                ],
                "senses": [
                    {
                        "sense_id": "83d405f1-abfa-3e42-9bb0-54e208514832",
                        "entry_id": "b2d95454-6af2-31db-9b2b-c293741e7f28",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4776d370-fc9f-49fe-881d-1780b582c0f9",
                                "sense_id": "83d405f1-abfa-3e42-9bb0-54e208514832",
                                "text": "Frau Rieble ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "daa09a74-b34f-4f1b-b42d-bfefac83cecd",
                                "sense_id": "83d405f1-abfa-3e42-9bb0-54e208514832",
                                "text": "Herr Rieble wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "04a260fe-fdf7-460f-a423-d9a8526fb998",
                                "sense_id": "83d405f1-abfa-3e42-9bb0-54e208514832",
                                "text": "Die Riebles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "b54a3db8-2cde-4f95-bc80-44a7459ebe55",
                                "sense_id": "83d405f1-abfa-3e42-9bb0-54e208514832",
                                "text": "Der Rieble trägt nie die Pullover, die die Rieble ihm strickt."
                            },
                            {
                                "example_id": "1a2dde20-3b21-4915-a336-649ca7909d67",
                                "sense_id": "83d405f1-abfa-3e42-9bb0-54e208514832",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Rieble kommt, geht der Herr Rieble.“"
                            },
                            {
                                "example_id": "af88dadc-3b4a-40c5-ae86-0e0645054857",
                                "sense_id": "83d405f1-abfa-3e42-9bb0-54e208514832",
                                "text": "Rieble kommt und geht."
                            },
                            {
                                "example_id": "1a065703-ec85-42b5-a3ab-3d618e38a29b",
                                "sense_id": "83d405f1-abfa-3e42-9bb0-54e208514832",
                                "text": "Riebles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
