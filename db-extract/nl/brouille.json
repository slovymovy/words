                        "examples": [
                            {
                                "example_id": "2e738cef-380d-45ca-9c48-43c5fe29863a",
                                "sense_id": "5edb25f2-2e59-3455-b6f9-5148d21463fd",
                                "text": "Zo heeft Ten Bosch’ moeder een dochter uit een eerder huwelijk met een SS-officier, die na afloop van hun huwelijksreis aan het Oostfront is gesneuveld. Als Ten Bosch de waarheid achterhaalt en er een roman over schrijft, levert dat hem een brouille op met zijn broer."
                            },
                            {
                                "example_id": "7c309926-1e30-44c9-b522-354d97b0597f",
                                "sense_id": "5edb25f2-2e59-3455-b6f9-5148d21463fd",
                                "text": "Maar om kort te gaan - kijk nou uit en doe niet weer zo lullig. Ik kan met jou toch moeilijk een brouille gaan maken."
                            }
                        ]
                    }
