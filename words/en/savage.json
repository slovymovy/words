    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "60dd632e-14c7-3040-9f57-622c86cc83fd",
                    "sense_definition": "Extremely violent, wild, or frightening.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The army launched a <w>savage</w> attack on the unsuspecting village.",
                            "target_lang_translations": {
                                "ru": "Армия предприняла <w>жестокую</w> атаку на ничего не подозревающую деревню.",
                                "de": "Die Armee startete einen <w>brutalen</w> Angriff auf das ahnungslose Dorf."
                            }
                        },
                        {
                            "text": "He survived a <w>savage</w> beating from the gang members.",
                            "target_lang_translations": {
                                "ru": "Он пережил <w>жестокое</w> избиение членами банды.",
                                "de": "Er überlebte eine <w>brutale</w> Prügelstrafe durch die Bandenmitglieder."
                            }
                        }
                    ],
                    "synonyms": [
                        "brutal",
                        "vicious",
                        "ferocious",
                        "cruel"
                    ],
                    "antonyms": [
                        "gentle",
                        "mild",
                        "kind"
                    ],
                    "common_phrases": [
                        "savage attack",
                        "savage beast",
                        "savage blow",
                        "savage cruelty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно жестокий, свирепый или пугающий.",
                        "de": "Extrem gewalttätig, wild oder erschreckend."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жестокий",
                                "target_lang_sense_clarification": "беспощадный, причиняющий боль"
                            },
                            {
                                "target_lang_word": "свирепый",
                                "target_lang_sense_clarification": "хищный, лютый, очень злой"
                            },
                            {
                                "target_lang_word": "беспощадный",
                                "target_lang_sense_clarification": "не знающий пощады"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "brutal",
                                "target_lang_sense_clarification": "rücksichtslos und gewalttätig"
                            },
                            {
                                "target_lang_word": "grausam",
                                "target_lang_sense_clarification": "ohne Mitleid, Schmerz zufügend"
                            },
                            {
                                "target_lang_word": "wild",
                                "target_lang_sense_clarification": "unkontrolliert und heftig"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "709fff59-18cb-3341-adfc-04f92d2002a3",
                    "sense_definition": "Brutally honest, impressive, or disrespectful in a bold and humorous way.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her reply to the rude comment was absolutely <w>savage</w>.",
                            "target_lang_translations": {
                                "ru": "Её ответ на грубый комментарий был абсолютно <w>жёстким</w>.",
                                "de": "Ihre Antwort auf den unhöflichen Kommentar war absolut <w>knallhart</w>."
                            }
                        },
                        {
                            "text": "That was a <w>savage</w> joke about his haircut, but everyone laughed.",
                            "target_lang_translations": {
                                "ru": "Это была <w>жёсткая</w> шутка о его стрижке, но все смеялись.",
                                "de": "Das war ein <w>dreister</w> Witz über seinen Haarschnitt, aber alle lachten."
                            }
                        }
                    ],
                    "synonyms": [
                        "ruthless",
                        "bold"
                    ],
                    "antonyms": [
                        "polite"
                    ],
                    "common_phrases": [
                        "absolutely savage",
                        "savage burn",
                        "pretty savage"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "common in internet culture and youth slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прямолинейный, дерзкий или впечатляющий (сленг).",
                        "de": "Brutal ehrlich, beeindruckend oder auf eine kühne und humorvolle Weise respektlos (Slang)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жёсткий",
                                "target_lang_sense_clarification": "сленг: крутой, но суровый или грубый"
                            },
                            {
                                "target_lang_word": "дерзкий",
                                "target_lang_sense_clarification": "смелый, вызывающий"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "knallhart",
                                "target_lang_sense_clarification": "sehr direkt und kompromisslos"
                            },
                            {
                                "target_lang_word": "dreist",
                                "target_lang_sense_clarification": "frech und respektlos"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69aea821-8d03-36d8-8d8d-8901f00a4e15",
                    "sense_definition": "Wild and not cultivated; existing in a natural and rugged state.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They got lost in the <w>savage</w> wilderness of the mountains.",
                            "target_lang_translations": {
                                "ru": "Они заблудились в <w>дикой</w> горной глуши.",
                                "de": "Sie verirrten sich in der <w>wilden</w> Berglandschaft."
                            }
                        },
                        {
                            "text": "The island possesses a <w>savage</w> beauty that attracts many adventurers.",
                            "target_lang_translations": {
                                "ru": "Остров обладает <w>дикой</w> красотой, которая привлекает многих искателей приключений.",
                                "de": "Die Insel besitzt eine <w>wilde</w> Schönheit, die viele Abenteurer anzieht."
                            }
                        }
                    ],
                    "synonyms": [
                        "wild",
                        "untamed",
                        "rugged"
                    ],
                    "antonyms": [
                        "cultivated",
                        "tame"
                    ],
                    "common_phrases": [
                        "savage wilderness",
                        "savage beauty",
                        "savage land"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дикий и невозделанный; существующий в естественном, суровом состоянии.",
                        "de": "Wild und nicht kultiviert; in einem natürlichen und rauen Zustand."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дикий",
                                "target_lang_sense_clarification": "находящийся в первозданном состоянии"
                            },
                            {
                                "target_lang_word": "суровый",
                                "target_lang_sense_clarification": "труднопроходимый, грубый (о природе)"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "wild",
                                "target_lang_sense_clarification": "naturbelassen, nicht gezähmt"
                            },
                            {
                                "target_lang_word": "unberührt",
                                "target_lang_sense_clarification": "von Menschenhand nicht verändert"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7027f998-6209-3b6d-bbd5-a25ab1866f18",
                    "sense_definition": "Primitive and uncivilized.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "4",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Early explorers often described the local tribes as <w>savage</w> people.",
                            "target_lang_translations": {
                                "ru": "Ранние исследователи часто описывали местные племена как <w>диких</w> людей.",
                                "de": "Frühe Entdecker beschrieben die lokalen Stämme oft als <w>barbarische</w> Menschen."
                            }
                        },
                        {
                            "text": "They lived in <w>savage</w> conditions without any modern tools or comforts.",
                            "target_lang_translations": {
                                "ru": "Они жили в <w>варварских</w> условиях без каких-либо современных инструментов или удобств.",
                                "de": "Sie lebten unter <w>primitiven</w> Bedingungen ohne moderne Werkzeuge oder Annehmlichkeiten."
                            }
                        }
                    ],
                    "synonyms": [
                        "barbaric",
                        "primitive"
                    ],
                    "antonyms": [
                        "civilized",
                        "sophisticated"
                    ],
                    "common_phrases": [
                        "savage tribes",
                        "savage customs"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often considered offensive in modern contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Примитивный и нецивилизованный.",
                        "de": "Primitiv und unzivilisiert."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дикарский",
                                "target_lang_sense_clarification": "свойственный дикарям"
                            },
                            {
                                "target_lang_word": "варварский",
                                "target_lang_sense_clarification": "грубый, некультурный"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "barbarisch",
                                "target_lang_sense_clarification": "kulturell unterentwickelt oder grausam"
                            },
                            {
                                "target_lang_word": "primitiv",
                                "target_lang_sense_clarification": "einfach, nicht zivilisiert"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f661d912-5ac7-3e76-956a-6d6150ee514f",
                    "sense_definition": "A person belonging to a primitive society.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "4",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The colonialists wrongly viewed the natives as <w>savages</w>.",
                            "target_lang_translations": {
                                "ru": "Колонизаторы ошибочно считали туземцев <w>дикарями</w>.",
                                "de": "Die Kolonialherren betrachteten die Einheimischen fälschlicherweise als <w>Wilde</w>."
                            }
                        },
                        {
                            "text": "In the movie, the so-called <w>savages</w> were actually very peaceful people.",
                            "target_lang_translations": {
                                "ru": "В фильме так называемые <w>дикари</w> на самом деле были очень мирными людьми.",
                                "de": "Im Film waren die sogenannten <w>Wilden</w> eigentlich sehr friedliche Menschen."
                            }
                        }
                    ],
                    "synonyms": [
                        "barbarian"
                    ],
                    "common_phrases": [
                        "noble savage"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "highly offensive in modern usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, принадлежащий к первобытному обществу.",
                        "de": "Eine Person, die einer primitiven Gesellschaft angehört."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дикарь",
                                "target_lang_sense_clarification": "представитель первобытного племени"
                            },
                            {
                                "target_lang_word": "варвар",
                                "target_lang_sense_clarification": "нецивилизованный человек"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Wilder",
                                "target_lang_sense_clarification": "veraltete Bezeichnung für Angehörige indigener Völker"
                            },
                            {
                                "target_lang_word": "Barbar",
                                "target_lang_sense_clarification": "unzivilisierte Person"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a79c3738-0dfe-38b7-9e3a-5bfaffe6c612",
                    "sense_definition": "Someone who does something cool, fearless, or brutally honest.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He ate the whole pizza in one minute; he is a <w>savage</w>.",
                            "target_lang_translations": {
                                "ru": "Он съел целую пиццу за одну минуту; он просто <w>зверь</w>.",
                                "de": "Er hat die ganze Pizza in einer Minute gegessen; er ist ein <w>Tier</w>."
                            }
                        },
                        {
                            "text": "She is a <w>savage</w> for quitting her job like that without notice.",
                            "target_lang_translations": {
                                "ru": "Она <w>безбашенная</w>, раз бросила работу вот так, без предупреждения.",
                                "de": "Sie ist <w>krass</w>, dass sie ihren Job einfach so ohne Kündigungsfrist aufgegeben hat."
                            }
                        }
                    ],
                    "synonyms": [
                        "legend"
                    ],
                    "common_phrases": [
                        "total savage",
                        "absolute savage"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто ведет себя круто, бесстрашно или предельно честно (сленг).",
                        "de": "Jemand, der sich cool, furchtlos oder brutal ehrlich verhält (Slang)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зверь",
                                "target_lang_sense_clarification": "перен.: кто-то очень крутой или мощный"
                            },
                            {
                                "target_lang_word": "безбашенный",
                                "target_lang_sense_clarification": "отчаянный, сумасбродный человек"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "krass",
                                "target_lang_sense_clarification": "sehr beeindruckend oder extrem"
                            },
                            {
                                "target_lang_word": "abgebrüht",
                                "target_lang_sense_clarification": "furchtlos und unbeeindruckt"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7fd41538-8709-3373-b395-3c00b0ca3da5",
                    "sense_definition": "To attack someone or something violently, often with teeth.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer's sheep were <w>savaged</w> by a pack of wolves.",
                            "target_lang_translations": {
                                "ru": "Овцы фермера были <w>растерзаны</w> стаей волков.",
                                "de": "Die Schafe des Bauern wurden von einem Wolfsrudel <w>zerfleischt</w>."
                            }
                        },
                        {
                            "text": "The bear <w>savaged</w> the campsite looking for food.",
                            "target_lang_translations": {
                                "ru": "Медведь <w>разгромил</w> лагерь в поисках еды.",
                                "de": "Der Bär <w>zerlegte</w> den Campingplatz auf der Suche nach Nahrung."
                            }
                        }
                    ],
                    "synonyms": [
                        "maul",
                        "attack",
                        "tear"
                    ],
                    "common_phrases": [
                        "savaged by a dog",
                        "savaged the sheep"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жестоко нападать на кого-то или что-то, часто кусая.",
                        "de": "Jemanden oder etwas gewaltsam angreifen, oft mit den Zähnen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "растерзать",
                                "target_lang_sense_clarification": "разорвать на части (о хищниках)"
                            },
                            {
                                "target_lang_word": "набрасываться",
                                "target_lang_sense_clarification": "агрессивно атаковать"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "zerfleischen",
                                "target_lang_sense_clarification": "mit den Zähnen zerreißen"
                            },
                            {
                                "target_lang_word": "anfallen",
                                "target_lang_sense_clarification": "plötzlich und gewaltsam angreifen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7b55404-1665-37cb-8750-497efe2fb825",
                    "sense_definition": "To criticize someone or something very severely and publicly.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "5",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new play was <w>savaged</w> by the theater critics.",
                            "target_lang_translations": {
                                "ru": "Новая пьеса была <w>разнесена</w> театральными критиками.",
                                "de": "Das neue Theaterstück wurde von den Kritikern <w>verrissen</w>."
                            }
                        },
                        {
                            "text": "The press <w>savaged</w> the politician for his mistake.",
                            "target_lang_translations": {
                                "ru": "Пресса <w>разнесла</w> политика за его ошибку.",
                                "de": "Die Presse <w>zerpflückte</w> den Politiker für seinen Fehler."
                            }
                        }
                    ],
                    "synonyms": [
                        "lambaste",
                        "criticize"
                    ],
                    "antonyms": [
                        "praise",
                        "acclaim"
                    ],
                    "common_phrases": [
                        "savaged by critics",
                        "savaged the plan"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "journalistic or literary context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Критиковать кого-то или что-то очень сурово и публично.",
                        "de": "Jemanden oder etwas sehr scharf und öffentlich kritisieren."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разносить",
                                "target_lang_sense_clarification": "подвергать уничтожающей критике"
                            },
                            {
                                "target_lang_word": "громить",
                                "target_lang_sense_clarification": "яростно критиковать"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "verreißen",
                                "target_lang_sense_clarification": "in einer Kritik vernichtend beurteilen"
                            },
                            {
                                "target_lang_word": "zerpflücken",
                                "target_lang_sense_clarification": "scharf und im Detail kritisieren"
                            }
                        ]
                    }
                }
            ]
        },
