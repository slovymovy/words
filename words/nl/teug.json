{
    "word_family": [
        "teugen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5f9de81f-7f1f-3acc-a3a9-005ede3af91a",
                    "sense_definition": "een hoeveelheid vloeistof die men in één keer doorslikt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "drinken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij nam een grote <w>teug</w> van het koude water na het hardlopen.",
                            "target_lang_translations": {
                                "en": "He took a large <w>gulp</w> of the cold water after running."
                            }
                        },
                        {
                            "text": "Zij dronk de limonade in één <w>teug</w> leeg omdat ze veel dorst had.",
                            "target_lang_translations": {
                                "en": "She finished the lemonade in one <w>draught</w> because she was very thirsty."
                            }
                        }
                    ],
                    "synonyms": [
                        "slok"
                    ],
                    "common_phrases": [
                        "in één teug"
                    ],
                    "target_lang_definitions": {
                        "en": "An amount of liquid swallowed at once."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "draught",
                                "target_lang_sense_clarification": "a single act of drinking or the amount drunk"
                            },
                            {
                                "target_lang_word": "gulp",
                                "target_lang_sense_clarification": "a large swallow of liquid"
                            },
                            {
                                "target_lang_word": "swig",
                                "target_lang_sense_clarification": "an informal, large swallow"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "835dc192-1df6-3044-bbed-2327b6ec67fd",
                    "sense_definition": "het naar binnen zuigen van lucht of rook",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inhaleren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De wandelaar nam een diepe <w>teug</w> frisse berglucht.",
                            "target_lang_translations": {
                                "en": "The hiker took a deep <w>breath</w> of fresh mountain air."
                            }
                        },
                        {
                            "text": "Hij nam nog een laatste <w>teug</w> van zijn sigaret voor hij naar binnen ging.",
                            "target_lang_translations": {
                                "en": "He took one last <w>puff</w> of his cigarette before going inside."
                            }
                        }
                    ],
                    "common_phrases": [
                        "diepe teug"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of inhaling air or smoke."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "breath",
                                "target_lang_sense_clarification": "a single inhalation of air"
                            },
                            {
                                "target_lang_word": "puff",
                                "target_lang_sense_clarification": "a single inhalation of smoke from a cigarette"
                            },
                            {
                                "target_lang_word": "drag",
                                "target_lang_sense_clarification": "informal term for inhaling smoke"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}