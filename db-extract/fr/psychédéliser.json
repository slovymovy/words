                "senses": [
                    {
                        "sense_id": "62fc4d07-f68a-33f5-9d94-1bd17e4d927d",
                        "entry_id": "6a2583f8-503e-39a9-af0c-82db26064be7",
                        "glosses": [
                            "Donner un caractère psychédélique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e75dd3bd-6c02-45a2-9ec7-ba2e3ab838d8",
                                "sense_id": "62fc4d07-f68a-33f5-9d94-1bd17e4d927d",
                                "text": "Mais si tu te laisses posséder par la ville, si tu te branches sur le flux d'énergie, si les forces de mort qui sont là pour te broyer éveillent en toi le vouloir-vivre, alors New York te psychédélise."
                            },
                            {
                                "example_id": "90d3b208-c06b-4957-8010-af7c43ef186a",
                                "sense_id": "62fc4d07-f68a-33f5-9d94-1bd17e4d927d",
                                "text": "Voici seulement deux ou trois ans, rien ne semblait plus mort et enterré que le modern style et la peinture 1900 : aujourd’hui, un Gustav Klinst redevient grand homme, ses tableaux font des millions, et on psychédélise à donner la nausée."
                            },
                            {
                                "example_id": "de4e4df0-5d9b-49bb-9e70-db428e3a6654",
                                "sense_id": "62fc4d07-f68a-33f5-9d94-1bd17e4d927d",
                                "text": "Nous sommes à la fin des années soixante et Alain monte ses premiers groupes, galvanisé par ce rock qui se psychédélise, découvre d'autres gammes et fraie avec des genres plus sérieux."
                            }
                        ]
                    }
