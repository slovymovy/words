                "senses": [
                    {
                        "sense_id": "310e9608-db62-33e6-87da-c9893b56dc45",
                        "entry_id": "b70b27fb-3fc0-3f95-bb00-2c8e1e9b4f91",
                        "glosses": [
                            "Überbauung von (bisher natürlichen) Flächen, beispielsweise mit Gebäuden, Straßen, Schienen, Sportplätzen; in Deutschland häufig in Form von neuen Gewerbe- oder Wohngebieten an Stadträndern (= Suburbanisierung)"
                        ],
                        "tags": [
                            "Umweltschutz"
                        ],
                        "examples": [
                            {
                                "example_id": "e8a6af9f-adea-4d93-9f01-f6c1156fb8f3",
                                "sense_id": "310e9608-db62-33e6-87da-c9893b56dc45",
                                "text": "Die Bodenversiegelung in Deutschland entspricht 114 Fußballplätzen - täglich. [Quelle: dw.de, 4.12.2015]"
                            },
                            {
                                "example_id": "6a17e2d5-5f18-428b-8b06-5d32307895fa",
                                "sense_id": "310e9608-db62-33e6-87da-c9893b56dc45",
                                "text": "„Unter Bodenversiegelung versteht man das mehr oder weniger vollständige Abdecken des natürlichen Bodens durch Materialien, die weder Wasser noch Luft durchlassen. Beispiele für solche versiegelte Flächen sind unsere Strassen, Gebäude, Parkplätze, Hartplätze bei Sportanlagen, gewisse Kunstrasen, Gartenplatten etc.“"
                            },
                            {
                                "example_id": "3c048951-e667-4d99-8418-60cfe6dc9ffe",
                                "sense_id": "310e9608-db62-33e6-87da-c9893b56dc45",
                                "text": "„Aus ehemaligen Überschwemmungsgebieten wurde Baugrund für Wohn- oder Gewerbegebiete sowie Infrastruktur. \"Bodenversiegelung\" heißt diese Art Umwandlung von grüner Landschaft in der Fachsprache.“"
                            },
                            {
                                "example_id": "277b5143-f301-4931-a93b-1bb3b5657444",
                                "sense_id": "310e9608-db62-33e6-87da-c9893b56dc45",
                                "text": "„Es gibt Widerstand gegen Bodenversiegelung – aber das ist eher eine Minderheitsposition“"
                            },
                            {
                                "example_id": "b88891e1-df2d-4180-b9a1-6a6161905abb",
                                "sense_id": "310e9608-db62-33e6-87da-c9893b56dc45",
                                "text": "„Conti will beweisen, dass sie Politik für alle macht: Sie stoppt die Bodenversiegelung, geht gegen Straßenprostitution und Drogendealer vor, und schafft die Gebühren für die Kindergärten ab.“"
                            },
                            {
                                "example_id": "82e90218-e678-460a-88ff-5a547efcae4d",
                                "sense_id": "310e9608-db62-33e6-87da-c9893b56dc45",
                                "text": "„Ein weiteres Problem ist die Bodenversiegelung durch Bauten und Verkehrswege, 1945 – 1975 wurde eine Fläche von der Größe Großbritanniens zugebaut. Lebensraum für Tiere und Pflanzen wird so vernichtet und der versiegelte Boden kann keine Niederschläge speichern.“"
                            },
                            {
                                "example_id": "e409ce26-9f0e-462f-9a08-078af1c1d4b0",
                                "sense_id": "310e9608-db62-33e6-87da-c9893b56dc45",
                                "text": "„Eine Rolle spielt dabei die Bodenversiegelung, also die luft- und wasserdichte Abdeckung: Für ein Einfamilienhaus - mit wenigen Menschen - muss in Relation mehr Boden betoniert werden als für ein Mehrfamilienhaus.“"
                            },
                            {
                                "example_id": "8daf52f5-ed35-4544-85cd-24ccde4ca6ad",
                                "sense_id": "310e9608-db62-33e6-87da-c9893b56dc45",
                                "text": "„Wir müssen […] der Bodenversiegelung entgegenwirken, den Wasserhaushalt insgesamt wieder natürlicher gestalten.“"
                            },
                            {
                                "example_id": "ec638663-7775-4e8d-8db5-fc594abfbab1",
                                "sense_id": "310e9608-db62-33e6-87da-c9893b56dc45",
                                "text": "„Aber Bäume in der Stadt stehen unter Stress! Bodenverdichtung, Bodenversiegelung, Trockenheit und Hitze machen sie anfällig für Schädlinge und Krankheiten.“"
                            },
                            {
                                "example_id": "180e5cb5-fedd-4b2c-8785-87a19f1f28c5",
                                "sense_id": "310e9608-db62-33e6-87da-c9893b56dc45",
                                "text": "„[Bäume] leiden unter Wärmestress, weil in der Stadt höhere Temperaturen herrschen als auf dem Land. Dadurch muss der Baum mehr verdunsten. Durch die Bodenversiegelung bekommt er aber oft nur wenig Wasser, die Folge ist Trockenstress.“"
                            },
                            {
                                "example_id": "4ae964a2-061c-4346-9fcc-472fe269ee1a",
                                "sense_id": "310e9608-db62-33e6-87da-c9893b56dc45",
                                "text": "[Hochwasserschutz an Flüssen:] „Die Bodenversiegelung in den Städten und Dörfern [muss] gebremst werden und die Landwirtschaft sich auf naturnahe Bewirtschaftung besinnen: »Die Schwammfunktion der Landschaft muss wieder hergestellt werden.«“"
                            },
                            {
                                "example_id": "cbfc39a6-0a7f-4b13-9757-cf9ea401e03a",
                                "sense_id": "310e9608-db62-33e6-87da-c9893b56dc45",
                                "text": "„Als weiterer Grund für die zu beobachtende Häufung von Hochwassern in den letzten Jahrzehnten wird oft die zunehmende Bodenversiegelung durch Wege, Straßen, Gebäude und Plätze angesehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
