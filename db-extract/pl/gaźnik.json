                "senses": [
                    {
                        "sense_id": "1cd9b3d8-a5ad-336c-b21a-6c4ac85ab57b",
                        "entry_id": "c289d2fe-9772-3b9a-be05-b8a54a18274c",
                        "glosses": [
                            "urządzenie do wytwarzania mieszanki paliwa i powietrza w silnikach spalinowych z zapłonem iskrowym"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c805558-e318-4250-a2e7-be7d61f2f2f5",
                                "sense_id": "1cd9b3d8-a5ad-336c-b21a-6c4ac85ab57b",
                                "text": "Silnik składa się z gaźnika, tłoków, wału, chłodnicy i wielu innych elementów."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2012684a-eaa4-46eb-a5cf-8f14a3bf3a3f",
                        "source_entry_id": "c289d2fe-9772-3b9a-be05-b8a54a18274c",
                        "source_sense_id": "1cd9b3d8-a5ad-336c-b21a-6c4ac85ab57b",
                        "target_lang_word": "carburettor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carburettor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4150c0fe-443c-327c-a14e-7acf7c052cf2",
                                        "entry_id": "aedf7911-a9b3-36e6-9946-5cf4ffd20c4f",
                                        "glosses": [
                                            "Alternative spelling of carburetor."
                                        ],
                                        "tags": [
                                            "UK",
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9183a9ab-ce18-4c3e-9ca1-1f3eeeab9073",
                                                "sense_id": "4150c0fe-443c-327c-a14e-7acf7c052cf2",
                                                "text": "Both affect the performance of the machine, especially the carburettors, and both are important to the final appearance of the model."
                                            },
                                            {
                                                "example_id": "b4483902-d063-4a16-895e-e755fbe198e3",
                                                "sense_id": "4150c0fe-443c-327c-a14e-7acf7c052cf2",
                                                "text": "In a carburettor the pressure drop (or viewed another way, suction) is used to draw fuel out of a reservoir, usually via a jet, and into the venturi to mix with the air flowing through it."
                                            },
                                            {
                                                "example_id": "f4ab6083-be59-4cc9-939b-81c3a527e878",
                                                "sense_id": "4150c0fe-443c-327c-a14e-7acf7c052cf2",
                                                "text": "For a large part of the twentieth century the majority of light vehicles used petrol engines that were equipped with a carburettor."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb3c330b-2b6c-4efe-b13b-86fb7db40181",
                        "source_entry_id": "c289d2fe-9772-3b9a-be05-b8a54a18274c",
                        "source_sense_id": "1cd9b3d8-a5ad-336c-b21a-6c4ac85ab57b",
                        "target_lang_word": "carburateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carburateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "57535ef0-6464-3e70-9df6-c41656354b3e",
                                        "entry_id": "fd88924c-e7c9-3e3a-a969-c0517ad0d4cb",
                                        "glosses": [
                                            "Appareil dans lequel se mélangent l’air atmosphérique et l’essence pour former le gaz qui fait fonctionner les moteurs à explosion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9e13304-08f9-4d87-a78b-1501c47360b7",
                                                "sense_id": "57535ef0-6464-3e70-9df6-c41656354b3e",
                                                "text": "Parmi les modifications importantes, il faut encore citer la mise en place d'un système de réchauffage pour empêcher les carburateurs de givrer, […]."
                                            },
                                            {
                                                "example_id": "4b2364d0-8688-4448-b8f7-6749a70c6bf1",
                                                "sense_id": "57535ef0-6464-3e70-9df6-c41656354b3e",
                                                "text": "Ce qui signifie que la structure retenue pour contrôler le moteur réalise également les fonctions autrefois assurées par le carburateur, l’injection électronique analogique ou l’allumeur électromécanique."
                                            },
                                            {
                                                "example_id": "c22878a3-7e57-42b2-9961-2da69b7c3f24",
                                                "sense_id": "57535ef0-6464-3e70-9df6-c41656354b3e",
                                                "text": "Après avoir totalement désossé l'engin, j'avais savamment vidé le pot d'échappement en supprimant les chicanes et adapté un carburateur récupéré sur la vieille mobylette d'un copain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49e596de-d91b-4586-9eed-4359c3cdb553",
                        "source_entry_id": "c289d2fe-9772-3b9a-be05-b8a54a18274c",
                        "source_sense_id": "1cd9b3d8-a5ad-336c-b21a-6c4ac85ab57b",
