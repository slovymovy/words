                "senses": [
                    {
                        "sense_id": "dd834b37-e9e1-350b-b4cf-b8ff4d2bcc7c",
                        "entry_id": "18e84be0-be7b-3007-b034-eee505edddca",
                        "glosses": [
                            "Variante eines Phonems (langue)"
                        ],
                        "tags": [
                            "Phonologie"
                        ],
                        "examples": [
                            {
                                "example_id": "5cfca6be-967a-4709-96e1-4adf75046c70",
                                "sense_id": "dd834b37-e9e1-350b-b4cf-b8ff4d2bcc7c",
                                "text": "„Im Prinzip können alle bekannten Bereiche der Sprache, von den Allophonen bis zur Textstruktur und dem Lexikon, statistisch untersucht werden.“"
                            },
                            {
                                "example_id": "712d8c91-4f83-4411-8203-0c1e086308fb",
                                "sense_id": "dd834b37-e9e1-350b-b4cf-b8ff4d2bcc7c",
                                "text": "„An weiteren wichtigen Allophonen sind nur noch die lokal verteilten Realisierungen von /r/ als [r, R] zu erwähnen.“"
                            },
                            {
                                "example_id": "146d63ba-b44d-4399-871c-235288ef70b4",
                                "sense_id": "dd834b37-e9e1-350b-b4cf-b8ff4d2bcc7c",
                                "text": "„Komplementär distribuierte Phone sind immer Allophone eines Phonems, weil logisch ausgeschlossen ist, daß diese Phone in Opposition stehen können, also gegenseitig bedeutungsdifferenzierend sind.“"
                            },
                            {
                                "example_id": "130d869b-7672-4a39-8533-afda55aa0033",
                                "sense_id": "dd834b37-e9e1-350b-b4cf-b8ff4d2bcc7c",
                                "text": "„Die Allophone [ç] und [x] behandeln wir als zwei Lauttypen gesondert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae13934e-830a-44b3-a5c4-13f3c3a89b93",
                        "source_entry_id": "18e84be0-be7b-3007-b034-eee505edddca",
                        "source_sense_id": "dd834b37-e9e1-350b-b4cf-b8ff4d2bcc7c",
