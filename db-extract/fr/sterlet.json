                    {
                        "translation_id": "35fd0661-0521-432d-bc96-e354a8d17610",
                        "source_entry_id": "ae0ebca0-d5b6-39e9-9c9d-05ef5f5cad82",
                        "source_sense_id": "72395c1a-8608-39d0-aba0-ed90d9a9fae9",
                        "target_lang_word": "стерлядь",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "стерлядь",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "032212fa-ba25-3b40-a6eb-79efc0b733d7",
                                        "entry_id": "f2a4a0f9-6a9d-308b-861b-2abe1c1739e8",
                                        "glosses": [
                                            "зоол. рыба из семейства осетровых"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da934adb-1811-4846-ba10-d9ff41709217",
                                                "sense_id": "032212fa-ba25-3b40-a6eb-79efc0b733d7",
                                                "text": "Проводя гостей, отец вздумал потянуть неводом известное рыбное плесо на реке Белой, которая текла всего в полуверсте от нашего жилья: ему очень хотелось поймать стерлядей, и он даже говорил мне: «Что, Сережа, кабы попалась белорыбица или осетр?»"
                                            },
                                            {
                                                "example_id": "db425980-ca44-4c7b-a88c-1ec195fb45ae",
                                                "sense_id": "032212fa-ba25-3b40-a6eb-79efc0b733d7",
                                                "text": "— Вы чего ж тут сидите? Батянька прислал, чтоб скорей шли к косе. Мы там мешок стерлядей наловили! — В голосе Дуняшки нескрываемое торжество."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a7213ee-c8d4-3d77-94ee-705b64684c3d",
                                        "entry_id": "f2a4a0f9-6a9d-308b-861b-2abe1c1739e8",
                                        "glosses": [
                                            "кулин. то же, что стерляжина; мясо стерляди, употребляемое в пищу"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a14be00-102c-4d98-bb2d-e4240ec537e4",
                                                "sense_id": "7a7213ee-c8d4-3d77-94ee-705b64684c3d",
                                                "text": "— А скажите, пожалуйста, Николай Иваныч, — сказал мне Горехвастов, — откуда у вас берутся все эти милые вещи: копченые стерляди, индеечья ветчина, оленьи языки… и эта бесценная водка!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
