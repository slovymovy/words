                "senses": [
                    {
                        "sense_id": "4c19439f-07d5-3700-a21d-a5de64b4275d",
                        "entry_id": "180c6533-63b4-36f0-85df-27b551ea39e0",
                        "glosses": [
                            "Amphetamin"
                        ],
                        "tags": [],
