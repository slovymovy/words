                "senses": [
                    {
                        "sense_id": "3a672847-6ee9-3076-9049-7f3f5247d8e0",
                        "entry_id": "7a15239b-c549-3fd5-99a6-55271afdf121",
                        "glosses": [
                            "день свадьбы, бракосочетания"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ad2bced-fd1d-4116-b286-f9bf08cde4ff",
                                "sense_id": "3a672847-6ee9-3076-9049-7f3f5247d8e0",
                                "text": "Am Hochzeitstag stand eine blumengeschmückte Kutsche für das Brautpaar bereit.",
                                "translation": "В день свадьбы для молодожёнов была приготовлена украшенная цветами карета."
                            }
                        ]
                    },
                    {
                        "sense_id": "cd16ecba-5f3b-3189-b579-063e28ac19a3",
                        "entry_id": "7a15239b-c549-3fd5-99a6-55271afdf121",
                        "glosses": [
                            "годовщина, юбилей (свадьбы)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b0ab162-855c-43d5-8a5e-8cc31b5a838d",
                                "sense_id": "cd16ecba-5f3b-3189-b579-063e28ac19a3",
                                "text": "Zum Hochzeitstag schenkt er seiner Frau jedes Jahr rote Rosen.",
                                "translation": "Каждый год на годовщину свадьбы он дарит своей жене красные розы."
                            }
                        ]
                    }
                ],
