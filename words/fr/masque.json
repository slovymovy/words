                    "common_phrases": [
                        "faire un masque",
                        "masque à l'argile"
                    ]
                },
                {
                    "sense_id": "5709b8a5-c886-36ab-b18c-0a04f7ac4027",
                    "sense_definition": "Apparence trompeuse sous laquelle une personne dissimule ses véritables pensées ou intentions.",
