                                        "entry_id": "887be0d2-3871-368a-8bd2-ba55823bef66",
                                        "glosses": [
                                            "Pneumoconiose liée à l'inhalation de particules de fer."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "646577ca-8dd8-4bad-b337-dd95e24517a9",
                                                "sense_id": "d23c6b68-db64-359d-a24a-7d6a086841a2",
                                                "text": "Après trente-trois ans dans les mines de fer, ce mineur est désormais atteint d’une sidérose."
                                            },
                                            {
                                                "example_id": "1a86eec0-6316-4ac3-83b6-e8763f4922cb",
                                                "sense_id": "d23c6b68-db64-359d-a24a-7d6a086841a2",
                                                "text": "Les critères de reconnaissance de la sidérose ont été assouplis et les mineurs de fer ne devront plus être atteints d’une sidérose pour faire reconnaître un cancer bronchopulmonaire."
                                            }
                                        ]
