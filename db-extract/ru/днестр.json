                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dniestr",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "48b740d0-eb92-39b9-88a0-025dc2af2841",
                                        "entry_id": "f33f514e-0aa1-3fe4-a403-d327a8972aa5",
                                        "glosses": [
                                            "rzeka wypływająca z Karpat Wschodnich, uchodząca do Morza Czarnego, a przepływająca przez Ukrainę i Mołdawię"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "231c4451-73cd-4861-b7a8-678c5a62a2c5",
                                                "sense_id": "48b740d0-eb92-39b9-88a0-025dc2af2841",
                                                "text": "Podole położone jest nad północnymi dopływami środkowego Dniestru."
                                            },
                                            {
                                                "example_id": "cd9fab2f-e109-4e9e-bfae-693e10fbfb31",
                                                "sense_id": "48b740d0-eb92-39b9-88a0-025dc2af2841",
                                                "text": "Tatarzy krymscy przekraczali Dniestr poniżej Tehinii i z Budziaku podążali pomiędzy Prutem i Dniestrem przez Mołdawię"
                                            },
                                            {
                                                "example_id": "852ce1f5-b22d-433e-af02-160a0be2ced9",
                                                "sense_id": "48b740d0-eb92-39b9-88a0-025dc2af2841",
                                                "text": "Sieć rzeczna jest dobrze rozwinięta, a główne rzeki to Dniestr z dopływami: Reut, Ikiel, Botna i Byk oraz Prut, należące do zlewiska Morza Czarnego."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
