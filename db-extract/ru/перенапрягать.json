                        "cross_references": [
                            {
                                "target_word": "surmener",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "88600dcc-3623-38c7-bfcc-199920df9092",
                                        "entry_id": "5cb4ba6e-f3c3-3527-bb99-58f1000ca11e",
                                        "glosses": [
                                            "Excéder de fatigue, en les faisant aller trop vite ou trop longtemps, en parlant des chevaux et des autres bêtes de somme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71f962b0-9f9a-4739-8abd-940ed35c3f5d",
                                                "sense_id": "88600dcc-3623-38c7-bfcc-199920df9092",
                                                "text": "Surmener un cheval."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a6899c1-ec54-344a-9e53-efd14eae4c21",
                                        "entry_id": "5cb4ba6e-f3c3-3527-bb99-58f1000ca11e",
                                        "glosses": [
                                            "Fatiguer à l’excès, en parlant des personnes."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "987a7284-b931-43d3-a8b0-f278ba1e44c8",
                                                "sense_id": "1a6899c1-ec54-344a-9e53-efd14eae4c21",
                                                "text": "Vous surmenez vos employés."
                                            },
                                            {
                                                "example_id": "e05f4b20-a47d-4f98-98bf-85bbd29249bf",
                                                "sense_id": "1a6899c1-ec54-344a-9e53-efd14eae4c21",
                                                "text": "Je suis surmené."
                                            },
                                            {
                                                "example_id": "1a7bda9c-35c5-427b-84dc-2c8e3f1efe96",
                                                "sense_id": "1a6899c1-ec54-344a-9e53-efd14eae4c21",
                                                "text": "Je me suis surmené."
                                            },
                                            {
                                                "example_id": "33c2e234-54e4-4610-9959-289537158429",
                                                "sense_id": "1a6899c1-ec54-344a-9e53-efd14eae4c21",
                                                "text": "Et, dès ce jour, il affecta de se rejeter tout entier dans le travail. C’était, d’ailleurs, une de ses théories, que l’absolu repos ne valait rien, qu’on ne devait jamais le prescrire, même aux surmenés."
                                            }
                                        ]
