                    {
                        "sense_id": "219551cf-3218-3903-a384-d1a329873c7d",
                        "entry_id": "4fc03483-1ab5-3422-8492-b61114a1a0c7",
                        "glosses": [
                            "zorganizowana działalność Kościoła, polegająca na głoszeniu zasad wiary i celebrowaniu liturgii"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23561402-d998-476a-a422-b41b0640e274",
                                "sense_id": "219551cf-3218-3903-a384-d1a329873c7d",
                                "text": "Honorata pomagała w duszpasterstwie akademickim, wszędzie jej było pełno."
                            },
                            {
                                "example_id": "e76ff21d-6c1e-4a57-b53b-ca732e11646a",
                                "sense_id": "219551cf-3218-3903-a384-d1a329873c7d",
                                "text": "Młodzi pojechali do Ziemi Świętej z duszpasterstwem pielgrzymkowym archidiecezji katowickiej."
                            },
                            {
                                "example_id": "c67fda0a-4365-4409-b7e0-9bd89c55a4cd",
                                "sense_id": "219551cf-3218-3903-a384-d1a329873c7d",
                                "text": "Nowy kolega w pracy i mój nowy proboszcz pochodzą z tego samego duszpasterstwa."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
