                    {
                        "translation_id": "731dd287-1797-4fb3-a69c-03a7716b92f6",
                        "source_entry_id": "b6eb6c5c-bb71-31eb-a353-4b4de3167d48",
                        "source_sense_id": "ed418552-341b-3330-8eeb-de4009dd6c6a",
