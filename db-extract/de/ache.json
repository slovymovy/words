                            {
                                "target_word": "agate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64e123c4-7553-3bb3-947b-590bc95dbd31",
                                        "entry_id": "8cc042c2-2b51-3748-8bc4-0a0837511264",
                                        "glosses": [
                                            "On the way; agoing."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "853a1f7b-86ea-4007-85fd-4ea775a73198",
                                                "sense_id": "64e123c4-7553-3bb3-947b-590bc95dbd31",
                                                "text": "Go to it then hardily, and let us be agate."
                                            },
                                            {
                                                "example_id": "7a35843d-ca44-42a3-8c51-3e08b7f7793b",
                                                "sense_id": "64e123c4-7553-3bb3-947b-590bc95dbd31",
                                                "text": "I'm fear'd you have some ill plans agate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d322649c-5bcf-49b3-ac8c-f5abc16cf6a7",
                        "source_entry_id": "3216272f-d3c6-3d54-8448-d59ac652b228",
                        "source_sense_id": "0f948e89-b149-33c3-8a73-66d83a4dbe3a",
                        "source_sense_description": "Name oder Namensbestandteil von Fließgewässern",
                        "target_lang_word": "agate",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agate",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "49f58f51-e08c-39e1-beeb-129f88879c9b",
                                        "entry_id": "776bc95e-7d79-3fad-a7f2-6197b692ce51",
                                        "glosses": [
                                            "Variété de quartz, agrégation de plusieurs formes de silices qui prend parfaitement le poli et varie pour les couleurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f0e4eaf-8ce7-4895-bf3c-b8ef69d4417a",
                                                "sense_id": "49f58f51-e08c-39e1-beeb-129f88879c9b",
                                                "text": "Ses rasoirs, à manche d’agate, coupaient bien, et il arborait un tablier de basaine blanche, immaculé, détail dont il n’aurait eu cure douze ans auparavant."
                                            },
                                            {
                                                "example_id": "5ba75a55-0f7b-404c-b5ee-f58ea42cdb11",
                                                "sense_id": "49f58f51-e08c-39e1-beeb-129f88879c9b",
                                                "text": "Ses yeux jaunes et bleus sont comme deux agates ;\nIl les ferme à demi, parfois, en reniflant,\nSe renverse, ayant pris son museau dans ses pattes,\nAvec des airs de tigre étendu sur le flanc."
                                            },
                                            {
                                                "example_id": "f32a99af-f6f0-4bf0-a214-7b32df4d18a5",
                                                "sense_id": "49f58f51-e08c-39e1-beeb-129f88879c9b",
                                                "text": "Un beau cabinet d’agates."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5de5c243-ab43-3ea9-a8e6-04e8466c33a6",
                                        "entry_id": "776bc95e-7d79-3fad-a7f2-6197b692ce51",
                                        "glosses": [
                                            "Objet fait de cette pierre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05c2e6c1-10b6-4df0-ab92-f11b300f2c9f",
                                                "sense_id": "5de5c243-ab43-3ea9-a8e6-04e8466c33a6",
                                                "text": "La plus belle agate connue est celle du cabinet des antiques à la Bibliothèque nationale de Paris : elle représente la glorification de Germanicus et elle a 32 centimètres de hauteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc4ec0d5-5b81-3140-8d62-8d401abb7d5c",
                                        "entry_id": "776bc95e-7d79-3fad-a7f2-6197b692ce51",
                                        "glosses": [
                                            "Instrument dans lequel est enchâssée une agate et qui sert à brunir l’or ou d’autres métaux."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ca0ede06-c5a8-3972-9af0-903ad17f9f3d",
                                        "entry_id": "776bc95e-7d79-3fad-a7f2-6197b692ce51",
                                        "glosses": [
                                            "Bille en verre avec des filaments multicolores à l’intérieur, cornaline. Terme notamment employé par opposition aux billes en terre cuite peintes en usage jusque vers les années 1970."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66e5a55e-bbf4-4de9-97f2-e8d3eb379864",
                                                "sense_id": "ca0ede06-c5a8-3972-9af0-903ad17f9f3d",
                                                "text": "Et elle me montrait une petite bille d’agate, grosse comme les plus fortes balles de plomb, et avec laquelle on avait chargé le pistolet de calibre qui était là."
                                            },
                                            {
                                                "example_id": "86829f41-df78-40df-ae8d-b9d4df597190",
                                                "sense_id": "ca0ede06-c5a8-3972-9af0-903ad17f9f3d",
                                                "text": "— Quatre billes et une agate ! ben, mon cochon, t’en as du culot ; j’te donne deux billes et une blanche, voilà."
                                            },
                                            {
                                                "example_id": "146160c1-8cac-4ac0-ae0b-9845605bc0a9",
                                                "sense_id": "ca0ede06-c5a8-3972-9af0-903ad17f9f3d",
                                                "text": "Dans les yeux de Gilberte il y avait le bon regard franc de on père ; c’est celui qu’elle avait eu quand elle m’avait donné la bille d’agate et m’avait dit : « Gardez-la en souvenir de notre amitié. »"
                                            },
                                            {
                                                "example_id": "a9c83ce8-3af9-4b4f-b4fe-71f2374f02b2",
                                                "sense_id": "ca0ede06-c5a8-3972-9af0-903ad17f9f3d",
                                                "text": "Il y a naturellement des billes, et aussi des gros calots de verre de toutes les couleurs, qu’ailleurs on appelle des agates."
                                            }
                                        ]
                                    }
                                ]
                            },
