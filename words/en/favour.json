                {
                    "sense_id": "db317304-3007-32ab-b7e5-1996ce968fa7",
                    "sense_definition": "Approval, support, or preference for someone or something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "noun_support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee voted in <w>favour</w> of the new proposal to build a park.",
                            "target_lang_translations": {
                                "ru": "Комитет проголосовал в <w>пользу</w> нового предложения о строительстве парка.",
                                "zh": "委员会投票<w>支持</w>了修建公园的新提案。",
                                "nl": "De commissie stemde ten <w>gunste</w> van het nieuwe voorstel om een park aan te leggen.",
                                "pl": "Komitet zagłosował na <w>korzyść</w> nowej propozycji budowy parku.",
                                "de": "Das Komitee stimmte <w>für</w> den neuen Vorschlag, einen Park zu bauen.",
                                "fr": "Le comité a voté en <w>faveur</w> de la nouvelle proposition de construire un parc.",
                                "it": "Il comitato ha votato a <w>favore</w> della nuova proposta di costruire un parco.",
                                "cs": "Výbor hlasoval <w>ve prospěch</w> nového návrhu na vybudování parku.",
                                "tr": "Komite, park yapılmasına yönelik yeni teklifin <w>lehine</w> oy kullandı.",
                                "es": "El comité votó a <w>favor</w> de la nueva propuesta para construir un parque."
                            }
                        },
                        {
                            "text": "After the scandal, the politician quickly fell out of <w>favour</w> with the public.",
                            "target_lang_translations": {
                                "ru": "После скандала политик быстро впал в <w>немилость</w> у общественности.",
                                "zh": "丑闻发生后，这位政客很快就失去了公众的<w>支持</w>。",
                                "nl": "Na het schandaal raakte de politicus snel uit de <w>gratie</w> bij het publiek.",
                                "pl": "Po skandalu polityk szybko stracił <w>przychylność</w> opinii publicznej.",
                                "de": "Nach dem Skandal verlor der Politiker schnell die <w>Gunst</w> der Öffentlichkeit.",
                                "fr": "Après le scandale, l'homme politique a rapidement perdu la <w>faveur</w> du public.",
                                "it": "Dopo lo scandalo, il politico ha rapidamente perso il <w>favore</w> del pubblico.",
                                "cs": "Po skandálu politik u veřejnosti rychle ztratil <w>přízeň</w>.",
                                "tr": "Skandaldan sonra siyasetçi halkın <w>gözünden</w> hızla düştü.",
                                "es": "Después del escándalo, el político rápidamente perdió el <w>favor</w> del público."
                            }
                        }
                    ],
