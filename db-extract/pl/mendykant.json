                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bettelmönch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d74bef43-ecc2-33ee-bb07-03cec3ca54f3",
                                        "entry_id": "8a378363-1e6d-36de-b258-27bc084c8889",
                                        "glosses": [
                                            "Mönch, der einem Bettelorden angehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0c57f4f-40c4-4370-8c56-77ee27490f21",
                                                "sense_id": "d74bef43-ecc2-33ee-bb07-03cec3ca54f3",
                                                "text": "„Die Wachen brachten uns wohlbehalten nach Lhasa, vierzehn Tage später erreichte ich die Bucht von Bengalen in Begleitung von rund fünfzig zerlumpten, abgemagerten Bettelmönchen aus den Tempeln obskurer indischer Dörfer.“"
                                            },
                                            {
                                                "example_id": "aff58681-7f50-4da8-a4db-a3fad676c928",
                                                "sense_id": "d74bef43-ecc2-33ee-bb07-03cec3ca54f3",
                                                "text": "„Dann machten sie sich wieder auf den Weg, gebeugt, die Kapuzen übergezogen und in ihren Lumpen zitternd wie Bettelmönche, die man ausgeschickt hatte, sich ihren Unterhalt zu suchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
