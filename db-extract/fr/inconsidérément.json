        "fr-extract.jsonl": [
            {
                "entry_id": "1466c825-dbaa-3a3c-8838-8f68ebfb31b6",
                "word": "inconsidérément",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e1bd248e-865e-312e-8e25-4160be9bb2a6",
                        "entry_id": "1466c825-dbaa-3a3c-8838-8f68ebfb31b6",
                        "glosses": [
                            "D’une manière inconsidérée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ff6d388-86ae-4f53-8c9a-1b7bacffa359",
                                "sense_id": "e1bd248e-865e-312e-8e25-4160be9bb2a6",
                                "text": "Robert Wells, animé du désir de venger la mort de son père, se précipita inconsidérément au milieu de l’armée du roi, où il fut enveloppé."
                            },
                            {
                                "example_id": "171f43aa-0784-4d17-949b-7d5201c4e738",
                                "sense_id": "e1bd248e-865e-312e-8e25-4160be9bb2a6",
                                "text": "Il a parlé inconsidérément, et il ne paraît point de sagesse dans ses discours."
                            },
                            {
                                "example_id": "f3910637-4f30-4766-b2f9-a2b83aefe1a2",
                                "sense_id": "e1bd248e-865e-312e-8e25-4160be9bb2a6",
                                "text": "L'abbé de Pont-carré me montra hier ce que vous lui écrivez sur le manteau donné inconsidérément [en cadeau à son valet]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d874297b-40b0-44b8-925c-d559737256f0",
                        "source_entry_id": "1466c825-dbaa-3a3c-8838-8f68ebfb31b6",
                        "source_sense_id": "e1bd248e-865e-312e-8e25-4160be9bb2a6",
                        "target_lang_word": "mindlessly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mindlessly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "56c73e85-a0f2-37c2-93df-eba68435ed2e",
                                        "entry_id": "6493abfb-32d5-3267-a9df-203b7341a540",
                                        "glosses": [
                                            "In a mindless manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bea7334-be76-46f6-a024-a0b108a1f4d6",
                                                "sense_id": "56c73e85-a0f2-37c2-93df-eba68435ed2e",
                                                "text": "For that is all there is: material atoms moving mindlessly in the beingless void of space."
                                            },
                                            {
                                                "example_id": "f5d312d6-bf9f-4e12-b8cc-75797b27777a",
                                                "sense_id": "56c73e85-a0f2-37c2-93df-eba68435ed2e",
                                                "text": "The Nanny is one of Pippa's favourite shows, but tonight the pleasure of mindlessly blobbing out in her usual Sunday-laid-back-luxury style..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8795c307-4dcd-40ae-8057-7e2a5910590b",
                        "source_entry_id": "1466c825-dbaa-3a3c-8838-8f68ebfb31b6",
                        "source_sense_id": "e1bd248e-865e-312e-8e25-4160be9bb2a6",
                        "target_lang_word": "rashly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rashly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76026db0-b58a-3271-ac62-81e806ed917d",
                                        "entry_id": "63102442-4ea9-3f8a-b9c8-f864203b25d7",
                                        "glosses": [
                                            "In a rash manner; hastily or without due consideration; with precipitation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c65d2b1-ee07-4d65-9160-ac7603728592",
                                                "sense_id": "76026db0-b58a-3271-ac62-81e806ed917d",
                                                "text": "Alas Wat, I haue kild the kings officer in ſtriking raſhly."
                                            },
                                            {
                                                "example_id": "7e5b75de-b258-4c55-8184-b7a9511f8276",
                                                "sense_id": "76026db0-b58a-3271-ac62-81e806ed917d",
                                                "text": "VVhy do you ſpeake ſo ſtartingly and raſhly."
                                            },
                                            {
                                                "example_id": "48569775-bfcb-4071-b68f-7e5c41474d5c",
                                                "sense_id": "76026db0-b58a-3271-ac62-81e806ed917d",
                                                "text": "[H]e'll say that we're contradicting what was said just now when we rashly maintain that there are falsehoods in judgements and statements."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "238b0dd0-2beb-48b9-8408-20457fd4a8cf",
                        "source_entry_id": "1466c825-dbaa-3a3c-8838-8f68ebfb31b6",
                        "source_sense_id": "e1bd248e-865e-312e-8e25-4160be9bb2a6",
                        "target_lang_word": "thoughtlessly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thoughtlessly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5aaac76-934d-3735-8545-bfde7458d420",
                                        "entry_id": "2e30de60-8757-3e90-96dc-e0f3fea755fa",
                                        "glosses": [
                                            "Done without thinking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51e9fcfb-479a-4bc8-8229-55e92b1ddfad",
                                                "sense_id": "a5aaac76-934d-3735-8545-bfde7458d420",
                                                "text": "He thoughtlessly invited her to come jogging, as he knew she hated exercise."
                                            },
                                            {
                                                "example_id": "9cf613fd-812b-45bd-bb9b-ba7290e59b16",
                                                "sense_id": "a5aaac76-934d-3735-8545-bfde7458d420",
                                                "text": "The railway ran through the resort's narrow streets up to Weymouth Quay station, with thoughtlessly parked vehicles sometimes having to be bumped out of the way."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f069aaa9-668e-421f-8edc-baa7018572d0",
                        "source_entry_id": "1466c825-dbaa-3a3c-8838-8f68ebfb31b6",
