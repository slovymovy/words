                        "sense_id": "4252886c-7c73-34c0-9c8b-38f0ac7ce9ad",
                        "entry_id": "b34c77c9-846f-3c72-b5a3-73766b54f74c",
                        "glosses": [
                            "Sac à dos souple fabriqué traditionnellement en feuilles de vacoa."
                        ],
                        "tags": [
                            "La Réunion"
                        ],
                        "examples": [
                            {
                                "example_id": "1adf4cf4-5770-4268-a785-f241efe06ab9",
                                "sense_id": "4252886c-7c73-34c0-9c8b-38f0ac7ce9ad",
                                "text": "Chacun transféra son cadavre dans un bertelle, un sac à dos en feuilles de vacoa tissées. Puis le groupe poursuivit sa route à la recherche d'une nouvelle couvée."
                            },
                            {
                                "example_id": "b275ec8b-ee82-484d-9f56-c6d4ea469620",
                                "sense_id": "4252886c-7c73-34c0-9c8b-38f0ac7ce9ad",
                                "text": "On sortit des bertelles et des tentes, toutes sortes de lames acérées, parfois rouillées, et l'on se jeta sans vergogne sur les nids."
                            },
                            {
                                "example_id": "e9242b7f-2c30-4d1c-bf36-937172d9029f",
                                "sense_id": "4252886c-7c73-34c0-9c8b-38f0ac7ce9ad",
                                "text": "Fontaine remplit son bertelle avec de la vaisselle en argent, et il trimballe déjà sur lui un goni plein de boîtes de conserve."
                            }
                        ]
                    }
