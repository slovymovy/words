            "senses": [
                {
                    "sense_id": "0ab3a5c7-5050-3b06-be17-afd49ad2e464",
                    "sense_definition": "Presque pas ; très peu (s'emploie généralement avec la négation « ne »).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quantite_faible",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis son installation à l'étranger, il ne donne <w>guère</w> de nouvelles à ses proches."
                        },
                        {
                            "text": "Cette explication confuse ne me paraît <w>guère</w> convaincante pour justifier un tel retard."
                        }
                    ],
                    "synonyms": [
                        "peu",
                        "à peine"
                    ],
                    "antonyms": [
                        "beaucoup"
                    ],
                    "common_phrases": [
                        "ne guère",
                        "guère plus"
                    ]
                },
                {
                    "sense_id": "6b95e4dd-6c89-3438-abfc-53b52d0184dd",
                    "sense_definition": "Associé à « que », exprime une restriction signifiant presque seulement ou uniquement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À cette heure tardive de la nuit, il n'y a <w>guère</w> que les taxis qui circulent encore."
                        },
                        {
                            "text": "Pour résoudre ce problème technique imprévu, je ne vois <w>guère</w> que cette solution."
                        }
                    ],
                    "synonyms": [
                        "seulement",
                        "uniquement"
                    ],
                    "common_phrases": [
                        "ne guère que",
                        "n'y avoir guère que"
                    ]
                },
                {
                    "sense_id": "c41f6e0d-11b0-3e4a-9e40-dd01ff3fb432",
                    "sense_definition": "De peu, d'une très faible marge ou quantité.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "quantite_faible",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'en est fallu de <w>guère</w> que nous ne manquions le dernier train pour Paris."
                        },
                        {
                            "text": "La collision a été évitée de <w>guère</w> grâce au freinage immédiat du conducteur."
                        }
                    ],
                    "synonyms": [
                        "de peu"
                    ],
                    "common_phrases": [
