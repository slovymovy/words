                "senses": [
                    {
                        "sense_id": "1b048e82-1460-3ad3-bcae-686e9dbe906b",
                        "entry_id": "cf8291f9-0902-33f4-800a-6e0efb811f8c",
                        "glosses": [
                            "Type de rossignol (le rossignol philomèle, Luscinia megarhynchos)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97d17cef-7f26-4aef-9734-134cf440b8d2",
                                "sense_id": "1b048e82-1460-3ad3-bcae-686e9dbe906b",
                                "text": "Loin de partager les affres des questionnants, des questionneurs de l’écriture, loin de prétendre que l’écriture est contrainte, fascisme ou répression (préférant même, quant à sa valeur de message, le chant-poème à l’aube du rossignol philomèle aux poèmes éclatés, émiettés, broyés, hachés d’une certaine et partielle poésie moderne), je dis qu’écrire ne fait pas qu’impliquer celui qui trace des graphes sur du papier d’une main plus ou moins habile, mais implique tout un réseau de lecteurs invisibles, répondant ou non à votre sollicitation, bref qu’il suffit de toucher aux mots, de les saisir, de les froisser pour faire lever images, messages et visages comme lorsqu’on prend à pleines mains une brassée, toute gorgée de soleil, de basilic ou d’origan."
                            },
                            {
                                "example_id": "75e85e29-2cf7-48f5-aaf2-d66caf3cf355",
                                "sense_id": "1b048e82-1460-3ad3-bcae-686e9dbe906b",
                                "text": "Nuit blanche, blanche de lune, lune de crème pour Octavio, et pas loin, presque sur la tête, le philomèle chantant."
                            },
                            {
                                "example_id": "30d7990f-e35c-4898-9058-1a67262cefbe",
                                "sense_id": "1b048e82-1460-3ad3-bcae-686e9dbe906b",
                                "text": "C’est un philomèle, sur cette photo."
                            }
                        ]
                    }
