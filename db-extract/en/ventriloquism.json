                        "target_lang_word": "ventriloquie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ventriloquie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a840503a-5979-3552-a541-2d583197f085",
                                        "entry_id": "45468137-31ca-38fd-ad92-ee4e3bd56f66",
                                        "glosses": [
                                            "Art du ventriloque."
                                        ],
                                        "tags": [
                                            "Prestidigitation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe7b82f8-8e0c-4023-8e7a-4f3d7d5b63a4",
                                                "sense_id": "a840503a-5979-3552-a541-2d583197f085",
                                                "text": "Forcé de faire la plénitude avec le vide, il appela à son secours une ventriloquie prodigieuse."
                                            },
                                            {
                                                "example_id": "9d4356f8-ba10-41f5-aa82-6af7776776b2",
                                                "sense_id": "a840503a-5979-3552-a541-2d583197f085",
                                                "text": "Il se trouve que la ventriloquie, la glossolalie, le fait de parler les langues des animaux, le fait de simplement parler « en langues », ne caractérisent qu’un membre du couple chamanique. Georges Charachidzé rapporte que les Géorgiens du Caucase nomment celui qui parle dans la transe le « linguiste », tandis qu’ils appellent celui dont la possession est visuelle le « porte-étendard »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03f76572-7d74-485c-bdd7-46c913eda4a1",
                        "source_entry_id": "76af86c5-73fb-3877-b968-d6c83085314b",
                        "source_sense_id": "146689b4-ac4e-3275-82dd-2869d8c308d8",
                        "source_sense_description": "art of projecting one's voice so that it appears to come from another source",
                        "target_lang_word": "Bauchreden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bauchreden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc30ac20-99de-3b6f-95ec-4a84e148f2cd",
                                        "entry_id": "2ef2cafc-3a2e-3989-9b99-04e88dd2a8d0",
                                        "glosses": [
                                            "Sprechen ohne sichtliche Mundbewegungen, meist so, dass es aussieht, als spreche eine bewegte Puppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e12c273-580f-4976-abe2-c5d81d2b4400",
                                                "sense_id": "bc30ac20-99de-3b6f-95ec-4a84e148f2cd",
                                                "text": "„Bauchreden ist eine kompakte und durchaus anstrengende Kunst.”"
                                            },
                                            {
                                                "example_id": "cb2e6d9b-1d24-419f-badb-d4e020fa3303",
                                                "sense_id": "bc30ac20-99de-3b6f-95ec-4a84e148f2cd",
                                                "text": "„Mit seiner Kombination aus Kabarett und Bauchreden war der Comedian richtig lustig bei seinem Gastspiel in Garching.“"
                                            },
                                            {
                                                "example_id": "3e66296c-0d31-4b66-9465-ec0df5b9f58e",
                                                "sense_id": "bc30ac20-99de-3b6f-95ec-4a84e148f2cd",
                                                "text": "„‚Bauchreden ist zwar physikalisch erklärbar, erfordert jedoch eine jahrelange Übung und verliert nichts von seiner Faszination‘, lautet ihr Fazit.“"
                                            },
                                            {
                                                "example_id": "4ad510db-4274-4db9-8c7e-ba81e675bf60",
                                                "sense_id": "bc30ac20-99de-3b6f-95ec-4a84e148f2cd",
                                                "text": "„Die Illusion des Bauchredens wirkt durch das Hinzuziehen einer Handpuppe noch verstärkt. Diese lenkt das Publikum ab, weil sich die Menschen automatisch auf die Puppe und deren Mundbewegungen konzentrieren.“"
                                            },
                                            {
                                                "example_id": "af5b709a-081e-45b3-8a27-1781c04b38b2",
                                                "sense_id": "bc30ac20-99de-3b6f-95ec-4a84e148f2cd",
                                                "text": "„Die Schauspieler, die die Technik des Bauchredens eigens für diese Produktion in Workshops gelernt haben, sprechen sich mit ihren echten Vornamen an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2fc18123-1a3b-429b-be8a-4ab37957e9c3",
                        "source_entry_id": "76af86c5-73fb-3877-b968-d6c83085314b",
                        "source_sense_id": "146689b4-ac4e-3275-82dd-2869d8c308d8",
                        "source_sense_description": "art of projecting one's voice so that it appears to come from another source",
                        "target_lang_word": "Bauchredekunst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bauchredekunst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "96266237-b559-3851-9699-5312c7d80886",
                                        "entry_id": "45ea00e2-41e2-33d9-bbdc-edaaf5ff9593",
                                        "glosses": [
                                            "Fähigkeit, ohne sichtliche Mundbewegungen zu sprechen, meist so, dass es aussieht, als spreche eine bewegte Puppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "782adce7-700d-4cbd-925b-39f677492f2f",
                                                "sense_id": "96266237-b559-3851-9699-5312c7d80886",
                                                "text": "„Seit über 15 Jahren steht der Berliner auf der Bühne und verbindet dabei Bauchredekunst, Comedy und Zauberei zu einem Programm, das von den wunderlichsten Figuren begleitet wird.“"
                                            },
                                            {
                                                "example_id": "5e00f7e9-eefd-4159-8175-082a8e47fe70",
                                                "sense_id": "96266237-b559-3851-9699-5312c7d80886",
                                                "text": "„Ähnlich witzig ist die Szene zwischen dem als Türken verkleideten Koltschitzky, der auch die Bauchredekunst beherrscht, und seiner Frau, wo die erschrockene Dame ihn mit Würstel, Schnaps und Zigarren (‚Stinkadores‘!) zu versöhnen trachtet (III, 6).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "888d49fa-3174-4aa4-9fba-0431aad1d784",
                        "source_entry_id": "76af86c5-73fb-3877-b968-d6c83085314b",
                        "source_sense_id": "146689b4-ac4e-3275-82dd-2869d8c308d8",
                        "source_sense_description": "art of projecting one's voice so that it appears to come from another source",
                        "target_lang_word": "Bauchrednerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bauchrednerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3edbebc8-514b-3d7b-9a6e-1be59714a623",
                                        "entry_id": "93d626fe-b25d-3aac-9023-1e9606ce1cd1",
                                        "glosses": [
                                            "Sprechen ohne sichtliche Mundbewegungen, meist so, dass es aussieht, als spreche eine bewegte Puppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63eaa395-5965-4384-9215-ae4c461a67f7",
                                                "sense_id": "3edbebc8-514b-3d7b-9a6e-1be59714a623",
                                                "text": "„Für seine Mischung aus Bauchrednerei und Comedy wurde Benjamin Tomkins vielfach mit Comedypreisen ausgezeichnet.“"
                                            },
                                            {
                                                "example_id": "c18296bf-3c7c-4d09-a634-ae6f4aca3ed2",
                                                "sense_id": "3edbebc8-514b-3d7b-9a6e-1be59714a623",
                                                "text": "„Diese Stimme kann sich sehr gut verstellen und beherrscht alle Tricks der Bauchrednerei.“"
                                            },
                                            {
                                                "example_id": "f6cbb79a-4ccd-4617-aff6-e65e4d1c1fe0",
                                                "sense_id": "3edbebc8-514b-3d7b-9a6e-1be59714a623",
                                                "text": "„In konzeptueller Hinsicht gefiel mir die Idee der Bauchrednerei sehr, die Vorstellung, durch Stellvertreter des eigenen Ich sprechen zu können, ohne die Verantwortung für ihre Gedanken und Handlungen übernehmen zu müssen.“"
                                            },
                                            {
                                                "example_id": "18443610-e730-4886-b1f2-d1af6d768369",
                                                "sense_id": "3edbebc8-514b-3d7b-9a6e-1be59714a623",
                                                "text": "„Mein Bemühen gipfelte in der (so plakativen wie provokativen) Frage, ob Schlingensiefs Theater uns jenseits seiner Wünschelrutengänge und Bauchrednereien noch etwas zu sagen habe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
