                        "examples": [
                            {
                                "example_id": "87cdf9d3-e805-4256-be1d-2fc3d9aef2f5",
                                "sense_id": "3d216911-5beb-3c40-ad2e-a450cc30e90d",
                                "text": "Qu’il soit installé sur la terrasse ou bien en vedette dans la cour arrière, le gazebo est l’incarnation même des soirées d’été en beauté et en confort."
                            },
                            {
                                "example_id": "0a320219-1fe1-4b52-8643-a43950870618",
                                "sense_id": "3d216911-5beb-3c40-ad2e-a450cc30e90d",
                                "text": "Représentez-vous un de ces bois que les grandes villes s’enorgueillissent de préserver enkystés dans leur enceinte : vestige dernier (ou simulacre ultime) de l’inhumaine nature que la cité a grignotée puis enchâsse, sertie d’allées, de clairières, de kiosques à musique, de gazebos pittoresques…."
                            }
                        ]
                    }
