                        "sense_id": "135971ea-2817-3209-a588-bce5c56336ae",
                        "entry_id": "b182a4b9-6e51-390d-9223-c1d5e091de93",
                        "glosses": [
                            "een laag gedroogd, glimmend en hard geworden verf of email"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdadad18-dfa7-475c-9d45-0cccd4423eee",
                                "sense_id": "135971ea-2817-3209-a588-bce5c56336ae",
                                "text": "Bouwvak of geen bouwvak: bij het Montessori College wordt al weken hard gewerkt. De complete buitenkant van de school op het Scholeneiland bij de Sloetsweg wordt voorzien van een nieuwe laklaag."
                            },
                            {
                                "example_id": "8621d986-5fd2-448e-9ff6-f70cbabea761",
                                "sense_id": "135971ea-2817-3209-a588-bce5c56336ae",
                                "text": "Allereerst zullen robots zelfstandige belangen moeten ontwikkelen, dus niet het soort belang dat een auto heeft bij een nieuwe laklaag. De robot moet een doel-in-zichzelf worden, waarmee het goed of slecht kan gaan. Niet goed of slecht voor iemand anders dan de robot, maar voor de robot zelf."
                            }
                        ]
                    }
