                "senses": [
                    {
                        "sense_id": "0874639d-4c2f-3604-97f7-50d051eba103",
                        "entry_id": "d8d0451b-24f3-395d-b913-1fbcb0436ee9",
                        "glosses": [
                            "Eigenschaft des Daseins, Substanz zu haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02aa48ce-8b2f-4648-83f4-09c8626a3a75",
                                "sense_id": "0874639d-4c2f-3604-97f7-50d051eba103",
                                "text": "„Und der Bereich der bloßen Vorstellungen erwächst aus dem Bereich der Abbilder und dem Bereich der Wirklichkeit und er kann auch einiges von deren Substanzialität haben.“"
                            },
                            {
                                "example_id": "dbb95686-e07f-4a4a-b7dd-3d51bc2fbb81",
                                "sense_id": "0874639d-4c2f-3604-97f7-50d051eba103",
                                "text": "„Wenn wir den Intellekt ‚Substanz‘ oder ‚Individuum‘ oder ‚Ursache‘ nennen, so besteht seine Substanzialität, Individualität und Kausalität weder in einer bruchlosen Ausweitung der empirischen Substanzialität, Individualität und Kausalität noch in deren vage bleibender Verneinung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8952b5f2-3c39-3c0b-a0c8-5f1c17581d23",
                        "entry_id": "d8d0451b-24f3-395d-b913-1fbcb0436ee9",
                        "glosses": [
                            "Eigenschaft, wesentlich, bedeutend (substantiell) zu sein, die Substanz zu betreffen"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "829f97c4-1288-45e1-891d-77c178d76b72",
                                "sense_id": "8952b5f2-3c39-3c0b-a0c8-5f1c17581d23",
                                "text": "„Dass die Substanzialität der Kultur, und zwar als ganze, sich historisch-technisch-medial verändern könnte, kommt ihr nicht in den Sinn.“"
                            },
                            {
                                "example_id": "2e8959b2-01b2-418a-80f4-e06842d59c36",
                                "sense_id": "8952b5f2-3c39-3c0b-a0c8-5f1c17581d23",
                                "text": "„Eine solche Art und Weise der Kommunikation funktioniert nur über das von den Kommunikationspartnern geteilte Vorverständnis über die Substanzialität der Kategorie Homosexualität.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
