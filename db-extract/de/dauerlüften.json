                "senses": [
                    {
                        "sense_id": "482cffef-4b89-33dd-aaf8-9850624f99a7",
                        "entry_id": "30d44cad-fb47-3365-b1d8-fca03e51c1da",
                        "glosses": [
                            "durch eine unverschlossene Öffnung übermäßig lüften"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df26a4b8-3b14-4b7e-a8c1-0df745d9ac11",
                                "sense_id": "482cffef-4b89-33dd-aaf8-9850624f99a7",
                                "text": "„Falsches Lüften: Lüften Sie immer nur kurze Zeit (5 bis 10 Minuten), denn durch das Dauerlüften in Kippstellung erreichen Sie keinen Luftaustausch, die Wände kühlen aus und Sie verschwenden Heizenergie.“"
                            },
                            {
                                "example_id": "205e8154-6496-4f2e-86f0-d1c556b03ce7",
                                "sense_id": "482cffef-4b89-33dd-aaf8-9850624f99a7",
                                "text": "„Die Faustregel lautet also: Im Sommer wird der Keller durch Dauerlüften immer feuchter - und - im Winter wird der Keller durch Dauerlüften immer trockener!“"
                            },
                            {
                                "example_id": "b9e5e12e-ef90-474a-a019-ec6a65b5eb1d",
                                "sense_id": "482cffef-4b89-33dd-aaf8-9850624f99a7",
                                "text": "„Um Räume richtig zu lüften sollte auf ein Dauerlüften durch Kippstellung der Fenster verzichtet werden.“"
                            },
                            {
                                "example_id": "63558450-a401-4255-9f23-9c6ecd1b3e0c",
                                "sense_id": "482cffef-4b89-33dd-aaf8-9850624f99a7",
                                "text": "„Verzichten Sie auf das Dauerlüften durch das Kippen eines oder mehrerer Fenster!“ „Dauerlüften kühlt die Fensterlaibung aus und erhöht dort die Schimmelgefahr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
