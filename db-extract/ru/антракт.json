                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f158aa43-54f5-4642-9c21-41451bf5ba09",
                                "sense_id": "47168838-a3b7-3532-b315-87d11dccf6cf",
                                "text": "— Па́па! — обрати́лась она́ к отцу́ в после́днем антра́кте. — Пойди́ на сце́ну и скажи́ им всем, что́бы приходи́ли к нам за́втра обе́дать!",
                                "translation": "\"Papa!\" she said to the police captain during the last interval, \"go behind the scenes and ask them all to dinner to-morrow!\"",
                                "english": "\"Papa!\" she said to the police captain during the last interval, \"go behind the scenes and ask them all to dinner to-morrow!\""
                            }
                        ]
