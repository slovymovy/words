                                "example_id": "4d6a68f7-8336-467f-8015-62f1a891d9c5",
                                "sense_id": "bf145d60-69a7-378d-8137-ccc2df6f432c",
                                "text": "„Das Bettelweib saß noch lange auf der Erde, nachdem er verschwunden, und fingerte geistesabwesend an dem Speziestaler.“"
                            },
                            {
                                "example_id": "7ae2b0f7-097f-4355-898e-4ee130f45569",
                                "sense_id": "bf145d60-69a7-378d-8137-ccc2df6f432c",
                                "text": "„Seine Mutter, ein Bettelweib, brachte ihn jeden Morgen zu ihnen.“"
                            }
                        ],
