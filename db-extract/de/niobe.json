                ],
                "senses": [
                    {
                        "sense_id": "b81de3de-2df7-34ae-889c-4ff57e3fad0b",
                        "entry_id": "9a8025e3-320b-3171-85dd-72e58a713882",
                        "glosses": [
                            "Tochter des Tantalus und Gemahlin des thebanischen Königs Amphion, deren sieben Söhne und sieben Töchter von Apollo und Diana getötet wurden"
                        ],
                        "tags": [
                            "griechische Mythologie"
                        ],
                        "examples": [
                            {
                                "example_id": "054cafde-5909-49f8-ad98-21dba27cf8ab",
                                "sense_id": "b81de3de-2df7-34ae-889c-4ff57e3fad0b",
                                "text": "Auch hieß Niobe unter allen Müttern die glücklichste, und sie wäre es gewesen, wenn sie nur sich selbst nicht dafür gehalten hätte; so aber wurde das Bewußtsein ihres Glückes ihr Verderben."
                            },
                            {
                                "example_id": "33b67736-38a1-47fb-8ff1-1faf56c2e86d",
                                "sense_id": "b81de3de-2df7-34ae-889c-4ff57e3fad0b",
                                "text": "Als nun die Thebanerinnen zusammenströmten, kam auf einmal Niobe im Schwarm eines königlichen Gefolges, mit einem golddurchwirkten Gewande angetan, prunkend einhergerauscht."
                            },
                            {
                                "example_id": "d0d06e1b-a909-4582-9426-55f8076c82fc",
                                "sense_id": "b81de3de-2df7-34ae-889c-4ff57e3fad0b",
                                "text": "Niobe vermochte lange das Schreckliche nicht zu fassen; …"
                            },
                            {
                                "example_id": "17861b43-b91b-42d8-97ba-8d43894c7cf5",
                                "sense_id": "b81de3de-2df7-34ae-889c-4ff57e3fad0b",
                                "text": "Aber während sie noch flehte, stürzte schon das Kind aus ihrem Schoße nieder, und einsam saß Niobe zwischen ihres Gatten, ihrer Söhne und ihrer Töchter Leichen."
                            },
                            {
                                "example_id": "4ec05496-13e0-46db-b809-2067eb89e697",
                                "sense_id": "b81de3de-2df7-34ae-889c-4ff57e3fad0b",
                                "text": "Hier haftete Niobe als ein Marmorfelsen am Gipfel des Berges, und noch jetzt zerfließt der Marmor in Tränen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
