                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "2d00f8d2-9ac0-4431-840e-1419b02601eb",
                                "sense_id": "22d06b5f-59f5-359a-b46c-35b23d617aba",
                                "text": "De politie is op zoek naar getuigen van de overval gisteren.",
                                "translation": "The police are looking for witnesses to the robbery yesterday.",
                                "english": "The police are looking for witnesses to the robbery yesterday."
                            },
                            {
                                "example_id": "45c8aec1-50de-4d44-a583-a57af163a3ba",
                                "sense_id": "22d06b5f-59f5-359a-b46c-35b23d617aba",
                                "text": "Tijdens de overval werd veel geld gestolen.",
                                "translation": "A lot of money was stolen during the hold-up.",
                                "english": "A lot of money was stolen during the hold-up."
                            },
                            {
                                "example_id": "d3c6e1fb-a5d2-4b6a-a68e-6b080a8dbaeb",
                                "sense_id": "22d06b5f-59f5-359a-b46c-35b23d617aba",
                                "text": "Het winkeltje had vorig jaar ook een overvalletje.",
                                "translation": "The small shop also had a little robbery last year.",
                                "english": "The small shop also had a little robbery last year."
                            }
                        ]
                    }
                ],
