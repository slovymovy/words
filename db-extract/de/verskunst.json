                                "example_id": "d982f2dc-6a24-4762-b498-183621197d66",
                                "sense_id": "3d007962-aae5-36fd-9f76-4900244b9f82",
                                "text": "„Erwachsene genießen das kontrastreiche Zusammenspiel zwischen virtuoser Karikatur und einfallsreicher Verskunst.“"
                            },
                            {
                                "example_id": "89fa639e-9625-49d6-98fc-c26bb4e41f70",
                                "sense_id": "3d007962-aae5-36fd-9f76-4900244b9f82",
                                "text": "„Verskunst ist zweisinnig, und wer da im Sessel stumm vor sich hin liest, mag sich feinsinnig vorkommen, allein, er versteht seine Lektüre nicht.“"
                            }
