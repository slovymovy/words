                    }
                ],
                "senses": [
                    {
                        "sense_id": "e77ff79a-7ff4-3377-9b04-2f601547999c",
                        "entry_id": "8c038b3a-cfcd-3282-81dc-c3bdd71f115a",
                        "glosses": [
                            "rasowy koń wierzchowy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "faceb8e2-4bb9-4632-904d-977a1512813b",
                                "sense_id": "e77ff79a-7ff4-3377-9b04-2f601547999c",
                                "text": "A jednak stało się! Powiedziałem tej bladolicej dziewczynie, że ją kocham, i jutro slę mego groma Leonarda na siwym rumaku do jej babki z epistołą błagającą, aby wstawiła się za mną do jej matki etc., etc., aby na koniec rączka panny Wacławy została własnością twego wiernego sługi."
                            },
                            {
                                "example_id": "c0ce028f-a54f-4c59-ae29-313c8e8ae973",
                                "sense_id": "e77ff79a-7ff4-3377-9b04-2f601547999c",
                                "text": "W połowie miesiąca boska Selene kąpie się w Oceanie i ubrana w szaty świetliste, zaprzęga jasne rumaki do wozu, z którego lecą dalekie promienie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "87321dab-7a74-3773-97d5-474d5fbbc8a0",
                        "entry_id": "8c038b3a-cfcd-3282-81dc-c3bdd71f115a",
                        "glosses": [
                            "koń bojowy pochodzący z europejskiej części Turcji"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a1dd19a-b297-42a9-9374-cd7a4da798ad",
                        "source_entry_id": "8c038b3a-cfcd-3282-81dc-c3bdd71f115a",
                        "source_sense_id": "e77ff79a-7ff4-3377-9b04-2f601547999c",
                        "target_lang_word": "steed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "steed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb00ffa2-9d4d-3174-91a9-fef12c2a7997",
                                        "entry_id": "a12d01fd-9ec5-3b1f-b5dd-e35582cffae7",
                                        "glosses": [
                                            "A stallion, especially one used for riding."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85e0487e-3cd2-4685-b56c-c0bfcef94f3e",
                                                "sense_id": "cb00ffa2-9d4d-3174-91a9-fef12c2a7997",
                                                "text": "The studded bridle on a ragged bough\nNimbly she fastens: -- O, how quick is love! --\nThe steed is stalled up, and even now\nTo tie the rider she begins to prove:\nBackward she push'd him, as she would be thrust,\nAnd govern'd him in strength, though not in lust."
                                            },
                                            {
                                                "example_id": "d9b3f74e-6608-409d-a343-80b7bce4d10f",
                                                "sense_id": "cb00ffa2-9d4d-3174-91a9-fef12c2a7997",
                                                "text": "The torch-eyed ſavage, with growl tremendous, riſing up, diſlocated at one blow the arched neck of Sadit's Arabian ſteed, and brought the unfortunate omrah to the duſt, expiring between his extended claws."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "517c2912-e661-3247-bb53-59d177d1424b",
                                        "entry_id": "a12d01fd-9ec5-3b1f-b5dd-e35582cffae7",
                                        "glosses": [
                                            "A bicycle."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fb2b412-4dab-4536-956a-24ac02fcaacf",
                                                "sense_id": "517c2912-e661-3247-bb53-59d177d1424b",
                                                "text": "silent steed"
                                            },
                                            {
                                                "example_id": "644c65d9-790f-42c4-8aa1-fef8e8e75a2e",
                                                "sense_id": "517c2912-e661-3247-bb53-59d177d1424b",
                                                "text": "In the green lanes of Merrie England the bicycle rider in his natty uniform, speeding along on his silent steed, is met with almost as often as vehicles drawn by horses, and it is safe to say that in the various countries of the world not less than half a million bicycles and tricycles are now in use."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17d13a8f-a59f-4442-9993-02bf9610483b",
                        "source_entry_id": "8c038b3a-cfcd-3282-81dc-c3bdd71f115a",
                        "source_sense_id": "e77ff79a-7ff4-3377-9b04-2f601547999c",
                        "target_lang_word": "courser",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "courser",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f30ca523-9ede-3de3-a4e5-610cca1e8fe9",
                                        "entry_id": "48df40bd-07d1-3bb9-8fd7-c701e6788331",
                                        "glosses": [
                                            "A dog used for coursing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2b84a929-8a4f-3674-a759-c29afa9245c4",
                                        "entry_id": "48df40bd-07d1-3bb9-8fd7-c701e6788331",
                                        "glosses": [
                                            "A hunter who practises coursing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7de5e388-9e86-334a-baaf-67e0f4ce9062",
                                        "entry_id": "48df40bd-07d1-3bb9-8fd7-c701e6788331",
                                        "glosses": [
                                            "A swift horse; a racehorse or a charger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a15acb5-467e-43f0-ae9c-2dcfd20fb786",
                                                "sense_id": "7de5e388-9e86-334a-baaf-67e0f4ce9062",
                                                "text": "Sir Launfal is instantly set at liberty, and vaulting on the courser his mistress had bestowed on him, and which was held at hand by his squire, he follows her out of the town."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ae770f2-f914-320f-8fd6-14db3e5e0250",
                                        "entry_id": "48df40bd-07d1-3bb9-8fd7-c701e6788331",
                                        "glosses": [
                                            "Any of several species of terrestrial bird in the genera Cursorius and Rhinoptilus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "07e8d295-4a7f-394a-a48c-b80d2ca3a6b9",
                                        "entry_id": "48df40bd-07d1-3bb9-8fd7-c701e6788331",
                                        "glosses": [
                                            "A stone used in building a course."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58ac39a6-7b9d-4735-81b8-ecbe47dcd16c",
                        "source_entry_id": "8c038b3a-cfcd-3282-81dc-c3bdd71f115a",
                        "source_sense_id": "e77ff79a-7ff4-3377-9b04-2f601547999c",
                        "target_lang_word": "скаку́н",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "скаку́н",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4c8c3487-adc9-3e8b-9075-a55ccfdebd31",
                                        "entry_id": "518d42a6-ed63-3b50-987a-e7e7581469f1",
                                        "glosses": [
                                            "высок. то же, что конь"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b093886-9ae8-40fe-bb31-932c0663f695",
                                                "sense_id": "4c8c3487-adc9-3e8b-9075-a55ccfdebd31",
                                                "text": "Князь превзошёл в этот раз самого себя: впереди всех проскакал он верхом по улицам голый, в чём мать родила, и как скакун под ним был арабский, чистейшей крови, то в погоне за ним полицейские, как ни ухищрялись, а не могли поймать шалуна."
                                            },
                                            {
                                                "example_id": "6efdba0c-4460-4c30-ad82-c95e22b87f50",
                                                "sense_id": "4c8c3487-adc9-3e8b-9075-a55ccfdebd31",
                                                "text": "— Славная у тебя лошадь! — говорил Азамат, — если бы я был хозяин в доме и имел табун в триста кобыл, то отдал бы половину за твоего скакуна, Казбич!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "308a6fd7-501a-3493-a463-18774d181cae",
                                        "entry_id": "518d42a6-ed63-3b50-987a-e7e7581469f1",
                                        "glosses": [
                                            "перен., шутл. средство передвижения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18ffdef1-f9f8-480b-a27e-bd2d0b1c2b69",
                                                "sense_id": "308a6fd7-501a-3493-a463-18774d181cae",
                                                "text": "Илья поблагодарил его, выкатил мотоцикл на улицу и сел за руль. Он хорошо понимал возбуждение семнадцатилетнего парня, готовившегося оседлать такого резвого скакуна."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ceb9e4ad-5147-3e29-8b75-1b57efee3d10",
                                        "entry_id": "518d42a6-ed63-3b50-987a-e7e7581469f1",
                                        "glosses": [
                                            "полит. жарг. противник власти, ставящий целью свалить её, и не имеющий программы, что делать дальше (в честь фразы «Кто не скачет, тот москаль»)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e174eb1-b807-45e2-85ca-c706357769c1",
                        "source_entry_id": "8c038b3a-cfcd-3282-81dc-c3bdd71f115a",
                        "source_sense_id": "e77ff79a-7ff4-3377-9b04-2f601547999c",
                        "target_lang_word": "конь",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "конь",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2ab1c369-a4c7-3b69-850b-c04ada32dfb3",
                                        "entry_id": "63224238-4531-3383-9dfe-bb6635e002dd",
                                        "glosses": [
                                            "лошадь, обычно самец"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e36ecd6-2ed6-47f2-8ba7-19ce2ad9e46e",
                                                "sense_id": "2ab1c369-a4c7-3b69-850b-c04ada32dfb3",
                                                "text": "Конь фыркал, переступал ногами и махал опененною мордой."
                                            },
                                            {
                                                "example_id": "851ea3de-ee47-4e3b-8a35-22d3d0c9f7b4",
                                                "sense_id": "2ab1c369-a4c7-3b69-850b-c04ada32dfb3",
                                                "text": "Стражник на гнедом коне поскакал во весь опор к перевозу."
                                            },
                                            {
                                                "example_id": "61799ded-33c2-455c-b9eb-95d9c5e2ed92",
                                                "sense_id": "2ab1c369-a4c7-3b69-850b-c04ada32dfb3",
                                                "text": "Григорий поспешно соскочил с седла, взял коня под уздцы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2a8cfff-dbf5-3b87-adff-da1a112c63e3",
                                        "entry_id": "63224238-4531-3383-9dfe-bb6635e002dd",
                                        "glosses": [
                                            "шахм. шахматная фигура, единственная из всех, ходящая не по прямой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46991e08-eb13-4681-8da2-cbc80f393481",
                                                "sense_id": "c2a8cfff-dbf5-3b87-adff-da1a112c63e3",
                                                "text": "Я вам могу дать вперёд коня и пешку."
                                            },
                                            {
                                                "example_id": "c44b4218-352d-42fc-8c1f-3884a2fe390c",
                                                "sense_id": "c2a8cfff-dbf5-3b87-adff-da1a112c63e3",
                                                "text": "Аронян, играя белыми с Леко, не получил в партии ничего особенного, но тут нервы венгерского гроссмейстера сдали, он некорректно пожертвовал коня и был за это наказан."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbd497a7-bd5c-354a-93c7-a50e3c57b838",
                                        "entry_id": "63224238-4531-3383-9dfe-bb6635e002dd",
                                        "glosses": [
                                            "спорт. гимнастический снаряд в виде мягкого бруса на четырёх ногах-опорах"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e28fa48-d8ef-4f1b-b897-67997db1a062",
                                                "sense_id": "cbd497a7-bd5c-354a-93c7-a50e3c57b838",
                                                "text": "Начинали выступления с упражнений на коне. Как говорили в советские времена — контрольно-пропускного пункта гимнастики."
                                            },
                                            {
                                                "example_id": "544f494b-3b2c-4822-a2f2-7a67482ce003",
                                                "sense_id": "cbd497a7-bd5c-354a-93c7-a50e3c57b838",
                                                "text": "В школе на уроках физкультуры не нужно заставлять детей скакать через коня — вместо этого надо прививать им навыки здорового образа жизни."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "052276d3-55a0-3f5e-a1f2-0b7b7f3c4ae2",
                                        "entry_id": "63224238-4531-3383-9dfe-bb6635e002dd",
                                        "glosses": [
                                            "крим. жарг., устар. ложка"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fe675d63-1ae3-3f4b-ad85-6443c4262dcf",
                                        "entry_id": "63224238-4531-3383-9dfe-bb6635e002dd",
                                        "glosses": [
                                            "крим. жарг. трамвай"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c0774d5d-b265-3a7f-9895-7bd988ae0718",
                                        "entry_id": "63224238-4531-3383-9dfe-bb6635e002dd",
                                        "glosses": [
                                            "крим. жарг. отец"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac621033-6526-3dea-b8b3-c6548ec52dcc",
                                        "entry_id": "63224238-4531-3383-9dfe-bb6635e002dd",
                                        "glosses": [
                                            "крим. жарг. приспособление в виде удочки для передачи мелких предметов из одной камеры в другую"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4df68841-0b7d-4b25-9f07-24363c8dceeb",
                                                "sense_id": "ac621033-6526-3dea-b8b3-c6548ec52dcc",
                                                "text": "Конь — это верёвка, при помощи которой передаётся информация в записках («малява», «муля») и различные презенты («груза»), в том числе и запретные («запреты»)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ba81e04-54dd-3182-ac77-c8afc9575c58",
                                        "entry_id": "63224238-4531-3383-9dfe-bb6635e002dd",
                                        "glosses": [
                                            "спорт. жарг., пренебр. болельщик или игрок футбольной команды ЦСКА"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
