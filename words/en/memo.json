{
    "word_family": [
        "memorandum",
        "memorize",
        "memory",
        "memorial"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7bca29a6-ea3e-3d88-96f1-4ebe39d6dd64",
                    "sense_definition": "A short written message or note, especially one used for communication within an organization.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager sent a <w>memo</w> to all employees regarding the new office policy.",
                            "target_lang_translations": {
                                "ru": "Менеджер разослал всем сотрудникам <w>служебную записку</w> относительно новых правил внутреннего распорядка."
                            }
                        },
                        {
                            "text": "I need to write an internal <w>memo</w> to update the team on our progress.",
                            "target_lang_translations": {
                                "ru": "Мне нужно написать внутреннюю <w>записку</w>, чтобы проинформировать команду о наших успехах."
                            }
                        }
                    ],
                    "synonyms": [
                        "note",
                        "memorandum",
                        "message"
                    ],
                    "common_phrases": [
                        "internal memo",
                        "write a memo",
                        "leaked memo",
                        "office memo"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткое письменное сообщение или заметка, используемая для общения внутри организации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "служебная записка",
                                "target_lang_sense_clarification": "официальное сообщение внутри компании"
                            },
                            {
                                "target_lang_word": "меморандум",
                                "target_lang_sense_clarification": "официальный документ или памятная записка"
                            },
                            {
                                "target_lang_word": "записка",
                                "target_lang_sense_clarification": "краткое сообщение"
                            },
                            {
                                "target_lang_word": "памятка",
                                "target_lang_sense_clarification": "краткие наставления или напоминание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdb501e6-6ea1-3d8e-89e2-a88dd9f4e1fa",
                    "sense_definition": "A record of partial results in computing that can be reused later to avoid recomputation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The algorithm checks the <w>memo</w> to see if the subproblem has already been solved.",
                            "target_lang_translations": {
                                "ru": "Алгоритм проверяет <w>мемо</w>, чтобы узнать, была ли подзадача уже решена."
                            }
                        },
                        {
                            "text": "Storing results in a <w>memo</w> significantly improves the performance of the recursive function.",
                            "target_lang_translations": {
                                "ru": "Хранение результатов в <w>кэше</w> значительно повышает производительность рекурсивной функции."
                            }
                        }
                    ],
                    "synonyms": [
                        "cache"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Запись промежуточных результатов вычислений, которая может быть использована повторно для повышения производительности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мемо",
                                "target_lang_sense_clarification": "в контексте мемоизации в программировании"
                            },
                            {
                                "target_lang_word": "кэш",
                                "target_lang_sense_clarification": "сохраненный результат вычислений"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "85fc0122-3f37-3eb9-950d-d6a98add58cf",
                    "sense_definition": "To send a written note or memorandum to someone, typically for official record-keeping.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will <w>memo</w> the staff about the upcoming changes to the schedule.",
                            "target_lang_translations": {
                                "ru": "Я <w>уведомлю</w> персонал <w>служебной запиской</w> о предстоящих изменениях в расписании."
                            }
                        },
                        {
                            "text": "The supervisor decided to <w>memo</w> him regarding the client complaints.",
                            "target_lang_translations": {
                                "ru": "Руководитель решил <w>направить</w> ему <w>официальное уведомление</w> по поводу жалоб клиентов."
                            }
                        }
                    ],
                    "synonyms": [
                        "notify",
                        "inform"
                    ],
                    "common_phrases": [
                        "memo the staff"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отправить письменную заметку или меморандум кому-либо, обычно для официального учета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уведомлять служебной запиской",
                                "target_lang_sense_clarification": "официально информировать"
                            },
                            {
                                "target_lang_word": "направить меморандум",
                                "target_lang_sense_clarification": "письменно известить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "181915f8-3172-33dd-a0cf-60fa20e43c9d",
                    "sense_definition": "To record or make a formal note of something.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "recording",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>memo</w> these findings so we can refer to them during the meeting.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>задокументируйте</w> эти выводы, чтобы мы могли сослаться на них во время встречи."
                            }
                        },
                        {
                            "text": "It is important to <w>memo</w> every transaction for the annual audit.",
                            "target_lang_translations": {
                                "ru": "Важно <w>фиксировать</w> каждую транзакцию для ежегодного аудита."
                            }
                        }
                    ],
                    "synonyms": [
                        "record",
                        "note",
                        "document"
                    ],
                    "target_lang_definitions": {
                        "ru": "Записать или сделать официальную пометку о чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заносить в протокол",
                                "target_lang_sense_clarification": "официально фиксировать"
                            },
                            {
                                "target_lang_word": "документировать",
                                "target_lang_sense_clarification": "делать запись для учета"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}