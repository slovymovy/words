                "senses": [
                    {
                        "sense_id": "9a262d2f-f58b-3efe-85b3-a7ceed3df0a7",
                        "entry_id": "d287249e-8acc-39d1-842e-715557286300",
                        "glosses": [
                            "Enlever sa cigarette à quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23883dbe-9483-44d5-baa1-4a7a38001d45",
                                "sense_id": "9a262d2f-f58b-3efe-85b3-a7ceed3df0a7",
                                "text": "Rappelons que Malraux s'est fait décloper sur un timbre, Lucky Luke coller un brin d'herbe dans la bouche, Sartre décloper idem."
                            }
                        ]
                    },
                    {
                        "sense_id": "36854a9c-260a-3da8-b150-2a0619430c64",
                        "entry_id": "d287249e-8acc-39d1-842e-715557286300",
                        "glosses": [
                            "Arrêter de fumer."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c9d7c836-6791-4367-a0a4-14454353208b",
                                "sense_id": "36854a9c-260a-3da8-b150-2a0619430c64",
                                "text": "Je profite du printemps et de la fête pascale de la résurrection pour décloper : deux hier, une aujourd'hui."
                            },
                            {
                                "example_id": "f1b536ae-65d3-4880-9e53-96ebab18ce68",
                                "sense_id": "36854a9c-260a-3da8-b150-2a0619430c64",
                                "text": "Il faut pas oublier que c'est vraiment pas facile de décloper."
                            },
                            {
                                "example_id": "8ca86f7f-7500-4baf-b42b-87237b6776e0",
                                "sense_id": "36854a9c-260a-3da8-b150-2a0619430c64",
                                "text": "la musique fait décloper?"
                            }
                        ]
                    }
