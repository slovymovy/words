                "senses": [
                    {
                        "sense_id": "654c756d-6273-344d-ab8d-10e65a67fa4b",
                        "entry_id": "78177dd0-fbd6-31ad-9328-0de7f13d6793",
                        "glosses": [
                            "Auftrag, jemanden zu ermorden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e33489c1-862e-49e9-ba16-0efc68ee51c0",
                                "sense_id": "654c756d-6273-344d-ab8d-10e65a67fa4b",
                                "text": "„Es war ein einfacher Mordauftrag gewesen, hatte Capel gesagt.“"
                            },
                            {
                                "example_id": "8f0c1ab6-cf7f-4308-b8e1-380c0410a988",
                                "sense_id": "654c756d-6273-344d-ab8d-10e65a67fa4b",
                                "text": "„Es könnte das Außenministerium mit dem nächsten Mordauftrag sein.“"
                            },
                            {
                                "example_id": "712fda13-5d19-48b1-968c-557d4b104d6d",
                                "sense_id": "654c756d-6273-344d-ab8d-10e65a67fa4b",
                                "text": "„Wobei man festhalten muss, dass ein Plotter mehr Zeit damit verbringt, ein sicheres Versteck für sich selbst zu finden und dafür zu sorgen, sich eine Hintertür offen zu halten, als für die Planung eines Mordauftrags.“"
                            },
                            {
                                "example_id": "59484724-c9c0-49b4-aa72-4f56a03013d9",
                                "sense_id": "654c756d-6273-344d-ab8d-10e65a67fa4b",
                                "text": "„Bei der Rettung der Familie würden sie vielleicht handfeste Beweise sichern können, die Braxton, Droon und womöglich sogar Ian Helms höchstpersönlich mit dem Mordauftrag in Verbindung brachten.“"
                            },
                            {
                                "example_id": "050243c3-7b52-4443-9e9d-8ba7ab7c697b",
                                "sense_id": "654c756d-6273-344d-ab8d-10e65a67fa4b",
                                "text": "„Lonnie hatte mehr als nur einen Mordauftrag mitgebracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
