                "senses": [
                    {
                        "sense_id": "b0cfff18-9a3a-32ed-a2eb-cf233fe3dee7",
                        "entry_id": "3e80b9bc-6c05-33af-9ed6-e3f98d1c4985",
                        "glosses": [
                            "Spektrum innerhalb der Forschung und Behandlung, das sich auf die Atemwege (Nase, Luftröhre, Lunge) spezialisiert; diejenigen Organe, die dem Atemweg zugerechnet werden"
                        ],
                        "tags": [
                            "auch"
                        ],
                        "examples": [
                            {
                                "example_id": "4d9e5218-c64b-4493-8258-52e3068b141f",
                                "sense_id": "b0cfff18-9a3a-32ed-a2eb-cf233fe3dee7",
                                "text": "„Dreißig Jahre nach der Unternehmensgründung begann das heute weltweit tätige Pharmaunternehmen mit der Erforschung von Arzneimitteln im Atemwegsbereich.“"
                            },
                            {
                                "example_id": "c2cb660b-e2dd-44b4-be9b-0107376836de",
                                "sense_id": "b0cfff18-9a3a-32ed-a2eb-cf233fe3dee7",
                                "text": "„Die Behandlung des Atemwegsbereichs muss unter ärztlicher Aufsicht erfolgen, da der unkontrollierte Verlauf von HNO-Erkrankungen mit schwerwiegenden Komplikationen und Folgen verbunden ist […].“"
                            }
                        ],
