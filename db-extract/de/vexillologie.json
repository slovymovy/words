                "senses": [
                    {
                        "sense_id": "b351b9e1-9d35-3a38-903c-5e26cd90cb27",
                        "entry_id": "0cf6c10c-bef6-3f02-9ac2-5a2992f2a3cc",
                        "glosses": [
                            "Lehre vom Fahnen- und Flaggenwesen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1eeabfc7-fe4d-4de0-abca-06de28ccd462",
                                "sense_id": "b351b9e1-9d35-3a38-903c-5e26cd90cb27",
                                "text": "Allerorten begegnen uns Fahnen mit unterschiedlichen Bedeutungen. Z. B. in der Politik, in der Schifffahrt oder im Sport. Und es gibt eine eigene Wissenschaft über die farbigen Zeichen im Wind. Sie nennt sich Vexillologie und unterscheidet sogar zwischen Fahnen und Flaggen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "235e5c94-94ce-4997-bf7d-1b45a5cea458",
                        "source_entry_id": "0cf6c10c-bef6-3f02-9ac2-5a2992f2a3cc",
                        "source_sense_id": "b351b9e1-9d35-3a38-903c-5e26cd90cb27",
                        "source_sense_description": "Lehre vom Fahnen- und Flaggenwesen",
                        "target_lang_word": "vexillology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vexillology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f4b08a9-48b2-3d3f-b6e4-4dc9262bda00",
                                        "entry_id": "e73ddf7d-82bd-386f-a4cf-d6594b28371c",
                                        "glosses": [
                                            "The study of flags."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e03dd620-0515-4e2b-b60e-8b75ccc032e5",
                                                "sense_id": "5f4b08a9-48b2-3d3f-b6e4-4dc9262bda00",
                                                "text": "Vexillology can help us to delve into national and global history."
                                            },
                                            {
                                                "example_id": "d516af92-0a39-412f-a0d4-fd7bf656c4ae",
                                                "sense_id": "5f4b08a9-48b2-3d3f-b6e4-4dc9262bda00",
                                                "text": "Sheldon: Over the next few 52 weeks, you and I are going to explore the dynamic world of vexillology."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3daf395f-b110-45ef-99b5-b1f5c3b6ffa0",
                        "source_entry_id": "0cf6c10c-bef6-3f02-9ac2-5a2992f2a3cc",
                        "source_sense_id": "b351b9e1-9d35-3a38-903c-5e26cd90cb27",
                        "source_sense_description": "Lehre vom Fahnen- und Flaggenwesen",
                        "target_lang_word": "vexillologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vexillologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f7c3fef5-bf3c-36d9-a099-6ccdbd961e9a",
                                        "entry_id": "ee13bb40-fbe8-37b1-9e7c-b1301ade8d0b",
                                        "glosses": [
                                            "Branche de l’histoire qui étudie les drapeaux, bannières, étendards, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3fa2901-cc7d-4543-a5db-f23850f67115",
                                                "sense_id": "f7c3fef5-bf3c-36d9-a099-6ccdbd961e9a",
                                                "text": "Quoi qu'il en soit, les drapeaux proprement dits n’ont pas encore suscité un tel regain d’intérêt et cette situation explique pourquoi la discipline dont ils font l’objet, la vexillologie, n’a nulle part trouvé de statut scientifique."
                                            },
                                            {
                                                "example_id": "34adee1e-f326-48ef-9b55-07e5f57ed723",
                                                "sense_id": "f7c3fef5-bf3c-36d9-a099-6ccdbd961e9a",
                                                "text": "L’homme de la rue se représente l’amateur de vexillologie forcément âgé et probablement militaire ou ayant un penchant pour tout ce qui touche à l’art militaire. Cette image est fausse et vraie en même temps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
