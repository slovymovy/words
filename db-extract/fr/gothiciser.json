                "senses": [
                    {
                        "sense_id": "efa0dcec-8aa2-319f-a0ba-6fb7a3dca50a",
                        "entry_id": "33b0c4b0-c55d-3f62-92ed-40352ed9db80",
                        "glosses": [
                            "Donner un caractère gothique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1c1520d-1a20-4a6b-874e-1a708401a98d",
                                "sense_id": "efa0dcec-8aa2-319f-a0ba-6fb7a3dca50a",
                                "text": "En 1780, Sir Roger Newdigate faisait « gothiciser » sa villa d’Asbury, et John Nash construisait plus tard pour le banquier Charles Hoare, la maison gothique de Luscombe, remarquable par sa tour hexagonale centrale et ses terrasses crénelées."
                            },
                            {
                                "example_id": "e55e4dac-e6b2-4633-812e-3bb3dfa96fc1",
                                "sense_id": "efa0dcec-8aa2-319f-a0ba-6fb7a3dca50a",
                                "text": "La marginalisation progressive à laquelle elle est, de fait, confrontée, la conduit à « gothiciser » son histoire."
                            }
                        ]
                    }
                ],
