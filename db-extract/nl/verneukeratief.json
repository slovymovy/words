                "senses": [
                    {
                        "sense_id": "f798f3b3-2499-3483-bd89-ea3b7365626d",
                        "entry_id": "33cb96b7-05f0-37e8-a8b4-afbcc4adff20",
                        "glosses": [
                            "tricky; relating to a statement, attitude, or behaviour that is more or less intentionally deceptive, misleading, undermining, or obstructive"
                        ],
                        "tags": [
                            "Netherlands",
                            "informal",
                            "mildly",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "d2ed86bb-d019-48d6-bae7-7f0d663c8d25",
                                "sense_id": "f798f3b3-2499-3483-bd89-ea3b7365626d",
                                "text": "Want Pel is er nu eenmaal om bekend, dat hij het intellect zijner discipelen niet steeds al te hoog aanslaat en ze graag laat rijen en, zoals de studenten zeggen, hen verneukeratief behandelt.",
                                "translation": "After all, Mr Pel is known for not always being overly appreciative of the intellect of his disciples, and for being inclined to leave them hanging and, as the students say, for treating them in an obstructive manner.",
                                "english": "After all, Mr Pel is known for not always being overly appreciative of the intellect of his disciples, and for being inclined to leave them hanging and, as the students say, for treating them in an obstructive manner."
                            }
                        ]
                    }
                ],
