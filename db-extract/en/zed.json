                        "entry_id": "7c4e1341-1d2a-3462-8c43-2281551dc46a",
                        "glosses": [
                            "A diminutive of the male given name Zedekiah."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9478ee78-3570-4a4c-8660-7d9eee264fc4",
                                "sense_id": "3ae64ad1-b3f7-306b-baff-35e8454b0613",
                                "text": "“So you changed it.”\n“Yes.” He turns off the tap.\n“Why did you choose the name Zed? What does it mean?”\n“Nothing. It's the last letter of the alphabet.”"
                            }
                        ]
