                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nauwkeurigheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit oude schilderij moet met grote <w>zorg</w> worden behandeld.",
                            "target_lang_translations": {
