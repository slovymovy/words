                ],
                "senses": [
                    {
                        "sense_id": "db215c4c-3438-3780-8ab1-e4d55e2e3a83",
                        "entry_id": "d45b4867-8362-31a9-b381-23f8ebb7814e",
                        "glosses": [
                            "The quality of being religious or pious, especially when zealous."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "83ab0c4c-699b-46ba-bd3e-4936091be26b",
                                "sense_id": "db215c4c-3438-3780-8ab1-e4d55e2e3a83",
                                "text": "“At least part of the stir over Carter’s shirtsleeve religiosity is that he seems to practice what he preaches,” Newsweek magazine mused a few days after the “born again” question made headlines across the country. “Kennedy went to Mass and Richard Nixon spoke affectionately of his Quaker mother, but neither appeared to be truly religious.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35dc47c9-cab8-4545-a45a-1cfe1f9049af",
                        "source_entry_id": "d45b4867-8362-31a9-b381-23f8ebb7814e",
                        "source_sense_id": "db215c4c-3438-3780-8ab1-e4d55e2e3a83",
                        "source_sense_description": "quality of being religious",
                        "target_lang_word": "religiositeit",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "religiositeit",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "33b52faa-6933-38aa-bffd-6b4b7810e005",
                                        "entry_id": "94808c1b-8f73-3542-88dd-93d4dced7d39",
                                        "glosses": [
                                            "alles wat te maken heeft met godsdienst en geloof in een opperwezen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "caaf245e-e764-4153-bf2e-209ea191fbf9",
                                                "sense_id": "33b52faa-6933-38aa-bffd-6b4b7810e005",
                                                "text": "Bisschop Tod Brown van Orange schrijft dat hij met bedroefdheid kennis nam van de financiële problemen bij Schullers gemeente. Hij wijst er op dat zij aanvankelijk samenkwam 'onder het nederige dak' van een drive-in snackbar en dat zij is uitgegroeid tot een 'gewaardeerde bron van religiositeit' in het deel van Californië waarin Orange ligt."
                                            },
                                            {
                                                "example_id": "5e9a2195-0a7b-4f56-8a40-ea2cada94374",
                                                "sense_id": "33b52faa-6933-38aa-bffd-6b4b7810e005",
                                                "text": "Tijdens het National Prayer Breakfast zei hij dat de uitdagingen waar de VS nu voor staan, van hem eisen dat hij luistert naar God en valse religiositeit vermijdt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9da0f061-59be-4c15-9568-6b25593d7d7f",
                        "source_entry_id": "d45b4867-8362-31a9-b381-23f8ebb7814e",
                        "source_sense_id": "db215c4c-3438-3780-8ab1-e4d55e2e3a83",
                        "source_sense_description": "quality of being religious",
                        "target_lang_word": "Religiosität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Religiosität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c704c50-4db4-3429-8129-ff07edee131a",
                                        "entry_id": "056bb275-13f8-3726-88c9-3dec9d66efae",
                                        "glosses": [
                                            "von religiösen Überzeugungen geprägte Einstellung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff0c57d7-dfae-4c67-9c09-99bf64517595",
                                                "sense_id": "3c704c50-4db4-3429-8129-ff07edee131a",
                                                "text": "„Daher ist das heutige Schlagwort »Esoterik« als Bezeichnung für eine neue und alternative Religiosität zu verstehen.“"
                                            },
                                            {
                                                "example_id": "93978efb-f8fb-4c91-8f73-46cf8b61a891",
                                                "sense_id": "3c704c50-4db4-3429-8129-ff07edee131a",
                                                "text": "„Bernkastel bringt mir besonderes Beispiel für die unbekümmerte, fast gefühl- und gedankenlose Religiosität dieser Menschen bei.“"
                                            },
                                            {
                                                "example_id": "47f0283b-6b41-4ade-bb72-24d2a9d783a5",
                                                "sense_id": "3c704c50-4db4-3429-8129-ff07edee131a",
                                                "text": "„Anders ist aber hier, in einem Landstrich, der von einer tiefen Religiosität geprägt ist, der Wunsch, in der Kirche Rat und vielleicht auch Hilfe zu finden.“"
                                            },
                                            {
                                                "example_id": "c987278a-ac1b-40cc-9218-754b342c97db",
                                                "sense_id": "3c704c50-4db4-3429-8129-ff07edee131a",
                                                "text": "„Doch im Gegensatz zu früher wäre es wohl verfehlt, die Wiederbelebung dieser Namen auf eine gesteigerte Religiosität zurückzuführen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
