                                                "example_id": "a6b8cfea-8712-4168-ae4a-3814b8414c92",
                                                "sense_id": "2fda5298-30f2-3bc6-a2df-29e327e1eb16",
                                                "text": "Гражданский иск."
                                            },
                                            {
                                                "example_id": "9f4e9d82-3abd-4622-9c59-f77f7e5dbbc1",
                                                "sense_id": "2fda5298-30f2-3bc6-a2df-29e327e1eb16",
                                                "text": "Гражданская война."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6352270e-0596-315b-be28-f70a287e13b4",
                                        "entry_id": "fc0b18df-c5ff-3501-b5b7-fc5323f90ed0",
                                        "glosses": [
                                            "невоенный, мирный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe9a5c5e-f878-4e78-9afd-f54c5db0469d",
                                                "sense_id": "6352270e-0596-315b-be28-f70a287e13b4",
                                                "text": "После войны он долго не мог привыкнуть к гражданской жизни."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8b04d4b-26de-33eb-bf7d-bd9e1cff4487",
                                        "entry_id": "fc0b18df-c5ff-3501-b5b7-fc5323f90ed0",
                                        "glosses": [
                                            "субстантивир. человек, не состоящий на службе в армии или другой силовой структуре"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8b43e94-b3e6-4611-9c1e-74f17f1e24d1",
                                                "sense_id": "b8b04d4b-26de-33eb-bf7d-bd9e1cff4487",
                                                "text": "Всех гражданских прошу покинуть территорию части!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9b046b2-5fb1-3cee-8c78-248a9d9b23ed",
                                        "entry_id": "fc0b18df-c5ff-3501-b5b7-fc5323f90ed0",
                                        "glosses": [
