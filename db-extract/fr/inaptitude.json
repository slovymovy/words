            {
                "entry_id": "a0af36c5-223e-34b2-802b-dcb56f1cc006",
                "word": "inaptitude",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6fc88c55-6206-44bf-8e3e-7946c00227c7",
                        "entry_id": "a0af36c5-223e-34b2-802b-dcb56f1cc006",
                        "tags": [
                            "plural"
                        ],
                        "form": "inaptitudes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "681592f4-a19a-39a3-a840-27adc22b0caa",
                        "entry_id": "a0af36c5-223e-34b2-802b-dcb56f1cc006",
                        "glosses": [
                            "Défaut d’aptitude à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e305489-14b2-41a7-8612-bb3ce1b1797e",
                                "sense_id": "681592f4-a19a-39a3-a840-27adc22b0caa",
                                "text": "Mais cette maladie peut également se consolider en une inaptitude qui devra être médicalement constatée pour constituer une cause réelle et sérieuse de licenciement lorsqu’aucun reclassement du salarié n’aura été possible."
                            },
                            {
                                "example_id": "258b9f92-be23-4f61-a058-74a1fdbc5187",
                                "sense_id": "681592f4-a19a-39a3-a840-27adc22b0caa",
                                "text": "Une décision qui aura un impact particulièrement important pour les salariés en cours d’arrêt maladie de longue durée, et pour les salariés licenciés pour inaptitude sans avoir perçu les congés payés afférents à leurs périodes d'arrêts."
                            },
                            {
                                "example_id": "a7129d84-e5fb-4ed4-924e-81d6a4866105",
                                "sense_id": "681592f4-a19a-39a3-a840-27adc22b0caa",
                                "text": "Son inaptitude l’exclut de tout emploi."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1310f68-0487-4da4-ad6f-952a0c65dc6e",
                        "source_entry_id": "a0af36c5-223e-34b2-802b-dcb56f1cc006",
                        "source_sense_id": "681592f4-a19a-39a3-a840-27adc22b0caa",
                        "target_lang_word": "Untüchtigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a70a1026-646c-4a1c-ae35-fac4c35ce85b",
                        "source_entry_id": "a0af36c5-223e-34b2-802b-dcb56f1cc006",
                        "source_sense_id": "681592f4-a19a-39a3-a840-27adc22b0caa",
                        "target_lang_word": "Unfähigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unfähigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "30819077-0ff9-3aec-95ff-d318229a52d1",
                                        "entry_id": "c026aef2-3cf2-3c57-b418-ffe75b6d18f0",
                                        "glosses": [
                                            "der (angeborene) Zustand, zu etwas nicht fähig oder nicht in der Lage zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddc6a979-0526-4ab4-a8a8-01efd210dff1",
                                                "sense_id": "30819077-0ff9-3aec-95ff-d318229a52d1",
                                                "text": "Mit der Unfähigkeit, mit den Menschen nicht umgehen zu können, hatte er nie wirklich eine Chance im Berufsleben."
                                            },
                                            {
                                                "example_id": "0ce866f9-e18a-4d78-8b08-341a8c0b6803",
                                                "sense_id": "30819077-0ff9-3aec-95ff-d318229a52d1",
                                                "text": "„Diese Terrorpanikmache nutzt dem Staat, den regierenden Parteibonzen, die damit von eigenen Problemen, der eigenen Unfähigkeit ablenken können.“"
                                            },
                                            {
                                                "example_id": "3ce80a7f-6ba6-466a-a0c7-71433604c9ef",
                                                "sense_id": "30819077-0ff9-3aec-95ff-d318229a52d1",
                                                "text": "„Ich dachte an die chronische Unfähigkeit meiner Landsleute, sich einer solchen Ordnung zu unterwerfen.“"
                                            },
                                            {
                                                "example_id": "5caf9651-2ce9-4dc3-ac8c-b27fc82a2b9e",
                                                "sense_id": "30819077-0ff9-3aec-95ff-d318229a52d1",
                                                "text": "„Seiner Unfähigkeit zur prinzipiellen Sinngebung, zur Einfühlung auch, versucht Schmidt durch Reisen zu entgehen.“"
                                            },
                                            {
                                                "example_id": "80547872-983c-4137-853d-35230f505945",
                                                "sense_id": "30819077-0ff9-3aec-95ff-d318229a52d1",
                                                "text": "„Was mich so unruhig macht, ist die Unfähigkeit, mich zu beschränken oder, wie mein Agent Zohnerer sagen würde, zu konzentrieren.“"
                                            },
                                            {
                                                "example_id": "560ef93b-b3ba-4f32-a703-a28bcb7c98c2",
                                                "sense_id": "30819077-0ff9-3aec-95ff-d318229a52d1",
                                                "text": "„Der Staat, der gerade in Berlin immer wieder seine Unfähigkeit beweist, soll alles richten, während der freie Markt angeblich nichts als eine profitgierige, ‚neoliberale‘ Verirrung ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
