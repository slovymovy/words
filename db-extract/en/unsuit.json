                "senses": [
                    {
                        "sense_id": "19a99852-27fb-3cec-a13a-fcd49ae5d54d",
                        "entry_id": "63c1b902-77bd-3577-87cc-d34bce9dde94",
                        "glosses": [
                            "A swimsuit made of cloth that allows through UVB rays so that the wearer can tan through the suit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "878e9917-38ae-4e4b-9f7e-cc0fad70a202",
                                "sense_id": "19a99852-27fb-3cec-a13a-fcd49ae5d54d",
                                "text": "unsuits, knitted or crocheted, of man-made fibres, children's wear"
                            },
                            {
                                "example_id": "8d996ca7-ba3c-4484-9fdb-ac55fff06de1",
                                "sense_id": "19a99852-27fb-3cec-a13a-fcd49ae5d54d",
                                "text": "Made of a special cotton fabric and available in men's and women's styles, the unsuit, at a price of $35 and up, is already making its mark."
                            },
                            {
                                "example_id": "6b6c02eb-71ba-4762-8e69-0398ccd51b00",
                                "sense_id": "19a99852-27fb-3cec-a13a-fcd49ae5d54d",
                                "text": "Do not wear loose-knit bathing suits or \"unsuits\" that let the ultraviolet rays through the suit's material."
                            }
                        ]
                    },
                    {
                        "sense_id": "f396a552-797b-3762-931a-81dec2182bb3",
                        "entry_id": "63c1b902-77bd-3577-87cc-d34bce9dde94",
                        "glosses": [
                            "A legal suit that is dismissed by the judge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b41d691-7120-46ff-9908-61e1fca77205",
                                "sense_id": "f396a552-797b-3762-931a-81dec2182bb3",
                                "text": "The years around 1669-1671 show a better than average share of withdrawals and unsuits."
                            }
                        ]
                    }
                ],
