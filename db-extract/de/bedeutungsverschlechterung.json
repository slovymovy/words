                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9363591-b26e-4ae8-ad4d-537c8e592a8e",
                                                "sense_id": "4d4c01bb-4c43-3cb3-929c-cda538e87fee",
                                                "text": "Nagle explains that the contemporary disapproval of the title is due to a multilayered pejoration inherent in the term Hobson-Jobson."
                                            }
                                        ]
