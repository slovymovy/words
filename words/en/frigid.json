                    "frequency": "VeryLow",
                    "semantic_group_id": "sexual_response",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Historical medical texts often labeled women as <w>frigid</w> without understanding psychological factors.",
                            "target_lang_translations": {
                                "zh": "历史上的医学文献在不了解心理因素的情况下，常常将女性贴上<w>性冷淡</w>的标签。"
                            }
                        },
                        {
                            "text": "The term <w>frigid</w> has largely fallen out of favor in modern sex therapy.",
                            "target_lang_translations": {
