                                        "glosses": [
                                            "Able to be protected by a patent; for which a patent can be granted."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d279fbd-e898-4d06-8b17-bc78833c3802",
                                                "sense_id": "73a887c5-780c-3565-8825-cd159deaf5d0",
                                                "text": "The funding gap is not the sole, or primary reason so few drugs are approved. Whether a product is patentable, and therefore profitable for a pharmaceutical company, is a major determinant in the rate at which it will proceed along the NIH process."
                                            }
