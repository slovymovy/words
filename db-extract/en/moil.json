                    },
                    {
                        "form_id": "dbf8289f-94e6-4b73-adf6-16a2ea912c2a",
                        "entry_id": "00820a31-2c2e-3366-a8d3-b1326557865b",
                        "tags": [
                            "participle",
                            "past"
                        ],
                        "form": "moiled"
                    },
                    {
                        "form_id": "696028b6-0527-4181-aae4-201b14da80b7",
                        "entry_id": "00820a31-2c2e-3366-a8d3-b1326557865b",
                        "tags": [
                            "past"
                        ],
                        "form": "moiled"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5e206e1c-66af-35c1-a940-67d754b448b8",
                        "entry_id": "00820a31-2c2e-3366-a8d3-b1326557865b",
                        "glosses": [
                            "To toil, to work hard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3141948c-bbc4-4680-86ab-ef85673e8894",
                                "sense_id": "5e206e1c-66af-35c1-a940-67d754b448b8",
                                "text": "Moil not too much underground, for the hope of mines is very uncertain, and useth to make the planters lazy in other things.."
                            },
                            {
                                "example_id": "68c499fd-c2f3-4428-9d6e-2e5db68720dc",
                                "sense_id": "5e206e1c-66af-35c1-a940-67d754b448b8",
                                "text": "Now he must moil and drudge for one he loathes."
                            },
                            {
                                "example_id": "21d33aa4-9161-40cc-b4ac-aa45fc39e0b0",
                                "sense_id": "5e206e1c-66af-35c1-a940-67d754b448b8",
                                "text": "Why for sluggards cark and moil?"
                            },
                            {
                                "example_id": "3b80ccd4-8748-4508-8e32-d98df910ec47",
                                "sense_id": "5e206e1c-66af-35c1-a940-67d754b448b8",
                                "text": "There are strange things done in the midnight sun\n By the men who moil for gold;\nThe Arctic trails have their secret tales\n That would make your blood run cold;\nThe Northern Lights have seen queer sights,\n But the queerest they ever did see\nWas that night on the marge of Lake Lebarge\n I cremated Sam McGee."
                            }
                        ]
                    },
                    {
                        "sense_id": "1fca82ee-1194-308f-8774-da0ed0ad8d82",
                        "entry_id": "00820a31-2c2e-3366-a8d3-b1326557865b",
                        "glosses": [
                            "To churn continually; to swirl."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4f467642-688b-49b3-b2cc-3065e6dd7b1b",
                                "sense_id": "1fca82ee-1194-308f-8774-da0ed0ad8d82",
                                "text": "A crowd of men and women moiled like nightmare figures in the smoke-green haze."
                            }
                        ]
                    },
                    {
                        "sense_id": "50e87635-9704-3ef5-862f-8ac0b7c3dea5",
