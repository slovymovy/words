                        "examples": [
                            {
                                "example_id": "144ca326-c76a-43ea-b78d-45bf09db5d30",
                                "sense_id": "0194871b-4a66-3512-8e06-9645f6cb8866",
                                "text": "„Ich dankte ihm für alles und besonders dafür, daß er mich mit seiner Schwester bekanntgemacht hatte, die mein Herz in Bann geschlagen habe, und deren Unnahbarkeit ich zu besiegen hoffte.“"
