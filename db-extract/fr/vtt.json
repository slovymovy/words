            {
                "entry_id": "702c498d-bdc0-377d-a66d-e9e1789b3fec",
                "word": "VTT",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cf2fbef1-908d-3c7b-bbfd-16129a7a7a9d",
                        "entry_id": "702c498d-bdc0-377d-a66d-e9e1789b3fec",
                        "glosses": [
                            "Geländewagen"
                        ],
                        "tags": [
                            "regional (Québec)",
                            "speziell Automobil"
                        ],
                        "examples": [
                            {
                                "example_id": "b4350b89-4527-4f2a-852e-87c9267b38a2",
                                "sense_id": "cf2fbef1-908d-3c7b-bbfd-16129a7a7a9d",
                                "text": "Le VTT c'est bof."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a6b546c-d52a-4efa-bd24-55b2f524c147",
                        "source_entry_id": "702c498d-bdc0-377d-a66d-e9e1789b3fec",
                        "source_sense_id": "cf2fbef1-908d-3c7b-bbfd-16129a7a7a9d",
                        "target_lang_word": "Geländewagen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geländewagen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6ab22ae3-88de-30b0-8001-d5668f1f95c3",
                                        "entry_id": "4a568ca3-7598-37f9-817d-caa6eb3d2c02",
                                        "glosses": [
                                            "ein Automobil zum Befahren von schwierigem Gelände abseits von ausgebauten Straßen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c751717e-abc1-4398-9a75-14809b4c7b87",
                                                "sense_id": "6ab22ae3-88de-30b0-8001-d5668f1f95c3",
                                                "text": "Mein Vater fährt einen Geländewagen Baujahr 2001."
                                            },
                                            {
                                                "example_id": "d8043dd4-db01-4bee-b112-d48edf5f3add",
                                                "sense_id": "6ab22ae3-88de-30b0-8001-d5668f1f95c3",
                                                "text": "Gestern wurde ein Geländewagen vom Dorfplatz gestohlen."
                                            },
                                            {
                                                "example_id": "2a7a950f-5de4-4971-9a3e-98059d292a08",
                                                "sense_id": "6ab22ae3-88de-30b0-8001-d5668f1f95c3",
                                                "text": "Auf dem Supermarktparkplatz stehen zwei hochwertige Geländewagen."
                                            },
                                            {
                                                "example_id": "f95ef263-7426-4dae-bd50-7467442748f6",
                                                "sense_id": "6ab22ae3-88de-30b0-8001-d5668f1f95c3",
                                                "text": "Während der Fahrt nach München überholten uns zwei schwarze Geländewagen."
                                            },
                                            {
                                                "example_id": "5c3c308d-db50-4b1a-b40b-13d81745f719",
                                                "sense_id": "6ab22ae3-88de-30b0-8001-d5668f1f95c3",
                                                "text": "„Ein chromblitzender Geländewagen mit einer auffälligen Werbeaufschrift wurde von einem braungebrannten Muskelmann aus einer Ausfahrt gesteuert.“"
                                            },
                                            {
                                                "example_id": "ffe0f57b-934e-419d-86de-2bb39da33d18",
                                                "sense_id": "6ab22ae3-88de-30b0-8001-d5668f1f95c3",
                                                "text": "„Bis auf 150 Meter kamen wir mit dem Geländewagen an den Schlund heran, dann zu Fuß weiter.“"
                                            },
                                            {
                                                "example_id": "1a99b769-97f3-4bbe-9d01-aef8060a4fde",
                                                "sense_id": "6ab22ae3-88de-30b0-8001-d5668f1f95c3",
                                                "text": "„In meinem Geländewagen sitzt man höher als in den meisten anderen Fahrzeugen, endlich muss Negusse nicht zu allen aufblicken!“"
                                            },
                                            {
                                                "example_id": "6e3eceab-f68d-43f9-b67a-24fd3190297e",
                                                "sense_id": "6ab22ae3-88de-30b0-8001-d5668f1f95c3",
                                                "text": "„Wir hatten einen Geländewagen mit Vierradantrieb, aber genau davor habe ich seit jeher einen Horror, noch dazu bei schwierigem Gelände und allem, was das so mit sich bringt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
