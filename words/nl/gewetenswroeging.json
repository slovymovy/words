                            },
                            {
                                "target_lang_word": "qualms of conscience",
                                "target_lang_sense_clarification": "uneasy feelings about the morality of one's actions"
                            },
                            {
                                "target_lang_word": "contrition",
                                "target_lang_sense_clarification": "the state of feeling sorry for a bad action"
