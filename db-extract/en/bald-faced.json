                                        "examples": [
                                            {
                                                "example_id": "ed9986bd-6b75-4435-9e04-b5273c66b5dd",
                                                "sense_id": "28310149-1026-3ea9-8c87-a79b19100d0a",
                                                "text": "Il vous faudra mater ce(tte) petit(e) effronté(e)."
                                            },
                                            {
                                                "example_id": "9f092d65-1476-4b95-b768-12ddac8658a8",
                                                "sense_id": "28310149-1026-3ea9-8c87-a79b19100d0a",
                                                "text": "Vous êtes un effronté, Monsieur, un effronté !"
                                            }
                                        ]
