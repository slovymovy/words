                ],
                "senses": [
                    {
                        "sense_id": "4dc5f9f1-cbf6-34af-af77-f6cebcb7ce7c",
                        "entry_id": "94c7c81e-921e-3e3b-8697-2b3dda8ccaf4",
                        "glosses": [
                            "sehr großer Hunger"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "6405e874-b364-4699-9be0-e22dc2acc823",
                                "sense_id": "4dc5f9f1-cbf6-34af-af77-f6cebcb7ce7c",
                                "text": "„Beim Scheine des winzigen Flämmchens hielten die Gefährten dann eine Mahlzeit ab, die ihnen bei ihrem Bärenhunger trefflich mundete.“"
                            },
                            {
                                "example_id": "06baef1d-a13b-4d87-9f7e-4113d69ac0b5",
                                "sense_id": "4dc5f9f1-cbf6-34af-af77-f6cebcb7ce7c",
                                "text": "„Keith versucht erst einmal etwas Essbares zu finden, denn er hat einen Bärenhunger und sein Magen knurrt schon mächtig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
