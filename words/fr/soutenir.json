{
    "word_family": [
        "soutien",
        "soutenable",
        "insoutenable",
        "soutenance"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "67ea90c2-b048-365c-aeff-7903905f7ac9",
                    "sense_definition": "Aider, encourager ou protéger une personne, un groupe ou un projet en lui apportant une assistance morale ou matérielle.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "aide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mes parents ont toujours choisi de <w>soutenir</w> mes projets artistiques avec beaucoup d'enthousiasme."
                        },
                        {
                            "text": "Toute l'équipe se mobilise pour <w>soutenir</w> un ami qui traverse une période difficile."
                        }
                    ],
                    "synonyms": [
                        "aider",
                        "épauler",
                        "appuyer",
                        "encourager"
                    ],
                    "antonyms": [
                        "abandonner",
                        "combattre"
                    ],
                    "common_phrases": [
                        "soutenir un ami",
                        "soutenir un projet"
                    ]
                },
                {
                    "sense_id": "598b2f9e-c729-39e4-a7d0-0250ad469be9",
                    "sense_definition": "Porter ou retenir un corps, une structure physique pour l'empêcher de s'affaisser ou de tomber.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette poutre en chêne <w>soutient</w> tout le poids de la toiture depuis des siècles."
                        },
                        {
                            "text": "L'infirmière s'est approchée pour <w>soutenir</w> le malade chancelant et l'aider à marcher."
                        }
                    ],
                    "synonyms": [
                        "porter",
                        "retenir",
                        "étayer"
                    ],
                    "common_phrases": [
                        "soutenir le poids",
                        "soutenir la charpente"
                    ]
                },
                {
                    "sense_id": "c797984e-82ea-331c-b517-0b0d38d0a4ae",
                    "sense_definition": "Affirmer avec fermeté et persistance qu'une déclaration ou qu'un fait est vrai.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le témoin continue de <w>soutenir</w> le contraire malgré les preuves présentées par la police."
                        },
                        {
                            "text": "Il <w>soutient</w> fermement qu'il n'était pas présent lors de la réunion."
                        }
                    ],
                    "synonyms": [
                        "affirmer",
                        "prétendre",
                        "assurer"
                    ],
                    "antonyms": [
                        "nier",
                        "démentir"
                    ],
                    "common_phrases": [
                        "soutenir le contraire",
                        "soutenir mordicus"
                    ]
                },
                {
                    "sense_id": "bb9b3039-6020-3d89-ac77-4b280d617af5",
                    "sense_definition": "Défendre par des arguments une thèse, une doctrine, une cause ou présenter officiellement un travail universitaire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'étudiante se prépare intensément pour <w>soutenir</w> une thèse devant un jury international."
                        },
                        {
                            "text": "Ce philosophe a toujours tenté de <w>soutenir</w> une cause écologique novatrice."
                        }
                    ],
                    "synonyms": [
                        "défendre",
                        "plaider"
                    ],
                    "antonyms": [
                        "attaquer",
                        "réfuter"
                    ],
                    "common_phrases": [
                        "soutenir une thèse",
                        "soutenir une cause"
                    ]
                },
                {
                    "sense_id": "c336cc6b-e7a4-3a86-a974-f31dc3a483db",
                    "sense_definition": "Faire face sans faiblir à une épreuve, un choc, une attaque ou un regard insistant.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "resistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Intimidé par l'autorité du directeur, l'employé n'a pas pu <w>soutenir</w> le regard."
                        },
                        {
                            "text": "La digue a réussi à <w>soutenir</w> le choc des vagues pendant la violente tempête."
                        }
                    ],
                    "synonyms": [
                        "endurer",
                        "supporter",
                        "résister"
                    ],
                    "antonyms": [
                        "flancher",
                        "céder"
                    ],
                    "common_phrases": [
                        "soutenir le regard",
                        "soutenir le choc"
                    ]
                },
                {
                    "sense_id": "c5956d9f-1557-365f-b267-e17b049a06fc",
                    "sense_definition": "Se maintenir debout, en équilibre ou conserver ses forces sans tomber.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après cette longue maladie, le patient parvenait à peine à se <w>soutenir</w> seul."
                        },
                        {
                            "text": "Épuisé par des heures de marche, le randonneur ne pouvait plus se <w>soutenir</w> debout."
                        }
                    ],
                    "synonyms": [
                        "tenir"
                    ],
                    "antonyms": [
                        "s'écrouler",
                        "s'effondrer"
                    ],
                    "common_phrases": [
                        "se soutenir à peine",
                        "se soutenir debout"
                    ]
                }
            ]
        }
    ]
}