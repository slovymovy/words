                "senses": [
                    {
                        "sense_id": "7b6b2c6c-77ff-33d2-88f5-e24e2a1a94f2",
                        "entry_id": "edc6ee02-7ac3-3bd6-940f-ef6b42b3a7b6",
                        "glosses": [
                            "The act of aggravating, or making worse; used of evils, natural or moral; the act of increasing in severity or heinousness; something additional to a crime or wrong and enhancing its guilt or injurious consequences."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d3ec346d-30a3-4980-82f1-75db9b0c4f9e",
                                "sense_id": "7b6b2c6c-77ff-33d2-88f5-e24e2a1a94f2",
                                "text": "Adrian, whose health had always been weak, now suffered considerable aggravation of suffering from the effects of his wound."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b0e7721-eaad-395f-89d5-3d76584dd2d4",
                        "entry_id": "edc6ee02-7ac3-3bd6-940f-ef6b42b3a7b6",
                        "glosses": [
                            "Exaggerated representation."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a534918a-b52e-32d7-b571-a66b4693e8d1",
                        "entry_id": "edc6ee02-7ac3-3bd6-940f-ef6b42b3a7b6",
                        "glosses": [
                            "An extrinsic circumstance or accident which increases the guilt of a crime or the misery of a calamity."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "00855844-13d4-3913-b0bb-0f82e61ce9de",
                        "entry_id": "edc6ee02-7ac3-3bd6-940f-ef6b42b3a7b6",
                        "glosses": [
                            "Provocation, irritation, annoyance."
                        ],
                        "tags": [
                            "countable",
                            "informal",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "63551626-5b10-40fe-98a6-5641c5ebf29b",
                                "sense_id": "00855844-13d4-3913-b0bb-0f82e61ce9de",
                                "text": "A little less conversation, a little more action please / All this aggravation ain't satisfactioning me"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "20eedb9c-09e5-4977-bdea-47f87951071f",
                        "source_entry_id": "edc6ee02-7ac3-3bd6-940f-ef6b42b3a7b6",
                        "source_sense_description": "act of aggravating",
                        "target_lang_word": "verergering",
