                "senses": [
                    {
                        "sense_id": "240ee141-bfad-3686-89ad-53cbf71c646e",
                        "entry_id": "d6177068-af38-32f2-8500-9f8accdec2a5",
                        "glosses": [
                            "Berge/Gebirge mit allen ihren Erscheinungsformen und Besonderheiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "368a6286-6a2e-4ed5-80ac-68ae74cc55ea",
                                "sense_id": "240ee141-bfad-3686-89ad-53cbf71c646e",
                                "text": "„Durch die Alpenschilderungen Rousseaus findet eine weitere ästhetische Besonderheit der Bergwelt Eingang in die kulturelle Tradition: die Vorstellung des Gebirges als eines Panoramas unterschiedlicher, ja gegensätzlicher Siedlungsräume und Vegetationszonen.“"
                            },
                            {
                                "example_id": "90388cbd-0508-4b11-9576-07874221d20f",
                                "sense_id": "240ee141-bfad-3686-89ad-53cbf71c646e",
                                "text": "„Einige Tage zuvor sollte eine junge Wissenschaftlerin in der Bergwelt der Anden eine weitreichende Entdeckung machen.“"
                            },
                            {
                                "example_id": "412d58ca-daa8-4f9b-a36f-3c47b518c21b",
                                "sense_id": "240ee141-bfad-3686-89ad-53cbf71c646e",
                                "text": "„Jeder glücklich erreichte Gipfel vermittelt das Bewusstsein, sich ein nicht jedermann zugängliches, dem Bergsteiger wichtiges Stück Bergwelt unseres Globus selbst erarbeitet und damit zu eigen gemacht zu haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
