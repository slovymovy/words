                ],
                "senses": [
                    {
                        "sense_id": "6ce2246c-f688-3af7-9971-4b690a3d379f",
                        "entry_id": "57229043-8553-3ce5-b3f2-ec7a2c3d1033",
                        "glosses": [
                            "Zweig eines Olivenbaums"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92b03d94-a77e-487d-9f5f-ef5468732ce8",
                                "sense_id": "6ce2246c-f688-3af7-9971-4b690a3d379f",
                                "text": "„Auch vergaß Musides nicht, nahe dem Haupt des Kalos die Olivenzweige aus dem Hain einzugraben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2cc49612-8e11-480a-a9da-75689db505bd",
                        "source_entry_id": "57229043-8553-3ce5-b3f2-ec7a2c3d1033",
                        "source_sense_id": "6ce2246c-f688-3af7-9971-4b690a3d379f",
                        "source_sense_description": "Zweig eines Olivenbaums",
                        "target_lang_word": "橄欖枝",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "橄欖枝",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "f25ac025-16d2-3275-aa50-0d2a9f05c96e",
                                        "entry_id": "c37cde17-7fc7-309d-8992-241c0f8b7f52",
                                        "glosses": [
                                            "油橄欖的枝葉"
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "243e2abd-f55b-47ef-a03b-14ea6b6cf1b3",
                                                "sense_id": "f25ac025-16d2-3275-aa50-0d2a9f05c96e",
                                                "text": "我又問天使說、這燈臺左右的兩棵橄欖樹、是甚麼意思。我二次問他說、這兩根橄欖枝、在兩個流出金色油的金嘴旁邊、是甚麼意思。"
                                            },
                                            {
                                                "example_id": "a0c7cd4f-3768-4cbb-bebe-afd8345587ca",
                                                "sense_id": "f25ac025-16d2-3275-aa50-0d2a9f05c96e",
                                                "text": "我又问天使说、这灯台左右的两棵橄榄树、是甚么意思。我二次问他说、这两根橄榄枝、在两个流出金色油的金嘴旁边、是甚么意思。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e368c17-7839-302c-a3fa-050c111c04d4",
                                        "entry_id": "c37cde17-7fc7-309d-8992-241c0f8b7f52",
                                        "glosses": [
                                            "和平的象徵"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2702d0d0-5698-486e-9577-22cc047ffbc0",
                                                "sense_id": "3e368c17-7839-302c-a3fa-050c111c04d4",
                                                "text": "拋出橄欖枝"
                                            },
                                            {
                                                "example_id": "07e6042a-f487-43e8-a100-c4220d2a4fd5",
                                                "sense_id": "3e368c17-7839-302c-a3fa-050c111c04d4",
                                                "text": "抛出橄榄枝"
                                            },
                                            {
                                                "example_id": "bffb9541-ae2f-46e8-b938-02b2b32338e2",
                                                "sense_id": "3e368c17-7839-302c-a3fa-050c111c04d4",
                                                "text": "過去四年多，我們向海峽對岸伸出無數次和平的橄欖枝，積極尋求兩岸重啟協商對話的新基礎。"
                                            },
                                            {
                                                "example_id": "7a5a5cfd-1998-499d-9295-0c3d287fbb52",
                                                "sense_id": "3e368c17-7839-302c-a3fa-050c111c04d4",
                                                "text": "过去四年多，我们向海峡对岸伸出无数次和平的橄榄枝，积极寻求两岸重启协商对话的新基础。"
                                            },
                                            {
                                                "example_id": "b1718528-90cb-4893-9217-d1286982acf7",
                                                "sense_id": "3e368c17-7839-302c-a3fa-050c111c04d4",
                                                "text": "一手拿橄欖枝，一手揮舞原子彈。這從來就是美帝國主義的反革命兩手策略。"
                                            },
                                            {
                                                "example_id": "a19cabba-3777-4f87-b456-185eac916f11",
                                                "sense_id": "3e368c17-7839-302c-a3fa-050c111c04d4",
                                                "text": "一手拿橄榄枝，一手挥舞原子弹。这从来就是美帝国主义的反革命两手策略。"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fcac468b-f64d-4c14-acdd-46e67f93dbfa",
                        "source_entry_id": "57229043-8553-3ce5-b3f2-ec7a2c3d1033",
                        "source_sense_id": "6ce2246c-f688-3af7-9971-4b690a3d379f",
                        "source_sense_description": "Zweig eines Olivenbaums",
                        "target_lang_word": "olive branch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "olive branch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41d2db33-711e-3365-9fee-251a73022e99",
                                        "entry_id": "6fa4e216-c8bb-360d-a00c-d71676684d2a",
                                        "glosses": [
                                            "A branch of an olive tree offered as an emblem of peace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6831d688-c741-48ef-98b9-3c9bffafee2d",
                                                "sense_id": "41d2db33-711e-3365-9fee-251a73022e99",
                                                "text": "I appeal to you to enable our people to establish national independent sovereignty over its own land. / Today I have come bearing an olive branch and a freedom-fighter's gun. Do not let the olive branch fall from my hand. I repeat: do not let the olive branch fall from my hand. / War flares up in Palestine, and yet it is in Palestine that peace will be born."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa62acd0-5bc3-360e-9c9b-5ca9205acc91",
                                        "entry_id": "6fa4e216-c8bb-360d-a00c-d71676684d2a",
                                        "glosses": [
                                            "Any symbol of peace, or a peace offering to an adversary to show goodwill and in the hope of securing peace."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acb9686b-87cb-44b6-8b61-5363c0ffe957",
                                                "sense_id": "aa62acd0-5bc3-360e-9c9b-5ca9205acc91",
                                                "text": "His [George W. Bush's] remarks came after Britain offered a diplomatic olive branch to Iran earlier in the day to try to secure an early release of the prisoners."
                                            },
                                            {
                                                "example_id": "7322c373-7f17-4ac3-a7ce-503fe9ac0760",
                                                "sense_id": "aa62acd0-5bc3-360e-9c9b-5ca9205acc91",
                                                "text": "On immigration in particular, the change of tone was jarring, even from within the speech itself. Amidst warning of the threats posed by illegal immigration to jobs and safety, the president [Donald Trump] seemingly extended an olive branch to his opponents."
                                            },
                                            {
                                                "example_id": "bce0cff9-f3b8-4768-95a7-ac925c96d7e9",
                                                "sense_id": "aa62acd0-5bc3-360e-9c9b-5ca9205acc91",
                                                "text": "Beijing has offered some olive branches. On Thursday, a spokeswoman for the Chinese Ministry of Commerce said China would welcome a visit from U.S. Treasury Secretary Janet Yellen, in response to Ms. Yellen’s statement earlier this week that she still hoped to go."
                                            },
                                            {
                                                "example_id": "7c7e705f-ada0-4784-9b2b-067edb744b7d",
                                                "sense_id": "aa62acd0-5bc3-360e-9c9b-5ca9205acc91",
                                                "text": "Mr. Ramaphosa entered the meeting seemingly optimistic about maintaining a cordial conversation with Mr. Trump. He offered olive branches to Mr. Trump, including a book about golf. He complimented Mr. Trump’s décor in the Oval Office."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bc8c8cd-380c-3e28-8133-419d3d11ac68",
                                        "entry_id": "6fa4e216-c8bb-360d-a00c-d71676684d2a",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: A branch of an olive tree."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "olive branch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5507fd31-dd4c-38bc-90e5-eebaaa75d416",
                                        "entry_id": "bfb435f0-afed-3c51-88dd-cc8a6410ca12",
                                        "glosses": [
                                            "Alternative form of olive-branch."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7151a22-e7b5-48d0-805b-5dd40bd82e3b",
                                                "sense_id": "5507fd31-dd4c-38bc-90e5-eebaaa75d416",
                                                "text": "There's no olive branching. You see I know these people backwards, the agony and the problems we had with those fellows is unbelievable,\" he says."
                                            },
                                            {
                                                "example_id": "ed294983-037f-4053-ad9f-95f65e3189be",
                                                "sense_id": "5507fd31-dd4c-38bc-90e5-eebaaa75d416",
                                                "text": "\"Presumably, Carty could make this an occasion for olive branching here,\" Mr. Hopkins said."
                                            },
                                            {
                                                "example_id": "d268f8ae-2453-4a75-b5c9-2b461e55a1a9",
                                                "sense_id": "5507fd31-dd4c-38bc-90e5-eebaaa75d416",
                                                "text": "Fire signs also have fiery tempers but traditionally, their hearts can 'olive branch' their way through most problems."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
