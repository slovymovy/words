                "senses": [
                    {
                        "sense_id": "afc15324-34cc-3778-92fa-517c7ea233ea",
                        "entry_id": "883df3e8-0185-3207-be24-7e30adf099aa",
                        "glosses": [
                            "Eigenschaft von etwas, sich als nicht verzichtbar erwiesen zu haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4aa847dc-0d0c-4ead-81bd-da14720e4592",
                                "sense_id": "afc15324-34cc-3778-92fa-517c7ea233ea",
                                "text": "„Erst gegen zwei Uhr morgens konnten sie die versammelte Meute von der Unentbehrlichkeit von Literatur in einem Nachtklub überzeugen.“"
                            },
                            {
                                "example_id": "e7f67f6c-da86-4714-9f1e-a66e4aa07259",
                                "sense_id": "afc15324-34cc-3778-92fa-517c7ea233ea",
                                "text": "„Jeder höhere Verwaltungsbeamte ist in ruhigen, von keinen Stürmen erschütterten Zeiten der Meinung, die ganze ihm anvertraute Bevölkerung bewege sich nur dank seinen Bemühungen, und das dieser Meinung entspringende Gefühl eigener Unentbehrlichkeit bildet für ihn den grössten Lohn seiner Mühen und Anstrengungen.“"
                            }
                        ],
