                                "target_senses": [
                                    {
                                        "sense_id": "b3a73e97-c4a6-32c2-8e66-fa311e670771",
                                        "entry_id": "e9b90758-4893-33d2-9056-e8e4503d078a",
                                        "glosses": [
                                            "The ability to foresee or prepare wisely for the future."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9aa10e5c-8319-4cfe-8971-e2f4562a70d1",
                                                "sense_id": "b3a73e97-c4a6-32c2-8e66-fa311e670771",
                                                "text": "Having the foresight to prepare an evacuation plan may have saved their lives."
                                            },
                                            {
                                                "example_id": "30f34a82-12ac-4e27-ae3e-21c89cf02824",
                                                "sense_id": "b3a73e97-c4a6-32c2-8e66-fa311e670771",
                                                "text": "The rugged forhead that with graue foreſight / Welds kingdomes cauſes, & affaires of ſtate; […]"
                                            },
                                            {
                                                "example_id": "feb47bc8-fc7a-488b-a071-9874b8bb570c",
                                                "sense_id": "b3a73e97-c4a6-32c2-8e66-fa311e670771",
                                                "text": "In the dead state all is apparently without motion. No agent within indicates design, intelligence, or foresight: […]"
                                            },
                                            {
                                                "example_id": "8e06d51c-eb96-4a2b-af2d-239b4f3c0cde",
                                                "sense_id": "b3a73e97-c4a6-32c2-8e66-fa311e670771",
                                                "text": "The specifiers of the Freightliner network had the foresight to base the rail journey on carrying ISO containers which are 8ft wide and originally 8ft tall (although now increased to a height of 9ft 6ins), with a variety of lengths."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0317e045-91e9-315c-975a-b89b46c07153",
                                        "entry_id": "e9b90758-4893-33d2-9056-e8e4503d078a",
                                        "glosses": [
                                            "The front sight on a rifle or similar weapon."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "471a6268-85b1-35a5-8bca-ff39f54e8366",
                                        "entry_id": "e9b90758-4893-33d2-9056-e8e4503d078a",
                                        "glosses": [
                                            "A bearing taken forwards towards a new object."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f352b71c-fe7e-42ff-ba6d-7010762e8295",
                        "source_entry_id": "52ce03f2-fca3-3774-8178-e5c0ab30152d",
                        "source_sense_id": "6929e4f7-80da-3def-a58f-66d2e37093aa",
                        "source_sense_description": "Vorbeugung, Vorbereitung für spätere Entwicklungen",
                        "target_lang_word": "prévoyance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prévoyance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c39f3295-aa6f-3eb1-b0cf-9fe59a7c6f50",
                                        "entry_id": "628d0025-5cfd-3dc3-820d-022b1b32feb6",
                                        "glosses": [
                                            "Faculté de prévoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3eeded5-e372-48f4-bbca-624a773e153e",
                                                "sense_id": "c39f3295-aa6f-3eb1-b0cf-9fe59a7c6f50",
                                                "text": "L'expédition du Mexique détruit notre effectif, anéantit le matériel de notre marine, dilapide nos finances, […]. Cette expédition, qui nous coûte tant, ne nous apprend rien, pas même la prudence et la prévoyance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e1586b2-d789-3485-bc2a-672ab29c6fe3",
                                        "entry_id": "628d0025-5cfd-3dc3-820d-022b1b32feb6",
                                        "glosses": [
                                            "Action de prévoir et de prendre des précautions pour l’avenir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fe4d3ac-948f-4714-a612-d828cc17c3dd",
                                                "sense_id": "1e1586b2-d789-3485-bc2a-672ab29c6fe3",
                                                "text": "La patience est la principale vertu réclamée à l'explorateur polaire, dit Nansen, mais la prévoyance est la seconde."
                                            },
                                            {
                                                "example_id": "ea205550-13f3-40d6-8132-ae06d75557e9",
                                                "sense_id": "1e1586b2-d789-3485-bc2a-672ab29c6fe3",
                                                "text": "La réputation de ce grand homme reposait principalement sur l’autorité avec laquelle il démontrait que l’éternument était une prévoyance de la nature, au moyen de laquelle les penseurs trop profonds pouvaient chasser par le nez le superflu de leurs idées ; […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0325629-a2ac-49af-bcb7-cf9b25ac5c00",
                        "source_entry_id": "52ce03f2-fca3-3774-8178-e5c0ab30152d",
