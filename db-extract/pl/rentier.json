                    {
                        "sense_id": "f21a7d5c-2a89-34ab-8584-273d24408140",
                        "entry_id": "8c86f18e-f47b-301f-be73-6eadd7cc53ec",
                        "glosses": [
                            "osoba czerpiąca zyski z posiadanego kapitału lub papierów wartościowych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7df45c3a-8240-4753-85b3-b5d16a1e3490",
                                "sense_id": "f21a7d5c-2a89-34ab-8584-273d24408140",
                                "text": "Stary, dobroduszny rentier, mieszkający oczywiście w mansardzie na szóstym piętrze, ułatwia spotkanie dwojgu młodym, biednym i kochającym się lokatorom sąsiednich mansard"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8fc3aa5-cc69-4e29-8167-307af6db5d68",
                        "source_entry_id": "8c86f18e-f47b-301f-be73-6eadd7cc53ec",
                        "source_sense_id": "f21a7d5c-2a89-34ab-8584-273d24408140",
                        "target_lang_word": "rentier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
