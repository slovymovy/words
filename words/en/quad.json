                            }
                        },
                        {
                            "text": "She is one of the <w>quads</w> born at the local hospital last year.",
                            "target_lang_translations": {
                                "ru": "Она одна из <w>четверняшек</w>, родившихся в местной больнице в прошлом году.",
                                "zh": "她是去年在当地医院出生的<w>四胞胎</w>之一。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "the quads"
