                                "sense_id": "30bd39e3-ac96-398b-8f99-2bb55fac8545",
                                "text": "Et l’interlocuteur de rester interdit devant cette sortie audacieuse, se demandant même si elle voulait, dit-il, « l’hétérosexualiser »."
                            },
                            {
                                "example_id": "e01a0ee7-740a-4ea0-8194-a6980718878b",
                                "sense_id": "30bd39e3-ac96-398b-8f99-2bb55fac8545",
                                "text": "Sexualiser, hétérosexualiser la publicité n'est en rien novateur... mais les vieilles recettes ne coûtent pas cher !"
                            },
                            {
                                "example_id": "7d7f0aa1-16f7-4d7e-9d81-63046268704f",
                                "sense_id": "30bd39e3-ac96-398b-8f99-2bb55fac8545",
                                "text": "J’essaye de m’hétérosexualiser !"
                            }
                        ]
                    }
