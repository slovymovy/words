                        "sense_id": "5378cc6f-8f2f-391b-b9e5-31a39f7afb79",
                        "entry_id": "f22e8958-4c75-3729-98ae-dca3d6afdbf0",
                        "glosses": [
                            "corrupt maken, aantasten, bederven, omkopen"
