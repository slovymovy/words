                ],
                "senses": [
                    {
                        "sense_id": "daa8a3cb-619e-3c94-b916-9c7b332c7216",
                        "entry_id": "1826ff2a-6068-3786-ae87-fdcaba6053ab",
                        "glosses": [
                            "Aussicht nach allen Seiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fc0d574-6fa3-4304-b938-fab6102d5560",
                                "sense_id": "daa8a3cb-619e-3c94-b916-9c7b332c7216",
                                "text": "Ein vergleichender Rundblick offenbart den unterschiedlichen Entwicklungsstand der Größmächte in Kolumbien."
                            },
                            {
                                "example_id": "740afb7b-c397-47ff-abfa-362ab1055af1",
                                "sense_id": "daa8a3cb-619e-3c94-b916-9c7b332c7216",
                                "text": "„Er nahm schnell einen Rundblick.“"
                            },
                            {
                                "example_id": "eeb9a1f1-728a-4803-b88d-dece54a27a61",
                                "sense_id": "daa8a3cb-619e-3c94-b916-9c7b332c7216",
                                "text": "„Weil sich die Fliegergefahr erheblich erhöht hat, nehme ich nur einen Rundblick über die Kimm und dann noch einen, den Kopf im Nacken, über den ganzen Himmel und verschwinde wieder nach unten.“"
                            },
                            {
                                "example_id": "98927a50-1aa6-468f-adc5-63bb27351097",
                                "sense_id": "daa8a3cb-619e-3c94-b916-9c7b332c7216",
                                "text": "„Von dort hat man einen fabelhaften Rundblick auf die Stadt und die umliegenden Landschaften.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9733c696-4b42-441f-a07c-6a057a7718c0",
                        "source_entry_id": "1826ff2a-6068-3786-ae87-fdcaba6053ab",
                        "source_sense_id": "daa8a3cb-619e-3c94-b916-9c7b332c7216",
                        "source_sense_description": "Aussicht nach allen Seiten",
                        "target_lang_word": "panorama",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "panorama",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cfe51989-7215-316c-8fc4-f5d1ba8817ba",
                                        "entry_id": "9bf739d9-057d-3c47-a9eb-4eb3d63f97f3",
                                        "glosses": [
                                            "Grand tableau circulaire et continu, disposé de manière que le spectateur placé au centre voie les objets représentés, comme si, placé sur une hauteur, il découvrait tout l’horizon dont il serait environné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0cdd4f9-c953-427d-bea2-f69ccabd5a7a",
                                                "sense_id": "cfe51989-7215-316c-8fc4-f5d1ba8817ba",
                                                "text": "Le panorama de Paris."
                                            },
                                            {
                                                "example_id": "a6e27177-ee97-4dfa-9a02-13d934b3ba6f",
                                                "sense_id": "cfe51989-7215-316c-8fc4-f5d1ba8817ba",
                                                "text": "Mais il est certain que la pénombre dispose à mieux voir ; comme dans les panoramas, par exemple, cette obscurité des vestibules qui prépare si bien au grand trompe-l’œil final."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0bf1746-aee2-364f-bf2d-8908493f3433",
                                        "entry_id": "9bf739d9-057d-3c47-a9eb-4eb3d63f97f3",
                                        "glosses": [
                                            "Vue d’ensemble."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5cabf32-2b2d-48bc-a92d-591ae574bece",
                                                "sense_id": "e0bf1746-aee2-364f-bf2d-8908493f3433",
                                                "text": "Alors j'ouvris les yeux, et […], je saisis, avec un plaisir mêlé d'effroi de me voir si petit au milieu de si grandes choses, tout l'ensemble de cet immense panorama, dont les dômes neigeux, dominant la riche végétation de la vallée, semblent le palais d'été du dieu de l'hiver."
                                            },
                                            {
                                                "example_id": "72e7fc7b-9291-479d-bd0a-f6b40e2d7a57",
                                                "sense_id": "e0bf1746-aee2-364f-bf2d-8908493f3433",
                                                "text": "Aussi rien n'est-il comparable, dans le cours de la Loire, au riche panorama que la Touraine présente alors aux yeux du voyageur."
                                            },
                                            {
                                                "example_id": "14237b52-447f-4dff-a2aa-dfe3fac9fdf4",
                                                "sense_id": "e0bf1746-aee2-364f-bf2d-8908493f3433",
                                                "text": "L’on peut dire que Lourdes est tout l’opposé de La Salette : le panorama y est magnifique, les parages s’éploient dans des verdures, les monts apprivoisés aisément s’abordent."
                                            },
                                            {
                                                "example_id": "ffe2c032-1809-42e4-888a-4a2004c49b6a",
                                                "sense_id": "e0bf1746-aee2-364f-bf2d-8908493f3433",
                                                "text": "Avec l'un des plus beaux panoramas du Sancy en toile de fond, Picherande se situe au cœur d'un paysage sauvage, entre les Monts Dore et le plateau de l’Artense, avec ses lacs, cascade, vallée de la Fontaine Salée, ses rivières et ses tourbières."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d16833c-815f-38d3-8097-35b75c8dbee6",
                                        "entry_id": "9bf739d9-057d-3c47-a9eb-4eb3d63f97f3",
                                        "glosses": [
                                            "Format photographique avec un grand angle."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcdec5a6-0ec2-4700-b666-582822509cee",
                                                "sense_id": "1d16833c-815f-38d3-8097-35b75c8dbee6",
                                                "text": "Tu prends le paysage en panorama ou en format classique ?"
                                            },
                                            {
                                                "example_id": "dd51b49f-df7f-429d-9c4d-3da08b466d62",
                                                "sense_id": "1d16833c-815f-38d3-8097-35b75c8dbee6",
                                                "text": "Pourquoi te prends-tu en photo de dos devant ce panorama?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be6ba69d-b333-4608-b74a-4e59e5fd0af8",
