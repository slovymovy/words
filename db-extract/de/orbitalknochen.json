                "senses": [
                    {
                        "sense_id": "ceb806e6-6392-39d5-b65e-e71c5cc2eb2a",
                        "entry_id": "a67f7c6d-cd04-387a-ae59-73274c5a52da",
                        "glosses": [
                            "Knochen der Augenhöhle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dce1b541-ade0-4e8f-b580-82742c6eae96",
                                "sense_id": "ceb806e6-6392-39d5-b65e-e71c5cc2eb2a",
                                "text": "„Später verletzte sich Calaway während einer Backstageaufnahme am Orbitalknochen, was ihn zu einer weiteren Verletzungspause zwang.“"
                            },
                            {
                                "example_id": "5e253175-c9a1-4119-ba49-e4c8a24f9a12",
                                "sense_id": "ceb806e6-6392-39d5-b65e-e71c5cc2eb2a",
                                "text": "„Der Enophthalmus kann aber auch ohne die Zertrümmerung der Orbitalknochen zustande kommen.“"
                            },
                            {
                                "example_id": "27574c57-a6c9-4db6-a1b5-6e095580c31d",
                                "sense_id": "ceb806e6-6392-39d5-b65e-e71c5cc2eb2a",
                                "text": "„Die Verletzungen der Orbitalknochen bestehen entweder in einer oberflächlichen Verwundung des Periostes und der Knochensubstanz oder in einer Fraktur des Knochens, die an dem festen Orbitalrand vorwiegend den Charakter der Zerspaltung und Zersplitterung und and der dünnen Orbitalwand den Charakter der Lochfraktur hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
