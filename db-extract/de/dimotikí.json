                "senses": [
                    {
                        "sense_id": "0281ba44-26b3-3e06-a9a7-bd307c686cc2",
                        "entry_id": "68eefe7a-601c-38bb-9a46-d8e76dfb5301",
                        "glosses": [
                            "eine Varietät des Griechischen, die neugriechische Volkssprache; Vergleiche auch Katharevousa"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "dfde3fe1-2fb3-43be-aaf7-462393e6c630",
                                "sense_id": "0281ba44-26b3-3e06-a9a7-bd307c686cc2",
                                "text": "„Die Verwendung der Dimotikí erregte bei den Sprachpuristen solchen Zorn, daß es sogar wegen der Übersetzung des Neuen Testaments in Dimotikí zu öffentlichem Aufruhr mit Straßenschlachten und Todesopfern kam.“"
                            },
                            {
                                "example_id": "a6887b95-d458-488d-8364-81a9133f5bf4",
                                "sense_id": "0281ba44-26b3-3e06-a9a7-bd307c686cc2",
                                "text": "„[…] in Griechenland, nach dem erwähnten Gespräch über Dimotikí und Katharévusa, sei er auf die Idee gekommen, in Nachahmung der Humanisten des 16. Jahrhunderts einen philosophischen Text in ‚néo-francais‘ zu übersetzen[…]“"
                            },
                            {
                                "example_id": "dd0324d5-19c6-4d8e-b9a8-80e49946fbf3",
                                "sense_id": "0281ba44-26b3-3e06-a9a7-bd307c686cc2",
                                "text": "„Im modernen Griechenland wird die Bezeichnung Katharévusa […] für die hinter der Entwicklung der gesprochenen Sprache zurückbleibende Form des archaisierenden Griechisch und die Bezeichnung Dimotikí […] für das sozusagen normale Neugriechisch benutzt.“"
                            },
                            {
                                "example_id": "3de6bfd7-6e6f-4cdf-93c2-e1df5d06d170",
                                "sense_id": "0281ba44-26b3-3e06-a9a7-bd307c686cc2",
                                "text": "„Als Parteigänger von Eleftherios Venizelos wurde er ins Athener Parlament gewählt, wo er für die Verwendung der griechischen Volkssprache (Dimotikí) eintrat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
