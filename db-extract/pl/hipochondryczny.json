                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hypochondriacal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a697a2e-48f4-36b6-9c11-157327791105",
                                        "entry_id": "cc5a197a-6d16-35e7-8f36-2e9bd48d29dd",
                                        "glosses": [
                                            "Coming from the hypochondria; pertaining to or caused by depressive spirits."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8281ffa5-f1c3-4b1a-ab02-be6446558548",
                                                "sense_id": "7a697a2e-48f4-36b6-9c11-157327791105",
                                                "text": "Fracastorius, Fallopius, and others, being to give their sentence of a party labouring of hypochondriacal melancholy, could not find out by the symptoms which part was most especially affected […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3665119b-de1e-34bb-a19b-a2232d5e0285",
                                        "entry_id": "cc5a197a-6d16-35e7-8f36-2e9bd48d29dd",
                                        "glosses": [
                                            "Suffering from hypochondria."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0e63717-2ec8-454b-a666-82d65e9c4883",
                                                "sense_id": "3665119b-de1e-34bb-a19b-a2232d5e0285",
                                                "text": "[…] the hypochondriacal British ceramist William De Morgan, who spent winters in Florence for his health while gradually bankrupting his business back home producing iridescent mythological scenes on tiles, vases and plates."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67b0a641-ba91-4185-a9c7-53e5ed833d48",
                        "source_entry_id": "9200bbbc-dbc1-3c21-9f2c-3cfd2bc3ff16",
