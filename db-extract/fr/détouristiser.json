                ],
                "senses": [
                    {
                        "sense_id": "1d97819c-1f61-35d8-85d4-30f12a34d7ad",
                        "entry_id": "411ee885-359d-3c78-b9d6-e64bfc4bc2dc",
                        "glosses": [
                            "Enlever son caractère touristique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8fba83d-e9d5-4015-9e22-d3ad0495f77f",
                                "sense_id": "1d97819c-1f61-35d8-85d4-30f12a34d7ad",
                                "text": "Il faut détouristiser la culture, la dépublicitariser, la faire briller par son absence, la rendre de nouveau hautaine et désirable."
                            },
                            {
                                "example_id": "9d988eaf-dff6-4554-addb-9df255c5fb8b",
                                "sense_id": "1d97819c-1f61-35d8-85d4-30f12a34d7ad",
                                "text": "Peut-être faudra-t-il un jour « détouristiser » nos façons de voir et de tout faire pour retrouver le sens existentiel du voyage : extrême ouverture sur l’extrême dehors ; rencontre radicale avec l’altérité radicale."
                            },
                            {
                                "example_id": "618c9ffb-2c61-43c1-8093-4e860dc89783",
                                "sense_id": "1d97819c-1f61-35d8-85d4-30f12a34d7ad",
                                "text": "Bon, j'essaye de me détouristiser."
                            }
                        ]
                    }
                ],
