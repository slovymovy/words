                                        "entry_id": "cfc74413-00d6-39b4-b152-d816bce75462",
                                        "glosses": [
                                            "box or open tray, typically kept on the surface of a desk, divided into compartments for such office supplies as pens, pencils, paperclips, etc. They are meant to help keep your items in a small compact space."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14a9dade-9c27-49b4-9d66-c54d8eca2b17",
                                                "sense_id": "671b3a92-b3bb-38e2-bf79-6d174e1c6167",
                                                "text": "The company's desk accessories, which include clocks, letter holders and a desk organizer, were designed by Alan Fletcher and Kenneth Grange in London, Takenobu Igarashi in Tokyo and Massimo Vignelli in New York."
                                            },
                                            {
                                                "example_id": "f5a1094d-4e90-43d9-878e-735bf403e13e",
                                                "sense_id": "671b3a92-b3bb-38e2-bf79-6d174e1c6167",
                                                "text": "Helps you to keep your desk clear from small things like pens, rulers, mobile phone and USBs."
                                            }
                                        ]
