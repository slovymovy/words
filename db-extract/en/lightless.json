                        "sense_id": "d4a8f7aa-bb60-373c-bfe3-1a2521c02ba4",
                        "entry_id": "cd4b31a5-1627-3c6e-ae77-ef596563b772",
                        "glosses": [
                            "Lacking light; unilluminated; dark."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "874ef98d-beca-434f-9483-5cc9f8e09883",
                                "sense_id": "d4a8f7aa-bb60-373c-bfe3-1a2521c02ba4",
                                "text": "From the besieged Ardea all in post,\nBorne by the trustless wings of false desire,\nLust-breathed Tarquin leaves the Roman host,\nAnd to Collatium bears the lightless fire\nWhich, in pale embers hid, lurks to aspire\nAnd girdle with embracing flames the waist\nOf Collatine’s fair love, Lucrece the chaste."
                            },
                            {
                                "example_id": "1aef482c-1b13-4fc4-80ca-91ff7c2cd061",
                                "sense_id": "d4a8f7aa-bb60-373c-bfe3-1a2521c02ba4",
                                "text": "\"I can’t stand much of this,\" said Hurstwood, whose legs ached him painfully, as he sat down upon the miserable bunk in the small, lightless chamber allotted to him."
                            },
                            {
                                "example_id": "d77bc27c-a0fe-4be0-be35-b6dc1bca0cee",
                                "sense_id": "d4a8f7aa-bb60-373c-bfe3-1a2521c02ba4",
                                "text": "Touch with thy flame the lightless lamp of my sorrow."
                            },
                            {
                                "example_id": "c05cd9d9-0d24-42b6-b55d-6585dbc93146",
                                "sense_id": "d4a8f7aa-bb60-373c-bfe3-1a2521c02ba4",
                                "text": "Knocked about on the wooden seat of the rackety rickety dim-lit bus, going past silent fields and past houses which were lightless and dead or bright and private, Mr Biswas no longer thought of the afternoon’s mission, but of the night ahead."
                            }
                        ]
                    }
