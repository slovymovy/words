                                        "entry_id": "680fa00c-9451-3883-8321-9c6e7ee20559",
                                        "glosses": [
                                            "(männliche) Person, die beruflich Tiere schlachtet, zerlegt und verarbeitet"
                                        ],
                                        "tags": [
                                            "vor allem in Norddeutschland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fd787ee-ca81-482c-bc96-378525309f14",
                                                "sense_id": "02383be3-7b77-3296-8ab5-a7c49c72cccd",
                                                "text": "Morgen bringen wir die Kuh zum Schlachter."
                                            },
                                            {
                                                "example_id": "7da1fc4a-6ef6-4fb1-bfac-8ebf3238624a",
                                                "sense_id": "02383be3-7b77-3296-8ab5-a7c49c72cccd",
                                                "text": "„Schließlich gab es nicht genug Schlachter, um so viele Tiere in kurzer Zeit zu verarbeiten, und vor allem zu wenig Kühlräume, Konservenbüchsen, Fässer und ähnliches Material, um haltbare Produkte im von den Kommunen geforderten Umfang zu produzieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schlachter",
                                "target_lang_code": "de",
                                "target_senses": [
