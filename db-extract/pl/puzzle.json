                "senses": [
                    {
                        "sense_id": "d6d7e8af-fb0e-3a52-83a0-ef923b615a4c",
                        "entry_id": "de32a472-2231-3537-8eed-27db38cb1f7b",
                        "glosses": [
                            "układanka składająca się z elementów o charakterystycznym kształcie, które należy dopasować, aby powstał obrazek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a77c638-1b32-4fbb-9031-6bcf685de2f4",
                                "sense_id": "d6d7e8af-fb0e-3a52-83a0-ef923b615a4c",
                                "text": "Całą noc układaliśmy puzzle, które dostaliśmy od taty."
                            },
                            {
                                "example_id": "a0e88d07-1649-479f-b3bf-1fc361ea9fbc",
                                "sense_id": "d6d7e8af-fb0e-3a52-83a0-ef923b615a4c",
                                "text": "Największe seryjnie produkowane puzzle składają się z 32 000 elementów"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "701b4cf5-3d51-4069-a2c9-296856a59869",
                        "source_entry_id": "de32a472-2231-3537-8eed-27db38cb1f7b",
                        "source_sense_id": "d6d7e8af-fb0e-3a52-83a0-ef923b615a4c",
                        "target_lang_word": "jigsaw puzzle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jigsaw puzzle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c99f302-c03b-348d-adcc-6b1b6d255b80",
                                        "entry_id": "0584088c-1add-33e9-b35e-89f0565ceb6e",
                                        "glosses": [
                                            "A type of puzzle in which the aim is to reconstruct a picture that has been cut (originally, with a jigsaw) into many small interlocking pieces."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "97463083-5434-35e7-abae-aa7f2f52fed1",
                                        "entry_id": "0584088c-1add-33e9-b35e-89f0565ceb6e",
                                        "glosses": [
                                            "An alphabetical jigsaw; a crossword in which the clues are not numbered and the solver must work out where each solution fits in the grid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca5b0355-9d4b-45ea-a26d-b6ed75790b60",
                                                "sense_id": "97463083-5434-35e7-abae-aa7f2f52fed1",
                                                "text": "The grid is designed so as to make this a genuine challenge: there are six words each of four to nine letters, and nothing longer – normally it’s the long lights that are the key to a jigsaw puzzle."
                                            },
                                            {
                                                "example_id": "73e767de-6e86-4b50-ada9-50f1d7c938e9",
                                                "sense_id": "97463083-5434-35e7-abae-aa7f2f52fed1",
                                                "text": "There is also the restriction with alphabeticals that the online interactive program for solving puzzles cannot cope with them, because the software is written on the basis that every numbered clue corresponds to the matching numbered slot in the grid. As this cannot be the case with a jigsaw puzzle, when it is faced by one the system has a nervous breakdown."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07c0a452-5941-404b-b833-e77894bf1e71",
                        "source_entry_id": "de32a472-2231-3537-8eed-27db38cb1f7b",
                        "source_sense_id": "d6d7e8af-fb0e-3a52-83a0-ef923b615a4c",
                        "target_lang_word": "puzzle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "puzzle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6351f915-8ba1-3baf-bcf5-ec32a4873bf0",
                                        "entry_id": "ee6693da-f76c-3c5c-9ccc-6b573dd12a21",
                                        "glosses": [
                                            "Jeu de patience composé de petites pièces à contours irréguliers que l’on doit assembler pour reconstituer une image."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a16fc114-cb74-4240-9c5f-ea1947ed58e6",
                                                "sense_id": "6351f915-8ba1-3baf-bcf5-ec32a4873bf0",
                                                "text": "Le rôle du faiseur de puzzle est difficile à définir. Dans la plupart des cas – pour tous les puzzles en carton en particulier – les puzzles sont fabriqués à la machine et leur découpage n'obéit à aucune nécessité : une presse coupante réglée selon un dessin immuable tranche les plaques de carton d'une façon toujours identique ; le véritable amateur rejette ces puzzles, pas seulement parce qu’ils sont en carton au lieu d’être en bois, ni parce qu'un modèle est reproduit sur la boîte d’emballage, mais parce que ce mode de découpage supprime la spécificité même du puzzle ; il importe peu en l’occurrence, contrairement à une idée fortement ancrée dans l’esprit du public, que l’image de départ soit réputée facile (une scène de genre à la manière de Vermeer par exemple, ou une photographie en couleurs d’un château autrichien) ou difficile (un Jackson Pollock, un Pissarro ou – paradoxe misérable – un puzzle blanc) : ce n’est pas le sujet du tableau ni la technique du peintre qui fait la difficulté du puzzle, mais la subtilité de la découpe, et une découpe aléatoire produira nécessairement une difficulté aléatoire, oscillant entre une facilité extrême pour les bords, les détails, les taches de lumière, les objets bien cernés, les traits, les transitions, et une difficulté fastidieuse pour le reste : le ciel sans nuages, le sable, la prairie, les labours, les zones d’ombre, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da762da6-894f-347e-81e0-9213e918c1fd",
                                        "entry_id": "ee6693da-f76c-3c5c-9ccc-6b573dd12a21",
                                        "glosses": [
                                            "Ensemble de choses semblables en imbrication étroite."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3c2f208-4ef9-4c00-ab74-854497307651",
                                                "sense_id": "da762da6-894f-347e-81e0-9213e918c1fd",
                                                "text": "La délégitimation des observances laïques, l’usure de morales d’État – celle des droits de l’homme a trop servi pour rester disponible –, le décri de la Patrie, du Progrès comme l'assurance d'un toujours mieux […], toutes ces érosions ont peu à peu sapé le crédit des credo qui unifiait tant bien que mal notre archipel, ce puzzle de méfiances communautaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4bc67e1-6768-457d-bb01-2ec2d2d9d354",
                        "source_entry_id": "de32a472-2231-3537-8eed-27db38cb1f7b",
                        "source_sense_id": "d6d7e8af-fb0e-3a52-83a0-ef923b615a4c",
                        "target_lang_word": "Puzzle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Puzzle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e02bd2f3-7e3f-3709-8c30-f927c46c2efb",
                                        "entry_id": "e40ed574-ec0c-3fee-a272-a57537c72bc9",
                                        "glosses": [
                                            "Spiel, bei dem ein zerschnittenes Bild wieder zusammengesetzt werden muss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb03fef5-37f4-4617-95b9-109adb7d3436",
                                                "sense_id": "e02bd2f3-7e3f-3709-8c30-f927c46c2efb",
                                                "text": "Sie verbrachte den Abend damit, ein Puzzle zu legen."
                                            },
                                            {
                                                "example_id": "1fed80ce-be2e-476c-86e8-fecd4cad51b6",
                                                "sense_id": "e02bd2f3-7e3f-3709-8c30-f927c46c2efb",
                                                "text": "„Das Puzzle hatte auch wieder tausend Teile.“"
                                            },
                                            {
                                                "example_id": "560f4eca-0114-42ac-9ec5-b94fafef150b",
                                                "sense_id": "e02bd2f3-7e3f-3709-8c30-f927c46c2efb",
                                                "text": "„Aber das Puzzle gelang mir nicht.“"
                                            }
