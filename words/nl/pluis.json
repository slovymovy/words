{
    "word_family": [
        "pluizen",
        "pluizig",
        "pluisje",
        "uitpluizen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "260b49a5-340c-37cd-92a6-8c8386460905",
                    "sense_definition": "Vlok droge, lichte stof met een open structuur, zoals van wol of katoen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pluis_stof",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er zit een klein <w>pluis</w> op je zwarte jas.",
                            "target_lang_translations": {
                                "en": "There is a small piece of <w>fluff</w> on your black coat."
                            }
                        },
                        {
                            "text": "Na het wassen zat de hele trui onder het <w>pluis</w>.",
                            "target_lang_translations": {
                                "en": "After washing, the entire sweater was covered in <w>lint</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "dot",
                        "nop",
                        "pluk"
                    ],
                    "target_lang_definitions": {
                        "en": "A small, loose piece of dry, light material with an open structure, such as wool, cotton, or dust."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fluff",
                                "target_lang_sense_clarification": "soft, light, fuzzy material"
                            },
                            {
                                "target_lang_word": "lint",
                                "target_lang_sense_clarification": "accumulated fabric fibers"
                            },
                            {
                                "target_lang_word": "pill",
                                "target_lang_sense_clarification": "small ball of fibers on a fabric surface"
                            },
                            {
                                "target_lang_word": "fuzz",
                                "target_lang_sense_clarification": "fine, loose fibers"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7acbb63-2b73-31f4-80c0-dd6d2884159a",
                    "sense_definition": "Zachte, lichte haartjes of pluisjes van planten (zoals populieren) of jonge vogels.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pluis_stof",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de lente zweeft er veel <w>pluis</w> van de populieren door de lucht.",
                            "target_lang_translations": {
                                "en": "In spring, a lot of <w>fluff</w> from the poplars floats through the air."
                            }
                        },
                        {
                            "text": "Het jonge vogeltje is nog bedekt met zacht <w>pluis</w>.",
                            "target_lang_translations": {
                                "en": "The young bird is still covered in soft <w>down</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Soft, light hairs or down from plants (such as poplars) or young birds."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "down",
                                "target_lang_sense_clarification": "soft feathers of young birds"
                            },
                            {
                                "target_lang_word": "fluff",
                                "target_lang_sense_clarification": "soft, light plant fibers or down"
                            },
                            {
                                "target_lang_word": "fuzz",
                                "target_lang_sense_clarification": "fine plant hairs"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df68bd22-d045-3309-9a4d-8f1888299265",
                    "sense_definition": "Bloemsteel met bloem; zijtak met bloem.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De botanicus bestudeerde de structuur van het <w>pluis</w> aan de zijtak.",
                            "target_lang_translations": {
                                "en": "The botanist studied the structure of the <w>flower stem</w> on the side branch."
                            }
                        },
                        {
                            "text": "Bij deze plantensoort is het <w>pluis</w> zeer fijn ontwikkeld.",
                            "target_lang_translations": {
                                "en": "In this plant species, the <w>flower head</w> is very finely developed."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Vlaams"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A flower stem with a flower; a side branch with a flower (Flemish)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sprig",
                                "target_lang_sense_clarification": "small stem with flowers or leaves"
                            },
                            {
                                "target_lang_word": "shoot",
                                "target_lang_sense_clarification": "young branch or stem"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8864c981-ed72-3a5a-ab07-557bcad26ce7",
                    "sense_definition": "In orde, deugdelijk of betrouwbaar (vrijwel uitsluitend gebruikt in de ontkennende vorm 'niet pluis').",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik vertrouw die situatie daar niet, het is daar vast <w>niet</w> <w>pluis</w>.",
                            "target_lang_translations": {
                                "en": "I don't trust that situation there; it's probably <w>not</w> <w>right</w>."
                            }
                        },
                        {
                            "text": "Zijn vreemde gedrag gaf me het gevoel dat er iets <w>niet</w> <w>pluis</w> was.",
                            "target_lang_translations": {
                                "en": "His strange behavior gave me the feeling that something was <w>not</w> <w>kosher</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "betrouwbaar",
                        "veilig",
                        "zeker"
                    ],
                    "common_phrases": [
                        "niet pluis"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Meestal in de ontkenning 'niet pluis'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "In order, proper, or reliable (almost exclusively used in the negative form 'niet pluis' meaning fishy, suspicious, or not right)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "right",
                                "target_lang_sense_clarification": "correct or safe (usually in 'not right')"
                            },
                            {
                                "target_lang_word": "safe",
                                "target_lang_sense_clarification": "secure or trustworthy"
                            },
                            {
                                "target_lang_word": "kosher",
                                "target_lang_sense_clarification": "legitimate or correct (colloquial)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "adb224ab-bd1b-3941-a08f-6daf4784ccb6",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>pluizen</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>pluis</w> de oude wollen trui helemaal uit om de pluisjes te verwijderen.",
                            "target_lang_translations": {
                                "en": "I <w>am de-fuzzing</w> the old woolen sweater completely to remove the lint."
                            }
                        },
                        {
                            "text": "Elke avond <w>pluis</w> ik ingewikkelde dossiers uit voor mijn werk.",
                            "target_lang_translations": {
                                "en": "Every evening I <w>scrutinize</w> complicated files for my work."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "eerste persoon enkelvoud tegenwoordige tijd"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present tense of 'pluizen' (to pill, shed fluff, or unravel/scrutinize)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fuzz",
                                "target_lang_sense_clarification": "to shed fibers"
                            },
                            {
                                "target_lang_word": "unravel",
                                "target_lang_sense_clarification": "to investigate or sort out"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44655076-3677-3eb1-a863-b6296accf53f",
                    "sense_definition": "Gebiedende wijs van <w>pluizen</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Pluis</w> die trui eens af voordat je naar het feest gaat!",
                            "target_lang_translations": {
                                "en": "<w>De-fuzz</w> that sweater before you go to the party!"
                            }
                        },
                        {
                            "text": "<w>Pluis</w> die zaak eerst goed uit voor je een beslissing neemt.",
                            "target_lang_translations": {
                                "en": "<w>Investigate</w> that matter thoroughly first before you make a decision."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "gebiedende wijs"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative form of 'pluizen' (to pill, shed fluff, or unravel/scrutinize)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unravel",
                                "target_lang_sense_clarification": "to investigate or sort out (imperative)"
                            },
                            {
                                "target_lang_word": "de-fuzz",
                                "target_lang_sense_clarification": "to remove lint or fluff (imperative)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}