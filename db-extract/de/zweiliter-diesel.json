                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c50a76e0-ae6e-41d1-a277-2aab1597a29f",
                                "sense_id": "acd75703-83a7-39e3-ad48-1fcf92e9427a",
                                "text": "„Im Gegensatz zum Oxygo-Sondermodell konnten die Épok-Modelle auch in Verbindung mit einem Wandler-Automatikgetriebe bestellt werden: der Zweiliter-Benziner mit einer Vierstufen-Automatik und der Zweiliter-Diesel mit einer Sechsstufen-Automatik (außer 307 CC Épok HDi FAP 135).“"
                            },
                            {
                                "example_id": "79e760f1-010c-40fd-bde6-59fc1d1edb8b",
                                "sense_id": "acd75703-83a7-39e3-ad48-1fcf92e9427a",
                                "text": "„1981 kam zusätzlich ein Zweiliter-Diesel mit 44kW/60 PS in das deutsche Programm.“"
                            }
                        ],
