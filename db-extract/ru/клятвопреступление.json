                                    {
                                        "sense_id": "815c49c7-dfe9-3430-b9d4-72edc7961d23",
                                        "entry_id": "354e0c9f-143a-3aee-935e-ae2713033225",
                                        "glosses": [
                                            "Verbrechen, das darin besteht, vor Gericht oder vor einer anderen zur Abnahme von Eiden zuständigen Stelle eine falsche Aussage zu beschwören (§ 154 StGB)"
                                        ],
                                        "tags": [
                                            "Germany"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8637a59-e5d1-4407-9ffd-3919c5566cb4",
                                                "sense_id": "815c49c7-dfe9-3430-b9d4-72edc7961d23",
                                                "text": "Als der Zeuge beschwor, zur Tatzeit mit dem Angeklagten eine Zechtour unternommen zu haben, leistete er einen Meineid."
                                            },
                                            {
                                                "example_id": "eeb7f253-0f83-44bd-aaa4-bdc136707776",
                                                "sense_id": "815c49c7-dfe9-3430-b9d4-72edc7961d23",
                                                "text": "„Dort, wo Giordano Bruno 33 Jahre zuvor im Büßerhemd kniend sein Todesurteil entgegennahm, im Festsaal des römischen Klosters St. Maria sopra Minerva, hat Galileo Galilei diesen Meineid geschworen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
