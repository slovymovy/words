                        "translation_id": "8c9f3210-ff9b-482a-bab8-465a9344c8d1",
                        "source_entry_id": "694a9ebc-cd49-3854-8420-bdf5af11f59c",
                        "source_sense_id": "bee0699e-6e0d-34f7-aab6-e1abf6c7e4d9",
