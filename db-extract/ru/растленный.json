                ],
                "translations": [
                    {
                        "translation_id": "9ebbb1d5-f80c-4154-89a5-468fec217f9b",
                        "source_entry_id": "a5949906-d2bc-342f-aa8e-2469547225a1",
                        "target_lang_word": "débauché",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "débauché",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "668f30e2-9822-329a-9ada-099325496816",
                                        "entry_id": "e1dbc617-4bf2-362f-8ab5-07a63023e660",
                                        "glosses": [
                                            "Qui est attiré à la débauche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f54613b8-31e7-42f5-b737-b4746da8d284",
                                                "sense_id": "668f30e2-9822-329a-9ada-099325496816",
                                                "text": "Le duc d’Orléans était leur garant, leur pavillon, leur espoir. Ils le savaient futile, versatile, influençable, […], aussi dépourvu de sens critique que de sens pratique, joueur, débauché, dépensier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd20ce0f-aea0-3fbe-b03f-f271729633f5",
                                        "entry_id": "e1dbc617-4bf2-362f-8ab5-07a63023e660",
                                        "glosses": [
                                            "Qui vit dans la débauche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ddc4278-8bc4-43ff-9838-7effc85cdb09",
                                                "sense_id": "dd20ce0f-aea0-3fbe-b03f-f271729633f5",
                                                "text": "J'ai grand-peur, confie-t-il un jour a des familiers, que cette dame débauchée ne la fasse devenir sujette au vin et aux femmes, et ne la mette sur les dents avant de me la rendre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a34eda1-5047-30b4-98e8-0f7c49f5c89a",
                                        "entry_id": "e1dbc617-4bf2-362f-8ab5-07a63023e660",
                                        "glosses": [
                                            "Détourné de son travail, de ses obligations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "962327d7-82cf-4bc5-8beb-ccdaccdaf7f4",
                                                "sense_id": "7a34eda1-5047-30b4-98e8-0f7c49f5c89a",
                                                "text": "Des ouvriers débauchés de l'atelier par l'appât d'un salaire plus élevé. Les soldats étrangers, débauchés par des émissaires, quittaient en foule son service."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e6ff332-c3a0-347c-a992-ae7fcccad938",
                                        "entry_id": "e1dbc617-4bf2-362f-8ab5-07a63023e660",
                                        "glosses": [
                                            "Entraîné dans partie de plaisir, une distraction."
                                        ],
                                        "tags": [
                                            "Plus rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df461358-6d3e-4fdf-be8e-370a417c2016",
                                                "sense_id": "5e6ff332-c3a0-347c-a992-ae7fcccad938",
                                                "text": "Mme de Coulanges me presse [d'y aller] d'un si bon ton, que me voilà débauchée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "débauché",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "822dd30c-46a3-3f1c-9a65-b588a98916e9",
                                        "entry_id": "4b1909bf-58d2-3f46-bae8-2edbf332d523",
                                        "glosses": [
                                            "Homme qui vit dans la débauche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dea9044-3b82-4049-9b97-4a7b75d7bc30",
                                                "sense_id": "822dd30c-46a3-3f1c-9a65-b588a98916e9",
                                                "text": "Le débauché se rit des discours de son père,\n Et, dans vingt et cinq ans venant à se changer,\n Retenu, vigilant, soigneux et ménager,\n De ces mêmes discours ses fils il admonête,\n Qui ne font que s’en rire et que hocher la tête. — (Régnier, Satire. V)"
                                            },
                                            {
                                                "example_id": "dcb29e02-af96-4696-a401-4ae2318bc63c",
                                                "sense_id": "822dd30c-46a3-3f1c-9a65-b588a98916e9",
                                                "text": "Bientôt son hôtesse nouvelle,\n Le prêchant, lui fit voir qu’il était auprès d'elle\n Un vrai dissipateur, un parfait débauché."
                                            },
                                            {
                                                "example_id": "66b45905-50d6-435e-9ff4-52c2c927914b",
                                                "sense_id": "822dd30c-46a3-3f1c-9a65-b588a98916e9",
                                                "text": "Il est certain que le débauché dissipera son talent, que le buveur le dépensera dans ses libations, sans que l’homme vertueux puisse se donner du talent par une honnête hygiène."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "débauché",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f24ca975-3ae3-3bbe-b9f7-aa3c781c3379",
                                        "entry_id": "9e1604dc-e4bf-3bce-a056-758a71f3bd29",
                                        "glosses": [
                                            "Participe passé masculin singulier de débaucher."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79d28b93-726e-4974-806d-6ccbb12c1287",
                        "source_entry_id": "a5949906-d2bc-342f-aa8e-2469547225a1",
                        "target_lang_word": "dépravé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dépravé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3fc55716-cabc-3def-aad7-abd2fd9ccc69",
                                        "entry_id": "b86f6d0d-9200-3b78-bc1b-7c4d84872640",
                                        "glosses": [
                                            "Qui vit dans la dépravation, dans la débauche, dans le vice."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ad68fca-3190-4920-a157-1a236263a662",
                                                "sense_id": "3fc55716-cabc-3def-aad7-abd2fd9ccc69",
                                                "text": "Elle n’était pas dépravée ; sa passion, au contraire, se montrait robuste et saine, et, dans ses embrassements, elle avait la noblesse terrible, l’héroïsme rugissant des grands fauves."
                                            },
                                            {
                                                "example_id": "f803fbd0-6dab-4918-bf7e-359434a708b0",
                                                "sense_id": "3fc55716-cabc-3def-aad7-abd2fd9ccc69",
                                                "text": "Dans le nombre de ces Parisiens accusés d’être si spirituels, il s’en trouve qui se croient infiniment mieux en uniforme que dans leurs habits ordinaires, et qui supposent chez les femmes des goûts assez dépravés pour imaginer qu’elles seront favorablement impressionnées à l’aspect d’un bonnet à poil et par le harnais militaire."
                                            },
                                            {
                                                "example_id": "fb938e1c-1b99-4e76-bf0d-45fcd16419c1",
                                                "sense_id": "3fc55716-cabc-3def-aad7-abd2fd9ccc69",
                                                "text": "Carel me parla d'une querelle entre eux, Rembrandt me traitant de prostituée, de soiffarde dépravée, alors Carel l'a frappé. Il l'a frappé... Pour moi."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dépravé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2af6391b-9f83-34f3-a0cc-4cae1560992d",
                                        "entry_id": "c131b573-d632-3e82-ae9f-0f28024640c4",
                                        "glosses": [
                                            "Participe passé masculin singulier de dépraver."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36f9cea0-c1c7-4469-b36e-b55d94726dbc",
                                                "sense_id": "2af6391b-9f83-34f3-a0cc-4cae1560992d",
                                                "text": "Moins surveillé par David à Angoulême, soit que plus âgé il inspirât plus de confiance à son mentor, soit que l’imprimeur comptât sur l’influence de la province, Cérizet était devenu, mais à l’insu de son tuteur, le don Juan en casquette de trois ou quatre petites ouvrières, et s’était dépravé complètement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
