                "senses": [
                    {
                        "sense_id": "b0a82ec3-0ed2-3521-b68d-ac01d179dc4c",
                        "entry_id": "8a4af93b-0f4c-3c48-a3d8-6b9f07484de8",
                        "glosses": [
                            "freemasonry, masonry"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f48e71f-0409-4cf4-bcf4-a5b4e41af7a9",
                                "sense_id": "b0a82ec3-0ed2-3521-b68d-ac01d179dc4c",
                                "text": "Он твёрдо ве́рил в возмо́жность бра́тства люде́й, соединённых с це́лью подде́рживать друг дру́га на пути́ доброде́тели, и таки́м представля́лось ему́ масо́нство.",
                                "translation": "He firmly believed in the possibility of the brotherhood of men united in the aim of supporting one another in the path of virtue, and that is how Freemasonry presented itself to him.",
                                "english": "He firmly believed in the possibility of the brotherhood of men united in the aim of supporting one another in the path of virtue, and that is how Freemasonry presented itself to him."
                            }
                        ]
                    }
                ],
                "translations": [],
