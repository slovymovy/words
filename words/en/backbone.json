{
    "word_family": [
        "backboned",
        "backboneless"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b11952ab-1d61-3b01-ba2a-40aba4e21e11",
                    "sense_definition": "The column of bones that runs along the middle of the back in vertebrate animals, supporting the body and protecting the spinal cord.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Injuring your <w>backbone</w> can cause serious problems with walking and balance.",
                            "target_lang_translations": {
                                "pl": "Uraz <w>kręgosłupa</w> może spowodować poważne problemy z chodzeniem i równowagą."
                            }
                        },
                        {
                            "text": "The doctor took an X-ray to examine the broken bones in his <w>backbone</w>.",
                            "target_lang_translations": {
                                "pl": "Lekarz wykonał zdjęcie rentgenowskie, aby zbadać złamane kości w jego <w>kręgosłupie</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "spine",
                        "spinal column",
                        "vertebral column"
                    ],
                    "common_phrases": [
                        "fractured backbone",
                        "animal backbone"
                    ],
                    "target_lang_definitions": {
                        "pl": "Szereg połączonych kości biegnący wzdłuż grzbietu u kręgowców, stanowiący główną oś ciała i chroniący rdzeń kręgowy."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "kręgosłup",
                                "target_lang_sense_clarification": "część szkieletu u ludzi i zwierząt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94edb3f9-2971-3110-9d74-54a80b924417",
                    "sense_definition": "The most important part of something, providing essential support, structure, or strength.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Small businesses are considered the <w>backbone</w> of the local economy.",
                            "target_lang_translations": {
                                "pl": "Małe przedsiębiorstwa są uważane za <w>kręgosłup</w> lokalnej gospodarki."
                            }
                        },
                        {
                            "text": "Before automobiles were invented, railroads formed the <w>backbone</w> of national trade.",
                            "target_lang_translations": {
                                "pl": "Zanim wynaleziono samochody, kolej stanowiła <w>trzon</w> handlu krajowego."
                            }
                        }
                    ],
                    "common_phrases": [
                        "backbone of the economy",
                        "form the backbone"
                    ],
                    "target_lang_definitions": {
                        "pl": "Najważniejsza część czegoś, stanowiąca podstawę, oparcie lub główną strukturę."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "kręgosłup",
                                "target_lang_sense_clarification": "główna oś, podpora lub fundament"
                            },
                            {
                                "target_lang_word": "trzon",
                                "target_lang_sense_clarification": "zasadniczy, najważniejszy element całości"
                            },
                            {
                                "target_lang_word": "filar",
                                "target_lang_sense_clarification": "główny element wspierający"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "439ef920-49c2-3bc6-9ee6-3c00a64ca9e0",
                    "sense_definition": "Strength of character, courage, or determination to stand up for oneself or endure difficulty.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He needs to show some <w>backbone</w> and tell his boss the truth.",
                            "target_lang_translations": {
                                "pl": "Musi pokazać trochę <w>charakteru</w> i powiedzieć swojemu szefowi prawdę."
                            }
                        },
                        {
                            "text": "She showed great <w>backbone</w> by refusing to compromise on her principles.",
                            "target_lang_translations": {
                                "pl": "Wykazała się wielkim <w>hartem ducha</w>, odmawiając pójścia na kompromis w kwestii swoich zasad."
                            }
                        }
                    ],
                    "common_phrases": [
                        "show some backbone",
                        "have the backbone"
                    ],
                    "target_lang_definitions": {
                        "pl": "Siła charakteru, odwaga lub determinacja, by bronić swoich przekonań i stawiać czoła trudnościom."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "kręgosłup moralny",
                                "target_lang_sense_clarification": "zasady etyczne, nieugiętość"
                            },
                            {
                                "target_lang_word": "charakter",
                                "target_lang_sense_clarification": "siła woli, stanowczość"
                            },
                            {
                                "target_lang_word": "odwaga",
                                "target_lang_sense_clarification": "śmiałość, hart ducha"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}