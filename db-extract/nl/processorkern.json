                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9b62569-c9b3-4804-abf5-fa9679b8a04c",
                                                "sense_id": "c2210068-f950-3b70-b57a-3184eafb8fc2",
                                                "text": "In a hollow-core design, neutrons escape from the core more readily, allowing more fissile material to be used (and thus allowing for a greater yield) while still keeping the core subcritical prior to detonation."
                                            }
                                        ]
                                    },
