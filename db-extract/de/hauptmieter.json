                "senses": [
                    {
                        "sense_id": "8c15e58e-dc6b-336b-9630-854ee084dbd9",
                        "entry_id": "04284537-5f2f-3f92-a785-c2d9f619d4b9",
                        "glosses": [
                            "Person, die ein Objekt (zum Beispiel eine Wohnung) vom Eigentümer mietet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a36f490f-e88f-454a-b89d-6e2162649bf9",
                                "sense_id": "8c15e58e-dc6b-336b-9630-854ee084dbd9",
                                "text": "„Hauptmieter hingegen waren meldepflichtig für Untermieter, Bettgeher, Lehrlinge, Dienstboten oder Verwandte, im Prinzip für alle, die entgeltlich oder unentgeltlich in der Wohnung wochen- oder monatsweise aufgenommen wurden, ebenso für Kinder, die das 18. Lebensjahr überschritten hatten und somit mit einem eigenen Meldezettel angemeldet werden mussten. “"
                            },
                            {
                                "example_id": "14fbb6e6-358f-4bf5-bc9b-8b90b48218b3",
                                "sense_id": "8c15e58e-dc6b-336b-9630-854ee084dbd9",
                                "text": "„Er faßte den Plan, selbst Hauptmieter eines Hauses zu werden, um mir dessen besten Teil zu überlassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
