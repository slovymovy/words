                "senses": [
                    {
                        "sense_id": "7ffdd82b-1ad0-315a-9dd1-33164983a6b6",
                        "entry_id": "fa52f852-55a9-348e-8c06-77bc6aed6148",
                        "glosses": [
                            "Personne qui fend du bois, du fer, de l’ardoise, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f78a288-b104-4629-a891-b034640855a6",
                                "sense_id": "7ffdd82b-1ad0-315a-9dd1-33164983a6b6",
                                "text": "La pierre ardoise étant amenée au jour, il s'agit de la transformer en ardoises. Dans ce but, elle est livrée à des ouvriers spéciaux appelés fendeurs ou ouvriers du jour qui, à l'aide d'un long ciseau qu'ils passent entre les joints, la divisent en feuillets d'une épaisseur déterminée."
                            },
                            {
                                "example_id": "658b3667-a76d-4c01-9a3b-e2c07b89bd86",
                                "sense_id": "7ffdd82b-1ad0-315a-9dd1-33164983a6b6",
                                "text": "Un fendeur ne peut changer l'établi qui lui est assigné, parce que les crénons se distribuent par ordre de rang."
                            },
                            {
                                "example_id": "9ac4204f-686c-41ab-bd26-8846de945a37",
                                "sense_id": "7ffdd82b-1ad0-315a-9dd1-33164983a6b6",
                                "text": "L'homme appartenait peut-être à une secte de fendeurs de bornes d'incendie. Ou peut-être faisait-il partie d'un nouveau service municipal chargé de vérifier le bon fonctionnement des bornes d'incendie en les tranchant en deux."
                            }
                        ]
                    },
                    {
                        "sense_id": "46d44106-0a18-3a00-9a89-f0a95600a6bc",
                        "entry_id": "fa52f852-55a9-348e-8c06-77bc6aed6148",
                        "glosses": [
                            "Personne qui fend du bois, du fer, de l’ardoise, etc.",
                            "Ouvrier qui fend les rouages d'une montre ou d'un pendule."
                        ],
