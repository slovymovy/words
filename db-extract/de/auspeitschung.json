                            {
                                "example_id": "589168da-85f8-4e1a-bc51-d7b1a3518337",
                                "sense_id": "a8f22a40-f617-3808-a449-74e81364cd44",
                                "text": "„Die Brigade erging sich in Auspeitschungen, Vergewaltigungen und Hinrichtungen, wobei die überlebenden Dorfbewohner zuschauen mussten.“"
                            }
                        ],
