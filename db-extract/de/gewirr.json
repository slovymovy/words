                                        "examples": [
                                            {
                                                "example_id": "74d5b5e6-0e16-479b-acc7-18fc5ea08172",
                                                "sense_id": "d8481ce2-72a1-33dd-a5c0-96c7341588cf",
                                                "text": "[…] if with thee the roaring wells\n⁠Should gulf him fathom-deep in brine;\n⁠And hands so often clasp’d in mine,\nShould toss with tangle and with shells."
                                            },
                                            {
                                                "example_id": "7834b909-ec9c-4c85-9644-2b2e01d2c8da",
                                                "sense_id": "d8481ce2-72a1-33dd-a5c0-96c7341588cf",
                                                "text": "You've never smelled the tangle o' the Isles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf00f7b7-cea3-3583-9bcf-6e237565ff66",
                                        "entry_id": "902af8b8-2e02-3f73-9153-0297ec2d6bee",
                                        "glosses": [
                                            "An instrument consisting essentially of an iron bar to which are attached swabs, or bundles of frayed rope, or other similar substances, used to capture starfishes, sea urchins, and other similar creatures living at the bottom of the sea."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c2a2b29-9ee0-3e6f-889a-9d2fb90dcc34",
                                        "entry_id": "902af8b8-2e02-3f73-9153-0297ec2d6bee",
                                        "glosses": [
                                            "Any long hanging thing, even a lanky person."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4254b354-b13b-478d-ae0c-2421545d69d4",
                        "source_entry_id": "b0c6ae21-3048-39c1-8675-eea5519f4be4",
                        "source_sense_id": "bba1ad6a-38b9-3b3d-addb-0567fafc9834",
                        "source_sense_description": "auf den ersten Eindruck hin undurchschaubares Durcheinander von irgendwelchen Dingen",
                        "target_lang_word": "enchevêtrement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enchevêtrement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "35307dfb-aa0d-36a7-90b1-74709ab3066c",
                                        "entry_id": "4b3021b4-d2bc-376e-900e-16db5fbbb595",
                                        "glosses": [
                                            "Action d’enchevêtrer ou état d’une ou de plusieurs choses enchevêtrées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c390b40-0a15-413c-829f-65fa0daf1ed0",
                                                "sense_id": "35307dfb-aa0d-36a7-90b1-74709ab3066c",
                                                "text": "De ce côté, le rivage, capricieusement festonné, creusé de criques et d'anses, hérissé de caps aigus et de promontoires abrupts, allait se perdre dans ce confus enchevêtrement de détroits, de pertuis, de passes, qui donne aux cartes des continents polaires un si bizarre aspect."
                                            },
                                            {
                                                "example_id": "ad90fa70-ad41-4eb0-89c6-01dfce86adff",
                                                "sense_id": "35307dfb-aa0d-36a7-90b1-74709ab3066c",
                                                "text": "Le martelage peut être remplacé par le laminage, mais ce moyen est inférieur parce qu'il ne réalise pas une pénétration aussi parfaite, un enchevêtrement aussi complet des molécules."
                                            },
                                            {
                                                "example_id": "2145f1a8-f51e-4e94-b9d7-e3220bf3a30d",
                                                "sense_id": "35307dfb-aa0d-36a7-90b1-74709ab3066c",
                                                "text": "Pour la première fois, Lucile disposait d’un territoire propre, auquel nul autre n’avait accès. Elle y installa son désordre, vêtements et livres dans un enchevêtrement qu’elle seule maîtrisait, et referma la porte derrière elle."
                                            },
                                            {
                                                "example_id": "d6586dfc-c89b-49fe-90e8-e71b6148a2c0",
                                                "sense_id": "35307dfb-aa0d-36a7-90b1-74709ab3066c",
                                                "text": "Jardin dickinsonien –\nUn enchevêtrement\nde tiges, feuilles et fleurs\nde sucepin,\nvenant\nd’un herbier iridescent,\nenvahit\nle jardin panoramique\n…\nde ma vitre givrée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "372c9a4d-5142-4897-90e2-504fc24b66c1",
                        "source_entry_id": "b0c6ae21-3048-39c1-8675-eea5519f4be4",
                        "source_sense_id": "bba1ad6a-38b9-3b3d-addb-0567fafc9834",
                        "source_sense_description": "auf den ersten Eindruck hin undurchschaubares Durcheinander von irgendwelchen Dingen",
                        "target_lang_word": "беспорядок",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "беспорядок",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "11a0645e-e982-3f6a-8447-4a8e5eaf3b45",
                                        "entry_id": "1a7b7027-7cba-342f-91a6-f39b80cb9cbc",
                                        "glosses": [
                                            "отсутствие порядка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d1f4ec8-7643-4de4-8bc3-ec011299aa79",
                                                "sense_id": "11a0645e-e982-3f6a-8447-4a8e5eaf3b45",
                                                "text": "Жена моя лишилась отличной горничной, но делать было нечего: беспорядок в доме терпеть, однако же, нельзя."
                                            },
                                            {
                                                "example_id": "69782d9c-4947-4306-a92a-f320a2d95581",
                                                "sense_id": "11a0645e-e982-3f6a-8447-4a8e5eaf3b45",
                                                "text": "— Рассказывая тебе мои похождения, я и забыла, что платье моё в беспорядке."
                                            },
                                            {
                                                "example_id": "bf5b5049-dc69-44bb-8517-e26cba1ef148",
                                                "sense_id": "11a0645e-e982-3f6a-8447-4a8e5eaf3b45",
                                                "text": "Он тихо освободил голову от её руки, вынул из кармана гребёнку и тщательно причесал приведенные ею в беспорядок волосы."
                                            },
                                            {
                                                "example_id": "85d68005-9c15-4ebf-92c5-39c211594acb",
                                                "sense_id": "11a0645e-e982-3f6a-8447-4a8e5eaf3b45",
                                                "text": "Прямо-таки совестно было глядеть на детдомовские беспорядки, словно сам был в них виноват: «Куда это годится."
                                            },
                                            {
                                                "example_id": "1f3332b3-00c0-4172-ad69-4e7adc05f939",
                                                "sense_id": "11a0645e-e982-3f6a-8447-4a8e5eaf3b45",
                                                "text": "Старик умеет работать и нетерпим к беспорядку, недобросовестности, сачковству."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "400912e6-ca39-35ca-94a4-145047371ded",
                                        "entry_id": "1a7b7027-7cba-342f-91a6-f39b80cb9cbc",
                                        "glosses": [
                                            "бунт, народные выступления"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3aa9403e-17a0-4a04-a35f-b6e7b065abf8",
                                                "sense_id": "400912e6-ca39-35ca-94a4-145047371ded",
                                                "text": "Состою я уже около тридцати лет на службе; служу безукоризненно, поведения трезвого, в беспорядках никогда не замечен."
                                            },
                                            {
                                                "example_id": "b8f96a27-cf39-4bec-9172-6745bdc26262",
                                                "sense_id": "400912e6-ca39-35ca-94a4-145047371ded",
                                                "text": "Вожди, обнаружив неудовольствие на эти грабежи, объявили, однако же, что они не в состоянии отвратить беспорядков."
                                            },
                                            {
                                                "example_id": "aae7868e-ee7f-4f93-8670-6c3c7f28e4a5",
                                                "sense_id": "400912e6-ca39-35ca-94a4-145047371ded",
                                                "text": "Уличные беспорядки будут подавляться с помощью силовых полей, как и опрометчивые военные акции, ― ни одна ракета не сможет взлететь, и всякое воздушное сообщение временно прекращено."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
