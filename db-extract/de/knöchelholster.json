                    {
                        "sense_id": "e581dfc4-5e64-3911-8f8e-073614f34da8",
                        "entry_id": "c514c6a5-1596-3d69-a371-d0f38edd0e22",
                        "glosses": [
                            "Holster, das am Knöchel befestigt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e57e806-3562-4abd-9d85-a94bbcf5c267",
                                "sense_id": "e581dfc4-5e64-3911-8f8e-073614f34da8",
                                "text": "„Er ließ die Hände in den Schoß sinken, doch der Abstand zwischen seinen Fingern und dem Ersatzrevolver in seinem Knöchelholster schien unüberbrückbar.“"
                            },
                            {
                                "example_id": "7ebe23e4-b711-4e04-b701-441d3d506a1a",
                                "sense_id": "e581dfc4-5e64-3911-8f8e-073614f34da8",
                                "text": "„Vielleicht trugen sie ein Knöchelholster, aber das musste mich kaum beunruhigen.“"
                            },
                            {
                                "example_id": "1a6dbec1-c1be-47f6-9ebe-37e474ad326f",
                                "sense_id": "e581dfc4-5e64-3911-8f8e-073614f34da8",
                                "text": "„Seine Desert Eagle, Kaliber 44 hatte er indessen an seinem rechten Bein in einem Knöchelholster versteckt platziert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
