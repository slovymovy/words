                    },
                    {
                        "form_id": "506c933d-d4d2-4d6c-ad41-a70e550f11c9",
                        "entry_id": "3338cfdf-fdc6-3fd6-bd83-4b03aef551d1",
                        "tags": [],
                        "form": "agro-chimie"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "81e4c3b5-b981-3cd6-8917-e38a5640a6aa",
                        "entry_id": "3338cfdf-fdc6-3fd6-bd83-4b03aef551d1",
                        "glosses": [
                            "Chimie appliquée aux besoins de l’agriculture pour la production d’engrais, de pesticides, d’herbicides, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b22004f-4ed5-43a0-b481-5137e06dabb1",
                                "sense_id": "81e4c3b5-b981-3cd6-8917-e38a5640a6aa",
                                "text": "À partir de 1775, Lavoisier sert à l’Administration royale des poudres : son travail se traduira par des améliorations dans la production de la poudre et dans le domaine de l’agrochimie, par la création d'une nouvelle méthode de production du salpêtre avec la potasse d’Alsace."
                            },
                            {
                                "example_id": "769c3dcf-ab30-4d1f-9897-32954dc139b8",
                                "sense_id": "81e4c3b5-b981-3cd6-8917-e38a5640a6aa",
                                "text": "D’une façon générale, l’agriculture écologique est une alternative et un antidote à l’agrochimie."
                            },
                            {
                                "example_id": "fd6a906a-c79a-4fa9-837c-d68b1058b459",
                                "sense_id": "81e4c3b5-b981-3cd6-8917-e38a5640a6aa",
                                "text": "Comme si cela ne suffisait pas, la molécule vedette du champion de l’agrochimie est désormais soupçonnée d’être en prime un perturbateur endocrinien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "26408b3a-b48e-45ba-acb2-dba4e34b9911",
                        "source_entry_id": "3338cfdf-fdc6-3fd6-bd83-4b03aef551d1",
                        "source_sense_id": "81e4c3b5-b981-3cd6-8917-e38a5640a6aa",
