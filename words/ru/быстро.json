    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "be204446-7804-3473-8aaa-eaeefb479f1d",
                    "sense_definition": "С большой скоростью; очень активно, энергично, не теряя времени.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "speed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он всегда <w>быстро</w> ходит по улице.",
                            "target_lang_translations": {
                                "en": "He always walks <w>fast</w> down the street.",
                                "zh": "他走在街上总是走得很<w>快</w>。"
                            }
                        },
                        {
                            "text": "Мы должны <w>быстро</w> закончить эту работу.",
                            "target_lang_translations": {
                                "en": "We must finish this work <w>quickly</w>.",
                                "zh": "我们必须<w>赶快</w>完成这项工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "скоро",
                        "стремительно",
                        "живо",
                        "проворно",
                        "спешно",
                        "торопливо"
                    ],
                    "antonyms": [
                        "медленно",
                        "небыстро"
                    ],
                    "common_phrases": [
                        "очень быстро",
                        "быстро бегать",
                        "быстро идти",
                        "быстро расти",
                        "быстро говорить"
                    ],
                    "target_lang_definitions": {
                        "en": "With great speed; very actively or energetically.",
                        "zh": "以极高的速度；非常积极或充满活力地，不浪费时间。"
                    },
                    "translations": {
                        "en": [
                            {
