                        "translation_id": "c2b83d06-ae93-44f3-a565-945c271329a6",
                        "source_entry_id": "012e695a-04cd-365a-adc0-087a48c76ab8",
                        "source_sense_id": "6633bd0d-8c52-3864-ae8f-3787dadb3905",
