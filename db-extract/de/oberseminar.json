                "senses": [
                    {
                        "sense_id": "5051933f-cb08-3e58-8a69-49df733ccd07",
                        "entry_id": "fe6ae6a2-2b16-39ba-aa06-935c3780a6fe",
                        "glosses": [
                            "Lehrveranstaltung im Hauptstudium für Studierende, deren Studienabschluss bald bevorsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6036250-ae60-4bf3-bf0f-a7463e06fb3e",
                                "sense_id": "5051933f-cb08-3e58-8a69-49df733ccd07",
                                "text": "„Seit Jahren veranstalte ich nur noch dieses eine Seminar, ein großes Oberseminar über Literaturkritik mit dem Titel »Praktische Kritik«.“"
                            },
                            {
                                "example_id": "d8f52b08-c6d8-4394-81ca-a032e536afde",
                                "sense_id": "5051933f-cb08-3e58-8a69-49df733ccd07",
                                "text": "„Hugo hatte uns zu Weihnachten eine Reise nach Rom geschenkt, vorher aber wollte er einen Entwurf seiner Doktorarbeit fertig geschrieben, ich meinen Platz in Henkes Oberseminar erobert haben.“"
                            },
                            {
                                "example_id": "bdfb0250-8342-4a7a-95b5-12a83b4d38f8",
                                "sense_id": "5051933f-cb08-3e58-8a69-49df733ccd07",
                                "text": "„Ich hatte mich auf diesen Abend sehr gefreut, war todmüde und erwartete eine Art fröhlicher Zusammenkunft, mit viel gutem Wein, gutem Essen, vielleicht Tanz (es ging uns dreckig, und wir konnten uns weder Wein noch gutes Essen leisten); stattdessen gab es schlechten Wein, und es wurde ungefähr so, wie ich mir ein Oberseminar für Soziologie bei einem langweiligen Professor vorstelle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
