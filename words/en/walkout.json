{
    "word_family": [
        "walk"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e9bbf626-3737-343c-b65c-c64f7e0eea24",
                    "sense_definition": "A sudden, often informal strike or stoppage of work by employees to protest working conditions or pay.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "protest_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Factory employees staged a brief <w>walkout</w> after contract negotiations collapsed.",
                            "target_lang_translations": {
                                "zh": "合同谈判破裂后，工厂员工举行了短暂的<w>罢工</w>。"
                            }
                        },
                        {
                            "text": "The unexpected <w>walkout</w> left commuters stranded without train service all morning.",
                            "target_lang_translations": {
                                "zh": "这场突如其来的<w>罢工</w>导致整上午都没有列车运行，让通勤人员滞留路上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "strike#Noun"
                    ],
                    "common_phrases": [
                        "stage a walkout"
                    ],
                    "target_lang_definitions": {
                        "zh": "（为抗议工作条件或薪资而突然发起的、通常非正式的）罢工"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "罢工",
                                "target_lang_sense_clarification": "停工抗议"
                            },
                            {
                                "target_lang_word": "突发性罢工",
                                "target_lang_sense_clarification": "未事先通知的罢工"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ffe696e5-6d1a-35fe-b7cf-f19a438e65fc",
                    "sense_definition": "An act of leaving a meeting, event, or room collectively as an expression of disapproval or protest.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "protest_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Opposition members organized a <w>walkout</w> during the president's speech.",
                            "target_lang_translations": {
                                "zh": "反对派成员在总统演讲期间组织了集体<w>退席</w>抗议。"
                            }
                        },
                        {
                            "text": "Students planned a massive <w>walkout</w> to protest the changes in school policy.",
                            "target_lang_translations": {
                                "zh": "学生们计划发起大规模<w>罢课</w>，以抗议学校政策的变动。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "student walkout"
                    ],
                    "target_lang_definitions": {
                        "zh": "（为表示抗议或反对而采取的）集体退场，罢课"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "退席",
                                "target_lang_sense_clarification": "集体离席表示抗议"
                            },
                            {
                                "target_lang_word": "退场",
                                "target_lang_sense_clarification": "集体离开以示抗议"
                            },
                            {
                                "target_lang_word": "罢课",
                                "target_lang_sense_clarification": "学生离开课堂抗议"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd2e52d8-3ecb-37d0-9a14-541e82be14a8",
                    "sense_definition": "The phase of a barbell squat exercise where the lifter unhooks the bar and steps backward from the rack.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "weightlifting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Keep your core tight during the <w>walkout</w> to maintain stability under heavy loads.",
                            "target_lang_translations": {
                                "zh": "在<w>出杠后退</w>过程中收紧核心，以保持大重量下的稳定性。"
                            }
                        },
                        {
                            "text": "A sloppy <w>walkout</w> wastes energy before you even begin the first repetition.",
                            "target_lang_translations": {
                                "zh": "不规范的<w>出杠后退</w>甚至在开始第一次动作之前就浪费了体力。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "squat walkout"
                    ],
                    "target_lang_definitions": {
                        "zh": "（举重深蹲中）出杠后后退调整站姿的动作步骤"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "出杠后退",
                                "target_lang_sense_clarification": "深蹲起杠后的后退步"
                            },
                            {
                                "target_lang_word": "出杠走步",
                                "target_lang_sense_clarification": "举重中出架走位"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8c687f05-c455-3ed6-b950-59df94941eca",
                    "sense_definition": "Misspelling of <w>walk out</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He chose to <w>walkout</w> on his responsibilities instead of facing the problem.",
                            "target_lang_translations": {
                                "zh": "他选择逃避责任<w>一走了之</w>，而不是正视问题。"
                            }
                        },
                        {
                            "text": "Do not simply <w>walkout</w> when an argument becomes difficult.",
                            "target_lang_translations": {
                                "zh": "争论陷入僵局时不要只是<w>甩手而去</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "misspelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "walk out 的错误拼写形式；走出，弃之不顾"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "一走了之",
                                "target_lang_sense_clarification": "丢下责任离开"
                            },
                            {
                                "target_lang_word": "甩手而去",
                                "target_lang_sense_clarification": "愤怒或逃避地离开"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}