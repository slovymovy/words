                "senses": [
                    {
                        "sense_id": "6bd3668a-5875-3786-921d-fd5337da15df",
                        "entry_id": "d0e8138b-e2c1-3d33-a2e3-09c189e0f964",
                        "glosses": [
                            "полит. приверженец традиционализма"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e8fa74d-446c-4992-ba14-49e6fd38df3d",
                                "sense_id": "6bd3668a-5875-3786-921d-fd5337da15df",
                                "text": "Они были настоящими традиционалистами, что скорее всего означает, что они были людьми глубоко религиозными."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d3ff93a-0468-4a21-b8b7-30820b6cb26e",
                        "source_entry_id": "d0e8138b-e2c1-3d33-a2e3-09c189e0f964",
                        "source_sense_id": "6bd3668a-5875-3786-921d-fd5337da15df",
                        "target_lang_word": "traditionalist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "traditionalist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d37086cc-65f1-3e13-a8a6-751752b24d11",
                                        "entry_id": "a1ce09af-b97e-390e-9b6d-966c9e2480c9",
                                        "glosses": [
                                            "A person who adheres to tradition, especially in cultural or religious practices."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fc0dda3-24fd-4547-a7e0-737ee807e452",
                                                "sense_id": "d37086cc-65f1-3e13-a8a6-751752b24d11",
                                                "text": "Pullman traditionalists will no doubt maintain that the full-service-at-every-seat principle is popular with their clientele; […]."
                                            },
                                            {
                                                "example_id": "1bdf8156-cc65-4ce2-8f03-31f78b282632",
                                                "sense_id": "d37086cc-65f1-3e13-a8a6-751752b24d11",
                                                "text": "He speaks at conferences across the country and posts prolifically on social media on topics ranging from the ethics of Covid-19 vaccines (which he has questioned) to the Latin Mass favored by traditionalists (and discouraged by Pope Francis) to local conflicts between priests and bishops."
                                            },
                                            {
                                                "example_id": "285eedf9-3a82-4261-a6c2-20ce216d7bcb",
                                                "sense_id": "d37086cc-65f1-3e13-a8a6-751752b24d11",
                                                "text": "Among the frontrunners before the conclave began were Pietro Parolin, the Vatican’s secretary of state; Luis Antonio Tagle, a reformer from the Philippines; Péter Erdő, a traditionalist from Hungary; Robert Sarah, a cardinal from Guinea who criticised Francis’s papacy; and the moderate US cardinal Robert Prevost."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3264873-4f44-30b0-9131-ca5efd350ea4",
                                        "entry_id": "a1ce09af-b97e-390e-9b6d-966c9e2480c9",
                                        "glosses": [
                                            "A traditional climbing climber."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "traditionalist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "307c433d-8631-392c-aede-40313a9fdd34",
                                        "entry_id": "d36667a5-11d8-3902-84fa-34cb6c0f7897",
                                        "glosses": [
                                            "Adhering to tradition, especially in religious practices."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c0177a5-5ebd-4d79-8c79-a16496cfcedf",
                                                "sense_id": "307c433d-8631-392c-aede-40313a9fdd34",
                                                "text": "The day before, Cardinal Burke and other traditionalist prelates made public an exchange of letters with Francis in which they aired grave doubts about the legitimacy of a major assembly of the world’s bishops and laypeople that will, on Wednesday, begin discussing some of the most sensitive topics in the church."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
