                        },
                        {
                            "text": "We moesten rennen omdat de <w>metro</w> er al aan kwam.",
                            "target_lang_translations": {
                                "en": "We had to run because the <w>subway</w> was already arriving.",
                                "ru": "Нам пришлось бежать, потому что <w>поезд метро</w> уже приближался.",
                                "de": "Wir mussten rennen, weil die <w>U-Bahn</w> schon einfuhr.",
                                "pl": "Musieliśmy biec, ponieważ <w>metro</w> już nadjeżdżało.",
                                "fr": "Nous avons dû courir car le <w>métro</w> arrivait déjà.",
                                "it": "Abbiamo dovuto correre perché la <w>metropolitana</w> stava già arrivando.",
                                "cs": "Museli jsme běžet, protože <w>metro</w> už přijíždělo.",
                                "tr": "Koşmak zorunda kaldık çünkü <w>metro</w> zaten geliyordu.",
                                "es": "Tuvimos que correr porque el <w>metro</w> ya estaba llegando."
