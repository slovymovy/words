                "senses": [
                    {
                        "sense_id": "b1b3024e-c1c3-383a-86b7-c26237fd9e49",
                        "entry_id": "de56ae70-f681-3dd2-bc02-8f5373a9b508",
                        "glosses": [
                            "in einer Organisation für Flüchtlingsfragen zuständige Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efa95fd3-4f1c-4c2e-9746-1cc04d6d5c35",
                                "sense_id": "b1b3024e-c1c3-383a-86b7-c26237fd9e49",
                                "text": "„Neben Nahrungspaketen und Sachleistungen für den täglichen Bedarf erhalten sie Taschengeld: pro Kopf und Monat 80 Mark. \"Das reicht oft nicht einmal, um regelmäßig bei der Ausländerbehörde vorstellig zu werden, geschweige denn dazu, einen Rechtsanwalt zu bezahlen\", kritisiert Bernd Mesovic, Flüchtlingsreferent der Arbeitsgemeinschaft Pro Asyl. Für zwei Mark Stundenlohn würden Flüchtlinge zu gemeinnütziger Arbeit verdonnert, lehnen sie ab, werde das Taschengeld gestrichen.“"
                            },
                            {
                                "example_id": "ef86a5b9-73d7-4e6c-acd5-1ebea4b586f9",
                                "sense_id": "b1b3024e-c1c3-383a-86b7-c26237fd9e49",
                                "text": "„Nach dem Zweiten Weltkrieg siedelte Stech als Heimatvertriebener von Königsberg nach Westdeutschland über und ließ sich in Schleswig-Holstein nieder. Er war 1945/46 Flüchtlingsreferent im Ministerium für Aufbau und Umsiedlung des Landes Schleswig-Holstein, leitete seit 1946 das dortige Landesflüchtlingsamt und wurde zum Regierungsrat ernannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
