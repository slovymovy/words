                ],
                "senses": [
                    {
                        "sense_id": "3f894773-29d3-33ec-ba07-8cb0bd650a31",
                        "entry_id": "79468d7f-8a86-389d-8620-1e18fca558e8",
                        "glosses": [
                            "Qui se fait par une marche continue, par un mouvement régulier, sans interruption."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f7e1bbf-a875-422b-91bd-bb4dfc4f3884",
                                "sense_id": "3f894773-29d3-33ec-ba07-8cb0bd650a31",
                                "text": "L’ordre successif des nuits et des jours."
                            }
                        ]
                    },
                    {
                        "sense_id": "5075b941-1e6d-3204-bc66-a8aa98e511ad",
                        "entry_id": "79468d7f-8a86-389d-8620-1e18fca558e8",
                        "glosses": [
                            "Qualifie les choses qui se suivent de près, qui se succèdent les unes aux autres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5357f561-273c-4808-823e-ebebdc249651",
                                "sense_id": "5075b941-1e6d-3204-bc66-a8aa98e511ad",
                                "text": "Et Pausole observait debout les révélations successives d'un corps teinté, ferme, vivace, tandis qu'elle ouvrait tour à tour la chemisette bossue, la jupe monastique, le difforme pantalon blanc."
                            },
                            {
                                "example_id": "1a95ec13-449c-4963-9f69-bb7700760b26",
                                "sense_id": "5075b941-1e6d-3204-bc66-a8aa98e511ad",
                                "text": "Deux ratés successifs cela est rare et invraisemblable ; mais tout est rare et invraisemblable si l'on ne parle pas abstraitement ; car pourquoi ici et non là ?"
                            },
                            {
                                "example_id": "1c275e21-b5c9-460e-8f55-a9257b962261",
                                "sense_id": "5075b941-1e6d-3204-bc66-a8aa98e511ad",
                                "text": "- CERALIMENT.LU.BRUN à Augy fabrique des biscottes, du pain grillé, des biscuits et réalise de la panification fraîche. C’est une filiale de la GÉNÉRALE BISCUIT, l’un un des premiers groupes européens né de la fusion successive de plusieurs entreprises concurrentes."
                            },
                            {
                                "example_id": "66fb758c-fe12-477f-b089-b71f0bb2401f",
                                "sense_id": "5075b941-1e6d-3204-bc66-a8aa98e511ad",
                                "text": "Ils arrivent par vagues successives à partir de mai pour démarier, puis biner deux fois les betteraves, certains repartent dans leur pays et reviendront au moment de l'arrachage."
                            }
                        ]
                    },
                    {
                        "sense_id": "02186405-2136-3811-986e-e08d7fe9c53b",
                        "entry_id": "79468d7f-8a86-389d-8620-1e18fca558e8",
                        "glosses": [
                            "Relatif à une succession, à un héritage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6767e9a-5d9b-42a6-9ec2-116a5b75bf9f",
                                "sense_id": "02186405-2136-3811-986e-e08d7fe9c53b",
                                "text": "Droits successifs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d836f315-2285-48e9-b045-f188d4d8780e",
                        "source_entry_id": "79468d7f-8a86-389d-8620-1e18fca558e8",
