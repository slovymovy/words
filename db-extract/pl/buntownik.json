                        "target_lang_word": "Aufrührer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aufrührer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "27895a6e-b105-36e9-af95-2304b5f9a042",
                                        "entry_id": "d64ca895-405b-31d1-ad46-ccf5f34d8b8e",
                                        "glosses": [
                                            "Person, die offen gegen die bestehende Ordnung, in der Regel durch Einsatz illegaler Mittel, aufbegehrt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f70699dd-c590-4dd0-baa1-67c2735fb4a4",
                                                "sense_id": "27895a6e-b105-36e9-af95-2304b5f9a042",
                                                "text": "Auf Rügen verursachte derselbe Mißbrauch noch in der Jugend von Ernst Moritz Arndt Aufstände des Landvolkes, Soldaten wurden entsendet, Aufrührer eingekerkert; dafür suchten die Bauern Rache, sie lauerten einzelnen Edelleuten auf und erschlugen sie."
                                            },
                                            {
                                                "example_id": "c10879c7-81b8-42dd-8c03-16302a17959d",
                                                "sense_id": "27895a6e-b105-36e9-af95-2304b5f9a042",
                                                "text": "Adieu Welt, denn niemand will in dir fromm sein; täglich richtet man die Mörder, vierteilt die Verräter, hänget die Dieb, Straßenräuber und Freibeuter, köpft Totschläger, verbrennt Zauberer, straft Meineidige, und verjagt Aufrührer."
                                            },
                                            {
                                                "example_id": "08a297e3-a246-4cc0-b281-edf07a27c9d7",
                                                "sense_id": "27895a6e-b105-36e9-af95-2304b5f9a042",
                                                "text": "Heute wäre dasselbe Beginnen eitel und noch dazu sträflicher; wir wären Aufrührer, weil wir uns selber, und nicht durch fremde Gewalt, von der rechtmäßigen Obrigkeit löseten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
