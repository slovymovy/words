                                "target_senses": [
                                    {
                                        "sense_id": "df6c9cae-7a77-3127-8ea7-b3cf6bfcb62b",
                                        "entry_id": "14684b94-5863-3c29-818a-cc77e7e6203b",
                                        "glosses": [
                                            "exponent, kterým je nutno umocnit základ, abychom dostali logaritmované číslo"
                                        ],
                                        "tags": [],
