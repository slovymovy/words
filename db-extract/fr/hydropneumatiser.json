                "senses": [
                    {
                        "sense_id": "9d7a69c9-78df-3d69-96ea-e7c16adae9e5",
                        "entry_id": "f2cbe16d-da61-3ea9-bf49-b29c1f8ec476",
                        "glosses": [
                            "Rendre hydropneumatique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62584397-5763-4baa-9f23-67c89c60aa67",
                                "sense_id": "9d7a69c9-78df-3d69-96ea-e7c16adae9e5",
                                "text": "Ici, rien de semblable : le procédé nouveau s’applique presque sans frais ni perte de temps, et sans aucun changement à ce qui existe lorsqu’il s’agit d'une turbine déjà établie ; et l’incrédule le plus décidé à l’endroit du succès définitif, ne pourrait du moins indiquer où serait, en cas d’échec, la perte qu’éprouverait le manufacturier qui, ayant une turbine dans son usine, consentirait, comme essai, à la laisser hydropneumatiser."
                            },
                            {
                                "example_id": "d05048ff-609f-4d72-b07c-21391084fcbc",
                                "sense_id": "9d7a69c9-78df-3d69-96ea-e7c16adae9e5",
                                "text": "Grille amortisseuse pour turbines hydrauliques à impulsion hydropneumatisées"
                            }
                        ]
                    }
