                    }
                ],
                "senses": [
                    {
                        "sense_id": "5c59382a-5448-3899-bc4b-463bbfe3fc55",
                        "entry_id": "02bb5923-d3ce-3b84-9962-f6cd2c5be639",
                        "glosses": [
                            "ausländischer Arbeiter"
                        ],
                        "tags": [
                            "Swiss Standard German",
                            "derogatory",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "fb09134b-b330-46d9-a175-4bbe20e2d746",
                                "sense_id": "5c59382a-5448-3899-bc4b-463bbfe3fc55",
                                "text": "„Federico sah aus wie ein Fremdarbeiter und war auch einer.“"
                            },
                            {
                                "example_id": "ef4ed55b-bdb6-48a2-9e1b-19e9d8cc4809",
                                "sense_id": "5c59382a-5448-3899-bc4b-463bbfe3fc55",
                                "text": "„Handel und Arbeit wandern aus den armen Binnenländern in die reicheren und günstiger gelegenen Küstenstaaten ab, wo es freilich alsbald zu Ausschreitungen gegen die Fremdarbeiter kam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7a9e06ea-e5c6-3913-a592-56b9e5728199",
                        "entry_id": "02bb5923-d3ce-3b84-9962-f6cd2c5be639",
                        "glosses": [
                            "ausländischer Zwangsarbeiter"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "36fe7b75-316e-4cdb-8e3c-99c5f0994a6e",
                                "sense_id": "7a9e06ea-e5c6-3913-a592-56b9e5728199",
                                "text": "„Als Entschädigung dafür teilte die Gemeindeverwaltung der Wirtschaft zwei Fremdarbeiter zu, die Russen Pjotr und Vera.“"
                            },
                            {
                                "example_id": "4b233395-d15e-41a3-ba4f-a161fe6ab720",
                                "sense_id": "7a9e06ea-e5c6-3913-a592-56b9e5728199",
                                "text": "„Zum Beispiel durfte kein Fremdarbeiter seinen Standort auf dem Darß unbegleitet verlassen.“"
                            },
                            {
                                "example_id": "9b0be53e-6081-428e-8809-86cd28b867cb",
                                "sense_id": "7a9e06ea-e5c6-3913-a592-56b9e5728199",
                                "text": "„In den Jahren vor der Flucht war das Verhältnis der sogenannten Fremdarbeiter zu ihren Arbeitgebern vielschichtig gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
