                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b6990a57-d3c4-30b8-89c8-b64016ecf23c",
                        "entry_id": "5f5b48dc-8c01-3463-b3fe-ba08f9f0f960",
                        "glosses": [
                            "One who dumps a boyfriend or girlfriend; the one of a romantic couple who terminates the relationship."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "76ccb403-922c-3790-9c17-44f6c1f4131d",
                        "entry_id": "5f5b48dc-8c01-3463-b3fe-ba08f9f0f960",
                        "glosses": [
                            "A wave that knocks a surfer into the water."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d50649a-28ba-4359-89b5-9048a9b39f33",
                                "sense_id": "76ccb403-922c-3790-9c17-44f6c1f4131d",
                                "text": "The choice of a dumper can be disastrous for a comparatively unskilled surfer […]"
                            },
                            {
                                "example_id": "eea39bf6-65be-4e28-829e-e12b8f6d56e9",
                                "sense_id": "76ccb403-922c-3790-9c17-44f6c1f4131d",
                                "text": "[…] learning how to slide across the face of a wave is put to practical use when inadvertently catching a dumper (plunging wave)."
                            }
                        ]
                    },
                    {
                        "sense_id": "ccc5ecc3-b020-38f0-83d0-0342cfedb375",
                        "entry_id": "5f5b48dc-8c01-3463-b3fe-ba08f9f0f960",
                        "glosses": [
                            "A program that outputs the contents of storage or a data structure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "600218de-4a63-49b7-ad70-4a26c6ff3512",
                                "sense_id": "ccc5ecc3-b020-38f0-83d0-0342cfedb375",
                                "text": "Protected programs implement various measures of counteraction against debuggers, disassemblers, dumpers, and other hacker tools."
                            }
                        ]
                    },
                    {
                        "sense_id": "54496bcd-46c3-3e3c-b610-7873a785577a",
                        "entry_id": "5f5b48dc-8c01-3463-b3fe-ba08f9f0f960",
                        "glosses": [
                            "A person's buttocks."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "ae2c8c40-23c7-49db-b716-c31933276561",
                                "sense_id": "54496bcd-46c3-3e3c-b610-7873a785577a",
                                "text": "My ass doesn't have to be that big, right? I'll kick you a few CCs and then you and me will take our brand-new dumpers and we'll just go, you know, flaunting around Copacabana Beach."
                            }
                        ]
                    }
