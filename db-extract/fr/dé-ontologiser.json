                ],
                "senses": [
                    {
                        "sense_id": "33a3b1e0-650b-3abc-9a39-9aae590083b3",
                        "entry_id": "36b0da20-79d2-3cbc-8676-0ed5d707966b",
                        "glosses": [
                            "Donner un caractère déontologique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aba0c07c-2146-48a5-ae41-0f49c2ab495b",
                                "sense_id": "33a3b1e0-650b-3abc-9a39-9aae590083b3",
                                "text": "Il faut dé-ontologiser le détail."
                            },
                            {
                                "example_id": "8a6ae60e-4a6b-46c8-8c5b-c7eab43e5e8b",
                                "sense_id": "33a3b1e0-650b-3abc-9a39-9aae590083b3",
                                "text": "Le discours indirect, ainsi que l’usage du verbe « to call », dé-ontologisent l’événement et affirment la valeur politique et historique du discours."
                            },
                            {
                                "example_id": "f9e4da4f-0e66-4a61-a753-ee7cbf50aedb",
                                "sense_id": "33a3b1e0-650b-3abc-9a39-9aae590083b3",
                                "text": "Tout processus de connaissance, du moins telle est l’ambition de la théorie luhmannienne, se « dé-ontologise » dans le même mouvement."
                            }
                        ]
                    }
