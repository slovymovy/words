                                        "glosses": [
                                            "bedrijven die op grote schaal uit grondstoffen voedingsmiddelen maken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5c16d75-364f-4562-8c4a-e72476ad01c2",
                                                "sense_id": "1349ac96-bbb8-3dcb-a0f6-73cbb32a905e",
                                                "text": "Via een website gaat de voedselindustrie de dialoog aan met consumenten, politiek, wetenschappers en consumentenorganisaties."
                                            },
                                            {
                                                "example_id": "117e1926-4e3c-4bb7-88b2-687df5bd4a19",
                                                "sense_id": "1349ac96-bbb8-3dcb-a0f6-73cbb32a905e",
                                                "text": "Rabobank heeft wereldwijd 95 miljard euro aan kredieten uitstaan in de voedselindustrie. De bank heeft er dus baat bij dat producenten efficiënter werken. Volgens de bank kunnen ondernemers tijdens de oogst en verwerking tot eindproduct samen 10 miljard euro besparen aan gederfde inkomsten door voedselverspilling."
                                            }
                                        ]
