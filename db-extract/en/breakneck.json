                                        "examples": [
                                            {
                                                "example_id": "8c0dc1ec-88aa-463c-877f-de67337bc59c",
                                                "sense_id": "1bc6c0ea-a072-34dd-9f47-eeb35ba50055",
                                                "text": "„Mit vielen Dingen kann das Theater nicht mithalten: So halsbrecherische Stunts oder atemberaubende Filmtricks wie auf der Leinwand gibt es auf der Bühne nicht.“"
                                            },
                                            {
                                                "example_id": "719af570-893e-4634-974f-eee00211d937",
                                                "sense_id": "1bc6c0ea-a072-34dd-9f47-eeb35ba50055",
                                                "text": "„Neun brauste halsbrecherisch mit dem Quad den Hügel herab und bog auf die Straße.“"
                                            }
