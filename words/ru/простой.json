                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "work_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Завод понёс большие убытки из-за длительного <w>простоя</w> оборудования.",
                            "target_lang_translations": {
