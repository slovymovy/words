                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acf0859a-d909-4d16-b338-7693f3c5c550",
                                "sense_id": "c682de11-0640-38f5-b8ff-474dcf1e2ef8",
                                "text": "…il chercha désespérément dans les vins de Capoue et les chairs drues des Campaniennes l’innocence perdue à la boucherie de Trasimène."
                            },
                            {
                                "example_id": "1e4d1c4e-8b73-4fc4-bccb-b435d9980399",
                                "sense_id": "c682de11-0640-38f5-b8ff-474dcf1e2ef8",
                                "text": "Mais une certaine Paculla Annia, une Campanienne, avait changé cela sur l'ordre prétendu des dieux : les rites furent donnés aux hommes, on les célébra la nuit et cinq fois par mois."
                            }
                        ]
                    }
