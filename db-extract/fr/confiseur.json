                        "entry_id": "153a8f73-45a5-31df-904e-31ee59c9007a",
                        "glosses": [
                            "Celui qui fait et vend des confitures, des conserves de fruits, des dragées et toutes sortes de sucreries."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3faf084b-8d4c-40a1-b317-2643c784aa10",
                                "sense_id": "86b74976-3d0a-352a-bd57-9574e5c02aae",
                                "text": "Boutique, magasin de confiseur."
                            },
                            {
                                "example_id": "0f87aeff-0170-4cc3-b664-550829f8a382",
                                "sense_id": "86b74976-3d0a-352a-bd57-9574e5c02aae",
                                "text": "J’arrive chez le confiseur, je goûte, en demande le prix et apprend qu’il coûte cinquante roupies le kilo."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a7cabf0b-1793-44ee-81ee-d990ef688971",
