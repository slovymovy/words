                        "glosses": [
                            "Pertaining to Morpheus; sleepy, soporific, oneiric."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "aad8b159-90dc-4cb7-adf6-62552a82929b",
                                "sense_id": "d00197c8-829d-3685-969d-74e30b119db5",
                                "text": "Then by the bed-side, where the faded moon / Made a dim, silver twilight, soft he set / A table, and, half anguish'd, threw thereon / A cloth of woven crimson, gold and jet:— / O for some drowsy Morphean amulet!"
                            },
                            {
                                "example_id": "c5a39a4c-5f7d-4531-9ead-56c284ad53c1",
                                "sense_id": "d00197c8-829d-3685-969d-74e30b119db5",
                                "text": "The laird did not awake in any reasonable time; for, he being overcome with fatigue and wassail, his sleep became sounder, and his Morphean measures more intense."
                            }
                        ]
                    }
