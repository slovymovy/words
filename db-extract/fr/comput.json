        "fr-extract.jsonl": [
            {
                "entry_id": "6888611c-af50-37ed-817c-eba7ff15e469",
                "word": "comput",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "03763fe7-bc97-453b-984a-7fe66b513404",
                        "entry_id": "6888611c-af50-37ed-817c-eba7ff15e469",
                        "tags": [
                            "plural"
                        ],
                        "form": "computs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "55d341bf-e78c-303c-804b-4f97c321a208",
                        "entry_id": "6888611c-af50-37ed-817c-eba7ff15e469",
                        "glosses": [
                            "Dressement d’un tableau chronologique ou d’un calendrier d’après des données astronomiques, dans la tradition chrétienne ; son résultat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79d54c95-ce8a-4dd5-883e-6fa1cd2dce66",
                                "sense_id": "55d341bf-e78c-303c-804b-4f97c321a208",
                                "text": "Le comput ecclésiastique."
                            },
                            {
                                "example_id": "9e39d484-4e3d-433e-b452-e500fad2d022",
                                "sense_id": "55d341bf-e78c-303c-804b-4f97c321a208",
                                "text": "La définition de la date de la Pâques chrétienne fait référence à la phase de la Lune. Les cycles lunaires sont irréguliers. Aussi le comput utilise une Lune fictive, dite Lune du comput ou Lune ecclésiastique ou Lune de Méton."
                            },
                            {
                                "example_id": "a8b570d8-223a-4832-a9d7-42c9885234b8",
                                "sense_id": "55d341bf-e78c-303c-804b-4f97c321a208",
                                "text": "La concordance entre les computs julien et grégorien."
                            },
                            {
                                "example_id": "e5306edd-4de5-4531-b253-58f6c0f36fb3",
                                "sense_id": "55d341bf-e78c-303c-804b-4f97c321a208",
                                "text": "Ce cycle de 60 ans est typique chez tous les peuples dont le comput astronomique répondait à l’année lunaire."
                            },
                            {
                                "example_id": "57e0d2e9-28b2-4ce8-a821-66336896f178",
                                "sense_id": "55d341bf-e78c-303c-804b-4f97c321a208",
                                "text": "Ces intervalles de temps deviennent des moments \"critiques\", particulièrement fastes ou néfastes ; parfois même le calendrier différencie chaque jour, en le reliant à une figure médiatrice du divin (rôle des saints dans le comput chrétien)."
                            }
                        ]
                    },
                    {
                        "sense_id": "f50e5711-0c93-3da7-9f61-d354d6c5058e",
                        "entry_id": "6888611c-af50-37ed-817c-eba7ff15e469",
                        "glosses": [
                            "Récapitulation d’éléments homologues d’un texte ou d’un ensemble de textes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "037d2705-c10c-4b99-9cd8-4bdf17e6f035",
                                "sense_id": "f50e5711-0c93-3da7-9f61-d354d6c5058e",
                                "text": "Le Livre des commandements de Maïmonide est un comput des prescriptions de la Torah. — (Sefer Hamitzvot leRambam → lire en ligne)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6d708a30-1b98-46d0-99b2-ba77d3be7e87",
                        "source_entry_id": "6888611c-af50-37ed-817c-eba7ff15e469",
                        "target_lang_word": "computus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "computus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ac47106-b14e-39a1-b945-47a4ad455721",
                                        "entry_id": "2c02783b-9a29-38f2-bb51-199bfa5fdff8",
                                        "glosses": [
                                            "The calculation of the date of Easter in the Christian calendar."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "233b8883-777d-4471-81c2-9332f518536e",
                                                "sense_id": "2ac47106-b14e-39a1-b945-47a4ad455721",
                                                "text": "An elaborate bundle of techniques called computus therefore developed around Easter calculations. Computus formed the centerpiece of “scientific” education in the monasteries."
                                            },
                                            {
                                                "example_id": "0df721e9-9583-4b37-8367-a674db4f7287",
                                                "sense_id": "2ac47106-b14e-39a1-b945-47a4ad455721",
                                                "text": "Bede's work, which remained in active use for half a millennium, stood at the very center of the university curriculum, because the mastery of computus included many different essential subjects such as astronomy, mathematics, geography, theology, and law; its applications, too, included medicine and agriculture."
                                            },
                                            {
                                                "example_id": "4bdcf3b4-0a7e-4cbc-a394-5ecc08365df3",
                                                "sense_id": "2ac47106-b14e-39a1-b945-47a4ad455721",
                                                "text": "The technical problems faced by Western computists when it came to dating the day of Christ's Passion and the year of the world's creation were so persistent and perplexing that only a radical solution could restore the lost coherence of computus and chronography."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fee007fe-8ad2-3a5d-83f1-9f2a3d14028f",
                                        "entry_id": "2c02783b-9a29-38f2-bb51-199bfa5fdff8",
                                        "glosses": [
                                            "A book of tables for calculating dates of astronomical events and moveable feasts."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4d437d6-42e6-42ac-b80b-65fcbb09a6fd",
                                                "sense_id": "fee007fe-8ad2-3a5d-83f1-9f2a3d14028f",
                                                "text": "1987, Bruce Eastwood, 5: Plinian astronomical diagrams in the early Middle Ages, Edward Grant, John Emery Murdoch, Mathematics and Its Applications to Science and Natural Philosophy in the Middle Ages, page 149,\nThis computus also contains only one completed Plinian diagram, that for the planetary harmonic intervals."
                                            },
                                            {
                                                "example_id": "3a0082b6-7709-490f-91df-055f69ee8fc7",
                                                "sense_id": "fee007fe-8ad2-3a5d-83f1-9f2a3d14028f",
                                                "text": "Prognostics have thus been discovered in computi, in volumes on science or medicine, and in miscellanies which present a host of different text genres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
