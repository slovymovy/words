                        "sense_id": "9e2556d2-2b82-389f-9163-842628ef62d9",
                        "entry_id": "d85bafc8-03dd-3ae7-97a8-af6c37db412c",
                        "glosses": [
                            "Gesamtheit der sterilen Blattorgane der Blüte von bedecktsamigen Pflanzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cb54af4-94b0-4dc4-969d-f369c58263e3",
                                "sense_id": "9e2556d2-2b82-389f-9163-842628ef62d9",
                                "text": "„In vielen Fällen sind die Sporophylle der Spermatophyten noch von einer Hülle anders gestalteter und häufig auffällig gefärbter steriler Blätter, dem Perianth, umgeben, das meist in Kelch (Calyx) und Krone (Corolla) gegliedert ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
