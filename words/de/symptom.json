                {
                    "sense_id": "77ebaf86-2160-3e53-ab69-480162c6c29b",
                    "sense_definition": "Körperliches oder seelisches Anzeichen einer Krankheit oder gesundheitlichen Störung",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "medizin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fieber und Husten sind typische <w>Symptome</w> einer Erkältung."
                        },
                        {
                            "text": "Wenn die <w>Symptome</w> nach drei Tagen nicht besser werden, sollten Sie einen Arzt aufsuchen."
                        }
                    ],
                    "synonyms": [
                        "Anzeichen",
                        "Krankheitssymptom"
                    ],
                    "antonyms": [
                        "Ursache"
                    ],
                    "common_phrases": [
                        "typische Symptome",
                        "Symptome lindern",
                        "Symptome zeigen"
                    ]
                },
                {
                    "sense_id": "d7021341-989a-3ee0-8c67-eb8f741cd80a",
                    "sense_definition": "Äußeres Anzeichen oder Begleiterscheinung, die auf einen tiefer liegenden Zustand oder Missstand hinweist",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anzeichen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die steigende Arbeitslosigkeit ist nur ein <w>Symptom</w> einer tieferen wirtschaftlichen Krise."
                        },
                        {
                            "text": "Man kann den Verfall der Gebäude als sichtbares <w>Symptom</w> des Niedergangs der Stadt deuten."
                        }
                    ],
                    "synonyms": [
                        "Anzeichen"
                    ],
                    "antonyms": [
                        "Ursache"
                    ],
                    "common_phrases": [
                        "Symptom einer Krise",
                        "als Symptom deuten"
                    ]
                },
                {
                    "sense_id": "970696ea-f165-3ecd-9896-f311a88e4cc1",
                    "sense_definition": "Sichtbare Auswirkung oder äußere Erscheinungsform eines technischen oder prozessualen Fehlers",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im Qualitätsmanagement reicht es nicht aus, bloß die <w>Symptome</w> eines Produktionsfehlers zu beheben."
                        },
                        {
                            "text": "Der Systemabsturz war lediglich das sichtbare <w>Symptom</w> eines grundlegenden Softwareproblems."
                        }
                    ],
                    "synonyms": [
                        "Fehlerwirkung"
                    ],
                    "antonyms": [
                        "Ursache"
                    ],
                    "common_phrases": [
                        "nur Symptome bekämpfen"
                    ]
                },
                {
                    "sense_id": "979c0739-d086-3361-97a3-386f8ff4ed6f",
                    "sense_definition": "Funktion eines sprachlichen Zeichens, Ausdruck über den Gemütszustand oder die Haltung des Sprechers zu vermitteln",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im Organon-Modell fungiert das Sprachzeichen als <w>Symptom</w> für das Innere des Sprechers."
                        },
                        {
                            "text": "Neben dem Symbol und dem Signal bezeichnet das <w>Symptom</w> die Ausdrucksseite der menschlichen Sprache."
                        }
                    ],
                    "antonyms": [
                        "Signal",
                        "Symbol"
                    ]
                }
            ]
        }
