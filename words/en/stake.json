{
    "word_family": [
        "stakeholder",
        "stakeout"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "db5ab003-da5e-35dd-ab25-f7e390e2859a",
                    "sense_definition": "A pointed piece of wood or metal driven into the ground as a marker or support.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "physical_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener drove a wooden <w>stake</w> into the soil to support the young tree.",
                            "target_lang_translations": {
                                "ru": "Садовник вбил деревянный <w>кол</w> в землю, чтобы подпереть молодое дерево.",
                                "zh": "园丁把一根木<w>桩</w>打进土里，用来支撑那棵小树。"
                            }
                        },
                        {
                            "text": "Surveyors placed a <w>stake</w> at each corner of the field to mark the property lines.",
                            "target_lang_translations": {
                                "ru": "Геодезисты установили <w>колышек</w> в каждом углу поля, чтобы отметить границы участка.",
                                "zh": "测量员在田地的每个角落都立了一根<w>桩</w>，以标出土地边界。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wooden stake",
                        "drive a stake"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заострённый кусок дерева или металла, вбиваемый в землю в качестве метки или опоры.",
                        "zh": "一种尖头的木棍或金属杆，打入地下作为标记或支撑物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кол",
                                "target_lang_sense_clarification": "заостренная палка"
                            },
                            {
                                "target_lang_word": "колышек",
                                "target_lang_sense_clarification": "маленький кол"
                            },
                            {
                                "target_lang_word": "столб",
                                "target_lang_sense_clarification": "опора"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "木桩",
                                "target_lang_sense_clarification": "用于支撑或标记的木制杆"
                            },
                            {
                                "target_lang_word": "桩",
                                "target_lang_sense_clarification": "打入地下的支撑物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11de9b6e-b8b4-3145-a1a3-b84f98467fa6",
                    "sense_definition": "A share or financial interest in a business or situation.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "business_interest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought a controlling <w>stake</w> in the software company last year.",
                            "target_lang_translations": {
                                "ru": "В прошлом году она купила контрольный <w>пакет</w> акций компании-разработчика программного обеспечения.",
                                "zh": "她去年买下了这家软件公司的控股<w>股份</w>。"
                            }
                        },
                        {
                            "text": "All employees feel they have a personal <w>stake</w> in the success of the project.",
                            "target_lang_translations": {
                                "ru": "Все сотрудники чувствуют свою личную <w>заинтересованность</w> в успехе проекта.",
                                "zh": "所有员工都觉得项目的成功与他们个人的<w>权益</w>息息相关。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "majority stake",
                        "equity stake",
                        "minority stake"
                    ],
                    "target_lang_definitions": {
                        "ru": "Доля или финансовый интерес в бизнесе или ситуации.",
                        "zh": "在企业或某项事务中的股份或经济利益。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доля",
                                "target_lang_sense_clarification": "часть в бизнесе"
                            },
                            {
                                "target_lang_word": "пай",
                                "target_lang_sense_clarification": "взнос/часть"
                            },
                            {
                                "target_lang_word": "пакет акций",
                                "target_lang_sense_clarification": "ценные бумаги"
                            },
                            {
                                "target_lang_word": "заинтересованность",
                                "target_lang_sense_clarification": "личный интерес"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "股份",
                                "target_lang_sense_clarification": "公司中的所有权份额"
                            },
                            {
                                "target_lang_word": "权益",
                                "target_lang_sense_clarification": "在某事中的利益关系"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef71dbb7-9b43-3ba7-af1c-e146726e3ac7",
                    "sense_definition": "Something valuable, such as money, that is risked on the result of a game or competition.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "gambling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>stakes</w> were very high during the final round of the poker tournament.",
                            "target_lang_translations": {
                                "ru": "<w>Ставки</w> были очень высоки во время финального раунда покерного турнира.",
                                "zh": "在扑克锦标赛的最后一轮中，<w>赌注</w>非常高。"
                            }
                        },
                        {
                            "text": "They are playing for high <w>stakes</w>, risking their entire savings on one game.",
                            "target_lang_translations": {
                                "ru": "Они играют по высоким <w>ставкам</w>, рискуя всеми своими сбережениями в одной игре.",
                                "zh": "他们正在进行高<w>赌注</w>的博弈，把全部积蓄都押在了一场比赛上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wager",
                        "bet"
                    ],
                    "common_phrases": [
                        "high stakes",
                        "raise the stakes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-либо ценное, например деньги, чем рискуют в игре или соревновании.",
                        "zh": "在博弈或竞争中投入的具有价值的东西（如金钱）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ставка",
                                "target_lang_sense_clarification": "сумма риска"
                            },
                            {
                                "target_lang_word": "кон",
                                "target_lang_sense_clarification": "место для ставок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "赌注",
                                "target_lang_sense_clarification": "博弈中投入的钱财"
                            },
                            {
                                "target_lang_word": "筹码",
                                "target_lang_sense_clarification": "比喻竞争中投入的资本"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b682585-6ed1-3b9b-bdf7-a5f515b4bb7a",
                    "sense_definition": "A wooden post to which a condemned person was tied to be burned alive as a form of execution.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "execution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In medieval history, heretics were sometimes burned at the <w>stake</w>.",
                            "target_lang_translations": {
                                "ru": "В средневековой истории еретиков иногда сжигали на <w>костре</w>.",
                                "zh": "在中世纪历史上，异教徒有时会被绑在<w>火刑柱</w>上烧死。"
                            }
                        },
                        {
                            "text": "Joan of Arc is a famous historical figure who died at the <w>stake</w>.",
                            "target_lang_translations": {
                                "ru": "Жанна д'Арк — известная историческая личность, погибшая на <w>костре</w>.",
                                "zh": "圣女贞德是一位著名的历史人物，她死于<w>火刑柱</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "at the stake",
                        "burn at the stake"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деревянный столб, к которому привязывали приговоренного для сожжения заживо.",
                        "zh": "一种木柱，用于将死刑犯绑在上面进行火刑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "костёр",
                                "target_lang_sense_clarification": "место казни (идиоматически)"
                            },
                            {
                                "target_lang_word": "столб",
                                "target_lang_sense_clarification": "орудие казни"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "火刑柱",
                                "target_lang_sense_clarification": "执行火刑的木柱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ae469f5-3566-3be1-9f44-ac27cd420e7e",
                    "sense_definition": "A territorial administrative unit in the Church of Jesus Christ of Latter-day Saints.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>stake</w> organized a large community service project for the weekend.",
                            "target_lang_translations": {
                                "ru": "Местный <w>кол</w> организовал крупный общественный проект на выходные.",
                                "zh": "当地的<w>支联会</w>为周末组织了一项大型社区服务活动。"
                            }
                        },
                        {
                            "text": "He was appointed as the president of his church <w>stake</w>.",
                            "target_lang_translations": {
                                "ru": "Он был назначен президентом своего церковного <w>кола</w>.",
                                "zh": "他被任命为他所在教会<w>支联会</w>的会长。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Mormonism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Территориальная административная единица в Церкви Иисуса Христа Святых последних дней.",
                        "zh": "耶稣基督后期圣徒教会的一种行政区域单位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кол",
                                "target_lang_sense_clarification": "церковный округ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "支联会",
                                "target_lang_sense_clarification": "摩门教的行政单位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "722fa701-5d93-3052-a28a-47562aa5543f",
                    "sense_definition": "A piece of wood driven into the ground in the middle of a croquet court, used as the finishing point.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player hit the ball against the <w>stake</w> to win the game.",
                            "target_lang_translations": {
                                "ru": "Игрок ударил мячом о <w>колышек</w>, чтобы выиграть игру.",
                                "zh": "选手击球撞向<w>终点桩</w>从而赢得了比赛。"
                            }
                        },
                        {
                            "text": "You must pass through all the hoops before hitting the central <w>stake</w>.",
                            "target_lang_translations": {
                                "ru": "Вы должны пройти через все воротца, прежде чем ударить в центральный <w>колышек</w>.",
                                "zh": "你必须穿过所有的球门，然后才能击中中央的<w>终点桩</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "peg"
                    ],
                    "target_lang_definitions": {
                        "ru": "Деревянный колышек в центре площадки для крокета, служащий финишной точкой.",
                        "zh": "槌球场中央打入地下的木桩，作为终点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колышек",
                                "target_lang_sense_clarification": "в крокете"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "终点桩",
                                "target_lang_sense_clarification": "槌球运动中的目标桩"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e8c6d7e5-97dc-3a64-8ad0-680b0f771e9b",
                    "sense_definition": "To risk money or something valuable on the result of an event or competition.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_risk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was willing to <w>stake</w> his professional reputation on the success of the new product.",
                            "target_lang_translations": {
                                "ru": "Он был готов <w>поставить на карту</w> свою профессиональную репутацию ради успеха нового продукта.",
                                "zh": "他愿意为了新产品的成功而<w>押上</w>自己的职业声誉。"
                            }
                        },
                        {
                            "text": "I would not <w>stake</w> my life on the accuracy of that report.",
                            "target_lang_translations": {
                                "ru": "Я бы не стал <w>ставить</w> свою жизнь на точность этого отчета.",
                                "zh": "我不会拿自己的性命去<w>押注</w>那份报告的准确性。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bet",
                        "wager",
                        "hazard"
                    ],
                    "common_phrases": [
                        "stake money",
                        "stake reputation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рисковать деньгами или чем-то ценным, ставя на результат события или соревнования.",
                        "zh": "将金钱或有价值的东西投入到某项事件的结果中以承担风险。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ставить на карту",
                                "target_lang_sense_clarification": "рисковать всем"
                            },
                            {
                                "target_lang_word": "ставить на кон",
                                "target_lang_sense_clarification": "рисковать в игре"
                            },
                            {
                                "target_lang_word": "рисковать",
                                "target_lang_sense_clarification": "общий смысл"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "押上",
                                "target_lang_sense_clarification": "投入赌注或承担风险"
                            },
                            {
                                "target_lang_word": "拿……冒险",
                                "target_lang_sense_clarification": "以某物作为赌注"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e86e84f-711d-3307-b5e6-39fcf5fcda93",
                    "sense_definition": "To support, fasten, or mark an area or object with stakes.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to <w>stake</w> the tomato plants so they do not fall over.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>подпереть</w> кусты помидоров, чтобы они не упали.",
                                "zh": "我们需要给番茄植株<w>立桩支撑</w>，以免它们倒伏。"
                            }
                        },
                        {
                            "text": "The surveyor <w>staked</w> out the boundaries of the new property.",
                            "target_lang_translations": {
                                "ru": "Геодезист <w>отметил колышками</w> границы нового участка.",
                                "zh": "测量员<w>标出</w>了新地块的边界。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "stake plants",
                        "stake out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подпирать, укреплять кольями или отмечать границы участка вешками.",
                        "zh": "用木桩支撑、固定或标记某区域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подпирать",
                                "target_lang_sense_clarification": "растения"
                            },
                            {
                                "target_lang_word": "укреплять",
                                "target_lang_sense_clarification": "делать прочным"
                            },
                            {
                                "target_lang_word": "отмечать колышками",
                                "target_lang_sense_clarification": "границы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "立桩支撑",
                                "target_lang_sense_clarification": "用木桩固定植物"
                            },
                            {
                                "target_lang_word": "标出",
                                "target_lang_sense_clarification": "用桩标记边界"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6252644e-4005-3961-b7f2-51d2932deec8",
                    "sense_definition": "To deposit and lock cryptocurrency to participate in the verification process of a blockchain network.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_crypto",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Investors can <w>stake</w> their tokens to earn rewards over time.",
                            "target_lang_translations": {
                                "ru": "Инвесторы могут <w>стейкать</w> свои токены, чтобы получать вознаграждение с течением времени.",
                                "zh": "投资者可以<w>质押</w>他们的代币，以随时间推移获得奖励。"
                            }
                        },
                        {
                            "text": "He plans to <w>stake</w> his cryptocurrency rather than selling it immediately.",
                            "target_lang_translations": {
                                "ru": "Он планирует <w>отправить в стейкинг</w> свою криптовалюту, а не продавать её сразу.",
                                "zh": "他计划将加密货币进行<w>质押</w>，而不是立即卖掉。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "stake coins",
                        "stake tokens"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "cryptocurrency context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Депонировать и блокировать криптовалюту для участия в процессе верификации блокчейн-сети.",
                        "zh": "锁定加密货币以参与区块链网络的验证过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стейкать",
                                "target_lang_sense_clarification": "сленг"
                            },
                            {
                                "target_lang_word": "отправлять в стейкинг",
                                "target_lang_sense_clarification": "термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "质押",
                                "target_lang_sense_clarification": "加密货币领域的锁定行为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92870005-a4fb-3e68-82b3-5d71bdeb0799",
                    "sense_definition": "To provide someone with money to start a business or participate in an activity.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His wealthy uncle agreed to <w>stake</w> him for the poker tournament.",
                            "target_lang_translations": {
                                "ru": "Его богатый дядя согласился <w>спонсировать</w> его участие в покерном турнире.",
                                "zh": "他富有的叔叔同意<w>资助</w>他参加扑克锦标赛。"
                            }
                        },
                        {
                            "text": "The investors <w>staked</w> the young entrepreneur so she could launch her startup.",
                            "target_lang_translations": {
                                "ru": "Инвесторы <w>профинансировали</w> молодого предпринимателя, чтобы она могла запустить свой стартап.",
                                "zh": "投资者们<w>资助</w>了这位年轻的企业家，使她能够启动自己的初创公司。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "stake a player"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Снабжать кого-либо деньгами для начала бизнеса или участия в каком-либо деле.",
                        "zh": "为某人提供创业或参与某项活动的资金。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "финансировать",
                                "target_lang_sense_clarification": "давать деньги"
                            },
                            {
                                "target_lang_word": "спонсировать",
