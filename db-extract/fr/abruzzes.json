                "senses": [
                    {
                        "sense_id": "f6b75404-7362-31e0-ac96-e64d8187a67b",
                        "entry_id": "e126cff9-048b-3881-8fdf-7102a37fca3b",
                        "glosses": [
                            "Région d’Italie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b687becf-1ac0-4c73-a978-26e85c3591a1",
                                "sense_id": "f6b75404-7362-31e0-ac96-e64d8187a67b",
                                "text": "Sous son nouvel aspect, avec son sayon, ses braies brunes, ses sandales lacées par-dessus ses bas bleus, son brûle-gueule, son chapeau roux à petits bords plats, il faut reconnaître qu’il avait l’air moins d’un curé que d’un parfait brigand des Abruzzes."
                            },
                            {
                                "example_id": "98110317-a1b1-4c96-a610-70c62e444889",
                                "sense_id": "f6b75404-7362-31e0-ac96-e64d8187a67b",
                                "text": "Très vite incriminés, les naturalistes ont procédé à une enquête visant à reconstituer la progression des loups depuis les Abruzzes jusqu'au Mercantour."
                            }
                        ]
                    }
                ],
