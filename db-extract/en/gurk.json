                        "entry_id": "7ebe78c7-ba44-3fc4-aeda-4911d03fd0cd",
                        "glosses": [
                            "An act of gurking; a burp or belch."
                        ],
                        "tags": [
                            "colloquial",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "fbef68ee-c397-4a4e-8ab5-e5585f90b48e",
                                "sense_id": "8df7d05f-ab21-33b7-be5c-f4598f784033",
                                "text": "I let out a loud gurk and everybody looked at me."
                            },
                            {
                                "example_id": "b398ea92-e151-4df1-946e-24b7408b5d04",
                                "sense_id": "8df7d05f-ab21-33b7-be5c-f4598f784033",
                                "text": "I bore him because I study his every gesture, sigh, gurk or twitch, determined with dread to find him in bad health, which must be most horribly irritating, and he bores me because he is so spoilt that a kind word flung into the silences he thinks will suffice to interest me."
                            }
                        ]
                    }
                ],
