                                "example_id": "6721109a-2b09-491c-bdf6-a934b0c1b6a0",
                                "sense_id": "c29b7c9a-7dd3-3a19-b318-ac1c6e3f5d14",
                                "text": "„Dank der technischen Änderung kann das Unternehmen seinen internationalen Expansionskurs fortsetzen.“"
                            },
                            {
                                "example_id": "2002931f-7e59-4db8-8dd1-1c6597e5bb8f",
                                "sense_id": "c29b7c9a-7dd3-3a19-b318-ac1c6e3f5d14",
                                "text": "„Der Onlinehändler gibt lieber Geld für seinen Expansionskurs aus, als an die Geschäftszahlen zu denken.“"
                            },
                            {
                                "example_id": "84000a51-5cf8-45d7-8e19-66324116bcf9",
                                "sense_id": "c29b7c9a-7dd3-3a19-b318-ac1c6e3f5d14",
                                "text": "„Auch gegenüber dem rabiaten Expansionskurs der USA zeigte sich die britische Regierung nachgiebig.“"
                            }
                        ],
