                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jego zachowanie przyprawiło niektórych widzów o <w>mdłości</w>.",
                            "target_lang_translations": {
                                "ru": "Его поведение вызвало у некоторых зрителей <w>тошноту</w>.",
                                "en": "His behavior gave some viewers <w>nausea</w>.",
                                "nl": "Zijn gedrag bezorgde sommige toeschouwers <w>misselijkheid</w>.",
                                "de": "Sein Verhalten erregte bei einigen Zuschauern <w>Übelkeit</w>.",
                                "fr": "Son comportement a donné des <w>nausées</w> à certains spectateurs.",
                                "it": "Il suo comportamento ha causato la <w>nausea</w> ad alcuni spettatori.",
                                "cs": "Jeho chování vyvolalo u některých diváků <w>nevolnost</w>.",
                                "tr": "Onun davranışı bazı izleyicilerin <w>midesini bulandırdı</w>.",
