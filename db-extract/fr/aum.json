                        "entry_id": "cfb2b722-399b-3a95-a3a5-3b2b40404c0d",
                        "glosses": [
                            "Syllabe sacrée ou mystique, utilisée dans les prières et méditations."
                        ],
                        "tags": [
                            "Hinduism"
                        ],
                        "examples": [
                            {
                                "example_id": "47e46fa1-5020-4826-ae42-fcad7e687069",
                                "sense_id": "260ed6ac-ce75-3f5b-84b5-c3375f4e0dbc",
                                "text": "L’hindouisme fait de la syllabe sacrée « aum » le son originel, qui exprime le noyau de cet appel qui nous parvient du cœur du cosmos, et invite à répéter cette syllabe pour s’y connecter."
                            }
                        ]
                    }
