                                        "glosses": [
                                            "Petits os du jeu d’osselets, généralement des tarses de veau ou de mouton ou des copies en métal ou en plastique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a5e74de-4322-4f05-b253-08a8478dabb9",
                                                "sense_id": "377383d2-6024-3ed8-afe0-734de091cd2f",
                                                "text": "Les tabletiers font des osselets d’ivoire."
                                            },
                                            {
                                                "example_id": "558ddc11-7098-4c86-953e-8e06e6d7d34d",
                                                "sense_id": "377383d2-6024-3ed8-afe0-734de091cd2f",
                                                "text": "Habilement, Stavro jette un osselet en l’air et avant de le rattraper, saisit tous les autres."
                                            },
                                            {
                                                "example_id": "e41a8f1f-a8fb-4861-82aa-5988b32eb620",
                                                "sense_id": "377383d2-6024-3ed8-afe0-734de091cd2f",
                                                "text": "Le reste est jeu d’enfant, et je suis avec tous mes livres comme un petit garçon qui agite des osselets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9fee11a-cf4e-3b79-8ef4-de066777c4a8",
                                        "entry_id": "06a7be4c-2fc1-3b83-9050-571d5bbd28a8",
                                        "glosses": [
                                            "Tumeur osseuse placée sur la partie inférieure de la jambe d’un cheval, à côté du boulet."
                                        ],
                                        "tags": [
                                            "Médecine vétérinaire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2eff5a1b-0015-4f4b-90a9-97b6996560f0",
                                                "sense_id": "c9fee11a-cf4e-3b79-8ef4-de066777c4a8",
                                                "text": "L’osselet est une exostose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
