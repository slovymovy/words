                                "target_lang_word": "超级",
                                "target_lang_sense_clarification": "表示程度极高"
                            },
                            {
                                "target_lang_word": "非常",
                                "target_lang_sense_clarification": "表示程度"
                            }
                        ]
                    }
                },
                {
