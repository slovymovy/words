                    {
                        "translation_id": "7d5a9e31-cdbf-4154-8df6-5150d7995b34",
                        "source_entry_id": "f1aaaa27-d260-32b3-8f2f-2f4369445601",
                        "source_sense_id": "3f657ff8-a921-33e0-b3d4-d53fb104cde5",
                        "source_sense_description": "een schip waarmee gezeild kan worden",
                        "target_lang_word": "sailer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sailer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1dbd1771-17bd-3146-a80d-7e768b9832df",
                                        "entry_id": "49cd1b32-7b94-3697-a325-48d6dd10e46b",
                                        "glosses": [
                                            "That which sails; a sailboat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab81df96-471d-4ba4-b6dc-05fc2a3bab97",
                                                "sense_id": "1dbd1771-17bd-3146-a80d-7e768b9832df",
                                                "text": "She is the best sailer in the service, and she carries a hundred guns."
                                            },
                                            {
                                                "example_id": "a954a3fc-8e34-438d-a213-f2ea7ffc1181",
                                                "sense_id": "1dbd1771-17bd-3146-a80d-7e768b9832df",
                                                "text": "The Gulnare was a fast sailer, built for a slaver originally[.]"
                                            },
                                            {
                                                "example_id": "c7d2b1ef-404c-44f0-8360-93661237a6de",
                                                "sense_id": "1dbd1771-17bd-3146-a80d-7e768b9832df",
                                                "text": "Elsewhere it has been said that in the lack of frigates (of course better sailers than line-of-battle ships) in the English squadron up the Straits at that period, the Indomitable was occasionally employed not only as an available substitute for a scout, but at times on detached service of more important kind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e013b489-da52-38a0-a98f-5b72e0950480",
                                        "entry_id": "49cd1b32-7b94-3697-a325-48d6dd10e46b",
                                        "glosses": [
                                            "A fastball that skims through the air."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bd70614c-bc5b-333c-a5a2-b7b60aa96b10",
                                        "entry_id": "49cd1b32-7b94-3697-a325-48d6dd10e46b",
                                        "glosses": [
                                            "A butterfly of the genus Neptis"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8c442c58-9431-3084-b094-57dcefd62a9f",
                                        "entry_id": "49cd1b32-7b94-3697-a325-48d6dd10e46b",
                                        "glosses": [
                                            "Obsolete form of sailor."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6c4b6d5-72bb-4c46-853e-923d26cb2b03",
                                                "sense_id": "8c442c58-9431-3084-b094-57dcefd62a9f",
                                                "text": "The records of Stepney parish note the burial of Henry Rainsford \"an old sailer sometyme beadle of Ratclife and now a pencioner.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f5512ae-704d-4c75-8357-76a40d5c7c46",
                        "source_entry_id": "f1aaaa27-d260-32b3-8f2f-2f4369445601",
                        "source_sense_id": "3f657ff8-a921-33e0-b3d4-d53fb104cde5",
                        "source_sense_description": "een schip waarmee gezeild kan worden",
                        "target_lang_word": "voilier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voilier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9976baf4-a3bb-3f22-b390-f17e1bb22d16",
                                        "entry_id": "34bdfca6-7474-3981-ac0e-d2cca8f83f54",
                                        "glosses": [
                                            "Bien ou mal muni de voiles."
                                        ],
                                        "tags": [
                                            "Navigation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9b30e14-38f0-4d01-8a54-54c0a26eb5c5",
                                                "sense_id": "9976baf4-a3bb-3f22-b390-f17e1bb22d16",
                                                "text": "Ce navire est bon voilier."
                                            },
                                            {
                                                "example_id": "2e34cc32-8663-410b-8e1b-5f776fd30381",
                                                "sense_id": "9976baf4-a3bb-3f22-b390-f17e1bb22d16",
                                                "text": "Cette corvette est mauvaise voilière."
                                            },
                                            {
                                                "example_id": "97c7a289-f2ce-4907-9650-1cb633197e3d",
                                                "sense_id": "9976baf4-a3bb-3f22-b390-f17e1bb22d16",
                                                "text": "La Valkyrie était fine voilière, mais avec un navire à voiles on ne sait jamais trop sur quoi compter."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "voilier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2c6b4349-5975-3938-b3f6-e50d8b2d223f",
                                        "entry_id": "593d6e1e-3f05-3969-9377-cb3f2114a8bf",
                                        "glosses": [
                                            "Bateau à voile propulsé par le vent."
                                        ],
                                        "tags": [
                                            "Navigation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af47e89e-2002-42a7-b2ce-a29d1bd5bf0d",
                                                "sense_id": "2c6b4349-5975-3938-b3f6-e50d8b2d223f",
                                                "text": "Sous un ciel fuligineux et sur une mer furieuse, un voilier démâté fuyait la tempête, donnant fortement de la bande, luttant désespérément contre l’assaut d’énormes vagues bondissantes qui se ruaient, secouant leurs crinières écumantes."
                                            },
                                            {
                                                "example_id": "3726327a-2c98-4685-a79a-dde64dc1c89a",
                                                "sense_id": "2c6b4349-5975-3938-b3f6-e50d8b2d223f",
                                                "text": "il dirigea lui-même, d’un brick destiné à la traite, fin voilier, étroit, long comme un bâtiment de guerre."
                                            },
                                            {
                                                "example_id": "f333b158-6b97-4a74-bff2-b480931380be",
                                                "sense_id": "2c6b4349-5975-3938-b3f6-e50d8b2d223f",
                                                "text": "La rade de Casablanca — nous l’avons vu déjà — n’est pas idéale ; tant s’en faut. Les vapeurs y mouillent à un mille ou un mille et demi, les voiliers, à plus de deux milles de terre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d479f251-6bab-3e29-b9c8-c5f1d168eec7",
                                        "entry_id": "593d6e1e-3f05-3969-9377-cb3f2114a8bf",
                                        "glosses": [
                                            "Oiseau de mer qui pratique peu le vol battu, et souvent le vol plané."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44a50edd-1535-4bd6-be44-46a5b7e53707",
                                                "sense_id": "d479f251-6bab-3e29-b9c8-c5f1d168eec7",
                                                "text": "Cette année au contraire, nous avons eu, dans les régions mêmes où se rencontrent les principaux voiliers, le Fou de Bassan et le Pétrel arctique principalement, toute la gamme des vents."
                                            },
                                            {
                                                "example_id": "1ed4bc06-36f3-43fc-9b84-928ea9379464",
                                                "sense_id": "d479f251-6bab-3e29-b9c8-c5f1d168eec7",
                                                "text": "Cette technique contraste toutefois avec celle de certains guides qui tentent d’obnubiler les oiseaux avec tout un attirail de calls vifs, rapides et insistants qui, aux dires de M. La Haye, est très performante dans les vastes champs renfermant plusieurs dizaines de grands voiliers ou bien à la passe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d28d713d-5173-3cec-abc7-cf535da71d2b",
                                        "entry_id": "593d6e1e-3f05-3969-9377-cb3f2114a8bf",
                                        "glosses": [
                                            "Grand poisson osseux marin pélagique dont la première nageoire dorsale est très développée en forme de voile et la mâchoire supérieure prolongée comme chez les espadons."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a3b8575a-27d1-3b17-b0fb-f55ec62f10a9",
                                        "entry_id": "593d6e1e-3f05-3969-9377-cb3f2114a8bf",
                                        "glosses": [
                                            "Celui qui fait et raccommode les voiles des bâtiments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c95e4ae-c8fa-4638-8ceb-6c50cfddf463",
                                                "sense_id": "a3b8575a-27d1-3b17-b0fb-f55ec62f10a9",
                                                "text": "Un maître voilier."
                                            },
                                            {
                                                "example_id": "5ba3e1b6-dcac-40ad-acd3-91dc9e026958",
                                                "sense_id": "a3b8575a-27d1-3b17-b0fb-f55ec62f10a9",
                                                "text": "Il avait beaucoup navigué. Il avait été mousse, voilier, gabier, timonier, contre-maître, maître d’équipage, pilote, patron."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92cd9e23-d126-3516-89a6-6a173d7accd7",
                                        "entry_id": "593d6e1e-3f05-3969-9377-cb3f2114a8bf",
                                        "glosses": [
                                            "Docker spécialisé dans la manutention des balles de coton."
                                        ],
                                        "tags": [
                                            "Le Havre"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fff398e-0f13-4191-ab33-518ec4e6c931",
                                                "sense_id": "92cd9e23-d126-3516-89a6-6a173d7accd7",
                                                "text": "Le voilier ouvrait la balle de coton, en prélevait un échantillon et recousait la balle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
