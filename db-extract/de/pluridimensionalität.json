                ],
                "senses": [
                    {
                        "sense_id": "54db96f1-ca55-3165-a87e-431551bc765b",
                        "entry_id": "62531eae-d155-3fcc-b0a4-c0002033f9d3",
                        "glosses": [
                            "Eigenschaft, sich in mehrere Richtungen (Dimensionen) zu erstrecken, mehrere Teilbereiche/Facetten zu haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81136003-f270-422d-95b9-9e64914955bb",
                                "sense_id": "54db96f1-ca55-3165-a87e-431551bc765b",
                                "text": "„Griesinger hat die Pluridimensionalität der Psychiatrie erkannt und eine entsprechende multimodale psychiatrische Behandlung gefordert.“"
                            },
                            {
                                "example_id": "f86455b9-40d9-4998-80ce-c9ac457a7b2a",
                                "sense_id": "54db96f1-ca55-3165-a87e-431551bc765b",
                                "text": "„Um das Konzept der Pluridimensionalität für eine geolinguistische Modellierung fassbar zu machen , muss zunächst geklärt werden , welche Dimensionen jenseits der Diatopik diesbezüglich in die Modellierung einfließen sollten.“"
                            },
                            {
                                "example_id": "f969775d-d445-4bd3-bdfb-f4b70e95ef0f",
                                "sense_id": "54db96f1-ca55-3165-a87e-431551bc765b",
                                "text": "„Und wenn die Simultaneität präsentische Situationen koordiniert und dem linearen Paradigma verhaftet bleibt, ist die Pluridimensionalität eben nicht zählbar, sondern ufert stets aus, produziert stets neue Möglichkeiten und Veränderungen, die sich in jedem Moment ereignen können.“"
                            },
                            {
                                "example_id": "21b93003-79fe-4ae5-9a32-684c4b39c8cd",
                                "sense_id": "54db96f1-ca55-3165-a87e-431551bc765b",
                                "text": "„Diese Analyse befaßt sich mit der Pluridimensionalität der juristischen Sprache, nicht mit der Pluridimensionalität der Rechtserscheinung.“"
                            },
                            {
                                "example_id": "3b530380-855a-40a4-a997-3e42aa270ecf",
                                "sense_id": "54db96f1-ca55-3165-a87e-431551bc765b",
                                "text": "„Vielleicht weist die Pluridimensionalität der Bewusstseinsvorgänge auf eine dritte, diesmal ausschlaggebende Auffassung des Leibes, die dem über die transzendentale Konstitution erweiterten Rahmen des Bewussten genugtun könnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
