                {
                    "sense_id": "673bc871-f476-3eea-8dd2-f08c85335a7d",
                    "sense_definition": "Het achterste deel van de menselijke voet.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "heel_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb een pijnlijke blaar op mijn <w>hak</w>.",
                            "target_lang_translations": {
                                "en": "I have a painful blister on my <w>heel</w>.",
                                "ru": "У меня болезненная мозоль на <w>пятке</w>.",
                                "pl": "Mam bolesny odcisk na <w>pięcie</w>.",
                                "de": "Ich habe eine schmerzhafte Blase an meiner <w>Ferse</w>.",
                                "fr": "J'ai une ampoule douloureuse sur le <w>talon</w>.",
                                "it": "Ho una dolorosa vescica sul <w>tallone</w>.",
                                "cs": "Mám bolestivý puchýř na <w>patě</w>.",
                                "tr": "Topuğumda acı verici bir su toplaması var.",
                                "es": "Tengo una ampolla dolorosa en el <w>talón</w>.",
                                "zh": "我的<w>脚后跟</w>磨出了一个疼人的水泡。"
                            }
                        },
                        {
                            "text": "Zet bij het lopen eerst je <w>hak</w> op de grond.",
                            "target_lang_translations": {
                                "en": "Put your <w>heel</w> on the ground first when walking.",
                                "ru": "При ходьбе сначала ставь <w>пятку</w> на землю.",
                                "pl": "Podczas chodzenia stawiaj najpierw <w>piętę</w> na ziemi.",
                                "de": "Setze beim Gehen zuerst deine <w>Ferse</w> auf den Boden.",
                                "fr": "En marchant, posez d'abord le <w>talon</w> sur le sol.",
                                "it": "Quando cammini, appoggia prima il <w>tallone</w> a terra.",
                                "cs": "Při chůzi došlapuj nejdříve na <w>patu</w>.",
                                "tr": "Yürürken önce <w>topuğunu</w> yere bas.",
                                "es": "Al caminar, apoya primero el <w>talón</w> en el suelo.",
                                "zh": "走路时先用<w>脚后跟</w>着地。"
                            }
                        }
