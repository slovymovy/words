                                        "entry_id": "15d4a2c2-0bbe-3ab2-a27d-4d72aa734e73",
                                        "glosses": [
                                            "нарушать упорядоченную или запланированную деятельность или нормальное функционирование сложно организованной системы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c67abdf-d26d-4df1-8968-baa3e717b2f9",
                                                "sense_id": "8df82ffb-447d-39f2-8f53-55a6f092718c",
                                                "text": "Инфляция расстраивает экономику."
                                            },
                                            {
                                                "example_id": "88f96497-7b44-40ea-bf58-8e42068980ae",
                                                "sense_id": "8df82ffb-447d-39f2-8f53-55a6f092718c",
                                                "text": "Душевные переживания расстраивают её здоровье."
                                            },
                                            {
                                                "example_id": "fbf88b86-eeaa-494e-ac39-8fc3a8cddc0d",
                                                "sense_id": "8df82ffb-447d-39f2-8f53-55a6f092718c",
                                                "text": "Вещества, содержащие алкоголь, расстраивают работу мозга."
                                            },
                                            {
                                                "example_id": "ef1acba3-d3bf-4f54-b200-ee14394fae68",
                                                "sense_id": "8df82ffb-447d-39f2-8f53-55a6f092718c",
                                                "text": "Это обстоятельство расстраивает все мои планы."
                                            },
                                            {
                                                "example_id": "8df4667f-f6a2-4091-b074-1ef6072271f7",
                                                "sense_id": "8df82ffb-447d-39f2-8f53-55a6f092718c",
                                                "text": "Усадьба его, расстраиваемая чудачествами управляющего, приносила мало дохода."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2154992b-e0e3-305b-b7fd-2f2a29cf0fe6",
                                        "entry_id": "15d4a2c2-0bbe-3ab2-a27d-4d72aa734e73",
                                        "glosses": [
                                            "физическим воздействием нарушать определённый порядок пространственного размещения объектов (обычно людей или транспортных средств)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "014c220c-0b81-4301-9de7-35d8cca6df0d",
                                                "sense_id": "2154992b-e0e3-305b-b7fd-2f2a29cf0fe6",
                                                "text": "Расстраивать ряды."
                                            },
                                            {
                                                "example_id": "02af3d23-97b6-4ec4-9d15-9ed8852d32ce",
                                                "sense_id": "2154992b-e0e3-305b-b7fd-2f2a29cf0fe6",
                                                "text": "Они кричали, расстраивая фронт и давя друг друга."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3517651-f944-3f33-aa06-e9a08ff800f3",
                                        "entry_id": "15d4a2c2-0bbe-3ab2-a27d-4d72aa734e73",
                                        "glosses": [
                                            "нарушать строй музыкального инструмента, создавая для него неблагоприятные условия функционирования"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68e3fbcb-329a-4ef3-b561-030cb01df0e0",
                                                "sense_id": "b3517651-f944-3f33-aa06-e9a08ff800f3",
                                                "text": "Своим бренчанием он совсем расстроил гитару."
                                            },
                                            {
                                                "example_id": "de26aae5-f6d4-4dfe-8af5-d13a82afb56f",
                                                "sense_id": "b3517651-f944-3f33-aa06-e9a08ff800f3",
                                                "text": "расстраивать рояль."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bac6621-3837-329e-973e-ab1186920aa2",
                                        "entry_id": "15d4a2c2-0bbe-3ab2-a27d-4d72aa734e73",
                                        "glosses": [
                                            "вызывать непродолжительное плохое эмоциональное состояние"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1181737-04e7-4128-b601-1753a6001b9c",
                                                "sense_id": "6bac6621-3837-329e-973e-ab1186920aa2",
                                                "text": "Исход дела расстраивал моего героя до крайности."
                                            },
                                            {
                                                "example_id": "f568830c-0681-4931-b72c-07d78a730e43",
                                                "sense_id": "6bac6621-3837-329e-973e-ab1186920aa2",
