        "fr-extract.jsonl": [
            {
                "entry_id": "4ffe4cca-1e40-3e02-8b32-6ccc7b1ad242",
                "word": "varlope",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7d714e55-82e1-4651-bcd9-a23baabc3e66",
                        "entry_id": "4ffe4cca-1e40-3e02-8b32-6ccc7b1ad242",
                        "tags": [
                            "plural"
                        ],
                        "form": "varlopes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fd4c25f9-5694-303f-a297-25616212a097",
                        "entry_id": "4ffe4cca-1e40-3e02-8b32-6ccc7b1ad242",
                        "glosses": [
                            "Grand rabot muni d’une poignée, qui sert aux menuisiers et aux charpentiers pour dresser et aplanir les pièces de bois. La varlope continue le travail de corroyage commencé avec le riflard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac5c63f3-fa8f-4682-9e57-badf76bc5474",
                                "sense_id": "fd4c25f9-5694-303f-a297-25616212a097",
                                "text": "Les boiseries furent dues en partie à l’emploi plus généralisé des rabots longs dits varlopes, et de la “guitare” pour creuser les moulures cintrées."
                            },
                            {
                                "example_id": "db0e08e3-8eb3-4ef4-b9b5-da53d2415dac",
                                "sense_id": "fd4c25f9-5694-303f-a297-25616212a097",
                                "text": "Cela est charmant à entendre, mêlé au bruit des outils, avec l’accompagnement du marteau et de la varlope ; mais là, sur cette estrade, c’était ridicule et navrant."
                            },
                            {
                                "example_id": "76456e05-8c85-4b03-bcde-81ed87ec284d",
                                "sense_id": "fd4c25f9-5694-303f-a297-25616212a097",
                                "text": "Armé du hacheret, du bédane et de la gouge, la varlope à la main, je règne, à mon établi, sur le chêne noueux et le noyer poli."
                            },
                            {
                                "example_id": "40bbcd74-df33-45d4-99cd-24b5f1538024",
                                "sense_id": "fd4c25f9-5694-303f-a297-25616212a097",
                                "text": "Avant la mécanisation des ateliers le rabot et la varlope tenaient lieu de dégauchisseuse, et la scie à refendre exigeait plus d’effort que la scie en ruban."
                            },
                            {
                                "example_id": "c9903ed2-9693-4b07-8495-1ba00f53d721",
                                "sense_id": "fd4c25f9-5694-303f-a297-25616212a097",
                                "text": "Au repos, on doit coucher riflard et varlope sur le côté pour que leur arête tranchante ne soit pas abîmée."
                            },
                            {
                                "example_id": "2e8da7ff-1b3a-4834-8e09-44bc2604062f",
                                "sense_id": "fd4c25f9-5694-303f-a297-25616212a097",
                                "text": "Enfin on abordera le plateau,l'étendue toute rabotée par la grande varlope de ce vent."
                            }
                        ]
                    },
                    {
                        "sense_id": "9b8ba468-9875-3f27-8081-3d63a326ed6a",
                        "entry_id": "4ffe4cca-1e40-3e02-8b32-6ccc7b1ad242",
                        "glosses": [
                            "Position sexuelle rappelant la forme de l’instrument."
                        ],
                        "tags": [],
                        "examples": []
                    }
