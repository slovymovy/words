                "senses": [
                    {
                        "sense_id": "8dbc95f0-bb98-3030-af50-e96dd2243829",
                        "entry_id": "d6d35aeb-25a9-35ac-906c-69aa2015e973",
                        "glosses": [
                            "To unwrap or disentangle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab88f0bd-1e52-4810-9049-b97f012abe73",
                                "sense_id": "8dbc95f0-bb98-3030-af50-e96dd2243829",
                                "text": "And therefore when the Will by deserved punishment is whipt out of her viciousness, the Native lustre of the Understanding will quickly disenvelop its self from the cloud of mistake, in which the Passion-exhaled vapors had enwrapt her."
                            },
                            {
                                "example_id": "e89cc264-96b0-4a38-bd33-f80b5c33816a",
                                "sense_id": "8dbc95f0-bb98-3030-af50-e96dd2243829",
                                "text": "The value of the former loss may fairly be doubted, for all we know of antiquity is through the doubtful mists of their mythos; requiring the utmost care to disenvelop from the shroud of falsehood in which it has so long slept."
                            },
                            {
                                "example_id": "67322582-6742-4755-8e55-39a4883c2bfe",
                                "sense_id": "8dbc95f0-bb98-3030-af50-e96dd2243829",
                                "text": "What in the structure of a particular noema is given in an enveloped form, namely its constituents reciprocally determining and qualifying each other, comes to be disenveloped, unfolded, and unravelled in the course of the perceptual process."
                            },
                            {
                                "example_id": "1f563e11-8cf9-4742-8053-921c5d16d265",
                                "sense_id": "8dbc95f0-bb98-3030-af50-e96dd2243829",
                                "text": "What follows is an attempt to disenvelop the term “ambient,” as a modifier of art practices."
                            }
                        ]
                    }
