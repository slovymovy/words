                "senses": [
                    {
                        "sense_id": "013c527b-2835-3cf7-b2e8-caf23d2aa95c",
                        "entry_id": "d670fd58-5df1-374b-bdab-74eba94b016d",
                        "glosses": [
                            "Façonner de façon préalable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1caa899a-13fa-46e3-86b9-5f569da0f565",
                                "sense_id": "013c527b-2835-3cf7-b2e8-caf23d2aa95c",
                                "text": "Pré-façonner vos brioches en boules."
                            },
                            {
                                "example_id": "9896d09c-7b29-4b34-9de0-211b43f924a6",
                                "sense_id": "013c527b-2835-3cf7-b2e8-caf23d2aa95c",
                                "text": "Cette diviseuse de pâte est conçue pour diviser volumétriquement et pré-façonner la pâte en boule."
                            },
                            {
                                "example_id": "3a43ce0f-aaf2-4be3-b28e-ab2f584dce88",
                                "sense_id": "013c527b-2835-3cf7-b2e8-caf23d2aa95c",
                                "text": "Quelles sont les différentes étapes de la fabrication du pain ? Il faut peser les ingrédients, pétrir, débaquer, diviser, pré-façonner, laisser pousser, bâter, lamer, enfourner et défourner."
                            }
                        ]
