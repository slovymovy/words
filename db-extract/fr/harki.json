                    {
                        "sense_id": "5cb1da89-4e37-3205-9037-0d9a248164e7",
                        "entry_id": "f6bb5b53-729c-3ef5-ba92-3a94d60a1734",
                        "glosses": [
                            "Militaire algérien enrôlé dans l’armée française pendant la guerre d’Algérie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dda6756-71b8-4a95-a7d9-dd95f7175406",
                                "sense_id": "5cb1da89-4e37-3205-9037-0d9a248164e7",
                                "text": "Les harkis furent répartis entre un G.M.C., avec Dourdan comme chef de bord, et un half-track, véhicule blindé dont Fabrice aurait la responsabilité."
                            }
                        ]
                    },
                    {
                        "sense_id": "cd2dd930-0fcf-3546-bd27-3f8000456f56",
                        "entry_id": "f6bb5b53-729c-3ef5-ba92-3a94d60a1734",
                        "glosses": [
                            "Algérien musulman soutenant le rattachement de l’Algérie à la République française durant la guerre d’Algérie."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "34398ff0-16e5-3705-a68f-07b2f61a1953",
                        "entry_id": "f6bb5b53-729c-3ef5-ba92-3a94d60a1734",
                        "glosses": [
                            "Membre de la communauté harkie installée en France en 1962."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "47eb730e-7fb8-47eb-9109-406745ae5785",
                                "sense_id": "34398ff0-16e5-3705-a68f-07b2f61a1953",
                                "text": "Tous les ouvriers du domaine, d’anciens harkis pour la plupart, étaient mobilisés, chacun mettant d’autant plus de cœur à l’ouvrage que monsieur Burgaud avait eu un mot aimable pour lui."
                            }
                        ]
                    },
                    {
                        "sense_id": "e959a4b4-5d9a-3f2c-a667-43923d595ab4",
                        "entry_id": "f6bb5b53-729c-3ef5-ba92-3a94d60a1734",
