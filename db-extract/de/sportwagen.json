                                "example_id": "42ed9489-fa65-41b9-b3d5-2ea66c3b194d",
                                "sense_id": "3c30d14c-9463-3f02-8177-c99d379d4df5",
                                "text": "„Mutter hatte damals von einer Freundin ›wahnsinnig preiswert‹ einen Sportwagen übernommen, und Leo war sehr empfindlich, wenn ihm irgend etwas als Angeberei ausgelegt werden konnte.“"
                            },
                            {
                                "example_id": "b42c4f13-0344-435d-ab4a-8a25e4e00931",
                                "sense_id": "3c30d14c-9463-3f02-8177-c99d379d4df5",
                                "text": "„Herr Müller fährt mit seinem neuen Sportwagen aus.“"
                            },
                            {
                                "example_id": "f929eb51-51ed-4ece-8853-d4f05b97633c",
                                "sense_id": "3c30d14c-9463-3f02-8177-c99d379d4df5",
                                "text": "„Der kleine rote Sportwagen hatte in Siglufjörđur bereits einige Aufmerksamkeit erregt.“"
                            }
