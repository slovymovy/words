                        "examples": [
                            {
                                "example_id": "ac7d37ee-9f05-4eb7-9fde-d361ee63dcdc",
                                "sense_id": "3006c54c-9efc-335c-8104-89f4dfaeb93c",
                                "text": "Ich muss noch Chanukkageschenke einkaufen."
                            },
                            {
                                "example_id": "e3deae66-5f4e-42c1-bbb4-531362f369ee",
                                "sense_id": "3006c54c-9efc-335c-8104-89f4dfaeb93c",
                                "text": "Hast du schon alle Chanukkageschenke besorgt?"
                            },
                            {
                                "example_id": "6c0ffff0-7c4d-40ca-b83f-0c6425319f54",
                                "sense_id": "3006c54c-9efc-335c-8104-89f4dfaeb93c",
                                "text": "„»Die Gemeinden dürfen das als Chanukkageschenk vom Landesverband betrachten«, erklärt der Jugendreferent.“"
                            },
                            {
                                "example_id": "de3c63f9-5f7d-49cc-9883-67409b8a3f8c",
                                "sense_id": "3006c54c-9efc-335c-8104-89f4dfaeb93c",
                                "text": "„Nicht umsonst pflegen viele jüdische Eltern die Tradition der Chanukkageschenke.“"
                            }
                        ],
