                ],
                "senses": [
                    {
                        "sense_id": "9938ef15-7837-37bc-b8dc-72f3b5659b5e",
                        "entry_id": "7983ede9-c3f5-3af1-9e2a-ef864d6daa1a",
                        "glosses": [
                            "Celle qui exerce la fonction du président ou de la présidente en son absence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa9a1279-95c8-40d9-a878-13c3e7d164bb",
                                "sense_id": "9938ef15-7837-37bc-b8dc-72f3b5659b5e",
                                "text": "Tout Atelier se composera d’une Grande Maîtresse ou Présidente, de deux Sœurs Inspectrices ou Vice-Présidentes, d’une Sœur Censeuse, d’une Sœur Secrétaire, d’une Sœur Trésorière et d’une Maîtresse des Cérémonies, et autres officières qui pourraient être requises pour les besoins de cet atelier."
                            },
                            {
                                "example_id": "c5d866ad-4da2-46b0-abde-3dba08de907d",
                                "sense_id": "9938ef15-7837-37bc-b8dc-72f3b5659b5e",
                                "text": "Ce qu’a dénoncé l’opposition, à commencer par Caroline Fiat, députée LFI et vice-présidente de l’Assemblée nationale, qui a évoqué un « record funeste contre notre démocratie »."
                            },
                            {
                                "example_id": "ded2543f-88ad-41cb-a11c-04dc8cea6e1b",
                                "sense_id": "9938ef15-7837-37bc-b8dc-72f3b5659b5e",
                                "text": "On remarque qu’il y a beaucoup de croyances du côté des entreprises, indique Laurence Vernay, première vice-présidente de la CCI."
                            },
                            {
                                "example_id": "ff779c51-cd08-486a-8e1c-5c040e933d88",
                                "sense_id": "9938ef15-7837-37bc-b8dc-72f3b5659b5e",
                                "text": "« Au sommet du Cojop, on compte un tiers de femmes pour deux tiers d’hommes et les deux têtes pensantes sont exclusivement masculines, avec Tony Estanguet et Étienne Thobois », comptabilise Béatrice Barbusse, vice-présidente à la fédération française de handball."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e8a3687-f81d-438d-b194-f1a7a599794c",
                        "source_entry_id": "7983ede9-c3f5-3af1-9e2a-ef864d6daa1a",
                        "source_sense_id": "9938ef15-7837-37bc-b8dc-72f3b5659b5e",
                        "target_lang_word": "Vizepräsidentin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
