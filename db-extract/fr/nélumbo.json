                        "glosses": [
                            "Graine de lotus, fève d’Égypte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc8c4098-a7ca-4b35-bba5-eeaa307db58e",
                                "sense_id": "3f781c1a-7da0-3484-b8cf-4f9dc426a63a",
                                "text": "Quant au lotus rose des auteurs, on l’a comparé d’une manière absolue au nélumbo de l’Inde, et l’on a pensé que celui-ci avait disparu de l’Égypte."
                            },
                            {
                                "example_id": "d83fc6c9-0ecf-4ff7-870d-df827ab91da1",
                                "sense_id": "3f781c1a-7da0-3484-b8cf-4f9dc426a63a",
                                "text": "Voici la mer des Roseaux, couverte de nymphéas bleus et jaunes, de roseaux à aigrettes, de nélumbos ; elle mérite justement son nom, car ces plantes aquatiques envahissent plus de la moitié de sa surface."
                            }
                        ]
                    }
