            "senses": [
                {
                    "sense_id": "7d17c926-b0bb-3d7d-934a-09c5fc37e896",
                    "sense_definition": "voorzien van een patroon van vierkanten of ruiten",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "patroon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij draagt vandaag een <w>geruit</w> overhemd naar zijn werk.",
                            "target_lang_translations": {
                                "en": "He is wearing a <w>checked</w> shirt to work today.",
                                "ru": "Сегодня он надел на работу <w>клетчатую</w> рубашку."
                            }
                        },
                        {
                            "text": "De picknicktafel was gedekt met een rood <w>geruit</w> tafelkleed.",
                            "target_lang_translations": {
                                "en": "The picnic table was covered with a red <w>checkered</w> tablecloth.",
                                "ru": "Стол для пикника был накрыт красной скатертью <w>в клетку</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "geblokt"
                    ],
                    "common_phrases": [
                        "geruit overhemd",
                        "rood geruit",
                        "geruit patroon"
                    ],
                    "target_lang_definitions": {
                        "en": "featuring a pattern of squares or diamonds",
                        "ru": "имеющий узор из квадратов или ромбов"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "checked",
                                "target_lang_sense_clarification": "pattern of squares"
                            },
                            {
                                "target_lang_word": "checkered",
                                "target_lang_sense_clarification": "pattern of squares"
                            },
                            {
                                "target_lang_word": "plaid",
                                "target_lang_sense_clarification": "pattern of crossed horizontal and vertical bands"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "клетчатый",
                                "target_lang_sense_clarification": "с узором в клетку"
                            },
                            {
                                "target_lang_word": "в клетку",
                                "target_lang_sense_clarification": "с рисунком в клетку"
                            },
                            {
                                "target_lang_word": "в ромбик",
                                "target_lang_sense_clarification": "с рисунком из ромбов"
                            }
                        ]
