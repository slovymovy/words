                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "12d51ad9-345e-4f31-aecb-ba2a5269464d",
                                "sense_id": "3f215ccc-18b9-3291-b5fb-25c30dff0a6c",
                                "text": "He didn't even play footy under the table. I kept wishing he would!"
                            },
                            {
                                "example_id": "33dcfbc1-2e3c-4d5d-a3c6-4af3973e1fe3",
                                "sense_id": "3f215ccc-18b9-3291-b5fb-25c30dff0a6c",
                                "text": "[…] playing footy under the table with Bee Amidon finished that for her."
