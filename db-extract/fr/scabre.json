                                        "sense_id": "b85d0137-9ae3-366b-9423-1364bd4d3a35",
                                        "entry_id": "2a1e372f-7b5a-39d2-b1e2-f5a4344f0bf4",
                                        "glosses": [
                                            "To create in an approximate form."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "739c6e73-0518-4cbd-bd20-b379f85f3f25",
                                                "sense_id": "b85d0137-9ae3-366b-9423-1364bd4d3a35",
                                                "text": "Rough in the shape first, then polish the details."
                                            },
                                            {
                                                "example_id": "26f9547b-3388-4c50-b61b-a0df4848ce19",
                                                "sense_id": "b85d0137-9ae3-366b-9423-1364bd4d3a35",
                                                "text": "On the floor, one beside the other, stood two amphoræ of veined marble-like limestone; one a huge vase 2 feet high and more than 6 feet round, finished and perfect, with two splendid spiral bands; and the other a smaller vase, of the same type, but only just roughed out of the block."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b8554fb-9d5a-3f08-96e3-52e3e760a683",
                                        "entry_id": "2a1e372f-7b5a-39d2-b1e2-f5a4344f0bf4",
                                        "glosses": [
                                            "To break the rules by being excessively violent."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc43aebb-e31a-4546-9323-e3013d4ecaa4",
                                                "sense_id": "1b8554fb-9d5a-3f08-96e3-52e3e760a683",
                                                "text": "[…] roughing is not a part of the sport, and will not be tolerated. Referees will not permit unfair practices that may cause injury to a contestant, and are held strictly responsible for enforcing these rules."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65f96ed2-2481-3c72-b834-2e8dfae719f0",
                                        "entry_id": "2a1e372f-7b5a-39d2-b1e2-f5a4344f0bf4",
                                        "glosses": [
                                            "To commit the offense of roughing, i.e. to punch another player."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a9a9b503-75b3-3264-8fe1-c2199416d2e2",
                                        "entry_id": "2a1e372f-7b5a-39d2-b1e2-f5a4344f0bf4",
                                        "glosses": [
                                            "To render rough; to roughen."
                                        ],
                                        "tags": [],
