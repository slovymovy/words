                        "glosses": [
                            "A mineral whose composition is that of a mixed niobate mostly of sodium, calcium and cerium, (Na,Ca)₂Nb₂O₆(OH,F)."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "78841b86-2293-4c7f-8acb-8797e6040d91",
                                "sense_id": "8e33c0fb-2dfb-3eb9-9d98-8652d82c82e6",
                                "text": "In general, the hydroxamates are used for flotation of oxidic minerals (pyrochlore, cassiterite and ilmenite), rare-earth oxides and oxide copper minerals."
                            }
                        ]
                    }
                ],
