                "senses": [
                    {
                        "sense_id": "659d22cf-a96c-3677-a2d6-4dc5fdc951c6",
                        "entry_id": "c3a62c78-ef56-383d-8deb-d1bf183ed298",
                        "glosses": [
                            "Trabant, eine Kraftfahrzeugmarke aus der ehemaligen DDR"
                        ],
                        "tags": [
                            "umgangssprachlich kurz für"
                        ],
                        "examples": [
                            {
                                "example_id": "102ac74c-3d5b-467f-a56f-61e3d531b1ce",
                                "sense_id": "659d22cf-a96c-3677-a2d6-4dc5fdc951c6",
                                "text": "„Die Polizei hat in Eisenhüttenstadt einen 25-Jährigen angetrunken und ohne Führerschein in einem gestohlenen Trabi gestoppt.“"
                            },
                            {
                                "example_id": "a52d03bb-30fc-4179-b515-1f39106bff6e",
                                "sense_id": "659d22cf-a96c-3677-a2d6-4dc5fdc951c6",
                                "text": "„Mittlerweile in Rente, gab sie sich reiselustig in ihrem Trabi.“"
                            },
                            {
                                "example_id": "98feeff1-8d6f-4141-a2ea-0589c8816500",
                                "sense_id": "659d22cf-a96c-3677-a2d6-4dc5fdc951c6",
                                "text": "„Ein Trabi hat eine Panne auf der Autobahn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
