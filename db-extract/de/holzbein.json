                ],
                "senses": [
                    {
                        "sense_id": "7e3d614e-7cf3-3688-8b5a-eb58d3668173",
                        "entry_id": "627b063c-fa37-3d6c-a84e-f4b70cd7b3da",
                        "glosses": [
                            "aus Holz geformtes Bein als Prothese"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5ef4f64-4a0a-42ab-87b8-105bbe6f274b",
                                "sense_id": "7e3d614e-7cf3-3688-8b5a-eb58d3668173",
                                "text": "„Kurz darauf sah ich nicht die Frau in Weiß eintreten, sondern ein zwergähnliches Wesen mit bläulichem Gesicht, einem Holzbein und einer Laterne in der Hand.“"
                            },
                            {
                                "example_id": "d8535001-71fb-4eb8-972a-ceecd2bef656",
                                "sense_id": "7e3d614e-7cf3-3688-8b5a-eb58d3668173",
                                "text": "„Auf dem Podium neben der Musik stand ein schönes Mädchen mit einem Holzbein und sang Lieder, die sich gewaschen hatten.“"
                            },
                            {
                                "example_id": "b29478cc-e6e2-4857-8e51-d951d854ba54",
                                "sense_id": "7e3d614e-7cf3-3688-8b5a-eb58d3668173",
                                "text": "„Der Schatten des Holzbeins war ein seltsamer Schatten.“"
                            },
                            {
                                "example_id": "8233114a-d039-40ea-a5ac-2db967558636",
                                "sense_id": "7e3d614e-7cf3-3688-8b5a-eb58d3668173",
                                "text": "„Dem Seemann fällt auf, dass der Pirat ein Holzbein, statt einer Hand nur einen Haken hat und eine Augenklappe trägt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3986757a-3a31-38d8-8263-ef28cd428120",
                        "entry_id": "627b063c-fa37-3d6c-a84e-f4b70cd7b3da",
                        "glosses": [
                            "aus Holz bestehendes Teil von Möbeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abfd2b6a-6a04-4104-b355-70fa98a97d96",
                                "sense_id": "3986757a-3a31-38d8-8263-ef28cd428120",
                                "text": "„Ein alter Sessel, bezogen mit ausgebleichtem roten Stoff. Eines der Holzbeine war neu befestigt worden, nicht fachgerecht, aber stabil.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
