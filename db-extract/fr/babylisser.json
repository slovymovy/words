                "senses": [
                    {
                        "sense_id": "dbe0f973-14dd-3c4a-b1b2-5dc3561d108e",
                        "entry_id": "d932a0ab-ce80-38d8-9cec-ae6a1be1a9ac",
                        "glosses": [
                            "Faire boucler les cheveux grâce à un fer à boucler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b8586fe-95f0-4992-a18a-7013209a6632",
                                "sense_id": "dbe0f973-14dd-3c4a-b1b2-5dc3561d108e",
                                "text": "SUR CE je vais vous laisser parce que je dois aller me babylisser les cheveux et puis parce que je sais plus quoi écrire."
                            },
                            {
                                "example_id": "0bfb9474-c3b1-4d13-8d7a-b548d05a73a8",
                                "sense_id": "dbe0f973-14dd-3c4a-b1b2-5dc3561d108e",
                                "text": "J'ai envie de te babylisser les cheveux!!!!"
                            },
                            {
                                "example_id": "4672536a-9a0d-42dc-8504-b9799395b5c3",
                                "sense_id": "dbe0f973-14dd-3c4a-b1b2-5dc3561d108e",
                                "text": "Pour se préparer, tout le monde a été chez le coiffeur pour se babylisser les cheveux (ça veut dire les faire boucler comme les tifs des poupées), les brushinguer (indispensable si, comme moi, on a les cheveux qui, au naturel, ressemblent à de la laine de fer), ou simplement les coiffer."
                            }
                        ]
                    }
