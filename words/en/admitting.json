            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3247254d-ce73-3c61-a04b-dc69a389fee4",
                    "sense_definition": "present participle and gerund of <w>admit</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "admit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>admitting</w> that she made a mistake during the meeting.",
                            "target_lang_translations": {
                                "ru": "Она <w>признает</w>, что совершила ошибку во время собрания."
                            }
                        },
                        {
                            "text": "The hospital is <w>admitting</w> new patients throughout the entire night.",
                            "target_lang_translations": {
                                "ru": "Больница <w>принимает</w> новых пациентов в течение всей ночи."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола «признавать» или «принимать/допускать»"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "признание",
                                "target_lang_sense_clarification": "в значении признания вины или факта"
                            },
                            {
                                "target_lang_word": "прием",
                                "target_lang_sense_clarification": "в значении процесса принятия кого-либо в организацию или больницу"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4229c37d-83af-33b4-af43-7095acf0e554",
                    "sense_definition": "The act of allowing someone or something to enter a place or organization.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "admit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>admitting</w> of new members to the club requires a unanimous vote.",
                            "target_lang_translations": {
                                "ru": "<w>Прием</w> новых членов в клуб требует единогласного голосования."
                            }
                        },
                        {
                            "text": "Strict rules govern the <w>admitting</w> of visitors into the secure facility.",
                            "target_lang_translations": {
                                "ru": "Строгие правила регулируют <w>допуск</w> посетителей на охраняемый объект."
                            }
                        }
                    ],
                    "synonyms": [
                        "entry",
                        "access",
                        "admission"
                    ],
                    "antonyms": [
                        "exclusion",
                        "denial"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс предоставления кому-либо или чему-либо права входа в место или вступления в организацию"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прием",
                                "target_lang_sense_clarification": "процесс вступления или допуска"
                            },
                            {
                                "target_lang_word": "допуск",
                                "target_lang_sense_clarification": "разрешение на вход в охраняемое место"
                            }
                        ]
                    }
                }
            ]
        }
    ]
