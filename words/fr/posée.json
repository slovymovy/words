            "senses": [
                {
                    "sense_id": "5b6d5baf-09a2-391b-9e5e-7f3579c57c21",
                    "sense_definition": "Féminin singulier de <w>posé</w>, qui fait preuve de calme, de mesure et de réflexion.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "caractere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C'est une femme particulièrement <w>posée</w> qui garde toujours son sang-froid dans les crises.",
                            "target_lang_translations": {
                                "en": "She is a particularly <w>level-headed</w> woman who always keeps her cool in times of crisis.",
                                "ru": "Это особенно <w>уравновешенная</w> женщина, которая в кризисных ситуациях всегда сохраняет хладнокровие.",
                                "de": "Sie ist eine besonders <w>besonnene</w> Frau, die in Krisen immer die Ruhe bewahrt.",
                                "es": "Es una mujer especialmente <w>serena</w> que siempre mantiene la sangre fría en los momentos de crisis.",
                                "zh": "她是一位格外<w>沉着</w>的女性，在危机中总能保持冷静。"
                            }
                        },
                        {
                            "text": "Elle a expliqué la situation d'une voix <w>posée</w> et rassurante.",
                            "target_lang_translations": {
                                "en": "She explained the situation in a <w>calm</w> and reassuring voice.",
                                "ru": "Она объяснила ситуацию <w>спокойным</w> и обнадёживающим голосом.",
                                "de": "Sie erklärte die Lage mit einer <w>ruhigen</w> und beruhigenden Stimme.",
                                "es": "Explicó la situación con una voz <w>tranquila</w> y reconfortante.",
                                "zh": "她用<w>沉稳</w>而令人安心的语气解释了情况。"
                            }
                        }
                    ],
                    "synonyms": [
                        "calme",
                        "réfléchie",
                        "tranquille"
                    ],
                    "antonyms": [
                        "agitée",
                        "impulsive"
                    ],
                    "common_phrases": [
                        "voix posée"
                    ],
                    "target_lang_definitions": {
                        "en": "Feminine singular form of posé, describing someone who shows calm, composure and thoughtfulness.",
                        "ru": "Спокойный, сдержанный и рассудительный; о человеке, сохраняющем самообладание в трудных обстоятельствах.",
                        "de": "Ruhig, gefasst und überlegt; beschreibt Menschen, die auch in schwierigen Lagen die Selbstbeherrschung bewahren.",
                        "es": "Dicho de una persona que muestra calma, mesura y reflexión en sus actos y palabras.",
                        "zh": "形容人冷静沉着、有分寸，遇事能保持头脑清醒。"
                    },
