{
    "word_family": [
        "docility",
        "indocile"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c702ccac-4a5e-36cd-b1d4-bd71d74880cb",
                    "sense_definition": "Ready to accept instruction or direction; obedient and easy to teach.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student had a <w>docile</w> disposition and always listened carefully to the teacher.",
                            "target_lang_translations": {
                                "ru": "У ученика был <w>послушный</w> нрав, и он всегда внимательно слушал учителя."
                            }
                        },
                        {
                            "text": "Young puppies are usually very <w>docile</w> when they are eager to learn new tricks.",
                            "target_lang_translations": {
                                "ru": "Молодые щенки обычно очень <w>понятливы</w>, когда с искренним интересом учат новые трюки."
                            }
                        }
                    ],
                    "synonyms": [
                        "amenable",
                        "compliant",
                        "teachable"
                    ],
                    "common_phrases": [
                        "docile disposition",
                        "docile nature"
                    ],
                    "target_lang_definitions": {
                        "ru": "Готовый принимать указания или руководства; послушный и легко поддающийся обучению."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "послушный",
                                "target_lang_sense_clarification": "готовый следовать указаниям"
                            },
                            {
                                "target_lang_word": "понятливый",
                                "target_lang_sense_clarification": "легко обучаемый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cca5db22-62b8-30b7-ab41-bc7bcc099597",
                    "sense_definition": "Quiet, easy to control, manage, or influence; submissive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer preferred a <w>docile</w> animal that would not cause trouble in the field.",
                            "target_lang_translations": {
                                "ru": "Фермер предпочитал <w>покорное</w> животное, которое не создавало бы проблем в поле."
                            }
                        },
                        {
                            "text": "Over time, the wild horse became a <w>docile</w> pet that followed every command.",
                            "target_lang_translations": {
                                "ru": "Со временем дикая лошадь превратилась в <w>послушного</w> питомца, исполнявшего каждую команду."
                            }
                        }
                    ],
                    "synonyms": [
                        "compliant",
                        "malleable",
                        "meek",
                        "submissive",
                        "tractable",
                        "manageable",
                        "biddable",
                        "passive",
                        "pliant",
                        "yielding"
                    ],
                    "antonyms": [
                        "perverse",
                        "defiant",
                        "rebellious",
                        "wilful",
                        "dominant"
                    ],
                    "common_phrases": [
                        "docile animal",
                        "docile population"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тихий, легкий в управлении, контроле или воздействии; покорный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покорный",
                                "target_lang_sense_clarification": "подчиняющийся, кроткий"
                            },
                            {
                                "target_lang_word": "послушный",
                                "target_lang_sense_clarification": "легко управляемый"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}