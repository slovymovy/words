                    {
                        "sense_id": "b086d7af-b1ac-3784-808a-ef64839f37d8",
                        "entry_id": "edd7116a-8dd3-3622-b003-8cc6ab8573f1",
                        "glosses": [
                            "To spin out; finish; exhaust."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "77affb55-4c9d-47a7-8950-f87f19e3a71e",
                                "sense_id": "b086d7af-b1ac-3784-808a-ef64839f37d8",
                                "text": "[…] again and again as if she could not tear herself away, yet each time dancing farther forward, swaying to and fro. Finally, her arms raised, she began twirling around, faster and faster, as if she were trying to outspin time itself."
                            },
                            {
                                "example_id": "2cdc2c17-d255-4aba-8c59-146bc617093a",
                                "sense_id": "b086d7af-b1ac-3784-808a-ef64839f37d8",
                                "text": "His protective senior staff decided the secretary was being outspun."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b36b206-5b38-3a15-b3f3-e39b7e7dc824",
                        "entry_id": "edd7116a-8dd3-3622-b003-8cc6ab8573f1",
                        "glosses": [
                            "To exceed in spinning; exceed in spinning thread."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "cdb1925b-4a5b-40f3-bc8a-7eef89b20f57",
                                "sense_id": "4b36b206-5b38-3a15-b3f3-e39b7e7dc824",
                                "text": "As if we could outspin the Fatal Sisters."
                            },
                            {
                                "example_id": "2eea839d-c38e-4e16-b729-52dcca9536b4",
                                "sense_id": "4b36b206-5b38-3a15-b3f3-e39b7e7dc824",
                                "text": "Old Cigfolla, who despite stiff joints could outspin any of them, drew out a fine thread of flax."
                            }
                        ]
                    }
