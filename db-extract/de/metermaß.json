                "senses": [
                    {
                        "sense_id": "48e87ecf-578d-3cbe-9e41-0c30b68c6f46",
                        "entry_id": "49df6714-c393-393c-b913-736e62eead2a",
                        "glosses": [
                            "in Milli- und Zentimeter eingeteiltes Hilfsmittel zum Messen von Längen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a01ff201-9cc6-47bf-85e5-196cbe952d47",
                                "sense_id": "48e87ecf-578d-3cbe-9e41-0c30b68c6f46",
                                "text": "„Haben Sie ein Metermaß, damit ich Abstand messen kann?“"
                            },
                            {
                                "example_id": "f42a12b8-3387-4f41-b1d7-3eeece18c907",
                                "sense_id": "48e87ecf-578d-3cbe-9e41-0c30b68c6f46",
                                "text": "„Ist es nicht auffällig, dass das Metermaß wie zufällig an allen möglichen Tatorten herumliegt?“"
                            },
                            {
                                "example_id": "2054f403-8f17-4d58-942f-8de1e55e16cc",
                                "sense_id": "48e87ecf-578d-3cbe-9e41-0c30b68c6f46",
                                "text": "„Wie präzise ein Metermaß der Vorgabe entspricht, lässt sich an der Genauigkeitsklasse ablesen, die laut EG-Richtlinie zu Beginn der Messskala im Oval aufgedruckt ist.“"
                            },
                            {
                                "example_id": "f58743de-9fe0-421a-a2b9-84166bb32e04",
                                "sense_id": "48e87ecf-578d-3cbe-9e41-0c30b68c6f46",
                                "text": "„Wenn es zum Beispiel um das Metermaß einer Schneiderin geht, vermutet man erfahrungsgemäß ein handliches Werkzeug.“"
                            },
                            {
                                "example_id": "eb73ce6c-a642-4b05-901f-eb12435aa45b",
                                "sense_id": "48e87ecf-578d-3cbe-9e41-0c30b68c6f46",
                                "text": "„Die mit dem 1. Januar 1872 im Deutschen Reich gesetzlich eingeführte neue Maß- und Gewichtsordnung hat das Bedürfnis mit sich gebracht, Hilfstabellen zur schnellen und leichten Berechnung des kubischen Inhalts aller Arten Körper in Metermaß zu schaffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "62b8d2d4-65e0-4bdc-b5df-f5ee766d1e8b",
                        "source_entry_id": "49df6714-c393-393c-b913-736e62eead2a",
                        "source_sense_id": "48e87ecf-578d-3cbe-9e41-0c30b68c6f46",
                        "source_sense_description": "in Milli- und Zentimeter eingeteiltes Hilfsmittel zum Messen von Längen",
                        "target_lang_word": "mètre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mètre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "96c01fa7-0f33-323e-88ad-18c48cf707b3",
                                        "entry_id": "386111f6-6890-3e97-8c8f-90825e35ff16",
                                        "glosses": [
                                            "Unité de mesure de longueur du Système international, dont le symbole est m. Le mètre est défini de manière universelle depuis 1983 par la longueur du trajet parcouru par la lumière dans le vide en 1/299 792 458 de seconde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acd2bf76-2fc2-49ea-b564-fb3e1be57482",
                                                "sense_id": "96c01fa7-0f33-323e-88ad-18c48cf707b3",
                                                "text": "Nous profitons de la clarté pour faire l’ascension d'une montagne de 400 mètres de hauteur qui domine Thorshavn."
                                            },
                                            {
                                                "example_id": "2e967d5c-0bd0-45ba-aaa9-96083c7074bd",
                                                "sense_id": "96c01fa7-0f33-323e-88ad-18c48cf707b3",
                                                "text": "Le travail de filature consiste à retirer le fil du cocon dont la longueur est d’environ 480 mètres et à le dévider sans le briser."
                                            },
                                            {
                                                "example_id": "055f1ef1-4a5c-41a2-8f28-5c7784a8f702",
                                                "sense_id": "96c01fa7-0f33-323e-88ad-18c48cf707b3",
                                                "text": "Nous envoyons les dragons en éclaireurs, mais rien à droite, rien à gauche, et, devant nous, à cinq cents mètres, la colline et la forêt."
                                            },
                                            {
                                                "example_id": "1fc7688f-2491-4912-862f-162ad888cc77",
                                                "sense_id": "96c01fa7-0f33-323e-88ad-18c48cf707b3",
                                                "text": "Je ne crois pas que la plus grande hauteur de l’atoll atteignît deux mètres."
                                            },
                                            {
                                                "example_id": "d81f84ed-fa12-439c-a450-a91f5fb2d515",
                                                "sense_id": "96c01fa7-0f33-323e-88ad-18c48cf707b3",
                                                "text": "Un tiers environ du département est formé de ces causses dénudés, de ces plateaux calcaires hauts, ici de 500 à 1000 mètres […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cd0feb4-ff13-3fe8-8b5c-96bbcc69fc44",
                                        "entry_id": "386111f6-6890-3e97-8c8f-90825e35ff16",
                                        "glosses": [
                                            "Instrument qui permet de mesurer cette longueur."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dff2e514-e40e-4e18-84cb-b82e63c2b5b3",
                                                "sense_id": "1cd0feb4-ff13-3fe8-8b5c-96bbcc69fc44",
                                                "text": "J’ai souvenir aussi, dit Lebrun, d’un mètre pliant avec lequel vous faisiez naître et mourir des triangles aussi mobiles que cette mer."
                                            },
                                            {
                                                "example_id": "eae14109-689e-4ade-b112-6f8db7bb9836",
                                                "sense_id": "1cd0feb4-ff13-3fe8-8b5c-96bbcc69fc44",
                                                "text": "C’était Pierson. Il était agenouillé, et avec un mètre de couturière il paraissait très occupé à mesurer le sol. Ses manches étaient retroussées, ses mains tachées de terre, et il y avait une petite pelle à ses côtés."
                                            },
                                            {
                                                "example_id": "064d656b-6474-45ab-9904-d774aa354319",
                                                "sense_id": "1cd0feb4-ff13-3fe8-8b5c-96bbcc69fc44",
                                                "text": "Le mètre de maçon est en bois, tout jaune. Le mètre de menuisier aussi, mais il a pas de ressorts. Le mètre de maçon a des ressorts – papa, en tout cas, appelle ça des ressorts – au bout de ses branches pour qu’elles se tiennent bien droites quand on déplie le mètre. Les menuisiers, je sais pas comment ils font. À cause des ressorts, les mètres de maçon cassent souvent."
                                            },
                                            {
                                                "example_id": "7b0121da-7b09-4b3a-bfb1-d3b689624372",
                                                "sense_id": "1cd0feb4-ff13-3fe8-8b5c-96bbcc69fc44",
                                                "text": "Il sortit de sa poche un mètre ruban métallique, qu’il déplia jusqu’à deux mètres, et au bout duquel il fixa une boucle faite avec un morceau de corde […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40ab428a-cad1-3b5b-9e8d-9c56d8622cfe",
                                        "entry_id": "386111f6-6890-3e97-8c8f-90825e35ff16",
                                        "glosses": [
                                            "Mètre carré."
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32c3d376-8e7a-4840-8b51-f0bb893c6e9f",
                                                "sense_id": "40ab428a-cad1-3b5b-9e8d-9c56d8622cfe",
                                                "text": "Le légume le plus abondant était sans contredit le Chou et les diverses races auxquelles il a donné naissance ; en effet, et nous ne comprenons ici que les expositions spéciales de cette Crucifère, ces produits n’occupaient pas moins de 80 mètres de surface."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9695fa63-f1b4-3a94-b4e6-1bf4aa638931",
                                        "entry_id": "386111f6-6890-3e97-8c8f-90825e35ff16",
                                        "glosses": [
                                            "Mètre cube."
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73b18402-ddf1-4b24-bb3a-3f41c36b9a84",
                                                "sense_id": "9695fa63-f1b4-3a94-b4e6-1bf4aa638931",
                                                "text": "On suppute le prix d’une colonne, on marchande l’épaisseur des dorures, bientôt il ne sera plus permis d’allumer une rampe au fronton de l’Élysée, sans entendre crier quelque part qu’un mètre de gaz coûte vingt centimes […]"
                                            },
                                            {
                                                "example_id": "f4bc9ca5-0691-4843-ad9f-9dff44a12426",
                                                "sense_id": "9695fa63-f1b4-3a94-b4e6-1bf4aa638931",
                                                "text": "On vient d’abattre à Lyon un platane géant. Cet arbre cubait près de 12 mètres et le tronc seul pesait 19540 kilogr."
                                            },
                                            {
                                                "example_id": "3ff9c103-1293-4d2d-88bd-96c681c17ac8",
                                                "sense_id": "9695fa63-f1b4-3a94-b4e6-1bf4aa638931",
                                                "text": "Avec 210 000 hectares de forêt, dont 90 % de forêt privée, le Loir-et-Cher dispose d’un stock de 21  millions de mètres de bois d’œuvre, de 12,5 millions de mètres de bois d’industrie pour la pâte à papier, les palettes et autres cageots, à quoi s’ajoutent 21,5 millions de mètres de bois énergie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mètre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4fdebde4-305e-30e0-9bb6-988fbbd2acae",
                                        "entry_id": "5855f3d1-53b0-356d-905e-7e97826e0034",
                                        "glosses": [
                                            "Pied déterminé, par la quantité, dans la versification grecque et latine, comme le dactyle, le spondée, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e228ed1b-af3e-4d20-8776-a9a5f1ce75c5",
                                                "sense_id": "4fdebde4-305e-30e0-9bb6-988fbbd2acae",
                                                "text": "Hilperik avait pris quelques uns des goûts de la civilisation romaine. Il […] avait la prétention d’être grammairien, théologien et poète. Ses vers latins, où les règles du mètre et de la prosodie étaient rarement observées, trouvaient des admirateurs parmi les nobles gaulois qui applaudissaient en tremblant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85e2c868-a871-3df3-979e-4c9c26ac5619",
                                        "entry_id": "5855f3d1-53b0-356d-905e-7e97826e0034",
                                        "glosses": [
                                            "Vers caractérisé par le nombre de syllabes et la coupe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25825bd0-744c-4394-a624-851155915811",
                                                "sense_id": "85e2c868-a871-3df3-979e-4c9c26ac5619",
                                                "text": "Ils manient avec une élégante aisance les mètres latins les plus compliqués et les vocables les plus choisis de la mythologie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7968e548-81ee-364a-a89c-ce361a62059b",
                                        "entry_id": "5855f3d1-53b0-356d-905e-7e97826e0034",
                                        "glosses": [
                                            "Nature et nombre de pieds nécessaires à la formation de chaque genre de vers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c952462-03bb-46f2-948b-d160fbadf48f",
                                                "sense_id": "7968e548-81ee-364a-a89c-ce361a62059b",
                                                "text": "Écouter Ronsard le maître\nOu chercher à travers champs,\nQuelques chants\nRhythmés sur un nouveau mètre."
                                            }
                                        ]
                                    }
                                ]
                            },
