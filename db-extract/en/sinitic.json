                    {
                        "translation_id": "1c4f359f-9149-40a8-90b5-4f1e500d644e",
                        "source_entry_id": "6d901c8a-ef7e-3b48-8e84-7498944c3b37",
                        "source_sense_description": "relating to the group of Chinese languages",
                        "target_lang_word": "chinesisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chinesisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3060eb43-ff99-3cc6-b462-4dd2855b0655",
                                        "entry_id": "4bbf72f0-873b-3df5-b794-a676fc07e115",
                                        "glosses": [
                                            "zum Volk der Chinesen gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24b14d3a-f3d2-43ce-b54b-31a4e477664f",
                                                "sense_id": "3060eb43-ff99-3cc6-b462-4dd2855b0655",
                                                "text": "Er brachte seine chinesische Ehefrau mit."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7e56cddb-b9d4-358e-9d1f-cb3ddc1d96fd",
                                        "entry_id": "4bbf72f0-873b-3df5-b794-a676fc07e115",
                                        "glosses": [
                                            "zu China gehörig, China betreffend, von China ausgehend/stammend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81549dc6-6285-4dd4-85c9-a5158b6151bd",
                                                "sense_id": "7e56cddb-b9d4-358e-9d1f-cb3ddc1d96fd",
                                                "text": "Der chinesische Außenminister ist heute in Berlin."
                                            },
                                            {
                                                "example_id": "685624fb-26e1-4ea5-bf58-564a63ab1949",
                                                "sense_id": "7e56cddb-b9d4-358e-9d1f-cb3ddc1d96fd",
                                                "text": "Diesmal versuchte ich es wirklich mit einer Seitenstraße, aber die führte auf eine noch lautere, noch bevölkertere, noch chinesischere Straße in Richtung Süden."
                                            },
                                            {
                                                "example_id": "0442f404-3162-4cb0-b980-d54b0a6b529f",
                                                "sense_id": "7e56cddb-b9d4-358e-9d1f-cb3ddc1d96fd",
                                                "text": "„Allein in Kasachstan betrugen die chinesischen Auslandsinvestitionen im Jahr 2018 mehr als 15 Milliarden US-Dollar.“"
                                            },
                                            {
                                                "example_id": "d3b9dbde-540c-42ad-9455-34c8d54ddc8a",
                                                "sense_id": "7e56cddb-b9d4-358e-9d1f-cb3ddc1d96fd",
                                                "text": "„Insbesondere gegen Muslime geht die chinesische Regierung […] hart vor.“"
                                            },
                                            {
                                                "example_id": "7e0dfc94-812c-4251-8a3f-c399bf35bf77",
                                                "sense_id": "7e56cddb-b9d4-358e-9d1f-cb3ddc1d96fd",
                                                "text": "„Es gibt erst wenige Personen in der Schweiz, die Versuche der chinesischen Einflussnahme an Universitäten offenlegen und kritisieren.“"
                                            },
                                            {
                                                "example_id": "94cdca1a-0353-4337-b25d-b4278e4121cb",
                                                "sense_id": "7e56cddb-b9d4-358e-9d1f-cb3ddc1d96fd",
                                                "text": "„Die Zusammenarbeit zwischen schweizerischen und chinesischen Universitäten ist eng, es gibt inzwischen über fünfzig Kooperationsabkommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c2aca505-4ae2-3bff-b0bd-b3b48d2c6504",
                                        "entry_id": "4bbf72f0-873b-3df5-b794-a676fc07e115",
                                        "glosses": [
                                            "zur Schriftsprache Chinesisch oder einer der in China gesprochenen Sprachen gehörig"
                                        ],
                                        "tags": [
                                            "nicht steigerbar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f70ffd2c-de43-481e-9a9c-b4fdfc235bd7",
                                                "sense_id": "c2aca505-4ae2-3bff-b0bd-b3b48d2c6504",
                                                "text": "Ich habe wieder ein paar chinesische Wörter gelernt."
                                            },
                                            {
                                                "example_id": "8b841078-d48b-4a44-96e1-4a4ee0c5b8f9",
                                                "sense_id": "c2aca505-4ae2-3bff-b0bd-b3b48d2c6504",
                                                "text": "„Auch die chinesische Mandarinschrift ist längst keine reine Zeichenschrift mehr.“"
                                            },
                                            {
                                                "example_id": "283f9a70-27bd-448d-a95d-3850dccdc1ca",
                                                "sense_id": "c2aca505-4ae2-3bff-b0bd-b3b48d2c6504",
                                                "text": "„Auch der Vater des jungen Tishu-Lama trug ein gelb atlassenes Gewand, das mit goldenen Drachen, dem chinesischen Wappen, reich durchwirkt war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "d7a152d5-cc48-3347-9802-fdb54198afa9",
                                        "entry_id": "4bbf72f0-873b-3df5-b794-a676fc07e115",
                                        "glosses": [
                                            "unverständlich"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b92f31c7-90c1-4080-adcb-7a9f0506ad4f",
                                                "sense_id": "d7a152d5-cc48-3347-9802-fdb54198afa9",
                                                "text": "Mein Mathelehrer wollte mir die Integralrechnung erklären. Doch für mich war das alles chinesisch."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "028b32bd-6de2-483a-9d82-50cc051bc8dc",
                        "source_entry_id": "6d901c8a-ef7e-3b48-8e84-7498944c3b37",
                        "source_sense_description": "relating to the group of Chinese languages",
