                        "glosses": [
                            "Dienst, der die Verkehrssicherheit im Winter gewährleisten soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bd85025-bc13-44a5-9a15-3a730469692a",
                                "sense_id": "ec046bd3-8ad6-3892-b754-2764b538d4d7",
                                "text": "Der Winterdienst kommt bei diesem starken Schneefall mit der Räumung des Schnees nicht nach."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ec61122b-a3ff-35d3-bbb2-1c8d66dfca25",
                        "entry_id": "d6d18036-6836-3516-95a8-1972f804a60a",
                        "glosses": [
                            "Gesamtheit aller Maßnahmen, die der Dienst [1] leistet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b7eb0f7-eb23-4022-b7ea-5f3cb91d82ce",
                                "sense_id": "ec61122b-a3ff-35d3-bbb2-1c8d66dfca25",
                                "text": "„Abweichend von anderen Bundesländern verbleibt in Berlin nach einer Gesetzesänderung im November 2010 die Verantwortlichkeit für die ordnungsgemäße Durchführung des Winterdienstes beim Anlieger, auch wenn dieser ein gewerbliches Unternehmen mit der Durchführung beauftragt hat […].“"
                            }
                        ],
                        "sense_index_json": "\"2\""
