                    },
                    {
                        "translation_id": "814c5c61-e302-48d8-b892-ecc743a3596d",
                        "source_entry_id": "0c25e5a6-3df2-3b3b-99e4-e1381ff539dc",
                        "source_sense_id": "68c62b37-721a-3e3f-ac69-30b6273c7efa",
                        "source_sense_description": "lied",
                        "target_lang_word": "song",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "song",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59fb91fc-36f2-3849-bfd5-7f00389adbc7",
                                        "entry_id": "98bb7cdd-8b7e-35f0-ad42-8045c6d3ec7b",
                                        "glosses": [
                                            "A musical composition with lyrics for voice or voices, performed by singing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cfb0dee-c280-4017-8e8b-9a9c375b4d0d",
                                                "sense_id": "59fb91fc-36f2-3849-bfd5-7f00389adbc7",
                                                "text": "Thomas listened to his favorite song on the radio yesterday."
                                            },
                                            {
                                                "example_id": "d5d0a319-2171-4786-9391-5005ae7272ef",
                                                "sense_id": "59fb91fc-36f2-3849-bfd5-7f00389adbc7",
                                                "text": "The Harpe. […] A harper with his wreſt maye tune the harpe wrong / Mys tunying of an Inſtrument ſhal hurt a true ſonge"
                                            },
                                            {
                                                "example_id": "ac36f070-0c53-4f36-a5d9-3e0a11abd1e8",
                                                "sense_id": "59fb91fc-36f2-3849-bfd5-7f00389adbc7",
                                                "text": "In the lightness of my heart I sang catches of songs as my horse gayly bore me along the well-remembered road."
                                            },
                                            {
                                                "example_id": "3d546982-dc11-44af-8394-8915a24e386c",
                                                "sense_id": "59fb91fc-36f2-3849-bfd5-7f00389adbc7",
                                                "text": "He was thinking; but the glory of the song, the swell from the great organ, the clustered lights,[…], the height and vastness of this noble fane, its antiquity and its strength—all these things seemed to have their part as causes of the thrilling emotion that accompanied his thoughts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3122f593-8ec8-3566-bd51-8fb46e989be3",
                                        "entry_id": "98bb7cdd-8b7e-35f0-ad42-8045c6d3ec7b",
                                        "glosses": [
                                            "Any musical composition."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "563a921b-9be9-3518-ba5f-66c8a8c34da5",
                                        "entry_id": "98bb7cdd-8b7e-35f0-ad42-8045c6d3ec7b",
                                        "glosses": [
                                            "Poetical composition; poetry; verse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0136310e-502f-422d-897a-b3be435b5610",
                                                "sense_id": "563a921b-9be9-3518-ba5f-66c8a8c34da5",
                                                "text": "This subject for heroic song."
                                            },
                                            {
                                                "example_id": "52d69ab5-8142-42b8-80df-eac4b8ea7d6b",
                                                "sense_id": "563a921b-9be9-3518-ba5f-66c8a8c34da5",
                                                "text": "The bard that first adorned our native tongue / Tuned to his British lyre this ancient song."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0e7c48b-4237-3767-a3dc-071f2ddf1f60",
                                        "entry_id": "98bb7cdd-8b7e-35f0-ad42-8045c6d3ec7b",
                                        "glosses": [
                                            "The act or art of singing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8d4ddb8-0070-4d08-8efb-346e38d9392b",
                                                "sense_id": "f0e7c48b-4237-3767-a3dc-071f2ddf1f60",
                                                "text": "How often the enthusiast has dwelt upon the birds bursting into song, the buds bursting into flower, all nature bursting into life!—as though a state of things in which everything around us is bursting is at all pleasant."
                                            },
                                            {
                                                "example_id": "585f3c43-7d66-484e-a7f8-bd3427bb4edb",
                                                "sense_id": "f0e7c48b-4237-3767-a3dc-071f2ddf1f60",
                                                "text": "Or take one that is less of an explanation and more of a song , The Spider . I knew all along what I wanted to say about a spider . I wanted to say all the good things I could . For spiders are the one order of creation that I thoroughly dislike.[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b0e8151-894e-3431-acda-7dee5556a432",
                                        "entry_id": "98bb7cdd-8b7e-35f0-ad42-8045c6d3ec7b",
                                        "glosses": [
                                            "A melodious sound made by a bird, insect, whale or other animal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5610d8a5-bf02-405a-a67f-f69dca8cb3f7",
                                                "sense_id": "5b0e8151-894e-3431-acda-7dee5556a432",
                                                "text": "I love hearing the song of canary birds."
                                            },
                                            {
                                                "example_id": "42f5b3d3-c3c5-4ab9-9365-6d8a14ea55cd",
                                                "sense_id": "5b0e8151-894e-3431-acda-7dee5556a432",
                                                "text": "That most ethereal of all sounds, the song of crickets."
                                            },
                                            {
                                                "example_id": "8a153e76-01d2-45e4-953d-0a439f20c6b4",
                                                "sense_id": "5b0e8151-894e-3431-acda-7dee5556a432",
                                                "text": "The robin alone by his soft morning song broke the silence and the solitude which reigned in the forest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "854c7f28-e8f9-38ff-945c-1f1fb98f72c1",
                                        "entry_id": "98bb7cdd-8b7e-35f0-ad42-8045c6d3ec7b",
                                        "glosses": [
                                            "The distinctive sound that a male bird utters to attract a mate or to protect his territory; contrasts with call; also, similar vocalisations made by female birds."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "21be1dee-fbfb-30ba-be66-97a52318c04f",
                                        "entry_id": "98bb7cdd-8b7e-35f0-ad42-8045c6d3ec7b",
                                        "glosses": [
                                            "A low price, especially one under the expected value; chiefly in for a song."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13db244b-5530-4019-81f7-9b2f9760458e",
                                                "sense_id": "21be1dee-fbfb-30ba-be66-97a52318c04f",
                                                "text": "He bought that car for a song."
                                            },
                                            {
                                                "example_id": "bc9cffcb-5854-4563-8529-59ee1c87a45a",
                                                "sense_id": "21be1dee-fbfb-30ba-be66-97a52318c04f",
                                                "text": "his [a common soldier's] pay is a song."
                                            },
                                            {
                                                "example_id": "c0619da9-d19a-4765-a506-bb05efca6983",
                                                "sense_id": "21be1dee-fbfb-30ba-be66-97a52318c04f",
                                                "text": "Thus the red damask curtains which now shut out the fog-laden, drizzling atmosphere of the Marylebone Road, had cost a mere song, and yet they might have been warranted to last another thirty years. A great bargain also had been the excellent Axminster carpet which covered the floor;[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e3f0681-b1fa-3b9d-bddf-19ee3ee921f2",
                                        "entry_id": "98bb7cdd-8b7e-35f0-ad42-8045c6d3ec7b",
                                        "glosses": [
                                            "An object of derision; a laughing stock."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b030cca-945b-4118-9de9-bee53753e339",
                                                "sense_id": "2e3f0681-b1fa-3b9d-bddf-19ee3ee921f2",
                                                "text": "And now am I their song, yea, I am their byword."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9934b0dd-4685-49fe-9870-30f7e437fc53",
                        "source_entry_id": "0c25e5a6-3df2-3b3b-99e4-e1381ff539dc",
                        "source_sense_id": "68c62b37-721a-3e3f-ac69-30b6273c7efa",
                        "source_sense_description": "lied",
                        "target_lang_word": "hymn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hymn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df42f7ae-9656-3da7-b4dc-19b93eea3d90",
                                        "entry_id": "a33e694a-762e-309c-a241-68d648d982e5",
                                        "glosses": [
                                            "A song of praise or worship, especially a religious one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a6e9039-4a9d-448d-b96a-412728694d26",
                                                "sense_id": "df42f7ae-9656-3da7-b4dc-19b93eea3d90",
                                                "text": "But when the moon rose and the breeze awakened, and the sedges stirred, and the cat’s-paws raced across the moonlit ponds, and the far surf off Wonder Head intoned the hymn of the four winds, the trinity, earth and sky and water, became one thunderous symphony—a harmony of sound and colour silvered to a monochrome by the moon."
                                            },
                                            {
                                                "example_id": "c2029e6a-a7ae-4749-a610-c8a5da327edd",
                                                "sense_id": "df42f7ae-9656-3da7-b4dc-19b93eea3d90",
                                                "text": "An interesting feature of the church is the invisible clock, which you can hear thumping away as you enter. Constructed in 1525, it is one of the oldest timepieces in England. It chimes the hours and the quarters, and every three hours it plays a hymn. But it has no faces."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hymn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "edac7ea1-32ce-382b-9e73-7b6eb0f7be99",
                                        "entry_id": "38b2a23a-870b-3a00-a0aa-ac02178634b6",
                                        "glosses": [
                                            "To sing a hymn."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f1b528f-3781-4965-9a57-444146df7c81",
                                                "sense_id": "edac7ea1-32ce-382b-9e73-7b6eb0f7be99",
                                                "text": "An unknown cast, including Diane Keaton, hymned the Age of Aquarius, stripped off at the end of the first act and let the sunshine in at the end of the second."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "396ed698-85ea-3e41-bf41-213f5b75d717",
                                        "entry_id": "38b2a23a-870b-3a00-a0aa-ac02178634b6",
                                        "glosses": [
                                            "To praise or extol in hymns."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0681cc7b-0e26-4bb3-ba3c-1177d2877f19",
                                                "sense_id": "396ed698-85ea-3e41-bf41-213f5b75d717",
                                                "text": "To hymn the birth-night of the Lord."
                                            },
                                            {
                                                "example_id": "a0aa1c0d-8c9d-428e-bced-08958a0a4a07",
                                                "sense_id": "396ed698-85ea-3e41-bf41-213f5b75d717",
                                                "text": "Their praise is hymned by loftier harps than mine."
                                            },
                                            {
                                                "example_id": "1a876034-f447-4935-b58b-da64f540ea41",
                                                "sense_id": "396ed698-85ea-3e41-bf41-213f5b75d717",
                                                "text": "In sculpture and in the drama, in Aristophanic farce and in hieratic rituals, in pictorial art and in the stream of literature, the phallus is transcendent. Thus the Priapean poetry of the ancients, particularly of the Romans, hymned sexual potency."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
