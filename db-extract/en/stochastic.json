                "senses": [
                    {
                        "sense_id": "93bd1586-b672-3750-aa5b-a80ae61c8298",
                        "entry_id": "6a86c218-ddb9-3ffd-a6cc-aab3708b1361",
                        "glosses": [
                            "Random, randomly determined."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f77b14e1-b302-47bd-823c-03002878d07f",
                                "sense_id": "93bd1586-b672-3750-aa5b-a80ae61c8298",
                                "text": "In the evening, while she bathed, waiting for him to enter the bathroom as she powdered her body, he crouched over the blueprints spread between the sofas in the lounge, calculating a stochastic analysis of the Pentagon car park."
                            },
                            {
                                "example_id": "cca2cc38-0715-40e5-b2c3-bc822128db55",
                                "sense_id": "93bd1586-b672-3750-aa5b-a80ae61c8298",
                                "text": "Self-slaughter, as Hamlet always says, was certainly in the cards, unless one had been out here long enough to have contemplated the will of God, observed the stochastic whimsy of the day, learned when and when not to whisper “Insh'allah,” and understood how, as one perhaps might never have in England, to await, to depend upon, the ineluctable departure of what was most dear."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a49befa-f643-4bed-b894-22352812eafc",
                        "source_entry_id": "6a86c218-ddb9-3ffd-a6cc-aab3708b1361",
