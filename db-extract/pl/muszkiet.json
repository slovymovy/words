                "senses": [
                    {
                        "sense_id": "038b26d3-a14a-3cf9-8208-be9dc0547bdc",
                        "entry_id": "ecfc9758-b33a-3982-963d-5b78eadce15d",
                        "glosses": [
                            "długa czarnoprochowa, odprzodowa, gładkolufowa broń palna wyposażona w lufę kalibru od 18 do 20 milimetrów,"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8628fd2-b53d-44ee-8446-c597050d8e3f",
                                "sense_id": "038b26d3-a14a-3cf9-8208-be9dc0547bdc",
                                "text": "Żołnierzy uzbrojonych w muszkiety nazywano muszkieterami."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e5ba485-9aa8-4ecc-9733-df9c06c454d1",
                        "source_entry_id": "ecfc9758-b33a-3982-963d-5b78eadce15d",
                        "source_sense_id": "038b26d3-a14a-3cf9-8208-be9dc0547bdc",
                        "target_lang_word": "musket",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "musket",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af434c0d-bcf0-3a21-9243-eee04e225fbe",
                                        "entry_id": "9b1654cb-231e-34ae-bee2-8127b23b55ef",
                                        "glosses": [
                                            "A kind of firearm formerly carried by the infantry of an army, originally fired by means of a match, or matchlock, for which several mechanical appliances (including the flintlock, and finally the percussion lock) were successively substituted; ultimately superseded by the rifle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2997e13-31b7-4727-9be4-0bff8de2c433",
                                                "sense_id": "af434c0d-bcf0-3a21-9243-eee04e225fbe",
                                                "text": "Soldier, soldier, won't you marry me, with your musket, fife and drum."
                                            },
                                            {
                                                "example_id": "dcf3f5fb-5def-4862-a3bd-4b74410e3112",
                                                "sense_id": "af434c0d-bcf0-3a21-9243-eee04e225fbe",
                                                "text": "Sam, Sam, pick up thy musket."
                                            },
                                            {
                                                "example_id": "ae9fa141-9ea1-4f07-b2cb-a2be56ad3790",
                                                "sense_id": "af434c0d-bcf0-3a21-9243-eee04e225fbe",
                                                "text": "[…] you may be assured, had they known the terrour of Muskets, Caliuers and Piſtols, they would haue vſed the leſſe Bowes, Speares and Bills; […]"
                                            },
                                            {
                                                "example_id": "e8cf6571-ec5d-44ea-be4f-f762b86d7587",
                                                "sense_id": "af434c0d-bcf0-3a21-9243-eee04e225fbe",
                                                "text": "The Souldier having his Musket ſhoulder'd, muſt ſtand ſtraight upon his Limbs, hold up his Head, and look always to the commanding Officer, […]"
                                            },
                                            {
                                                "example_id": "51c6eba0-99cf-491d-8af3-fb50efa8c225",
                                                "sense_id": "af434c0d-bcf0-3a21-9243-eee04e225fbe",
                                                "text": "The whole of the tumultuous scene vanished from the senses of Lionel at the flash of the musket of this man, and he sunk beneath the feet of the combatants, insensible of further triumph, and of every danger."
                                            },
                                            {
                                                "example_id": "35656ad2-d04e-4642-8ac6-e4bfb040bc33",
                                                "sense_id": "af434c0d-bcf0-3a21-9243-eee04e225fbe",
                                                "text": "Probably, rifling evolved from the early observation of the feathers on an arrow-and from the practical results of cutting channels in a musket, originally to reduce fouling, then because it was found to improve accuracy of the shot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b4ec427-983e-3fd2-9b31-43a76556b400",
                                        "entry_id": "9b1654cb-231e-34ae-bee2-8127b23b55ef",
                                        "glosses": [
                                            "A male Eurasian sparrowhawk (Accipiter nisus)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fe3fc603-d79f-4a6d-b52a-9845637fbbf7",
                        "source_entry_id": "ecfc9758-b33a-3982-963d-5b78eadce15d",
                        "source_sense_id": "038b26d3-a14a-3cf9-8208-be9dc0547bdc",
                        "target_lang_word": "mousquet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mousquet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8ca3c189-ee97-3168-8ab5-c9dbcf56dbb0",
                                        "entry_id": "bd60035c-14ea-3ec8-98e6-0470bfc2aa76",
                                        "glosses": [
                                            "Arme à feu qui était en usage avant le fusil et qu’on faisait partir au moyen d’une mèche allumée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a7e20ba-e564-43f3-b488-991579ab5646",
                                                "sense_id": "8ca3c189-ee97-3168-8ab5-c9dbcf56dbb0",
                                                "text": "Oui-da ! répondit Fergusson ; mais ils seraient à bonne portée aussi, et notre Victoria offrirait un but trop facile aux balles de leurs longs mousquets."
                                            },
                                            {
                                                "example_id": "5b9c76ab-378c-46a4-99b9-c80f418c211d",
                                                "sense_id": "8ca3c189-ee97-3168-8ab5-c9dbcf56dbb0",
                                                "text": "Une sentinelle, le mousquet au bras et enveloppée dans son manteau, se promène le long du rempart."
                                            },
                                            {
                                                "example_id": "9298295d-4d68-45fa-9d96-8b086a70d341",
                                                "sense_id": "8ca3c189-ee97-3168-8ab5-c9dbcf56dbb0",
                                                "text": "Les terribles prêcheurs de Seize, les moines qui portaient le mousquet aux processions de la Ligue, s'humanisent tout à coup ; les voilà devenus bénins. C'est qu'il faut bien essayer d’endormir ceux qu'on n'a pas pu tuer."
                                            },
                                            {
                                                "example_id": "44913eb2-8e17-404c-b6c2-21221aac809d",
                                                "sense_id": "8ca3c189-ee97-3168-8ab5-c9dbcf56dbb0",
                                                "text": "Le plus grand nombre de ces soldats improvisés avaient des fusils, des carabines ou d’anciens mousquets de la garde nationale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6eb4b8af-3544-3ec6-afdc-135d41d4106f",
                                        "entry_id": "bd60035c-14ea-3ec8-98e6-0470bfc2aa76",
                                        "glosses": [
                                            "Meuble représentant l’arme du même nom dans les armoiries. Il est généralement représenté comme un fusil ancien. Ce meuble fait référence à la chasse ou la guerre."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36d9facd-ecca-4c5c-95c3-4d81307228c6",
                                                "sense_id": "6eb4b8af-3544-3ec6-afdc-135d41d4106f",
                                                "text": "D’azur, à deux mousquets passés en sautoir brochant sur une rapière, le tout d’or, qui est de l’École de Guerre du Nord (Suède) → voir illustration « armoiries avec 2 mousquets »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a007bb8a-e617-3250-a3ef-ea1f642fe57d",
                                        "entry_id": "bd60035c-14ea-3ec8-98e6-0470bfc2aa76",
                                        "glosses": [
                                            "Support utilisé comme ornement extérieur d’armoiries. Il est généralement représenté par paire et passés en sautoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
