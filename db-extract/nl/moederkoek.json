                        "entry_id": "c869ab37-7fd1-3de2-a3ce-050674eef178",
                        "glosses": [
                            "orgaan bestaande uit baarmoederslijmvlies en embryoblaasje dat zorgt voor de uitwisseling van voedingsstoffen, zuurstof en afvalstoffen tussen moeder en ongeboren kind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4ca60d8-b450-4eef-b761-5bf36e0ec61d",
                                "sense_id": "0cb240db-ee93-3cf1-8edd-437a38e665f7",
                                "text": "Het ongeboren kind is met de navelstreng verbonden met de moederkoek."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44e94720-237c-42ea-8a0c-c16d5e179592",
