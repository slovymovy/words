                    }
                ],
                "senses": [
                    {
                        "sense_id": "c4f72619-3a0f-3c5a-ba26-6c07cd1bf8d9",
                        "entry_id": "bb594bb5-ac14-336c-a364-f3fbf00d8784",
                        "glosses": [
                            "Vorteil, der einem Bundeskanzlers/einer Bundeskanzlerin bei erneuten Wahlen, meist von Medien, eingeräumt wird"
                        ],
                        "tags": [
                            "Medien"
                        ],
                        "examples": [
                            {
                                "example_id": "1fc87c4f-8669-4ee0-953f-c009b87dc8b8",
                                "sense_id": "c4f72619-3a0f-3c5a-ba26-6c07cd1bf8d9",
                                "text": "„Es gibt keinen Kanzlerbonus für Kurzzeitkanzler.“"
                            },
                            {
                                "example_id": "ac098097-473b-4c62-91ab-0acba2325af4",
                                "sense_id": "c4f72619-3a0f-3c5a-ba26-6c07cd1bf8d9",
                                "text": "„»Den Wert des Kanzlerbonus kann man nicht beziffern, weil er unschätzbar hoch ist«, analysiert Politberater Josef Kalina, der 2006 den Wahlkampf von Alfred Gusenbauer leitete.“"
                            },
                            {
                                "example_id": "9c0e048d-d6e3-4a2e-9f40-223a9c1e3654",
                                "sense_id": "c4f72619-3a0f-3c5a-ba26-6c07cd1bf8d9",
                                "text": "[Deutschland 2001:] „[…] Die Wahlkampfmanager von CDU und CSU setzen mannschaftliche Geschlossenheit gegen Schröders Kanzlerbonus.“"
                            },
                            {
                                "example_id": "eb5051f1-1152-43a9-b47a-bd204a8e53a2",
                                "sense_id": "c4f72619-3a0f-3c5a-ba26-6c07cd1bf8d9",
                                "text": "[Deutschland 2013:] „Merkels Kanzlerbonus war uneinholbar - und ihre Partei, die CDU, profitierte vom Ansehen ihrer Spitzenkandidatin.“"
                            },
                            {
                                "example_id": "7aeaab54-a692-4723-a282-90612a1af091",
                                "sense_id": "c4f72619-3a0f-3c5a-ba26-6c07cd1bf8d9",
                                "text": "[Deutschland 2013:] „Der Kanzlerbonus von Angela Merkel ist bemerkenswert hoch […].“"
                            },
                            {
                                "example_id": "4be730bf-6333-45d1-8cbf-4afa5d7c6a6b",
                                "sense_id": "c4f72619-3a0f-3c5a-ba26-6c07cd1bf8d9",
                                "text": "[Deutschland 2013:] „Steinbrück […] hat keinen Kanzlerbonus.“"
                            },
                            {
                                "example_id": "a423e4ad-2cc9-4c7e-aa96-4bbe210f37e7",
                                "sense_id": "c4f72619-3a0f-3c5a-ba26-6c07cd1bf8d9",
                                "text": "[Deutschland 2013:] „Reden-Trainer Jörg Abromeit ergänzt: »Merkel war am Anfang erstaunlich aufgeregt und angespannt, spielte aber in der letzten halben Stunde der Sendung ihren Kanzlerbonus gut aus«.“"
                            },
                            {
                                "example_id": "51e05535-26c6-471c-bd58-61ee46e8d10f",
                                "sense_id": "c4f72619-3a0f-3c5a-ba26-6c07cd1bf8d9",
                                "text": "[Österreich 2010:] „Der frühere Wiener Stadtrat und spätere Infrastrukturminister Faymann – Bundeskanzler seit dem 2. Dezember 2008 in der zweiten grossen Koalition mit der Volkspartei (ÖVP) in Folge – vermochte bisher nicht vom «Kanzlerbonus» zu profitieren. In den Meinungsumfragen läuft ihm der ÖVP-Chef und Vizekanzler Josef Pröll regelmässig den Rang ab.“"
                            },
                            {
                                "example_id": "ab159ebc-a0ca-4578-93c4-707ee4947734",
                                "sense_id": "c4f72619-3a0f-3c5a-ba26-6c07cd1bf8d9",
                                "text": "[Deutschland 2005:] „Schröder gebührt das historische Verdienst, das politische Wörterbuch um einen Ausdruck erweitert zu haben. Er hat dafür gesorgt, dass sich neben dem Kanzlerbonus künftig auch der – bislang ziemlich ungebräuchliche – Begriff des Kanzlermalus etablieren dürfte.“"
                            },
                            {
                                "example_id": "d62ee10b-3c69-4b8e-af6a-5f9bcadeab0c",
                                "sense_id": "c4f72619-3a0f-3c5a-ba26-6c07cd1bf8d9",
                                "text": "[Deutschland 2020:] „Es sei kein Nachteil, dass die Union ohne Kanzlerbonus ins Rennen gehe, \"wir aber mit dem Vizekanzlerbonus\", sagte Scholz mit Blick auf die Bundestagswahl in einem Jahr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
