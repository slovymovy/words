                "senses": [
                    {
                        "sense_id": "e35e83bf-2126-3c34-bda0-0cb12f396f0b",
                        "entry_id": "adfc4ca2-280c-361d-8826-5c6d23b1e19d",
                        "glosses": [
                            "Stellung/Ausrichtung eines Beines/der Beine in einer spezifischen Situation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2a0a662-cf05-4fe9-99b2-e91e2341c1d4",
                                "sense_id": "e35e83bf-2126-3c34-bda0-0cb12f396f0b",
                                "text": "„Beim DAA-Tisch kann der Operateur alle wesentlichen Beinpositionen des Patienten selbst einstellen und erhält dabei Feedback über Gewebespannungen.“"
                            },
                            {
                                "example_id": "97047d86-2dfd-43de-b438-8cc16cbccadd",
                                "sense_id": "e35e83bf-2126-3c34-bda0-0cb12f396f0b",
                                "text": "„Je nach Art des Eingriffs und den Körpermaßen von Patient und Operateur ließen sich diese Beinpositionen flexibel an die Operationsbedingungen anpassen.“"
                            },
                            {
                                "example_id": "81ec1a80-e749-49ac-a147-9f67451d2f2a",
                                "sense_id": "e35e83bf-2126-3c34-bda0-0cb12f396f0b",
                                "text": "„Sie verbessert Ihre Haltung, erhöht Ihre Beinposition und ermöglicht die aktive Bewegung am Schreibtisch, was stundenlange Sitzungen im Homeoffice und Büro spürbar erleichtert.“"
                            },
                            {
                                "example_id": "2d05f5bb-8cfa-4f3c-a99b-db261362b7a5",
                                "sense_id": "e35e83bf-2126-3c34-bda0-0cb12f396f0b",
                                "text": "„Fachkundig, präzise und doch einfach verständlich wurde ein Teil des Teams in die Handhabung von Pfeil und Bogen sowie Armhaltung und Beinposition eingeweiht, um dann recht schnell zur Praxis überzugehen.“"
                            },
                            {
                                "example_id": "1aa12677-99c6-4af3-8213-f9a74bad795d",
                                "sense_id": "e35e83bf-2126-3c34-bda0-0cb12f396f0b",
                                "text": "„Sobald Eltern ihr Neugeborenes hochheben, verändert sich reflexartig deren Beinposition.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
