                "senses": [
                    {
                        "sense_id": "4effadc0-8f00-394a-b169-0b99cf0d985b",
                        "entry_id": "12e211bb-5ffe-3e63-bf6d-bcf9ae86dc25",
                        "glosses": [
                            "Tatsache, dass ein Immunsystem durchgemachte Infektionen abspeichert und so besser (auf die nächste vom gleichen oder ähnlichen Typ) vorbereitet ist"
                        ],
                        "tags": [
                            "Infektiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "5461a356-c2ca-4459-8e23-dc7cd1e4ddde",
                                "sense_id": "4effadc0-8f00-394a-b169-0b99cf0d985b",
                                "text": "„Bei späterer, erneuter Auseinandersetzung mit demselben Erreger steht aufgrund des Erstkontaktes ein Immungedächtnis zur Verfügung, das nun für eine wesentlich raschere Erregerabwehr sorgt.“"
                            },
                            {
                                "example_id": "07ca080f-3e3c-46ff-9ea5-a898e0531638",
                                "sense_id": "4effadc0-8f00-394a-b169-0b99cf0d985b",
                                "text": "„Bei einer Masern-Infektion werden Teile des Immungedächtnisses angegriffen. Diese können durch den Virus gelöscht werden - der Organismus wird dadurch anfälliger für andere Erreger.“"
                            },
                            {
                                "example_id": "87df3ca2-f858-4fee-8951-b558340e79bd",
                                "sense_id": "4effadc0-8f00-394a-b169-0b99cf0d985b",
                                "text": "„Spezielle Gedächtniszellen wurden auch nicht gefunden, abgesehen von einer Sorte Lymphozyten, die für das Immungedächtnis des Körpers verantwortlich sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
