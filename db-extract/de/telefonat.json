                        "form": "das Telefonat"
                    },
                    {
                        "form_id": "dda87b13-dfef-49e9-bbb2-6342574ff547",
                        "entry_id": "bfe44044-cdd8-3949-8bc3-caa9059cfb2e",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Telefonate"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3919c4a0-8349-3bec-b43b-483f3cbd9dd8",
                        "entry_id": "bfe44044-cdd8-3949-8bc3-caa9059cfb2e",
                        "glosses": [
                            "Gespräch mittels Telefon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d63a722f-c95b-4f99-ad15-0add237aa447",
                                "sense_id": "3919c4a0-8349-3bec-b43b-483f3cbd9dd8",
                                "text": "„Für die Telefonate habe er Zeugen, außerdem habe er Gesprächsprotokolle angefertigt.“"
                            },
                            {
                                "example_id": "005a52ae-e8dd-43e8-84e6-53962f540aee",
                                "sense_id": "3919c4a0-8349-3bec-b43b-483f3cbd9dd8",
                                "text": "„Das Telefonat dauerte fast eine Stunde.“"
                            },
                            {
                                "example_id": "a27eb6d2-528c-4ac1-9802-aacdc990cf11",
                                "sense_id": "3919c4a0-8349-3bec-b43b-483f3cbd9dd8",
                                "text": "„Sowie diese Dame ihr Telefonat beendet hatte, drehte sie den Stuhl wieder gegen mich, und erneut traf mich ihr verschleiert-bohrender Blick.“"
                            },
                            {
                                "example_id": "1dfc11a0-e55d-4ef0-bd80-eb7dcba5df7c",
                                "sense_id": "3919c4a0-8349-3bec-b43b-483f3cbd9dd8",
                                "text": "„Und beide erhöhten mit jedem Telefonat ihr Angebot.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
