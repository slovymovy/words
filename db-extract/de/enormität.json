                    {
                        "sense_id": "8c35d56e-19dd-39ea-849c-bc6615dd5bde",
                        "entry_id": "467cfda2-9b72-3a38-aff4-c5deccbe365b",
                        "glosses": [
                            "Eigenschaft/Zustand, der in deutlichem Maße eine riesig große, (enorme) Ausprägung zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e6295c6-1bc7-45a5-acbc-2d7ee02498ab",
                                "sense_id": "8c35d56e-19dd-39ea-849c-bc6615dd5bde",
                                "text": "„Der Enormität seiner Bedürfnisse entspricht nur die Enormität seines Verlangens und seines Angebots, aber wie immer bei dem Thema Enormität ist auch Übertreibung im Spiel.“"
                            },
                            {
                                "example_id": "115bb215-391b-4417-81cf-0d4ecb4911f3",
                                "sense_id": "8c35d56e-19dd-39ea-849c-bc6615dd5bde",
                                "text": "„Sensationen, Enormitäten, Possen und derb-groteske Szenen, das oberflächlich Effektvolle, Primitivistische, tragen zu diesem Ziel bei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
