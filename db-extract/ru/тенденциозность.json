                                                "example_id": "8ffec88a-d11e-424d-a6ed-ae16d4e72016",
                                                "sense_id": "4b14093f-cabd-372d-b3db-31384997a2bf",
                                                "text": "Sweet, sensitive, and impossibly sassy, V is many fans' bias, and an integral member of the group."
                                            },
