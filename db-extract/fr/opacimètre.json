                        "glosses": [
                            "Appareil de mesure de l’opacité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43088c42-db64-4f8a-93e4-c3ce8e4f3c34",
                                "sense_id": "a62a9d3c-275e-3ec2-8718-e4bff5e3e9a0",
                                "text": "Le microphotomètre peut être préférable à l’opacimètre intégrateur pour l’étude de plages extrêmement petites."
                            },
                            {
                                "example_id": "e4dc6632-5a70-4f44-a2d0-a16380372f79",
                                "sense_id": "a62a9d3c-275e-3ec2-8718-e4bff5e3e9a0",
                                "text": "Il existe deux types d’appareils, communément appelés « opacimètres », mettant à profit l’interaction entre un faisceau lumineux et les particules en suspension dans le gaz."
                            },
                            {
                                "example_id": "2ffaeeb3-87d8-41dd-9e20-8cc63f253755",
                                "sense_id": "a62a9d3c-275e-3ec2-8718-e4bff5e3e9a0",
                                "text": "Le moteur diesel fait l’objet d’une réglementation qui limite l’opacité des gaz d’échappement. Le contrôle s’effectue grâce à un opacimètre."
                            }
                        ]
                    }
