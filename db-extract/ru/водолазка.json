                    {
                        "form_id": "c8e400ec-565a-4362-80a4-c818b07ef4ef",
                        "entry_id": "4a847004-8012-3c86-a79f-a169777fdf25",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "водола́зках"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "16cfe28d-0a60-3f50-8b9a-cfd71b751307",
                        "entry_id": "4a847004-8012-3c86-a79f-a169777fdf25",
                        "glosses": [
                            "разг. свитер с длинным закатывающимся воротником"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a7c0c0f-fc33-46ef-9a14-dac8623a310c",
                                "sense_id": "16cfe28d-0a60-3f50-8b9a-cfd71b751307",
                                "text": "Что-то недосягаемое, непреодолимо-манящее содержалось в самой форме электрогитары, в битловских водолазках, в их причёсках."
                            },
                            {
                                "example_id": "ddf51cad-990c-4f6e-a8c2-016d5ce6180c",
                                "sense_id": "16cfe28d-0a60-3f50-8b9a-cfd71b751307",
                                "text": "Он был в толстом свитере с широким вырезом, в модной черной водолазке, плотно обнимавшей его шею."
                            }
                        ]
                    },
                    {
                        "sense_id": "13af8ae9-b60c-3e25-a19c-bb5c8f4dd9d2",
                        "entry_id": "4a847004-8012-3c86-a79f-a169777fdf25",
                        "glosses": [
                            "одуш. разг. редк. женск. к водолаз"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53f64f26-adf7-4d8b-adf6-ceccafad27b7",
                                "sense_id": "13af8ae9-b60c-3e25-a19c-bb5c8f4dd9d2",
                                "text": "И его дочери тоже были водолазки, тоже промышляли всю жизнь в море."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9bdf7f01-8738-4a5f-b82f-79b254a3819a",
                        "source_entry_id": "4a847004-8012-3c86-a79f-a169777fdf25",
                        "source_sense_description": "свитер",
                        "target_lang_word": "Rollkragenpullover",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rollkragenpullover",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fcb940c7-f203-37a9-a850-0febc896ee8f",
                                        "entry_id": "05e2c65c-4917-39ae-a70f-e7c0c2907928",
                                        "glosses": [
                                            "Pullover mit Rollkragen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcb99692-297b-4c44-951e-b2c0cde9592d",
                                                "sense_id": "fcb940c7-f203-37a9-a850-0febc896ee8f",
                                                "text": "„Jobs war kein Designer, kein Computertechniker, kein Informatiker, nicht einmal ein Showman – obwohl seine Auftritte im schwarzen Rollkragenpullover, das neueste Apple-Produkt in der Hand, legendär sind.“"
                                            },
                                            {
                                                "example_id": "d9a9ba35-779d-495c-8a79-ea778f9b4ea4",
                                                "sense_id": "fcb940c7-f203-37a9-a850-0febc896ee8f",
                                                "text": "„Sie trägt einen Rollkragenpullover, einen schwarzen Rock und einen fest zusammengezogenen Gürtel, der ihren Körper in zwei erotische Zonen teilt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
