                            {
                                "example_id": "164c757e-2892-45a1-92b2-5f6c85731055",
                                "sense_id": "a37c0c94-bdb4-3286-83ad-adf28367727b",
                                "text": "„Denn noch größere Schiffstypen kommen auf, die sehr viel tiefer im Wasser liegen als die Boote der Wikinger.“"
                            },
                            {
                                "example_id": "2409954a-5a29-43b2-8d6e-28845aa2a205",
                                "sense_id": "a37c0c94-bdb4-3286-83ad-adf28367727b",
                                "text": "„Ich hielt mich bei jeder Gelegenheit auf den Kais auf, studierte die verschiedenen Schiffstypen und versuchte, ihre Takelage zu verstehen.“"
                            }
