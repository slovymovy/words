                    {
                        "translation_id": "9b3c6645-bccd-4f40-91aa-22147aa149b0",
                        "source_entry_id": "c4b5cb68-7cb5-3f23-847a-ba897e260e58",
                        "source_sense_id": "9cda5092-e63e-3d61-9b8c-ce586f6987d8",
