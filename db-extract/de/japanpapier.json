                "senses": [
                    {
                        "sense_id": "315bec08-a68e-3b03-823d-529a476e4608",
                        "entry_id": "d9cd382f-2117-3521-9b79-b40ebcfb659d",
                        "glosses": [
                            "handgeschöpftes, aus Japan stammendes Papier, das weich, seidig und biegsam, aber gleichzeitig fest ist, da bei der Herstellung lange Fasern von Pflanzen aus der Familie der Seidelbastgewächse oder der Maulbeergewächse verwendet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34cabfb7-9a19-453e-9586-d914fbbb7b9a",
                                "sense_id": "315bec08-a68e-3b03-823d-529a476e4608",
                                "text": "Siegfried bastelt in seiner Freizeit Karten für verschiedenste Anlässe. Dabei arbeitet er gern mit Japanpapier und Moosgummi."
                            },
                            {
                                "example_id": "254be152-8cfa-4832-9f6c-c3b1b13f9843",
                                "sense_id": "315bec08-a68e-3b03-823d-529a476e4608",
                                "text": "„Mittels Heliogravure und Platinotypie auf Japanpapier oder farbigem Gummi- und Bromöldruck veredelten und abstrahierten sie die Bildwirkung.“"
                            },
                            {
                                "example_id": "96be8f2c-8c84-4e7d-8234-3ae705d1a1d9",
                                "sense_id": "315bec08-a68e-3b03-823d-529a476e4608",
                                "text": "„Ringsum hängen an den Bücherborden in Herrn Reimers’ Wohnung Streifen aus Japanpapier, auf die mit schwarzer Tusche dekorative japanische Schriftzeichen gemalt sind.“"
                            },
                            {
                                "example_id": "f4aaed8c-d27b-4219-857f-2e168870ef03",
                                "sense_id": "315bec08-a68e-3b03-823d-529a476e4608",
                                "text": "„Einen wichtigen Platz werden dabei die Aquarelle einzunehmen haben, deren Technik er auf eine so in Deutschland nie bisher erlebte Höhe geführt hat, mit berauschenden Farben auf leicht aufsaugendes Japanpapier rasch hingetuscht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
