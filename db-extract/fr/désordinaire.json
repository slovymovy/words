                "senses": [
                    {
                        "sense_id": "c1796384-ce97-3915-ac83-cfc9aff80a5f",
                        "entry_id": "4d653717-6277-3409-86e2-a93fc582c374",
                        "glosses": [
                            "Qui n’est pas habituel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e9167ec-8ab2-4f14-81e9-4210226e2dd8",
                                "sense_id": "c1796384-ce97-3915-ac83-cfc9aff80a5f",
                                "text": "Pour la tourbe lecturière c'est du volapuk, mais pour l'aristocratie littéraire c'est un élixir désordinaire bon pour démorboser par ces temps de banalité spleenatique."
                            },
                            {
                                "example_id": "2f756bd1-3169-4f6d-93dc-fcb9e0bd2064",
                                "sense_id": "c1796384-ce97-3915-ac83-cfc9aff80a5f",
                                "text": "— Nous manger. Ben v'là donc !\n — C'est pas désordinaire, vous l'savez bien.\n — Vous m'en direz des belles!"
                            },
                            {
                                "example_id": "d57d9c57-3423-4f3a-bb65-88f6a3d3a84e",
                                "sense_id": "c1796384-ce97-3915-ac83-cfc9aff80a5f",
                                "text": "Prendre pied dans un état de conscience par lequel l'expérience d'une réalité que certains avec moi qualifient de « désordinaire » n'est pas seulement possible mais devient une seconde nature."
                            },
                            {
                                "example_id": "2317717b-a024-45cb-a271-66847de914d0",
                                "sense_id": "c1796384-ce97-3915-ac83-cfc9aff80a5f",
                                "text": "C'est une journée tout à fait « désordinaire », sourit l'ancienne institutrice."
                            }
                        ]
                    }
                ],
