                "senses": [
                    {
                        "sense_id": "61870454-1f29-332b-bff4-58a54420c421",
                        "entry_id": "7385b8a4-7e48-30ee-8620-deac44b9b451",
                        "glosses": [
                            "stuk metaal of hout waarmee men letters op papier kan afdrukken"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "91278139-4292-4923-b5eb-7cf94632ec54",
                                "sense_id": "61870454-1f29-332b-bff4-58a54420c421",
                                "text": "Zuinige drukletters als gatenkaas Ecofont ontving gisteren de prijs voor de meest innovatieve ondernemer. Het bedrijf maakt letters met onzichtbare gaatjes. En dat scheelt veel inkt."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc5b45cd-f294-3ddc-b94d-265b2a6f8932",
                        "entry_id": "7385b8a4-7e48-30ee-8620-deac44b9b451",
                        "glosses": [
                            "een letter los geschreven en dus niet in verbonden schrift"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "379b6142-58a1-40bb-8928-7807ec5e55b8",
                                "sense_id": "bc5b45cd-f294-3ddc-b94d-265b2a6f8932",
                                "text": "De titel van het werk is ‘L.H.O.O.Q.’, een homofoon van het Engelse woord ‘look’. Als de drukletters in het Frans hardop worden gespeld, klinken ze als: ‘Elle a chaud au cul’. Het werk maakte deel uit van de verzameling dadaïstische en surrealistische werken van de Amerikaan Arthur Brandt."
                            },
                            {
                                "example_id": "086e7d93-6a3c-4808-83eb-c7f266cd387e",
                                "sense_id": "bc5b45cd-f294-3ddc-b94d-265b2a6f8932",
                                "text": "Een tussenvorm is de als kalligrafie vermomde drukletter, die het authentieke'van het handschrift combineert met het gemak van de kant-en-klare letter. Om de suggestie zo sterk mogelijk te maken, leveren de ontwerpers de letters compleet met los toe te voegen swashes (op- en neerhalen) en klinkervarianten, zodat de ene e of a niet precies op de andere lijkt."
                            }
                        ]
                    }
                ],
