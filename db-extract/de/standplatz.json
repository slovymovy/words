                "senses": [
                    {
                        "sense_id": "9821017d-ed1b-3b2e-b958-208d381d1a60",
                        "entry_id": "de853d4b-6035-399f-81d7-fa102d769512",
                        "glosses": [
                            "Ort, Stelle, an der jemand oder etwas abgestellt ist oder verweilt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bee04a2b-d874-43a3-b537-5365fb4c3a1d",
                                "sense_id": "9821017d-ed1b-3b2e-b958-208d381d1a60",
                                "text": "Dies ist ein Standplatz nur für Taxis."
                            },
                            {
                                "example_id": "f1de0901-7412-4e3f-b059-871514393a82",
                                "sense_id": "9821017d-ed1b-3b2e-b958-208d381d1a60",
                                "text": "In dieser Straße haben die Huren ihre Standplätze."
                            },
                            {
                                "example_id": "85e4e684-2976-4cd0-a3f1-761b29878d17",
                                "sense_id": "9821017d-ed1b-3b2e-b958-208d381d1a60",
                                "text": "„Mit schmerzenden Füßen trafen Mimi und Thomas nach Stunden wieder am Standplatz ihres Wagens ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4474ca94-be4f-4181-9ac6-e0ccc4077de9",
                        "source_entry_id": "de853d4b-6035-399f-81d7-fa102d769512",
                        "source_sense_id": "9821017d-ed1b-3b2e-b958-208d381d1a60",
                        "source_sense_description": "Ort, Stelle, an der jemand oder etwas abgestellt ist oder verweilt",
                        "target_lang_word": "emplacement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emplacement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee9050cb-be50-3e73-be65-c0fff28c9c15",
                                        "entry_id": "c07f7242-72a2-38d4-bdcf-3ece08f2ca4d",
                                        "glosses": [
                                            "Espace de terrain considéré comme propre à y construire un bâtiment, à y tracer un jardin, à y exercer un commerce ou une industrie, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8920987b-cc2d-4e8c-a349-310780575661",
                                                "sense_id": "ee9050cb-be50-3e73-be65-c0fff28c9c15",
                                                "text": "Le seigneur viscontier qui ne trouvait pas d’endroit convenable pour établir la fourche patibulaire, pouvait même contraindre le propriétaire d’un champ à lui céder l’emplacement dont il avait besoin : c’était une application anticipée de la loi d’expropriation pour cause d’utilité publique."
                                            },
                                            {
                                                "example_id": "5a625b1f-ebc0-43e1-b88c-0db527005804",
                                                "sense_id": "ee9050cb-be50-3e73-be65-c0fff28c9c15",
                                                "text": "En effet, en exécution de ces lettres patentes, l’emplacement pour bâtir le nouveau bourg fut tracé au delà de l’Aude, […]."
                                            },
                                            {
                                                "example_id": "a4f6dcb7-7322-4ebc-9b98-76093baf3e66",
                                                "sense_id": "ee9050cb-be50-3e73-be65-c0fff28c9c15",
                                                "text": "Le génie est représenté dans l’armée marocaine par un petit corps d’ingénieurs (mohendisîn), dont la fonction principale et à peu près unique est de précéder les corps expéditionnaires et de choisir l’emplacement des campements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db44b403-8bc1-392f-ba7c-9fb5c3ea1a0e",
                                        "entry_id": "c07f7242-72a2-38d4-bdcf-3ece08f2ca4d",
                                        "glosses": [
                                            "Lieu où se situe quelque chose ou quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f246e1cf-b5c0-4a47-835c-20503857b153",
                                                "sense_id": "db44b403-8bc1-392f-ba7c-9fb5c3ea1a0e",
                                                "text": "Quelque caillou qu’on lui présentât, il en situait toujours et sans erreur l’emplacement exact : […]."
                                            },
                                            {
                                                "example_id": "f77cddcf-70a3-4a13-9909-fedcd1268b98",
                                                "sense_id": "db44b403-8bc1-392f-ba7c-9fb5c3ea1a0e",
                                                "text": "Le tube digestif présente à l’emplacement du pharynx un aplatissement de sa lumière interne dans le sens dorso-ventral."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29ff1a62-935a-35aa-8aad-c6136fb66f85",
                                        "entry_id": "c07f7242-72a2-38d4-bdcf-3ece08f2ca4d",
                                        "glosses": [
                                            "Lieu où se situait quelque chose qui a disparu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3e38c0f-a75a-4704-8cdf-61e7826326e8",
                                                "sense_id": "29ff1a62-935a-35aa-8aad-c6136fb66f85",
                                                "text": "Il est vrai, aussi, qu’un discret marquage au sol indique, sur la place de la Bastille, l’emplacement des fondations de la prison."
                                            },
                                            {
                                                "example_id": "d8b9c784-15e4-4abd-ad93-80600fee7475",
                                                "sense_id": "29ff1a62-935a-35aa-8aad-c6136fb66f85",
                                                "text": "Ils me donnent rendez-vous dans un lieu hautement symbolique de la ville de Lagos : le Freedom Park, construit sur l’emplacement d’une ancienne prison coloniale où les Britanniques torturaient et exécutaient les opposants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
