                "senses": [
                    {
                        "sense_id": "04ce2065-1e5d-347e-87bc-2ad9cb133289",
                        "entry_id": "db2eef86-1cb7-3903-98be-acba1b434e89",
                        "glosses": [
                            "feine Risse auf Gemälden, die entstehen, wenn das Gemälde Temperaturschwankungen ausgesetzt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afabbfe5-3900-4cf0-b79b-5b32e0eb6a10",
                                "sense_id": "04ce2065-1e5d-347e-87bc-2ad9cb133289",
                                "text": "„Tatsächlich hatten sie bereits am Siegel des Louvre auf der Rückseite sowie an der Krakelüre, dem Muster der Risse im Firnis, erkannt, dass es sich um La Gioconda handeln musste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b1dc24cd-7013-42b5-a376-b4b00e72f6fa",
                        "source_entry_id": "db2eef86-1cb7-3903-98be-acba1b434e89",
                        "source_sense_id": "04ce2065-1e5d-347e-87bc-2ad9cb133289",
                        "source_sense_description": "feine Risse auf Gemälden, die entstehen, wenn das Gemälde Temperaturschwankungen ausgesetzt ist",
                        "target_lang_word": "craquelure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "craquelure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4583d90-e5c2-3171-8f18-708859afbd74",
                                        "entry_id": "6a955e79-dd4b-3bd2-acef-d40bc2f59a76",
                                        "glosses": [
                                            "The distinctive pattern of hairline cracks in the surface of an old painting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cbe1887-fd87-4138-9105-1284255e7754",
                                                "sense_id": "c4583d90-e5c2-3171-8f18-708859afbd74",
                                                "text": "Documentary evidence is what he prefers; but, failing that, he will put up with a cunning concoction of dates and watermarks, cabalistic signatures, craquelure, patina, chemical properties of paint and medium, paper and canvas, all sorts of collateral evidence, historical and biographical, and racy tricks of brush or pen."
                                            },
                                            {
                                                "example_id": "eb0da575-41ff-42ed-a659-5a31ef156268",
                                                "sense_id": "c4583d90-e5c2-3171-8f18-708859afbd74",
                                                "text": "Alan squinted. It was the robot, the one he’d given her, the pretty thing with the Dutch Master craquelure up its tuna-can skirts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
