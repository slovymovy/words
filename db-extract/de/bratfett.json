                "senses": [
                    {
                        "sense_id": "71da8a23-4e9e-3c2f-b9cf-6cdf0bdc6159",
                        "entry_id": "a05c04cc-de44-34c9-8472-6e0bedb0d99b",
                        "glosses": [
                            "Fett, das zum Braten verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a91e2a7-73c9-4891-bfbd-904e1361fe8a",
                                "sense_id": "71da8a23-4e9e-3c2f-b9cf-6cdf0bdc6159",
                                "text": "„Einer der Schlüssel passte. Er drehte ihn leise herum, zog die Waffe, öffnete die Tür und betrat den Flur, in dem es nach Essen duftete, nach Zwiebeln und Bratfett.“"
                            },
                            {
                                "example_id": "65a724e6-b6a7-40d7-825f-2b73983eba8c",
                                "sense_id": "71da8a23-4e9e-3c2f-b9cf-6cdf0bdc6159",
                                "text": "„Bei Kerzenlicht aßen sie ein üppiges Mahl. Schinken, grüne Bohnen und Kartoffelbrei mit Brötchen und Bratfett.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
