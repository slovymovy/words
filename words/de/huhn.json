                {
                    "sense_id": "70b2b59c-ae9c-3b83-83b3-650303cb3a44",
                    "sense_definition": "Weit verbreitetes Haus- und Nutztier aus der Ordnung der Hühnervögel, das wegen seiner Eier und seines Fleisches gezüchtet wird",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "tier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Auf dem Bauernhof laufen viele <w>Hühner</w> frei im Garten herum."
                        },
                        {
                            "text": "Mein Großvater steht jeden Morgen früh auf, um die <w>Hühner</w> zu füttern."
                        }
                    ],
                    "synonyms": [
                        "Haushuhn"
                    ],
                    "common_phrases": [
                        "Hühner halten",
                        "Hühner füttern"
                    ]
                },
                {
                    "sense_id": "348bb27a-c29e-3a17-b669-57dde658830f",
                    "sense_definition": "Fleisch des Haushuhns, das als Nahrungsmittel zubereitet und verzehrt wird",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fleisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zum Abendessen kocht meine Mutter heute leckeres <w>Huhn</w> mit Reis und frischem Gemüse."
                        },
                        {
                            "text": "Im Restaurant bestellen viele Gäste am liebsten knusprig gebratenes <w>Huhn</w>."
                        }
                    ],
                    "common_phrases": [
                        "Huhn mit Reis",
                        "gebratenes Huhn"
                    ],
                    "synonyms": [
                        "Hähnchen"
                    ]
                },
                {
                    "sense_id": "eddf6718-7ad8-3172-8378-de903499fec6",
                    "sense_definition": "Weibliches Exemplar des Haushuhns",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "tier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Unser weißes <w>Huhn</w> hat heute früh schon wieder zwei frische Eier ins Nest gelegt."
                        },
                        {
                            "text": "Auf der Wiese sucht das fleißige <w>Huhn</w> den ganzen Tag nach Körnern und Würmern."
                        }
                    ],
                    "synonyms": [
                        "Henne"
                    ],
                    "antonyms": [
                        "Hahn"
                    ],
                    "common_phrases": [
                        "Hahn und Huhn"
                    ]
                },
                {
                    "sense_id": "250ef2af-948c-35db-a4eb-164ae4941f97",
                    "sense_definition": "Kurzbezeichnung für einen Vogel aus der Familie der Fasanenartigen oder der Ordnung der Hühnervögel",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "tier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Wanderer beobachteten aufmerksam mehrere wilde <w>Hühner</w> am dichten Waldrand."
                        },
                        {
                            "text": "Plötzlich flogen drei scheue <w>Hühner</w> laut flatternd über das offene Feld davon."
                        }
                    ],
                    "synonyms": [
