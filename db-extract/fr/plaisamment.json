                                        "glosses": [
                                            "humorystycznie, nie na serio, z przymrużeniem oka"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1df1bcdf-d95b-4714-ae0b-2ee92eb81112",
                                                "sense_id": "f66457ff-683a-3f4a-9c1a-c4795a9afd3e",
                                                "text": "O przygodach i flirtach opowiadał przecież żartobliwie, z ironią, kpiną, cynizmem, przechwalając się przed siostrą i ojcem swymi podbojami"
