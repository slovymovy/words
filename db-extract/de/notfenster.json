                "senses": [
                    {
                        "sense_id": "fdccea29-ab5e-3f65-b1db-e81c5e0b01be",
                        "entry_id": "bec46b87-ba93-3658-b6cd-991a8debc116",
                        "glosses": [
                            "Fenster, welches in der Not zu einem Ausstieg umfunktioniert werden kann."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02412da8-b0cd-4f23-a4f7-1b6cb24aa300",
                                "sense_id": "fdccea29-ab5e-3f65-b1db-e81c5e0b01be",
                                "text": "Das Notfenster wurde auf Funktionstüchtigkeit überprüft."
                            },
                            {
                                "example_id": "29587853-f400-485d-bdb6-e9197767ccee",
                                "sense_id": "fdccea29-ab5e-3f65-b1db-e81c5e0b01be",
                                "text": "„Sollte die Grippe ungeahnte Auswüchse annehmen, würden Apotheken geschlossen und die Kunden nur noch durch das Notfenster bedient.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "aaa8a6b3-bc27-3a4e-a97c-301e33a17cd1",
                        "entry_id": "bec46b87-ba93-3658-b6cd-991a8debc116",
                        "glosses": [
                            "improvisiertes Fenster, das z. B. bei einer Reparatur angebracht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69ca4ee2-349e-413a-b4b9-cb6518e3844c",
                                "sense_id": "aaa8a6b3-bc27-3a4e-a97c-301e33a17cd1",
                                "text": "Das Notfenster wurde während der Sanierung hinzugefügt, dass auch währenddessen die Wohnungen bewohnbar bleiben."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
