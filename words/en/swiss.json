    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b9c97904-3c31-350c-a722-b8332e968f91",
                    "sense_definition": "Of, from, or pertaining to Switzerland or the Swiss people.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We bought some delicious <w>Swiss</w> chocolate at the airport shop.",
                            "target_lang_translations": {
                                "ru": "Мы купили вкусный <w>швейцарский</w> шоколад в магазине в аэропорту.",
                                "zh": "我们在机场商店买了一些美味的<w>瑞士</w>巧克力。"
                            }
                        },
                        {
                            "text": "He always carries a <w>Swiss</w> Army knife in his pocket.",
                            "target_lang_translations": {
                                "ru": "Он всегда носит в кармане <w>швейцарский</w> армейский нож.",
                                "zh": "他口袋里总是带着一把<w>瑞士</w>军刀。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Swiss cheese",
                        "Swiss chocolate",
                        "Swiss Army knife",
                        "Swiss watch",
                        "Swiss roll"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к Швейцарии или швейцарцам.",
                        "zh": "与瑞士或瑞士人有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "швейцарский",
                                "target_lang_sense_clarification": "прилагательное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "瑞士的",
                                "target_lang_sense_clarification": "形容词"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cbbcd43f-4c90-3ebd-b1f4-a7f82bc55cf8",
                    "sense_definition": "A person from Switzerland or of Swiss descent.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Swiss</w> are famous for their neutrality and banking system.",
                            "target_lang_translations": {
                                "ru": "<w>Швейцарцы</w> известны своим нейтралитетом и банковской системой.",
                                "zh": "<w>瑞士人</w>以其中立和银行体系而闻名。"
                            }
                        },
                        {
                            "text": "She married a <w>Swiss</w> and moved to Zurich last year.",
                            "target_lang_translations": {
                                "ru": "Она вышла замуж за <w>швейцарца</w> и переехала в Цюрих в прошлом году.",
                                "zh": "她去年嫁给了一位<w>瑞士人</w>并搬到了苏黎世。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Житель Швейцарии или человек швейцарского происхождения.",
                        "zh": "瑞士人或有瑞士血统的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "швейцарец",
                                "target_lang_sense_clarification": "мужской род"
                            },
                            {
                                "target_lang_word": "швейцарка",
                                "target_lang_sense_clarification": "женский род"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "瑞士人",
                                "target_lang_sense_clarification": "名词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dcea87f9-42b0-3835-9432-7004ea8a1fac",
                    "sense_definition": "A type of pale yellow cheese with holes, originally from Switzerland.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I would like a sandwich with roast beef and <w>Swiss</w>.",
                            "target_lang_translations": {
                                "ru": "Я бы хотел сэндвич с ростбифом и <w>швейцарским сыром</w>.",
                                "zh": "我想要一个烤牛肉配<w>瑞士奶酪</w>的三明治。"
                            }
                        },
                        {
                            "text": "This recipe calls for a slice of melted <w>Swiss</w> on top.",
                            "target_lang_translations": {
                                "ru": "В этом рецепте требуется ломтик расплавленного <w>швейцарского сыра</w> сверху.",
                                "zh": "这个食谱需要在上面放一片融化的<w>瑞士奶酪</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сорт бледно-желтого сыра с дырками, родом из Швейцарии.",
                        "zh": "一种原产于瑞士的带孔淡黄色奶酪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "швейцарский сыр",
                                "target_lang_sense_clarification": "продукт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "瑞士奶酪",
                                "target_lang_sense_clarification": "名词"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "9b2cf7ed-afaf-365c-9ea8-31dfc87b5d51",
                    "sense_definition": "Swiss German; the variety of German spoken in Switzerland.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "It can be difficult to understand <w>Swiss</w> if you only know standard German.",
                            "target_lang_translations": {
                                "ru": "Трудно понять <w>швейцарский диалект</w>, если знаешь только литературный немецкий.",
                                "zh": "如果你只懂标准德语，理解<w>瑞士德语</w>可能会有困难。"
                            }
                        },
                        {
                            "text": "They spoke <w>Swiss</w> at home when he was a child.",
                            "target_lang_translations": {
                                "ru": "В детстве они дома говорили на <w>швейцарском диалекте</w>.",
                                "zh": "他小时候在家里说的是<w>瑞士德语</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Швейцарский диалект немецкого языка.",
                        "zh": "瑞士德语，即在瑞士使用的德语变体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "швейцарский диалект",
                                "target_lang_sense_clarification": "язык"
                            },
                            {
                                "target_lang_word": "швейцарский немецкий",
                                "target_lang_sense_clarification": "язык"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "瑞士德语",
                                "target_lang_sense_clarification": "语言名称"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "398321a4-75b9-3f8a-8727-64aab33d84e9",
                    "sense_definition": "To prepare meat or fabric by rolling or pounding in order to soften it.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manufacturer <w>swisses</w> the material to give it a smooth finish.",
                            "target_lang_translations": {
                                "ru": "Производитель <w>каландрирует</w> материал, чтобы придать ему гладкость.",
                                "zh": "制造商对材料进行<w>压光</w>处理，使其表面光滑。"
                            }
                        },
                        {
                            "text": "You need to <w>swiss</w> the fabric before using it for the dress.",
                            "target_lang_translations": {
                                "ru": "Вам нужно <w>размягчить</w> ткань перед тем, как использовать её для платья.",
                                "zh": "在用这块布料做裙子之前，你需要先将其<w>软化</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подготавливать ткань или мясо путем прокатки или отбивания для размягчения.",
                        "zh": "通过滚压或捶打来软化肉类或织物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каландрировать",
                                "target_lang_sense_clarification": "текстиль"
                            },
                            {
                                "target_lang_word": "размягчать",
                                "target_lang_sense_clarification": "ткань или материал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "压光",
                                "target_lang_sense_clarification": "纺织工艺"
                            },
                            {
                                "target_lang_word": "软化",
                                "target_lang_sense_clarification": "处理材料"
                            }
                        ]
                    }
                }
            ]
        }
    ]
