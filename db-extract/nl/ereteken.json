                                        "glosses": [
                                            "Something characteristic; a mark; a token."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be3e2218-1e3f-470a-a968-0db5f9fc19fe",
                                                "sense_id": "26d15d1e-02db-37d5-ae2c-8072d35476e1",
                                                "text": "Sweet mercy is nobility’s true badge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9709d6cd-2202-322c-97d7-f10a8a7a6d99",
                                        "entry_id": "d4e29d1d-515b-3c18-830e-c4b8a81b996f",
                                        "glosses": [
                                            "A brand on the hand of a thief, etc."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e48bb7d9-070b-45ac-bebc-e6302cc5c18c",
                                                "sense_id": "9709d6cd-2202-322c-97d7-f10a8a7a6d99",
                                                "text": "He has got his badge, and piked.",
                                                "translation": "He was branded on the hand, and is at liberty.",
                                                "english": "He was branded on the hand, and is at liberty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f134a56-25fb-3273-8390-ae42b02d460f",
                                        "entry_id": "d4e29d1d-515b-3c18-830e-c4b8a81b996f",
                                        "glosses": [
                                            "A carved ornament on the stern of a vessel, containing a window or the representation of one."
                                        ],
                                        "tags": [],
