                        {
                            "text": "Zij viel hard op haar <w>stuit</w> tijdens het schaatsen.",
                            "target_lang_translations": {
                                "en": "She fell hard on her <w>tailbone</w> while ice skating."
                            }
                        },
                        {
                            "text": "De arts onderzocht de pijn in haar <w>stuit</w> na de val.",
                            "target_lang_translations": {
