                "senses": [
                    {
                        "sense_id": "bf63075b-5b06-3c80-9fc5-f9c947caf7c3",
                        "entry_id": "bf29f36c-ec6f-32a1-82a0-e06741429ed9",
                        "glosses": [
                            "Menge an abfließendem/abgeleitetem Wasser (Abwasser), die an einem bestimmten Ort in einem bestimmten Zeitraum anfällt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aca39cd6-aa4e-4fce-b293-af848516f870",
                                "sense_id": "bf63075b-5b06-3c80-9fc5-f9c947caf7c3",
                                "text": "„Das bedeutet für einen Zwei-Personen-Haushalt bei einem Abwasseranfall von rund 35 Kubikmetern pro Jahr (nachweislich) einen Preis in Höhe von 4,98 Euro.“"
                            },
                            {
                                "example_id": "cd6607bf-e4b3-49a2-a08f-290455aefa32",
                                "sense_id": "bf63075b-5b06-3c80-9fc5-f9c947caf7c3",
                                "text": "„Auch die Nachfrage beim für die Abwasserplanung zuständigen Ingenieurbüro habe ergeben, dass die Kläranlage Lauter vermutlich noch Kapazitäten für den Abwasseranfall aus Kirchlauter (650 EW) besitze.“"
                            },
                            {
                                "example_id": "f26bc9bf-2666-4d66-89c7-313048c81288",
                                "sense_id": "bf63075b-5b06-3c80-9fc5-f9c947caf7c3",
                                "text": "„Der Abwasseranfall erhöhte sich während des Dauerregens zum Teil auf das Sechsfache der normalen Fracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
