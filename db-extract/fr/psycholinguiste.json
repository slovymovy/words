                "senses": [
                    {
                        "sense_id": "2cf44fda-ca50-3db7-b839-9368087d4af4",
                        "entry_id": "bdfeb350-f0e9-3826-829b-2d6d633949c1",
                        "glosses": [
                            "Spécialiste de la psycholinguistique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12fdc8da-b69e-4358-a65b-9961c173d626",
                                "sense_id": "2cf44fda-ca50-3db7-b839-9368087d4af4",
                                "text": "L’étude du langage dans sa normalité ou ses troubles peut éclairer le linguiste et le psycholinguiste sur les fondements du langage lui-même, et contribuer à mieux comprendre les structures et l’utilisation que nous faisons du langage au quotidien."
                            },
                            {
                                "example_id": "22ca186b-6e1c-4f48-a57c-472afb223938",
                                "sense_id": "2cf44fda-ca50-3db7-b839-9368087d4af4",
                                "text": "Néanmoins, la plupart des psycholinguistes pensent que les données expérimentales sont suffisantes pour montrer que la structure profonde, ou tout au moins une structure équivalente, a une réalité psychologique."
                            }
                        ]
                    }
                ],
