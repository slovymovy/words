                                "target_senses": [
                                    {
                                        "sense_id": "64869f2b-f23f-30e2-93ac-f8903fb0c6bb",
                                        "entry_id": "e1075eda-9c7b-3fd3-b834-3451be12599a",
                                        "glosses": [
                                            "το μέρος φυτού που είναι ριζωμένο στο χώμα"
                                        ],
                                        "tags": [
                                            "βοτανική"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec41be12-9973-4bca-b722-91a04c98775e",
                                                "sense_id": "64869f2b-f23f-30e2-93ac-f8903fb0c6bb",
                                                "text": "Μερικά λαχανικά, όπως το καρότο, είναι ρίζες και όχι καρποί."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30b07f8c-a866-3d26-ba0a-9b52a0a27d12",
                                        "entry_id": "e1075eda-9c7b-3fd3-b834-3451be12599a",
                                        "glosses": [
                                            "η πηγή, η αιτία αρνητικού φαινομένου ή προβλήματος"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9110364e-8bd7-4b35-b3ec-140ff8c88b36",
                                                "sense_id": "30b07f8c-a866-3d26-ba0a-9b52a0a27d12",
                                                "text": "Την ρίζα του προβλήματος την ξέρουμε όλοι."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3683d3f0-cdf0-3345-8e4c-5372eeaf16b2",
                                        "entry_id": "e1075eda-9c7b-3fd3-b834-3451be12599a",
                                        "glosses": [
                                            "η καταγωγή, ως ενωτικό στοιχείο με το παρελθόν",
                                            "σχέσεις, δεσμοί, αισθήματα που δένουν κάποιον σε έναν τόπο"
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24cac4f6-45dc-4987-8645-326262bf4179",
                                                "sense_id": "3683d3f0-cdf0-3345-8e4c-5372eeaf16b2",
                                                "text": "Έβγαλε ρίζες στο εξωτερικό και δεν λέει να γυρίσει εδώ παρά για λίγο."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "154fc071-5348-3e76-b0d2-8976ce9a2c94",
                                        "entry_id": "e1075eda-9c7b-3fd3-b834-3451be12599a",
                                        "glosses": [
                                            "το κατώτερο μέρος",
                                            "οι πρόποδες"
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5d25bfd-4cf3-4a33-b62f-f8504369b785",
                                                "sense_id": "154fc071-5348-3e76-b0d2-8976ce9a2c94",
                                                "text": "Το χωριό βρίσκεται στις ρίζες του βουνού."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea78b7e4-eabe-3d40-86ff-427ebc454999",
                                        "entry_id": "e1075eda-9c7b-3fd3-b834-3451be12599a",
                                        "glosses": [
                                            "το αρχικό και αμετάβλητο μέρος μιας λέξης από το οποίο μπορούν να παράγονται πολλά θέματα"
                                        ],
                                        "tags": [
                                            "γλωσσολογία"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fabe222b-d762-4d3c-8f96-84d11cf34d3b",
                                                "sense_id": "ea78b7e4-eabe-3d40-86ff-427ebc454999",
                                                "text": "Το αρχικό τμήμα γραφ-, που απ' αυτό παράγονται με ποικίλους μορφοφωνολογικούς κανόνες όλες οι λέξεις της ομάδας αυτής, λέγεται ρίζα."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "934c012c-af1b-33a6-9c96-35740d82714b",
                                        "entry_id": "e1075eda-9c7b-3fd3-b834-3451be12599a",
                                        "glosses": [
                                            "αριθμός ο οποίος μηδενίζει την τιμή μιας συνάρτησης"
                                        ],
                                        "tags": [
                                            "μαθηματικά"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75cbe74e-431b-4cb9-b619-e20ad31faa87",
                                                "sense_id": "934c012c-af1b-33a6-9c96-35740d82714b",
                                                "text": "Μια συνάρτηση μπορεί να μην έχει καμία ρίζα."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72c796c5-d077-32dc-91cc-8490eec456ef",
                                        "entry_id": "e1075eda-9c7b-3fd3-b834-3451be12599a",
                                        "glosses": [
                                            "αριθμός ο οποίος μηδενίζει την τιμή της συνάρτησης χ στην νιοστή (χ^ν)"
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a945f92e-ede3-4d4a-a00a-ac6f29ae460f",
                                                "sense_id": "72c796c5-d077-32dc-91cc-8490eec456ef",
                                                "text": "Η τετραγωνική ρίζα του δύο είναι άρρητος αριθμός."
                                            },
                                            {
                                                "example_id": "317039d7-3dc7-4ea8-92b9-2e9e9992d9e4",
                                                "sense_id": "72c796c5-d077-32dc-91cc-8490eec456ef",
                                                "text": "Η τρίτη ρίζα του 9 είναι το 3."
                                            },
                                            {
                                                "example_id": "ebc46195-ac4d-419e-8e37-49dd1a420cbb",
                                                "sense_id": "72c796c5-d077-32dc-91cc-8490eec456ef",
                                                "text": "η τετραγωνική ρίζα του x συμβολίζεται απλά με: √."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39e42c0e-0889-3708-b0b3-2ccb997ddc65",
                                        "entry_id": "e1075eda-9c7b-3fd3-b834-3451be12599a",
                                        "glosses": [
                                            "ομάδα ατόμων που δεν υφίσταται μεταβολή στην διάρκεια μιας χημικής αντίδρασης"
                                        ],
                                        "tags": [
                                            "χημεία"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bb717ea-c87d-482b-9460-4795b6975d2e",
                                                "sense_id": "39e42c0e-0889-3708-b0b3-2ccb997ddc65",
                                                "text": "Η νιτρική ρίζα (NO⁻₃) αποτελείται από ένα άτομο αζώτου και τρία άτομα οξυγόνου και είναι φορτισμένη αρνητικά."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
