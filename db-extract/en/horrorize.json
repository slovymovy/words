                        "examples": [
                            {
                                "example_id": "82ab9122-ea0c-41e3-9f71-8473018f26c6",
                                "sense_id": "1f042dab-fcba-3d97-aeb2-1435fbb4681a",
                                "text": "Ely's method was to enlarge himself by praising up his cousin and to pleasure himself by horrorizing the men with true faithful portrayals of pirates caught and hanged, […]"
                            },
                            {
                                "example_id": "faaf32a5-f15b-44d9-b5de-ad8160c5bdc3",
                                "sense_id": "1f042dab-fcba-3d97-aeb2-1435fbb4681a",
                                "text": "Their ruthless divinities portrayed them as an uncivilized people with extremely low morality by letting these small gods terrorize and horrorize the common people with uncommon sense and vicious brutality."
                            }
                        ]
                    }
