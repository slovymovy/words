                        "examples": [
                            {
                                "example_id": "bbc56dc8-dffb-471d-ac98-db54f4caf0f5",
                                "sense_id": "7bffb017-7ebe-3792-a68e-7b53068a4a23",
                                "text": "Ayant la passion du cheval, elle faisait un voyage d’études aux haras marocains de Temara et de Meknès, à la recherche d’étalons capables de ré-infuser le fameux sang pur arabe à son écurie de course, repliée de Pologne sur Maisons-Laffitte et Alger."
                            },
                            {
                                "example_id": "f7b628ae-a322-4408-b3f0-b4a925ef77ae",
                                "sense_id": "7bffb017-7ebe-3792-a68e-7b53068a4a23",
                                "text": "Une tentative a été d'activer in vitro les lymphocytes du patient lui-même avec de ITL-2, et ensuite de lui ré-infuser."
                            }
                        ]
                    }
