                    }
                ],
                "translations": [
                    {
                        "translation_id": "696fee66-276e-4c27-b2da-4a700a7e33b4",
                        "source_entry_id": "d1a7788d-1fb4-3c50-b78c-3db141657c5e",
                        "source_sense_id": "1c3a9fb3-113f-336c-99f3-842119b7fb9d",
                        "target_lang_word": "factory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "factory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36bd113a-7480-351f-b162-7ca549f6d607",
                                        "entry_id": "3d4ca012-8a39-37cf-aa73-cce1c6d1adb2",
                                        "glosses": [
                                            "A building or other place where manufacturing takes place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "616019f0-bcfb-42c1-ae06-5df75b30f0d8",
                                                "sense_id": "36bd113a-7480-351f-b162-7ca549f6d607",
                                                "text": "History has shown that, even without cheap labor, factories run perfectly well."
                                            },
                                            {
                                                "example_id": "eafc0703-e2b6-4c93-a61e-807b797af524",
                                                "sense_id": "36bd113a-7480-351f-b162-7ca549f6d607",
                                                "text": "[…] St. Bede's at this period of its history was perhaps the poorest and most miserable parish in the East End of London. Close-packed, crushed by the buttressed height of the railway viaduct, rendered airless by huge walls of factories, it at once banished lively interest from a stranger's mind and left only a dull oppression of the spirit."
                                            },
                                            {
                                                "example_id": "8e5e0ef0-9ace-4d5d-987b-e1f7b88cf80b",
                                                "sense_id": "36bd113a-7480-351f-b162-7ca549f6d607",
                                                "text": "The highway to the East Coast which ran through the borough of Ebbfield had always been a main road and even now, despite the vast garages, the pylons and the gaily painted factory glasshouses which had sprung up beside it, there still remained an occasional trace of past cultures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9a74f7e-ab23-38e1-9bf7-2b164e010038",
                                        "entry_id": "3d4ca012-8a39-37cf-aa73-cce1c6d1adb2",
                                        "glosses": [
                                            "A police station."
                                        ],
                                        "tags": [
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7375c13c-b5ab-403a-9661-b16851222327",
                                                "sense_id": "a9a74f7e-ab23-38e1-9bf7-2b164e010038",
                                                "text": "The guys all knew each other and we were having a jolly old chinwag as we marched them out of the house in front of their stunned neighbours and into a van we had called to take them all to the Factory (police station)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8aea6f54-f5d1-3fa4-ae5b-90796e8c74f6",
                                        "entry_id": "3d4ca012-8a39-37cf-aa73-cce1c6d1adb2",
                                        "glosses": [
                                            "A device or process that produces or manufactures something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0e90a9b-d628-458f-bbe5-08509cb10c3e",
                                                "sense_id": "8aea6f54-f5d1-3fa4-ae5b-90796e8c74f6",
                                                "text": "Radio became a star factory for journalists."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdd4420f-6348-3e06-b8e4-2cfdc340fdd7",
                                        "entry_id": "3d4ca012-8a39-37cf-aa73-cce1c6d1adb2",
                                        "glosses": [
                                            "A factory farm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e5902f2-3016-4ddf-947a-e6c586b02ff1",
                                                "sense_id": "cdd4420f-6348-3e06-b8e4-2cfdc340fdd7",
                                                "text": "chicken factory; pig factory"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f59c7591-f617-3ec9-9c0e-da8e57aa9f27",
                                        "entry_id": "3d4ca012-8a39-37cf-aa73-cce1c6d1adb2",
                                        "glosses": [
                                            "In a computer program or library, a function, method, etc. which creates an object."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5085c346-34e2-4b03-8d53-67341b8734ef",
                                                "sense_id": "f59c7591-f617-3ec9-9c0e-da8e57aa9f27",
                                                "text": "The task factory […] is the object that is responsible for creating instances of those tasks dynamically."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "908a5a0c-87e8-3ca0-b23b-eb8a97f9d230",
                                        "entry_id": "3d4ca012-8a39-37cf-aa73-cce1c6d1adb2",
                                        "glosses": [
                                            "The original state of an electronic device, as it was when it came from the manufacturer."
                                        ],
                                        "tags": [
                                            "attributive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6475967-2646-43c5-8908-6af51ead4f18",
                                                "sense_id": "908a5a0c-87e8-3ca0-b23b-eb8a97f9d230",
                                                "text": "factory settings; factory defaults; a factory reset"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e78d5636-5c55-332c-a21e-f4a9df451d3f",
                                        "entry_id": "3d4ca012-8a39-37cf-aa73-cce1c6d1adb2",
                                        "glosses": [
                                            "The position or state of being a factor."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d8b8e61a-98fb-33d1-9b6c-5301a7458617",
                                        "entry_id": "3d4ca012-8a39-37cf-aa73-cce1c6d1adb2",
                                        "glosses": [
                                            "A trading establishment, especially set up by merchants working in a foreign country."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "647c98a6-617c-4612-bee4-313282de349e",
                                                "sense_id": "d8b8e61a-98fb-33d1-9b6c-5301a7458617",
                                                "text": "We had here his curate, Mr. Furley, who had been nine years chaplain to the English factory at St. Petersburg […] ."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "factory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c83b92f5-1621-309d-8299-a715954324ad",
                                        "entry_id": "6c13c3bf-1422-3572-be05-7a7022b7dedc",
                                        "glosses": [
                                            "Having come from the factory in the state it is currently in; original, stock."
                                        ],
                                        "tags": [
                                            "colloquial",
