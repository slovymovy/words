                "senses": [
                    {
                        "sense_id": "df672c08-fcb1-3f00-8b17-642b2365b272",
                        "entry_id": "8734ea7c-7b1a-367b-9501-c810d95284bd",
                        "glosses": [
                            "Dose, die Thunfisch enthält, in der Thunfisch gelagert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0767974c-fe57-4e97-8247-9de34d69a271",
                                "sense_id": "df672c08-fcb1-3f00-8b17-642b2365b272",
                                "text": "„Das scheibenförmige Gebäude war beim Angriff der Drachen und bei der späteren Gasexplosion buchstäblich zerfetzt worden. Es sah aus wie eine Thunfischdose mit aufgezogenem Deckel.“"
                            },
                            {
                                "example_id": "ef9c6b94-69a9-4911-8079-23c689507bf8",
                                "sense_id": "df672c08-fcb1-3f00-8b17-642b2365b272",
                                "text": "„Dann legte Giyoung noch eine Thunfischdose und vier Tütensuppen in den Korb.“"
                            },
                            {
                                "example_id": "535e3d0c-4816-4f0e-9f6a-949641fde854",
                                "sense_id": "df672c08-fcb1-3f00-8b17-642b2365b272",
                                "text": "„Es ist ihm lieber, wenn das Kokain in Blumen, stinkenden Lederballen oder Thunfischdosen versteckt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
