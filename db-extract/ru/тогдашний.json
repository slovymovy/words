                                "example_id": "057f8f47-9bb3-4405-90d1-9ba77f102353",
                                "sense_id": "6c84b282-aeca-3c45-8ba4-efe168150062",
                                "text": "Но благодаря тогдашней цензуре произведения Екатерины Великой не могли увидеть свет и были только напечатаны лет пятнадцать тому назад, когда цензура временно стала немного либеральнее."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b90514f0-1212-47b5-ac51-bd9ef380d708",
                        "source_entry_id": "ef1d2bb8-9f3b-3415-b41d-4c8f5e5cafc3",
                        "source_sense_description": "живший в прежнее время",
                        "target_lang_word": "damalig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "damalig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a2813dfd-32fa-3902-bba6-69c3144c3110",
                                        "entry_id": "623ccf96-1587-3b1a-b17b-c02b3ff9f1c2",
                                        "glosses": [
                                            "zu einem bestimmten Zeitpunkt in der Vergangenheit vorhanden oder stattgefunden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6023dc76-8edb-4675-bbe6-7cf5832fd4dc",
                                                "sense_id": "a2813dfd-32fa-3902-bba6-69c3144c3110",
                                                "text": "Er hat mit seiner damaligen Frau nicht viel unternommen."
                                            },
                                            {
                                                "example_id": "6bb4fa89-96d6-469d-a6dc-c2796faa0875",
                                                "sense_id": "a2813dfd-32fa-3902-bba6-69c3144c3110",
                                                "text": "„Sie projizierten Bilder der damaligen Demonstrationen auf Hauswände, dazu liefen die Geräusche des Aufbruchs vom Band.“"
                                            },
                                            {
                                                "example_id": "f9559047-ba64-4812-abca-7eb1dca6cdcb",
                                                "sense_id": "a2813dfd-32fa-3902-bba6-69c3144c3110",
                                                "text": "„Um die norddeutsche Tiefebene aber machten die schönen Dinge der damaligen Zeit einen großen Bogen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
