                "senses": [
                    {
                        "sense_id": "8b3bcca8-4d80-39cd-9da4-55468a70ad9d",
                        "entry_id": "96a8a744-70dc-346b-8685-4a38421ce0b3",
                        "glosses": [
                            "subjektive Erfahrungen (Eindrücke und Gefühle), die ein Läufer beim Laufen erlebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6a51ffc-f125-41a6-b8ef-4aa2b3f5cefc",
                                "sense_id": "8b3bcca8-4d80-39cd-9da4-55468a70ad9d",
                                "text": "„Die ergonomischen Turnschuhe wurden speziell für Personen entwickelt, die viel zu Fuß unterwegs sind und ein komfortables Lauferlebnis ohne Schmerzen genießen möchten.“"
                            },
                            {
                                "example_id": "96030856-9447-4f96-b432-9114e363db90",
                                "sense_id": "8b3bcca8-4d80-39cd-9da4-55468a70ad9d",
                                "text": "„Der 31. Rostocker Citylauf hat wieder einmal gezeigt, dass er zu den spektakulärsten Lauferlebnissen nicht nur in der Region Rostock zählt.“"
                            },
                            {
                                "example_id": "16bf79a9-c110-47d0-a739-3cb46eadb177",
                                "sense_id": "8b3bcca8-4d80-39cd-9da4-55468a70ad9d",
                                "text": "„Für der Erfolg des großen Lauferlebnisses haben wieder einmal über 200 Helferinnen und Helfer mitgewirkt.“"
                            },
                            {
                                "example_id": "ae0e66f0-6db0-4179-8516-3a99e85e30c0",
                                "sense_id": "8b3bcca8-4d80-39cd-9da4-55468a70ad9d",
                                "text": "„In seinen Vorträgen über Willenskraft, Motivation und Resilienz erzählt er von seinen faszinierenden Lauferlebnissen und wie sich der Transfer ins Unternehmertum oder das tägliche Leben anbietet.“"
                            },
                            {
                                "example_id": "a66121df-9afb-4f58-9eb4-aea18b575486",
                                "sense_id": "8b3bcca8-4d80-39cd-9da4-55468a70ad9d",
                                "text": "„Der Schuh ist vollgepackt mit raffinierten Details, die Ihr Lauferlebnis verbessern, von der bequemen Passform bis hin zu den Hightech-Funktionen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
