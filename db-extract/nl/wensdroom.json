                    },
                    {
                        "translation_id": "3090d029-3e47-4fee-901c-c3dc03415d97",
                        "source_entry_id": "7e8bf486-dc41-3f9f-8f22-de82a0e29fd7",
                        "source_sense_id": "58e165cc-5af9-3af1-b589-0c10b6dc83b0",
                        "target_lang_word": "dream",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dream",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f4805bb-3b56-3738-ad93-79aed52fce9e",
                                        "entry_id": "7ae7e04c-88c7-3273-aa21-addbcf8f3ad7",
                                        "glosses": [
                                            "Imaginary events seen in the mind while sleeping."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4252d7bc-b2d4-4868-9fb7-bf4bf59d2f35",
                                                "sense_id": "5f4805bb-3b56-3738-ad93-79aed52fce9e",
                                                "text": "be in a dream"
                                            },
                                            {
                                                "example_id": "2ef37e33-f8b1-40a1-8ef6-9ecd61cced51",
                                                "sense_id": "5f4805bb-3b56-3738-ad93-79aed52fce9e",
                                                "text": "have a dream"
                                            },
                                            {
                                                "example_id": "fb876f03-d299-4e68-b35e-eed4c30c0dee",
                                                "sense_id": "5f4805bb-3b56-3738-ad93-79aed52fce9e",
                                                "text": "scary dream"
                                            },
                                            {
                                                "example_id": "8719d60c-70e3-4594-8f9c-0d0409b10524",
                                                "sense_id": "5f4805bb-3b56-3738-ad93-79aed52fce9e",
                                                "text": "vivid dream"
                                            },
                                            {
                                                "example_id": "6fce3af7-2efb-40f5-abb2-05dacd33f49f",
                                                "sense_id": "5f4805bb-3b56-3738-ad93-79aed52fce9e",
                                                "text": "erotic dream"
                                            },
                                            {
                                                "example_id": "92b8b47f-57fd-4c4b-a471-e8c8e72338a9",
                                                "sense_id": "5f4805bb-3b56-3738-ad93-79aed52fce9e",
                                                "text": "feel like a dream"
                                            },
                                            {
                                                "example_id": "b2b85d24-ef76-4195-b9e8-ccba12c9c6ce",
                                                "sense_id": "5f4805bb-3b56-3738-ad93-79aed52fce9e",
                                                "text": "Dreams are but interludes which fancy makes."
                                            },
                                            {
                                                "example_id": "a7fdeeaf-9d6b-4d3d-8c96-27b034764af4",
                                                "sense_id": "5f4805bb-3b56-3738-ad93-79aed52fce9e",
                                                "text": "She wakened in sharp panic, bewildered by the grotesquerie of some half-remembered dream in contrast with the harshness of inclement fact, drowsily realizing that since she had fallen asleep it had come on to rain smartly out of a shrouded sky."
                                            },
                                            {
                                                "example_id": "8dd71865-7af2-47e0-ba46-758bd713eff6",
                                                "sense_id": "5f4805bb-3b56-3738-ad93-79aed52fce9e",
                                                "text": "And I find it kind of funny, I find it kind of sad\n The dreams in which I'm dying are the best I've ever had"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b46de425-9518-3d68-918e-0a3056714067",
                                        "entry_id": "7ae7e04c-88c7-3273-aa21-addbcf8f3ad7",
                                        "glosses": [
                                            "A hope or wish."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6933f27c-24fb-4a2e-897f-4d4aed7563c3",
                                                "sense_id": "b46de425-9518-3d68-918e-0a3056714067",
                                                "text": "have a dream"
                                            },
                                            {
                                                "example_id": "abc92bcf-4c10-4c74-bb49-9b08648f7931",
                                                "sense_id": "b46de425-9518-3d68-918e-0a3056714067",
                                                "text": "fulfil a dream"
                                            },
                                            {
                                                "example_id": "71fd2067-b37e-44e7-b6ea-ed684105fdd4",
                                                "sense_id": "b46de425-9518-3d68-918e-0a3056714067",
                                                "text": "harbour a dream"
                                            },
                                            {
                                                "example_id": "36837001-1f87-49fb-a9f9-caa3da9f0c62",
                                                "sense_id": "b46de425-9518-3d68-918e-0a3056714067",
                                                "text": "realize a dream"
                                            },
                                            {
                                                "example_id": "23f06815-133c-43db-a741-81e807605e2b",
                                                "sense_id": "b46de425-9518-3d68-918e-0a3056714067",
                                                "text": "So this was my future home, I thought![…]Backed by towering hills, the but faintly discernible purple line of the French boundary off to the southwest, a sky of palest Gobelin flecked with fat, fleecy little clouds, it in truth looked a dear little city; the city of one's dreams."
                                            },
                                            {
                                                "example_id": "01302fbc-0813-4711-bb80-2ca297f095c5",
                                                "sense_id": "b46de425-9518-3d68-918e-0a3056714067",
                                                "text": "I have a dream that my four little children will one day live in a nation where they will not be judged by the color of their skin, but by the content of their character. I have a dream today!"
                                            },
                                            {
                                                "example_id": "099d55df-9c1b-44c7-b54b-35eda4e2bb16",
                                                "sense_id": "b46de425-9518-3d68-918e-0a3056714067",
                                                "text": "Ralph Wiggum is generally employed as a bottomless fount of glorious non sequiturs, but in “I Love Lisa” he stands in for every oblivious chump who ever deluded himself into thinking that with persistence, determination, and a pure heart he can win the girl of his dreams."
                                            },
                                            {
                                                "example_id": "2ae47924-7077-43bb-902f-309d9a9a0230",
                                                "sense_id": "b46de425-9518-3d68-918e-0a3056714067",
                                                "text": "More likely than capture is death at the hands of Chinese border police. Killings like that of fifteen-year-old Yeshe Dundrub, shot at night in Saga County (Ch: Saga Xian) in November 1999, while fleeing with forty others to Nepal, are covered up when possible. (Dundrub, whose dream was to be a monk, died in a military hospital bed nine hours after he was shot.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe822cb1-bf0e-309f-80a8-29941393da2c",
                                        "entry_id": "7ae7e04c-88c7-3273-aa21-addbcf8f3ad7",
                                        "glosses": [
                                            "A visionary scheme; a wild conceit; an idle fancy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb6fc80e-03da-4b2c-8a06-93581901161c",
                                                "sense_id": "fe822cb1-bf0e-309f-80a8-29941393da2c",
                                                "text": "live in a dream"
                                            },
                                            {
                                                "example_id": "1a1981b4-2f4c-4c4f-a194-97469b0902f4",
                                                "sense_id": "fe822cb1-bf0e-309f-80a8-29941393da2c",
                                                "text": "wake up from a dream"
                                            },
                                            {
                                                "example_id": "d4e84532-b410-4b28-8ed2-02bf4d420f39",
                                                "sense_id": "fe822cb1-bf0e-309f-80a8-29941393da2c",
                                                "text": "impossible dream"
                                            },
                                            {
                                                "example_id": "845352c4-d58d-4948-b9d9-e7b1ca54e0e0",
                                                "sense_id": "fe822cb1-bf0e-309f-80a8-29941393da2c",
                                                "text": "a dream of bliss"
                                            },
                                            {
                                                "example_id": "01834d7c-616c-4b27-8852-c9c2e5c31b40",
                                                "sense_id": "fe822cb1-bf0e-309f-80a8-29941393da2c",
                                                "text": "the dream of his youth"
                                            },
                                            {
                                                "example_id": "68c7123d-95de-4bb1-b903-8cd5f468d143",
                                                "sense_id": "fe822cb1-bf0e-309f-80a8-29941393da2c",
                                                "text": "There sober thought pursued the amusing theme,\n Till Fancy coloured it and formed a dream."
                                            },
                                            {
                                                "example_id": "4a6bb258-88f2-41d1-add6-a514837548c9",
                                                "sense_id": "fe822cb1-bf0e-309f-80a8-29941393da2c",
                                                "text": "It is not, then, a mere dream, but a very real aim which they propose."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dream",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d719e7f2-f8f8-340f-92fa-576a76bd0574",
                                        "entry_id": "2dc654b7-a040-3015-8e28-d3822cea1c72",
                                        "glosses": [
                                            "To see imaginary events in one's mind while sleeping."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfd97139-2340-4632-a7b9-42154d259410",
                                                "sense_id": "d719e7f2-f8f8-340f-92fa-576a76bd0574",
                                                "text": "Last night I dreamed I was leaping over giant cupcakes and chocolate cookies."
                                            },
                                            {
                                                "example_id": "a8c678de-a154-4a69-81bd-cd71c00c0753",
                                                "sense_id": "d719e7f2-f8f8-340f-92fa-576a76bd0574",
                                                "text": "Dreaming when Dawn's Left Hand was in the Sky\nI heard a Voice within the Tavern cry,\n\"Awake, my Little ones, and fill the Cup\nBefore Life's Liquor in its Cup be dry.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f297006-1792-3ad6-b5ec-2f00acf416fa",
                                        "entry_id": "2dc654b7-a040-3015-8e28-d3822cea1c72",
                                        "glosses": [
                                            "To hope, to wish."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d77735e-f458-4303-9471-bc88e64dbe64",
                                                "sense_id": "2f297006-1792-3ad6-b5ec-2f00acf416fa",
                                                "text": "Lucy dreams of becoming a scientist when she'll grow up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c2ebd3b-bdfb-366b-a32e-d3d8926295dc",
                                        "entry_id": "2dc654b7-a040-3015-8e28-d3822cea1c72",
                                        "glosses": [
                                            "To daydream."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51ab8598-515d-4c31-a28b-154f2eef2b7b",
                                                "sense_id": "5c2ebd3b-bdfb-366b-a32e-d3d8926295dc",
                                                "text": "Stop dreaming and get back to work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db357886-8c2f-3f92-96b7-cf4c0d3ca274",
                                        "entry_id": "2dc654b7-a040-3015-8e28-d3822cea1c72",
                                        "glosses": [
                                            "To envision as an imaginary experience (usually when asleep)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d3f9b21-d41e-470f-abd9-e761ee03c28b",
                                                "sense_id": "db357886-8c2f-3f92-96b7-cf4c0d3ca274",
                                                "text": "I dreamed a vivid dream last night."
                                            },
                                            {
                                                "example_id": "1bdca7d2-8bdb-42e0-8b3f-ca2cb60964b6",
                                                "sense_id": "db357886-8c2f-3f92-96b7-cf4c0d3ca274",
                                                "text": "And still they dream that they shall still succeed."
                                            },
                                            {
                                                "example_id": "22f7f99e-e483-47e4-85e8-e3b9f8ce3bea",
                                                "sense_id": "db357886-8c2f-3f92-96b7-cf4c0d3ca274",
                                                "text": "At length in sleep their bodies they compose, / And dreamt the future fight, and early rose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70aceb1b-bfb0-36db-a6ca-4abf825b9ab5",
                                        "entry_id": "2dc654b7-a040-3015-8e28-d3822cea1c72",
                                        "glosses": [
                                            "To consider the possibility (of)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00acf694-e12d-4506-8060-ef5dd7220e25",
                                                "sense_id": "70aceb1b-bfb0-36db-a6ca-4abf825b9ab5",
                                                "text": "I wouldn't dream of snubbing you in public."
                                            },
                                            {
                                                "example_id": "fa147536-61ef-4a35-adef-86049489f15f",
                                                "sense_id": "70aceb1b-bfb0-36db-a6ca-4abf825b9ab5",
                                                "text": "There are more things in heaven and earth, Horatio,\n Than are dreamt of in your philosophy."
                                            },
                                            {
                                                "example_id": "f72f66cf-0343-4a80-9d65-616f5fed2780",
                                                "sense_id": "70aceb1b-bfb0-36db-a6ca-4abf825b9ab5",
                                                "text": "But then I had the [massive] flintlock by me for protection.\n[…]The linen-press and a chest on the top of it formed, however, a very good gun-carriage; and, thus mounted, aim could be taken out of the window[…], and a 'bead' could be drawn upon Molly, the dairymaid, kissing the fogger behind the hedge, little dreaming that the deadly tube was levelled at them."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dream",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dcbd9c9e-bf9d-3420-9224-7965d5ffb773",
                                        "entry_id": "5557ab21-fc29-37b3-9fd4-913364b01d42",
                                        "glosses": [
                                            "Ideal; perfect."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cb0f953-0d81-41dc-9205-768ff96d4e1c",
                                                "sense_id": "dcbd9c9e-bf9d-3420-9224-7965d5ffb773",
                                                "text": "Gonna drive back down where you once belonged / In the back of a dream car, twenty foot long"
                                            },
                                            {
                                                "example_id": "caed39f0-d30f-4756-b47b-4e2b0ba4009c",
                                                "sense_id": "dcbd9c9e-bf9d-3420-9224-7965d5ffb773",
                                                "text": "If a girl who talked like that was not his dream girl, he didn't know a dream girl when he heard one."
                                            },
                                            {
                                                "example_id": "20b2e61f-2d4c-4fa0-a319-eaad99527fea",
                                                "sense_id": "dcbd9c9e-bf9d-3420-9224-7965d5ffb773",
                                                "text": "England found chances a rarity, although Liverpool striker Solanke almost made it a dream debut in the closing seconds, only to miscontrol at the far post."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
