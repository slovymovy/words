                "senses": [
                    {
                        "sense_id": "4c4b70a1-dc3f-316a-9cc1-9f37452027fc",
                        "entry_id": "2f8af35c-d72d-3a79-87a3-b4c5b79807b0",
                        "glosses": [
                            "treurdicht"
