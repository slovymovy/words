                        "cross_references": []
                    },
                    {
                        "translation_id": "2375834c-80a8-4259-9179-5ea586974436",
                        "source_entry_id": "da0d70cc-8797-3dc7-b719-0f3722b7c89c",
                        "source_sense_description": "used to express assent, especially to a superior",
                        "target_lang_word": "есть",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "есть",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f505cc26-78e9-38a0-b844-d96cef85bf06",
                                        "entry_id": "147da7c5-97ae-3c3a-86fe-130062569529",
                                        "glosses": [
                                            "название шестой по порядку буквы в старо- и церковнославянском алфавите"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5baa1eea-e06b-4f50-bb46-7e5d59a838aa",
                                                "sense_id": "f505cc26-78e9-38a0-b844-d96cef85bf06",
                                                "text": "Видишь фигуру? Это — аз. Говори: аз! Буки! Веди! Это — что? — Буки. — Попал! Это? — Веди. — Врёшь, аз! Гляди: глаголь, добро, есть, — это что? — Добро. — Попал! Это? — Глаголь. — Верно! А это? — Аз."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "есть",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d8f9a2db-4153-3d00-9dc8-22bffb8d7505",
                                        "entry_id": "9ae0876c-5853-360a-87e2-fda203a10d7c",
                                        "glosses": [
                                            "воен. подтвердительный ответ на приказ"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e03669f5-4d92-4a74-926f-857e7623321f",
                                                "sense_id": "d8f9a2db-4153-3d00-9dc8-22bffb8d7505",
                                                "text": "— Есть прекратить огонь, товарищ комбат!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "есть",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f17360e5-ccf5-3f6f-aa8b-34437e82dc6c",
                                        "entry_id": "7de5477f-92fd-3456-b90e-096e0a35e9cf",
                                        "glosses": [
                                            "принимать пищу, питаться"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2397fef-6f13-4298-a4d6-dd107fe86666",
                                                "sense_id": "f17360e5-ccf5-3f6f-aa8b-34437e82dc6c",
                                                "text": "В то время как я ем с аппетитом, он проглотил несколько кусочков мяса с картофелем и от всего отказался."
                                            },
                                            {
                                                "example_id": "c208572f-357b-4f5c-a55d-5f5b3c7a8544",
                                                "sense_id": "f17360e5-ccf5-3f6f-aa8b-34437e82dc6c",
                                                "text": "Пища её была разнообразна. Она почти не употребляла мяса, но часто ела яйца, рыбу, мучное, овощи и варёные фрукты."
                                            },
                                            {
                                                "example_id": "842430a8-c5c9-44f2-86c2-408ce76fdaa9",
                                                "sense_id": "f17360e5-ccf5-3f6f-aa8b-34437e82dc6c",
                                                "text": "Бобриков ему говорит: ты только много не ешь, лучше понемножку… Уснул Бобриков, а тот стал есть. Ел, ел, пока не наелся досыта."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "909b9d3e-1061-36c3-be95-a09d6c835227",
                                        "entry_id": "7de5477f-92fd-3456-b90e-096e0a35e9cf",
                                        "glosses": [
                                            "употреблять что-либо в пищу"
                                        ],
                                        "tags": [
                                            "с доп."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e8ed5c7-e5d2-4768-a169-67d712895ab1",
                                                "sense_id": "909b9d3e-1061-36c3-be95-a09d6c835227",
                                                "text": "Спиридонов выпил, несколько мгновений молчал, точно вынырнув из воды, потом стал есть суп."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53d5c932-ca65-3600-825f-e469bd8d6b35",
                                        "entry_id": "7de5477f-92fd-3456-b90e-096e0a35e9cf",
                                        "glosses": [
                                            "разг. : кусать, жалить"
                                        ],
                                        "tags": [
                                            "о насекомых"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e57ad7d-dec0-4aa1-a21a-023c28945d83",
                                                "sense_id": "53d5c932-ca65-3600-825f-e469bd8d6b35",
                                                "text": "Положим, он знает лесные дорожки, // Гарцует верхом, не боится воды, // Зато беспощадно едят его мошки, // Зато ему рано знакомы труды."
                                            },
                                            {
                                                "example_id": "cac3c2d0-57cf-4dae-a358-41061aaab28b",
                                                "sense_id": "53d5c932-ca65-3600-825f-e469bd8d6b35",
                                                "text": "Непокрытую голову палило солнце, тело ели комары и мошки, на лице от пота выступала соль, слепившая глаза, руки покрывались подушками сплошных мозолей, которые под косьём прорывались, и из них сочилась липкая белая жидкость вперемешку с кровью."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aeea0b42-f3e2-3e96-9ef1-1325eeea618e",
                                        "entry_id": "7de5477f-92fd-3456-b90e-096e0a35e9cf",
                                        "glosses": [
                                            "портить, уничтожать, грызя, съедая"
                                        ],
                                        "tags": [
                                            "о грызунах, насекомых, молюсках и т. п."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41ba1317-d2a5-4ba7-b55e-354215bf2c66",
                                                "sense_id": "aeea0b42-f3e2-3e96-9ef1-1325eeea618e",
                                                "text": "Осенью думаю на этом месте насадить малины, потому что её меньше едят слизняки, которых у нас, благодаря сырости, невообразимое количество."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1e57ec3-6056-3bfe-8409-bcd9204c94bd",
                                        "entry_id": "7de5477f-92fd-3456-b90e-096e0a35e9cf",
                                        "glosses": [
                                            "причинять повреждения, разрушая химически"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0732ee84-3319-4165-b5cd-1ea0e9bc09f2",
                                                "sense_id": "b1e57ec3-6056-3bfe-8409-bcd9204c94bd",
                                                "text": "По(изъ)едать, травить, говр. об острой, едкой, жгучей влаге, снадобье. И щёлочь ест, и кислота ест. Вода ест соль. Хлор ест краску. Известь ест руки, щиплет, жжёт до язв. Мыло глаза ест."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "769a8636-6479-3f84-bd9e-a8ebb8e22171",
                                        "entry_id": "7de5477f-92fd-3456-b90e-096e0a35e9cf",
                                        "glosses": [
                                            "раздражать"
                                        ],
                                        "tags": [
                                            "о дыме, газе, мыле и т. п."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3809e75f-525f-4979-a8f9-e71bfcd10de5",
                                                "sense_id": "769a8636-6479-3f84-bd9e-a8ebb8e22171",
                                                "text": "Взбираясь по лестнице, вёдшей к Петровичу, которая, надобно отдать справедливость, была вся умащена водой, помоями и проникнута насквозь тем спиртуозным запахом, который ест глаза и, как известно, присутствует неотлучно на всех чёрных лестницах петербургских домов, — взбираясь по лестнице, Акакий Акакиевич уже подумывал о том, сколько запросит Петрович, и мысленно положил не давать больше двух рублей."
                                            },
                                            {
                                                "example_id": "91250e1a-8105-4a0b-965c-1f7c29841f1f",
                                                "sense_id": "769a8636-6479-3f84-bd9e-a8ebb8e22171",
                                                "text": "Ничего не понимаю — и глаза мыло ест."
                                            },
                                            {
                                                "example_id": "9f50ca56-5c4a-4afb-8d82-eb4ee8345545",
                                                "sense_id": "769a8636-6479-3f84-bd9e-a8ebb8e22171",
                                                "text": "Посредине палатки горел огонь. Дым не успевал выйти через отверстие в крыше, ел глаза и принудил меня лечь на землю."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c610e590-1106-3801-b1cb-c0e4c9f9a4c2",
                                        "entry_id": "7de5477f-92fd-3456-b90e-096e0a35e9cf",
                                        "glosses": [
                                            "разг. : мучить, не давать покоя"
                                        ],
                                        "tags": [
                                            "о болезни, заботе, тоске и т. п."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83416de7-76c4-4baf-93b8-97a767ecf965",
                                                "sense_id": "c610e590-1106-3801-b1cb-c0e4c9f9a4c2",
                                                "text": "Бульба медленно, потупив голову, оборотился и шёл назад, преследуемый укорами Янкеля, которого ела грусть при мысли о даром потерянных червонцах."
                                            },
                                            {
                                                "example_id": "a0f34a65-e7a6-4fa6-9e4b-6429452b8822",
                                                "sense_id": "c610e590-1106-3801-b1cb-c0e4c9f9a4c2",
                                                "text": "Главное, что его мучило, это — Устенька, которая из богатой невесты превратилась в нищую. Эта последняя мысль ела старика день и ночь."
                                            },
                                            {
                                                "example_id": "def12367-ea51-452c-988d-f3fd75e08147",
                                                "sense_id": "c610e590-1106-3801-b1cb-c0e4c9f9a4c2",
                                                "text": "Особенно по воскресеньям меня ела тоска, когда я вспоминал о Чугуеве и переносился в наш осиновский кружок."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc560221-9bff-3534-a998-4c3bbf7a1fb0",
                                        "entry_id": "7de5477f-92fd-3456-b90e-096e0a35e9cf",
                                        "glosses": [
                                            "разг. изводить бесконечными попрёками, замечаниями, придирками и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3783999-6d79-487b-81da-056fc3744108",
                                                "sense_id": "cc560221-9bff-3534-a998-4c3bbf7a1fb0",
                                                "text": "И не от воров они запираются, а чтоб люди не видали, как они своих домашних едят поедом да семью тиранят."
                                            },
                                            {
                                                "example_id": "582c5c6c-0063-495d-9571-ce69564a2803",
                                                "sense_id": "cc560221-9bff-3534-a998-4c3bbf7a1fb0",
                                                "text": "Бедному человеку, в будке там или где, какое уж житьё! Едят тебя живодёры эти. Весь сок выжимают, а стар станешь — выбросят, как жмыху какую, свиньям на корм."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "есть",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1c3455a5-e985-311b-805e-245d34173dc5",
                                        "entry_id": "00f6aa4e-32d5-3733-a0f8-a71637db02bb",
                                        "glosses": [
                                            "являться, представлять собой в действительности"
                                        ],
                                        "tags": [
                                            "тж. в значении других лиц наст. вр. от быть (вследствие утраты старинных форм спряжения наст. вр. глаг. быть: есмь, есь и т. д.)"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a14568d8-9e09-454f-a503-0dcb2997c059",
                                                "sense_id": "1c3455a5-e985-311b-805e-245d34173dc5",
                                                "text": "Ведь надо знать, как вещи есть: // Не думай, что везде по-нашему хоромы."
                                            },
                                            {
                                                "example_id": "0f5c72eb-a939-48e0-806b-7bf805c95161",
                                                "sense_id": "1c3455a5-e985-311b-805e-245d34173dc5",
                                                "text": "— Я не хотела, чтоб вы думали обо мне лучше, чем я есть."
                                            },
                                            {
                                                "example_id": "d0893dfc-bfbe-4bb9-8a3d-e03b95375679",
                                                "sense_id": "1c3455a5-e985-311b-805e-245d34173dc5",
                                                "text": "— Кто ты есть? — говорил он, играя пальцами, приподняв брови."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a57c361-b7e5-3d05-8660-1f3e7f74f643",
                                        "entry_id": "00f6aa4e-32d5-3733-a0f8-a71637db02bb",
                                        "glosses": [
                                            "существует (существуют)"
                                        ],
                                        "tags": [
                                            "в знач. сказ. (независимо от лица и числа)"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11dae989-903c-4368-8b02-875ee2360c89",
                                                "sense_id": "1a57c361-b7e5-3d05-8660-1f3e7f74f643",
                                                "text": "Вот люди, есть ли им подобные?"
                                            },
                                            {
                                                "example_id": "ef11a9dd-4354-4101-872c-ffcbe94036ad",
                                                "sense_id": "1a57c361-b7e5-3d05-8660-1f3e7f74f643",
                                                "text": "Есть речи — значенье // Темно иль ничтожно, // Но им без волненья // Внимать невозможно."
                                            },
                                            {
                                                "example_id": "6bac5e08-68a3-42b8-991b-1b2c49acab71",
                                                "sense_id": "1a57c361-b7e5-3d05-8660-1f3e7f74f643",
                                                "text": "Но для женщины паспорт не так обязателен, и есть страны, где его вовсе не требуют."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cb1bbc2-886c-30ce-bc93-b5bb67a098e9",
                                        "entry_id": "00f6aa4e-32d5-3733-a0f8-a71637db02bb",
                                        "glosses": [
                                            "находится (находятся), присутствует (присутствуют)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72a09730-17cd-48ee-ae91-5df5b722f83c",
                                                "sense_id": "6cb1bbc2-886c-30ce-bc93-b5bb67a098e9",
                                                "text": "— У тебя дома кто есть? — Никого… Мама у Иванцовых."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8ec7eb7-327e-3031-adfa-d05c841c2344",
                                        "entry_id": "00f6aa4e-32d5-3733-a0f8-a71637db02bb",
                                        "glosses": [
                                            "имеется, находится в наличии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ce6c6d3-9a10-4f27-9f14-f10bc4300649",
                                                "sense_id": "f8ec7eb7-327e-3031-adfa-d05c841c2344",
                                                "text": "И ноты есть у нас, и инструменты есть, // Скажи лишь, как нам сесть!"
                                            },
                                            {
                                                "example_id": "8d8787c7-5a68-44c9-ba41-c58dc7f2994e",
                                                "sense_id": "f8ec7eb7-327e-3031-adfa-d05c841c2344",
                                                "text": "— Там ещё есть хорошие вещи, — сказала матушка, опуская руки в чемодан, — но их мы пока не будем разворачивать."
                                            },
                                            {
                                                "example_id": "45b71378-9a92-4f9a-abbe-af382f1d4649",
                                                "sense_id": "f8ec7eb7-327e-3031-adfa-d05c841c2344",
                                                "text": "У меня есть деньги — надо сходить и купить в магазине."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d825205-df2d-4b96-8509-69b0698a64df",
                        "source_entry_id": "da0d70cc-8797-3dc7-b719-0f3722b7c89c",
                        "source_sense_description": "used to express assent, especially to a superior",
                        "target_lang_word": "так то́чно",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "так то́чно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1ee643a1-20cf-3c25-a159-36a28f3900a3",
                                        "entry_id": "e86b45e2-97e2-3215-b429-861bc74604d3",
                                        "glosses": [
                                            "воен. формула утвердительного ответа военнослужащего"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5535c2e5-e6c1-4f3d-a67d-5877a59090d1",
                                                "sense_id": "1ee643a1-20cf-3c25-a159-36a28f3900a3",
                                                "text": "Вы меня не знаете. Может быть, вы знали меня с хорошей стороны, но теперь узнаете меня и с плохой стороны. Я не такой добрый, как вам кажется. Я любого доведу до слёз. Так знаете теперь, с кем имеете дело, или нет? — Знаю, господин лейтенант. — В последний раз вам повторяю, вы меня не знаете! Осёл! Есть у вас братья? — Так точно, господин лейтенант, есть один."
                                            },
                                            {
                                                "example_id": "02651ac8-cce5-4fed-bdfb-69a1cf47734e",
                                                "sense_id": "1ee643a1-20cf-3c25-a159-36a28f3900a3",
                                                "text": "— Чем это от тебя так разит, прохвост? — Осмелюсь доложить, господин лейтенант, от меня разит ромом. — Попался, негодяй! Наконец-то я тебя накрыл! — Так точно, господин лейтенант, только что мы получили ром к кофе, и я сначала выпил ром. Но если, господин лейтенант, вышло новое распоряжение и следует пить сначала кофе, а потом ром, прошу простить. Впредь этого не будет."
                                            },
                                            {
                                                "example_id": "1d4e38da-2912-4a1f-bea0-30185986dc0c",
                                                "sense_id": "1ee643a1-20cf-3c25-a159-36a28f3900a3",
                                                "text": "Ну и идиот же вы, Швейк! — с сердцем воскликнул поручик Лукаш. — Но не вздумайте, по своему обыкновению, ответить: «Так точно — я идиот»."
                                            },
                                            {
                                                "example_id": "044d039d-61b1-4170-809a-321524e7c29b",
                                                "sense_id": "1ee643a1-20cf-3c25-a159-36a28f3900a3",
                                                "text": "И Швейку ничего иного не оставалось, как только отдавать честь и соглашаться: «Так точно, молчу, дело совершенно ясное»."
                                            },
                                            {
                                                "example_id": "d0e1b3e6-a3b9-4504-9cf6-d700de41e24d",
                                                "sense_id": "1ee643a1-20cf-3c25-a159-36a28f3900a3",
                                                "text": "— Задача ясна? — Так точно. — Вопросы есть? — Никак нет. — Действуйте. — Слушаюсь."
                                            },
                                            {
                                                "example_id": "64098158-fd8a-42e8-ac9a-67769a94e427",
                                                "sense_id": "1ee643a1-20cf-3c25-a159-36a28f3900a3",
                                                "text": "— Ну как мальчик? — Мальчик ничего, товарищ капитан. — Работает? — Так точно. — Какие обязанности выполняет при орудии? — До сего дня он у меня стреляные гильзы укладывал. А сегодня — или, сказать точнее, вчера вечером — я его помощником шестого номера поставил. — Ну и как? Справился? — Ничего."
                                            },
                                            {
                                                "example_id": "fb2acf31-f313-41cd-b492-b9d96bbfa603",
                                                "sense_id": "1ee643a1-20cf-3c25-a159-36a28f3900a3",
                                                "text": "— Патроны привезли? — Так точно. — Хорошо. Тут в некоторых местах нарушен забор. Вы не пробовали — через эти проломы, в случае чего, можно выкатить пушки? — Так точно. Пробовал. Выкатываются. — Хорошо. Учтите это. Связь с наблюдательными пунктами исправно работает? — Исправно. — Кто дежурит на правом боковом? — Не могу знать. — Узнайте и доложите. И пусть мне сюда подадут машину. — Слушаюсь."
                                            },
                                            {
                                                "example_id": "d5109be1-caec-47b1-b997-71d27b722b82",
                                                "sense_id": "1ee643a1-20cf-3c25-a159-36a28f3900a3",
                                                "text": "— Красноармеец Солнцев! — Я, товарищ капитан. — Боевое задание. Немедленно доставьте этот пакет на командный пункт дивизиона, начальнику штаба. Понятно? — Так точно. — Повторите. — Приказано немедленно доставить пакет на командный пункт дивизиона, начальнику штаба. — Правильно."
                                            },
                                            {
                                                "example_id": "b378a2a6-5ad7-41a3-8c21-ac58ba7e5eb5",
                                                "sense_id": "1ee643a1-20cf-3c25-a159-36a28f3900a3",
                                                "text": "— Это что же, вот этот один солдат с бабой вели бой с целым полком? — Так точно. — Ты, Чонкин, прямо скажу, — герой, хоть на вид и обыкновенный лопух."
                                            },
                                            {
                                                "example_id": "e7a17e21-1853-4a3b-b8e7-20572ffaea05",
                                                "sense_id": "1ee643a1-20cf-3c25-a159-36a28f3900a3",
                                                "text": "— Ой! Извините, товарищ капитан! — Гвардии капитан. — Так точно, гвардии товарищ капитан!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5ea1f83-ac2c-3529-af0d-f6d983158f69",
                                        "entry_id": "e86b45e2-97e2-3215-b429-861bc74604d3",
                                        "glosses": [
                                            "да, именно так"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
