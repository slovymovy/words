                    }
                ],
                "senses": [
                    {
                        "sense_id": "c45e86b1-b4eb-3fbd-860e-b4f46f4dcadf",
                        "entry_id": "911b7b02-29f7-32c5-b5f6-7394e7a190cc",
                        "glosses": [
                            "Concours comprenant dix épreuves."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8c6dff51-5a7e-310b-a59e-aee4f0f71521",
                        "entry_id": "911b7b02-29f7-32c5-b5f6-7394e7a190cc",
                        "glosses": [
                            "Concours qui se déroule en deux jours comprenant le 100 m, le saut en longueur, lancer du poids, saut en hauteur, 400 m, 110 m haies, lancer du disque, saut à la perche, lancer du javelot, 1500 m."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "0acf9d08-b014-4bff-844b-93f25414246e",
                                "sense_id": "8c6dff51-5a7e-310b-a59e-aee4f0f71521",
                                "text": "Le décathlon est sans doute, aux Jeux olympiques, la plus exigeante des disciplines athlétiques en plein air."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0fdde00-bfca-41d9-912e-ec4d56e8a1cb",
                        "source_entry_id": "911b7b02-29f7-32c5-b5f6-7394e7a190cc",
                        "target_lang_word": "Zehnkampf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zehnkampf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8408f562-a00f-3c7a-a0e1-87457bdb7a81",
                                        "entry_id": "0e65ad81-3331-3308-ac4f-a4f0ab1af2c4",
                                        "glosses": [
                                            "ein Wettkampf im Sport, der aus zehn leichtathletischen Einzelwettbewerben an zwei Tagen besteht und aus denen eine Gesamtwertung gebildet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7c4bc77-3272-447c-a9cc-2145d976a2a6",
                                                "sense_id": "8408f562-a00f-3c7a-a0e1-87457bdb7a81",
                                                "text": "Der Zehnkapf besteht heute aus vier Lauf-, drei Sprung- und drei Wurfdisziplinen und erfordert eine große Vielseitigkeit und Ausdauer der Sportler."
                                            },
                                            {
                                                "example_id": "7958d3c5-b517-4595-92a8-efc2cebf2157",
                                                "sense_id": "8408f562-a00f-3c7a-a0e1-87457bdb7a81",
                                                "text": "Es haben viele Sportlerinnen und Sportler am Olympischen Zehnkampf teilgenommen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5e138764-d22e-36eb-a3ff-484f2b7f43ab",
                                        "entry_id": "0e65ad81-3331-3308-ac4f-a4f0ab1af2c4",
                                        "glosses": [
                                            "antiker Zehnkampf, auch als Dekathlon bezeichnet"
                                        ],
                                        "tags": [
                                            "Antike"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be7b7849-c160-4588-9f04-975a533c0b60",
                                                "sense_id": "5e138764-d22e-36eb-a3ff-484f2b7f43ab",
                                                "text": "In der Antike wurde der Zehnkampf von den Griechen Dekathlon genannt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1642d212-c05f-44be-83ea-f132f4ffe213",
