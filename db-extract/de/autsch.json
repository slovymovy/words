                                        "sense_id": "6d0a6133-b2a5-33e6-8b64-7d9f90cd8013",
                                        "entry_id": "35962262-2e6a-3bb6-bee7-5d1b74f9035b",
                                        "glosses": [
                                            "To exclaim \\\"ouch!\\\" in discomfort or pain."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
