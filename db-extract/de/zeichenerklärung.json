                    }
                ],
                "translations": [
                    {
                        "translation_id": "db356ddf-f3a6-45db-ac40-f0d1a5545cde",
                        "source_entry_id": "bd5f2b12-86c3-3209-a50d-b3e9db19952b",
                        "source_sense_id": "d83f5dea-d759-3db4-8a77-f9eca6b6d283",
                        "source_sense_description": "erklärende Liste der Bedeutungen von verwendeten Symbolen, Farben oder Ähnlichem",
                        "target_lang_word": "légende",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "légende",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9c1fbd46-bdfc-38cc-87c7-43380c4096d8",
                                        "entry_id": "49307f09-a759-3655-ae4c-9c3acd0a1198",
                                        "glosses": [
                                            "Inscription gravée circulairement près des bords et quelquefois sur la tranche d’une pièce de monnaie, d’un jeton, d’une médaille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8a121ae-7b5c-409a-bf92-8526d324f9b4",
                                                "sense_id": "9c1fbd46-bdfc-38cc-87c7-43380c4096d8",
                                                "text": "Les anciennes pièces de cinq francs portaient pour légende « Dieu Protège La France »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b935691-2254-3b69-8841-db2078fbc35a",
                                        "entry_id": "49307f09-a759-3655-ae4c-9c3acd0a1198",
                                        "glosses": [
                                            "Âme d’une devise, de ce qu’on y peut lire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "421ae4bc-a329-4005-a29e-c07236a885f6",
                                                "sense_id": "1b935691-2254-3b69-8841-db2078fbc35a",
                                                "text": "Louis XIV avait pour devise le soleil avec cette légende : « Nec Pluribus Impar »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9edaa44-3ab2-307c-84b6-8cb47098ca89",
                                        "entry_id": "49307f09-a759-3655-ae4c-9c3acd0a1198",
                                        "glosses": [
                                            "Liste placée sur un plan d’architecture, sur une carte topographique, géographique (mappemonde ou autre), etc., pour expliquer les lettres, les signes, les couleurs par lesquels on indique les différentes parties ou les endroits remarquables."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9d4f229f-2726-3970-88e7-bf376ebf6a63",
                                        "entry_id": "49307f09-a759-3655-ae4c-9c3acd0a1198",
                                        "glosses": [
                                            "Liste placée sur un plan d’architecture, sur une carte topographique, géographique (mappemonde ou autre), etc., pour expliquer les lettres, les signes, les couleurs par lesquels on indique les différentes parties ou les endroits remarquables.",
                                            "Tableau descriptif, non nécessairement complet, des conventions cartographiques permettant la lecture de la carte."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7ec19cbb-b715-3945-a48b-7cb9e234a5ba",
                                        "entry_id": "49307f09-a759-3655-ae4c-9c3acd0a1198",
                                        "glosses": [
                                            "Liste placée sur un plan d’architecture, sur une carte topographique, géographique (mappemonde ou autre), etc., pour expliquer les lettres, les signes, les couleurs par lesquels on indique les différentes parties ou les endroits remarquables.",
                                            "Mention dans le champ de la carte explicitant ou complétant un signe conventionnel ou fournissant un renseignement particulier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5dcb84c-5095-405b-b13e-091d63a47ce7",
                                                "sense_id": "7ec19cbb-b715-3945-a48b-7cb9e234a5ba",
                                                "text": "Il existe encore une classe de roches feldspathiques […]: ce sont les eurites ou pétrosilex, tantôt purs, tantôt mélangés de cristaux de quartz, et que nous avons, par cette raison, désignés, dans la légende de la carte géologique, sous le nom de porphyres quartzifères, […]."
                                            },
                                            {
                                                "example_id": "c391867f-f139-451d-a653-1f0b6f6b916b",
                                                "sense_id": "7ec19cbb-b715-3945-a48b-7cb9e234a5ba",
                                                "text": "On remarquera, comme on l'a fait sommairement sur la légende de la carte, que ce figuré peut représenter des séries métamorphiques dont l'âge peut être mésozoïque ou cénozoïque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7686f2b5-52b5-32c1-8a07-71f21988b811",
                                        "entry_id": "49307f09-a759-3655-ae4c-9c3acd0a1198",
                                        "glosses": [
                                            "Paroles qu’on trouve inscrites dans un tableau, ou dans une estampe, et qui semblent parfois sortir de la bouche des personnages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba43b1bc-dac5-406e-b1c6-af60da150bc9",
                                                "sense_id": "7686f2b5-52b5-32c1-8a07-71f21988b811",
                                                "text": "Une légende de Daumier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49bb5e81-77a3-3d84-9b16-944b0c644804",
                                        "entry_id": "49307f09-a759-3655-ae4c-9c3acd0a1198",
                                        "glosses": [
                                            "Notice explicative mise au bas ou au-dessous d’un tableau, d’un dessin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "754e49e8-5fea-44e3-a541-f437c1a6f5a7",
                                                "sense_id": "49bb5e81-77a3-3d84-9b16-944b0c644804",
                                                "text": "[…], il fit une seconde halte pour lire ces mots : À la Belle-Étoile, écrits en légende sous une peinture qui représentait le simulacre le plus flatteur pour un voyageur affamé : c’était une volaille rôtissant au milieu d’un ciel noir, […]."
                                            },
                                            {
                                                "example_id": "ea5ee837-03f8-4416-93c5-2bc806617078",
                                                "sense_id": "49bb5e81-77a3-3d84-9b16-944b0c644804",
                                                "text": "En 1866, M. l’abbé Jeuffrain, nommé récemment curé de Graville-Sainte-Honorine, remarqua dans la chapelle de sainte Honorine une pierre tombale de grande dimension, sans légende, mais chargée de traces d’incrustations héraldiques, au nombre de douze ou quatorze, et présentant les effigies d’un chevalier et de sa femme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cef5ece-80ef-392c-93e0-d5d6b6a73202",
                                        "entry_id": "49307f09-a759-3655-ae4c-9c3acd0a1198",
                                        "glosses": [
                                            "Récit populaire, plus ou moins fabuleux, qui s’est transmis par la tradition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7108f6e-fbcc-4bce-892e-109f1bb54f7b",
                                                "sense_id": "8cef5ece-80ef-392c-93e0-d5d6b6a73202",
                                                "text": "Selon une légende qui a longtemps eu cours dans le Midi, des Hébreux seraient venus se fixer à Narbonne au temps du roi David, soit au XIᵉ siècle avant l’ère chrétienne."
                                            },
                                            {
                                                "example_id": "3c1074b0-b8db-478a-8cd8-75ba6a914a9b",
                                                "sense_id": "8cef5ece-80ef-392c-93e0-d5d6b6a73202",
                                                "text": "Il n’y a rien d’étonnant à ce que les Féroë aient été considérés comme le domaine du dieu Thor et que les vieux se racontent les légendes des poulpitecs, du Kraken et des sirènes."
                                            },
                                            {
                                                "example_id": "13862226-9127-4738-aa3e-70bd4be8a301",
                                                "sense_id": "8cef5ece-80ef-392c-93e0-d5d6b6a73202",
                                                "text": "Un autre capitaine […] se promenait avec une Bible et exploitait le goût des indigènes pour le merveilleux et leur penchant à discuter les légendes bibliques, qui par certains côtés ressemblent à leurs légendes païennes, […]."
                                            },
                                            {
                                                "example_id": "9e76f5e2-e591-40ea-b44d-936a90374064",
                                                "sense_id": "8cef5ece-80ef-392c-93e0-d5d6b6a73202",
                                                "text": "« Des légendes ? dit Natalie, qu’est-ce que c’est, des légendes ?\n— Eh bien, dit Martin Paul, ce sont des fables, des contes ; c’est ce qu’on fait semblant de croire vrai, tout en sachant que c’est faux ; ce sont des illusions qu’on a quand la nuit est douce, que ça sent bon, que ça chante dans les herbes… »"
                                            },
                                            {
                                                "example_id": "f1f34fe1-6df8-4b80-a919-82dd40a8a78e",
                                                "sense_id": "8cef5ece-80ef-392c-93e0-d5d6b6a73202",
                                                "text": "Il se fabriquait une étrange réputation, personnage de légende qui voyait à travers le brouillard, savait se rendre invisible aux gabelous, capable de tout !"
                                            },
                                            {
                                                "example_id": "2a771d4d-9669-49a7-912c-205664c2625e",
                                                "sense_id": "8cef5ece-80ef-392c-93e0-d5d6b6a73202",
                                                "text": "« Rien qu’une légende, dis-tu ? Tu ne veux que des faits ? Les faits sont périssables, crois-moi, seule la légende reste, comme l’âme après le corps, ou comme le parfum dans le sillage d’une femme. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1be375c-e565-3aee-ad47-0e341ac87deb",
                                        "entry_id": "49307f09-a759-3655-ae4c-9c3acd0a1198",
                                        "glosses": [
                                            "Récit mythique."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e78f0bcd-d920-49de-86d9-b79116654a78",
                                                "sense_id": "e1be375c-e565-3aee-ad47-0e341ac87deb",
                                                "text": "Le biniou de Jozon Thoraval! Il avait sa légende, comme tout biniou qui se respecte ; j’en puis faire aujourd’hui l’histoire […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99b008f0-ffdc-3669-86ab-62402846bf0a",
                                        "entry_id": "49307f09-a759-3655-ae4c-9c3acd0a1198",
                                        "glosses": [
                                            "Ouvrage contenant le récit de la vie des saints."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e034473-7022-4f2c-b30f-7d6525d10f48",
                                                "sense_id": "99b008f0-ffdc-3669-86ab-62402846bf0a",
                                                "text": "Des compositions d’un autre genre, appartenant de même à la littérature théologique, se sont continuées en latin, et en même temps ont commencé à être écrites en français ; telles sont les légendes, traduites en général d’après un original latin, […]."
                                            },
                                            {
                                                "example_id": "281f2967-ce00-43e1-b1c1-acf05f5fef05",
                                                "sense_id": "99b008f0-ffdc-3669-86ab-62402846bf0a",
                                                "text": "Ce saint-là n’est pas dans la légende."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7987455-14ad-388a-8c06-22533f9456cf",
                                        "entry_id": "49307f09-a759-3655-ae4c-9c3acd0a1198",
                                        "glosses": [
                                            "Histoire fausse."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7d5104a-03dc-47a8-92ae-3e9cdfb27918",
                                                "sense_id": "f7987455-14ad-388a-8c06-22533f9456cf",
                                                "text": "Mais Estivareilles est surtout connu pour posséder plusieurs « menhirs christianisés », et il nous faut combattre une légende, celle de l’origine préhistorique de ces pierres levées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41416c8e-46ee-332b-9fd5-7fbc8470a51f",
                                        "entry_id": "49307f09-a759-3655-ae4c-9c3acd0a1198",
                                        "glosses": [
                                            "Histoire fausse cherchant à donner à un événement banal un caractère spectaculaire."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e54e87b4-4dbc-41c3-8ac2-f027d1090b7a",
                                                "sense_id": "41416c8e-46ee-332b-9fd5-7fbc8470a51f",
                                                "text": "La chanteuse était morte d'un arrêt cardiaque dans une chambre d'hôtel, à Brest, sa ville natale où elle était en tournée, ce que la légende, qui est le désir d'être trompé, transformait déjà en : morte sur scène."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79c4ce4d-b44e-330b-ba99-a6860822595c",
                                        "entry_id": "49307f09-a759-3655-ae4c-9c3acd0a1198",
                                        "glosses": [
                                            "Personne célèbre, talentueuse ou héroïque qui a atteint un certain succès, une certaine notoriété dans un domaine, un milieu."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d1ad58c-5d13-438a-b3ab-6b2014ffdcba",
                                                "sense_id": "79c4ce4d-b44e-330b-ba99-a6860822595c",
                                                "text": "Je suis une légende vivante."
                                            },
                                            {
                                                "example_id": "4732dc6c-8374-46cd-b54f-bdc29c551530",
                                                "sense_id": "79c4ce4d-b44e-330b-ba99-a6860822595c",
                                                "text": "Cette chanteuse s’est hissée au rang des légendes de la pop."
                                            },
                                            {
                                                "example_id": "04d8f1d7-b740-4612-956d-68a0a7c089a4",
                                                "sense_id": "79c4ce4d-b44e-330b-ba99-a6860822595c",
                                                "text": "Ce footballeur est une légende."
                                            },
                                            {
                                                "example_id": "ac80a847-70f3-41ca-b8ca-0b7519467084",
                                                "sense_id": "79c4ce4d-b44e-330b-ba99-a6860822595c",
                                                "text": "[S’adressant à Arthur.] Des chefs de guerre, il y en a de toutes sortes. Des bons, des mauvais, des pleines cagettes, il y en a. Mais une fois de temps en temps, il en sort un. Exceptionnel. Un héros. Une légende. Des chefs comme ça, il y en a presque jamais. Mais tu sais ce qu’ils ont tous en commun ? Tu sais ce que c’est, leur pouvoir secret ? Ils ne se battent que pour la dignité des faibles."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
