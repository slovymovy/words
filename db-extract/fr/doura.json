                        "glosses": [
                            "Sorgo égyptien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56b8c4fe-2765-4e3b-ac7d-926e39b45fff",
                                "sense_id": "ee120ae5-4c62-3d81-9c71-15f4f42130e8",
                                "text": "Le sol n'offre que des chardons, entremêlés de chétives plantations de coton, de doura, d'orge et de froment."
                            },
                            {
                                "example_id": "8ba71d8b-5dfc-4c60-88c0-dcec4ab4275c",
                                "sense_id": "ee120ae5-4c62-3d81-9c71-15f4f42130e8",
                                "text": "Des marchands ambulants criaient des dattes, du doura (maïs), des confitures, des sorbets, des fruits et des morceaux de canne à sucre."
                            },
                            {
                                "example_id": "dc1c622e-aa46-4401-a74a-faa6ea26cf0d",
                                "sense_id": "ee120ae5-4c62-3d81-9c71-15f4f42130e8",
                                "text": "Un autre, qui est boulanger, parle déjà de doura et de tef ; un autre encore du café de Zeghè, sur le lac Tana. Ils savent déjà tout de l’Éthiopie."
                            }
                        ]
                    }
