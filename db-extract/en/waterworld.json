                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5b32468-0f43-496e-adae-941efb895af0",
                                "sense_id": "b397bd4c-4662-3153-80c7-1bfb99d9f059",
                                "text": "The rest of Pampanga (except the towns around Mt. Arayat and those near Bulacan) is a waterworld during the rainy season."
                            },
                            {
                                "example_id": "a5076c8e-c0b6-4152-9f3b-468283292f8e",
                                "sense_id": "b397bd4c-4662-3153-80c7-1bfb99d9f059",
                                "text": "While fire is impossible on a waterworld, electronic circuits may not be. Electric eels, for example, demonstrate that electric circuits are possible in a salty aqueous environment, though it would not be an easy task."
                            }
                        ]
                    }
