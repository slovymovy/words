                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e862913-49f6-41b3-8061-99fcd8c8ad89",
                                "sense_id": "4d2d7967-b8d6-347a-817c-c3dc170842f2",
                                "text": "La grossesse cornuale s’apparente aux grossesses interstitielles. Il s’agit d’une grosse extra-utérine implantée dans la corne rudimentaire d’un utérus bicorne."
                            },
                            {
                                "example_id": "548d569f-5393-4bb4-a213-f58c96565f13",
                                "sense_id": "4d2d7967-b8d6-347a-817c-c3dc170842f2",
                                "text": "La corne et sa région sont alors fortement irriguées grâce à l’artère cornuale et drainées par la veine cornuale, ce qui permet son développement."
                            }
                        ]
                    }
