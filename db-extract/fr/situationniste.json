                        "entry_id": "939265ef-eede-3bf5-9a6e-43f73941c5c2",
                        "glosses": [
                            "Membre ou partisan de l’Internationale situationniste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24f1d73b-a899-4936-b677-da230486c9e5",
                                "sense_id": "37183958-e6b9-39a3-9421-cc50048732ff",
                                "text": "La voix de son interlocuteur était celle d’un homme instruit, habitué à la parole ; il ressemblait à un situationniste belge, ou à un intellectuel prolétarien – avec des chemises Arrow tout de même ; pourtant, à ses mains fortes, usées, on devinait qu’il avait effectivement exercé un métier manuel."
                            },
                            {
                                "example_id": "d6d5bee0-1d89-434d-8589-083f4bd579d1",
                                "sense_id": "37183958-e6b9-39a3-9421-cc50048732ff",
                                "text": "En 1969, un groupe de situationnistes installa une copie en plâtre de la statue vite cassée par la police."
                            }
                        ]
                    }
                ],
