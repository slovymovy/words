                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88c8d877-62d3-431f-8559-26b8b3c942c4",
                                "sense_id": "785d7587-cf15-37dd-b3b8-ef2d9a13fbf0",
                                "text": "„Die Augen des Toten sollen in dunklen Höhlen versunken sein, und er soll blindlings voranstolpern, sich an den kalten Marmorwänden entlangtasten und sie mit verwestem Brei beschmieren, bis die Knochen seiner Handflächen freigelegt sind.“"
                            },
                            {
                                "example_id": "df741796-0253-4b18-96c1-8e951ad9bcc6",
                                "sense_id": "785d7587-cf15-37dd-b3b8-ef2d9a13fbf0",
                                "text": "„Die weißen Marmorwände sahen immer noch so eisig aus, daß man unwillkürlich an eine Louis-XV-Dekoration aus Schnee in einer Eskimobehausung denken mußte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
