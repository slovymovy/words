                "translations": [
                    {
                        "translation_id": "235f5df8-5b08-4640-9ea1-62ff7689fd39",
                        "source_entry_id": "a5e1d0b1-d234-35a3-a949-aa583fab1379",
                        "source_sense_id": "b5bf4c4b-8f8f-376f-b421-ad2b01eb7ecc",
                        "source_sense_description": "something that stiffens",
                        "target_lang_word": "Versteifung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Versteifung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f75c9a8e-0484-369a-a961-c4d7b69ae349",
                                        "entry_id": "4f8a2b3c-a47c-34f8-a1dc-ddbc4a4bd82c",
                                        "glosses": [
                                            "hilfreiches Etwas, das dazu dient, etwas zu versteifen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57dd0292-6cfc-4204-b012-85a0d3c81126",
                                                "sense_id": "f75c9a8e-0484-369a-a961-c4d7b69ae349",
                                                "text": "„Diese Versteifungen sorgen für die hohe Stabilität insbesondere für Dachbleche.“"
                                            },
                                            {
                                                "example_id": "1c08603f-b9f5-428e-a1c5-ada03ab6074b",
                                                "sense_id": "f75c9a8e-0484-369a-a961-c4d7b69ae349",
                                                "text": "Ein Schott in einem Bootsrumpf dient auch dessen Versteifung."
                                            },
                                            {
                                                "example_id": "09388898-270e-4808-8495-80b599ad1bc7",
                                                "sense_id": "f75c9a8e-0484-369a-a961-c4d7b69ae349",
                                                "text": "Eine Sicke dient häufig der Versteifung von dünnwandigen Bauteilen gegenüber Verformung oder Schwingung."
                                            },
                                            {
                                                "example_id": "34a11eab-b549-4692-b128-d39f3ddd64d5",
                                                "sense_id": "f75c9a8e-0484-369a-a961-c4d7b69ae349",
                                                "text": "„Während früher auch andere Materialien verwendet wurden“ […] „, ist ein moderner Tübbing ein vorgefertigtes Betonsegment für Versteifungen im Tunnelbau.“"
                                            },
                                            {
                                                "example_id": "bcef14cf-8d9b-4d25-82de-b0854b19f6ad",
                                                "sense_id": "f75c9a8e-0484-369a-a961-c4d7b69ae349",
                                                "text": "„Unter konstruktiven Versteifungen sollen gezielt eingebrachte geometrische Anisotropien verstanden werden, die helfen, die Steifigkeit einer Leichtbaukonstruktion zu erhöhen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5dcb1be5-a4c7-382e-8374-b04874cd82b6",
                                        "entry_id": "4f8a2b3c-a47c-34f8-a1dc-ddbc4a4bd82c",
                                        "glosses": [
                                            "der Vorgang des Versteifens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d8f7a2f-1676-4377-b856-a98f4f7df078",
                                                "sense_id": "5dcb1be5-a4c7-382e-8374-b04874cd82b6",
                                                "text": "„Die Versteifung der Wäsche beruht auf dem physikalischen Effekt der Verkleisterung der Stärke beim Erhitzen.“"
                                            },
                                            {
                                                "example_id": "c79f8540-26a2-4d87-8bc0-f92a993e924a",
                                                "sense_id": "5dcb1be5-a4c7-382e-8374-b04874cd82b6",
                                                "text": "„Die Folge der Versteifung ist eine teilweise oder vollständige Übernahme der Beweglichkeit durch benachbarte Gelenke, die dadurch mittel-langfristig ebenfalls geschädigt werden können.“"
                                            },
                                            {
                                                "example_id": "c199641b-173f-4099-8dc4-667e0175fca3",
                                                "sense_id": "5dcb1be5-a4c7-382e-8374-b04874cd82b6",
                                                "text": "„Der Gehstock kann Menschen helfen, die sich unsicher fortbewegen, Versteifungen in Gelenken haben oder ein Bein etwas schonen möchten, zum Beispiel bei beginnender Arthrose in Knie oder Hüfte.“"
                                            },
                                            {
                                                "example_id": "8be97a81-17b1-4f26-8c10-5b24eab31d44",
                                                "sense_id": "5dcb1be5-a4c7-382e-8374-b04874cd82b6",
                                                "text": "„Diese kurzen Übungen helfen Ihnen, trotz künstlicher Hüfte fit zu bleiben. Sie steigern die Beweglichkeit, verhindern Versteifungen und bauen Muskeln auf. Zehn Minuten am Tag reichen aus!“"
                                            },
                                            {
                                                "example_id": "945904cf-d94c-40b5-b1b8-b8205db15eba",
                                                "sense_id": "5dcb1be5-a4c7-382e-8374-b04874cd82b6",
                                                "text": "„Bei sexueller Erregung füllen sich die Schwellkörper mit Blut, wodurch der Penis größer und hart wird, es kommt zur Erektion („Aufrichtung“, „Versteifung“). Für die Versteifung sind vor allem die Penisschwellkörper verantwortlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
