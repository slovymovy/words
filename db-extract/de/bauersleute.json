                            },
                            {
                                "target_word": "paysans",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f99eec8c-eeac-3121-8367-58ee3b4f7091",
                                        "entry_id": "02762876-ce24-3843-aca6-6af577657ffc",
                                        "glosses": [
                                            "Pluriel de paysan."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e66f080-bc53-4f0e-8812-c49a624a0b12",
                                                "sense_id": "f99eec8c-eeac-3121-8367-58ee3b4f7091",
                                                "text": "Il aimait la campagne et les paysans de loin, dans ses souvenirs. Il les rêvait alors, graves, simples, austères comme les Natchez de Chateaubriand. De près, il les trouvait rudes, malpropres et cyniques. Il s’éloigna, dégoûté déjà de l’envie qu’il avait eue de causer avec eux."
                                            },
                                            {
                                                "example_id": "a899a14a-13c7-4d8a-abe0-58df1d49daa3",
                                                "sense_id": "f99eec8c-eeac-3121-8367-58ee3b4f7091",
                                                "text": "Les millions de morts de la grande guerre sont, pour les quatre-vingts centièmes des ouvriers et des paysans."
                                            },
                                            {
                                                "example_id": "0d4a79ad-e51e-4a1f-8d70-865f7e87a867",
                                                "sense_id": "f99eec8c-eeac-3121-8367-58ee3b4f7091",
                                                "text": "Les cris des coqs, les sabots des ânes poussés par l’encouragement sonore et monotone des paysans, réveillèrent Elhamy le lendemain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
