                    {
                        "translation_id": "23005847-4be2-4f71-a809-fc8dedc829e4",
                        "source_entry_id": "aa293bf0-3a04-33f7-ad19-e74e110beaf3",
                        "target_lang_word": "Schachspieler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schachspieler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ad1ed6d1-8057-3507-b911-614c218e46d2",
                                        "entry_id": "bfc99ecf-11f4-3c62-a9c3-d3274ca9dc1e",
                                        "glosses": [
                                            "(männliche^☆) Person, die das Schachspiel ausübt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93fa8a2e-527f-4ddc-af91-824b1c4eb3d9",
                                                "sense_id": "ad1ed6d1-8057-3507-b911-614c218e46d2",
                                                "text": "Schachspieler müssen über eine hohe Konzentrationsfähigkeit verfügen."
                                            },
                                            {
                                                "example_id": "19a0f7d5-59a2-492e-96b8-854ce7174cd3",
                                                "sense_id": "ad1ed6d1-8057-3507-b911-614c218e46d2",
                                                "text": "„Der Sultan wollte durchaus seinem Feind das Gefühl schenken, einen wirklich großen Schachspieler geschlagen zu haben, den zweitbesten der Welt vielleicht.“"
                                            },
                                            {
                                                "example_id": "deedf783-b689-4bb4-86e2-59a744794cb3",
                                                "sense_id": "ad1ed6d1-8057-3507-b911-614c218e46d2",
                                                "text": "„Ob im Herbst 2020 im Museumsquartier drei Wochen lang die Köpfe der beiden besten Schachspieler der Welt rauchen, entscheidet sich im Frühjahr.“"
                                            },
                                            {
                                                "example_id": "9a0c732a-ebb4-4d91-ad72-9073617f71b1",
                                                "sense_id": "ad1ed6d1-8057-3507-b911-614c218e46d2",
                                                "text": "„Indessen heißt rechnen noch nicht analysieren. Ein Schachspieler zum Beispiel tut das eine, ohne sich um das andere im mindesten zu kümmern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19bcb09d-1eb9-44be-ac82-8f3451200947",
                        "source_entry_id": "aa293bf0-3a04-33f7-ad19-e74e110beaf3",
                        "target_lang_word": "schaakspeler",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schaakspeler",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c0054dcc-646c-3896-9e40-69508eb2cc73",
                                        "entry_id": "4688a63f-d138-3a74-b77a-e44287d82e74",
                                        "glosses": [
                                            "iemand die schaak speelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97397056-3f42-4042-99b8-d7a34700e5a9",
                                                "sense_id": "c0054dcc-646c-3896-9e40-69508eb2cc73",
                                                "text": "' 'Bedoel je daarmee een soort transacties tussen mensen?' 'Als die transactie een spelletje schaak is, wie is dan je betere partner, een rechtvaardig iemand of een schaakspeler?' 'Een schaakspeler."
                                            },
                                            {
                                                "example_id": "fe398c01-37a4-411a-a08f-6d6274680c8d",
                                                "sense_id": "c0054dcc-646c-3896-9e40-69508eb2cc73",
                                                "text": "Moest-ie met de meester mee naar een beroemde schaakspeler."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "585625d5-31e9-30c2-99bc-6fa6f125992c",
                                        "entry_id": "4688a63f-d138-3a74-b77a-e44287d82e74",
                                        "glosses": [
                                            "iemand die ver vooruit kan denken"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52ceed35-f6c1-4cd9-a02b-e736a13282ea",
                                                "sense_id": "585625d5-31e9-30c2-99bc-6fa6f125992c",
                                                "text": "Kock: \"Hij is arrogant ja. Hij wil graag laten zien wat hij allemaal heeft bereikt in de sport en ook als zakenman. Op sociale media plaatst hij om de haverklap foto's van zijn auto's, zijn vliegtuigen en enorme huizen. Wat zijn kracht is? Het vermogen om vooruit te denken. In één seconde tien stappen verder denken dan de concurrent. Dat maakt het verschil. Dan ben je echt een topper. Eigenlijk is het een groot schaakspeler.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
