                ],
                "senses": [
                    {
                        "sense_id": "390c6131-592b-3a3a-b670-cb4a1e772ebc",
                        "entry_id": "c91ea0b7-afe0-3f10-b932-cdf36ece7ec2",
                        "glosses": [
                            "sich explosionsartig ausbreitende Luftkompression"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1c3d293-3476-41da-9bfb-3c7cd0d37bc0",
                                "sense_id": "390c6131-592b-3a3a-b670-cb4a1e772ebc",
                                "text": "„Am 5. April 1945 explodierte eine Bombe unmittelbar vor dem im Haus untergebrachten Café, wobei die Druckwelle und Splitter einen weit entfernten Wasserspeicher durchlöcherten und in den umliegenden Räumen weitere Beschädigungen verursachten.“"
                            },
                            {
                                "example_id": "8b02c280-fd99-4102-8abf-d83e6d1569a8",
                                "sense_id": "390c6131-592b-3a3a-b670-cb4a1e772ebc",
                                "text": "„Ein Wissenschaftler wies darauf hin, dass auf jeden Fall eine Druckwelle die Ursache sein müsse.“"
                            },
                            {
                                "example_id": "867dcacf-73ad-486c-b5d2-1fcf3374eb31",
                                "sense_id": "390c6131-592b-3a3a-b670-cb4a1e772ebc",
                                "text": "„Zwei der drei Wachen waren von der Druckwelle gegen die Wand geschleudert worden und hatten Feuer gefangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
