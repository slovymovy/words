                ],
                "senses": [
                    {
                        "sense_id": "4c7d0486-ec18-3a9d-baa4-0d1b05e91caf",
                        "entry_id": "e73b509d-b986-31a4-9a84-e174f17501a1",
                        "glosses": [
                            "свойство по значению прилагательного злодейский"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64a73395-9829-494f-b5df-88b97bb35075",
                                "sense_id": "4c7d0486-ec18-3a9d-baa4-0d1b05e91caf",
                                "text": "Честных в активе больше было, чем жулья, а злодейство от тех и других было одинаковое."
                            },
                            {
                                "example_id": "befc83ad-ae99-4b04-b8a2-46de43ff6747",
                                "sense_id": "4c7d0486-ec18-3a9d-baa4-0d1b05e91caf",
                                "text": "Жизнь становилась всё более тусклой и однообразной. Даже злодейство носило какой-то будничный, унылый характер."
                            }
                        ]
                    },
                    {
                        "sense_id": "d08d868d-61c8-32d5-bec1-3eb95cc6522f",
                        "entry_id": "e73b509d-b986-31a4-9a84-e174f17501a1",
                        "glosses": [
                            "разг. злодейский поступок; преступление, злодеяние"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24fb08c4-fa1a-4010-9cf5-36c06fa20413",
                                "sense_id": "d08d868d-61c8-32d5-bec1-3eb95cc6522f",
                                "text": "Иродово злодейство воспринимаешь злодейством Ирода, а не мукой безымянных младенцев."
                            }
                        ]
                    }
                ],
