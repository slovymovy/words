                "senses": [
                    {
                        "sense_id": "9384c43c-aa6c-325c-9d07-39c0d24a53ca",
                        "entry_id": "eca491ca-5f3d-3a9b-9b45-59b7f3a8e273",
                        "glosses": [
                            "Rendre perfide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b18782d4-85d2-4d8c-bf87-729f449f9d48",
                                "sense_id": "9384c43c-aa6c-325c-9d07-39c0d24a53ca",
                                "text": "Quand on s’est bien perfidisé, on va se présenter à d’autres hommes qui se sont aussi perfidisés de leur côté ; & alors c’est à qui jouera l’autre."
                            },
                            {
                                "example_id": "d47b1f46-dd31-4373-b8a1-06cfb50f5396",
                                "sense_id": "9384c43c-aa6c-325c-9d07-39c0d24a53ca",
                                "text": "Le monde des Cartoons est en danger, car un infâme méchant utilise son « perfidificateur » pour « perfidiser » tous les gentils cartoons, habitant le pays de mignognia."
                            },
                            {
                                "example_id": "59a49938-4222-4f42-af59-84a1dedb0b5d",
                                "sense_id": "9384c43c-aa6c-325c-9d07-39c0d24a53ca",
                                "text": "Nan, pas possible, ils joueront tous a MPH avant de nous avoir perfidisé."
                            }
                        ]
                    }
