                    {
                        "sense_id": "8e8aeb55-5c06-3d99-ab90-27c3315ebdd2",
                        "entry_id": "3522d015-360f-3ce9-91e9-a4d7f6b5e261",
                        "glosses": [
                            "Molécule hétérocyclique aromatique de formule C₄H₅N, c’est-à-dire un cycle aromatique avec 4 atomes de carbone et un atome d’azote."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48db844a-78e9-44d8-904f-428e0af8757b",
                                "sense_id": "8e8aeb55-5c06-3d99-ab90-27c3315ebdd2",
                                "text": "Les anions du pyrrole réagissent avec les électrophiles par l’atome d'azote."
                            },
                            {
                                "example_id": "a0797146-e24c-495e-910c-c9cca73eea51",
                                "sense_id": "8e8aeb55-5c06-3d99-ab90-27c3315ebdd2",
                                "text": "Ces pyrroles peuvent être substitués également dans les autres positions selon les substituants du composé carbonylé."
                            }
                        ]
                    }
                ],
