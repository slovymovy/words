                                            {
                                                "example_id": "f6dc5d99-6978-4501-9b67-5c346d60117e",
                                                "sense_id": "1e576630-a496-3c16-818f-e427a2b795b6",
                                                "text": "Sie verströmte einen wollüstigen Duft."
                                            },
                                            {
                                                "example_id": "d4030c05-1c37-4586-a924-ef2b41e60ff9",
                                                "sense_id": "1e576630-a496-3c16-818f-e427a2b795b6",
