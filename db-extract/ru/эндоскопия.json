                "senses": [
                    {
                        "sense_id": "d652776c-9b3a-3393-ba33-49e3d28ce9ac",
                        "entry_id": "db90f331-f323-3612-b3d4-5c998e0267bd",
                        "glosses": [
                            "мед. способ осмотра некоторых внутренних органов при помощи эндоскопа"
                        ],
                        "tags": [],
