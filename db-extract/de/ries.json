                                    {
                                        "sense_id": "fc67ddc1-b494-3085-94e3-c191854b4815",
                                        "entry_id": "c41615a1-80ad-329d-add2-ff0f73bfe34c",
                                        "glosses": [
                                            "Réunion de vingt mains de papier, soit 500 feuilles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4df1c6b-98bb-440d-9d82-b1a4319dc820",
                                                "sense_id": "fc67ddc1-b494-3085-94e3-c191854b4815",
                                                "text": "La rame de papier contient cinq-cents feuilles, quel que soit le format du papier."
                                            },
                                            {
                                                "example_id": "54fd0672-b23e-4820-8701-1f4dc0e1225b",
                                                "sense_id": "fc67ddc1-b494-3085-94e3-c191854b4815",
                                                "text": "Acheter, vendre des rames de papier."
                                            },
                                            {
                                                "example_id": "f8a555b4-ae00-4cbd-8c9d-af509680da31",
                                                "sense_id": "fc67ddc1-b494-3085-94e3-c191854b4815",
                                                "text": "J’avais couvert des rames de papier. Il y en avait une montagne accumulée sur ma table de travail. Je ne les considérais jamais avec beaucoup d’orgueil ; j’évitais ordinairement d’y jeter les yeux de trop près, et je vivais au jour le jour des illusions de la veille."
                                            }
                                        ]
