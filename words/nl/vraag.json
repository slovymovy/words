                        {
                            "text": "Als de <w>vraag</w> stijgt, gaat de prijs vaak omhoog.",
                            "target_lang_translations": {
                                "en": "When <w>demand</w> rises, the price often goes up.",
                                "ru": "Когда <w>спрос</w> растёт, цена часто поднимается.",
                                "pl": "Gdy <w>popyt</w> rośnie, cena często idzie w górę.",
                                "de": "Wenn die <w>Nachfrage</w> steigt, geht der Preis oft nach oben.",
                                "fr": "Quand la <w>demande</w> augmente, le prix grimpe souvent.",
                                "it": "Se la <w>domanda</w> sale, il prezzo spesso aumenta.",
                                "cs": "Když <w>poptávka</w> roste, cena jde často nahoru.",
                                "tr": "<w>Talep</w> arttığında, fiyat da genellikle yükselir.",
                                "es": "Cuando la <w>demanda</w> aumenta, el precio suele subir."
                            }
