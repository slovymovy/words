                                        "glosses": [
                                            "zaadaptowana na potrzeby własnego języka nazwa obiektu geograficznego inna od nazwy używanej w języku lub językach oficjalnych na obszarze, gdzie dany obiekt geograficzny się znajduje"
                                        ],
