                ],
                "senses": [
                    {
                        "sense_id": "7ff9fb51-c5da-3b1e-b5af-3553f0b30ab9",
                        "entry_id": "eb4376ec-88d1-36fe-b9e0-7c173ba37099",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "737d01a0-4054-485d-b298-7035eb4c9955",
                                "sense_id": "7ff9fb51-c5da-3b1e-b5af-3553f0b30ab9",
                                "text": "Frau Klassen ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "82e19e88-fb20-44d1-b9c1-62ada1e7eada",
                                "sense_id": "7ff9fb51-c5da-3b1e-b5af-3553f0b30ab9",
                                "text": "Herr Klassen wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c417dd44-1f93-4855-8500-2a932f24f691",
                                "sense_id": "7ff9fb51-c5da-3b1e-b5af-3553f0b30ab9",
                                "text": "Die Klassens fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "d2acd1ec-ded8-42ae-b872-22c687a8c6fc",
                                "sense_id": "7ff9fb51-c5da-3b1e-b5af-3553f0b30ab9",
                                "text": "Der Klassen trägt nie die Schals, die die Klassen ihm strickt."
                            },
                            {
                                "example_id": "5a159267-9aaa-4be1-b187-256d131a42b4",
                                "sense_id": "7ff9fb51-c5da-3b1e-b5af-3553f0b30ab9",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Klassen kommt, geht der Herr Klassen.“"
                            },
                            {
                                "example_id": "4baa10ac-1e7e-476a-aa7e-83c541bcd340",
                                "sense_id": "7ff9fb51-c5da-3b1e-b5af-3553f0b30ab9",
                                "text": "Klassen kommt und geht."
                            },
                            {
                                "example_id": "f737a6f7-557d-4c40-801e-e3438a695f9b",
                                "sense_id": "7ff9fb51-c5da-3b1e-b5af-3553f0b30ab9",
                                "text": "Klassens kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
