                        "examples": [
                            {
                                "example_id": "92adca19-349e-4cba-8109-d355f8aad39b",
                                "sense_id": "bcebaa44-1f2c-338a-8bd1-37f1035df0a4",
                                "text": "[…] Demandeur, vendeur, défendeur, bailleur, à côté des formes demandeuse, vendeuse, défendeuse, bailleuse, ont une seconde forme demanderesse, venderesse, défenderesse, bailleresse, laquelle s’emploie en terme de procédure."
                            },
                            {
                                "example_id": "7501c0d1-b80e-4281-a739-d8848f5405b5",
                                "sense_id": "bcebaa44-1f2c-338a-8bd1-37f1035df0a4",
                                "text": "Voyons, disait hier, à la huitième chambre, M. le président Gillet, à la défendeuse, il ne s’agit plus que de vingt sous que vous réclame le plaignant."
                            },
                            {
                                "example_id": "6e18915d-8276-44da-ad8b-17256ca1da53",
                                "sense_id": "bcebaa44-1f2c-338a-8bd1-37f1035df0a4",
                                "text": "demandeur, vendeur et défendeur font au féminin demandeuse, vendeuse et défendeuse, mais en termes de jurisprudence on dit : demanderesse, venderesse, et défenderesse."
                            },
                            {
                                "example_id": "1d4c7771-aa5f-4ef0-9dfa-10df8131adc4",
                                "sense_id": "bcebaa44-1f2c-338a-8bd1-37f1035df0a4",
                                "text": "La Chambre syrienne, dans sa séance du 27 avril 1938, n’a-t-elle pas imputé les troubles sanglants de la Djézireh aux Chrétiens et à la France « méchante, libérale, énigmatique, défendeuse des libertés démocratiques et publiques ? … »"
                            }
                        ]
