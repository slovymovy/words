                        ],
                        "examples": [
                            {
                                "example_id": "2d76198c-1917-48db-836c-0d71459de458",
                                "sense_id": "01f4d351-3be5-37a5-b59b-c9508929330f",
                                "text": "I ſtand aboue thee, and as from a rocke / VVhoſe eminence outſvvelles the raging flood, / See thy hopes ſhip vvrackt: […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6c6862c-9deb-4434-ad0e-6e349c83dcd3",
                        "source_entry_id": "8b5ab038-2dda-3732-8ca3-bc0649143da8",
                        "source_sense_id": "01f4d351-3be5-37a5-b59b-c9508929330f",
