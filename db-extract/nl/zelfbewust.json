                                "example_id": "9ea1c6aa-36a1-419c-b521-34d9955113d9",
                                "sense_id": "c35a35a4-1e8c-301b-8ecc-bb648e3f14ef",
                                "text": "De apen waren in zekere mate zelfbewust.",
                                "translation": "The primates were to a certain degree self-aware.",
                                "english": "The primates were to a certain degree self-aware."
                            }
                        ]
                    },
                    {
                        "sense_id": "ed66f046-d190-3de9-9335-6313e918412d",
                        "entry_id": "20959d87-0b9a-30d6-b954-96878acbe02f",
                        "glosses": [
                            "confident, self-confident"
                        ],
                        "tags": [],
                        "examples": [
                            {
