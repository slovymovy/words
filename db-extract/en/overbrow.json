                "senses": [
                    {
                        "sense_id": "bbc07c2b-96b9-3617-8e1e-c631acced041",
                        "entry_id": "4b1b81fa-0383-39bf-90af-064c5f47f5d0",
                        "glosses": [
                            "To hang over like a brow; to impend over."
                        ],
                        "tags": [
                            "poetic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "eb48cdd2-9bc4-4721-988e-75ed64208a44",
                                "sense_id": "bbc07c2b-96b9-3617-8e1e-c631acced041",
                                "text": "The prints of the Matlock cliffs on the Derwent, which every body has seen, will give the stranger some idea of the rocks which overbrow the partially wooded ravines, and glens down which the streams tributary to the Dove descend."
                            },
                            {
                                "example_id": "1043d8ab-e5ca-4456-bd15-35402ca4b7f3",
                                "sense_id": "bbc07c2b-96b9-3617-8e1e-c631acced041",
                                "text": "With solemn feet I tread the hill, That overbrows the lonely vale"
                            },
                            {
                                "example_id": "e9e99dbf-e536-45ab-a27d-7f56119d8c99",
                                "sense_id": "bbc07c2b-96b9-3617-8e1e-c631acced041",
                                "text": "18000, William Wordsworth, Michael\nDid with a huge projection overbrow\nLarge space beneath."
                            }
                        ]
                    }
                ],
