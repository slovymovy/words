            "senses": [
                {
                    "sense_id": "bef6c8e1-31a2-317d-8ca4-3cb6e9472ebb",
                    "sense_definition": "The mother of one's father or mother.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "family_relatives",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My <w>grandmother</w> bakes the most delicious cookies every Sunday.",
                            "target_lang_translations": {
                                "ru": "Моя <w>бабушка</w> печет самые вкусные печенья каждое воскресенье.",
                                "zh": "我<w>奶奶</w>每个星期天都会烤最好吃的饼干。"
                            }
                        },
                        {
                            "text": "We are going to visit our maternal <w>grandmother</w> for the holidays.",
                            "target_lang_translations": {
                                "ru": "Мы собираемся навестить нашу <w>бабушку</w> по материнской линии на праздники.",
                                "zh": "假期我们要去探望我们的<w>姥姥</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "grandma",
                        "granny",
                        "nan",
                        "nana"
                    ],
                    "antonyms": [
