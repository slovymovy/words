                "senses": [
                    {
                        "sense_id": "d4b0f27d-3d71-3da2-8b90-6d2bd17afcf2",
                        "entry_id": "afdb0e89-b6d9-3ad5-8639-0f2479a21253",
                        "glosses": [
                            "espèce de cercopithèque (Cercopithecus lomamiensis) vivant dans les environs de la rivière Lomami au Congo-Kinshasa."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d039a8f8-0867-4230-a6ef-bba20dac194d",
                                "sense_id": "d4b0f27d-3d71-3da2-8b90-6d2bd17afcf2",
                                "text": "« Le challenge est maintenant de faire du lesula une espèce emblématique pour symboliser la conservation de la faune en danger au Congo », a expliqué John Hart, l’un des biologistes en charge de l’étude."
                            },
                            {
                                "example_id": "4b6b1a4c-2571-4baa-b052-e4625b448343",
                                "sense_id": "d4b0f27d-3d71-3da2-8b90-6d2bd17afcf2",
                                "text": "Il était connu par certaines populations locales, mais n’avait jamais été identifié formellement par la science. Le lesula, son nom usuel, a reçu le nom scientifique de Cercopithecus lomamiensis."
                            },
                            {
                                "example_id": "c49eb82a-44fa-40d7-92cf-134506dd418d",
                                "sense_id": "d4b0f27d-3d71-3da2-8b90-6d2bd17afcf2",
                                "text": "La revue PLoS One a publié mercredi le portrait du lesula, un primate découvert par la communauté scientifique en 2007 sur le Moyen-Lomami, une rivière située au cœur de la République démocratique du Congo."
                            }
                        ]
                    }
                ],
