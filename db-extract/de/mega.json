                                "sense_id": "a9dafd50-0495-37ed-8440-b1eb7fe4e73f",
                                "text": "Das ist megaeinfach.",
                                "translation": "It’s super easy.",
                                "english": "It’s super easy."
                            },
                            {
                                "example_id": "4d531cbb-1b78-4f63-b944-839f130cf652",
                                "sense_id": "a9dafd50-0495-37ed-8440-b1eb7fe4e73f",
                                "text": "Er freute sich mega.",
                                "translation": "He was super happy.",
                                "english": "He was super happy."
                            },
                            {
                                "example_id": "3b6b31c9-764c-49f2-ba8b-bc8426cbe554",
                                "sense_id": "a9dafd50-0495-37ed-8440-b1eb7fe4e73f",
                                "text": "Gleichzeitig habe sie sich auch aus Überzeugung für den Journalismus entschieden. „Weil ich denke, dass seine Aufgabe mega wichtig ist für unsere Demokratie“."
                            }
                        ]
                    }
