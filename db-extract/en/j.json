                            {
                                "example_id": "20fcdc2d-239a-4e99-9c3f-b8f78236ea87",
                                "sense_id": "0b8d7ecb-ac78-30bc-85e5-ef88018dbc3b",
                                "text": "I stepped outside to smoke myself a J."
                            },
                            {
                                "example_id": "5c0bb79d-b8ba-490d-9984-7bc88582db7b",
                                "sense_id": "0b8d7ecb-ac78-30bc-85e5-ef88018dbc3b",
