                    },
                    {
                        "translation_id": "4513b1ac-628c-4232-a3e6-de906d39f285",
                        "source_entry_id": "7a5b9c5d-0979-34ed-94ce-b6b35f26313d",
                        "source_sense_id": "6fee35a4-a1cc-37bd-9f9d-630f4648b2ba",
                        "source_sense_description": "Fabricante",
                        "target_lang_word": "Näherin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Näherin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "be6dd66e-154e-3482-b896-b58d5881ff12",
                                        "entry_id": "71dd254c-d039-35b5-8a89-c77a5505c859",
                                        "glosses": [
                                            "weibliche Person, die (meist beruflich) näht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c520b11f-c3da-4266-ac57-d8c94a4aba39",
                                                "sense_id": "be6dd66e-154e-3482-b896-b58d5881ff12",
                                                "text": "Er brachte seine kaputten Hemden zur Näherin."
                                            },
                                            {
                                                "example_id": "6edb511c-d8ee-4f17-b526-6daa5bffe864",
                                                "sense_id": "be6dd66e-154e-3482-b896-b58d5881ff12",
                                                "text": "„Mama arbeitet nicht mehr in der Produktion, sie hat eine Stelle als Näherin in einem der Kinderheime bekommen.“"
                                            },
                                            {
                                                "example_id": "06ccdf99-321f-46b5-9723-58c0f0fae5cb",
                                                "sense_id": "be6dd66e-154e-3482-b896-b58d5881ff12",
                                                "text": "„Die Näherin war schon bestellt, der Heiratsvertrag war aufgesetzt, da bekam der Bauer einen Schlaganfall und starb, ohne wieder zu sich gekommen zu sein.“"
                                            },
                                            {
                                                "example_id": "57f95e8d-906c-4ee3-a054-86141dbd1d88",
                                                "sense_id": "be6dd66e-154e-3482-b896-b58d5881ff12",
                                                "text": "„Auch dazu habe ich an anderer Stelle eine Nachkriegsvariante erzählt, wo eine Lehrerin in den Fünfzigerjahren ihre Schülerinnen fragt, was sie denn werden wollten, und die alle brav mit den damals typischen Frauenberufen antworteten: Stenotypistin will die eine werden, Näherin die andere, Kosmetikerin die dritte, und schließlich sagt eine, dass sie Prostituierte werden will.“"
                                            },
                                            {
                                                "example_id": "90520402-8762-40f6-9f50-60d4bfe2a176",
                                                "sense_id": "be6dd66e-154e-3482-b896-b58d5881ff12",
                                                "text": "„Offiziell war er der Singer-Ausbilder für die vielen Näherinnen der Region.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17631682-c0ec-4b5a-b393-28fe32678510",
                        "source_entry_id": "7a5b9c5d-0979-34ed-94ce-b6b35f26313d",
                        "source_sense_id": "6fee35a4-a1cc-37bd-9f9d-630f4648b2ba",
                        "source_sense_description": "Fabricante",
                        "target_lang_word": "Schneiderin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schneiderin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "449fe9a5-edf9-3434-847d-4da8af23f1d9",
                                        "entry_id": "13d98e71-ff5c-3c3f-894a-a82506320243",
                                        "glosses": [
                                            "weiblicher Schneider"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f275467-1ee5-40eb-b16d-5ee3cca638c3",
                                                "sense_id": "449fe9a5-edf9-3434-847d-4da8af23f1d9",
                                                "text": "Seine Mutter hat den Beruf der Schneiderin gelernt."
                                            },
                                            {
                                                "example_id": "ef332ae8-fdcd-4b4d-b460-76d1bf0ba52b",
                                                "sense_id": "449fe9a5-edf9-3434-847d-4da8af23f1d9",
                                                "text": "„Im Begleittext von Smith erfährt der Leser, dass es sich hier um eine in Armut geratene Schneiderin handelt, die […] ohne Unterstützung und Obdach die Betreuung eines fremden Kindes übernommen hat.“"
                                            },
                                            {
                                                "example_id": "097e5faf-5890-4a54-98f8-427814b14288",
                                                "sense_id": "449fe9a5-edf9-3434-847d-4da8af23f1d9",
                                                "text": "„Als ich, nach Aufforderung durch Serana, die Wohnung das erste Mal betreten hatte, hielt die Schneiderin mich fest.“"
                                            },
                                            {
                                                "example_id": "802d307c-dffd-48c0-a5c6-afcd8171f3c9",
                                                "sense_id": "449fe9a5-edf9-3434-847d-4da8af23f1d9",
                                                "text": "„Während die Schneiderin zuschnitt, begann ihre Tochter zu nähen; aber da eine allein nicht allzuviel leisten konnte, sagte ich der Frau, es wäre uns sehr recht, wenn sie uns noch eine weitere verschaffe, die französisch sprechen könne.“"
                                            },
                                            {
                                                "example_id": "41a7dbb7-755f-457f-b83d-6949c736707d",
                                                "sense_id": "449fe9a5-edf9-3434-847d-4da8af23f1d9",
                                                "text": "„Die meisten Kleider habe ich selbst ihr gekauft, sogar die Änderungen mit den Schneiderinnen besprochen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04ff2dbc-f8c9-489f-a3ff-9bf8b8d37c96",
                        "source_entry_id": "7a5b9c5d-0979-34ed-94ce-b6b35f26313d",
                        "source_sense_id": "6fee35a4-a1cc-37bd-9f9d-630f4648b2ba",
                        "source_sense_description": "Fabricante",
                        "target_lang_word": "seamstress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seamstress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0fbf49f5-906d-3db5-9cde-478e4c2cee7b",
                                        "entry_id": "1cbc25bf-67b7-34dd-a9ea-4f6509a8f4fa",
                                        "glosses": [
                                            "A woman who sews clothes professionally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3da76bf-7f3b-404e-9e42-740ee13f2628",
                                                "sense_id": "0fbf49f5-906d-3db5-9cde-478e4c2cee7b",
                                                "text": "[…] the Seamſtreſs brought in her ſilver thimble, the Chamber-maid her Bodkin, the Cook his ſilver ſpoon, the Vintner his Bowl into the common Treaſury of War and they who contributed to ſo pious a work, were invited more then others in ſome Churches to come to the Holy Communion in the very time of adminiſtration; […]"
                                            },
                                            {
                                                "example_id": "c009b0f7-a300-4bee-88e8-1020c5608b1d",
                                                "sense_id": "0fbf49f5-906d-3db5-9cde-478e4c2cee7b",
                                                "text": "They are seamstresses, who have plied the daily and nightly needle in the service of master tailors and close-fisted contractors, until now it is almost time for each to hem the borders of her own shroud."
                                            },
                                            {
                                                "example_id": "086205aa-8164-4ddf-9a6e-c806236a3c7a",
                                                "sense_id": "0fbf49f5-906d-3db5-9cde-478e4c2cee7b",
                                                "text": "“If you have finished blathering about men, perhaps you won’t mind skipping over the new seamstress you’ve no doubt found?\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5519a428-4092-40f3-b4ee-43d1ae0c12fe",
                        "source_entry_id": "7a5b9c5d-0979-34ed-94ce-b6b35f26313d",
