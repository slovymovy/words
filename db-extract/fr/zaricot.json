                        ],
                        "examples": [
                            {
                                "example_id": "d399a8d3-15ed-4555-a3ff-23d48900f3c6",
                                "sense_id": "c48d97b4-56ca-35c9-98c7-2179f794c0fe",
                                "text": "Tu pouvais écrire sans t'arrêter comme un zaricot symphonique offert gratuitement à tous les amants de l'univers et du Mississipi"
                            },
                            {
                                "example_id": "640f46ea-b838-4038-9f0d-40cef8684bbf",
                                "sense_id": "c48d97b4-56ca-35c9-98c7-2179f794c0fe",
                                "text": "Oh ! le gueux ! s’écria-t-elle, oubliant Vulcain dans sa colère ; y n’veut pas l’épouser, à ce que vous disions ? eh ben ! nous varrons… j’vas faire un zaricot d’son corps à c’te bambocheux… faites préparer ses billets d’enterrement… je n’vous dis que ça ! C’est ben sûr sorti d’la culotte à Cartouche et ça n’veut pas épouser une honnête fille !"
                            },
                            {
                                "example_id": "b047df83-f552-41a2-ad4e-8265e72e11ac",
                                "sense_id": "c48d97b4-56ca-35c9-98c7-2179f794c0fe",
                                "text": "Bon ben apparemment c'est pas un zaricot"
                            }
                        ]
                    }
