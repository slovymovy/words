                                "target_senses": [
                                    {
                                        "sense_id": "26ad57c8-c5b2-3570-8f26-f5972a434308",
                                        "entry_id": "e7253db7-d93c-347e-a03b-91934a947493",
                                        "glosses": [
                                            "sechs mal zehn, die Kardinalzahl zwischen 59 und 61 (siehe auch fünfzig und siebzig)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84bb7aef-bc06-446c-8ab2-31f8544c0e4d",
                                                "sense_id": "26ad57c8-c5b2-3570-8f26-f5972a434308",
                                                "text": "Eine Stunde hat sechzig Minuten."
                                            },
                                            {
                                                "example_id": "0cdbdf73-dc07-454f-a8ae-9813740905d5",
                                                "sense_id": "26ad57c8-c5b2-3570-8f26-f5972a434308",
                                                "text": "Es waren aber ihrer sechzig."
                                            },
                                            {
                                                "example_id": "5738606d-bab0-4448-ae46-c9cfbe8feb18",
                                                "sense_id": "26ad57c8-c5b2-3570-8f26-f5972a434308",
                                                "text": "„Seit die amerikanischen Brüder Orville und Wilbur Wright in Kitty Hawk den ersten Motorflug durchführten, sind kaum mehr als sechzig Jahre vergangen."
                                            },
                                            {
                                                "example_id": "d5de9ac2-a15b-494d-a403-d2497b88961c",
                                                "sense_id": "26ad57c8-c5b2-3570-8f26-f5972a434308",
                                                "text": "„Nach sechzig Jahren politischer Stabilität und mehr oder weniger stetigem Wirtschaftswachstum wird das Nachkriegseuropa, einst ein solides Gebäude, nachgerade baufällig und steht vor einer Identitätskrise, die hässlich zu werden droht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fabbe604-4d76-3a24-9230-5661da5ac5ce",
                                        "entry_id": "e7253db7-d93c-347e-a03b-91934a947493",
                                        "glosses": [
                                            "sechzig Jahre (alt)"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00fc68b7-fcb9-4a02-8688-bdf971c7bdaa",
                                                "sense_id": "fabbe604-4d76-3a24-9230-5661da5ac5ce",
                                                "text": "Mit sechzig ist manch einer schon in Rente."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "12cc0529-d948-301c-882b-6a39249108f1",
                                        "entry_id": "e7253db7-d93c-347e-a03b-91934a947493",
                                        "glosses": [
                                            "mit einer Geschwindigkeit von 60 km/h"
                                        ],
                                        "tags": [
                                            "mit sechzig"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b9a56e8-bac8-4abe-8e4b-fd6182d73147",
                                                "sense_id": "12cc0529-d948-301c-882b-6a39249108f1",
                                                "text": "Sie fuhr mit sechzig durch eine Spielstraße."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
