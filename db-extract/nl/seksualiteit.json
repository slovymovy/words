                                    {
                                        "sense_id": "96c898f6-091e-3b22-81fa-958565bd5d58",
                                        "entry_id": "cddf779f-cbad-3aab-9db4-481c663f020e",
                                        "glosses": [
                                            "sexuální aktivita, potence, sexuální vzrušivost či podnikavost (zájem o sexuální aktivitu nebo účast na ní)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b1e150a-5554-4bd5-83e6-99b653ed9182",
                                                "sense_id": "96c898f6-091e-3b22-81fa-958565bd5d58",
                                                "text": "…sexualita ženy je daleko více ovlivněna psychologickými a vztahovými faktory než sexualita muže, takže se zde častěji promítají i potíže emocionální, spíše než jen potíže čistě tělesného charakteru…"
                                            },
                                            {
                                                "example_id": "c1bdbbc4-3633-494e-afe6-0501efff17f3",
                                                "sense_id": "96c898f6-091e-3b22-81fa-958565bd5d58",
                                                "text": "[V]ýznam sexuality pro udržení páru je ještě větší než to, že mají děti."
                                            },
                                            {
                                                "example_id": "3e2eeceb-3efb-47a6-8433-7243d2abac00",
                                                "sense_id": "96c898f6-091e-3b22-81fa-958565bd5d58",
                                                "text": "Přílišná sexualita má různé důvody. U žen, které trápí hypersexualita, hovoří odborníci o nymfomanii, u mužů pak o satyriáze."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b84d9b8-aa4e-388f-b6c6-a8ef5fd68ac8",
                                        "entry_id": "cddf779f-cbad-3aab-9db4-481c663f020e",
                                        "glosses": [
                                            "sexuální identita, gender"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f402568e-6487-37fa-8a57-167edec459e7",
                                        "entry_id": "cddf779f-cbad-3aab-9db4-481c663f020e",
                                        "glosses": [
                                            "sexuální orientace"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14e55843-ccef-4d71-931e-e059c5401ce0",
                                                "sense_id": "f402568e-6487-37fa-8a57-167edec459e7",
                                                "text": "[Dokument] přináší tísnivé svědectví o utrpení nezletilých Rusů s menšinovou sexualitou. […] [Iniciativa Děti-404 je] internetový projekt, který na sociálních sítích Facebook a VKontakte nabízí pomoc dětem s odlišnou sexualitou."
                                            },
                                            {
                                                "example_id": "a1394097-e274-45e2-8a90-d663915d2c31",
                                                "sense_id": "f402568e-6487-37fa-8a57-167edec459e7",
                                                "text": "Výborně se podařilo vztahy s odlišnou sexualitou zpracovat například v jednom z dílů Soukromých pastí."
                                            },
                                            {
                                                "example_id": "6a7dc92d-2888-4f72-ba11-aa7174d64997",
                                                "sense_id": "f402568e-6487-37fa-8a57-167edec459e7",
                                                "text": "[P]odle řady studií z různých konců světa je kulturní vliv na sexualitu větší u žen než u mužů. Ženy v homofobním prostředí mají méně zkušeností, zatímco u mužů rozdíl mezi homofobní a nehomofobní společností příliš velký není. V homofobním prostředí se jen o homosexuálních zážitcích méně mluví a více se utajují."
                                            },
                                            {
                                                "example_id": "6f67fb72-6b46-49bf-91c8-35ef467086dd",
                                                "sense_id": "f402568e-6487-37fa-8a57-167edec459e7",
                                                "text": "V rozhovoru zdůraznil, že ho nikdy nepřitahovali muži a že jeho genderová identita nemá nic společného se sexualitou. „Nejsem gay. Co vím, tak jsem heterosexuál…“"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
