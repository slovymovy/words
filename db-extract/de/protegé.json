                ],
                "senses": [
                    {
                        "sense_id": "ae163080-28c8-36b6-9739-569d31fe223e",
                        "entry_id": "0cd5bd77-1e8d-3aa5-8a0c-55cd287e6724",
                        "glosses": [
                            "junge Person, die von einer älteren Person mit gesellschaftlichem Einfluss und/oder mehr Erfahrung auf einem Gebiet gefördert wird"
                        ],
                        "tags": [
                            "archaic",
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "439b4dc0-87d7-4826-9e41-efe0a9fb947a",
                                "sense_id": "ae163080-28c8-36b6-9739-569d31fe223e",
                                "text": "Mein Protegé macht große Fortschritte."
                            },
                            {
                                "example_id": "7985c597-717a-4c58-96ce-8e868be4f958",
                                "sense_id": "ae163080-28c8-36b6-9739-569d31fe223e",
                                "text": "„Roth lud sein Protegé ein, an seinem Seminar teilzunehmen, wo er auf die beinahe krankhaft schüchterne Frau zeigte und »Harpo!« rief, wenn er sie aufforderte, etwas zu sagen.“"
                            },
                            {
                                "example_id": "9fc568da-aa71-4a62-b500-8a4d52d51427",
                                "sense_id": "ae163080-28c8-36b6-9739-569d31fe223e",
                                "text": "„Da solche Protegés immer auch illoyal werden und im schlimmsten Fall sich sogar gegen die pakistanischen Streitkräfte wenden können, gehört es zu den größten Herausforderungen für die Armee, solche Entwicklungen im Auge zu behalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60a2d93c-7b07-4694-ab98-b7d3d9c60e92",
                        "source_entry_id": "0cd5bd77-1e8d-3aa5-8a0c-55cd287e6724",
                        "source_sense_id": "ae163080-28c8-36b6-9739-569d31fe223e",
                        "source_sense_description": "bevorzugt geförderte Person",
                        "target_lang_word": "protégé",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "protégé",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f2826de-6242-3fdf-b244-15236b4e7bab",
                                        "entry_id": "66bbdee9-c42e-36d2-894f-654816c70d8d",
                                        "glosses": [
                                            "A person who is guided and supported by an older and more experienced person (a protector or mentor)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2261276f-497c-48d1-8abb-fc5e721e35d3",
                                                "sense_id": "3f2826de-6242-3fdf-b244-15236b4e7bab",
                                                "text": "His status as a protégé of the great artist had many benefits, but was ultimately a burden."
                                            },
                                            {
                                                "example_id": "2a742b8f-cd12-4edd-8915-f63c2388c0c1",
                                                "sense_id": "3f2826de-6242-3fdf-b244-15236b4e7bab",
                                                "text": "While Yau was in China, he visited Xi-Ping Zhu, a protégé of his who was now chairman of the mathematics department at Sun Yat-sen University."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f65469a-72be-4217-9889-2b87dff7637e",
                        "source_entry_id": "0cd5bd77-1e8d-3aa5-8a0c-55cd287e6724",
                        "source_sense_id": "ae163080-28c8-36b6-9739-569d31fe223e",
                        "source_sense_description": "bevorzugt geförderte Person",
                        "target_lang_word": "protégé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "protégé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f81ecf17-cc66-392b-936d-849b618104ad",
                                        "entry_id": "de232d3c-2a52-3f73-a9b8-22e50659eb2a",
                                        "glosses": [
                                            "En parlant des choses, mis à l’abri."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc47c2d4-f427-449b-8382-a428f440753b",
                                                "sense_id": "f81ecf17-cc66-392b-936d-849b618104ad",
                                                "text": "Périmètre protégé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b13bb3c-75c5-38ab-8b08-b8a25941394f",
                                        "entry_id": "de232d3c-2a52-3f73-a9b8-22e50659eb2a",
                                        "glosses": [
                                            "En parlant des personnes, bénéficiant d’une protection de la part d’un puissant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c9cbee71-f6fd-3502-9d66-09e3c3efb2a5",
                                        "entry_id": "de232d3c-2a52-3f73-a9b8-22e50659eb2a",
                                        "glosses": [
                                            "Se dit d’une variable dont la portée est restreinte aux classes qui en héritent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "protégé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "68128467-8570-36b8-b73f-3b5781bc3f10",
                                        "entry_id": "920d87c7-7b56-3ad3-a566-dd68aeb89c80",
                                        "glosses": [
                                            "Personne qui bénéficie d’une protection de la part de quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d990fa2-c277-4e40-bec3-50f5f27fd7cc",
                                                "sense_id": "68128467-8570-36b8-b73f-3b5781bc3f10",
                                                "text": "Le protégé ne peut se passer de la compétence du protecteur, de sa force et de sa vigilance."
                                            },
                                            {
                                                "example_id": "86337f49-7425-46cb-8344-5875db1e6010",
                                                "sense_id": "68128467-8570-36b8-b73f-3b5781bc3f10",
                                                "text": "C’est sa protégée."
                                            },
                                            {
                                                "example_id": "057eb6e1-3d25-4fca-8cd3-04d3c5e4a1e5",
                                                "sense_id": "68128467-8570-36b8-b73f-3b5781bc3f10",
                                                "text": "Cet homme est un des protégés du ministre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "protégé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "733ae2d7-8c97-3aab-9f38-5854fde83ed7",
                                        "entry_id": "3b464c46-52a0-37d5-922d-50f14006fcb5",
                                        "glosses": [
                                            "Participe passé de protéger."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab5fe076-5d3e-4ea6-8e84-120498ea87d0",
                                                "sense_id": "733ae2d7-8c97-3aab-9f38-5854fde83ed7",
                                                "text": "Aussi le bélier avait-il besoin d’être protégé des actions des assiégés : il était donc habituellement couvert par un chat ou manteau."
                                            }
                                        ]
                                    }
                                ]
