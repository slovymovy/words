                                            {
                                                "example_id": "9a7be299-a143-4fe3-b302-c0a9d5f86561",
                                                "sense_id": "04a5c2ea-3665-3594-ae7d-e240586be162",
                                                "text": "Near-synonyms: reputedly, purportedly, putatively, rumoredly, supposedly, allegedly, ostensibly, possibly, probably, likely, plausibly"
                                            },
                                            {
                                                "example_id": "11a4cbd9-5fd3-4508-98f5-8937d88744de",
                                                "sense_id": "04a5c2ea-3665-3594-ae7d-e240586be162",
                                                "text": "Other opposition forces have reportedly pushed to Ajdabiya, west of Benghazi […]"
                                            },
                                            {
                                                "example_id": "367a598c-6317-4579-b4a9-31de5ec658fd",
                                                "sense_id": "04a5c2ea-3665-3594-ae7d-e240586be162",
                                                "text": "Nintoku, the pseudolegendary emperor of the fourth century, reportedly enjoyed falconry."
                                            },
                                            {
                                                "example_id": "e48e07de-d155-4fea-81ad-eff34f3fb95d",
                                                "sense_id": "04a5c2ea-3665-3594-ae7d-e240586be162",
                                                "text": "Coristine, who had signed onto the telemeeting using a non-government email address, gave the bureaucrats swift marching orders, telling them he needed access to the federal department’s contract and payment systems before reportedly making them justify their jobs at the $1 billion-budget administration."
                                            }
                                        ]
                                    }
                                ]
