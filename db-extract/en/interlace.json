                        ],
                        "examples": [
                            {
                                "example_id": "797c1c36-dd06-48ba-ab70-34be2df2474e",
                                "sense_id": "bb6127d3-110e-38b5-b2be-c3c6446a61cc",
                                "text": "interlacing branches"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38060748-4d8a-432f-8525-c9e1dd5e9c6d",
                        "source_entry_id": "0913d274-2e47-3989-b77d-19297148d08e",
                        "source_sense_description": "to cross one with another",
                        "target_lang_word": "entrelacer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entrelacer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "41ea9921-7073-3906-8ed4-80335a8cb884",
                                        "entry_id": "d05da0eb-a081-3bcb-972d-96da0be55ac6",
                                        "glosses": [
                                            "Enlacer l’un dans l’autre, en parlant de choses ou de personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7efbff4d-9b19-42b6-8b9f-b0c52eea8bc5",
                                                "sense_id": "41ea9921-7073-3906-8ed4-80335a8cb884",
                                                "text": "Entrelacer des branches d’arbres l’une dans l’autre."
                                            },
                                            {
                                                "example_id": "1a79b7cd-78b3-460e-b187-76d531053a2b",
                                                "sense_id": "41ea9921-7073-3906-8ed4-80335a8cb884",
                                                "text": "Entrelacer les cheveux de rubans, de fleurs, de perles, de diamants."
                                            },
                                            {
                                                "example_id": "de3f4df7-20ac-42c0-bf42-67c03a720040",
                                                "sense_id": "41ea9921-7073-3906-8ed4-80335a8cb884",
                                                "text": "Des branches qui s’entrelacent. — Des chiffres entrelacés."
                                            },
                                            {
                                                "example_id": "855e752b-190f-4ac1-bd54-2981eae520db",
                                                "sense_id": "41ea9921-7073-3906-8ed4-80335a8cb884",
                                                "text": "Mais toujours la pensée de l’absente était indissolublement mêlée aux actes les plus simples de la vie de Swann —déjeuner, recevoir son courrier, sortir, se coucher— par la tristesse même qu’il avait à les accomplir sans elle, comme ces initiales de Philibert le Beau que dans l’église de Brou, à cause du regret qu’elle avait de lui, Marguerite d’Autriche entrelaça partout aux siennes."
                                            },
                                            {
                                                "example_id": "2fb3d9da-9a34-48a4-a7a7-e4dd4dfc3213",
                                                "sense_id": "41ea9921-7073-3906-8ed4-80335a8cb884",
                                                "text": "Le fils du pharmacien, petit noceur à figure de cocher, entrelaçait des initiales sur un napperon, et le gros Glaume, veuf à marier, remplissait de laine alternativement magenta et vieil or les quadrillages d’une pantoufle."
                                            },
                                            {
                                                "example_id": "b3036f7f-893e-44bc-a3a5-74f7220d4582",
                                                "sense_id": "41ea9921-7073-3906-8ed4-80335a8cb884",
                                                "text": "Ces martyrs allaient à la mort entrelacés."
                                            },
                                            {
                                                "example_id": "1b007d44-73ab-4e9b-a5a1-348b1f27e60f",
                                                "sense_id": "41ea9921-7073-3906-8ed4-80335a8cb884",
                                                "text": "Au moment du naufrage, ils se tenaient entrelacés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "702c803c-1ece-49f9-97cc-7f31653a6eee",
                        "source_entry_id": "0913d274-2e47-3989-b77d-19297148d08e",
                        "source_sense_description": "to cross one with another",
                        "target_lang_word": "verflechten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verflechten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "870acf29-dd06-3efb-aff6-b9e6a3ae96e1",
                                        "entry_id": "8d7bd23d-b10d-3b24-8b8f-3562d04e7948",
                                        "glosses": [
                                            "etwas durch Flechten eng miteinander verbinden"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30ea4d02-9930-4d69-b471-455af2cdfc73",
                                                "sense_id": "870acf29-dd06-3efb-aff6-b9e6a3ae96e1",
                                                "text": "Damit das so bleibt, will Porsche-Chef Wendelin Wiedeking beide Unternehmen organisatorisch nicht verflechten - noch nicht jedenfalls."
                                            },
                                            {
                                                "example_id": "e4f0e41b-f756-4be0-b98d-6f112259530d",
                                                "sense_id": "870acf29-dd06-3efb-aff6-b9e6a3ae96e1",
                                                "text": "Möge das wundervolle Land, das, wie Deutschland, zugleich einig und stark geworden ist, allen inneren Gegnern zum Trotz, die Bande der Einigkeit in Zukunft nur immer dichter und fester verflechten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7c1ee5f7-7191-3e33-893f-0eafafd1ba9c",
                                        "entry_id": "8d7bd23d-b10d-3b24-8b8f-3562d04e7948",
                                        "glosses": [
                                            "sich eng verbinden"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e180dcb1-9da0-426d-a59b-cacf2b9c7379",
                                                "sense_id": "7c1ee5f7-7191-3e33-893f-0eafafd1ba9c",
                                                "text": "Wie in einem Webstuhl verflechten sich manche Pflanzen mit dem Zaun und hüllen ihn in einen zarten Blütenschleier."
                                            },
                                            {
                                                "example_id": "e511ecdb-e108-42ef-b1d0-2486397b002c",
                                                "sense_id": "7c1ee5f7-7191-3e33-893f-0eafafd1ba9c",
                                                "text": "\"Aktionen von Betreibern und Besuchern\", stellt sie fest, \"sind zu einem gewissen Maß interdependent und verflechten sich über den Abend hinweg.\""
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e776695-6e9c-4a54-8899-c46eac24306d",
                        "source_entry_id": "0913d274-2e47-3989-b77d-19297148d08e",
                        "source_sense_description": "to cross one with another",
                        "target_lang_word": "verschränken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verschränken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5fa3a2c1-e5af-3700-a87b-ec1605a8be1c",
                                        "entry_id": "f0175619-7c92-3c77-a5a7-5dcab91dd14a",
                                        "glosses": [
                                            "zwei Teile so umeinander winden, dass die Verbindung stabil ist"
                                        ],
                                        "tags": [
                                            "oft über Gliedmaßen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66178d9d-93ef-4b39-bb6f-32cc5e70f4de",
                                                "sense_id": "5fa3a2c1-e5af-3700-a87b-ec1605a8be1c",
                                                "text": "Sie verschränkt die Hände hinter dem Kopf und lächelt mich an."
                                            },
                                            {
                                                "example_id": "f5a140dc-5d2c-40e4-91c3-959332f0c37d",
                                                "sense_id": "5fa3a2c1-e5af-3700-a87b-ec1605a8be1c",
                                                "text": "„Indem das Bild sich in diesem Zeigen zugleich als das Zeigende zeigt, sind Sinn und Sinnlichkeit verschränkt.“"
                                            },
                                            {
                                                "example_id": "203962c9-9ca5-4393-a742-4e55aa350fda",
                                                "sense_id": "5fa3a2c1-e5af-3700-a87b-ec1605a8be1c",
                                                "text": "„[…] und der vor Augenblicken unendliche Raum flocht sich zum Strick. Ihm zu entgehen verschränktet und küßtet ihr euch ineinander. Wenig später war das Zimmer eng wie ein Grab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
