                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "89409bf0-f8ad-4923-bd11-c3c8201f5c62",
                        "entry_id": "729a237d-ce93-3fce-8b69-3781f68b4381",
                        "tags": [
                            "plural"
                        ],
                        "form": "vlooienmarkten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "acf5ed1d-05ec-375b-8b00-a8da20e11588",
                        "entry_id": "729a237d-ce93-3fce-8b69-3781f68b4381",
                        "glosses": [
                            "rommelmarkt, luizenmarkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0274c9a2-e31a-4c91-8fc3-d978c6ac604e",
                                "sense_id": "acf5ed1d-05ec-375b-8b00-a8da20e11588",
                                "text": "Een jongeheer van dertien jaar kocht deze afleveringen aan een boekenstalletje op de marché aux puces (vlooienmarkt) voor de nietige som van acht sous."
                            },
                            {
                                "example_id": "63d8b9e3-1d64-417b-905e-1ac191865769",
                                "sense_id": "acf5ed1d-05ec-375b-8b00-a8da20e11588",
                                "text": "`Waar hebben jullie deze tafel gekocht?' vroeg Luc. `Op een alleraardigste vlooienmarkt. Ergens buiten. Haha.' Niemand lachte mee. Eduard streelde de tafel. Hij was verliefd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b213bec-4f27-4a46-a718-b23796e194c8",
                        "source_entry_id": "729a237d-ce93-3fce-8b69-3781f68b4381",
                        "source_sense_id": "acf5ed1d-05ec-375b-8b00-a8da20e11588",
                        "target_lang_word": "Flohmarkt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flohmarkt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cbb5b6f8-0133-33d0-a9d1-0e1efabd690a",
                                        "entry_id": "24d55c82-9461-3167-987c-31307bd7b8ae",
                                        "glosses": [
                                            "Markt, auf dem alte, gebrauchte, oft geringwertige Waren zum Verkauf angeboten werden, überwiegend von Privatpersonen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bece8b0-5010-4736-a44e-42d22ccc92b6",
                                                "sense_id": "cbb5b6f8-0133-33d0-a9d1-0e1efabd690a",
                                                "text": "In Hannover findet am Wochenende regelmäßig ein Flohmarkt statt."
                                            },
                                            {
                                                "example_id": "08d63849-4ead-4870-8e77-f03c9c5c9659",
                                                "sense_id": "cbb5b6f8-0133-33d0-a9d1-0e1efabd690a",
                                                "text": "„Von solchen Erinnerungen geplagt habe ich mir neulich auf dem Flohmarkt im Mauerpark sogar einen Massagelöffel gekauft.“"
                                            },
                                            {
                                                "example_id": "88da5bdf-8c64-4b83-9636-72e4a5378243",
                                                "sense_id": "cbb5b6f8-0133-33d0-a9d1-0e1efabd690a",
                                                "text": "„Auf einem Flohmarkt in München lernte er Ende September einen Mann kennen, der darüber fluchte, wie man mit Flüchtlingen umgehe.“"
                                            },
                                            {
                                                "example_id": "aee63cdd-f5a7-4245-8717-63712d6d0f55",
                                                "sense_id": "cbb5b6f8-0133-33d0-a9d1-0e1efabd690a",
                                                "text": "„Tagsüber streifte er auf dem Boulevard Saint-Germain herum, trank einen guten Kaffee, saß an der Seine, besuchte Flohmärkte in den alten Pariser Hallen.“"
                                            },
                                            {
                                                "example_id": "0488a10c-40ed-4f0f-bece-83ccb109c9ab",
                                                "sense_id": "cbb5b6f8-0133-33d0-a9d1-0e1efabd690a",
                                                "text": "„Ich kaufte auf dem Flohmarkt einen alten vergoldeten Rahmen dafür.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "598e8762-dd4d-49cf-9d45-3c84fe008b6d",
                        "source_entry_id": "729a237d-ce93-3fce-8b69-3781f68b4381",
                        "source_sense_id": "acf5ed1d-05ec-375b-8b00-a8da20e11588",
                        "target_lang_word": "Trödelmarkt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trödelmarkt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f3718844-68d3-302e-8536-fe61b40a6163",
                                        "entry_id": "4e5600be-5027-3bde-82fe-dd6f2304f117",
                                        "glosses": [
                                            "Markt, auf dem meist alte, gebrauchte Waren von geringem Wert zum Verkauf angeboten werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef1100e2-21ca-4bff-8cf3-4af4ea1d7ec4",
                                                "sense_id": "f3718844-68d3-302e-8536-fe61b40a6163",
                                                "text": "Sie erstanden auf dem Trödelmarkt viele alte Schallplatten."
                                            },
                                            {
                                                "example_id": "b9a4dd24-8133-4d42-8b83-088656373e39",
                                                "sense_id": "f3718844-68d3-302e-8536-fe61b40a6163",
                                                "text": "„Sie sprechen zu diesem Zweck nicht nur private Kunstsammler an, die hier neuerdings in großer Zahl vorhanden sind, sondern gehen auch auf Trödelmärkte, wo Tafelbilder zu Spottpreisen verramscht werden.“"
                                            },
                                            {
                                                "example_id": "66cde06d-2653-43aa-99cc-d758e8180bda",
                                                "sense_id": "f3718844-68d3-302e-8536-fe61b40a6163",
                                                "text": "„Als Pierre in seinem Kutscherkaftan, den Gerassim ihm besorgt und ausgekocht hatte, mit dem alten Diener zusammen zum Trödelmarkt am Sucharew-Turm gegangen war, um sich dort eine Pistole zu kaufen, war er den Rostows begegnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "afe57ddb-8a4a-4665-81c5-5a7c080dad25",
                        "source_entry_id": "729a237d-ce93-3fce-8b69-3781f68b4381",
                        "source_sense_id": "acf5ed1d-05ec-375b-8b00-a8da20e11588",
                        "target_lang_word": "flea market",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flea market",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28ad17ff-2d4b-3e70-be98-9e84c6111600",
                                        "entry_id": "e65eb451-5fea-30c8-af9f-2ff736917637",
                                        "glosses": [
                                            "An outdoor temporary market selling inexpensive antiques, curios, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45f6e52e-1f1c-42ff-8082-986c973a1af1",
                                                "sense_id": "28ad17ff-2d4b-3e70-be98-9e84c6111600",
                                                "text": "Although things are sold cheaper at the flea market, it's always a good idea to check whether the item is stolen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6320489f-4125-3907-92b1-6815ffd07140",
                                        "entry_id": "e65eb451-5fea-30c8-af9f-2ff736917637",
                                        "glosses": [
                                            "A permanent indoor market of stalls in a warehouse selling inexpensive antiques, outdated goods, curios, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "faa7dcec-e117-4e70-b403-6932426f8fa4",
                                                "sense_id": "6320489f-4125-3907-92b1-6815ffd07140",
                                                "text": "The Towne Hall is a big inflatable building in the middle of the Snooze ’n’ Crusie. It is Derelict Las Vegas: convenience store, video arcade, laundromat, bar, liquor store, flea market, whorehouse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c05e2794-4fd7-4950-ad49-ca9d7a5f84f1",
                        "source_entry_id": "729a237d-ce93-3fce-8b69-3781f68b4381",
                        "source_sense_id": "acf5ed1d-05ec-375b-8b00-a8da20e11588",
                        "target_lang_word": "marché aux puces",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marché aux puces",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "47bb45d6-7cf9-3edc-852d-b784bc34e3c0",
                                        "entry_id": "28ab28bb-43fe-3d81-b2cf-f4685575d368",
                                        "glosses": [
                                            "Marché où se vendent des objets d’occasion, souvent de faible valeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36cee2f5-6c26-4b53-9dc3-9111d43f6e18",
                                                "sense_id": "47bb45d6-7cf9-3edc-852d-b784bc34e3c0",
                                                "text": "L’ensemble de l’étalage rappelle les exhibitions de ce marché de brocanteurs dénommé « le Marché aux puces »."
                                            },
                                            {
                                                "example_id": "3dc20a3e-dbc6-4117-ba97-6e5cb62890ab",
                                                "sense_id": "47bb45d6-7cf9-3edc-852d-b784bc34e3c0",
                                                "text": "Les flâneries du photographe au marché aux puces, avec des prises de vue échelonnées sur six ans, n'ont pas le même degré d'étrangeté : le marché aux puces est, dans l'entre-deux-guerres, un motif littéraire et plastique fréquent."
                                            },
                                            {
                                                "example_id": "fe9c3e90-7b89-4753-bb26-53432338491c",
                                                "sense_id": "47bb45d6-7cf9-3edc-852d-b784bc34e3c0",
                                                "text": "Mais Minouche tirait déjà un casier puis deux d’un vieux meuble de musée qu’elle avait découvert au marché aux puces et qu’elle avait, elle-même, gratté et reverni."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
