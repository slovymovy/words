                        "entry_id": "19e5d1df-06af-3347-bd19-7c01d156531b",
                        "glosses": [
                            "mężczyzna zabiegający o względy kobiety, starający się o jej rękę"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "b9edc749-220c-4b97-8dbf-24d51418b227",
                                "sense_id": "94dd3a41-a6a1-36a3-baa9-fb3c63adb19c",
                                "text": "Ojciec naliczył już piętnastu zalotników, których Marzena zawsze po czasie odpychała."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
