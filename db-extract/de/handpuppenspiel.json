                "senses": [
                    {
                        "sense_id": "ede84e60-6856-35dc-836a-d7436cf2bdef",
                        "entry_id": "a1b65c82-be42-36fe-83db-66e055569caf",
                        "glosses": [
                            "Form des Theaters, bei dem handgeführte Puppen als Schauspieler auf einer kleinen Bühne agieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14fb91ec-ead4-482e-a0f6-76486fe43c08",
                                "sense_id": "ede84e60-6856-35dc-836a-d7436cf2bdef",
                                "text": "„Bevor ein Kind etwa ein Handpuppenspiel derart zu beherrschen versteht, dass es ein wirkliches Spiel im sozialen Raum wird, ist es der Grundschule meist schon entwachsen.“"
                            },
                            {
                                "example_id": "5a5f95c9-9b10-4791-b628-a782c44cee61",
                                "sense_id": "ede84e60-6856-35dc-836a-d7436cf2bdef",
                                "text": "„Auf Stöcke gesteckt, lassen wir sie etwa acht Tage lang gut austrocknen, bevor wir sie mit Plakatfarben bemalen können. Inzwischen fertigen wir bereits die Kostüme an, vgl. die Handpuppenspiele.“"
                            },
                            {
                                "example_id": "6c66d53e-2d4e-4026-839a-fe6c39fad0e0",
                                "sense_id": "ede84e60-6856-35dc-836a-d7436cf2bdef",
                                "text": "„Der Senior des deutschen Puppenspiels selbst, Max Jacob, leitet ihn; er erzählt von seinen ‚Hohnsteinern’, mit denen er seit 1921 das Handpuppenspiel auf ein bis dahin unbekanntes künstlerisches und literarisches Niveau erhoben, ja, geradezu den Stil für das ernstzunehmende Puppentheater geschaffen hat.“"
                            },
                            {
                                "example_id": "88f0a029-8d01-45fc-a0ac-91decf4ca9b4",
                                "sense_id": "ede84e60-6856-35dc-836a-d7436cf2bdef",
                                "text": "„In dem lustigen Handpuppenspiel mit Musik für Kinder ab 7 Jahren geht es um Mut, Feigheit, Liebe und natürlich den Sieg des Guten über das Böse.“"
                            },
                            {
                                "example_id": "6b0fcf43-0639-436d-92a8-1969e85b83c7",
                                "sense_id": "ede84e60-6856-35dc-836a-d7436cf2bdef",
                                "text": "„Jede Stundensendung ist eine bunte Mischung aus werbespotähnlichen Trickfilmen, in denen das Abc, die Zahlen von 1 bis 10 und geometrische Formen in atemberaubendem Tempo und psychedelischen Bildern dargestellt werden, aus Handpuppenspielen und aus Straßenszenen, in denen es um Probleme des Zusammenlebens, um allgemeine Erfahrungen geht, bei denen aber auch Lehrinhalte von Trick- und Puppenfilmen wieder aufgenommen und variiert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
