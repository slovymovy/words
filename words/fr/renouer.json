    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "14b0845f-13d4-31d2-8b6a-d0db0e3bf98e",
                    "sense_definition": "Reprendre des relations personnelles, sociales ou diplomatiques qui avaient été interrompues.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "relations",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs années de silence, elle souhaite enfin <w>renouer</w> les liens avec sa sœur."
                        },
                        {
                            "text": "Les deux pays ont décidé de <w>renouer</w> le dialogue afin de négocier un accord de paix durable."
                        }
                    ],
                    "synonyms": [
                        "se réconcilier"
                    ],
                    "antonyms": [
                        "rompre",
                        "se brouiller"
                    ],
                    "common_phrases": [
                        "renouer le contact",
                        "renouer des liens",
                        "renouer le dialogue"
                    ]
                },
                {
                    "sense_id": "012f951e-fc0d-3801-802e-74b99db291de",
                    "sense_definition": "Nouer ou attacher de nouveau quelque chose qui était défait ou cassé.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'arrête un instant au bord du chemin pour <w>renouer</w> ses lacets défaits."
                        },
                        {
                            "text": "L'enfant essaie patiemment de <w>renouer</w> le ruban rouge de son paquet cadeau."
                        }
                    ],
                    "synonyms": [
                        "rattacher"
                    ],
                    "antonyms": [
                        "dénouer",
                        "détacher"
                    ],
                    "common_phrases": [
                        "renouer ses lacets",
                        "renouer un ruban"
                    ]
                },
                {
                    "sense_id": "c189e137-882d-3248-9809-08f3bfd310c8",
                    "sense_definition": "Retrouver ou recommencer une habitude, une tradition ou un état interrompu.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reprise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette équipe sportive espère bien <w>renouer</w> avec le succès après une série de défaites."
                        },
                        {
                            "text": "L'orateur prend un moment de silence pour <w>renouer</w> le fil de son discours."
                        }
                    ],
                    "synonyms": [
                        "retrouver"
                    ],
                    "antonyms": [
                        "abandonner",
                        "délaisser"
                    ],
                    "common_phrases": [
                        "renouer avec le succès",
                        "renouer avec la tradition",
                        "renouer le fil"
                    ]
                }
            ]
        }
    ]
}