                ],
                "senses": [
                    {
                        "sense_id": "d3e6e620-c6fe-3572-830e-259ffd55d6bf",
                        "entry_id": "6e046102-d9b3-3d92-ba17-d7f0d6a63a77",
                        "glosses": [
                            "hohe Konzentration von Schadstoffen in der Luft, wie sie sich über dicht besiedelten Räumen bilden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02913327-64db-4855-b1e8-d98a167a4463",
                                "sense_id": "d3e6e620-c6fe-3572-830e-259ffd55d6bf",
                                "text": "In Städten wie Peking oder Shanghai bildet sich häufig Smog."
                            },
                            {
                                "example_id": "246b1d7d-f9b2-4eec-9d87-aae94d0a80a4",
                                "sense_id": "d3e6e620-c6fe-3572-830e-259ffd55d6bf",
                                "text": "„Ich blickte mich um und versuchte über dem blauen Smog hinter der mehrspurigen Flughafenausfahrt Straßen und Berge zu erkennen.“"
                            },
                            {
                                "example_id": "dcd9ed65-4188-46d3-9f05-1fafed28c0db",
                                "sense_id": "d3e6e620-c6fe-3572-830e-259ffd55d6bf",
                                "text": "„Ich ging zielstrebig durch den Smog.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc42833d-6f62-4aa6-9bb9-b3fccc01608f",
                        "source_entry_id": "6e046102-d9b3-3d92-ba17-d7f0d6a63a77",
                        "source_sense_id": "d3e6e620-c6fe-3572-830e-259ffd55d6bf",
                        "source_sense_description": "hohe Konzentration von Schadstoffen in der Luft, wie sie sich über dicht besiedelten Räumen bilden kann",
                        "target_lang_word": "smog",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "smog",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a84a8d5d-b498-31a5-85b7-c78d9f3d85cc",
                                        "entry_id": "0177898d-70d5-3832-8961-e978ba883546",
                                        "glosses": [
                                            "A noxious mixture of particulates and gases that is the result of urban air pollution."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "474c21d9-2278-4acd-b839-e9ea5f2db1d7",
                                                "sense_id": "a84a8d5d-b498-31a5-85b7-c78d9f3d85cc",
                                                "text": "A widow since 1967, she lives now in Honolulu because, she says, she can enjoy the Californialike climate without the smog."
                                            },
                                            {
                                                "example_id": "64bd860e-09c8-4e95-9377-2831f0343992",
                                                "sense_id": "a84a8d5d-b498-31a5-85b7-c78d9f3d85cc",
                                                "text": "Everyone smoked so if the auditorium was full, the whole room would be filled with smoke in next to no time. It was like the legendary London smog of the 1950s in there sometimes. You took it in turn to “flash the ash” as it was called."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "smog",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e06f842-e01a-3fe9-b553-5f4b1158d828",
                                        "entry_id": "e1e20b67-f4dd-3bc4-9a72-ecc39d68ad2b",
                                        "glosses": [
                                            "To get a smog check; to check a vehicle or have it checked for emissions."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d3d3f49-b7af-46b7-a68e-a1384035fe82",
                                                "sense_id": "1e06f842-e01a-3fe9-b553-5f4b1158d828",
                                                "text": "If the car is more than five years old, you'll have to have it smogged before you can register it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16acafbb-afaf-4a3c-8e56-b60781df592b",
                        "source_entry_id": "6e046102-d9b3-3d92-ba17-d7f0d6a63a77",
                        "source_sense_id": "d3e6e620-c6fe-3572-830e-259ffd55d6bf",
                        "source_sense_description": "hohe Konzentration von Schadstoffen in der Luft, wie sie sich über dicht besiedelten Räumen bilden kann",
                        "target_lang_word": "smog",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "smog",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ccf9500-e88e-3580-8266-d54eac946239",
                                        "entry_id": "0fef87c7-4cb6-3b7a-8be5-3b2c6a10405f",
                                        "glosses": [
                                            "Brume bleutée à roussâtre provenant d’un mélange de polluants atmosphériques qui limite la visibilité dans l’atmosphère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cab0907f-e1f3-49db-a144-3adfef0db987",
                                                "sense_id": "0ccf9500-e88e-3580-8266-d54eac946239",
                                                "text": "Michel accéléra pour échapper à la meute, ce qui déclara dans un cumulo-stratus immaculé une toux généralisée et la mise à pied d’une centaine de coursiers égarés dans le smog."
                                            },
                                            {
                                                "example_id": "0fe3ab4d-0678-4c19-8593-ede033816242",
                                                "sense_id": "0ccf9500-e88e-3580-8266-d54eac946239",
                                                "text": "On sait déjà que la Coupe du monde 2022 ne sera pas celle de l’écologie. Le smog de Doha et les gros pick-up américains qui occupent les larges routes locales ne sont pas là pour le démentir"
                                            },
                                            {
                                                "example_id": "71076b9a-6242-4de9-8329-1470739ed7d3",
                                                "sense_id": "0ccf9500-e88e-3580-8266-d54eac946239",
                                                "text": "Par beau temps, il paraît qu’on aperçoit la cordillère des Andes, mais en ce lendemain d’orage, on ne distingue guère qu’une mégalopole recouverte d’un smog à couper au couteau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38864d62-de9c-4e4b-b8f0-c2f21f3dca15",
                        "source_entry_id": "6e046102-d9b3-3d92-ba17-d7f0d6a63a77",
                        "source_sense_id": "d3e6e620-c6fe-3572-830e-259ffd55d6bf",
                        "source_sense_description": "hohe Konzentration von Schadstoffen in der Luft, wie sie sich über dicht besiedelten Räumen bilden kann",
                        "target_lang_word": "smog",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "smog",
