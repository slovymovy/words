                    {
                        "translation_id": "a9500811-1d90-4cd2-b59c-04d66e96b45d",
                        "source_entry_id": "8390faa9-08d9-3762-b36a-d16eb384bbc6",
                        "source_sense_description": "растение",
                        "target_lang_word": "plaquebière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plaquebière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f79168f7-605d-3795-8799-52d1a95a6694",
                                        "entry_id": "14209c47-4009-37ec-a61b-0b2e6dba5b88",
                                        "glosses": [
                                            "Nom vernaculaire de Rubus chamaemorus , petite plante vivace, ronces avec peu d’épines, typiques des tourbières des pays nordiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb4340e7-eeb0-4349-8b27-04c461369d6c",
                                                "sense_id": "f79168f7-605d-3795-8799-52d1a95a6694",
                                                "text": "Le blason représente un plant de plaquebière, ou mûre arctique, plante répandue dans la région."
                                            },
                                            {
                                                "example_id": "64516acc-8aab-4954-9451-7f3bb359e41c",
                                                "sense_id": "f79168f7-605d-3795-8799-52d1a95a6694",
                                                "text": "Des sommets couverts de la toundra alpine, où les plaquebières ambrées brillent parmi les conifères nains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3793a69-8843-3d47-ba35-107e7df45944",
                                        "entry_id": "14209c47-4009-37ec-a61b-0b2e6dba5b88",
                                        "glosses": [
                                            "Fruit de cette plante, d’abord rouge puis jaune d’or à maturité, utilisé pour les confitures et dont on fait une liqueur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df0e1e0a-9a8f-42ea-a9f8-d2f114c675b4",
                                                "sense_id": "f3793a69-8843-3d47-ba35-107e7df45944",
                                                "text": "On travaillait au jardin, on allait aux plaquebières, on cueillait des coques et du homard sur les grèves."
                                            },
                                            {
                                                "example_id": "03a44549-9cbf-4c06-b665-67dbf88ed160",
                                                "sense_id": "f3793a69-8843-3d47-ba35-107e7df45944",
                                                "text": "Les ours dévorent les météorologues, les chiens veillent, les étés offrent les joies de la pêche et de la cueillette des plaquebières."
                                            },
                                            {
                                                "example_id": "7b2769b8-c9d6-40c4-a088-8dbb96efd1bb",
                                                "sense_id": "f3793a69-8843-3d47-ba35-107e7df45944",
                                                "text": "La plaquebière ressemble à une framboise orangée, tandis que l’aronie est une baie rouge ou noire."
                                            },
                                            {
                                                "example_id": "cde489f3-3642-4ba0-b34b-c35a41aa622e",
                                                "sense_id": "f3793a69-8843-3d47-ba35-107e7df45944",
                                                "text": "Les lignes de dunes jetées par le vent y alternent avec des dépressions longitudinales devenues, avec les siècles, d’étroites tourbières humides — dites sayons dans le pays — où les Madelinots vont cueillir les plaquebières et les mocôques."
                                            },
                                            {
                                                "example_id": "0e226b12-aad1-4c25-8a87-65f406883867",
                                                "sense_id": "f3793a69-8843-3d47-ba35-107e7df45944",
                                                "text": "Un extrait de plaquebières."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "072eb1cb-e14f-3d75-ae42-ae0327dc486c",
                                        "entry_id": "14209c47-4009-37ec-a61b-0b2e6dba5b88",
                                        "glosses": [
                                            "Meuble représentant la plante du même nom dans les armoiries."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b690e3a-d6b1-4b44-81a4-eeb682be9fdb",
                                                "sense_id": "072eb1cb-e14f-3d75-ae42-ae0327dc486c",
                                                "text": "De gueules, à une plaquebière, tigée et feuillée d’or, qui est de la commune de Nesseby en Norvège."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
