                ],
                "senses": [
                    {
                        "sense_id": "a5814aa9-cf41-3686-b89d-b5e6038233f0",
                        "entry_id": "930a052f-5bf1-36e0-b526-64532f3d8be8",
                        "glosses": [
                            "Rendre dolichocéphale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb0f6781-1c61-45d7-b39f-8c3ba7749b04",
                                "sense_id": "a5814aa9-cf41-3686-b89d-b5e6038233f0",
                                "text": "La petite tache brachycéphale de Chabanais s'est beaucoup étendue, toute la lisière charentaise occidentale voit aussi le crâne s'élargir tandis que le Nord-Ouest du Périgord s'est un peu plus dolichocéphalisé."
                            },
                            {
                                "example_id": "806d9de0-200b-4413-825c-b224d16b9676",
                                "sense_id": "a5814aa9-cf41-3686-b89d-b5e6038233f0",
                                "text": "Deux cantons se sont dolichocéphalisés (Ghabanais et Confolens)."
                            },
                            {
                                "example_id": "517d3dc0-cfbf-43b8-94d4-0b528f60823e",
                                "sense_id": "a5814aa9-cf41-3686-b89d-b5e6038233f0",
                                "text": "Cette augmentation du nombre des dolichocéphales pourrait s’interpréter en faveur de l’hypothèse qui veut que le crâne se dolichocéphalise avec l'âge."
                            }
                        ]
                    }
