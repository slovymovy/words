                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "apparence_negligee",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avec ce vieux pull déchiré, tu as vraiment une allure de <w>clochard</w>."
