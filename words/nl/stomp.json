{
    "word_family": [
        "stompen",
        "stompheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "25b70ce8-f23c-382b-8bf0-1e8cceac3c7e",
                    "sense_definition": "Niet scherp of puntig; zijn scherpte verloren hebbend.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "scherpte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met zo'n <w>stomp</w> mes kun je geen snede in het brood maken. ",
                            "target_lang_translations": {
                                "en": "You cannot make a cut in the bread with such a <w>blunt</w> knife."
                            }
                        },
                        {
                            "text": "Hij probeerde te schrijven met een <w>stomp</w> potlood.",
                            "target_lang_translations": {
                                "en": "He tried to write with a <w>dull</w> pencil."
                            }
                        }
                    ],
                    "synonyms": [
                        "bot"
                    ],
                    "antonyms": [
                        "scherp",
                        "puntig",
                        "spits"
                    ],
                    "common_phrases": [
                        "stomp mes",
                        "stomp potlood"
                    ],
                    "target_lang_definitions": {
                        "en": "Not sharp or pointed; having lost its sharpness."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blunt",
                                "target_lang_sense_clarification": "lacking a sharp edge or point"
                            },
                            {
                                "target_lang_word": "dull",
                                "target_lang_sense_clarification": "not sharp, unable to cut easily"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6792f7ec-5874-3889-b6d0-f39be3861c9e",
                    "sense_definition": "Met een hoek die groter is dan 90 graden.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geometrie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In deze driehoek is een van de hoeken een <w>stompe</w> hoek. ",
                            "target_lang_translations": {
                                "en": "In this triangle, one of the angles is an <w>obtuse</w> angle."
                            }
                        },
                        {
                            "text": "De leraar legde uit hoe je een <w>stompe</w> hoek moet meten.",
                            "target_lang_translations": {
                                "en": "The teacher explained how to measure an <w>obtuse</w> angle."
                            }
                        }
                    ],
                    "antonyms": [
                        "scherp"
                    ],
                    "common_phrases": [
                        "stompe hoek"
                    ],
                    "target_lang_definitions": {
                        "en": "With an angle greater than 90 degrees."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "obtuse",
                                "target_lang_sense_clarification": "angle greater than 90 degrees"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "917e0808-d9c8-3b2b-ab22-791262336868",
                    "sense_definition": "Een krachtige, pijnlijke stoot met de vuist of elleboog.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "stoot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij gaf zijn tegenstander een harde <w>stomp</w> in zijn maag. ",
                            "target_lang_translations": {
                                "en": "He gave his opponent a hard <w>punch</w> in the stomach."
                            }
                        },
                        {
                            "text": "Onverwachts kreeg ik een <w>stomp</w> in mijn rug.",
                            "target_lang_translations": {
                                "en": "Unexpectedly, I received a <w>thump</w> in my back."
                            }
                        }
                    ],
                    "synonyms": [
                        "slag",
                        "mep",
                        "klop",
                        "mot"
                    ],
                    "antonyms": [
                        "aai",
                        "streling",
                        "schop"
                    ],
                    "common_phrases": [
                        "een stomp geven",
                        "een stomp krijgen"
                    ],
                    "target_lang_definitions": {
                        "en": "A powerful, painful strike with the fist or elbow."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "punch",
                                "target_lang_sense_clarification": "strike with a fist"
                            },
                            {
                                "target_lang_word": "jab",
                                "target_lang_sense_clarification": "quick, sharp strike"
                            },
                            {
                                "target_lang_word": "thump",
                                "target_lang_sense_clarification": "heavy blow"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4dcce018-f1a0-3d63-aa88-c1972aa6b6b4",
                    "sense_definition": "Het overgebleven korte, dikke uiteinde van iets dat afgesneden of afgebroken is.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "restant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de kap bleef er slechts een <w>stomp</w> van de boom staan.",
                            "target_lang_translations": {
                                "en": "After the felling, only a <w>stump</w> of the tree remained standing."
                            }
                        },
                        {
                            "text": "Hij hield nog een klein <w>stompje</w> van de kaars over.",
                            "target_lang_translations": {
                                "en": "He had a small <w>stub</w> of the candle left."
                            }
                        }
                    ],
                    "synonyms": [
                        "knobbel"
                    ],
                    "antonyms": [
                        "spits",
                        "pin"
                    ],
                    "common_phrases": [
                        "stomp van de boom"
                    ],
                    "target_lang_definitions": {
                        "en": "The remaining short, thick end of something that has been cut off or broken off."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stump",
                                "target_lang_sense_clarification": "remaining base of a tree or limb"
                            },
                            {
                                "target_lang_word": "stub",
                                "target_lang_sense_clarification": "short remaining part of a pencil, candle, or ticket"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cee95215-1636-3916-adf8-fcd777d6c8ff",
                    "sense_definition": "Eerste persoon enkelvoud van het werkwoord <w>stompen</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>stomp</w> per ongeluk tegen de tafel aan.",
                            "target_lang_translations": {
                                "en": "I accidentally <w>bump</w> against the table."
                            }
                        },
                        {
                            "text": "Soms <w>stomp</w> ik per ongeluk tegen iemand aan op straat.",
                            "target_lang_translations": {
                                "en": "Sometimes I accidentally <w>bump</w> into someone on the street."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present of the verb 'stompen' (to bump, jab, or punch)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bump",
                                "target_lang_sense_clarification": "to knock gently or accidentally against something"
                            },
                            {
                                "target_lang_word": "poke",
                                "target_lang_sense_clarification": "to jab or prod"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}