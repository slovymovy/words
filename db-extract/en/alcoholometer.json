                "senses": [
                    {
                        "sense_id": "e6637d7b-a753-3061-ac7a-49924a1c8afe",
                        "entry_id": "e3472034-315b-32eb-9da7-f9727503b7f0",
                        "glosses": [
                            "A specialized form of hydrometer used to measure the amount of alcohol in a liquid (such as beer)."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7c1283e-ad8f-452d-9502-4714a10a5a4b",
                        "source_entry_id": "e3472034-315b-32eb-9da7-f9727503b7f0",
                        "source_sense_id": "e6637d7b-a753-3061-ac7a-49924a1c8afe",
                        "source_sense_description": "Specialized form of hydrometer used to measure amount of alcohol in liquid",
                        "target_lang_word": "alcoomètre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alcoomètre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3712c290-a97d-38d2-b5be-5e66114c71ea",
                                        "entry_id": "ea148780-48a8-35de-99a9-8e12898aab45",
                                        "glosses": [
                                            "Pèse-liqueur employé pour déterminer ce qu’un liquide contient d’alcool absolu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "615524cc-a943-436d-a7cd-4d69289b5af3",
                                                "sense_id": "3712c290-a97d-38d2-b5be-5e66114c71ea",
                                                "text": "La densité différente de l'huile d'olive, et de celles qu'on y introduit, est un des caractères le plus souvent employés pour reconnaître la fraude. On se sert soit de l'oléomètre Lefebvre, soit de l’élaïomètre de Gobley, soit de l’alcoomètre centésimal de Gay-Lussac, dont l'emploi a été conseillé par M. Marchand."
                                            },
                                            {
                                                "example_id": "3f9db56d-09c6-4b9c-93eb-6ada2cfdaeb7",
                                                "sense_id": "3712c290-a97d-38d2-b5be-5e66114c71ea",
                                                "text": "L'aréomètre de Cartier a été pendant longtemps le seul employé ; maintenant on se sert de préférence de l’alcoomètre de Gay Lussac, gradué en 100 degrés, et dont les indications sont plus précises. Cet appareil plongé dans l'eau marque 0° et dans l'alcool pur 100°."
                                            },
                                            {
                                                "example_id": "0d1a9729-7c0e-4c47-b25a-073fbb72389d",
                                                "sense_id": "3712c290-a97d-38d2-b5be-5e66114c71ea",
                                                "text": "L'essai d'un alcool doit porter tout d'abord sur le degré alcoolique qui est déterminé au moyen de l’alcoomètre de Gay-Lussac."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
