                ],
                "senses": [
                    {
                        "sense_id": "ab1bdd57-7f98-38c5-aa36-428a5e9ea4ee",
                        "entry_id": "1debda07-a543-3c8c-a1bf-32acab61183b",
                        "glosses": [
                            "стрелять в воздух из оружия в честь какого-либо праздника"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc9ce289-9559-4a1c-a30a-a0f38825cede",
                                "sense_id": "ab1bdd57-7f98-38c5-aa36-428a5e9ea4ee",
                                "text": "Жалею, что, идя сюда на обед, я не захватил с собой крупповской пушки, чтобы салютовать в честь женщин."
                            },
                            {
                                "example_id": "19018cbf-436f-4995-9702-f78d88db8d82",
                                "sense_id": "ab1bdd57-7f98-38c5-aa36-428a5e9ea4ee",
                                "text": "В двенадцать часов следующего дня наступившую тишину вновь нарушил грохот канонады: русская артиллерия салютовала въезду Александра II в Плевну."
                            }
                        ]
                    },
                    {
                        "sense_id": "eda99c0f-7835-3ad0-915a-4c4af698941b",
                        "entry_id": "1debda07-a543-3c8c-a1bf-32acab61183b",
                        "glosses": [
                            "устар., воен. отдавать честь, приветствовать по традиционной для каких-либо обстоятельств форме"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b85cea49-c135-4873-8e70-fbc2911a5caa",
                                "sense_id": "eda99c0f-7835-3ad0-915a-4c4af698941b",
                                "text": "Мирович, отдавая воинские почести почившему, салютовал шпагой."
                            },
                            {
                                "example_id": "5a81b9fb-2696-478b-8fd5-fba62e85e54e",
                                "sense_id": "eda99c0f-7835-3ad0-915a-4c4af698941b",
                                "text": "Стрельцы скосили глаза, четко отбивая шаг, сделали мушкетами вверх и налево. Меркуров выкинул шпагу из ножен, салютуя. Крыков выбросил из ножен свою."
                            }
                        ]
                    },
                    {
                        "sense_id": "1f10d01a-c32a-3ac6-88b8-8637ae2ba03c",
                        "entry_id": "1debda07-a543-3c8c-a1bf-32acab61183b",
                        "glosses": [
                            "перен., разг. приветствовать кого-либо, встречать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0003efff-7e7b-4c35-8577-3b89dfa02038",
                                "sense_id": "1f10d01a-c32a-3ac6-88b8-8637ae2ba03c",
                                "text": "Когда Бендер с завхозом проходили по дому, двери салютовали страшными ударами."
                            },
                            {
                                "example_id": "f775cdca-43eb-4df3-a39c-37f44d84652c",
                                "sense_id": "1f10d01a-c32a-3ac6-88b8-8637ae2ba03c",
                                "text": "Все знали Таню. Оборачивались и салютовали ей бокальчиками. ― Татьяна Никитична, хотите новый анекдот из Москвы?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "63405218-5ab7-4c90-9e2e-76cb12d770ae",
                        "source_entry_id": "1debda07-a543-3c8c-a1bf-32acab61183b",
                        "target_lang_word": "salutieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salutieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cea194b1-507b-347b-b508-a28ec94b3a0b",
                                        "entry_id": "bfc1d086-656c-3466-bad4-35bd3d8beb52",
                                        "glosses": [
                                            "militärisch grüßen, die militärische Ehre erweisen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a68f63c-3c83-4ffa-b291-8e100f451231",
                                                "sense_id": "cea194b1-507b-347b-b508-a28ec94b3a0b",
                                                "text": "Die Soldaten salutierten vor dem Offizier."
                                            },
                                            {
                                                "example_id": "0c5c21aa-079f-4305-9ea7-06d3af22acdf",
                                                "sense_id": "cea194b1-507b-347b-b508-a28ec94b3a0b",
                                                "text": "„Die Schweizergardisten salutieren und der dunkle Wagen fährt ein in den kleinsten Staat der Welt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "95a59346-dfc2-3342-ba6c-13d1913893bd",
                                        "entry_id": "bfc1d086-656c-3466-bad4-35bd3d8beb52",
                                        "glosses": [
                                            "Salut schießen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e3652c38-e413-3da2-8053-8873fdfafefd",
                                        "entry_id": "bfc1d086-656c-3466-bad4-35bd3d8beb52",
                                        "glosses": [
                                            "jemanden durch Anlegen der Hand an den Kopf grüßen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a17ed47-3b6b-440f-ac63-16ca55984c6d",
                                                "sense_id": "e3652c38-e413-3da2-8053-8873fdfafefd",
                                                "text": "„Er trat während der ersten Strophe neben das Bild des amtierenden Staatspräsidenten, das in jedem Klassenzimmer neben dem Kruzifix hängen musste, und salutierte bei der letzten Strophe.“"
                                            },
                                            {
                                                "example_id": "baa56687-700e-4852-aa94-32e9b5b6fa21",
                                                "sense_id": "e3652c38-e413-3da2-8053-8873fdfafefd",
                                                "text": "„Man sah zu ihm empor, die einen salutierten, die andern brüllten Kosenamen hinauf und wieder anderen war das Herz so voll, daß sie nur noch drohend die Faust nach oben schütteln konnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
