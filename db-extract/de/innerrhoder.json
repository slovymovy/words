            {
                "entry_id": "f050261e-9445-3c3f-a6aa-95c9cd116cbd",
                "word": "Innerrhoder",
                "pos": "adj",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "1bc370ce-fdeb-4c37-95d6-83408a108e98",
                        "entry_id": "f050261e-9445-3c3f-a6aa-95c9cd116cbd",
                        "tags": [
                            "positive"
                        ],
                        "form": "Innerrhoder"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "da3b3725-88ae-318e-b221-7f282999683d",
                        "entry_id": "f050261e-9445-3c3f-a6aa-95c9cd116cbd",
                        "glosses": [
                            "aus dem (Halb-)Kanton Appenzell Innerrhoden stammend, sich auf den (Halb-)Kanton Appenzell Innerrhoden beziehend, zum (Halb-)Kanton Appenzell Innerrhoden gehörig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "815611c8-ff18-4a31-a01b-e5e5165ccecf",
                                "sense_id": "da3b3725-88ae-318e-b221-7f282999683d",
                                "text": "„19 Jahre dauerte es, bis das Bundesgericht am 25. März 1990 einer Klage von Frauen aus Appenzell Innerrhoden Recht gab und die Verfassungswidrigkeit der Innerrhoder Kantonsverfassung in diesem Punkt bestätigte.“"
                            },
                            {
                                "example_id": "3aa2d503-3889-40b5-beca-2c69c7d81f00",
                                "sense_id": "da3b3725-88ae-318e-b221-7f282999683d",
                                "text": "„Arthur Loepfe, Innerrhoder CVP-Nationalrat, wies darauf hin, dass Freiheit im Steuerbereich namentlich für kleine und ländliche Kantone eine Voraussetzung darstelle, um gegenüber den Zentren konkurrenzfähig zu sein.“"
                            },
                            {
                                "example_id": "4e7cea94-57e5-4a57-8f74-0ac78ecefeac",
                                "sense_id": "da3b3725-88ae-318e-b221-7f282999683d",
                                "text": "„Eine Razzia zweier Innerrhoder Polizisten im Jahr 2000 in Vaduz (Liechtenstein) wirbelt immer mehr Staub auf.“"
                            },
                            {
                                "example_id": "4acdbda0-7269-4bec-8871-221807cc66ac",
                                "sense_id": "da3b3725-88ae-318e-b221-7f282999683d",
                                "text": "„Die genauen Umstände, die zum Tod geführt haben, können auf Grund der verstrichenen Zeit nicht mehr ermittelt werden, teilte die Innerrhoder Kantonspolizei am Mittwoch mit.“"
                            },
                            {
                                "example_id": "98f5035d-7e04-4473-8935-a738126f749b",
                                "sense_id": "da3b3725-88ae-318e-b221-7f282999683d",
                                "text": "„Sowohl die Standeskommission als auch das Innerrhoder Verwaltungsgericht wiesen die Beschwerde ab und gaben dem Bauherrn Recht.“"
                            },
                            {
                                "example_id": "78acd91e-3c9d-4fbe-ab5d-b7d6a511b908",
                                "sense_id": "da3b3725-88ae-318e-b221-7f282999683d",
                                "text": "„Die Innerrhoder Regierung befürchtet, dass das zurzeit in der Vernehmlassung befindliche Raumkonzept des Bundes die Eigenständigkeit und die Entwicklungsmöglichkeiten des kleinsten Schweizer Kantons ebenso wie anderer landwirtschaftlich geprägter Kantone einengen werde.“"
                            },
                            {
                                "example_id": "790b53f3-3373-4176-80de-0411ab1f0bfa",
                                "sense_id": "da3b3725-88ae-318e-b221-7f282999683d",
                                "text": "„Antonia Fässler ist neue Innerrhoder Statthalterin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
