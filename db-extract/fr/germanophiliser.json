                "senses": [
                    {
                        "sense_id": "729ddca5-f6df-3473-bd78-2eb2e099c39e",
                        "entry_id": "b2e23cad-12bf-38ba-8604-735410b0587b",
                        "glosses": [
                            "Être germanophile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4381f87-420d-4062-a807-150474b7806a",
                                "sense_id": "729ddca5-f6df-3473-bd78-2eb2e099c39e",
                                "text": "Il attaque ma germanophilie : car il paraît qu’on germanophilise quand on refuse de s’associer à une haine aveugle dont on empoisonne la France…"
                            }
                        ]
                    },
                    {
                        "sense_id": "f05bae39-c1e5-34cf-ab4f-31a067e7244f",
                        "entry_id": "b2e23cad-12bf-38ba-8604-735410b0587b",
                        "glosses": [
                            "Donner un caractère germanophile à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7500c72-2385-405f-9570-0062240fe2ba",
                                "sense_id": "f05bae39-c1e5-34cf-ab4f-31a067e7244f",
                                "text": "Enfin, Jong Twente pourrait prochainement germanophiliser l’équipe première si ses 8 allemands sont au niveau."
                            },
                            {
                                "example_id": "06d1c729-99f5-4ec6-b986-5d3053546f3e",
                                "sense_id": "f05bae39-c1e5-34cf-ab4f-31a067e7244f",
                                "text": "J’aimerais vraiment pouvoir faire cette licence qui en plus plus de tout l’intérêt personnel que j’y porte, cela pourrait permettre de « germanophiliser » pour profil, d’autant plus que la L3 peut se faire avec un parcours « métier de la communication », que normalement je suivrai en parallèle d’un M1 en communication côté Sciences Po."
                            }
                        ]
                    }
