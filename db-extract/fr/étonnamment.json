                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d98a49b4-79be-338a-8395-ccdada3a67d0",
                        "entry_id": "ee1e4abe-8f8a-354e-a083-561d00f39df4",
                        "glosses": [
                            "D’une manière étonnante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94d3bd58-4217-4bcf-8bac-754782e3f78c",
                                "sense_id": "d98a49b4-79be-338a-8395-ccdada3a67d0",
                                "text": "Elle a eu une crise affreuse ; mais elle va étonnamment bien à présent."
                            },
                            {
                                "example_id": "487acc96-0f76-4ee7-a47c-a672812c71e2",
                                "sense_id": "d98a49b4-79be-338a-8395-ccdada3a67d0",
                                "text": "Il était d’une grande urbanité d’autrefois, ainsi que le maître de maison lui-même, s’effaçait devant tout le monde et subissait étonnamment les raseurs."
                            },
                            {
                                "example_id": "eae2862a-e3e3-4191-a60d-baf8b5026f69",
                                "sense_id": "d98a49b4-79be-338a-8395-ccdada3a67d0",
                                "text": "C’était étonnamment moins difficile parce qu’il s'agissait de l’histoire d'Adréa Bescond et qu’elle était sur le plateau, me donnant l’impression d’aider à faire comprendre ce qu’elle a vécu."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b1410a8-01f6-4bb8-af0e-c17508c11661",
                        "source_entry_id": "ee1e4abe-8f8a-354e-a083-561d00f39df4",
                        "source_sense_id": "d98a49b4-79be-338a-8395-ccdada3a67d0",
                        "target_lang_word": "amazingly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amazingly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f4e3c572-29ac-3f16-88f5-aff64cc94ed9",
                                        "entry_id": "79f7d897-b2b6-345a-977a-7c0e4b867fac",
                                        "glosses": [
                                            "In an amazing manner; in a way that causes amazement; wonderfully."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4398029-fe65-4e86-b94f-3d3c6b466f7d",
                                                "sense_id": "f4e3c572-29ac-3f16-88f5-aff64cc94ed9",
                                                "text": "That violin solo was played amazingly."
                                            },
                                            {
                                                "example_id": "52598c2f-e63a-4edd-9940-69d360039eb1",
                                                "sense_id": "f4e3c572-29ac-3f16-88f5-aff64cc94ed9",
                                                "text": "While at first in the U.S.A. it may have been a matter of high-pressure salesmanship—and it has undoubtely been the irresistible enterprise of the General Motors Corporation, through its Electro-Motive subsidiary, that has set in motion this amazingly rapid transformation of American railway motive power, and has caused all the steam locomotive builders in the U.S.A. to follow suit or be left out in the cold—it seems now beyond dispute that, so far as the U.S.A. is concerned, the economics of the power question can be solved no other way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3481d11f-6bb5-3cb9-9e49-e67f5ae3640d",
                                        "entry_id": "79f7d897-b2b6-345a-977a-7c0e4b867fac",
                                        "glosses": [
                                            "Difficult to believe; strange but true."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c126aba-30ec-4766-b567-f8e374b1f39d",
                                                "sense_id": "3481d11f-6bb5-3cb9-9e49-e67f5ae3640d",
                                                "text": "Amazingly, no one was injured in the crash."
                                            },
                                            {
                                                "example_id": "da94ad3b-671e-4197-9cb9-446127be676b",
                                                "sense_id": "3481d11f-6bb5-3cb9-9e49-e67f5ae3640d",
                                                "text": "Signalman Bridges was killed by the blast, as was fireman Nightall. Amazingly, driver Gimbert came round some 200 yards away, on the grass outside the Station Hotel where he had been flung."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a7525e7-6762-3e89-822d-8dae09eced1b",
                                        "entry_id": "79f7d897-b2b6-345a-977a-7c0e4b867fac",
                                        "glosses": [
                                            "To a wonder-inspiring extent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd227fff-34b0-4794-8367-a21f5fa01455",
                                                "sense_id": "9a7525e7-6762-3e89-822d-8dae09eced1b",
                                                "text": "The car has amazingly low fuel consumption."
                                            },
                                            {
                                                "example_id": "95d038e8-feab-40ae-975c-6325f9ef4331",
                                                "sense_id": "9a7525e7-6762-3e89-822d-8dae09eced1b",
                                                "text": "The disease AIDS is wiping out a significant portion of the Gay Community and concerns about it are well-justified. But there is another disease that strikes an amazingly high percentage in our community. This disease is Chemical Dependency."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e63f171-329b-4d3a-807f-ea83697523b3",
                        "source_entry_id": "ee1e4abe-8f8a-354e-a083-561d00f39df4",
                        "source_sense_id": "d98a49b4-79be-338a-8395-ccdada3a67d0",
                        "target_lang_word": "surprisingly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surprisingly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bec13c8f-b2cd-3aa5-abda-d604a2a55d67",
                                        "entry_id": "0ffa2eb6-15c2-3ab1-a61d-65011c8c1930",
                                        "glosses": [
                                            "In a way that causes surprise because it is unexpected, or unusual."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48a9a95a-415e-4522-b89d-3f954ea96d74",
                                                "sense_id": "bec13c8f-b2cd-3aa5-abda-d604a2a55d67",
                                                "text": "Near-synonyms: unexpectedly, unusually"
                                            },
                                            {
                                                "example_id": "12b5eb65-ba4c-4816-a58d-1133dd322e45",
                                                "sense_id": "bec13c8f-b2cd-3aa5-abda-d604a2a55d67",
                                                "text": "The house was surprisingly small for such a numerous family."
                                            },
                                            {
                                                "example_id": "50f2806e-e94d-456e-a8dd-524fe9ba988f",
                                                "sense_id": "bec13c8f-b2cd-3aa5-abda-d604a2a55d67",
                                                "text": "Not surprisingly, the electrician didn't come at the time he had said."
                                            },
                                            {
                                                "example_id": "383b7574-0c09-4927-8cbb-c4421accf0ab",
                                                "sense_id": "bec13c8f-b2cd-3aa5-abda-d604a2a55d67",
                                                "text": "Chema'd, surprisingly, paid for everything."
                                            },
                                            {
                                                "example_id": "e7e00a25-6645-414a-80b4-f93b0a55550a",
                                                "sense_id": "bec13c8f-b2cd-3aa5-abda-d604a2a55d67",
                                                "text": "François Hollande has moved a step closer to becoming the first Socialist president of France in a generation by beating the incumbent, Nicolas Sarkozy, in the first round of elections. But the surprisingly high vote for the extreme-right candidate, Marine Le Pen, boosted the overall figures for the right and meant that the final runoff vote on 6 May remains on a knife edge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a938c5ab-9a08-46e1-b435-4afb5a49d48e",
                        "source_entry_id": "ee1e4abe-8f8a-354e-a083-561d00f39df4",
                        "source_sense_id": "d98a49b4-79be-338a-8395-ccdada3a67d0",
                        "target_lang_word": "verbazingwekkend",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verbazingwekkend",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "029185be-dd4d-374b-8c3d-e190632a2b66",
                                        "entry_id": "f9432b9b-9f1d-3f72-af6e-3e494fe9eba5",
                                        "glosses": [
                                            "wat verbazing opwekt, wat buitengewoon is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81689d7c-23e0-4688-9ae6-cebf98646934",
                                                "sense_id": "029185be-dd4d-374b-8c3d-e190632a2b66",
                                                "text": "Die circusartiesten lieten verbazingwekkende dingen zien."
                                            },
                                            {
                                                "example_id": "42b63dcf-141f-4640-9d03-bb8a578ad96c",
                                                "sense_id": "029185be-dd4d-374b-8c3d-e190632a2b66",
                                                "text": "Prinses Elfilda dankt haar populariteit grotendeels aan haar verbazingwekkende schoonheid, hoewel er ook iets in haar karakter zit dat het grote publiek aantrekt. Ze zegt weinig, en als ze al een keertje haar mond opendoet, komen de woorden er aarzelend uit, zodat ze een bedeesde indruk maakt, een indruk die nog eens wordt versterkt door de manier waarop ze haar hoofd naar beneden houdt en door haar lange wimpers omhoogkijkt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c33c071-3f4a-4670-b54c-8845c010ee74",
                        "source_entry_id": "ee1e4abe-8f8a-354e-a083-561d00f39df4",
                        "source_sense_id": "d98a49b4-79be-338a-8395-ccdada3a67d0",
