                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56b7b15b-09db-4aa8-a435-dbba2a3a4714",
                                                "sense_id": "bcd74209-e60d-3552-ab30-867269d97797",
                                                "text": "ungrounded accusations"
                                            },
                                            {
                                                "example_id": "476fb489-f94b-4046-a421-def2a1c245e3",
                                                "sense_id": "bcd74209-e60d-3552-ab30-867269d97797",
                                                "text": "a blind accusation"
                                            },
                                            {
                                                "example_id": "27c8ed92-e18c-45ae-ac66-951ecdf14d76",
                                                "sense_id": "bcd74209-e60d-3552-ab30-867269d97797",
                                                "text": "repeated accusations"
                                            },
                                            {
                                                "example_id": "07ad0072-dd27-4b48-8664-d21ff98c9d15",
                                                "sense_id": "bcd74209-e60d-3552-ab30-867269d97797",
