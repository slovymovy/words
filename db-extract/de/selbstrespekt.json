                        "translation_id": "f8e3584f-c6d1-4a7e-8d99-b3fb01d5037a",
                        "source_entry_id": "eb3fd265-5d34-3ce8-af48-f5bd1000767d",
                        "source_sense_id": "0ab01956-8b8a-332b-93a4-24a4d85f00ca",
                        "source_sense_description": "Respekt vor sich selbst",
                        "target_lang_word": "self-respect",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "self-respect",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45bb6b73-f497-3189-8ed3-d37dd1048fe6",
                                        "entry_id": "cc0eef96-8995-3716-8d12-a6f74a6ada3e",
                                        "glosses": [
                                            "The knowledge of one's own worth."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e99e21b8-c9ab-4d03-82ff-29321351e943",
                                                "sense_id": "45bb6b73-f497-3189-8ed3-d37dd1048fe6",
                                                "text": "[…] he wished he had been a William Price, distinguishing himself and working his way to fortune and consequence with so much self-respect and happy ardour, instead of what he was!"
                                            },
                                            {
                                                "example_id": "66f750c9-14d7-441b-ab2b-7e3a1aed3788",
                                                "sense_id": "45bb6b73-f497-3189-8ed3-d37dd1048fe6",
                                                "text": "In the little chaos of Pearl's character there might be seen emerging[…]an uncontrollable will—sturdy pride, which might be disciplined into self-respect—and a bitter scorn of many things which, when examined, might be found to have the taint of falsehood in them."
                                            },
                                            {
                                                "example_id": "ce5e24ad-a960-46b4-a042-86d56eb2bd15",
                                                "sense_id": "45bb6b73-f497-3189-8ed3-d37dd1048fe6",
                                                "text": "Would any woman have behaved like that—if a man had said he didn’t want her? We’ve too much self-respect; we’re infinitely finer than they are."
                                            },
                                            {
                                                "example_id": "3b4e95d1-0628-4e41-8d30-da7ef8bc46b9",
                                                "sense_id": "45bb6b73-f497-3189-8ed3-d37dd1048fe6",
                                                "text": "“To hold Arrakis,” the Duke said, “one is faced with decisions that may cost one his self-respect.” He pointed out the window to the Atreides green and black banner hanging limply from a staff at the edge of the landing field. \"That honorable banner could come to mean many evil things.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
