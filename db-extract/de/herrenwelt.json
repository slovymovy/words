                "senses": [
                    {
                        "sense_id": "ab96b74d-a8fc-3f5c-8729-322f03c25c35",
                        "entry_id": "b346bed5-77e1-3b3e-bb5e-9998e3638d9d",
                        "glosses": [
                            "die Gesamtheit der Herren/Männer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f9d3195-30fd-43dc-9567-555130d62790",
                                "sense_id": "ab96b74d-a8fc-3f5c-8729-322f03c25c35",
                                "text": "Die Herrenwelt konnte sich überwiegend nicht mit der neuen Mode anfreunden."
                            },
                            {
                                "example_id": "df1eabbc-8aad-4aae-9e69-84c062835426",
                                "sense_id": "ab96b74d-a8fc-3f5c-8729-322f03c25c35",
                                "text": "„Das männliche Schmuckbedürfnis ist eine der liebenswertesten Eigenschaften der Herrenwelt und schreit besonders in Feldgrau nach seinem Recht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f8af79ff-0a07-351b-8318-1aa5e778bdf9",
                        "entry_id": "b346bed5-77e1-3b3e-bb5e-9998e3638d9d",
                        "glosses": [
                            "von Männern geprägter Lebensbereich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "532bf4ed-0fcb-41d7-8b07-9ddee9d6a34d",
                                "sense_id": "f8af79ff-0a07-351b-8318-1aa5e778bdf9",
                                "text": "„Und dann war es auch schon Zeit, diese unsere muntere nachmittägliche Herrenwelt zu beenden und zum Bürofest aufzubrechen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
