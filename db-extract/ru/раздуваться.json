                        "tags": [
                            "participle",
                            "active",
                            "past"
                        ],
                        "form": "раздува́вшийся"
                    },
                    {
                        "form_id": "3f3f380f-f371-4907-8432-96e52f0ccc4f",
                        "entry_id": "a6f51924-a4d7-397b-9c92-9a6a47a252e3",
                        "tags": [
                            "adverbial",
                            "participle",
                            "present"
                        ],
                        "form": "раздува́ясь"
                    },
                    {
                        "form_id": "d901becd-28db-48b8-9e72-c84184512132",
                        "entry_id": "a6f51924-a4d7-397b-9c92-9a6a47a252e3",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "раздува́вшись"
                    },
                    {
                        "form_id": "7de3564a-4f7a-4adb-95f7-2bb002d4c8fd",
                        "entry_id": "a6f51924-a4d7-397b-9c92-9a6a47a252e3",
                        "tags": [
                            "future"
                        ],
                        "form": "буду/будешь… раздува́ться"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4a79b09d-8f43-3a93-a92c-f989e7b35ebd",
                        "entry_id": "a6f51924-a4d7-397b-9c92-9a6a47a252e3",
                        "glosses": [
                            "страд. к раздувать (в значении «наполняться воздухом; надуваться)"
                        ],
                        "tags": [
                            "passive"
                        ],
                        "examples": [
                            {
                                "example_id": "2ebb6654-4b0f-48d5-91ce-fa87e65e3d31",
                                "sense_id": "4a79b09d-8f43-3a93-a92c-f989e7b35ebd",
                                "text": "Мать смотрит на кухтыль, ноздри у нее начинают раздуваться и белеют."
                            },
                            {
                                "example_id": "34ef129f-1637-4c62-9cd2-42e3a8d93da6",
                                "sense_id": "4a79b09d-8f43-3a93-a92c-f989e7b35ebd",
                                "text": "По мере того как шарик будет раздуваться, наблюдателю, находящемуся на одном из пятнышек, будет казаться, что все другие пятнышки удаляются от него."
                            },
                            {
                                "example_id": "b44be750-0857-4e60-aa33-bfb3e7d98d1b",
                                "sense_id": "4a79b09d-8f43-3a93-a92c-f989e7b35ebd",
                                "text": "Надьке ветром надуло, говорили, и живот её осенью стал раздуваться, как воздушный шар, если его надувать насосом от велосипеда."
                            }
                        ]
                    },
                    {
                        "sense_id": "0449494d-b4f1-3881-b7e1-7ac893dc090e",
                        "entry_id": "a6f51924-a4d7-397b-9c92-9a6a47a252e3",
                        "glosses": [
                            "перен. страд. к раздувать (в значении «непомерно преувеличиваться»)"
                        ],
                        "tags": [
                            "passive"
                        ],
                        "examples": [
                            {
                                "example_id": "bf0b8654-02fd-4a5a-b50c-99dbacb94c04",
                                "sense_id": "0449494d-b4f1-3881-b7e1-7ac893dc090e",
                                "text": "Толкуют нередко продналог и связанные с ним изменения в нашей политике в смысле коренного перелома в ней. Неудивительно, что такое толкование усиленно раздувается зарубежной белогвардейской, главным образом эсеровской и меньшевистской, печатью."
                            }
                        ]
                    },
                    {
                        "sense_id": "885c5a52-365c-3826-9ff4-b8ed84f21ffa",
                        "entry_id": "a6f51924-a4d7-397b-9c92-9a6a47a252e3",
                        "glosses": [
                            "увеличиваться в объёме, становиться толстым, пухлым, например от чего-либо положенного или проникшего внутрь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47f4a898-a499-4952-a067-2b82b6c04bc6",
                                "sense_id": "885c5a52-365c-3826-9ff4-b8ed84f21ffa",
                                "text": "Между тем братья стали раздуваться, расти, они заполнили всю комнату, весь дом, и затем выросли из него."
                            },
                            {
                                "example_id": "89bc7ddf-7d5d-4866-ac2c-3641e49ba43b",
                                "sense_id": "885c5a52-365c-3826-9ff4-b8ed84f21ffa",
                                "text": "Позднее Надя рассказывала, что в Армении на глазах у всех у Осипа Эмильевича стала раздуваться на шее огромная опухоль, как зоб, а через несколько часов опала."
                            }
                        ]
                    },
                    {
                        "sense_id": "faa11aa3-7842-3438-8edd-6dcf987dc588",
                        "entry_id": "a6f51924-a4d7-397b-9c92-9a6a47a252e3",
                        "glosses": [
                            "становиться полноводным, подниматься выше обычного уровня (о водоёме)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "818cd754-a3ed-45b8-9478-af5e61fd22fe",
                                "sense_id": "faa11aa3-7842-3438-8edd-6dcf987dc588",
                                "text": "Всю ночь лил дождь; речка Лесковица… раздулась и бурлила против своего обыкновения."
                            },
                            {
                                "example_id": "f3020127-a258-4482-ac35-876a35d1cea7",
                                "sense_id": "faa11aa3-7842-3438-8edd-6dcf987dc588",
                                "text": "Ручейки, ничтожные накануне, раздулись так, что лошади шли по брюхо в воде."
                            }
                        ]
                    },
                    {
                        "sense_id": "91af27ee-15d1-326c-9484-6985d4d436e0",
                        "entry_id": "a6f51924-a4d7-397b-9c92-9a6a47a252e3",
                        "glosses": [
                            "перен., разг. принимать важный, надменный вид"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d14f311-309d-471a-9754-31f8d89c852d",
                                "sense_id": "91af27ee-15d1-326c-9484-6985d4d436e0",
                                "text": "А самое главное ― он не стал «раздуваться» от собственной значимости."
                            },
                            {
                                "example_id": "342132aa-d5e3-4e34-8268-8abbb802aca0",
                                "sense_id": "91af27ee-15d1-326c-9484-6985d4d436e0",
                                "text": "Меняется вдруг самооценка, он на глазах начинает раздуваться, появляются капризы, завышение требований к жизни и условиям работы."
                            }
                        ]
                    }
