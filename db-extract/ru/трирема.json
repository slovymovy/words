                                        "entry_id": "5b3ce959-c483-3ae8-802a-1d733477ab4b",
                                        "glosses": [
                                            "Kriegsschiff mit jeweils drei übereinanderliegenden Ruderbänken back- und steuerbords"
                                        ],
