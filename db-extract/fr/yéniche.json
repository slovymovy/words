                                "target_senses": [
                                    {
                                        "sense_id": "8509f4ac-ce90-3f3f-9594-e1215614f8ba",
                                        "entry_id": "c12315cb-9947-3966-bfb8-afee37aab8bb",
                                        "glosses": [
                                            "zum Volk der Jenischen gehörig"
                                        ],
