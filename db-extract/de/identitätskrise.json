                "senses": [
                    {
                        "sense_id": "5b8d793d-133d-3111-9b60-9174b9f6535a",
                        "entry_id": "1ab4fbee-9b92-3c1a-9579-23f915cef28b",
                        "glosses": [
                            "Krise, verursacht durch ein unsicheres Selbstbild"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f72df173-e8c6-4629-8753-cdc657d4bde8",
                                "sense_id": "5b8d793d-133d-3111-9b60-9174b9f6535a",
                                "text": "„Oft werde ich gefragt, ob ich als Deutsch-Türke unter einer Identitätskrise leide.“"
                            },
                            {
                                "example_id": "5e61bdfd-9fb1-4f36-83e6-732f0cf188e0",
                                "sense_id": "5b8d793d-133d-3111-9b60-9174b9f6535a",
                                "text": "„Die Abspaltung Bangladeschs verursachte fünfundzwanzig Jahre nach der Staatsgründung nicht nur eine tiefgreifende nationale Identitätskrise; sie hatte überdies gewaltige ökonomische Einbußen zur Folge, da mit Bangladesch der wichtigste Konsumentenmarkt und auch eine bedeutende Quelle für Gütereinfuhren in den ehemaligen Westteil des Landes wegbrachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
