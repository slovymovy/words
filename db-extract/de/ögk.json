                            {
                                "example_id": "789af289-05b0-4423-96c4-efabe9bc322f",
                                "sense_id": "5b40e57c-48a7-321e-9f33-20029f23e2d4",
                                "text": "Die Österreichische Geodätische Kommission (ÖGK), bis in die 1990er Jahre Österreichische Kommission für die internationale Erdmessung (ÖKIE), ist eine Fachkommission für Höhere Geodäsie und benachbarte Geowissenschaften in Wien."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "26ac4cfe-75a6-3bdf-be20-28101fd7ade6",
                        "entry_id": "a58bf10c-edd1-3b43-8763-3b5719a26834",
                        "glosses": [
                            "Österreichische Gesundheitskasse"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "5064fb91-fd05-4380-87f1-36d3cf73722e",
                                "sense_id": "26ac4cfe-75a6-3bdf-be20-28101fd7ade6",
                                "text": "Die Österreichische Gesundheitskasse (ÖGK) ist eine Körperschaft des öffentlichen Rechts (Österreich) mit Sitz Wien und Träger der Pflichtkrankenversicherung in Österreich in Österreich. 2020 wurden durch Fusion die zuvor 21 Versicherungsträger auf fünf reduziert."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "309cc913-f819-3fa3-ad15-f0f4b6332cca",
                        "entry_id": "a58bf10c-edd1-3b43-8763-3b5719a26834",
                        "glosses": [
