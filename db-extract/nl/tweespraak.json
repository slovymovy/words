                                        "examples": [
                                            {
                                                "example_id": "207ae647-fb0b-4810-a7dd-9dd3575e0b52",
                                                "sense_id": "1625a10e-69cb-313d-90d6-3cbbe4528391",
                                                "text": "The purpose of the dialog is not historical accuracy; the argument is all, as it is with Plato's Socrates."
                                            },
                                            {
                                                "example_id": "0f13ce4a-c2fe-4e0d-95cc-e4ee245d1f18",
                                                "sense_id": "1625a10e-69cb-313d-90d6-3cbbe4528391",
                                                "text": "Besides, a video post room's console is smaller than those used for film, and you couldn't squander a dozen or more channels on dialog."
                                            },
                                            {
                                                "example_id": "57321296-70c9-4914-aa25-2197ea65cce4",
                                                "sense_id": "1625a10e-69cb-313d-90d6-3cbbe4528391",
                                                "text": "As we conclude our third annual report on explaining extreme events, the dialog around the value of attribution science is intensifying (Kerr 2013)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6bf9c95-f747-3e63-a13b-20a965d76702",
                                        "entry_id": "1c1207e5-a02d-3b16-8d1d-d213bc88a7b0",
                                        "glosses": [
