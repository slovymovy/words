                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d927fd6d-d9e0-4758-9a9a-96f78d5ca31a",
                                "sense_id": "f28c9fef-bf8c-31ed-846f-576b6ce9469d",
                                "text": "За людьми́ приезжа́ли на чёрных маши́нах, так называ́емых «воро́нках», по ноча́м и забира́ли це́лыми се́мьями.",
                                "translation": "他們在夜裡來抓乘坐黑車的人，即所謂的“voronkas”（稻田車），並逮捕了整個家庭。"
                            }
                        ]
                    },
                    {
                        "sense_id": "198c3d09-8772-349c-ad3c-70009d0f8e86",
                        "entry_id": "d5a00ad0-3bd9-3792-99ef-69a433daf1bf",
                        "glosses": [
