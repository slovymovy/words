                    },
                    {
                        "translation_id": "1f2d6938-c38d-4345-adad-6ead069ce1fe",
                        "source_entry_id": "1763dddd-51ef-387a-8f91-8b2583dc2f35",
                        "source_sense_id": "f2b5c58f-6709-335c-ac55-a2e6b2c58514",
                        "target_lang_word": "nesso di parole",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8d96ee24-b7a3-426f-9374-17035ab4829e",
                        "source_entry_id": "1763dddd-51ef-387a-8f91-8b2583dc2f35",
                        "source_sense_id": "f2b5c58f-6709-335c-ac55-a2e6b2c58514",
                        "target_lang_word": "Wortgruppe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wortgruppe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "440674e3-e3c1-3325-a5e6-f2e0d7b6feda",
                                        "entry_id": "bdf07cd3-5c11-3cb0-81aa-ddc897d65434",
                                        "glosses": [
                                            "Folge von Wörtern (kleiner als ein Satz), die syntaktisch zusammenhängen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "921cfba8-7abc-494d-9f07-69a543a5ac14",
                                                "sense_id": "440674e3-e3c1-3325-a5e6-f2e0d7b6feda",
                                                "text": "Zur wortinternen Großschreibung: „Sie kommt vor bei Substantivkomposita und bei Wortgruppen, die nach den geltenden Normen getrennt zu schreiben wären.“"
                                            },
                                            {
                                                "example_id": "931e698d-6b02-451a-bda5-6816bc787594",
                                                "sense_id": "440674e3-e3c1-3325-a5e6-f2e0d7b6feda",
                                                "text": "„Dabei darf nicht übersehen werden, wie viele Initialwörter der Technik aus englischsprachigen Wortgruppen hervorgegangen sind:…“"
                                            },
                                            {
                                                "example_id": "5ba8890f-fa88-44d2-8574-3e52158a3dc4",
                                                "sense_id": "440674e3-e3c1-3325-a5e6-f2e0d7b6feda",
                                                "text": "„Je abstrakter die Wörter sind, desto wichtiger wird für den Schreiber auch der Bau und die Anordnung von Wortgruppen und Sätzen.“"
                                            },
                                            {
                                                "example_id": "8947ccea-3110-44ef-89ee-71c89143e31f",
                                                "sense_id": "440674e3-e3c1-3325-a5e6-f2e0d7b6feda",
                                                "text": "„Das heißt: Obwohl die Wörter und Wortgruppen dem gleichen Bidungstyp angehören, tendieren wir bei den einzelnen Vertretern mal mehr zum Wort, mal mehr zur Wortgruppe.“"
                                            },
                                            {
                                                "example_id": "da49b110-5402-4bb9-a4aa-5e1d136f60aa",
                                                "sense_id": "440674e3-e3c1-3325-a5e6-f2e0d7b6feda",
                                                "text": "„Wörter und Wortgruppen, die als Zitate aus einer fremden Sprache angesehen werden, bleiben in der Schreibung meist völlig unverändert .“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f73f83eb-fa3b-4e54-95f7-11c3448191eb",
                        "source_entry_id": "1763dddd-51ef-387a-8f91-8b2583dc2f35",
                        "source_sense_id": "f2b5c58f-6709-335c-ac55-a2e6b2c58514",
                        "target_lang_word": "Wortverbindung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wortverbindung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba5374e6-8ec2-39e8-ae36-a3d6a019864c",
                                        "entry_id": "4cea2c2f-8d50-3937-acb8-3b66ccd6f634",
                                        "glosses": [
                                            "„Einheit von mehreren Wörtern, die häufig oder stets zusammen gebraucht werden.“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e2887e9-86ff-47ef-82fa-e0f1184c4f42",
                                                "sense_id": "ba5374e6-8ec2-39e8-ae36-a3d6a019864c",
                                                "text": "„Radio hören“ ist eine Wortverbindung aus dem Substantiv „Radio“ und dem Verb „hören“."
                                            },
                                            {
                                                "example_id": "c121a939-8689-4b84-8c13-8c3db1b64f46",
                                                "sense_id": "ba5374e6-8ec2-39e8-ae36-a3d6a019864c",
                                                "text": "Weitere Wortverbindungen: zu Abend essen, Zähne putzen, Zeit verstreichen lassen"
                                            },
                                            {
                                                "example_id": "c2d66bdb-40f6-476c-9f8b-374368d1ea4a",
                                                "sense_id": "ba5374e6-8ec2-39e8-ae36-a3d6a019864c",
                                                "text": "„Redewendungen, Phraseologismen, das heißt feste Wortverbindungen sind ein wichtiger Bestandteil unserer Sprache.“"
                                            },
                                            {
                                                "example_id": "4e21f119-1df1-461b-9ac5-ceac07836821",
                                                "sense_id": "ba5374e6-8ec2-39e8-ae36-a3d6a019864c",
                                                "text": "„Eine besondere Aufgabe unseres Wörterbuches sahen wir darin, den für die altnordische Sprache besonders charakteristischen Ausdrucksformen möglichst weiten Raum zu geben; es gehören dazu neben den für bestimmte Wörter typischen Wortverbindungen vor allem die unpersönlichen Ausdrücke und die zahlreichen präpositionalen Fügungen.“"
                                            },
                                            {
                                                "example_id": "b0c98bf2-5f8f-465b-ad92-c4038383846b",
                                                "sense_id": "ba5374e6-8ec2-39e8-ae36-a3d6a019864c",
                                                "text": "„Zum Sprachsystem gehören aber nicht nur grammatische und lexikalische Einheiten, sondern auch solche der Phraseologie, d. h. die Wortverbindungen oder Redewendungen, die dem Sprecher zur Verfügung stehen.“"
                                            },
                                            {
                                                "example_id": "3a50b4f1-7b31-4132-98dc-62b7303094e3",
                                                "sense_id": "ba5374e6-8ec2-39e8-ae36-a3d6a019864c",
                                                "text": "„Die deutsche Sprache wimmelt von raffinierten Wortverbindungen und gewitzten Metaphern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e0b7950c-b6b6-373e-aaeb-2382145cad9b",
                                        "entry_id": "4cea2c2f-8d50-3937-acb8-3b66ccd6f634",
                                        "glosses": [
                                            "jedes gemeinsame Vorkommen von Wörtern im Satz"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30078b7a-c960-4d83-b59f-d30235646c59",
                                                "sense_id": "e0b7950c-b6b6-373e-aaeb-2382145cad9b",
                                                "text": "„Einzig und allein für Wortverbindungen wurde von der Einführung bestimmter stenografischer Kürzel abgesehen…“"
                                            },
                                            {
                                                "example_id": "685c2b79-7c62-455e-8715-d5a878ee0b77",
                                                "sense_id": "e0b7950c-b6b6-373e-aaeb-2382145cad9b",
                                                "text": "„Wortverbindungen aus drei Wörtern untersucht NIKITINA (1971), indem sie zunächst in einer umfangreichen Stichprobe publizistischer Texte die 120 häufigsten Substantive bestimmt und dann alle Verbindungen dieser Substantive mit den beiden im Text vorangehenden Wörtern ermittelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
