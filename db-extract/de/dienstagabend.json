                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d09ca10-b14c-4b3c-87ae-e19a4cff0126",
                                "sense_id": "fdd3c61e-b1d3-3dba-8ab0-c60bdaafaac4",
                                "text": "Diese Woche kannst du am Dienstagabend ausgehen. Ich passe auf die Kinder auf."
                            },
                            {
                                "example_id": "99dd5f9c-30b3-43e3-ad8a-b0f64226534c",
                                "sense_id": "fdd3c61e-b1d3-3dba-8ab0-c60bdaafaac4",
                                "text": "Dienstagabende verlaufen in deiner Familie immer sehr hektisch."
                            },
                            {
                                "example_id": "f2440cd2-972a-47fc-a841-106c768ba435",
                                "sense_id": "fdd3c61e-b1d3-3dba-8ab0-c60bdaafaac4",
                                "text": "„Dienstagabend startet in den Schaufenstern eines Möbelhauses auf der Wiener Mariahilfer Straße ein Weltrekordversuch im Dauerfernsehen.“"
                            },
                            {
                                "example_id": "137a6825-7969-409c-a9a1-334df4d3baa8",
                                "sense_id": "fdd3c61e-b1d3-3dba-8ab0-c60bdaafaac4",
                                "text": "„Mastercard erfreut seine Aktionäre. Der Finanzdienstleister will seine Dividende kräftig aufstocken und einen Aktiensplit vornehmen, wie er am Dienstagabend mitteilte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
