                "senses": [
                    {
                        "sense_id": "91142c87-1036-3eba-8bb9-efdc6681fe19",
                        "entry_id": "3e1a1513-e6e3-3762-824a-cba9c517c723",
                        "glosses": [
                            "gewöhnlicher Aufenthaltsort des spirituellen Leiters einer Kirchengemeinde"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "f4c08ac2-f3eb-401e-b659-250d0141d719",
                                "sense_id": "91142c87-1036-3eba-8bb9-efdc6681fe19",
                                "text": "„Die afrikanische Gemeinde der Kirche musste wegen des Vorfalls ihren Weihnachts-Gottesdienst in einem kleinen Besprechungsraum im Pastorat abhalten, berichtete die Diakonin.“"
                            },
                            {
                                "example_id": "453a4061-2f23-47cd-92f4-c3268e7f99f7",
                                "sense_id": "91142c87-1036-3eba-8bb9-efdc6681fe19",
                                "text": "„Das weiß getünchte, reetgedeckte Friesenhaus auf dem Deich neben der Kirche ist das alt-katholische Pastorat von St. Theresia.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "963696ac-ded4-388e-8cc5-f66235d9a726",
                        "entry_id": "3e1a1513-e6e3-3762-824a-cba9c517c723",
                        "glosses": [
                            "Funktion des spirituellen Leiters einer Kirchengemeinde"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "5b1af2e8-4f74-40eb-aefe-5d489d0a199d",
                                "sense_id": "963696ac-ded4-388e-8cc5-f66235d9a726",
                                "text": "„Am 29. Juli 1719 wurde der neue Pfarrer vom Freiherrn und dessen Amtmann Rubens in die Pastorat eingeführt.“"
                            },
                            {
                                "example_id": "d757b78f-d7c5-4ac5-bea5-e53a9ee85cc9",
                                "sense_id": "963696ac-ded4-388e-8cc5-f66235d9a726",
                                "text": "„Gleichzeitig wurde die Fürsorge darauf gerichtet, das katholische Pastorat in Ebernburg fest zu begründen, wozu allerdings die beiden Erfordernisse noch fehlten: die Gemeinde und das Gehalt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
