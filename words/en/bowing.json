    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ff904758-f00d-353a-97da-6a0a2ec449f8",
                    "sense_definition": "Present participle of <w>bow</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The performer was <w>bowing</w> to the audience after finishing the show.",
                            "target_lang_translations": {
                                "nl": "De artiest <w>maakte een buiging</w> voor het publiek na afloop van de show."
                            }
                        },
                        {
                            "text": "He entered the room while respectfully <w>bowing</w> his head.",
                            "target_lang_translations": {
                                "nl": "Hij kwam de kamer binnen terwijl hij eerbiedig zijn hoofd <w>boog</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bowing down",
                        "bowing your head"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Onvoltooid deelwoord van bow (buigen)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "buigen",
                                "target_lang_sense_clarification": "als begroeting of respectbetoon"
                            },
                            {
                                "target_lang_word": "een buiging maken",
                                "target_lang_sense_clarification": "het maken van een buiging"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0aabaaa9-3aa4-3cf3-9cf5-dc776e82890c",
                    "sense_definition": "The act of bending at the waist as a sign of greeting, respect, or deference.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In many cultures, polite <w>bowing</w> is a common way to greet elders.",
                            "target_lang_translations": {
                                "nl": "In veel culturen is een beleefde <w>buiging</w> een gebruikelijke manier om ouderen te begroeten."
                            }
                        },
                        {
                            "text": "The dancer concluded the performance with a low <w>bowing</w> toward the crowd.",
                            "target_lang_translations": {
                                "nl": "De danser sloot het optreden af met een diepe <w>buiging</w> naar het publiek."
                            }
                        }
                    ],
                    "synonyms": [
                        "obeisance",
                        "curtsy"
                    ],
                    "common_phrases": [
                        "polite bowing",
                        "formal bowing"
                    ],
                    "target_lang_definitions": {
                        "nl": "De handeling van buigen vanuit het middel als teken van begroeting, respect of eerbied."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "buiging",
                                "target_lang_sense_clarification": "als gebaar van respect of begroeting"
                            },
                            {
                                "target_lang_word": "het buigen",
                                "target_lang_sense_clarification": "de handeling van het buigen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb53ae69-69ad-3cb8-b53a-e46d7b67c9bb",
                    "sense_definition": "The state or process of curving, arching, or bending under pressure.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy stacks of books caused noticeable <w>bowing</w> in the wooden shelf.",
                            "target_lang_translations": {
                                "nl": "De zware stapels boeken veroorzaakten een opvallende <w>doorbuiging</w> van de houten plank."
                            }
                        },
                        {
                            "text": "An engineer checked the structural <w>bowing</w> along the basement wall.",
                            "target_lang_translations": {
                                "nl": "Een ingenieur controleerde de structurele <w>kromming</w> langs de keldermuur."
                            }
                        }
                    ],
                    "synonyms": [
                        "bending",
                        "warping",
                        "curvature"
                    ],
                    "common_phrases": [
                        "structural bowing"
                    ],
                    "target_lang_definitions": {
                        "nl": "De toestand of het proces van kromtrekken, doorbuigen of buigen onder druk."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "doorbuiging",
                                "target_lang_sense_clarification": "het doorbuigen van materialen onder druk"
                            },
                            {
                                "target_lang_word": "kromming",
                                "target_lang_sense_clarification": "het kromtrekken van een oppervlak of structuur"
                            },
                            {
                                "target_lang_word": "het doorbuigen",
                                "target_lang_sense_clarification": "het proces van bezwijken of buigen onder gewicht"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be886ccb-124d-31af-b17f-cba9a8fe5075",
                    "sense_definition": "The technique or manner of using a bow to play a stringed musical instrument.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her violin teacher spent weeks correcting her improper <w>bowing</w> technique.",
                            "target_lang_translations": {
                                "nl": "Haar vioolleraar was wekenlang bezig met het corrigeren van haar onjuiste <w>strijkstoktechniek</w>."
                            }
                        },
                        {
                            "text": "Smooth <w>bowing</w> is essential to produce a clear sound on the cello.",
                            "target_lang_translations": {
                                "nl": "Een soepele <w>streektechniek</w> is essentieel om een heldere klank uit de cello te halen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bowing technique",
                        "bowing arm"
                    ],
                    "target_lang_definitions": {
                        "nl": "De techniek of manier waarop een strijkstok wordt gebruikt om een snaarinstrument te bespelen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "strijkstoktechniek",
                                "target_lang_sense_clarification": "manier van het hanteren van de strijkstok"
                            },
                            {
                                "target_lang_word": "streektechniek",
                                "target_lang_sense_clarification": "manier van strijken op een strijkinstrument"
                            },
                            {
                                "target_lang_word": "streek",
                                "target_lang_sense_clarification": "de beweging of hantering met de strijkstok"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}