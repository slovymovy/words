                                    {
                                        "sense_id": "95e3ce54-222e-3a3e-92ba-95e586259280",
                                        "entry_id": "d0c020b1-513c-3294-99cb-a5c155c4ac9d",
                                        "glosses": [
                                            "A stand-alone cabinet designed to stand on the floor; especially, one integrated with home entertainment equipment, such as a TV or stereo system."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c9aa189-ae78-4b68-ace9-52b8515e763a",
                                                "sense_id": "95e3ce54-222e-3a3e-92ba-95e586259280",
                                                "text": "The film's music blared from the console."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa1b7fe6-4de1-38f2-81d0-d80bb8970570",
                                        "entry_id": "d0c020b1-513c-3294-99cb-a5c155c4ac9d",
                                        "glosses": [
                                            "A desk-like cabinet, table, or stand upon which controls, instruments, and displays are mounted."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7dc79659-b5fa-3e15-a122-40c31206b12f",
                                        "entry_id": "d0c020b1-513c-3294-99cb-a5c155c4ac9d",
                                        "glosses": [
                                            "An instrument with displays and an input device that is used to monitor and control an electronic system."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d60058a-4818-46d5-970b-1c5fc1c98dd0",
                                                "sense_id": "7dc79659-b5fa-3e15-a122-40c31206b12f",
                                                "text": "The operating console of the new Glasgow Central cabin is divided into four sections, each at an angle to each other and each of which is normally under one signalman's control; [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d56b48b9-faad-3eaf-bfd2-0197ac46e7cd",
                                        "entry_id": "d0c020b1-513c-3294-99cb-a5c155c4ac9d",
                                        "glosses": [
                                            "An instrument with displays and an input device that is used to monitor and control an electronic system.",
                                            "The keyboard and screen of a computer or other electronic device."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "418f0d04-9154-3f23-9b7c-60d5c9347c7c",
                                        "entry_id": "d0c020b1-513c-3294-99cb-a5c155c4ac9d",
                                        "glosses": [
                                            "An instrument with displays and an input device that is used to monitor and control an electronic system.",
                                            "Abbreviation of video game console."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8623aac6-e02f-465d-9c74-71fc80e99191",
                                                "sense_id": "418f0d04-9154-3f23-9b7c-60d5c9347c7c",
                                                "text": "Consoles continue to gain traction in the video game market."
                                            },
                                            {
                                                "example_id": "8d133d89-e37a-46d5-9a21-871e8cd2db85",
                                                "sense_id": "418f0d04-9154-3f23-9b7c-60d5c9347c7c",
                                                "text": "I rarely play FPS on a PC these days. I'm lazy and it's just so much easier to stick on Halo or Modern Warfare 2 on a console. Plus after a day in front of a PC I don't necessarily want to spend an evening in front of one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d30f7e1-7569-3590-b0e2-89e4c76ea602",
                                        "entry_id": "d0c020b1-513c-3294-99cb-a5c155c4ac9d",
                                        "glosses": [
                                            "A storage tray or container mounted between the seats of an automobile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf75d353-cddc-4784-87f8-e392ddd0251c",
                                                "sense_id": "4d30f7e1-7569-3590-b0e2-89e4c76ea602",
                                                "text": "Could you put my phone in the centre console?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c20eb349-ff73-3b5c-b061-0e0c7d6f83a7",
                                        "entry_id": "d0c020b1-513c-3294-99cb-a5c155c4ac9d",
                                        "glosses": [
                                            "An ornamental member jutting out of a wall to carry a superincumbent weight, often S-shaped."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "84e95294-5f7c-3668-97dc-912513f1f69b",
                                        "entry_id": "d0c020b1-513c-3294-99cb-a5c155c4ac9d",
                                        "glosses": [
                                            "cantilever"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f2642da-e4fe-39a4-af1e-8fbd7b801664",
                                        "entry_id": "d0c020b1-513c-3294-99cb-a5c155c4ac9d",
                                        "glosses": [
                                            "A decorative frame or support (in architecture, drawings, etc) around a heraldic shield."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83957be2-10f9-4e33-8c1e-e83ae103946d",
                                                "sense_id": "3f2642da-e4fe-39a4-af1e-8fbd7b801664",
                                                "text": "On an attractive console with two winged putti as supporters [...] is a marriage coat of arms : Dexter, the Paoli arms : Gules (base), a bend azure charged with five lilies gules, and or (chief); Sinister, the[…]"
                                            },
                                            {
                                                "example_id": "757ece74-4ed2-4aa3-b22a-5d516cc94637",
                                                "sense_id": "3f2642da-e4fe-39a4-af1e-8fbd7b801664",
                                                "text": "The only authentic reference for the tincture of the shield still in existence is the armorial console in Jacques Coeur's chapel[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "console",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "09453b1d-428b-3e3e-a632-3e97a5736db9",
                                        "entry_id": "a66d0bd1-16a9-3631-a33f-7e628ab68334",
                                        "glosses": [
                                            "To comfort (someone) in a time of grief, disappointment, etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8bf12ca-01bf-4078-9258-ca9c6d7682d8",
                                                "sense_id": "09453b1d-428b-3e3e-a632-3e97a5736db9",
                                                "text": "However, she contained herself as best she might, consoled by the reflection that her reasoning had been justified by events."
                                            },
                                            {
                                                "example_id": "6d7fb05d-f4a4-4127-9a4a-1fc743634b9f",
                                                "sense_id": "09453b1d-428b-3e3e-a632-3e97a5736db9",
                                                "text": "1856: Gustave Flaubert, Madame Bovary, Part III Chapter X, translated by Eleanor Marx-Aveling\n\"Do you remember, my friend, that I went to Tostes once when you had just lost your first deceased? I consoled you at that time. I thought of something to say then, but now—\" Then, with a loud groan that shook his whole chest, \"Ah! this is the end for me, do you see! I saw my wife go, then my son, and now to-day it's my daughter.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
