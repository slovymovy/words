                "senses": [
                    {
                        "sense_id": "44b245e8-f257-3f14-b5f9-f5624aa8c91c",
                        "entry_id": "79c981e4-ba9c-3c37-95fd-74cacb06b1a9",
                        "glosses": [
                            "von einem Teil der heutigen Zeitgenossen erlebte Geschichte als gegenwärtige Epoche der späten Neuzeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9e6e5e4-fbcc-45c1-90b6-cbefe0ebc9a9",
                                "sense_id": "44b245e8-f257-3f14-b5f9-f5624aa8c91c",
                                "text": "„Als »Eiserner Vorhang« wird in Politik und Zeitgeschichte eine sowohl ideologisch wie tatsächlich »unüberwindbare« Grenze nach ihrem Vorbild aus dem Theaterbau beschrieben.“"
                            },
                            {
                                "example_id": "7170ff08-46b6-465e-8e1a-927db99177bd",
                                "sense_id": "44b245e8-f257-3f14-b5f9-f5624aa8c91c",
                                "text": "„Sein Tagebuch von dieser mühsamen Tour über 310 Meilen bis nach Savannah, Georgia, ist als bedeutendes Dokument der Posthistorie wie der Zeitgeschichte erhalten geblieben und gibt gute Einblicke zu damaligen Entwicklungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
