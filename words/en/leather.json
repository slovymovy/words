        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "58e9844e-4238-348b-91ff-778f6d27954b",
                    "sense_definition": "To hit or beat someone or something with great force.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player <w>leathered</w> the ball into the top corner of the goal.",
                            "target_lang_translations": {
                                "ru": "Игрок <w>вколотил</w> мяч в верхний угол ворот.",
                                "nl": "De speler <w>roste</w> de bal in de kruising van het doel.",
                                "pl": "Zawodnik <w>kropnął</w> piłkę w samo okienko bramki.",
                                "de": "Der Spieler <w>zimmerte</w> den Ball in den oberen Torwinkel.",
                                "fr": "Le joueur a <w>expédié</w> le ballon d'une frappe puissante dans la lucarne du but.",
                                "it": "Il giocatore ha <w>scagliato</w> la palla nell'angolo alto della porta.",
                                "cs": "Hráč <w>napálil</w> míč do horního rohu branky.",
                                "tr": "Oyuncu topu kalenin üst köşesine <w>yapıştırdı</w>.",
                                "es": "El jugador <w>chutó con fuerza</w> el balón hacia la escuadra de la portería.",
                                "zh": "球员一脚<w>猛击</w>，将球踢进了球门的死角。"
                            }
