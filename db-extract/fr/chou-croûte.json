                        "examples": [
                            {
                                "example_id": "5c436617-563d-4ffd-a1aa-bbd1435713fb",
                                "sense_id": "fcd69c5c-0bc2-34cf-bfab-13d8e2556f6c",
                                "text": "Un médecin allemand établi à Moscou, le docteur Huhn, fit adopter, en 1806, pour l’armée russe, alors en campagne, la chou-croûte rendue portative par le procédé suivant :\nOn prend une certaine quantité de chou-croûte, par exemple cent livres ; […]."
                            },
                            {
                                "example_id": "3a7c0791-5ed7-4a6c-a689-f9a221b92742",
                                "sense_id": "fcd69c5c-0bc2-34cf-bfab-13d8e2556f6c",
                                "text": "La Chou-croûte est un excellent manger, quand on a remplacé l’eau de végétation par une saumure faite à froid."
                            },
                            {
                                "example_id": "19545181-5fcd-4069-b9f3-c230dbf5f41d",
                                "sense_id": "fcd69c5c-0bc2-34cf-bfab-13d8e2556f6c",
                                "text": "Prenez deux de ces choux, coupez-les en quatre, supprimez-en le trognon, émincez-les comme je l’ai indiqué à la chou-croûte à la française ; faites-les blanchir, rafraîchissez-les, […]."
                            }
                        ]
                    }
