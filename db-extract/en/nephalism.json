                        ],
                        "examples": [
                            {
                                "example_id": "7304e66f-c4b2-47d8-8e57-c7f990f49010",
                                "sense_id": "d946de11-4d8d-39d9-bdbc-677adf50f5d7",
                                "text": "Our Nephalism we seek to honour as a stepping-stone to the gospel[…"
                            },
                            {
                                "example_id": "6f083e9a-cf3a-402d-a409-b6a74fc6c68c",
                                "sense_id": "d946de11-4d8d-39d9-bdbc-677adf50f5d7",
                                "text": "The medical profession is somewhat divided in its estimate of the comparative value of temperance and of nephalism in promoting the designs which we have in view."
                            },
                            {
                                "example_id": "7ef39c8a-0eb9-4047-874c-4f32a6381f29",
                                "sense_id": "d946de11-4d8d-39d9-bdbc-677adf50f5d7",
                                "text": "May the Lord have mercy on the drunkards of Continental Europe, […] and reclaim them all through the initiatory labours of those who, by nephalism brought back to the practice of the Gospel, have thus been so wonderfully saved from utter ruin and desolation."
                            }
                        ]
                    }
