                        "sense_id": "7b583e2c-7be0-3262-a1af-c3fafac0a057",
                        "entry_id": "d3d0538e-10d9-3b2c-a1a7-c60074566760",
                        "glosses": [
                            "for the most part"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42bffb95-8f66-487e-abfa-be6625b83459",
                                "sense_id": "7b583e2c-7be0-3262-a1af-c3fafac0a057",
                                "text": "Het werk is grotendeels voltooid, maar er zijn nog een paar dingen te doen.",
                                "translation": "The work is for the most part completed, but there are a few things left to do.",
                                "english": "The work is for the most part completed, but there are a few things left to do."
                            },
                            {
                                "example_id": "0f95306c-33e9-4e1b-a703-3cffbc70097c",
                                "sense_id": "7b583e2c-7be0-3262-a1af-c3fafac0a057",
                                "text": "Het bos is grotendeels beschermd gebied.",
                                "translation": "The forest is for the most part a protected area.",
                                "english": "The forest is for the most part a protected area."
                            },
                            {
                                "example_id": "1fae02fa-9392-4d65-97f3-5673b0533134",
                                "sense_id": "7b583e2c-7be0-3262-a1af-c3fafac0a057",
                                "text": "De studenten waren grotendeels tevreden met de nieuwe docent.",
                                "translation": "The students were for the most part satisfied with the new teacher.",
                                "english": "The students were for the most part satisfied with the new teacher."
                            }
                        ]
                    }
