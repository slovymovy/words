                        "glosses": [
                            "Variante orthographique de senioriser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99337a00-acb1-4af6-93c8-4e7f112cb94d",
                                "sense_id": "51878783-42fe-3ee9-a1a1-e9355fb026cb",
                                "text": "\"Infirmiériser\" les smurs, \"sénioriser et camutiser\" les urgences et les smurs améliore la situation, et la démarche est déjà en route."
                            },
                            {
                                "example_id": "1fe17f53-56f4-47d7-bbb8-77d16efa1ef6",
                                "sense_id": "51878783-42fe-3ee9-a1a1-e9355fb026cb",
                                "text": "L'interne n'agissant que par “délégation et sous la responsabilité du praticien dont il relève” toute garde doit être séniorisée."
                            },
                            {
                                "example_id": "9177ac8a-7478-454e-b51f-6fff742446bb",
                                "sense_id": "51878783-42fe-3ee9-a1a1-e9355fb026cb",
                                "text": "Ce diplôme permet aux jeunes pharmaciens de se «sénioriser» plus rapidement en tant que pharmacien adjoint."
                            }
                        ]
                    }
