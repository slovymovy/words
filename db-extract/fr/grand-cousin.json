                "senses": [
                    {
                        "sense_id": "ace87150-0b21-3cb7-aa9a-33a334c08b74",
                        "entry_id": "fba19c72-dac1-3510-8d86-4d9c16895e04",
                        "glosses": [
                            "Fils du grand-oncle ou de la grand-tante d’une personne, autrement dit le cousin de son père ou de sa mère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "573b3dd1-9d05-4bd7-a111-124a6d3a6d2a",
                                "sense_id": "ace87150-0b21-3cb7-aa9a-33a334c08b74",
                                "text": "Et quand je le reçus de leurs mains, vers midi, dans le vestibule de la maison de mon oncle, toujours fermé dans la journée à cause de la lourde chaleur du dehors, on entendait, à la cantonade, mon grand cousin qui chantait, d’une voix atténuée en fausset plaintif de montagnard."
                            },
                            {
                                "example_id": "66c1dd4a-3a44-4c71-b0b0-41fc32e20bc1",
                                "sense_id": "ace87150-0b21-3cb7-aa9a-33a334c08b74",
                                "text": "Jokanaan serait donc, en fait, un grand-cousin de Jésus à notre époque et sous nos latitudes, mais, étant donné les grands écarts d’âge qui pouvaient séparer les enfants d’un même père, à cette époque, il est difficile de se prononcer sur ce point."
                            }
                        ]
                    }
                ],
                "translations": [
