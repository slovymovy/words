                        "glosses": [
                            "Donner un caractère téléonomique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f96747f1-01c5-44d7-b125-510a1b8cbec2",
                                "sense_id": "ef04ee3a-b412-339d-a895-d81105ab9272",
                                "text": "Le sens n'est ni posé a priori en tant que signifié préalable, ni téléonomisé en tant que référé à un ordre transcendantal."
                            },
                            {
                                "example_id": "fdfce73a-5909-4ce3-8988-15f617e91481",
                                "sense_id": "ef04ee3a-b412-339d-a895-d81105ab9272",
                                "text": "Les cassures historiques sont alors téléonomisées au niveau des représentations théoriques et l'éclectisme apparaît."
                            }
                        ]
                    }
