                        "glosses": [
                            "Musicien ou musicienne qui joue de l’harmonéon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "184fa31f-f766-43c6-9bf5-7f4ec21de94a",
                                "sense_id": "00758c3b-e639-3889-bd41-5abe6372a718",
                                "text": "Y a-t-il un harmonéoniste parmi nous ? Parlez-moi de cette belle aventure, si elle est personnelle sinon j’ai lu l’essentiel sur Pierre Monichon et son instrument."
                            },
                            {
                                "example_id": "36280847-b2d3-43f3-a99a-10a4e1e79d29",
                                "sense_id": "00758c3b-e639-3889-bd41-5abe6372a718",
                                "text": "Elle aime aussi interpréter des standards de blues, la musique de Gerschwin et le Negro Spiritual auquel elle a consacré une série de concerts « Plantation songs », accompagnée par l’harmonéoniste William Robin."
                            }
                        ]
                    }
