                "senses": [
                    {
                        "sense_id": "80c03360-9a41-3331-98f2-9c3819854db4",
                        "entry_id": "d0dcad4a-06dc-3562-a8bb-c90ec72c98da",
                        "glosses": [
                            "Jongler à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4298baad-9e23-4921-b1cc-498e2f14a7e2",
                                "sense_id": "80c03360-9a41-3331-98f2-9c3819854db4",
                                "text": "Vous verrez pendant le ralenti que les doigts se réajustent à chaque fois pour rejongler avec la balle."
                            },
                            {
                                "example_id": "c9a27e33-709a-44b4-9606-9aa30888c740",
                                "sense_id": "80c03360-9a41-3331-98f2-9c3819854db4",
                                "text": "Il vous faudra jongler et rejongler."
                            },
                            {
                                "example_id": "c3213982-cc0b-496e-9299-25a96ab79214",
                                "sense_id": "80c03360-9a41-3331-98f2-9c3819854db4",
                                "text": "Moi du coup je dois rejongler avec tout mes trucs pour arriver à recaser tout le monde dans un laps de temps pas trop long."
                            }
                        ]
                    }
                ],
