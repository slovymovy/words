                        "examples": [
                            {
                                "example_id": "bdafdf38-8fba-4a47-b32b-e8b42d35787d",
                                "sense_id": "48a0ef78-9622-3658-a163-edf6ebe5ebf4",
                                "text": "Hij had kort daarvoor al zijn taken neergelegd, nadat vrijwel het hele partijbestuur was opgestapt uit onvrede over zijn functioneren. Zoetelief was nog geen jaar geleden met de zegen van de partijtop gekozen als opvolger van partijcoryfee Jan Nagel."
                            },
                            {
                                "example_id": "8a98a7c9-adbd-46de-ac79-e85f808fb1a8",
                                "sense_id": "48a0ef78-9622-3658-a163-edf6ebe5ebf4",
                                "text": "De partijtop had hen begin november veel lager op de lijst geplaatst en ontzegde hen daarmee feitelijk een nieuwe termijn als raadslid. De omstreeks 3800 leden van D66 Amsterdam waren het daar niet mee eens, blijkt na de herschikking."
                            }
                        ]
