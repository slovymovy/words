                    "frequency": "VeryLow",
                    "semantic_group_id": "chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traditional recipe requires adding <w>yearning</w> to the warm milk.",
                            "target_lang_translations": {
                                "de": "Das traditionelle Rezept erfordert die Zugabe von <w>Lab</w> zur warmen Milch."
                            }
                        },
                        {
                            "text": "The cheesemaker carefully measured the <w>yearning</w> to ensure the curd formed correctly.",
                            "target_lang_translations": {
                                "de": "Der Käser maß das <w>Lab</w> sorgfältig ab, um sicherzustellen, dass die Dickete richtig entstand."
                            }
                        }
                    ],
                    "synonyms": [
