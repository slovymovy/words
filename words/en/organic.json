        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a1f81378-d0c8-33c0-b08b-678750ef6729",
                    "sense_definition": "Produced or involving production without the use of chemical fertilizers, pesticides, or other artificial chemicals.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people prefer to buy <w>organic</w> vegetables even if they are more expensive.",
