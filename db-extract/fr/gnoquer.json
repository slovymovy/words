        "fr-extract.jsonl": [
            {
                "entry_id": "d7f05f27-5dc4-3fb7-9cbb-e4e3817b33ef",
                "word": "gnoquer",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "56bce6a5-1985-3840-bfa2-532bb7e776b6",
                        "entry_id": "d7f05f27-5dc4-3fb7-9cbb-e4e3817b33ef",
                        "glosses": [
                            "Piger."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "96422fbc-d5bc-4137-8939-ebc013ca5de4",
                                "sense_id": "56bce6a5-1985-3840-bfa2-532bb7e776b6",
                                "text": "Mais avant de pouvoir la juger, il fallait gnoquer selon quels critères la juger."
                            },
                            {
                                "example_id": "de2e3f5e-b7af-47a8-accc-2f1fe8b0886c",
                                "sense_id": "56bce6a5-1985-3840-bfa2-532bb7e776b6",
                                "text": "En l’occurrence, le verbe «gnoquer» qui signifie «comprendre pleinement» et «ne faire plus qu’un avec l’objet de sa réflexion»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "037309aa-1ca5-41d7-b2c5-21d1c3878228",
                        "source_entry_id": "d7f05f27-5dc4-3fb7-9cbb-e4e3817b33ef",
                        "source_sense_id": "56bce6a5-1985-3840-bfa2-532bb7e776b6",
                        "target_lang_word": "grok",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grok",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a47b0b06-24d5-31ea-9aff-3a6e2871623d",
                                        "entry_id": "e6e58d03-e033-38b7-8d64-4965df5bfa59",
                                        "glosses": [
                                            "To understand (something) intuitively, to know (something) without having to think intellectually."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57629319-cf48-449b-be19-04a919e36b88",
                                                "sense_id": "a47b0b06-24d5-31ea-9aff-3a6e2871623d",
                                                "text": "I do not grok all fullness of what I read. In the history written by Master William Shakespeare I found myself full of happiness at the death of Romeo. Then I read on and learned that he had discorporated too soon – or so I thought I grokked. Why?"
                                            },
                                            {
                                                "example_id": "71691afb-b387-4d1f-9841-874cdd1049d4",
                                                "sense_id": "a47b0b06-24d5-31ea-9aff-3a6e2871623d",
                                                "text": "Grok―and then it's clear, without anybody having to say it."
                                            },
                                            {
                                                "example_id": "c5b7a1ed-4cb1-4fad-8409-8c8ce5e9d172",
                                                "sense_id": "a47b0b06-24d5-31ea-9aff-3a6e2871623d",
                                                "text": "He freely plucks notions and verbiage from science fiction to describe everything from mountain-related undertakings to political subterfuge – like \"grok\", a term from Robert Heinlein's Stranger in a Strange Land, to denote intuitive understanding."
                                            },
                                            {
                                                "example_id": "673778a3-328e-4318-ba00-d1a4a03262c0",
                                                "sense_id": "a47b0b06-24d5-31ea-9aff-3a6e2871623d",
                                                "text": "Because what he never managed to grok then was that the company he created was destined to become a template for all of humanity, the digital reflection of masses of people across the globe. Including — and especially — the bad ones."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b581c37-a186-3e66-af85-bacaabc1fa40",
                                        "entry_id": "e6e58d03-e033-38b7-8d64-4965df5bfa59",
                                        "glosses": [
                                            "To fully and completely understand something in all of its details and intricacies."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e893341-c507-4664-8301-a1be3df0e6d9",
                                                "sense_id": "5b581c37-a186-3e66-af85-bacaabc1fa40",
                                                "text": "I finally grok Perl."
                                            },
                                            {
                                                "example_id": "e3a4406c-73f4-4258-abf4-d0967517bca5",
                                                "sense_id": "5b581c37-a186-3e66-af85-bacaabc1fa40",
                                                "text": "I find it exceedingly doubtful that any person groks quantum mechanics."
                                            },
                                            {
                                                "example_id": "e0875646-629b-418e-9a91-4451a2c7b7e7",
                                                "sense_id": "5b581c37-a186-3e66-af85-bacaabc1fa40",
                                                "text": "Today we take a few moments to help you grok some of the ways that victims of TU can up their hipness – if we may use that term without being considered old school."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
