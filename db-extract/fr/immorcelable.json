                        "glosses": [
                            "Que l’on ne peut pas morceler."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "b4d0f726-d723-48f5-a961-54ffd586a07d",
                                "sense_id": "7d05f197-deb9-3a52-81f5-c26677871295",
                                "text": "Son but est de reproduire le plus fidèlement possible ce tout « immorcelable » que constituent l'art et la nature."
                            },
                            {
                                "example_id": "4e19e6b1-2257-485e-90dc-5b63c41c1476",
                                "sense_id": "7d05f197-deb9-3a52-81f5-c26677871295",
                                "text": "Le droit ne pouvant pas renoncer à la personne, il n'aura d'autre ressource que de la séparer du corps biologique et d'admettre la réalité d'une personne centrale, incessible, invendable, immorcelable, qui serait propriétaire de ce corps, […]."
                            }
                        ]
