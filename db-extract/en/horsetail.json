                                        "sense_id": "8e878a09-0bf1-31b0-aee8-1f49cb784e85",
                                        "entry_id": "d70a5440-30da-3fa9-b917-fa96f5e5aff4",
                                        "glosses": [
                                            "haardracht waarbij het haar op het achterhoofd in een bundel wordt samengebonden"
