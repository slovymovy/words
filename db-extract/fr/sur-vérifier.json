                ],
                "senses": [
                    {
                        "sense_id": "c35c6da8-1d2a-36e7-98bf-478f76a943ff",
                        "entry_id": "746b1ec7-99e0-3120-8dfa-ce193bda297f",
                        "glosses": [
                            "Vérifier plus que la normale, plus qu’on ne le fait habituellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6344dda1-f151-421b-ba69-cac056a1c903",
                                "sense_id": "c35c6da8-1d2a-36e7-98bf-478f76a943ff",
                                "text": "Et moi, si je ne peux pas vérifier, re-vérifier, sur-vérifier que j’ai pris la bonne décision, je suis perdu !"
                            },
                            {
                                "example_id": "50c30da4-92a5-47ae-a328-bbf1b3244663",
                                "sense_id": "c35c6da8-1d2a-36e7-98bf-478f76a943ff",
                                "text": "Julien vérifie, revérifie et sur-vérifie."
                            },
                            {
                                "example_id": "29ea274b-e93f-4f08-a883-64ae2407e157",
                                "sense_id": "c35c6da8-1d2a-36e7-98bf-478f76a943ff",
                                "text": "Finalement, elle ne peut s’exprimer, dans l’état actuel de la connaissance dévoilée, que dans l’ajustement total au système novateur culturel, vérifié, revérifié, sur-vérifié."
                            }
                        ]
                    }
