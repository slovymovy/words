                ],
                "senses": [
                    {
                        "sense_id": "5326db07-372d-30e1-9a30-84eed838f27f",
                        "entry_id": "99e54ab1-7558-3ced-b886-bc7f12cd197e",
                        "glosses": [
                            "verletzte Stelle in einem (Haut-)Gewebe, an der etwas, zum Beispiel ein Geschoss/Projektil, einen Körper oder Ähnliches verlassen hat (ausgetreten ist)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffea66b5-6e28-466b-b4c3-03f18c927c55",
                                "sense_id": "5326db07-372d-30e1-9a30-84eed838f27f",
                                "text": "„Eine Austrittswunde ist größer als eine Eintrittswunde und besitzt gezackte Ränder.“"
                            },
                            {
                                "example_id": "5f3d5340-d65d-44b1-ae5e-0d51d50204df",
                                "sense_id": "5326db07-372d-30e1-9a30-84eed838f27f",
                                "text": "„Sollte trotz einer Eintrittswunde […] keine Austrittswunde […] zu finden sein, ist eine klare Indikation zur chirurgischen Exploration gegeben.“"
                            },
                            {
                                "example_id": "a613964c-a21a-46e1-be8d-72d251d44979",
                                "sense_id": "5326db07-372d-30e1-9a30-84eed838f27f",
                                "text": "„Eine Eintrittswunde stützt sich gegen das darunterliegende Gewebe ab, bei einer Austrittswunde ist dies nicht der Fall.“"
                            },
                            {
                                "example_id": "bf01d47c-cce7-4301-a810-a13755ac1fec",
                                "sense_id": "5326db07-372d-30e1-9a30-84eed838f27f",
                                "text": "„Bei Stichwunden ist entsprechend dem ‚low velocity‘-Charakter der Weichteilschaden auf Ein- bzw. Austrittswunde bei perforierenden Verletzungen bzw. die unmittelbar an den Stichkanal angrenzende Region limitiert.“"
                            },
                            {
                                "example_id": "a3c6e80a-872d-46d6-8bad-9ce384aa8da6",
                                "sense_id": "5326db07-372d-30e1-9a30-84eed838f27f",
                                "text": "„Eine perforierende Hornhautverletzung ist […] eine penetrierende Bulbusverletzung, und eine perforierende Bulbusverletzung ist eine solche mit einer Ein- und einer Austrittswunde.“"
                            },
                            {
                                "example_id": "fbec9d3a-337c-4cc6-b570-e0ac41cef41f",
                                "sense_id": "5326db07-372d-30e1-9a30-84eed838f27f",
                                "text": "„Er drehte das Bein und musterte die Austrittswunde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
