                            {
                                "example_id": "3e604bb9-1aa0-4307-8e12-f5d028618b4e",
                                "sense_id": "8e437190-003b-3083-a146-5e6ea0b05bf7",
                                "text": "Święty ojciec Pio stał się jednym z najpopularniejszych świętych Kościoła katolickiego"
                            },
                            {
                                "example_id": "43e9eaef-8d11-49ff-bbc6-9077df47af14",
                                "sense_id": "8e437190-003b-3083-a146-5e6ea0b05bf7",
                                "text": "Znajduje się tam klasztor ojców kapucynów, w którym żył i pracował słynny stygmatyk Ojciec Pio"
                            },
                            {
                                "example_id": "8acf0615-c1ab-45fc-b4f3-9d88b4fb3db7",
                                "sense_id": "8e437190-003b-3083-a146-5e6ea0b05bf7",
                                "text": "Mam na imię Pio i jestem wokalistą kapeli heavymetalowej z Fiesole."
                            },
                            {
                                "example_id": "420b0fda-597c-442a-a388-74221a78704f",
                                "sense_id": "8e437190-003b-3083-a146-5e6ea0b05bf7",
                                "text": "Wuj Pio był niepoprawnym dzieckiem szlachcica z dobrego kastylijskiego domu"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
