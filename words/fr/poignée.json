                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux hommes ont échangé une chaleureuse <w>poignée</w> de main avant de commencer la réunion."
                        },
                        {
                            "text": "Il a salué son voisin d'une vigoureuse <w>poignée</w> de main pour le remercier de son aide."
                        }
                    ],
                    "synonyms": [
                        "poignée de main"
                    ],
                    "common_phrases": [
                        "poignée de main chaleureuse",
                        "échanger une poignée de main"
                    ]
                },
                {
                    "sense_id": "687e8500-219d-32d1-9bc9-9ff8112c3634",
                    "sense_definition": "Organe de commande d'un appareil ou véhicule que l'on actionne manuellement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mecanisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cycliste a serré la <w>poignée</w> de frein pour éviter un piéton sur la route."
                        },
                        {
                            "text": "Le pilote a tourné la <w>poignée</w> des gaz pour accélérer dans la ligne droite."
                        }
                    ],
                    "common_phrases": [
                        "poignée de frein",
                        "poignée des gaz"
                    ]
                },
                {
                    "sense_id": "b12564d9-c496-31d3-bf06-50cbdd747e49",
                    "sense_definition": "Morceau d'étoffe ou de cuir permettant de saisir des ustensiles très chauds sans se brûler.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ustensile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Prenez une <w>poignée</w> pour sortir ce plat brûlant du four sans danger."
                        },
                        {
                            "text": "Elle a utilisé une <w>poignée</w> de tissu pour déplacer la marmite fumante."
