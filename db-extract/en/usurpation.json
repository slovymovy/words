                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2b7c3228-0792-3a0d-91ec-25d1e21e0b9e",
                                        "entry_id": "cb6a9ddd-b38f-3d29-b583-51b5617b103f",
                                        "glosses": [
                                            "Action d’usurper ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7844e447-6cd4-4ef0-a542-a893b60a04c0",
                                                "sense_id": "2b7c3228-0792-3a0d-91ec-25d1e21e0b9e",
                                                "text": "J’en appellerai à Rome contre toi, répondit le grand maître, pour usurpation sur les immunités et privilèges de notre ordre."
                                            },
                                            {
                                                "example_id": "a7dea2a6-d7b8-4798-b0fd-dd2279aa994f",
                                                "sense_id": "2b7c3228-0792-3a0d-91ec-25d1e21e0b9e",
                                                "text": "Les États-Unis ont hérité de l’Angleterre ce système d’envahissement et d’usurpation continuel qui est un des points les plus saillants du caractère britannique."
                                            },
                                            {
                                                "example_id": "217846be-57dc-41bf-87d8-fb2f007ddfac",
                                                "sense_id": "2b7c3228-0792-3a0d-91ec-25d1e21e0b9e",
                                                "text": "[…], il se laissa imposer le titre de roi des Français sous le nom de Louis-Philippe Iᵉʳ (7 août 1830). C'était une usurpation audacieuse de la souveraineté nationale; l'avènement de la branche cadette peut être qualifiée un escamotage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24180d4e-3776-3643-bc76-eab32134a172",
                                        "entry_id": "cb6a9ddd-b38f-3d29-b583-51b5617b103f",
                                        "glosses": [
                                            "La chose même qui est usurpée."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e0128e6-e8b2-41d9-af68-c488fb68446b",
                                                "sense_id": "24180d4e-3776-3643-bc76-eab32134a172",
                                                "text": "La plupart des terres de cette seigneurie n’étaient que des usurpations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2fd7f055-b37f-4a63-a0b5-3ec3bf6760ab",
                        "source_entry_id": "f93ecd4e-dffb-3692-8cb3-003b179406ee",
