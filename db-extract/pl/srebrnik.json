                "translations": [
                    {
                        "translation_id": "03929cfd-6581-4ed5-9fe7-d970e79dc764",
                        "source_entry_id": "5ec732d5-553d-31c2-b844-b6483d43a379",
                        "source_sense_id": "20742a64-8ad7-3096-b5b6-727a1bcc0b45",
                        "target_lang_word": "silverling",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "silverling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "749cf27b-bbf1-38ea-932a-83f40b90650f",
                                        "entry_id": "ff9d2900-c0b0-31b3-aee0-a0e8252cb51d",
                                        "glosses": [
                                            "Shekel or small silvern coin of little value."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15536dc0-114a-4416-9055-1e29a6e4a073",
                                                "sense_id": "749cf27b-bbf1-38ea-932a-83f40b90650f",
                                                "text": "As for those Samnites, and the men of Uz,\nThat bought my Spanish oils and wines of Greece,\nHere have I purs'd their paltry silverlings.\nFie, what a trouble 'tis to count this trash!"
                                            },
                                            {
                                                "example_id": "a0f5db7d-346f-456a-a418-f36410d348f9",
                                                "sense_id": "749cf27b-bbf1-38ea-932a-83f40b90650f",
                                                "text": "And it shall come to pass in that day, that every place shall be, where there were a thousand vines at a thousand silverlings, it shall even be for briers and thorns."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d4ed6ba-d935-3612-9886-dc2421df4d49",
                                        "entry_id": "ff9d2900-c0b0-31b3-aee0-a0e8252cb51d",
                                        "glosses": [
                                            "Baccharis halimifolia, a shrub of the aster family."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
