                        "examples": [
                            {
                                "example_id": "879969ac-3a3f-4758-a594-be2103bd24a1",
                                "sense_id": "b2558af5-67bb-3e25-8a9d-05336eb85c0a",
                                "text": "Investeerders willen uiteindelijk een prettig rendement terugzien op het geld dat zij in welk bedrijf dan ook hebben gestoken. Voor een investeerder in de vervoersonderneming die vorig jaar nog een bescheiden winst boekte, zal dat niet anders zijn."
                            },
                            {
                                "example_id": "b7dd1007-8d1f-433a-beaa-1a07670c48f5",
                                "sense_id": "b2558af5-67bb-3e25-8a9d-05336eb85c0a",
                                "text": "Descheemaecker vindt dat de Belgische spoorwegen het best gediend zijn met een vervoersonderneming (NMBS) en een infrastructuurbeheerder (Infrabel), zonder dat daar nog een holding boven staat."
                            }
