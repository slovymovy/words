                    {
                        "sense_id": "255ae9aa-deab-35d7-a4f6-92d290e20894",
                        "entry_id": "ec01deea-7a4e-32ed-8672-63da2bbad50f",
                        "glosses": [
                            "een asymmetrische kabel waarvan de twee geleiders cilindrisch om elkaar heen geconstrueerd zijn met een diëlektricum (isolatiemateriaal) ertussen waarbij de buitenmantel afschermt tegen externe storende invloeden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "319373a2-6f5b-4403-baf3-577298ed90ff",
                                "sense_id": "255ae9aa-deab-35d7-a4f6-92d290e20894",
                                "text": "Dit kan beter met een coaxkabel gedaan worden, die is ongevoeliger voor het oppikken van stoorsignalen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4eccb50e-a720-4c1e-8331-eddd7e5c2d1a",
                        "source_entry_id": "ec01deea-7a4e-32ed-8672-63da2bbad50f",
                        "source_sense_id": "255ae9aa-deab-35d7-a4f6-92d290e20894",
                        "target_lang_word": "Koaxialkabel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Koaxialkabel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "edb79879-1482-3815-8445-c56b51b69fef",
                                        "entry_id": "af0189d5-e556-3dd8-b40e-cd50553fb343",
                                        "glosses": [
                                            "Kabel, das im Inneren leitendes Material (Innenleiter) hat, das von einer Isolierschicht (Isolierung) umgeben ist, das wieder von einem röhrenartigen Außenleiterfolie umgeben ist"
                                        ],
                                        "tags": [
                                            "Hochfrequenztechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c9a417d-b4cf-48c5-a16a-d7613d6de3a8",
                                                "sense_id": "edb79879-1482-3815-8445-c56b51b69fef",
                                                "text": "Als TV-Anschlusskabel wird ein Koaxialkabel mit doppelter Abschirmung beim Kabel-TV verwendet."
                                            },
                                            {
                                                "example_id": "b87fad98-a1ea-4c56-8e46-51e0d1d1d96a",
                                                "sense_id": "edb79879-1482-3815-8445-c56b51b69fef",
                                                "text": "„Die sogenannten Koaxialkabel sind technisch aber aufwendiger als die dünneren Telekomleitungen.“"
                                            },
                                            {
                                                "example_id": "b2753472-98e6-4d17-b726-62aec240b74a",
                                                "sense_id": "edb79879-1482-3815-8445-c56b51b69fef",
                                                "text": "„Um den gewünschten Effekte zu erzielen, hat Eliyahu Jerby von der Universität von Tel Aviv ein handelsübliches Mikrowellengerät ausgeschlachtet. Dessen Herzstück, das so genannte Magnetron, hat er anschließend mit einem Koaxialkabel verbunden, das in ähnlicher Form als Antennenkabel im Haushalt verwendet wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
