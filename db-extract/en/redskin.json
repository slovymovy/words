                "translations": [
                    {
                        "translation_id": "d13b65ef-27ee-4bde-94a1-a86d3ed126d9",
                        "source_entry_id": "f1b87ae1-b351-345c-ab0f-c8a51700fc55",
                        "source_sense_id": "e53d6dd2-68ce-3b9f-bbcc-d50b97b11f8d",
                        "source_sense_description": "an American Indian",
                        "target_lang_word": "Peau-Rouge",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Peau-Rouge",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b8cb611-050e-3a9e-83ad-2f322b321e92",
                                        "entry_id": "13ef6a8e-fcf3-305f-81a0-6078241dcbfb",
                                        "glosses": [
                                            "Amérindien."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c6994c6-fe94-49a0-86d2-9f9568c4846f",
                                                "sense_id": "1b8cb611-050e-3a9e-83ad-2f322b321e92",
                                                "text": "De je ne sais plus quelle histoire, lue l’hiver précédent, sur les Indiens des Grands-Lacs, j’avais retenu ceci, qui m’avait beaucoup frappé : un vieux chef Peau-Rouge, dont la fille se languissait d’amour pour un Visage-Pâle, avait fini par consentir à la donner à cet étranger, afin qu’elle eût encore de la joie à ses réveils."
                                            },
                                            {
                                                "example_id": "9448addf-97f5-4222-b2d7-6499cb5e0f21",
                                                "sense_id": "1b8cb611-050e-3a9e-83ad-2f322b321e92",
                                                "text": "Toutes les éventualités se présentèrent : le désert sans ressources, des Américains exaspérés, des Japonais, des Chinois, peut-être des Peaux-Rouges ! … Y avait-il encore des Peaux-Rouges ?"
                                            },
                                            {
                                                "example_id": "85839225-2486-4e1f-81f9-fa25c6750484",
                                                "sense_id": "1b8cb611-050e-3a9e-83ad-2f322b321e92",
                                                "text": "Mais ma mère avait trouvé un moyen de me coincer en me confiant des rôles de Peau-Rouge. Elle connaissait mes goûts et savait très bien que je préférais les Indiens aux cow-boys."
                                            },
                                            {
                                                "example_id": "a962ba89-2704-4248-9ec5-0d0883a616f4",
                                                "sense_id": "1b8cb611-050e-3a9e-83ad-2f322b321e92",
                                                "text": "Le prisonnier croit être tombé entre les mains d'une bande de Peaux-Rouges qui vont le soumettre à la torture."
                                            },
                                            {
                                                "example_id": "320282a7-0e54-4354-826a-06d41030ad9a",
                                                "sense_id": "1b8cb611-050e-3a9e-83ad-2f322b321e92",
                                                "text": "Si vous n’y prenez garde, vous risquez d’effrayer nos chers Peaux-Rouges !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2fa3664-6efa-474f-8bca-077aab3c3706",
                        "source_entry_id": "f1b87ae1-b351-345c-ab0f-c8a51700fc55",
                        "source_sense_id": "e53d6dd2-68ce-3b9f-bbcc-d50b97b11f8d",
                        "source_sense_description": "an American Indian",
                        "target_lang_word": "Rothaut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rothaut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f9194b44-4220-37fc-8db3-03e5ed66f3cd",
                                        "entry_id": "cf159b84-ecde-394c-9549-ab22069df28b",
                                        "glosses": [
                                            "abwertend, scherzhaft, veraltet: indigener Bewohner Nordamerikas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdbc63a1-d05d-4351-8ced-66814a31f143",
                                                "sense_id": "f9194b44-4220-37fc-8db3-03e5ed66f3cd",
                                                "text": "„Wie in der Frage der Rothäute sind sie auch in der der Schwarzhäute nicht allzu wirksam gewesen, denn fast zweihundert Jahre mußten seit jenem Protest von Germantown vergehen, bevor sich die Anhänger und die Gegner der Sklaverei entscheidend trafen.“"
                                            },
                                            {
                                                "example_id": "cc56a38e-e1e7-45ea-a312-6dd8af1ad1b7",
                                                "sense_id": "f9194b44-4220-37fc-8db3-03e5ed66f3cd",
                                                "text": "„Die beiden Indianer führten uns hinunter zum Flussbett und dann tatsächlich unter die Brücke, auf der Seite des Wachpostens, wo wir eine Gruppe von ungefähr dreißig Männern, Frauen und Kindern dieser Rothäute trafen.“"
                                            },
                                            {
                                                "example_id": "737f4b7a-7faf-4511-89f5-a90abf88f6e5",
                                                "sense_id": "f9194b44-4220-37fc-8db3-03e5ed66f3cd",
                                                "text": "„Zwischen Weißen und Rothäuten findet ein großer Kampf statt.“"
                                            },
                                            {
                                                "example_id": "67ab9688-9b17-4de2-b75e-548fdc1ea9f3",
                                                "sense_id": "f9194b44-4220-37fc-8db3-03e5ed66f3cd",
                                                "text": "„Bald trat sie in die liberale National Indian Defence Association (N.I.D.A.) ein und engagierte sich für sogenannte Rothäute wie Sitting Bull.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
