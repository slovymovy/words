                "senses": [
                    {
                        "sense_id": "5af36a3b-f63c-39f7-a2c5-5602f1e63c06",
                        "entry_id": "ddbc7fdf-cea8-32f6-856e-eedaf00b8365",
                        "glosses": [
                            "geur van spijzen, dranken, genotmiddelen enz"
                        ],
                        "tags": [
                            "aangename"
                        ],
                        "examples": [
                            {
                                "example_id": "cc3f40bb-083b-4ebb-b7c7-130dad53ec47",
                                "sense_id": "5af36a3b-f63c-39f7-a2c5-5602f1e63c06",
                                "text": "Toen ik thuis kwam rook ik direct het heerlijke aroma van het eten."
                            }
                        ]
                    },
                    {
                        "sense_id": "9c48ca0b-16d5-330a-b007-3f696f454d09",
                        "entry_id": "ddbc7fdf-cea8-32f6-856e-eedaf00b8365",
                        "glosses": [
                            "stof die smaak en geur aan spijzen etc. geeft"
                        ],
                        "tags": [
                            "specerij",
                            "kruid"
                        ],
                        "examples": [
                            {
                                "example_id": "9ba9ff1b-8ae4-40d8-bfc0-29ee792a609e",
                                "sense_id": "9c48ca0b-16d5-330a-b007-3f696f454d09",
                                "text": "Op de verpakking van kant-en-klaarmaaltijden kun je lezen welke aroma's gebruikt werden. Hiervoor moet je kijken onder het kopje geur- en smaakstoffen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11bfd647-6895-4d8f-bfa8-0d76e4ff602b",
                        "source_entry_id": "ddbc7fdf-cea8-32f6-856e-eedaf00b8365",
                        "source_sense_id": "5af36a3b-f63c-39f7-a2c5-5602f1e63c06",
                        "source_sense_description": "(aangename) geur van spijzen, dranken, genotmiddelen enz",
                        "target_lang_word": "Aroma",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aroma",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b6ea02e4-c63a-3487-b129-1a243f3dca7b",
                                        "entry_id": "85b91ba5-f055-365c-b247-ceb3b0f8be5e",
                                        "glosses": [
                                            "bestimmter, meist angenehmer, durch einen Geruchsstoff ausgelöster Duft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a9cb272-8362-4058-8a44-e2c3017db8f7",
                                                "sense_id": "b6ea02e4-c63a-3487-b129-1a243f3dca7b",
                                                "text": "Ich mag es, wenn morgens das Aroma von Kaffee in der Luft liegt."
                                            },
                                            {
                                                "example_id": "0b1f7eec-cfdd-4ed6-833b-24959fbccb60",
                                                "sense_id": "b6ea02e4-c63a-3487-b129-1a243f3dca7b",
                                                "text": "In der Likörfabritation haben die Aromas, in konzentrierter Form aus den Früchten dargestellt, große Wichtigkeit. (1892)"
                                            },
                                            {
                                                "example_id": "d579729e-ae8e-44b0-a8a7-16d619c46d1c",
                                                "sense_id": "b6ea02e4-c63a-3487-b129-1a243f3dca7b",
                                                "text": "Je reifer Trauben geerntet werden, desto reicher und komplexer werden die Aromen."
                                            },
                                            {
                                                "example_id": "b8e6b0bf-69e3-4b63-a911-df88608611b7",
                                                "sense_id": "b6ea02e4-c63a-3487-b129-1a243f3dca7b",
                                                "text": "Theophrast gab schon im dritten Jahrhundert v. Chr. an, man solle die Operation im Wasserbade vornehmen, um ein Anbrennen der Aromata zu verhindern."
                                            },
                                            {
                                                "example_id": "22317b70-8450-47da-a8a5-157fe65f1c98",
                                                "sense_id": "b6ea02e4-c63a-3487-b129-1a243f3dca7b",
                                                "text": "„Später hatte das Aroma seines Waschmittels mir einen Stich versetzt, ein unbestimmtes Gefühl von Versagen vermittelt, genau wie es seine Worte regelmäßig taten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "687f26b2-3bd5-342c-afb0-ef764af2af07",
                                        "entry_id": "85b91ba5-f055-365c-b247-ceb3b0f8be5e",
                                        "glosses": [
                                            "bestimmter, meist angenehmer, durch einen Geschmacksstoff ausgelöster Geschmack"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34ffa1db-21f8-4253-b981-0746285a3ba2",
                                                "sense_id": "687f26b2-3bd5-342c-afb0-ef764af2af07",
                                                "text": "Das Aroma der reifen Pfirsiche ist einfach überwältigend!"
                                            },
                                            {
                                                "example_id": "4f9f6d58-33b7-4337-b5f3-cd99bd53e685",
                                                "sense_id": "687f26b2-3bd5-342c-afb0-ef764af2af07",
                                                "text": "„Die Zubereitung ist typisch für die Kanaren: Man legt sie in einen Tontopf mit Deckel und gießt wenig sehr stark gesalzenes Wasser dazu, das sie beim Verdampfen mit einer Salzkruste ummantelt; kein bisschen vom Aroma geht verloren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "785c490c-6c79-3764-b3b5-e55a58889607",
                                        "entry_id": "85b91ba5-f055-365c-b247-ceb3b0f8be5e",
                                        "glosses": [
                                            "Inhaltsstoff, der für Geschmack sorgt; aromatisches Würzmittel, Gewürz, Essenz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90b1b21e-fd27-47d0-91a5-666175fbfc20",
                                                "sense_id": "785c490c-6c79-3764-b3b5-e55a58889607",
                                                "text": "„Als Aroma gekennzeichnete Zusatzstoffe können natürliche, naturidentische oder künstliche Aromen sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36736c24-b27e-4b62-b05d-fe1334f13b32",
                        "source_entry_id": "ddbc7fdf-cea8-32f6-856e-eedaf00b8365",
                        "source_sense_id": "5af36a3b-f63c-39f7-a2c5-5602f1e63c06",
