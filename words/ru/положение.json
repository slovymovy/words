                                "target_lang_sense_clarification": "state of being pregnant"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "身孕",
                                "target_lang_sense_clarification": "怀孕的委婉说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "667a0ada-14f7-3b8b-8534-eda5fe3909b9",
                    "sense_definition": "Действие по глаголу «положить»; помещение объекта в определённое место.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action_archaic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Торжественное <w>положение</w> первого камня ознаменовало начало строительства нового храма.",
                            "target_lang_translations": {
                                "en": "The ceremonial <w>laying</w> of the first stone marked the beginning of the construction of the new temple.",
                                "zh": "奠基石的隆重<w>安放</w>标志着新寺庙建设的开始。"
                            }
                        },
                        {
                            "text": "Древний ритуал включал в себя <w>положение</w> священных предметов на алтарь.",
                            "target_lang_translations": {
                                "en": "The ancient ritual included the <w>placing</w> of sacred objects on the altar.",
                                "zh": "古老的仪式包括将圣物<w>安放</w>在祭坛上。"
                            }
                        }
                    ],
                    "synonyms": [
