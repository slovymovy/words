                                        "glosses": [
                                            "Qui navre, qui cause une vive et profonde affliction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bd09008-b267-49af-a4d6-6d321a4c4b4b",
                                                "sense_id": "dace6800-a1aa-3545-8e11-fdd3e233fa5e",
                                                "text": "Aventure, histoire navrante."
                                            },
                                            {
                                                "example_id": "20d31ed8-c4fc-4be0-b885-7b2460a830b2",
                                                "sense_id": "dace6800-a1aa-3545-8e11-fdd3e233fa5e",
                                                "text": "Alors Silvère, à bout de force, se mit à pleurer. Les sanglots d’un homme ont des sécheresses navrantes."
                                            },
                                            {
                                                "example_id": "82749043-4c08-404f-a84c-f1b1aa3b2b22",
                                                "sense_id": "dace6800-a1aa-3545-8e11-fdd3e233fa5e",
                                                "text": "C’est un spectacle navrant."
                                            },
                                            {
                                                "example_id": "34544bd6-414f-485b-80fa-585dc05a5dcb",
                                                "sense_id": "dace6800-a1aa-3545-8e11-fdd3e233fa5e",
                                                "text": "C’était la première fois que j’entendais le mot « navré » proféré par une bouche humaine et cela sonnait tout à fait autrement que le « Mais vrai, j’ai trop pleuré, les aubes sont navrantes… » du Bateau ivre."
                                            }
                                        ]
