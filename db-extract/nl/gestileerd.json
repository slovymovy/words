                                "target_senses": [
                                    {
                                        "sense_id": "5d700c7f-d543-33dc-9f3d-ed348790218f",
                                        "entry_id": "4d10569d-c4c1-3993-9090-f848172650ea",
                                        "glosses": [
                                            "A change to the text of a document."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c2869c08-c9cd-3ed7-b6b7-c7947050ae9d",
                                        "entry_id": "4d10569d-c4c1-3993-9090-f848172650ea",
                                        "glosses": [
                                            "A change in the text of a file, a website or the code of software."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9e1f138-9f9b-4233-a757-36b8befb4dca",
                                                "sense_id": "c2869c08-c9cd-3ed7-b6b7-c7947050ae9d",
                                                "text": "He has made 5780 edits on Wikipedia so far."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30985b48-73ce-3bbd-ab35-38c0035cdd43",
                                        "entry_id": "4d10569d-c4c1-3993-9090-f848172650ea",
                                        "glosses": [
                                            "An edited piece of media, especially video footage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f073c6b0-4804-4353-9965-194ea70f2446",
                                                "sense_id": "30985b48-73ce-3bbd-ab35-38c0035cdd43",
                                                "text": "An early edit of the film included a romantic subplot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "051f58fc-d4a9-3fc5-8801-e34abb59aac0",
                                        "entry_id": "4d10569d-c4c1-3993-9090-f848172650ea",
                                        "glosses": [
                                            "A compilation of memorable moments (in a show, sport, etc.), often featuring stylized camera effects and intense music."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bec78b74-787a-4b7b-8329-c3928d48e51d",
                                                "sense_id": "051f58fc-d4a9-3fc5-8801-e34abb59aac0",
                                                "text": "a basketball edit, a Thor edit"
                                            },
                                            {
                                                "example_id": "5d86b5e3-94da-4e82-8c05-fb3660c6a94d",
                                                "sense_id": "051f58fc-d4a9-3fc5-8801-e34abb59aac0",
                                                "text": "bro thinks he's in an edit (Internet meme)"
                                            },
                                            {
                                                "example_id": "4961b529-8d94-4427-9f8b-7cfe75414a7d",
                                                "sense_id": "051f58fc-d4a9-3fc5-8801-e34abb59aac0",
                                                "text": "Valorant edits have become massive on TikTok as creators put their editing skills to the test in making the best edits they can, but Tarik argued that videos like these can be \"over-edited\" and that he can't tell what's happening."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c393c715-73a7-368f-8270-90f20188b02f",
                                        "entry_id": "4d10569d-c4c1-3993-9090-f848172650ea",
                                        "glosses": [
                                            "An interruption or change to an improvised scene."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0845e773-edea-3cfc-b056-25d0cdee1847",
                                        "entry_id": "4d10569d-c4c1-3993-9090-f848172650ea",
                                        "glosses": [
                                            "An alteration to the DNA sequence of a chromosome; an act of gene splicing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1e327e9f-982b-3924-8fd7-228618c3506c",
                                        "entry_id": "4d10569d-c4c1-3993-9090-f848172650ea",
                                        "glosses": [
                                            "A range of products related by theme or purpose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ae07035-d422-4a17-a455-03e198552a53",
                                                "sense_id": "1e327e9f-982b-3924-8fd7-228618c3506c",
                                                "text": "The Outnet will release a high-summer edit of 17 exclusive, limited-edition items including a Eugenia Kim fedora ($175.)"
                                            },
                                            {
                                                "example_id": "c6b7f4d7-d5d7-47ef-99ad-81b46a5d0778",
                                                "sense_id": "1e327e9f-982b-3924-8fd7-228618c3506c",
                                                "text": "The Loose Women star, 33, took to Instagram yesterday (May 8) to announce her latest clothing edit."
                                            },
                                            {
                                                "example_id": "4d02a3d7-ab6f-49cb-abc6-4d4a3b6d74ef",
                                                "sense_id": "1e327e9f-982b-3924-8fd7-228618c3506c",
                                                "text": "Thankfully, fellow new mum Ashley James has released the ultimate summer edit with clothing brand Tu that’s not only affordable, but was chosen with postpartum bodies in mind […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "edit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4e9943b-b79c-35a4-84b2-b4b004361dcb",
                                        "entry_id": "cd841ffb-8486-357b-90ed-b6b5a94d046a",
                                        "glosses": [
                                            "To change a text, or a document."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbfdd7be-91d8-4c12-9d1a-b39fa6e4eb36",
                                                "sense_id": "a4e9943b-b79c-35a4-84b2-b4b004361dcb",
                                                "text": "Your speech is too long. You need to edit it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4126cb9-4a4b-3a07-a254-01ba5888ff7a",
                                        "entry_id": "cd841ffb-8486-357b-90ed-b6b5a94d046a",
                                        "glosses": [
                                            "To alter a photograph or recording of sound or video."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c0185fd-2ffc-4b00-89ae-f59bbbcb3791",
                                                "sense_id": "d4126cb9-4a4b-3a07-a254-01ba5888ff7a",
                                                "text": "We shot an hour-long interview then edited it down to 45 minutes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "642610bb-4d4b-3d27-9b8f-f97153d4a8f4",
                                        "entry_id": "cd841ffb-8486-357b-90ed-b6b5a94d046a",
                                        "glosses": [
                                            "To be the editor of a publication."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44982423-4c44-451a-9532-ca34fd799026",
                                                "sense_id": "642610bb-4d4b-3d27-9b8f-f97153d4a8f4",
                                                "text": "He edits the Chronicle."
                                            },
                                            {
                                                "example_id": "8a9320ca-eae4-4d50-aeae-1230dd97ec34",
                                                "sense_id": "642610bb-4d4b-3d27-9b8f-f97153d4a8f4",
                                                "text": "\"How?\" responded Patsy; \"why, it's easy enough, Uncle. We'll buy a press, hire a printer, and Beth and Louise will help me edit the paper. I'm sure I can exhibit literary talents of a high order, once they are encouraged to sprout. Louise writes lovely poetry and 'stories of human interest,' and Beth—\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a01e274-353f-3558-a21a-79380895f0a1",
                                        "entry_id": "cd841ffb-8486-357b-90ed-b6b5a94d046a",
                                        "glosses": [
                                            "To change the contents of a file, website, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79ff294e-5e65-4a88-a0bf-eba7d29176f4",
                                                "sense_id": "7a01e274-353f-3558-a21a-79380895f0a1",
                                                "text": "Wikipedia is an interactive encyclopedia which allows anybody to edit and improve articles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27dde5af-6704-33dc-bf45-16d8d0b04051",
                                        "entry_id": "cd841ffb-8486-357b-90ed-b6b5a94d046a",
                                        "glosses": [
                                            "To alter the DNA sequence of a chromosome; to perform gene splicing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40e7ad7d-388d-48c1-927c-22f15dbf9f50",
                                                "sense_id": "27dde5af-6704-33dc-bf45-16d8d0b04051",
                                                "text": "Today, the technology to edit genomes is limited in the number of changes that can be made at once, which is probably one reason why the Harvard team focused on only 14 genes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cfbeb76-9c30-37b1-a24b-a08a109632de",
                                        "entry_id": "cd841ffb-8486-357b-90ed-b6b5a94d046a",
                                        "glosses": [
                                            "To assemble a film by cutting and splicing raw footage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b976bca-9af7-4ac6-8885-655e1ed97b73",
                                                "sense_id": "4cfbeb76-9c30-37b1-a24b-a08a109632de",
                                                "text": "When the director approached Ms. Adair about his idea for “Boyhood,” shooting footage each of those 12 years, she immediately agreed to take part. The decision was made to edit the film progressively, cutting the scenes from each year after they were completed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "036fbcfa-3f65-3b76-872c-3bcbd65b5378",
                                        "entry_id": "cd841ffb-8486-357b-90ed-b6b5a94d046a",
                                        "glosses": [
                                            "To cut short or otherwise alter an improvised scene."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64b89c98-97e1-48ea-b5d4-863db52ea542",
                                                "sense_id": "036fbcfa-3f65-3b76-872c-3bcbd65b5378",
                                                "text": "A good rule of thumb is to edit a scene before you think, \"Gosh, somebody should edit this scene.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ce3df42-a77f-34f9-a9ac-be781bf7bbbb",
                                        "entry_id": "cd841ffb-8486-357b-90ed-b6b5a94d046a",
                                        "glosses": [
                                            "To lend itself to editing in a certain way."
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99e1b751-ba5b-4f63-adf8-157243917428",
                                                "sense_id": "6ce3df42-a77f-34f9-a9ac-be781bf7bbbb",
                                                "text": "The junior can offer to do the voxes, gaining experience and sparing the senior journalist the trouble. Always remember to think how the clips will edit together."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
