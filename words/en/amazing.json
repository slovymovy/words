                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>amazing</w> the audience with his incredible magic tricks.",
                            "target_lang_translations": {
