                        "sense_id": "88bb4239-21e3-3b82-976b-add2ead53ba6",
                        "entry_id": "b144bff4-0bb4-3f26-9802-dcde4fe364b0",
                        "glosses": [
                            "een dichtslaand net waarmee men vogels kan vangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0762597d-79ea-4731-8809-e06ae211ecb0",
                                "sense_id": "88bb4239-21e3-3b82-976b-add2ead53ba6",
                                "text": "De Goudvink is opgericht in 1950, door met name vogelvangers. Glanerbruggers gingen vroeger graag met lijmstok of een slagnet en een lokvogel op pad om sijsjes, putters of goudvinken te vangen."
                            },
                            {
                                "example_id": "263f1a9a-af60-42bc-aec2-01c246efb805",
                                "sense_id": "88bb4239-21e3-3b82-976b-add2ead53ba6",
                                "text": "De politie kreeg zondagmorgen van Belgische collega's de melding dat mannen langs de Molenkreek in Eede(langs de grens), zowel op Nederlands als op Belgisch grondgebied met slagnetten bezig waren met het vangen van spreeuwen."
                            }
                        ]
                    }
