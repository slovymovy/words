                        "form": "die Selektionsdrucke"
                    },
                    {
                        "form_id": "5e635730-5cb6-42e7-a30e-e414839e93a5",
                        "entry_id": "87e7b3c4-04f5-38f5-8408-a3870839c6af",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Selektionsdrücke"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "aa707085-789a-3c87-bcdb-2587158203c8",
                        "entry_id": "87e7b3c4-04f5-38f5-8408-a3870839c6af",
                        "glosses": [
                            "die durch eine Umweltbedingung entstandene Notwendigkeit zur evolutionären Anpassung der genetischen Eigenschaften einer Population"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bccb552-390e-4a30-9a2e-7a1726c3c563",
                                "sense_id": "aa707085-789a-3c87-bcdb-2587158203c8",
                                "text": "Wenn man auf Bakterien durch den Einsatz von Antibiotika einen Selektionsdruck ausübt, dann werden sich eben jene Erreger durchsetzen, die durch eine geeignete Mutation zufällig gegen bestimmte Antibiotika resistent sind."
                            },
                            {
                                "example_id": "752b7726-a591-4398-a41f-183c44a3445f",
                                "sense_id": "aa707085-789a-3c87-bcdb-2587158203c8",
                                "text": "Mit steigendem Lebensalter, so erklärte der spätere Nobelpreisträger, nehme bei Organismen die Fruchtbarkeit ab und damit sinke auch der Selektionsdruck: Die natürliche Auslese greift nicht mehr."
                            },
                            {
                                "example_id": "8a2b23c0-5535-42f1-b186-68202528b226",
                                "sense_id": "aa707085-789a-3c87-bcdb-2587158203c8",
                                "text": "Hofreiter vermutet: Großräumige klimatische Umschwünge führen zu Selektionsdruck – sie könnten bei vielen Lebewesen die Bildung neuer Arten gestartet haben."
                            },
                            {
                                "example_id": "2367f0ed-7607-4556-8be0-c50f0d70ee2e",
                                "sense_id": "aa707085-789a-3c87-bcdb-2587158203c8",
                                "text": "In Europa entfiel dieser Selektionsdruck bislang, und so setzte sich auch die helle Hautfarbe durch."
                            },
                            {
                                "example_id": "8652c9e4-f372-4a2f-a035-a2869f564d0f",
                                "sense_id": "aa707085-789a-3c87-bcdb-2587158203c8",
                                "text": "Gleichartige Selektionsdrucke können zu Ähnlichkeit von Eigenschaften unterschiedlichster stammesgeschichtlicher Herkunft führen."
                            },
                            {
                                "example_id": "528ddbb2-732d-4b34-b27f-dbf213626513",
                                "sense_id": "aa707085-789a-3c87-bcdb-2587158203c8",
                                "text": "Die Selektionsdrücke, die zur Entstehung der Vierbeinigkeit bei den devonischen Formen geführt haben könnten, sind unklar."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
