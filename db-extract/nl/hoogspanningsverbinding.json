                        "examples": [
                            {
                                "example_id": "6f05c94b-fbcb-4a6e-b95c-2cad284cf2b8",
                                "sense_id": "82c0b8d1-6ca2-36e5-ac94-9a9fadbdbf7f",
                                "text": "Het aanvankelijke plan was een geheel nieuwe hoogspanningsverbinding van veertig kilometer lengte tussen de Eemshaven en een industrieterrein in Groningen-stad. De kabels zouden aan bijna zestig meter hoge masten worden bevestigd."
                            },
                            {
                                "example_id": "832c4693-49a6-4bde-9c98-a6115b09c817",
                                "sense_id": "82c0b8d1-6ca2-36e5-ac94-9a9fadbdbf7f",
                                "text": "Tennet is in de buurt van het Groningse dorp Meeden bezig met de uitbreiding van een hoogspanningsverbinding met Duitsland. De aannemer zou daar in opdracht van de netbeheerder deze week beginnen met de aan- en afvoer van zand en aarde, maar ziet daar nu vanaf."
                            }
