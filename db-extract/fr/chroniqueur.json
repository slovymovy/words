        "fr-extract.jsonl": [
            {
                "entry_id": "d61fd9ef-19ee-3d0c-b72e-2f0927d2d70b",
                "word": "chroniqueur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1bbc2604-f6b7-4f0f-a761-83a587a07c98",
                        "entry_id": "d61fd9ef-19ee-3d0c-b72e-2f0927d2d70b",
                        "tags": [
                            "plural"
                        ],
                        "form": "chroniqueurs"
                    },
                    {
                        "form_id": "333853aa-9c48-48e9-85bb-236be26191d9",
                        "entry_id": "d61fd9ef-19ee-3d0c-b72e-2f0927d2d70b",
                        "tags": [
                            "feminine"
                        ],
                        "form": "chroniqueuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5a598577-a949-3f01-a0e2-b57cdb041681",
                        "entry_id": "d61fd9ef-19ee-3d0c-b72e-2f0927d2d70b",
                        "glosses": [
                            "Auteur de chroniques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7af2d305-f72d-4bdc-92a3-fa9b47d33962",
                                "sense_id": "5a598577-a949-3f01-a0e2-b57cdb041681",
                                "text": "Longpont nous force d’ajouter foi aux paroles de Guillaume de Nangis et à celles de tous les chroniqueurs qui ont parlé de l’incendie de 1131."
                            },
                            {
                                "example_id": "75235764-dcda-4e14-be3e-071a08c29366",
                                "sense_id": "5a598577-a949-3f01-a0e2-b57cdb041681",
                                "text": "L’historien n’a pas à délivrer des prix de vertu, […] ; les questions qui intéressent les chroniqueurs et passionnent les romanciers sont celles qu’il laisse le plus volontiers de côté."
                            },
                            {
                                "example_id": "a4903b5d-c874-458a-bd36-417d5fb2fc51",
                                "sense_id": "5a598577-a949-3f01-a0e2-b57cdb041681",
                                "text": "Certains chroniqueurs prétendent même qu’il aurait étendu cette mesure à tous les juifs de son royaume, à l’instigation de l’empereur d’Orient, Héraclius, qui lui aurait fait savoir qu’aux dires de ses astrologues l’empire chrétien était menacé par un peuple circoncis."
                            },
                            {
                                "example_id": "ab47a2f9-0206-4e29-994a-21f9b54a088f",
                                "sense_id": "5a598577-a949-3f01-a0e2-b57cdb041681",
                                "text": "C’est aussi en tant que « roi de France » que Louis IX (saint Louis) est mentionné par divers chroniqueurs arabes de la fin du xiiiᵉ ou du xiiiᵉ siècle, qui le désignent comme “Sanlûwis ibn Lûwis” et “rîdâfrans”."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a6fae54-cd1a-3f0e-b2a9-f51a4dc6b4b2",
                        "entry_id": "d61fd9ef-19ee-3d0c-b72e-2f0927d2d70b",
                        "glosses": [
                            "Rédacteur dans un journal, dans une émission de radio ou de télévision, spécialement chargé de la chronique."
                        ],
                        "tags": [
                            "Audiovisuel"
                        ],
                        "examples": [
                            {
                                "example_id": "f2abb70e-e881-49d6-ad3f-ebe89143559e",
                                "sense_id": "5a6fae54-cd1a-3f0e-b2a9-f51a4dc6b4b2",
                                "text": "Pourquoi ne pas avoir aussi mentionné que le préfacier de l’édition française de Human Nature, Alexandre Dorozynski, est un chroniqueur scientifique formé en Russie soviétique et spécialiste de Lénine ?"
                            },
                            {
                                "example_id": "fd4aaee6-d005-4883-9649-3e234d077cf9",
                                "sense_id": "5a6fae54-cd1a-3f0e-b2a9-f51a4dc6b4b2",
                                "text": "Les chroniqueurs rapportent que Nicolas Sarkozy, pour expliquer qu’il se sentait bien dans sa peau de Président, aurait dit qu’il avait la banane."
                            },
                            {
                                "example_id": "e8766d1c-dce8-4925-9ab6-a4cc4057ec9f",
                                "sense_id": "5a6fae54-cd1a-3f0e-b2a9-f51a4dc6b4b2",
                                "text": "Chaque jour, Harold Hyman, chroniqueur à BFMTV, explique les nœuds de la géopolitique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "665dd4e0-fe14-4deb-a0b5-68264160ceb7",
                        "source_entry_id": "d61fd9ef-19ee-3d0c-b72e-2f0927d2d70b",
                        "source_sense_id": "5a598577-a949-3f01-a0e2-b57cdb041681",
                        "source_sense_description": "Auteur de chroniques",
                        "target_lang_word": "chronicler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chronicler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "782f6cd4-aa08-3923-ba7e-e7d758003f49",
                                        "entry_id": "79156084-dd99-3cdf-80fe-3c4e5a260146",
                                        "glosses": [
                                            "A person who writes a chronicle or chronicles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3acb8a81-a805-4089-87d2-6e8ba572b4d5",
                                                "sense_id": "782f6cd4-aa08-3923-ba7e-e7d758003f49",
                                                "text": "But he was also a natural chronicler: one senses that, even as his schemes collapsed, this aesthetic Arab Quixote knew the stories would make great material for his witty, sharp, melancholic writings."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4abc68f8-3f38-4bb5-af70-7da52e77407f",
                        "source_entry_id": "d61fd9ef-19ee-3d0c-b72e-2f0927d2d70b",
                        "source_sense_id": "5a598577-a949-3f01-a0e2-b57cdb041681",
