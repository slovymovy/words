                ],
                "senses": [
                    {
                        "sense_id": "09783871-f14a-39bf-94f5-553b11c7937c",
                        "entry_id": "14fdd914-43df-30d2-b19c-e5d0ba3009b4",
                        "glosses": [
                            "die Frauen, welche nach Ende des zweiten Weltkrieges die deutschen und österreichischen Städte von Trümmern befreiten und damit einen maßgeblichen Anteil zum Wiederaufbau leisteten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af48db2d-e89f-4ea2-986e-3f82f1df1a52",
                                "sense_id": "09783871-f14a-39bf-94f5-553b11c7937c",
                                "text": "„Die Leistungen der Trümmerfrauen wurden in Feierstunden, mit der Errichtung von Denkmälern, durch die Organisation von Ausstellungen und der Überreichung von Auszeichnungen gewürdigt.“"
                            },
                            {
                                "example_id": "6e078ed7-45b9-4c25-963e-9496a3c37ac6",
                                "sense_id": "09783871-f14a-39bf-94f5-553b11c7937c",
                                "text": "„Da gab es nicht nur die mit Recht berühmt gewordenen Trümmerfreuen, die im Schutt des zerstörten Deutschlands die Ärmel hochkrempelten und damit einen ersten Emanzipationsschub durch das Land schickten, es gab auch die ausgemergelten Hunger- und Elendsgestalten der daheimgebliebenen Männer, die im Volkssturm oder als Unabkömmliche den Krieg überstanden hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
