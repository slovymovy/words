                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45ab2215-9cca-4461-8e1f-e72d4327d7b2",
                                                "sense_id": "aeb9c116-f211-3dba-a5a5-8b4c971aa171",
                                                "text": "This rest might yet have balmed thy broken sinews"
                                            }
                                        ]
