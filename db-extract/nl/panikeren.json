                        "examples": [
                            {
                                "example_id": "3a9e398b-c778-477c-b6bb-e6ae270277bd",
                                "sense_id": "9a46878d-db4c-3cb8-a002-55f881999481",
                                "text": "Niemand was nerveus, tot duidelijk werd dat het om geweerschoten ging. Iedereen panikeerde en liep in het rond.'"
                            },
                            {
                                "example_id": "aa8b2d9e-490a-4813-80e8-f84e12e26d86",
                                "sense_id": "9a46878d-db4c-3cb8-a002-55f881999481",
                                "text": "‘We mogen niet overdrijven, noch panikeren.’ Dat was de belangrijkste boodschap die minister van Justitie Koen Geens, terugblikkend op de golf van aanslagen van de voorbije jaren, in de VS te vertellen had."
                            }
                        ]
                    }
