                        "zh": [
                            {
                                "target_lang_word": "什一税",
                                "target_lang_sense_clarification": "历史上的宗教或政府税收"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a60d69c-aefd-34be-a8d8-a8c155705f6d",
                    "sense_definition": "A musical interval spanning ten degrees of the staff, equivalent to an octave plus a third.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pianist had to stretch her hand wide to reach the <w>tenth</w>.",
                            "target_lang_translations": {
                                "ru": "Пианистке пришлось широко растянуть руку, чтобы взять <w>дециму</w>.",
                                "zh": "钢琴家必须把手张得很开才能弹到<w>十度音程</w>。"
                            }
                        },
                        {
                            "text": "The harmony moves in parallel motion, maintaining a constant <w>tenth</w>.",
                            "target_lang_translations": {
                                "ru": "Гармония движется параллельно, сохраняя постоянную <w>дециму</w>.",
                                "zh": "和声以平行运动进行，保持恒定的<w>十度音程</w>。"
                            }
                        }
