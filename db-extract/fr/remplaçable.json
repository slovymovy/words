            {
                "entry_id": "f8f5b511-31a5-3f27-955c-f00d552460c3",
                "word": "remplaçable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e57e7ff8-8914-47b2-8cd7-b8bfa258e259",
                        "entry_id": "f8f5b511-31a5-3f27-955c-f00d552460c3",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "remplaçables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "600e3106-3d5b-31ad-8830-0bc6d951942a",
                        "entry_id": "f8f5b511-31a5-3f27-955c-f00d552460c3",
                        "glosses": [
                            "Que l'on peut remplacer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1b955db-ca46-4bd6-8f53-04f657bccbf0",
                                "sense_id": "600e3106-3d5b-31ad-8830-0bc6d951942a",
                                "text": "En observant ces étroites relations, le docteur Hofmann fut conduit à essayer de remplacer dans la rosaniline l'hydrogène par d'autres radicaux que le phényle. Il essaya d'y introduire l'éthyle, en faisant digérer de la rosaniline avec de l'iodure d'éthyle, et il réussit effectivement à substituer trois molécules d'éthyle aux trois d'hydrogène qui étaient remplaçables."
                            },
                            {
                                "example_id": "93352b5c-bba5-425b-8ad3-a156ba8e6cd0",
                                "sense_id": "600e3106-3d5b-31ad-8830-0bc6d951942a",
                                "text": "A priori, un nom est très peu remplaçable par un verbe ; un peu remplaçable par n'importe quel autre nom ; beaucoup remplaçable par un nom de sens voisin."
                            },
                            {
                                "example_id": "4336a20a-52d4-4343-8a59-fa156c96ab51",
                                "sense_id": "600e3106-3d5b-31ad-8830-0bc6d951942a",
                                "text": "Vous pouvez remplacer ou ajouter un périphérique remplaçable à chaud sur un serveur de supports Backup Exec sans avoir à redémarrer le serveur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46dd5a5c-7e16-4ec9-a423-7d9c87bb374f",
                        "source_entry_id": "f8f5b511-31a5-3f27-955c-f00d552460c3",
                        "source_sense_id": "600e3106-3d5b-31ad-8830-0bc6d951942a",
                        "target_lang_word": "austauschbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "austauschbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b7d44816-4cda-3758-b5ea-dcec63b1cf43",
                                        "entry_id": "2731c48a-e0ec-327b-80f5-504575069c4d",
                                        "glosses": [
                                            "bei Bedarf aus einem Gerät entfernbar und durch ein neues Teil ersetzbar"
                                        ],
                                        "tags": [
                                            "technisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6657d776-912f-4adb-9666-dc7b85f19395",
                                                "sense_id": "b7d44816-4cda-3758-b5ea-dcec63b1cf43",
                                                "text": "„Wichtige Teile wie Akkus in Handys sollen austauschbar sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e823dcad-05d5-336b-8d9d-3dc1ea0530fc",
                                        "entry_id": "2731c48a-e0ec-327b-80f5-504575069c4d",
                                        "glosses": [
                                            "miteinander kombinierbar, zusammenpassend"
                                        ],
                                        "tags": [
                                            "technisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db66a523-47da-4a95-a416-930cd381b26d",
                                                "sense_id": "e823dcad-05d5-336b-8d9d-3dc1ea0530fc",
                                                "text": "„Das Leibniz‑Rechenzentrum der Bayerischen Akademie der Wissenschaften LRZ fungiert als eine Art Schaltzentrale, in der die Eingaben in die Computer tausender Wissenschaftler koordiniert und untereinander austauschbar gemacht werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cfa174d8-3fdd-3e61-ae9f-d13ef1aa7d92",
                                        "entry_id": "2731c48a-e0ec-327b-80f5-504575069c4d",
                                        "glosses": [
                                            "beliebig durch jemand anderen ersetzbar"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "283c184d-d281-4ffb-a4d2-109db04073ba",
                                                "sense_id": "cfa174d8-3fdd-3e61-ae9f-d13ef1aa7d92",
                                                "text": "„Ich wollte nicht bloß hübsches, austauschbares Dekor in einem Film sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
