                        "examples": [
                            {
                                "example_id": "2e28c8b0-669b-4fa3-b18f-6c87f1741ab2",
                                "sense_id": "e2380991-850c-3a84-9dbf-ba3b19da15ce",
                                "text": "Inmiddels telt de gemeente circa 150 zielen. Voor een deel christenen uit de Forest -een provincie in het zuidoosten van Guinee-, die werkzaam zijn bij de bauxietmaatschappij van Kamsar."
                            },
                            {
                                "example_id": "d29bb25f-fec0-4b75-b3ab-9c6e034a3838",
                                "sense_id": "e2380991-850c-3a84-9dbf-ba3b19da15ce",
                                "text": "Om het dreigende tekort aan energie in en rond de Surinaamse hoofdstad te keren, hebben de bauxietmaatschappij Suralco en de regering besloten aggregaten te huren van een buitenlands bedrijf."
                            },
                            {
                                "example_id": "1f97e705-f93a-4195-a9ce-fa333447e976",
                                "sense_id": "e2380991-850c-3a84-9dbf-ba3b19da15ce",
                                "text": "Ballast Nedam is begonnen met de voorbereiding van de bouw van een nieuwe brug over de Surinamerivier. Dat gebeurt in opdracht van de bauxietmaatschappijen Billiton en Suralco, dochter van Alcoa."
                            }
