                    {
                        "translation_id": "caf6a79b-a3ee-4794-858a-4aaf488e981d",
                        "source_entry_id": "5d26de70-36e9-3cf2-a9bc-ca17a17a6f7a",
                        "source_sense_id": "73dc0e5e-57dc-3489-9f70-c773bb18c231",
                        "source_sense_description": "Chemie: chemisches Element mit der Ordnungszahl 38",
                        "target_lang_word": "strontium",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "strontium",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "da690e7e-71dc-3dc8-b475-40f66a9b66be",
                                        "entry_id": "e9fff319-80c6-3a46-ad10-0ce9a2b45419",
                                        "glosses": [
                                            "Élément chimique de numéro atomique 38 et de symbole Sr qui fait partie des métaux alcalino-terreux."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e54b3032-6541-4471-8a4c-19440f973318",
                                                "sense_id": "da690e7e-71dc-3dc8-b475-40f66a9b66be",
                                                "text": "L’azotate de strontium entre dans la composition des feux de bengale rouges."
                                            },
                                            {
                                                "example_id": "7a3e96b7-1b9d-466e-a97e-4a7b88c2cdfb",
                                                "sense_id": "da690e7e-71dc-3dc8-b475-40f66a9b66be",
                                                "text": "La transition displacive du titanate de strontium (SrTiO₃) est peut-être l’une des transitions de phase les plus étudiées en matière condensée depuis plus de 50 ans."
                                            },
                                            {
                                                "example_id": "40989e50-2f50-48db-a3df-e313c9d5347a",
                                                "sense_id": "da690e7e-71dc-3dc8-b475-40f66a9b66be",
                                                "text": "En étudiant le strontium, un élément chimique contenu dans les aliments ingérés et incorporés dans l’émail dentaire, les scientifiques parviennent même à déterminer la mobilité sur nos une territoriale des hommes pour se nourrir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f646e585-5a9a-33e4-8b6e-091484304146",
                                        "entry_id": "e9fff319-80c6-3a46-ad10-0ce9a2b45419",
                                        "glosses": [
                                            "Métal gris-jaune, mou et malléable, forme métallique pure de l’élément."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fe1ce9d-e82c-42f8-b29c-c6281df72aae",
                                                "sense_id": "f646e585-5a9a-33e4-8b6e-091484304146",
                                                "text": "Le bleu vient du cuivre, le vert du baryum, le rouge du strontium, le jaune, du sodium. Ce sont tous des métaux. Tous ces métaux ou composés métalliques brûlent en émettant une lumière colorée propre à leur nature."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
