                        "sense_id": "ce984238-6085-3173-8ff7-43beb9b1334e",
                        "entry_id": "eb4033dc-710c-3381-aff6-e525c56272a4",
                        "glosses": [
                            "That overpowers; so strong as to be overwhelming."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "881929d9-5d63-49f2-8e89-03b68d0bf1f7",
                                "sense_id": "ce984238-6085-3173-8ff7-43beb9b1334e",
                                "text": "The original family who had begun to build a palace to rival Nonesuch had died out before they had put up little more than the gateway, so that the actual structure which had come down to posterity retained the secret magic of a promise rather than the overpowering splendour of a great architectural achievement."
                            },
                            {
                                "example_id": "05ac45c3-e91c-40f1-bd34-d67dbaa3fa23",
                                "sense_id": "ce984238-6085-3173-8ff7-43beb9b1334e",
                                "text": "The fact that approximately 40% of spoken language at the cafeteria was not English, suggests that the effect of the near 100% English signage is far from overpowering."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
