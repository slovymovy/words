                        "sense_id": "52aab4d5-bbd1-393b-a1db-af09a300b67c",
                        "entry_id": "f460d4df-c060-323b-b78f-e789a3c9f8ca",
                        "glosses": [
                            "Auteur d’un énoncé : locuteur à l’oral, narrateur à l’écrit ou encore graphiateur d’une narration graphique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e814b078-257c-4723-95b1-d738f44acc2c",
                                "sense_id": "52aab4d5-bbd1-393b-a1db-af09a300b67c",
                                "text": "Le pronom personnel ordonne l’espace à partir d’un point central qui est l’ipséité (ego) de l’énonciateur."
                            },
                            {
                                "example_id": "c94cd3c3-7be2-4494-b422-ebb719ba6bb9",
                                "sense_id": "52aab4d5-bbd1-393b-a1db-af09a300b67c",
                                "text": "On va l’utiliser pour introduire un élément nouveau et inconnu de l’énonciateur."
                            }
                        ]
                    }
                ],
