                "senses": [
                    {
                        "sense_id": "ffcf14b3-bc85-328c-9e7d-d0d92bbc2297",
                        "entry_id": "3ce42d01-ad49-3915-8429-de64bdd59845",
                        "glosses": [
                            "Confidentialité : état, d’être confidentiel, de divulgation restreinte."
                        ],
                        "tags": [
                            "singular"
                        ],
                        "examples": [
                            {
                                "example_id": "8ca8dc89-74ab-41ad-9010-c48e247a2c2c",
                                "sense_id": "ffcf14b3-bc85-328c-9e7d-d0d92bbc2297",
                                "text": "Vertraulichkeit ist die Eigenschaft einer Nachricht, nur für einen beschränkten Empfängerkreis vorgesehen zu sein.",
                                "translation": "La confidentialité est la propriété d’une information de n’être à l’intention que d’un cercle restreint de personnes."
                            }
                        ]
                    },
                    {
                        "sense_id": "d0232480-1c3e-3da6-a84a-fcbf5d7641e9",
                        "entry_id": "3ce42d01-ad49-3915-8429-de64bdd59845",
                        "glosses": [
                            "Confidence ; rapprochement perçu comme excessif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e74115ef-5ccd-45ae-9e83-cdef4bc34ae5",
                                "sense_id": "d0232480-1c3e-3da6-a84a-fcbf5d7641e9",
                                "text": "Unter Unbekannten sollte man sich keine Vertraulichkeiten erlauben.",
                                "translation": "Entre inconnus, on ne devrait pas se permettre des confidences."
                            }
                        ]
                    }
                ],
