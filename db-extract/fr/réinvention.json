                                            {
                                                "example_id": "be15fa8b-f357-4ede-a0ca-5c14c2c572b1",
                                                "sense_id": "0b7767a3-b39e-358e-bb46-76ad5f10fae5",
                                                "text": "There have been various reinventions of the wheel."
                                            },
                                            {
                                                "example_id": "17fe7b83-bf66-4f6e-aac9-45af8691a7ce",
                                                "sense_id": "0b7767a3-b39e-358e-bb46-76ad5f10fae5",
                                                "text": "Chicago was home to the reinvention of the harmonica from tiny dime store toy to amplified and distorted Mississippi sax."
                                            },
                                            {
                                                "example_id": "8f7f8ee7-edac-4ca4-aeb6-8b85df737403",
                                                "sense_id": "0b7767a3-b39e-358e-bb46-76ad5f10fae5",
                                                "text": "Personal reinventions fail partly for the obvious reasons: you set your goals too high; or your existing obligations at work or home get in the way; or you find (who could have imagined it?) that the unimpressive level of self-discipline you’ve demonstrated for your entire life until this moment can’t magically be tripled overnight."
                                            }
