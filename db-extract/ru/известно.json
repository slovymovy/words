        "ru-extract.jsonl": [
            {
                "entry_id": "e36c9396-b7af-3715-abee-fd157a2911ec",
                "word": "известно",
                "pos": "adj",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e709a419-c214-33f8-a18b-94722178dd6f",
                        "entry_id": "e36c9396-b7af-3715-abee-fd157a2911ec",
                        "glosses": [
                            "есть сведения, известия у кого-либо, знакомо кому-либо"
                        ],
                        "tags": [
                            "в знач. сказуемого, кому-чему о ком-чем, про кого-что или с союзом"
                        ],
                        "examples": [
                            {
                                "example_id": "7f96639a-9884-460c-bafe-e35f84770025",
                                "sense_id": "e709a419-c214-33f8-a18b-94722178dd6f",
                                "text": "Известно, что слоны в диковинку у нас."
                            },
                            {
                                "example_id": "ef6e5a92-c9dc-434d-aadd-ad34b3414fe3",
                                "sense_id": "e709a419-c214-33f8-a18b-94722178dd6f",
                                "text": "Об этом происшествии стало известно из газет."
                            },
                            {
                                "example_id": "c6971dee-c6bd-4c05-b131-4bb578f5b06a",
                                "sense_id": "e709a419-c214-33f8-a18b-94722178dd6f",
                                "text": "Вам известно, что до конца дней своих он был холостым."
                            },
                            {
                                "example_id": "56d7af87-23fe-43e3-9574-be3987e08113",
                                "sense_id": "e709a419-c214-33f8-a18b-94722178dd6f",
                                "text": "О Достоевском известно, что он страдал эпилепсией."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1194224-7df8-30ab-9f00-007da99160c1",
                        "entry_id": "e36c9396-b7af-3715-abee-fd157a2911ec",
                        "glosses": [
                            "прост. конечно, понятно"
                        ],
                        "tags": [
                            "вводное слово"
                        ],
                        "examples": [
                            {
                                "example_id": "3b3abb0a-551d-4f7d-a9ec-e2664c47c8b7",
                                "sense_id": "f1194224-7df8-30ab-9f00-007da99160c1",
                                "text": "Известно, с ним не сговоришься."
                            },
                            {
                                "example_id": "446877fd-cee0-4bf0-8eda-3d78506f41a9",
                                "sense_id": "f1194224-7df8-30ab-9f00-007da99160c1",
                                "text": "И вот приезжает эта барыня Колтовская к нам в Полевской завод. Как раз о празднике было дело. У нас на Петро-Павла, известно, гулянка."
                            }
                        ]
                    }
                ],
