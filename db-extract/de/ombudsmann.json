                        ],
                        "form": "die Ombudsmänner"
                    },
                    {
                        "form_id": "301a1fde-f78b-4639-bcef-634bdcb1d57f",
                        "entry_id": "769ec601-f33f-336b-a7d1-09be09cda6fb",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Ombudsleute"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6ed4cf62-50ed-3f72-9ae2-1907ba1a0deb",
                        "entry_id": "769ec601-f33f-336b-a7d1-09be09cda6fb",
                        "glosses": [
                            "männlicher Vertreter eines Personenkreises in nichtgerichtlichen Streitfällen gegenüber einer Organisation, Firma oder Institution"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49f8b5fb-5433-4a44-a855-5fd827bbc51f",
                                "sense_id": "6ed4cf62-50ed-3f72-9ae2-1907ba1a0deb",
                                "text": "Der Ombudsmann der Versicherung konnte den Streitfall zur Zufriedenheit des Kunden lösen."
                            },
                            {
                                "example_id": "613f341a-b23b-424a-af29-32b888d5c98e",
                                "sense_id": "6ed4cf62-50ed-3f72-9ae2-1907ba1a0deb",
                                "text": "„Der Bonner Juraprofessor Wolfgang Löwer, Sprecher des »Ombudsmanns« der Deutschen Forschungsgemeinschaft, war nach seinen Angaben bereits an vier oder fünf Verfahren beteiligt, an deren Ende die Doktoren keinen Titel mehr hatten.“"
                            },
                            {
                                "example_id": "e558c12d-aef1-42d6-9d77-97efd44edd2f",
                                "sense_id": "6ed4cf62-50ed-3f72-9ae2-1907ba1a0deb",
                                "text": "„Sogar Subari war als Ombudsmann bis 2009 oberster Menschenrechtler im Land.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f89b38a6-c630-40cd-afbb-eeebe8da351a",
                        "source_entry_id": "769ec601-f33f-336b-a7d1-09be09cda6fb",
                        "source_sense_id": "6ed4cf62-50ed-3f72-9ae2-1907ba1a0deb",
                        "target_lang_word": "ombudsman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ombudsman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "379e9dff-40b6-3166-84f4-dba4c96009ca",
                                        "entry_id": "dbbc894e-c278-3b1f-8a8e-36d0a41e6656",
                                        "glosses": [
                                            "An appointed official whose duty is to investigate complaints, generally on behalf of individuals such as consumers or taxpayers, against institutions such as companies and government departments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53a0411d-3b31-409e-815c-b8801306ca6a",
                                                "sense_id": "379e9dff-40b6-3166-84f4-dba4c96009ca",
                                                "text": "\"All the Nordic ombudsmen have the same view: that circumcision of boys should not be done until the boy is old enough to decide himself if is something he wants to do,” Anne Lindboe, Norway's Ombudsman for Children, told DW."
                                            },
                                            {
                                                "example_id": "199e1dad-962a-4082-88f1-9a8b5db95c4e",
                                                "sense_id": "379e9dff-40b6-3166-84f4-dba4c96009ca",
                                                "text": "The ombudsman found that youth living at El Pueblo remained under the care and supervision of staff who had been accused of abusing them. In one case, a youth was reportedly dragged across the carpet by two staff members, resulting in rugburns on his face."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f80aee13-96e3-3f7e-8aa2-c77ca66b42b7",
                                        "entry_id": "dbbc894e-c278-3b1f-8a8e-36d0a41e6656",
                                        "glosses": [
                                            "A designated internal mediator in an organization whose duty is to assist members with conflict resolution and other problems and to serve as an independent consultant to recommend changes to policies or procedures to improve organization effectiveness, efficiency, and humaneness."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7084ad7d-ca37-49f9-9507-8d1716a28757",
                        "source_entry_id": "769ec601-f33f-336b-a7d1-09be09cda6fb",
                        "source_sense_id": "6ed4cf62-50ed-3f72-9ae2-1907ba1a0deb",
                        "target_lang_word": "médiateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "médiateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "99460e4f-eb25-3bb1-a12d-f192a33c14d8",
                                        "entry_id": "cdfa3f00-6b19-37c2-a7bc-8e44252caca6",
                                        "glosses": [
                                            "Qui opère la médiation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6ec8f03-13a7-4711-ad38-9f29592962f6",
                                                "sense_id": "99460e4f-eb25-3bb1-a12d-f192a33c14d8",
                                                "text": "Les puissances médiatrices déclarèrent que…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "médiateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f842a5e4-a8e7-3da6-86b3-b0a896f2d21b",
                                        "entry_id": "ddb8d62c-50e0-3e26-a07e-5a973c61df6f",
                                        "glosses": [
                                            "Celui qui s’entremet pour opérer un accord, un accommodement entre deux ou plusieurs personnes, entre différents partis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d1a63cb-f886-4b4d-a38f-3f55fb60ec0a",
                                                "sense_id": "f842a5e4-a8e7-3da6-86b3-b0a896f2d21b",
                                                "text": "Mais l’homme le mieux posé est le curé Delacollonge. Médiateur entre la chiourme et le ban, le pouvoir s’en sert pour agir sur les galériens qui, de leur côté, s’adressent à lui pour obtenir des grâces."
                                            },
                                            {
                                                "example_id": "3fc91781-7842-457b-b0e9-f2e15fef8733",
                                                "sense_id": "f842a5e4-a8e7-3da6-86b3-b0a896f2d21b",
                                                "text": "A présent, les médiateurs observent que les jeunes se charrient sur leurs parents, leur mère, leur sœur, avec des énoncés comme « ta mère la pute » par exemple. En ce sens, les pratiques des jeunes sont devenues conformes avec la réalité noire américaine décrite par Labov."
                                            },
                                            {
                                                "example_id": "891b08a7-03d1-4820-aa95-d9fb2a244315",
                                                "sense_id": "f842a5e4-a8e7-3da6-86b3-b0a896f2d21b",
                                                "text": "Le roi de France se fit médiateur entre l’Autriche et l’Angleterre."
                                            },
                                            {
                                                "example_id": "8b73ef53-35f7-4f97-a1f0-2e71dc56d5de",
                                                "sense_id": "f842a5e4-a8e7-3da6-86b3-b0a896f2d21b",
                                                "text": "Le rôle du médiateur est d’aider l’entrepreneur et l’Urssaf à trouver un compromis afin de régler le litige."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e350cc73-03bf-343b-bfe5-154e44f827e7",
                                        "entry_id": "ddb8d62c-50e0-3e26-a07e-5a973c61df6f",
                                        "glosses": [
                                            "Jésus-Christ, en tant qu’intermédiaire entre Dieu et les hommes."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "761e139b-8370-30b4-96d0-527996dea608",
                                        "entry_id": "ddb8d62c-50e0-3e26-a07e-5a973c61df6f",
                                        "glosses": [
                                            "Médiateur chimique ; neurotransmetteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d46b2f7c-9862-43fb-ba2e-f57e8e93e972",
                                                "sense_id": "761e139b-8370-30b4-96d0-527996dea608",
                                                "text": "La variation d’un seul acide aminé dans le gène qui code pour l’enzyme COMT, un médiateur qui métabolise la dopamine et la noradrénaline, produit une différence suffisamment importante dans cette enzyme pour modifier la résistance à la douleur et de là influer sur le courage d’une personne."
                                            },
                                            {
                                                "example_id": "280b96aa-d381-47c6-a8ee-32667f3bf2d8",
                                                "sense_id": "761e139b-8370-30b4-96d0-527996dea608",
                                                "text": "Lors d’une autre rencontre avec ces allergènes, les mastocytes vont se « dégranuler » et libérer ces médiateurs chimiques au potentiel inflammatoire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
