                "senses": [
                    {
                        "sense_id": "3baf46cc-9ad9-339f-a0f1-17007f4c6284",
                        "entry_id": "432c45b9-67d5-30f1-99bb-2e080fae7a6c",
                        "glosses": [
                            "истор. реактопласт из группы фенолформальдегидных смол, аналог бакелита, разработанный в России в 1914 году"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "978c7510-16dc-4c0a-a6a2-951095d6ac56",
                                "sense_id": "3baf46cc-9ad9-339f-a0f1-17007f4c6284",
                                "text": "Из эбонитовой пластинки выпиливаем квадрат размерами 7×7 см (можно вместо эбонита взять карболит или пропарафинированный дуб)."
                            }
                        ]
                    }
                ],
                "translations": [
