        "ru-extract.jsonl": [
            {
                "entry_id": "888c0f79-9a2a-3506-b13a-a989e2b5ce51",
                "word": "Ремез",
                "pos": "name",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7dcd8779-c9ed-3466-955e-ae7ca680cd40",
                        "entry_id": "888c0f79-9a2a-3506-b13a-a989e2b5ce51",
                        "glosses": [
                            "фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4049f4e0-e03c-49d0-a3df-b8c4b135abac",
                                "sense_id": "7dcd8779-c9ed-3466-955e-ae7ca680cd40",
                                "text": "Руководили студией Михаил Шатров и Владимир Ворошилов, режиссёром был Оскар Ремез, он очень интересно работал, с новым театральным мышлением (как потом сложилась его судьба — не знаю)."
                            },
                            {
                                "example_id": "2ddb7c2d-aa32-4820-9e04-3b3ae1f78d50",
                                "sense_id": "7dcd8779-c9ed-3466-955e-ae7ca680cd40",
                                "text": "В ночь на 18-е в захолустном городке Алапаевске будут убиты члены императорской семьи: сестра царицы, великая княгиня Елизавета Фёдоровна, великие князья Сергей Михайлович, Игорь, Иван и Константин Константиновичи, князь Палей, фрейлина Варвара Яковлева, управляющий делами Сергея Михайловича Фёдор Ремез."
                            }
                        ]
                    }
                ],
