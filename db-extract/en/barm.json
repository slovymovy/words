                ],
                "senses": [
                    {
                        "sense_id": "07be60b8-89b4-3f7e-81e4-70a20617afec",
                        "entry_id": "d247d412-dc39-3120-ba08-9be8513cfd71",
                        "glosses": [
                            "Foam rising upon beer or other malt liquors when fermenting, used as leaven in brewing and making bread; yeast."
                        ],
                        "tags": [
                            "countable",
                            "dialectal",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "23aae667-457b-4c60-83e7-6cb21ddc8160",
                                "sense_id": "07be60b8-89b4-3f7e-81e4-70a20617afec",
                                "text": "[A]nd sometimes make the drink to bear no barm."
                            },
                            {
                                "example_id": "b6fe4e35-bb9d-42c2-88f0-8854bfdfbb89",
                                "sense_id": "07be60b8-89b4-3f7e-81e4-70a20617afec",
                                "text": "In 1577 yeast, called barm, is bought at 9d. the pail."
                            },
                            {
                                "example_id": "e451179d-2e32-44cd-84d2-33b93a064ee8",
                                "sense_id": "07be60b8-89b4-3f7e-81e4-70a20617afec",
                                "text": "And he chaffed the women as he served them their ha'porths of barm."
                            }
                        ]
                    },
                    {
                        "sense_id": "b2aab5c1-2c85-39d1-9972-9b02a23b6742",
                        "entry_id": "d247d412-dc39-3120-ba08-9be8513cfd71",
                        "glosses": [
                            "A small, round, flat individual loaf or roll of bread."
                        ],
                        "tags": [
                            "countable",
