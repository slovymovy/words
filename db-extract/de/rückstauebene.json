                "senses": [
                    {
                        "sense_id": "7ad7d7ed-8200-35cd-9571-142e10e02fdf",
                        "entry_id": "554f1ad4-438f-3b84-bca9-0f9e91800afa",
                        "glosses": [
                            "niedrigste Fläche im Gelände, auf der sich Wasser drucklos ausbreiten kann; höchste Ebene des Entwässerungssystems vor Austritt ins Freie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e744e93-e8e3-45c1-b643-83c7131b33ab",
                                "sense_id": "7ad7d7ed-8200-35cd-9571-142e10e02fdf",
                                "text": "„Entwässerungsanlagen wie Bodenabläufe, Waschmaschinen, Waschbecken, Duschen (Grauwasser) oder WC (Schwarzwasser), die unterhalb der Rückstauebene liegen, müssen wirkungsvoll und dauerhaft gegen Rückstau geschützt sein.“"
                            },
                            {
                                "example_id": "12a22889-55b6-432d-8d64-cbf21d0c8a88",
                                "sense_id": "7ad7d7ed-8200-35cd-9571-142e10e02fdf",
                                "text": "„Als Rückstauebene gilt die Höhe von 10 cm über der endgültigen Straßenoberkante an der Anschlussstelle.“"
                            },
                            {
                                "example_id": "4c6ac694-cfb8-4285-91d7-4547dfe865f2",
                                "sense_id": "7ad7d7ed-8200-35cd-9571-142e10e02fdf",
                                "text": "„Soweit nicht anders festgelegt gilt als maßgebende Rückstauebene die Straßenhöhe an der Anschlussstelle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
