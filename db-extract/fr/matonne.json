                        "examples": [
                            {
                                "example_id": "69893f1c-c90f-491b-aa80-0f9838090cf5",
                                "sense_id": "53324162-9c6b-3c9a-86a9-2d72a4a1a315",
                                "text": "Ils étaient en train de faire l’apprentissage du supermarché et de ses règles que la direction de Prior exhibait sans subtilité avec son panier obligatoire et sa matonne haut perchée."
                            },
                            {
                                "example_id": "4b5428a7-5315-4e8e-b0b7-b53d22e5a7bb",
                                "sense_id": "53324162-9c6b-3c9a-86a9-2d72a4a1a315",
                                "text": "Elle aurait pu tout de même se choisir une autre vocation... Matonne à la Petite Roquette, elle aurait au moins déjà la médaille pénitentiaire."
                            }
                        ]
                    }
