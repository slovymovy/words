                        ]
                    },
                    {
                        "translation_id": "80023aa3-b2ba-465d-a111-9fd4d6b6844c",
                        "source_entry_id": "1b26f00f-dd18-3376-96b2-46a466992e70",
                        "source_sense_id": "73907c45-76aa-396d-a90f-269651f89f7e",
                        "target_lang_word": "hummus",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hummus",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "8502d09b-43ab-3967-8464-71e1a3a47211",
                                        "entry_id": "dc0a6312-b481-3fa3-81ad-aba24d0a43e4",
                                        "glosses": [
                                            "Pasta de garbanzo con zumo (jugo) de limón, una crema denominada tahina (pasta de semillas de sésamo: ajonjolí) y aceite de oliva. Ingredientes de variantes locales pueden ser ajo y pimentón. La denominación completa en árabe es حُمُّص بطحينة (ḥummuṣ bi ṭaḥīna): garbanzos y pasta de sésamo, o musabbaha."
                                        ],
                                        "tags": [
                                            "Gastronomía"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17ef7508-2af6-4bec-a457-e4fdc064d6e0",
                                                "sense_id": "8502d09b-43ab-3967-8464-71e1a3a47211",
                                                "text": "Los beneficios desconocidos del hummus: un antidepresivo que previene el cáncer. De origen árabe, el hummus no era muy conocido hasta hace relativamente poco tiempo cuando su expansión en Estados Unidos ha sido tal que la industria del hummus ha pasado de tener, según el New York Times, una facturación de cinco millones de dólares anuales hace 15 años a los 530 millones"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2650aa6-9f3c-403a-accd-d1694289c3eb",
                        "source_entry_id": "1b26f00f-dd18-3376-96b2-46a466992e70",
                        "source_sense_id": "73907c45-76aa-396d-a90f-269651f89f7e",
                        "target_lang_word": "Hummus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hummus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d139fbea-2bb0-3dac-b996-0818e1eb919e",
                                        "entry_id": "0a252941-c573-324b-afe3-47f43de31ff4",
                                        "glosses": [
                                            "Brei aus Kichererbsen mit verschiedenen Gewürzen und Ölen, der traditionell im arabischen Raum und Israel als Vorspeise mit Fladenbrot gegessen wird"
                                        ],
                                        "tags": [
                                            "orientalische Küche"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b90633da-ff56-436a-80e3-aa68fcd0c079",
                                                "sense_id": "d139fbea-2bb0-3dac-b996-0818e1eb919e",
                                                "text": "„Das Steak in Scheiben schneiden und zusammen mit dem Salat, der Kresse, dem Hummus und der sauren Sahne auf dem Wrap anrichten.“"
                                            },
                                            {
                                                "example_id": "c18ea376-41c5-412e-b04a-7d864e242c44",
                                                "sense_id": "d139fbea-2bb0-3dac-b996-0818e1eb919e",
                                                "text": "„Abends saßen alle zusammen bei einem großen Abendessen mit Hammelfleisch, Hummus und Tabouleh und schauten sich den Empfang des sächsischen Ministerpräsidenten beim Bildungsminister von Abu Dhabi an.“"
                                            },
                                            {
                                                "example_id": "1123bd1f-252b-4a7c-9052-aaffdcc2ae54",
                                                "sense_id": "d139fbea-2bb0-3dac-b996-0818e1eb919e",
                                                "text": "„Durch den Rauch des Spießbraters lief ich am Hummus-Mann vorüber, er schloß gerade sein Geschäft, denn es war schon Nachmittag, und Hummus ist das arabische Frühstück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
