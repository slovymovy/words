                    "sense_definition": "bestimmte Aufgaben, Rechte, Pflichten oder Interessen stellvertretend oder eigenverantwortlich ausüben",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Anwalt wird vor Gericht alle rechtlichen Interessen seines Mandanten zuverlässig <w>wahrnehmen</w>."
                        },
                        {
                            "text": "Die Bürger möchten ihre demokratischen Rechte in vollem Umfang <w>wahrnehmen</w>."
                        }
                    ],
                    "common_phrases": [
                        "Interessen wahrnehmen",
                        "seine Rechte wahrnehmen",
                        "Verantwortung wahrnehmen"
