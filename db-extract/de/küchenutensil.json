                "senses": [
                    {
                        "sense_id": "c04af746-a9c7-38b6-a2b4-fed821525348",
                        "entry_id": "a091500f-30c3-37ea-b37c-254ddd6b632e",
                        "glosses": [
                            "in der Küche verwendetes Werkzeug zum Zubereiten von Speisen oder Getränken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfeca02b-428d-4741-9fb0-7a5345653a7d",
                                "sense_id": "c04af746-a9c7-38b6-a2b4-fed821525348",
                                "text": "„Dieses Küchenutensil ermöglicht es, Tomaten und Paprika zu schälen, sodass dieses Gemüse verdaulicher wird.“"
                            },
                            {
                                "example_id": "5eda7b00-7848-4686-b13e-341387fbf0eb",
                                "sense_id": "c04af746-a9c7-38b6-a2b4-fed821525348",
                                "text": "„Gebrauchen Sie Küchenutensilien, die sich problemlos mit heißem Wasser reinigen lassen.“"
                            },
                            {
                                "example_id": "affe8b26-96cc-4bf3-8cd3-996d8c5df7eb",
                                "sense_id": "c04af746-a9c7-38b6-a2b4-fed821525348",
                                "text": "„In diesem Kapitel wollen wir zwei praktische Küchenutensilien fertigen, die auch du in deinem Haushalt sicherlich gut gebrauchen kannst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
