                "senses": [
                    {
                        "sense_id": "3cbe0743-e11e-32bf-a7e2-b6dd279af6af",
                        "entry_id": "758559dd-a762-387d-8c25-accb3a214b24",
                        "glosses": [
                            "das Schreiben mit der Hand"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "34e31625-1499-4c08-888f-8b551c1a18cb",
                                "sense_id": "3cbe0743-e11e-32bf-a7e2-b6dd279af6af",
                                "text": "Druckschrift und Schreibschrift sind zwei Varianten der Chirographie."
                            },
                            {
                                "example_id": "e9dec332-34a7-4b17-9e9a-e3ec8817b3f1",
                                "sense_id": "3cbe0743-e11e-32bf-a7e2-b6dd279af6af",
                                "text": "„Kubismus, Futurismus, Dadaismus wie auch Konkrete Poesie wenden sich fast ausschließlich der technischen Schrift, der typographischen Letter und nicht der Chirographie zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "37825aae-a996-3de0-a296-75c11dc58b7b",
                        "entry_id": "758559dd-a762-387d-8c25-accb3a214b24",
                        "glosses": [
                            "ein mit der Hand geschriebenes Dokument"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "b345da04-ade0-4fcf-8376-e2ef2c689974",
                                "sense_id": "37825aae-a996-3de0-a296-75c11dc58b7b",
                                "text": "„Der Schuldschein als solcher kommt in zwei Formen vor: a) als Chirographie, b) als Schtar.“"
                            },
                            {
                                "example_id": "e545ae98-e4cf-476d-9d7a-71132f9cd66d",
                                "sense_id": "37825aae-a996-3de0-a296-75c11dc58b7b",
                                "text": "„Dieser formelle Unterschied zwischen Schtar und Chirographie ist der einzige characteristische, in der Natur beider Urkunden begründete, alle anderen formellen Verschiedenheiten sind nur scheinbar und zufällig.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
