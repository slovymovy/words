                        "source_sense_description": "Vorgang, um jemanden in Angst oder Schrecken zu versetzen und von etwas abzuhalten",
                        "target_lang_word": "dissuasion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dissuasion",
