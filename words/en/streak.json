{
    "word_family": [
        "streaky",
        "streaker"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "76cf7f2a-1434-3b68-92b7-5de98685ab42",
                    "sense_definition": "An irregular line or mark left on a surface, often caused by smearing, coloring, or motion.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "physical_mark",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cleaning cloth was dirty and left a greasy <w>streak</w> on the window.",
                            "target_lang_translations": {
                                "ru": "Тряпка для уборки была грязной и оставила жирный <w>развод</w> на окне.",
                                "zh": "清洁布很脏，在窗户上留下了一道油腻的<w>痕迹</w>。",
                                "de": "Das Putztuch war schmutzig und hinterließ eine fettige <w>Schliere</w> auf dem Fenster."
                            }
                        },
                        {
                            "text": "She decided to dye purple <w>streaks</w> into her dark hair for the party.",
                            "target_lang_translations": {
                                "ru": "Она решила покрасить фиолетовые <w>пряди</w> на своих темных волосах для вечеринки.",
                                "zh": "她决定为了参加聚会，在深色头发上染几道紫色<w>挑染</w>。",
                                "de": "Sie beschloss, sich für die Party lila <w>Strähnen</w> in ihr dunkles Haar zu färben."
                            }
                        }
                    ],
                    "synonyms": [
                        "stripe",
                        "band",
                        "smear",
                        "mark",
                        "smudge"
                    ],
                    "common_phrases": [
                        "leave a streak",
                        "streaks of light",
                        "streaks of gray"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неровная линия или след на поверхности, часто оставленный мазком, краской или движением.",
                        "zh": "表面上不规则的细长线条或痕印，常由涂抹、着色或移动而留下。",
                        "de": "Eine unregelmäßige Linie oder Spur auf einer Oberfläche, oft verursacht durch Wischen, Farbe oder Bewegung."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полоса",
                                "target_lang_sense_clarification": "длинный след на поверхности"
                            },
                            {
                                "target_lang_word": "развод",
                                "target_lang_sense_clarification": "пятно или след от жидкости, грязи"
                            },
                            {
                                "target_lang_word": "прядь",
                                "target_lang_sense_clarification": "окрашенная полоса волос"
                            },
                            {
                                "target_lang_word": "полоска",
                                "target_lang_sense_clarification": "узкая или маленькая полоса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "痕迹",
                                "target_lang_sense_clarification": "表面上拖擦、沾染后留下的细长痕迹"
                            },
                            {
                                "target_lang_word": "条纹",
                                "target_lang_sense_clarification": "细长的线状纹路或印子"
                            },
                            {
                                "target_lang_word": "挑染",
                                "target_lang_sense_clarification": "头发中染出的细条颜色"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Streifen",
                                "target_lang_sense_clarification": "Linie oder Farbspur"
                            },
                            {
                                "target_lang_word": "Schliere",
                                "target_lang_sense_clarification": "Wischspur, oft fettig oder feucht auf Glas"
                            },
                            {
                                "target_lang_word": "Strähne",
                                "target_lang_sense_clarification": "gefärbter Haarstreifen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b889703f-1a78-3e1c-b9c9-c54be7220d6b",
                    "sense_definition": "A continuous period of specified success, luck, or activity.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "series_events",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The basketball team is currently enjoying a ten-game winning <w>streak</w>.",
                            "target_lang_translations": {
                                "ru": "Баскетбольная команда в настоящее время наслаждается <w>серией</w> из десяти побед.",
                                "zh": "这支篮球队目前正处于十连胜的<w>势头</w>中。",
                                "de": "Die Basketballmannschaft freut sich derzeit über eine <w>Siegesserie</w> von zehn Spielen."
                            }
                        },
                        {
                            "text": "After a long losing <w>streak</w>, the gambler finally decided to go home.",
                            "target_lang_translations": {
                                "ru": "После долгой <w>полосы</w> неудач игрок наконец решил пойти домой.",
                                "zh": "在经历了漫长的<w>连败</w>之后，那个赌徒终于决定回家。",
                                "de": "Nach einer langen <w>Pechsträhne</w> beschloss der Spieler schließlich, nach Hause zu gehen."
                            }
                        }
                    ],
                    "synonyms": [
                        "run",
                        "series",
                        "succession",
                        "string"
                    ],
                    "common_phrases": [
                        "winning streak",
                        "losing streak",
                        "lucky streak"
                    ],
                    "target_lang_definitions": {
                        "ru": "Непрерывный период определенного успеха, удачи или деятельности.",
                        "zh": "某种成功、运气或活动持续不断的一段时期。",
                        "de": "Eine ununterbrochene Phase bestimmten Erfolgs, Glücks oder Verhaltens."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полоса",
                                "target_lang_sense_clarification": "период времени (удач или неудач)"
                            },
                            {
                                "target_lang_word": "серия",
                                "target_lang_sense_clarification": "последовательность побед или поражений"
                            },
                            {
                                "target_lang_word": "череда",
                                "target_lang_sense_clarification": "ряд сменяющих друг друга событий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "连胜",
                                "target_lang_sense_clarification": "连续获得胜利的一段时期"
                            },
                            {
                                "target_lang_word": "连败",
                                "target_lang_sense_clarification": "连续失败的一段时期"
                            },
                            {
                                "target_lang_word": "势头",
                                "target_lang_sense_clarification": "连续出现的好运、霉运或某种状态"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Serie",
                                "target_lang_sense_clarification": "Abfolge von Siegen oder Niederlagen"
                            },
                            {
                                "target_lang_word": "Strähne",
                                "target_lang_sense_clarification": "Glücks- oder Pechsträhne"
                            },
                            {
                                "target_lang_word": "Lauf",
                                "target_lang_sense_clarification": "anhaltende Phase des Erfolgs"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c01987c3-c35c-30f6-8346-e06329da7beb",
                    "sense_definition": "A specific characteristic or quality in someone's personality, often a negative or distinct one.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "personality_trait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite his generally kind nature, he has a ruthless <w>streak</w> when doing business.",
                            "target_lang_translations": {
                                "ru": "Несмотря на его в целом добрую натуру, у него есть безжалостная <w>черта</w> в ведении бизнеса.",
                                "zh": "尽管他平时性格和善，但做生意时却有冷酷的<w>一面</w>。",
                                "de": "Trotz seines allgemein freundlichen Wesens hat er beim Geschäftemachen einen rücksichtslosen <w>Zug</w>."
                            }
                        },
                        {
                            "text": "Her stubborn <w>streak</w> makes it very difficult to change her mind once she decides something.",
                            "target_lang_translations": {
                                "ru": "Её упрямая <w>жилка</w> делает очень трудным изменение её мнения, как только она что-то решит.",
                                "zh": "她那股<w>倔劲</w>让人很难改变她的想法，一旦她做了决定就更是如此。",
                                "de": "Ihre sture <w>Ader</w> macht es sehr schwer, sie umzustimmen, sobald sie einen Entschluss gefasst hat."
                            }
                        }
                    ],
                    "synonyms": [
                        "element",
                        "strain",
                        "touch",
                        "trace",
                        "vein"
                    ],
                    "common_phrases": [
                        "mean streak",
                        "stubborn streak",
                        "competitive streak",
                        "rebellious streak"
                    ],
                    "target_lang_definitions": {
                        "ru": "Специфическая черта или качество в чьем-либо характере, часто негативное или отчетливое.",
                        "zh": "某人性格中的某种特点或倾向，常指较明显或偏负面的那一种。",
                        "de": "Eine bestimmte Eigenschaft oder Wesensart im Charakter einer Person, meist negativ oder auffällig."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "черта",
                                "target_lang_sense_clarification": "особенность характера"
                            },
                            {
                                "target_lang_word": "жилка",
                                "target_lang_sense_clarification": "склонность или природное свойство"
                            },
                            {
                                "target_lang_word": "нотка",
                                "target_lang_sense_clarification": "оттенок в поведении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一面",
                                "target_lang_sense_clarification": "性格中某种鲜明的一面，常带负面色彩"
                            },
                            {
                                "target_lang_word": "特质",
                                "target_lang_sense_clarification": "性格上的某种明显特点"
                            },
                            {
                                "target_lang_word": "劲儿",
                                "target_lang_sense_clarification": "较强烈的性情或劲头，多用于口语"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Zug",
                                "target_lang_sense_clarification": "Charakterzug"
                            },
                            {
                                "target_lang_word": "Ader",
                                "target_lang_sense_clarification": "Neigung oder Wesensart"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e204220-9ec4-33d5-8189-7acf39177ab1",
                    "sense_definition": "The color of the powder produced when a mineral is rubbed against a hard, unglazed surface.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mineralogy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Geologists test the mineral by observing the color of its <w>streak</w> on a porcelain plate.",
                            "target_lang_translations": {
                                "ru": "Геологи проверяют минерал, наблюдая за цветом его <w>черты</w> на фарфоровой пластинке.",
                                "zh": "地质学家通过观察这种矿物在瓷板上留下的<w>条痕</w>颜色来鉴定它。",
                                "de": "Geologen testen das Mineral, indem sie die Farbe seines <w>Strichs</w> auf einer Porzellantafel beobachten."
                            }
                        },
                        {
                            "text": "Although the stone appears dark, it leaves a reddish <w>streak</w> when scratched.",
                            "target_lang_translations": {
                                "ru": "Хотя камень кажется темным, он оставляет красноватую <w>черту</w>, если его поцарапать.",
                                "zh": "这块石头虽然看起来颜色很深，但划擦后会留下带红色的<w>条痕</w>。",
                                "de": "Obwohl der Stein dunkel wirkt, hinterlässt er beim Ritzen einen rötlichen <w>Strich</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Цвет порошка, получаемого при трении минерала о твердую неглазурованную поверхность.",
                        "zh": "矿物在坚硬、无釉的表面上摩擦时所产生粉末的颜色。",
                        "de": "Die Farbe des Pulvers, das entsteht, wenn ein Mineral an einer harten, unglasierten Oberfläche gerieben wird."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "черта",
                                "target_lang_sense_clarification": "геологический термин"
                            },
                            {
                                "target_lang_word": "цвет черты",
                                "target_lang_sense_clarification": "характеристика минерала"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "条痕",
                                "target_lang_sense_clarification": "矿物在无釉硬面上摩擦后留下的粉末痕"
                            },
                            {
                                "target_lang_word": "条痕颜色",
                                "target_lang_sense_clarification": "用于描述矿物鉴定中的这一颜色特征"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Strich",
                                "target_lang_sense_clarification": "mineralogischer Fachbegriff für den Abrieb"
                            },
                            {
                                "target_lang_word": "Strichfarbe",
                                "target_lang_sense_clarification": "Farbe des Mineralpulvers"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "144b5ec4-5610-36ad-99d4-5e3543a46e02",
                    "sense_definition": "To mark a surface with lines or smears, or to become marked in this way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_mark",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tears began to <w>streak</w> her face as she listened to the sad story.",
                            "target_lang_translations": {
                                "ru": "Слезы начали <w>оставлять дорожки</w> на ее лице, пока она слушала грустную историю.",
                                "zh": "她听着这个悲伤的故事时，泪水开始在她脸上<w>留下道道痕迹</w>。",
                                "de": "Tränen begannen, <w>Spuren</w> auf ihrem Gesicht zu <w>hinterlassen</w>, während sie der traurigen Geschichte lauschte."
                            }
                        },
                        {
                            "text": "If you wash the windows in direct sunlight, the cleaner will dry too fast and <w>streak</w> the glass.",
                            "target_lang_translations": {
                                "ru": "Если мыть окна под прямыми солнечными лучами, чистящее средство высохнет слишком быстро и <w>оставит разводы</w> на стекле.",
                                "zh": "如果在阳光直射下擦窗户，清洁剂会干得太快，在玻璃上<w>留下条痕</w>。",
                                "de": "Wenn Sie die Fenster in direkter Sonne putzen, trocknet der Reiniger zu schnell und <w>hinterlässt Schlieren auf</w> dem Glas."
                            }
                        }
                    ],
                    "synonyms": [
                        "mark",
                        "smear",
                        "smudge",
                        "stripe"
                    ],
                    "common_phrases": [
                        "streak the window",
                        "streak with tears",
                        "streak with dirt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оставлять линии или разводы на поверхности или покрываться ими.",
                        "zh": "在表面留下线状痕迹或污痕，或使其出现这种痕迹。",
                        "de": "Eine Oberfläche mit Streifen oder Schlieren versehen oder solche Spuren bilden."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оставлять разводы",
                                "target_lang_sense_clarification": "пачкать поверхность (о жидкости)"
                            },
                            {
                                "target_lang_word": "оставлять полосы",
                                "target_lang_sense_clarification": "проводить линии"
                            },
                            {
                                "target_lang_word": "избороздить",
                                "target_lang_sense_clarification": "покрыть множеством линий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "留下条痕",
                                "target_lang_sense_clarification": "在表面形成一道道痕印或污痕"
                            },
                            {
                                "target_lang_word": "留下痕迹",
                                "target_lang_sense_clarification": "留下较明显的线状印记"
                            },
                            {
                                "target_lang_word": "弄出条纹",
                                "target_lang_sense_clarification": "使表面出现一道道污迹或色痕"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Schlieren hinterlassen",
                                "target_lang_sense_clarification": "beim Wischen oder Trocknen"
                            },
                            {
                                "target_lang_word": "Streifen ziehen",
                                "target_lang_sense_clarification": "Spuren bilden"
                            },
                            {
                                "target_lang_word": "schlieren",
                                "target_lang_sense_clarification": "Schlieren bilden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66d938ad-4a01-37fb-8776-87bb0695fa87",
                    "sense_definition": "To move very quickly in a straight line or direction.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We watched a shooting star <w>streak</w> across the dark night sky.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как падающая звезда <w>пронеслась</w> по темному ночному небу.",
                                "zh": "我们看着一颗流星<w>划过</w>漆黑的夜空。",
                                "de": "Wir sahen zu, wie eine Sternschnuppe über den dunklen Nachthimmel <w>schoss</w>."
                            }
                        },
                        {
                            "text": "The frightened cat <w>streaked</w> out of the room as soon as the vacuum cleaner started.",
                            "target_lang_translations": {
                                "ru": "Испуганная кошка <w>пулей вылетела</w> из комнаты, как только заработал пылесос.",
                                "zh": "吸尘器一启动，那只受惊的猫就立刻<w>窜出</w>了房间。",
                                "de": "Die verängstigte Katze <w>flitzte</w> aus dem Zimmer, sobald der Staubsauger anging."
                            }
                        }
                    ],
                    "synonyms": [
                        "dash",
                        "dart",
                        "fly",
                        "race",
                        "rush",
                        "sprint"
                    ],
                    "antonyms": [
                        "crawl",
                        "creep"
                    ],
                    "common_phrases": [
                        "streak across",
                        "streak past",
                        "streak through"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться очень быстро по прямой линии или в определенном направлении.",
                        "zh": "沿着直线或朝某个方向非常快速地移动。",
                        "de": "Sich sehr schnell in eine Richtung oder geradlinig bewegen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пронестись",
                                "target_lang_sense_clarification": "быстро промчаться"
                            },
                            {
                                "target_lang_word": "промелькнуть",
                                "target_lang_sense_clarification": "быстро показаться и исчезнуть"
                            },
                            {
                                "target_lang_word": "мчаться",
                                "target_lang_sense_clarification": "быстро двигаться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "划过",
                                "target_lang_sense_clarification": "快速从一处掠过，常用于光、星体等"
                            },
                            {
                                "target_lang_word": "飞驰而过",
                                "target_lang_sense_clarification": "非常快地经过或冲过"
                            },
                            {
                                "target_lang_word": "窜出",
                                "target_lang_sense_clarification": "猛地快速跑出去，多用于动物或人"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "flitzen",
                                "target_lang_sense_clarification": "sehr schnell rennen oder sausen"
                            },
                            {
                                "target_lang_word": "sausen",
                                "target_lang_sense_clarification": "mit hoher Geschwindigkeit dahingleiten"
                            },
                            {
                                "target_lang_word": "schießen",
                                "target_lang_sense_clarification": "blitzschnell vorbeiziehen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "686da5d6-b731-3ca2-a121-a7676aa83c94",
                    "sense_definition": "To run naked through a public place, usually as a prank or stunt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "naked_run",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The football match was paused briefly when a fan <w>streaked</w> across the pitch.",
                            "target_lang_translations": {
                                "ru": "Футбольный матч был ненадолго приостановлен, когда болельщик <w>пробежал голым</w> по полю.",
                                "zh": "一名球迷从球场上<w>裸奔</w>而过时，足球比赛短暂停了下来。",
                                "de": "Das Fußballspiel wurde kurz unterbrochen, als ein Fan <w>nackt über das Spielfeld flitzte</w>."
                            }
