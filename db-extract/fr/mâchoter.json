                        "glosses": [
                            "Mâcher en faisant de petits mouvements de la bouche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e6a68e1-abea-44de-8b1e-a763ecf0320c",
                                "sense_id": "75fa90e1-f7b7-3c98-b1e6-3a497052b1b0",
                                "text": "Le cheval doit ouvrir franchement la bouche à chaque action des rênes et ramener la tête, mâcher et non mâchoter son mors en tiraillant un peu sur la main."
                            },
                            {
                                "example_id": "163bfc25-f4b3-49a0-b01c-29fd8da8fcc2",
                                "sense_id": "75fa90e1-f7b7-3c98-b1e6-3a497052b1b0",
                                "text": "Ainsi que les petits des animaux domestiques, ils aiment à mâchoter ce qui est à leur portée ;"
                            }
                        ]
                    }
