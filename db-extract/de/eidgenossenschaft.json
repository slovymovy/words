                        ],
                        "form": "die Eidgenossenschaft"
                    },
                    {
                        "form_id": "8e53cb6f-dccc-4dc0-8bf9-f5a009cecc88",
                        "entry_id": "3470c22d-9a41-33e9-9cdc-04dcf72c898a",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Eidgenossenschaften"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "86b0f39a-cbb3-388a-bad9-5d93e94efd57",
                        "entry_id": "3470c22d-9a41-33e9-9cdc-04dcf72c898a",
                        "glosses": [
                            "Schweizerische Eidgenossenschaft, der seit 1848 bestehende schweizerische Bundesstaat; auch spezifisch die Bundesebene im schweizerischen Staatsgefüge"
                        ],
                        "tags": [
                            "short-form"
                        ],
                        "examples": [
                            {
                                "example_id": "954181f3-e3a9-4344-a4d9-6e5704bab0f3",
                                "sense_id": "86b0f39a-cbb3-388a-bad9-5d93e94efd57",
                                "text": "„Auch Umwege führen nach Rom: Die Eidgenossenschaft kommt endlich im Vatikan an. Die Schweiz eröffnet eine Botschaft beim Heiligen Stuhl und beseitigt damit nach 150 Jahren die letzten Reste des Kulturkampfs.“"
                            },
                            {
                                "example_id": "fdfc022d-19ae-453d-bbc0-81104a3f7386",
                                "sense_id": "86b0f39a-cbb3-388a-bad9-5d93e94efd57",
                                "text": "„Es gehört schon bald zur guten Tradition, dass der Bundesrat seine Flug-Statistik präsentiert. Es geht um jene Flüge, welche die Magistraten mit den Fluggeräten der Eidgenossenschaft durchführen.“"
                            },
                            {
                                "example_id": "00c78ff6-6951-4c00-8710-5fc245bb67ed",
                                "sense_id": "86b0f39a-cbb3-388a-bad9-5d93e94efd57",
                                "text": "„Oberleitung und strategische Führung auf Stufe Eidgenossenschaft [Titel; dann:] Der Bund hat bei der Verbundaufgabe «Amtliche Vermessung» die strategische Führung inne. Fachstelle ist die Eidgenössische Vermessungsdirektion.“"
                            },
                            {
                                "example_id": "e8646782-4c83-4ada-bb6b-03a3209569c9",
                                "sense_id": "86b0f39a-cbb3-388a-bad9-5d93e94efd57",
                                "text": "„Wie die EU, diese europäische Eidgenossenschaft des 21. Jahrhunderts, hat im 19. Jahrhundert die Schweizerische Eidgenossenschaft erst dank der Auseinandersetzung mit reaktionären Kräften den Sprung nach vorn geschafft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ba3668a3-982f-32ae-b5e9-b97db17e1e66",
                        "entry_id": "3470c22d-9a41-33e9-9cdc-04dcf72c898a",
                        "glosses": [
                            "durch Eid verbundenes Bündnisgefüge, insbesondere der vom Spätmittelalter bis 1848 bestehende Staatenbund und Vorläufer der heutigen Schweiz (bis 1798 die Alte Eidgenossenschaft)"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "09744a29-a56a-4496-a44b-c66ba4f268a5",
                                "sense_id": "ba3668a3-982f-32ae-b5e9-b97db17e1e66",
                                "text": "„Karl der Kühne selbst fand in der Schlacht bei Nancy gegen die Eidgenossen den Tod.“"
                            },
                            {
                                "example_id": "10341198-29dc-468c-a870-134ea5a43940",
                                "sense_id": "ba3668a3-982f-32ae-b5e9-b97db17e1e66",
                                "text": "„Entstanden ist die Eidgenossenschaft nicht 1291, sondern im wilden 15. Jahrhundert.“"
                            },
                            {
                                "example_id": "b76e768c-0c98-4e17-8b25-e9b22e579941",
                                "sense_id": "ba3668a3-982f-32ae-b5e9-b97db17e1e66",
                                "text": "„Das von der modernen Historiografie als Burgundische Eidgenossenschaft bezeichnete lockere Bündnisgefüge verband vom frühen 13. Jh. an Städte, Landschaften und Herren der Westschweiz. Partner, Ausrichtung und Schwerpunkte wechselten mehrfach. Die Burgundische Eidgenossenschaft beruhte auf meist zweiseitigen, zeitlich begrenzten Bündnissen, Landfrieden und Burgrechten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
