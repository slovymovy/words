                "translations": [
                    {
                        "translation_id": "49ede6b0-3994-4984-b2a9-e13ed05634b1",
                        "source_entry_id": "f4518b58-a062-3705-9d8c-2d34a0722fc9",
                        "source_sense_id": "0ba4cb3c-7a77-31a7-ab90-ba9fb153d706",
                        "target_lang_word": "interview",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interview",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee5b125c-3164-3026-9cf0-7018971f30d0",
                                        "entry_id": "f811c50e-909d-39f0-8571-6bc9c32b355c",
                                        "glosses": [
                                            "An official face-to-face meeting of monarchs or other important figures."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ca67d2b-13d5-4d18-ab4c-d1a40b008adb",
                                                "sense_id": "ee5b125c-3164-3026-9cf0-7018971f30d0",
                                                "text": "To be present at an interview, as that famous of Henry the Eighth and Francis the First, so much renowned all over Europe[…], no age ever saw the like."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "295417d9-9a05-30c2-9796-c86d2d50416a",
                                        "entry_id": "f811c50e-909d-39f0-8571-6bc9c32b355c",
                                        "glosses": [
                                            "Any face-to-face meeting, especially of an official or adversarial nature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eba59a69-52bc-4a85-982f-00d1852d7376",
                                                "sense_id": "295417d9-9a05-30c2-9796-c86d2d50416a",
                                                "text": "(Aaron Burr narrating): It was at about this time that I learned exactly what it was that Hamilton had said of me, and knew that this world was far too narrow a place to contain the two of us. Hamilton's friend made one further attempt to get him off the hook but only further impaled the slanderer by remarking that should Colonel Burr wish to enquire of any other conversation of Hamilton concerning Burr, a prompt and frank avowal or denial would be given. This was too much. I told Van Ness to set a time and place for an interview [referring to a duel with pistols]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b16968bd-c9b9-3277-9294-2ece64a2cad4",
                                        "entry_id": "f811c50e-909d-39f0-8571-6bc9c32b355c",
                                        "glosses": [
                                            "A conversation in person (or, by extension, over the telephone, Internet etc.) between a journalist and someone whose opinion or statements he or she wishes to record for publication, broadcast etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "468413c5-7de3-4dc3-b49d-e9c4bec9963b",
                                                "sense_id": "b16968bd-c9b9-3277-9294-2ece64a2cad4",
                                                "text": "The reporter gave the witness an interview."
                                            },
                                            {
                                                "example_id": "494c3a41-b33f-4415-97bd-b38ab7fbe7b6",
                                                "sense_id": "b16968bd-c9b9-3277-9294-2ece64a2cad4",
                                                "text": "He has a job interview on Saturday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0217e42c-d5fa-3fbe-99d1-d6081c6f613f",
                                        "entry_id": "f811c50e-909d-39f0-8571-6bc9c32b355c",
                                        "glosses": [
                                            "A formal meeting, in person, for the assessment of a candidate or applicant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29add447-0ceb-4140-9c17-fc4ee0aab504",
                                                "sense_id": "0217e42c-d5fa-3fbe-99d1-d6081c6f613f",
                                                "text": "It was a dreadful interview; I have no hope of getting the job."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "536ef3d6-5e66-30f3-b32f-ebe6e82aab9b",
                                        "entry_id": "f811c50e-909d-39f0-8571-6bc9c32b355c",
                                        "glosses": [
                                            "An audition."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "28e864a4-d2f0-3217-b74e-0ab576526af7",
                                        "entry_id": "f811c50e-909d-39f0-8571-6bc9c32b355c",
                                        "glosses": [
                                            "A police interrogation of a suspect or party in an investigation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "interview",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c1801c5-fe71-3236-975a-a392a21da117",
                                        "entry_id": "e7b49dbc-bafd-3da6-90d8-1b4a9e90fdcd",
                                        "glosses": [
                                            "To ask questions of (somebody); to have an interview."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "530ebb2e-08ba-4308-9b35-de7fd62899e5",
                                                "sense_id": "1c1801c5-fe71-3236-975a-a392a21da117",
                                                "text": "He interviewed the witness."
                                            },
                                            {
                                                "example_id": "d299a76c-da47-4be6-9250-4af39dd1b9fa",
                                                "sense_id": "1c1801c5-fe71-3236-975a-a392a21da117",
                                                "text": "A very famous journalist interviewed him."
                                            },
                                            {
                                                "example_id": "35f49aa1-ad69-4def-97ca-3d9da69a5d75",
                                                "sense_id": "1c1801c5-fe71-3236-975a-a392a21da117",
                                                "text": "The witness was interviewed."
                                            },
                                            {
                                                "example_id": "ddad1c2b-99c6-4a4a-b249-91fc5f1f6794",
                                                "sense_id": "1c1801c5-fe71-3236-975a-a392a21da117",
                                                "text": "Professor Solanka paused and turned to face the lounging goddess of the threshold, who proceeded, unnervingly, to interview him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb8b5405-05b8-335f-9bd9-62c045194242",
                                        "entry_id": "e7b49dbc-bafd-3da6-90d8-1b4a9e90fdcd",
                                        "glosses": [
                                            "To be interviewed; to attend an interview."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e0569cf-16ef-444e-9003-ed9e8576fec9",
                                                "sense_id": "cb8b5405-05b8-335f-9bd9-62c045194242",
                                                "text": "When she interviewed with Microsoft in August, she overlooked a small cut in salary and asked about long-term career opportunities — and quality of life."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94c2c73a-9c33-48d9-8e70-ec48142be8cf",
                        "source_entry_id": "f4518b58-a062-3705-9d8c-2d34a0722fc9",
                        "source_sense_id": "0ba4cb3c-7a77-31a7-ab90-ba9fb153d706",
                        "target_lang_word": "Interview",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Interview",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d3cd0ce2-6366-3392-b831-c1e5076b2344",
                                        "entry_id": "b85c8bc9-022b-3ab7-bfd2-e5101ce48dd4",
                                        "glosses": [
                                            "Befragung mit dem Ziel, von dem/den Befragten Informationen oder Ansichten in Erfahrung zu bringen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be421701-5310-4db0-a5d1-52067bb7a467",
                                                "sense_id": "d3cd0ce2-6366-3392-b831-c1e5076b2344",
                                                "text": "Die Fragen, die der Journalist während des Interviews stellen möchte, hat er sich vorher notiert."
                                            },
                                            {
                                                "example_id": "a2080ff2-3f12-47ed-a0bf-4ea364fba9cc",
                                                "sense_id": "d3cd0ce2-6366-3392-b831-c1e5076b2344",
                                                "text": "Interviews gibt es nicht nur im Journalismus, sondern auch in der Marktforschung und in anderen Bereichen."
                                            },
                                            {
                                                "example_id": "705dcae5-b99d-466c-922a-04161411b0af",
                                                "sense_id": "d3cd0ce2-6366-3392-b831-c1e5076b2344",
                                                "text": "„Symptomatisch für diese gipfelbezogene Erlebnisweise des Höhenbergsteigens ist die Motivationskurve, die sich in zahlreichen, von mir geführten Interviews sinngleich wie in den folgenden Aussagen offenbart: Wenn ich einen Gipfel erreicht habe, sinkt meine Motivation rapide ab […].“"
                                            },
                                            {
                                                "example_id": "7d073a6d-dc71-4e4a-9f0e-6e0bca13d9eb",
                                                "sense_id": "d3cd0ce2-6366-3392-b831-c1e5076b2344",
                                                "text": "„Ausgerechnet er, der einst noch spätnachts zum Pressegespräch bat, gibt zum Wahltag keine Interviews.“"
                                            },
                                            {
                                                "example_id": "7a9a8dd9-9b18-4527-96ff-1376cd3edf11",
                                                "sense_id": "d3cd0ce2-6366-3392-b831-c1e5076b2344",
                                                "text": "„Interviews müssen dazu genutzt werden, sich zu verbergen.“"
                                            },
                                            {
                                                "example_id": "d78ef1e8-7a2b-48d0-87b1-b63e40b84a9d",
                                                "sense_id": "d3cd0ce2-6366-3392-b831-c1e5076b2344",
                                                "text": "„Im journalistischen Interview geht es um mehr als um Frage und Antwort.“"
                                            },
                                            {
                                                "example_id": "088fc2fa-0d19-4f3c-ab1c-ded61f2990d1",
                                                "sense_id": "d3cd0ce2-6366-3392-b831-c1e5076b2344",
                                                "text": "„Viele Jahre später, als ich die Geschichte schon fast vergessen hatte, las ich ein Interview mit einem persischen Dichter, der seit den Sechzigerjahren in München im Exil lebte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f91d970-bfc3-4272-99f7-e060bace9fa6",
                        "source_entry_id": "f4518b58-a062-3705-9d8c-2d34a0722fc9",
                        "source_sense_id": "0ba4cb3c-7a77-31a7-ab90-ba9fb153d706",
                        "target_lang_word": "интервью",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "интервью",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d5aa07b7-7749-33d9-aa69-32055ff127f6",
                                        "entry_id": "a2165d46-99e2-3c7f-8c71-29ae61830b35",
                                        "glosses": [
                                            "беседа, проводимая по заранее намеченному плану"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "699a56b4-0519-4368-ad24-01597489ba68",
                                                "sense_id": "d5aa07b7-7749-33d9-aa69-32055ff127f6",
                                                "text": "― Каждый день сообщения по мере продвижения следствия. Потом интервью с его женою, ― Силин загнул палец, ― интервью с Иваном…"
                                            },
                                            {
                                                "example_id": "a920f556-c842-4e9a-bf69-8c4c648b8998",
                                                "sense_id": "d5aa07b7-7749-33d9-aa69-32055ff127f6",
                                                "text": "При получении ПМЖ в «миграфон верките», конечно, проходишь интервью, там спрашивают, какого цвета зубная щётка у вашей жены, какого цвета унитаз в ванной, ― и на этом всё."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa9644e9-9bd6-3ad6-874f-9edc4e471871",
                                        "entry_id": "a2165d46-99e2-3c7f-8c71-29ae61830b35",
                                        "glosses": [
                                            "опрос человека по профессиональной или/и личной тематике, проводящийся журналистом с целью публикации или вещания в СМИ"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84b83a87-697b-4a6c-a3a6-3ec4c7cac915",
                                                "sense_id": "fa9644e9-9bd6-3ad6-874f-9edc4e471871",
                                                "text": "Римский-Корсаков и Шаляпин ― герои дня. Портреты и интервью с ними печатаются во всех газетах."
                                            },
                                            {
                                                "example_id": "78013c97-aa4f-4715-8c80-af9b5154cd0b",
                                                "sense_id": "fa9644e9-9bd6-3ad6-874f-9edc4e471871",
                                                "text": "Вот, например, иракское телевидение показывает интервью с крестьянином, который сбил из винтовки вражеский самолёт."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47757694-8838-3969-b311-406cac36e221",
                                        "entry_id": "a2165d46-99e2-3c7f-8c71-29ae61830b35",
                                        "glosses": [
                                            "неол. то же, что собеседование; разговор с соискателем на какую-либо должность с целью оценки его профессиональных качеств"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9cf231e-c342-4c10-8898-21b32d07a2f6",
                                                "sense_id": "47757694-8838-3969-b311-406cac36e221",
                                                "text": "Фирмы отбирают студентов на интервью, студенты ранжируют фирмы в порядке предпочтения."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
