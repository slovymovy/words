                                "target_senses": [
                                    {
                                        "sense_id": "fe5bfb57-10b3-3ef4-af52-d200a5dc7469",
                                        "entry_id": "9dd4d95f-b6a5-3840-abf2-22fb621e73c9",
                                        "glosses": [
                                            "A physical, chemical, infective agent aggressing an organism."
