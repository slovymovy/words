                            {
                                "example_id": "e6ec39f6-d684-4b77-b8c5-9e22b6055285",
                                "sense_id": "a1d3aaae-1f0c-3446-b088-f959f7014b41",
                                "text": "Dans l’obscurité, je vois grésiller le bout incandescent de la cibiche."
                            },
                            {
                                "example_id": "32ce9798-9fdf-4df7-a65a-f606a7ca3da8",
                                "sense_id": "a1d3aaae-1f0c-3446-b088-f959f7014b41",
                                "text": "— Tiens, lui dit-il en tendant vingt sous, tu t'achèteras du roudoudou.\n—– Du roudoudou, sans blague ? Je suis plus une môme. Je me paierai des cibiches."
                            },
                            {
                                "example_id": "01fd8474-4e6c-4217-b683-c0dd08b9e11c",
                                "sense_id": "a1d3aaae-1f0c-3446-b088-f959f7014b41",
                                "text": "Hep ! monsieur, une cigarette\n Une cibiche, ça n’engage à rien\n Si j’te plais, on f’ra la causette\n T’es gentil, t’as l’air d’un bon chien"
                            }
                        ]
