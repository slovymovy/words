                },
                {
                    "sense_id": "cfa19770-a6be-3ed0-bd97-4d422e3307fd",
                    "sense_definition": "степень насыщенности или концентрированности напитка",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне не нравится слишком большая <w>крепость</w> этого кофе.",
                            "target_lang_translations": {
