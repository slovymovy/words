                        "examples": [
                            {
                                "example_id": "88a72509-ba1d-4273-8eba-41694d224483",
                                "sense_id": "ce3c6274-4796-310a-9ac5-be7547816713",
                                "text": "De Franse begraafplaats is een necropolis, een dodenstad. Je loopt door straten waar de ene kapel naast de andere staat."
                            },
                            {
                                "example_id": "0fdd189c-be6d-4817-a9c1-dd4998165bb4",
                                "sense_id": "ce3c6274-4796-310a-9ac5-be7547816713",
                                "text": "Archeologen hebben in de Egyptische necropolis Abydos het graf van een tot nu toe onbekende farao opgegraven. Zij gaan ervan uit dat het om koning Senebkai gaat die omstreeks 1600 voor Christus heeft geleefd. Aan een muur in de dodenstad in het midden van Egypte werd zijn naam ontdekt."
                            }
                        ]
                    }
