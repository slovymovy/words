{
    "word_family": [
        "knorren",
        "geknor",
        "knorpot"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f3e4aa99-2308-3650-af89-b475b1e1e5b4",
                    "sense_definition": "slechtgehumeurd en ontevreden, vaak gepaard gaand met mopperen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "humeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude man was vandaag weer eens in een <w>knorrige</w> bui.",
                            "target_lang_translations": {
                                "en": "The old man was in a <w>grumpy</w> mood once again today.",
                                "ru": "Старик сегодня снова был в <w>ворчливом</w> настроении."
                            }
                        },
                        {
                            "text": "Het is een keuze of je <w>knorrig</w> of vrolijk door het leven wilt gaan.",
                            "target_lang_translations": {
                                "en": "It is a choice whether you want to go through life <w>grouchy</w> or cheerful.",
                                "ru": "Это выбор каждого — идти по жизни <w>брюзгливым</w> или жизнерадостным."
                            }
                        }
                    ],
                    "synonyms": [
                        "chagrijnig",
                        "ontevreden",
                        "brommerig",
                        "mopperig"
                    ],
                    "antonyms": [
                        "vrolijk",
                        "opgewekt"
                    ],
                    "common_phrases": [
                        "knorrige bui",
                        "knorrig antwoorden"
                    ],
                    "target_lang_definitions": {
                        "en": "bad-tempered and dissatisfied, often accompanied by grumbling",
                        "ru": "в плохом настроении и недовольный, часто сопровождается ворчанием"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grumpy",
                                "target_lang_sense_clarification": "bad-tempered and irritable"
                            },
                            {
                                "target_lang_word": "grouchy",
                                "target_lang_sense_clarification": "complaining and in a bad mood"
                            },
                            {
                                "target_lang_word": "cantankerous",
                                "target_lang_sense_clarification": "bad-tempered, argumentative, and uncooperative"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ворчливый",
                                "target_lang_sense_clarification": "склонный к постоянному недовольству и жалобам"
                            },
                            {
                                "target_lang_word": "брюзгливый",
                                "target_lang_sense_clarification": "постоянно выражающий недовольство по мелочам"
                            },
                            {
                                "target_lang_word": "раздражительный",
                                "target_lang_sense_clarification": "легко приходящий в состояние гнева или недовольства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46e6158f-349d-34af-b557-94bcd12d30b9",
                    "sense_definition": "met veel knoesten of onregelmatigheden, meestal gezegd van hout of bomen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "uiterlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude eik had een <w>knorrige</w> stam die getekend was door de tijd.",
                            "target_lang_translations": {
                                "en": "The old oak had a <w>gnarled</w> trunk that was marked by time.",
                                "ru": "У старого дуба был <w>узловатый</w> ствол, отмеченный временем."
                            }
                        },
                        {
                            "text": "Hij sneed een wandelstok uit een <w>knorrig</w> stuk hout dat hij in het bos vond.",
                            "target_lang_translations": {
                                "en": "He carved a walking stick from a <w>knotty</w> piece of wood he found in the forest.",
                                "ru": "Он вырезал трость из <w>корявого</w> куска дерева, который нашел в лесу."
                            }
                        }
                    ],
                    "antonyms": [
                        "glad"
                    ],
                    "common_phrases": [
                        "knorrige stam"
                    ],
                    "target_lang_definitions": {
                        "en": "having many knots or irregularities, usually said of wood or trees",
                        "ru": "с большим количеством узлов или неровностей, обычно говорится о древесине или деревьях"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gnarled",
                                "target_lang_sense_clarification": "knotted, rough, and twisted, especially with age"
                            },
                            {
                                "target_lang_word": "knotty",
                                "target_lang_sense_clarification": "full of knots or lumps in wood"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "узловатый",
                                "target_lang_sense_clarification": "имеющий много узлов или наростов (о дереве)"
                            },
                            {
                                "target_lang_word": "корявый",
                                "target_lang_sense_clarification": "неровный, изогнутый и грубый"
                            },
                            {
                                "target_lang_word": "сучковатый",
                                "target_lang_sense_clarification": "с большим количеством сучков"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}