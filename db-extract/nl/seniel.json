                                    {
                                        "sense_id": "c95e36a5-78ab-3a63-9705-6131118bd496",
                                        "entry_id": "85322d7d-36c0-3c35-ae74-b34034a0ad7c",
                                        "glosses": [
                                            "Relatif à la vieillesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f02a8d88-d35a-4b71-9b53-3f3fed141459",
                                                "sense_id": "c95e36a5-78ab-3a63-9705-6131118bd496",
                                                "text": "Débilité sénile, faiblesse qui tient à la vieillesse."
                                            },
                                            {
                                                "example_id": "32bb11f2-84e2-468e-a340-0a5b4e687eec",
                                                "sense_id": "c95e36a5-78ab-3a63-9705-6131118bd496",
                                                "text": "Démence sénile, ensemble de troubles mentaux spécifiques de la vieillesse."
                                            },
                                            {
                                                "example_id": "edfb50a4-77c7-4358-9c55-9fab7b404636",
                                                "sense_id": "c95e36a5-78ab-3a63-9705-6131118bd496",
                                                "text": "Gangrène sénile, gangrène liée à l'âge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be705af0-540f-39e7-b4ad-b033eebb0d36",
                                        "entry_id": "85322d7d-36c0-3c35-ae74-b34034a0ad7c",
                                        "glosses": [
                                            "Qui rappelle le comportement d'un vieillard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6b29fd0-bc67-4dcc-b1ba-979ed74b099b",
                                                "sense_id": "be705af0-540f-39e7-b4ad-b033eebb0d36",
                                                "text": "Raisonnement sénile."
                                            },
                                            {
                                                "example_id": "ef034d0f-5a4e-4214-92e8-f3cf0198351e",
                                                "sense_id": "be705af0-540f-39e7-b4ad-b033eebb0d36",
                                                "text": "— Il faut vous dire qu’à l’âge de dix-huit ans, j’ai été toute une saison chargé de veiller sur ma grand-mère, devenue peu à peu sénile."
                                            }
                                        ]
                                    }
                                ]
                            }
