                    {
                        "translation_id": "70bbc655-a2ca-435a-8480-e0d36790823c",
                        "source_entry_id": "6604d40a-5eb1-3e14-8a9f-2e1732fe3456",
                        "source_sense_description": "Distinction",
                        "target_lang_word": "onderscheiding",
