                        ],
                        "examples": [
                            {
                                "example_id": "a53ec76e-3446-4b7c-a339-0b2dc1ceebbd",
                                "sense_id": "61b6a45c-a8bb-3117-8ed5-52c828d226cd",
                                "text": "Machen Sie den Sauhaufen Ihres Sohnes von meinem liebevoll gepflegten englischen Rasen weg."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a5c44722-dfd6-3df8-aef8-49a5f3585317",
                        "entry_id": "370d609b-91e2-3f0c-af81-afc3875aeb56",
                        "glosses": [
                            "grobe Beleidigung gegenüber einer Gruppe"
                        ],
                        "tags": [
                            "derogatory",
                            "impolite"
                        ],
                        "examples": [
                            {
                                "example_id": "d4f50476-14df-4f0f-80aa-a1dacbf68e5f",
                                "sense_id": "a5c44722-dfd6-3df8-aef8-49a5f3585317",
                                "text": "Der Sauhaufen hat gestern so laut Party gemacht, dass ich nicht schlafen konnte."
                            }
                        ],
