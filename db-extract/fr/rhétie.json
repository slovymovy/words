            {
                "entry_id": "b55bb626-1ee0-35e3-87c7-158585ad8f41",
                "word": "Rhétie",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4f509cfc-b916-31a5-a194-62209a3c3f73",
                        "entry_id": "b55bb626-1ee0-35e3-87c7-158585ad8f41",
                        "glosses": [
                            "Province de l’Empire romain, habitée dans le Tyrol par les Rhètes et en Bavière par les Vindéliciens."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "fe789f67-4e16-42f7-91f3-1c34aefe6709",
                                "sense_id": "4f509cfc-b916-31a5-a194-62209a3c3f73",
                                "text": "Au XIXᵉ siècle, le linguiste italien Graziado Ascoli les a réunies en un groupe nommé « rhéto-roman », en référence à la Rhétie, provinces romaines qui correspondait aux Alpes centrales."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f60c5450-f466-4bbd-8d45-6a135c697f9b",
                        "source_entry_id": "b55bb626-1ee0-35e3-87c7-158585ad8f41",
                        "source_sense_id": "4f509cfc-b916-31a5-a194-62209a3c3f73",
                        "target_lang_word": "Rätien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rätien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cea372af-9709-3708-8cbb-e32794689d2d",
                                        "entry_id": "85a69a1c-2491-33e6-8b09-295c5a9edcfb",
                                        "glosses": [
                                            "altrömische Provinz"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57f18e87-8a8d-4dab-9901-4c7f260e4e8c",
                                                "sense_id": "cea372af-9709-3708-8cbb-e32794689d2d",
                                                "text": "Kelten saßen schon an die fünf Jahrhunderte lang im Land zu der Zeit, als die Römer ihre Herrschaft in Rätien aufrichteten (15. v. Chr.)."
                                            },
                                            {
                                                "example_id": "03d8e50a-7f2c-4f36-8d50-fbe100597688",
                                                "sense_id": "cea372af-9709-3708-8cbb-e32794689d2d",
                                                "text": "In römischer Zeit erschien der Name «Rätien» für eine Provinz, die zuerst von Graubünden bis Augsburg reichte und nachher in die Raetia prima (Chur) und Raetia secunda (Augsburg) geteilt wurde."
                                            },
                                            {
                                                "example_id": "46aee078-a7b6-472c-b06f-e518d9213293",
                                                "sense_id": "cea372af-9709-3708-8cbb-e32794689d2d",
                                                "text": "Es wird davon ausgegangen, dass der halbrund ausgeformten Tortyp gegen Ende des 2. Jahrhunderts entstand und in Rätien sein Vorbild beim Legionslager Regensburg hat."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a350a6d8-4b4e-36b4-9cbb-458419e515a6",
                                        "entry_id": "85a69a1c-2491-33e6-8b09-295c5a9edcfb",
                                        "glosses": [
                                            "der schweizerische Kanton Graubünden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b533940-b21f-45b5-bf10-dedf4b2a7d97",
                                                "sense_id": "a350a6d8-4b4e-36b4-9cbb-458419e515a6",
                                                "text": "Im 16. Jahrhundert wurde von Humanisten der Name der römischen Provinz Raetia als Rätien auf das Gebiet der Drei Bünde übertragen."
                                            },
                                            {
                                                "example_id": "e4e8ed8f-5ba2-40cc-8f89-a94fec830b54",
                                                "sense_id": "a350a6d8-4b4e-36b4-9cbb-458419e515a6",
                                                "text": "Poschiavo wiederum, dessen Name vom lateinischen post lacum («hinter dem See») herrührt, kam als Teil des Kantons Rätien zur Helvetischen Republik."
                                            },
                                            {
                                                "example_id": "58865d2d-ac5e-448b-bec3-8f156ab331c1",
                                                "sense_id": "a350a6d8-4b4e-36b4-9cbb-458419e515a6",
                                                "text": "«Das LIR ist nicht einfach ein romanisches Lexikon, sondern stellt ganz Graubünden, ja sogar ganz Rätien in einem Zeitraum von rund 12 000 Jahren dar», erläutert Collenberg, der sich seit 21 Jahren als Redaktor dem Lexikon widmet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
