                "senses": [
                    {
                        "sense_id": "5aaa3fcb-e450-3c09-abfd-66bb534c2637",
                        "entry_id": "776611d8-78e0-3177-90b6-243281a15cb6",
                        "glosses": [
                            "Freude, die durch die sinnliche Wahrnehmung angenehmer Eindrücke hervorgerufen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6aa89d4-7969-4de5-befd-cff9b2de9d8e",
                                "sense_id": "5aaa3fcb-e450-3c09-abfd-66bb534c2637",
                                "text": "„Das Glück zwischen uns, die Lebensfreude, eine Sinnenfreude, die sehr viel mehr als Sinnenfreude ist, nur das zählt im Moment.“"
                            },
                            {
                                "example_id": "235748a1-0a57-4a26-ae3c-711dc46ed233",
                                "sense_id": "5aaa3fcb-e450-3c09-abfd-66bb534c2637",
                                "text": "„Der Traum zeigt die verdrängten Schattenseiten, die jedoch auf der anderen Seite Sinnenfreude und Lebenslust in sich schließen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3042b866-3444-3907-b33a-ca9e98bc322d",
                        "entry_id": "776611d8-78e0-3177-90b6-243281a15cb6",
                        "glosses": [
                            "Freude durch körperlichen, auch erotischen/sexuellen Genuss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6870db11-b6e3-40fb-9b85-b4b769879848",
                                "sense_id": "3042b866-3444-3907-b33a-ca9e98bc322d",
                                "text": "„Dann überließen sich beide ganz der Sinnenfreude.“"
                            },
                            {
                                "example_id": "f88a3601-293b-4660-b8c0-678f99a038eb",
                                "sense_id": "3042b866-3444-3907-b33a-ca9e98bc322d",
                                "text": "„Schauerlich, wenn das Weib die Sinnenfreude und ihre Schönheit mit dem Mann nicht teilt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
