                ],
                "senses": [
                    {
                        "sense_id": "60af8bce-0c4d-3598-9f8b-853e9196b812",
                        "entry_id": "fe8e5dca-6943-3af4-9489-c783419e6862",
                        "glosses": [
                            "land dat grenst aan een bepaald land"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57d1a374-4ed9-42c8-8a15-e95298a7d684",
                                "sense_id": "60af8bce-0c4d-3598-9f8b-853e9196b812",
                                "text": "Er bestaat vrees dat het geweld overslaat naar de buurlanden."
                            },
                            {
                                "example_id": "55b6e3ba-3ba7-4dc5-ac68-aaca78fa3e4f",
                                "sense_id": "60af8bce-0c4d-3598-9f8b-853e9196b812",
                                "text": "Duitsland en België zijn de buurlanden van Nederland."
                            },
                            {
                                "example_id": "994eaf89-3fc5-4b83-bbe1-15074fd1f121",
                                "sense_id": "60af8bce-0c4d-3598-9f8b-853e9196b812",
                                "text": "Zweden koos aan het begin van de coronacrisis een aanpak die afweek van die in veel andere landen in Europa: scholen, sportscholen, horecazaken en winkels bleven open. Wel moesten Zweden 1,5 meter afstand van elkaar houden op straat. Tegelijkertijd werd erop gerekend dat mensen de nieuwe coronaregels vrijwillig zouden naleven, tot afschuw van buurlanden."
                            },
                            {
                                "example_id": "0808b4c3-8138-4654-b4ee-0e85930a459f",
                                "sense_id": "60af8bce-0c4d-3598-9f8b-853e9196b812",
                                "text": "Een lichtpuntje was dat Finland er veel beter vanaf was gekomen dan de buurlanden Estland, Letland en Litouwen, die waren opgeslokt door de barbarij en veranderd in Sovjetrepublieken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2c64490-356e-4ba9-96d8-4a233322ae5a",
                        "source_entry_id": "fe8e5dca-6943-3af4-9489-c783419e6862",
                        "source_sense_id": "60af8bce-0c4d-3598-9f8b-853e9196b812",
                        "source_sense_description": "land dat grenst aan een bepaald land",
                        "target_lang_word": "Nachbarland",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachbarland",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3020a926-ca61-3c8e-9638-767f9ebd4840",
                                        "entry_id": "ec394f88-324e-3d93-a7f0-9d196619cde8",
                                        "glosses": [
                                            "Staat, der mit einem anderen eine Staatsgrenze teilt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74639fd1-79a8-4800-899b-625c6facbfb5",
                                                "sense_id": "3020a926-ca61-3c8e-9638-767f9ebd4840",
                                                "text": "Deutschland hat neun Nachbarländer."
                                            },
                                            {
                                                "example_id": "488d1eaa-e05c-4e40-acba-4c3ef3cff96d",
                                                "sense_id": "3020a926-ca61-3c8e-9638-767f9ebd4840",
                                                "text": "„Mit solchen und ähnlichen wüsten Drohungen versucht Pjöngjang regelmäßig, sein Nachbarland Südkorea und dessen Verbündete - besonders die USA - einzuschüchtern.“"
                                            },
                                            {
                                                "example_id": "70d0b5c4-0dc6-4361-87a9-fefcd0673f16",
                                                "sense_id": "3020a926-ca61-3c8e-9638-767f9ebd4840",
                                                "text": "„Zu den Statistiken aus den Nachbarländern sei angemerkt, dass sie nicht alle vergebenen Vornamen berücksichtigen, sondern nur die Erstnamen beziehungsweise einen Vornamen.“"
                                            },
                                            {
                                                "example_id": "02e28dc4-b080-4a53-8397-2bda6787e3e5",
                                                "sense_id": "3020a926-ca61-3c8e-9638-767f9ebd4840",
                                                "text": "„Die Reaktion der Nordvietnamesen bestand darin, dass sie ihre Bemühungen intensivierten, das Nachbarland zu infiltrieren und die kommunistische Bewegung des Landes […] zu schulen.“"
                                            },
                                            {
                                                "example_id": "2059ac58-312c-44ba-a90b-a782c66175d0",
                                                "sense_id": "3020a926-ca61-3c8e-9638-767f9ebd4840",
                                                "text": "„Er floh aus dem Nachbarland Eritrea vor dem folternden Diktator Isayas Afewerki.“"
                                            },
                                            {
                                                "example_id": "73f9164a-67b7-4bc0-8c9f-92c591d0591b",
                                                "sense_id": "3020a926-ca61-3c8e-9638-767f9ebd4840",
                                                "text": "„Seit der Gründung Pakistans nutzte Afghanistan die Paschtunistan-Frage, um in regelmäßigen Abständen die Selbstbestimmung der Paschtunen im Nachbarland zu fordern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
