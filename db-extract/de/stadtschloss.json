                ],
                "senses": [
                    {
                        "sense_id": "2644d63f-8955-365c-9481-5be955866ce5",
                        "entry_id": "0e2328a6-1801-33c9-b145-bba825ccc321",
                        "glosses": [
                            "ein meist mehrflügeliges (den Baustil seiner Zeit und den Prunk seiner Bewohner repräsentierendes) Wohngebäude des Adels, welches in einer Stadt oder dessen Nähe errichtet worden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87bc2e35-79b8-4b61-b8f4-1004eb61cfbc",
                                "sense_id": "2644d63f-8955-365c-9481-5be955866ce5",
                                "text": "In der Bundeshauptstadt plant man die Rekonstruktion jenes Stadtschlosses, welches von der DDR gesprengt wurde, und als Museum dienen soll."
                            },
                            {
                                "example_id": "35a31fab-4d56-4467-81a8-5bc678f8a61b",
                                "sense_id": "2644d63f-8955-365c-9481-5be955866ce5",
                                "text": "2005 wurde das Braunschweiger Stadtschloss als ein Einkaufscenter im inneren wiederhergestellt."
                            },
                            {
                                "example_id": "887bfcc7-2767-464e-a5df-582aeb3addd2",
                                "sense_id": "2644d63f-8955-365c-9481-5be955866ce5",
                                "text": "„In der oberen Etage sollen die Sammlungen der Staatlichen Museen sowie der Humboldt-Universität im Zusammenhang mit dem Stadtschloß vorgestellt werden.“"
                            },
                            {
                                "example_id": "979f0989-2fa4-4a87-9ee1-8e37eb4c713c",
                                "sense_id": "2644d63f-8955-365c-9481-5be955866ce5",
                                "text": "„Aschgrau statt patinagrün: Das neue Potsdamer Stadtschloss wird nach seiner Fertigstellung kein edles Kupferdach zieren.“"
                            },
                            {
                                "example_id": "ba0f5cd1-ab09-4984-bfe8-52bacc031345",
                                "sense_id": "2644d63f-8955-365c-9481-5be955866ce5",
                                "text": "„Im Frühjahr 2013 soll der Grundstein für das neue Stadtschloss gelegt werden. Die Eröffnung des Humboldtforums ist für 2018 geplant. Kosten: 590 Millionen Euro.“"
                            },
                            {
                                "example_id": "c0afa74a-5834-4982-81df-847acac381b5",
                                "sense_id": "2644d63f-8955-365c-9481-5be955866ce5",
                                "text": "„Eine Frau, mit der ich vor dem Stadtschloss ins Gespräch kam, lieferte mir die Erklärung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
