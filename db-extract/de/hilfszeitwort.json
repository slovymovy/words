                "senses": [
                    {
                        "sense_id": "e144856e-bb47-3c3b-a3c6-f2cee3d736ea",
                        "entry_id": "15cdd6da-d581-30eb-94cc-98295f532baf",
                        "glosses": [
                            "deutsche Bezeichnung für „Hilfsverb“; Verb, das als grammatisches Wort nur zusammen mit anderen Ausdrücken ein Prädikat bildet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b464c22e-de09-4c4c-8a37-53a16278249a",
                                "sense_id": "e144856e-bb47-3c3b-a3c6-f2cee3d736ea",
                                "text": "Hilfszeitwörter dienen im Deutschen zur Bildung der Formen des Perfekts, Plusquamperfekts und Futurs."
                            },
                            {
                                "example_id": "94f4eb01-e451-422d-9029-bac87ca93a06",
                                "sense_id": "e144856e-bb47-3c3b-a3c6-f2cee3d736ea",
                                "text": "Hilfszeitwörter sind im Deutschen \"haben\", \"sein\" und \"werden\". Sie werden für die Bildung der verschiedenen Zeiten (Tempora) verwendet. z. B.: ich bin gewesen, ich hatte gesehen."
                            },
                            {
                                "example_id": "ca3af97a-ac37-40cd-97a4-5de2bae571ef",
                                "sense_id": "e144856e-bb47-3c3b-a3c6-f2cee3d736ea",
                                "text": "„Grillparzer pflegte auch Hilfszeitwörter wegzulassen, wie schon vor ihm Lessing…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f13a97bd-37fd-46bf-b93f-eacdcce814f4",
                        "source_entry_id": "15cdd6da-d581-30eb-94cc-98295f532baf",
                        "source_sense_id": "e144856e-bb47-3c3b-a3c6-f2cee3d736ea",
                        "target_lang_word": "verbo auxiliar",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verbo auxiliar",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "46f99d43-b954-335f-9687-4c1f289e8232",
                                        "entry_id": "418bfc14-7f50-3023-8201-29dab1f7c76f",
                                        "glosses": [
                                            "Verbo (tipo de palabra que se conjuga) que se usa para formar tiempos compuestos, la voz pasiva, y otras perífrasis verbales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "187b2bc4-92ac-4db9-b484-45db62fa92e4",
                                                "sense_id": "46f99d43-b954-335f-9687-4c1f289e8232",
                                                "text": "El verbo \"haber\" es un verbo auxiliar en español cuando se emplea para formar tiempos como el pluscuamperfecto, el pretérito perfecto compuesto, etc. El verbo \"ser\" actúa como verbo auxiliar para formar la voz pasiva en español. El verbo \"estar\" es verbo auxiliar en perífrasis verbales con el gerundio, como en \"estoy leyendo\"."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
