                ],
                "senses": [
                    {
                        "sense_id": "5ba70c77-ba81-3da2-bfe9-34a357710e1e",
                        "entry_id": "fcd6ae2d-e830-375d-83b9-fcee0cf1e81c",
                        "glosses": [
                            "Person, die sich im Finanzwesen sehr gut auskennt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50ec576e-1616-48fb-8108-b315696d5ebb",
                                "sense_id": "5ba70c77-ba81-3da2-bfe9-34a357710e1e",
                                "text": "„Wenn die Finanzexperten so schlau sind, wie sie immer tun, müssten sie eigentlich die Herabstufung der USA vorausgesehen und dies in die Kurse der vorigen Woche eingepreist haben.“"
                            },
                            {
                                "example_id": "fb3d7ee3-d66c-4c56-b4d6-e813d0fc4836",
                                "sense_id": "5ba70c77-ba81-3da2-bfe9-34a357710e1e",
                                "text": "„\"Gerade in Phasen niedriger Guthabenverzinsung wie jetzt sollten Kapitalanleger ihr Erspartes - zumindest teilweise - in die Finanzierung einbringen. Denn damit ist das Sparguthaben nicht nur extrem solide investiert, Banken belohnen einen höheren Eigenkapitalanteil mit günstigeren Konditionen\", so Finanzexperte Goris.“"
                            },
                            {
                                "example_id": "8b1892ac-b63c-4ce8-8727-6940ac6659f1",
                                "sense_id": "5ba70c77-ba81-3da2-bfe9-34a357710e1e",
                                "text": "„Der Grüne Finanzexperte und Bankenkritiker Gerhard Schick wartet noch immer auf eine offizielle Einladung für eine Vorstandssitzung der Deutschen Bank.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
