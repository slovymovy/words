                "senses": [
                    {
                        "sense_id": "7c673123-de1c-3e8c-96e1-b5037b93e7d8",
                        "entry_id": "291dacb0-df5d-3edb-bd81-bd355770b70c",
                        "glosses": [
                            "aus Neopren gefertigter Kälteschutzanzug"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e913163-d518-46a9-a2e1-ab48f88571a4",
                                "sense_id": "7c673123-de1c-3e8c-96e1-b5037b93e7d8",
                                "text": "Vor dem Start schlüpfte der Surfer in seinen Neoprenanzug."
                            },
                            {
                                "example_id": "be952c7b-6666-4bd1-b4ba-26b2e7829c2b",
                                "sense_id": "7c673123-de1c-3e8c-96e1-b5037b93e7d8",
                                "text": "Der thailändische Beerenpflücker, der in Nordschweden Blaubeeren sammelte, trug einen Neoprenanzug gegen die Kälte und Feuchtigkeit."
                            },
                            {
                                "example_id": "d6fcbc72-62cc-405f-9750-3bf997cfe644",
                                "sense_id": "7c673123-de1c-3e8c-96e1-b5037b93e7d8",
                                "text": "„In den 1980er-Jahren war O'Neill zum größten Hersteller und Designer von Neoprenanzügen geworden.“"
                            }
                        ],
