    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cb285482-4642-3c23-bfe7-163fa903ba10",
                    "sense_definition": "Qui concerne deux parties, deux pays ou deux intervenants.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "diplomatie_accords",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux gouvernements ont signé un accord <w>bilatéral</w> pour renforcer leurs échanges commerciaux."
                        },
                        {
                            "text": "Ces négociations <w>bilatérales</w> permettront d'apaiser les tensions diplomatiques entre les deux nations voisines."
                        }
                    ],
                    "synonyms": [
                        "bipartite"
                    ],
                    "antonyms": [
                        "unilatéral",
                        "multilatéral"
                    ],
                    "common_phrases": [
                        "accord bilatéral",
                        "relations bilatérales"
                    ]
                },
                {
                    "sense_id": "9a830f85-93a0-38f3-989e-376e5393391a",
                    "sense_definition": "Qui possède deux côtés ou qui présente une symétrie droite-gauche.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "forme_symetrie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le corps humain présente une symétrie <w>bilatérale</w> presque parfaite par rapport à son axe vertical."
                        },
                        {
                            "text": "Le médecin a diagnostiqué une otite <w>bilatérale</w> qui touche les deux oreilles du patient."
                        }
                    ],
                    "common_phrases": [
                        "symétrie bilatérale"
                    ]
                },
                {
                    "sense_id": "a2e2730f-d815-39d0-aa1c-eba4ccf738f8",
                    "sense_definition": "Qui crée des obligations réciproques et interdépendantes pour chacune des parties contractantes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "droit_contrats",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La vente immobilière est un contrat <w>bilatéral</w> qui impose des devoirs au vendeur et à l'acheteur."
                        },
                        {
                            "text": "Dans cet engagement <w>bilatéral</w>, chaque signataire doit respecter scrupuleusement les clauses prévues."
                        }
                    ],
                    "synonyms": [
                        "synallagmatique",
                        "réciproque"
                    ],
                    "antonyms": [
                        "unilatéral"
                    ],
                    "common_phrases": [
                        "contrat bilatéral"
                    ]
                },
                {
                    "sense_id": "c42c9109-2bd1-36aa-b81e-e0051e860804",
                    "sense_definition": "Relatif à une filiation qui prend en compte simultanément la lignée paternelle et la lignée maternelle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "parente",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce système de parenté, la filiation <w>bilatérale</w> accorde les mêmes droits aux deux lignées familiales."
                        },
                        {
                            "text": "Les anthropologues étudient les sociétés qui privilégient une descendance <w>bilatérale</w> pour la transmission des biens."
                        }
                    ],
                    "synonyms": [
                        "cognatique"
                    ],
                    "antonyms": [
                        "unilatéral"
                    ],
                    "common_phrases": [
                        "filiation bilatérale"
                    ]
                }
            ]
        }
    ]
