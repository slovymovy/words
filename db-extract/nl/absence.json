                                        "glosses": [
                                            "Fehlstunde oder Fehltag in Schule oder Beruf etwa aufgrund von Krankheit"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "Swiss Standard German",
                                            "usually"
