                "senses": [
                    {
                        "sense_id": "8381f44f-73d4-3a7b-aac2-4046b2f134f3",
                        "entry_id": "deae9e27-62e0-38df-9b31-67dee745a8ee",
                        "glosses": [
                            "ein Wort, in dem alle Buchstaben gleich oft (im einfachsten Fall jeder einmal) vorkommen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f450bc2-4ad5-4779-a691-1cc5981404f5",
                                "sense_id": "8381f44f-73d4-3a7b-aac2-4046b2f134f3",
                                "text": "Das Wort „Otto“ ist ein Isogramm, in dem jeder enthaltene Buchstabe genau zweimal vorkommt."
                            },
                            {
                                "example_id": "9f1a7db7-bf76-4333-9491-8921338c026b",
                                "sense_id": "8381f44f-73d4-3a7b-aac2-4046b2f134f3",
                                "text": "„Geist“ ist ein Anagramm zu dem Wort „siegt“ und ein Isogramm."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ca97b68d-bb91-323e-8884-af4377843d29",
                        "entry_id": "deae9e27-62e0-38df-9b31-67dee745a8ee",
                        "glosses": [
                            "Linie in einem Diagramm oder einer Karte, die gleiche Werte verbindet"
                        ],
                        "tags": [
                            "Kartographie",
                            "wissenschaftliche und technische Grafik"
                        ],
                        "examples": [
                            {
                                "example_id": "d97c6a9a-29c7-4312-ba7b-0e804c0d94fc",
                                "sense_id": "ca97b68d-bb91-323e-8884-af4377843d29",
                                "text": "Auf der Niederschlagskarte Chinas gibt ein Isogramm einen Jahresniederschlag von 200 mm an."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
