                            {
                                "example_id": "77c5893e-2a78-4d98-b063-69f3aef5c8cd",
                                "sense_id": "f0a72a36-39c5-3b53-9287-7b5bfe23e78c",
                                "text": "„Ein beträchtliches Anwesen, aber ich schätze, man braucht ein beträchtliches Familienvermögen, um solche Expeditionen zu finanzieren...“"
                            },
                            {
                                "example_id": "7b058801-1ee4-4e90-83d0-b55380a1b3ef",
                                "sense_id": "f0a72a36-39c5-3b53-9287-7b5bfe23e78c",
                                "text": "„Als Sohn mexikanischer Einwanderer verfügte der Präsident nicht über einen beeindruckenden politischen Stammbaum, der mit Generationen von Familienvermögen verbunden war.“"
                            }
                        ],
