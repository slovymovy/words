        "fr-extract.jsonl": [
            {
                "entry_id": "341d7e65-eb74-3eaf-9cdb-1a69699a58df",
                "word": "émulation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5d1f7999-9de4-4660-8a1b-cda67a8a1514",
                        "entry_id": "341d7e65-eb74-3eaf-9cdb-1a69699a58df",
                        "tags": [
                            "plural"
                        ],
                        "form": "émulations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "90cf22eb-3845-3bd1-a9f5-78fd6d19f1f0",
                        "entry_id": "341d7e65-eb74-3eaf-9cdb-1a69699a58df",
                        "glosses": [
                            "Sentiment de rivalité qui pousse à chercher à égaler quelqu'un ou à le surpasser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ec0eb9e-2555-474a-8cdd-58fd2017284b",
                                "sense_id": "90cf22eb-3845-3bd1-a9f5-78fd6d19f1f0",
                                "text": "De là les premiers regards sur ses semblables ; de là les premières comparaisons avec eux, de là l’émulation, les rivalités, la jalousie."
                            },
                            {
                                "example_id": "34aeebca-b4df-4b61-8d4b-f5f550802b62",
                                "sense_id": "90cf22eb-3845-3bd1-a9f5-78fd6d19f1f0",
                                "text": "Le rang d'aîné qu'avait le dauphin, et la faveur du roi qu'avait le duc d'Orléans, faisaient entre eux une sorte d'émulation, qui allait jusqu'à la haine."
                            }
                        ]
                    },
                    {
                        "sense_id": "338dd5e6-0318-3842-9bfc-8d3cc557b56d",
                        "entry_id": "341d7e65-eb74-3eaf-9cdb-1a69699a58df",
                        "glosses": [
                            "Situation de rivalité considérée comme bénéfique à chacun des rivaux, chacun cherchant à s'améliorer pour surpasser les autres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34032e8e-97bf-429a-81a5-66cc566dd70a",
                                "sense_id": "338dd5e6-0318-3842-9bfc-8d3cc557b56d",
                                "text": "Quelque rapport qu'il paraisse de la jalousie à l'émulation, il y a entre elles le même éloignement que celui qui se trouve entre le vice et la vertu."
                            },
                            {
                                "example_id": "f29220ef-96e9-4022-99e2-f1a5d8607b42",
                                "sense_id": "338dd5e6-0318-3842-9bfc-8d3cc557b56d",
                                "text": "Le concept de concurrence, ici mis en œuvre, se présente comme une néfaste simplification de l’émulation telle que la pensaient les Grecs, qui la nommaient éris. Que l’émulation soit au principe du dynamisme interne de toute communauté économico-politique paraît non seulement concevable, mais indépassable."
                            },
                            {
                                "example_id": "0f8de5bd-7142-4834-ae96-5157c3ad1ccb",
                                "sense_id": "338dd5e6-0318-3842-9bfc-8d3cc557b56d",
                                "text": "Je me plais à voir, dans ces relations du passé, dans cette émulation spirituelle de tout ce que la culture présentait alors de plus généreux, de plus universel, de plus neuf et de plus hardi, une sorte d'annonce, de préparation et d'inconsciente promesse; […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "5304b96a-bf4a-3952-8752-2a654151cdff",
                        "entry_id": "341d7e65-eb74-3eaf-9cdb-1a69699a58df",
                        "glosses": [
                            "Procédé d'imitation ou de simulation logicielle d'un matériel ancien ou d'un programme non prévu pour le matériel sur lequel on veut l'exécuter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac139c15-76cd-4df8-a614-2083097615f9",
                                "sense_id": "5304b96a-bf4a-3952-8752-2a654151cdff",
                                "text": "Ce site est dédié aux logiciels d'émulation de consoles vidéo."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f0385978-e2db-4a5c-bbab-ae8ca7e26bdc",
                        "source_entry_id": "341d7e65-eb74-3eaf-9cdb-1a69699a58df",
                        "source_sense_description": "rivalité qui pousse à égaler ou surpasser",
                        "target_lang_word": "emulation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emulation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "09e89f6e-3c3e-3634-8c26-30cab9aef856",
                                        "entry_id": "80d32186-6777-3fda-b2d9-6997dbc74a93",
                                        "glosses": [
                                            "The endeavor or desire to equal or excel someone else in qualities or actions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fe37b9a-e9f4-412e-b212-08aa7350a7ce",
                                                "sense_id": "09e89f6e-3c3e-3634-8c26-30cab9aef856",
                                                "text": "a great figure who is worthy of respect and emulation"
                                            },
                                            {
                                                "example_id": "d14bd988-2fc8-499e-be0c-e7cac1acd223",
                                                "sense_id": "09e89f6e-3c3e-3634-8c26-30cab9aef856",
                                                "text": "Allur'd, not forc'd, encourag'd, not compell'd;\nThe shrinking eye look'd up, the soul was cheer'd,\nFelt as it learnt, confided e'er it fear'd;\nAnd first by emulation's ardour mov'd,\nPrest onward in the path which soon it lov'd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f08597c-cf2e-359e-9dda-3cbb6588c417",
                                        "entry_id": "80d32186-6777-3fda-b2d9-6997dbc74a93",
                                        "glosses": [
                                            "Jealous rivalry; envy; envious contention."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7622985b-0e82-49f3-b3f4-6a823ea16582",
                                                "sense_id": "2f08597c-cf2e-359e-9dda-3cbb6588c417",
                                                "text": "Scarce two gentlemen dwell together in the country […] , but there is emulation betwixt them and their servants, some quarrel or some grudge betwixt their wives or children […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdf13588-cb54-35f5-b029-8a4c0d0ea7b3",
                                        "entry_id": "80d32186-6777-3fda-b2d9-6997dbc74a93",
                                        "glosses": [
                                            "Execution of a program or other software designed for a different system, by simulating parts of the other system."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
