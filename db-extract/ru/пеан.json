                                    {
                                        "sense_id": "80550c0e-bf1f-3569-aada-9e737387b1ca",
                                        "entry_id": "a7ba2220-bc93-339a-a74a-e4739ac86ce1",
                                        "glosses": [
                                            "in Südasien verbreitetes, aus Betelnüssen hergestelltes Genuss- und Rauschmittel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46a688e9-8775-4b8b-b668-45817238f3cf",
                                                "sense_id": "80550c0e-bf1f-3569-aada-9e737387b1ca",
                                                "text": "„Sie hat Paan in der rechten Backe und fängt ab und zu den roten Saft mit der Zunge auf, bevor er ihr übers Kinn rinnt.“"
                                            },
                                            {
                                                "example_id": "3270fad4-6dd5-49e8-9bf6-f90fdece03c6",
                                                "sense_id": "80550c0e-bf1f-3569-aada-9e737387b1ca",
                                                "text": "„Paritosh Shah sprach flüsternd in eines seiner schwarzen Telefone und hielt mir mit der freien Hand eine silberne Schatulle mit silberfleckigen Paan, Supari und Elaichi hin.“"
                                            }
                                        ],
