{
    "word_family": [
        "poker",
        "poky",
        "slowpoke",
        "pokeweed",
        "pokeberry"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "764bbe48-6832-30a0-a148-4c34f64a3ab0",
                    "sense_definition": "To push a finger, stick, or other pointed object quickly into or against someone or something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She used a stick to <w>poke</w> the fire and make it burn brighter.",
                            "target_lang_translations": {
                                "ru": "Она использовала палку, чтобы <w>поворошить</w> костёр и заставить его гореть ярче.",
                                "zh": "她用一根棍子去<w>拨弄</w>火堆，让火烧得更旺。"
                            }
                        },
                        {
                            "text": "Stop trying to <w>poke</w> me in the ribs while I am driving.",
                            "target_lang_translations": {
                                "ru": "Перестань пытаться <w>ткнуть</w> меня в ребра, пока я за рулем.",
                                "zh": "我开车的时候，别老想用手指<w>戳</w>我的肋骨。"
                            }
                        }
                    ],
                    "synonyms": [
                        "prod",
                        "jab",
                        "dig",
                        "thrust"
                    ],
                    "common_phrases": [
                        "poke in the eye",
                        "poke with a stick",
                        "poke fun at"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро толкать пальцем, палкой или другим острым предметом внутрь или в поверхность чего-либо.",
                        "zh": "用手指、棍子或其他尖的东西快速戳或捅某人、某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тыкать",
                                "target_lang_sense_clarification": "несовершенный вид; наносить легкие удары"
                            },
                            {
                                "target_lang_word": "ткнуть",
                                "target_lang_sense_clarification": "совершенный вид; сделать быстрый тычок"
                            },
                            {
                                "target_lang_word": "шуровать",
                                "target_lang_sense_clarification": "ворошить (обычно об огне или углях)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "戳",
                                "target_lang_sense_clarification": "用手指等尖细物快速戳一下"
                            },
                            {
                                "target_lang_word": "捅",
                                "target_lang_sense_clarification": "用较尖或较硬的东西捅一下"
                            },
                            {
                                "target_lang_word": "拨弄",
                                "target_lang_sense_clarification": "拨动、翻动，常用于火或煤"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77feb726-63e1-3d99-bd50-a33be0918760",
                    "sense_definition": "To send a digital notification to get someone's attention on a social media platform.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "digital_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I decided to <w>poke</w> my old friend on Facebook to see if he would respond.",
                            "target_lang_translations": {
                                "ru": "Я решил <w>ткнуть</w> старого друга в Фейсбуке, чтобы посмотреть, ответит ли он.",
                                "zh": "我决定在脸书上给老朋友<w>戳一戳</w>，看看他会不会回应。"
                            }
                        },
                        {
                            "text": "If you <w>poke</w> him online, he might notice your message sooner.",
                            "target_lang_translations": {
                                "ru": "Если ты <w>ткнешь</w> его в сети, он может заметить твое сообщение раньше.",
                                "zh": "如果你在网上<w>戳一戳</w>他，他可能会更快注意到你的消息。"
                            }
                        }
                    ],
                    "synonyms": [
                        "nudge",
                        "ping"
                    ],
                    "common_phrases": [
                        "poke a friend",
                        "send a poke"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отправить цифровое уведомление пользователю в социальной сети, чтобы привлечь его внимание.",
                        "zh": "在社交媒体平台上给某人发送一个提醒，以引起对方注意。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ткнуть",
                                "target_lang_sense_clarification": "сленг; использовать функцию привлечения внимания"
                            },
                            {
                                "target_lang_word": "подмигнуть",
                                "target_lang_sense_clarification": "аналог функции 'poke' в некоторых соцсетях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "戳一戳",
                                "target_lang_sense_clarification": "社交平台上的提醒功能，轻点一下引起对方注意"
                            },
                            {
                                "target_lang_word": "戳",
                                "target_lang_sense_clarification": "口语说法，指在线上给对方发一个轻提醒"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55fbb71d-2891-35aa-9cc8-ce71867365e6",
                    "sense_definition": "To push or stick part of something out so that it is visible; to protrude.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog's head <w>poked</w> out of the car window to catch the breeze.",
                            "target_lang_translations": {
                                "ru": "Голова собаки <w>высунулась</w> из окна машины, чтобы поймать ветерок.",
                                "zh": "那只狗把头<w>伸出</w>车窗，好吹吹风。"
                            }
                        },
                        {
                            "text": "Be careful, there is a sharp wire <w>poking</w> through the fabric of the chair.",
                            "target_lang_translations": {
                                "ru": "Осторожно, острая проволока <w>торчит</w> сквозь ткань стула.",
                                "zh": "小心，椅子的布面里有一根尖铁丝正<w>露出</w>来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stick out",
                        "protrude",
                        "jut"
                    ],
                    "common_phrases": [
                        "poke out",
                        "poke through",
                        "poke one's head in"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выступать наружу или быть видимым изнутри чего-либо.",
                        "zh": "使某物的一部分伸到外面并能看见；突出。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высовываться",
                                "target_lang_sense_clarification": "показываться наружу (о движении)"
                            },
                            {
                                "target_lang_word": "торчать",
                                "target_lang_sense_clarification": "выступать над поверхностью (о состоянии)"
                            },
                            {
                                "target_lang_word": "выглядывать",
                                "target_lang_sense_clarification": "смотреть или виднеться из укрытия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "伸出",
                                "target_lang_sense_clarification": "从里面往外探出、伸到外面"
                            },
                            {
                                "target_lang_word": "露出",
                                "target_lang_sense_clarification": "从遮挡物后面显露出来"
                            },
                            {
                                "target_lang_word": "突出",
                                "target_lang_sense_clarification": "向外突出来"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "955ef388-1e63-35cd-9a50-5e028d9366a1",
                    "sense_definition": "To search for something by moving things around, often in a casual or unorganized way.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "search_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I spent the afternoon <w>poking</w> around the attic looking for my grandfather's old photos.",
                            "target_lang_translations": {
                                "ru": "Я провел день, <w>копаясь</w> на чердаке в поисках старых фотографий дедушки.",
                                "zh": "我整个下午都在阁楼里<w>翻找</w>祖父的老照片。"
                            }
                        },
                        {
                            "text": "The detective began to <w>poke</w> about the crime scene for any missed clues.",
                            "target_lang_translations": {
                                "ru": "Детектив начал <w>рыскать</w> по месту преступления в поисках упущенных улик.",
                                "zh": "侦探开始在犯罪现场四处<w>搜找</w>，看看有没有漏掉的线索。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rummage",
                        "forage",
                        "dig",
                        "root"
                    ],
                    "common_phrases": [
                        "poke around",
                        "poke about",
                        "poke one's nose into"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искать что-либо, перебирая вещи, часто небрежно или без системы.",
                        "zh": "翻动周围的东西寻找某物，通常方式较随意或不太有条理。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рыться",
                                "target_lang_sense_clarification": "искать, перекладывая вещи"
                            },
                            {
                                "target_lang_word": "копаться",
                                "target_lang_sense_clarification": "медленно или тщательно искать"
                            },
                            {
                                "target_lang_word": "шуровать",
                                "target_lang_sense_clarification": "разг.; энергично искать или рыскать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "翻找",
                                "target_lang_sense_clarification": "把东西翻来翻去地找"
                            },
                            {
                                "target_lang_word": "乱翻",
                                "target_lang_sense_clarification": "随意或杂乱地到处找"
                            },
                            {
                                "target_lang_word": "搜找",
                                "target_lang_sense_clarification": "四处搜寻、查找"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ab01f8f-adc5-3de6-a7c3-436f6fbb0a02",
                    "sense_definition": "To have sexual intercourse with someone.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sexual_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teenagers were making crude jokes about who <w>poked</w> whom at the party.",
                            "target_lang_translations": {
                                "ru": "Подростки отпускали грубые шутки о том, кто кого <w>трахнул</w> на вечеринке.",
                                "zh": "那群青少年在开一些下流玩笑，说谁在派对上把谁<w>上</w>了。"
                            }
                        },
                        {
                            "text": "He got into trouble for bragging that he had <w>poked</w> her.",
                            "target_lang_translations": {
                                "ru": "У него были неприятности из-за хвастовства, что он её <w>чпокнул</w>.",
                                "zh": "他因为吹嘘自己把她<w>上</w>了而惹上了麻烦。"
                            }
                        }
                    ],
                    "synonyms": [
                        "screw",
                        "bang",
                        "shag"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заниматься сексом с кем-либо (грубый сленг).",
                        "zh": "与某人发生性关系；粗俗俚语说法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трахать",
                                "target_lang_sense_clarification": "грубое обозначение полового акта"
                            },
                            {
                                "target_lang_word": "чпокнуть",
                                "target_lang_sense_clarification": "сленг; совершить быстрый половой акт"
                            },
                            {
                                "target_lang_word": "шуровать",
                                "target_lang_sense_clarification": "устар. сленг; заниматься сексом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "上",
                                "target_lang_sense_clarification": "粗俗说法，指与某人发生性关系"
                            },
                            {
                                "target_lang_word": "操",
                                "target_lang_sense_clarification": "非常粗俗的说法"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "74ccff2b-e281-338a-a01f-bcaa94ee6026",
                    "sense_definition": "A quick push or jab with a finger or a pointed object.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave him a sharp <w>poke</w> in the arm to get his attention.",
                            "target_lang_translations": {
                                "ru": "Она наградила его резким <w>тычком</w> в руку, чтобы привлечь его внимание.",
                                "zh": "为了引起他的注意，她朝他手臂上来了一记猛<w>戳</w>。"
                            }
                        },
                        {
                            "text": "One little <w>poke</w> with the needle and the balloon burst instantly.",
                            "target_lang_translations": {
                                "ru": "Один маленький <w>тычок</w> иголкой, и шарик мгновенно лопнул.",
                                "zh": "针轻轻一<w>戳</w>，气球立刻就爆了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jab",
                        "prod",
                        "thrust",
                        "nudge"
                    ],
                    "common_phrases": [
                        "give a poke",
                        "sharp poke"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстрый толчок или удар пальцем или острым предметом.",
                        "zh": "用手指或尖物快速戳、捅的一下。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тычок",
                                "target_lang_sense_clarification": "короткий удар или прикосновение"
                            },
                            {
                                "target_lang_word": "толчок",
                                "target_lang_sense_clarification": "резкое движение от себя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "戳",
                                "target_lang_sense_clarification": "一下快速的戳碰或戳刺"
                            },
                            {
                                "target_lang_word": "捅",
                                "target_lang_sense_clarification": "一下突然的捅碰"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57b55c7a-9c44-36ff-80b5-50b33d924b14",
                    "sense_definition": "A Hawaiian dish consisting of diced raw fish, usually tuna, seasoned with soy sauce, sesame oil, and other ingredients.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to order a spicy tuna <w>poke</w> for lunch.",
                            "target_lang_translations": {
                                "ru": "Мы решили заказать острое <w>поке</w> с тунцом на обед.",
                                "zh": "我们决定午餐点一份辣味金枪鱼<w>波奇饭</w>。"
                            }
                        },
                        {
                            "text": "The restaurant serves a delicious salmon <w>poke</w> bowl with avocado and rice.",
                            "target_lang_translations": {
                                "ru": "В ресторане подают вкусный боул с <w>поке</w> из лосося с авокадо и рисом.",
                                "zh": "这家餐厅供应很好吃的三文鱼<w>波奇饭</w>，配牛油果和米饭。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "poke bowl",
                        "tuna poke",
                        "salmon poke"
                    ],
                    "target_lang_definitions": {
                        "ru": "Гавайское блюдо из нарезанной кубиками сырой рыбы (обычно тунца) с приправами.",
                        "zh": "一种夏威夷菜，通常由切丁生鱼（多为金枪鱼）拌酱油、芝麻油等制成。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поке",
                                "target_lang_sense_clarification": "название блюда"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "波奇饭",
                                "target_lang_sense_clarification": "音译名称，常指这种夏威夷生鱼饭"
                            },
                            {
                                "target_lang_word": "夏威夷生鱼饭",
                                "target_lang_sense_clarification": "对这种菜的较直白叫法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6701aa71-c6cb-38a0-80be-63b6983a65a8",
                    "sense_definition": "A sack or bag; now used almost exclusively in a specific idiom.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Buying a used car without a mechanic's inspection is like buying a pig in a <w>poke</w>.",
                            "target_lang_translations": {
                                "ru": "Покупка подержанной машины без осмотра механика — это как покупка кота в <w>мешке</w>.",
                                "zh": "没让技师检查就买二手车，就像英语里说的“买<w>袋子</w>里的猪”一样。"
                            }
                        },
                        {
                            "text": "He refused to agree to the deal because he didn't want to buy a pig in a <w>poke</w>.",
                            "target_lang_translations": {
                                "ru": "Он отказался соглашаться на сделку, потому что не хотел покупать кота в <w>мешке</w>.",
                                "zh": "他不肯答应这笔交易，因为他不想像“买<w>袋子</w>里的猪”那样稀里糊涂吃亏。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sack",
                        "bag"
                    ],
                    "common_phrases": [
                        "pig in a poke"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "common only in the idiom 'pig in a poke'"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "Southern US or dialectal UK"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мешок; используется почти исключительно в идиоме 'pig in a poke' (кот в мешке).",
                        "zh": "袋子；现在几乎只用于固定习语中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мешок",
                                "target_lang_sense_clarification": "в составе идиомы 'кот в мешке'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "袋子",
                                "target_lang_sense_clarification": "古旧用法，现多只见于习语 pig in a poke"
                            },
                            {
                                "target_lang_word": "布袋",
                                "target_lang_sense_clarification": "古旧说法，指布袋、口袋一类"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c10fb26-c62b-3bb6-ad3c-93ecb514bc8f",
                    "sense_definition": "A lazy person or someone who moves very slowly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hurry up, you slow <w>poke</w>, or we will miss the bus!",
                            "target_lang_translations": {
                                "ru": "Поторапливайся, ты, <w>копуша</w>, иначе мы опоздаем на автобус!",
                                "zh": "快点，你这个<w>磨蹭鬼</w>，不然我们就赶不上公交车了！"
                            }
                        },
                        {
                            "text": "He is such an old <w>poke</w> that it takes him all day to finish a simple task.",
                            "target_lang_translations": {
                                "ru": "Он такой старый <w>тормоз</w>, что у него уходит весь день на простую задачу.",
                                "zh": "他真是个老<w>慢性子</w>，做个简单任务都要花上一整天。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dawdler",
                        "slowcoach",
                        "sluggard"
                    ],
                    "common_phrases": [
                        "slow poke"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        },
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ленивый человек или тот, кто делает всё очень медленно.",
                        "zh": "懒散的人，或动作、做事非常慢的人。"
                    },
                    "translations": {
                        "ru": [
