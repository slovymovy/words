                    },
                    {
                        "form_id": "dd228e33-0196-4b06-be1e-486ef5c2e8d1",
                        "entry_id": "8f6a2a74-fc30-3e64-a403-da62b39bcc13",
                        "tags": [
                            "past"
                        ],
                        "form": "prognosticated"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2c11249b-56e0-3107-8fa0-1f97ac337243",
                        "entry_id": "8f6a2a74-fc30-3e64-a403-da62b39bcc13",
                        "glosses": [
                            "To predict or forecast, especially through the application of skill."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "829dd765-f535-4d15-bf68-593c0f6f0524",
                                "sense_id": "2c11249b-56e0-3107-8fa0-1f97ac337243",
                                "text": "Examining the tea-leaves, she prognosticated dark days ahead."
                            },
                            {
                                "example_id": "7f252f73-0b15-4932-b1ba-52fe9e5647d3",
                                "sense_id": "2c11249b-56e0-3107-8fa0-1f97ac337243",
                                "text": "But from thine eyes my knowledge I derive,\nAnd constant stars in them I read such art\nAs 'Truth and beauty shall together thrive,\nIf from thyself, to store thou wouldst convert';\nOr else of thee this I prognosticate:\n'Thy end is truth's and beauty's doom and date.'"
                            },
                            {
                                "example_id": "e0534c37-446a-428b-95a4-2dbc488a5c71",
                                "sense_id": "2c11249b-56e0-3107-8fa0-1f97ac337243",
                                "text": "...to-morrow I intend lengthening the night till afternoon. I prognosticate for myself an obstinate cold, at least."
                            },
                            {
                                "example_id": "b0b1ae0d-0d91-4e24-9b58-32493838ad69",
                                "sense_id": "2c11249b-56e0-3107-8fa0-1f97ac337243",
                                "text": "All old people and many sick people were drawn, were it only for a foot or two, into the open air, and prognosticated pleasant things about the course of the world."
                            }
                        ]
                    },
                    {
                        "sense_id": "845ed592-b819-327b-8dd5-3dc2731f6fef",
                        "entry_id": "8f6a2a74-fc30-3e64-a403-da62b39bcc13",
                        "glosses": [
                            "To presage, betoken."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6cafe4e4-62d4-4114-b46c-d1f33dd9ff69",
                                "sense_id": "845ed592-b819-327b-8dd5-3dc2731f6fef",
                                "text": "The bluebells may prognosticate an early spring this year."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a292cd8d-0264-4005-b3a7-f0bb5f282c87",
                        "source_entry_id": "8f6a2a74-fc30-3e64-a403-da62b39bcc13",
                        "source_sense_description": "predict, foretell",
                        "target_lang_word": "pronostiquer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pronostiquer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "67bdc0af-d971-339b-93e4-e8fb216da901",
                                        "entry_id": "914efab0-176c-3e5d-bbc6-a89ad639b982",
                                        "glosses": [
                                            "Faire un pronostic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd2b90fb-1b9b-43d3-a6aa-f3792d36c209",
                                                "sense_id": "67bdc0af-d971-339b-93e4-e8fb216da901",
                                                "text": "Une nouvelle grossesse s'étant manifestée, une doctoresse pronostiqua la naissance de deux jumeaux."
                                            },
                                            {
                                                "example_id": "5576ace4-faf1-4102-b75e-0e55610eadd7",
                                                "sense_id": "67bdc0af-d971-339b-93e4-e8fb216da901",
                                                "text": "J’ai rendu hommage à votre perspicacité tout à l’heure et je reconnais encore que vous avez fort bien pronostiqué en nous annonçant que le capitaine Brocq avait une maîtresse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c2574d7-b826-4df4-a48a-a2c9b88a266c",
                        "source_entry_id": "8f6a2a74-fc30-3e64-a403-da62b39bcc13",
