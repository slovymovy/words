                    }
                ],
                "senses": [
                    {
                        "sense_id": "136d90b1-0b33-3eb5-8807-343587a57191",
                        "entry_id": "c3f4ed31-deb0-3a78-a060-84ae287d84cd",
                        "glosses": [
                            "Qui est très riche, qui est dans l’opulence ou qui dénote l’opulence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a5bc466-f321-412f-a3f3-71115f5c8a44",
                                "sense_id": "136d90b1-0b33-3eb5-8807-343587a57191",
                                "text": "Le nom de la première localité rencontrée en entrant par le sud sur cet opulent territoire du Vouzinois sonne mal, avouons-le : Pauvres !"
                            },
                            {
                                "example_id": "f0caad30-7e61-415d-b8f3-f4a20accdd48",
                                "sense_id": "136d90b1-0b33-3eb5-8807-343587a57191",
                                "text": "[…], mais on peut aussi être tout à la fois très riche et très malheureux, car l'argent ne donne ni la santé, ni le contentement de soi-même, et il ne préserve pas de l’ennui, cette plaie des oisifs opulents."
                            }
                        ]
                    },
                    {
                        "sense_id": "206ef4b9-5794-3778-890b-789f06a221f1",
                        "entry_id": "c3f4ed31-deb0-3a78-a060-84ae287d84cd",
                        "glosses": [
                            "Qui est ample, fourni et abondant."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "52255d3b-aebe-444e-8886-25dcb914c2e9",
                                "sense_id": "206ef4b9-5794-3778-890b-789f06a221f1",
                                "text": "Il était deux heures de l'après-midi, Marion, assise devant une haute glace, arrangeait elle-même son opulente chevelure."
                            },
                            {
                                "example_id": "6d092d28-62b6-4cad-a821-c4981d59f064",
                                "sense_id": "206ef4b9-5794-3778-890b-789f06a221f1",
                                "text": "Les papes suivants affecteront en revanche d’être offusqués par tant de poitrines opulentes, tant de zigounettes ainsi impudiquement dévoilées. Clément VIII, Paul III et Paul IV songèrent à détruire la fresque..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86666b91-f377-4682-a68f-d73eca764ddc",
                        "source_entry_id": "c3f4ed31-deb0-3a78-a060-84ae287d84cd",
                        "target_lang_word": "üppig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "üppig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f6b24bbb-6bf6-326f-a3f2-95b745728fec",
                                        "entry_id": "03459e0f-eb40-36f4-815e-096bac204115",
                                        "glosses": [
                                            "in großer Fülle (vorhanden)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa56739e-4d69-435c-894a-2e060b4c9a62",
                                                "sense_id": "f6b24bbb-6bf6-326f-a3f2-95b745728fec",
                                                "text": "Die Gastgeber servierten ein überaus üppiges Mahl."
                                            },
                                            {
                                                "example_id": "3f9d8704-09ba-4695-8830-5333a9d7cb50",
                                                "sense_id": "f6b24bbb-6bf6-326f-a3f2-95b745728fec",
                                                "text": "Die üppige Ausstattung des Films machte ihn fast unbezahlbar in der Herstellung."
                                            },
                                            {
                                                "example_id": "80dc8eb9-f6f1-4a04-8ad0-fd9c6f552f2e",
                                                "sense_id": "f6b24bbb-6bf6-326f-a3f2-95b745728fec",
                                                "text": "Nach Berechnungen des Bundes der Steuerzahler fallen die Steuergeschenke von Schwarz-Gelb weniger üppig aus als nach den Koalitionsverhandlungen verkündet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5dd96c03-0b47-4913-adf1-41425990e2b7",
                        "source_entry_id": "c3f4ed31-deb0-3a78-a060-84ae287d84cd",
                        "target_lang_word": "opulent",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "opulent",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d8717e60-570f-36d2-8d66-779f9411aea9",
                                        "entry_id": "4cbeca2c-01f8-390a-9b1f-adda90ac4a1f",
                                        "glosses": [
                                            "üppig, reichlich; von großer Opulenz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46abe088-49f4-4a74-b242-c2f2026fd6b5",
                                                "sense_id": "d8717e60-570f-36d2-8d66-779f9411aea9",
                                                "text": "Die opulente Ausstattung der Hotelzimmer versetzte die Besucher in Erstaunen."
                                            },
                                            {
                                                "example_id": "e60d91ac-4f5c-4894-b3cf-6d19baf2acbe",
                                                "sense_id": "d8717e60-570f-36d2-8d66-779f9411aea9",
                                                "text": "„Es ist erst knapp vier Wochen her, da kasperte sich TV-Star Jan-Josef Liefers als Freiherr von Münchhausen durch einen opulenten ARD-Zweiteiler - jetzt ist Ben Becker in der Rolle des legendären Lügenbarons zu sehen.“"
                                            },
                                            {
                                                "example_id": "2cb9ed67-2cdf-4847-84be-f3c12d836623",
                                                "sense_id": "d8717e60-570f-36d2-8d66-779f9411aea9",
                                                "text": "„Am nächsten Tag um elf empfing mich ein opulentes Frühstück im Esszimmer der Pension.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f07e748a-1f86-4bf5-8e8e-01dab260bf35",
                        "source_entry_id": "c3f4ed31-deb0-3a78-a060-84ae287d84cd",
                        "target_lang_word": "opulent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "opulent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dfc5ba71-46c5-346d-857d-ec0e43b91908",
                                        "entry_id": "7201f8bb-33b7-3adc-b81b-bb4a00e58bf6",
                                        "glosses": [
                                            "Luxuriant, and ostentatiously magnificent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4fe0fda-f8a3-4ba5-b0b1-19339c99925d",
                                                "sense_id": "dfc5ba71-46c5-346d-857d-ec0e43b91908",
                                                "text": "He saw himself, in a smart suit and a songkok, bowed into the opulent suites of Ritzes and Waldorfs and baring, under dark glasses, a hairy chest to a milder sun by a snakeless sea."
                                            },
                                            {
                                                "example_id": "9b8f450b-d7d3-49a5-814d-2c9ac87c0e7f",
                                                "sense_id": "dfc5ba71-46c5-346d-857d-ec0e43b91908",
                                                "text": "It is a glossy film with gross, opulent opticals and little comic, or any, relief; it has the jaundiced complexion of an early 60s underground film, which it is; it is ponderous, Wagnerian, and feels about five hours long (its running time is about an hour)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e2ce7c1-0db1-3848-acf2-25b7a7ec71ad",
                                        "entry_id": "7201f8bb-33b7-3adc-b81b-bb4a00e58bf6",
                                        "glosses": [
                                            "Rich, sumptuous and extravagant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2063fd85-e66e-4d18-b24c-c231bfa60a25",
                                                "sense_id": "9e2ce7c1-0db1-3848-acf2-25b7a7ec71ad",
                                                "text": "The outdoor setting around the lily ponds in the twin courtyards of the Enid A. Haupt Conservatory is opulent with maples in radiant hues, and a veritable forest of conifers and bamboo with underplantings like bush-clover, silver grass and balloon flowers from the “seven flowers of autumn” cited in early Japanese poems."
                                            },
                                            {
                                                "example_id": "6c854658-a6c1-4d35-ae96-4443b74ee8e9",
                                                "sense_id": "9e2ce7c1-0db1-3848-acf2-25b7a7ec71ad",
                                                "text": "For all England was his fief, held in vassalage to God and to no man alive, his heart now sang; allwhither his empire spread, opulent in grain and metal and every revenue of the earth, and in stalwart men (his chattels), and in strong orderly cities, where the windows would be adorned with scarlet hangings, and women (with golden hair and red lax lips) would presently admire as King Edward rode slowly by at the head of a resplendent retinue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
