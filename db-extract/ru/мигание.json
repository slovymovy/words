                                        "entry_id": "7ff109b9-fa72-3df0-8e12-3f35be3c15aa",
                                        "glosses": [
                                            "A text formatting feature that causes text to disappear and reappear as a form of visual emphasis."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58c6ee4f-712c-4b84-89b6-5abc03704846",
                                                "sense_id": "a70c3004-6ccd-3cdd-86fa-ee9fd2ce2570",
                                                "text": "I can think of no good reason to use blink because blinking text and images are annoying, they mark the creator as an amateur, and they have poor browser support."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "058a6689-2551-3d93-be22-d10435d77d77",
                                        "entry_id": "7ff109b9-fa72-3df0-8e12-3f35be3c15aa",
                                        "glosses": [
                                            "A glimpse or glance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b1d6efe-bed1-45bc-9ead-9e3731327dd1",
                                                "sense_id": "058a6689-2551-3d93-be22-d10435d77d77",
                                                "text": "This is the first blink that ever I had of him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "785abda2-1eaa-3a94-a447-ba63aba739aa",
                                        "entry_id": "7ff109b9-fa72-3df0-8e12-3f35be3c15aa",
                                        "glosses": [
                                            "gleam; glimmer; sparkle"
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "dialectal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cf4b21b-07b5-4292-9a49-314660e0adf8",
                                                "sense_id": "785abda2-1eaa-3a94-a447-ba63aba739aa",
                                                "text": "Not a blink of light was there."
                                            },
                                            {
                                                "example_id": "5cbe3a84-0dc8-4a03-97eb-a859d7ba7d51",
                                                "sense_id": "785abda2-1eaa-3a94-a447-ba63aba739aa",
                                                "text": "this man vanished away […]as he had been a blink of the sun"
                                            }
                                        ]
                                    },
