                                        "glosses": [
                                            "geen samenhangend geheel vormen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5c67e99-c708-432c-9c98-4b02138b8322",
                                                "sense_id": "94caaf96-ba03-37c9-9f97-f4261addc7b4",
                                                "text": "Dit zijn volledig onsamenhangend samenvattingen."
                                            },
                                            {
                                                "example_id": "88424f25-a668-4e82-a658-81fb4aad1c83",
                                                "sense_id": "94caaf96-ba03-37c9-9f97-f4261addc7b4",
                                                "text": "Hoewel alles wat ik zag hier al eeuwen stond, maakte het een breekbare indruk op mij, als een mirage gebouwd op zee die bij de geringste rimpeling van het water gefragmenteerd zou raken tot onsamenhangende herinneringen op miljoenen foto's."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "onsamenhangend",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "77bfdad7-c62c-33eb-b832-a98db006cb00",
                                        "entry_id": "12ff3397-5f13-3ec9-9d60-74e3ac4d8b5c",
                                        "glosses": [
                                            "op een niet samenhangende manier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a148ee4-4bff-415b-83ce-3fac2274fe22",
                                                "sense_id": "77bfdad7-c62c-33eb-b832-a98db006cb00",
                                                "text": "Hij sprak nogal onsamenhangend."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc8a59c6-f39c-4c25-bfbe-500ac67a634c",
                        "source_entry_id": "20d94602-6b9b-311b-a31b-ac1470662324",
