                                ]
                            },
                            {
                                "target_word": "discordant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c19bf674-34ee-37bb-99ba-df0e1e2841ef",
                                        "entry_id": "5565fd72-645f-3453-9656-b72f59df9e49",
                                        "glosses": [
                                            "A thing which is not in accord or harmony with one or more other things."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32e49080-c34f-4f60-ba89-112527b120b9",
                                                "sense_id": "c19bf674-34ee-37bb-99ba-df0e1e2841ef",
                                                "text": "In the process of dismemberment it must often happen that the true individuality of a soil is lost, so that schemes of laboratory classification sometimes arbitrarily separate agricultural similars and unite agricultural discordants."
                                            }
