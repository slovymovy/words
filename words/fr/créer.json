                        "créer un compte",
                        "créer un site"
                    ]
                },
                {
                    "sense_id": "45852cc7-bd47-3495-8cc0-60d4c11757c2",
                    "sense_definition": "Imaginer, inventer ou concevoir par l'esprit ou par l'art.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "intellect",
                    "name_type": "no",
                    "examples": [
