                    {
                        "sense_id": "ac26bee0-34b8-3246-b267-8f897e2cc1c2",
                        "entry_id": "05045bdb-8855-3def-bb0e-a2cec8a0814b",
                        "glosses": [
                            "weg via welke zaken of personen naar een bepaalde plaats worden gebracht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c97ae39-eff3-4b46-bdd4-372c1478b0fc",
                                "sense_id": "ac26bee0-34b8-3246-b267-8f897e2cc1c2",
                                "text": "Op Saba is door Defensie een nieuwe watervoorraad geleverd. De verwachting is dat de drinkwaterfabriek binnen enkele dagen weer werkt. Nieuwe aanvoerroutes worden gezocht voor het aanleveren van voedsel. Het ziekenhuis beschikt over reguliere medicijnen."
                            },
                            {
                                "example_id": "5e60dc58-fbff-4f33-b4fc-51f2b3103b7a",
                                "sense_id": "ac26bee0-34b8-3246-b267-8f897e2cc1c2",
                                "text": "Het Syrisch regeringsleger heeft de laatste aanvoerroute van terreurorganisatie Islamitische Staat naar de stad al-Bab maandag afgesloten. Het grootste IS-bolwerk in de provincie Aleppo is nu geheel omsingeld."
                            },
                            {
                                "example_id": "799974ff-e65a-4134-967e-67f1382ad930",
                                "sense_id": "ac26bee0-34b8-3246-b267-8f897e2cc1c2",
                                "text": "'Misschien is de zee van nu af aan wel de enige aanvoerroute voor voedsel. Maar ik snap niet hoe ze dat met al die kapotte bruggen de stad in denken te krijgen.'"
                            }
                        ]
                    }
