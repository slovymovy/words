                    "frequency": "Middle",
                    "semantic_group_id": "financieel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na alle onkosten hielden we een <w>zuivere</w> winst van duizend euro over.",
                            "target_lang_translations": {
                                "en": "After all expenses, we were left with a <w>net</w> profit of a thousand euros.",
                                "ru": "После всех расходов у нас осталась <w>чистая</w> прибыль в тысячу евро."
                            }
