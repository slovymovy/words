                    {
                        "sense_id": "85499f7b-6ecb-3696-8fa0-c804a68f3527",
                        "entry_id": "87436018-1716-3cee-a226-fdd849573bc6",
                        "glosses": [
                            "in een tint groen met RAL-nummer 6005 ( )."
                        ],
                        "tags": [
                            "RAL-kleur"
                        ],
                        "examples": [
                            {
                                "example_id": "b6f15697-6552-4c76-b750-5cd6a5afebb1",
                                "sense_id": "85499f7b-6ecb-3696-8fa0-c804a68f3527",
                                "text": "De zijkant was een egaal mosgroen vlak."
                            },
                            {
                                "example_id": "9f12b3e2-cdfb-4c22-afdc-81bbbdbc05eb",
                                "sense_id": "85499f7b-6ecb-3696-8fa0-c804a68f3527",
                                "text": "Hij rijdt in een mosgroene auto."
                            },
                            {
                                "example_id": "62becd76-9130-457d-9fd9-9293440e3fcc",
                                "sense_id": "85499f7b-6ecb-3696-8fa0-c804a68f3527",
                                "text": "Ondertussen was de herfst in Washington overal zichtbaar om me heen en op de heuvels zag je een lappendeken aan kleuren: rode herfstbladeren, weelderige okergele weiden, mosgroene bossen, turquoise meren en verse witte bergpieken."
                            }
                        ]
                    }
                ],
