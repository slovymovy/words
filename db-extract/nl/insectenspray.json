                        "glosses": [
                            "insecten dodende vloeistof die men gebruikt door ze te verstuiven tot een nevel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1d1aaca-1f4f-4053-844c-a8278663c3d3",
                                "sense_id": "369e2a37-082b-3a9e-a02e-7a10a9ea0cab",
                                "text": "De mensen hebben alles gedaan wat binnen hun macht lag om ze uit te roeien: ieder soort vergif, spuitbussen, het invoeren en kweken van natuurlijke vijanden, het opzoeken en vernietigen van hun eitjes, genetische modificatie gebruiken om ze te steriliseren, verbranden met vuur, verdrinken in water, elk gezin heeft insectenspray, onder ieder bureau ligt een vliegenmepper."
                            },
                            {
                                "example_id": "bbcdad16-6a6c-4b4d-9ad0-0b3447b72a7f",
                                "sense_id": "369e2a37-082b-3a9e-a02e-7a10a9ea0cab",
                                "text": "Kijk uit met wespenvallen. De zoetigheid in zo'n val kan juist méér wespen aantrekken. Insectenspray werkt wel."
                            }
                        ]
                    }
