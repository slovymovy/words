                    "sense_id": "bd959d40-185a-3d54-9b11-bfd7cd205aff",
                    "sense_definition": "Taki, który ma cechy ideału, jest doskonały i pozbawiony wszelkich wad.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "perfection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nikt z nas nie jest <w>idealny</w>, dlatego powinniśmy wybaczać sobie drobne błędy.",
                            "target_lang_translations": {
                                "ru": "Никто из нас не <w>идеален</w>, поэтому нам следует прощать себе мелкие ошибки.",
                                "de": "Niemand von uns ist <w>ideal</w>, deshalb sollten wir uns gegenseitig kleine Fehler verzeihen."
                            }
                        },
                        {
                            "text": "Samochód, który kupiliśmy, jest w <w>idealnym</w> stanie technicznym i wizualnym.",
                            "target_lang_translations": {
                                "ru": "Автомобиль, который мы купили, находится в <w>идеальном</w> техническом и внешнем состоянии.",
                                "de": "Das Auto, das wir gekauft haben, ist in einem <w>idealen</w> technischen und optischen Zustand."
                            }
                        }
                    ],
                    "synonyms": [
                        "doskonały",
                        "perfekcyjny",
                        "nienaganny"
                    ],
                    "antonyms": [
                        "niedoskonały",
                        "wadliwy"
                    ],
                    "common_phrases": [
                        "nikt nie jest idealny",
                        "w idealnym stanie",
                        "idealny porządek"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий качествами идеала, совершенный и лишенный каких-либо недостатков.",
                        "de": "Etwas, das den Eigenschaften eines Ideals entspricht, vollkommen ist und keinerlei Mängel aufweist."
                    },
                    "translations": {
