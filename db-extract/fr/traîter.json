                "senses": [
                    {
                        "sense_id": "ee6193eb-513a-3ab1-a17f-37735afed697",
                        "entry_id": "414676c9-7deb-3410-8444-62d9a470af07",
                        "glosses": [
                            "Variante orthographique de traiter."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "684ec55d-dd51-4466-8e0f-9eaadbf958e4",
                                "sense_id": "ee6193eb-513a-3ab1-a17f-37735afed697",
                                "text": "Il y excitait le gouvernement à enlever aux gens de de^([sic]) couleur et aux noirs leurs propriétés, attendu qu'ils n'étaient pas des hommes ; à les traîter comme des bêtes de somme et à ne les épargner qu'autant qu'ils se rendraient utiles par le service de leurs bras."
                            },
                            {
                                "example_id": "f10707a5-d490-4b65-92e6-c8b6bb420554",
                                "sense_id": "ee6193eb-513a-3ab1-a17f-37735afed697",
                                "text": "Une embarcation dotée d'un faucardeur et d'un moissonneur sillonne la portion à traîter."
                            },
                            {
                                "example_id": "fc3615fc-293e-484d-ab05-a792f7090db8",
                                "sense_id": "ee6193eb-513a-3ab1-a17f-37735afed697",
                                "text": "\"Il m'a envoyé un message pour me traîter d'âne\", a révélé Carragher."
                            }
                        ]
                    }
