                "senses": [
                    {
                        "sense_id": "cb87f641-f37e-36b1-9060-b57d78374b44",
                        "entry_id": "7c9d91e7-0f5b-3033-b0bd-db24969d2f8e",
                        "glosses": [
                            "aus Messing hergestellter Draht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25a8d56f-a606-4b80-a1a4-0eea868c114c",
                                "sense_id": "cb87f641-f37e-36b1-9060-b57d78374b44",
                                "text": "„Nach Abschluss ihres Studiums experimentiert sie aufgrund der hohen Silberpreise mit Messingdraht, Holz, Rohrstock und anderen alternativen Werkstoffen, als Werkzeuge reichen ihr Bunsenbrenner, Polierstahl und Silberdraht.“"
                            },
                            {
                                "example_id": "5a77c9d3-9130-4eed-b927-fb2905d090d3",
                                "sense_id": "cb87f641-f37e-36b1-9060-b57d78374b44",
                                "text": "„Wir betraten ein Zimmer mit vergitterten Schränken; hinter diesen Gittern aus geflochtenem Messingdraht sah man Vorhänge, und hinter den Vorhängen mußten sich die Bücher befinden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
