                    "frequency": "High",
                    "semantic_group_id": "lichaamsdelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik had pijn van de kramp in mijn <w>dijen</w> en onder in mijn rug.",
                            "target_lang_translations": {
                                "en": "I had pain from the cramp in my <w>thighs</w> and lower back.",
                                "ru": "У меня была боль от судорог в <w>бёдрах</w> и в нижней части спины."
                            }
                        },
                        {
                            "text": "De sporter heeft zeer gespierde <w>dijen</w> door het vele fietsen.",
                            "target_lang_translations": {
