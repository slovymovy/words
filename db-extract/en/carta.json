            {
                "entry_id": "96db5938-82a0-30f1-8a9e-cc2c7023b488",
                "word": "Carta",
                "pos": "name",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a91b1edf-2220-473a-9b01-d85586ee31e0",
                        "entry_id": "96db5938-82a0-30f1-8a9e-cc2c7023b488",
