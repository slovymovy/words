                "senses": [
                    {
                        "sense_id": "a20ed2ec-579e-323f-842d-a3d5ca1ca8e1",
                        "entry_id": "d9984f8c-d2fa-3b57-802b-395cdb4f8f98",
                        "glosses": [
                            "für Pferdehintern"
                        ],
                        "tags": [
                            "grob"
                        ],
                        "examples": [
                            {
                                "example_id": "46349de7-d0b0-462c-b550-30d7e4146ee7",
                                "sense_id": "a20ed2ec-579e-323f-842d-a3d5ca1ca8e1",
                                "text": "„Der Tunnel ist ein wenig breiter als die Eisenbahnspur, die, wie Sie jetzt wissen – so breit ist wie zwei Pferdeärsche.“"
                            },
                            {
                                "example_id": "1ca60106-04e5-416b-bf1d-efe99fda886d",
                                "sense_id": "a20ed2ec-579e-323f-842d-a3d5ca1ca8e1",
                                "text": "„Wenn Ihnen jetzt beim nächsten Mal ein Maß ausgehändigt wird und Sie sich wundern, welcher Pferdearsch sich das ausgedacht hat, dann liegen Sie genau richtig, denn die antiken Streitwagen wurden in der angegebenen Breite hergestellt, damit zwei Pferdehintern davor passten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5453efe6-172a-3f3d-afe5-15f6a25ee419",
                        "entry_id": "d9984f8c-d2fa-3b57-802b-395cdb4f8f98",
                        "glosses": [
                            "dicker Hintern oder Mensch mit dickem Hintern"
                        ],
