                "senses": [
                    {
                        "sense_id": "457adb99-d467-31ab-8bb5-e7413a96bec7",
                        "entry_id": "60394fbd-7120-3769-a355-7c4766877690",
                        "glosses": [
                            "rechtmäßige, aus einer oder mehreren Privat-Willenserklärungen bestehende Rechtshandlung, gerichtet auf Rechtswirkung, die willensgemäß eintritt"
                        ],
                        "tags": [
                            "Rechtswissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "d86d3d43-f3d5-45b4-af32-dd27c66f7561",
                                "sense_id": "457adb99-d467-31ab-8bb5-e7413a96bec7",
                                "text": "Anders verhält es sich bei einem Rechtsgeschäft, das ein Ehegatte in Vertretung der ehelichen Gemeinschaft für die laufenden Bedürfnisse der Familie abschliesst."
                            },
                            {
                                "example_id": "bc1302b6-bd67-4a0c-a749-c7a5bc09490e",
                                "sense_id": "457adb99-d467-31ab-8bb5-e7413a96bec7",
                                "text": "Die Auslobung, mit der wir es hier zu tun haben, ist ein einseitiges Rechtsgeschäft."
                            },
                            {
                                "example_id": "0d4b6a9f-9880-4538-982e-692aa1e0a9c9",
                                "sense_id": "457adb99-d467-31ab-8bb5-e7413a96bec7",
                                "text": "„Odin hat inzwischen vom Gericht eine zunächst zeitlich begrenzte Generalvollmacht erhalten, die ihn ermächtigt, sämtliche den Hof betreffenden Rechtsgeschäfte zu tätigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
