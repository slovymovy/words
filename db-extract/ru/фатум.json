                                        "entry_id": "8372a8e4-2cc1-3f64-b119-5790d6f626df",
                                        "glosses": [
                                            "The products of a chemical reaction in their final form in the biosphere."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
