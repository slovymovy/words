                },
                {
                    "sense_id": "8ace3e25-c6a9-3e05-bc6f-2214e73e7357",
                    "sense_definition": "A road network in Montreal, Quebec, Canada for bicycles.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Cyclists in Montreal use the <w>REV</w> to commute safely across the city.",
                            "target_lang_translations": {
                                "ru": "Велосипедисты в Монреале используют <w>сеть велодорожек REV</w> для безопасного передвижения по городу.",
                                "pl": "Rowerzyści w Montrealu korzystają z <w>sieci REV</w>, aby bezpiecznie przemieszczać się przez miasto."
                            }
                        },
                        {
                            "text": "The new section of the <w>REV</w> will open next month.",
                            "target_lang_translations": {
                                "ru": "Новый участок <w>сети велодорожек REV</w> откроется в следующем месяце.",
                                "pl": "Nowy odcinek <w>sieci REV</w> zostanie otwarty w przyszłym miesiącu."
                            }
                        }
