                        "glosses": [
                            "Pflanze, die in Trockenwüsten endemisch ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4d33b18-7f14-4f12-a937-6dd00c735060",
                                "sense_id": "caa25e60-8a03-3f1f-910b-af8bd704df56",
                                "text": "„Die meisten Pflanzen benutzen ihre Wurzeln, um sich mit Wasser zu versorgen. Nicht so das Moos Syntrichia caninervis. Die Wüstenpflanze sammelt Feuchtigkeit aus der Luft und zwar mithilfe feiner, maximal zwei Millimeter langen [sic!] Härchen an der Spitze ihrer Blätter.“"
                            }
                        ],
