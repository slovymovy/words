                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "87001f72-6f5e-3a91-9782-a221d55bc60e",
                        "entry_id": "d3efd684-6337-3373-a945-a0b4f550d744",
                        "glosses": [
                            "Of or relating to anatomy or dissection."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "d49a3cea-0600-40c3-9543-f19467f9c4ef",
                                "sense_id": "87001f72-6f5e-3a91-9782-a221d55bc60e",
                                "text": "The two species have some anatomical similarities."
                            },
                            {
                                "example_id": "f4329a19-bff4-4a8e-bcfa-e532c5ace432",
                                "sense_id": "87001f72-6f5e-3a91-9782-a221d55bc60e",
                                "text": "So he clung to the sides of the vertical tunnel, le wormhole, employing the setules covering his legs, that is, millions of tiny spider-hairs with triangular tips, a wall-creeper physiology if you wish, a hang-upside-down-from-the-ceiling anatomical boon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9353d880-58dd-41cd-ad64-f6b10bff951f",
                        "source_entry_id": "d3efd684-6337-3373-a945-a0b4f550d744",
                        "source_sense_id": "87001f72-6f5e-3a91-9782-a221d55bc60e",
                        "source_sense_description": "Of or relating to anatomy or dissection",
                        "target_lang_word": "anatomický",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anatomický",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "a20eabca-d4a3-3c74-b993-dd21ccd9a2ad",
                                        "entry_id": "fac6c008-7b7a-334c-9327-a14dcd3a5140",
                                        "glosses": [
                                            "vztahující se k anatomii"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19c3673a-0fb0-4f95-9e52-c88aa6383939",
                                                "sense_id": "a20eabca-d4a3-3c74-b993-dd21ccd9a2ad",
                                                "text": "Každá žena je krásná, bujně rostlá a vášnivá. Chcete-li víc, tož je blondýna nebo brunetka; ale na tom už mnoho nezáleží, a sám autor si občas splete její černé kštice nebo plavé kadeře. Není tenká ani tlustá; její tělo je univerzální jako anatomický model."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a2451ae-a587-41bf-b7fe-808c2c9ae94b",
                        "source_entry_id": "d3efd684-6337-3373-a945-a0b4f550d744",
                        "source_sense_id": "87001f72-6f5e-3a91-9782-a221d55bc60e",
                        "source_sense_description": "Of or relating to anatomy or dissection",
                        "target_lang_word": "anatomisch",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anatomisch",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f1e7c897-62ee-3c2e-8683-cb741cbdc8fc",
                                        "entry_id": "7e12d7ec-2439-30fe-b19c-61616a2f80bd",
                                        "glosses": [
                                            "met betrekking tot de anatomie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dffd9cf1-e7ff-4300-8509-d362aca6b2f1",
                                                "sense_id": "f1e7c897-62ee-3c2e-8683-cb741cbdc8fc",
                                                "text": "Wat vind je ervan?' De kwaliteit van de anatomische tekening was uitmuntend."
                                            },
                                            {
                                                "example_id": "cc1ce913-54af-4a70-9a1e-183b435fc3b4",
                                                "sense_id": "f1e7c897-62ee-3c2e-8683-cb741cbdc8fc",
                                                "text": "' 'Waarom denkt u dat hij Buffalo Bill is?' 'Hij vermoordde toen ook al mensen en deed, anatomisch gezien, gelijksoortige dingen met ze."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d698d54c-0b4c-4540-8c7d-aa6e57ef6175",
                        "source_entry_id": "d3efd684-6337-3373-a945-a0b4f550d744",
                        "source_sense_id": "87001f72-6f5e-3a91-9782-a221d55bc60e",
