                            "passive"
                        ],
                        "examples": [
                            {
                                "example_id": "213b16dd-4acb-440e-a1d5-c3573ca96906",
                                "sense_id": "8bff481c-962a-3c3e-a40e-0b9d9c6df73a",
                                "text": "Из них получают сахаристую жидкость ― сусло, которое затем варится с добавлением ароматного хмеля и сбраживается с помощью дрожжей."
                            }
                        ]
                    }
