                                    },
                                    {
                                        "sense_id": "0ab80cfe-5375-3661-b9aa-b251e832d4af",
                                        "entry_id": "77581377-fb67-39d6-a369-27a834bfca1b",
                                        "glosses": [
                                            "Of animals: to develop quantities of tallow."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4df69348-2d8a-427a-92bc-fcfeefff62ba",
                                                "sense_id": "0ab80cfe-5375-3661-b9aa-b251e832d4af",
                                                "text": "[…] their beef is finer than that of the old short-horned breed, and they fatten much earlier and quicker, conveying still a vast depth of natural flesh, and tallowing within in the first degree."
                                            }
