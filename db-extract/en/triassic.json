                "entry_id": "f4b2aaaa-ebfa-3887-a8f4-260f3129d82e",
                "word": "Triassic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "37359a6e-dfd8-3711-b751-c0f330c477cb",
                        "entry_id": "f4b2aaaa-ebfa-3887-a8f4-260f3129d82e",
                        "glosses": [
                            "Of or from the geologic strata above the Permian and below the Jurassic; of or belonging to the period 250 to 200 million years ago when these strata were laid down."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "7428e899-698e-403e-b7a7-8eef7768d1d1",
                                "sense_id": "37359a6e-dfd8-3711-b751-c0f330c477cb",
                                "text": "“Well,” Ellie said. “We know animals have survived. Crocodiles are basically Triassic animals living in the present. Sharks are Triassic. So we know it has happened before.”"
                            }
                        ]
                    }
                ],
