{
    "word_family": [
        "scarred",
        "scarring"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c600f45e-05e7-3fbc-b77d-ebe0a67f6d96",
                    "sense_definition": "A permanent mark on the skin, sometimes caused by the healing of a wound.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mark",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The accident left a small <w>scar</w> on his forehead.",
                            "target_lang_translations": {
                                "ru": "После аварии у него на лбу остался маленький <w>шрам</w>.",
                                "zh": "那场事故在他的额头上留下了一道小<w>疤痕</w>。"
                            }
                        },
                        {
                            "text": "She has a <w>scar</w> on her knee from falling off her bike.",
                            "target_lang_translations": {
                                "ru": "У нее на колене <w>шрам</w> от падения с велосипеда.",
                                "zh": "她的膝盖上有一处<w>伤疤</w>，是骑自行车摔倒后留下的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cicatrix",
                        "mark",
                        "blemish"
                    ],
                    "common_phrases": [
                        "facial scar",
                        "deep scar",
                        "jagged scar",
                        "old scar"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постоянный след на коже, часто остающийся после заживления раны.",
                        "zh": "永久留在皮肤上的痕迹，通常是伤口愈合后形成的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шрам",
                                "target_lang_sense_clarification": "след от раны"
                            },
                            {
                                "target_lang_word": "рубец",
                                "target_lang_sense_clarification": "медицинский термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "疤痕",
                                "target_lang_sense_clarification": "普通说法，指皮肤上留下的痕迹"
                            },
                            {
                                "target_lang_word": "伤疤",
                                "target_lang_sense_clarification": "口语中常用"
                            },
                            {
                                "target_lang_word": "瘢痕",
                                "target_lang_sense_clarification": "医学或较正式用语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af660199-463c-3e1d-89b7-a52ae0f9238c",
                    "sense_definition": "A permanent negative effect on someone's mind, caused by a traumatic experience.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mark",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The war left a deep emotional <w>scar</w> on the soldiers who returned home.",
                            "target_lang_translations": {
                                "ru": "Война оставила глубокий душевный <w>шрам</w> у солдат, вернувшихся домой.",
                                "zh": "战争给那些回到家的士兵留下了很深的情感<w>创伤</w>。"
                            }
                        },
                        {
                            "text": "It takes a long time to heal the <w>scars</w> of a difficult childhood.",
                            "target_lang_translations": {
                                "ru": "Требуется много времени, чтобы залечить <w>шрамы</w> тяжелого детства.",
                                "zh": "艰难童年留下的<w>创伤</w>，往往需要很长时间才能抚平。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "emotional scar",
                        "mental scar",
                        "psychological scar",
                        "battle scars"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постоянное негативное влияние на психику, вызванное травмирующим опытом.",
                        "zh": "由创伤性经历造成的、长期留在心理上的负面影响。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шрам",
                                "target_lang_sense_clarification": "переносное значение, душевный след"
                            },
                            {
                                "target_lang_word": "травма",
                                "target_lang_sense_clarification": "психологическая"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "创伤",
                                "target_lang_sense_clarification": "指心理或情感上长期留下的伤害"
                            },
                            {
                                "target_lang_word": "心灵创伤",
                                "target_lang_sense_clarification": "更强调内心受到的长期影响"
                            },
                            {
                                "target_lang_word": "心理创伤",
                                "target_lang_sense_clarification": "较正式说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dab558b6-cb9f-30af-901e-8bf67c9f6119",
                    "sense_definition": "Any permanent mark resulting from damage to an object or landscape.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mark",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The forest fire left a black <w>scar</w> on the side of the mountain.",
                            "target_lang_translations": {
                                "ru": "Лесной пожар оставил черный <w>шрам</w> на склоне горы.",
                                "zh": "森林大火在山坡上留下了一道黑色的<w>伤痕</w>。"
                            }
                        },
                        {
                            "text": "The construction project is a <w>scar</w> on the beautiful valley.",
                            "target_lang_translations": {
                                "ru": "Этот строительный проект — <w>шрам</w> на теле прекрасной долины.",
                                "zh": "这个建设项目是这座美丽山谷上的一道<w>伤痕</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "scar on the landscape"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любой постоянный след, возникший в результате повреждения предмета или ландшафта.",
                        "zh": "物体或地貌因受损而留下的永久性痕迹。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шрам",
                                "target_lang_sense_clarification": "переносное значение, след на местности"
                            },
                            {
                                "target_lang_word": "след",
                                "target_lang_sense_clarification": "отметка, повреждение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "伤痕",
                                "target_lang_sense_clarification": "比喻因破坏而留下的明显痕迹"
                            },
                            {
                                "target_lang_word": "痕迹",
                                "target_lang_sense_clarification": "较中性，可指物体或景观上的痕迹"
                            },
                            {
                                "target_lang_word": "创痕",
                                "target_lang_sense_clarification": "较书面，常用于景观或环境"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "907faa8b-0155-3e3c-818f-1ee9ea18aeab",
                    "sense_definition": "A cliff or rock outcrop.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We climbed up the steep rocky <w>scar</w> to get a better view.",
                            "target_lang_translations": {
                                "ru": "Мы вскарабкались на крутой каменистый <w>утес</w>, чтобы лучше осмотреться.",
                                "zh": "为了看得更远，我们爬上了那面陡峭多岩的<w>岩壁</w>。"
                            }
                        },
                        {
                            "text": "The limestone <w>scar</w> stood out clearly against the green hills.",
                            "target_lang_translations": {
                                "ru": "Известняковая <w>скала</w> отчетливо выделялась на фоне зеленых холмов.",
                                "zh": "那片石灰岩<w>崖壁</w>在绿色山丘的映衬下格外显眼。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Northern England"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Утес или скалистый выступ.",
                        "zh": "悬崖或突出的岩石壁面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утес",
                                "target_lang_sense_clarification": "скалистый обрыв"
                            },
                            {
                                "target_lang_word": "скала",
                                "target_lang_sense_clarification": "каменная глыба"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "岩壁",
                                "target_lang_sense_clarification": "陡峭的岩石壁面"
                            },
                            {
                                "target_lang_word": "崖壁",
                                "target_lang_sense_clarification": "突出的岩石陡坡或崖面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "326ea741-fbb2-3032-a5b6-1e618daba402",
                    "sense_definition": "A marine food fish, the scarus or parrotfish.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The diver spotted a colorful <w>scar</w> swimming near the coral reef.",
                            "target_lang_translations": {
                                "ru": "Дайвер заметил пеструю <w>рыбу-попугая</w>, плавающую возле кораллового рифа.",
                                "zh": "潜水员发现一条色彩斑斓的<w>鹦嘴鱼</w>在珊瑚礁附近游动。"
                            }
                        },
                        {
                            "text": "We ordered a grilled <w>scar</w> at the seafood restaurant.",
                            "target_lang_translations": {
                                "ru": "Мы заказали жареного <w>скара</w> в рыбном ресторане.",
                                "zh": "我们在海鲜餐馆点了一份烤<w>鹦嘴鱼</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Морская промысловая рыба, скар или рыба-попугай.",
                        "zh": "一种海洋食用鱼，即鹦嘴鱼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рыба-попугай",
                                "target_lang_sense_clarification": "вид рыбы"
                            },
                            {
                                "target_lang_word": "скар",
                                "target_lang_sense_clarification": "научное название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鹦嘴鱼",
                                "target_lang_sense_clarification": "最常见的名称，指 parrotfish"
                            },
                            {
                                "target_lang_word": "鹦鹉鱼",
                                "target_lang_sense_clarification": "别称，较少见"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e448a4bb-f64a-3e20-afb7-d6483b83290f",
                    "sense_definition": "To mark the skin permanently.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mark",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The severe burn <w>scarred</w> his arm for the rest of his life.",
                            "target_lang_translations": {
                                "ru": "Сильный ожог <w>оставил шрам</w> на его руке на всю жизнь.",
                                "zh": "严重的烧伤让他的手臂一辈子都<w>留下疤痕</w>。"
                            }
                        },
                        {
                            "text": "He was <w>scarred</w> in a fight when he was a teenager.",
                            "target_lang_translations": {
                                "ru": "Он <w>получил шрам</w> в драке, когда был подростком.",
                                "zh": "他十几岁打架后，脸上<w>留下疤痕</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "scarred for life",
                        "badly scarred"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оставлять постоянный след или шрам на коже.",
                        "zh": "使皮肤永久留下疤痕。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оставлять шрам",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "уродовать",
                                "target_lang_sense_clarification": "портить внешность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "留下疤痕",
                                "target_lang_sense_clarification": "使皮肤形成永久性的疤"
                            },
                            {
                                "target_lang_word": "留疤",
                                "target_lang_sense_clarification": "较口语，指伤后形成疤"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e031f9c0-02df-3dd2-8ee7-42afec110244",
                    "sense_definition": "To affect deeply in a traumatic manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mark",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The terrifying accident <w>scarred</w> him emotionally for many years.",
                            "target_lang_translations": {
                                "ru": "Страшная авария <w>травмировала</w> его душевно на долгие годы.",
                                "zh": "那场可怕的事故给他多年都<w>留下心理创伤</w>。"
                            }
                        },
                        {
                            "text": "She was <w>scarred</w> by the sudden loss of her parents.",
                            "target_lang_translations": {
                                "ru": "Внезапная потеря родителей <w>оставила глубокий след</w> в ее душе.",
                                "zh": "父母的突然离世让她<w>深受创伤</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "emotionally scarred",
                        "scarred by the experience"
                    ],
                    "target_lang_definitions": {
                        "ru": "Глубоко травмировать, наносить душевную рану.",
                        "zh": "以创伤性的方式对人造成深刻而长期的心理影响。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "травмировать",
                                "target_lang_sense_clarification": "наносить психологический вред"
                            },
                            {
                                "target_lang_word": "оставлять след",
                                "target_lang_sense_clarification": "в душе или памяти"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "留下心理创伤",
                                "target_lang_sense_clarification": "强调造成长期的心理伤害"
                            },
                            {
                                "target_lang_word": "深受创伤",
                                "target_lang_sense_clarification": "强调内心受到严重打击"
                            },
                            {
                                "target_lang_word": "使心灵受创",
                                "target_lang_sense_clarification": "较书面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a3cf06b-5d62-3512-b21f-8d3debba543d",
                    "sense_definition": "To form a scar or leave a mark on a surface.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mark",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Decades of mining have <w>scarred</w> the beautiful green landscape.",
                            "target_lang_translations": {
                                "ru": "Десятилетия горных работ <w>изуродовали</w> прекрасный зеленый ландшафт.",
                                "zh": "数十年的采矿已经<w>破坏了</w>这片美丽的绿色景观。"
                            }
                        },
                        {
                            "text": "The wooden table was <w>scarred</w> by deep scratches and burns.",
                            "target_lang_translations": {
                                "ru": "Деревянный стол был <w>испорчен</w> глубокими царапинами и ожогами.",
                                "zh": "深深的划痕和烧痕<w>损伤了</w>这张木桌的表面。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оставлять следы или повреждения на поверхности.",
                        "zh": "在表面形成疤状痕迹，或留下明显的损伤。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уродовать",
                                "target_lang_sense_clarification": "портить вид местности или предмета"
                            },
                            {
                                "target_lang_word": "портить",
                                "target_lang_sense_clarification": "наносить повреждения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "破坏",
                                "target_lang_sense_clarification": "使表面或景观受损，留下明显痕迹"
                            },
                            {
                                "target_lang_word": "损伤",
                                "target_lang_sense_clarification": "较具体地指表面受到损害"
                            },
                            {
                                "target_lang_word": "留下伤痕",
                                "target_lang_sense_clarification": "强调留下难看的损毁痕迹"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}