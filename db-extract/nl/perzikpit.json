                "senses": [
                    {
                        "sense_id": "590c79e8-9c6f-306d-8065-ceaebde2dec8",
                        "entry_id": "f0993725-c6e0-3883-bcda-65da4cdc4dfe",
                        "glosses": [
                            "het stenige deel van een perzik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c8044c3-a3f5-4f52-8441-fa3574d91eae",
                                "sense_id": "590c79e8-9c6f-306d-8065-ceaebde2dec8",
                                "text": "De rotte vruchten van het verleden begraaft hij symbolisch door een perzikpit in de grond te duwen. Tegelijk een bron van nieuw leven! Dit indrukwekkende verhaal is het meest uitgebreid. Verboom moet alleen oppassen niet te veel loodzware ernst in zijn verhalen te stoppen."
                            },
                            {
                                "example_id": "ff6562bd-1081-4f0d-a28d-1672421569b6",
                                "sense_id": "590c79e8-9c6f-306d-8065-ceaebde2dec8",
                                "text": "Chinese archeologen en een Canadese antropoloog hebben nu in de vallei van de benedenrivier van de Yangtze, niet ver van Sjanghai, perzikpitten van ten minste 7.500 jaar oud gevonden."
                            },
                            {
                                "example_id": "00134ddc-eeca-414c-83bd-20d001abb6df",
                                "sense_id": "590c79e8-9c6f-306d-8065-ceaebde2dec8",
                                "text": "De plastic deeltjes of microbeads kunnen vervangen worden door afbreekbare producten zoals kersenpitten of perzikpitten."
                            }
                        ]
                    }
                ],
