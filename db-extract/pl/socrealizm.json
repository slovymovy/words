                        "entry_id": "e0767591-8aa1-3d47-ae29-d00df79d5044",
                        "glosses": [
                            "kierunek w sztuce zapoczątkowany w ZSRR w 1934 r., głoszący zaangażowanie polityczne i ideowe, nawiązujący do filozofii marksistowskiej"
                        ],
                        "tags": [],
                        "examples": [
                            {
