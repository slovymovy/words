                "senses": [
                    {
                        "sense_id": "ce25c090-ce3f-3e58-b1d7-f22a8bedb2ce",
                        "entry_id": "bb077fce-0f94-3ac1-a59c-2818f4ec17d1",
                        "glosses": [
                            "To bind or encircle with lace, or as with lace"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c0065988-6933-41fd-9557-05379fe397ff",
                                "sense_id": "ce25c090-ce3f-3e58-b1d7-f22a8bedb2ce",
                                "text": "But yet I may ſay ſafely, so many wel lettred\nEmbraudred, enlaſid together, and fettred,\nAnd ſo little learning, ſo lewdly alowed,\nWhat fault find ye herein but may be avowed?"
                            }
                        ]
                    },
                    {
                        "sense_id": "d93e8b50-eead-3e93-a001-02cc7ae59652",
                        "entry_id": "bb077fce-0f94-3ac1-a59c-2818f4ec17d1",
                        "glosses": [
                            "To entangle."
                        ],
                        "tags": [
                            "broadly",
                            "figuratively",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "df05f531-b9a0-4deb-b46e-d05463492092",
                                "sense_id": "d93e8b50-eead-3e93-a001-02cc7ae59652",
                                "text": "The chains of command are designed to enlace various departments."
                            },
                            {
                                "example_id": "1599e5be-d8b5-47ef-9ea4-a72b97ab6646",
                                "sense_id": "d93e8b50-eead-3e93-a001-02cc7ae59652",
                                "text": "The bonds of friendship helped enlace the two communities."
                            },
                            {
                                "example_id": "a8f642e2-7f11-49a1-8297-dcf1d1a5845a",
                                "sense_id": "d93e8b50-eead-3e93-a001-02cc7ae59652",
                                "text": "His speech sought to enlace both the traditional and modern values."
                            }
                        ]
                    }
