                        "examples": [
                            {
                                "example_id": "1a47d6c9-29a6-4d6f-bc1b-90ad1107fb21",
                                "sense_id": "23f49d4d-37a9-3a49-9c89-fc39afa31923",
                                "text": "De drie zonnen staan in een rechte lijn en draaien rond onze planeet in dezelfde hoeksnelheid! En dus bevinden onze planeet en de drie zonnen zich altijd in een rechte lijn, met onze wereld aan het eind!' 'Weet je zeker dat die observatie geen vergissing is?' Newton greep de minister van Astronomie bij zijn halsboord."
                            },
                            {
                                "example_id": "508001f4-74eb-41af-ad80-5e509eef326e",
                                "sense_id": "23f49d4d-37a9-3a49-9c89-fc39afa31923",
                                "text": "Een zwart halsboord stak merkwaardig fris af tegen de viriele bleekheid van zijn gezicht."
                            }
                        ]
