                                "sense_id": "4b17641e-1c3b-3ea5-b821-f98e295000df",
                                "text": "„500 Personen von den insgesamt 2400 EinwohnerInnen [sic] leben seit mehr als zehn Jahren auf Svalbard, und nur 130 seit länger als 20 Jahren.“"
                            },
                            {
                                "example_id": "4acb791b-5090-4bf0-8072-d1838d5c2003",
                                "sense_id": "4b17641e-1c3b-3ea5-b821-f98e295000df",
                                "text": "„Wissenschaftler der Universität Oslo entdeckten auf Svalbard einen 150 Mio. Jahre alten Dinosaurier-Friedhof mit Skeletten von Plesiosauriern und Ichthyosauriern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
