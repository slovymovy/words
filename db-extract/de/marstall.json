                        "form": "die Marställe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "13397aad-a6c0-397a-b21b-c966d96a5e0a",
                        "entry_id": "0c54e02e-6e1f-3f28-8564-0ffec4b39409",
                        "glosses": [
                            "Stallungen für Pferde und Wagen eines Fürsten, welche oftmals die Gebäude für Pferde, Wagen, Kutschen und Geschirr umfassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7715ca64-434c-4ba8-81a5-97161ff8f10a",
                                "sense_id": "13397aad-a6c0-397a-b21b-c966d96a5e0a",
                                "text": "Der einst von Kaiser Wilhelm II. errichtete Neue Marstall vor dem Berliner Schloss, welcher zur Unterbringung der 300 Pferde sowie der Kutschen und Schlitten des kaiserlichen Hofes diente, ist heute eine Bibliothek."
                            },
                            {
                                "example_id": "31ead1d9-1d61-4c4b-b051-b9257e3ac6aa",
                                "sense_id": "13397aad-a6c0-397a-b21b-c966d96a5e0a",
                                "text": "In der Barockepoche wurden Marställe oft aufgedonnerter und üppig, sodass sich seine Bedeutung auch auf Hofreitschulen und Reithallen erweiterte."
                            },
                            {
                                "example_id": "43be99e1-a2ba-412d-ab40-0ffc5e3b2b61",
                                "sense_id": "13397aad-a6c0-397a-b21b-c966d96a5e0a",
                                "text": "Kurfürst Joachim II. von Brandenburg ließ während des Erweiterungsbaues des Berliner Schlosses einen Marstall errichten, der im Laufe der Geschichte seine Bedeutung änderte, mal Audienz- und mal Wohnräume aufnahm, und, überbaut und verändert, bis zu seiner von der DDR gewollten Sprengung 1950 stand."
                            },
                            {
                                "example_id": "e2526e76-b4cb-411c-927b-b5fdfa2d8283",
                                "sense_id": "13397aad-a6c0-397a-b21b-c966d96a5e0a",
                                "text": "„Im Marstall des Sultans standen australische Rappen und prächtige isabellfarbige Hengste in sauberen Boxen.“"
                            },
                            {
                                "example_id": "af5c23a0-3542-4073-8759-bd907fc95d33",
                                "sense_id": "13397aad-a6c0-397a-b21b-c966d96a5e0a",
                                "text": "„Die Kinder wurden nach dem Marstall des Königs geführt, und dessen Pferde nach Frederiksberg getrieben.“"
                            },
                            {
                                "example_id": "3a9c550f-0c6f-4553-82fc-49dab3fc7a36",
                                "sense_id": "13397aad-a6c0-397a-b21b-c966d96a5e0a",
                                "text": "„Deshalb wies Butzbach ausdrücklich darauf hin, dass die Miltenberger Burg einen Marstall hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "14c25889-daf1-3195-9fd6-6c5a31e141c4",
                        "entry_id": "0c54e02e-6e1f-3f28-8564-0ffec4b39409",
                        "glosses": [
                            "Gesamtheit der Pferde eines Fürsten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea351a42-0859-4a76-b8a9-cccfcec3e06d",
                                "sense_id": "14c25889-daf1-3195-9fd6-6c5a31e141c4",
                                "text": "Der fürstliche Marstall umfasst mehr als 500 Rösser, 20 Prachtequipage, einen im Nordosten angebautes Reithaus und die Augsburger Silbergeschirrsammlung mit 300 Buffets."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c8915561-820f-4f28-9212-8369ebbd89b1",
                        "source_entry_id": "0c54e02e-6e1f-3f28-8564-0ffec4b39409",
                        "source_sense_id": "13397aad-a6c0-397a-b21b-c966d96a5e0a",
