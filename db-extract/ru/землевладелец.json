                                "example_id": "eb12f377-a699-43ce-9b59-c8d470a430e0",
                                "sense_id": "1569e593-8fb6-3876-9050-69b838215ee0",
                                "text": "Землевладе́ние есть монопо́лия, и на основа́нии э́той монопо́лии землевладе́лец потре́бует пла́ты с фе́рмера и за э́ту зе́млю.",
                                "translation": "Landownership is a monopoly, and on the basis of this monopoly the landowner demands payment from the farmer for this land also.",
                                "english": "Landownership is a monopoly, and on the basis of this monopoly the landowner demands payment from the farmer for this land also."
                            }
                        ]
