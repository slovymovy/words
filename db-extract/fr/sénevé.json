                                    },
                                    {
                                        "sense_id": "9492b306-6249-3c1f-b95b-cb4b6063c1b8",
                                        "entry_id": "b3020827-2386-3312-ad07-fb0dfb7a666d",
                                        "glosses": [
                                            "unpassende Bemerkung, die ein Dritter zu einem Gespräch von anderen Personen beisteuert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71a01b96-75ef-4d06-8cd5-cc18bef9f35d",
