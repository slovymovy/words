                        "target_lang_word": "Krabbelkind",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "efd5f3b0-8221-4f67-929e-d8a583e57fd5",
                        "source_entry_id": "e3edf582-6c95-39b1-8ba3-e7c706020d09",
                        "source_sense_id": "40be92b8-3166-366e-b37c-fd94d9cfd797",
                        "source_sense_description": "Krabbelkind, sehr kleines Kind, Kleinkind, Hosenscheißer",
                        "target_lang_word": "Kleinkind",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kleinkind",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0a568d16-33ef-3ea3-92ab-91c3294efc22",
                                        "entry_id": "a9f67a56-f4a1-3b43-8759-2af3bad5b461",
                                        "glosses": [
                                            "Kind unter sechs Jahren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc9cad32-f673-48f5-b3c5-671001d06d39",
                                                "sense_id": "0a568d16-33ef-3ea3-92ab-91c3294efc22",
                                                "text": "Es gibt ein extra Planschbecken für Kleinkinder."
                                            },
                                            {
                                                "example_id": "873d0824-9193-4661-9e69-28070f4efddc",
                                                "sense_id": "0a568d16-33ef-3ea3-92ab-91c3294efc22",
                                                "text": "„Es fehlte die Wahrnehmung dafür, dass es für die Kleineren weit schwerer war, mit einer Kette von furchtbaren Erlebnissen fertigzuwerden, weil die überforderten Erwachsenen nicht die Sicherheit und Nestwärme geben konnten, die Kleinkinder für den Aufbau ihrer psychischen Stabilität brauchen.“"
                                            },
                                            {
                                                "example_id": "9654fbb2-cdb7-474a-9acd-79eb8a58fac1",
                                                "sense_id": "0a568d16-33ef-3ea3-92ab-91c3294efc22",
                                                "text": "„Wolfgang Thierse, geboren 1943, floh als Kleinkind mit seiner Familie vor der russischen Armee aus dem brennenden Breslau bei 16 Grad unter Null und 50 Zentimeter Neuschnee.“"
                                            },
                                            {
                                                "example_id": "2d6c6036-9d09-4320-a7b9-e9546757a6cb",
                                                "sense_id": "0a568d16-33ef-3ea3-92ab-91c3294efc22",
                                                "text": "„Er wandte sich mir zu und behandelte mich nicht wie ein Kleinkind.“"
                                            },
                                            {
                                                "example_id": "f56fe350-0cdc-45c9-9859-0ff89810a62a",
                                                "sense_id": "0a568d16-33ef-3ea3-92ab-91c3294efc22",
                                                "text": "„Hier wohnte die eine als Kleinkind und sie erinnere sich noch immer an einen fantastischen Blick auf den Rhein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74f8328a-d321-4897-ae9e-bf1a7edc87c0",
                        "source_entry_id": "e3edf582-6c95-39b1-8ba3-e7c706020d09",
                        "source_sense_id": "40be92b8-3166-366e-b37c-fd94d9cfd797",
                        "source_sense_description": "Krabbelkind, sehr kleines Kind, Kleinkind, Hosenscheißer",
                        "target_lang_word": "Hosenscheißer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hosenscheißer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0882fe1f-fb76-32f7-a100-9a0073aa0b72",
                                        "entry_id": "1ddbc41d-a1c3-3494-b520-cbef0f7b3f83",
                                        "glosses": [
                                            "Kind, das noch in die Hosen macht"
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ccaf4ad-c467-4df0-9af0-b8be9edb4159",
                                                "sense_id": "0882fe1f-fb76-32f7-a100-9a0073aa0b72",
                                                "text": "Da schläft unser kleiner Hosenscheißer."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8dd98625-73c7-39c8-a124-1592e979756b",
                                        "entry_id": "1ddbc41d-a1c3-3494-b520-cbef0f7b3f83",
                                        "glosses": [
                                            "Schimpfwort für eine sehr ängstliche Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8f2e1df-7b31-4f9c-ba2f-4d3f3557c15a",
                                                "sense_id": "8dd98625-73c7-39c8-a124-1592e979756b",
                                                "text": "„Immerhin war ich damals ein furchtbarer Hosenscheißer und hatte jegliche Art von Ängsten, die man nur haben kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
