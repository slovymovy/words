                                    },
                                    {
                                        "sense_id": "fa9b4db8-92c0-3cdc-aa86-1b9ad77774b0",
                                        "entry_id": "e7e8bb48-3e29-31d7-ae0e-42788a89c7a4",
                                        "glosses": [
                                            "mit großer Selbstbeherrschung, ohne zu klagen"
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bdeb1d1-fc07-4086-a379-7f1942fc424f",
                                                "sense_id": "fa9b4db8-92c0-3cdc-aa86-1b9ad77774b0",
                                                "text": "„Mühsam hatte sie sich also mit ihren Tieren nach oben gekämpft und erledigte tapfer ihre Arbeiten, was ihr aber von Tag zu Tag schwerer fiel.“"
