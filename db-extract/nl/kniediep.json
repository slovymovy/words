                        "examples": [
                            {
                                "example_id": "4d5103ca-48ad-4465-b09a-d8b7f87e772e",
                                "sense_id": "b3f70d40-09f7-3251-adb1-315956c57fcb",
                                "text": "Met vier aangedreven wielen kniediep door de modder baggeren. Het is de droom van veel kerels die dagelijks met hun stoere 4x4 noodgedwongen over het asfalt rollen. Terwijl hun vrouwen in de vrije tijd liever kamperen, fietsen en wandelen. Het Almelose stel Linda en Jeroen Jansen brengen droom en wens bij elkaar."
                            },
                            {
                                "example_id": "6914bac5-bdf1-4791-be65-92a85e112221",
                                "sense_id": "b3f70d40-09f7-3251-adb1-315956c57fcb",
                                "text": "Maar wees gewaarschuwd: Game of Thrones is anders. Onder meer vanwege het duo seks & geweld. De serie lijkt bij vlagen meer op een instructiefilm bij de Kamasutra dan op een middeleeuwse heldensage. En een beetje geweld prima, maar om nu kniediep door het bloed te moeten waden..."
                            }
