                                    {
                                        "sense_id": "e33699f8-eacf-39c7-8f44-8a7950961d90",
                                        "entry_id": "2d84ff1a-dc37-3afa-9085-8acc3e356866",
                                        "glosses": [
                                            "benaming voor bomen uit het geslacht Ginkgo uit de familie Ginkgoaceae; dit geslacht is uitgestorven op de Japanse notenboom Ginkgo biloba na, die daarom soms wordt gezien als een levend fossiel"
                                        ],
                                        "tags": [
                                            "coniferen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce1a4598-27d2-4211-9b2b-1ad867299600",
                                                "sense_id": "e33699f8-eacf-39c7-8f44-8a7950961d90",
                                                "text": "De poort aldaar geeft toegang tot de smalle gang (‘niet fietsen’) die voert naar een hemelse binnentuin met een spectaculaire ginkgo, een zonnewijzer en een reusachtige magnolia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01598835-6f92-43af-8e73-40057ede93df",
                        "source_entry_id": "f07bb583-3e83-32c8-b066-44ac407936d5",
                        "source_sense_description": "tree",
                        "target_lang_word": "Japanse notenboom",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Japanse notenboom",
