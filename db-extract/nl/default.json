                "senses": [
                    {
                        "sense_id": "5ba2c208-92fc-381c-87f2-40a0376e4486",
                        "entry_id": "bbdf7bd6-2f72-3e29-b329-4e89b0f0c073",
                        "glosses": [
                            "waarde die een parameter heeft als de gebruiker van een programma niet zelf een andere waarde opgeeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9c22878-f08a-4def-9f05-406b0212bd0a",
                                "sense_id": "5ba2c208-92fc-381c-87f2-40a0376e4486",
                                "text": "Via het Aantal-veld kun je een aantal invoeren. De default is 1. Je kunt op het getal klikken en dan een nieuw getal invoeren via het toetsenbord."
                            }
                        ]
                    },
                    {
                        "sense_id": "e82ed02e-98b6-3036-b459-2af50fa3d561",
                        "entry_id": "bbdf7bd6-2f72-3e29-b329-4e89b0f0c073",
                        "glosses": [
                            "uitgangspunt dat van toepassing is tenzij uitdrukkelijk anders wordt besloten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01908704-8ca6-4139-9d9f-dc8f6a78b506",
                                "sense_id": "e82ed02e-98b6-3036-b459-2af50fa3d561",
                                "text": "Intussen kunnen reisorganisaties alvast royale CO2-compensatie als default opnemen in de reissom van hun meest exclusieve reizen; noblesse oblige."
                            },
                            {
                                "example_id": "c16e0c11-8969-499f-9a5c-6ccbae54827b",
                                "sense_id": "e82ed02e-98b6-3036-b459-2af50fa3d561",
                                "text": "Het meest verwonderlijke aan het rapport Onderwijs2032 is dat nergens valt te lezen voor welk probleem dit advies eigenlijk de oplossing is. Moet je bij Rijkswaterstaat wel eerst een scheur in de dijk kunnen aantonen voor je mag uitrukken met de graafmachines, in de wereld van het onderwijs is ‘defect’ de default."
                            }
                        ]
                    },
                    {
                        "sense_id": "a618b682-7f08-3809-b5d5-b76d6b997fa2",
                        "entry_id": "bbdf7bd6-2f72-3e29-b329-4e89b0f0c073",
                        "glosses": [
                            "vaststelling dat je niet bent verschenen bij een rechtszaak die tegen je is aangespannen"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "34b204cc-89c5-4650-8675-2cc41fc2a158",
                                "sense_id": "a618b682-7f08-3809-b5d5-b76d6b997fa2",
                                "text": "Wanneer \"geïnthimeerde\" echter niet in rechte was verschenen, kon impetrant van appel of reformatie default verzoeken."
                            }
                        ]
                    },
                    {
                        "sense_id": "955ee851-613f-3fec-8054-390b8531c3c1",
                        "entry_id": "bbdf7bd6-2f72-3e29-b329-4e89b0f0c073",
                        "glosses": [
                            "vaststelling dat een schuld niet zal worden terugbetaald"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "729d1ea8-b25f-4767-96f3-548956b72a95",
                                "sense_id": "955ee851-613f-3fec-8054-390b8531c3c1",
                                "text": "Hij wist dat Athene weinig wapens had en zich geen bluf kon veroorloven (default op de 30 miljard euro die de ECB opkocht was zo’n wapen). Dreigen met bankroet mocht alleen als je een Plan B had."
                            }
                        ]
                    },
                    {
                        "sense_id": "134c1f91-5a95-398d-9adb-a23613181c85",
                        "entry_id": "bbdf7bd6-2f72-3e29-b329-4e89b0f0c073",
                        "glosses": [
                            "wegblijven van de tegenstander bij een wedstrijd, zodat je zonder spelen tot winnaar wordt verklaard"
                        ],
                        "tags": [
                            "Antillen"
                        ],
                        "examples": [
                            {
                                "example_id": "fb8d80cd-bf36-47f5-9356-24113dc0ab15",
                                "sense_id": "134c1f91-5a95-398d-9adb-a23613181c85",
                                "text": "Hekkesluiter van de derde divisie, Volvox/Paradise, won zijn eerste wedstrijd en wel middels default. Tegenstander Sparta Arends besloot namelijk niet op de baan te verschijnen."
                            }
                        ]
                    }
                ],
