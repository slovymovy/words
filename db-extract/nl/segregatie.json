                                        "sense_id": "2247ffaf-ff9f-31f0-aefc-dc6241e40439",
                                        "entry_id": "baa5cbb2-3577-3606-8211-4f9b41a1a053",
                                        "glosses": [
                                            "The separation of people based upon race, sex, religion, or other identity in institutions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "352f05ff-f819-47f5-99f4-5762d3e4f231",
                                                "sense_id": "2247ffaf-ff9f-31f0-aefc-dc6241e40439",
                                                "text": "The fact that one is gay or one's brother is gay […] — this has less influence on the average HK person's attention or attitude than how he or she finds a job, the way he lives and the way he eats, which is like New York or oter large cities. There tends to be a segregation between a person's private life and his job or other affairs. It does not mean that they are liberal, just that city life fosters this individualism."
                                            }
                                        ]
                                    },
