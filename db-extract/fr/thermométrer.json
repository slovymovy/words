                "senses": [
                    {
                        "sense_id": "0f3d93bd-d406-3dce-873e-5c94fea9fedd",
                        "entry_id": "002dd3b6-bcc7-359f-aa03-02539936ed98",
                        "glosses": [
                            "Mesurer la température avec un thermomètre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c3c1dc0-0002-40d8-906c-7209951266dc",
                                "sense_id": "0f3d93bd-d406-3dce-873e-5c94fea9fedd",
                                "text": "On doit mentionner également une source froide, la source Sainte-Marguerite qui, thermométrée le 3 septembre par une température atmosphérique de 19° 5, marquait 13 °."
                            },
                            {
                                "example_id": "3d86d6a4-4f2a-487d-b962-46327e06f8e3",
                                "sense_id": "0f3d93bd-d406-3dce-873e-5c94fea9fedd",
                                "text": "Elle a son point d'émergence à 2ᵐ,50 de la Grosse source ; son captage sous les dalles de la salle des piscines du bain Romain ne permet pas de la thermométrer."
                            },
                            {
                                "example_id": "583911c6-7d5d-4b63-af51-db3a96700afa",
                                "sense_id": "0f3d93bd-d406-3dce-873e-5c94fea9fedd",
                                "text": "En dehors des aéroports, je me suis fait thermométrer à chaque passage de frontière avec la Chine en bagnole."
                            }
                        ]
                    }
