{
    "word_family": [
        "illicitly",
        "illicitness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d9ab90ee-2964-343c-92fc-59cc2b4449da",
                    "sense_definition": "Forbidden by law, rules, or custom.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unlawful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The authorities are working hard to stop the <w>illicit</w> trade of endangered animals.",
                            "target_lang_translations": {
                                "ru": "Власти усердно работают над тем, чтобы остановить <w>незаконную</w> торговлю животными, находящимися под угрозой исчезновения."
                            }
                        },
                        {
                            "text": "He was arrested for his involvement in an <w>illicit</w> drug operation.",
                            "target_lang_translations": {
                                "ru": "Он был арестован за участие в <w>нелегальной</w> торговле наркотиками."
                            }
                        }
                    ],
                    "synonyms": [
                        "illegal",
                        "unlawful",
                        "prohibited"
                    ],
                    "antonyms": [
                        "legal",
                        "lawful",
                        "licit"
                    ],
                    "common_phrases": [
                        "illicit trade",
                        "illicit drugs",
                        "illicit activities"
                    ],
                    "target_lang_definitions": {
                        "ru": "Запрещенный законом, правилами или обычаями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "незаконный",
                                "target_lang_sense_clarification": "нарушающий закон"
                            },
                            {
                                "target_lang_word": "нелегальный",
                                "target_lang_sense_clarification": "действующий вне рамок закона"
                            },
                            {
                                "target_lang_word": "запрещенный",
                                "target_lang_sense_clarification": "не дозволенный правилами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43d85a70-d4b2-30dc-bb0e-342c950051a1",
                    "sense_definition": "Not morally or socially acceptable; breaking social norms.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "socially_unacceptable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The novel tells the story of an <w>illicit</w> love affair between two neighbors.",
                            "target_lang_translations": {
                                "ru": "В романе рассказывается история <w>запретной</w> любви между двумя соседями."
                            }
                        },
                        {
                            "text": "They met in secret to continue their <w>illicit</w> relationship away from prying eyes.",
                            "target_lang_translations": {
                                "ru": "Они тайно встречались, чтобы продолжать свои <w>недозволенные</w> отношения вдали от посторонних глаз."
                            }
                        }
                    ],
                    "synonyms": [
                        "illegitimate"
                    ],
                    "antonyms": [
                        "respectable",
                        "legitimate"
                    ],
                    "common_phrases": [
                        "illicit affair",
                        "illicit relationship"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неприемлемый с моральной или социальной точки зрения; нарушающий общественные нормы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "незаконный",
                                "target_lang_sense_clarification": "о внебрачной или предосудительной связи"
                            },
                            {
                                "target_lang_word": "запретный",
                                "target_lang_sense_clarification": "недопустимый по моральным соображениям"
                            },
                            {
                                "target_lang_word": "недозволенный",
                                "target_lang_sense_clarification": "нарушающий приличия или нормы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "796b59bc-e1f0-3664-bffe-c575d91262af",
                    "sense_definition": "Not officially approved by law or regulations, though not necessarily invalid or criminal.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "unlawful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>illicit</w> entry into the building was considered a trespass rather than a felony.",
                            "target_lang_translations": {
                                "ru": "<w>Неправомерное</w> проникновение в здание было расценено как нарушение границ владения, а не как тяжкое преступление."
                            }
                        },
                        {
                            "text": "While the contract was technically <w>illicit</w> due to a filing error, the court did not rule it void.",
                            "target_lang_translations": {
                                "ru": "Хотя контракт технически был <w>незаконным</w> из-за ошибки при подаче документов, суд не признал его недействительным."
                            }
                        }
                    ],
                    "synonyms": [
                        "unlawful"
                    ],
                    "antonyms": [
                        "authorized"
                    ],
                    "common_phrases": [
                        "illicit entry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не имеющий официального разрешения или оформленный с нарушениями, но не обязательно преступный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неправомерный",
                                "target_lang_sense_clarification": "совершенный без должного основания"
                            },
                            {
                                "target_lang_word": "неположенный",
                                "target_lang_sense_clarification": "не соответствующий правилам или порядку"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7be255c9-2841-33a9-b8d9-69f1043865ee",
                    "sense_definition": "An item that is banned, prohibited, or illegal to possess.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "illegal_items",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police seized a variety of <w>illicits</w> during the raid on the warehouse.",
                            "target_lang_translations": {
                                "ru": "Во время рейда на склад полиция изъяла множество <w>запрещенных товаров</w>."
                            }
                        },
                        {
                            "text": "Customs officers are trained to identify various <w>illicits</w> hidden in cargo containers.",
                            "target_lang_translations": {
                                "ru": "Сотрудники таможни обучены выявлять различную <w>контрабанду</w>, спрятанную в грузовых контейнерах."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет, владение которым запрещено или незаконно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запрещенный товар",
                                "target_lang_sense_clarification": "предмет контрабанды или нелегального оборота"
                            },
                            {
                                "target_lang_word": "контрабанда",
                                "target_lang_sense_clarification": "незаконно ввезенные или запрещенные вещи"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}