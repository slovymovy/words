                            {
                                "example_id": "895ac68b-8f12-4fee-8639-380d00530276",
                                "sense_id": "c2c481dc-9fc7-3a45-a913-b3608a6b5d82",
                                "text": "Uit het puntje van de sigaret steeg een dunne rookkringel op, recht naar boven, want er stond hier geen briesje dat zijn route zou kunnen veranderen."
                            },
                            {
                                "example_id": "8e656d0c-1241-426e-a7fe-a0ec9fafb4dc",
                                "sense_id": "c2c481dc-9fc7-3a45-a913-b3608a6b5d82",
                                "text": "Hij haalde een doosje dunne sigaartjes tevoorschijn."
                            }
                        ]
                    }
