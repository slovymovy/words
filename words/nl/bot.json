        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d56ccb65-ca13-3a39-a2c1-16fd5ef9d088",
                    "sense_definition": "niet scherp meer, waardoor het moeilijk is om ergens doorheen te snijden",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "scherpte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De schaar is te <w>bot</w> om het dikke papier goed te kunnen knippen.",
                            "target_lang_translations": {
                                "en": "The scissors are too <w>blunt</w> to cut the thick paper properly."
                            }
                        },
                        {
                            "text": "Met een <w>bot</w> mes kun je geen mooie plakjes vlees afsnijden.",
                            "target_lang_translations": {
                                "en": "You cannot cut nice slices of meat with a <w>dull</w> knife."
                            }
                        }
                    ],
                    "synonyms": [
                        "stomp"
                    ],
                    "antonyms": [
                        "scherp",
                        "vlijmscherp",
                        "messcherp"
                    ],
                    "common_phrases": [
                        "bot mes",
                        "botte schaar"
                    ],
                    "target_lang_definitions": {
                        "en": "no longer sharp, making it difficult to cut through something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blunt",
                                "target_lang_sense_clarification": "not sharp"
                            },
                            {
                                "target_lang_word": "dull",
                                "target_lang_sense_clarification": "lacking a sharp edge"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e37a84f-02d4-35c7-b2d9-4e8a116ed89e",
                    "sense_definition": "onvriendelijk, kortaf of onbeleefd in de omgang met anderen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn opmerking was nogal <w>bot</w> en kwetste haar gevoelens diep.",
                            "target_lang_translations": {
                                "en": "His remark was rather <w>blunt</w> and deeply hurt her feelings."
                            }
                        },
                        {
                            "text": "Ik vind het vervelend als mensen <w>bot</w> gedrag vertonen tegenover vreemden.",
                            "target_lang_translations": {
                                "en": "I find it annoying when people display <w>rude</w> behavior toward strangers."
                            }
                        }
                    ],
                    "synonyms": [
                        "onbeleefd",
                        "lomp",
                        "onvriendelijk",
                        "kortaf"
                    ],
                    "antonyms": [
                        "beleefd"
                    ],
                    "common_phrases": [
                        "bot gedrag",
                        "botte opmerking"
                    ],
                    "target_lang_definitions": {
                        "en": "unfriendly, abrupt, or impolite in interaction with others"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blunt",
                                "target_lang_sense_clarification": "abrupt or unceremonious in speech"
                            },
                            {
                                "target_lang_word": "rude",
                                "target_lang_sense_clarification": "bad-mannered or discourteous"
                            },
                            {
                                "target_lang_word": "curt",
                                "target_lang_sense_clarification": "rudely brief"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7cc5c1f-6d52-3e23-bbaa-b955b298233c",
                    "sense_definition": "gezegd van een situatie die puur op toeval berust en erg vervelend is",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geluk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was <w>botte</w> pech dat de trein net voor zijn neus wegreed.",
                            "target_lang_translations": {
                                "en": "It was <w>sheer</w> bad luck that the train pulled away right in front of him."
                            }
                        },
                        {
                            "text": "Dat hij vlak voor de finish viel, was echt een geval van <w>botte</w> pech.",
                            "target_lang_translations": {
                                "en": "The fact that he fell just before the finish was truly a case of <w>rotten</w> luck."
                            }
                        }
                    ],
                    "common_phrases": [
                        "botte pech"
                    ],
                    "target_lang_definitions": {
                        "en": "said of a situation that is purely based on chance and is very annoying"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sheer",
                                "target_lang_sense_clarification": "used to emphasize a quality like bad luck"
                            },
                            {
                                "target_lang_word": "rotten",
                                "target_lang_sense_clarification": "used in the phrase 'rotten luck'"
                            }
                        ]
                    }
                }
            ]
