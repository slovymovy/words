                "senses": [
                    {
                        "sense_id": "7819bc04-ba20-38de-a28b-55406015ca5b",
                        "entry_id": "a9e2923b-d943-3eea-bef2-d47c6260b1e4",
                        "glosses": [
                            "Wort mit zwei oder mehr Bedeutungen, wobei eine Bedeutung das Gegenteil einer anderen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34c2d97b-4c0e-4660-98c5-3bd95fb1b786",
                                "sense_id": "7819bc04-ba20-38de-a28b-55406015ca5b",
                                "text": "„Der Begriff Transparenz ist ein klassisches Autoantonym, also ein Wort, das zwei gegenteilige Bedeutungen hat. Ein integriertes Informationssystem ist transparent bezüglich einer bestimmten Art von Heterogenität, wenn ein Nutzer oder eine Anwendung diese nicht wahrnimmt – er blickt quasi durch das Problem hindurch. Eine Technik oder ein Verfahren im Alltag nennt man dagegen transparent, wenn ein Betroffener alle Details erkennen kann – er »blickt durch«, auch Details sind sichtbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
