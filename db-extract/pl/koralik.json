                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "956685f2-027b-4e46-ae20-6c4357916841",
                                                "sense_id": "e74b5aca-dfb4-33e1-8de3-dfb2e01a13b6",
                                                "text": "Only the hum of the miserable creatures stirred the heavy murk that beaded our foreheads with sweat as we pushed our way through it."
                                            }
