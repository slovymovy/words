                ],
                "senses": [
                    {
                        "sense_id": "2bc0e5dc-0059-38be-90b2-3008624accb6",
                        "entry_id": "7758b22d-6e3c-3bed-87c3-1d7c00e32013",
                        "glosses": [
                            "уменьш.-ласк. к чай"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef2415f9-9694-44c6-9d7b-cd221886e322",
                                "sense_id": "2bc0e5dc-0059-38be-90b2-3008624accb6",
                                "text": "А ведь вы правы: всё лучше выпить чайку́."
                            },
                            {
                                "example_id": "c1aa6814-cbc1-4736-9082-9b3f7421c44e",
                                "sense_id": "2bc0e5dc-0059-38be-90b2-3008624accb6",
                                "text": "Да не хочешь ли ко мне сперва чайку зайти напиться?"
                            },
                            {
                                "example_id": "1005a8f9-c4d7-4964-a5b3-89e4e997b677",
                                "sense_id": "2bc0e5dc-0059-38be-90b2-3008624accb6",
                                "text": "― Валюша, а может быть, ты позволишь мне, старому человеку, иной раз забежать на огонёк? Посидели бы за чайком, поговорили бы… Посмеялись."
                            },
                            {
                                "example_id": "7d6fa715-5e91-4667-9c47-3b782f35beea",
                                "sense_id": "2bc0e5dc-0059-38be-90b2-3008624accb6",
                                "text": "Сейчас чайку́ попьём, мне семейство вареньица домашнего с оказией прислали."
                            }
                        ]
                    }
                ],
