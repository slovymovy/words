                        "glosses": [
                            "Faire perdre sa graisse à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3e6cdd3-4071-4421-b31a-02363fc9c0a7",
                                "sense_id": "05cc8687-6dd8-3025-b7b5-9e46fee1047b",
                                "text": "D’après Seegen il fait diminuer la proportion des matières azotées dans l’urine ; comme altérant, ce ne serait donc pas sur les matières albuminoïdes qu’il agirait, mais sur les principes hydro-carbonés, d’où son succès dans l’obésité, il désengraisse sans cachexier, contrairement aux eaux alcalines."
                            },
                            {
                                "example_id": "054ecd3f-25a6-4569-97f2-4ae359ce2326",
                                "sense_id": "05cc8687-6dd8-3025-b7b5-9e46fee1047b",
                                "text": "Le seul moyen de se préserver de ces animaux est de ne pas les engraisser, ou de les désengraisser : les deux méthodes sont valables."
                            },
                            {
                                "example_id": "44f164b9-29c9-4d52-9613-985827fec6b5",
                                "sense_id": "05cc8687-6dd8-3025-b7b5-9e46fee1047b",
                                "text": "On n’est jamais à l’abri d’une bonne nouvelle: Macron et Philippe n’ont peut-être pas totalement renoncé à désengraisser l’État."
                            },
                            {
                                "example_id": "08421ba5-4dcf-401b-bb15-5da3fcc13799",
                                "sense_id": "05cc8687-6dd8-3025-b7b5-9e46fee1047b",
                                "text": "Vite allez à Super Sport ci-dessous pour vous désengraisser et jouir d’une santé resplendissante."
                            }
                        ]
                    }
