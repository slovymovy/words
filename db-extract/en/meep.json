                "senses": [
                    {
                        "sense_id": "cddfc7bc-4a23-350d-b7fe-44a0cad09a94",
                        "entry_id": "1755b80a-a7df-32c9-9b97-c800abffd2c5",
                        "glosses": [
                            "imitating a small animal's cry, particularly a kitten or small bird"
                        ],
                        "tags": [
                            "onomatopoeic"
                        ],
                        "examples": [
                            {
                                "example_id": "483d4371-d63d-415a-a2f3-f92de3ed2434",
                                "sense_id": "cddfc7bc-4a23-350d-b7fe-44a0cad09a94",
                                "text": "\"Meep, meep, meep!\" echoed his brothers and sisters. They all felt pleased with themselves for having learnt to call their mother …"
                            },
                            {
                                "example_id": "5383b778-e5b4-47d2-b0bf-8496884dab96",
                                "sense_id": "cddfc7bc-4a23-350d-b7fe-44a0cad09a94",
                                "text": "\"We gave him three nervous breakdowns, you know,\" he says, waving his fingers in the rear view.\n\"Listen, I...\"\n\"I've heard this kind of thing before. The English think the French are little blind dogs. Meep meep meep meep meep,\" he says, performing a talking pantomime with his hand."
                            },
                            {
                                "example_id": "80b2ede4-6c16-474f-b241-f24394275cb8",
                                "sense_id": "cddfc7bc-4a23-350d-b7fe-44a0cad09a94",
                                "text": "'Granny, your hat squeaked,' said Tiffany. 'It went meep!'\n'No it didn’t,' Granny said sharply.\n'It did, you know,' said Nanny Ogg. 'I heard it, too.'\nGranny Weatherwax grunted and pulled off her hat. The white kitten, curled around her tight bun of hair, blinked in the light."
                            }
                        ]
                    },
