                        "glosses": [
                            "kraina historyczna w południowo-wschodniej Francji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8072ea43-e2a9-4fd6-8001-1b58d641c3fb",
                                "sense_id": "8bf02d75-1228-3f52-a98b-b5f7a28cb0bf",
                                "text": "Jeden z tych ludzi był Anglikiem, drugi Francuzem; obydwaj szczupli, wysokiego wzrostu, jeden brunet, jako południowiec z Prowansji, drugi rudy jak prawdziwy gentleman z Lancashire"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
