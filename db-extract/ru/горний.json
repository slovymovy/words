                ],
                "senses": [
                    {
                        "sense_id": "37a282de-2548-3d36-9af2-5422f7b01bb8",
                        "entry_id": "418257d0-c062-378e-9cbe-9f399357d246",
                        "glosses": [
                            "поэт., устар. находящийся в выси, в вышине или на возвышении"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad467de1-97a8-4d78-9beb-af85e0ac6fac",
                                "sense_id": "37a282de-2548-3d36-9af2-5422f7b01bb8",
                                "text": "Дорога в горний град [Иерусалим], разумеется, гористая, как впрочем и везде в здешней стороне."
                            }
                        ]
                    },
                    {
                        "sense_id": "83bb61de-74a0-3fea-9573-da165972606b",
                        "entry_id": "418257d0-c062-378e-9cbe-9f399357d246",
                        "glosses": [
                            "поэт., устар. перен. сходящий с вышины, с небес; небесный, возвышенный, божественный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a361a79-9e49-4d0a-8e5d-9ee6160d4722",
                                "sense_id": "83bb61de-74a0-3fea-9573-da165972606b",
                                "text": "И внял я неба содроганье, // И горний ангелов полёт, // И гад морских подводный ход, // И дольней ло́зы прозябанье."
                            },
                            {
                                "example_id": "c234b6df-6300-4b8b-b1d2-ae01a3f4402e",
                                "sense_id": "83bb61de-74a0-3fea-9573-da165972606b",
                                "text": "Горние помыслы."
                            }
                        ]
                    }
                ],
