{
    "word_family": [
        "condoleren",
        "condoleance"
    ],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "e067d557-4756-3850-be12-cb4ed2cdbcb6",
                    "sense_definition": "Een uitdrukking van medeleven bij het overlijden van een dierbare.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "condoleance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik hoorde dat je oma is gestorven, <w>gecondoleerd</w>.",
                            "target_lang_translations": {
                                "en": "I heard that your grandmother passed away, <w>my condolences</w>."
                            }
                        },
                        {
                            "text": "Mijn oprechte <w>gecondoleerd</w> met dit grote verlies.",
                            "target_lang_translations": {
                                "en": "My sincere <w>condolences</w> on this great loss."
                            }
                        }
                    ],
                    "synonyms": [
                        "innige deelneming"
                    ],
                    "common_phrases": [
                        "gecondoleerd met verlies"
                    ],
                    "target_lang_definitions": {
                        "en": "An expression of sympathy upon the death of a loved one."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "my condolences",
                                "target_lang_sense_clarification": "The standard formal expression used to offer sympathy."
                            },
                            {
                                "target_lang_word": "sorry for your loss",
                                "target_lang_sense_clarification": "A common, slightly more personal way to express sympathy."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6682d3ed-359c-3397-97ca-78172f37c200",
                    "sense_definition": "Het voltooid deelwoord van <w>condoleren</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft de familie persoonlijk <w>gecondoleerd</w> na de dienst.",
                            "target_lang_translations": {
                                "en": "He personally <w>offered his condolences</w> to the family after the service."
                            }
                        },
                        {
                            "text": "Zij zijn door veel vrienden <w>gecondoleerd</w> met hun verdriet.",
                            "target_lang_translations": {
                                "en": "They were <w>offered condolences</w> by many friends regarding their grief."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "voltooid deelwoord"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The past participle of the verb 'to condole' (to express sympathy)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "offered condolences",
                                "target_lang_sense_clarification": "Used in the context of expressing sympathy to someone."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}