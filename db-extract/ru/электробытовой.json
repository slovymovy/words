                                    {
                                        "sense_id": "21860ab2-50d1-33c5-b539-fe844a26e085",
                                        "entry_id": "1008f09b-42d2-33d7-9d07-be84245c6ea2",
                                        "glosses": [
                                            "Relatif aux appareils ou outils électriques destinés à couvrir des besoins domestiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78fa7306-f731-496f-8643-e399e0b432cf",
                                                "sense_id": "21860ab2-50d1-33c5-b539-fe844a26e085",
                                                "text": "Un appareil électroménager."
                                            },
                                            {
                                                "example_id": "aaebfa29-798e-4c09-b4c9-017049182ff8",
                                                "sense_id": "21860ab2-50d1-33c5-b539-fe844a26e085",
                                                "text": "L’appareillage électroménager économise d'abord la fatigue de la maîtresse de maison."
                                            },
                                            {
                                                "example_id": "9f8a36af-96f0-4fe8-9ea5-54e55839b4b5",
                                                "sense_id": "21860ab2-50d1-33c5-b539-fe844a26e085",
                                                "text": "La production électroménagère."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "électroménager",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e82b4074-6e8a-3ad2-b49d-9dddba187ff4",
                                        "entry_id": "e43e3868-da5b-34c3-962c-2ba7a6d99994",
                                        "glosses": [
                                            "Secteur économique qui regroupe les appareils ou outils électriques destinés à couvrir des besoins domestiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "338eeb2f-ab2f-44d3-93f3-3940fdfb2d7f",
                                                "sense_id": "e82b4074-6e8a-3ad2-b49d-9dddba187ff4",
                                                "text": "Concessionnaires de la marque allemande Rot Punkt et de l’italienne Birex, ils sont en pleine tendance de la stylique (alliance du stylisme et de la fonctionnalité) en intégrant les choix les plus pointus de l’électroménager et du mobilier contemporain dans les espaces de vie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3abb50a5-7f38-3d63-bac1-0cd9303fd5dd",
                                        "entry_id": "e43e3868-da5b-34c3-962c-2ba7a6d99994",
                                        "glosses": [
                                            "Ensemble des appareils ou outils électroménagers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b9119e7-c24e-47b7-828a-8552093e7586",
                                                "sense_id": "3abb50a5-7f38-3d63-bac1-0cd9303fd5dd",
                                                "text": "La performance du réparateur d’électroménager n'en est une qu’au regard du temps qu'il passe pour effectuer sa réparation."
                                            },
                                            {
                                                "example_id": "8185ab1a-4239-4f11-9b16-75fce878bb57",
                                                "sense_id": "3abb50a5-7f38-3d63-bac1-0cd9303fd5dd",
                                                "text": "Sur place, 90 techniciens s’affairent pour remettre en marche principalement le petit électroménager (PEM)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "866434f1-d529-429f-8220-1cabe00e7ac3",
                        "source_entry_id": "5eb6df3a-1675-3b27-88c3-1b488524678e",
