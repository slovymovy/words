                                    {
                                        "sense_id": "31e9b716-725c-36e1-ab74-8d3f90716358",
                                        "entry_id": "0179e06d-5ff7-3923-a02d-3069b631c997",
                                        "glosses": [
                                            "italienischer Tresterbrand, alkoholisches Getränk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "747411da-5750-4d73-b929-65817678e279",
                                                "sense_id": "31e9b716-725c-36e1-ab74-8d3f90716358",
                                                "text": "Zum Cappuccino passt ein Grappa."
                                            },
                                            {
