                "senses": [
                    {
                        "sense_id": "04c37c0a-0f10-3607-9be5-752b0debe3cb",
                        "entry_id": "8a7805f1-b504-3371-bcef-01d9fda99a2c",
                        "glosses": [
                            "mit Tasten oder Knöpfen, bei welchem der Ton durch eine Zunge, welche auf einer Grundplatte befestigt ist und durch einen Luftstrom, welcher mit einem Blasebalg erzeugt wird, in Schwingung versetzt, erzeugt wird"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "761e1b04-b429-4b43-8534-cbcbc5f50e97",
                                "sense_id": "04c37c0a-0f10-3607-9be5-752b0debe3cb",
                                "text": "„Die an diesem Nachmittag aufspielenden Musiker haben sich alle einem Instrument zugewandt, das lange unter Diskriminierung und Spott leiden musste, was auch die Bezeichnungen Handorgel, Arme-Leute-Klavier und Quetschkommode illustrieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d44b1b15-38d8-3fd7-a673-c01033d4293a",
                        "entry_id": "8a7805f1-b504-3371-bcef-01d9fda99a2c",
                        "glosses": [
                            "mechanisches Musikinstrument, das mit einer Kurbel betrieben (gespielt) wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84cf3103-952e-4ff0-807e-0c6533671e11",
                                "sense_id": "d44b1b15-38d8-3fd7-a673-c01033d4293a",
                                "text": "„Aufgeregt drehte er an einer Handorgel, wie sie vor etwa hundert Jahren Kriegsinvaliden, die kein anderes Einkommen hatten, gestiftet worden war.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
