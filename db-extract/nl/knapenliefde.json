                        "sense_id": "b3952bef-0cbb-357c-8bee-b03089909225",
                        "entry_id": "081b7a4f-5dc2-392b-bde0-95ab64a499b6",
                        "glosses": [
                            "erotisch-seksuele gevoelens van volwassenen (met name mannen) voor jonge jongens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cc29c35-e500-4046-88b8-0cd7eac8d6de",
                                "sense_id": "b3952bef-0cbb-357c-8bee-b03089909225",
                                "text": "De omgang van den meer volwassene met de jeugd en de bescherming en hulp, door gene aan deze verleend in de openbare oefenplaatsen, leidde tot die zonderlinge liefde van den hemelschen Eros, de knapenliefde, de gehechtheid aan hem, die in lichaams- en geestesgaven de bovenhand heeft en aan den anderen kant de toewijding van den meer begaafde aan de veredeling en versterking van de nog in ontwikkeling zijnde vermogens."
                            }
                        ]
                    },
                    {
                        "sense_id": "e901e241-00ec-3a16-b102-3713f5fd0c7b",
                        "entry_id": "081b7a4f-5dc2-392b-bde0-95ab64a499b6",
                        "glosses": [
                            "jeugdige verliefdheid"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "169b73bc-4a49-4221-b279-a4aa8630b52c",
                                "sense_id": "e901e241-00ec-3a16-b102-3713f5fd0c7b",
                                "text": "Knapenliefde.\nEn blozend sprak de blonde knaap:\n- ‘Voorwaar, ik heb u lief!’\nEn in zijne oogen las het kind\nhaar eersten minnebrief.\nZij zag hem bleek en bevend aan,\nde illusievolle maagd.\nGesproken was het groote woord,\nde stoute stap gewaagd!"
                            }
                        ]
                    }
