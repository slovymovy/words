                "translations": [
                    {
                        "translation_id": "3b993a6d-4524-426e-986f-2bff3345c8c0",
                        "source_entry_id": "2cb78e48-3020-327a-8fc2-9d74810ea5c2",
                        "source_sense_description": "Translations",
                        "target_lang_word": "bentoniet",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bentoniet",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c6660517-59e1-3f21-8913-432b03f367b6",
                                        "entry_id": "9d3ef1f0-7f56-373d-ad9b-d61173cb39f8",
                                        "glosses": [
                                            "een in de natuur voorkomende natrium-kleisoort met deeltjes die zo klein zijn dat ze de grond waterdicht kunnen maken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "953ec4a5-3123-4d38-a4df-93dc85b6eccf",
                                                "sense_id": "c6660517-59e1-3f21-8913-432b03f367b6",
                                                "text": "Toezichthouders houden een extra oogje in het zeil. Indien nodig zetten zij rijstroken af of ruimen ze boorspoeling op. Dit mengsel van water en de kleisoort bentoniet is niet schadelijk, maar wel hinderlijk voor voetgangers en verkeer."
                                            },
                                            {
                                                "example_id": "8e1299fa-a5f0-4133-847f-3fc06fd332b2",
                                                "sense_id": "c6660517-59e1-3f21-8913-432b03f367b6",
                                                "text": "Bij Nijmegen wordt een stadseiland in de drukstbevaren rivier van Europa aangelegd. Drie pijlers van de spoorbrug staan straks in de hoogwatergeul. ProRail graaft daar in het water sleuven van 1,5 meter breed en 23 meter diep over een lengte van 80 meter. Op de bodem van de sleuven wordt de waterdichte kleisoort bentoniet gestort."
                                            },
                                            {
                                                "example_id": "3e15ebdf-14e2-4054-babe-779289132618",
                                                "sense_id": "c6660517-59e1-3f21-8913-432b03f367b6",
                                                "text": "Bij Kanaal Almelo-De Haandrik zijn de problemen ontstaan ter hoogte van Daarlerveen. Door het aanbrengen van een halve meter klei op de bodem heeft de provincie geprobeerd de stroming tussen het kanaal en de omliggende landen te dichten. Dit bleek echter niet te werken. Na onderzoek is besloten het materiaal rona (bentoniet klei) aan te brengen door het bedrijf Van Heteren uit Hengelo. In de loop van 2013 is daarmee het probleem verholpen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af92b0d7-27be-4d77-89a8-100e6d1084d3",
                        "source_entry_id": "2cb78e48-3020-327a-8fc2-9d74810ea5c2",
