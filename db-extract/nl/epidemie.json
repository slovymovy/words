                ],
                "senses": [
                    {
                        "sense_id": "8553a82b-a207-3a2e-97ee-a71a919620ee",
                        "entry_id": "33acf61d-53db-3350-a739-f15f7901151c",
                        "glosses": [
                            "besmettelijke ziekte die zich snel verspreidt onder een groep van mensen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d73872b-b23a-4873-b076-509df80497fb",
                                "sense_id": "8553a82b-a207-3a2e-97ee-a71a919620ee",
                                "text": "De laatste polio-epidemie in Nederland was in 1992. Er werden 71 mensen ziek, van wie er 2 overleden. Verreweg de meeste patiënten waren van orthodox-gereformeerde huize en niet gevaccineerd. De voorlaatste uitbraak was in 1978, met 110 patiënten, waarvan er 4 overleden, uit dezelfde geloofsgroep. Het virus kwam de eerste keer uit Turkije, de tweede epidemie begon met import uit India."
                            },
                            {
                                "example_id": "c2bb707a-f516-48d0-91ca-67fec315c73c",
                                "sense_id": "8553a82b-a207-3a2e-97ee-a71a919620ee",
                                "text": "Burn-outs zijn tegenwoordig beroepsziekte nummer 1. Het NRC meldt dat meer dan 14 procent van de werknemers jaarlijks burn-outklachten ondervindt. Zo’n 5 procent van de beroepsbevolking komt als gevolg daarvan langdurig thuis te zitten. Een fikse burn-out leidt gemiddeld tot 242 dagen verzuim. Als reactie op deze epidemie wordt er door steeds meer bedrijven en overheden beleid gemaakt om mensen na een aantal jaar trouwe dienst verplicht op verlof te sturen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54f89788-c368-430c-93fb-b661fa6dc24a",
                        "source_entry_id": "33acf61d-53db-3350-a739-f15f7901151c",
                        "source_sense_id": "8553a82b-a207-3a2e-97ee-a71a919620ee",
                        "source_sense_description": "besmettelijke ziekte die zich snel verspreidt onder een groep van mensen",
                        "target_lang_word": "Epidemie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Epidemie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ac58bb2f-49d0-3d84-a1ee-1c986329e636",
                                        "entry_id": "c66a99a8-e5cf-3054-b08a-fcf61475bafe",
                                        "glosses": [
                                            "massenhaftes Auftreten einer Krankheit innerhalb einer Population"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5c85775-80b8-47ee-b1a1-1c00b2a33784",
                                                "sense_id": "ac58bb2f-49d0-3d84-a1ee-1c986329e636",
                                                "text": "Diese Grippe-Epidemie hat wirtschaftlich großen Schaden verursacht."
                                            },
                                            {
                                                "example_id": "963f1494-14de-483b-ad7a-c71b1189dd31",
                                                "sense_id": "ac58bb2f-49d0-3d84-a1ee-1c986329e636",
                                                "text": "„Angesichts der Zustände im Gefängnis wussten beide Männer, dass jederzeit eine Epidemie ausbrechen konnte.“"
                                            },
                                            {
                                                "example_id": "fb6e1203-bcac-494b-9529-66b4555371b1",
                                                "sense_id": "ac58bb2f-49d0-3d84-a1ee-1c986329e636",
                                                "text": "„Erschwert wurde dies durch eine hartnäckige Epidemie, die römische Soldaten nach ihrem Sieg über die Parther aus dem Osten eingeschleppt hatten.“"
                                            },
                                            {
                                                "example_id": "5a95e972-ddf1-4b11-8954-6bfa17dee8f3",
                                                "sense_id": "ac58bb2f-49d0-3d84-a1ee-1c986329e636",
                                                "text": "„Jetzt aber hat mit dem Sommer auch die Epidemie ihren Höhepunkt längst überschritten, und die Impfung widerlegt sich selbst mit der Art, in der sie durchgeführt wird.“"
                                            },
                                            {
                                                "example_id": "230a1d40-30ae-426e-a2d5-30ff16e6bdfa",
                                                "sense_id": "ac58bb2f-49d0-3d84-a1ee-1c986329e636",
                                                "text": "„Das schlechte Essen und Epidemien, wie sie zu jedem Krieg gehören, verursachen eine Dysenterie, die ihn ungeheuer schwächt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a3e8240-e7db-42c4-8d0f-462c474e9f29",
                        "source_entry_id": "33acf61d-53db-3350-a739-f15f7901151c",
                        "source_sense_id": "8553a82b-a207-3a2e-97ee-a71a919620ee",
                        "source_sense_description": "besmettelijke ziekte die zich snel verspreidt onder een groep van mensen",
                        "target_lang_word": "epidemic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "epidemic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b774907b-502f-3cfa-97f8-7ed6f5abfc68",
                                        "entry_id": "4f44152b-fe10-383a-92f9-a23342acf747",
                                        "glosses": [
                                            "A widespread disease that affects many humans in a population."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3bee367-d59b-4f8f-8954-402652391eb5",
                                                "sense_id": "b774907b-502f-3cfa-97f8-7ed6f5abfc68",
                                                "text": "At that time, the city [Christiania, now Oslo] was in the grip of a cholera epidemic, and victims were dying at the rate of 60 a day. Bradshaw contracted the disease, and died on September 6 [1853]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2c49c7f-ca83-3bdd-94c9-f42625c89c69",
                                        "entry_id": "4f44152b-fe10-383a-92f9-a23342acf747",
                                        "glosses": [
                                            "An occurrence of a disease or disorder in a human population at a frequency higher than that expected in a given time period; an episode of outbreak and subsequent high prevalence."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5ffaa791-a50d-33c7-8ec7-72fc7f47c229",
                                        "entry_id": "4f44152b-fe10-383a-92f9-a23342acf747",
                                        "glosses": [
                                            "A heightened occurrence of anything harmful."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9086b9c-2cfc-46b9-90d8-386f0a275ba0",
                                                "sense_id": "5ffaa791-a50d-33c7-8ec7-72fc7f47c229",
                                                "text": "Even before the pandemic, the United States surgeon general, Vivek Murthy, said the country was experiencing an “epidemic of loneliness,” driven by the accelerated pace of life and the spread of technology into all of our social interactions."
                                            },
                                            {
                                                "example_id": "a61f3b1d-8bd7-4859-8653-32734a226b36",
                                                "sense_id": "5ffaa791-a50d-33c7-8ec7-72fc7f47c229",
                                                "text": "People are holding coordinated protests across UK towns and cities this weekend against what they call a “climate of fear” on the roads, and an “epidemic” of careless and dangerous driving that is curbing children’s freedoms and putting lives at risk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3ef3ca8-d3c3-3819-8983-de8e7cedc30a",
                                        "entry_id": "4f44152b-fe10-383a-92f9-a23342acf747",
                                        "glosses": [
                                            "The spreading of an idea or belief amongst a population."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9a502f4-8667-43e6-a956-bbb0a5fb757b",
                                                "sense_id": "f3ef3ca8-d3c3-3819-8983-de8e7cedc30a",
                                                "text": "Lord Avonleigh was at once liberated from his imprisonment, well prepared to be considered, and to consider himself, a martyr to the cause of loyalty; and as the services of the rich nobleman,...his claims to notice and favour were most graciously acknowledged. Accordingly, he returned to his seat in a little fever of royal devotedness—it was the fashionable epidemic; and who coming from Whitehall could be without it?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "epidemic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29dacaf7-3b19-3f4f-84d2-11deb0675605",
                                        "entry_id": "28ce6a1e-7d31-39c1-aa91-6010cca33d11",
                                        "glosses": [
                                            "Of, related to, or being an epidemic: a widespread outbreak of disease in humans."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f01755a-c4a3-389d-ae76-91b5e57e22df",
                                        "entry_id": "28ce6a1e-7d31-39c1-aa91-6010cca33d11",
                                        "glosses": [
                                            "Like an epidemic: widespread in a bad way."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f2b54ad-64a2-488d-b0d0-0b918ae074fb",
                                                "sense_id": "6f01755a-c4a3-389d-ae76-91b5e57e22df",
                                                "text": "Epidemic hysteria occurred upon the incumbent’s reelection."
                                            },
                                            {
                                                "example_id": "25cb6fc6-a6c7-488b-be69-e93f0e87eb32",
                                                "sense_id": "6f01755a-c4a3-389d-ae76-91b5e57e22df",
                                                "text": "[In] May, there was, at London and in its neighbourhood, a disease very epidemic, though not fatal, which had some time before been very prevalent both in Italy and Germany."
                                            },
                                            {
                                                "example_id": "7d57423b-be3b-4ddf-9360-b9f401f52a79",
                                                "sense_id": "6f01755a-c4a3-389d-ae76-91b5e57e22df",
                                                "text": "The major reason for such an examination was to determine if any patterns uncovered seemed to be more epidemic than endemic."
                                            },
                                            {
                                                "example_id": "0c094fe2-55c6-4711-be6c-be3dc8a86128",
                                                "sense_id": "6f01755a-c4a3-389d-ae76-91b5e57e22df",
                                                "text": "This proportion increased about 5% from 1988 to 1992—hardly a change of epidemic proportions."
                                            },
                                            {
                                                "example_id": "c88bd35f-bb2c-4219-81b3-5796591b602a",
                                                "sense_id": "6f01755a-c4a3-389d-ae76-91b5e57e22df",
                                                "text": "This was the stagecoach holdup, and while these encounters were not as epidemic as we like to remember, nonetheless there were numerous bands of \"road agents\" who lay by the roadside in wait for passengers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "112b9c46-d6c4-49d1-8dc8-d26ce3bbaea3",
                        "source_entry_id": "33acf61d-53db-3350-a739-f15f7901151c",
                        "source_sense_id": "8553a82b-a207-3a2e-97ee-a71a919620ee",
                        "source_sense_description": "besmettelijke ziekte die zich snel verspreidt onder een groep van mensen",
                        "target_lang_word": "épidémie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épidémie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8af086b5-0c47-328e-8859-34f65ff4b0ee",
                                        "entry_id": "05768d77-c738-3c63-9eb5-0108ec7296a1",
                                        "glosses": [
                                            "Apparition soudaine et propagation rapide d’une maladie infectieuse, animale, végétale ou humaine, qui atteint en même temps, dans une région donnée, un nombre de cas supérieur à ce qui est normalement attendu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9a6343f-8eb9-4295-916e-a73c79db6822",
                                                "sense_id": "8af086b5-0c47-328e-8859-34f65ff4b0ee",
                                                "text": "Mais comme la mère Désiré agonisait et que quelques autres ne valaient guère mieux, il jugea que l’enquête rigoureuse et sévère qui s’imposait devait lui faire découvrir la source occulte de cette extraordinaire épidémie."
                                            },
                                            {
                                                "example_id": "9031ba98-ee38-4238-ae05-ccbfc65449e7",
                                                "sense_id": "8af086b5-0c47-328e-8859-34f65ff4b0ee",
                                                "text": "Soudain une épidémie de typhoïde ravagea le village. Coup sur coup, les morts s'amoncelaient."
                                            },
                                            {
                                                "example_id": "5e6807c4-053d-4f57-a168-b57618e4f308",
                                                "sense_id": "8af086b5-0c47-328e-8859-34f65ff4b0ee",
                                                "text": "Leur pouvoir était illimité ; ils guérissaient les malades abandonnés des médecins, rendaient fécondes les terres stériles, arrêtaient les épidémies de bestiaux, mais ils n’étaient point toujours d’humeur à ces sorcelleries bienfaisantes."
                                            },
                                            {
                                                "example_id": "f89c8ff0-b096-49d7-b1f0-7bd94471f800",
                                                "sense_id": "8af086b5-0c47-328e-8859-34f65ff4b0ee",
                                                "text": "A Singapour, en 1967, au moment même où la chute de la fécondité atteint sa vitesse maximale, se déclenche une épidemie de Koro, manifestation hystérique spécifiquement masculine. Les individus touchés craignent et perçoivent une rétraction de leur pénis, qui menace, disent-ils, de disparaître dans l'abdomen."
                                            },
                                            {
                                                "example_id": "cf84887d-7236-42d7-af6a-e4a23b3ec3a3",
                                                "sense_id": "8af086b5-0c47-328e-8859-34f65ff4b0ee",
                                                "text": "Dans une petite commune telle que Drain, l’épidémie de peste de 1563 fit 153 morts qui furent enterrés ensemble à l'endroit où se dresse la croix commémorative du Moulin-Moreau, sur la route de Saint-Laurent-des-Autels."
                                            },
                                            {
                                                "example_id": "4fe07364-291c-4efd-9b07-4b799fe390ed",
                                                "sense_id": "8af086b5-0c47-328e-8859-34f65ff4b0ee",
                                                "text": "Francis Hallé : Une épidémie, par exemple une attaque bactérienne, ça ne tue jamais 100 % des arbres. Ça s’est passé avec les ormes il y a quelques années. Presque tous les ormes ont disparu, mais pas tous ! Il reste des ormes résistants."
                                            },
                                            {
                                                "example_id": "9f3c695a-50b2-4451-8270-71354d5e02b4",
                                                "sense_id": "8af086b5-0c47-328e-8859-34f65ff4b0ee",
                                                "text": "Quelques invités et festivaliers se sont désistés au dernier moment, en raison de la reprise de l’épidémie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "700c5136-4216-3b65-81f1-328b252fafde",
                                        "entry_id": "05768d77-c738-3c63-9eb5-0108ec7296a1",
                                        "glosses": [
                                            "Cette maladie elle-même."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2b10f790-c6b3-3bc5-994e-78241fc81885",
                                        "entry_id": "05768d77-c738-3c63-9eb5-0108ec7296a1",
                                        "glosses": [
                                            "Engouement qui atteint un grand nombre de personnes."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cf1620e-776a-4c71-94e2-fb4c32ade574",
                                                "sense_id": "2b10f790-c6b3-3bc5-994e-78241fc81885",
                                                "text": "Une véritable épidémie de petits drapeaux et d’insignes pour boutonnières s’abattit sur les torrents de jeunesse laborieuse et pressée […]. Il était dangereux de ne pas avoir d’insignes patriotiques au revers de l’habit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9eeb3620-7c98-4eb3-8941-8e5fb2ef8e9c",
                        "source_entry_id": "33acf61d-53db-3350-a739-f15f7901151c",
