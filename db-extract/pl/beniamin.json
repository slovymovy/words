                                        "entry_id": "a960ea71-3752-39d9-ac09-66f99dcca603",
                                        "glosses": [
                                            "jüngste Person innerhalb einer Gruppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aedb1398-6d89-43f3-9b12-1c53b392603f",
                                                "sense_id": "a3eb4e77-106d-3a6f-ae8c-99f799cc7ff0",
                                                "text": "In diesem Jahr organisierte der LAC Eupen für die jüngsten Altersklassen, das heißt für die Benjamine, die Pupilles und die Minimes, zum ersten Mal eine interne Challenge."
                                            },
                                            {
                                                "example_id": "9646c8c0-8c08-4b92-a166-81741f76a07b",
                                                "sense_id": "a3eb4e77-106d-3a6f-ae8c-99f799cc7ff0",
                                                "text": "Die Benjamine unter den Frankfurter Galerien sind die Unternehmen von Ernst Fischer und Ursula Lichter."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Benjamin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab871878-6955-3124-9e57-7c31fcb58643",
                                        "entry_id": "def0b93a-7c93-337a-a5fd-91bfa8d8dc0e",
