                {
                    "sense_id": "4fd56909-afd5-3e92-9865-f7f5d045e2df",
                    "sense_definition": "Летательный аппарат тяжелее воздуха с жёстким неподвижным крылом и собственным мотором.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "транспорт",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пассажирский <w>самолёт</w> совершил посадку в аэропорту.",
                            "target_lang_translations": {
                                "en": "The passenger <w>airplane</w> landed at the airport."
                            }
                        },
                        {
                            "text": "Мы летели на огромном <w>самолёте</w> через весь океан.",
                            "target_lang_translations": {
                                "en": "We flew on a huge <w>plane</w> across the entire ocean."
                            }
                        }
                    ],
                    "synonyms": [
                        "аэроплан"
                    ],
                    "common_phrases": [
                        "пассажирский самолёт",
                        "военный самолёт"
                    ],
                    "target_lang_definitions": {
                        "en": "A powered heavier-than-air aircraft with fixed wings."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "airplane",
                                "target_lang_sense_clarification": "Common term in North American English for a powered aircraft."
                            },
                            {
                                "target_lang_word": "aeroplane",
                                "target_lang_sense_clarification": "Common term in British and Commonwealth English for a powered aircraft."
                            },
                            {
                                "target_lang_word": "plane",
                                "target_lang_sense_clarification": "Informal, widely used term for an aircraft."
                            },
                            {
                                "target_lang_word": "aircraft",
                                "target_lang_sense_clarification": "A more formal or technical term covering all vehicles capable of flight."
                            }
                        ]
                    }
                },
                {
