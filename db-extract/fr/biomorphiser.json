                "senses": [
                    {
                        "sense_id": "d286b4d5-3f3a-3b6a-81ef-b28df3ed820a",
                        "entry_id": "d5ab56df-7a2e-3ba0-b592-fdc93ce4eef5",
                        "glosses": [
                            "Faire ressembler à des formes du vivant, donner un caractère biomorphique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bea46896-4194-493a-a64a-80beaebc2779",
                                "sense_id": "d286b4d5-3f3a-3b6a-81ef-b28df3ed820a",
                                "text": "Les avions volent : il n'a pas été considéré que c'était \"biomorphiser\" que de réutiliser ce verbe défini à l'origine pour les oiseaux ou les insectes."
                            },
                            {
                                "example_id": "290c6c20-7dd4-4aec-a2d2-8783be1f525f",
                                "sense_id": "d286b4d5-3f3a-3b6a-81ef-b28df3ed820a",
                                "text": "Notre environnement physique se « biomorphise », tant pour ce qui est des objets physiques que de leurs interfaces."
                            }
                        ]
                    }
