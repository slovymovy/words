                "senses": [
                    {
                        "sense_id": "5a1fdbbd-5ba9-3ecf-a427-dbd4100db599",
                        "entry_id": "be9f45af-6eb4-3d64-8db9-abdba0b5ca27",
                        "glosses": [
                            "дорожная сумка или чехол для пледа и постельных принадлежностей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e4d1b9e-f821-4fad-bc8d-4dff397c4b17",
                                "sense_id": "5a1fdbbd-5ba9-3ecf-a427-dbd4100db599",
                                "text": "Он достал из портпледа свой бухарский халат и подушку, лёг и укрылся халатом."
                            },
                            {
                                "example_id": "b12fb813-e759-444b-831e-f8cb624a0d5f",
                                "sense_id": "5a1fdbbd-5ba9-3ecf-a427-dbd4100db599",
                                "text": "Лара со свойственною ей быстротой носилась от портпледа к портпледу, распихивала подушки, стягивала ремни и только умоляла Пашу и дворничиху не помогать, чтобы не мешать ей."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e162f69d-456c-4f09-82e9-9011edcf251c",
                        "source_entry_id": "be9f45af-6eb4-3d64-8db9-abdba0b5ca27",
                        "source_sense_id": "5a1fdbbd-5ba9-3ecf-a427-dbd4100db599",
                        "target_lang_word": "holdall",
