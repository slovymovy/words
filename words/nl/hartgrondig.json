            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5c87039d-d7ca-3a43-816a-167250e6fdd2",
                    "sense_definition": "uit het diepst van het hart komend en zeer oprecht gemeend",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij sprak haar <w>hartgrondige</w> dank uit aan iedereen die had geholpen bij de zoekactie.",
                            "target_lang_translations": {
                                "fr": "Elle a exprimé ses remerciements <w>du fond du cœur</w> à tous ceux qui avaient aidé aux recherches."
                            }
                        },
                        {
                            "text": "Hij wenste haar met een <w>hartgrondige</w> glimlach veel succes met haar nieuwe baan.",
                            "target_lang_translations": {
                                "fr": "Il lui a souhaité beaucoup de succès dans son nouvel emploi avec un sourire <w>chaleureux</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "oprecht",
                        "innig"
                    ],
                    "antonyms": [
                        "onoprecht",
                        "oppervlakkig"
                    ],
                    "common_phrases": [
                        "hartgrondige dank"
                    ],
                    "target_lang_definitions": {
                        "fr": "Venant du plus profond du cœur et exprimé avec une grande sincérité"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "du fond du cœur",
                                "target_lang_sense_clarification": "exprimé sincèrement et profondément"
                            },
                            {
                                "target_lang_word": "sincère",
                                "target_lang_sense_clarification": "authentique, sans feinte"
                            },
                            {
                                "target_lang_word": "chaleureux",
                                "target_lang_sense_clarification": "plein d'émotion et de bienveillance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b980fdb-75d0-3fd0-8a7e-6e3038837e68",
                    "sense_definition": "buitengewoon intens en diep gevoeld, vooral gezegd van afkeer of ergernis",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb een <w>hartgrondige</w> hekel aan mensen die altijd te laat komen op afspraken.",
                            "target_lang_translations": {
                                "fr": "J'ai une aversion <w>viscérale</w> pour les personnes qui arrivent toujours en retard aux rendez-vous."
                            }
                        },
                        {
                            "text": "Na de lange vergadering slaakte de directeur een <w>hartgrondige</w> zucht van verlichting.",
                            "target_lang_translations": {
                                "fr": "Après la longue réunion, le directeur poussa un <w>profond</w> soupir de soulagement."
                            }
                        }
                    ],
                    "synonyms": [
                        "intens"
                    ],
                    "common_phrases": [
                        "hartgrondige hekel",
                        "hartgrondig oneens zijn"
                    ],
                    "target_lang_definitions": {
                        "fr": "Extrêmement intense et profondément ressenti, en particulier en parlant de dégoût, de haine ou d'exaspération"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "profond",
                                "target_lang_sense_clarification": "intense, ressenti au plus profond de soi"
                            },
                            {
                                "target_lang_word": "viscéral",
                                "target_lang_sense_clarification": "irrationnel et puissant (dégoût, aversion)"
                            },
                            {
                                "target_lang_word": "véritable",
                                "target_lang_sense_clarification": "intense et incontestable"
                            }
                        ]
                    }
                }
            ]
        }
    ]
