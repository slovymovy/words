                        "glosses": [
                            "pain de forme circulaire, aux graines de sésame, très commun en Turquie et en Arménie similaire au koulouri grec."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1d60810-2b13-41c0-a672-d4c5fba4a0cc",
                                "sense_id": "b4e5ef98-ad57-376e-aa42-03e11293ec4d",
                                "text": "La trentaine, chemise blanche, costume noir, l’homme élégant tend un sachet de simit, ces bagels turcs qu’on trouve un peu partout dans Istanbul, à un groupe d’étudiants communistes émergeant d’une tente, place Taksim."
                            },
                            {
                                "example_id": "2c266928-948e-458f-80f3-06c892d2473c",
                                "sense_id": "b4e5ef98-ad57-376e-aa42-03e11293ec4d",
                                "text": "Dans le grand hall grouillant de monde, un marchand ambulant s’approcha d’aux pour leur proposer des simits, sortes de bretzels, …."
                            }
                        ]
                    }
