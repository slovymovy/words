                            {
                                "example_id": "2327a5ea-0f41-4ec2-bcf0-9194b85d34ac",
                                "sense_id": "293ff685-0356-3826-9140-bb07996c4ffd",
                                "text": "Mam na imię Konrad i jestem infirmarzem z Katowic."
                            }
