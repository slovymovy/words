    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "88c6159a-8c21-334b-bfa7-11f21e673e8a",
                "word": "regift",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "db3c6f52-9d93-4156-a7db-8e45779916ac",
                        "entry_id": "88c6159a-8c21-334b-bfa7-11f21e673e8a",
                        "tags": [
                            "plural"
                        ],
                        "form": "regifts"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "41d3e4fe-7731-3b9d-ba43-aa6e3aa477b8",
                        "entry_id": "88c6159a-8c21-334b-bfa7-11f21e673e8a",
                        "glosses": [
                            "A gift which has been given to a second or subsequent recipient."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "ea88936c-8483-4e7c-9c07-a4e4ed4d5dd3",
                                "sense_id": "41d3e4fe-7731-3b9d-ba43-aa6e3aa477b8",
                                "text": "Fortunately, I'd brought a selection of consolation prizes, Christmas regifts all, and so Ritchie the stranded F-250 driver became the recipient of a very nice scented candle."
                            },
                            {
                                "example_id": "b1c6334b-1521-408c-b3cf-42ac7a536a52",
                                "sense_id": "41d3e4fe-7731-3b9d-ba43-aa6e3aa477b8",
                                "text": "Some regifts, particularly distinctive ones, may make the rounds (see “How to Repurpose a Fruitcake,” facing page) and end up being regifted to the original giver, a situation you may find hard to explain."
                            },
                            {
                                "example_id": "9824d4c2-c5ce-4734-98fa-315c8e0c90a0",
                                "sense_id": "41d3e4fe-7731-3b9d-ba43-aa6e3aa477b8",
                                "text": "Food and drink are the most likely type of unwanted items to be passed along, accounting for 35 percent of all regifts, versus 23 percent for beauty and bath products and 18 percent for trinkets and collectibles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c444e8b6-19f7-4b3e-9dc8-b118b9ca2544",
                        "source_entry_id": "88c6159a-8c21-334b-bfa7-11f21e673e8a",
                        "source_sense_id": "41d3e4fe-7731-3b9d-ba43-aa6e3aa477b8",
                        "source_sense_description": "thing given as a gift that was previously received as a gift",
                        "target_lang_word": "regalo riciclato",
                        "target_lang_code": "it",
