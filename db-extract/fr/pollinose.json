                        "entry_id": "83b5dbc4-6351-3eeb-be95-0375e169bc2b",
                        "glosses": [
                            "Allergie au pollen."
                        ],
                        "tags": [
                            "Nosologie"
                        ],
                        "examples": [
                            {
                                "example_id": "844dd287-1014-4750-97bc-a212256b468d",
                                "sense_id": "d71dae1d-86c1-302a-972d-c389cc962311",
                                "text": "On appelle pollinose ou allergie au pollen, une affection allergique provoquée par le pollen contenu dans les étamines et disséminés soit par le vent, soit par les insectes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d1e1bf63-54d6-492f-a5eb-bf2dfecdebb8",
                        "source_entry_id": "83b5dbc4-6351-3eeb-be95-0375e169bc2b",
                        "source_sense_id": "d71dae1d-86c1-302a-972d-c389cc962311",
                        "target_lang_word": "Heuschnupfen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heuschnupfen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4f32e19a-58dc-3d03-9490-919fe8c77297",
                                        "entry_id": "f3c8ddd6-07f0-31dd-a184-362a9827d7be",
                                        "glosses": [
                                            "Pollenallergie; saisonaler allergischer Schnupfen, der entsteht, wenn Allergene die Nasenschleimhaut reizen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3de2d89-acfe-4d70-901d-267f4b64b62a",
                                                "sense_id": "4f32e19a-58dc-3d03-9490-919fe8c77297",
                                                "text": "Hinter einem scheinbar klassischen Heuschnupfen kann sich auch eine Pilzsporenallergie verbergen, bzw. sie kann mit der Pollenallergie kombiniert sein."
                                            },
                                            {
                                                "example_id": "5f477ad8-f991-4b1f-88b3-1fcce5d95e3f",
                                                "sense_id": "4f32e19a-58dc-3d03-9490-919fe8c77297",
                                                "text": "Heuschnupfen ist eine häufige allergische Erkrankung, die auf einer Überempfindlichkeit gegen die Eiweißkomponenten von bestimmten Pollen beruht. Pollen gelangen während der Gräser- und Baumblüte in die Luft. Sie bewirken an den Schleimhäuten der Atemwege, der Nase und den Augen eine allergische Reaktion. (Internetbeleg)"
                                            },
                                            {
                                                "example_id": "5cd45393-9eff-4ebf-bdd1-aedbd8be5c19",
                                                "sense_id": "4f32e19a-58dc-3d03-9490-919fe8c77297",
                                                "text": "Woher weiß ich, ob ich eine Erkältung habe oder an Heuschnupfen leide? (Internetbeleg)"
                                            },
                                            {
                                                "example_id": "018e712a-c171-4b24-9a1e-6c40e675fce7",
                                                "sense_id": "4f32e19a-58dc-3d03-9490-919fe8c77297",
                                                "text": "Jeder dritte bis vierte nicht behandelte Heuschnupfen geht in ein allergisches Asthma mit lebensbedrohlichen Risiken über. (Internetbeleg)"
                                            },
                                            {
                                                "example_id": "4cf06872-a08b-43db-8678-c62ed88c18df",
                                                "sense_id": "4f32e19a-58dc-3d03-9490-919fe8c77297",
                                                "text": "„Im Sommer leidet er furchtbar an Heuschnupfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
