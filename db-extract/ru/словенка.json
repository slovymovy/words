                                        "glosses": [
                                            "Habitant de la Slovénie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aa04f2b-f8da-4c2b-977d-a16b5546bc36",
                                                "sense_id": "a1ce377a-966a-35c8-b260-9dc36e56a355",
                                                "text": "Les Slovènes avaient directement basculé – après deux guerres mondiales – des gracieusetés de l’Empire austro-baroque à la bétonification socialiste."
                                            },
                                            {
                                                "example_id": "50fee947-6cd9-4a27-82fb-f462075e674c",
                                                "sense_id": "a1ce377a-966a-35c8-b260-9dc36e56a355",
                                                "text": "Il faudra toutefois se mesurer au Marseillais Denis Gargaud-Chanut, champion olympique à Rio en 2016, qui a devancé le Slovène Benjamin Savsek, champion olympique en titre."
                                            },
                                            {
                                                "example_id": "3c6a15cb-419e-4fa8-a946-c258ed2cc75c",
                                                "sense_id": "a1ce377a-966a-35c8-b260-9dc36e56a355",
                                                "text": "Le Slovène ne participera ni à Gand-Wevelgem, dimanche, ni à À travers la Flandre, mercredi."
                                            }
                                        ]
