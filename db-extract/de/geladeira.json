                        "glosses": [
                            "kastenförmiges, einem Schrank ähnliches, gegen Wärme isoliertes und mit einem Kühlsystem ausgestattetes Behältnis, in dem leicht verderbliche Lebensmittel kühl aufbewahrt werden, um sie frischzuhalten"
                        ],
                        "tags": [
                            "Brasilien",
                            "(Rio Grande do Sul)"
                        ],
                        "examples": [
                            {
                                "example_id": "af9db50b-11bd-464d-ad13-e40a6512444c",
                                "sense_id": "7afe329c-8b62-3315-b27f-aafc6bf8ade5",
                                "text": "„Wenn es am Wochenend ned chuvt [= regnet], holen wir Bier aus der geladeira und fahrn an die praia.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
