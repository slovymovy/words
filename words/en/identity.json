{
    "word_family": [
        "identify",
        "identical",
        "identification",
        "identifiable",
        "identically"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5944abb3-d874-373a-86df-7068650aa1eb",
                    "sense_definition": "The characteristics, feelings, or beliefs that distinguish people from others; the sense of who a person or group is.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "selfhood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Moving to a new country can sometimes make you lose your sense of <w>identity</w>.",
                            "target_lang_translations": {
                                "ru": "Переезд в новую страну иногда может заставить вас потерять чувство собственной <w>идентичности</w>.",
                                "zh": "移居到一个新的国家有时会让你失去<w>身份</w>认同感。"
                            }
                        },
                        {
                            "text": "The nation has maintained a strong cultural <w>identity</w> despite recent changes.",
                            "target_lang_translations": {
                                "ru": "Нация сохранила сильную культурную <w>идентичность</w>, несмотря на недавние перемены.",
                                "zh": "尽管近期发生了变化，这个国家依然保持着强烈的文化<w>身份</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "individuality",
                        "personality",
                        "selfhood",
                        "personhood"
                    ],
                    "common_phrases": [
                        "sense of identity",
                        "cultural identity",
                        "national identity",
                        "lose one's identity",
                        "search for identity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеристики, чувства или убеждения, которые отличают людей от других; осознание того, кем является человек или группа.",
                        "zh": "指一个人或群体的特征、情感或信仰，即关于“我是谁”的自我认知。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "идентичность",
                                "target_lang_sense_clarification": "осознание своей принадлежности к группе или своих особенностей"
                            },
                            {
                                "target_lang_word": "индивидуальность",
                                "target_lang_sense_clarification": "совокупность характерных черт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "身份",
                                "target_lang_sense_clarification": "指个人或群体的自我认知或社会属性"
                            },
                            {
                                "target_lang_word": "特性",
                                "target_lang_sense_clarification": "指区别于他人的独特品质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a66c0aa0-4f49-3daf-987b-843a39c34ae1",
                    "sense_definition": "The name or official proof of who a person is.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "official_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police are trying to establish the <w>identity</w> of the suspect found at the scene.",
                            "target_lang_translations": {
                                "ru": "Полиция пытается установить <w>личность</w> подозреваемого, найденного на месте происшествия.",
                                "zh": "警方正在试图确认在现场发现的嫌疑人的<w>身份</w>。"
                            }
                        },
                        {
                            "text": "You must prove your <w>identity</w> before entering the secure building.",
                            "target_lang_translations": {
                                "ru": "Вы должны подтвердить свою <w>личность</w> перед входом в охраняемое здание.",
                                "zh": "进入这座安保大楼前，你必须证明自己的<w>身份</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "identity card",
                        "identity theft",
                        "mistaken identity",
                        "prove one's identity",
                        "reveal identity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имя или официальное подтверждение того, кем является человек.",
                        "zh": "指一个人的姓名或证明其身份的官方凭证。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "личность",
                                "target_lang_sense_clarification": "конкретный человек, чьи данные устанавливаются"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "身份",
                                "target_lang_sense_clarification": "指个人的官方身份或法律地位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "437d91bf-263d-31d0-bc93-f2665700e49c",
                    "sense_definition": "The fact of being exactly the same as something else.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sameness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>identity</w> of the two chemical samples was confirmed by the laboratory.",
                            "target_lang_translations": {
                                "ru": "<w>Идентичность</w> двух химических образцов была подтверждена лабораторией.",
                                "zh": "实验室确认了这两个化学样本的<w>同一性</w>。"
                            }
                        },
                        {
                            "text": "Philosophers often debate the <w>identity</w> of the mind and the brain.",
                            "target_lang_translations": {
                                "ru": "Философы часто спорят о <w>тождественности</w> разума и мозга.",
                                "zh": "哲学家们经常争论心灵与大脑的<w>同一性</w>问题。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sameness",
                        "identicalness",
                        "uniformity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Факт полного сходства или совпадения с чем-либо другим.",
                        "zh": "指事物之间完全相同或一致的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тождественность",
                                "target_lang_sense_clarification": "полное совпадение"
                            },
                            {
                                "target_lang_word": "идентичность",
                                "target_lang_sense_clarification": "полное сходство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "同一性",
                                "target_lang_sense_clarification": "指事物在本质上完全相同"
                            },
                            {
                                "target_lang_word": "一致性",
                                "target_lang_sense_clarification": "指事物之间没有差别"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4826d9e6-70fe-3ee8-8e45-a695e330ede1",
                    "sense_definition": "An equation that is true for all possible values of its variables.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student wrote a complex algebraic <w>identity</w> on the chalkboard.",
                            "target_lang_translations": {
                                "ru": "Студент написал на доске сложное алгебраическое <w>тождество</w>.",
                                "zh": "学生在黑板上写下了一个复杂的代数<w>恒等式</w>。"
                            }
                        },
                        {
                            "text": "Proving this trigonometric <w>identity</w> is a key part of the final exam.",
                            "target_lang_translations": {
                                "ru": "Доказательство этого тригонометрического <w>тождества</w> является ключевой частью итогового экзамена.",
                                "zh": "证明这个三角<w>恒等式</w>是期末考试的关键部分。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "algebraic identity",
                        "trigonometric identity"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "mathematics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Равенство, которое верно для всех возможных значений входящих в него переменных.",
                        "zh": "数学中指对于变量的所有取值都成立的等式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тождество",
                                "target_lang_sense_clarification": "математическое равенство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "恒等式",
                                "target_lang_sense_clarification": "数学术语，指恒等关系"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be6cdf7b-9fa3-320b-9c59-e9a30f84f7fa",
                    "sense_definition": "An element, such as zero in addition or one in multiplication, that leaves another element unchanged when combined with it.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the field of real numbers, zero serves as the additive <w>identity</w>.",
                            "target_lang_translations": {
                                "ru": "В поле вещественных чисел ноль служит аддитивным <w>нейтральным элементом</w>.",
                                "zh": "在实数域中，零作为加法<w>单位元</w>。"
                            }
                        },
                        {
                            "text": "The concept of an <w>identity</w> is fundamental to understanding group theory.",
                            "target_lang_translations": {
                                "ru": "Понятие <w>нейтрального элемента</w> фундаментально для понимания теории групп.",
                                "zh": "<w>单位元</w>的概念对于理解群论至关重要。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "additive identity",
                        "multiplicative identity",
                        "identity element"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "mathematics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Элемент (например, ноль при сложении), который оставляет другой элемент неизменным при соединении с ним.",
                        "zh": "数学中指与另一个元素结合时，该元素保持不变的特殊元素（如加法中的0或乘法中的1）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нейтральный элемент",
                                "target_lang_sense_clarification": "в математике"
                            },
                            {
                                "target_lang_word": "единичный элемент",
                                "target_lang_sense_clarification": "в теории групп"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "单位元",
                                "target_lang_sense_clarification": "代数结构中的中性元素"
                            },
                            {
                                "target_lang_word": "恒等元",
                                "target_lang_sense_clarification": "数学中保持运算结果不变的元素"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1431f939-d5a7-3208-a08c-81630c348e12",
                    "sense_definition": "A well-known or famous person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>identity</w> was honored for his contributions to the town history.",
                            "target_lang_translations": {
                                "ru": "Местную <w>знаменитость</w> чествовали за вклад в историю города.",
                                "zh": "这位当地的<w>名人</w>因其对小镇历史的贡献而受到表彰。"
                            }
                        },
                        {
                            "text": "Several sporting <w>identities</w> attended the charity gala last night.",
                            "target_lang_translations": {
                                "ru": "Несколько спортивных <w>знаменитостей</w> посетили благотворительный гала-вечер вчера.",
                                "zh": "几位体育界的<w>知名人士</w>出席了昨晚的慈善晚宴。"
                            }
                        }
                    ],
                    "synonyms": [
                        "celebrity",
                        "personality"
                    ],
                    "target_lang_definitions": {
                        "ru": "Хорошо известный или знаменитый человек.",
                        "zh": "指社会上知名或有影响力的人物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "знаменитость",
                                "target_lang_sense_clarification": "известная персона"
                            },
                            {
                                "target_lang_word": "известная личность",
                                "target_lang_sense_clarification": "человек, известный в обществе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "名人",
                                "target_lang_sense_clarification": "指广为人知的人"
                            },
                            {
                                "target_lang_word": "知名人士",
                                "target_lang_sense_clarification": "指在特定领域有声望的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}