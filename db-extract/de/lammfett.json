                "senses": [
                    {
                        "sense_id": "8798d85d-3117-3e35-be9a-b68fe39f362b",
                        "entry_id": "a7c006a4-9675-38fe-b3cc-810b40017fcb",
                        "glosses": [
                            "Fett vom Lamm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95b4459e-f2ff-413f-b5a1-c2259d0d8d71",
                                "sense_id": "8798d85d-3117-3e35-be9a-b68fe39f362b",
                                "text": "„Mit Lammfett versetzter Wein in frisch versiegelten Krügen und die erlesensten Früchte der Jahreszeit waren auf Schüsseln hoch aufgetürmt.“"
                            },
                            {
                                "example_id": "2fee375a-cb3d-4692-9db8-757a45901713",
                                "sense_id": "8798d85d-3117-3e35-be9a-b68fe39f362b",
                                "text": "„Vergehen des Monats: Briet sich Lammkoteletts und spülte nicht nur die fettverschmierte Pfanne nicht ab, sondern versteckte sie auch noch im Backofen, so dass sich die Küche mit dem beißenden Gestank von zweimal erhitztem Lammfett füllte, als ich Ofenkartoffeln machen wollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
