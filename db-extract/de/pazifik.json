                ],
                "senses": [
                    {
                        "sense_id": "dfa5b4b1-a479-3d84-9664-5f26c4cea645",
                        "entry_id": "734f9462-0c26-3703-84e4-6e0fb62d90bf",
                        "glosses": [
                            "Kurzform für den Pazifischer Ozean"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "74d937ba-5491-43c6-a7a9-c210f3ff71e8",
                                "sense_id": "dfa5b4b1-a479-3d84-9664-5f26c4cea645",
                                "text": "Der Pazifik ist der größte der Ozeane."
                            },
                            {
                                "example_id": "2f582089-9532-447a-b666-14d02581226f",
                                "sense_id": "dfa5b4b1-a479-3d84-9664-5f26c4cea645",
                                "text": "„Damals war Abenddämmerung gewesen und die Nacht, aus dem Osten kommend, jagte den Zug und überholte ihn, überschritt die Rocky Mountains und eilte bis an den Pazifik.“"
                            },
                            {
                                "example_id": "b9260c21-9838-41ee-9bf9-72ab61351be2",
                                "sense_id": "dfa5b4b1-a479-3d84-9664-5f26c4cea645",
                                "text": "„Während andere Entdecker die Passage vom Atlantik aus gesucht hatten, sollte Cook es im hohen Norden des Pazifiks versuchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
