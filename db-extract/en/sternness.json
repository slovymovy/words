                "word": "sternness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0569e1fe-77ab-4dae-b880-072cb1c9132e",
                        "entry_id": "11c8e570-6f1a-3cab-bb0b-41b9dc75b878",
                        "tags": [
