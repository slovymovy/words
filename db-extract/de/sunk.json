                ],
                "senses": [
                    {
                        "sense_id": "1f8b80e4-1483-3e11-ace3-8791cd47cd6e",
                        "entry_id": "8c6e7927-bf4e-3a16-ab57-481bf027936a",
                        "glosses": [
                            "Absinken eines Wasserstandes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd7e63eb-03ab-48dc-aa20-e3cdacae30f0",
                                "sense_id": "1f8b80e4-1483-3e11-ace3-8791cd47cd6e",
                                "text": "„Auch wenn der Sunk die feste Wand bei A erreicht hat und sich die ursprüngliche Wassertiefe t wieder einstellt, strömt weiter Wasser zum See ab. Der Sunk eilt deshalb von A nach B zurück.“"
                            },
                            {
                                "example_id": "5eca5dc2-2af6-4cce-9b52-503acccf2460",
                                "sense_id": "1f8b80e4-1483-3e11-ace3-8791cd47cd6e",
                                "text": "„Die Geschwindigkeitshöhe des Sunkes muß gleich oder größer sein als die Gegendruckhöhe, wenn sich noch ein Sunk ausbilden soll.“"
                            },
                            {
                                "example_id": "fae796ca-4756-428f-83ed-37a34cafe86d",
                                "sense_id": "1f8b80e4-1483-3e11-ace3-8791cd47cd6e",
                                "text": "„Stets bleibt dabei der Übergang von der Stauanlagen – und Kraftwerkstreppe zum freien Fluß die besonders zu beachtende Stelle, weil sich dort sowohl ein plötzlicher Sunk infolge Generalkurzschluß der Flußkraftwerke als auch ein zu großer Rückhalt für die Schiffahrt besonders nachteilig bemerkbar machen.“"
                            },
                            {
                                "example_id": "24b6330b-4391-437b-9508-c53c6293e5cc",
                                "sense_id": "1f8b80e4-1483-3e11-ace3-8791cd47cd6e",
                                "text": "„Wichtige Bemessungsgrößen sind: […] die maximale Füllwassermenge, um den Sunk im oberen Vorhafen und damit Bewegungen dort wartender Schiffe nicht zu groß werden zu lassen, […]“"
                            },
                            {
                                "example_id": "dc7ad1ad-0312-4032-bffa-57c5e0e0e8e4",
                                "sense_id": "1f8b80e4-1483-3e11-ace3-8791cd47cd6e",
                                "text": "„Der beim Abschluß des Stollens entstehende Sunk wird in seiner Größe durch die Wassermenge Q bestimmt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
