                                "example_id": "05dc2229-3d93-4573-8a43-f24a0715e798",
                                "sense_id": "6748f2a6-a229-35ba-ac64-e55a971d5ae8",
                                "text": "How vividly with the recital of these old customs memory reverts to the other quaint and fantastic forms New England piety took on — to the pastor who could hairsplit by the hour 'twixt Free Will and Election"
                            },
                            {
                                "example_id": "c18d40c5-80ce-4b3a-840d-10c9d1fcbe0b",
                                "sense_id": "6748f2a6-a229-35ba-ac64-e55a971d5ae8",
                                "text": "We are not disposed to refine and hairsplit so as to nullify these wise provisions of the statute"
                            }
                        ]
