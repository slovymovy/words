                        "translation_id": "908daebe-a661-4684-b85b-84c4e8c89fe9",
                        "source_entry_id": "cfce70c2-818f-365a-8314-0193c024cf34",
                        "source_sense_id": "8b7ea980-cffa-3776-9d23-f3e33ee5d710",
