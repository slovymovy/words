                        "glosses": [
                            "drukgradiënt tussen twee verschillende ruimtes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4565007c-d86e-47bc-91ab-bea826d57392",
                                "sense_id": "111545b3-b717-3345-bf55-4418888af50f",
                                "text": "De sereniteit, als oplossing voorgesteld, drong door alle poriën van zijn permeabele ziel naar binnen tot er geen enkel drukverschil meer was tussen zijn stemming en de heersende rondom."
                            },
                            {
                                "example_id": "e4f30444-41ea-49ea-99d3-489eab8b8f7c",
                                "sense_id": "111545b3-b717-3345-bf55-4418888af50f",
                                "text": "Een vrouw die naast het beschadigde raampje zat, werd gedeeltelijk naar buiten gezogen door het drukverschil, maar ze wist met hulp van passagiers weer terug te komen. De vrouw raakte zwaargewond en overleed later in het ziekenhuis. Zeven andere passagiers raakten lichtgewond."
                            }
                        ]
                    }
