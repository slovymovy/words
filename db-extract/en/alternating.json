                    {
                        "translation_id": "16e5df8e-edb0-4d63-8a71-a2bcbfdbf8ad",
                        "source_entry_id": "c6f6d102-bb81-31a9-a0cd-dc424ce0ee6d",
                        "source_sense_description": "such that it alternates",
                        "target_lang_word": "alternatif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alternatif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "30102f6a-e4da-354f-afc6-63dea2539204",
                                        "entry_id": "27241030-b602-3b45-a7da-d6434923ac80",
                                        "glosses": [
                                            "Qui se produit tour à tour, en parlant de deux choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd89bb29-d1a4-4ae9-a772-e8902ecc687e",
                                                "sense_id": "30102f6a-e4da-354f-afc6-63dea2539204",
                                                "text": "La systole et la diastole du cœur sont deux mouvements alternatifs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5bb335a-e2b2-31ed-b139-2d97ea5b567c",
                                        "entry_id": "27241030-b602-3b45-a7da-d6434923ac80",
                                        "glosses": [
                                            "Qui change de sens à intervalles réguliers."
                                        ],
                                        "tags": [
                                            "especially",
                                            "physical"
                                        ],
                                        "note": "En ce sens, il est appliqué à des notions qui impliquent un mouvement",
                                        "examples": [
                                            {
                                                "example_id": "7ec6b640-72bc-4a2e-8696-867063c4f4e7",
                                                "sense_id": "e5bb335a-e2b2-31ed-b139-2d97ea5b567c",
                                                "text": "On note une prédominance à l’emploi des réseaux alternatifs et à l’usage généralisé du triphasé 200 V/400 Hz."
                                            },
                                            {
                                                "example_id": "b858f667-7ae0-44d9-99c5-1828c6d506db",
                                                "sense_id": "e5bb335a-e2b2-31ed-b139-2d97ea5b567c",
                                                "text": "Ajoutons que le premier solarigraphe […] fut remplacé, en 1932, par un autre, lequel était muni d'un commutateur automatique spécial permettant l'usage alternatif d'un solarigraphe et d'un pyrhéliographe […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "136d92a9-8c74-33ca-909a-6be9031b4999",
                                        "entry_id": "27241030-b602-3b45-a7da-d6434923ac80",
                                        "glosses": [
                                            "Qualifie les charges des offices qui sont exercées tour à tour par deux personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7e5bd46-5858-445a-b498-036b3f688779",
                                                "sense_id": "136d92a9-8c74-33ca-909a-6be9031b4999",
                                                "text": "Une présidence alternative."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81ce8264-1ee4-3254-adb5-23c3735b66ce",
                                        "entry_id": "27241030-b602-3b45-a7da-d6434923ac80",
                                        "glosses": [
                                            "Seconde proposition ou seconde chose qui permet ou oblige à un choix (donc une alternative) entre deux propositions ou entre deux choses opposées."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0e79a05-321c-4c00-b866-340dd3de3a8a",
                                                "sense_id": "81ce8264-1ee4-3254-adb5-23c3735b66ce",
                                                "text": "Car il est clair pour tous qu'une partie de la cotisation alimente la « caisse centrale de résistance », le plus souvent nommée « caisse de grève ». Ladite caisse intervient aussi pour couvrir des dépenses relatives à des actions alternatives à la grève."
                                            },
                                            {
                                                "example_id": "a803ae6b-2dbb-44c6-b256-fd977d5a7dc3",
                                                "sense_id": "81ce8264-1ee4-3254-adb5-23c3735b66ce",
                                                "text": "La Turquie souligne également que sa coopération avec les Brics est complémentaire, et non alternative, à l'accord d'union douanière avec l'Union européenne. Le pays poursuit ses propres intérêts économiques en participant à de nombreuses organisations internationales."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0f13850-e88f-3473-a3cb-f26d2ec710f1",
                                        "entry_id": "27241030-b602-3b45-a7da-d6434923ac80",
                                        "glosses": [
                                            "Seconde proposition ou seconde chose qui permet ou oblige à un choix (donc une alternative) entre deux propositions ou entre deux choses opposées.",
                                            "Une opposition, à une idée (thèse, doctrine, etc.) en vue"
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "note": "L'Académie Française juge ce sens comme fautif",
                                        "examples": [
                                            {
                                                "example_id": "18aea59a-2591-47de-8df7-4c648f74c4dc",
                                                "sense_id": "a0f13850-e88f-3473-a3cb-f26d2ec710f1",
                                                "text": "Les théories alternatives n’ont pas à être cohérentes et peuvent même se contredire les unes les autres sur certains points. Elles reposent sur des anomalies, prétendument inexplicables, qui laissent planer un doute sur certains aspects de la version officielle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63d59b28-b345-4292-be69-91242707efa6",
