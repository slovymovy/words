                ],
                "senses": [
                    {
                        "sense_id": "a4dae6a9-b749-3631-bbd7-db2124d9148b",
                        "entry_id": "48ba242d-4670-38c7-9d58-8a941d3aea5c",
                        "glosses": [
                            "Espèce de petit quadrupède carnassier au pelage fin et recherché, appartenant à la famille des mustélidés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b58f5e3f-b7ee-4f34-acea-fa5dbaba9824",
                                "sense_id": "a4dae6a9-b749-3631-bbd7-db2124d9148b",
                                "text": "Le chat-pêcheur, la martre et le vison abondaient le long du torrent mais n’étaient point dangereux."
                            },
                            {
                                "example_id": "0edf3392-77a2-4bcf-becd-83b9cd6602b3",
                                "sense_id": "a4dae6a9-b749-3631-bbd7-db2124d9148b",
                                "text": "Il piège principalement les renards, les coyotes, les martres, les visons, les castors et les loutres depuis 40 ans."
                            },
                            {
                                "example_id": "09eeea60-351a-4bd6-b257-4ff022d560a0",
                                "sense_id": "a4dae6a9-b749-3631-bbd7-db2124d9148b",
                                "text": "Peau, queue, fourrure de martre."
                            },
                            {
                                "example_id": "6de5b87a-c0c1-4933-9610-4e9be36ec262",
                                "sense_id": "a4dae6a9-b749-3631-bbd7-db2124d9148b",
                                "text": "Les zibelines sont les plus belles des martres."
                            }
                        ]
                    },
                    {
                        "sense_id": "42a2778b-27a6-3dcf-aa96-104cfcaadc98",
                        "entry_id": "48ba242d-4670-38c7-9d58-8a941d3aea5c",
                        "glosses": [
                            "Fourrure de cet animal."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "195295be-9d61-42c4-8d30-0b361e1209b9",
                                "sense_id": "42a2778b-27a6-3dcf-aa96-104cfcaadc98",
                                "text": "Julie avança la tête hors de la calèche. Un bonnet de martre lui servait de coiffure."
                            }
                        ]
                    },
                    {
                        "sense_id": "b16074b8-955e-3149-b55a-0ecc9367199e",
                        "entry_id": "48ba242d-4670-38c7-9d58-8a941d3aea5c",
                        "glosses": [
                            "Poils de cette fourrure, utilisés en particulier pour certains pinceaux."
                        ],
                        "tags": [
                            "Peinture"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
