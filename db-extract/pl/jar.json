                "translations": [
                    {
                        "translation_id": "b8a3b614-d208-405d-8a1f-279e11db740a",
                        "source_entry_id": "2950779a-bdef-3d97-9a75-cc1303dce2f5",
                        "source_sense_id": "eabad8ce-da53-3592-8622-1ed2e7adcaa0",
                        "target_lang_word": "ravine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ravine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "08b3c2b1-c411-3f8b-9102-d8a079bac5c8",
                                        "entry_id": "cf75c4b7-21b0-3681-ae3b-07b06a3d506c",
                                        "glosses": [
                                            "A deep narrow valley or gorge in the earth's surface worn by running water."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93d0846a-5f03-473b-b212-76880998285d",
                                                "sense_id": "08b3c2b1-c411-3f8b-9102-d8a079bac5c8",
                                                "text": "Sometimes the earth stretched up towards them with peaks of mountains, sometimes it fell away in steep ravines, blue rivers sang to them as they passed above them, or very faintly came the song of breezes in lone orchards, and far away the sea sang mighty dirges of old forsaken isles."
                                            },
                                            {
                                                "example_id": "d556ae9e-f103-43f3-858e-cf254253d470",
                                                "sense_id": "08b3c2b1-c411-3f8b-9102-d8a079bac5c8",
                                                "text": "He fell into a reverie, a most dangerous state of mind for a chauffeur, since a fall into reverie on the part of a driver may mean a fall into a ravine on the part of the machine."
                                            },
                                            {
                                                "example_id": "5392f75c-ef1c-45e1-9f54-e905ed3ba51b",
                                                "sense_id": "08b3c2b1-c411-3f8b-9102-d8a079bac5c8",
                                                "text": "Thirty feet below her, where the Persians were crashing through the brush, the streambed kinked to the left side of the ravine and ran under an enormous thorn tree with a thick base."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ravine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4073deaf-8315-39d7-9d59-cfacd35fd714",
                                        "entry_id": "9b1a51e7-6dda-31a6-b10a-6bd91d090400",
                                        "glosses": [
                                            "Alternative form of raven (“rapine, rapacity; prey, plunder”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "427c3fa6-ab2a-4141-905e-9664f695c2db",
                                                "sense_id": "4073deaf-8315-39d7-9d59-cfacd35fd714",
                                                "text": "And he, shall he,\nMan, her last work, who seem’d so fair, […]\nWho trusted God was love indeed\nAnd love Creation’s final law—\nTho’ Nature, red in tooth and claw\nWith ravine, shriek’d against his creed—\nWho loved, who suffer’d countless ills,\nWho battled for the True, the Just,\nBe blown about the desert dust,\nOr seal’d within the iron hills?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "407add75-591b-47e8-9417-5403e4c495bd",
                        "source_entry_id": "2950779a-bdef-3d97-9a75-cc1303dce2f5",
                        "source_sense_id": "eabad8ce-da53-3592-8622-1ed2e7adcaa0",
                        "target_lang_word": "Klamm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klamm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b662495a-b279-387e-ac7c-5ebd579dcbf2",
                                        "entry_id": "035c6198-cf89-341d-9a50-6e34427b4eb7",
                                        "glosses": [
                                            "tiefe, enge Schlucht, durch die ein Gebirgsbach, Wildbach fließt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "486354b8-a1c6-4f6a-81cf-d127cb0b3110",
                                                "sense_id": "b662495a-b279-387e-ac7c-5ebd579dcbf2",
                                                "text": "„Zu den spektakulärsten Erlebnissen, die man auch ohne große alpine Erfahrung machen kann, zählen Wanderungen durch eine Klamm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a2ee9ea-174d-4372-80f6-a271004148bf",
                        "source_entry_id": "2950779a-bdef-3d97-9a75-cc1303dce2f5",
                        "source_sense_id": "eabad8ce-da53-3592-8622-1ed2e7adcaa0",
                        "target_lang_word": "яр",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "яр",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "dad7bf65-1887-3232-a995-a0ae517b59b7",
                                        "entry_id": "ddd27fcc-54c0-3c34-8598-5d2c71a83b34",
                                        "glosses": [
                                            "обрывистый крутой и высокий берег реки, озера, склон оврага, обрыв"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd965316-2f5a-4621-b8a9-3d62ab9eb591",
                                                "sense_id": "dad7bf65-1887-3232-a995-a0ae517b59b7",
                                                "text": "В осыпях песочных яров, образующих местами берега реки, или ручьев, в первую впадающих, находят клыки мамонтов;<…>"
                                            },
                                            {
                                                "example_id": "e94f6967-b5b1-4255-ae5b-20c60c6c33c3",
                                                "sense_id": "dad7bf65-1887-3232-a995-a0ae517b59b7",
                                                "text": "Они намерены были вести подкопы по яру Старицы, кругом всей крепости, под соборную церковь, под батареи и под комендантские палаты."
                                            },
                                            {
                                                "example_id": "02d7ddc0-de7b-449f-840b-c4356da3be26",
                                                "sense_id": "dad7bf65-1887-3232-a995-a0ae517b59b7",
                                                "text": "Баба подумала, да и заложила дровни и взвалила старика, который был без памяти, свезла под яр и вывалила в речку."
                                            },
                                            {
                                                "example_id": "49a447de-792f-4b29-b485-8ac6f8c7b019",
                                                "sense_id": "dad7bf65-1887-3232-a995-a0ae517b59b7",
                                                "text": "Ока нежилась в берегах, синея и сверкая искрами далеко под береговыми ярами."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3f496dc-9dfd-3119-8fda-68785f5b43a3",
                                        "entry_id": "ddd27fcc-54c0-3c34-8598-5d2c71a83b34",
                                        "glosses": [
                                            "то же, что овраг, лощина"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79733fb5-80e7-4541-a66a-156d32dc0cf7",
                                                "sense_id": "a3f496dc-9dfd-3119-8fda-68785f5b43a3",
                                                "text": "Скачка была самая ужасная; мотавшиеся на поводьях, избитые копытами, солдаты отчаянными криками ещё более увеличивали испуг лошадей, летевших по полю без удержу, стремглав бросавшихся в яры и овраги, убиваясь и убивая несчастных драгун."
                                            }
                                        ]
                                    }
                                ]
                            },
