            "senses": [
                {
                    "sense_id": "7069c93d-5de3-3f99-bdc1-9f06603b8de6",
                    "sense_definition": "Ouverture ou renfoncement pratiqué dans l'épaisseur d'un mur pour y loger une porte ou une fenêtre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une silhouette mystérieuse est apparue dans l'<w>embrasure</w> de la porte du salon."
                        },
                        {
                            "text": "Il aimait s'asseoir dans l'<w>embrasure</w> de la fenêtre pour lire tranquillement son roman."
                        }
                    ],
                    "synonyms": [
                        "ébrasement",
                        "baie"
                    ],
                    "common_phrases": [
                        "embrasure de la porte",
                        "embrasure de la fenêtre"
                    ]
                },
                {
                    "sense_id": "762720ff-ca60-36a8-ac3e-c31555ff0231",
                    "sense_definition": "Ouverture pratiquée dans le parapet ou le mur d'une fortification pour permettre le tir d'une pièce d'artillerie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fortification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les soldats ont pointé les pièces d'artillerie à travers chaque <w>embrasure</w> de la forteresse."
                        },
                        {
                            "text": "Des sentinelles surveillaient les mouvements ennemis depuis les <w>embrasures</w> du vieux fort."
                        }
                    ],
                    "synonyms": [
                        "meurtrière",
                        "créneau",
                        "canonnière"
                    ],
                    "common_phrases": [
                        "embrasure de tir",
                        "embrasure de canon"
                    ]
                },
                {
                    "sense_id": "e5881467-b988-3686-954f-96a7a0c0b04e",
                    "sense_definition": "Espace triangulaire situé entre deux dents adjacentes, s'élargissant à partir du point de contact.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le dentiste nettoie soigneusement chaque <w>embrasure</w> pour prévenir l'accumulation de plaque."
                        },
                        {
                            "text": "L'hygiène quotidienne de l'<w>embrasure</w> entre les molaires nécessite l'utilisation de fil dentaire."
