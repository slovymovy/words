                "entry_id": "9dcf8bb4-7bc7-3fe5-9c35-caaca78b9ec8",
                "word": "civilizational",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "727f197f-71d9-3eb8-bf49-60ad4a73b1b4",
                        "entry_id": "9dcf8bb4-7bc7-3fe5-9c35-caaca78b9ec8",
                        "glosses": [
                            "Pertaining to or arising from civilization"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "be1309f6-a12c-4e4e-a18a-af72c17c4696",
                                "sense_id": "727f197f-71d9-3eb8-bf49-60ad4a73b1b4",
                                "text": "There are various civilizational factors at work."
                            },
                            {
                                "example_id": "014719a1-1f42-4be8-9eff-6e8f0f3fe406",
                                "sense_id": "727f197f-71d9-3eb8-bf49-60ad4a73b1b4",
                                "text": "From the Baltics to Central Asia, former Soviet states are seen by President Vladimir Putin as part of “the Russian world,” with supposedly a distinct civilizational identity that justifies Moscow’s meddling."
                            },
                            {
                                "example_id": "646d5bfd-a221-4842-9934-9f4330238966",
                                "sense_id": "727f197f-71d9-3eb8-bf49-60ad4a73b1b4",
                                "text": "“We’ve got civilizational suicidal empathy going on,” Musk said, borrowing the term from Gad Saad, a Canadian scholar who is also a frequent Rogan host."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10847831-49ff-4ee4-8430-c5443ab9db77",
                        "source_entry_id": "9dcf8bb4-7bc7-3fe5-9c35-caaca78b9ec8",
                        "source_sense_id": "727f197f-71d9-3eb8-bf49-60ad4a73b1b4",
