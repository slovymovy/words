                        "examples": [
                            {
                                "example_id": "4a223b12-f88a-4543-a24f-f261f3a53f23",
                                "sense_id": "f11445c5-24c4-3fdf-a1d4-1ed93ddcddd1",
                                "text": "Не тебе бы, старцу старому, В поле чистое выезживать — Или некем заменитися?"
                            },
                            {
                                "example_id": "b543c604-ea5a-4c62-b772-1715663b0e1d",
                                "sense_id": "f11445c5-24c4-3fdf-a1d4-1ed93ddcddd1",
                                "text": "Но они требуют особенного обращения. Каждого нужно выезживать не менее четырёх часов в день."
                            }
                        ]
                    }
