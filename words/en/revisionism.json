            "senses": [
                {
                    "sense_id": "4ff4e1d2-889c-31bc-aba9-ce141bd31b56",
                    "sense_definition": "The advocacy of a revision or re-examination of an accepted theory, doctrine, or interpretation of historical events.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "historical_and_ideological_interpretation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many scholars accused the author of historical <w>revisionism</w> after the controversial book was published."
                        },
                        {
                            "text": "Critics worried that political <w>revisionism</w> would distort the true events of the twentieth century."
                        }
                    ],
                    "antonyms": [
                        "orthodoxy",
                        "traditionalism"
                    ],
                    "common_phrases": [
                        "historical revisionism"
                    ]
                },
                {
                    "sense_id": "5fbc9404-dd11-343e-8c08-49a549e0145c",
                    "sense_definition": "A departure from or modification of standard Marxist or communist principles, especially favoring gradual reform over violent revolution.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "historical_and_ideological_interpretation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hardline party leaders frequently purged members accused of ideological <w>revisionism</w>."
                        },
                        {
                            "text": "The debate over Marxist <w>revisionism</w> divided European socialists in the late nineteenth century."
                        }
                    ],
                    "antonyms": [
