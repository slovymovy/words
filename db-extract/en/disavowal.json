                    {
                        "translation_id": "95092e17-6244-4397-ac7e-b3a10a38ed9a",
                        "source_entry_id": "dfe5dc60-06cd-3158-ba34-c0c3278e2174",
                        "source_sense_id": "cee033ba-154e-3e61-9711-3620424d75c2",
