        "fr-extract.jsonl": [
            {
                "entry_id": "5745d22f-5518-3f56-9302-ce8ae2d6a814",
                "word": "ombreux",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "191ab4e8-eafa-4f39-9c40-0da058c22d7d",
                        "entry_id": "5745d22f-5518-3f56-9302-ce8ae2d6a814",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "ombreuse"
                    },
                    {
                        "form_id": "95696903-a2a6-43d6-8d1e-b242e6e93ec1",
                        "entry_id": "5745d22f-5518-3f56-9302-ce8ae2d6a814",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "ombreuses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "efbb029a-557c-3565-8b50-f6f0a7fd776d",
                        "entry_id": "5745d22f-5518-3f56-9302-ce8ae2d6a814",
                        "glosses": [
                            "Où il y a de l’ombre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f55b5168-c4be-4732-9a8e-64e84571408e",
                                "sense_id": "efbb029a-557c-3565-8b50-f6f0a7fd776d",
                                "text": "Proserpine et le lieutenant marchaient les premiers, immédiatement suivis des cinq Polonais, choisissant avec soin les endroits les plus ombreux, les contrebas et les plis du sol pour y faire passer leur monde, préoccupés avant tout de n’être pas aperçus."
                            },
                            {
                                "example_id": "a9c50966-2c73-49e9-8bdb-10d9a6f88068",
                                "sense_id": "efbb029a-557c-3565-8b50-f6f0a7fd776d",
                                "text": "Son nom, ses cris, son babillage se perdent l'été dans l’immensité des avenues ombreuses et des pelouses ; ils égayent, l'hiver, les corridors et les pièces sonores du château."
                            },
                            {
                                "example_id": "82e49077-af01-4658-afc1-26d240b538d0",
                                "sense_id": "efbb029a-557c-3565-8b50-f6f0a7fd776d",
                                "text": "La forêt de Hêtre-Sapin à humus abondant sous sa forme la plus « climacique », abrite dans les endroits ombreux une flore assez pauvre à Aspérule odorante, Luzule blanche, Scille fausse Jacinthe, Fougères et Mousses."
                            },
                            {
                                "example_id": "ab308f9b-a380-4888-bfcc-c93de08c0b46",
                                "sense_id": "efbb029a-557c-3565-8b50-f6f0a7fd776d",
                                "text": "Pendant qu'on décharge mes bêtes, je me précipite vers la grotte fraîche et ombreuse où jaillit la source et j'en prends possession pour le reste de la journée."
                            },
                            {
                                "example_id": "6b1a59e9-10af-4add-838f-4e7e187caa12",
                                "sense_id": "efbb029a-557c-3565-8b50-f6f0a7fd776d",
                                "text": "Le temps avait particulièrement soigné, cette année-là, les parties ombreuses de notre territoire."
                            },
                            {
                                "example_id": "d101ea7a-9d10-40bb-99a9-19459f4bc44a",
                                "sense_id": "efbb029a-557c-3565-8b50-f6f0a7fd776d",
                                "text": "Dans cette région ombreuse se succèdent de petites montagnes aux épaisses forêts de conifères, dont le vert profond contraste avec celui, pâle, des vaporeux bambous du fond des vallées, où grondent des torrents et s’échelonnent des rizières en terrasses."
                            }
                        ]
                    },
                    {
                        "sense_id": "c53f5898-7591-32a5-9e6e-5f7cc41a02ee",
                        "entry_id": "5745d22f-5518-3f56-9302-ce8ae2d6a814",
                        "glosses": [
                            "Qui donne ou fait de l’ombre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72c98495-0e6a-4957-996b-616df372d902",
                                "sense_id": "c53f5898-7591-32a5-9e6e-5f7cc41a02ee",
                                "text": "Les forêts ombreuses."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c288c44-aa34-4e6b-99fd-866ff0a91531",
                        "source_entry_id": "5745d22f-5518-3f56-9302-ce8ae2d6a814",
                        "target_lang_word": "shady",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shady",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e60d48f8-4817-3267-bafc-ff2838586cb8",
                                        "entry_id": "7a4a8361-6671-3447-8a97-771a13b3a22c",
                                        "glosses": [
                                            "Abounding in shades."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f870e93d-55f4-3026-993d-7bfaaebd648a",
                                        "entry_id": "7a4a8361-6671-3447-8a97-771a13b3a22c",
                                        "glosses": [
                                            "Causing shade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea8e9086-15be-4f1c-9d02-fdf22f58c5e6",
                                                "sense_id": "f870e93d-55f4-3026-993d-7bfaaebd648a",
                                                "text": "The shady trees cover him with their shadow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "283c667b-8584-34af-985d-6b0ad27c93b2",
                                        "entry_id": "7a4a8361-6671-3447-8a97-771a13b3a22c",
                                        "glosses": [
                                            "Overspread with shade; sheltered from the glare of light or sultry heat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc206ba4-9f76-47e5-bc1c-f82193f6d027",
                                                "sense_id": "283c667b-8584-34af-985d-6b0ad27c93b2",
                                                "text": "you may have rooms both for summer and winter; shady for summer, and warm for winter"
                                            },
                                            {
                                                "example_id": "21064a3a-b166-4817-ab37-6e93d6859611",
                                                "sense_id": "283c667b-8584-34af-985d-6b0ad27c93b2",
                                                "text": "I know the shadiest breeziest spots, hidden tables surrounded by trees that have lived longer than the neighborhoods around them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bc957a5-4bd5-3047-ba40-34ea4d60ab65",
                                        "entry_id": "7a4a8361-6671-3447-8a97-771a13b3a22c",
                                        "glosses": [
                                            "Not trustworthy; disreputable."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61789e9c-255f-4fbb-bcb3-80358957b449",
                                                "sense_id": "3bc957a5-4bd5-3047-ba40-34ea4d60ab65",
                                                "text": "He is a shady character."
                                            },
                                            {
                                                "example_id": "e2ff8041-1557-48ed-a840-38dffeac67e1",
                                                "sense_id": "3bc957a5-4bd5-3047-ba40-34ea4d60ab65",
                                                "text": "No sunshine in my life, the way I deal is shady"
                                            },
                                            {
                                                "example_id": "5199bc84-8792-4a53-a94d-944c54619dac",
                                                "sense_id": "3bc957a5-4bd5-3047-ba40-34ea4d60ab65",
                                                "text": "Jon & Kate Plus 8 is a show based on two facts: 1) Jon and Kate Gosselin have eight children, and 2) the word ‘Kate’ rhymes with the word ‘eight’. One suspects that if Kate were ever to have another child, a shady network executive would urge her to put it in a binbag with a brick and drop it down a well. But this is just a horrifying tangent."
                                            },
                                            {
                                                "example_id": "23db13bf-8518-4901-9cd4-50dfa0c26cd5",
                                                "sense_id": "3bc957a5-4bd5-3047-ba40-34ea4d60ab65",
                                                "text": "People on the internet seemingly can’t get enough of the whole thing. The Guardian named it “pop’s shadiest power move.”"
                                            },
                                            {
                                                "example_id": "7888c1f1-1f94-4092-80b3-556e0b5c5b5f",
                                                "sense_id": "3bc957a5-4bd5-3047-ba40-34ea4d60ab65",
                                                "text": "However, when Buster's character was still being developed, he was indeed a much shadier and less lovable character."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0477df69-255c-310b-bf53-bd82b8ef6191",
                                        "entry_id": "7a4a8361-6671-3447-8a97-771a13b3a22c",
                                        "glosses": [
                                            "Mean, cruel."
                                        ],
                                        "tags": [
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f34da52-14fb-41c8-9847-fa9aa44e52f8",
                                                "sense_id": "0477df69-255c-310b-bf53-bd82b8ef6191",
                                                "text": "They were being proper shady to him. Even if you don't like someone, locking them out, stealing their clothes and ganging up on them to take the piss is just childish."
                                            },
                                            {
                                                "example_id": "e2c3ef66-80bb-47e6-8dcc-34f693cebf91",
                                                "sense_id": "0477df69-255c-310b-bf53-bd82b8ef6191",
                                                "text": "I didn't even ask her to be in the 'Increase the Peace' campaign, which was well shady, 'cos if anyone knows anything about rudes and violence and getting dragged into stuff it's Uma."
                                            },
                                            {
                                                "example_id": "4ed5faf3-aea9-424c-9f86-184bffbdaa06",
                                                "sense_id": "0477df69-255c-310b-bf53-bd82b8ef6191",
                                                "text": "\"Don't be shady,\" she said, \"You know I always pay up.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca529fb5-d7a9-4157-82fd-7a4ac0a5e751",
                        "source_entry_id": "5745d22f-5518-3f56-9302-ce8ae2d6a814",
