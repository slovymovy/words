                "senses": [
                    {
                        "sense_id": "6b42c017-0f15-337f-a6b6-d3fda25743aa",
                        "entry_id": "9e983f79-5468-358d-a7a9-3a24694c5413",
                        "glosses": [
                            "разг. то же, что шинкование"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdfd6772-b813-407f-ba81-80408aed043d",
                                "sense_id": "6b42c017-0f15-337f-a6b6-d3fda25743aa",
                                "text": "Да ведь кони-то — здесь, с тобой, на пашне, а коров-то нынче с ограды палкой не выгонишь, им сейчас ботвы разной огородной цельная копна сложена, а капустного листа от шинковки и засолки — другая!"
                            }
                        ]
                    },
                    {
                        "sense_id": "117b1e1f-7722-39ef-be9e-02ee8a1a61d3",
                        "entry_id": "9e983f79-5468-358d-a7a9-3a24694c5413",
                        "glosses": [
                            "приспособление, устройство для шинкования чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "480034d2-eb18-413f-9fe1-1139acaaa1a0",
                                "sense_id": "117b1e1f-7722-39ef-be9e-02ee8a1a61d3",
                                "text": "Три стакана муки высыпать горкой на доску и прямо на муку потереть на крупной шинковке пачку холодного масла."
                            }
                        ]
                    }
