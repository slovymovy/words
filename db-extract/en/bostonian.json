            {
                "entry_id": "8b8c964b-e406-3467-8670-3c4c83c36294",
                "word": "Bostonian",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "44b0ef11-4765-4199-aaa4-a10437e9af99",
                        "entry_id": "8b8c964b-e406-3467-8670-3c4c83c36294",
                        "tags": [
                            "plural"
                        ],
                        "form": "Bostonians"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "246fc58e-d5b2-35eb-ba2e-83d0b57328b0",
                        "entry_id": "8b8c964b-e406-3467-8670-3c4c83c36294",
                        "glosses": [
                            "A person who was born in or who lives in Boston, Massachusetts."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99e4bfe0-7d6e-41b7-9e3d-30fb8ab6fb82",
                                "sense_id": "246fc58e-d5b2-35eb-ba2e-83d0b57328b0",
                                "text": "Bostonians eagerly await the arrival of spring after a long, cold, snowy winter."
                            },
                            {
                                "example_id": "7d9fc522-1fad-432c-9f8e-3c28db592040",
                                "sense_id": "246fc58e-d5b2-35eb-ba2e-83d0b57328b0",
                                "text": "Single-sex clusters of Bostonians made their boisterous way through the streets, hoping to collide with their opposite numbers."
                            }
                        ]
                    },
                    {
                        "sense_id": "90d69da6-7e11-3983-b944-9bd02ead1a64",
                        "entry_id": "8b8c964b-e406-3467-8670-3c4c83c36294",
                        "glosses": [
                            "A person who was born in or who lives in Boston, Lincolnshire."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
