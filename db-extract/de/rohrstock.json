                ],
                "senses": [
                    {
                        "sense_id": "8f48bde8-f126-37bd-bba8-669afc88640f",
                        "entry_id": "a5585411-88ac-33a1-a295-f09f98ea74f6",
                        "glosses": [
                            "leichter, hohler, leicht elastischer Holzstab zum Schlagen als Bestrafung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e285023-6f25-481b-b836-43ba53b41219",
                                "sense_id": "8f48bde8-f126-37bd-bba8-669afc88640f",
                                "text": "Und der Lehrer holte den Schüler vor die Klasse und verprügelte ihn mit seinem Rohrstock."
                            },
                            {
                                "example_id": "9e25dcdc-842f-4083-ac5d-a2dfeccb83aa",
                                "sense_id": "8f48bde8-f126-37bd-bba8-669afc88640f",
                                "text": "„Rektor Schneider, der Leiter der Knabenschule, war ein Künstler im Umgang mit dem Rohrstock.“"
                            },
                            {
                                "example_id": "7486fc89-cf1e-4fec-90b8-47d3389fe8d3",
                                "sense_id": "8f48bde8-f126-37bd-bba8-669afc88640f",
                                "text": "„Dieser Lehrer Franke hatte eine bestialische Freude daran, mich mit dem Rohrstock zu hauen, am liebsten für etwas, was ich nicht tat.“"
                            },
                            {
                                "example_id": "97c96d1c-df8a-4e9a-9a74-efc965fd2598",
                                "sense_id": "8f48bde8-f126-37bd-bba8-669afc88640f",
                                "text": "„Ich träumte auch von dem gelben Rohrstock und von dem schwarzen, sah beide in meiner Hand."
                            },
                            {
                                "example_id": "46e138be-eb3a-49f4-b5b5-b240e711374b",
                                "sense_id": "8f48bde8-f126-37bd-bba8-669afc88640f",
                                "text": "„Mit gespaltenen Rohrstöcken bemühten sich die Begleiter, unter lauten Rufen die Straße frei zu halten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
