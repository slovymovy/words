                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b23381f3-8820-410a-ad4c-c378e4285f9f",
                                "sense_id": "d7e18f23-c0cc-33a3-980d-dbd00387f921",
                                "text": "La principale faiblesse des tenants de la thèse de la relativité (dépendance) de la pensée (philosophie, vision du monde) vis-à-vis des différentes langues maternelles est due au fait qu’ils négligent d’aporétiser le rap en langage-pensée."
                            },
                            {
                                "example_id": "6a2b428a-e7cb-481f-9e9a-cc4488102168",
                                "sense_id": "d7e18f23-c0cc-33a3-980d-dbd00387f921",
                                "text": "A certains égards, Platon ne cesse jamais en effet, de remettre sa théorie des idées en cause donc d’aporétiser (30)."
                            }
                        ]
                    }
