                "senses": [
                    {
                        "sense_id": "c9515a5a-9b00-34dd-9c90-bf86c0920743",
                        "entry_id": "1d1975d4-76b5-3780-9273-e226838f52bd",
                        "glosses": [
                            "женск. к портретист; художница, создающая преимущественно портреты; специализирующаяся на портретной живописи"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14b132ab-2d6a-445b-9a85-2aba4eceda2a",
                                "sense_id": "c9515a5a-9b00-34dd-9c90-bf86c0920743",
                                "text": "Живописи учила сама мать, отменная художница миниатюрой и портретистка."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd2a55ee-d4fc-4a7c-854a-058e0280c29a",
                        "source_entry_id": "1d1975d4-76b5-3780-9273-e226838f52bd",
                        "source_sense_id": "c9515a5a-9b00-34dd-9c90-bf86c0920743",
                        "target_lang_word": "Porträtmalerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Porträtmalerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "35971525-33f7-32ab-868d-617290af054f",
                                        "entry_id": "05158793-1c8f-3de7-b8da-ce5cf8c80ac1",
                                        "glosses": [
                                            "Malerin, die vornehmlich oder ausschließlich Porträts anfertigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "732590ea-df33-494b-8d49-de7a319be76f",
                                                "sense_id": "35971525-33f7-32ab-868d-617290af054f",
                                                "text": "Seine Cousine ist eine exzellente Porträtmalerin."
                                            },
                                            {
                                                "example_id": "b8486ea0-0a70-4409-ab98-c881335dca1f",
                                                "sense_id": "35971525-33f7-32ab-868d-617290af054f",
                                                "text": "„Sie hat bisher in Graubünden, am Comer See und in Vorarlberg gewohnt, jetzt macht sie sich mit ihrem Vater, einem unbedeutenden Maler, nach Italien und dann nach London auf - und wird die berühmteste Porträtmalerin ihrer Epoche.“"
                                            },
                                            {
                                                "example_id": "1e8e62a4-3562-41f5-a7db-d01b1b531ea4",
                                                "sense_id": "35971525-33f7-32ab-868d-617290af054f",
                                                "text": "„Die Museumspädagogin Fiona Alderton stellt in dem zehnminütigen Rundgang 'Women in Art History' (der locker länger wird, drückt man zum Verweilen auf den Bildern auch mal die Stopptaste) acht Künstlerinnen vor, deren Werke im Besitz des Museums sind, von der flämischen Porträtmalerin Catarina van Hemessen über die Impressionistin Berthe Morisot bis zu Bridget Riley und ihrem Monumentalwerk ‚Messengers‘ (2019), das den Annenberg Court mit pastellfarbenen Wolkentupfern übersät.“"
                                            },
                                            {
                                                "example_id": "babcacc3-3219-4dfe-98f4-5c2591918959",
                                                "sense_id": "35971525-33f7-32ab-868d-617290af054f",
                                                "text": "„Von Bob Thompson, einem jung verstorbenen US-Expressionisten, sind zwei poetische Bilder zu sehen, die realistischen Werke der ebenfalls amerikanischen Porträtmalerin Alice Neel stellen in ihrer Fokussiertheit einen direkten Gegenpol dar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
