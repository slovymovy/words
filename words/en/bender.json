                    "frequency": "VeryLow",
                    "semantic_group_id": "shelter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The travelers built a traditional <w>bender</w> using hazel poles and heavy tarpaulin.",
                            "target_lang_translations": {
                                "it": "I viaggiatori hanno costruito una tradizionale <w>capanna</w> utilizzando pali di nocciolo e un pesante telone."
                            }
                        },
                        {
                            "text": "They slept inside a rough <w>bender</w> to stay dry during the storm.",
                            "target_lang_translations": {
                                "it": "Hanno dormito all'interno di un rudimentale <w>rifugio</w> per rimanere all'asciutto durante la tempesta."
                            }
