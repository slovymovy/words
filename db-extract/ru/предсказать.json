                ],
                "translations": [
                    {
                        "translation_id": "7b9d46fc-46d0-4c6c-8b84-01fb1551ff92",
                        "source_entry_id": "8f25e0a0-4b51-3732-83ba-ba6ab07a8877",
                        "target_lang_word": "predict",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "predict",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d7f25079-cfbd-3612-9aea-bcf437b46193",
                                        "entry_id": "310c1c15-f759-3e98-b058-51c5c973ce71",
                                        "glosses": [
                                            "To make a prediction: to forecast, foretell, or estimate a future event on the basis of knowledge and reasoning; to prophesy a future event on the basis of mystical knowledge or power."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc19c3b3-4241-41fd-9754-7ea4197e0e2e",
                                                "sense_id": "d7f25079-cfbd-3612-9aea-bcf437b46193",
                                                "text": "After he had renounced his fathers bishoprick of Valentia in Spaine... and to attaine by degrees the Maiesty of Cesar, was created Duke of that place, gaue for his poesie, Aut Cesar, aut nihil. which being not fauoured from the heauens, had presently the euent the same predicted."
                                            },
                                            {
                                                "example_id": "0d0bd905-7272-48ba-906c-08711448a35f",
                                                "sense_id": "d7f25079-cfbd-3612-9aea-bcf437b46193",
                                                "text": "Professor Trelawney kept predicting Harry’s death, which he found extremely annoying."
                                            },
                                            {
                                                "example_id": "6e3a4bca-16c0-43f8-b6a2-e8c522ce3f9a",
                                                "sense_id": "d7f25079-cfbd-3612-9aea-bcf437b46193",
                                                "text": "The physics of elementary particles in the 20th century was distinguished by the observation of particles whose existence had been predicted by theorists sometimes decades earlier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e6d0f52-7bc2-35c7-acad-25510dda9a3e",
                                        "entry_id": "310c1c15-f759-3e98-b058-51c5c973ce71",
                                        "glosses": [
                                            "To imply."
                                        ],
                                        "tags": [
                                            "transitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e16eab0-ba2d-4592-a82a-a3d7ca1eafbc",
                                                "sense_id": "4e6d0f52-7bc2-35c7-acad-25510dda9a3e",
                                                "text": "It is interesting to see how clearly theory predicts the difference between the ascending and descending curves of a dynamo."
                                            },
                                            {
                                                "example_id": "44beb15a-33e3-49a1-93ad-d14981e52da4",
                                                "sense_id": "4e6d0f52-7bc2-35c7-acad-25510dda9a3e",
                                                "text": "For both men and women, greater symmetry predicted a larger number of past sex partners."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc069ead-962d-3f45-871f-4550c5ac66d6",
                                        "entry_id": "310c1c15-f759-3e98-b058-51c5c973ce71",
                                        "glosses": [
                                            "To make predictions."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8eda1a02-42d1-4d48-89ae-d2dfa950b87b",
                                                "sense_id": "dc069ead-962d-3f45-871f-4550c5ac66d6",
                                                "text": "The devil can both predict and make predictors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ab4d34d-1468-3739-93d6-9c51a15ec090",
                                        "entry_id": "310c1c15-f759-3e98-b058-51c5c973ce71",
                                        "glosses": [
                                            "To direct a ranged weapon against a target by means of a predictor."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5459ae63-74e3-46ff-9fb5-496283f97460",
                                                "sense_id": "1ab4d34d-1468-3739-93d6-9c51a15ec090",
                                                "text": "They're predicting us now; looks like a barrage."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "predict",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "396be220-1cef-3d4f-9a97-197ef264ea2d",
                                        "entry_id": "ed109c85-66b7-385f-a55f-88ff01012d41",
                                        "glosses": [
                                            "A prediction."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf8f24ac-f839-46b3-8d1f-98c173d8a863",
                                                "sense_id": "396be220-1cef-3d4f-9a97-197ef264ea2d",
                                                "text": "Or say with Princes if it shall go well, / By oft predict that I in heaven find."
                                            }
