                "senses": [
                    {
                        "sense_id": "668e4554-0c9c-3c4f-af19-7c1666c26d52",
                        "entry_id": "8d14cd62-3517-3576-8958-10ad5840b7dc",
                        "glosses": [
                            "österreichisch: Organ oder die Funktion der Leitung einer Gesellschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf229604-b409-4ea2-99c4-5aabaa37754a",
                                "sense_id": "668e4554-0c9c-3c4f-af19-7c1666c26d52",
                                "text": "Wir wurden ins Gebüsch verwiesen und beschweren sollten wir uns bei der Chefität am Seeausfluss"
                            },
                            {
                                "example_id": "cd3ae2f5-cf65-4435-8ccb-2cc545aa773d",
                                "sense_id": "668e4554-0c9c-3c4f-af19-7c1666c26d52",
                                "text": "„Unsere Beratungserfahrung zeigt: Wenn Mitarbeiter ihre Verärgerung über die Chefität ein Stück durch- und aufgearbeitet sowie einige neue Verhaltensmöglichkeiten identifiziert haben und sich in der Folge wieder mehr auf ihre Arbeit konzentrieren sowie Formen kollegialer Unterstützung ausbauen, löst das Verhalten des Vorgesetzten viel weniger negative Reaktionen auch dann hervor, wenn sich die Zufriedenheit mit ihm nicht sonderlich ändert.“"
                            },
                            {
                                "example_id": "74cb61d7-ff0b-4901-ac7c-e1f74da652ce",
                                "sense_id": "668e4554-0c9c-3c4f-af19-7c1666c26d52",
                                "text": "„Meine Zeichnungen erreichen den Auftraggeber meist in letzter Sekunde, kurz vor Drucklegung. Das bringt die Chefität oft zum Schwitzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "54e96643-6e67-3e7e-a797-7eb6f330e135",
                        "entry_id": "8d14cd62-3517-3576-8958-10ad5840b7dc",
                        "glosses": [
                            "österreichisch: Stockwerk der Geschäftsleitung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d6fcee5-ffc1-4e2f-af1f-9534d2520717",
                                "sense_id": "54e96643-6e67-3e7e-a797-7eb6f330e135",
                                "text": "Die Chefität, bei der wir uns beschweren konnten, befand sich im obersten Stockwerk."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
