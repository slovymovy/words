                        "sense_id": "8065f787-ffb3-3be3-b683-1697da143d86",
                        "entry_id": "2689f89d-563b-36ac-98f4-aefa76623534",
                        "glosses": [
                            "Unternehmen, das eine größere Anzahl von Hotels an verschiedenen Orten betreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd68bd53-0337-4d1b-8ca3-f770b2ee26b9",
                                "sense_id": "8065f787-ffb3-3be3-b683-1697da143d86",
                                "text": "„Alice dirigierte ihn zu einem Hotel am Ufer des Toten Meeres, das zu einer Schweizer Hotelkette gehörte und dessen Manager sie kannte.“"
                            },
                            {
                                "example_id": "0bebb2e6-c333-4d29-82a6-f37a76b3de29",
                                "sense_id": "8065f787-ffb3-3be3-b683-1697da143d86",
                                "text": "„Die Jacke war ihr ein bisschen zu groß, ich dachte, die sei sicher für eine andere genäht worden, ein Standardmaß, mit dem die gesamte Hotelkette operierte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
