                        "entry_id": "439f53bc-b826-3899-8861-c23798fd5340",
                        "glosses": [
                            "Lead shot used in shotgun cartridges, made of larger pellets than birdshot and suitable for hunting larger game."
                        ],
                        "tags": [
                            "US",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
