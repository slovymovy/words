                        "glosses": [
                            "A man employed in parts of Africa to disseminate information within a community, usually by means of a gong."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7793f4a3-8d34-41e5-b77f-4f7b717a6345",
                                "sense_id": "6e5249de-2d67-3f38-a646-df6808dc5182",
                                "text": "The Gongman who usually is a member of the household of the local leader (chief) is responsible for delivering messages from the traditional leader verbally to elders and community leaders in the locality."
                            },
                            {
                                "example_id": "a6691b42-eb9f-40f1-96bb-24b509c6bf97",
                                "sense_id": "6e5249de-2d67-3f38-a646-df6808dc5182",
                                "text": "[…] Africa, where Pratt (1985) remarks that traditional communication channels are 'the gongman, the town crier, the market square and the chief's court'. and corporate communication is practised in both countries."
                            }
                        ]
                    }
