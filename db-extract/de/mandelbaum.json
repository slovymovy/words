                        ],
                        "form": "die Mandelbäume"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7c7456d6-6363-3930-90b7-d6c6c71cfbf7",
                        "entry_id": "cd47a141-dacc-30b0-98b3-0bc9a7cda57e",
                        "glosses": [
                            "baumartige Pflanze aus der Gattung Prunus (Pflaumen) in der Familie der Rosengewächse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5ef02eb-97c4-468c-bc9c-842b415d7548",
                                "sense_id": "7c7456d6-6363-3930-90b7-d6c6c71cfbf7",
                                "text": "„Ein Mandelbaum hat schon zartgrüne Triebe, der Marillenbaum ist bereits in voller Blüte.“"
                            },
                            {
                                "example_id": "f6212eb6-434a-4f13-b658-7cc26886a9a4",
                                "sense_id": "7c7456d6-6363-3930-90b7-d6c6c71cfbf7",
                                "text": "„Hier stehen ein Kirschbaum, Apfel-, Mandel- und Zwetschgenbäume, eine Himalaja-Kiefer, eine Hängebuche und eine weiße Magnolie, auf die Amalia immer sehr stolz war, obwohl der Baum geradezu entgegen ihren Bemühungen überleben musste; Amalia hatte das Gegenteil eines grünen Daumens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25254c3d-bfc4-433a-bfe0-75fb6b229567",
                        "source_entry_id": "cd47a141-dacc-30b0-98b3-0bc9a7cda57e",
                        "source_sense_id": "7c7456d6-6363-3930-90b7-d6c6c71cfbf7",
                        "source_sense_description": "baumartige Pflanze aus der Gattung Prunus (Pflaumen) in der Familie der Rosengewächse",
