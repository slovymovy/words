                    },
                    {
                        "form_id": "040c1822-6293-4409-a0b4-9f8dce2443c3",
                        "entry_id": "ed563f27-097b-3e52-86ed-c9bbf611f0e4",
                        "tags": [
                            "past"
                        ],
                        "form": "clumpered"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "12da7044-8334-3de9-91bc-d157240104d4",
                        "entry_id": "ed563f27-097b-3e52-86ed-c9bbf611f0e4",
                        "glosses": [
                            "To form into clumps or masses."
                        ],
                        "tags": [
                            "intransitive",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "1ec09bcd-08be-43a2-9909-14f62b3f3879",
                                "sense_id": "12da7044-8334-3de9-91bc-d157240104d4",
                                "text": "Vapours […] clumper'd in balls of clouds."
                            },
                            {
                                "example_id": "76e06866-802c-493f-8fbc-a3cef8c443ce",
                                "sense_id": "12da7044-8334-3de9-91bc-d157240104d4",
                                "text": "An' dere at evemen, I da goo, A-hoppèn auver ghiates an' bars, By twinklen light o' winter stars, When snow da clumper to my shoe;"
                            },
                            {
                                "example_id": "bff19274-de17-456f-9219-6a5e48b935cd",
                                "sense_id": "12da7044-8334-3de9-91bc-d157240104d4",
                                "text": "[…] then let it cool, and put in the Camphire and four ounces of Venice turpentine drop by drop, lest it clumper, stirring it continually, then make it up into Rolls, and do with it to the pleasure of God , and health of man."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c6d999c-37d8-39c4-bc5c-059ebf56666b",
                        "entry_id": "ed563f27-097b-3e52-86ed-c9bbf611f0e4",
                        "glosses": [
                            "To move heavily; to clomp or clump."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d230d713-3cfd-470d-9546-deb8c895b0a4",
                                "sense_id": "5c6d999c-37d8-39c4-bc5c-059ebf56666b",
                                "text": "The palms of TV looked especially welcome as the plane clumpered down on a hazy tarmac in a greenish, weedy field."
                            },
                            {
                                "example_id": "89ec6077-4b57-40b8-b485-41efd5132247",
                                "sense_id": "5c6d999c-37d8-39c4-bc5c-059ebf56666b",
                                "text": "As the tired horse clumpered into Dark, I ate the wursttail, arranged bread, butter and milk for pastor, so he not need to go to bed hungry."
                            },
                            {
                                "example_id": "7b47bfcd-afce-466f-a318-c7073ee9813d",
                                "sense_id": "5c6d999c-37d8-39c4-bc5c-059ebf56666b",
                                "text": "The soft tumbling patter of four-footed steps clumpered up behind the girl and the hobgoblin, and Chester walked up and sat between them, watching the bitter, bouncing boy."
                            }
                        ]
                    },
                    {
                        "sense_id": "531e8b84-e325-3c62-9fe5-72ebecb3df5e",
                        "entry_id": "ed563f27-097b-3e52-86ed-c9bbf611f0e4",
                        "glosses": [
                            "To make a clumping noise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34bb926c-f81a-4cdc-91d7-e0ddbf4eeba3",
                                "sense_id": "531e8b84-e325-3c62-9fe5-72ebecb3df5e",
                                "text": "The cold, indeed, was now becoming so intense as to congeal and skim over all the pools and still eddies of the river, and make solid ice along the shores of the rapid currents of the stream; while even the ground was fast becoming so frozen as to clumper and sound beneath the hurrying tread of our anxious travellers ."
                            }
                        ]
                    }
                ],
                "translations": [],
