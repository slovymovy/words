                        "glosses": [
                            "Amérindien mythique, habitant de la Patagonie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf75f26e-f4a0-4740-8e42-cfc6ab6e438f",
                                "sense_id": "e7c0366f-3e36-3412-8513-2a84fd5483ec",
                                "text": "Les Patagons géants sont vraisemblablement un canular fantaisiste."
                            },
                            {
                                "example_id": "419cf904-5634-4f3d-89c6-cbb87b191518",
                                "sense_id": "e7c0366f-3e36-3412-8513-2a84fd5483ec",
                                "text": "En vérité, mademoiselle, écrivait-elle, j’aurais autant l’idée d’épouser un Patagon que la plupart des hommes que je vois ici."
                            }
                        ]
                    }
