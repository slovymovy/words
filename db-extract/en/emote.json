    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "55641b58-61cf-3426-a7ef-9827b0d8fa5c",
                "word": "emote",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7e862db8-5732-47e6-950d-480631d90de3",
                        "entry_id": "55641b58-61cf-3426-a7ef-9827b0d8fa5c",
                        "tags": [
                            "plural"
                        ],
                        "form": "emotes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f304e560-998f-3629-a714-6a426dcccef3",
                        "entry_id": "55641b58-61cf-3426-a7ef-9827b0d8fa5c",
                        "glosses": [
                            "A virtual action expressed to other users as a graphic or reported speech rather than a straightforward message."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": [
                            {
                                "example_id": "d3c25475-86bb-4268-af6c-982b9a7e28a9",
                                "sense_id": "f304e560-998f-3629-a714-6a426dcccef3",
                                "text": "She replied with an emote: \"*hugs* I'm sorry\""
                            }
                        ]
                    },
                    {
                        "sense_id": "dcc417d0-3349-39ef-b4ff-96d4d5566500",
                        "entry_id": "55641b58-61cf-3426-a7ef-9827b0d8fa5c",
                        "glosses": [
                            "Clipping of emoticon."
                        ],
                        "tags": [
                            "Internet",
                            "abbreviation",
                            "alt-of",
                            "clipping"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1c9490ad-62c3-39ec-91fc-9e6d98c4df1b",
                        "entry_id": "55641b58-61cf-3426-a7ef-9827b0d8fa5c",
                        "glosses": [
                            "A short action, such as a gesture or a dance move, which may be seen by other players but does not have any effect on gameplay."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2c82029-05c7-4a88-bfe1-9b04a97aeab8",
                                "sense_id": "1c9490ad-62c3-39ec-91fc-9e6d98c4df1b",
                                "text": "Many video games allow players to purchase emotes for real-life money."
                            },
                            {
                                "example_id": "3f97edc4-f000-4a76-9aa6-64788ba24606",
                                "sense_id": "1c9490ad-62c3-39ec-91fc-9e6d98c4df1b",
                                "text": "Juggernaut franchises like Call of Duty and Battlefield are trying to capitalize on the success of Fortnite, but battle-royale games aren't just about skins and emotes."
                            },
                            {
                                "example_id": "ffd0ec42-03f1-4e65-a1c1-f6e82e3c4600",
                                "sense_id": "1c9490ad-62c3-39ec-91fc-9e6d98c4df1b",
                                "text": "As old maps return to Fortnite, so do old battles over who owns some of the emotes used in-game."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17ca62f1-199e-4a3a-a358-8af6eab04c68",
                        "source_entry_id": "55641b58-61cf-3426-a7ef-9827b0d8fa5c",
                        "source_sense_description": "virtual action expressed to other users as reported speech rather than a straightforward message",
