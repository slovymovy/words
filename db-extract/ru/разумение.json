                    },
                    {
                        "form_id": "c6a17603-2f29-480d-b388-5859a98cee88",
                        "entry_id": "bbfb1971-e469-3e16-acc2-93d6a6b73f29",
                        "tags": [
                            "nominative",
                            "plural"
                        ],
                        "form": "разуме́ния"
                    },
                    {
                        "form_id": "a34b0cf8-4c29-4255-a6c1-de0f258d2a7e",
                        "entry_id": "bbfb1971-e469-3e16-acc2-93d6a6b73f29",
                        "tags": [
                            "genitive",
                            "plural"
                        ],
                        "form": "разуме́ний"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6b3bbf47-c06f-32be-9c0b-d3ba19930b47",
                        "entry_id": "bbfb1971-e469-3e16-acc2-93d6a6b73f29",
                        "glosses": [
                            "理解，懂得，領悟"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d35de491-7d28-46d0-8d73-5c9152d601f9",
                                "sense_id": "6b3bbf47-c06f-32be-9c0b-d3ba19930b47",
                                "text": "[Kозлов] посвятил Райского... в тайны разумения древнего мира.",
                                "translation": "科茲洛夫把理解古代世界的秘密……告訴了萊斯基。"
                            },
                            {
                                "example_id": "5b835df7-63fb-4aaa-8746-a5365f94791a",
                                "sense_id": "6b3bbf47-c06f-32be-9c0b-d3ba19930b47",
                                "text": "Я должен облекать свою мысль в такую форму, которая была бы доступна разумению.",
                                "translation": "我應該給我的思想賦予一種能為人理解的形式。"
                            }
                        ]
                    },
                    {
                        "sense_id": "9793d1bb-0c3a-3585-937c-ed5456aa26e6",
                        "entry_id": "bbfb1971-e469-3e16-acc2-93d6a6b73f29",
                        "glosses": [
                            "智力，理解力，領悟能力"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26ae110d-2cf5-4afd-abd1-1734883bfe03",
                                "sense_id": "9793d1bb-0c3a-3585-937c-ed5456aa26e6",
                                "text": "Он лишён всякого разумения.",
                                "translation": "他一點理解力也沒有。"
                            },
                            {
                                "example_id": "3c661691-4e5a-4fcc-8a68-312b6a2b8b81",
                                "sense_id": "9793d1bb-0c3a-3585-937c-ed5456aa26e6",
                                "text": "Всё это выше моего разумения.",
                                "translation": "這一切都超過了我的理解能力。"
                            },
                            {
                                "example_id": "4e6f62a0-b48c-4ac2-b21b-e93de331dc41",
                                "sense_id": "9793d1bb-0c3a-3585-937c-ed5456aa26e6",
                                "text": "На службе отечеству разумения доселе нам, кажется, доставало.",
                                "translation": "在效力祖國的過程中，我們的理解力至今似乎也還算足夠。"
                            },
                            {
                                "example_id": "fbaee02b-654d-4b66-9181-feb15751e85e",
                                "sense_id": "9793d1bb-0c3a-3585-937c-ed5456aa26e6",
                                "text": "Впрочем, она видела, что Конон, по мере разумения, своё дело делает.",
                                "translation": "不過，她也看得出科農在自己的理解範圍內能將工作做好。"
                            }
                        ]
                    },
                    {
                        "sense_id": "1f686723-d1b6-3cc7-a9d3-e7b478c7449a",
                        "entry_id": "bbfb1971-e469-3e16-acc2-93d6a6b73f29",
                        "glosses": [
                            "見解，觀點，看法"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b357b5d8-6b96-4f27-a258-f3b6e09f096b",
                                "sense_id": "1f686723-d1b6-3cc7-a9d3-e7b478c7449a",
                                "text": "По моему разумению, вы не правы.",
                                "translation": "依我之見，您是不對的。"
                            },
                            {
                                "example_id": "3136884b-efd1-4a4e-af29-358c2c63c4a8",
                                "sense_id": "1f686723-d1b6-3cc7-a9d3-e7b478c7449a",
                                "text": "Касаткин осмелился сказать, что, по его разумению, осада Данцига затянулась.",
                                "translation": "卡薩特金斗膽地說，據他的看法，對但澤的圍攻拖得太久了。"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ]
    }
