                    "frequency": "Middle",
                    "semantic_group_id": "application",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette consigne stricte <w>vaut</w> pour l'ensemble du personnel de l'entreprise."
                        },
                        {
                            "text": "Le règlement intérieur <w>vaut</w> autant pour les nouveaux que pour les anciens."
