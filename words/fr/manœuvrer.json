    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ed37ab6a-a12a-3efc-821a-5cd552fbcd9a",
                    "sense_definition": "Actionner un appareil, une commande ou un mécanisme avec la main.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mecanisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le technicien doit <w>manœuvrer</w> ce levier avec précaution pour éviter une panne."
                        },
                        {
                            "text": "Elle a appris à <w>manœuvrer</w> les commandes complexes de la grue en atelier."
                        }
                    ],
                    "synonyms": [
                        "actionner",
                        "manipuler"
                    ],
                    "common_phrases": [
                        "manœuvrer un levier",
                        "manœuvrer une vanne"
                    ]
                },
                {
                    "sense_id": "da2f2e5c-cc37-397e-a08c-7b643d250d16",
                    "sense_definition": "Effectuer des mouvements précis pour diriger ou déplacer un véhicule ou un navire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "navigation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conducteur a dû <w>manœuvrer</w> pour se garer dans cet espace particulièrement étroit."
                        },
                        {
                            "text": "Le capitaine réussit à <w>manœuvrer</w> le navire malgré les vents violents au port."
                        }
                    ],
                    "synonyms": [
                        "piloter",
                        "guider"
                    ],
                    "common_phrases": [
                        "manœuvrer pour se garer",
                        "manœuvrer un bateau"
                    ]
                },
                {
                    "sense_id": "23aa6cdb-d85d-3112-b262-ec521640d23f",
                    "sense_definition": "Agir avec adresse, calcul ou ruse pour parvenir à ses fins.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "strategie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le candidat a su habilement <w>manœuvrer</w> pour remporter l'élection municipale."
                        },
                        {
                            "text": "Ils préfèrent <w>manœuvrer</w> en coulisse pour convaincre les membres du comité."
                        }
                    ],
                    "synonyms": [
                        "intriguer",
                        "combiner"
                    ],
                    "common_phrases": [
                        "manœuvrer en coulisse",
                        "manœuvrer habilement"
                    ]
                },
                {
                    "sense_id": "504b3270-9255-3d5c-9300-1d1133c14704",
                    "sense_definition": "Influencer insidieusement quelqu'un pour le contraindre à agir selon ses propres intérêts.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "strategie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet individu sans scrupule sait comment <w>manœuvrer</w> ses associés pour les tromper."
                        },
                        {
                            "text": "Le directeur refuse catégoriquement de se laisser <w>manœuvrer</w> par ses rivaux."
                        }
                    ],
                    "synonyms": [
                        "manipuler"
                    ],
                    "common_phrases": [
