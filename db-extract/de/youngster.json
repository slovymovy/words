                "senses": [
                    {
                        "sense_id": "4452c92c-f2e6-3b8b-b31c-7cb4b7c2af81",
                        "entry_id": "0174d2d8-8fe7-3c08-9483-8f111d0a9805",
                        "glosses": [
                            "Nachwuchssportler; neuer, junger Spieler in einer Mannschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44725107-c0ce-478b-90e4-d383121811f5",
                                "sense_id": "4452c92c-f2e6-3b8b-b31c-7cb4b7c2af81",
                                "text": "Der Youngster gab bei seinem ersten Spiel mit zweit Toren einen famosen Einstand."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0274f09b-6740-3ece-8d65-7068047fd887",
                        "entry_id": "0174d2d8-8fe7-3c08-9483-8f111d0a9805",
                        "glosses": [
                            "meist jüngere Person, die neu in eine bereits bestehenden Gruppe kommt und sich erst beweisen muss"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "948e47b9-7479-4d4d-a7b0-1f949f40edf8",
                                "sense_id": "0274f09b-6740-3ece-8d65-7068047fd887",
                                "text": "„Als Youngster in der Freiheitsbewegung hatte Torvalds ausgerechnet jenen Teil eines Betriebssystems programmiert, der Stallman und seiner Gruppe noch fehlte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "e32fb979-efb3-3774-862d-0bab94c1d740",
                        "entry_id": "0174d2d8-8fe7-3c08-9483-8f111d0a9805",
                        "glosses": [
                            "zweijähriges Pferd"
                        ],
                        "tags": [
                            "Reitsport"
                        ],
                        "examples": [],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "ef30253b-eafe-3741-80f6-7a215be51fce",
                        "entry_id": "0174d2d8-8fe7-3c08-9483-8f111d0a9805",
                        "glosses": [
                            "nicht erwachsene Person, die aber kein Kind mehr ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7db0bae8-6e20-4fb7-8665-e4e926a16aed",
                                "sense_id": "ef30253b-eafe-3741-80f6-7a215be51fce",
                                "text": "„Die fünf Youngster spielen die auf wiederkehrenden Mustern beruhenden Reels und Jigs: schnelle Tänze, wie man sie vor ein paar Hundert Jahren noch überall in Westeuropa hörte.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e1c7d9d-2883-4c3d-9558-aa833f93e4e5",
                        "source_entry_id": "0174d2d8-8fe7-3c08-9483-8f111d0a9805",
                        "source_sense_id": "ef30253b-eafe-3741-80f6-7a215be51fce",
                        "source_sense_description": "nicht erwachsene Person, die aber kein Kind mehr ist",
                        "target_lang_word": "youngster",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "youngster",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49ebe799-1222-39bc-89ca-ec83311463fa",
                                        "entry_id": "877e85c0-37f6-37e6-beba-fec7b3f31ca4",
                                        "glosses": [
                                            "A young person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2a3f9a1-04ef-4319-9f9b-8a6a838695f4",
                                                "sense_id": "49ebe799-1222-39bc-89ca-ec83311463fa",
                                                "text": "As soon as Julia returned with a constable, Timothy, who was on the point of exhaustion, prepared to give over to him gratefully. The newcomer turned out to be a powerful youngster, fully trained and eager to help, and he stripped off his tunic at once."
                                            },
                                            {
                                                "example_id": "4eaed8e2-9067-4ef9-9a16-889102173336",
                                                "sense_id": "49ebe799-1222-39bc-89ca-ec83311463fa",
                                                "text": "‘Cook-housekeeper jobs don’t grow on trees,’ went on the woman, ‘leastways not where you can keep a youngster with you.’ [...] ‘Do you mean,’ stammered Jess, ‘that you are . . .?’ ‘Cook-housekeeper,’ the woman nodded. ‘Aren’t I telling you? It’s all confirmed!’ ‘And the youngster – me?’ asked Jessamy. ‘Well, whoever else you silly child!’ said the housekeeper, smiling."
                                            },
                                            {
                                                "example_id": "0ea8b795-c75c-4b84-a5f8-c14f76c86c91",
                                                "sense_id": "49ebe799-1222-39bc-89ca-ec83311463fa",
                                                "text": "“Besides,” she says, looking possessively at her class of Chinese youngsters, “can you imagine these children going to an ordinary school?”"
                                            },
                                            {
                                                "example_id": "8186f84e-ac74-43b2-89ab-7875d2ac7cae",
                                                "sense_id": "49ebe799-1222-39bc-89ca-ec83311463fa",
                                                "text": "In a single moment Montenegro and their supporters were given fresh impetus and encouragement. Beciraj tested Hart with a low shot before teenager Phil Jones, on his England debut, suffered an anxious moment when Stevan Jovetic went down under his challenge, leaving the youngster clearly relieved to see referee Stark wave away Montenegro's appeals."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
