                        "examples": [
                            {
                                "example_id": "c7d25b1e-22eb-4d32-8ae5-1fbb75a6790b",
                                "sense_id": "ebf78977-8f29-3d61-8da5-4c72de0ae2da",
                                "text": "Une fortune commença cette année à poindre grandement et peu espérable alors, montée ensuite au comble."
                            },
                            {
                                "example_id": "d7631780-3903-46cb-9f18-55eeca854267",
                                "sense_id": "ebf78977-8f29-3d61-8da5-4c72de0ae2da",
                                "text": "Cette île fameuse n’avait plus de chevaliers, plus de soldats, plus d’artillerie, plus de vaisseaux en état de tenir la mer, plus de vivres même, plus rien, et le secours des princes chrétiens n’était plus espérable d’aucun côté."
                            }
                        ]
