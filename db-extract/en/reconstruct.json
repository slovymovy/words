                    {
                        "translation_id": "98eb5139-1a5c-40df-bab7-7a6211502d29",
                        "source_entry_id": "61f61865-5462-3a60-9712-d4e222259378",
                        "source_sense_description": "to construct again",
                        "target_lang_word": "rekonstruieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
