    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ac31c062-c312-3061-8145-2e33076720e4",
                    "sense_definition": "In a serious, solemn, or formal manner, often suggesting that a situation is critical or dangerous.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "seriousness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor looked at the test results and spoke <w>gravely</w> about the patient's condition.",
                            "target_lang_translations": {
                                "ru": "Врач посмотрел на результаты анализов и <w>серьезно</w> заговорил о состоянии пациента."
                            }
                        },
                        {
                            "text": "The president addressed the nation <w>gravely</w> to discuss the upcoming economic challenges.",
                            "target_lang_translations": {
                                "ru": "Президент <w>торжественно</w> обратился к нации, чтобы обсудить предстоящие экономические трудности."
                            }
                        }
                    ],
                    "synonyms": [
                        "seriously",
                        "solemnly",
                        "soberly"
                    ],
                    "antonyms": [
                        "lightly",
                        "cheerfully",
                        "frivolously"
                    ],
                    "common_phrases": [
                        "spoke gravely",
                        "nodded gravely",
                        "gravely ill"
                    ],
                    "target_lang_definitions": {
                        "ru": "Серьезным, торжественным или официальным образом, часто указывающим на критическую или опасную ситуацию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "серьезно",
                                "target_lang_sense_clarification": "о манере поведения или ситуации"
                            },
                            {
                                "target_lang_word": "торжественно",
                                "target_lang_sense_clarification": "официально и важно"
                            },
                            {
                                "target_lang_word": "тяжело",
                                "target_lang_sense_clarification": "в контексте болезни или состояния"
                            }
                        ]
                    }
                }
            ]
        },
        {
