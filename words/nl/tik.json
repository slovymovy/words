                                "ru": "Учитель дал ученику легкий исправительный <w>шлепок</w> по пальцам.",
                                "en": "The teacher gave the student a corrective <w>rap</w> on the fingers.",
                                "pl": "Nauczyciel dał uczniowi korygujące <w>klepnięcie</w> po palcach.",
                                "de": "Der Lehrer gab dem Schüler einen korrigierenden <w>Klaps</w> auf die Finger.",
                                "fr": "Le professeur a donné à l'élève un <w>petit coup</w> correctif sur les doigts.",
                                "it": "L'insegnante ha dato allo studente un <w>colpetto</w> correttivo sulle dita.",
                                "cs": "Učitel dal žákovi výchovné <w>ťuknutí</w> přes prsty.",
                                "tr": "Öğretmen öğrencinin parmaklarına düzeltici bir <w>hafif vuruş</w> yaptı.",
                                "es": "El profesor le dio al alumno un <w>golpecito</w> correctivo en los dedos.",
                                "zh": "老师在学生的手指上<w>轻拍</w>了一下以示惩戒。"
                            }
                        },
                        {
                            "text": "Hij gaf me een speelse <w>tik</w> op mijn schouder.",
                            "target_lang_translations": {
                                "ru": "Он игриво <w>хлопнул</w> меня по плечу.",
                                "en": "He gave me a playful <w>tap</w> on my shoulder.",
                                "pl": "Dał mi żartobliwego <w>klepnięcia</w> w ramię.",
                                "de": "Er gab mir einen spielerischen <w>Stupser</w> auf die Schulter.",
                                "fr": "Il m'a donné un <w>petit coup</w> amical sur l'épaule.",
                                "it": "Mi ha dato un <w>colpetto</w> giocoso sulla spalla.",
                                "cs": "Hravě mě <w>ťukl</w> do ramene.",
                                "tr": "Omzuma şakacı bir <w>dokunuş</w> yaptı.",
                                "es": "Me dio una <w>palmadita</w> juguetona en el hombro.",
                                "zh": "他顽皮地<w>轻拍</w>了我的肩膀。"
                            }
                        }
