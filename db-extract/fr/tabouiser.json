                ],
                "senses": [
                    {
                        "sense_id": "36475f75-4967-3b13-8a6d-5316bebafd71",
                        "entry_id": "d994e96e-3f17-3c56-9244-41e6379ec5e8",
                        "glosses": [
                            "Considérer comme tabou."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd271500-f943-43ec-8c74-732370ad30ce",
                                "sense_id": "36475f75-4967-3b13-8a6d-5316bebafd71",
                                "text": "Ajouterai-je que j’ai sans doute retiré ma pièce à Vilar parce que la presse le tabouisait au maléfice de Jean-Louis Barrault, tabou de la veille, détabouisé du jour au lendemain."
                            },
                            {
                                "example_id": "865e93c4-7537-42f2-8abe-b43a101a7ed0",
                                "sense_id": "36475f75-4967-3b13-8a6d-5316bebafd71",
                                "text": "[…] F. Mitterrand croit pouvoir se prévaloir du fait que, manifestement par égard pour ses voisins, le chancelier Kohl n’aborde jamais directement la question de l’unité allemande, lui faisant même le reproche de tabouiser le sujet et de cacher ses véritables intentions."
                            },
                            {
                                "example_id": "63c8b273-6f98-4f08-a10a-3309bb8d296f",
                                "sense_id": "36475f75-4967-3b13-8a6d-5316bebafd71",
                                "text": "Le régime diversitaire s’est constitué en tabouisant la question de l’immigration."
                            }
                        ]
                    }
                ],
