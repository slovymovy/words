                "senses": [
                    {
                        "sense_id": "6f74e400-9ea7-3032-8096-7c1e62ac2aa4",
                        "entry_id": "0c63f238-a7da-322f-91d1-538efaa12e8e",
                        "glosses": [
                            "deutscher Soldat während der Weltkriege"
                        ],
                        "tags": [
                            "historical",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "8c50bcd9-9592-480c-ae3d-2cf16626bde7",
                                "sense_id": "6f74e400-9ea7-3032-8096-7c1e62ac2aa4",
                                "text": "„Aber die Feldgrauen sind die Brüder dieser ausgemergelten, verhungerten Massen, sie schleudern die Gewehre zu Boden, die Tore springen auf, das Volk dringt in die Kaserne und verbrüdert sich mit den Soldaten des Kaisers.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03e35878-49b6-4e5d-9017-418e86cedb97",
                        "source_entry_id": "0c63f238-a7da-322f-91d1-538efaa12e8e",
                        "source_sense_id": "6f74e400-9ea7-3032-8096-7c1e62ac2aa4",
