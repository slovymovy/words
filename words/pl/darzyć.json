                {
                    "sense_id": "f7ac68ac-f42b-3143-9984-0dd21723e696",
                    "sense_definition": "czuć do kogoś określone uczucie lub mieć wobec kogoś konkretne nastawienie",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "uczucia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Darzę</w> ją wielkim szacunkiem.",
                            "target_lang_translations": {
                                "ru": "Я <w>питаю</w> к ней огромное уважение."
                            }
                        },
                        {
                            "text": "Rodzice <w>darzą</w> go ogromnym zaufaniem.",
                            "target_lang_translations": {
                                "ru": "Родители <w>питают</w> к нему огромное доверие."
                            }
                        }
                    ],
                    "synonyms": [
                        "żywić"
                    ],
                    "common_phrases": [
                        "darzyć zaufaniem",
                        "darzyć szacunkiem",
                        "darzyć sympatią"
                    ],
                    "target_lang_definitions": {
                        "ru": "испытывать к кому-либо определенное чувство или иметь конкретное отношение"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "питать",
                                "target_lang_sense_clarification": "использовать с существительными, обозначающими чувства (уважение, доверие, симпатию)"
                            },
                            {
                                "target_lang_word": "относиться",
                                "target_lang_sense_clarification": "иметь определенное отношение к кому-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6aa2a27-5670-3407-a811-488a3cc2b3c1",
                    "sense_definition": "obdarowywać kogoś czymś, dawać komuś coś w darze",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dawanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Los <w>darzy</w> nas wieloma niespodziankami.",
                            "target_lang_translations": {
                                "ru": "Судьба <w>одаривает</w> нас множеством сюрпризов."
                            }
                        },
                        {
                            "text": "Przyroda <w>darzy</w> nas swoimi owocami każdego lata.",
                            "target_lang_translations": {
                                "ru": "Природа <w>одаривает</w> нас своими плодами каждое лето."
                            }
                        }
                    ],
                    "synonyms": [
