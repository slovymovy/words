                "senses": [
                    {
                        "sense_id": "18e23fb3-64dd-33c6-93f1-015df5f25f37",
                        "entry_id": "348b163e-83ce-3410-a713-f88b3a48950d",
                        "glosses": [
                            "To fail to finish, as a sporting event or a piece of media."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a21a3ee3-1f00-4281-a4fa-acfaa5766907",
                                "sense_id": "18e23fb3-64dd-33c6-93f1-015df5f25f37",
                                "text": "While I used to love them, now I keep DNFing superhero movies."
                            },
                            {
                                "example_id": "5b948fce-7eee-4ec1-a325-3f5e2904a8d4",
                                "sense_id": "18e23fb3-64dd-33c6-93f1-015df5f25f37",
                                "text": "He'd DNFed and could have gone home an hour earlier, but he wanted to see me win."
                            },
                            {
                                "example_id": "179982ca-eb67-4183-9c1c-df1005aeebfa",
                                "sense_id": "18e23fb3-64dd-33c6-93f1-015df5f25f37",
                                "text": "Others refuse to ever DNF, slowly slogging through even the worst of books. I fall somewhere in the middle. I'll DNF a book early on if I realize I'm unlikely to enjoy it."
                            }
                        ]
                    }
                ],
