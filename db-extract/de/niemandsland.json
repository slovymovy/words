                        ],
                        "form": "den Niemandsländern"
                    },
                    {
                        "form_id": "88e8c3c9-1f3d-4da2-bbc4-c1a14adbe0c6",
                        "entry_id": "6af2e793-b78f-3898-ba97-5efebe9e260f",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Niemandsland"
                    },
                    {
                        "form_id": "ee78d175-8f60-4e0b-b104-22416b1a4805",
                        "entry_id": "6af2e793-b78f-3898-ba97-5efebe9e260f",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Niemandsländer"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "34f8ab72-294b-3ebd-b161-c95be4a6d7d3",
                        "entry_id": "6af2e793-b78f-3898-ba97-5efebe9e260f",
                        "glosses": [
                            "staatsrechtlich herrenloses Land (z.B. Grenzgebiete) oder Land zwischen den Fronten im Krieg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f40ed47-2af8-4feb-a093-14e84b1a478a",
                                "sense_id": "34f8ab72-294b-3ebd-b161-c95be4a6d7d3",
                                "text": "Gegen Morgen kamen wir an einem Melonenfeld vorbei, das irgendein unternehmungslustiger Araber in diesem Niemandsland zwischen den feindlichen Armeen ausgesät hatte."
                            },
                            {
                                "example_id": "5e09d84c-9d55-48b2-845d-a5e95f9395b1",
                                "sense_id": "34f8ab72-294b-3ebd-b161-c95be4a6d7d3",
                                "text": "„Im Niemandsland zwischen Nordhausen und Duderstadt war Kurt Marenke wieder zu Gepäck gekommen.“"
                            },
                            {
                                "example_id": "0df066a0-a3e9-4961-a508-fcaa8243d0b3",
                                "sense_id": "34f8ab72-294b-3ebd-b161-c95be4a6d7d3",
                                "text": "„Bis dahin war die Antarktis als herrenloses Niemandsland behandelt worden.“"
                            },
                            {
                                "example_id": "825cdb91-a2c4-4df3-93b9-546baf59db72",
                                "sense_id": "34f8ab72-294b-3ebd-b161-c95be4a6d7d3",
                                "text": "„Wie sich herausstellte, waren Hamids ängstliche Warnungen nur gutes altes Misstrauen unter Nachbarn, und unsere Fahrt durch die 15 Kilometer Niemandsland zwischen Algerien und dem Niger war ereignislos.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "eac2eab2-7eea-35d9-95cb-4e6028235bec",
                        "entry_id": "6af2e793-b78f-3898-ba97-5efebe9e260f",
                        "glosses": [
                            "nicht besiedeltes oder unwirtschaftliches Land"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce2b820c-ebd6-4e0c-b365-eadc79635022",
                                "sense_id": "eac2eab2-7eea-35d9-95cb-4e6028235bec",
                                "text": "…eine von den nördlichsten Inseln der Gruppe: einsam, abgelegen und öde, anzusehen wie das Niemandsland, das man an den nördlichsten Küstenstreifen unseres Kontinents gewahrt."
                            },
                            {
                                "example_id": "c4592522-8251-4397-b6eb-faff6f7b6e93",
                                "sense_id": "eac2eab2-7eea-35d9-95cb-4e6028235bec",
                                "text": "„Einige Minuten fuhren sie durch bemoostes Niemandsland, dann grüßte sie ein chinesischer Offizier.“"
                            },
                            {
                                "example_id": "43f6bd98-5510-44bc-a329-25111bf8854f",
                                "sense_id": "eac2eab2-7eea-35d9-95cb-4e6028235bec",
                                "text": "„Oder im Großraum Marseille werden abseits der pittoresken Felsbuchten der ‚Calanques‘ 250 Kilometer neue Wanderwege durch Industriegebiete, Stromleitungswälder und Niemandsländer angelegt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "0e632756-965f-3e4a-8133-1a7a72aa5117",
                        "entry_id": "6af2e793-b78f-3898-ba97-5efebe9e260f",
                        "glosses": [
                            "(im übertragenen Sinne) unklares, undefiniertes oder wenig bis unerforschtes Gebiet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6900d744-8c2e-432e-928a-0a23b178ea58",
                                "sense_id": "0e632756-965f-3e4a-8133-1a7a72aa5117",
                                "text": "Die Anleger sind eigentlich ratlos, und deshalb bewegt sich der DAX derzeit im Niemandsland."
                            },
                            {
                                "example_id": "af8e5554-4f1e-4684-af61-af0607f47924",
                                "sense_id": "0e632756-965f-3e4a-8133-1a7a72aa5117",
                                "text": "Guantánamo Bay ist ein rechtliches Niemandsland, in dem Gefangene außerhalb der Rechtsstaatlichkeit festgehalten werden."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
