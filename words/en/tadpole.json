{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d58b96bf-b44a-3f08-a377-ade5ca210c49",
                    "sense_definition": "A young frog or toad in its larval stage that lives in water and has a tail.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "amphibian_larva",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>tadpole</w> swam quickly through the pond water.",
                            "target_lang_translations": {
                                "pl": "<w>Kijanka</w> szybko przepłynęła przez wodę w stawie."
                            }
                        },
                        {
                            "text": "We watched the <w>tadpole</w> grow legs and eventually leave the water.",
                            "target_lang_translations": {
                                "pl": "Obserwowaliśmy, jak <w>kijanka</w> wypuszcza nogi i w końcu opuszcza wodę."
                            }
                        }
                    ],
                    "synonyms": [
                        "polliwog",
                        "porriwiggle"
                    ],
                    "target_lang_definitions": {
                        "pl": "Larwa płaza bezogonowego (żaby lub ropuchy), żyjąca w wodzie i posiadająca ogon."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "kijanka",
                                "target_lang_sense_clarification": "larwa żaby lub ropuchy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11404942-ee55-3e07-a666-5f7ca87cd4a2",
                    "sense_definition": "The aquatic larva of any amphibian.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "amphibian_larva",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researcher identified the salamander <w>tadpole</w> in the stream.",
                            "target_lang_translations": {
                                "pl": "Badacz zidentyfikował <w>kijankę</w> salamandry w strumieniu."
                            }
                        },
                        {
                            "text": "Many species of newt begin their life cycle as an aquatic <w>tadpole</w>.",
                            "target_lang_translations": {
                                "pl": "Wiele gatunków traszek rozpoczyna swój cykl życiowy jako wodna <w>kijanka</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Wodne stadium larwalne płaza."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "kijanka",
                                "target_lang_sense_clarification": "ogólne określenie larwy płaza"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b74cb62-71f7-3dbd-b60e-5cd8ad036548",
                    "sense_definition": "A small child.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "child",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is time for you little <w>tadpoles</w> to go to sleep now.",
                            "target_lang_translations": {
                                "pl": "Czas już, żebyście wy, małe <w>szkraby</w>, szli spać."
                            }
                        },
                        {
                            "text": "The energetic <w>tadpoles</w> ran around the playground all afternoon.",
                            "target_lang_translations": {
                                "pl": "Energiczne <w>maluchy</w> biegały po placu zabaw przez całe popołudnie."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used affectionately or playfully to refer to children."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Małe dziecko (używane pieszczotliwie lub żartobliwie)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "szkrab",
                                "target_lang_sense_clarification": "pieszczotliwe określenie małego dziecka"
                            },
                            {
                                "target_lang_word": "maluch",
                                "target_lang_sense_clarification": "małe dziecko"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "daa55ad7-6d89-3f20-bf12-00258006ae04",
                    "sense_definition": "An insignificant or unimportant person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "child",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The arrogant man treated everyone he met like a mere <w>tadpole</w>.",
                            "target_lang_translations": {
                                "pl": "Arogancki mężczyzna traktował każdego, kogo spotkał, jak zwykłego <w>pionka</w>."
                            }
                        },
                        {
                            "text": "Do not let that <w>tadpole</w> tell you how to run your business.",
                            "target_lang_translations": {
                                "pl": "Nie pozwól, żeby ten <w>pionek</w> mówił ci, jak prowadzić biznes."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Osoba nieistotna lub nieważna."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "pionek",
                                "target_lang_sense_clarification": "osoba o małym znaczeniu"
                            },
                            {
                                "target_lang_word": "nikt",
                                "target_lang_sense_clarification": "osoba bez znaczenia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a833b2f-faf1-3b04-a953-42cc2b0f67ed",
                    "sense_definition": "A simple drawing of a person with a large head and stick limbs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child proudly showed me a <w>tadpole</w> he drew in class.",
                            "target_lang_translations": {
                                "pl": "Dziecko z dumą pokazało mi <w>głowonoga</w>, którego narysowało w klasie."
                            }
                        },
                        {
                            "text": "Developmental psychologists often study the <w>tadpole</w> as a stage in children's art.",
                            "target_lang_translations": {
                                "pl": "Psycholodzy rozwojowi często badają <w>głowonoga</w> jako etap w dziecięcej twórczości plastycznej."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Prosty rysunek postaci z dużą głową i kreskowymi kończynami."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "głowonóg",
                                "target_lang_sense_clarification": "wczesny etap rysunku dziecka przedstawiający postać jako głowę z nogami"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a37988ec-b8da-3137-9dff-a88703a54b32",
                    "sense_definition": "A cargo bicycle with two wheels in the front and one in the back.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He uses a <w>tadpole</w> to deliver heavy packages across the city.",
                            "target_lang_translations": {
                                "pl": "Używa <w>roweru towarowego typu tadpole</w> do dostarczania ciężkich paczek przez miasto."
                            }
                        },
                        {
                            "text": "The stability of a <w>tadpole</w> makes it great for carrying groceries.",
                            "target_lang_translations": {
                                "pl": "Stabilność <w>roweru typu tadpole</w> sprawia, że świetnie nadaje się do przewożenia zakupów."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Rower towarowy z dwoma kołami z przodu i jednym z tyłu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rower towarowy typu tadpole",
                                "target_lang_sense_clarification": "specjalistyczne określenie konstrukcji roweru"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}