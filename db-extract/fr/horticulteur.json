                                "target_senses": [
                                    {
                                        "sense_id": "aa7de875-239b-3559-b732-1de4a6becd78",
                                        "entry_id": "2c76e766-6746-380f-8588-7cd8eb938d0f",
                                        "glosses": [
                                            "A gardener; a person interested in or practicing horticulture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b8ea011-38ee-4cfc-b702-ccb20506c922",
                                                "sense_id": "aa7de875-239b-3559-b732-1de4a6becd78",
                                                "text": "[…] [I]nfected tulips are weakened by the viruses that cause the very patterns and swirls that fascinated horticulturists and investors in the first place."
                                            }
                                        ]
