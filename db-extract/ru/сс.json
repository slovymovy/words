                                                "example_id": "6384710c-342a-46c8-abf1-32652d90c831",
                                                "sense_id": "50b90c6f-c85e-3d88-b979-acf3101bfe61",
                                                "text": "The officer who cut off Rachabalizoda’s ear had military patches including a far-right Totenkopf (dead person’s head) previously worn by Nazi SS units."
                                            },
                                            {
                                                "example_id": "3a104656-bbf8-420a-a7ce-e8d4db10656f",
                                                "sense_id": "50b90c6f-c85e-3d88-b979-acf3101bfe61",
                                                "text": "(It's possible that at least some of the liberals who answered \"yes, violence can sometimes be justified\" had in mind edge cases like armed resistance by Jews against the SS, not the assassination of peaceful political pundits with whom they disagree.)"
                                            }
                                        ]
