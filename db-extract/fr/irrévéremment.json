            {
                "entry_id": "5e196ff6-a091-319a-9485-405f76745b38",
                "word": "irrévéremment",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "96cd38ce-ff82-3c99-b0d7-0f1da455b29e",
                        "entry_id": "5e196ff6-a091-319a-9485-405f76745b38",
                        "glosses": [
                            "D’une manière irrévérente."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7c3e03c-df2c-4140-bdc9-607793941709",
                                "sense_id": "96cd38ce-ff82-3c99-b0d7-0f1da455b29e",
                                "text": "Un roi ne permet pas dans ses États qu’on parle irrévéremment même d’un roi étranger, même d’un roi ennemi, tant le nom de roi est vénérable partout où il se rencontre."
                            },
                            {
                                "example_id": "fea5bf8c-cea6-4aa0-bb50-22985f1ea068",
                                "sense_id": "96cd38ce-ff82-3c99-b0d7-0f1da455b29e",
                                "text": "Si tost que la dame ouyt ce, elle luy dit : Sire chevalier, ne vous desplaise, se jusques à present ay parlé si irreveremment à vous ; car l’on ne connoist pas les gens à les veoir."
                            },
                            {
                                "example_id": "51f6d911-e8b7-432f-bce6-e3ac37135ed3",
                                "sense_id": "96cd38ce-ff82-3c99-b0d7-0f1da455b29e",
                                "text": "Parler irreveremment des œuvres de Dieu."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff527194-c094-454f-bd8e-c35773de3def",
                        "source_entry_id": "5e196ff6-a091-319a-9485-405f76745b38",
                        "source_sense_id": "96cd38ce-ff82-3c99-b0d7-0f1da455b29e",
                        "target_lang_word": "irreverently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irreverently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2267c6ff-504e-33d9-8f69-453f21d57fb1",
                                        "entry_id": "2defc725-fdee-336d-a52b-3ad3eeb55cf2",
                                        "glosses": [
                                            "In an irreverent manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6db443d8-816b-4e05-ac71-9f4703a54a75",
                                                "sense_id": "2267c6ff-504e-33d9-8f69-453f21d57fb1",
                                                "text": "He finds out, soon enough for his weal and his bane, that he is stronger than Nature: and right tyrannously and irreverently he lords it over her, clearing, delving, dyking, building, without fear or shame."
                                            },
                                            {
                                                "example_id": "3707a739-2cef-4dbc-a9c2-1da28333df86",
                                                "sense_id": "2267c6ff-504e-33d9-8f69-453f21d57fb1",
                                                "text": "Elisha […] was able to call upon two she-bears to come and eat up the children who had treated him irreverently […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
