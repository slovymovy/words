                        "source_sense_id": "d8967c79-3744-3f3f-b437-0900d12eb285",
                        "source_sense_description": "Zimmer/Raum, der verschiedenen Zwecken dient",
                        "target_lang_word": "salle polyvalente",
                        "target_lang_code": "fr",
