                "senses": [
                    {
                        "sense_id": "0f0c9684-6899-3c5f-b9e1-fa1b91e1ea9a",
                        "entry_id": "624efe09-d1a6-3def-b48f-3f760d176962",
                        "glosses": [
                            "ein Mensch, der ungeschickt und nicht ganz ernst zu nehmen ist"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c6c66aaf-bd20-4a4d-9037-c8bfd6392ab7",
                                "sense_id": "0f0c9684-6899-3c5f-b9e1-fa1b91e1ea9a",
                                "text": "Hugo kommt oft zu spät und hält sich kaum an die Vorgaben. Wenn er wiedermal etwas Schusseliges anstellt, kommt von seinen Kollegen nur: \"So ein Säftel!\""
                            },
                            {
                                "example_id": "77ac4c22-d605-45f6-80ad-ba915c1b7a03",
                                "sense_id": "0f0c9684-6899-3c5f-b9e1-fa1b91e1ea9a",
                                "text": "Dieser Säftel hat den E-Mail-Anhang vergessen!"
                            },
                            {
                                "example_id": "4570b9a2-1d7b-4049-af70-1cf9e7d576b7",
                                "sense_id": "0f0c9684-6899-3c5f-b9e1-fa1b91e1ea9a",
                                "text": "Eine an sich liebe Person lässt das Essen anbrennen oder den Kuchen zu lang im Ofen. Getrost kann man ihn oder sie als wahrhaftigen Säftel bezeichnen."
                            },
                            {
                                "example_id": "7c5dd8bc-5f5c-454d-8f75-62df09724936",
                                "sense_id": "0f0c9684-6899-3c5f-b9e1-fa1b91e1ea9a",
                                "text": "Markus gibt nur unqualifizierte Kommentare von sich. Er verhält sich wie der letzte Säftel. Idiot wäre zu harsch und Depp zu lasch."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
