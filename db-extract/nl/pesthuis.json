                    {
                        "sense_id": "992c1fae-1ae2-3b30-a838-1bb79744a8e6",
                        "entry_id": "e540e237-5902-319a-bfab-fefd894b5edd",
                        "glosses": [
                            "gebouw waarin pestlijders werden geïsoleerd en verzorgd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f6b9147-c042-41cc-8401-5be0213985c7",
                                "sense_id": "992c1fae-1ae2-3b30-a838-1bb79744a8e6",
                                "text": "De pestepidemieën van de zeventiende eeuw waren zo omvangrijk dat het Amsterdamse pesthuis bij het Sint-Pietersgasthuis - het latere Binnengasthuis - te klein werd."
                            },
                            {
                                "example_id": "e762e8b2-e7d4-4f2e-8dba-4768c091bccd",
                                "sense_id": "992c1fae-1ae2-3b30-a838-1bb79744a8e6",
                                "text": "Tegelijkertijd werden er ook praktische maatregelen genomen, zoals het merken van huizen van pestlijders die niet in het pesthuis waren opgenomen; niemand mocht daar naar binnen."
                            }
                        ]
                    }
