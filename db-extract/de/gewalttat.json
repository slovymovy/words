                ],
                "senses": [
                    {
                        "sense_id": "6d8d3580-86d6-39c5-bd2f-9167cdde5c7a",
                        "entry_id": "532a6b78-00eb-3fbe-bb68-19d73f80ca2e",
                        "glosses": [
                            "aggressive Handlung, bei der körperliche oder technische Gewalt gegen eine Person/Personen ausgeübt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65c7decf-5d5d-4289-a96b-8851dd8bdecc",
                                "sense_id": "6d8d3580-86d6-39c5-bd2f-9167cdde5c7a",
                                "text": "„Wenn diese Berichte von Gewalttaten oder verbotener Leidenschaft handelten, dann umso besser.“"
                            },
                            {
                                "example_id": "a05387b7-a6ef-4b72-b973-999bc54c1509",
                                "sense_id": "6d8d3580-86d6-39c5-bd2f-9167cdde5c7a",
                                "text": "„Die meisten waren an Krankheiten oder durch Gewalttaten gestorben.“"
                            },
                            {
                                "example_id": "6f2523e2-8321-49f8-89f3-a0c739e94f41",
                                "sense_id": "6d8d3580-86d6-39c5-bd2f-9167cdde5c7a",
                                "text": "„Die Gewalttat fand in ihrem Hotelzimmer statt.“"
                            },
                            {
                                "example_id": "d6973fc5-49b0-4ae6-bf2f-3977542b78eb",
                                "sense_id": "6d8d3580-86d6-39c5-bd2f-9167cdde5c7a",
                                "text": "„Auch andernorts verübten junge Neonazis zuletzt schwere Gewalttaten.“"
                            },
                            {
                                "example_id": "dd5be632-f260-4875-b620-061c4221398f",
                                "sense_id": "6d8d3580-86d6-39c5-bd2f-9167cdde5c7a",
                                "text": "„Die Führung des südafrikanischen ANC unter dem Pazifisten Albert Luthuli gab sich alle erdenkliche Mühe, die eigene Anhängerschaft von Gewalttaten abzuhalten, und führte sogar ein Gewaltlosigkeitstraining für ihre Aktivisten durch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
