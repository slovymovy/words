                    {
                        "sense_id": "e8e39e60-14c8-3ed9-909e-fadba879dfd4",
                        "entry_id": "3086ba96-f09a-3dc9-a956-8d3ae0c20a24",
                        "glosses": [
                            "снимать (снять) или нарушать (нарушить) маскировку, делая заметным"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90c9a04c-cc7e-4c22-80cc-f10f74043b5f",
                                "sense_id": "e8e39e60-14c8-3ed9-909e-fadba879dfd4",
                                "text": "Печку топить не разрешали. Это могло нас демаскировать."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd5b1172-75e4-45ff-9ec5-78958a9174d6",
                        "source_entry_id": "3086ba96-f09a-3dc9-a956-8d3ae0c20a24",
                        "source_sense_id": "e8e39e60-14c8-3ed9-909e-fadba879dfd4",
                        "target_lang_word": "decamouflage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "241c7341-a7ac-4004-801e-c3fb08ab9965",
                        "source_entry_id": "3086ba96-f09a-3dc9-a956-8d3ae0c20a24",
                        "source_sense_id": "e8e39e60-14c8-3ed9-909e-fadba879dfd4",
                        "target_lang_word": "unmask",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unmask",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "39595e65-5d81-3976-a04a-2854f29f097b",
                                        "entry_id": "21510009-26c6-3e71-a836-5aa9299612ed",
                                        "glosses": [
                                            "To remove a mask from someone."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b1d72ea-1c5e-3a24-b5c3-275e17c705b3",
                                        "entry_id": "21510009-26c6-3e71-a836-5aa9299612ed",
                                        "glosses": [
                                            "To expose, or reveal the true character of someone."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9ced00a-2efa-44fa-9741-9c6c6378bbe9",
                                                "sense_id": "3b1d72ea-1c5e-3a24-b5c3-275e17c705b3",
                                                "text": "The Charieſt maide is prodigall enough, / If ſhe vnmaske hir beautie to the Moone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23df59d4-3680-3463-9b50-ea2919b40c52",
                                        "entry_id": "21510009-26c6-3e71-a836-5aa9299612ed",
                                        "glosses": [
                                            "To remove one's mask."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0e4d397-7abf-42b6-a2f7-6c0a830705c4",
                                                "sense_id": "23df59d4-3680-3463-9b50-ea2919b40c52",
                                                "text": "But instead of a direct answer to so important a question, Jones began to be very importunate with the lady to unmask; and at length having prevailed, there appeared not Mrs Fitzpatrick, but the Lady Bellaston herself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ee66644-bb05-3707-bf6b-ecef7917b2dd",
                                        "entry_id": "21510009-26c6-3e71-a836-5aa9299612ed",
                                        "glosses": [
                                            "To cease engaging in masking, to cease disguising one's autism."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdae3067-991a-4f23-9af7-39e88d4ba927",
                                                "sense_id": "5ee66644-bb05-3707-bf6b-ecef7917b2dd",
                                                "text": "[…] to unmask and to assume her 'natural' role (rather than her 'fitting in' role)."
                                            },
                                            {
                                                "example_id": "aec31fc5-cc20-42b7-aeee-8a520f3b6859",
                                                "sense_id": "5ee66644-bb05-3707-bf6b-ecef7917b2dd",
                                                "text": "Autistic females are trying to adhere to social expectations placed upon them, and masking and blending to fit those expectations, […] How do you unmask when you have spent a [long time masking]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afc1b29e-63e9-32ef-8623-8989fd6760d6",
                                        "entry_id": "21510009-26c6-3e71-a836-5aa9299612ed",
                                        "glosses": [
                                            "To expose something that was concealed or shielded from an enemy."
                                        ],
                                        "tags": [
                                            "dated",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "465a90bb-4470-4923-96b3-3815212ce87d",
                                                "sense_id": "afc1b29e-63e9-32ef-8623-8989fd6760d6",
                                                "text": "He recalled his horse. This, retiring, unmasked the heavy infantry, which Hannibal called in from either flank and sent with a vigorous élan in close column across the ford against the ill-arrayed barbarians, followed by the cavalry, which had formed again in its rear."
                                            },
                                            {
                                                "example_id": "ab08b3e8-095a-452b-933f-057a7bf7b9f3",
                                                "sense_id": "afc1b29e-63e9-32ef-8623-8989fd6760d6",
                                                "text": "In less than an hour the batteries were unmasked. The Confederate works were visible and at 5:08 a.m., Seymour ordered the batteries to commence firing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3a757ad-0938-35a9-b6f3-f180310eba92",
                                        "entry_id": "21510009-26c6-3e71-a836-5aa9299612ed",
                                        "glosses": [
                                            "To enable (an interrupt, etc.) by unsetting or setting the associated bit."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "167b7a1f-35bc-4164-8df7-65f93b3de7ca",
                        "source_entry_id": "3086ba96-f09a-3dc9-a956-8d3ae0c20a24",
