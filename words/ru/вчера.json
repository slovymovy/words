                    "semantic_group_id": "literal_yesterday",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "А потом «сегодня» превратилось во «<w>вчера</w>», и начался новый день.",
                            "target_lang_translations": {
                                "en": "And then 'today' turned into '<w>yesterday</w>', and a new day began.",
                                "zh": "后来“今天”变成了“<w>昨天</w>”，新的一天开始了。",
                                "de": "Und dann wurde aus dem „Heute“ ein „<w>Gestern</w>“ und ein neuer Tag begann.",
                                "nl": "En toen veranderde 'vandaag' in '<w>gisteren</w>' en begon er een nieuwe dag.",
                                "pl": "A potem „dzisiaj” zmieniło się we „<w>wczoraj</w>” i zaczął się nowy dzień.",
                                "fr": "Et puis « aujourd'hui » s'est transformé en « <w>hier</w> », et un nouveau jour a commencé.",
                                "it": "E poi l'«oggi» si è trasformato in «<w>ieri</w>» ed è iniziato un nuovo giorno.",
                                "cs": "A pak se „dnešek“ změnil ve „<w>včerejšek</w>“ a začal nový den.",
                                "tr": "Ve sonra 'bugün' '<w>dün</w>'e dönüştü ve yeni bir gün başladı.",
                                "es": "Y luego el «hoy» se convirtió en «<w>ayer</w>» y comenzó un nuevo día."
                            }
                        },
                        {
                            "text": "Не стоит жить одним только <w>вчера</w>.",
                            "target_lang_translations": {
                                "en": "One shouldn't live only in <w>yesterday</w>.",
                                "zh": "人不应该只活在<w>昨天</w>里。",
                                "de": "Man sollte nicht nur im <w>Gestern</w> leben.",
                                "nl": "Je moet niet alleen in het <w>gisteren</w> leven.",
                                "pl": "Nie warto żyć samym tylko <w>wczoraj</w>.",
                                "fr": "Il ne faut pas vivre uniquement dans le <w>hier</w>.",
                                "it": "Non bisogna vivere solo di <w>ieri</w>.",
                                "cs": "Nemá cenu žít jen <w>včerejškem</w>.",
                                "tr": "Sadece <w>dün</w> ile yaşanmaz.",
                                "es": "No vale la pena vivir solo del <w>ayer</w>."
                            }
                        }
