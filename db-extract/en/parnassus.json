    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "cf8952bc-9b4f-3175-938e-5de56c9fbc73",
                "word": "Parnassus",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "abe28efc-4093-3fa2-a938-81c5b92c07a1",
                        "entry_id": "cf8952bc-9b4f-3175-938e-5de56c9fbc73",
                        "glosses": [
                            "A mountain in central Greece, adjacent the site of the ancient city of Delphi, that in Greek mythology was sacred to Apollo and the Corycian nymphs and was the home of the Muses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad7cd1f4-3137-47ff-abd4-012e1a6b4e88",
                                "sense_id": "abe28efc-4093-3fa2-a938-81c5b92c07a1",
                                "text": "Go down beside thy native rill,\n⁠On thy Parnassus set thy feet,\n⁠And hear thy laurel whisper sweet\nAbout the ledges of the hill."
                            },
                            {
                                "example_id": "e86880c1-61b3-466d-8210-d8521dfd0a2e",
                                "sense_id": "abe28efc-4093-3fa2-a938-81c5b92c07a1",
                                "text": "Phocis separates the Aonian from the Actæan region; a fruitful land while it was a land; but at that time it had become a part of the sea, and a wide plain of sudden waters. There a lofty mountain rises towards the stars, with two tops, by name Parnassus, and advances beyond the clouds with its summit."
                            }
                        ]
                    },
                    {
                        "sense_id": "adb3a96e-dde3-3810-9fe5-8efa950ffcc9",
                        "entry_id": "cf8952bc-9b4f-3175-938e-5de56c9fbc73",
                        "glosses": [
                            "The home of poetry, literature, and learning."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "69293ed5-f584-4ef8-bfa9-564ba74cb08f",
                                "sense_id": "adb3a96e-dde3-3810-9fe5-8efa950ffcc9",
                                "text": "His intrinsic beauty and power meant nothing to the hundreds of thousands who were acclaiming him and buying his books. He was the fad of the hour, the adventurer who had stormed Parnassus while the gods nodded."
                            },
                            {
                                "example_id": "426c4d9b-5f3c-44a0-a272-7c3b7e04dd9c",
                                "sense_id": "adb3a96e-dde3-3810-9fe5-8efa950ffcc9",
                                "text": "[…] \"He's arguably the best pitcher on the Mets,\" the preening sportswriter writes, aspiring to Parnassus, which Red Smith reached by never using words like \"arguably.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "98183e26-e054-3f78-9a43-4a7ea5adf457",
                        "entry_id": "cf8952bc-9b4f-3175-938e-5de56c9fbc73",
                        "glosses": [
                            "A small town in Hurunui district, north Canterbury, New Zealand, named after Mount Parnassus."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
