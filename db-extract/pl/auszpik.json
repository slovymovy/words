                                    }
                                ]
                            },
                            {
                                "target_word": "aspic",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "98a27db9-2672-33e9-9fd6-b2322ea495b3",
                                        "entry_id": "278394b9-d0e7-3f68-abd9-0b7d236a5cfd",
                                        "glosses": [
                                            "Synonyme de lavande aspic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21d82f59-d034-409d-be42-506a973de558",
                                                "sense_id": "98a27db9-2672-33e9-9fd6-b2322ea495b3",
                                                "text": "Le sol n'était qu'une immense dalle de calcaire bleuté, sillonnée de fentes toutes brodées de thym, de rue et d'aspic…"
                                            },
                                            {
                                                "example_id": "7dc584fa-d597-4134-90ca-9b2e71c3fe99",
                                                "sense_id": "98a27db9-2672-33e9-9fd6-b2322ea495b3",
                                                "text": "Sur les plateaux de la garrigue, le thym, le romarin, le cade et le kermès gardent leurs feuilles éternelles autour de l’aspic toujours bleu."
                                            },
                                            {
                                                "example_id": "cc0cc04b-7ed5-47e9-8870-669832adc8b7",
                                                "sense_id": "98a27db9-2672-33e9-9fd6-b2322ea495b3",
                                                "text": "Qu’est-elle maintenant, Sylvius, cette femme d’autrefois à jamais endormie ? Une cendre légère dispersée dans la vallée, un souffle dans la fraîcheur des matins, un parfum qui se joint au parfum de l’aspic, quand fleurissent les jours glorieux du printemps."
                                            },
                                            {
                                                "example_id": "52175741-52f6-4607-b86a-5b8495192c79",
                                                "sense_id": "98a27db9-2672-33e9-9fd6-b2322ea495b3",
                                                "text": "L’odeur de l’essence d’aspic est camphrée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2e24f75-ce05-4689-9ad0-8dddba7e3e67",
                        "source_entry_id": "04d193f5-c7b6-360f-80b5-aece17e2d123",
                        "source_sense_id": "af71ad9f-4c8c-3ed3-987f-68248a2b3077",
                        "target_lang_word": "Aspik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aspik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2d3b9b90-238b-3532-af73-a69f41aa72c9",
                                        "entry_id": "d36b7b29-c6fa-3d2d-9614-0a3bb021d155",
                                        "glosses": [
                                            "säuerliches Gallert aus Gelatine oder Kalbsknochen zum Überzug von Speisen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5958817-733b-48d6-9150-fdfd5ae17675",
                                                "sense_id": "2d3b9b90-238b-3532-af73-a69f41aa72c9",
                                                "text": "„Der königliche Haushofmeister Johann Rottenhöfer weist darin an, wie in Aspik eingelegte winzige Forellen die Tafel verschönern - und das Ganze wie ein Aquarium aussieht.“"
                                            },
                                            {
                                                "example_id": "02b474e8-24d9-4972-92aa-e9c09271f30e",
                                                "sense_id": "2d3b9b90-238b-3532-af73-a69f41aa72c9",
                                                "text": "„Und eine genaue Analyse zeigt: Dieser Minikubus enthält zwischen einem Teigboden und dem Aspik tatsächlich ein Stück Sardelle im Milligrammbereich.“"
                                            },
                                            {
                                                "example_id": "f859a74d-aaff-40db-af74-a2304d98f777",
                                                "sense_id": "2d3b9b90-238b-3532-af73-a69f41aa72c9",
                                                "text": "„Serviert wird estnische Küche: Sült (Fleisch in Aspik), Mulgikapsas (fettiges Sauerkraut) und Kama, eine süße Nachspeise.“"
                                            },
                                            {
                                                "example_id": "0e1cc0d9-8ab6-47ec-9d7f-4c83d5ce0742",
                                                "sense_id": "2d3b9b90-238b-3532-af73-a69f41aa72c9",
                                                "text": "„Ich griff sofort nach einer der Hühnerkeulen in Portwein und Aspik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
