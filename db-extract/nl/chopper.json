                    {
                        "sense_id": "84a288f2-9cf6-3599-8919-28119becab01",
                        "entry_id": "eba9c481-9620-379a-b722-8f333c54ac99",
                        "glosses": [
                            "keukengerei dat met ronddraaiende messen voedsel in kleine stukjes hakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5295ad1-938b-400a-9ad8-5f2cb12ba84c",
                                "sense_id": "84a288f2-9cf6-3599-8919-28119becab01",
                                "text": "In de chopper hakte ze een stukje verse gember, een Spaanse peper en een paar tenen knoflook tot minuscule stukjes."
                            }
                        ]
                    },
                    {
                        "sense_id": "0bae7003-2c09-3b9e-b87f-352ea356b0ee",
                        "entry_id": "eba9c481-9620-379a-b722-8f333c54ac99",
                        "glosses": [
                            "vliegtuig zonder vleugels dat door een grote rotor met een verticale as kan opstijgen"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "7eabbe47-3508-4846-a189-3b54cac24ceb",
                                "sense_id": "0bae7003-2c09-3b9e-b87f-352ea356b0ee",
                                "text": "Dio poseert voor de helikopter met twee vingers in de lucht. (…) Piloot Willem de Jong: „Ik heet Willem, maar ze noemen me Wopper.” Dio: „Met Wopper in de chopper!”"
                            }
                        ]
                    },
                    {
                        "sense_id": "f27bd15d-9024-358e-8c07-ca03f1c47fbc",
                        "entry_id": "eba9c481-9620-379a-b722-8f333c54ac99",
                        "glosses": [
                            "type motorfiets met een lange voorvork en een klein voorwiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddd6a16d-67a5-4a7b-8ff5-a5be94cc9117",
                                "sense_id": "f27bd15d-9024-358e-8c07-ca03f1c47fbc",
                                "text": "Alle types zijn aanwezig: toer- en racemotoren, hier en daar zelfs een ruige chopper."
                            }
                        ]
                    },
                    {
                        "sense_id": "3865625e-01d1-3a5e-a931-a5317713a1f3",
                        "entry_id": "eba9c481-9620-379a-b722-8f333c54ac99",
                        "glosses": [
                            "type motorfiets met een lange voorvork en een klein voorwiel",
                            "fiets of bromfiets met een hoog stuur en een klein voorwiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e27db236-4121-4e9e-8d04-d0c4dd767aab",
                                "sense_id": "3865625e-01d1-3a5e-a931-a5317713a1f3",
                                "text": "Alle types zijn aanwezig: toer- en racemotoren, hier en daar zelfs een ruige chopper."
                            },
                            {
                                "example_id": "a35c9b1e-c458-4edd-b5b9-40b6389ff752",
                                "sense_id": "3865625e-01d1-3a5e-a931-a5317713a1f3",
                                "text": "Als trotse bezitter van een peperdure mountainbike, chopper of retrofiets, is je grootste vijand de fietsendief."
                            }
                        ]
                    },
                    {
                        "sense_id": "a096f03f-cd42-31b5-8265-582aaedf2b2f",
                        "entry_id": "eba9c481-9620-379a-b722-8f333c54ac99",
                        "glosses": [
                            "steen die je in de hand kunt houden en waar aan een kant een of meer stukken zo van zijn afgeslagen dat er een scherpe rand ontstaat waarmee je kan snijden en hakken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52b4a303-47ff-4381-b165-ea6012784f0e",
                                "sense_id": "a096f03f-cd42-31b5-8265-582aaedf2b2f",
                                "text": "De vuistbijlen en choppers die aan Pithecanthropus erectus werden toegeschreven blijken van sapiens te zijn geweest."
                            }
                        ]
                    },
                    {
                        "sense_id": "baf315c7-a59b-32ca-9d9b-d11e93810fec",
                        "entry_id": "eba9c481-9620-379a-b722-8f333c54ac99",
                        "glosses": [
                            "schakeling waarmee elektrische spanning wordt verlaagd door gelijkstroom voortdurend heel snel aan- en uit te schakelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e39bd6d-39b7-4539-9463-303c5a6d16ac",
                                "sense_id": "baf315c7-a59b-32ca-9d9b-d11e93810fec",
                                "text": "Het verschil huist in de chopper, een gelijkstroom omzetter [sic!] die er bij het wegrijden voor zorgt dat de twee elektromotoren in iedere locomotief niet in een klap aan de 1500 volt gelijkstroom van de bovenleiding worden gekoppeld."
                            }
                        ]
                    }
