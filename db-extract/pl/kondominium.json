                                "target_senses": [
                                    {
                                        "sense_id": "2a0a6a41-01a3-366d-a8c0-0aca52e6ec35",
                                        "entry_id": "e90380e9-8032-3efd-8459-7a08e7df67dc",
                                        "glosses": [
                                            "Joint sovereignty over a territory by two or more countries."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "393a49e0-ec2a-4456-bc9c-bc85b08066fd",
                                                "sense_id": "2a0a6a41-01a3-366d-a8c0-0aca52e6ec35",
                                                "text": "The Anglo-Egyptian Sudan was a condominium ruled jointly by Egypt and the United Kingdom."
                                            },
                                            {
                                                "example_id": "aac1d95c-bf18-4c83-be77-ad2a3b47620e",
                                                "sense_id": "2a0a6a41-01a3-366d-a8c0-0aca52e6ec35",
                                                "text": "The strategic location of the condominiums […] made them important for the Confederacy's territorial integrity even if they produced little revenue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61928a21-2aeb-3996-91da-63d08c724a8a",
                                        "entry_id": "e90380e9-8032-3efd-8459-7a08e7df67dc",
                                        "glosses": [
                                            "Joint sovereignty over a territory by two or more countries.",
                                            "A region or territory under such rule."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4d92f8d2-e069-38c7-a0fd-05836af7e644",
                                        "entry_id": "e90380e9-8032-3efd-8459-7a08e7df67dc",
                                        "glosses": [
                                            "A building or complex of buildings that provides multiple residential units each of which is owned separately but whose grounds, structure, etc. (if any) are owned jointly.",
                                            "The system of ownership by which such condominiums operate."
                                        ],
                                        "tags": [
