        "nl-extract.jsonl": [
            {
                "entry_id": "248b8117-4f6d-35ae-a024-1fbbb9fe8ba1",
                "word": "verzuilen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c63c8177-109e-35dd-84cb-28cb927b33bc",
                        "entry_id": "248b8117-4f6d-35ae-a024-1fbbb9fe8ba1",
                        "glosses": [
                            "een samenleving verdelen naar politieke richting en kerkelijke gezindheid en dus niet naar sociaal-economische klasse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c48f730-8a2d-4b10-8051-03748d5828a7",
                                "sense_id": "c63c8177-109e-35dd-84cb-28cb927b33bc",
                                "text": "Maar mensen willen zichzelf graag in hokjes stoppen, tegenwoordig. De belofte van internet was dat ieder zijn eigen CNN kon zijn. In praktijk gingen mensen zichzelf verzuilen. Je eigen gelijk kun je crowdsourcen — het is als de collectebus waarmee gereformeerden of communisten ooit hun blaadjes financierden. Journalistiek als preek voor eigen parochie."
                            },
                            {
                                "example_id": "f247d028-6385-4ccc-bb92-551bbe43c780",
                                "sense_id": "c63c8177-109e-35dd-84cb-28cb927b33bc",
                                "text": "De omroepen waren ‘te links’ en moesten weer verzuilen. Dat deden ze, onder meer met nieuwsrubriek Uitgesproken. Die stopt nu. Prompt laait het verzuilingsdebat weer op."
                            }
                        ]
                    }
