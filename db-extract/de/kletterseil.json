                "senses": [
                    {
                        "sense_id": "c72d77fc-01a1-3e24-bec7-306084a83a98",
                        "entry_id": "f2cac858-cc7f-3480-86ad-c6e34fbeb483",
                        "glosses": [
                            "Seil als Sportgerät im Sportunterricht"
                        ],
                        "tags": [
                            "Turnen"
                        ],
                        "examples": [
                            {
                                "example_id": "452efce9-f847-4852-b288-04ef6991b4e5",
                                "sense_id": "c72d77fc-01a1-3e24-bec7-306084a83a98",
                                "text": "„Der Standesbeamte saß vor einer Reihe von Kletterseilen, deren untere Enden an der Wand festgehakt waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f03aaefb-df50-38f3-972f-102b8ccd9930",
                        "entry_id": "f2cac858-cc7f-3480-86ad-c6e34fbeb483",
