                        "sense_id": "acb65868-02e5-36f3-b4d1-8bb2ef6799f6",
                        "entry_id": "d1745d29-a4c1-340d-9cca-9a76d5d36747",
                        "glosses": [
                            "Qui s’oppose aux Allemands."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c51aa86-c548-4983-9308-32f1d87a9a2d",
                                "sense_id": "acb65868-02e5-36f3-b4d1-8bb2ef6799f6",
                                "text": "Mue par une pensée diabolique, cette criminelle Allemande lança le jeune Fritz, à l’âge de vingt et un ans, dans des dissipations antigermaniques."
                            },
                            {
                                "example_id": "cab8f475-2de0-4852-ab61-8edeb84e6d3f",
                                "sense_id": "acb65868-02e5-36f3-b4d1-8bb2ef6799f6",
                                "text": "Il y avait là un vieil esprit gaulois, antigermanique, aux prises avec un reliquat de Lombards, issus des Germains, et très-disposés à accepter la domination de ceux avec lesquels ils avaient une étroite communauté d’origine."
                            }
                        ]
                    }
