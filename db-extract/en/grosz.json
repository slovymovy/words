                        "sense_id": "c24ac837-29d8-3042-9626-986138c791c3",
                        "entry_id": "3096d4a4-8ede-397a-a039-285b043d13af",
                        "glosses": [
                            "A subdivision of currency, equal to one hundredth of a Polish zloty."
                        ],
                        "tags": [],
                        "examples": [
