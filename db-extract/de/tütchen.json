                                "target_senses": [
                                    {
                                        "sense_id": "e5c17fa2-8826-3a36-a832-97a6d9ad92d9",
                                        "entry_id": "74586fa1-4280-3b16-a1eb-a72a586edca5",
                                        "glosses": [
                                            "A small scented cloth bag filled with fragrant material such as herbs or potpourri."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4b54988d-cba0-3baa-be0a-8570c23175e5",
                                        "entry_id": "74586fa1-4280-3b16-a1eb-a72a586edca5",
                                        "glosses": [
                                            "A cheesecloth bag of herbs and/or spices added during cooking and then removed before serving."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d7d1b4bc-356c-3ff1-9617-eae2a4ec052c",
                                        "entry_id": "74586fa1-4280-3b16-a1eb-a72a586edca5",
                                        "glosses": [
                                            "A small, sealed packet containing a single-use quantity of any material."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9cb37cb-8be1-4bd1-8a0e-82ca1c25fb91",
                                                "sense_id": "d7d1b4bc-356c-3ff1-9617-eae2a4ec052c",
                                                "text": "My burger arrived with a plastic sachet of tomato ketchup."
                                            },
                                            {
                                                "example_id": "f8e9301c-099d-4704-9932-50c0331fa19c",
                                                "sense_id": "d7d1b4bc-356c-3ff1-9617-eae2a4ec052c",
                                                "text": "In the Philippines and other parts of Southeast Asia, the problem was compounded by a new kind of plastic packaging that took flight in the 1980s — the sachet. It was a plastic pouch but often bulked up with layers of aluminum or paper for shape or durability. […] Sachets are cheap, flashy and convenient."
                                            }
                                        ]
                                    }
                                ]
                            }
