                    {
                        "sense_id": "4133061d-e2ae-32aa-b031-700f069b8515",
                        "entry_id": "fbcfc4ad-aecc-3dc4-bc9b-7d73ae2d9436",
                        "glosses": [
                            "verkleinwoord enkelvoud van het zelfstandig naamwoord pot"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "e1ca0a2b-1595-4742-a9bd-2e24858f237c",
                                "sense_id": "4133061d-e2ae-32aa-b031-700f069b8515",
                                "text": "Ontspannen lag hij op zijn matje met een pruttelend potje aardappelpuree op zijn gasbrander."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4cbdab8e-c5af-47f1-91e0-3f564b1ca8f1",
                        "source_entry_id": "fbcfc4ad-aecc-3dc4-bc9b-7d73ae2d9436",
                        "source_sense_id": "4133061d-e2ae-32aa-b031-700f069b8515",
                        "source_sense_description": "een spel of ronde",
                        "target_lang_word": "Partie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Partie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f952218-2039-3a2e-8992-a364286e8a92",
                                        "entry_id": "c551f9a1-41c9-315e-b40e-6c0b82a567e1",
                                        "glosses": [
                                            "Durchlauf eines Spiels oder Sportwettkampfes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ae9000c-7fdc-4ee4-b8a2-9f2d68a8d91d",
                                                "sense_id": "1f952218-2039-3a2e-8992-a364286e8a92",
                                                "text": "„Er brach sofort seine Partie Domino ab, versprach ihn da unten zu besuchen, bestellte zwei Anis-Schnäpse und umarmte ihn.“"
                                            },
                                            {
                                                "example_id": "14492eb9-ed57-475d-accf-e8591e22344d",
                                                "sense_id": "1f952218-2039-3a2e-8992-a364286e8a92",
                                                "text": "Sie spielten eine Partie Blitzschach."
                                            },
                                            {
                                                "example_id": "cfb62fad-4fb0-4a2c-a782-13512588cdbd",
                                                "sense_id": "1f952218-2039-3a2e-8992-a364286e8a92",
                                                "text": "„Wir begannen unsere Partie Schach aufs Neue.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9ed7a9ec-5bb1-3ff9-8b5b-ff4ba425e89b",
                                        "entry_id": "c551f9a1-41c9-315e-b40e-6c0b82a567e1",
                                        "glosses": [
                                            "Rolle, Stimme in einem Bühnenstück oder Singspiel"
                                        ],
                                        "tags": [
                                            "Theater"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b68cd3cd-c96e-41be-8823-266490e8234e",
                                                "sense_id": "9ed7a9ec-5bb1-3ff9-8b5b-ff4ba425e89b",
                                                "text": "Er übernahm die Partie der Sopranistin."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bb4c4fbd-0a68-3580-abd4-5517c08546d7",
                                        "entry_id": "c551f9a1-41c9-315e-b40e-6c0b82a567e1",
                                        "glosses": [
                                            "Teil eines Gegenstands (zum Beispiel einer Landschaft oder eines Körpers)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db9d09ff-f093-4b77-ad5e-9bc3bc822c0a",
                                                "sense_id": "bb4c4fbd-0a68-3580-abd4-5517c08546d7",
                                                "text": "Die linke Partie gefiel Roger besser."
                                            },
                                            {
                                                "example_id": "7d20b75e-a6c1-4345-904b-0a7367e6a14b",
                                                "sense_id": "bb4c4fbd-0a68-3580-abd4-5517c08546d7",
                                                "text": "„Außerdem bekam jeder Soldat eine Partie Branntwein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "0af66389-3c81-3877-99c4-5eb25f6504a6",
                                        "entry_id": "c551f9a1-41c9-315e-b40e-6c0b82a567e1",
                                        "glosses": [
                                            "eine gemeinsame Unternehmung, ein Ausflug"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91531210-c733-43da-87f3-ae3df6a03f2f",
                                                "sense_id": "0af66389-3c81-3877-99c4-5eb25f6504a6",
                                                "text": "Die Familie unternahm eine Partie zur Großmutter auf dem Lande."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "8859dd6f-5784-392f-8afe-dcbe5244d1bb",
                                        "entry_id": "c551f9a1-41c9-315e-b40e-6c0b82a567e1",
                                        "glosses": [
                                            "tatsächlicher oder möglicher Ehepartner"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37b45498-72c5-4be1-a7af-df53172a689d",
                                                "sense_id": "8859dd6f-5784-392f-8afe-dcbe5244d1bb",
                                                "text": "\"Nach Norderney müssen Sie gehen\", sagte mir Frau Geheimrat Doddersucht, die von ihren sechs Töchtern bereits vier auf Norderney losgeworden war, alles gute Partien, wirklich ausgezeichnet waren die Mädchen angekommen; \"man trifft durchweg nur gute Gesellschaft dort.\""
                                            },
                                            {
                                                "example_id": "3eb4e6cc-31a7-4377-bac0-dd97052cb312",
                                                "sense_id": "8859dd6f-5784-392f-8afe-dcbe5244d1bb",
                                                "text": "So war denn auch bald Gerede über Ansas und Grita, die einen meinten, das Paar passe gut zusammen, und die andern, es sei für beide eine schlechte Partie, da sie nicht bemittelt genug seien, um von Geld und Gut absehen zu können."
                                            },
                                            {
                                                "example_id": "129b1664-22e0-41c0-ad7a-e5613f8a3d0b",
                                                "sense_id": "8859dd6f-5784-392f-8afe-dcbe5244d1bb",
                                                "text": "„Weras Bemerkung war durchaus richtig, wie es alle ihre Bemerkungen waren, aber wie fast alle ihre Bemerkungen berührte sie alle anderen unangenehm, und zwar nicht nur Sonja, Nikolai und Natascha, sondern auch die alte Gräfin, die immer fürchtete, ihr Sohn könne sich um seiner Liebe zu Sonja willen noch einmal eine glänzende Partie verscherzen.“"
                                            },
                                            {
                                                "example_id": "ca432904-3a42-47af-94a8-61a2675afab2",
                                                "sense_id": "8859dd6f-5784-392f-8afe-dcbe5244d1bb",
                                                "text": "„Denn der besorgte Vater hat inzwischen in Paris bereits die richtige Partie für seinen Sohn ausgehandelt, es gibt kein Zurück, und der junge Marquis weiß das, er muß gehorchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "54fe588a-847f-330b-b927-d3190e7b5f13",
                                        "entry_id": "c551f9a1-41c9-315e-b40e-6c0b82a567e1",
                                        "glosses": [
                                            "zusammenhängende Gruppe von Menschen (zum Beispiel für eine bestimmte Aufgabe)"
                                        ],
                                        "tags": [
                                            "general",
                                            "outdated"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
