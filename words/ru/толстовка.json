{
    "word_family": [
        "толстовец",
        "толстовство"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "801f636f-6b48-36df-bd08-de72f966a9ec",
                    "sense_definition": "Верхняя спортивная одежда свободного кроя из плотной ткани, часто с длинными рукавами.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На улице прохладно, поэтому я надел теплую <w>толстовку</w>.",
                            "target_lang_translations": {
                                "en": "It is chilly outside, so I put on a warm <w>sweatshirt</w>."
                            }
                        },
                        {
                            "text": "Моя любимая <w>толстовка</w> очень мягкая и удобная.",
                            "target_lang_translations": {
                                "en": "My favorite <w>sweatshirt</w> is very soft and comfortable."
                            }
                        }
                    ],
                    "synonyms": [
                        "худи"
                    ],
                    "common_phrases": [
                        "теплая толстовка",
                        "надеть толстовку"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "повседневное использование"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A loose-fitting casual top made of thick fabric, often with long sleeves."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sweatshirt",
                                "target_lang_sense_clarification": "general term for a casual long-sleeved top"
                            },
                            {
                                "target_lang_word": "hoodie",
                                "target_lang_sense_clarification": "a sweatshirt with a hood"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83ac2791-7cf7-304a-83a7-eecd4e0b93f1",
                    "sense_definition": "Историческая мужская блуза свободного покроя с поясом, которую носил Лев Толстой.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На старых фотографиях писатель часто изображен в длинной <w>толстовке</w> с поясом.",
                            "target_lang_translations": {
                                "en": "In old photographs, the writer is often depicted in a long <w>Tolstoy blouse</w> with a belt."
                            }
                        },
                        {
                            "text": "В конце девятнадцатого века такая <w>толстовка</w> стала символом народнических идей.",
                            "target_lang_translations": {
                                "en": "At the end of the nineteenth century, such a <w>Tolstoy blouse</w> became a symbol of populist ideas."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "исторический предмет одежды"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A historical loose-fitting men's blouse with a belt, worn by Leo Tolstoy."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Tolstoy blouse",
                                "target_lang_sense_clarification": "a specific historical garment associated with the writer"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e5b4370d-1ebc-35c8-9319-78d7dc62a3da",
                    "sense_definition": "Женщина, являющаяся последовательницей учения <w>толстовства</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она была убежденная <w>толстовка</w> и посвятила жизнь помощи бедным крестьянам.",
                            "target_lang_translations": {
                                "en": "She was a convinced <w>Tolstoyan</w> and dedicated her life to helping poor peasants."
                            }
                        },
                        {
                            "text": "В то время многие образованные женщины становились <w>толстовками</w> под влиянием идей писателя.",
                            "target_lang_translations": {
                                "en": "At that time, many educated women became <w>Tolstoyans</w> under the influence of the writer's ideas."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "исторический термин"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A woman who is a follower of the teachings of Tolstoyism."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Tolstoyan",
                                "target_lang_sense_clarification": "a follower of the philosophy of Leo Tolstoy"
                            }
                        ]
                    }
                }
            ]
        },
        {
