                        "sense_id": "a594c742-eaff-36db-ab3a-533f37f5fa1d",
                        "entry_id": "28c8d468-7d05-3081-b6a7-a36f6c617ac5",
                        "glosses": [
                            "iemand die gevaarlijke stunts doet voor zijn beroep"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "b333a348-2cc4-4be3-a40b-0797058917e4",
                                "sense_id": "a594c742-eaff-36db-ab3a-533f37f5fa1d",
                                "text": "De stuntman sloeg met zijn brandende auto driemaal over de kop, stortte toen in een ravijn waarbij zijn auto ontplofte, maar hij overleefde dit alles."
                            }
                        ]
                    }
                ],
