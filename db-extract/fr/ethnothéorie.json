                "senses": [
                    {
                        "sense_id": "df31a9e0-82f8-3e0d-914f-4f542308848b",
                        "entry_id": "0fd9d70b-6f92-3a99-ada8-9e8043c08970",
                        "glosses": [
                            "Croyance ou représentation partagée par les membres d’un groupe ethnique ou culturel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04716a3a-4f9b-4c01-81d4-aad81a1c5ab6",
                                "sense_id": "df31a9e0-82f8-3e0d-914f-4f542308848b",
                                "text": "Cette niche comprend le contexte matériel et social dans lequel l’enfant évolue, les pratiques éducatives auquel il est soumis et les ethnothéories ou représentations des adultes qui ont la charge de cet enfant, principalement les parents."
                            },
                            {
                                "example_id": "a66450b9-deca-47c9-bff0-208b7b332ab6",
                                "sense_id": "df31a9e0-82f8-3e0d-914f-4f542308848b",
                                "text": "Premier fait à signaler, les ethnothéories des informateurs constituent très souvent des tapa, cimu, n 'récit, histoire', ou croyance véhiculée par la tradition orale."
                            },
                            {
                                "example_id": "c4b237d9-234b-453a-b695-b2c7a57bfb78",
                                "sense_id": "df31a9e0-82f8-3e0d-914f-4f542308848b",
                                "text": "Nous nous construisons, comme le chercheur, dans l’identification à l’autre et dans une différenciation prescrite par la culture comme ethnothéorie."
                            }
                        ]
                    }
                ],
