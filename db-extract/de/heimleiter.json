                        "tags": [],
                        "examples": [
                            {
                                "example_id": "633e3941-c56c-4fb0-97b3-5abcfd1765b5",
                                "sense_id": "9c70887d-41d6-3cb4-8666-5639d3b2573d",
                                "text": "Im Dezember wurde Gerhard zum Heimleiter des Kinderheimes ernannt."
                            },
                            {
                                "example_id": "cff670cc-85e7-462f-b78c-70108ba8adb4",
                                "sense_id": "9c70887d-41d6-3cb4-8666-5639d3b2573d",
                                "text": "„In der Dachwohnung eines Kinderheims waren der 53-jährige Heimleiter und eine 51-jährige Frau tot aufgefunden worden.“"
                            },
                            {
                                "example_id": "acd99af1-b0e6-4200-b222-40210e75598d",
                                "sense_id": "9c70887d-41d6-3cb4-8666-5639d3b2573d",
                                "text": "„Es waren ältere Bilder, nur der Heimleiter und zwei der Erzieherinnen waren immer noch da.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
