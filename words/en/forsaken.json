{
    "word_family": [
        "forsake",
        "forsaker"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "56f2ee04-30cd-3800-a75a-8b7e778d1d74",
                    "sense_definition": "Deserted or abandoned by someone or something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abandoned",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>forsaken</w> village stood empty in the middle of the valley.",
                            "target_lang_translations": {
                                "pl": "<w>Opuszczona</w> wioska stała pusta pośrodku doliny."
                            }
                        },
                        {
                            "text": "He felt completely <w>forsaken</w> after his friends left him behind.",
                            "target_lang_translations": {
                                "pl": "Czuł się całkowicie <w>porzucony</w>, gdy przyjaciele go zostawili."
                            }
                        }
                    ],
                    "synonyms": [
                        "abandoned",
                        "deserted",
                        "desolate"
                    ],
                    "common_phrases": [
                        "feel forsaken"
                    ],
                    "target_lang_definitions": {
                        "pl": "Opuszczony lub porzucony przez kogoś lub coś."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "opuszczony",
                                "target_lang_sense_clarification": "ogólne określenie miejsca lub osoby, która została zostawiona"
                            },
                            {
                                "target_lang_word": "porzucony",
                                "target_lang_sense_clarification": "podkreśla akt zostawienia kogoś lub czegoś"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8dac2853-2cf8-3310-8508-306392099c78",
                    "sense_definition": "Lacking support or help; feeling helpless.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "helpless",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>forsaken</w> traveler had no way to call for assistance.",
                            "target_lang_translations": {
                                "pl": "<w>Bezradny</w> podróżnik nie miał jak wezwać pomocy."
                            }
                        },
                        {
                            "text": "She was left <w>forsaken</w> and powerless in the face of the crisis.",
                            "target_lang_translations": {
                                "pl": "Została <w>osamotniona</w> i bezsilna w obliczu kryzysu."
                            }
                        }
                    ],
                    "synonyms": [
                        "forlorn",
                        "powerless"
                    ],
                    "target_lang_definitions": {
                        "pl": "Pozbawiony wsparcia lub pomocy; czujący się bezradnie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "bezradny",
                                "target_lang_sense_clarification": "odnoszący się do braku możliwości działania"
                            },
                            {
                                "target_lang_word": "osamotniony",
                                "target_lang_sense_clarification": "podkreślający poczucie bycia samemu w trudnej sytuacji"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fee8a980-dddf-3ba6-b2a1-072b3e4ecd56",
                    "sense_definition": "Past participle of <w>forsake</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has <w>forsaken</w> his old habits to start a new life.",
                            "target_lang_translations": {
                                "pl": "<w>Wyrzekł się</w> swoich starych nawyków, by rozpocząć nowe życie."
                            }
                        },
                        {
                            "text": "The king was <w>forsaken</w> by his closest advisors during the war.",
                            "target_lang_translations": {
                                "pl": "Król został <w>porzucony</w> przez swoich najbliższych doradców podczas wojny."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past participle of a verb"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Imiesłów bierny czasownika forsake (porzucać, wyrzekać się)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "porzucony",
                                "target_lang_sense_clarification": "w kontekście osób lub rzeczy"
                            },
                            {
                                "target_lang_word": "wyrzeczony się",
                                "target_lang_sense_clarification": "w kontekście nawyków lub przekonań"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}