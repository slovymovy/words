                "senses": [
                    {
                        "sense_id": "be914e01-c6a3-31e4-91c5-93a9667cdc3e",
                        "entry_id": "d0fdb4ad-29fb-3d45-95a9-7d49b868339a",
                        "glosses": [
                            "потерявший всякое чувство меры, крайне разнузданный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bba7125c-b1df-4101-ad3c-c8c74b01fbe2",
                                "sense_id": "be914e01-c6a3-31e4-91c5-93a9667cdc3e",
                                "text": "― Довёл девку до евтого, да ещё пристаёшь, видно весело тебе, оголтелый, на ее слёзы смотреть."
                            },
                            {
                                "example_id": "bdaa63ec-df4b-4b59-9972-bcba97e7cd54",
                                "sense_id": "be914e01-c6a3-31e4-91c5-93a9667cdc3e",
                                "text": "Что ты, оголтелый, в экую пропасть суешься?"
                            },
                            {
                                "example_id": "733f0883-57d0-4f2d-8dbb-d67273e9e0c9",
                                "sense_id": "be914e01-c6a3-31e4-91c5-93a9667cdc3e",
                                "text": "Новая машина промчалась мимо с каким-то издевательски-роскошным рокотом, обдав его грязью, ― шофер, наверное, поддал газу, а Сыромуков подумал: как много развелось на свете оголтелого хамья."
                            },
                            {
                                "example_id": "938be69b-d9a4-4d6c-b0ce-36e1dfb64747",
                                "sense_id": "be914e01-c6a3-31e4-91c5-93a9667cdc3e",
                                "text": "Услыхав, что он агент царской охранки, английский шпион и оголтелый враг народа, мы с тетей Зиной покинули кипящего краба на произвол судьбы и в немом недоумении уставились друг на друга."
                            }
                        ]
                    },
                    {
                        "sense_id": "1adff541-3e84-35ab-aa14-a694d5c2c8c7",
                        "entry_id": "d0fdb4ad-29fb-3d45-95a9-7d49b868339a",
                        "glosses": [
                            "ничем не сдерживаемый, крайний по силе, степени проявления"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e64ae592-6bfe-4d20-937e-5f2d69b16c70",
                                "sense_id": "1adff541-3e84-35ab-aa14-a694d5c2c8c7",
                                "text": "Ветер. Фонарь качается как оголтелый."
                            },
                            {
                                "example_id": "50dc0556-1e2b-49e2-b7dc-b849d5f5041a",
                                "sense_id": "1adff541-3e84-35ab-aa14-a694d5c2c8c7",
                                "text": "Есть в дружбе счастье оголтелое…"
                            },
                            {
                                "example_id": "012c8ec0-f25f-469d-89a3-375a89abdd82",
                                "sense_id": "1adff541-3e84-35ab-aa14-a694d5c2c8c7",
                                "text": "Стаи мыслей слетели от центра сознания, будто стаи оголтелых, бурей спугнутых птиц"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1556af4c-1fee-46f1-acb8-b8680e3c921e",
                        "source_entry_id": "d0fdb4ad-29fb-3d45-95a9-7d49b868339a",
                        "source_sense_description": "потерявший всякое чувство меры",
                        "target_lang_word": "effréné",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "effréné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "711b566b-006d-3091-8e81-136e62edda8a",
                                        "entry_id": "c2ecae3e-526a-3740-a20d-e833ba8ed9b1",
                                        "glosses": [
                                            "Sans frein ni selle en parlant du cheval représenté sur un blason."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccc2533b-58d0-4d82-8781-04d84ccc6b1e",
                                                "sense_id": "711b566b-006d-3091-8e81-136e62edda8a",
                                                "text": "Cheval effréné se dit aussi cheval gai."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd8880a4-b417-3401-9dda-1761710dab94",
                                        "entry_id": "c2ecae3e-526a-3740-a20d-e833ba8ed9b1",
                                        "glosses": [
                                            "Sans frein, sans retenue, débridé, exagéré, immodéré."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffd17e67-dcd3-4f64-9da8-6a50aaa84037",
                                                "sense_id": "fd8880a4-b417-3401-9dda-1761710dab94",
                                                "text": "« Sans mon intervention, vous vous enrichissiez aux dépens de nos prolétaires géorgiens et recommenciez, grâce au pétrole russe, votre vie de luxe effréné, qui est un attentat à la misère du monde… »"
                                            },
                                            {
                                                "example_id": "e2ee6d21-6323-464b-a0d3-c8bd234594a1",
                                                "sense_id": "fd8880a4-b417-3401-9dda-1761710dab94",
                                                "text": "Le nain Ilioucha était parmi eux, hilare, effréné, grotesque, se livrant à un kozatchok endiablé."
                                            },
                                            {
                                                "example_id": "49ad981c-e27e-4a46-8403-5f9d34793393",
                                                "sense_id": "fd8880a4-b417-3401-9dda-1761710dab94",
                                                "text": "Après quatre années d’une couverture à un rythme effréné et dans un climat particulièrement chaotique, je ne peux qu’espérer que nous saurons tirer des leçons de l’exemple américain."
                                            },
                                            {
                                                "example_id": "e787d06f-da96-4595-8984-b5ec26d08a68",
                                                "sense_id": "fd8880a4-b417-3401-9dda-1761710dab94",
                                                "text": "La « condition humaine », au sens de l'irrémédiable et de l'échec, les précipite [les Américains] chez les psychiatres ou dans une course effrénée vers des substituts de puissance, argent et records du monde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "301b9652-7fa2-46a5-ac61-ad4704cd8f43",
                        "source_entry_id": "d0fdb4ad-29fb-3d45-95a9-7d49b868339a",
                        "source_sense_description": "ничем не сдерживаемый",
                        "target_lang_word": "déchaîné",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déchaîné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3872ca73-8005-36e3-b015-0417b307a8b3",
                                        "entry_id": "0d8b6a27-2da4-371b-9ed5-1888468d0266",
                                        "glosses": [
                                            "Qualifie un être ou un phénomène qui se déchaîne, qui s’emporte, qui dépasse la mesure commune, dont on ne peut plus arrêter les excès."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47001499-c618-4fe4-97d5-0cb200ccca2d",
                                                "sense_id": "3872ca73-8005-36e3-b015-0417b307a8b3",
                                                "text": "Mais on dérape très vite, le médecin est aussi fou que ses patients, les infirmières sont déchaînées, l'atmosphère vire au pandémonium morbide et sexué."
                                            },
                                            {
                                                "example_id": "73d58eaf-eecc-4db0-b617-82695dfdf967",
                                                "sense_id": "3872ca73-8005-36e3-b015-0417b307a8b3",
                                                "text": "En même temps, les rappels à l’Histoire, en ces temps troublés, sont comme des racines profondes qui peuvent permettre à un grand et vieil arbre de résister à des vents déchaînés."
                                            },
                                            {
                                                "example_id": "c7cb2ca4-4ad4-4f06-9232-2f775656b713",
                                                "sense_id": "3872ca73-8005-36e3-b015-0417b307a8b3",
                                                "text": "Dès que les passions populaires sont déchaînées, on peut tout craindre."
                                            },
                                            {
                                                "example_id": "e595532a-8701-49af-acb3-e956a2757ed0",
                                                "sense_id": "3872ca73-8005-36e3-b015-0417b307a8b3",
                                                "text": "Il est déchaîné ; c’est un diable déchaîné"
                                            },
                                            {
                                                "example_id": "639b8733-3a3e-4d27-a6fd-533c3114577a",
                                                "sense_id": "3872ca73-8005-36e3-b015-0417b307a8b3",
                                                "text": "Il semblait que tous les vents fussent déchaînés."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "déchaîné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "442019af-cb48-311c-8360-b7b02037c181",
                                        "entry_id": "8c680308-8e3c-3823-a726-a2914e9827ed",
                                        "glosses": [
                                            "Participe passé masculin singulier de déchaîner."
                                        ],
