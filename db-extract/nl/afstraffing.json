                        "source_entry_id": "ec60c9b9-4024-3cfb-8e64-fe806856fdb5",
                        "source_sense_id": "019bf87e-62dd-37a8-952f-12cca43a69e7",
                        "source_sense_description": "straf die iemand ondergaat na iets verkeerds te hebben gedaan",
