                        ],
                        "examples": [
                            {
                                "example_id": "2eb70f5f-703f-4be1-ac0f-e156013547f7",
                                "sense_id": "2c55bbce-ab4d-3344-aa62-7bef4045a506",
                                "text": "C’est qu’elle avait enfin compris notre campagne, émoussée et claircie par chaque matin neuf."
                            }
                        ]
