                "senses": [
                    {
                        "sense_id": "379b008a-218d-33da-99e9-58f9bdfd3a84",
                        "entry_id": "845104f4-2501-3d75-ab5c-5d9a4131e746",
                        "glosses": [
                            "Medium, mit dem sich Werbung verbreiten lässt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d19c1fac-2e2a-435b-8167-341fbc5c7d90",
                                "sense_id": "379b008a-218d-33da-99e9-58f9bdfd3a84",
                                "text": "„Die Gegenstände und Einrichtungen, über die das Werbemittel der Öffentlichkeit zugänglich gemacht wird, bezeichnet man als Werbeträger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9b946969-5a2f-3859-ae20-0b3603294da0",
                        "entry_id": "845104f4-2501-3d75-ab5c-5d9a4131e746",
                        "glosses": [
                            "Person, die sich (gegen Bezahlung) für Werbezwecke zur Verfügung stellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31c7f6a2-f871-4270-8d3d-3c14a88213df",
                                "sense_id": "9b946969-5a2f-3859-ae20-0b3603294da0",
                                "text": "„Wie noch kein Sportartikelunternehmen zuvor kreierte Nike um seine Werbeträger einen regelrechten Persönlichkeitskult, der Mitte der 80er mit dem Aufstieg des Jahrhundertbasketballers Michael Jordan begann.“"
                            },
                            {
                                "example_id": "68046a54-dcd4-4407-a33d-c2a8a8f12174",
                                "sense_id": "9b946969-5a2f-3859-ae20-0b3603294da0",
                                "text": "„Für Spielzeughersteller sind derartige Kinderstars attraktive Werbeträger, da andere Kinder ihnen vertrauen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
