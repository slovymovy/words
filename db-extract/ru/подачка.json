                    }
                ],
                "translations": [
                    {
                        "translation_id": "2bffe47d-8397-4ffb-9e4c-5e1d18f7154d",
                        "source_entry_id": "9995509c-4eaf-3eb2-85c9-1ad4164daf57",
                        "source_sense_id": "e64d7853-5264-3dc3-94e5-fa29e2f4b3c2",
                        "target_lang_word": "pittance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pittance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e6cb6a9-a955-3911-855a-6d6a90e87172",
                                        "entry_id": "a637121b-2925-315d-b5f1-d744733c432a",
                                        "glosses": [
                                            "A small allowance of food and drink; a scanty meal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "227bc37d-ad5b-3963-8503-b17ba46fb10b",
                                        "entry_id": "a637121b-2925-315d-b5f1-d744733c432a",
                                        "glosses": [
                                            "A meagre allowance of money or wages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e41eacf-f22e-47c4-8b9a-0e801fb659b4",
                                                "sense_id": "227bc37d-ad5b-3963-8503-b17ba46fb10b",
                                                "text": "In the very prime of life, Mr. Glentworth found every prospect gone; he had only a meagre pittance, compared to his former expenditure; but he had neither the habits nor the opportunity of increasing it."
                                            },
                                            {
                                                "example_id": "8614b5f1-1b10-4110-ad6b-79e4a0cb85be",
                                                "sense_id": "227bc37d-ad5b-3963-8503-b17ba46fb10b",
                                                "text": "So I went to keep house with him at the Why Not? and my aunt sent down my bag of clothes, and would have made over to Elzevir the pittance that my father left for my keep, but he said it was not needful, and he would have none of it."
                                            },
                                            {
                                                "example_id": "9abea35c-fc06-4e4e-8d10-01c64a0759a5",
                                                "sense_id": "227bc37d-ad5b-3963-8503-b17ba46fb10b",
                                                "text": "Dad was forced to claim benefit money from the government. It was a pittance, barely enough to live on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03a964e6-ca18-36c2-abf3-39c2a7b8230e",
                                        "entry_id": "a637121b-2925-315d-b5f1-d744733c432a",
                                        "glosses": [
                                            "A small amount."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4cd61cb-ad10-4323-acc2-788c69a451aa",
                                                "sense_id": "03a964e6-ca18-36c2-abf3-39c2a7b8230e",
                                                "text": "The former residents of Fraguas, who sold up for a pittance, have swung behind the resettlement, happy to see life return to the narrow lanes where they grew up."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61816f26-6780-429f-a9f3-cb803097cdee",
                        "source_entry_id": "9995509c-4eaf-3eb2-85c9-1ad4164daf57",
                        "source_sense_id": "e64d7853-5264-3dc3-94e5-fa29e2f4b3c2",
                        "target_lang_word": "dole",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23af03e8-2aa3-3998-905f-c8b7f58ca3a3",
                                        "entry_id": "6c909c54-f0c8-36ce-8fb3-9317a756b22c",
                                        "glosses": [
                                            "To distribute in small amounts; to share out small portions of a meager resource."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "dole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d29840e-f4c3-374d-bd2e-c5984b0415a6",
                                        "entry_id": "547a568e-5752-3a02-8840-854f6963179c",
                                        "glosses": [
                                            "Money or other goods given as charity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a0eefe0-aadf-4034-a2ff-94c42386211d",
                                                "sense_id": "1d29840e-f4c3-374d-bd2e-c5984b0415a6",
                                                "text": "So sure the dole, so ready at their call, / They stood prepar'd to see the manna fall."
                                            },
                                            {
                                                "example_id": "a8921cf5-f77c-44a7-9395-f3fed6c885c4",
                                                "sense_id": "1d29840e-f4c3-374d-bd2e-c5984b0415a6",
                                                "text": "Devereux […] was beholden, not only for his fun, but occasionally for his daily bread and even his liberty, to those benovolent^([sic]) doles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8890112-6052-301b-8ac9-fdc1f8c7a1c3",
                                        "entry_id": "547a568e-5752-3a02-8840-854f6963179c",
                                        "glosses": [
                                            "Distribution; dealing; apportionment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1854ec03-51f4-4c34-b046-a1957144d0b3",
                                                "sense_id": "a8890112-6052-301b-8ac9-fdc1f8c7a1c3",
                                                "text": "c. 1650s, John Cleveland, Upon Phillis Walking in a Morning before Sun-rising\nAt her general dole, / Each receives his ancient soul."
                                            },
                                            {
                                                "example_id": "22a88da9-3c97-4b93-a478-806b5c052479",
                                                "sense_id": "a8890112-6052-301b-8ac9-fdc1f8c7a1c3",
                                                "text": "Go not away, thou weary soul: / Heaven has in store a precious dole / Even on Bethsaida's cold and darksome height, [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "456bf3c2-0013-3864-b6ab-a7b9c01b4e19",
                                        "entry_id": "547a568e-5752-3a02-8840-854f6963179c",
                                        "glosses": [
                                            "Payment by the state to the unemployed; unemployment benefits."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f932317-20a7-4f4f-99f7-d47e0ea90d85",
                                                "sense_id": "456bf3c2-0013-3864-b6ab-a7b9c01b4e19",
                                                "text": "The FY 1997/98 Commonwealth budget allocated funding of A$ 21.6 million to the Work for the Dole initiative for unemployed young people."
                                            },
                                            {
                                                "example_id": "d32591c8-3268-4499-a9f9-ffd012651c90",
                                                "sense_id": "456bf3c2-0013-3864-b6ab-a7b9c01b4e19",
                                                "text": "I get my dole paid twice a week."
                                            },
                                            {
                                                "example_id": "6b518468-e29e-429c-ab5f-e482409a821e",
                                                "sense_id": "456bf3c2-0013-3864-b6ab-a7b9c01b4e19",
                                                "text": "I've been on the dole for two years now."
                                            },
                                            {
                                                "example_id": "2977b28d-885c-4447-95c6-6c1b91a62b75",
                                                "sense_id": "456bf3c2-0013-3864-b6ab-a7b9c01b4e19",
                                                "text": "So, we are being fobbed off by second-rate American junk by smart aleck salesman from Pittsburgh while British factories stand empty and British workmen queue up for the dole."
                                            },
                                            {
                                                "example_id": "2be596cc-13ff-4857-a346-b4eea1952faf",
                                                "sense_id": "456bf3c2-0013-3864-b6ab-a7b9c01b4e19",
                                                "text": "From the ice age to the dole age / There is but one concern / I have just discovered"
                                            },
                                            {
                                                "example_id": "3e6273fd-102a-426c-a806-e71537e9e055",
                                                "sense_id": "456bf3c2-0013-3864-b6ab-a7b9c01b4e19",
                                                "text": "The men sit because they′re worn out from walking to the Labour Exchange every morning to sign for the dole, discussing the world’s problems and wondering what to do with the rest of the day."
                                            },
                                            {
                                                "example_id": "49ffd6aa-f29c-4c67-a1a8-b4089a8e3c4e",
                                                "sense_id": "456bf3c2-0013-3864-b6ab-a7b9c01b4e19",
                                                "text": "Sort your shit out, then roll / Sex, drugs, and on the dole / Some men rise, some men fall"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "088081b3-cbbf-34d8-9c29-f7739de11faf",
                                        "entry_id": "547a568e-5752-3a02-8840-854f6963179c",
                                        "glosses": [
                                            "A boundary; a landmark."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04346652-5acb-4193-9d06-2a68857e5179",
                                                "sense_id": "088081b3-cbbf-34d8-9c29-f7739de11faf",
                                                "text": "Curſed be he which tranſlateth the bounds and dolles of his Neighbor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fd913cc-a4c1-372d-a7fe-1676425a2dc1",
                                        "entry_id": "547a568e-5752-3a02-8840-854f6963179c",
                                        "glosses": [
                                            "A void space left in tillage."
                                        ],
                                        "tags": [
                                            "British",
                                            "dialectal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
