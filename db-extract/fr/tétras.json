        "fr-extract.jsonl": [
            {
                "entry_id": "07175018-263e-3aa6-b5fe-69bc91525043",
                "word": "tétras",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a6804a1e-df6a-386f-aea0-a306671c0868",
                        "entry_id": "07175018-263e-3aa6-b5fe-69bc91525043",
                        "glosses": [
                            "Coq de bruyère d’une grande espèce."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13a4745d-fe49-47f9-9c2c-53eea11b9384",
                                "sense_id": "a6804a1e-df6a-386f-aea0-a306671c0868",
                                "text": "Mais que voulez-vous qu'on fasse d'autre à Mayland ? La mer grondante l'entoure aux trois quarts, et l'hinterland est constitué par des landes et des friches où ne vivent que des lapins sauvages et des tétras."
                            },
                            {
                                "example_id": "18954893-0c7b-4f12-bb55-8c68a94b6b4c",
                                "sense_id": "a6804a1e-df6a-386f-aea0-a306671c0868",
                                "text": "C’est comme pour appeauter un tétras, rien de plus simple. Tu tends une feuille de chiendent entre tes deux pouces et tu souffles dans l’intervalle. Tu vois arriver le coq, la crête droite, écarlate et le collet ébouriffé."
                            }
                        ]
                    },
                    {
                        "sense_id": "95c27724-e0a2-36f1-882f-ba99d3d403f5",
                        "entry_id": "07175018-263e-3aa6-b5fe-69bc91525043",
                        "glosses": [
                            "La viande de cet oiseau."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a27dfc82-5fd8-43f7-9744-fc4297426f20",
                        "source_entry_id": "07175018-263e-3aa6-b5fe-69bc91525043",
                        "source_sense_id": "a6804a1e-df6a-386f-aea0-a306671c0868",
                        "source_sense_description": "Coq de bruyère",
                        "target_lang_word": "Birkhahn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
