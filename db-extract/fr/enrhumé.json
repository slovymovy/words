                        "entry_id": "0b73d5ad-9621-3133-ba56-d3bd784ea367",
                        "glosses": [
                            "Évoquant la congestion, l'oppression, le malaise d'une personne enrhumée."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "27093b6f-0794-492e-8fe2-b602523130f6",
                                "sense_id": "918b1f68-00c8-3166-8f6a-c6086f992ea7",
                                "text": "Les rues, enrhumées, étaient étroites, sales, souillées de mélancolie. Rien, ici, ne respirait vraiment."
                            }
                        ]
                    }
