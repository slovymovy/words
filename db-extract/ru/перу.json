                                "example_id": "7b0b6b48-6397-498a-8031-a24d237b8843",
                                "sense_id": "bb230798-f56d-3381-9aab-686dc2565361",
                                "text": "Как на заре веков мы отплывали в Пе́ру, / Авророю лица приветствуя восход."
                            },
                            {
                                "example_id": "f3ea9db2-39f6-4cf4-95cc-8a3d75a0cc84",
                                "sense_id": "bb230798-f56d-3381-9aab-686dc2565361",
                                "text": ".. 8 стран Южной Америки: Аргентина, Боливия, Бразилия, Колумбия, Парагвай, Перу, Уругвай, Венесуэла."
                            }
                        ]
                    }
