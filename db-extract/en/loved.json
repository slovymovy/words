                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geliebt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dde9349d-ab2b-3e84-9c32-a7b56005b67d",
                                        "entry_id": "7c028eef-07a5-3ba9-8378-47f6a67f1fde",
                                        "glosses": [
                                            "durch andere in inniger Zuneigung und Wertschätzung verbunden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1b4f39b-7b26-43e3-9669-355d876edd95",
                                                "sense_id": "dde9349d-ab2b-3e84-9c32-a7b56005b67d",
                                                "text": "Wie süß ists mir, mein sehr geliebtes Kind, meine gute Eleonore, von deinem Glück noch reden zu dürfen, da schon für mich die Sonne bald emporsteigt drüben im Reich der Schatten."
                                            },
                                            {
                                                "example_id": "bcbaf1fb-5d3d-4dec-b38b-dbe04ce13660",
                                                "sense_id": "dde9349d-ab2b-3e84-9c32-a7b56005b67d",
                                                "text": "Ja, mein geliebter Sohn, Alaeddin Abulschamat ist dein Vater, und der Emir Chaled, welcher dir bisher seine Stelle vertreten und dich mit so viel Sorgfalt hat erziehen lassen, ist nur dein Pflegevater."
                                            },
                                            {
                                                "example_id": "5b896e34-66f0-41ed-9a52-387649a6b0e5",
                                                "sense_id": "dde9349d-ab2b-3e84-9c32-a7b56005b67d",
                                                "text": "Joseph Ratzinger ist zweifellos der weltweit beliebteste und geliebteste Deutsche der vergangenen Jahrhunderte."
                                            },
                                            {
                                                "example_id": "6519bf3e-bac1-42da-a4ca-ff17b5cd9a0f",
                                                "sense_id": "dde9349d-ab2b-3e84-9c32-a7b56005b67d",
                                                "text": "Dem geliebteren Maximilian erfüllte man die Kriegsforderungen lieber und schneller."
                                            },
                                            {
                                                "example_id": "4f529eb1-b6b5-470a-aca9-fce6e75be975",
                                                "sense_id": "dde9349d-ab2b-3e84-9c32-a7b56005b67d",
                                                "text": "Wir kommen so dem Charakter unseres Helden näher, und wie einem solchen gerade eine Kunst zusagen müsse, die Kunst der Herzenssprache vor allen andern, unsere geliebte Musik."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
