                    }
                ],
                "senses": [
                    {
                        "sense_id": "2e7479e4-cd48-339c-b1d7-bec868000d42",
                        "entry_id": "fd1be1e6-d775-3f43-a174-104666ce0975",
                        "glosses": [
                            "A movie with sound, as opposed to a silent film."
                        ],
                        "tags": [
                            "dated",
                            "historical",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "d65d5a2a-6c7b-4d54-8635-3fd2f679ebf7",
                                "sense_id": "2e7479e4-cd48-339c-b1d7-bec868000d42",
                                "text": "On October 6, 1927, Warner Bros. released The Jazz Singer, the first sound-synched feature film, prompting a technological shift of unprecedented speed and unstoppable force. Within two years, nearly every studio release was a talkie."
                            },
                            {
                                "example_id": "890cb2bb-4c2a-4489-bcdc-449416530f67",
                                "sense_id": "2e7479e4-cd48-339c-b1d7-bec868000d42",
                                "text": "“We have just returned from the talkies.” “They should never have added sound. There was pop music and people talking all the way through it.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "b5f9426b-02bd-3156-bbcd-ea5ca2efbf3a",
                        "entry_id": "fd1be1e6-d775-3f43-a174-104666ce0975",
                        "glosses": [
                            "A song in which the lyrics are spoken rather than sung."
                        ],
                        "tags": [
                            "dated",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "dda36013-2023-44f4-a74b-c8137fb06622",
                                "sense_id": "b5f9426b-02bd-3156-bbcd-ea5ca2efbf3a",
                                "text": "\"[Love] Jones,\" [named after] a slang expression for addiction, was a string-infested talkie-thing that surprised many folks when it mounted for the upper reaches of Billboard’s pop charts."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6054a6be-426c-4d2a-8922-efb4ba7a75fa",
