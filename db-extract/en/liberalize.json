                        "target_lang_word": "libéraliser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "libéraliser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "801ad6f4-f8fd-3a4c-be12-ddadc37513c3",
                                        "entry_id": "72b357d3-c541-32a3-9540-a132d1c052a2",
                                        "glosses": [
                                            "Rendre une économie plus libérale."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21e05d56-fe55-4dff-bc00-aacc76cf383e",
                                                "sense_id": "801ad6f4-f8fd-3a4c-be12-ddadc37513c3",
                                                "text": "Il faut libéraliser les échanges."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "858aa1d3-7049-3b66-a15e-bf4d68ed9b9b",
                                        "entry_id": "72b357d3-c541-32a3-9540-a132d1c052a2",
                                        "glosses": [
                                            "Rendre plus libéral, plus libre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a232691-c714-4798-a008-cbda6cd3acd5",
                                                "sense_id": "858aa1d3-7049-3b66-a15e-bf4d68ed9b9b",
                                                "text": "Mai 68 a permis de libéraliser les rapports entre les sexes dans tous les domaines de la vie politique."
                                            },
                                            {
                                                "example_id": "df4bccd1-3d25-42be-ab93-6a5d304d25bb",
                                                "sense_id": "858aa1d3-7049-3b66-a15e-bf4d68ed9b9b",
                                                "text": "La modification de l'article 60 du Code civil vise en effet à libéraliser une pratique qui jusque-là nécessitait un passage devant le juge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba1cbb9a-4bde-4f4d-9d22-dd7a30f114f3",
                        "source_entry_id": "6b0b8d29-2160-3987-bdaa-99bc29c860c7",
                        "source_sense_description": "to make liberal",
                        "target_lang_word": "liberalisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "liberalisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8deb373a-27db-309e-b9bf-2bed7efb0cae",
                                        "entry_id": "4b6650fc-18a2-343e-881e-9c9d19c65d14",
                                        "glosses": [
                                            "von Einschränkungen befreien; liberaler machen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a3f9322-2101-4abe-a4c4-88e15159d03d",
                                                "sense_id": "8deb373a-27db-309e-b9bf-2bed7efb0cae",
                                                "text": "Die Liberalisierung des Postmarktes – mit Ausnahme der Pakete, deren Beförderung schon lange liberalisiert ist – ging etwas langsamer vor sich als die in der Telekom-Branche."
                                            },
                                            {
                                                "example_id": "9b33f9f4-a18f-4135-8ab7-9ed653d3f1ad",
                                                "sense_id": "8deb373a-27db-309e-b9bf-2bed7efb0cae",
                                                "text": "Erst seit 2001 ist der heimische Strommarkt völlig liberalisiert, jeder Stromkunde kann seinen Lieferanten frei wählen."
                                            },
                                            {
                                                "example_id": "b877222b-1e38-440e-8b86-f31bcb9ee315",
                                                "sense_id": "8deb373a-27db-309e-b9bf-2bed7efb0cae",
                                                "text": "Ähnlich wie im Strom -und Telekommunikationsmarkt soll demnächst auch der Wassermarkt in den EU-Ländern liberalisiert werden."
                                            },
                                            {
                                                "example_id": "5e3526ca-dfc8-4f18-a73d-cd71f6c4a227",
                                                "sense_id": "8deb373a-27db-309e-b9bf-2bed7efb0cae",
                                                "text": "Das Mietrecht gehört liberalisiert und nicht verschärft."
                                            },
                                            {
                                                "example_id": "5b39a85c-b119-49d9-a294-dbcc2beb7c6e",
                                                "sense_id": "8deb373a-27db-309e-b9bf-2bed7efb0cae",
                                                "text": "Ab den 1970er Jahren wurden die bis dahin streng kontrollierten internationalen Finanzmärkte sukzessive liberalisiert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "017a03e9-2c89-3953-a87b-661159735399",
                                        "entry_id": "4b6650fc-18a2-343e-881e-9c9d19c65d14",
                                        "glosses": [
                                            "Einfuhrverbote, Einfuhrbeschränkungen, Zölle oder Einfuhrkontingente stufenweise beseitigen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6afbf2a9-6ef0-4e2f-b534-603bb63f2057",
                                                "sense_id": "017a03e9-2c89-3953-a87b-661159735399",
                                                "text": "Die Einfuhr ist liberalisiert, Einfuhrlizenzen oder Genehmigungen sind grundsätzlich nicht erforderlich."
                                            },
                                            {
                                                "example_id": "447e17f4-9003-4e7c-95b6-9f869c33a5fe",
                                                "sense_id": "017a03e9-2c89-3953-a87b-661159735399",
                                                "text": "Das ursprünglich zwischen 23 Staaten ausgehandelte Abkommen zielte darauf ab, durch einen multilateralen Zollabbau und den Erlass von Vorschriften gegen unlauteren Wettbewerb den Handel zu liberalisieren und damit einer Rückkehr zum Protektionismus der Zwischenkriegszeit entgegenzuwirken (Freihandel, Zölle)."
                                            },
                                            {
                                                "example_id": "2404b23d-976e-4c6f-8e82-c2412941a3bc",
                                                "sense_id": "017a03e9-2c89-3953-a87b-661159735399",
                                                "text": "Avenir Suisse möchte also, dass die Schweiz, die EU oder alle anderen ausser den USA jeweils unilateral ihre Zölle liberalisieren, sprich abbauen, auch wenn die USA selbst protektionistisch bleibt, da sie letztendlich (scheinbar) dasselbe Ziel wie Trump verfolgt, nämlich einen vollständig liberalisierten Welthandel."
                                            },
                                            {
                                                "example_id": "08fc5a7e-d817-4a1d-918c-bc9db328b96c",
                                                "sense_id": "017a03e9-2c89-3953-a87b-661159735399",
                                                "text": "Vor allem die Amerikaner, aber auch die Europäer hatten ein großes Interesse daran, den Dienstleistungssektor ähnlich zu liberalisieren, wie es für den Warenhandel schon seit 1947 im Rahmen des GATT mit großem Erfolg gelungen war."
                                            },
                                            {
                                                "example_id": "c812b659-e6bb-4c4a-9447-d3fb2bbb3076",
                                                "sense_id": "017a03e9-2c89-3953-a87b-661159735399",
                                                "text": "Die Einfuhr von Gütern nach Rumänien ist allen Unternehmen erlaubt und weitgehend liberalisiert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
