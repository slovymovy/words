                                            {
                                                "example_id": "52e934fd-979d-420a-9fb6-aad445125721",
                                                "sense_id": "7dee75d7-d7c0-3c83-baa6-9ab5fe9c7365",
                                                "text": "Siedzieliśmy pod rozłożystymi, iglastymi drzewami, przy pniu, gdzie było zacisznie i sucho"
                                            }
