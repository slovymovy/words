                ],
                "senses": [
                    {
                        "sense_id": "b6685605-bebb-38c0-82cd-215aa06635a3",
                        "entry_id": "9a6a3c45-d72e-3d2d-96da-67485eb11f67",
                        "glosses": [
                            "„Herrscher eines sehr kleinen Fürstentums“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84fa2c08-fc34-46df-b67b-eb45f5f5878a",
                                "sense_id": "b6685605-bebb-38c0-82cd-215aa06635a3",
                                "text": "„Der Glanz des französischen Hofes unter Ludwig XIV. wirkte auf die Höfe der deutschen Duodezfürsten und auf alles, was sich in Deutschland zur sogenannten höheren Gesellschaft zählte, mit einer solchen Kraft, daß die deutsche Sprache in diesen Kreisen geradezu verpönt war.“"
                            },
                            {
                                "example_id": "aeec38a2-24c2-4b4c-a5fc-67af929f4f59",
                                "sense_id": "b6685605-bebb-38c0-82cd-215aa06635a3",
                                "text": "„Deutschland, das Musikland schlechthin, wo jeder Duodezfürst seine Kapelle unterhielt und Wagner, ungestört von Zeit und Raum, seine musikalischen Fortschrittsbahnen ziehen konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1f4f94ee-3c92-3f03-88ff-1bc573ef986e",
                        "entry_id": "9a6a3c45-d72e-3d2d-96da-67485eb11f67",
                        "glosses": [
                            "Inhaber von Macht oder Einfluss auf räumlich oder gegenständlich beschränktem Gebiet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f30ed8b-525d-4a5f-a540-f584315ce98c",
                                "sense_id": "1f4f94ee-3c92-3f03-88ff-1bc573ef986e",
                                "text": "„Doch der Duodezfürst Oskar Lafontaine hat in all seiner Selbstherrlichkeit niemals Widersprüche geduldet.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
