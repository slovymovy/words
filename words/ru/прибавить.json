    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "37b58035-9482-38c5-9f9c-1b68bc72b732",
                    "sense_definition": "Выполнить арифметическую операцию сложения.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "arithmetic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Нужно <w>прибавить</w> пять к десяти, чтобы получить пятнадцать."
                        },
                        {
                            "text": "Если <w>прибавить</w> к этому числу два, результат изменится."
                        }
                    ],
                    "synonyms": [
                        "приплюсовать"
                    ],
                    "antonyms": [
                        "вычесть"
                    ]
                },
                {
                    "sense_id": "d5046fa3-ccd4-3dbf-9d0e-a7deeeb9b4a3",
                    "sense_definition": "Увеличить скорость движения.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Водитель решил <w>прибавить</w> ходу, чтобы успеть до темноты."
                        },
                        {
                            "text": "Нам нужно <w>прибавить</w> скорости, иначе мы опоздаем на поезд."
                        }
                    ],
                    "synonyms": [
                        "увеличить"
                    ],
                    "antonyms": [
                        "сбавить"
                    ],
                    "common_phrases": [
                        "прибавить ходу"
                    ]
                },
                {
                    "sense_id": "57a070a0-0bbd-3cf2-ae0f-175fdeb9eea0",
                    "sense_definition": "Добавить что-либо к уже имеющемуся набору или количеству.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "addition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В суп стоит <w>прибавить</w> немного соли для вкуса."
                        },
                        {
                            "text": "Я хочу <w>прибавить</w> этот документ к общему списку файлов."
                        }
                    ],
                    "synonyms": [
                        "добавить"
                    ],
                    "antonyms": [
                        "изъять"
