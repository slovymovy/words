                                "target_senses": [
                                    {
                                        "sense_id": "357c3a96-3b99-39c7-b409-2bddf844b82a",
                                        "entry_id": "d2283c4c-d3e6-320c-8703-970eeda1e463",
                                        "glosses": [
                                            "Alternative spelling of bevor (“part of a helmet”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2edae71-dce2-490a-a742-57ac36d8191f",
                                                "sense_id": "357c3a96-3b99-39c7-b409-2bddf844b82a",
                                                "text": "Lord Stafford’s father, Duke of Buckingham,\nIs either slain or wounded dangerously;\nI cleft his beaver with a downright blow:"
                                            },
                                            {
                                                "example_id": "5422b736-124c-4d6d-94c1-948c18e0217b",
                                                "sense_id": "357c3a96-3b99-39c7-b409-2bddf844b82a",
                                                "text": "With trembling hands her beaver he untied, / Which done, he saw, and seeing knew her face."
                                            },
                                            {
                                                "example_id": "5e84d615-6a86-471c-92b7-23b78d206dc0",
                                                "sense_id": "357c3a96-3b99-39c7-b409-2bddf844b82a",
                                                "text": "Without alighting from his horse, the conqueror called for a bowl of wine, and opening the beaver, or lower part of his helmet, announced that he quaffed it, “To all true English hearts, and to the confusion of foreign tyrants.”"
                                            },
                                            {
                                                "example_id": "d0e7791c-c012-4f38-81bf-43d296253548",
                                                "sense_id": "357c3a96-3b99-39c7-b409-2bddf844b82a",
                                                "text": "1951 Adaptation of the 1885 Ormsby translation of Cervantes’ Don Quixote, correcting Ormsby as to the portion of the helmet referred to by Cervantes (see note 11 to chapter II) at the suggestion of Juan Hartzenbusch, a 19th-century director of the National Library of Spain.\nThey laid a table for him at the door of the inn for the sake of the air, and the host brought him a portion of ill-soaked and worse cooked stockfish, and a piece of bread as black and mouldy as his own armour; but a laughble sight it was to see him eating, for having his helmet on and the beaver up, he could not with his own hands put anything into his mouth unless some one else placed it there, and this service one of the ladies rendered him."
                                            },
                                            {
                                                "example_id": "17a1d34a-00de-42ab-9222-4f76897b3f84",
                                                "sense_id": "357c3a96-3b99-39c7-b409-2bddf844b82a",
                                                "text": "As each one brings a little of himself to what he sees you brought the trappings of your historic preoccupations, so that Monsieur flattered you by presenting himself with beaver up like Hamlet's father's ghost!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "beaver",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21ae8820-9fab-3ddc-bbad-4f0b8fb1b2d0",
                                        "entry_id": "2965fd69-5a09-33e3-af17-fb3ed2e09259",
                                        "glosses": [
                                            "Butter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90380b4b-887f-4e3a-8119-be80589e62f1",
                                                "sense_id": "21ae8820-9fab-3ddc-bbad-4f0b8fb1b2d0",
                                                "text": "Butter – Beaver."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
