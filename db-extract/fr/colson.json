                        "cross_references": [
                            {
                                "target_word": "zip-tie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "393281dd-2db5-3672-a69f-e0dfc1cbe13f",
                                        "entry_id": "d5366488-5f80-3bcf-9f14-71cbde8ba41c",
                                        "glosses": [
                                            "Alternative form of zip tie."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3575727e-39db-48e7-9a13-699486d3e3ed",
                                                "sense_id": "393281dd-2db5-3672-a69f-e0dfc1cbe13f",
                                                "text": "She pulled a zip-tie out from her waistband."
                                            },
                                            {
                                                "example_id": "b2bb6062-f2f2-4830-91a4-67b6aeba2202",
                                                "sense_id": "393281dd-2db5-3672-a69f-e0dfc1cbe13f",
                                                "text": "He thought he could feel the zip-tie beginning to give, too."
                                            },
                                            {
                                                "example_id": "9551c265-dd2a-4e5f-9e8a-d7bf7f1dcaff",
                                                "sense_id": "393281dd-2db5-3672-a69f-e0dfc1cbe13f",
                                                "text": "As soon as he was comfortable, he examined the zip-tie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "zip-tie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d004917f-08c0-31b7-adaf-544d54099025",
                                        "entry_id": "2fb2d0d1-aa2f-3d1e-b234-017b2505245b",
                                        "glosses": [
                                            "Alternative form of zip tie."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8683e3c4-f5f8-4901-89e4-7c9796bb8202",
                                                "sense_id": "d004917f-08c0-31b7-adaf-544d54099025",
                                                "text": "I drink a swig of it and get to work zip-tying lights inside of trusses."
                                            },
                                            {
                                                "example_id": "2c71e96a-3285-4273-9c2b-1039c99ab012",
                                                "sense_id": "d004917f-08c0-31b7-adaf-544d54099025",
                                                "text": "It was brutal, more brutal than normal. I had to zip-tie my bike to the racking just to keep it from flying off."
                                            },
                                            {
                                                "example_id": "92238d3d-7414-4cd7-9b07-101a1b5ea327",
                                                "sense_id": "d004917f-08c0-31b7-adaf-544d54099025",
                                                "text": "Two of the terrorists point their guns at the group while Beard moves through the bodies, checking each person for cell phones, removing watches and jewelry, zip-tying hands behind backs, and duct-taping mouths."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
