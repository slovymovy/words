                "senses": [
                    {
                        "sense_id": "57deb0b8-d08a-31bf-bf1d-0e7873f70119",
                        "entry_id": "e5865241-65bb-3daa-b5a8-c6f0feee0e5c",
                        "glosses": [
                            "Assouvir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27a864ab-d6ae-4160-b4ee-d8bc5dbaebb9",
                                "sense_id": "57deb0b8-d08a-31bf-bf1d-0e7873f70119",
                                "text": "L'entendre et l'écouter dans l'intraductible de la voix, qui la montre cherchant à chaque instant à se réassouvir à se désouvenir du cri d'Orphée d'avant la lettre."
                            },
                            {
                                "example_id": "4d351840-0907-478f-9774-e3d49300be2e",
                                "sense_id": "57deb0b8-d08a-31bf-bf1d-0e7873f70119",
                                "text": "J'ose ainsi espérer pouvoir réassouvir ma passion des cieux noirs, en compagnie de mon ami le dobson"
                            }
                        ]
                    }
