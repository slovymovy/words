                "forms": [],
                "senses": [
                    {
                        "sense_id": "a61609ea-4db5-35f0-9702-6849d4ae5c6c",
                        "entry_id": "dea23c77-a0b1-35cd-991e-3817120f937b",
                        "glosses": [
                            "Région des Pays-Bas qui comprend la partie orientale et la plus urbanisée de la province d’Overijssel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "043d2859-ad1a-41ea-8c1c-3c869bca13f7",
                                "sense_id": "a61609ea-4db5-35f0-9702-6849d4ae5c6c",
                                "text": "TWENTE, (Géog. mod.) canton des Pays-bas, dans la province d’Ovérissel, sur les confins de la Westphalie. Oldensel en est le chef-lieu."
                            },
                            {
                                "example_id": "16ba628b-8313-4cc8-ad9f-6c48ab86a49c",
                                "sense_id": "a61609ea-4db5-35f0-9702-6849d4ae5c6c",
                                "text": "OVER-ISSEL, l’, (Géogr.) en latin Transidalana provincia, l’une des sept Provinces-Unies, au-delà de l’Issel, bornée N. par la Frise & le terrain de Groningue, O. par l’Issel, S. par le comté de Zutphen, E. par l’évêché de Munster : on la divise en trois parties principales, qui sont le pays de Drente, de Twente, & le Sallant."
                            },
                            {
                                "example_id": "27de14fe-fc3d-49e7-b0bd-2cebffe80e93",
                                "sense_id": "a61609ea-4db5-35f0-9702-6849d4ae5c6c",
                                "text": "Il est à croire qu’après la défaite des Marses & des Bructeres, les Tubantes allerent occuper une partie de leur pays, sur les deux bords de la riviere de Wecht, avant que les Chamaves & les Ampsibariens s’y fussent établis. Trop de lieux portent dans ce quartier la le nom de ces peuples, pour qu’on puisse douter qu’ils y ayent fait quelque demeure. On y voit Bentlagen, qui signifie le camp des Tubantes, outre Bentlo, Beutinge, Bente, & peut-être encore quelques autres. Tout cela porte Alting à conclure que les Tubantes ont habité tout le pays qui est entre l’Ems & le comté de Bentheim, y compris ce comté & la seconde Salique (Solland), ou cette partie de l’Over-Issel, appellée aujourd’hui Twente, du nom de ces peuples."
                            }
                        ]
                    }
                ],
