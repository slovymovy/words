    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5afc2813-2afb-343c-be7e-4ac67bd2d022",
                    "sense_definition": "Added to what is already present or available.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You may be charged an <w>additional</w> fee for late payment.",
                            "target_lang_translations": {
                                "ru": "С вас может взиматься <w>дополнительная</w> плата за просрочку платежа.",
                                "zh": "逾期付款可能会被收取一笔<w>额外</w>费用。",
                                "pl": "Możesz zostać obciążony <w>dodatkową</w> opłatą za spóźnioną płatność."
                            }
                        },
                        {
                            "text": "The hotel provided <w>additional</w> towels on request.",
                            "target_lang_translations": {
                                "ru": "Отель предоставил <w>дополнительные</w> полотенца по запросу.",
                                "zh": "酒店应要求提供了<w>额外</w>的毛巾。",
                                "pl": "Hotel na życzenie zapewnił <w>dodatkowe</w> ręczniki."
                            }
                        }
                    ],
                    "synonyms": [
                        "extra",
                        "further",
                        "supplementary",
                        "supplemental",
                        "auxiliary",
                        "more",
                        "added"
                    ],
                    "common_phrases": [
                        "additional information",
                        "additional cost",
                        "additional resources",
                        "additional support"
                    ],
                    "target_lang_definitions": {
                        "ru": "Добавленный к тому, что уже присутствует или доступно.",
                        "zh": "在已有事物之外增加的；额外的。",
                        "pl": "Dodany do tego, co już istnieje lub jest dostępne."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дополнительный",
