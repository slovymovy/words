                        "tiens tiens"
                    ]
                },
                {
                    "sense_id": "04885940-caf2-35df-8f34-dd2a2ba0f2d6",
                    "sense_definition": "Exclamation qui marque le doute ou la suspicion, parfois mêlés d'étonnement, devant un fait qui paraît étrange.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "étonnement et doute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Tiens</w>, <w>tiens</w>, voilà qui est bizarre, murmura-t-il en regardant la porte entrouverte."
                        },
                        {
                            "text": "<w>Tiens</w>, il n'a pas répondu à ma question, et cela me paraît suspect."
                        }
                    ],
                    "common_phrases": [
