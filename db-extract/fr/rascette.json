                        "entry_id": "dfce28a3-7dfb-3418-89f3-246ef0bee89e",
                        "glosses": [
                            "Partie du bas de la paume de la main, contre le poignet, où se voient des lignes transversales."
                        ],
                        "tags": [
                            "Chiromancie"
                        ],
                        "examples": [
                            {
                                "example_id": "1116b614-320f-43bf-9ede-224e8324757d",
                                "sense_id": "9ec3669a-426c-3972-9ea5-f523240cd19e",
                                "text": "Elle se frotte la paume droite, zébrée à la base, à travers les rascettes, par une longue cicatrice violette."
                            },
                            {
                                "example_id": "74bc31e6-4eb0-424d-bef8-2f9bdff991f2",
                                "sense_id": "9ec3669a-426c-3972-9ea5-f523240cd19e",
                                "text": "C’est probablement faux, mais en tout cas les siennes n’ont jamais cessé d’âtre bien nette, de tracer notamment une ligne de vie qui file jusqu’au rascettes."
                            }
                        ]
                    }
