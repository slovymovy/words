                    {
                        "translation_id": "1a72db87-192b-4783-9816-0f66a1db266d",
                        "source_entry_id": "18aeb84f-a7d6-3f69-bfd8-ab8dcf806281",
                        "source_sense_id": "8b3357ee-bc6f-3694-b0d8-08412ca9d8cb",
                        "target_lang_word": "homogeneousness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homogeneousness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ddba36cd-af60-3078-b214-1e634cb4cf73",
                                        "entry_id": "bd9ac91d-3b7b-360e-9fca-598d912a8641",
