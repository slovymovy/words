                ],
                "senses": [
                    {
                        "sense_id": "54d2fb70-2429-3717-b606-9bcafa63c819",
                        "entry_id": "0cc23cd2-0590-3031-b42a-807ff89e4cdd",
                        "glosses": [
                            "Créature du folklore japonais d’origine chinoise, inspirée du renard, dotée de pouvoirs de métamorphose et d’illusions, pouvant avoir jusqu’à neuf queues."
                        ],
                        "tags": [
                            "Mythologie japonaise"
                        ],
                        "note": "Parfois considéré comme un abus de langage",
                        "examples": [
                            {
                                "example_id": "dfd00333-ea91-4754-96e6-263616d40c53",
                                "sense_id": "54d2fb70-2429-3717-b606-9bcafa63c819",
                                "text": "Dommage que tu ne puisses pas parler, sinon tu m’aurais dit où se cache le kitsune."
                            },
                            {
                                "example_id": "f8da48cf-fdf3-41c7-a9d0-838ae1a06800",
                                "sense_id": "54d2fb70-2429-3717-b606-9bcafa63c819",
                                "text": "Les kitsunes possèdent de nombreux pouvoirs : en plus d’avoir des talents de métamorphes et la possibilité d’adopter une apparence humaine, ils sont capables de prendre possession d’un humain."
                            }
                        ]
                    }
                ],
