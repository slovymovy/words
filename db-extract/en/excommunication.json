                    {
                        "translation_id": "98c0cc7b-4668-4e4c-b385-e44268364ad7",
                        "source_entry_id": "27332fd7-bd7a-3277-bafe-96dc3166b453",
                        "source_sense_id": "2bde1dd4-09f6-3c32-a588-b582d0a6145b",
                        "source_sense_description": "act of excommunicating, disfellowshipping or ejecting",
                        "target_lang_word": "excommunication",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "excommunication",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb25a391-7af9-32c0-94fd-3e298e5d0a4e",
                                        "entry_id": "831663c7-c6e7-3075-a89a-aa44f53faeb4",
                                        "glosses": [
                                            "Censure ecclésiastique par laquelle on est retranché de la communion de l’Église."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e5094d4-71b6-45ab-9232-83363c154ae2",
                                                "sense_id": "eb25a391-7af9-32c0-94fd-3e298e5d0a4e",
                                                "text": "Godfroid, Elie, 21 ans, instituteur communal à Flohimont, commune de Saint-Pierre, prête serment et déclare :\nDepuis le 1ᵉʳ octobre 1879, je remplis les fonctions d'instituteur communal à Flohimont. Mon prédécesseur avait 55 élèves en hiver; en été 35 environ. Je n'ai eu que 13 élèves en hiver et 6 à 8 en été. J'attribue la désertion de mon école à la peine d’excommunication lancée par le curé, au refus d'absolution et surtout de première communion."
                                            },
                                            {
                                                "example_id": "df1bdaea-81b7-44a6-92cc-2fcf99cdedfc",
                                                "sense_id": "eb25a391-7af9-32c0-94fd-3e298e5d0a4e",
                                                "text": "Excommunication majeure, celle qui retranche entièrement de la communion de l’église et de toute communion avec les fidèles."
                                            },
                                            {
                                                "example_id": "23397a5e-27a4-415d-b04b-c20b4453a79a",
                                                "sense_id": "eb25a391-7af9-32c0-94fd-3e298e5d0a4e",
                                                "text": "excommunication mineure, celle qui interdit seulement l’usage des sacrements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4720493-9a00-3804-ac8e-9bf8bf29ee67",
                                        "entry_id": "831663c7-c6e7-3075-a89a-aa44f53faeb4",
                                        "glosses": [
                                            "Sentence de bannissement de la communauté des fidèles dans d'autres religions."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e682c92-ec10-4c0b-bae8-736a11a1d621",
                                                "sense_id": "a4720493-9a00-3804-ac8e-9bf8bf29ee67",
                                                "text": "Les partisans de Maïmonide répliquèrent à l'interdit prononcé par les « littéralistes » en lançant, à leur tour, l'excommunication contre les auteurs de l'interdit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8da7a6cc-c936-4f9c-b6ad-27512f63ce0f",
                        "source_entry_id": "27332fd7-bd7a-3277-bafe-96dc3166b453",
                        "source_sense_id": "2bde1dd4-09f6-3c32-a588-b582d0a6145b",
                        "source_sense_description": "act of excommunicating, disfellowshipping or ejecting",
                        "target_lang_word": "Exkommunikation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Exkommunikation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eddc3ba3-f444-33b8-8b8e-fdaaf9366754",
                                        "entry_id": "30f7196a-4937-346c-a216-de84efea1bbe",
                                        "glosses": [
                                            "der Ausschluss aus einer kirchlichen Gemeinschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d51dedb-e921-4c50-8ba4-66cac2ae9d6b",
                                                "sense_id": "eddc3ba3-f444-33b8-8b8e-fdaaf9366754",
                                                "text": "„Nur fünf Jahre später bedrohte ein in Toulouse abgehaltenes Konzil die neuen Ketzer und ihre Förderer mit Exkommunikation und Kerker.“"
                                            },
                                            {
                                                "example_id": "0daf6e4e-871d-46c5-ad07-5bfff2ed9329",
                                                "sense_id": "eddc3ba3-f444-33b8-8b8e-fdaaf9366754",
                                                "text": "„Die Nonne erklärte mir, daß jede von ihnen nur zehn savoyardische Soldi pro Tag erhalten würde; bei Strafe der Exkommunikation dürften sie ohne Wissen der Äbtissin nichts besitzen.“"
                                            },
                                            {
                                                "example_id": "48a5c65e-d5e6-4536-b350-a489f154d03d",
                                                "sense_id": "eddc3ba3-f444-33b8-8b8e-fdaaf9366754",
                                                "text": "„Eine Exkommunikation ist eine Beugestrafe, kein Kirchenausschluss. Sie will bezwecken, dass wir leiden, weil wir keinen Zugang mehr zu den Sakramenten haben. Der Punkt ist aber: Niemand verweigert uns die Kommunion. Mein Mann und ich zahlen nach wie vor Kirchensteuer. Eine Exkommunikation ist ein mittelalterliches Instrument, das völlig absurd ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
