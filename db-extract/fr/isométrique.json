        "fr-extract.jsonl": [
            {
                "entry_id": "6c0d8b1b-f380-3a5b-980c-acbed05bc4e9",
                "word": "isométrique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "81a7aaf9-3ee0-455d-b0ba-a593ff155623",
                        "entry_id": "6c0d8b1b-f380-3a5b-980c-acbed05bc4e9",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "isométriques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e40facef-5906-358e-88f0-d420656b6fab",
                        "entry_id": "6c0d8b1b-f380-3a5b-980c-acbed05bc4e9",
                        "glosses": [
                            "De même mesure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bb16042-8009-4e29-bd42-b074da4c28e7",
                                "sense_id": "e40facef-5906-358e-88f0-d420656b6fab",
                                "text": "À la surface plane, isométrique de la carte du monde se substituait une topographie anormale où Shannon était plus proche de Katowice que de Bruxelles, de Fuerteventura que de Madrid."
                            },
                            {
                                "example_id": "ef7b27fa-54ab-4a9c-a258-7ae623eefecc",
                                "sense_id": "e40facef-5906-358e-88f0-d420656b6fab",
                                "text": "S’il est vrai que l’attitude peut être obtenue par contraction isométrique volontaire, résultant des prises de positions hyper-corrigées, elle est aussi — et surtout — conséquente du jeu musculaire tonique."
                            }
                        ]
                    },
                    {
                        "sense_id": "c70f1d89-c8ee-3fda-8c50-312de3440ab8",
                        "entry_id": "6c0d8b1b-f380-3a5b-980c-acbed05bc4e9",
                        "glosses": [
                            "Qui conserve les mesures."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e617ddf-97f5-4366-8633-0782db56466d",
                                "sense_id": "c70f1d89-c8ee-3fda-8c50-312de3440ab8",
                                "text": "Quand un poème, ou une strophe, ne sont composés que de vers identiques, on les qualifie d’isométriques. Dans le cas contraire, ils sont dits hétérométriques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ad0055f-a238-4816-aaef-b69ff46bcf00",
                        "source_entry_id": "6c0d8b1b-f380-3a5b-980c-acbed05bc4e9",
                        "target_lang_word": "isometrisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "isometrisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "de1da8b1-bb54-3028-b617-43e82d5202e7",
                                        "entry_id": "de653724-7766-384a-b4cd-7fa2a0fd16a6",
                                        "glosses": [
                                            "von gleichbleibender Länge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "984a2e83-8670-48ee-bd36-c269378d5b1b",
                                                "sense_id": "de1da8b1-bb54-3028-b617-43e82d5202e7",
                                                "text": "Die isometrischen Übungen sind gut für den Muskelaufbau."
                                            },
                                            {
                                                "example_id": "11ec7fd5-3444-4310-9122-b51ccf49eaf3",
                                                "sense_id": "de1da8b1-bb54-3028-b617-43e82d5202e7",
                                                "text": "Die „Anspannung eines Muskels ohne Veränderung seiner Länge“ nennt man „isometrische Muskelkontraktion.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "83d7ee4a-c992-3274-a90b-d4d461ee9a53",
                                        "entry_id": "de653724-7766-384a-b4cd-7fa2a0fd16a6",
                                        "glosses": [
                                            "von gleichbleibendem/gleichmäßigem Wachstum"
                                        ],
                                        "tags": [
                                            "Biologie (speziell Botanik)"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62070a41-6840-40b5-9196-760f86992229",
                                                "sense_id": "83d7ee4a-c992-3274-a90b-d4d461ee9a53",
                                                "text": "Die Pflanze wächst isometrisch."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1366864d-fa6c-31ec-8899-0ace895a12fe",
                                        "entry_id": "de653724-7766-384a-b4cd-7fa2a0fd16a6",
                                        "glosses": [
                                            "Abstände erhaltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b88aa4c3-b561-4f40-936f-cc555e37284c",
                                                "sense_id": "1366864d-fa6c-31ec-8899-0ace895a12fe",
                                                "text": "„Zwei metrische Räume M₁ und M₂ heißen isometrisch, wenn es eine bijektive Abbildung",
                                                "translation": "ist für alle x₁, x₂, die Element von M₁ sind.“"
                                            },
                                            {
                                                "example_id": "46c34d88-def3-48d0-8e05-961d6c7d542b",
                                                "sense_id": "1366864d-fa6c-31ec-8899-0ace895a12fe",
                                                "text": "Jede orthogonale Abbildung ist also insbesondere isometrisch."
                                            },
                                            {
                                                "example_id": "ed32dc41-1ecb-4852-868b-b270d028f594",
                                                "sense_id": "1366864d-fa6c-31ec-8899-0ace895a12fe",
                                                "text": "Ist eine isometrische Abbildung zusätzlich auch noch surjektiv, insgesamt also bijektiv, so ist ihre Umkehrung f: X – X offenbar auch isometrisch, und die Abbildung heißt eine Isometrie zwischen X und X."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b34a1798-d50c-432f-a889-c85e60f5094c",
                        "source_entry_id": "6c0d8b1b-f380-3a5b-980c-acbed05bc4e9",
