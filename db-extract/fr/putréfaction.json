                                "target_senses": [
                                    {
                                        "sense_id": "b6597f6a-3c1c-31d5-9420-35d5b26e41f5",
                                        "entry_id": "f1ce0c20-2564-371b-ba02-06de73618382",
                                        "glosses": [
                                            "sterke verontreiniging"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2694c663-b19f-432c-abb8-6d917e08feb4",
                                                "sense_id": "b6597f6a-3c1c-31d5-9420-35d5b26e41f5",
                                                "text": "b.v. het terechtkomen van onnatuurlijke, schadelijke of giftige stoffen in het milieu"
                                            },
                                            {
                                                "example_id": "1db31e58-effb-4a7a-acfe-8cb6b5aed494",
                                                "sense_id": "b6597f6a-3c1c-31d5-9420-35d5b26e41f5",
                                                "text": "Dat milieuvervuiling een probleem is, werd rond 1970 algemeen bekend."
                                            },
                                            {
                                                "example_id": "58c53ddd-9fda-4c13-9a21-ca8183d6e7c9",
                                                "sense_id": "b6597f6a-3c1c-31d5-9420-35d5b26e41f5",
                                                "text": "Vandaag wordt bij verschillende Nederlandse vliegvelden gedemonstreerd door mensen die vinden dat de overlast en de vervuiling door de luchtvaart de spuigaten uit loopt."
                                            },
                                            {
                                                "example_id": "e57f792d-efca-468c-9e00-0730cdf27877",
                                                "sense_id": "b6597f6a-3c1c-31d5-9420-35d5b26e41f5",
                                                "text": "\"We willen bezoekers laten zien hoe kwetsbaar het waddengebied is\", zegt Venema. \"Met vervuiling, gaswinning en druk op de natuur is er veel werk te doen. In het nieuwe centrum kunnen we dat verhaal beter vertellen.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e0ab8a2-90b0-4ba5-997d-2b649d4fec34",
                        "source_entry_id": "ff448fad-4c60-3b99-ba88-40f6d90b2a43",
                        "target_lang_word": "verrotting",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verrotting",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6f0e9163-1b2a-3778-a8b2-e47563656606",
                                        "entry_id": "546cf903-3d73-3e5e-813e-eaa3a76d3f3f",
                                        "glosses": [
                                            "het uiteenvallen van dode organismen of dood organisch materiaal"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8360af2-4ad6-4bfc-8f72-76ea08942ace",
                                                "sense_id": "6f0e9163-1b2a-3778-a8b2-e47563656606",
                                                "text": "Zodra Rostov de deur van het gebouw binnenging werd hij bevangen door een stank van verrotting vermengd met de ziekenhuislucht."
                                            },
                                            {
                                                "example_id": "7325f730-6cf0-4ead-9924-835b3356cc37",
                                                "sense_id": "6f0e9163-1b2a-3778-a8b2-e47563656606",
                                                "text": "Voor veel soldaten maakte het ook niet meer uit; duizenden overleefden de gevechten niet. Een ooggetuige die het slagveld een paar dagen later bezocht, schreef in een brief: \"Duizenden liggen daar nog onbegraven, de sedert twee dagen heersende warmte heeft de verrotting sterk bevorderd. Op een kwartier uur van het slagveld ontwaart men reeds de verpestende reuk\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
