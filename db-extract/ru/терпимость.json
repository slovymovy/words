                                        "sense_id": "840c5b41-855f-36fe-9f1e-453e0ae38e2e",
                                        "entry_id": "86867581-d071-3734-9fbc-6a3f41d39172",
                                        "glosses": [
                                            "Actitud justa, objetiva y permisiva para las opiniones y practicas que difieren de las propias."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d288bcd-ef2a-4f19-a433-35875fd87bcd",
                                                "sense_id": "840c5b41-855f-36fe-9f1e-453e0ae38e2e",
                                                "text": "Las identidades, son construidas con relación a espacios de acción, con relación a su cuerpo, a las interrelaciones, a la construcción de la subjetividad, de la tolerancia y la solidaridad."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
