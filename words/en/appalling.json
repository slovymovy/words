                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>appalling</w> the crowd with his rude comments.",
                            "target_lang_translations": {
