                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "977aea3c-00ca-43e4-bc45-7c0658dc33c8",
                                "sense_id": "b4ff5d07-6ab8-303d-b200-29a75ad0723f",
                                "text": "Tout d’même c’est dérangeant pour les cossards, vu l’temps qu'est bon, qu'il faut r'piquer d'main."
                            }
                        ]
