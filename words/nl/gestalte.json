                    "frequency": "Middle",
                    "semantic_group_id": "uiterlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ondanks zijn kleine <w>gestalte</w> was hij een indrukwekkende verschijning.",
                            "target_lang_translations": {
