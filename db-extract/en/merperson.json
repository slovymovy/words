                                        "sense_index_json": "\"1.5\""
                                    },
                                    {
                                        "sense_id": "c34c5c37-899b-3590-a326-61292e3afaec",
                                        "entry_id": "ab560f78-24b8-3eb6-9b0d-74d31850cdcd",
                                        "glosses": [
