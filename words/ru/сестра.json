    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1f00c276-88d8-35c8-b136-e0f576627275",
                    "sense_definition": "Дочь тех же родителей по отношению к другим их детям.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "родственники",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Моя младшая <w>сестра</w> учится в школе и очень любит рисовать.",
                            "target_lang_translations": {
                                "nl": "Mijn jongere <w>zus</w> zit op school en houdt erg van tekenen."
                            }
                        },
                        {
                            "text": "У него есть старший брат и родная <w>сестра</w>.",
                            "target_lang_translations": {
                                "nl": "Hij heeft een oudere broer en een biologische <w>zus</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "сестрица"
                    ],
                    "antonyms": [
                        "брат"
                    ],
                    "common_phrases": [
                        "родная сестра",
                        "младшая сестра",
                        "старшая сестра",
                        "двоюродная сестра"
                    ],
                    "target_lang_definitions": {
                        "nl": "Dochter van dezelfde ouders ten opzichte van hun andere kinderen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "zus",
                                "target_lang_sense_clarification": "informeel, meest gebruikelijk"
                            },
                            {
                                "target_lang_word": "zuster",
                                "target_lang_sense_clarification": "formeler"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b8aa79c-0e33-3a98-9408-9e091d81fd62",
                    "sense_definition": "Медицинский работник среднего звена; медсестра.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "профессии",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Медицинская <w>сестра</w> быстро и аккуратно сделала пациенту укол.",
                            "target_lang_translations": {
                                "nl": "De <w>verpleegster</w> gaf de patiënt snel en voorzichtig een injectie."
                            }
                        },
                        {
                            "text": "Врач попросил, чтобы дежурная <w>сестра</w> принесла историю болезни.",
                            "target_lang_translations": {
                                "nl": "De arts vroeg de <w>dienstdoende zuster</w> om het medisch dossier te brengen."
                            }
                        }
                    ],
                    "synonyms": [
                        "медсестра",
                        "сестра милосердия"
                    ],
                    "antonyms": [
                        "врач",
                        "медбрат"
                    ],
                    "common_phrases": [
                        "медицинская сестра",
                        "дежурная сестра",
                        "старшая сестра"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "часто используется в разговорной речи вместо полного термина медсестра"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een paramedisch medewerker; verpleegkundige."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "zuster",
                                "target_lang_sense_clarification": "traditionele aanspreekvorm voor een verpleegster"
                            },
                            {
                                "target_lang_word": "verpleegster",
                                "target_lang_sense_clarification": "vrouwelijke verpleegkundige"
                            },
                            {
                                "target_lang_word": "verpleegkundige",
                                "target_lang_sense_clarification": "moderne, genderneutrale term"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fec9efab-c4f2-3363-85f4-a652147a1f90",
                    "sense_definition": "Женщина, являющаяся членом религиозной общины или монастыря.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "религия",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В монастыре <w>сёстры</w> проводили дни в молитвах и трудах.",
                            "target_lang_translations": {
                                "nl": "In het klooster brachten de <w>zusters</w> hun dagen door in gebed en arbeid."
                            }
                        },
                        {
                            "text": "Каждая <w>сестра</w> в этой общине имела свои послушания.",
                            "target_lang_translations": {
                                "nl": "Elke <w>zuster</w> in deze gemeenschap had haar eigen plichten."
                            }
                        }
                    ],
                    "synonyms": [
                        "монашка"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een vrouw die lid is van een religieuze gemeenschap of klooster."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "zuster",
                                "target_lang_sense_clarification": "religieuze zuster"
                            },
                            {
                                "target_lang_word": "non",
                                "target_lang_sense_clarification": "kloosterlinge"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d189b9b7-0710-3d79-81dd-5d22c8a470da",
                    "sense_definition": "Женщина, близкая кому-либо по духу, убеждениям или общему делу.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "близость",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она была мне не просто подругой, а настоящей духовной <w>сестрой</w>.",
                            "target_lang_translations": {
                                "nl": "Ze was voor mij niet zomaar een vriendin, maar een echte spirituele <w>zuster</w>."
                            }
                        },
                        {
                            "text": "В этой борьбе мы стояли плечом к плечу как <w>сёстры</w> по оружию.",
                            "target_lang_translations": {
                                "nl": "In deze strijd stonden we schouder aan schouder als <w>zusters</w> in de strijd."
                            }
                        }
                    ],
                    "synonyms": [
                        "подруга"
                    ],
                    "antonyms": [
                        "недруг",
                        "оппонент"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een vrouw die iemand nabijstaat in geest, overtuiging of gemeenschappelijke zaak."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "zuster",
                                "target_lang_sense_clarification": "geestelijke of ideologische zuster"
                            }
                        ]
                    }
                }
            ]
        }
