{
    "word_family": [
        "hengelaar",
        "hengelen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "192bf4fc-8699-3bf9-baa6-240cd35d20c9",
                    "sense_definition": "stok of buis om met een lijn te vissen",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "vissen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij kocht een nieuwe <w>hengel</w> om in de vijver te vissen.",
                            "target_lang_translations": {
                                "ru": "Он купил новую <w>удочку</w>, чтобы ловить рыбу в пруду.",
                                "en": "He bought a new <w>fishing rod</w> to fish in the pond."
                            }
                        },
                        {
                            "text": "Met een simpele <w>hengel</w> zat hij urenlang geduldig aan de waterkant.",
                            "target_lang_translations": {
                                "ru": "С простой <w>удочкой</w> он часами терпеливо сидел на берегу.",
                                "en": "With a simple <w>fishing rod</w>, he sat patiently by the water's edge for hours."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hengel uitwerpen"
                    ],
                    "target_lang_definitions": {
                        "ru": "длинный гибкий стержень с леской и крючком для рыбной ловли",
                        "en": "A long, flexible rod with a line and hook used for fishing."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удочка",
                                "target_lang_sense_clarification": "основное приспособление для ловли рыбы"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "fishing rod",
                                "target_lang_sense_clarification": "the standard tool used for angling"
                            },
                            {
                                "target_lang_word": "rod",
                                "target_lang_sense_clarification": "a common term for a fishing pole"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44088417-231b-3bae-95bb-adb8d80bca3f",
                    "sense_definition": "stok of buis om een microfoon op de gewenste plaats te houden",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "techniek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De geluidsman hield de <w>hengel</w> precies boven de acteurs.",
                            "target_lang_translations": {
                                "ru": "Звукооператор держал <w>микрофонную удочку</w> прямо над актерами.",
                                "en": "The sound technician held the <w>boom</w> exactly above the actors."
                            }
                        },
                        {
                            "text": "Tijdens de opnames bleef de <w>hengel</w> net buiten het beeld.",
                            "target_lang_translations": {
                                "ru": "Во время съемок <w>микрофонная удочка</w> оставалась прямо за пределами кадра.",
                                "en": "During the filming, the <w>boom</w> stayed just out of the frame."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "длинный шест для удержания микрофона над актерами во время съемок",
                        "en": "A long pole used to hold a microphone in the desired position during filming."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "микрофонная удочка",
                                "target_lang_sense_clarification": "специальный держатель для микрофона"
                            },
                            {
                                "target_lang_word": "журавль",
                                "target_lang_sense_clarification": "профессиональный термин для микрофонного штатива"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "boom",
                                "target_lang_sense_clarification": "a pole used to suspend a microphone"
                            },
                            {
                                "target_lang_word": "boom pole",
                                "target_lang_sense_clarification": "a specific term for a microphone holder"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e616708a-0194-3152-88fe-549f38370468",
                    "sense_definition": "plant uit de bremraapfamilie Melampyrum pratense",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "plantkunde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In dit bosgebied groeit veel <w>hengel</w> tussen de eikenbomen.",
                            "target_lang_translations": {
                                "ru": "В этой лесной местности среди дубов растет много <w>марьянника</w>.",
                                "en": "In this forest area, a lot of <w>cow-wheat</w> grows between the oak trees."
                            }
                        },
                        {
                            "text": "De zeldzame vlinder legt haar eitjes op de bladeren van de <w>hengel</w>.",
                            "target_lang_translations": {
                                "ru": "Редкая бабочка откладывает свои яйца на листья <w>марьянника</w>.",
                                "en": "The rare butterfly lays its eggs on the leaves of the <w>cow-wheat</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "травянистое растение семейства заразиховых (Марьянник луговой)",
                        "en": "A herbaceous plant of the Orobanchaceae family (Common Cow-wheat)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "марьянник",
                                "target_lang_sense_clarification": "ботаническое название растения"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "cow-wheat",
                                "target_lang_sense_clarification": "the common name for the plant Melampyrum pratense"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b0f79db9-86c9-3804-9b6c-e8fbd6fcefd4",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>hengelen</w>",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "vissen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>hengel</w> elke zondag in de lokale rivier.",
                            "target_lang_translations": {
                                "ru": "Я каждое воскресенье <w>рыбачу</w> на местной реке.",
                                "en": "I <w>fish</w> in the local river every Sunday."
                            }
                        },
                        {
                            "text": "Ik <w>hengel</w> naar informatie over het nieuwe project.",
                            "target_lang_translations": {
                                "ru": "Я <w>выуживаю</w> информацию о новом проекте.",
                                "en": "I am <w>fishing for</w> information about the new project."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "первое лицо единственного числа настоящего времени глагола 'рыбачить' или 'выуживать'",
                        "en": "First person singular present tense of 'to fish' or 'to fish for'."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рыбачу",
                                "target_lang_sense_clarification": "процесс ловли рыбы"
                            },
                            {
                                "target_lang_word": "выуживаю",
                                "target_lang_sense_clarification": "переносное значение: пытаться получить информацию"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "fish",
                                "target_lang_sense_clarification": "the act of catching fish"
                            },
                            {
                                "target_lang_word": "fish for",
                                "target_lang_sense_clarification": "figurative: to try to obtain information or compliments"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12eb3e1c-c15a-35f1-a5cd-0189cb83de15",
                    "sense_definition": "tweede persoon enkelvoud tegenwoordige tijd van <w>hengelen</w>",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "vissen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>hengel</w> je altijd naar complimenten?",
                            "target_lang_translations": {
                                "ru": "Почему ты всегда <w>выпрашиваешь</w> комплименты?",
                                "en": "Why are you always <w>fishing for</w> compliments?"
                            }
                        },
                        {
                            "text": "Als je daar <w>hengel</w> je vast een mooie vis uit het water.",
                            "target_lang_translations": {
                                "ru": "Если ты будешь <w>рыбачить</w> там, то наверняка вытащишь из воды хорошую рыбу.",
                                "en": "If you <w>fish</w> there, you will surely pull a nice fish out of the water."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "второе лицо единственного числа настоящего времени глагола 'рыбачить' или 'выуживать'",
                        "en": "Second person singular present tense of 'to fish' or 'to fish for'."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рыбачишь",
                                "target_lang_sense_clarification": "процесс ловли рыбы"
                            },
                            {
                                "target_lang_word": "выуживаешь",
                                "target_lang_sense_clarification": "переносное значение: пытаться получить что-то"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "fish",
                                "target_lang_sense_clarification": "the act of catching fish"
                            },
                            {
                                "target_lang_word": "fish for",
                                "target_lang_sense_clarification": "figurative: to try to obtain something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "037c3fb3-b574-321c-bf62-30cc1a0c6d04",
                    "sense_definition": "gebiedende wijs van <w>hengelen</w>",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "vissen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Hengel</w> die sleutels eens uit het putje met een magneet.",
                            "target_lang_translations": {
                                "ru": "<w>Выуди</w> ключи из сливного отверстия с помощью магнита.",
                                "en": "<w>Fish</w> those keys out of the drain with a magnet."
                            }
                        },
                        {
                            "text": "<w>Hengel</w> nu maar naar een betere baan.",
                            "target_lang_translations": {
                                "ru": "А теперь <w>попытайся найти</w> работу получше.",
                                "en": "Now go <w>fish for</w> a better job."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "повелительное наклонение глагола 'рыбачить' или 'выуживать'",
                        "en": "Imperative form of 'to fish' or 'to fish for'."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выуди",
                                "target_lang_sense_clarification": "достать что-то с помощью приспособления"
                            },
                            {
                                "target_lang_word": "рыбачь",
                                "target_lang_sense_clarification": "занимайся рыбной ловлей"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "fish",
                                "target_lang_sense_clarification": "the act of catching fish"
                            },
                            {
                                "target_lang_word": "fish out",
                                "target_lang_sense_clarification": "to retrieve something from a difficult spot"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}