                                        "entry_id": "7f53f3e0-912e-332c-a89f-9fde8698e900",
                                        "glosses": [
                                            "A worker for a political campaign who encourages voters to vote on Election Day."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20c41867-c10b-4246-8c44-2a49e4d81f57",
