                "senses": [
                    {
                        "sense_id": "ddb07221-2d4f-3659-870e-8bf525ce6343",
                        "entry_id": "e5f86a8b-af0a-353b-bff4-9d3f999a0b5f",
                        "glosses": [
                            "lange vernachlässigter und entsprechend chaotischer, ungepflegter Raum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8716ea3-a8af-4803-a27d-9b2917612f76",
                                "sense_id": "ddb07221-2d4f-3659-870e-8bf525ce6343",
                                "text": "„So ging das stundenlang, er säuberte die Welt, brachte den Augiasstall in Ordnung, bahnte den Weg für die Verbrüderung der Menschheit und das Reich der Gedankenfreiheit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "458f3b2f-6480-3466-9ade-84124f86e930",
                        "entry_id": "e5f86a8b-af0a-353b-bff4-9d3f999a0b5f",
                        "glosses": [
                            "Bereich, der von Korruption geprägt ist"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "ec11632a-311b-4061-8859-ec2745748f6f",
                                "sense_id": "458f3b2f-6480-3466-9ade-84124f86e930",
                                "text": "„Schünemann spricht daher von einer ‚Illusion, wenn man glaube, durch die Beschwörung einer,Wirtschaftsethik' könne man einen Augiasstall an Korruption ausmisten.‘“"
                            }
                        ],
