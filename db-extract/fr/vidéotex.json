        "fr-extract.jsonl": [
            {
                "entry_id": "ea3cfbd4-570a-3cc6-a364-2e04eb045110",
                "word": "vidéotex",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fa9578d0-ab1e-31d7-8969-3248b8ad5d83",
                        "entry_id": "ea3cfbd4-570a-3cc6-a364-2e04eb045110",
                        "glosses": [
                            "Système de diffusion d’informations accessible par un terminal et donnant accès à des bases de données via le réseau téléphonique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00aa232f-65af-49eb-8bba-50130ea6706c",
                                "sense_id": "fa9578d0-ab1e-31d7-8969-3248b8ad5d83",
                                "text": "On distingue le vidéotex diffusé, sans possibilité pour le récepteur de choisir l'information (système Antiope) du vidéotex interactif (système Télétel) qui permet la sélection de l'information par dialogue avec l'ordinateur central du système."
                            },
                            {
                                "example_id": "11d2666f-9f87-46ac-8d31-15b5115899ef",
                                "sense_id": "fa9578d0-ab1e-31d7-8969-3248b8ad5d83",
                                "text": "Le Minitel, ce terminal informatique, célèbre pour sa forme cubique et ses adresses commençant par quatre chiffres, qui a fait entrer la télématique et le vidéotex dans les foyers de millions de Français — et de 20 000 Québécois sous l’appellation Alextel —, ferme aujourd’hui définitivement son clavier amovible sur son écran, 30 ans après sa naissance."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9032015e-9c00-4398-891b-b9dd1e55a206",
                        "source_entry_id": "ea3cfbd4-570a-3cc6-a364-2e04eb045110",
                        "source_sense_id": "fa9578d0-ab1e-31d7-8969-3248b8ad5d83",
                        "target_lang_word": "Bildschirmtext",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "11c72097-4cdc-45b2-84ec-7dedef6e761e",
                        "source_entry_id": "ea3cfbd4-570a-3cc6-a364-2e04eb045110",
                        "source_sense_id": "fa9578d0-ab1e-31d7-8969-3248b8ad5d83",
                        "target_lang_word": "videotex",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "videotex",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5957d59b-d652-3f85-be8b-34d3555d9727",
                                        "entry_id": "b727ea95-a4aa-3ab3-9ef8-e7a1534c5ff0",
                                        "glosses": [
                                            "Any of various early information retrieval services, such as viewdata and Teletext systems, that delivered pages of computerized text to users on request."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78e205d4-74a7-4057-8c33-034ce37f802a",
                                                "sense_id": "5957d59b-d652-3f85-be8b-34d3555d9727",
                                                "text": "A variety of extensions of this basic videotex terminal can be foreseen."
                                            },
                                            {
                                                "example_id": "e889df93-1cfb-4669-ac89-885533ab28a6",
                                                "sense_id": "5957d59b-d652-3f85-be8b-34d3555d9727",
                                                "text": "In this paper, the development of a microprocessor based system for converting videotex pages to synthetic speech in real time, for the benefit of blind people, is described."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f46ab20-1f73-459a-b619-efa949b40ace",
                        "source_entry_id": "ea3cfbd4-570a-3cc6-a364-2e04eb045110",
                        "source_sense_id": "fa9578d0-ab1e-31d7-8969-3248b8ad5d83",
                        "target_lang_word": "videotext",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "videotext",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8b09cc2-ac70-3b58-8077-6675615fec9b",
                                        "entry_id": "4aa1bdf0-f188-3e7c-a34a-605c6c75b7f8",
                                        "glosses": [
                                            "Alternative form of videotex."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c265aed-9733-4a39-bef1-ff32184e52e8",
                                                "sense_id": "e8b09cc2-ac70-3b58-8077-6675615fec9b",
                                                "text": "Despite the industry's failures in launching videotext services (electronically disseminated news and information) for general consumers several years ago, such systems are definitely a major part of the future."
                                            }
                                        ]
                                    }
                                ]
