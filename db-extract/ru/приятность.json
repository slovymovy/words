                    },
                    {
                        "form_id": "0f2d935a-c043-40ae-a21f-57c6e771778a",
                        "entry_id": "08f33cf4-d401-348a-a376-b987f461d7c5",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "прия́тностях"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5a1b04f7-7e11-325b-8a3e-78c6e6030cb9",
                        "entry_id": "08f33cf4-d401-348a-a376-b987f461d7c5",
                        "glosses": [
                            "свойство по значению прилагательного приятный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e16b84b-237f-4987-b5af-d7b158d3c60e",
                                "sense_id": "5a1b04f7-7e11-325b-8a3e-78c6e6030cb9",
                                "text": "На взгляд он был человек видный; черты лица его были не лишены приятности, но в эту приятность, казалось, чересчур было передано сахару; в приёмах и оборотах его было что-то заискивающее расположения и знакомства."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd261655-7420-3c82-805c-a6edcfc45d92",
                        "entry_id": "08f33cf4-d401-348a-a376-b987f461d7c5",
                        "glosses": [
                            "удовольствие, то, что кажется приятным"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "492e3dd5-d715-4482-bce9-292898db0949",
                                "sense_id": "fd261655-7420-3c82-805c-a6edcfc45d92",
                                "text": "Ну, нынче гулять не составляет никакой приятности; климат весьма нехороший."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8abe00d1-b092-45d1-afc6-f3f8fc3d4f47",
                        "source_entry_id": "08f33cf4-d401-348a-a376-b987f461d7c5",
                        "target_lang_word": "pleasantness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pleasantness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d85f9ab6-af8e-3826-95e9-6bcf20ee6768",
                                        "entry_id": "f50be026-b8af-3f85-995b-e45d2e1e1512",
                                        "glosses": [
                                            "The state or quality of being pleasant."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8439ef71-120d-47fc-b369-c42cca97975f",
                                                "sense_id": "d85f9ab6-af8e-3826-95e9-6bcf20ee6768",
                                                "text": "If this is sound, the pleasantness of pleasure can no longer be our guide; the higherness of the higher pleasure must have the decisive word — hedonism has committed suicide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e45a7efa-3693-3e1e-9dd7-999567c86081",
                                        "entry_id": "f50be026-b8af-3f85-995b-e45d2e1e1512",
                                        "glosses": [
                                            "Something pleasant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2aa9d20-32ed-411e-9d57-4ce0e815053e",
                                                "sense_id": "e45a7efa-3693-3e1e-9dd7-999567c86081",
                                                "text": "[…] to destroy the affections of truth, and thereby the pleasantnesses and happinesses of heaven […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d494534c-6a1f-4570-ba2a-98a10dfe6e08",
                        "source_entry_id": "08f33cf4-d401-348a-a376-b987f461d7c5",
                        "target_lang_word": "amenity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amenity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5740e8e-f0c4-34d2-8cc8-09f759e09405",
                                        "entry_id": "1b5f46af-e088-3c79-b551-d2aa3eb7423f",
                                        "glosses": [
                                            "Pleasantness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47aece5c-22b6-4170-9c8f-3f0fa3b55c52",
                                                "sense_id": "b5740e8e-f0c4-34d2-8cc8-09f759e09405",
                                                "text": "We especially enjoyed the amenity of the climate on our last holiday."
                                            },
                                            {
                                                "example_id": "f9300790-4e8c-4acc-9599-9d0a78118a6c",
                                                "sense_id": "b5740e8e-f0c4-34d2-8cc8-09f759e09405",
                                                "text": "The harbor of Port Royal, rendered gloomy by recollections of misery, was avoided; and after searching the coast and discovering places, which were so full of amenity, that melancholy itself could not but change its humor, as it gazed, the followers of Calvin planted themselves on the banks of the river May."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4932dd3c-8d8d-3eb5-b275-20e3d871bc60",
                                        "entry_id": "1b5f46af-e088-3c79-b551-d2aa3eb7423f",
                                        "glosses": [
                                            "A thing or circumstance that is welcome and makes life a little easier or more pleasant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee18b330-fdfa-4910-b659-6d6bfd68f952",
                                                "sense_id": "4932dd3c-8d8d-3eb5-b275-20e3d871bc60",
                                                "text": "All the little amenities the hotel provided made our stay very enjoyable."
                                            },
                                            {
                                                "example_id": "9688dcbf-3dd3-4835-b067-20f69004be59",
                                                "sense_id": "4932dd3c-8d8d-3eb5-b275-20e3d871bc60",
                                                "text": "The Castle is an antique extent of ground, which now they call Marsfield, and would have ben a fitting area to have plac’d the Ducal palace in. The suburbs are large, the prospects sweete, with other amenities, not omitting the flower gardens, in which all the inhabitants excel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5673270c-2c7e-3be5-99f4-8aa18c676468",
                                        "entry_id": "1b5f46af-e088-3c79-b551-d2aa3eb7423f",
                                        "glosses": [
                                            "Convenience."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4fb4e873-ff55-343c-a517-c3cb5df9246e",
                                        "entry_id": "1b5f46af-e088-3c79-b551-d2aa3eb7423f",
                                        "glosses": [
                                            "A unit pertaining to the infrastructure of a community, such as a public toilet, a postbox, a library, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7b796b4-25c1-46fc-ae1a-76cd1c67474e",
                                                "sense_id": "4fb4e873-ff55-343c-a517-c3cb5df9246e",
                                                "text": "Suburbia was the prescribed antidote to the dreariness of the hypertrophied industrial city—and most American cities had never been anything but that. They were short on amenity, overcrowded, and artless. Americans were sick of them and saw no way to improve them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
