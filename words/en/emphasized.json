{
    "word_family": [
        "emphasis",
        "emphatic",
        "emphatically",
        "emphasizer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f830b38f-94b9-32e2-9766-6a20267f9198",
                    "sense_definition": "Simple past and past participle of <w>emphasize</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher <w>emphasized</w> the importance of doing homework every day.",
                            "target_lang_translations": {
                                "ru": "Учитель <w>подчеркнул</w> важность ежедневного выполнения домашнего задания.",
                                "nl": "De docent <w>benadrukte</w> het belang van het dagelijks maken van huiswerk."
                            }
                        },
                        {
                            "text": "She <w>emphasized</w> the fact that we need to work together to succeed.",
                            "target_lang_translations": {
                                "ru": "Она <w>сделала упор</w> на том факте, что нам нужно работать вместе, чтобы добиться успеха.",
                                "nl": "Zij <w>onderstreepte</w> het feit dat we moeten samenwerken om te slagen."
                            }
                        }
                    ],
                    "synonyms": [
                        "stressed",
                        "highlighted",
                        "underlined",
                        "pointed out"
                    ],
                    "antonyms": [
                        "downplayed",
                        "understated",
                        "ignored"
                    ],
                    "common_phrases": [
                        "emphasized the importance",
                        "emphasized the need",
                        "emphasized the fact"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола emphasize (подчеркивать, придавать значение).",
                        "nl": "De verleden tijd en voltooid deelwoord van het werkwoord 'benadrukken' of 'onderstrepen'."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подчеркнул",
                                "target_lang_sense_clarification": "выделил как важное (прошедшее время)"
                            },
                            {
                                "target_lang_word": "акцентировал",
                                "target_lang_sense_clarification": "сделал ударение на чем-либо"
                            },
                            {
                                "target_lang_word": "сделал упор",
                                "target_lang_sense_clarification": "обратил особое внимание"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "benadrukte",
                                "target_lang_sense_clarification": "het leggen van nadruk op iets (verleden tijd)"
                            },
                            {
                                "target_lang_word": "onderstreepte",
                                "target_lang_sense_clarification": "het extra aandacht geven aan een punt"
                            },
                            {
                                "target_lang_word": "legde de nadruk op",
                                "target_lang_sense_clarification": "het expliciet maken van een belangrijk punt"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "022da439-6dc7-3a5f-b55c-689740a4b3f6",
                    "sense_definition": "Having been given extra stress or focus.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this particular style of music, the rhythm is heavily <w>emphasized</w>.",
                            "target_lang_translations": {
                                "ru": "В этом конкретном музыкальном стиле ритм сильно <w>акцентирован</w>.",
                                "nl": "In deze specifieke muziekstijl wordt het ritme sterk <w>geaccentueerd</w>."
                            }
                        },
                        {
                            "text": "The <w>emphasized</w> words in the text show the author's main argument.",
                            "target_lang_translations": {
                                "ru": "<w>Выделенные</w> слова в тексте указывают на основной аргумент автора.",
                                "nl": "De <w>benadrukte</w> woorden in de tekst tonen het hoofdargument van de auteur."
                            }
                        }
                    ],
                    "synonyms": [
                        "stressed",
                        "accentuated",
                        "highlighted"
                    ],
                    "antonyms": [
                        "understated"
                    ],
                    "common_phrases": [
                        "heavily emphasized",
                        "strongly emphasized",
                        "more emphasized"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, чему придано особое значение, внимание или ударение; выделенный.",
                        "nl": "Iets dat extra aandacht, nadruk of focus heeft gekregen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "акцентированный",
                                "target_lang_sense_clarification": "имеющий ударение или выделение"
                            },
                            {
                                "target_lang_word": "выделенный",
                                "target_lang_sense_clarification": "отмеченный особым образом"
                            },
                            {
                                "target_lang_word": "подчеркнутый",
                                "target_lang_sense_clarification": "явно выраженный"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "benadrukt",
                                "target_lang_sense_clarification": "iets dat extra aandacht heeft gekregen"
                            },
                            {
                                "target_lang_word": "geaccentueerd",
                                "target_lang_sense_clarification": "iets dat sterker naar voren is gebracht"
                            },
                            {
                                "target_lang_word": "onderstreept",
                                "target_lang_sense_clarification": "iets dat expliciet is gemarkeerd"
                            }
                        ]
                    }
                }
            ]
        }
    ]
