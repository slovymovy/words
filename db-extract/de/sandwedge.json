                "senses": [
                    {
                        "sense_id": "daf66987-aeda-322f-9b63-ad20b1b2ae8b",
                        "entry_id": "06887a4f-1716-345c-8c29-96ed3af083e9",
                        "glosses": [
                            "Schläger, der zum Spiel aus dem Sandbunker geeignet ist"
                        ],
                        "tags": [
                            "Golfsport"
                        ],
                        "examples": [
                            {
                                "example_id": "1b5414df-b4db-49c2-9b64-01b6cf883635",
                                "sense_id": "daf66987-aeda-322f-9b63-ad20b1b2ae8b",
                                "text": "Wenn der Ball im Bunker liegt, kommt der Sandwedge zum Einsatz."
                            },
                            {
                                "example_id": "1698c0ca-602e-436b-8f33-230f0c235103",
                                "sense_id": "daf66987-aeda-322f-9b63-ad20b1b2ae8b",
                                "text": "„Spielt man aus schwererem oder härteren Sand, sollte der Sandwedge weniger Bounce haben, damit er leichter in den Sand eindringen kann.“"
                            },
                            {
                                "example_id": "d48b33a8-6137-4e97-a9c8-66cbb689fff1",
                                "sense_id": "daf66987-aeda-322f-9b63-ad20b1b2ae8b",
                                "text": "„Hier sei zunächst gesagt, dass man aus dem Bunker nahe zu jeden Schläger benutzen kann. Doch am besten geeignet und auch eigentlich dafür vorgesehen ist das Sandwedge.“"
                            },
                            {
                                "example_id": "7d0ed2e3-a2c2-4f06-8211-24594d2ec0d6",
                                "sense_id": "daf66987-aeda-322f-9b63-ad20b1b2ae8b",
                                "text": "„Mit in der Regel ca. 56° Loft nutzt man das Sandwedge für Bunkerschläger und Pitches vom Fairway.“"
                            },
                            {
                                "example_id": "f8e63962-2320-48ab-b989-d0f22c2e5267",
                                "sense_id": "daf66987-aeda-322f-9b63-ad20b1b2ae8b",
                                "text": "„Für einen steil ansteigenden Ballflug zum Loch und sofortigem Stillstand des Balls nach der Landung muss das Sandwedge aggressiv in den Sand geschlagen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
