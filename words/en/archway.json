{
    "word_family": [
        "arch"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "789caf51-93d7-3e82-9f1f-388106c34306",
                    "sense_definition": "A passageway covered by an arch, particularly one made of masonry.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "architectural_feature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They walked through the stone <w>archway</w> to enter the old castle courtyard.",
                            "target_lang_translations": {
                                "zh": "他们穿过石砌的<w>拱门</w>进入了古老的城堡庭院。"
                            }
                        },
                        {
                            "text": "The covered <w>archway</w> provided shelter from the heavy rain.",
                            "target_lang_translations": {
                                "zh": "带顶的<w>拱廊</w>为他们遮挡了大雨。"
                            }
                        }
                    ],
                    "synonyms": [
                        "arcade",
                        "vault"
                    ],
                    "common_phrases": [
                        "covered archway",
                        "stone archway"
                    ],
                    "target_lang_definitions": {
                        "zh": "由拱形结构覆盖的通道，通常由砖石砌成。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "拱门",
                                "target_lang_sense_clarification": "指拱形的门或通道。"
                            },
                            {
                                "target_lang_word": "拱廊",
                                "target_lang_sense_clarification": "指由一系列拱门组成的通道。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3571ce18-359f-3f71-8637-7e7a39ab1682",
                    "sense_definition": "A doorway with a semilunar-shaped top.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "architectural_feature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The elegant <w>archway</w> led directly into the grand dining hall.",
                            "target_lang_translations": {
                                "zh": "那扇优雅的<w>拱形门</w>直通宏伟的餐厅。"
                            }
                        },
                        {
                            "text": "She stood under the ornate <w>archway</w> waiting for her guests to arrive.",
                            "target_lang_translations": {
                                "zh": "她站在装饰华丽的<w>拱形门</w>下等待客人的到来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "doorway",
                        "portal"
                    ],
                    "common_phrases": [
                        "ornate archway",
                        "grand archway"
                    ],
                    "target_lang_definitions": {
                        "zh": "顶部呈半圆形的门洞。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "拱形门",
                                "target_lang_sense_clarification": "特指顶部为拱形的门。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7f320f23-ea62-3254-b92b-72504bbca035",
                    "sense_definition": "A neighbourhood of Upper Holloway, borough of Islington, Greater London, England.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "location",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They decided to meet near the <w>Archway</w> underground station.",
                            "target_lang_translations": {
                                "zh": "他们决定在<w>阿奇威</w>地铁站附近见面。"
                            }
                        },
                        {
                            "text": "Many commuters pass through <w>Archway</w> on their way to central London.",
                            "target_lang_translations": {
                                "zh": "许多通勤者在前往伦敦市中心的途中会经过<w>阿奇威</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Refers to a specific location in London."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "位于英国伦敦伊斯灵顿区的一个地名。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "阿奇威",
                                "target_lang_sense_clarification": "伦敦地名 Archway 的音译。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}