            {
                "entry_id": "cfb43b36-a06a-3729-a06f-347801bd20fd",
                "word": "spouting",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "72ef7b83-c8bb-4517-b4e5-2837025e69b3",
                        "entry_id": "cfb43b36-a06a-3729-a06f-347801bd20fd",
                        "tags": [
                            "plural"
                        ],
                        "form": "spoutings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "42094026-6b06-3c93-b4bb-d088f7e74853",
                        "entry_id": "cfb43b36-a06a-3729-a06f-347801bd20fd",
                        "glosses": [
                            "The process or result of something being spouted; that which is spouted."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e555918-cacc-4fef-bbab-3f3c511e990e",
                                "sense_id": "42094026-6b06-3c93-b4bb-d088f7e74853",
                                "text": "Spoutings of lava shot from the crest of the volcano."
                            },
                            {
                                "example_id": "7c443cd7-6d6c-4bb1-8862-c76c31175e6d",
                                "sense_id": "42094026-6b06-3c93-b4bb-d088f7e74853",
                                "text": "The spoutings of a large whale can be seen from a great distance."
                            },
                            {
                                "example_id": "70156ee5-a814-46e8-99c3-6032eb0cb4ae",
                                "sense_id": "42094026-6b06-3c93-b4bb-d088f7e74853",
                                "text": "After these spoutings, the great Geyser remained quiet the whole night ; the water in the meanwhile rose gradually, and the bason was filled about four in the morning."
                            },
                            {
                                "example_id": "3e9579ad-7240-4da5-be06-b0342d2aa7e2",
                                "sense_id": "42094026-6b06-3c93-b4bb-d088f7e74853",
                                "text": "The average interval between its spoutings is 78 minutes."
                            },
                            {
                                "example_id": "9005c950-7bbc-4f67-8bf0-0583d90f995c",
                                "sense_id": "42094026-6b06-3c93-b4bb-d088f7e74853",
                                "text": "Saint-Loup, for another thing, is by way of being a family black sheep: seemingly uninterested in social success, a devoted student of Nietzsche and Proudhon, we are told that his head was full of “socialistic spoutings,” and that he was “imbued with the most prgound contempt for his caste.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "c5abafa0-2536-3ce4-964a-eeddf32673c0",
                        "entry_id": "cfb43b36-a06a-3729-a06f-347801bd20fd",
                        "glosses": [
                            "A gutter under the eaves of a building; guttering."
                        ],
                        "tags": [
                            "Australia",
                            "New-Zealand"
                        ],
                        "examples": [
                            {
                                "example_id": "ca747344-b64a-45b7-8e17-7e377ba2b33b",
                                "sense_id": "c5abafa0-2536-3ce4-964a-eeddf32673c0",
                                "text": "The spouting was filled with leaves and needed cleaning."
                            },
                            {
                                "example_id": "b462ff95-e391-49c0-aebf-6663e1273e12",
                                "sense_id": "c5abafa0-2536-3ce4-964a-eeddf32673c0",
                                "text": "These items will include:\ngalvanised-steel spoutings and downpipes — if used[…]."
                            },
                            {
                                "example_id": "494a223e-edda-421a-8e95-8bf05017d053",
                                "sense_id": "c5abafa0-2536-3ce4-964a-eeddf32673c0",
                                "text": "The old house, neglected for so many years, needed painting and repairs: the roof leaked and the spoutings had rusted."
                            },
                            {
                                "example_id": "983381b7-2763-44cb-a12b-f3c0be703dd5",
                                "sense_id": "c5abafa0-2536-3ce4-964a-eeddf32673c0",
                                "text": "Water trickles away from gutterings and down spoutings into the big water tank at the back of the house."
                            }
                        ]
                    }
                ],
