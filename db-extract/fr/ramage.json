        "fr-extract.jsonl": [
            {
                "entry_id": "9a7448ae-2045-33c5-9158-a5171b806553",
                "word": "ramage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2a5460fc-4260-4543-b3e6-da98255b7e9a",
                        "entry_id": "9a7448ae-2045-33c5-9158-a5171b806553",
                        "tags": [
                            "plural"
                        ],
                        "form": "ramages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fb7d602a-d103-375f-9606-5b196e59973f",
                        "entry_id": "9a7448ae-2045-33c5-9158-a5171b806553",
                        "glosses": [
                            "Rameaux, branchages."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "31f97af3-1078-4a20-9bbc-2c05a1442658",
                                "sense_id": "fb7d602a-d103-375f-9606-5b196e59973f",
                                "text": "Les prairies avaient des airs de parc anglais. Des arbres les encadraient et, pour peu qu’on s’élevât, tous ces ramages dominés formaient une grande forêt, un vêtement de verdure aux verts innombrables qui couvrait la terre à l’infini."
                            }
                        ]
                    },
                    {
                        "sense_id": "94250d47-3796-3b85-8bac-83e2ffe7ef23",
                        "entry_id": "9a7448ae-2045-33c5-9158-a5171b806553",
                        "glosses": [
                            "Motif de rameaux, de branchages, de feuillages, de fleurs sur une étoffe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d767624a-b041-4241-a565-ec2fc381db09",
                                "sense_id": "94250d47-3796-3b85-8bac-83e2ffe7ef23",
                                "text": "La grande affaire, c’est qu’il soit matériellement impossible de suspendre une perle de plus aux oreilles de marbre de l’idole, d’enchâsser un plus gros diamant dans l’or de sa couronne, et de tracer un autre ramage de pierreries sur le brocart de sa robe."
                            },
                            {
                                "example_id": "a0dff242-e3cd-4d2e-ae8c-3b2a22e2ca91",
                                "sense_id": "94250d47-3796-3b85-8bac-83e2ffe7ef23",
                                "text": "Les deux Pompes semblaient s’être taillé des accoutrements étranges au milieu de vieux rideaux de fenêtre, ces vieux rideaux à ramages datant de la Restauration."
                            },
                            {
                                "example_id": "a7df3af0-59b1-44b7-b793-8fcffa4e6d7c",
                                "sense_id": "94250d47-3796-3b85-8bac-83e2ffe7ef23",
                                "text": "Le palier est long et étroit, le mur est tendu d’une imitation de tapisserie à ramages vert sombre où brille le cuivre d’une applique à gaz."
                            },
                            {
                                "example_id": "3c940e6b-a7f4-4557-a722-cd210e082eec",
                                "sense_id": "94250d47-3796-3b85-8bac-83e2ffe7ef23",
                                "text": "Elles sont veuves, sûrement. Elles ont souvent les cheveux presque mauves, trop frisés, des tailleurs à ramages beiges ou bien lilas, des poignets à gourmette, mais pas de gourmette."
                            }
                        ]
                    },
                    {
                        "sense_id": "97770947-b466-3743-9025-a2ed24b7e21e",
                        "entry_id": "9a7448ae-2045-33c5-9158-a5171b806553",
                        "glosses": [
                            "Chant des petits oiseaux qui se tiennent dans les rameaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a299cf4c-ffc9-4591-a79b-beb7b971b6cf",
                                "sense_id": "97770947-b466-3743-9025-a2ed24b7e21e",
                                "text": "Que vous êtes joli ! que vous me semblez beau ! Sans mentir, si votre ramage se rapporte à votre plumage, vous êtes le Phénix des hôtes de ces bois."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e2151b8-d20b-325c-be48-b32511586c21",
                        "entry_id": "9a7448ae-2045-33c5-9158-a5171b806553",
                        "glosses": [
                            "Discours dénué de sens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e1194e8-292d-4608-b1fd-71d5405a6c7d",
                                "sense_id": "5e2151b8-d20b-325c-be48-b32511586c21",
                                "text": "Et pour vous soulager un peu de ce ramage barbare des grammairiens ; souffrez que je m’arrête un moment sur le merveilleux de cette importante machine qu’on appelle une langue."
                            }
                        ]
                    },
                    {
                        "sense_id": "e4728968-3d3f-3832-94e1-b11c83e5c000",
                        "entry_id": "9a7448ae-2045-33c5-9158-a5171b806553",
                        "glosses": [
                            "Babil des enfants."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "daf4d4bc-1c67-4aca-8167-8f999d580aab",
                                "sense_id": "e4728968-3d3f-3832-94e1-b11c83e5c000",
                                "text": "Les enfants font du ramage."
                            }
                        ]
                    },
                    {
                        "sense_id": "a8c56805-258d-3ab1-b7f0-b4446a5acd98",
                        "entry_id": "9a7448ae-2045-33c5-9158-a5171b806553",
                        "glosses": [
                            "Droit de faire du bois dans les forêts privées et publiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b50a5ad6-f207-4221-a67f-3e144faae795",
                                "sense_id": "a8c56805-258d-3ab1-b7f0-b4446a5acd98",
                                "text": "Je fais du ramage dans les forêts privées et publiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "09ae1a57-5158-3d79-9617-fcf664edb22e",
                        "entry_id": "9a7448ae-2045-33c5-9158-a5171b806553",
                        "glosses": [
                            "Groupe de parenté d’agrégation mélangeant l’organisation lignagère de telle sorte qu’il en résulte un système non unilinéaire."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "90d8d02a-f842-3b75-a0cd-0e008e4e2061",
                        "entry_id": "9a7448ae-2045-33c5-9158-a5171b806553",
                        "glosses": [
                            "Dans l'industrie textile, action qui consistait à tendre les draps sur des rames."
                        ],
