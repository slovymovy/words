                "senses": [
                    {
                        "sense_id": "0ba7edbe-d660-3778-bb1e-3fe297d72fca",
                        "entry_id": "9aba8fcb-686f-3d20-9479-a306adacf595",
                        "glosses": [
                            "Qui appartient au matin."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "7f7ce90e-bd02-4b6a-9230-a44a5b7d4884",
                                "sense_id": "0ba7edbe-d660-3778-bb1e-3fe297d72fca",
                                "text": "L’air était frais ; le vent matinier souillait dans les branches encore dépouillées des arbres de haute venue et d’essence forestière, tandis qu’il agitait le long des haies les guirlandes de ronces, déjà feuillues, et qu’il secouait en neige sous les pommiers arrondis, les corolles fanées, espérance du pressoir."
                            },
                            {
                                "example_id": "3d2e4bd2-62cc-4032-b66f-a9392b72686b",
                                "sense_id": "0ba7edbe-d660-3778-bb1e-3fe297d72fca",
                                "text": "Éveille-toi; La rose\nOuvre aux vents matiniers\nSes plis légers."
                            },
                            {
                                "example_id": "7ef88ec4-74df-4730-b1d4-2b285d9c3480",
                                "sense_id": "0ba7edbe-d660-3778-bb1e-3fe297d72fca",
                                "text": "L’étoile matinière, la planète Vénus, que l’on appelle aussi l’étoile du matin."
                            }
                        ]
                    },
                    {
                        "sense_id": "a89cdf2c-ce89-30e0-8db8-612abace02f4",
                        "entry_id": "9aba8fcb-686f-3d20-9479-a306adacf595",
                        "glosses": [
                            "Se dit d’une personne qui se lève tôt."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "60acda29-20bd-49f7-ac22-e223f292090e",
                                "sense_id": "a89cdf2c-ce89-30e0-8db8-612abace02f4",
                                "text": "Maintenant, elle si active, si matinière, se levait tard, ne paraissait guère que pour le second déjeuner."
                            }
                        ]
                    }
