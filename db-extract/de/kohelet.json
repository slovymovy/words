                "senses": [
                    {
                        "sense_id": "af1933a1-84b4-37ed-9ef5-2cc82317310b",
                        "entry_id": "5881ac8f-3859-318e-a472-102c0b6caef9",
                        "glosses": [
                            "eine alttestamentliche Schrift der Bibel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ff89fbf-aeb0-4f0f-976d-fd1dadf4e8b3",
                                "sense_id": "af1933a1-84b4-37ed-9ef5-2cc82317310b",
                                "text": "„Das Buch Kohelet wurde wie das der Sprüche dem König Salomo zugeschrieben, obgleich es außer dem ,Sohn Davids‘ als Verfasserangabe in 1,1 und verschiedenen Andeutungen (vgl. 1,12+16) keinen Hinweis auf eine solche Autorschaft gibt.“"
                            },
                            {
                                "example_id": "3698db19-6f4e-4b05-8374-3c24ea53f0f6",
                                "sense_id": "af1933a1-84b4-37ed-9ef5-2cc82317310b",
                                "text": "¹Worte Kohelets, des Davidsohnes, der König in Jerusalem war. ² Windhauch, Windhauch, sagte Kohelet, Windhauch, Windhauch, das ist alles Windhauch. (Kohelet 1,1-2)"
                            },
                            {
                                "example_id": "37514f67-feb7-464e-bab4-caeeff867011",
                                "sense_id": "af1933a1-84b4-37ed-9ef5-2cc82317310b",
                                "text": "Die Schlüsselfrage für den Zusammenhang von inhaltlichern und struktureller Analyse ist: Welcher „Kohelet“ wird interpretiert? Kohelet als Buchganzes in der uns vorliegenden Endgestalt (Fox und Krüger)?"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
