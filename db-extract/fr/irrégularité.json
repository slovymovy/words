                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db2f7eda-ba9b-4838-9317-c78c391aa209",
                                                "sense_id": "a20214f2-adc7-38a3-b752-80cc4cf1aa60",
                                                "text": "„Meine Beobachtungen in natürlicher Umgebung, das heißt außerhalb von Testsituationen, bestätigen die Vermutung, daß Kinder vor fünf vor allem auf semantische Unregelmäßigkeiten reagieren, die sich in der Wortwahl zeigen.“"
                                            }
                                        ],
