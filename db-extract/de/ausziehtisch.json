                "senses": [
                    {
                        "sense_id": "fe844e55-8e93-31d5-a3ff-9ccf48229515",
                        "entry_id": "4ccbba00-96a6-3ea1-9572-479b8e60b978",
                        "glosses": [
                            "Tisch, bei dem bei Bedarf die nutzbare Fläche - meist an zwei gegenüberliegenden Seiten - durch zusätzliche, (her)ausziehbare Flächen (Platten) vergrößert werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d856a003-b0ed-4c65-923d-093eabafda1a",
                                "sense_id": "fe844e55-8e93-31d5-a3ff-9ccf48229515",
                                "text": "„Wenn Heinz kam, machte sich Herr Kuppisch immer am Ausziehtisch zu schaffen. Er kam nie mit diesem Ding zurecht.“"
                            },
                            {
                                "example_id": "b0b5f1f4-0e2a-4846-9b17-2eb64296be0c",
                                "sense_id": "fe844e55-8e93-31d5-a3ff-9ccf48229515",
                                "text": "„Dann waren noch vier Teller mit Kuchen und Früchten auf dem Ausziehtische.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
