                        ],
                        "examples": [
                            {
                                "example_id": "8a32670c-d606-4f7c-b59b-ff2e7f80394b",
                                "sense_id": "4abc2b81-8335-3258-b029-1e86d5cb002d",
                                "text": "She allows users to repin her pictures on their Pinterests for their own admiration. Recently, I’ve been following her Pinterest and found that white pencil jeans, platform dress sandals and hi-low chiffon maxi skirts are popping into spring collections and fashionistas’ closets."
                            },
                            {
                                "example_id": "f60dcc5d-dd9a-43ec-87c1-39919ce5e910",
                                "sense_id": "4abc2b81-8335-3258-b029-1e86d5cb002d",
                                "text": "She scanned the rest of the ideas she’d amalgamated on her Pinterest: handmade candles, homemade jams, woven baskets, pot pourri with a signature scent."
                            },
                            {
                                "example_id": "26189e8f-e283-4558-90be-a7fd42169da1",
                                "sense_id": "4abc2b81-8335-3258-b029-1e86d5cb002d",
                                "text": "She had a Facebook, an Instagram, a Twitter, a blog, a LinkedIn, a Pinterest, and a Goodreads account. […] On her Pinterest, she had amassed hundreds of pictures of wedding dresses on a board called “Someday Soon:D.”"
                            }
                        ]
                    }
