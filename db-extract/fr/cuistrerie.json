        "fr-extract.jsonl": [
            {
                "entry_id": "15d75f39-1dc9-3ca7-b3e9-00ec362d4760",
                "word": "cuistrerie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5f05c2d8-e2e7-4c7c-8a31-fca8aab36e34",
                        "entry_id": "15d75f39-1dc9-3ca7-b3e9-00ec362d4760",
                        "tags": [
                            "plural"
                        ],
                        "form": "cuistreries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9c615699-e919-3dda-8ecb-f5fe9b1a57f5",
                        "entry_id": "15d75f39-1dc9-3ca7-b3e9-00ec362d4760",
                        "glosses": [
                            "Propos, manières, théorie de cuistre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f95b6e5b-0fc2-41fa-8404-ec4386afdec6",
                                "sense_id": "9c615699-e919-3dda-8ecb-f5fe9b1a57f5",
                                "text": "Je garde le contact avec eux : ils m'aèrent et m'empêchent de m'enliser dans la cuistrerie."
                            },
                            {
                                "example_id": "15aead05-2995-40f6-b968-2261a1b47e0c",
                                "sense_id": "9c615699-e919-3dda-8ecb-f5fe9b1a57f5",
                                "text": "Sans culot ni jargon, la cuistrerie ne trouve pas de gogos."
                            },
                            {
                                "example_id": "f15710e1-befc-4c02-bbe1-20b0f3012073",
                                "sense_id": "9c615699-e919-3dda-8ecb-f5fe9b1a57f5",
                                "text": "Cuistrerie et bourrage de crâne, sans prise en compte de la réalité."
                            },
                            {
                                "example_id": "9a9fed3a-db2c-4b73-ade7-0c1499635d3e",
                                "sense_id": "9c615699-e919-3dda-8ecb-f5fe9b1a57f5",
                                "text": "Des « entreprises de cuistrerie » , qui mènent direct à Pôle Emploi."
                            },
                            {
                                "example_id": "b8ef31b3-7b4e-445a-b95e-079bf55505a9",
                                "sense_id": "9c615699-e919-3dda-8ecb-f5fe9b1a57f5",
                                "text": "Ils sont aussi ignorants l'un que l'autre. (…) Ils se regardent de la tête aux pieds, ils préludent par de légères escarmouches; bientôt la guerre se déclare; les cuistreries de toute espèce se croisent et s'échangent, et, pour comble de malheur, entre les deux ivrognes s'agite dame Pluche, qui les repousse l'un et l'autre de ses coudes affilés."
                            },
                            {
                                "example_id": "9377ab8d-52ea-4e44-adf1-b5064d59abb1",
                                "sense_id": "9c615699-e919-3dda-8ecb-f5fe9b1a57f5",
                                "text": "Nous considérons aujourd’hui comme une parfaite cuistrerie l’ancienne prétention qu’eurent nos pères de créer une science de l’art ou encore de décrire l’œuvre d’art […]."
                            }
                        ]
                    }
                ],
