                ],
                "senses": [
                    {
                        "sense_id": "fd69623f-31ce-3b7f-9ea3-eda29643d06d",
                        "entry_id": "eb6cbca3-90d8-35b8-9e90-20fe1b077b50",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5caeceb1-9219-4c3b-933f-b8bfe9e8ac35",
                                "sense_id": "fd69623f-31ce-3b7f-9ea3-eda29643d06d",
                                "text": "Frau Stierle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "83424558-0fc5-496e-a0f5-74bb455b389b",
                                "sense_id": "fd69623f-31ce-3b7f-9ea3-eda29643d06d",
                                "text": "Herr Stierle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d104b6c6-f9de-404f-a7de-c82db3283dbc",
                                "sense_id": "fd69623f-31ce-3b7f-9ea3-eda29643d06d",
                                "text": "Die Stierles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "6dd9d6d3-b924-4277-85b7-be5826bb96ab",
                                "sense_id": "fd69623f-31ce-3b7f-9ea3-eda29643d06d",
                                "text": "Der Stierle trägt nie die Pullover, die die Stierle ihm strickt."
                            },
                            {
                                "example_id": "4a84cdb2-952b-493f-9273-f54ad2d341d9",
                                "sense_id": "fd69623f-31ce-3b7f-9ea3-eda29643d06d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Stierle kommt, geht der Herr Stierle.“"
                            },
                            {
                                "example_id": "879e6675-3b30-42be-90e4-cf97aba845d8",
                                "sense_id": "fd69623f-31ce-3b7f-9ea3-eda29643d06d",
                                "text": "Stierle kommt und geht."
                            },
                            {
                                "example_id": "6f6bb0c3-fe9f-4c63-91d1-dc50b46b41a3",
                                "sense_id": "fd69623f-31ce-3b7f-9ea3-eda29643d06d",
                                "text": "Stierles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
