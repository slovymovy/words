                                    {
                                        "sense_id": "35edd0c2-2979-3686-ab9a-0671e0b965d9",
                                        "entry_id": "ad914082-524b-35eb-bdd7-89e9694e0e75",
                                        "glosses": [
                                            "A pie or tart made with a filling of cooked apples."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "732bb175-56a4-34c2-8bc8-0aa9d19409af",
                                        "entry_id": "ad914082-524b-35eb-bdd7-89e9694e0e75",
                                        "glosses": [
                                            "Anything positive that is quintessentially American."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afc5dd2c-2504-409c-942c-e427cf40ef2d",
                                                "sense_id": "732bb175-56a4-34c2-8bc8-0aa9d19409af",
                                                "text": "[…] what we've been waiting for so long: a positive but never Pollyanish play about gays leading lives which are neither some bizarre caricature taken from heterosexual fantasy nor even more nuclear and apple-pie normal than any straight lives anyone has ever heard of."
                                            },
                                            {
                                                "example_id": "ad354354-34e0-447b-a77e-fb0648941b36",
                                                "sense_id": "732bb175-56a4-34c2-8bc8-0aa9d19409af",
                                                "text": "Hanks has often been called our generation's answer to James Stewart, and the similarities are certainly there. With his shared \"gee shucks\" sweetness and apple pie Americanness, Stewart also appeared in many war films and family dramas."
                                            },
                                            {
                                                "example_id": "a5807281-71a5-46da-b0ae-50c7ea594c6e",
                                                "sense_id": "732bb175-56a4-34c2-8bc8-0aa9d19409af",
                                                "text": "She was a refugee, not to America but from within America: a Mom and apple pie America, an America of the past that was being rapidly transformed by material inventions, and by the freeways, malls, and drive-in banks cited in the song Big Science as landmarks on the road to town."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f02ac491-5c75-3411-8c9c-03a99988a0af",
                                        "entry_id": "ad914082-524b-35eb-bdd7-89e9694e0e75",
                                        "glosses": [
                                            "Any of various willowherbs."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "dialectal",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
