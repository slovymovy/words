                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e806187-f3da-409b-98b3-d4b146ad3a75",
                                                "sense_id": "d51680bb-1c98-3f8d-985a-dd320512c63b",
                                                "text": "Well I'm near the end and I just ain't got the time / And I'm wasted and I can't find my way home"
                                            },
                                            {
                                                "example_id": "540899e5-9d8c-4f81-9439-f63a60f17065",
                                                "sense_id": "d51680bb-1c98-3f8d-985a-dd320512c63b",
                                                "text": "I went to the minimart...It’s about a fifteen minute walk both ways. But I didn’t wanna drive cause I was really wasted."
