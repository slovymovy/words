                        "examples": [
                            {
                                "example_id": "492ed7cf-fcf4-4de8-8e5a-889950f23673",
                                "sense_id": "d1a53908-ae24-3641-a2cd-7cd1dbef4700",
                                "text": "„Der Wille des Verstorbenen kann sich also negativ dahin auswirken, daß durch ihn einem durch Sitte oder Gesetz dazu an sich Berufenen das Bestimmungsrecht über seine Bestattung entzogen wird […]“"
                            },
                            {
                                "example_id": "15ccf31d-467b-45f6-9354-fc5b3febb3fa",
                                "sense_id": "d1a53908-ae24-3641-a2cd-7cd1dbef4700",
                                "text": "„In diesem Fall kollidieren zwei Gesetze mit Verfassungsrang: die Religionsfreiheit und das staatliche Bestimmungsrecht im Schulwesen.“"
                            },
                            {
                                "example_id": "a752073b-323b-4cf6-bc65-cc0ad0f07f05",
                                "sense_id": "d1a53908-ae24-3641-a2cd-7cd1dbef4700",
                                "text": "„Das Bestimmungsrecht des Patienten hängt naturgemäß im Wesentlichen von seinem Kenntnisstand ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
