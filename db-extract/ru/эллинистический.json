                    {
                        "translation_id": "a0c6178e-9f94-4377-af48-52f466f2e93d",
                        "source_entry_id": "f05e0c20-887d-33c4-97d6-c9b97e8c2766",
                        "source_sense_id": "704919a6-b2e2-3055-9edd-1dacb477f0be",
                        "target_lang_word": "hellenistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hellenistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9fa6d092-5e31-3d37-9a4f-90306f02a698",
                                        "entry_id": "3fc228c6-78c7-3deb-a827-8448517dd50c",
                                        "glosses": [
                                            "den Hellenismus betreffend, zu ihm gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c881097-e279-4554-b221-78218495f82d",
                                                "sense_id": "9fa6d092-5e31-3d37-9a4f-90306f02a698",
                                                "text": "„Hannibals politische Konzeption gipfelte in dem Bestreben, Karthago als ein außerhalb des römischen Machtmonopols stehendes, autonomes Staatswesen zu erhalten. Das Vorbild dafür bot das politische System der hellenistischen Staaten, das durch die Herstellung eines Gleichgewichts der Kräfte die Etablierung eines allmächtigen Hegemons verhindern konnte und die politische Existenz mehrerer in Konkurrenz zueinander stehender Gemeinwesen garantierte.“"
                                            },
                                            {
                                                "example_id": "b63114bb-91f4-4570-af49-95db90e4ec34",
                                                "sense_id": "9fa6d092-5e31-3d37-9a4f-90306f02a698",
                                                "text": "„Auf meinem Weg hindurch kam ich an weiteren, noch älteren Grabmalen vorüber, solchen aus hellenistischer Zeit.“"
                                            },
                                            {
                                                "example_id": "28899276-6f3f-4e35-8104-ed908b12ae6b",
                                                "sense_id": "9fa6d092-5e31-3d37-9a4f-90306f02a698",
                                                "text": "„So fanden etwa hellenistische Vorstellungen Eingang in die indische Darstellungskunst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
