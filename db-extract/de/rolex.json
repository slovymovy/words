                ],
                "senses": [
                    {
                        "sense_id": "35921285-c944-3d82-807b-df3d900f1683",
                        "entry_id": "a75f60a7-e41a-3394-bb53-2e2bc3052c09",
                        "glosses": [
                            "von der Firma Rolex SA hergestellte Uhr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecd3908c-bee1-49e1-930c-422e2f007328",
                                "sense_id": "35921285-c944-3d82-807b-df3d900f1683",
                                "text": "„Selbstverständlich hat auch die Goldküste eine Abordnung entsandt, zumeist hellhäutige, teuer gekleidete Schwarze der Generation meines Vaters, die dauernd ängstlich auf ihre Rolex schauen, wahrscheinlich um zu prüfen, ob die Beerdigung rechtzeitig vor ihrem Nachmittagstee zu Ende ist.“"
                            },
                            {
                                "example_id": "602af899-143d-4732-aa1a-6cce2eb6a35a",
                                "sense_id": "35921285-c944-3d82-807b-df3d900f1683",
                                "text": "„Sie ist nicht ganz so teuer wie eine Rolex, doch eine Rolex hat keinen großen Wiederverkaufswert; das sind hässliche Uhren, die nur von alten Männern und Asiaten getragen werden.“"
                            },
                            {
                                "example_id": "2536a8d7-034b-4a45-b115-fb45249c3fe8",
                                "sense_id": "35921285-c944-3d82-807b-df3d900f1683",
                                "text": "„Ein glatt rasierter, geschniegelter, erhaben wie ein Prinz auftretender Mann um die 30 in einem 4000-Dollar-Anzug, bei dem exakt ein Zentimeter des Hemds unter den Ärmeln des Jacketts hervorlugt, am Handgelenk eine goldene Rolex mit goldenen Karos anstelle der Ziffern, begleitet sie zum Aufzug und steigt mit ihr in die Kabine.“"
                            },
                            {
                                "example_id": "7e6f1b23-47ed-40aa-a921-e8d1d88f3915",
                                "sense_id": "35921285-c944-3d82-807b-df3d900f1683",
                                "text": "„Der athletische, gut aussehende Mann trug einen Maßanzug, an einem Handgelenk eine Rolex und am anderen ein Armband, beide aus Gold.“"
                            },
                            {
                                "example_id": "0f299d16-6599-4da6-adff-616174e89f05",
                                "sense_id": "35921285-c944-3d82-807b-df3d900f1683",
                                "text": "„Nach meiner nicht gefälschten Rolex ist es bereits halb zwei.“"
                            },
                            {
                                "example_id": "618fbd8e-f4b8-49f6-b989-81caa87f779c",
                                "sense_id": "35921285-c944-3d82-807b-df3d900f1683",
                                "text": "„Vorsteher Oliver Kahn erklärt ‚bei der Ehre aller meiner Rolexe‘, er lebe jetzt ‚von einer Art Bürgergeld und meinem kargen Schonvermögen‘.“"
                            },
                            {
                                "example_id": "7d9e9e4b-2dda-438f-8b96-8bbdf4f1c854",
                                "sense_id": "35921285-c944-3d82-807b-df3d900f1683",
                                "text": "„Die Abwickler hatten Porsches und Rolexe, sie hatten das Projekt aufgekauft, sie verkündeten große Pläne, die ihnen niemand glaubte, dann luden sie die Leitungsebene zu einem Workshop-Wochenende ein.“"
                            },
                            {
                                "example_id": "8faacef9-0848-49f6-a7a4-a354fcd29054",
                                "sense_id": "35921285-c944-3d82-807b-df3d900f1683",
                                "text": "„Offensichtlich sind die SPAM-Kollegen ihre ganzen falschen Rolexe nicht losgeworden und versuchen es jetzt mit einer neuen Strategie.“"
                            },
                            {
                                "example_id": "043f4699-a5a9-46fb-be50-247b6c3bcfff",
                                "sense_id": "35921285-c944-3d82-807b-df3d900f1683",
                                "text": "„Man könnte ja mal Karl-Heinz Rummenigge fragen, einen erfahrenen Katar-Reisenden, der 2013 zu knapp 250.000 Euro Geldstrafe verurteilt wurde, weil er bei der Rückkehr nach Deutschland vergessen hatte, zwei ihm geschenkte Rolexe im Wert von 100.000 Euro zu verzollen.“"
                            },
                            {
                                "example_id": "249959f3-a321-4d30-8e2d-12e314125461",
                                "sense_id": "35921285-c944-3d82-807b-df3d900f1683",
                                "text": "„Hach ja alte Zeiten… heute ist das dann wahrscheinlich wieder so das das ganze schöne Geld das die Spekulanten in Privatyachten und Rolexe umgesetzt haben, natürlich in militärisch besser geschützten Bereichen wie etwa der US-Diaspora, so den ärmsten Leuten abgenommen wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
