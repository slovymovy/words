                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c6a0d8ca-9f89-3fc7-8170-f6d4cd8e9813",
                                        "entry_id": "50e7ee37-ba99-37a6-84e8-e7159d848351",
                                        "glosses": [
                                            "klar zu erkennen; besonders gut erkennbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07e18121-8fcb-4975-942f-b3478dd5452c",
                                                "sense_id": "c6a0d8ca-9f89-3fc7-8170-f6d4cd8e9813",
                                                "text": "Pippa ist unverkennbar die Schwester von Kate."
                                            },
                                            {
                                                "example_id": "ebf81b3b-42d1-45dc-9179-5322271485aa",
                                                "sense_id": "c6a0d8ca-9f89-3fc7-8170-f6d4cd8e9813",
                                                "text": "Das ist unverkennbar Bach, Johann Sebastian Bach!"
                                            },
                                            {
                                                "example_id": "36908f50-d20e-486f-9df7-1320a9732f18",
                                                "sense_id": "c6a0d8ca-9f89-3fc7-8170-f6d4cd8e9813",
                                                "text": "Schlanke Gestalt, akkurater Scheitel, leicht geneigter Kopf. Die Silhouette [von Claus Kleber] ist unverkennbar – und zum Markenzeichen eines sachlichen, manchmal ironisch gefärbten Journalismus geworden."
                                            },
                                            {
                                                "example_id": "bd7cd68a-af3a-4377-9131-750c66ebec12",
                                                "sense_id": "c6a0d8ca-9f89-3fc7-8170-f6d4cd8e9813",
                                                "text": "Sie [Hanne Wieder] war Schauspielerin, Regisseurin, Kabarettistin und Chansonsängerin, spielte beim Theater und beim Film und ihr Gesicht und ihre Stimme waren für das Publikum unverkennbar."
                                            },
                                            {
                                                "example_id": "45cf3371-3fab-4c3e-9d42-3a8d7b559572",
                                                "sense_id": "c6a0d8ca-9f89-3fc7-8170-f6d4cd8e9813",
                                                "text": "Das hier ist das unverkennbare Wahrzeichen der Stadt [Brüssel]: Das „Atomium“ war Symbol der Weltausstellung 1958."
                                            },
                                            {
                                                "example_id": "167efec9-e07b-42de-b454-e46970ac5dd1",
                                                "sense_id": "c6a0d8ca-9f89-3fc7-8170-f6d4cd8e9813",
                                                "text": "Man hört ihm [Barack Obama] seine Resignation in der Stimme [nach einem erneuten Amoklauf an einem US-College in Oregon mit zehn Toten] an, er presst die Lippen aufeinander, der Frust ist unverkennbar: „Irgendwie ist das alles zur Routine geworden. Die Berichterstattung ist Routine. Meine Antwort hier auf diesem Podium wird in einer Routine enden. So wie die Debatte im Nachgang der Tat. Wir sind abgestumpft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
