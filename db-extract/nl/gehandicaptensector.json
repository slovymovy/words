                        "glosses": [
                            "alles en iedereen die betrokken is bij de zorg voor gehandicapten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27814a01-bc54-4110-9ef3-78e45aaee47f",
                                "sense_id": "a23e388e-47b0-3a2b-865d-17dd79d49848",
                                "text": "Opvallend is het geringe aantal onderzoeken dat de Inspectie doet naar sterfgevallen in de gehandicaptensector. In totaal komen er bij de Inspectie jaarlijks 36 calamiteitenmeldingen binnen vanwege onverwacht overlijden in de sector. Sinds 2013 onderzocht de Inspectie slechts enkele van deze meldingen."
                            },
                            {
                                "example_id": "692f16f5-374b-47b8-b123-5607615d3524",
                                "sense_id": "a23e388e-47b0-3a2b-865d-17dd79d49848",
                                "text": "Verstandelijk gehandicapten die in woongroepen en instellingen wonen, krijgen nauwelijks de kans om te stemmen. Hun stempassen worden vaak weggegooid, schrijft het tijdschrift Markant, maandblad voor de gehandicaptensector."
                            }
                        ]
                    }
