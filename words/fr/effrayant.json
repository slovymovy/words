        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7206224f-79e5-32e4-830c-eef9e26b6e30",
                    "sense_definition": "Participe présent de <w>effrayer</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En <w>effrayant</w> les oiseaux dans le jardin, le chat les a fait fuir rapidement.",
                            "target_lang_translations": {
                                "en": "By <w>scaring</w> the birds in the garden, the cat quickly sent them fleeing.",
                                "ru": "<w>Пугая</w> птиц в саду, кот быстро обратил их в бегство.",
                                "de": "Indem die Katze die Vögel im Garten <w>erschreckte</w>, brachte sie diese schnell zur Flucht.",
                                "es": "<w>Asustando</w> a los pájaros del jardín, el gato los hizo huir rápidamente.",
                                "zh": "猫<w>吓唬</w>花园里的鸟，很快就把它们赶跑了。"
                            }
                        },
                        {
                            "text": "Il a fait sursauter sa sœur en l'<w>effrayant</w> avec un faux serpent en plastique.",
                            "target_lang_translations": {
                                "en": "He made his sister jump by <w>scaring</w> her with a fake plastic snake.",
                                "ru": "Он заставил сестру вздрогнуть, <w>пугая</w> её ненастоящей пластиковой змеёй.",
                                "de": "Er brachte seine Schwester zum Zusammenzucken, indem er sie mit einer unechten Plastikschlange <w>erschreckte</w>.",
                                "es": "Hizo que su hermana diera un respingo <w>asustándola</w> con una serpiente falsa de plástico.",
                                "zh": "他用一条假的塑料蛇<w>吓唬</w>妹妹，把她惊得跳了起来。"
                            }
                        }
