                "translations": [
                    {
                        "translation_id": "1c052ac4-3106-420a-be93-8172ee5baf59",
                        "source_entry_id": "08cbdc97-3023-3830-b907-02a234bebf4d",
                        "source_sense_description": "in a wicked manner",
                        "target_lang_word": "mauvaisement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mauvaisement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "550c637c-a7de-3c14-b362-9d5a58b26eb7",
                                        "entry_id": "1fce8173-43e2-3cd4-b285-2a5adbb871ac",
                                        "glosses": [
                                            "D’une manière mauvaise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e809cf21-3355-4c4d-8d41-681f5a5ef816",
                                                "sense_id": "550c637c-a7de-3c14-b362-9d5a58b26eb7",
                                                "text": "Si fait, elle vous a mauvaisement trompée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3212754d-74f0-4ead-a4a6-1059e069b764",
                        "source_entry_id": "08cbdc97-3023-3830-b907-02a234bebf4d",
                        "source_sense_description": "in a wicked manner",
                        "target_lang_word": "méchamment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "méchamment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8b1741cc-e389-3230-9ac5-ac22e44a4eb5",
                                        "entry_id": "ca611117-c395-3b27-bbb5-d648c3f52e37",
                                        "glosses": [
                                            "Avec méchanceté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b855eb5-b659-4bba-94b8-d18bf2d7e9c3",
                                                "sense_id": "8b1741cc-e389-3230-9ac5-ac22e44a4eb5",
                                                "text": "Quelqu’un d’autre gratifia méchamment Bert de plusieurs solides coups de pied."
                                            },
                                            {
                                                "example_id": "b10dc51d-b7e4-4161-8ff8-c2f64bc4d4fb",
                                                "sense_id": "8b1741cc-e389-3230-9ac5-ac22e44a4eb5",
                                                "text": "Jimmy le faisait méchamment trébucher, en le happant du crochet de sa grosse canne blanche."
                                            },
                                            {
                                                "example_id": "de41749e-ce3b-445b-9ddb-c3f65668d849",
                                                "sense_id": "8b1741cc-e389-3230-9ac5-ac22e44a4eb5",
                                                "text": "Combien les lunettes nous ont-elles découvert d’êtres qui n'étaient point pour nos philosophes d’auparavant ! on entreprenait méchamment l’Écriture sainte sur le grand nombre des étoiles, en disant : il n'y en a que mille vingt-deux, nous le savons."
                                            },
                                            {
                                                "example_id": "e6afad3a-8f0c-41b0-ae34-090fce85f1b8",
                                                "sense_id": "8b1741cc-e389-3230-9ac5-ac22e44a4eb5",
                                                "text": "Mais pour un lourd frelon, méchamment imbécile,\nQui vit du mal qu’il fait et nuit sans être utile,\nOn écrase à plaisir cet insecte orgueilleux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42c35b09-dc8a-3592-a68a-d35cfe44529f",
                                        "entry_id": "ca611117-c395-3b27-bbb5-d648c3f52e37",
                                        "glosses": [
                                            "Gravement."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78353e68-b8c1-401a-b861-41bffd19ff40",
                                                "sense_id": "42c35b09-dc8a-3592-a68a-d35cfe44529f",
                                                "text": "C'était la terreur. Un sacré tord-boyaux de frousse tellement on avait peur qu'un des deux se viandât méchamment cinq mètres plus bas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec5dd7b0-4c9a-3646-aec4-1fafcf81e2b2",
                                        "entry_id": "ca611117-c395-3b27-bbb5-d648c3f52e37",
                                        "glosses": [
                                            "Très, extrêmement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ffd0463-bcf8-4add-9d04-82b8fa860ec9",
                                                "sense_id": "ec5dd7b0-4c9a-3646-aec4-1fafcf81e2b2",
                                                "text": "Sur les murs tout en beau bois sombre, c’était couvert de photos de bécanes, de posters avec des espèces de slogans marrants, et il y avait deux vieilles brêles méchamment splendides exposées sur des piédestaux au fond de la salle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91b60c50-578c-4e5e-b23e-f47f7b47e1ce",
                        "source_entry_id": "08cbdc97-3023-3830-b907-02a234bebf4d",
                        "source_sense_description": "in a wicked manner",
                        "target_lang_word": "cruellement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cruellement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8030cc57-e588-3cd2-87e2-97a9dabdcf11",
                                        "entry_id": "ee67c085-579f-3902-b315-c4d87df9ff83",
                                        "glosses": [
                                            "D’une manière cruelle, avec cruauté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "906ef374-4c5f-4253-8ac0-34e201a4143b",
                                                "sense_id": "8030cc57-e588-3cd2-87e2-97a9dabdcf11",
                                                "text": "Il le fait mourir cruellement."
                                            },
                                            {
                                                "example_id": "2fc00840-26c1-40e1-a784-18b668c4a7d6",
                                                "sense_id": "8030cc57-e588-3cd2-87e2-97a9dabdcf11",
                                                "text": "Cruellement docile aux leçons de ton maître."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37f76e13-7844-3dd0-9475-64b94bf5f636",
                                        "entry_id": "ee67c085-579f-3902-b315-c4d87df9ff83",
                                        "glosses": [
                                            "D’une façon douloureuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb8a04f7-4643-44d5-9601-01a76f363c44",
                                                "sense_id": "37f76e13-7844-3dd0-9475-64b94bf5f636",
                                                "text": "Son pied gauche, dont l'orteil rongeait la chaussette dix fois raccommodée, déchiquetant les mailles et creusant sa trouée, le faisait souffrir cruellement."
                                            },
                                            {
                                                "example_id": "bc3e2a84-8aba-4298-99e2-9856064400e2",
                                                "sense_id": "37f76e13-7844-3dd0-9475-64b94bf5f636",
                                                "text": "Quoi qu'il en fût, ma naissance fut pénible. Je déchirai ma mère si cruellement que le contact de son mari lui devint un supplice."
                                            },
                                            {
                                                "example_id": "1f98e9ea-4237-46a8-8650-4ce8af470baf",
                                                "sense_id": "37f76e13-7844-3dd0-9475-64b94bf5f636",
                                                "text": "Cruellement blessé, mais trop fier pour me plaindre."
                                            },
                                            {
                                                "example_id": "fc0c4b88-db0e-4314-bee4-256afef25acd",
                                                "sense_id": "37f76e13-7844-3dd0-9475-64b94bf5f636",
                                                "text": "Cruellement trompé, je t’ai trompé toi-même."
                                            },
                                            {
                                                "example_id": "679ebc4a-dd4a-4974-9892-387d9ae0204e",
                                                "sense_id": "37f76e13-7844-3dd0-9475-64b94bf5f636",
                                                "text": "La marmotte a les quatre dents de devant assez longues et assez fortes pour blesser cruellement."
                                            },
                                            {
                                                "example_id": "f2f4e6f9-5144-4a99-aeb4-ef60da77c01b",
                                                "sense_id": "37f76e13-7844-3dd0-9475-64b94bf5f636",
                                                "text": "Enfin on atteignit Gjatz avec la nuit ; mais cette première journée d’hiver avait été cruellement remplie ; l’aspect du champ de bataille, de ces deux hôpitaux abandonnés, cette multitude de caissons livrés aux flammes, ces Russes fusillés […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd40ba39-f685-3cbd-9e62-7d11cff00e62",
                                        "entry_id": "ee67c085-579f-3902-b315-c4d87df9ff83",
                                        "glosses": [
                                            "Cruellement laid, très laid."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a049ee19-f6e4-4939-b194-fcd6fcd73d43",
                                                "sense_id": "cd40ba39-f685-3cbd-9e62-7d11cff00e62",
                                                "text": "Chamillart se trouva d’autant plus flatté [de la demande de la Feuillade] que sa fille était cruellement vilaine."
                                            },
                                            {
                                                "example_id": "c815e8a4-ce4c-4a0b-adb3-fbcb8470a4df",
                                                "sense_id": "cd40ba39-f685-3cbd-9e62-7d11cff00e62",
                                                "text": "L'esprit y est toujours naturel et exempt de ce jargon ridicule, à la fois puéril et barbare, dont plusieurs de nos pièces modernes sont si cruellement infectées."
                                            },
                                            {
                                                "example_id": "c81c320b-4d67-4d19-bfc7-5a74e1c8a3eb",
                                                "sense_id": "cd40ba39-f685-3cbd-9e62-7d11cff00e62",
                                                "text": "Sa gloire, cruellement obscurcie par la fin de son règne, au moins si on en juge par les événements."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
