                                        "glosses": [
                                            "Maltraiter, vexer."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b2837c2-887f-47c0-80f9-4b49ee02c39a",
                        "source_entry_id": "fa379a8b-fa5a-37b9-9a6b-f3d2a470ecf8",
