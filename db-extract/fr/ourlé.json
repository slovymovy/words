                "senses": [
                    {
                        "sense_id": "c45c3521-82b3-3345-88a3-816c4f96ca1a",
                        "entry_id": "84bea6df-ee82-3b4a-ada4-ec584b0a5421",
                        "glosses": [
                            "Dont le rebord est en forme d’ourlet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e35d027-4061-4f5a-8713-1dde80c18798",
                                "sense_id": "c45c3521-82b3-3345-88a3-816c4f96ca1a",
                                "text": "Ainsi ancrée au bord de la lagune ourlée de bavures de lumière, la forteresse semblait soudain mise à flot, portée sur un élément fluide qui la faisait vivre sur le fond inerte du paysage, du léger et profond tressaillement d’aise d’un vaisseau au mouillage."
                            },
                            {
                                "example_id": "e2493be3-295b-45f1-b1d9-34b410078f00",
                                "sense_id": "c45c3521-82b3-3345-88a3-816c4f96ca1a",
                                "text": "Votre exquis San-A. retend son oreille finalement ourlée, mes petites fleurs."
                            },
                            {
                                "example_id": "0b72b6b0-0ecd-42e9-9df9-0fdd4d48f775",
                                "sense_id": "c45c3521-82b3-3345-88a3-816c4f96ca1a",
                                "text": "Il faut dire qu’il a du genre, l’animal. Une dégaine à la Johnny, un style vestimentaire étudié, le tatouage assumé, une gueule d’ange déchu, le regard ourlé de promesses déjà oubliées avec l’aube, un rien de machisme latent."
                            },
                            {
                                "example_id": "4e3e6c87-2037-42ff-9f4b-b3ec1290fb03",
                                "sense_id": "c45c3521-82b3-3345-88a3-816c4f96ca1a",
                                "text": "Je me souviens vaguement des traits de la gamine, une blondine coiffée d'un chapeau de paille orné de cerises artificielles, avec une robe en lingerie blanche, percée de trou-trous ourlés."
                            }
                        ]
                    }
