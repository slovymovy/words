                        "glosses": [
                            "Of, relating to, or like, a talisman."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bada759-6989-4e61-92cc-66c514c2d6b1",
                                "sense_id": "f4c60aea-7b7b-3018-9a7e-024bfc42f688",
                                "text": "Oleg Blokhin's side lost the talismanic Andriy Shevchenko to the substitutes' bench because of a knee injury but still showed enough to put England through real turmoil in spells."
                            },
                            {
                                "example_id": "8849a5c3-7c70-410a-a946-32e2fe60b66c",
                                "sense_id": "f4c60aea-7b7b-3018-9a7e-024bfc42f688",
                                "text": "For Marshall, law possessed a talismanic quality, representing all that was best in American democracy."
                            },
                            {
                                "example_id": "e3865111-3d41-49f5-9b43-0bf8ae565b7a",
                                "sense_id": "f4c60aea-7b7b-3018-9a7e-024bfc42f688",
                                "text": "Midfielder Hayley Raso put the game beyond doubt in the second half, before the team’s talismanic striker Sam Kerr – the face of this home World Cup – made her return to the pitch following the calf injury she suffered on the eve of the tournament."
                            }
                        ]
                    },
