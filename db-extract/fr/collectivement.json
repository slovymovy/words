                                        "glosses": [
                                            "In a collective manner; viewed together as a whole; to be treated as a single unit, rather than the items that make up the collection separately."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "597dc31b-8454-4b33-8057-ec442b632257",
                                                "sense_id": "59b1135c-8423-316e-b54e-2ef5576b9c3b",
                                                "text": "...the tube of the throat between the larynx and the oral cavity, which is called the pharynx; the oral cavity; and the nasal cavity. These passages are collectively known as the vocal tract."
                                            }
                                        ]
