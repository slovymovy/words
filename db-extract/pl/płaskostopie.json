                                "target_senses": [
                                    {
                                        "sense_id": "51ca23b9-db82-3852-acee-9c4008aef877",
                                        "entry_id": "2b25e82a-a49e-3f75-a916-8b5c4495674e",
                                        "glosses": [
                                            "A condition in which the arch of the foot makes contact with the ground."
                                        ],
