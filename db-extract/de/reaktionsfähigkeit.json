                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "db9bd99e-7c8c-3991-8240-0ad8c7b23742",
                        "entry_id": "ab32ab25-3bee-34fb-816c-b3792a77d742",
                        "glosses": [
                            "Eigenschaft eines Stoffes, leicht eine chemische Verbindung eingehen zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85b80421-bc95-4618-9d9b-01f70bb7341c",
                                "sense_id": "db9bd99e-7c8c-3991-8240-0ad8c7b23742",
                                "text": "Brom besitzt eine hohe Reaktionsfähigkeit, es greift fast alle Metalle an, sogar Gold löst sich in Brom. Nur Platin und Tantal widerstehen ihm."
                            }
                        ],
                        "sense_index_json": "\"2\""
