                                "target_senses": [
                                    {
                                        "sense_id": "4167915b-40d6-3a77-9d88-838a830bf51e",
                                        "entry_id": "d9eda116-fa95-35f5-82a9-1324a8f39e7e",
                                        "glosses": [
                                            "Qui a rapport à la wicca."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c81eec59-3902-444f-90fe-7562ab371a0a",
                                                "sense_id": "4167915b-40d6-3a77-9d88-838a830bf51e",
                                                "text": "J’ai fait beaucoup de lectures en préparant l’écriture de Blanc résine, sur l’écoféminisme, sur les différents rapports au sacré, le paganisme, la culture wicca, les traditions amérindiennes…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55d7e11c-4a4e-4c88-b1e8-18c3e8503cbd",
                        "source_entry_id": "ababbe61-0c3f-36cc-b4df-713b4e51f450",
                        "source_sense_id": "69b69612-a8bf-3264-b37c-e823d9ceef2e",
                        "source_sense_description": "neo-pagan religion",
                        "target_lang_word": "Wicca",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wicca",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6f87e7ef-17af-398e-8306-82050e9f552a",
                                        "entry_id": "28fb263c-b22d-3b50-b0f3-3fcacd41eb2e",
                                        "glosses": [
                                            "große Religion innerhalb des Neopaganismus, die die Arbeit mit einem gehörnten Gott und einer großen Göttin, sowie die Feier von Sabbat und Esbat beinhaltet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "342b2cc6-66b1-4159-80f1-27a2ce7ed884",
                                                "sense_id": "6f87e7ef-17af-398e-8306-82050e9f552a",
                                                "text": "„Seien wir uns mal ehrlich: Wicca ist keine uralte Tradition, Wicca ist ein 50 Jahre alter Mix aus allem Möglichen. Aber eines steht fest: Wicca und überhaupt Magie an sich, ist wie Sprengstoff. Es funktioniert.“"
                                            },
                                            {
                                                "example_id": "531ab102-417e-43ea-8ec3-6679475206f2",
                                                "sense_id": "6f87e7ef-17af-398e-8306-82050e9f552a",
                                                "text": "„Wicca ist eine neureligiöse Bewegung, die sich an den alten, vor–römischen Religionen Nord-, Mittel- und Südeuropas orientiert: dem Kelten- und Germanentum.“"
                                            },
                                            {
                                                "example_id": "c40a2744-32f1-4c5f-a584-74d83a58c1e2",
                                                "sense_id": "6f87e7ef-17af-398e-8306-82050e9f552a",
                                                "text": "„Während Hexerei im Europa des 21. Jahrhunderts, insbesondere unter der Selbstbezeichnung Wicca, als „Religion“ beurteilt wird, besteht in der ethnologischen Forschung große Uneinigkeit, ob Hexerei in Afrika als Religion einzuordnen ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Wicca",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7c050392-a514-31e6-9ff7-b5c2ab24bc41",
                                        "entry_id": "ddaaab23-8eb1-38da-bdfb-31cf4f6d3ca6",
                                        "glosses": [
                                            "Anhänger des Wicca"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5c31c02-183e-4a5c-b70a-f0fabc430302",
                                                "sense_id": "7c050392-a514-31e6-9ff7-b5c2ab24bc41",
                                                "text": "„Die meisten Wicca unterteilen in sogenannte weiße, graue und schwarze Magie, wobei die weiße zu positiven Zwecken eingesetzt wird und die schwarze schaden soll.“"
                                            },
                                            {
                                                "example_id": "56f2afd5-7b4c-4b35-98bd-31009113d5e6",
                                                "sense_id": "7c050392-a514-31e6-9ff7-b5c2ab24bc41",
                                                "text": "„Wiccas sind Frauen und Männer, die sich selbst als «neue Hexen auf altem Pfad» bezeichnen.“"
                                            },
                                            {
                                                "example_id": "b4ecea1c-841c-40ef-853d-c6d9f709b7ab",
                                                "sense_id": "7c050392-a514-31e6-9ff7-b5c2ab24bc41",
                                                "text": "„Wicca kann sich erst nennen, wer von Eingeweihten initiiert wurde.“"
                                            },
                                            {
                                                "example_id": "f8429bfe-53d8-411e-a545-50fdc8dcc8df",
                                                "sense_id": "7c050392-a514-31e6-9ff7-b5c2ab24bc41",
                                                "text": "„Jeder Wicca ist eine Hexe, aber nicht jede Hexe ist ein Wicca.“"
                                            },
                                            {
                                                "example_id": "ddbd053b-1982-40d8-ba2b-526e0536fc53",
                                                "sense_id": "7c050392-a514-31e6-9ff7-b5c2ab24bc41",
                                                "text": "„Dann, nach einer gefühlten Ewigkeit, verzieht der Wicca das Gesicht zu einem unförmigen Lächeln.“"
                                            },
                                            {
                                                "example_id": "33c21a07-0f87-471f-a5c1-25238ad180da",
                                                "sense_id": "7c050392-a514-31e6-9ff7-b5c2ab24bc41",
                                                "text": "„Nun kann die magische Arbeit, welche vom Anliegen des Wiccas an die Götter abhängt, beginnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Wicca",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b7fa2001-4de1-31e3-8e41-4f69b73f44ec",
                                        "entry_id": "2c08b526-0743-3c0a-80fd-dcb5b4228b85",
                                        "glosses": [
                                            "Anhängerin des Wicca"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7619ff30-9387-4a39-a9fd-6540831e2878",
                                                "sense_id": "b7fa2001-4de1-31e3-8e41-4f69b73f44ec",
                                                "text": "„Die Wicca neben ihr gab sich ebenfalls so, als hätte sie ein lauteres, unschuldiges Wesen.“"
                                            },
                                            {
                                                "example_id": "09316c46-9df1-4f87-beac-908b36adfb55",
                                                "sense_id": "b7fa2001-4de1-31e3-8e41-4f69b73f44ec",
                                                "text": "„Achtung, hier kommt eine Wicca, die nicht mehr lange unter den Lebenden weilen wird.“"
                                            },
                                            {
                                                "example_id": "5dbfc7fb-8b49-419c-a359-fcf39981a1e8",
                                                "sense_id": "b7fa2001-4de1-31e3-8e41-4f69b73f44ec",
                                                "text": "„Im Kanton Aargau amtet eine selbsternannte Hexe, die auch Hausherrin über das Hexenmuseum ist. Wicca Meier Spring verfügt über ein profundes Wissen und bildet ausserdem Hexen aus.“"
                                            },
                                            {
                                                "example_id": "da9767fd-1cae-4865-9327-48b832ed77f3",
                                                "sense_id": "b7fa2001-4de1-31e3-8e41-4f69b73f44ec",
                                                "text": "„Am Bug hielt eine Wicca einen brennenden Stab hoch.“"
                                            },
                                            {
                                                "example_id": "88574927-802e-4f8d-8119-9103a5c7ba88",
                                                "sense_id": "b7fa2001-4de1-31e3-8e41-4f69b73f44ec",
                                                "text": "„Mit diesen Worten knallte die Wicca die Tür zum Bad zu und sperrte ihre Kommilitonin aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
