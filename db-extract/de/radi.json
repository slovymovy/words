                "senses": [
                    {
                        "sense_id": "1e5f8a8a-da7f-30b3-b19d-a0731c2175a9",
                        "entry_id": "e4ea246f-c91b-326d-b415-be53a3847e20",
                        "glosses": [
                            "zu den Kreuzblütlern gehörende Pflanze mit dicker, rübenförmiger, scharf schmeckender Wurzel"
                        ],
                        "tags": [
