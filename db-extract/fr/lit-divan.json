                        "glosses": [
                            "Meuble utilisable soit comme lit soit comme divan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc38c725-4d1a-43eb-ba5a-fd53b9126195",
                                "sense_id": "94c68891-ca12-379c-8363-fa6a0dc3290a",
                                "text": "Les murs de la pièce sont blancs, comme la couverture du grand lit-divan qui fait face à la porte du palier."
                            },
                            {
                                "example_id": "3c7e27cb-6865-4564-8bf4-b0324c92f4de",
                                "sense_id": "94c68891-ca12-379c-8363-fa6a0dc3290a",
                                "text": "Nasr est assis sur le trône, une espèce de lit-divan surélevé couvert d’un tapis sombre, auprès duquel un esclave tient un plat de pétales de roses confits."
                            },
                            {
                                "example_id": "d6e744cb-14b5-4d8a-83a6-4dd10ab7dc5a",
                                "sense_id": "94c68891-ca12-379c-8363-fa6a0dc3290a",
                                "text": "Elle se contente d’une modification fonctionnelle : elle replace les deux lits Empire en acajou de la chambre par deux lits-divans longs – il fallait 2,10 mètres pour le Général – et étroits."
                            },
                            {
                                "example_id": "e835b34a-5e3a-45ac-ab73-49918a1f749a",
                                "sense_id": "94c68891-ca12-379c-8363-fa6a0dc3290a",
                                "text": "Les lits-divans peuvent être une excellente alternative si vous avez des invités réguliers et avez besoin d'un niveau de confort plus élevé."
                            }
                        ]
                    }
