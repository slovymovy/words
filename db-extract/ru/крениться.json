                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4818505-6a54-4c70-bf4d-b36b98e3750a",
                                "sense_id": "5b695e71-f85c-34c5-af40-6620e89c4a17",
                                "text": "Без шума катились колеса прямо по траве, и вдруг тарантас принялся подскакивать, крениться направо и налево."
                            },
                            {
                                "example_id": "08ba0dcf-78d1-494a-baca-02752732aeb7",
                                "sense_id": "5b695e71-f85c-34c5-af40-6620e89c4a17",
                                "text": "Раздался взрыв, и крейсер стал крениться на борт, к нему на помощь пошли другой крейсер и два миноносца."
                            }
                        ]
                    }
