{
    "word_family": [
        "scrappy",
        "scrapper",
        "scrapbook"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e256e1f3-9166-3d7d-b35c-d390f235fee6",
                    "sense_definition": "A small piece or detached fragment of something larger.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "fragment_or_amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wrote her phone number on a <w>scrap</w> of paper.",
                            "target_lang_translations": {
                                "ru": "Она записала свой номер телефона на <w>клочке</w> бумаги.",
                                "zh": "她把电话号码写在了一张<w>纸片</w>上。",
                                "pl": "Zapisała swój numer telefonu na <w>kawałku</w> papieru."
                            }
                        },
                        {
                            "text": "I found a <w>scrap</w> of fabric that matches the curtains perfectly.",
                            "target_lang_translations": {
                                "ru": "Я нашел <w>лоскуток</w> ткани, который идеально подходит к шторам.",
                                "zh": "我找到了一块和窗帘颜色很搭的<w>布头</w>。",
                                "pl": "Znalazłam <w>kawałek</w> materiału, który idealnie pasuje do zasłon."
                            }
                        }
                    ],
                    "synonyms": [
                        "fragment",
                        "piece",
                        "bit",
                        "snippet",
                        "shred",
                        "remnant"
                    ],
                    "antonyms": [
                        "whole"
                    ],
                    "common_phrases": [
                        "scrap of paper",
                        "scrap of cloth",
                        "scrap of material"
                    ],
                    "target_lang_definitions": {
                        "ru": "Маленький кусочек или оторванный фрагмент чего-то большего.",
                        "zh": "指某物的一小块或碎片。",
                        "pl": "Mały kawałek lub oderwany fragment czegoś większego."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клочок",
                                "target_lang_sense_clarification": "обычно бумаги или волос"
                            },
                            {
                                "target_lang_word": "обрывок",
                                "target_lang_sense_clarification": "оторванная часть чего-либо"
                            },
                            {
                                "target_lang_word": "лоскуток",
                                "target_lang_sense_clarification": "ткани"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "碎片",
                                "target_lang_sense_clarification": "指破碎的小块"
                            },
                            {
                                "target_lang_word": "纸片",
                                "target_lang_sense_clarification": "指小块纸张"
                            },
                            {
                                "target_lang_word": "布头",
                                "target_lang_sense_clarification": "指零碎的布料"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "kawałek",
                                "target_lang_sense_clarification": "ogólne określenie fragmentu czegoś"
                            },
                            {
                                "target_lang_word": "fragment",
                                "target_lang_sense_clarification": "wyodrębniona część całości"
                            },
                            {
                                "target_lang_word": "urywek",
                                "target_lang_sense_clarification": "część czegoś, np. rozmowy lub tekstu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2575539d-0375-3906-bc6a-4b31ab7b7704",
                    "sense_definition": "Discarded material, especially metal, that can be collected and reprocessed.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "waste_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old car was finally sold for <w>scrap</w>.",
                            "target_lang_translations": {
                                "ru": "Старую машину наконец продали на <w>металлолом</w>.",
                                "zh": "那辆旧车最终被当作<w>废金属</w>卖掉了。",
                                "pl": "Stary samochód został w końcu sprzedany na <w>złom</w>."
                            }
                        },
                        {
                            "text": "They collect <w>scrap</w> metal to recycle and sell for profit.",
                            "target_lang_translations": {
                                "ru": "Они собирают <w>лом</w> металла для переработки и продажи с целью получения прибыли.",
                                "zh": "他们收集<w>废金属</w>进行回收以赚取利润。",
                                "pl": "Zbierają <w>złom</w> metalowy, aby go przetworzyć i sprzedać z zyskiem."
                            }
                        }
                    ],
                    "synonyms": [
                        "junk",
                        "waste",
                        "debris"
                    ],
                    "common_phrases": [
                        "scrap metal",
                        "scrap yard",
                        "sold for scrap",
                        "scrap iron"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отработанный материал, особенно металл, который можно собрать и переработать.",
                        "zh": "废弃的材料，尤指可回收利用的金属。",
                        "pl": "Odpady, zwłaszcza metalowe, które można zebrać i poddać recyklingowi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "металлолом",
                                "target_lang_sense_clarification": "металлический лом для переработки"
                            },
                            {
                                "target_lang_word": "лом",
                                "target_lang_sense_clarification": "сокращение от металлолом"
                            },
                            {
                                "target_lang_word": "утиль",
                                "target_lang_sense_clarification": "вещи, годные для переработки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "废金属",
                                "target_lang_sense_clarification": "指废弃的金属材料"
                            },
                            {
                                "target_lang_word": "废料",
                                "target_lang_sense_clarification": "指生产或使用中产生的废弃物"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "złom",
                                "target_lang_sense_clarification": "zużyte przedmioty metalowe przeznaczone do przetworzenia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04fc14db-fcb5-36f7-8739-efd733427126",
                    "sense_definition": "Small amounts of food left over after a meal.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "waste_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We usually give the table <w>scraps</w> to the dog.",
                            "target_lang_translations": {
                                "ru": "Мы обычно отдаем <w>остатки</w> со стола собаке.",
                                "zh": "我们通常把<w>剩饭</w>喂给狗吃。",
                                "pl": "Zazwyczaj dajemy <w>resztki</w> ze stołu psu."
                            }
                        },
                        {
                            "text": "The stray cat survived by eating <w>scraps</w> from the restaurant bin.",
                            "target_lang_translations": {
                                "ru": "Бродячий кот выжил, питаясь <w>объедками</w> из мусорного бака ресторана.",
                                "zh": "那只流浪猫靠吃餐馆垃圾桶里的<w>残羹剩饭</w>活了下来。",
                                "pl": "Bezpański kot przeżył, jedząc <w>resztki</w> z restauracyjnego śmietnika."
                            }
                        }
                    ],
                    "synonyms": [
                        "leftovers",
                        "remains"
                    ],
                    "common_phrases": [
                        "table scraps",
                        "food scraps",
                        "feed on scraps"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое количество еды, оставшееся после приема пищи.",
                        "zh": "餐后剩下的少量食物。",
                        "pl": "Niewielkie ilości jedzenia pozostałe po posiłku."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "остатки",
                                "target_lang_sense_clarification": "еды"
                            },
                            {
                                "target_lang_word": "объедки",
                                "target_lang_sense_clarification": "остатки пищи (часто для животных)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "剩饭",
                                "target_lang_sense_clarification": "指吃剩下的饭菜"
                            },
                            {
                                "target_lang_word": "残羹剩饭",
                                "target_lang_sense_clarification": "指吃剩下的食物"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "resztki",
                                "target_lang_sense_clarification": "pozostałości jedzenia"
                            },
                            {
                                "target_lang_word": "obierki",
                                "target_lang_sense_clarification": "odpady kuchenne (np. warzywne)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a52d5ec-2a63-39f1-be1b-c37057c6da8b",
                    "sense_definition": "A minor fight or argument.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The players got into a bit of a <w>scrap</w> on the field.",
                            "target_lang_translations": {
                                "ru": "Игроки устроили небольшую <w>потасовку</w> на поле.",
                                "zh": "球员们在场上发生了一点小<w>打架</w>。",
                                "pl": "Zawodnicy wdali się w małą <w>bójkę</w> na boisku."
                            }
                        },
                        {
                            "text": "He walked away with a black eye after a <w>scrap</w> at the bar.",
                            "target_lang_translations": {
                                "ru": "Он ушел с фингалом после <w>драки</w> в баре.",
                                "zh": "他在酒吧<w>打架</w>后，带着一只黑眼圈离开了。",
                                "pl": "Wyszedł z podbitym okiem po <w>bójce</w> w barze."
                            }
                        }
                    ],
                    "synonyms": [
                        "fight",
                        "tussle",
                        "skirmish",
                        "brawl",
                        "scuffle"
                    ],
                    "common_phrases": [
                        "get into a scrap",
                        "bit of a scrap"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая драка или ссора.",
                        "zh": "小规模的打斗或争吵。",
                        "pl": "Niewielka bójka lub sprzeczka."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потасовка",
                                "target_lang_sense_clarification": "небольшая драка"
                            },
                            {
                                "target_lang_word": "стычка",
                                "target_lang_sense_clarification": "конфликт"
                            },
                            {
                                "target_lang_word": "драка",
                                "target_lang_sense_clarification": "физический конфликт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打架",
                                "target_lang_sense_clarification": "指肢体冲突"
                            },
                            {
                                "target_lang_word": "争吵",
                                "target_lang_sense_clarification": "指言语冲突"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "bójka",
                                "target_lang_sense_clarification": "fizyczna awantura"
                            },
                            {
                                "target_lang_word": "sprzeczka",
                                "target_lang_sense_clarification": "krótka wymiana zdań, kłótnia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c3a0fa1-57b2-3ea5-8e80-ae1c77eb1cc5",
                    "sense_definition": "The smallest possible amount, usually used in negative contexts.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fragment_or_amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is not a <w>scrap</w> of evidence to support his claim.",
                            "target_lang_translations": {
                                "ru": "Нет ни <w>капли</w> доказательств в поддержку его заявления.",
                                "zh": "没有任何<w>丝毫</w>证据支持他的说法。",
                                "pl": "Nie ma ani <w>odrobiny</w> dowodów na poparcie jego twierdzenia."
                            }
                        },
                        {
                            "text": "She doesn't care a <w>scrap</w> about what the neighbors think.",
                            "target_lang_translations": {
                                "ru": "Ей ни <w>капли</w> не интересно, что думают соседи.",
                                "zh": "她对邻居们的想法<w>一点</w>也不在乎。",
                                "pl": "Nie obchodzi jej ani <w>odrobina</w> tego, co myślą sąsiedzi."
                            }
                        }
                    ],
                    "synonyms": [
                        "shred",
                        "ounce",
                        "iota",
                        "whit",
                        "speck"
                    ],
                    "antonyms": [
                        "load",
                        "heap"
                    ],
                    "common_phrases": [
                        "not a scrap",
                        "without a scrap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мельчайшее возможное количество, обычно используется в отрицательном контексте.",
                        "zh": "极小的量，通常用于否定句中。",
                        "pl": "Najmniejsza możliwa ilość, zazwyczaj używana w kontekstach przeczących."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "капля",
                                "target_lang_sense_clarification": "перен. ни капли"
                            },
                            {
                                "target_lang_word": "крупица",
                                "target_lang_sense_clarification": "мельчайшая частица"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "丝毫",
                                "target_lang_sense_clarification": "指极小的数量"
                            },
                            {
                                "target_lang_word": "一点",
                                "target_lang_sense_clarification": "指极小的程度"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "odrobina",
                                "target_lang_sense_clarification": "bardzo mała ilość"
                            },
                            {
                                "target_lang_word": "krzywda",
                                "target_lang_sense_clarification": "w kontekście 'nie obchodzi go ani krztyna'"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cf9ab932-20ed-3f9a-b3b5-2151dc457cb4",
                    "sense_definition": "To decide not to continue with a plan or activity; to get rid of something no longer useful.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "discard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government decided to <w>scrap</w> the controversial tax policy.",
                            "target_lang_translations": {
                                "ru": "Правительство решило <w>отказаться от</w> спорной налоговой политики.",
                                "zh": "政府决定<w>废弃</w>那项有争议的税收政策。",
                                "pl": "Rząd zdecydował się <w>anulować</w> kontrowersyjną politykę podatkową."
                            }
                        },
                        {
                            "text": "We had to <w>scrap</w> our holiday plans because of the bad weather.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось <w>отменить</w> наши планы на отпуск из-за плохой погоды.",
                                "zh": "因为天气不好，我们不得不<w>取消</w>了度假计划。",
                                "pl": "Musieliśmy <w>porzucić</w> nasze plany wakacyjne z powodu złej pogody."
                            }
                        }
                    ],
                    "synonyms": [
                        "discard",
                        "abandon",
                        "cancel",
                        "ditch",
                        "drop"
                    ],
                    "antonyms": [
                        "keep",
                        "retain",
                        "adopt"
                    ],
                    "common_phrases": [
                        "scrap a plan",
                        "scrap the idea",
                        "scrap a project"
                    ],
                    "target_lang_definitions": {
                        "ru": "Решить не продолжать план или деятельность; избавиться от чего-то, что больше не нужно.",
                        "zh": "决定放弃某项计划或活动；丢弃不再有用的东西。",
                        "pl": "Decyzja o zaprzestaniu realizacji planu lub pozbycie się czegoś niepotrzebnego."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отказаться от",
                                "target_lang_sense_clarification": "плана или идеи"
                            },
                            {
                                "target_lang_word": "списать",
                                "target_lang_sense_clarification": "в утиль или со счетов"
                            },
                            {
                                "target_lang_word": "отменить",
                                "target_lang_sense_clarification": "планы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "废弃",
                                "target_lang_sense_clarification": "指不再使用"
                            },
                            {
                                "target_lang_word": "取消",
                                "target_lang_sense_clarification": "指终止计划"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "anulować",
                                "target_lang_sense_clarification": "zrezygnować z planów"
                            },
                            {
                                "target_lang_word": "porzucić",
                                "target_lang_sense_clarification": "zrezygnować z pomysłu lub projektu"
                            },
                            {
                                "target_lang_word": "wyrzucić",
                                "target_lang_sense_clarification": "pozbyć się czegoś niepotrzebnego"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "342dc9af-fea6-3700-adfb-b946a7200702",
                    "sense_definition": "To engage in a fight or quarrel.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two brothers are always <w>scrapping</w> over who gets the front seat.",
                            "target_lang_translations": {
                                "ru": "Два брата вечно <w>цапаются</w> из-за того, кто сядет на переднее сиденье.",
                                "zh": "两兄弟总是为了谁坐前排而<w>吵架</w>。",
                                "pl": "Dwaj bracia ciągle <w>kłócą się</w> o to, kto usiądzie na przednim siedzeniu."
                            }
                        },
                        {
                            "text": "He isn't afraid to <w>scrap</w> if someone insults his friends.",
                            "target_lang_translations": {
                                "ru": "Он не боится <w>подраться</w>, если кто-то оскорбляет его друзей.",
                                "zh": "如果有人侮辱他的朋友，他不怕跟人<w>打架</w>。",
                                "pl": "Nie boi się <w>bić</w>, jeśli ktoś obraża jego przyjaciół."
                            }
                        }
                    ],
                    "synonyms": [
                        "fight",
                        "brawl",
                        "tussle",
                        "scuffle"
                    ],
                    "common_phrases": [
                        "scrap with someone"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вступать в драку или ссору.",
                        "zh": "参与打斗或争吵。",
                        "pl": "Wdawać się w bójkę lub kłótnię."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "драться",
                                "target_lang_sense_clarification": "физически"
                            },
                            {
                                "target_lang_word": "цапаться",
                                "target_lang_sense_clarification": "разг. ссориться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打架",
                                "target_lang_sense_clarification": "指肢体冲突"
                            },
                            {
                                "target_lang_word": "吵架",
                                "target_lang_sense_clarification": "指言语争执"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "bić się",
                                "target_lang_sense_clarification": "fizyczna walka"
                            },
                            {
                                "target_lang_word": "kłócić się",
                                "target_lang_sense_clarification": "werbalny konflikt"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}