                                "example_id": "9807c7ec-de57-450d-a357-c1b90237db8b",
                                "sense_id": "d797041d-05be-3281-9afa-a367cb1f46a7",
                                "text": "„2008 lag der Jahresdurchschnitt für die Hacklerregelung noch bei nur 62.000 Pensionen bzw. bei knapp 58 Prozent der Frühpensionen.“"
                            },
                            {
                                "example_id": "69a4e159-2035-404c-b5c6-90813427f0ca",
                                "sense_id": "d797041d-05be-3281-9afa-a367cb1f46a7",
                                "text": "„Die Arbeitslosenquote ist im Jahresdurchschnitt von 3,3 auf 3,2% zurückgegangen.“"
                            },
                            {
                                "example_id": "5a55ba8c-1561-4098-abba-7c02d365c04d",
                                "sense_id": "d797041d-05be-3281-9afa-a367cb1f46a7",
                                "text": "„40 Mikrogramm je Kubikmeter darf die Luft von den Stickoxiden im Jahresdurchschnitt enthalten.“"
