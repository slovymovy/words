                ],
                "senses": [
                    {
                        "sense_id": "8d860871-0607-38bc-9332-ded749384fa8",
                        "entry_id": "7af7be1c-efab-3967-8c1c-55f148f3a6a6",
                        "glosses": [
                            "italienischer Fahrzeughersteller mit Hauptsitz in Maranello"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3232d56f-5744-4795-8952-10b7e629740e",
                                "sense_id": "8d860871-0607-38bc-9332-ded749384fa8",
                                "text": "„Das ist der teuerste Ferrari und das teuerste Straßenfahrzeug aller Zeiten.“"
                            },
                            {
                                "example_id": "a98b9c71-6888-486f-8e6e-b2d7243c157d",
                                "sense_id": "8d860871-0607-38bc-9332-ded749384fa8",
                                "text": "„Bei Ferrari wartet nun alles auf einen anderen Exweltmeister, auf Fernando Alonso.“"
                            },
                            {
                                "example_id": "d63600d6-b6a6-4d28-9301-ea6871a93d9f",
                                "sense_id": "8d860871-0607-38bc-9332-ded749384fa8",
                                "text": "„Ferrari hat den nächsten Testfahrer für die kommende Formel-1-Saison geholt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4d70274f-df37-3a03-aea6-004e5e33e460",
                        "entry_id": "7af7be1c-efab-3967-8c1c-55f148f3a6a6",
                        "glosses": [
                            "Fahrzeug des Fahrzeugherstellers Ferrari"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "583247e9-c2b2-4140-8c5b-982306b1c646",
                                "sense_id": "4d70274f-df37-3a03-aea6-004e5e33e460",
                                "text": "„Wird mir wirklich ein Ferrari anvertraut, oder sucht der Herr mit dem Pirelli-Kalender an der Wand nur ein Blondchen für den Beifahrersitz?“"
                            },
                            {
                                "example_id": "3bf5f708-76ab-47b1-ae97-6c2931ed3489",
                                "sense_id": "4d70274f-df37-3a03-aea6-004e5e33e460",
                                "text": "„Der Ferrari F12 Berlinetta, 740 PS stark und rund 268.000 Euro teuer, gehört fahrdynamisch und auch preislich sicher zu den exklusivsten Automobilen des Planeten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
