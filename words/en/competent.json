                    "frequency": "VeryLow",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The laboratory used <w>competent</w> cells to ensure the success of the gene cloning experiment.",
                            "target_lang_translations": {
                                "ru": "Лаборатория использовала <w>компетентные</w> клетки для обеспечения успеха эксперимента по клонированию генов.",
                                "tr": "Laboratuvar, gen klonlama deneyinin başarısını sağlamak için <w>kompetan</w> hücreler kullandı."
                            }
                        },
                        {
                            "text": "Researchers are studying how bacteria become <w>competent</w> under stressful conditions.",
                            "target_lang_translations": {
                                "ru": "Исследователи изучают, как бактерии становятся <w>компетентными</w> в стрессовых условиях.",
                                "tr": "Araştırmacılar, bakterilerin stresli koşullar altında nasıl <w>kompetan</w> hale geldiğini inceliyorlar."
                            }
                        }
