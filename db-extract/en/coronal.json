                    {
                        "translation_id": "4352b1bc-af28-43bc-bca8-6770164d6d5c",
                        "source_entry_id": "da7b2762-8c50-3005-b707-f20f52140f22",
                        "source_sense_description": "produced with tip or blade of tongue",
                        "target_lang_word": "koronal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "koronal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "03684803-664e-393c-9459-4208d641bd53",
                                        "entry_id": "1e1abd4d-45c5-329c-b53b-e654e79b57ef",
                                        "glosses": [
                                            "mit dem vorderen Teil der Zunge, dem Zungenkranz (Zungensaum), gebildet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd66ebc5-d26f-4db0-8e48-8b87259a39ff",
                                                "sense_id": "03684803-664e-393c-9459-4208d641bd53",
                                                "text": "Die Laute [m], [p], [b], [f], [v], [n], [t], [d], [s], [z], [ʃ], [ʒ] und die Affrikaten werden im Deutschen koronal gebildet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "58894914-2916-366f-99b2-1ff771e6de7c",
                                        "entry_id": "1e1abd4d-45c5-329c-b53b-e654e79b57ef",
                                        "glosses": [
                                            "die Korona (der Sonne) betreffend oder von ihr stammend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7706efd9-11d5-4eb2-b4e8-ddfd7a89dfd5",
                                                "sense_id": "58894914-2916-366f-99b2-1ff771e6de7c",
                                                "text": "„Die Geschwindigkeit des langsamen Sonnenwinds liegt bei etwa 400 Kilometern pro Sekunde, der schnelle Sonnenwind, der an den koronalen Löchern austritt, erreicht 800–900 Kilometer pro Sekunde […].“"
                                            },
                                            {
                                                "example_id": "d444731a-3483-4b1d-9e71-490ca02be967",
                                                "sense_id": "58894914-2916-366f-99b2-1ff771e6de7c",
                                                "text": "„Gerhard Elwert wandte sich dann der Erforschung der bei den Sonneneruptionen beschleunigten Elektronen und deren Ausbreitung im koronalen Plasma zu.“"
                                            },
                                            {
                                                "example_id": "071f29ba-789e-4296-a081-707fef4ee486",
                                                "sense_id": "58894914-2916-366f-99b2-1ff771e6de7c",
                                                "text": "„Bei Temperaturen von ca. 6000 Grad Celsius in der Photosphäre ist die Strahlung im EUV Bereich nur sehr schwach. Das heiße koronale Plasma ist in Magnetfeldbögen gefangen, sogenannten koronalen Loops.“"
                                            },
                                            {
                                                "example_id": "df0817d2-da40-4dc9-b211-87f3a7ffd01f",
                                                "sense_id": "58894914-2916-366f-99b2-1ff771e6de7c",
                                                "text": "„Während die Formel von Reimers (1977) für den zu erwartenden Massenverlust für stellare Frühphasen, wie insbesondere O-, B-Sterne, Gültigkeit hat, bei denen strahlungsgetriebene Sternwinde vorherrschen, muß im Falle koronal geheizter Sternwinde, wie er bei späteren Sternphase gegeben ist, eine geänderte Abhängigkeit der Massenverlustraten erwartet werden erwartet werden.“"
                                            },
                                            {
                                                "example_id": "8d1e36a9-84bc-418e-a029-206055a6d9be",
                                                "sense_id": "58894914-2916-366f-99b2-1ff771e6de7c",
                                                "text": "„Obwohl man entsprechend ihrem Alter nur eine schwache koronale Emission erwartet, zeigen die RS CVn-Sterne eine sehr starke, variable Emission im weichen Röntgenbereich von L_X⋍10²² bis etwa 3·10²⁴W […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "df57756f-cdf6-3f34-a8ed-a7208c206802",
                                        "entry_id": "1e1abd4d-45c5-329c-b53b-e654e79b57ef",
                                        "glosses": [
                                            "zur Zahnkrone hin (gelegen)"
                                        ],
                                        "tags": [
                                            "Zahnmedizin"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
