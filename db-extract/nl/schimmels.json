                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f94e0ac-10f2-4644-b3f5-f6c1165fff41",
                                                "sense_id": "176e386a-e5b1-3861-9ef2-fb372624448a",
                                                "text": "Nad Hiroszimą unosił się grzyb po wybuchu bomby atomowej."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "2b0a8e3d-bb22-3811-9dfb-19d91cc39696",
                                        "entry_id": "ab12af08-5b42-3ec3-aef4-7cc8db23d148",
                                        "glosses": [
                                            "grzybica, choroba wywoływana przez grzyby (1.1) pasożytnicze"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c291aef4-35e3-4958-a1e2-8fad3feb0546",
                                                "sense_id": "2b0a8e3d-bb22-3811-9dfb-19d91cc39696",
                                                "text": "Wchodziliśmy w klapkach pod prysznice, aby nie złapać grzyba na stopach."
                                            }
