                "senses": [
                    {
                        "sense_id": "5ee6894d-858c-342c-8ebc-abfaaa96ff4e",
                        "entry_id": "e99a4293-d92d-3466-b6d3-357fed738a2c",
                        "glosses": [
                            "Zeitschrift, die ihre Themen hauptsächlich an den Interessen von Mädchen ausrichtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2625c0d0-ad3a-4112-a03b-a67b179e4c26",
                                "sense_id": "5ee6894d-858c-342c-8ebc-abfaaa96ff4e",
                                "text": "„Aber dann, mit fünfzehn, ließ sich das Thema nicht mehr vermeiden, es schien das zu sein, worüber alle sprachen, es war in jeder Mädchenzeitschrift, es war im Fernsehen, und es war Milenas Lieblingsthema: die Liebe.“"
                            },
                            {
                                "example_id": "602e0ff8-1d1a-486a-a88e-ff2c9f7027bd",
                                "sense_id": "5ee6894d-858c-342c-8ebc-abfaaa96ff4e",
                                "text": "„Hans Fallada lernt eine junge Frau kennen, Marianne Portisch, Sportlehrerin aus dem Sudetenland, Schriftleiterin einer nationalsozialistischen Mädchenzeitschrift.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
