    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9741490f-3ca1-30a7-8e27-bbbd79ddc5bf",
                    "sense_definition": "Разговорное обозначение сюрреализма или чего-либо, имеющего сюрреалистический, странный или иррациональный характер.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "сюрреализм",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Происходящее вокруг напоминало настоящий <w>сюр</w>.",
                            "target_lang_translations": {
                                "en": "What was happening around me felt like pure <w>surrealism</w>."
                            }
                        },
                        {
                            "text": "Этот фильм — чистый <w>сюр</w>, который сложно понять с первого раза.",
                            "target_lang_translations": {
                                "en": "This film is pure <w>surrealism</w>, which is hard to understand the first time."
                            }
                        }
                    ],
                    "synonyms": [
                        "сюрреализм"
                    ],
                    "antonyms": [
                        "реал",
                        "реализм"
                    ],
                    "common_phrases": [
                        "полный сюр",
                        "настоящий сюр"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Используется в разговорной речи."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A colloquial term for surrealism or anything that has a surreal, strange, or irrational character."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "surreal",
                                "target_lang_sense_clarification": "referring to a bizarre or dreamlike quality"
                            },
                            {
                                "target_lang_word": "surrealism",
                                "target_lang_sense_clarification": "the artistic or literary movement"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7b0c191-506b-3628-a0a8-2e9baf587530",
                    "sense_definition": "Абсурдная, нелепая или странная ситуация, выходящая за рамки логики.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "сюрреализм",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вся эта ситуация — какой-то <w>сюр</w>.",
                            "target_lang_translations": {
                                "en": "This whole situation is just <w>absurd</w>."
                            }
                        },
                        {
                            "text": "Происходящий <w>сюр</w> не поддается никакому логическому объяснению.",
                            "target_lang_translations": {
                                "en": "The <w>absurdity</w> taking place defies any logical explanation."
                            }
                        }
                    ],
                    "synonyms": [
                        "абсу́рд"
                    ],
                    "common_phrases": [
                        "сплошной сюр"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Используется в разговорной речи."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An absurd, ridiculous, or strange situation that goes beyond the bounds of logic."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "absurdity",
                                "target_lang_sense_clarification": "the quality of being wildly unreasonable or illogical"
                            },
                            {
                                "target_lang_word": "surreal situation",
                                "target_lang_sense_clarification": "a state of affairs that feels dreamlike or bizarre"
                            }
                        ]
                    }
                }
            ]
        }
    ]
