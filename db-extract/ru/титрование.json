                        "target_lang_word": "Titration",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Titration",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0e3d7733-1769-32e4-a2cc-8398e3708924",
                                        "entry_id": "873d4691-a01a-3656-bd7c-970c8c5b105a",
                                        "glosses": [
                                            "Messmethode, bei der Massen durch Volumenmessungen bestimmt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41c20e2a-8990-41fb-aec1-d1ed4a2a1282",
                                                "sense_id": "0e3d7733-1769-32e4-a2cc-8398e3708924",
                                                "text": "„Vor Beginn der eigentlichen Titration wird der Gehalt der Maßlösung genau bestimmt und ein Korrekturfaktor, der sogenannte Titer ermittelt, um die Genauigkeit der Messung zu erhöhen.“"
                                            },
                                            {
                                                "example_id": "9905b6bf-7600-46ee-b6ac-d83774ed74e2",
                                                "sense_id": "0e3d7733-1769-32e4-a2cc-8398e3708924",
                                                "text": "„Sie macht das, wie der Chemiker beim Experiment der Titration: Tropfen für Tropfen verändert sie die Ausgangslösung; und auf einmal schlägt die Farbe um.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
