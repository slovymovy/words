                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8b214da-6c16-4c4a-b540-1d452ef18bfb",
                                                "sense_id": "b17f1547-d515-3e46-a15b-ff4199b93ecf",
                                                "text": "Die Fee im Märchen entzaubert den Bären, der in Wirklichkeit ein Prinz ist."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "57a57e9c-3d2f-3220-868d-06a9fe222b1f",
