                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85d690cc-63c7-4a8c-b750-edec48346c55",
                                "sense_id": "fe713ead-c746-3d29-9be0-4761b9d221a8",
                                "text": "[…] pebbles of vast size, or blocks of stone, attrited by water to smoothness, conjoined by a cement of mud."
                            }
                        ]
                    },
                    {
                        "sense_id": "31459f0b-0529-3c88-a21d-e5c0e7dcce8e",
                        "entry_id": "7ac7e189-f8d0-309d-9c95-64a00c8c0523",
                        "glosses": [
                            "To engage in attrition; to quit or drop out."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4ae4464-7873-48bf-9719-c524093368a6",
                                "sense_id": "31459f0b-0529-3c88-a21d-e5c0e7dcce8e",
                                "text": "the relatives who had been helping slipped away as I grew older, attriting for various reasons that all amounted to the same reason."
                            }
                        ]
                    },
                    {
                        "sense_id": "898f3393-8978-33ea-8e8f-70eb989d0daf",
                        "entry_id": "7ac7e189-f8d0-309d-9c95-64a00c8c0523",
                        "glosses": [
                            "To be reduced in quantity through attrition."
