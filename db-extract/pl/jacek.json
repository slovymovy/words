                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e96dfb3-acc5-4aab-8b77-de8353c7b31a",
                                                "sense_id": "f990f85b-f2b6-3665-a814-958502855c27",
                                                "text": "Hyacinthe, qui entrait, serra la main de Gérard, d’un air de lassitude."
                                            },
                                            {
                                                "example_id": "b4107789-61a1-496c-b018-25da2863a60a",
                                                "sense_id": "f990f85b-f2b6-3665-a814-958502855c27",
                                                "text": "Trente ans de prison ont également été requis contre Hyacinthe Kafando, l’ancien commandant de la garde de M. Compaoré, autre grand absent de ce procès, car il est en fuite depuis 2016."
                                            }
                                        ]
                                    }
