                "senses": [
                    {
                        "sense_id": "d2ac3fe3-c48e-31d2-bca2-a14a27364d05",
                        "entry_id": "e6e31dc0-abfe-33c2-9bab-791743665b87",
                        "glosses": [
                            "großes hohes Möbelstück in einem Vorzimmer zur verschlossenen Aufbewahrung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa843921-2f57-4eee-add0-f4189874bbf1",
                                "sense_id": "d2ac3fe3-c48e-31d2-bca2-a14a27364d05",
                                "text": "„In einer Lade im Vorzimmerschrank lag ein Paar Glaceehandschuhe in Schwarz und ein goldenes Feuerzeug.“"
                            },
                            {
                                "example_id": "c8109717-1bea-488e-be17-03079263bf7d",
                                "sense_id": "d2ac3fe3-c48e-31d2-bca2-a14a27364d05",
                                "text": "„Das vorausgeschickte Gepäck stand im Vorraum und so konnte sie ungehindert beginnen, ihre Sachen in den schmalen wenn es Vorzimmerschrank einzuordnen.“"
                            },
                            {
                                "example_id": "b0451622-a4d3-45cd-ac42-1dc720056d54",
                                "sense_id": "d2ac3fe3-c48e-31d2-bca2-a14a27364d05",
                                "text": "„Ein Paar Sommerschuhe und ein Paar Winterschuhe blieben im Vorzimmerschrank, alle anderen wurden entsorgt.“"
                            },
                            {
                                "example_id": "ed9e5a92-01d9-4028-8052-ef8c97ae018a",
                                "sense_id": "d2ac3fe3-c48e-31d2-bca2-a14a27364d05",
                                "text": "„Im Vorzimmerschrank fand sich ein alter Pyjama ihres Vaters mit ausgeleiertem Hosenbund, der sich auf zwei Armlängen dehnen ließ.“"
                            },
                            {
                                "example_id": "5416b919-3cde-46ba-81a4-2996f64e0302",
                                "sense_id": "d2ac3fe3-c48e-31d2-bca2-a14a27364d05",
                                "text": "„Sie öffnete den Vorzimmerschrank und hob einen abgeschabten dunkelbraunen Lederkoffer heraus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
