                "senses": [
                    {
                        "sense_id": "1e8be43e-a743-3bf9-902e-16b74fa5eebd",
                        "entry_id": "9411d8ae-b219-3b39-85f5-a9936533393d",
                        "glosses": [
                            "Gesamtheit aller Unterstützungs- und Schnellreaktionseinheiten der Polizeikräfte als geschlossene Einheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54573465-24d3-4f75-a787-5491b0313930",
                                "sense_id": "1e8be43e-a743-3bf9-902e-16b74fa5eebd",
                                "text": "„Auch die Männer von der Bereitschaftspolizei und die, die von anderen District-Commanders wegen des Tods eines Mädchens ans Morddezernat ausgeliehen worden waren, sind zu ihren Dienststellen zurückgekehrt.“"
                            },
                            {
                                "example_id": "f503d9dc-584a-4084-ad7a-f079c110059a",
                                "sense_id": "1e8be43e-a743-3bf9-902e-16b74fa5eebd",
                                "text": "„Maxwells Stimme schlängelte sich durch eine Halluzination, in der ein Aufgebot der New Yorker Bereitschaftspolizei auf dem Schauplatz erschien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
