{
    "word_family": [
        "ruination",
        "ruinous",
        "ruined",
        "ruiner"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d93a0c9d-5031-3222-9501-1e68ca1c8e09",
                    "sense_definition": "To destroy or damage something so badly that it is no longer usable or functional.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>ruined</w> his new white pants by accidentally spilling oil on them during the party.",
                            "target_lang_translations": {
                                "ru": "Он <w>испортил</w> свои новые белые брюки, случайно пролив на них масло во время вечеринки."
                            }
                        },
                        {
                            "text": "The heavy rain will <w>ruin</w> the crops if it does not stop soon.",
                            "target_lang_translations": {
                                "ru": "Сильный дождь <w>погубит</w> урожай, если скоро не прекратится."
                            }
                        }
                    ],
                    "synonyms": [
                        "destroy",
                        "wreck"
                    ],
                    "common_phrases": [
                        "ruin the crops",
                        "ruin the furniture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разрушить или повредить что-либо настолько сильно, что оно становится непригодным для использования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испортить",
                                "target_lang_sense_clarification": "сделать негодным или некрасивым"
                            },
                            {
                                "target_lang_word": "разрушить",
                                "target_lang_sense_clarification": "сломать или привести в негодность"
                            },
                            {
                                "target_lang_word": "погубить",
                                "target_lang_sense_clarification": "уничтожить, например, урожай"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a6672f8-5e1f-30e2-bc4c-b2af47641870",
                    "sense_definition": "To make an experience or situation much less enjoyable or pleasant.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "spoil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The loud noise from the construction site <w>ruined</w> the mood of our quiet dinner.",
                            "target_lang_translations": {
                                "ru": "Шум со стройки <w>испортил</w> атмосферу нашего тихого ужина."
                            }
                        },
                        {
                            "text": "Don't let one small mistake <w>ruin</w> the day for everyone else.",
                            "target_lang_translations": {
                                "ru": "Не позволяй одной маленькой ошибке <w>испортить</w> день всем остальным."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ruin the mood",
                        "ruin the day",
                        "ruin the surprise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать какой-либо опыт или ситуацию гораздо менее приятными."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испортить",
                                "target_lang_sense_clarification": "сделать менее приятным (настроение, день)"
                            },
                            {
                                "target_lang_word": "отравить",
                                "target_lang_sense_clarification": "сделать неприятным (существование, момент)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10e0deef-c189-3b86-8ff3-b2995f3b38f6",
                    "sense_definition": "To cause the failure of a plan, project, or progress.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "failure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My car breaking down just as I was starting my trip <w>ruined</w> my vacation plans.",
                            "target_lang_translations": {
                                "ru": "Поломка машины в самом начале поездки <w>разрушила</w> мои планы на отпуск."
                            }
                        },
                        {
                            "text": "A sudden change in the weather could <w>ruin</w> the plans for the outdoor wedding.",
                            "target_lang_translations": {
                                "ru": "Внезапная перемена погоды может <w>расстроить</w> планы на свадьбу под открытым небом."
                            }
                        }
                    ],
                    "synonyms": [
                        "undo",
                        "wreck"
                    ],
                    "common_phrases": [
                        "ruin my plans",
                        "ruin the vacation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стать причиной неудачи плана, проекта или прогресса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разрушить",
                                "target_lang_sense_clarification": "сорвать планы или надежды"
                            },
                            {
                                "target_lang_word": "испортить",
                                "target_lang_sense_clarification": "помешать успешному выполнению"
                            },
                            {
                                "target_lang_word": "расстроить",
                                "target_lang_sense_clarification": "нарушить порядок или планы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "472ebb51-7d41-377a-a2d3-40251244800e",
                    "sense_definition": "To cause someone or a business to lose all their money or go bankrupt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "financial_loss",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The massive lawsuit threatened to <w>ruin</w> the company and all its employees.",
                            "target_lang_translations": {
                                "ru": "Масштабный судебный иск грозил <w>разорить</w> компанию и всех её сотрудников."
                            }
                        },
                        {
                            "text": "If you continue to spend money like this, you will <w>ruin</w> us financially.",
                            "target_lang_translations": {
                                "ru": "Если ты продолжишь так тратить деньги, ты <w>разоришь</w> нас."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ruin us financially",
                        "ruin the business"
                    ],
                    "target_lang_definitions": {
                        "ru": "Привести человека или бизнес к потере всех денег или банкротству."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разорить",
                                "target_lang_sense_clarification": "лишить достатка, ввергнуть в нищету"
                            },
                            {
                                "target_lang_word": "погубить",
                                "target_lang_sense_clarification": "финансово уничтожить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b387bb1-3953-3fb7-a951-77740291c66b",
                    "sense_definition": "To reveal the ending or a secret part of a story, movie, or book before someone has seen it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spoil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please don't <w>ruin</w> the ending of the movie for me; I haven't seen it yet.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не <w>порть</w> мне концовку фильма, я его ещё не видел."
                            }
                        },
                        {
                            "text": "He accidentally <w>ruined</w> the book by telling me who the killer was.",
                            "target_lang_translations": {
                                "ru": "Он случайно <w>испортил</w> всё впечатление от книги, рассказав мне, кто был убийцей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ruin the ending",
                        "ruin the movie"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used interchangeably with 'spoil'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Раскрыть концовку или секретную часть истории, фильма или книги до того, как человек их увидел."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испортить",
                                "target_lang_sense_clarification": "раскрыть интригу или финал"
                            },
                            {
                                "target_lang_word": "заспойлерить",
                                "target_lang_sense_clarification": "сленг: раскрыть сюжет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6a91182-e5c5-333d-a715-c83286e57646",
                    "sense_definition": "To damage someone's reputation or social standing, historically through seduction.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reputation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the novel, the villain sought to <w>ruin</w> her reputation through lies and scandal.",
                            "target_lang_translations": {
                                "ru": "В романе злодей стремился <w>погубить</w> её репутацию с помощью лжи и скандалов."
                            }
                        },
                        {
                            "text": "The scandal <w>ruined</w> his reputation and forced him to resign from office.",
                            "target_lang_translations": {
                                "ru": "Скандал <w>разрушил</w> его репутацию и вынудил его уйти в отставку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ruin a reputation"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often used in historical or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нанести ущерб чьей-либо репутации или социальному положению."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "погубить",
                                "target_lang_sense_clarification": "уничтожить репутацию"
                            },
                            {
                                "target_lang_word": "опорочить",
                                "target_lang_sense_clarification": "нанести вред доброму имени"
                            },
                            {
                                "target_lang_word": "разрушить",
                                "target_lang_sense_clarification": "уничтожить положение в обществе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "94c29fc2-c1da-37e1-bb41-a9d95da22a3f",
                    "sense_definition": "The physical remains of a building or structure that has been destroyed or has fallen into decay.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "remains",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We spent the afternoon exploring the ancient <w>ruins</w> of the Roman temple.",
                            "target_lang_translations": {
                                "ru": "Мы провели вторую половину дня, исследуя древние <w>руины</w> римского храма."
                            }
                        },
                        {
                            "text": "The castle is now a beautiful <w>ruin</w> overlooking the valley.",
                            "target_lang_translations": {
                                "ru": "Замок теперь представляет собой живописные <w>развалины</w>, возвышающиеся над долиной."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ancient ruins",
                        "castle ruins",
                        "roman ruins"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физические остатки здания или сооружения, которое было разрушено или пришло в упадок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "руины",
                                "target_lang_sense_clarification": "остатки строения"
                            },
                            {
                                "target_lang_word": "развалины",
                                "target_lang_sense_clarification": "ветхое, разрушенное здание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be9d8b39-98c8-3a9e-8b61-36bf0306a8f8",
                    "sense_definition": "A state of complete destruction, decay, or neglect.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old mansion has fallen into <w>ruin</w> after being abandoned for decades.",
                            "target_lang_translations": {
                                "ru": "Старый особняк пришел в <w>упадок</w> после того, как был заброшен на десятилетия."
                            }
                        },
                        {
                            "text": "The city lay in <w>ruin</w> after the devastating earthquake.",
                            "target_lang_translations": {
                                "ru": "Город лежал в <w>руинах</w> после разрушительного землетрясения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fall into ruin",
                        "lay in ruin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние полного разрушения, упадка или запустения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разруха",
                                "target_lang_sense_clarification": "полный развал в хозяйстве"
                            },
                            {
                                "target_lang_word": "запустение",
                                "target_lang_sense_clarification": "состояние заброшенности"
                            },
                            {
                                "target_lang_word": "упадок",
                                "target_lang_sense_clarification": "состояние разрушения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97c971e0-22b4-301b-82d5-8089bfc850f1",
                    "sense_definition": "The cause of someone's failure, downfall, or destruction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "downfall",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His obsession with gambling was the <w>ruin</w> of his entire family.",
                            "target_lang_translations": {
                                "ru": "Его страсть к азартным играм стала <w>гибелью</w> для всей его семьи."
                            }
                        },
                        {
                            "text": "Arrogance has been the <w>ruin</w> of many powerful leaders throughout history.",
                            "target_lang_translations": {
                                "ru": "Высокомерие становилось причиной <w>краха</w> многих могущественных лидеров на протяжении истории."
                            }
                        }
                    ],
                    "common_phrases": [
                        "the ruin of many",
                        "be the ruin of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причина чьей-либо неудачи, падения или гибели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гибель",
                                "target_lang_sense_clarification": "причина краха или смерти"
                            },
                            {
                                "target_lang_word": "проклятие",
                                "target_lang_sense_clarification": "то, что ведет к беде"
                            },
                            {
                                "target_lang_word": "крах",
                                "target_lang_sense_clarification": "причина полного провала"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a58c61a8-478a-30b7-8d7e-fef8837da70e",
                    "sense_definition": "The state of having lost all one's money; total financial failure.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "financial_loss",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stock market crash brought financial <w>ruin</w> to thousands of investors.",
                            "target_lang_translations": {
                                "ru": "Крах фондового рынка принес финансовое <w>разорение</w> тысячам инвесторов."
                            }
                        },
                        {
                            "text": "He faced total <w>ruin</w> after his business venture failed unexpectedly.",
                            "target_lang_translations": {
                                "ru": "Он столкнулся с полным <w>крахом</w> после того, как его бизнес-проект неожиданно провалился."
                            }
                        }
                    ],
                    "common_phrases": [
                        "financial ruin",
                        "total ruin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние потери всех денег; полный финансовый крах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разорение",
                                "target_lang_sense_clarification": "процесс или результат потери богатства"
                            },
                            {
                                "target_lang_word": "крах",
                                "target_lang_sense_clarification": "банкротство, финансовый провал"
                            },
                            {
                                "target_lang_word": "банкротство",
                                "target_lang_sense_clarification": "официальная неплатежеспособность"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}