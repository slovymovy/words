                                    {
                                        "sense_id": "02e13712-3be2-35a4-9ba7-c9eaba5284dc",
                                        "entry_id": "bbbc9fb2-4d30-385a-bc81-2a6b65c99b59",
                                        "glosses": [
                                            "свойство или состояние по значению прилагательного конусный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "683f8c46-7db8-496e-a00b-fef308212c19",
                                                "sense_id": "02e13712-3be2-35a4-9ba7-c9eaba5284dc",
                                                "text": "Износ шеек и цапф обычно сопровождается изменением их формы: появляются конусность или эллипсность."
                                            }
                                        ]
                                    }
