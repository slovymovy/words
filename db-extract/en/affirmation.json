    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b15152d1-bace-394e-b16f-b514db1b3642",
                "word": "affirmation",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "1cbeab3e-44a1-4590-af34-902b349c8f1e",
                        "entry_id": "b15152d1-bace-394e-b16f-b514db1b3642",
                        "tags": [
                            "plural"
                        ],
                        "form": "affirmations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "62e1a551-aca9-358f-949a-7512f8d53566",
                        "entry_id": "b15152d1-bace-394e-b16f-b514db1b3642",
                        "glosses": [
                            "That which is affirmed; a declaration that something is true."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1fcaddb5-295e-47ea-9cbc-effb2e5e1b5f",
                                "sense_id": "62e1a551-aca9-358f-949a-7512f8d53566",
                                "text": "Her success was an affirmation of all her hard work."
                            },
                            {
                                "example_id": "5547ab3a-bbc2-480e-ab53-d577b6b2807f",
                                "sense_id": "62e1a551-aca9-358f-949a-7512f8d53566",
                                "text": "The ceremony included an affirmation of loyalty."
                            }
                        ]
                    },
                    {
                        "sense_id": "0c14eb8a-12d8-3aa4-8b86-6325759cff92",
                        "entry_id": "b15152d1-bace-394e-b16f-b514db1b3642",
                        "glosses": [
                            "A solemn pledge (to tell the truth, to bear allegiance, etc.), legally equivalent to an oath, taken by people who are forbidden to take a religious oath (such as Quakers) or otherwise prefer not to do so."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "661d771e-d95d-36d6-a74f-2e93fcdbab69",
                        "entry_id": "b15152d1-bace-394e-b16f-b514db1b3642",
                        "glosses": [
                            "A form of self-forced meditation or repetition; autosuggestion."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "747baf9c-97fe-4f33-8cb4-efc2a30fda64",
                                "sense_id": "661d771e-d95d-36d6-a74f-2e93fcdbab69",
                                "text": "Daily positive affirmations can improve self-confidence."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "abad87ae-610d-4126-9fe0-c579f8bed4d0",
                        "source_entry_id": "b15152d1-bace-394e-b16f-b514db1b3642",
                        "source_sense_description": "that which is affirmed",
                        "target_lang_word": "affirmation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "affirmation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b18b7448-c5bf-3ef8-9dc4-4dab16d39904",
                                        "entry_id": "2f6486f7-0c9a-3865-abf3-af992573c981",
                                        "glosses": [
                                            "Action d’affirmer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "040e0f28-f61c-4077-ae37-b3c80e4939ca",
                                                "sense_id": "b18b7448-c5bf-3ef8-9dc4-4dab16d39904",
                                                "text": "De l’autre côté, quelques-uns parmi nous discutaient s'il fallait ajouter foi aux affirmations du criminel qui s'était montré menteur incorrigible."
                                            },
                                            {
                                                "example_id": "ac531346-d92d-4fba-b755-7bdd022d48f8",
                                                "sense_id": "b18b7448-c5bf-3ef8-9dc4-4dab16d39904",
                                                "text": "Sommeil impossible pour quatre, car Laurent ronfle. Nous vérifions enfin sur lui l'affirmation classique des ronfleurs qui ne ronflent prétendent-ils, que couchés sur le dos. Les ronfleurs sont des menteurs : Laurent ronfle quand nous le tournons sur le côté droit, et sur le côté gauche, et sur le ventre."
                                            },
                                            {
                                                "example_id": "5172583c-0e8a-44e4-a517-f2249e89d56d",
                                                "sense_id": "b18b7448-c5bf-3ef8-9dc4-4dab16d39904",
                                                "text": "Sous les instances de deux officiers, je renonce à aller voir si les deux autres passerelles du génie existent, malgré les affirmations contraires des officiers relevés."
                                            },
                                            {
                                                "example_id": "b36e2c31-ebab-4b30-a355-909cb7108d39",
                                                "sense_id": "b18b7448-c5bf-3ef8-9dc4-4dab16d39904",
                                                "text": "Il est donc légitime lorsque la foi et la raison semblent en désaccord, de tenir pour vraies les affirmations de la foi, puisque le miracle est chose toujours réalisable pour un Dieu tout-puissant."
                                            },
                                            {
                                                "example_id": "2c84c212-fceb-4bd8-96df-bddb447a4910",
                                                "sense_id": "b18b7448-c5bf-3ef8-9dc4-4dab16d39904",
                                                "text": "Une longue fréquentation des ouvrages ésotériques m’a souvent fait croiser des ouvrages bourrés d’affirmations non vérifiées et contraires à toute démarche scientifique, garnis de citations introuvables, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf91fdf2-dfbe-3ad6-bc04-1eb54de7f48a",
                                        "entry_id": "2f6486f7-0c9a-3865-abf3-af992573c981",
                                        "glosses": [
                                            "Expression par laquelle une proposition est affirmative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "251ea4bc-caaa-4464-9409-e6a8c2d4c70b",
                                                "sense_id": "cf91fdf2-dfbe-3ad6-bc04-1eb54de7f48a",
                                                "text": "L’affirmation est opposée à la négation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bd097be-5602-30b3-a913-6d43b97dc911",
                                        "entry_id": "2f6486f7-0c9a-3865-abf3-af992573c981",
                                        "glosses": [
                                            "Assurance avec serment et dans les formes juridiques."
                                        ],
                                        "tags": [
                                            "Justice"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "937aa36b-df49-4ed5-b4fa-876b641c20b5",
                                                "sense_id": "5bd097be-5602-30b3-a913-6d43b97dc911",
                                                "text": "Prendre un acte d’affirmation."
                                            },
                                            {
                                                "example_id": "df46f199-ee0f-4ddc-bf3b-8d1b42b6a73a",
                                                "sense_id": "5bd097be-5602-30b3-a913-6d43b97dc911",
                                                "text": "Je m’en rapporte à votre affirmation."
                                            },
                                            {
                                                "example_id": "8d64aaf0-64e4-4486-8223-861879753fa2",
                                                "sense_id": "5bd097be-5602-30b3-a913-6d43b97dc911",
                                                "text": "Affirmation de compte."
                                            },
                                            {
                                                "example_id": "03d72c35-8e96-451d-b12b-85c9b0d103c0",
                                                "sense_id": "5bd097be-5602-30b3-a913-6d43b97dc911",
                                                "text": "Le juge a pris leur affirmation."
                                            },
                                            {
                                                "example_id": "0aa6ada8-d827-4b0e-be8f-dbd4d108b058",
                                                "sense_id": "5bd097be-5602-30b3-a913-6d43b97dc911",
                                                "text": "Le greffe des affirmations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b113a12-8246-4f4f-b27c-c29c23083479",
                        "source_entry_id": "b15152d1-bace-394e-b16f-b514db1b3642",
