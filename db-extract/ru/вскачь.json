                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "au galop",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "71e39426-e0f2-3dd1-9d80-cd207e11a2e9",
                                        "entry_id": "a16b6504-5e88-3877-812c-6a589c6c510c",
                                        "glosses": [
                                            "Dans une allure de galop rapide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b68ae880-3b03-4aad-b716-32f831acc379",
                                                "sense_id": "71e39426-e0f2-3dd1-9d80-cd207e11a2e9",
                                                "text": "Portés, au galop d'abord, puis au trot par Eponine et Sultan, ils ont gagné le plateau et les herbages de Saint-Marc-Jaumegarde où ils ont rencontré, à la sortie du village et dans son domaine, le sieur Aurélien Fontenac éleveur de chevaux, cavalier émérite et maître de manège : « […] »."
                                            },
                                            {
                                                "example_id": "6e566280-4525-40e1-8f34-77804623a79c",
                                                "sense_id": "71e39426-e0f2-3dd1-9d80-cd207e11a2e9",
                                                "text": "Il poussa son cheval au galop, coupant ainsi court à la conversation qui n’avait déjà que trop duré."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3abaaac-5944-350e-bded-0227a9ff271d",
                                        "entry_id": "a16b6504-5e88-3877-812c-6a589c6c510c",
                                        "glosses": [
                                            "Rapidement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f57dddc-3711-4481-8c71-435709b05a6b",
                                                "sense_id": "d3abaaac-5944-350e-bded-0227a9ff271d",
                                                "text": "Il faut, pour ne pas se perdre dans les méandres de sa pensée, le lire d’abord au galop afin de saisir l’idée générale de chaque phrase, puis reprendre cette phrase plus lentement pour en examiner le détail qui est souvent beau."
                                            },
                                            {
                                                "example_id": "2442f63c-8198-4311-a592-23583452a33b",
                                                "sense_id": "d3abaaac-5944-350e-bded-0227a9ff271d",
                                                "text": "Il fit la connaissance d’Anne-Marie Schweitzer, s’empara de cette grande fille délaissée, l’épousa, lui fit un enfant au galop, moi, et tenta de se réfugier dans la mort."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
