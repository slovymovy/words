                    },
                    {
                        "translation_id": "ceeb7a75-bff0-416d-ad4b-06ffb11e5ca8",
                        "source_entry_id": "79d4fa63-6b4d-3670-a2bd-16a17a4eb11e",
                        "source_sense_description": "функция, определенная для матриц",
                        "target_lang_word": "permanent",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "permanent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f740980a-8fb7-3498-b72b-7b05ccaf7947",
                                        "entry_id": "d992932e-0721-385f-9154-cb046bcc44cd",
                                        "glosses": [
                                            "Qui est stable, immuable, qui dure sans changer, qui dure constamment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12e78af7-c5b0-4429-95c4-e0f2b077739d",
                                                "sense_id": "f740980a-8fb7-3498-b72b-7b05ccaf7947",
                                                "text": "Il n’y a point ici-bas de félicité permanente."
                                            },
                                            {
                                                "example_id": "31395321-9515-4628-81a4-09dfe88bd3ac",
                                                "sense_id": "f740980a-8fb7-3498-b72b-7b05ccaf7947",
                                                "text": "L’homme sage est permanent comme le soleil ; le fou change comme la lune."
                                            },
                                            {
                                                "example_id": "8b2e5363-3cab-4893-ac61-6f94b1d3e2ac",
                                                "sense_id": "f740980a-8fb7-3498-b72b-7b05ccaf7947",
                                                "text": "On voit par là combien il [Richelieu] savait soumettre l’insolence de ses passions passagères à l’intérêt permanent de sa politique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c91e2da7-8378-3177-9324-0e2e43ee85c9",
                                        "entry_id": "d992932e-0721-385f-9154-cb046bcc44cd",
                                        "glosses": [
                                            "Qui est à demeure ; par opposition à temporaire ou passager."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "583bbd6b-af26-4c95-8cbc-b0b5f16635ca",
                                                "sense_id": "c91e2da7-8378-3177-9324-0e2e43ee85c9",
                                                "text": "Fortification permanente, par opposition à fortification passagère, fortification qui a pour objet de renforcer des positions qu’un État a un intérêt majeur et permanent à garder."
                                            },
                                            {
                                                "example_id": "7a06b4fc-c837-40cc-847e-5eaceac8816c",
                                                "sense_id": "c91e2da7-8378-3177-9324-0e2e43ee85c9",
                                                "text": "Les collections permanentes du Musée présentent une sélection de ses sculptures."
                                            },
                                            {
                                                "example_id": "be69d392-2a32-46b1-9a60-105cb6743652",
                                                "sense_id": "c91e2da7-8378-3177-9324-0e2e43ee85c9",
                                                "text": "Ce bâtiment historique présente une exposition permanente intitulée « Vive Espoo »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51dfa7e2-546b-3fb5-ae40-0b6520e8fe48",
                                        "entry_id": "d992932e-0721-385f-9154-cb046bcc44cd",
                                        "glosses": [
                                            "Qui est constamment en fonctions, en organisation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8843a1cd-68fd-499b-8678-c22b01bbcf65",
                                                "sense_id": "51dfa7e2-546b-3fb5-ae40-0b6520e8fe48",
                                                "text": "Assemblées permanentes."
                                            },
                                            {
                                                "example_id": "dc3d9daf-723c-4119-a786-0dec847bef75",
                                                "sense_id": "51dfa7e2-546b-3fb5-ae40-0b6520e8fe48",
                                                "text": "Armée permanente, armée qui existe en temps de paix comme en temps de guerre."
                                            }
