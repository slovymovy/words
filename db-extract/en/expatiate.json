                                                "sense_id": "9eb5285e-d27e-3d88-a8e6-d022b19bc836",
                                                "text": "Er werd eindeloos uitgeweid over de klimaatsproblemen, maar tot weinig actie besloten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "594a9bb8-f305-3ccb-ba0b-700190c8f4ce",
                                        "entry_id": "6be47a8a-79b2-3bce-9798-eb39393c8b90",
                                        "glosses": [
                                            "de ingewanden van dieren verwijderen en over het land verspreiden"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5303578c-712b-4e91-b542-4f8865e19db1",
                                                "sense_id": "594a9bb8-f305-3ccb-ba0b-700190c8f4ce",
                                                "text": "Ingewanden, kunnen die nog zo maar uitgeweid worden?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
