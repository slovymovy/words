                                "example_id": "a322bbf0-8d64-4c94-9cf9-6d19a740840c",
                                "sense_id": "5a16b09f-320a-33ef-b30c-f049e0f0d7b6",
                                "text": "Je fais un passage de temps à autre avant de réhiberner."
                            }
