                            "comment": "used in drug subculture"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Slang name for narcotic substances from hemp (marijuana, hashish).",
                        "de": "Slangbegriff für aus Hanf gewonnene Rauschmittel (Marihuana, Haschisch)."
                    },
                    "translations": {
