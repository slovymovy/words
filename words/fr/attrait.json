                    "frequency": "Middle",
                    "semantic_group_id": "attirance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le poète décrivait les nombreux <w>attraits</w> de la jeune femme dans ses vers passionnés."
                        },
                        {
                            "text": "Malgré les années qui passent, elle a conservé tous ses <w>attraits</w> de jeunesse."
                        }
                    ],
                    "synonyms": [
                        "charme"
                    ],
                    "common_phrases": [
