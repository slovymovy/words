                        "source_entry_id": "b9f228de-b72a-3e9e-b926-9bb54bfaf18f",
                        "source_sense_id": "7d92d586-83fc-3607-a137-5287791873c2",
                        "target_lang_word": "service road",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "service road",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c74794b-bb91-3b34-9051-c8fc3305037e",
                                        "entry_id": "721f6da4-0146-3294-8107-729e9a361f3d",
                                        "glosses": [
                                            "A relatively narrow road which runs alongside a major transportation route, such as a canal, a railway line, or a controlled-access highway."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c892bb8-60e4-46eb-9513-2d04db262764",
                                                "sense_id": "2c74794b-bb91-3b34-9051-c8fc3305037e",
                                                "text": "[I]t can only pinpoint phones to within a few hundred feet. That makes it difficult to tell if a signal is coming from a vehicle on the highway or from one on a parallel service road."
                                            },
                                            {
                                                "example_id": "8f827071-0924-41be-9c97-1de3ca4294f9",
                                                "sense_id": "2c74794b-bb91-3b34-9051-c8fc3305037e",
                                                "text": "RCMP issued a news release reporting that a passing motorist had found a woman's body in a ditch next to a service road adjacent to Highway 16."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b32623a3-8a83-39a9-9988-1a6909f42835",
                                        "entry_id": "721f6da4-0146-3294-8107-729e9a361f3d",
                                        "glosses": [
                                            "A route which enters or circulates through an institution, compound, land area, etc. for purposes of private access, maintenance, or security."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b1c9d90-df8b-46e8-ac89-298f1d5e1475",
                                                "sense_id": "b32623a3-8a83-39a9-9988-1a6909f42835",
                                                "text": "From the day-use area behind Longmire Lodge, we walked up the service road behind the ranger station and employee housing."
                                            },
                                            {
                                                "example_id": "ec27aa6a-9b14-4db9-ba38-04cdd1af9d5a",
                                                "sense_id": "b32623a3-8a83-39a9-9988-1a6909f42835",
                                                "text": "Large steel columns from the fallen World Trade Center have been found beneath a service road being excavated at Ground Zero."
                                            },
                                            {
                                                "example_id": "85a23ee2-65da-42da-91be-b9ffcb8712f0",
                                                "sense_id": "b32623a3-8a83-39a9-9988-1a6909f42835",
                                                "text": "We walk the service road, past the stables, up the slope, to where the watermill stands."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
