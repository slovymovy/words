                "senses": [
                    {
                        "sense_id": "14c7212e-a159-39fb-90eb-e3858b2a8ee5",
                        "entry_id": "587584b0-1f2b-37e4-905c-e8e6a98e12fe",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным туризм"
