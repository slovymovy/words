                        "glosses": [
                            "Bouillie à base d’avoine, principalement servie au repas du matin."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "589067ac-406c-4aae-af33-e9cb4a82d5e2",
                                "sense_id": "6474b66f-fe90-38f9-8e13-5ce67f6c7974",
                                "text": "C'est à qui aura le plus gros morceau et à qui aura la mesure la plus pleine, soit de soupane, soit de soupe ou de thé."
                            },
                            {
                                "example_id": "7cc053f3-9a9a-44f8-b250-3f55fd267a44",
                                "sense_id": "6474b66f-fe90-38f9-8e13-5ce67f6c7974",
                                "text": "Il y avait bien peu de mets où l'on n’ajoutât pas de mélasse, les bouillies de farine de maïs et de lait appelées soupanes, les crêpes de blé, les fèves au lard et même les viandes se couvraient de mélasse ; les tartines se trempent de mélasse."
                            }
                        ]
                    }
