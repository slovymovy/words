                                        "glosses": [
                                            "Anteil einer Sache an einem Ganzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2323ddb-7b41-4be3-91fb-75985f10b9e8",
                                                "sense_id": "b5f9ad0b-9301-3c11-a94f-55675365ce30",
                                                "text": "Die Quote der Studienabbrecher sank im letzten Jahr um 3 Prozent."
                                            },
                                            {
                                                "example_id": "3ef37e48-81ce-4780-a214-396b5be4234b",
                                                "sense_id": "b5f9ad0b-9301-3c11-a94f-55675365ce30",
                                                "text": "[Angela Merkel:] „»Ich war damals jung. Ich war Frau und kam aus dem Osten. Das war dreifach Quote. Und ich war gut verwendbar, sagen wir mal so.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7a4a585f-bcc7-3241-b932-a8d6f5d7958f",
                                        "entry_id": "95d61fab-5ba2-3fd2-8124-fde529ebfb5f",
                                        "glosses": [
                                            "Anteil der Fernsehzuschauer, die ein bestimmtes Programm anschauen; Kurzform von Einschaltquote"
