                "senses": [
                    {
                        "sense_id": "cb1758e2-1592-3b60-8ad5-edd7f27a7b69",
                        "entry_id": "23738844-9d4b-37c8-937f-8b523361cca7",
                        "glosses": [
                            "Person, die etwas verbessern will"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31f5fc17-da68-4b3f-aa45-fcfce2308ddf",
                                "sense_id": "cb1758e2-1592-3b60-8ad5-edd7f27a7b69",
                                "text": "„Zwei Dinge am tunesischen Beispiel beflügeln die Hoffnungen der arabischen Reformer“"
                            },
                            {
                                "example_id": "34eb5e15-b806-4eb3-a8b9-b25ca4ab38f0",
                                "sense_id": "cb1758e2-1592-3b60-8ad5-edd7f27a7b69",
                                "text": "„Wenn heutzutage ein Reformer mit einem lehrhaften, moraltriefenden Traktat daherkommen und damit die Welt verbessern wollte, so wäre das von vornherein ein aussichtsloses Unterfangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
