                    },
                    {
                        "translation_id": "a7318a23-03be-478a-8007-e5a94600e494",
                        "source_entry_id": "67cc399d-57d4-3429-8f00-066f656124c0",
                        "source_sense_id": "2d9dc2b8-35a0-3a8e-9de6-b6ae3aa45d0e",
                        "source_sense_description": "Logik: Schlussfolgerung, die ihr Ergebnis als (nicht notwendig direkte) Prämisse benutzt",
                        "target_lang_word": "círculo vicioso",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5f2a0caf-3cfd-4cea-8883-d3fcb2cd6e92",
                        "source_entry_id": "67cc399d-57d4-3429-8f00-066f656124c0",
                        "source_sense_id": "3bc4fc08-e0d4-32eb-a743-35b1bf1a1e09",
                        "target_lang_word": "vicious circle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vicious circle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a40681e5-0ad1-3bf1-a7a5-247efd9351d9",
                                        "entry_id": "4e403b44-0df2-376d-a53a-e4fd716b94d6",
                                        "glosses": [
                                            "A situation in which the response to one problem creates a chain of problems, each making it more difficult to solve the original one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3070ae5-196c-4671-a82e-b56eca9a0a11",
                                                "sense_id": "a40681e5-0ad1-3bf1-a7a5-247efd9351d9",
                                                "text": "Meanwhile street congestion grows worse and the vicious circle tightens of private motor-cars which impede L.T.E. buses in Central London and of exasperated bus travellers who therefore take to using their own cars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a84cff4e-9254-3f50-9880-8679402ba580",
                                        "entry_id": "4e403b44-0df2-376d-a53a-e4fd716b94d6",
                                        "glosses": [
                                            "A fallacy in which the premise is used to prove a conclusion which is then used to prove the premise."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2e32205-23fa-46fe-b565-7222c8977ed8",
                        "source_entry_id": "67cc399d-57d4-3429-8f00-066f656124c0",
                        "source_sense_id": "3bc4fc08-e0d4-32eb-a743-35b1bf1a1e09",
                        "target_lang_word": "cercle vicieux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cercle vicieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "22d6099a-ab56-319f-804b-874025bee592",
                                        "entry_id": "eb6643ce-b3f8-3214-8f2f-dc09dcc440fc",
                                        "glosses": [
                                            "Raisonnement circulaire invalide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78c4b2aa-0eb5-4d11-923f-03bb8da4ec5c",
                                                "sense_id": "22d6099a-ab56-319f-804b-874025bee592",
                                                "text": "En établissant le droit de vie & de mort sur le droit d’esclavage, & le droit d’esclavage sur le droit de vie & de mort, n’est-il pas clair qu’on tombe dans le cercle vicieux ?"
                                            },
                                            {
                                                "example_id": "5547038f-e45a-4629-b575-981c72bf414e",
                                                "sense_id": "22d6099a-ab56-319f-804b-874025bee592",
                                                "text": "Tous les hommes sont mortels;\nSocrate est homme;\nSocrate est mortel.\nCe raisonnement est un cercle vicieux, car je ne peux affirmer la première proposition que si je suis convaincu de la vérité de la dernière. Socrate non mortel serait en effet une exception suffisante pour infirmer la certitude de la majeure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c55dc8c6-468e-379e-8086-2b90c2fdbd51",
                                        "entry_id": "eb6643ce-b3f8-3214-8f2f-dc09dcc440fc",
                                        "glosses": [
                                            "Causes et effets qui s’entretiennent ou s’amplifient mutuellement et dégradent une situation."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1d6a035-b075-4a41-819b-9b2a1b129c51",
                                                "sense_id": "c55dc8c6-468e-379e-8086-2b90c2fdbd51",
                                                "text": "Plus il fait chaud, plus il y a de climatiseurs... et plus il y a de climatiseurs, plus il fait chaud. Tel est le cercle vicieux de la climatisation, contributeur discret mais croissant au réchauffement de la planète."
                                            },
                                            {
                                                "example_id": "60052079-4112-45d1-8d13-b8afa4f455e1",
                                                "sense_id": "c55dc8c6-468e-379e-8086-2b90c2fdbd51",
                                                "text": "Le cercle vicieux de la récession menace."
                                            },
                                            {
                                                "example_id": "e7ac320a-29b8-459d-be5d-0bfdf25f69e4",
                                                "sense_id": "c55dc8c6-468e-379e-8086-2b90c2fdbd51",
                                                "text": "Pour briser ce cercle vicieux, le rapport en appelle à la prise en compte du changement climatique dans les politiques internationales, à travers une analyse multifactorielle des situations."
                                            },
                                            {
                                                "example_id": "81c3c292-d8cf-45dc-b7d5-fcc6586619d5",
                                                "sense_id": "c55dc8c6-468e-379e-8086-2b90c2fdbd51",
                                                "text": "Leur étude souligne un cercle vicieux : plus il fait chaud, plus les climatiseurs tournent... ce qui réchauffe encore plus l'air à l'extérieur !"
                                            },
                                            {
                                                "example_id": "1465675a-26dc-4cef-9d4c-a49a41fc19db",
                                                "sense_id": "c55dc8c6-468e-379e-8086-2b90c2fdbd51",
                                                "text": "La climatisation est certes une solution très efficace pour atténuer les conséquences sanitaires mais les effets secondaires négatifs sont nombreux : ce système énergivore n’est pas décarboné donc il engendre des émissions de gaz à effet de serre importantes. C’est un cercle vicieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "433f4796-98dd-304d-80d6-1fb6ef1fd779",
                                        "entry_id": "eb6643ce-b3f8-3214-8f2f-dc09dcc440fc",
                                        "glosses": [
                                            "Cercle lié au vice."
                                        ],
                                        "tags": [
                                            "Par plaisanterie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98ac8743-d882-43e9-8db2-60b0568dc471",
                                                "sense_id": "433f4796-98dd-304d-80d6-1fb6ef1fd779",
                                                "text": "— Prenez un cercle, caressez-le, il deviendra vicieux !"
                                            },
                                            {
                                                "example_id": "0339775d-7135-41bb-b1a2-57651b655628",
                                                "sense_id": "433f4796-98dd-304d-80d6-1fb6ef1fd779",
                                                "text": "– Vous savez, mon cher Gérard, je me suis offert de nombreux amants… La Madone des Sleepings n’a pour auréole que le cercle vicieux de ses caprices et pour chapelle que les chambres de luxe des grands palaces…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
