                                "target_senses": [
                                    {
                                        "sense_id": "157b3cab-5740-3f97-9a98-936b7aad3913",
                                        "entry_id": "3990b696-cafc-3d7a-af77-c5434fc1e001",
                                        "glosses": [
                                            "der Kirche unterstellte Religionslehrkraft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7896c17-e702-4820-bb5f-973bf144d702",
                                                "sense_id": "157b3cab-5740-3f97-9a98-936b7aad3913",
                                                "text": "Katechet und Katechetin, bzw. Religionspädagoge und Religionspädagogin übernehmen als Hauptaufgabe den Religionsunterricht sowohl in der Volksschule als auch in der Pfarrei, bzw. der Kirchgemeinde."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "78a67122-18e8-3b9d-9042-3d772ddb5a67",
                                        "entry_id": "3990b696-cafc-3d7a-af77-c5434fc1e001",
                                        "glosses": [
                                            "Laie, der im Auftrag eines Pfarrers Kinder und Erwachsene auf den Empfang bestimmter Sakramente vorbereitet"
                                        ],
                                        "tags": [
                                            "Katholizismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16a7f1a2-c5f2-4bf2-a9ec-0853557bced7",
                                                "sense_id": "78a67122-18e8-3b9d-9042-3d772ddb5a67",
                                                "text": "„Der Dienst des Katecheten in der Kirche ist sehr alt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
