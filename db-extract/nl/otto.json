                                        "examples": [
                                            {
                                                "example_id": "8556cd6a-2a2e-469f-830d-f4c8945621b4",
                                                "sense_id": "1239cf04-facd-34cd-82d6-f7257e239257",
                                                "text": "Froyſard, a Countreyman of ours, records, / England all Oliuers and Rowlands breed, / During the time Edward the third did raigne: […]"
                                            },
                                            {
                                                "example_id": "906f9049-1e3e-4ac3-b095-b1ec9fcca998",
                                                "sense_id": "1239cf04-facd-34cd-82d6-f7257e239257",
                                                "text": "\"My name is Oliver, sir,\" replied the little invalid with a look of great astonishment. \"Oliver,\" said Mr. Brownlow; \"Oliver what? Oliver White,—eh?\" \"No, sir, Twist,—Oliver Twist.\" \"Queer name,\" said the old gentleman. What made you tell the magistrate your name was White?\""
                                            },
                                            {
                                                "example_id": "8cab043b-66a3-4b48-9336-7800239bf42b",
                                                "sense_id": "1239cf04-facd-34cd-82d6-f7257e239257",
                                                "text": "And Oliver suits me, don't you find? It rather goes with my dark, dark hair and kissable ivory teeth, my slim waist, my panache and my linen suit with the ineradicable stain of Pinot Noir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "226525af-2850-3f3a-9355-b7d6afe372a4",
                                        "entry_id": "8fe7aa4d-ef86-3fa3-8d20-328a0f2013d1",
                                        "glosses": [
                                            "A surname originating as a patronymic."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd809f42-de74-4451-bd8d-40ed174f7673",
                                                "sense_id": "226525af-2850-3f3a-9355-b7d6afe372a4",
                                                "text": "“I appreciate your curiosity,” Oliver answers in hurried monotone without inflection or pauses for punctuation."
                                            }
