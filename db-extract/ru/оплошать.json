                "senses": [
                    {
                        "sense_id": "ac16c9cd-a75c-37d6-904d-c02e97b94c61",
                        "entry_id": "89145f10-17d7-37f2-912a-87eafe15ca4c",
                        "glosses": [
                            "разг. совершить промах, ошибку; сделать что-либо неудачно, плохо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71769308-b623-41c8-b729-41f9033d1c7e",
                                "sense_id": "ac16c9cd-a75c-37d6-904d-c02e97b94c61",
                                "text": "Как это, в самом деле, мы так оплошали?"
                            },
                            {
                                "example_id": "67866c85-a889-4d64-8ad5-b77e7387d623",
                                "sense_id": "ac16c9cd-a75c-37d6-904d-c02e97b94c61",
                                "text": "Тогда он потихоньку пробирался к лестнице, ведущей наверх, и, найдя, по обыкновению, дверь всегда запертою, ложился где-нибудь неподалёку, прятался в угол и коварно поджидал, когда кто-нибудь оплошает и оставит дверь наверх отпертою."
                            }
                        ]
                    }
