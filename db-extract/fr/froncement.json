                                        "sense_id": "0109a4f6-7299-3b93-b819-0cc728c82cd7",
                                        "entry_id": "3ce54fd1-1dbd-3e7c-9d93-6d6bcd5b9734",
                                        "glosses": [
                                            "The wrinkling of the brows or face in frowning; the expression of displeasure, sullenness, or discontent in the countenance; an angry frown."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80751acc-8cab-48a2-b9eb-cca99d853056",
                                                "sense_id": "0109a4f6-7299-3b93-b819-0cc728c82cd7",
                                                "text": "She made a scowl."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dd1b73e-1798-3f04-9c68-7e629441782d",
                                        "entry_id": "3ce54fd1-1dbd-3e7c-9d93-6d6bcd5b9734",
                                        "glosses": [
                                            "Gloom; dark or threatening aspect."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8f9c6d6-858b-4daf-ab5c-7f8c56467a31",
                                                "sense_id": "1dd1b73e-1798-3f04-9c68-7e629441782d",
                                                "text": "Mr. Pynsent, who had asked Miss Amory to dance, came up on one occasion to claim her hand, but scowls of recognition having already passed between him and Mr. Arthur Pendennis in the dancing-room, Arthur suddenly rose up and claimed Miss Amory as his partner for the present dance […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scowl",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3c9f859-aa7e-3fa0-92b5-fdc6f88dcd12",
                                        "entry_id": "bcaca0a6-6d89-3577-90c5-d2c4452b279e",
                                        "glosses": [
                                            "To wrinkle the brows, as in frowning or displeasure; to put on a frowning look; to look sour, sullen, severe, or angry."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b60678e8-2e42-4b3e-a3e6-753507aa14de",
                                                "sense_id": "c3c9f859-aa7e-3fa0-92b5-fdc6f88dcd12",
                                                "text": "She scould, and frownd with froward countenaunce"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93ff47a8-6238-344d-b762-f2e0afba2f9d",
                                        "entry_id": "bcaca0a6-6d89-3577-90c5-d2c4452b279e",
                                        "glosses": [
                                            "To look gloomy, dark, or threatening; to lower."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05c5888a-58da-492c-9d05-24bb8142152d",
                                                "sense_id": "93ff47a8-6238-344d-b762-f2e0afba2f9d",
                                                "text": "The scowling heavens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e0fb788-c374-3471-87ae-81d36e87df22",
                                        "entry_id": "bcaca0a6-6d89-3577-90c5-d2c4452b279e",
                                        "glosses": [
                                            "To look at or repel with a scowl or a frown."
