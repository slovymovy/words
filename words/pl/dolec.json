                    "sense_definition": "potoczne określenie dolara, waluty Stanów Zjednoczonych",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "pieniądze",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bilety na mecz piłki nożnej są drogie, skoro kosztują pięćdziesiąt <w>dolców</w> za sztukę.",
                            "target_lang_translations": {
                                "ru": "Билеты на футбольный матч дорогие, раз стоят пятьдесят <w>баксов</w> за штуку."
                            }
                        },
                        {
                            "text": "Po wymianie waluty w kantorze zostało mi jeszcze kilkanaście <w>dolców</w> w portfelu.",
                            "target_lang_translations": {
                                "ru": "После обмена валюты в обменнике у меня в кошельке осталось ещё около десятка <w>баксов</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "baks",
                        "dolar",
                        "zielony"
                    ],
                    "common_phrases": [
                        "kilkadziesiąt dolców"
                    ],
                    "traits": [
