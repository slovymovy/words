            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e56345dd-649d-3f77-93c4-e2cdd375af9d",
                    "sense_definition": "Present participle and gerund of <w>sleep</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baby is <w>sleeping</w> peacefully in the crib.",
                            "target_lang_translations": {
                                "ru": "Ребенок мирно <w>спит</w> в кроватке.",
                                "zh": "婴儿正在摇篮里安静地<w>睡觉</w>。"
                            }
                        },
                        {
                            "text": "I was <w>sleeping</w> when the phone rang.",
                            "target_lang_translations": {
                                "ru": "Я <w>спал</w>, когда зазвонил телефон.",
                                "zh": "电话响的时候我正在<w>睡觉</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sleeping in",
                        "sleeping over",
                        "trouble sleeping"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от <w>sleep</w>.",
                        "zh": "动词 sleep 的现在分词和动名词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спать",
                                "target_lang_sense_clarification": "находиться в состоянии сна"
                            },
                            {
                                "target_lang_word": "спящий",
                                "target_lang_sense_clarification": "причастие: находящийся в состоянии сна"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "睡觉",
                                "target_lang_sense_clarification": "处于睡眠状态"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e2d66157-0018-3d87-820e-841c4e652642",
                    "sense_definition": "In a state of sleep; not awake.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please be quiet so you do not wake the <w>sleeping</w> child.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, ведите себя тихо, чтобы не разбудить <w>спящего</w> ребенка.",
                                "zh": "请安静一点，以免吵醒那个<w>睡着的</w>孩子。"
                            }
                        },
                        {
                            "text": "The <w>sleeping</w> cat looked very comfortable on the sofa.",
                            "target_lang_translations": {
                                "ru": "<w>Спящий</w> кот выглядел очень уютно на диване.",
                                "zh": "那只<w>睡着的</w>猫在沙发上看起来很舒服。"
                            }
                        }
                    ],
                    "synonyms": [
                        "asleep",
                        "slumbering",
                        "dozing",
                        "napping"
                    ],
                    "antonyms": [
                        "awake",
                        "waking"
                    ],
                    "common_phrases": [
                        "sleeping beauty",
                        "sleeping giant",
                        "sleeping baby"
                    ],
                    "target_lang_definitions": {
                        "ru": "В состоянии сна; не бодрствующий.",
                        "zh": "处于睡眠状态；未醒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спящий",
                                "target_lang_sense_clarification": "погруженный в сон"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "睡着的",
                                "target_lang_sense_clarification": "形容词：处于睡眠中的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0b2a041-b65b-318a-97e3-d4dcaba6e6c5",
                    "sense_definition": "Designed to be used for sleeping or to help someone sleep.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You will need a warm <w>sleeping</w> bag for the camping trip.",
                            "target_lang_translations": {
                                "ru": "Для похода тебе понадобится теплый <w>спальный</w> мешок.",
                                "zh": "露营时你需要一个保暖的<w>睡眠</w>袋。"
                            }
                        },
                        {
                            "text": "The doctor prescribed a <w>sleeping</w> pill to help treat her insomnia.",
                            "target_lang_translations": {
                                "ru": "Врач выписал <w>снотворную</w> таблетку, чтобы помочь вылечить ее бессонницу.",
                                "zh": "医生给她开了<w>安眠</w>药来治疗她的失眠。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sleeping bag",
                        "sleeping pill",
                        "sleeping car",
                        "sleeping quarters"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предназначенный для сна или помогающий уснуть.",
                        "zh": "专为睡眠设计或有助于睡眠的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спальный",
                                "target_lang_sense_clarification": "предназначенный для сна (о вещах)"
                            },
                            {
                                "target_lang_word": "снотворный",
                                "target_lang_sense_clarification": "вызывающий сон (о лекарствах)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "睡眠",
                                "target_lang_sense_clarification": "用于睡眠的（物品）"
                            },
                            {
                                "target_lang_word": "安眠",
                                "target_lang_sense_clarification": "有助于睡眠的（药物）"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ab36329b-1cfe-3be5-ad49-aaf904d6274c",
                    "sense_definition": "The state or act of being asleep.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His heavy <w>sleeping</w> caused him to miss the morning alarm.",
                            "target_lang_translations": {
                                "ru": "Его крепкий <w>сон</w> стал причиной того, что он пропустил утренний будильник.",
                                "zh": "他睡得太沉，导致错过了早上的闹钟。"
                            }
                        },
                        {
                            "text": "There is a time for <w>sleeping</w> and a time for working.",
                            "target_lang_translations": {
                                "ru": "Есть время для <w>сна</w>, и есть время для работы.",
                                "zh": "该<w>睡眠</w>的时候就睡眠，该工作的时候就工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "slumber",
                        "sleep",
                        "rest"
                    ],
                    "antonyms": [
                        "waking"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние или процесс сна.",
                        "zh": "睡眠的状态或行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сон",
                                "target_lang_sense_clarification": "физиологическое состояние покоя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "睡眠",
                                "target_lang_sense_clarification": "生理上的休息状态"
                            }
                        ]
                    }
                }
            ]
        }
    ]
