                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette ancienne <w>querelle</w> entre voisins a fini par empoisonner la vie de tout le quartier."
                        },
                        {
                            "text": "Il refuse de prendre parti dans une <w>querelle</w> qui ne le concerne absolument pas."
                        }
                    ],
