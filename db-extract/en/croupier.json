                    {
                        "translation_id": "2804772b-2a5d-410e-9989-29cd1dab861f",
                        "source_entry_id": "12dfed9a-b38c-3d33-8ece-597b6cb926e1",
                        "source_sense_description": "person who collects bets and pays out winnings at a gambling table",
                        "target_lang_word": "Croupier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Croupier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9f67d710-3c7a-35af-8605-a73841d072e6",
                                        "entry_id": "751acf7e-2f38-33eb-8ae6-0639ab0dc41e",
                                        "glosses": [
                                            "Mitarbeiter in einer Spielbank, der den regelgerechten Ablauf des Spiels am Spieltisch sicherstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "885e4413-3967-4ee3-88d5-52dca6e2772c",
                                                "sense_id": "9f67d710-3c7a-35af-8605-a73841d072e6",
                                                "text": "„Die Croupiers dagegen hatten nichts zu lachen…“"
                                            },
                                            {
                                                "example_id": "b49e13cb-d32c-4df6-952e-502f8795eb51",
                                                "sense_id": "9f67d710-3c7a-35af-8605-a73841d072e6",
                                                "text": "„Der Croupier erwiderte dieses Lächeln, fast unmerklich, kaum daß sich die Lippen unter dem gesträubten Bart verzogen.“"
                                            },
                                            {
                                                "example_id": "7ef09ed2-fcfc-43de-9c63-c6cd7c844eb8",
                                                "sense_id": "9f67d710-3c7a-35af-8605-a73841d072e6",
                                                "text": "„Gelegentlich bat er den Croupier, für ihn zu spielen.“"
                                            },
                                            {
                                                "example_id": "ffa9d6dc-2889-43cf-95f8-ecefa4162f1a",
                                                "sense_id": "9f67d710-3c7a-35af-8605-a73841d072e6",
                                                "text": "„Ich war zur Hälfte bei ihm beteiligt und half ihm als Croupier; er leistete mir den gleichen Dienst, wenn ich die Bank hielt, was sehr häufig geschah, denn die Spieler schätzten ihn nicht.“"
                                            },
                                            {
                                                "example_id": "0ec791ed-ca24-4925-b349-76f9402ce111",
                                                "sense_id": "9f67d710-3c7a-35af-8605-a73841d072e6",
                                                "text": "„Es war immer noch besser, für das Opfer einer Katastrophe gehalten zu werden als für die Witwe eines Mannes, der sich in Paris von Mädchen und in Monte Carlo von Croupiers hat ausnehmen lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
