                "senses": [
                    {
                        "sense_id": "5cecf819-5849-3d19-99c6-8a11c278bea9",
                        "entry_id": "c37ac4e2-df79-344d-a4fb-04fcca18e841",
                        "glosses": [
                            "Cimenter à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "318c3c5b-1dda-4bd1-9c44-857a26c866b7",
                                "sense_id": "5cecf819-5849-3d19-99c6-8a11c278bea9",
                                "text": "Croyez-vous que quelqu’un d’autre aurait pu non seulement faire cela, avec ma femme et moi dormant, toutes fenêtres pouvertes, à vingt mètres de là, mais encore remettre tout en ordre et recimenter les dalles?"
                            },
                            {
                                "example_id": "0aae5539-8fc2-4981-b680-25d97a275b58",
                                "sense_id": "5cecf819-5849-3d19-99c6-8a11c278bea9",
                                "text": "Récemment, des ouvriers ont recimenté le trottoir au pied de l’immeuble…"
                            },
                            {
                                "example_id": "ccc55f3f-f3b7-4140-ae24-38779ed534e4",
                                "sense_id": "5cecf819-5849-3d19-99c6-8a11c278bea9",
                                "text": "Nous commençâmes par le court en dur dont on recimentait la surface."
                            }
                        ]
                    }
