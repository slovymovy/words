                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff7f5547-4019-41a1-81c2-3fe1ab3cfd1e",
                                                "sense_id": "9450e520-3b02-33cd-8590-7a0f94b0ab48",
                                                "text": "Das Ufer vieler Seen ist mit Rohr bestanden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "380d6176-6d4f-3335-934e-0733330aa686",
