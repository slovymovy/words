                ],
                "senses": [
                    {
                        "sense_id": "715be735-0fb4-3025-88ac-21eb2baa7c48",
                        "entry_id": "7bb58659-83d9-390c-8cf4-fe9793028970",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69e5d5ca-277b-4223-a3b1-3ab8b06f7dfc",
                                "sense_id": "715be735-0fb4-3025-88ac-21eb2baa7c48",
                                "text": "Frau Reisel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b8b36b5d-53e5-464f-a8b9-ab131762b2b1",
                                "sense_id": "715be735-0fb4-3025-88ac-21eb2baa7c48",
                                "text": "Herr Reisel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d36881aa-c65b-4834-9724-25ab86604e88",
                                "sense_id": "715be735-0fb4-3025-88ac-21eb2baa7c48",
                                "text": "Die Reisels fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "008e1dd1-a1eb-48ba-b8d9-d2e8835c9d45",
                                "sense_id": "715be735-0fb4-3025-88ac-21eb2baa7c48",
                                "text": "Der Reisel trägt nie die Schals, die die Reisel ihm strickt."
                            },
                            {
                                "example_id": "7e48e381-14f8-4330-8f56-1589cddcb275",
                                "sense_id": "715be735-0fb4-3025-88ac-21eb2baa7c48",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Reisel kommt, geht der Herr Reisel.“"
                            },
                            {
                                "example_id": "b7329fd0-b03c-4b73-893f-dcbdfb0087b5",
                                "sense_id": "715be735-0fb4-3025-88ac-21eb2baa7c48",
                                "text": "Reisel kommt und geht."
                            },
                            {
                                "example_id": "12a4b7da-334e-41ba-83ad-e0953d05e409",
                                "sense_id": "715be735-0fb4-3025-88ac-21eb2baa7c48",
                                "text": "Reisels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
