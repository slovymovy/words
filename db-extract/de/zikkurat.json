                    {
                        "translation_id": "bd919a5e-1093-4b43-a2a7-4229fee0c25a",
                        "source_entry_id": "1aca0850-38a6-33a5-93a3-2cd7b183c605",
                        "source_sense_id": "dc88986b-3342-323d-b6f8-209e5048039d",
                        "source_sense_description": "Architektur: ein mehrstufiger Tempelbau der Hochkulturen Mesopotamiens",
                        "target_lang_word": "ziggourat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ziggourat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bdf4564f-2c2e-397b-ac77-b7dcc9a5872a",
                                        "entry_id": "e0cb8fd1-cda7-3833-a760-dc3350faace8",
                                        "glosses": [
                                            "Édifice religieux mésopotamien en forme de pyramide à étages, dont la fonction demeure floue même s’il s’agirait plutôt d’un lieu de cultes et de sacrifices, qui comportait un sanctuaire. C’est à partir de trois plates-formes que ce genre d’édifices est appelé ziggourat, le maximum étant de sept niveaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9630041b-f8e6-4314-bbfc-24816a9183f2",
                                                "sense_id": "bdf4564f-2c2e-397b-ac77-b7dcc9a5872a",
                                                "text": "Des monticules en forme de ziggourats poussaient par terre tandis que des piles précaires et autres tours penchées s’élevaient au sommet de la cloison."
                                            },
                                            {
                                                "example_id": "91f01c79-4a02-436e-96b3-dab2c95f47ce",
                                                "sense_id": "bdf4564f-2c2e-397b-ac77-b7dcc9a5872a",
                                                "text": "La plupart étaient composées de trois corps en forme de trapèze, empilés les uns sur les autres, de plus en plus petits, comme les terrasses successives d’une ziggourat."
                                            },
                                            {
                                                "example_id": "40aa2a77-f063-4068-800d-3d37751f88fc",
                                                "sense_id": "bdf4564f-2c2e-397b-ac77-b7dcc9a5872a",
                                                "text": "Comme ces structures étaient construites en briques d’ argile, la plupart des ziggourats mésopotamiennes furent découverte dans un piètre état de conservation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "993bdd32-040d-489c-84d4-20114347496c",
                        "source_entry_id": "1aca0850-38a6-33a5-93a3-2cd7b183c605",
                        "source_sense_id": "dc88986b-3342-323d-b6f8-209e5048039d",
                        "source_sense_description": "Architektur: ein mehrstufiger Tempelbau der Hochkulturen Mesopotamiens",
                        "target_lang_word": "зиккурат",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "зиккурат",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "480c8a44-2e5d-3c05-b808-c1e116f8119e",
                                        "entry_id": "ad57828d-1c87-31a8-b686-c741c98c8dc2",
                                        "glosses": [
                                            "истор., архит. многоступенчатое культовое сооружение в древнем Междуречье"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3af37a99-28d6-40c3-b334-960d3442f6e2",
                                                "sense_id": "480c8a44-2e5d-3c05-b808-c1e116f8119e",
                                                "text": "Пирамиды строго ориентированы по странам света, зиккураты служили для астрономических наблюдений и так далее."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbd4cd3d-b1d9-3547-8bdb-aa9b871926db",
                                        "entry_id": "ad57828d-1c87-31a8-b686-c741c98c8dc2",
                                        "glosses": [
                                            "перен. монументальное сооружение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a16c61c-c3bb-497c-a637-b9f2af2c27e6",
                                                "sense_id": "dbd4cd3d-b1d9-3547-8bdb-aa9b871926db",
                                                "text": "Увидев любимого друга Фиделя и прочих команданте на трибуне московского зиккурата, Тушинский воспрял."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
