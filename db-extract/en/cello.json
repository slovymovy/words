                        "source_sense_id": "8b02d85a-a7e7-3232-b019-cd0fdb7adbfd",
                        "source_sense_description": "Cello",
                        "target_lang_word": "Cello",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cello",
