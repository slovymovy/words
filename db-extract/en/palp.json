                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2305c41-663e-440d-85ee-e592e1f7c63d",
                                "sense_id": "0f7035cf-3ca1-30ed-83d8-42b7725d84c6",
                                "text": "Below her formidable eyes her fangs are flanked by limb-like mouthparts: her palps, coloured a startling white like a quivering moustache."
