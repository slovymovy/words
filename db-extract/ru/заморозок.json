                ],
                "senses": [
                    {
                        "sense_id": "201b0613-29f0-3d73-a4d7-f21f40828f12",
                        "entry_id": "3df826ba-d477-3a16-9721-02bddfe6ae7f",
                        "glosses": [
                            "лёгкий мороз, обычно по утрам весной или осенью"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5f2aa9e-8d77-4095-bb33-2fe709518827",
                                "sense_id": "201b0613-29f0-3d73-a4d7-f21f40828f12",
                                "text": "Кончились полевые работы, наступала осень с дождями, грязью, холодными ветрами и утренними заморозками."
                            },
                            {
                                "example_id": "119461e0-ed6a-456f-bccf-8e88a66b38f0",
                                "sense_id": "201b0613-29f0-3d73-a4d7-f21f40828f12",
                                "text": "День был ясный, солнечный, после сильного ночного заморозка, и весёлый блеск осеннего дня совпадал с известием о победе, которое передавали не только рассказы участвовавших в нём, но и радостное выражение лиц солдат, офицеров, генералов и адъютантов, ехавших туда и оттуда мимо Ростова."
                            },
                            {
                                "example_id": "f4f3acc5-f872-4aeb-81c7-0bbb92aec293",
                                "sense_id": "201b0613-29f0-3d73-a4d7-f21f40828f12",
                                "text": "10 мая: ночью лёгкий заморозок, слегка обжёгший листья ревеня; днём небольшой дождь и весьма прохладно (7°Р)"
                            },
                            {
                                "example_id": "967e817a-9ffb-4b19-8165-2d134325bf46",
                                "sense_id": "201b0613-29f0-3d73-a4d7-f21f40828f12",
                                "text": "После сильного ночного заморозка солнце взошло в полной силе и так разогрело землю, что от неё сильно пари́ло."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23c6e61f-93a0-43d9-aed8-4738f50fc130",
                        "source_entry_id": "3df826ba-d477-3a16-9721-02bddfe6ae7f",
                        "source_sense_id": "201b0613-29f0-3d73-a4d7-f21f40828f12",
                        "target_lang_word": "przymrozek",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
