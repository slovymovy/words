                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54600444-18b7-4e5c-a71f-8a188c7d0b67",
                                "sense_id": "31b9a1d2-d7b4-3f93-83f9-4c5a79aea920",
                                "text": "The ghostly prudes with hagged face\nAlready had condemned the sinner."
                            },
                            {
                                "example_id": "89b9dfbb-bf0f-4e47-89ea-43ea49173f39",
                                "sense_id": "31b9a1d2-d7b4-3f93-83f9-4c5a79aea920",
                                "text": "Woe-begone mother, half anger, half agony,\nAs over thy shoulder thou lookest to hush the babe,\nBleakly the blinding snow beats in thy hagged face."
                            },
                            {
                                "example_id": "c4ad5a40-512f-4654-9a2e-81b78ff6aab5",
                                "sense_id": "31b9a1d2-d7b4-3f93-83f9-4c5a79aea920",
                                "text": "The face of yourself you see in the mirror with its expression of unbearable anguish so hagged and awful with sorrow you cant even cry for a thing so ugly, so lost, no connection whatever with early perfection and therefore nothing to connect with tears or anything"
                            }
                        ]
                    }
