                "senses": [
                    {
                        "sense_id": "d9deee08-e659-3105-9641-a84bddd34395",
                        "entry_id": "a401a201-2a7b-3200-bc9d-e7cd5c08e536",
                        "glosses": [
                            "Châtaignier cultivé, dont le fruit, comestible, est plus gros que d’ordinaire (un seul par bogue)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5a9426c-74cc-4310-93f5-fe0c08877b21",
                                "sense_id": "d9deee08-e659-3105-9641-a84bddd34395",
                                "text": "Sur les thyrses neigeux des maroniers moroses\nLes oiseaux gazouillaient aux derniers feux du jour,\nEt leur chant semblait dire aux âmes longtemps closes\nDe chanter dans les fleurs la chanson de l’amour"
                            }
                        ]
                    },
                    {
                        "sense_id": "cdaa4214-25f3-32bb-9f5f-1138d46999d5",
                        "entry_id": "a401a201-2a7b-3200-bc9d-e7cd5c08e536",
                        "glosses": [
                            "Frère lai de l’hospice du Saint-Bernard, secouriste en montagne."
                        ],
                        "tags": [
                            "Col du Saint-Bernard"
                        ],
                        "examples": [
                            {
                                "example_id": "6130bf89-de94-4d25-adb8-d09104a22f46",
                                "sense_id": "cdaa4214-25f3-32bb-9f5f-1138d46999d5",
                                "text": "Quand les frères ne voient plus autour d’eux que des murailles de neige et un ciel sombre, ils partent accompagnés des maroniers et des chiens, et ils se dirigent vers la vallée d’Aoste et la vallée de Martigny, écoutant, cherchant quelque voyageur égaré"
                            },
                            {
                                "example_id": "a7d9e6eb-c71c-4d43-b172-3a1616ea792e",
                                "sense_id": "cdaa4214-25f3-32bb-9f5f-1138d46999d5",
                                "text": "Des chiens d’une espèce particulière et d’un instinct admirable, nommés marons, aident les religieux dits maroniers à retrouver les sentiers cachés par la neige."
                            }
                        ]
                    }
                ],
