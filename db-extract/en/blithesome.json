                    {
                        "sense_id": "f57f1b49-7cb4-3ed8-a1d6-b6fde1bebd5f",
                        "entry_id": "1a4dd80f-0e35-3fef-92fd-28232b9023f3",
                        "glosses": [
                            "Happy or spriteful; carefree."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55e5e55c-98c7-402a-bc19-312e03e9b57e",
                                "sense_id": "f57f1b49-7cb4-3ed8-a1d6-b6fde1bebd5f",
                                "text": "Fare not the birds well, as from spray to spray / Blithsome they bound—yet find their simple food / Scattered abundantly?"
                            },
                            {
                                "example_id": "417e3d19-bb98-44b0-85b1-89c02c953083",
                                "sense_id": "f57f1b49-7cb4-3ed8-a1d6-b6fde1bebd5f",
                                "text": "She made herself as blithesome as a lark, and at last she offered him two hundred dollars if he would sell her the whistle, and tell her how she should manage to get it safe home with her."
                            },
                            {
                                "example_id": "eb167e71-f829-4b06-9af2-b903eccfcf8c",
                                "sense_id": "f57f1b49-7cb4-3ed8-a1d6-b6fde1bebd5f",
                                "text": "[']Take the Adventure, heed the call, now ere the irrevocable moment passes!' 'Tis but a banging of the door behind you, a blithesome step forward, and you are out of the old life and into the new!"
                            }
                        ]
                    }
                ],
