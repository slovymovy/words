                                "target_senses": [
                                    {
                                        "sense_id": "43de4086-0f15-32d7-afea-4d9dffa33725",
                                        "entry_id": "e77a9a9f-a32d-3dbc-a770-f6963bf9c271",
                                        "glosses": [
                                            "Espèce d'oiseau passereau d'Eurasie, corvidé noir brillant au bec foncé, trapu et effilé, plus petit que le grand corbeau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f33cc56-0ddc-4075-8f39-fa9efef4d291",
                                                "sense_id": "43de4086-0f15-32d7-afea-4d9dffa33725",
                                                "text": "Seule une corneille noire poussée par cet incroyable aplomb qui singularise son espèce, s'était hasardée à houspiller le seigneur pour lui contester sa proie. Culotté le corvidé ! qui n'hésitait pas à tirer les plumes de la queue du convive pour le forcer à s'éloigner. Vite lassé par tant d'effronterie, l'aigle noir s'est brutalement retourné, bec grand ouvert, ailes déployées, au comble de l'irritation."
                                            },
                                            {
                                                "example_id": "ab026561-66cb-4cba-923c-b72a1af29016",
                                                "sense_id": "43de4086-0f15-32d7-afea-4d9dffa33725",
                                                "text": "La corneille noire est commune en France. Elle est omnivore et consomme aussi bien des insectes et des larves que des grains, des œufs ou des poussins."
                                            },
                                            {
                                                "example_id": "8e02ab70-fada-487a-a641-b8f6a08904d0",
                                                "sense_id": "43de4086-0f15-32d7-afea-4d9dffa33725",
                                                "text": "Les corneilles noires vivent dans des espaces très fréquentés car elles y trouvent une nourriture abondante et facile à exploiter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
