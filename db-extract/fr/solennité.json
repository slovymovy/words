        "fr-extract.jsonl": [
            {
                "entry_id": "4b901002-f4d5-3d8a-8d84-c25b95b102ac",
                "word": "solennité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "19a89a4a-a2a4-447b-be88-e7b9efac9f6d",
                        "entry_id": "4b901002-f4d5-3d8a-8d84-c25b95b102ac",
                        "tags": [
                            "plural"
                        ],
                        "form": "solennités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5a798794-e05f-34f8-a8ea-e794332dc9cb",
                        "entry_id": "4b901002-f4d5-3d8a-8d84-c25b95b102ac",
                        "glosses": [
                            "Cérémonie publique qui rend une chose solennelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0db144f-f8da-49e9-8de3-15dbd3597093",
                                "sense_id": "5a798794-e05f-34f8-a8ea-e794332dc9cb",
                                "text": "Cette cérémonie fut célébrée avec toute la pompe que l’Église romaine sait donner à ses solennités."
                            },
                            {
                                "example_id": "2f30c54f-a6bd-4ee3-8034-0e790e52c8d4",
                                "sense_id": "5a798794-e05f-34f8-a8ea-e794332dc9cb",
                                "text": "La lune n’est pas plutôt couchée, qu’un souffle venant du large brise l’image des constellations, comme on éteint les flambeaux après une solennité."
                            },
                            {
                                "example_id": "bcfea21c-28f1-418d-aea3-dc0eaa6de568",
                                "sense_id": "5a798794-e05f-34f8-a8ea-e794332dc9cb",
                                "text": "Les habitants protestèrent contre leur venue, prétendant qu’il n’était pas décent que des infidèles assistassent à une solennité présidée par des prêtres chrétiens."
                            }
                        ]
                    },
                    {
                        "sense_id": "2bcc0c99-d5bd-3bfd-b0fc-fca07ffd7cbb",
                        "entry_id": "4b901002-f4d5-3d8a-8d84-c25b95b102ac",
                        "glosses": [
                            "Ce qui a un caractère solennel, un air, un aspect solennel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6823c490-33eb-4384-954e-7172ba488d68",
                                "sense_id": "2bcc0c99-d5bd-3bfd-b0fc-fca07ffd7cbb",
                                "text": "[…], conférant à l’ensemble cette solennité de la lumière tombant de l’espace firmamental sans l’éblouissement des rayons, […]."
                            },
                            {
                                "example_id": "ac866261-927f-4535-b593-d6e87cf74b00",
                                "sense_id": "2bcc0c99-d5bd-3bfd-b0fc-fca07ffd7cbb",
                                "text": "Le dirlo fait semblant de lire un rapport avec cette solennité mensongère qu’empruntent les juges corrompus."
                            },
                            {
                                "example_id": "b76275e7-c79c-4121-a060-485d4a2df73b",
                                "sense_id": "2bcc0c99-d5bd-3bfd-b0fc-fca07ffd7cbb",
                                "text": "Entourés de vestons-cravates, Girard et moi détonnions dans nos vestes de denim fatiguées, arborées comme par défi à la barbe de cet obscur aréopage de diplomates culturels à la solennité empesée."
                            },
                            {
                                "example_id": "8d47f04b-813a-4203-ae94-fa24c824141c",
                                "sense_id": "2bcc0c99-d5bd-3bfd-b0fc-fca07ffd7cbb",
                                "text": "L’idée de déployer tous les fastes de la République et d’afficher une solennité churchillienne pour annoncer une augmentation de 1,6 point de la TVA ne peut venir que de cerveaux hallucinés."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec3df5b7-755e-3241-803f-feda4b52f6ee",
                        "entry_id": "4b901002-f4d5-3d8a-8d84-c25b95b102ac",
                        "glosses": [
                            "Formalité qui rend un acte solennel, authentique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5227d32-aee2-4e49-bc86-f264bd99778d",
                                "sense_id": "ec3df5b7-755e-3241-803f-feda4b52f6ee",
                                "text": "(Acte notarié). La preuve testimoniale n'est pas admissible contre les énonciations d'un acte notarié relatives à sa substance , aux dispositions qu'il contient, aux formes et solennités qu'il constate avoir été observées."
                            }
                        ]
                    },
                    {
                        "sense_id": "3804ae42-0552-3fba-a576-47cf4df6c669",
                        "entry_id": "4b901002-f4d5-3d8a-8d84-c25b95b102ac",
                        "glosses": [
                            "Dans la liturgie catholique depuis Vatican II, célébration comprenant, comme un dimanche, des premières vêpres, deux lectures avant l’Évangile, gloria, crédo, et qui, si elle est universelle, est marquée chaque année, même en cas de concurrence."
                        ],
                        "tags": [
                            "Liturgie"
                        ],
                        "examples": [
                            {
                                "example_id": "6f7fc1a5-c265-4154-a59a-92375ab1bbb1",
                                "sense_id": "3804ae42-0552-3fba-a576-47cf4df6c669",
                                "text": "Noël, l’Ascension, la Trinité font partie des solennités du calendrier."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8a3138a-a299-43ab-b692-f545a50b9efb",
                        "source_entry_id": "4b901002-f4d5-3d8a-8d84-c25b95b102ac",
                        "target_lang_word": "Feierlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feierlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f5fbd2ca-2e1f-3268-8b31-224ad9764dd8",
                                        "entry_id": "a33d37e3-32c0-355d-8227-4cb18ac7a2bc",
                                        "glosses": [
                                            "die würdevolle Ernsthaftigkeit eines Moments"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e01ec7c7-1232-432d-a258-03e72c35d305",
                                                "sense_id": "f5fbd2ca-2e1f-3268-8b31-224ad9764dd8",
                                                "text": "Bei der Trauung sollte schon die Feierlichkeit gewahrt bleiben."
                                            },
                                            {
                                                "example_id": "d1c6ea1b-11b9-47a6-8d2c-5853f7352c4b",
                                                "sense_id": "f5fbd2ca-2e1f-3268-8b31-224ad9764dd8",
                                                "text": "Die Feierlichkeit der Zeugnisverleihung war so intensiv, dass sie beinahe mit Händen zu greifen war."
                                            },
                                            {
                                                "example_id": "3bfe7fad-7b4b-472d-8df9-b96e79d4ce87",
                                                "sense_id": "f5fbd2ca-2e1f-3268-8b31-224ad9764dd8",
                                                "text": "„Sein Gesicht zeigte eine so ungewöhnliche Feierlichkeit, dass Pierre bei seinem Anblick erschrocken aufstand.“"
                                            },
                                            {
                                                "example_id": "df420a8b-f3f5-48d8-8dfe-52520143c14b",
                                                "sense_id": "f5fbd2ca-2e1f-3268-8b31-224ad9764dd8",
                                                "text": "„Als der Krieg ausbrach, nahm sie die mit Unterschrift versehene Photographie Kaiser Wilhelms von der Wand und hängte sie mit einer gewissen Feierlichkeit im Diener-WC auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e7c7665b-ee8a-3917-9a2e-b223d1a4fd37",
                                        "entry_id": "a33d37e3-32c0-355d-8227-4cb18ac7a2bc",
                                        "glosses": [
                                            "festliche Veranstaltung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88848e33-b1fa-4d55-bff2-e94fdd4ef9c3",
                                                "sense_id": "e7c7665b-ee8a-3917-9a2e-b223d1a4fd37",
                                                "text": "Die Feierlichkeit zu Ehren meines 20-jährigen Jubiläums war sehr schön."
                                            },
                                            {
                                                "example_id": "4d6d7bf1-eacb-47cb-bef3-347f77c24a77",
                                                "sense_id": "e7c7665b-ee8a-3917-9a2e-b223d1a4fd37",
                                                "text": "Die an die Geschäftseröffnung angeschlossenen Feierlichkeiten gerieten ziemlich aus dem Ufer."
                                            },
                                            {
                                                "example_id": "fea0297c-b503-44ac-9257-589af8058e1e",
                                                "sense_id": "e7c7665b-ee8a-3917-9a2e-b223d1a4fd37",
                                                "text": "„Am Silvester-Abend ist in Dubai in der Nähe der Feierlichkeiten ein Grossbrand in einem Luxushotel ausgebrochen.“"
                                            },
                                            {
                                                "example_id": "52d3bdef-8418-4a54-b178-fc178e64cf08",
                                                "sense_id": "e7c7665b-ee8a-3917-9a2e-b223d1a4fd37",
                                                "text": "„Die Feierlichkeiten haben Tradition und Moderne so verbunden, wie es sich Selassie auch für seine Herrschaft wünscht.“"
                                            },
                                            {
                                                "example_id": "895e1401-9127-4269-a56c-155531a42f35",
                                                "sense_id": "e7c7665b-ee8a-3917-9a2e-b223d1a4fd37",
                                                "text": "„Verärgert wünschte der König, die Feierlichkeiten so schnell wie möglich hinter sich zu bringen.“"
                                            },
                                            {
                                                "example_id": "46565094-3045-427c-8be5-1d8ccf791e7c",
                                                "sense_id": "e7c7665b-ee8a-3917-9a2e-b223d1a4fd37",
                                                "text": "„Als die Feierlichkeit zu Ende war, rief die Gouverneurin ihn zu sich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7375791-c8cd-4ea6-a442-28b201c19d20",
                        "source_entry_id": "4b901002-f4d5-3d8a-8d84-c25b95b102ac",
                        "target_lang_word": "solemnity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "solemnity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "663f71be-e77a-30cd-9666-b85d2262a550",
                                        "entry_id": "3740f4e0-16b3-38d7-971a-6ef071dbef16",
                                        "glosses": [
                                            "The quality of being deeply serious and sober or solemn."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1172247f-02f5-414a-bac7-c4a53b02452b",
                                                "sense_id": "663f71be-e77a-30cd-9666-b85d2262a550",
                                                "text": "There has been nothing in archæology that has made such a vivid impression on the popular imagination as Mr. Arthur Evans's excavations at Knossos. The Minotaur! the Labyrinth—such words do not suggest the solemnities of antiquarian research."
                                            },
                                            {
                                                "example_id": "b0b27d5e-8b38-4b38-b137-a2c9a2a55e74",
                                                "sense_id": "663f71be-e77a-30cd-9666-b85d2262a550",
                                                "text": "the solemnity of a funeral"
                                            },
                                            {
                                                "example_id": "f4ccfc7e-40e0-4323-b5fc-9a205d1e1b15",
                                                "sense_id": "663f71be-e77a-30cd-9666-b85d2262a550",
                                                "text": "The stateliness and gravity of the Spaniards shows itself in the solemnity of their language."
                                            },
                                            {
                                                "example_id": "cd72e2d8-2200-47c3-ba41-857c33192541",
                                                "sense_id": "663f71be-e77a-30cd-9666-b85d2262a550",
                                                "text": "These promises were often made with great solemnity and confirmed with an oath."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1906eb87-ca27-3a34-afc3-5d0bd9390f37",
                                        "entry_id": "3740f4e0-16b3-38d7-971a-6ef071dbef16",
                                        "glosses": [
                                            "An instance or example of solemn behavior; a rite or ceremony performed with reverence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "becfbdb5-8c8f-4741-8117-70f96492e097",
                                                "sense_id": "1906eb87-ca27-3a34-afc3-5d0bd9390f37",
                                                "text": "Great was the cauſe; our old ſolemnities / From no blind zeal or fond tradition riſe, / But ſav'd from death, our Argives yearly pay / Theſe grateful honours to the God of Day."
                                            },
                                            {
                                                "example_id": "dfed2aa9-3024-4f16-b6b9-c0a9b831ac0b",
                                                "sense_id": "1906eb87-ca27-3a34-afc3-5d0bd9390f37",
                                                "text": "This is the Man after God's Heart, […] by endeavouring, when he aſſiſted at thoſe Solemnities, to perform them with the utmoſt Attention, Alacrity, and holy Warmth of Mind, of which he was capable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "418db01f-b853-35c1-b693-3549646eeaee",
                                        "entry_id": "3740f4e0-16b3-38d7-971a-6ef071dbef16",
                                        "glosses": [
                                            "A feast day of the highest rank celebrating a mystery of faith such as the Trinity, an event in the life of Jesus, the Virgin Mary, or another important saint."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f7e5179d-b000-30f5-940e-6583225101b9",
                                        "entry_id": "3740f4e0-16b3-38d7-971a-6ef071dbef16",
                                        "glosses": [
                                            "A solemn or formal observance; proceeding according to due form; the formality which is necessary to render a thing done valid."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "871357ac-cb73-3b7b-a0ed-a73517c66199",
                                        "entry_id": "3740f4e0-16b3-38d7-971a-6ef071dbef16",
                                        "glosses": [
                                            "A celebration or festivity."
                                        ],
                                        "tags": [
                                            "countable",
