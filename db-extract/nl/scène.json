                                "target_senses": [
                                    {
                                        "sense_id": "9f94391d-060f-3751-9adc-c8f352f259da",
                                        "entry_id": "cafd9658-b510-3d3b-b1f5-49b1d26d11f9",
                                        "glosses": [
                                            "The location of an event that attracts attention."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9260dc63-b3a9-4f40-b91a-df450be298e8",
                                                "sense_id": "9f94391d-060f-3751-9adc-c8f352f259da",
                                                "text": "the scene of the crime"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26ac28e6-2321-37bf-a1c7-17586470568f",
                                        "entry_id": "cafd9658-b510-3d3b-b1f5-49b1d26d11f9",
                                        "glosses": [
                                            "The stage."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "977342a2-42ab-4080-b610-968693c0b26b",
                                                "sense_id": "26ac28e6-2321-37bf-a1c7-17586470568f",
                                                "text": "They stood in the centre of the scene."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3b1cb3c-3513-3c2c-accf-f911154eba00",
                                        "entry_id": "cafd9658-b510-3d3b-b1f5-49b1d26d11f9",
                                        "glosses": [
                                            "The decorations; furnishings, and backgrounds of a stage, representing the place in which the action of a play is set."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbd36d1d-cfc1-40a5-9d75-6ebfea8d2b2e",
                                                "sense_id": "e3b1cb3c-3513-3c2c-accf-f911154eba00",
                                                "text": "to paint scenes"
                                            },
                                            {
                                                "example_id": "470382ff-7d4e-4a8b-97ce-1a98383c9c24",
                                                "sense_id": "e3b1cb3c-3513-3c2c-accf-f911154eba00",
                                                "text": "to change the scenes"
                                            },
                                            {
                                                "example_id": "db182492-e3e2-4304-9876-08fe42132b88",
                                                "sense_id": "e3b1cb3c-3513-3c2c-accf-f911154eba00",
                                                "text": "behind the scenes"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c77e124c-8d31-346f-ba6e-65604cef054d",
                                        "entry_id": "cafd9658-b510-3d3b-b1f5-49b1d26d11f9",
                                        "glosses": [
                                            "A part of a dramatic work that is set in the same place or time. In the theatre, generally a number of scenes constitute an act."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "038a5713-d77c-46f4-b0cd-dafaed38ddce",
                                                "sense_id": "c77e124c-8d31-346f-ba6e-65604cef054d",
                                                "text": "The play is divided into three acts, and in total twenty-five scenes."
                                            },
                                            {
                                                "example_id": "d0290ee5-eb17-4ba4-8ce3-89b5591af2ca",
                                                "sense_id": "c77e124c-8d31-346f-ba6e-65604cef054d",
                                                "text": "The most moving scene is the final one, where he realizes he has wasted his whole life."
                                            },
                                            {
                                                "example_id": "3ae65ca5-2346-4922-a880-1cf7ac9f77bf",
                                                "sense_id": "c77e124c-8d31-346f-ba6e-65604cef054d",
                                                "text": "There were some very erotic scenes in the movie, although it was not classified as pornography."
                                            },
                                            {
                                                "example_id": "4781fcbf-058a-4dc5-8cbc-a7666bb33e37",
                                                "sense_id": "c77e124c-8d31-346f-ba6e-65604cef054d",
                                                "text": "Miss Phyllis Morgan, as the hapless heroine dressed in the shabbiest of clothes, appears in the midst of a gay and giddy throng; she apostrophises all and sundry there, including the villain, and has a magnificent scene which always brings down the house, and nightly adds to her histrionic laurels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d5f5fcb-b994-3880-9689-0ab189107980",
                                        "entry_id": "cafd9658-b510-3d3b-b1f5-49b1d26d11f9",
                                        "glosses": [
                                            "The location, time, circumstances, etc., in which something occurs, or in which the action of a story, play, or the like, is set up."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17fc70f2-468c-4829-a51b-e79ee064d764",
                                                "sense_id": "7d5f5fcb-b994-3880-9689-0ab189107980",
                                                "text": "In Troy, there lies the scene."
                                            },
                                            {
                                                "example_id": "eaff9cbc-8542-4d9c-a288-8baec9e85e83",
                                                "sense_id": "7d5f5fcb-b994-3880-9689-0ab189107980",
                                                "text": "The world is a vast scene of strife."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "158cdf2e-97ed-3d45-9ba5-218c368dec96",
                                        "entry_id": "cafd9658-b510-3d3b-b1f5-49b1d26d11f9",
                                        "glosses": [
                                            "A combination of objects or events in view or happening at a given moment at a particular place."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "055e2bda-b6c6-4a67-9386-f12386182984",
                                                "sense_id": "158cdf2e-97ed-3d45-9ba5-218c368dec96",
                                                "text": "He assessed the scene to check for any danger, and agreed it was safe."
                                            },
                                            {
                                                "example_id": "175c0e19-1165-4719-8fd8-15da071ea9b9",
                                                "sense_id": "158cdf2e-97ed-3d45-9ba5-218c368dec96",
                                                "text": "They saw an angry scene outside the pub."
                                            },
                                            {
                                                "example_id": "d7f6c013-b110-4507-aaf0-d30ae10ae1db",
                                                "sense_id": "158cdf2e-97ed-3d45-9ba5-218c368dec96",
                                                "text": "Through what new scenes and changes must we pass!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2299cb9a-d699-3eb7-803f-9677731ebbda",
                                        "entry_id": "cafd9658-b510-3d3b-b1f5-49b1d26d11f9",
                                        "glosses": [
                                            "A landscape, or part of a landscape; scenery."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54d349a3-caf1-4c81-9cb1-38a329c47882",
                                                "sense_id": "2299cb9a-d699-3eb7-803f-9677731ebbda",
                                                "text": "A sylvan scene with various greens was drawn, / Shades on the sides, and in the midst a lawn."
                                            },
                                            {
                                                "example_id": "ad4f6553-ed58-4ada-a114-6f2a3c98b827",
                                                "sense_id": "2299cb9a-d699-3eb7-803f-9677731ebbda",
                                                "text": "He turned back to the scene before him and the enormous new block of council dwellings. The design was some way after Corbusier but the block was built up on plinths and resembled an Atlantic liner swimming diagonally across the site."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "007b332c-5b72-30d9-b64c-24ee5ebde0fa",
                                        "entry_id": "cafd9658-b510-3d3b-b1f5-49b1d26d11f9",
                                        "glosses": [
                                            "An exhibition of passionate or strong feeling before others, creating embarrassment or disruption; often, an artificial or affected action, or course of action, done for effect; a theatrical display."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c4e8130-bf1d-4848-9c94-686daebb4a7d",
                                                "sense_id": "007b332c-5b72-30d9-b64c-24ee5ebde0fa",
                                                "text": "The headmistress told the students not to cause a scene."
                                            },
                                            {
                                                "example_id": "30745b05-36f2-41be-a7dd-e6fa295889b3",
                                                "sense_id": "007b332c-5b72-30d9-b64c-24ee5ebde0fa",
                                                "text": "The crazy lady made a scene in the grocery store."
                                            },
                                            {
                                                "example_id": "4f9e8304-542c-4536-87e1-726dadbdc9bb",
                                                "sense_id": "007b332c-5b72-30d9-b64c-24ee5ebde0fa",
                                                "text": "Probably no lover of scenes would have had very long to wait or some explosions between parties, both equally ready to take offence, and careless of giving it."
                                            },
                                            {
                                                "example_id": "67714079-bf8b-41cc-85aa-f41a03e2b03b",
                                                "sense_id": "007b332c-5b72-30d9-b64c-24ee5ebde0fa",
                                                "text": "I'm having wicked dreams of leaving Tennessee\nHear Santa Monica, I swear it's calling me\nWon't make my mama proud, it's gonna cause a scene\nShe sees her baby girl, I know she's gonna scream"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "002dcfc5-3db9-393c-bbdb-bb451d237a3f",
                                        "entry_id": "cafd9658-b510-3d3b-b1f5-49b1d26d11f9",
                                        "glosses": [
                                            "An element of fiction writing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6e835b8c-bc1f-3aba-b6c6-80e17d066586",
                                        "entry_id": "cafd9658-b510-3d3b-b1f5-49b1d26d11f9",
                                        "glosses": [
                                            "A social environment consisting of an informal, vague group of people with a uniting interest; their sphere of activity; a subculture."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4913132e-9db9-4de4-94c4-f5696fe93819",
                                                "sense_id": "6e835b8c-bc1f-3aba-b6c6-80e17d066586",
                                                "text": "She got into the emo scene at an early age."
                                            },
                                            {
                                                "example_id": "900f3e5f-8755-4dea-ad4c-39b2f72d40a1",
                                                "sense_id": "6e835b8c-bc1f-3aba-b6c6-80e17d066586",
                                                "text": "Indie just isn't my scene."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3224e644-f431-3bf7-b77c-bba981bc4726",
                                        "entry_id": "cafd9658-b510-3d3b-b1f5-49b1d26d11f9",
                                        "glosses": [
                                            "A youth subculture popular in the Anglosphere in the 2000s and early 2010s."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fea64d79-5628-3fdd-94f4-7fe91bed7c22",
                                        "entry_id": "cafd9658-b510-3d3b-b1f5-49b1d26d11f9",
                                        "glosses": [
                                            "A fantasy that is acted out."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
