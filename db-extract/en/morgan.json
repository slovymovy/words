                                "target_senses": [
                                    {
                                        "sense_id": "0d6d5246-fa7d-3209-b817-31bcf9c15d10",
                                        "entry_id": "bb75935d-d634-3244-b5da-354dff32269d",
                                        "glosses": [
                                            "Fée de la légende arthurienne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9dbbb9a-be60-4269-bd70-a54c29b6aafe",
                                                "sense_id": "0d6d5246-fa7d-3209-b817-31bcf9c15d10",
                                                "text": "Morgane me fut chère\nDont le cœur n’est pas sûr.\nAvec le noble Arthur\nJ’ai longtemps fait la guerre."
                                            },
                                            {
                                                "example_id": "b96c98d6-8435-40c7-8db5-ac0310bf5dc1",
                                                "sense_id": "0d6d5246-fa7d-3209-b817-31bcf9c15d10",
                                                "text": "Plus encore, l’édition de 1528 « désarthurianise » Perceforest : le prologue multiplie les références antiques ou contemporaines et n’évoque jamais Arthur ou la Table Ronde, les titres de chapitres, comparés aux rubriques des divers témoins manuscrits, gomment les allusions arthuriennes (mises à part celles à Morgane, qui, nous l’avons vu, n’est plus véritablement arthurienne)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Morgane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "04b4cbe7-c156-33c4-8816-753d8f19a08e",
                                        "entry_id": "7baab167-bfc7-3a88-8765-2c9bcd7abc9b",
                                        "glosses": [
                                            "Prénom féminin breton popularisé par la fée Morgane, personnage de la légende arthurienne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c6f5659-f22e-4c3e-9146-a20c0d95868b",
                                                "sense_id": "04b4cbe7-c156-33c4-8816-753d8f19a08e",
                                                "text": "À 20 ans, Morgane Bourgeois connaîtra sa première cape à l’arrière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
