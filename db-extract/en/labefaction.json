                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "24b17db3-2e36-3fc1-ba02-c97f5eb71f8a",
                        "entry_id": "ed80ed17-f8f8-39a9-9a1e-def82b9e23a3",
                        "glosses": [
                            "The act of shaking or weakening or the resulting state; overthrow, ruination."
                        ],
                        "tags": [
                            "rare",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "094deb72-383f-4038-9277-7eb30ca611da",
                                "sense_id": "24b17db3-2e36-3fc1-ba02-c97f5eb71f8a",
                                "text": "Man's labefaction did not occur in time past; nor does it wait upon time future."
                            },
                            {
                                "example_id": "62d7f55c-24b3-4542-9ef3-1f9c7ec08c99",
                                "sense_id": "24b17db3-2e36-3fc1-ba02-c97f5eb71f8a",
                                "text": "1968, \"The Casualty Loss Deduction and Consumer Expectation: Section 165(c)(3) of the Internal Revenue Code,\" The University of Chicago Law Review, vol. 36, no. 1, p. 224 (citing 54 F.2d 537 (2d Cir. 1931)),\nThe court found \"simply a steady labefaction from wind and weather more rapid than usual because of structural defects.\""
                            }
                        ]
                    }
