                "senses": [
                    {
                        "sense_id": "901a5e50-7c71-391d-a12d-f0f1b6623f44",
                        "entry_id": "c4eb6bc0-8e4a-3ca2-9bd7-f2e7ae558211",
                        "glosses": [
                            "Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff5dba9f-e001-4382-b5c0-3bfd6c4ca1e6",
                                "sense_id": "901a5e50-7c71-391d-a12d-f0f1b6623f44",
                                "text": "Frau Czaschke ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c08a4a3e-648a-4170-8c3b-98a7c22c0456",
                                "sense_id": "901a5e50-7c71-391d-a12d-f0f1b6623f44",
                                "text": "Herr Czaschke wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "feb53d32-3e22-4c27-9c66-3db8e05f15a3",
                                "sense_id": "901a5e50-7c71-391d-a12d-f0f1b6623f44",
                                "text": "Die Czaschkes fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "17cff99a-3839-4f03-8095-480f4f2494c9",
                                "sense_id": "901a5e50-7c71-391d-a12d-f0f1b6623f44",
                                "text": "Der Czaschke trägt nie die Pullover, die die Czaschke ihm strickt."
                            },
                            {
                                "example_id": "723c2eba-a40f-4ba8-afbb-392232b605d5",
                                "sense_id": "901a5e50-7c71-391d-a12d-f0f1b6623f44",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Czaschke kommt, geht der Herr Czaschke.“"
                            },
                            {
                                "example_id": "7863f46c-e8c7-43fc-821b-137d28b26b85",
                                "sense_id": "901a5e50-7c71-391d-a12d-f0f1b6623f44",
                                "text": "Czaschke kommt und geht."
                            },
                            {
                                "example_id": "b863714e-f1ee-4c87-9205-fa9df5dbb736",
                                "sense_id": "901a5e50-7c71-391d-a12d-f0f1b6623f44",
                                "text": "Czaschkes kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
