                        "examples": [
                            {
                                "example_id": "e98e201a-177f-4030-ab72-435f3f67f59c",
                                "sense_id": "d1b8ae9f-3ac0-37c4-b41f-3000a68557d2",
                                "text": "Fürstenwalde liegt in Deutschlands Osten."
                            },
                            {
                                "example_id": "bc1149a9-3eee-4b2f-b528-9752295f244a",
                                "sense_id": "d1b8ae9f-3ac0-37c4-b41f-3000a68557d2",
                                "text": "„Fürstenwaldes Stadtgraben diente nicht nur der Verteidigung der Stadt, sondern auch der Regenentwässerung.“"
                            },
                            {
                                "example_id": "78cc05cb-78e6-4103-abca-27f91a072649",
                                "sense_id": "d1b8ae9f-3ac0-37c4-b41f-3000a68557d2",
                                "text": "„SA-Männer und ein Gendarm durchsuchen seine Wohnung, sperren das Telefon und bringen ihn nach Fürstenwalde ins Gefängnis.“"
                            }
                        ],
