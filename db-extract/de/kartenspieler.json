                    {
                        "translation_id": "9861e3d9-aca7-4d24-92f7-69cd229fcb27",
                        "source_entry_id": "b29e9117-fb30-3ea0-aab5-290087680c29",
                        "source_sense_id": "3a781291-700d-3275-9c0a-459c5f71db0e",
