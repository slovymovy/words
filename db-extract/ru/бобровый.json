                        ],
                        "examples": [
                            {
                                "example_id": "3b9c065b-e3f4-49bf-b9b1-9c09e920a7fd",
                                "sense_id": "9a648b30-3c56-3768-992e-2d93c0b3a405",
                                "text": "бобро́вая нора́",
                                "translation": "beaver's burrow",
                                "english": "beaver's burrow"
                            },
                            {
                                "example_id": "e7de3a90-dfc6-4f0e-bcec-9ee5575be981",
                                "sense_id": "9a648b30-3c56-3768-992e-2d93c0b3a405",
                                "text": "На поро́ге стоя́л стари́к лет шести́десяти, в дли́нной до земли́ шу́бе и в бобро́вой ша́пке.",
                                "translation": "An old man of sixty, in a long fur coat reaching to the ground, and a beaver cap, was standing at the door.",
                                "english": "An old man of sixty, in a long fur coat reaching to the ground, and a beaver cap, was standing at the door."
                            }
                        ]
                    }
