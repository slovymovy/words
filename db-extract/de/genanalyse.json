                "senses": [
                    {
                        "sense_id": "09d22e78-e77a-3279-88b2-0df8b809fbd8",
                        "entry_id": "d82d88d1-cd85-3398-81ec-f3cd5e04bd26",
                        "glosses": [
                            "Untersuchung und Beschreibung (Analyse) von Erbinformation auf der DNA (Gen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0fd2fb3-0175-460c-baec-4788c78af5aa",
                                "sense_id": "09d22e78-e77a-3279-88b2-0df8b809fbd8",
                                "text": "Für wenige Euro kann sich jeder, der das möchte, eine Genanalyse im Internet bestellen."
                            },
                            {
                                "example_id": "d088f258-a0e7-47a5-8d0c-ae97a4892db7",
                                "sense_id": "09d22e78-e77a-3279-88b2-0df8b809fbd8",
                                "text": "Eine Genanalyse verhilft Ihnen zu Leistungssteigerungen und einer Lifestyle-Optimierung!"
                            },
                            {
                                "example_id": "1b246786-41f8-4b24-a5ae-c78ab8cc45d3",
                                "sense_id": "09d22e78-e77a-3279-88b2-0df8b809fbd8",
                                "text": "Auf Basis einer Genanalyse kann über das Risiko, eine gewisse Krankheit zu bekommen, Auskunft gegeben werden. Das wirft ethische Fragen auf."
                            },
                            {
                                "example_id": "7b8363d0-06ee-4a08-b1a6-4ce5df34190c",
                                "sense_id": "09d22e78-e77a-3279-88b2-0df8b809fbd8",
                                "text": "„Im Rahmen der genetischen Beratung kann eine pränatale Genanalyse angeboten werden, die in der klinischen Routine allerdings aufwendig ist.“"
                            },
                            {
                                "example_id": "1d80434f-b40e-4733-834e-e4defa6808ba",
                                "sense_id": "09d22e78-e77a-3279-88b2-0df8b809fbd8",
                                "text": "„Die Genanalyse der Pflanzen belege, dass ihre Samen vermutlich von Menschen ausgebracht worden waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
