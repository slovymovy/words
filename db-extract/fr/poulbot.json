            {
                "entry_id": "e037aac6-cc43-3b1b-a2a3-eedfc35e424d",
                "word": "Poulbot",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6405bb3a-21ad-3a70-81d8-0dc9f288d158",
                        "entry_id": "e037aac6-cc43-3b1b-a2a3-eedfc35e424d",
                        "glosses": [
                            "Nom de famille, surtout connu pour Francisque Poulbot, dessinateur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d6b99b3-9334-4265-8d6d-7184e8b088ec",
                                "sense_id": "6405bb3a-21ad-3a70-81d8-0dc9f288d158",
                                "text": "De grandes banques naîtront bientôt\nOù ferez-vous alors vos culbutes\nVous, les pauvres gosses à Poulbot?"
                            },
                            {
                                "example_id": "5428a20d-8b4b-41aa-b145-6442116a6a62",
                                "sense_id": "6405bb3a-21ad-3a70-81d8-0dc9f288d158",
                                "text": "Le médecin a ordonné des gargarismes de liqueur Labarraque. Justement, il y a, sur la page de publicité du journal, des images de Poulbot qui vantent les vertus tonifiantes du Quinium Labarraque. On use de cette équivoque pour distraire un peu Jacqueline"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
