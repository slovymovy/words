                    "frequency": "Middle",
                    "semantic_group_id": "toxischer_schaden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Täter versuchte damals, den König mit tödlichem Gift im Wein zu <w>vergiften</w>."
                        },
                        {
                            "text": "Im Kriminalroman wollte die eifersüchtige Ehefrau ihren reichen Mann heimlich <w>vergiften</w>."
                        }
                    ],
                    "common_phrases": [
                        "jemanden mit Gift vergiften",
                        "wilde Tiere vergiften"
                    ]
                },
                {
                    "sense_id": "4852595a-993e-3a09-be0d-269bd4830fa4",
                    "sense_definition": "Durch den Verzehr oder das Einatmen giftiger Substanzen erkranken oder Schaden erleiden.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "toxischer_schaden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mehrere Kinder <w>vergifteten</w> sich gestern an ungenießbaren Beeren aus dem Wald."
                        },
                        {
                            "text": "Wer verdorbenen Fisch isst, kann sich leicht den Magen <w>vergiften</w>."
                        }
                    ],
                    "common_phrases": [
                        "sich an Pilzen vergiften",
                        "sich an Lebensmitteln vergiften"
                    ]
                },
                {
                    "sense_id": "17bb8573-6484-3cf6-9eb6-90e9d8418cda",
                    "sense_definition": "Etwas wie Wasser, Nahrung oder die Natur durch Schadstoffe ungenießbar oder gefährlich machen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kontamination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die alte Chemiefabrik am Fluss <w>vergiftete</w> über Jahre hinweg das Trinkwasser der Region."
                        },
                        {
                            "text": "Dunkle Abgase aus ungefilterten Schornsteinen <w>vergiften</w> die Luft in der gesamten Stadt."
                        }
                    ],
                    "synonyms": [
                        "kontaminieren",
                        "verseuchen"
                    ],
                    "antonyms": [
