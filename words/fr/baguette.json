                    "frequency": "Middle",
                    "semantic_group_id": "ustensile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il n'est pas facile de manger du riz avec des <w>baguettes</w> quand on débute."
                        },
                        {
                            "text": "Elle a commandé un bol de nouilles et a demandé une paire de <w>baguettes</w>."
                        }
                    ],
                    "common_phrases": [
