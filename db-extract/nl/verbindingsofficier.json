                        "entry_id": "7d3c684d-3a5d-3ac6-befb-a6b8d85d213b",
                        "glosses": [
                            "ambtenaar die zich bezighoudt met de externe contacten van een organisatie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24885dbd-bb5c-4ddb-a8b4-21eb6ca09649",
                                "sense_id": "ee9411fe-2020-3ece-ad02-220f87bab087",
                                "text": "Mogelijk is informatie over terreur niet goed met België uitgewisseld, omdat vorige zomer een belangrijke tussenpersoon is wegbezuinigd. Volgens het ministerie van Veiligheid en Justitie gaat het om de verbindingsofficier op de Nederlandse ambassade in België."
                            }
                        ]
