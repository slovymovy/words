                                "target_senses": [
                                    {
                                        "sense_id": "99ed0b23-1523-3045-8839-b3a29b2811f6",
                                        "entry_id": "603232d6-151a-3994-abbe-01b87aafb20d",
                                        "glosses": [
                                            "a Russian log hut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f693d0b8-5884-48b6-b415-beb949cc9e91",
                                                "sense_id": "99ed0b23-1523-3045-8839-b3a29b2811f6",
                                                "text": "From the doctor's I flitted over to a travel agency, obtained maps and booklets, studied them, learned that on the mountainside above Cedarn there were two or three clusters of cabins, rushed my order to the Cedarn Post Office, and a few days later had rented for the month of August what looked in the snapshots they sent me like a cross between a mujik's izba and Refuge Z, but it had a tiled bathroom and cost dearer than my Appalachian castle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4601f6a7-b20b-4ce4-89cc-1cc514af9117",
                        "source_entry_id": "959dff29-da43-3b36-b113-79755163c14b",
                        "source_sense_id": "0247e1fd-d941-374d-bff0-a733e052e945",
                        "target_lang_word": "изба",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "изба",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f3b104ea-ec24-3ae3-9a26-616ed7274e6a",
                                        "entry_id": "5ed5511c-09ae-3966-91d1-76963759035e",
                                        "glosses": [
                                            "деревянный срубный (бревенчатый) жилой дом в России"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f40de7f-2705-4b99-9d66-0e241540a2f4",
                                                "sense_id": "f3b104ea-ec24-3ae3-9a26-616ed7274e6a",
                                                "text": "Широкая пятистенная изба незаметно переходила в другие пристройки, из которых образовался крепкий деревянный четырёхугольник."
                                            },
                                            {
                                                "example_id": "45706b47-ad04-4ec2-83dd-495866293ca1",
                                                "sense_id": "f3b104ea-ec24-3ae3-9a26-616ed7274e6a",
                                                "text": "На краю распаханной под огород пустоши стояла старая изба лесника."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36016999-3449-328c-9a0f-c0c73cf6a034",
                                        "entry_id": "5ed5511c-09ae-3966-91d1-76963759035e",
                                        "glosses": [
                                            "внутреннее жилое помещение такого дома"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea3104ca-b61d-4470-a551-9492dbe6638c",
                                                "sense_id": "36016999-3449-328c-9a0f-c0c73cf6a034",
                                                "text": "Они прошли через сени, через жилую избу хозяев, и вошли в заднюю комнатку, в которой стояла кровать Марка."
                                            },
                                            {
                                                "example_id": "0593318a-7c36-4cb1-895c-81be6c202377",
                                                "sense_id": "36016999-3449-328c-9a0f-c0c73cf6a034",
                                                "text": "Она сделалась дюжей толстой бабою, он видел, как она колотила слюнявых ребят, мела избу, бранила пьяного мужа самыми отвратительными речами…"
                                            },
                                            {
                                                "example_id": "121c5c4f-31e8-4982-a650-864235374c5b",
                                                "sense_id": "36016999-3449-328c-9a0f-c0c73cf6a034",
                                                "text": "Антон припёр как можно плотнее дверь из крылечка в избу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7e50d97-6160-3996-b377-2143eac225b1",
                                        "entry_id": "5ed5511c-09ae-3966-91d1-76963759035e",
                                        "glosses": [
                                            "истор. в Московской Руси XVI века — канцелярия, присутственное место, о́рган центрального управления"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e36ca85-910f-4ecc-afe2-b86729c6a301",
                                                "sense_id": "f7e50d97-6160-3996-b377-2143eac225b1",
                                                "text": "Посольская изба."
                                            },
                                            {
                                                "example_id": "3a5b8a31-02d6-4982-a296-7b777a838d87",
                                                "sense_id": "f7e50d97-6160-3996-b377-2143eac225b1",
                                                "text": "Воеводская изба."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5beefe4f-89b0-3aec-b774-5bec4310e431",
