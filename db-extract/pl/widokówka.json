                                    {
                                        "sense_id": "b141a81b-9d36-30b9-83da-c3f36424825f",
                                        "entry_id": "325249e1-5af8-3a42-a157-b2562876cbca",
                                        "glosses": [
                                            "Scenic, like the image on a postcard."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "547c7c6a-683a-495a-b304-246e338fa567",
                                                "sense_id": "b141a81b-9d36-30b9-83da-c3f36424825f",
                                                "text": "It was a picture-postcard summer day."
                                            },
                                            {
                                                "example_id": "11b3349c-7cbc-457e-b047-183e3b2cf205",
                                                "sense_id": "b141a81b-9d36-30b9-83da-c3f36424825f",
                                                "text": "A place that's mostly sunny, but that isn't very picture postcard when your doctor has warned you never to go out with less than SP-30 sunblock."
                                            },
                                            {
                                                "example_id": "b8eb5d9d-f255-4e26-aef4-1b9230b58621",
                                                "sense_id": "b141a81b-9d36-30b9-83da-c3f36424825f",
                                                "text": "Aberdour station opened in 1890, welcoming day-trippers and travellers to the picture-postcard seaside village."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
