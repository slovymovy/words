                                            {
                                                "example_id": "523f1602-212f-4ad7-9123-1edf99517b62",
                                                "sense_id": "661e7a20-0fb2-3af7-ac15-bb45edb91c59",
                                                "text": "Это от судьи триста; это от почтмейстера триста, шестьсот, семьсот, восемьсот…"
                                            },
                                            {
                                                "example_id": "96c5cf21-c0f2-432d-a118-3882566b4499",
                                                "sense_id": "661e7a20-0fb2-3af7-ac15-bb45edb91c59",
                                                "text": "Думаю себе: «Не получить мне семисот рублей; всё равно проиграю»."
                                            },
                                            {
                                                "example_id": "73a0d1ee-5fe8-4cf4-a486-602c94d6b2cb",
                                                "sense_id": "661e7a20-0fb2-3af7-ac15-bb45edb91c59",
                                                "text": "Лицо пана стало изменяться к худшему. — Семьсот, семьсот, а не пятьсот, сейчас, сию минуту в руки! — надбавил Митя, почувствовав нечто нехорошее."
                                            },
                                            {
                                                "example_id": "5aa4f2b7-185b-4f58-bcd9-1ae0fd3716ce",
                                                "sense_id": "661e7a20-0fb2-3af7-ac15-bb45edb91c59",
                                                "text": "Теперь туркам угрожал не десятитысячный летучий отряд, а стошестидесятипятитысячная русская армия с более чем семьюстами орудиями, наступавшая по трём направлениям."
                                            }
                                        ]
                                    }
                                ]
                            }
