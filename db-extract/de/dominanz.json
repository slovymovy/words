                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2512f6b-49ef-4beb-9277-fdf6c1d40e7f",
                                                "sense_id": "4095d496-b36b-32d5-9ea0-fc08620a89c2",
                                                "text": "Kiedy jedna grupa kontroluje drugą grupę i używa niehumanitarnych środków, by podtrzymać tę dominację, mamy do czynienia z apartheidem"
                                            },
                                            {
                                                "example_id": "8b56637a-004f-4e81-98e6-df1283a1b9c5",
                                                "sense_id": "4095d496-b36b-32d5-9ea0-fc08620a89c2",
                                                "text": "Ponad pół wieku Europa Wschodnia znajdowała się pod dominacją radziecką."
                                            },
                                            {
                                                "example_id": "4724eda0-057b-497e-abe8-7a39e2795e25",
                                                "sense_id": "4095d496-b36b-32d5-9ea0-fc08620a89c2",
                                                "text": "Przed muzułmańską dominacją Sycylia przez kilka stuleci stanowiła jedną z prowincji Cesarstwa Bizantyjskiego ze stolicą w Syrakuzach, gdzie znajdowały się najważniejsze ośrodki administracyjne."
                                            }
