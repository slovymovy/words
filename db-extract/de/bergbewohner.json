                ],
                "senses": [
                    {
                        "sense_id": "8274b729-ad0f-38a4-8629-37ba24bc09b6",
                        "entry_id": "fb8c3924-5ccc-3449-82da-bc17cbdc7efc",
                        "glosses": [
                            "Person, die in den Bergen lebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e37122f8-863e-4abf-8b9c-6eef85531aea",
                                "sense_id": "8274b729-ad0f-38a4-8629-37ba24bc09b6",
                                "text": "„Keiner der Bergbewohner wagte es, ihm nachzusetzen, und es ist wahrscheinlich, dass sie seinen Tod in der Kälte begrüßt hätten; doch als sie einige Tage darauf seine Schreie aus einer entfernten Bergschlucht hörten, wurde ihnen bewusst, dass es ihm irgendwie gelungen war zu überleben - und dass auf irgendeine Weise seine Beseitigung nottat.“"
                            },
                            {
                                "example_id": "63f3d2fd-b75a-4391-a128-f63544f8d332",
                                "sense_id": "8274b729-ad0f-38a4-8629-37ba24bc09b6",
                                "text": "„Seine Onkel und Tanten sind Bergbewohner, die wahrscheinlich nie zuvor eine so große Menschenmenge gesehen haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
