                "senses": [
                    {
                        "sense_id": "050a87cb-c86b-3e6a-bef2-c906f4862270",
                        "entry_id": "a5156536-490e-3671-8593-8b647601bddf",
                        "glosses": [
                            "der Mutter Jesu, Maria, geweihte Kirche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d933c5a5-c677-4296-b997-c6c295991f47",
                                "sense_id": "050a87cb-c86b-3e6a-bef2-c906f4862270",
                                "text": "Die Ostermesse findet in der Marienkirche statt."
                            },
                            {
                                "example_id": "955d1ae5-bc9b-42b5-9cd8-0f44a6e617b1",
                                "sense_id": "050a87cb-c86b-3e6a-bef2-c906f4862270",
                                "text": "„Die Marienkirche lag einige Kilometer entfernt, aber obwohl sie nur zwei Stunden geschlafen hatte, fühlte sie sich hellwach.“"
                            },
                            {
                                "example_id": "b622629d-4744-4253-9017-a1b40b007729",
                                "sense_id": "050a87cb-c86b-3e6a-bef2-c906f4862270",
                                "text": "„In vielen Städten wurden nach Pogromen über den zerstörten Synagogen Marienkirchen errichtet, um den verhassten Ort mit einem der Muttergottes gewidmeten Bau zu ›reinigen‹.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
