                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f721fa6a-b3fd-48f6-9fe2-7ceef1b059a9",
                                "sense_id": "ae24ae2a-4d7b-341e-8a5d-4ad19b9df369",
                                "text": "„Er ist ein ›Agent, der zwei Gegenparte zugleich vertreten musste‹ […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "da6808ec-2b51-3b31-a709-a5552d727dbc",
                        "entry_id": "17ebf895-f25d-334c-a2e6-a45c4753f449",
                        "glosses": [
                            "Ergänzung oder Entsprechung zu einem Gegenstand oder einer Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e60296b2-6aa5-49b2-a14e-9246870c2ab1",
                                "sense_id": "da6808ec-2b51-3b31-a709-a5552d727dbc",
                                "text": "„Tatsächlich gibt es Gerüchte, dass diese Operationen mit denen ihrer amerikanischen Gegenparte vergleichbar sind, […]“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
