                    {
                        "sense_id": "7366ba95-091f-374a-bf89-26fc6455bad4",
                        "entry_id": "25d4327c-ccf3-36bf-8b4b-fd323e51eba0",
                        "glosses": [
                            "het gerechtelijk verklaren dat iemand schuldig is aan de genoemde misdaden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed8fe26d-e215-4d99-85a0-48036910f629",
                                "sense_id": "7366ba95-091f-374a-bf89-26fc6455bad4",
                                "text": "Die vragen die aan de essentie van de zaak voorbijgingen en de mogelijkheid uitsloten die essentie te ontdekken, zoals alle vragen die voor het gerecht worden gesteld, hadden slechts ten doel een kanaal te realiseren waarlangs de rechters wilden dat de antwoorden van de aangeklaagden vloeiden om hen zo tot het beoogde doel te voeren, namelijk de schuldigverklaring."
                            },
                            {
                                "example_id": "9d7e1c7e-1c66-4df5-a80e-f0d55058be58",
                                "sense_id": "7366ba95-091f-374a-bf89-26fc6455bad4",
                                "text": "Deskundigen denken dat alleen strengere vonnissen het probleem niet oplossen. Rechtszaken duren vaak jaren en het komt niet vaak tot een schuldigverklaring."
                            }
                        ]
                    }
                ],
