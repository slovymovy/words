                    "frequency": "Middle",
                    "semantic_group_id": "positionner_au_milieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu dois <w>centrer</w> le titre du document pour que la présentation soit plus nette."
                        },
                        {
                            "text": "Le photographe a préféré <w>centrer</w> le sujet afin d'obtenir un portrait parfaitement équilibré."
                        }
                    ],
                    "common_phrases": [
                        "centrer le texte",
                        "centrer une image",
                        "centrer un élément"
