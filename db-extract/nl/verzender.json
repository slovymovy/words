                                "target_senses": [
                                    {
                                        "sense_id": "442f7b34-c825-345a-8f4f-04a5e5adf4fe",
                                        "entry_id": "1933a8ed-17fb-3f2a-9bf6-3b4cb7a7823a",
                                        "glosses": [
