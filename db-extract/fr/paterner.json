                "senses": [
                    {
                        "sense_id": "3f9a24b7-537f-3430-8735-fc45910a0f56",
                        "entry_id": "8e131ec7-771e-3c79-a582-223caa1be5c7",
                        "glosses": [
                            "Jouer son rôle de père."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "13975bb5-899b-45ef-9d97-7028623f1e6c",
                                "sense_id": "3f9a24b7-537f-3430-8735-fc45910a0f56",
                                "text": "Stéphane Dichev médite : « N'attribuons pas à un sexe un rôle exclusif. Maternité ne signifie pas appropriation. Je demande à paterner. » — (L'Express, 27 septembre 1980)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5dc58135-2ffd-45a7-b8d4-d56db85e14c3",
                        "source_entry_id": "8e131ec7-771e-3c79-a582-223caa1be5c7",
                        "source_sense_id": "3f9a24b7-537f-3430-8735-fc45910a0f56",
                        "target_lang_word": "bevatern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bevatern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "49742e8f-3415-3d8a-bdfa-b50f9d17ce7c",
                                        "entry_id": "020ef310-be25-3614-afc3-445f4394d8dd",
                                        "glosses": [
                                            "zum Vater machen, zum Vater geben"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e252706f-03fa-4fcb-8302-4be04a4337c2",
                                                "sense_id": "49742e8f-3415-3d8a-bdfa-b50f9d17ce7c",
                                                "text": "Es lassen sich hier weitere okkasionelle Bildungen wie behätscheln, betottern oder das bei Mackensen (WM) aufgeführte bevatern anschließen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "05959489-92ea-3f2e-93f0-425dcc0e77d0",
                                        "entry_id": "020ef310-be25-3614-afc3-445f4394d8dd",
                                        "glosses": [
                                            "wie ein Vater zu jemandem sein, jemanden versorgen, sich um ihn sorgen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a1af827-5e9a-4531-aae8-b1c1f2c44100",
                                                "sense_id": "05959489-92ea-3f2e-93f0-425dcc0e77d0",
                                                "text": "Es lassen sich hier weitere okkasionelle Bildungen wie behätscheln, betottern oder das bei Mackensen (WM) aufgeführte bevatern anschließen."
                                            },
                                            {
                                                "example_id": "79087491-5504-46f0-9632-ea7b15c12c9f",
                                                "sense_id": "05959489-92ea-3f2e-93f0-425dcc0e77d0",
                                                "text": "„Und selbst wenn er aufgrund seiner eigenen Problematik bemuttern oder »bevatern« möchte - es reicht nie. Denn etwas, was in der Kindheit ausgeblieben ist, kann man später nicht nachholen.“"
                                            },
                                            {
                                                "example_id": "86e4c123-e1e8-4239-a050-06449c3400cc",
                                                "sense_id": "05959489-92ea-3f2e-93f0-425dcc0e77d0",
                                                "text": "„Er kümmert sich voll, aber er versucht nicht, uns zu bevatern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
