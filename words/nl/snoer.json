    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "32449a3d-2c3f-34c8-8c02-75ec7198d5f7",
                    "sense_definition": "een soepele elektriciteitskabel die binnenshuis gebruikt wordt",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verbinding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zit er aan dat <w>snoer</w> al een stekker?",
                            "target_lang_translations": {
                                "en": "Is there already a plug on that <w>cord</w>?"
                            }
                        },
                        {
                            "text": "Pas op dat je niet over het <w>snoer</w> van de stofzuiger struikelt.",
                            "target_lang_translations": {
                                "en": "Be careful not to trip over the vacuum cleaner <w>flex</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "kabel"
                    ],
                    "common_phrases": [
                        "elektrisch snoer",
                        "lang snoer"
                    ],
                    "target_lang_definitions": {
                        "en": "a flexible electrical cable used indoors"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cord",
                                "target_lang_sense_clarification": "flexible electrical cable"
                            },
                            {
                                "target_lang_word": "flex",
                                "target_lang_sense_clarification": "insulated electrical wire (UK/Ireland)"
                            },
                            {
                                "target_lang_word": "lead",
                                "target_lang_sense_clarification": "electrical connection cable"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38ba25aa-f32c-3a8e-b633-17cc5f04c444",
                    "sense_definition": "een ketting van een aantal aan een draad geregen voorwerpen, zoals kralen of parels",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sieraad",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij droeg een prachtig <w>snoer</w> van witte parels om haar hals.",
                            "target_lang_translations": {
                                "en": "She wore a beautiful <w>string</w> of white pearls around her neck."
                            }
                        },
                        {
                            "text": "Het <w>snoer</w> kralen brak en alle kralen rolden over de vloer.",
                            "target_lang_translations": {
                                "en": "The <w>necklace</w> of beads broke and all the beads rolled across the floor."
                            }
                        }
                    ],
                    "synonyms": [
                        "halssnoer",
                        "ketting"
                    ],
                    "common_phrases": [
                        "snoer parels",
                        "snoer kralen"
                    ],
                    "target_lang_definitions": {
                        "en": "a chain of objects, such as beads or pearls, strung on a thread"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "string",
                                "target_lang_sense_clarification": "of pearls or beads"
                            },
                            {
                                "target_lang_word": "necklace",
                                "target_lang_sense_clarification": "jewelry worn around the neck"
                            },
                            {
                                "target_lang_word": "strand",
                                "target_lang_sense_clarification": "a single string of jewelry"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36b0a596-52ec-338c-9f54-290d015da955",
                    "sense_definition": "buigzaam materiaal in een zeer langgerekte vorm waarmee je dingen kunt vastbinden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verbinding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij gebruikte een stevig <w>snoer</w> om de bundel kranten bij elkaar te houden.",
                            "target_lang_translations": {
                                "en": "He used a sturdy <w>cord</w> to keep the bundle of newspapers together."
                            }
                        },
                        {
                            "text": "Met een dun <w>snoer</w> bond ze de takken van de plant vast.",
                            "target_lang_translations": {
                                "en": "She tied the branches of the plant with a thin <w>string</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "koord",
                        "lijn",
                        "touw"
                    ],
                    "common_phrases": [
                        "stevig snoer"
                    ],
                    "target_lang_definitions": {
                        "en": "flexible material in a very elongated form used for tying things together"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cord",
                                "target_lang_sense_clarification": "thin rope or string"
                            },
                            {
                                "target_lang_word": "string",
                                "target_lang_sense_clarification": "thin twine for tying"
                            },
                            {
                                "target_lang_word": "line",
                                "target_lang_sense_clarification": "a length of cord"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5417a0c2-1dd0-31f7-b083-ec0253d53f93",
                    "sense_definition": "een dunne draad waaraan een of meer vishaakjes zijn bevestigd",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "visserij",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De visser wierp zijn <w>snoer</w> behoedzaam uit in het kabbelende water.",
                            "target_lang_translations": {
                                "en": "The fisherman cautiously cast his <w>line</w> into the rippling water."
                            }
                        },
                        {
                            "text": "Er zat een knoop in het <w>snoer</w> waardoor hij de vis niet kon binnenhalen.",
                            "target_lang_translations": {
                                "en": "There was a knot in the <w>fishing line</w>, which meant he couldn't reel in the fish."
                            }
                        }
                    ],
                    "synonyms": [
                        "vislijn"
                    ],
                    "common_phrases": [
                        "vlijmscherp snoer"
                    ],
                    "target_lang_definitions": {
                        "en": "a thin thread to which one or more fish hooks are attached"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fishing line",
                                "target_lang_sense_clarification": "thread used for fishing"
                            },
                            {
                                "target_lang_word": "line",
                                "target_lang_sense_clarification": "short for fishing line"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ec71ef3-edc1-366e-bc42-30af5dbea907",
                    "sense_definition": "een verouderde term voor een <w>schoondochter</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "familie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In oude teksten wordt de vrouw van de zoon soms aangeduid als <w>snoer</w>.",
                            "target_lang_translations": {
                                "en": "In old texts, the son's wife is sometimes referred to as a <w>daughter-in-law</w>."
                            }
                        },
                        {
                            "text": "De oude man sprak met veel respect over zijn <w>snoer</w>.",
                            "target_lang_translations": {
                                "en": "The old man spoke with great respect about his <w>daughter-in-law</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "schoondochter"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "vrijwel niet meer in gebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "an archaic term for a daughter-in-law"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "daughter-in-law",
                                "target_lang_sense_clarification": "archaic usage"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa5bd815-5868-36f4-82bd-e852ed327bee",
                    "sense_definition": "een vrouw die tegen vergoeding seks heeft met mannen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "belediging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In die oude klucht werden hoeren en <w>snoeren</w> vaak in één adem genoemd.",
                            "target_lang_translations": {
                                "en": "In that old farce, whores and <w>harlots</w> were often mentioned in the same breath."
                            }
                        },
                        {
                            "text": "Het woord <w>snoer</w> werd vroeger als scheldwoord voor een lichtekooi gebruikt.",
                            "target_lang_translations": {
                                "en": "The word 'snoer' was formerly used as a slur for a <w>strumpet</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "hoer",
                        "prostituee",
                        "lichtekooi",
                        "slet"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "historisch scheldwoord"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a woman who has sex with men for payment; often used as an insult"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "harlot",
                                "target_lang_sense_clarification": "archaic/literary insult"
                            },
                            {
                                "target_lang_word": "strumpet",
                                "target_lang_sense_clarification": "historical derogatory term"
                            },
                            {
                                "target_lang_word": "prostitute",
                                "target_lang_sense_clarification": "formal term"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "49e758f0-e1e8-34b7-8ee4-2b6b7d4d85b4",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>snoeren</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>snoer</w> mijn veters altijd heel strak vast voor het hardlopen.",
                            "target_lang_translations": {
                                "en": "I always <w>lace</w> my shoelaces very tightly before running."
                            }
                        },
                        {
                            "text": "Ik <w>snoer</w> hem de mond met een onweerlegbaar argument.",
                            "target_lang_translations": {
                                "en": "I <w>silence</w> him with an irrefutable argument."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "first person singular present tense of 'to lace' or 'to tighten'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lace",
                                "target_lang_sense_clarification": "to tighten laces"
                            },
                            {
                                "target_lang_word": "silence",
                                "target_lang_sense_clarification": "to shut someone up"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "037a13bc-5d2c-3279-b85d-d4dd14c0e5df",
                    "sense_definition": "gebiedende wijs van <w>snoeren</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Snoer</w> die tas goed dicht voordat je vertrekt.",
                            "target_lang_translations": {
                                "en": "<w>Tighten</w> that bag securely before you leave."
                            }
                        },
                        {
                            "text": "<w>Snoer</w> hem de mond als hij weer begint te liegen.",
                            "target_lang_translations": {
                                "en": "<w>Silence</w> him if he starts lying again."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperatief"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "imperative form of 'to lace' or 'to tighten'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lace up",
                                "target_lang_sense_clarification": "command to tighten"
                            },
                            {
                                "target_lang_word": "silence",
                                "target_lang_sense_clarification": "command to shut someone up"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}