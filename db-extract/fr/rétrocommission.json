                                "target_senses": [
                                    {
                                        "sense_id": "5bb4a57c-0a62-33a7-bcb7-bc79269cad85",
                                        "entry_id": "6bec24fc-5962-38a3-97d0-745e3a14f54b",
                                        "glosses": [
                                            "A backward kick; a retrograde movement of an extremity."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13249ecf-1ee3-4584-9a39-6d8743ccf82a",
                                                "sense_id": "5bb4a57c-0a62-33a7-bcb7-bc79269cad85",
                                                "text": "Kickbacks work the triceps muscle at the back of your arm. Exercising these muscles helps eliminate arm jiggle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd4e31f0-f6df-3933-bd62-b9789cf7940c",
                                        "entry_id": "6bec24fc-5962-38a3-97d0-745e3a14f54b",
                                        "glosses": [
                                            "A covert, often illegal, payment in return for a favor consisting of providing an opportunity of chargeable transaction; especially, a kind of quid pro quo in which if you (an insider) secretly help me (an outsider) win the bid for the contract then I will secretly send you a portion of the contract value; thus, a kind of bribe."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6acc3e01-ad6d-4b47-a57d-f7a4f83ab03b",
                                                "sense_id": "fd4e31f0-f6df-3933-bd62-b9789cf7940c",
                                                "text": "Central to his [Yury Skuratov's] investigation were kickbacks supposedly paid by a Swiss construction company for contracts to restore government buildings, including both houses of parliament."
                                            },
                                            {
                                                "example_id": "148fff75-5058-43d2-93e7-9961e4066373",
                                                "sense_id": "fd4e31f0-f6df-3933-bd62-b9789cf7940c",
                                                "text": "You sell cars and help arrange car insurance for buyers. Insurance brokers pay back part of their commissions to you for referring customers to them. You must include the kickbacks in your income."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd74cef8-955c-3ac9-8ab5-b41159376248",
                                        "entry_id": "6bec24fc-5962-38a3-97d0-745e3a14f54b",
                                        "glosses": [
                                            "Recoil; a sudden backward motion, usually in the direction of the operator."
                                        ],
