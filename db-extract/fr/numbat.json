                        "sense_id": "f3888e58-4d26-3fb4-812e-c550bf42f3bf",
                        "entry_id": "cb4ee143-3c1a-386c-9c74-90a8e2648756",
                        "glosses": [
                            "Petit marsupial endémique d’Australie occidentale se nourrissant presque exclusivement de termites."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a88c3316-5667-457b-99e2-671f4f9bf7ec",
                                "sense_id": "f3888e58-4d26-3fb4-812e-c550bf42f3bf",
                                "text": "Les termites étant actifs de jour, le numbat est le seul marsupial australien totalement diurne."
                            },
                            {
                                "example_id": "71c4bcc3-db97-4468-a825-fde419b9ceeb",
                                "sense_id": "f3888e58-4d26-3fb4-812e-c550bf42f3bf",
                                "text": "«Chère Madame Bardot, vous voulez protéger les chats et c’est très bien. Nous, nous voulons protéger la bettongie à queue touffue, l’opossum à queue en anneau des côtes ouest, et aussi le numbat»."
                            }
                        ]
                    }
                ],
