                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4f2c44b2-de12-3f9c-8db9-48c0968ea68d",
                                        "entry_id": "b91fbf90-0fb4-350e-b2d8-a184f545bb3f",
                                        "glosses": [
                                            "A hole for an arm in a piece of clothing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "980c9917-c363-4fbe-bc92-996ff1b60a21",
                                                "sense_id": "4f2c44b2-de12-3f9c-8db9-48c0968ea68d",
                                                "text": "He... violently pull'd off her Riding-Hood, and tore it at the Arm Holes in pulling it off."
