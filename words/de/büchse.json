                    "frequency": "Middle",
                    "semantic_group_id": "behaelter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er nahm eine alte <w>Büchse</w> aus dem Regal und suchte darin nach passenden Schrauben."
                        },
                        {
                            "text": "Im Vorratskeller steht noch eine ungeöffnete <w>Büchse</w> mit getrockneten Kräutern."
                        }
                    ],
                    "synonyms": [
                        "Dose"
                    ],
                    "antonyms": [
                        "Flasche"
                    ],
                    "common_phrases": [
