                        "glosses": [
                            "One who or that which aborts."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8ca1ce9-8398-440b-97ea-11248a55ada6",
                                "sense_id": "cbb546cf-ac21-3684-a6a0-fd65e1b4f32d",
                                "text": "1927, Infectious Abortion of Cattle, Washington, D.C.: U.S. Department of Agriculture Farmers’ Bulletin No. 1536, p. 6,\nAlthough cows which have aborted may conceive at the first service, it is often necessary to breed an aborter repeatedly before conception takes place."
                            }
                        ]
                    },
                    {
                        "sense_id": "165a8c8a-a43a-3bd4-b28d-8b90ca9b4d1a",
                        "entry_id": "2747999c-d05a-3eb7-bf68-fb7fbf1f1203",
                        "glosses": [
                            "One who or that which aborts.",
                            "One who has an abortion."
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "62c86d07-ef73-402a-bb62-bd6e7128e98d",
                                "sense_id": "165a8c8a-a43a-3bd4-b28d-8b90ca9b4d1a",
                                "text": "[…] these findings are consistent with other studies which have shown that most aborters tend to be highly informed about contraceptives but failed to use them at the time they became pregnant."
                            }
                        ]
                    },
                    {
                        "sense_id": "339cfb2e-7883-3095-91c3-948d0907245f",
                        "entry_id": "2747999c-d05a-3eb7-bf68-fb7fbf1f1203",
                        "glosses": [
                            "One who performs an abortion."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "2a84da17-4cf7-4cdf-b31d-6819f9fd17f9",
                                "sense_id": "339cfb2e-7883-3095-91c3-948d0907245f",
                                "text": "But when is one an accomplice? Is a thief the accomplice of his receiver, a briber the accomplice of the official he corrupts […] an abortee the accomplice of the aborter […]?"
                            }
                        ]
                    }
                ],
