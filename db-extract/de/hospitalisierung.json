                "senses": [
                    {
                        "sense_id": "d72f5489-1edd-3037-81ae-a1a6ddc4a4d0",
                        "entry_id": "16b011ab-45d6-389c-a0e5-39f2b8dc87c6",
                        "glosses": [
                            "Aufnahme/Einweisung in ein Krankenhaus (Hospital)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32de20ab-c7da-42cd-b434-28c4fd49fd9b",
                                "sense_id": "d72f5489-1edd-3037-81ae-a1a6ddc4a4d0",
                                "text": "„In einer retrospektiven Beobachtungsstudie wurde die deutschlandweite fallpauschalenbezogene Krankenhausstatistik (DRG-Statistik; DRG, „diagnosis related groups“) zwischen 2007 und 2015 ausgewertet. Wir untersuchten Hospitalisierungen, Anzahl der Todesfälle und die Inanspruchnahme einer Intensivtherapie.“"
                            },
                            {
                                "example_id": "a100283b-f953-4b19-9ec2-fe5b1288731d",
                                "sense_id": "d72f5489-1edd-3037-81ae-a1a6ddc4a4d0",
                                "text": "„Die Hospitalisierungen nahmen nun aber wieder zu auf durchschnittlich über 60 pro Tag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a04c0d3-2373-4e17-ba2b-57d0a06ece9f",
