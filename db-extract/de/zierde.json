                    {
                        "sense_id": "133f558b-66bf-34f4-95fd-7e69cb80e3d1",
                        "entry_id": "39de8de6-f274-3b10-8526-7ebbe3babb49",
                        "glosses": [
                            "Schmuck, Verschönerung, Verzierung"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "e7c70870-1884-4fd0-ba4d-c19462210c0a",
                                "sense_id": "133f558b-66bf-34f4-95fd-7e69cb80e3d1",
                                "text": "Die Eiche ist eine wahre Zierde für unseren Garten."
                            },
                            {
                                "example_id": "d49a94ed-21ef-4e84-a8d8-ed057fbd61ba",
                                "sense_id": "133f558b-66bf-34f4-95fd-7e69cb80e3d1",
                                "text": "„Marie singt auch sehr schön; jedem Chor würde sie zur Zierde gereichen.“"
                            },
                            {
                                "example_id": "8e480088-309a-499f-94ce-3b6decf886a4",
                                "sense_id": "133f558b-66bf-34f4-95fd-7e69cb80e3d1",
                                "text": "„Der Giebel schien stets zu lächeln, es war ein schönes Haus, die Zierde der Gegend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a6b8fd4-832b-422f-9d7e-f08851db65e8",
                        "source_entry_id": "39de8de6-f274-3b10-8526-7ebbe3babb49",
                        "source_sense_id": "133f558b-66bf-34f4-95fd-7e69cb80e3d1",
                        "source_sense_description": "gehoben: Schmuck, Verschönerung, Verzierung",
                        "target_lang_word": "ornament",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ornament",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41a5e8c5-2a16-3dc4-a4f0-a84a580a23dc",
                                        "entry_id": "14d5315e-7c56-37ef-af6e-4f614f60ec17",
                                        "glosses": [
                                            "An element of decoration; that which embellishes or adorns."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e7527c3-83d9-44ac-b571-ebb0c9efe301",
                                                "sense_id": "41a5e8c5-2a16-3dc4-a4f0-a84a580a23dc",
                                                "text": "Dust are our frames; and, gilded dust, our pride / Looks only for a moment whole and sound; / Like that long-buried body of the king / Found lying with his urns and ornaments, / Which at a touch of light, an air of heaven, / Slipt into ashes and was found no more."
                                            },
                                            {
                                                "example_id": "6a0d7426-48dc-48c4-b79d-775195da78f4",
                                                "sense_id": "41a5e8c5-2a16-3dc4-a4f0-a84a580a23dc",
                                                "text": "I'm a bit short on brain myself; the old bean would appear to have been constructed more for ornament than for use."
                                            },
                                            {
                                                "example_id": "a4b89678-c9f6-48cf-a237-f3e5e1eef89f",
                                                "sense_id": "41a5e8c5-2a16-3dc4-a4f0-a84a580a23dc",
                                                "text": "Drawings and pictures are more than mere ornaments in scientific discourse. Blackboard sketches, geological maps, diagrams of molecular structure, astronomical photographs, MRI images, the many varieties of statistical charts and graphs: These pictorial devices are indispensable tools for presenting evidence, for explaining a theory, for telling a story."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74ca53cd-45bb-38f0-b41f-154ceead094f",
                                        "entry_id": "14d5315e-7c56-37ef-af6e-4f614f60ec17",
                                        "glosses": [
                                            "A Christmas tree decoration."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e5781031-7b43-30fc-93d7-b804bd6c81b4",
                                        "entry_id": "14d5315e-7c56-37ef-af6e-4f614f60ec17",
                                        "glosses": [
                                            "A musical flourish that is unnecessary to the overall melodic or harmonic line, but serves to decorate that line."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c08bea5a-61f7-3afc-9d6b-cda6daf9225f",
                                        "entry_id": "14d5315e-7c56-37ef-af6e-4f614f60ec17",
                                        "glosses": [
                                            "The articles used in church services."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "43446cc1-8a09-309f-b07b-a36cf0843a0c",
                                        "entry_id": "14d5315e-7c56-37ef-af6e-4f614f60ec17",
                                        "glosses": [
                                            "A characteristic that has a decorative function (typically in order to attract a mate)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "ornament",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2291a26-0ffb-3540-889f-9fa6588287b5",
                                        "entry_id": "532b53af-a44e-3ee3-8204-0a629400ede0",
                                        "glosses": [
                                            "To decorate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9d6d2b9-57a4-4841-87ba-89adfc0bf0ff",
                                                "sense_id": "d2291a26-0ffb-3540-889f-9fa6588287b5",
                                                "text": "We will ornament the windows with trim to make the room seem brighter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0dbfe5f-677d-3f45-9d7b-84fff09447b4",
                                        "entry_id": "532b53af-a44e-3ee3-8204-0a629400ede0",
                                        "glosses": [
                                            "To add to."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7790dee0-e91f-4de3-996c-93299ee4256e",
                                                "sense_id": "f0dbfe5f-677d-3f45-9d7b-84fff09447b4",
                                                "text": "The editor ornamented his plain writing, making it fancier but less clear."
                                            },
                                            {
                                                "example_id": "fdd06661-1b6a-4d91-8e54-69b283061324",
                                                "sense_id": "f0dbfe5f-677d-3f45-9d7b-84fff09447b4",
                                                "text": "Not a scene goes by that hasn't been ornamented with a split screen, a freeze frame, a caption, a voice-over, a switch between monochrome and colour, or a change of the aspect radio^([sic – meaning ratio])."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99e14f29-29c0-4166-96ca-4c9aecc98c97",
                        "source_entry_id": "39de8de6-f274-3b10-8526-7ebbe3babb49",
                        "source_sense_id": "133f558b-66bf-34f4-95fd-7e69cb80e3d1",
