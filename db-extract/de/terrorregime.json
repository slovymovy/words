                        "glosses": [
                            "Regime, das seine Herrschaft mit Terror ausübt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a983a31-3e99-412c-8c2c-c01850f35fb5",
                                "sense_id": "a57777ec-8574-3726-8a96-a74adc6a66db",
                                "text": "„Es sind vereinzelte Stimmen, meist Aussagen von Missionaren, die ab 1895 erste Nachrichten von Leopolds Terrorregime nach Europa bringen.“"
                            },
                            {
                                "example_id": "88ffa5bc-712b-4298-a437-74e86a675433",
                                "sense_id": "a57777ec-8574-3726-8a96-a74adc6a66db",
                                "text": "„Der Spannungsbogen der Geschichte wird in den folgenden Kapiteln durch das sich nun immer deutlicher abzeichnende Ende des Hitlerschen Terrorregimes und den im Lager wachsenden Widerstand gegen die SS-Wachmannschaft erzeugt.“"
                            }
                        ],
