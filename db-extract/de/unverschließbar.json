                        "examples": [
                            {
                                "example_id": "b1dc94df-ef8e-40ad-88ca-65200660b4c0",
                                "sense_id": "f8b5cdf6-5206-3680-93cf-6b982d2472ba",
                                "text": "„Aber ich hatte Glück: die freundliche Wirtin war eine Badenserin; sie führte mich in ein ganz nettes Gaststübchen. Es war unverschließbar; ich schob den Waschtisch vor die Tür und schlief den Schlaf der Jugend und des guten Gewissens.“"
                            },
                            {
                                "example_id": "4cfa3131-73a7-467e-a4f5-3e67425cb6a3",
                                "sense_id": "f8b5cdf6-5206-3680-93cf-6b982d2472ba",
                                "text": "„Der Mensch dünkt sich so ein Kunstwerk zu sein, so sich in seiner Gewalt zu haben, wie ein richtiges gutes Schloß, das man kinderleicht auf- und zuschließt. Und doch ist nichts so unverschließbar wie ein Menschenherz: die Mienen künden von ihm, und in den Worten zittern seine Schläge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
