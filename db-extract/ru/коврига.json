                                                "example_id": "47655c34-205b-4829-8b45-827e30aaa035",
                                                "sense_id": "42284f92-53ce-3fa0-b428-f2630f2fe880",
                                                "text": "Mujer 3: No te faltará la hogaza de pan caliente. ¶ Mujer 2: Ni el techo para tus hijas."
                                            }
                                        ],
