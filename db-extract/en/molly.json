                "senses": [
                    {
                        "sense_id": "8196330b-1184-3892-8541-1490799a65c3",
                        "entry_id": "b037aea4-ab82-3e0f-9de6-17f0d97801b3",
                        "glosses": [
                            "To engage in (male) homosexual activity with."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75f11ec8-2446-40f3-af74-46b65197d696",
                                "sense_id": "8196330b-1184-3892-8541-1490799a65c3",
                                "text": "I said, \"I never mollied you.\" My Lord, I never laid Hands upon him, nor touch'd him."
                            },
                            {
                                "example_id": "57b163c9-dfd1-4ff8-87d9-ba289235e6bc",
                                "sense_id": "8196330b-1184-3892-8541-1490799a65c3",
                                "text": "On one occasion, Partridge was nearly mobbed in a molly-house when some men called him a 'treacherous, blowing-up, mollying bitch, and swore they'd massacre anybody that should betray them.'"
                            },
                            {
                                "example_id": "4cdcc23e-53fc-4629-b128-ee93b24e3530",
                                "sense_id": "8196330b-1184-3892-8541-1490799a65c3",
                                "text": "It is a case of the biter bit, or the molly-taker mollied, but it is also an interesting example of the ways in which the criminal underworld and sexual underworld met in eighteenth-century London"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
