                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "амбразура",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b9d8cfc4-0c09-335c-a975-28d45dd3bf3b",
                                        "entry_id": "443c948e-c635-3c3e-834b-c762e5d89cbf",
                                        "glosses": [
                                            "воен. отверстие в бруствере или стене укрепления для ведения стрельбы с укреплённой позиции"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fecb96e7-1e3c-4431-97a3-b99187ac62c6",
                                                "sense_id": "b9d8cfc4-0c09-335c-a975-28d45dd3bf3b",
                                                "text": "Голой грудью на амбразуру."
                                            }
                                        ]
                                    }
                                ]
