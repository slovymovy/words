                        "examples": [
                            {
                                "example_id": "a9ac6c9c-d9c3-492d-a5cf-1469998e3f3b",
                                "sense_id": "1110fbf9-21bb-3ba0-a609-b81c66f472e8",
                                "text": "Bedauerlicherweise konnten wir am Tatort keine verwertbaren Spuren feststellen."
                            },
                            {
                                "example_id": "4b01d3e7-1af4-4f63-bb29-20c96f9cfdef",
                                "sense_id": "1110fbf9-21bb-3ba0-a609-b81c66f472e8",
                                "text": "„Einst als Heiligabendessen schlechthin betrachtet (zur aktuellen Jahreszeit ja auch gerne Weihnachtskarpfen genannt), wurde der sanftmütige heimische Zuchtfisch inzwischen von den Festtagstischen bedauerlicherweise weitgehend verdrängt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
