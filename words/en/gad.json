{
    "word_family": [
        "gadabout",
        "gadding"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "71c1e68d-c606-3a95-8b29-81f894ab1914",
                    "sense_definition": "To move from one location to another in an apparently random and frivolous manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spends her weekends <w>gadding</w> about the city instead of studying for her exams.",
                            "target_lang_translations": {
                                "nl": "Ze brengt haar weekenden door met <w>rondzwerven</w> door de stad in plaats van te studeren voor haar examens."
                            }
                        },
                        {
                            "text": "Stop <w>gadding</w> around and focus on finishing your important work before the deadline.",
                            "target_lang_translations": {
                                "nl": "Stop met <w>rondzwerven</w> en concentreer je op het afmaken van je belangrijke werk voor de deadline."
                            }
                        }
                    ],
                    "synonyms": [
                        "gallivant"
                    ],
                    "common_phrases": [
                        "gadding about"
                    ],
                    "target_lang_definitions": {
                        "nl": "Zonder duidelijk doel rondtrekken of op pad zijn."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "rondzwerven",
                                "target_lang_sense_clarification": "doelloos rondtrekken"
                            },
                            {
                                "target_lang_word": "flaneren",
                                "target_lang_sense_clarification": "op een ontspannen, soms ijdele manier rondlopen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6daf58d5-9992-3aec-a62d-725a45a58466",
                    "sense_definition": "To run with the tail in the air, usually in an attempt to escape insects.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cattle began to <w>gad</w> across the field to escape the swarm of flies.",
                            "target_lang_translations": {
                                "nl": "Het vee begon over het veld te <w>rennen</w> om aan de zwerm vliegen te ontsnappen."
                            }
                        },
                        {
                            "text": "Farmers notice that cows <w>gad</w> when they are bothered by warble flies in the summer.",
                            "target_lang_translations": {
                                "nl": "Boeren merken dat koeien <w>op hol slaan</w> wanneer ze in de zomer last hebben van horzels."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Met de staart omhoog rennen, meestal om aan insecten te ontsnappen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "op hol slaan",
                                "target_lang_sense_clarification": "in paniek wegrennen (van vee)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4db61c7c-ab4b-3562-80f6-a0df9c951bea",
                    "sense_definition": "A spike on a gauntlet.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The medieval knight wore gauntlets decorated with sharp <w>gads</w> on the knuckles.",
                            "target_lang_translations": {
                                "nl": "De middeleeuwse ridder droeg handschoenen versierd met scherpe <w>punten</w> op de knokkels."
                            }
                        },
                        {
                            "text": "Historians examined the <w>gad</w> on the ancient glove to understand its defensive purpose.",
                            "target_lang_translations": {
                                "nl": "Historici onderzochten de <w>stekel</w> op de oude handschoen om het defensieve doel ervan te begrijpen."
                            }
                        }
                    ],
                    "synonyms": [
                        "gadling",
                        "spike"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een metalen punt of uitsteeksel op een handschoen of pantser."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "punt",
                                "target_lang_sense_clarification": "scherp uitsteeksel"
                            },
                            {
                                "target_lang_word": "stekel",
                                "target_lang_sense_clarification": "scherp, uitstekend deel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d92b850-2ffc-3215-b1b8-82232be3c462",
                    "sense_definition": "A pointed metal tool for breaking or chiselling rock.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The miner used a steel <w>gad</w> to break through the hard rock in the tunnel.",
                            "target_lang_translations": {
                                "nl": "De mijnwerker gebruikte een stalen <w>beitel</w> om door het harde gesteente in de tunnel te breken."
                            }
                        },
                        {
                            "text": "He carried a heavy <w>gad</w> to help him chip away at the stone wall.",
                            "target_lang_translations": {
                                "nl": "Hij droeg een zware <w>beitel</w> bij zich om hem te helpen stukken van de stenen muur af te hakken."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een puntig metalen gereedschap voor het bewerken van steen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "beitel",
                                "target_lang_sense_clarification": "gereedschap voor steenbewerking"
                            },
                            {
                                "target_lang_word": "houweel",
                                "target_lang_sense_clarification": "gereedschap om in steen of grond te hakken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "118cc1b1-54ee-34f7-a219-89b44ef220ae",
                    "sense_definition": "A sharp-pointed rod for driving cattle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer used a long <w>gad</w> to guide the oxen toward the barn.",
                            "target_lang_translations": {
                                "nl": "De boer gebruikte een lange <w>drijfstok</w> om de ossen naar de stal te leiden."
                            }
                        },
                        {
                            "text": "He held the <w>gad</w> firmly to ensure the animals stayed on the path.",
                            "target_lang_translations": {
                                "nl": "Hij hield de <w>drijfstok</w> stevig vast om ervoor te zorgen dat de dieren op het pad bleven."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to historical agricultural tools."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een scherpe stok of staaf om vee aan te drijven."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "drijfstok",
                                "target_lang_sense_clarification": "stok om vee te sturen"
                            },
                            {
                                "target_lang_word": "prikstok",
                                "target_lang_sense_clarification": "stok met een scherpe punt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea3737f3-2c7e-3e9a-9db5-6c837b71095b",
                    "sense_definition": "One who roams about idly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was known as a local <w>gad</w> who spent his days wandering the village streets.",
                            "target_lang_translations": {
                                "nl": "Hij stond bekend als een lokale <w>zwerver</w> die zijn dagen doorbracht met dwalen door de straten van het dorp."
                            }
                        },
                        {
                            "text": "The old man was a restless <w>gad</w> who never stayed in one place for long.",
                            "target_lang_translations": {
                                "nl": "De oude man was een rusteloze <w>landloper</w> die nooit lang op één plek bleef."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand die doelloos rondzwerft."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "zwerver",
                                "target_lang_sense_clarification": "iemand die rondtrekt"
                            },
                            {
                                "target_lang_word": "landloper",
                                "target_lang_sense_clarification": "iemand die zonder doel rondtrekt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24f0b017-f1da-362b-a516-e6214cfc33a3",
                    "sense_definition": "Acronym of generalized anxiety disorder.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor explained that <w>GAD</w> is a common condition characterized by persistent worry.",
                            "target_lang_translations": {
                                "nl": "De arts legde uit dat <w>gegeneraliseerde angststoornis</w> een veelvoorkomende aandoening is die wordt gekenmerkt door aanhoudende zorgen."
                            }
                        },
                        {
                            "text": "Patients diagnosed with <w>GAD</w> often benefit from cognitive behavioral therapy.",
                            "target_lang_translations": {
                                "nl": "Patiënten bij wie <w>gegeneraliseerde angststoornis</w> is vastgesteld, hebben vaak baat bij cognitieve gedragstherapie."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Afkorting voor gegeneraliseerde angststoornis."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gegeneraliseerde angststoornis",
                                "target_lang_sense_clarification": "medische term voor GAD"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "533ceeda-cf4b-381a-842b-2ddf81dda21d",
                    "sense_definition": "A male given name from Hebrew.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "<w>Gad</w> is a traditional name often found in historical and religious texts.",
                            "target_lang_translations": {
                                "nl": "<w>Gad</w> is een traditionele naam die vaak voorkomt in historische en religieuze teksten."
                            }
                        },
                        {
                            "text": "Many people named <w>Gad</w> have contributed significantly to academic and cultural fields.",
                            "target_lang_translations": {
                                "nl": "Veel mensen genaamd <w>Gad</w> hebben aanzienlijk bijgedragen aan academische en culturele vakgebieden."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een mannelijke voornaam van Hebreeuwse oorsprong."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "Gad",
                                "target_lang_sense_clarification": "voornaam"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "fc53532e-99b2-314f-8974-4f1330836512",
                    "sense_definition": "An exclamation roughly equivalent to by God or goodness gracious.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "By <w>gad</w>, that is the most surprising news I have heard all year!",
                            "target_lang_translations": {
                                "nl": "Mijn <w>hemel</w>, dat is het meest verrassende nieuws dat ik dit hele jaar heb gehoord!"
                            }
                        },
                        {
                            "text": "Oh <w>gad</w>, I completely forgot to lock the front door before leaving.",
                            "target_lang_translations": {
                                "nl": "Oh <w>godsamme</w>, ik was helemaal vergeten de voordeur op slot te doen voordat ik vertrok."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used as a mild oath."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een verouderde uitroep, vergelijkbaar met 'mijn hemel' of 'godsamme'."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "mijn hemel",
                                "target_lang_sense_clarification": "uitroep van verbazing"
                            },
                            {
                                "target_lang_word": "godsamme",
                                "target_lang_sense_clarification": "milde krachtterm"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}