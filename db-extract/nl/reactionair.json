        "nl-extract.jsonl": [
            {
                "entry_id": "d32eb298-700b-353e-82c9-d051a1b8ff73",
                "word": "reactionair",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bda4cccc-496e-34a8-875e-171fd12d8f0b",
                        "entry_id": "d32eb298-700b-353e-82c9-d051a1b8ff73",
                        "glosses": [
                            "uiterst conservatief"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c91066c1-d4fd-451e-a92b-e3bc6a944381",
                        "source_entry_id": "d32eb298-700b-353e-82c9-d051a1b8ff73",
                        "source_sense_id": "bda4cccc-496e-34a8-875e-171fd12d8f0b",
                        "target_lang_word": "reactionary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reactionary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52c48873-b5d5-3a08-a151-c621b3ae5ad8",
                                        "entry_id": "d52b538f-5519-3187-9928-45c519ee6e3f",
                                        "glosses": [
                                            "Extremely conservative; opposing revolution (such as the French Revolution); favoring a return to a golden age of the past."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c7b7681-431e-476d-9286-d8216846170a",
                                                "sense_id": "52c48873-b5d5-3a08-a151-c621b3ae5ad8",
                                                "text": "There's a fairly simple reason for the embrace of radicalism on the right, and it has to do with the reactionary imperative that lies at the core of conservative doctrine. […] If he is to preserve what he values, the conservative must declare war against the culture as it is."
                                            },
                                            {
                                                "example_id": "52ac9d8e-6662-47d9-bda9-492e469e6ba4",
                                                "sense_id": "52c48873-b5d5-3a08-a151-c621b3ae5ad8",
                                                "text": "[Jeffrey] Epstein was interested in transhumanism, a theory of human perfection via technological manipulation that—like its predecessor, eugenics—is shot through with racist and reactionary ideas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14240758-ac51-30b8-bf3a-66a5551a4c1f",
                                        "entry_id": "d52b538f-5519-3187-9928-45c519ee6e3f",
                                        "glosses": [
                                            "Of, pertaining to, participating in, or inducing a chemical reaction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ea7c006-0300-47e2-95f3-42ba31bdf17c",
                                                "sense_id": "14240758-ac51-30b8-bf3a-66a5551a4c1f",
                                                "text": "Psychiatry extends the theory into biology in the belief that all human behavior is nothing more than a series of reactionary chemical processes in the brain that determine pre-coded genetic responses built up from the conditioning of one’s environment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc0148a8-e1fa-33bd-b290-4d980c2d389a",
                                        "entry_id": "d52b538f-5519-3187-9928-45c519ee6e3f",
                                        "glosses": [
                                            "In reaction to; as a result of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08465880-e9f8-49e0-a275-9b543a139efd",
                                                "sense_id": "fc0148a8-e1fa-33bd-b290-4d980c2d389a",
                                                "text": "The regulator noted that reduced service levels and passenger numbers helped deliver strong performance, with fewer reactionary delays."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "reactionary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c64d8708-06e0-367b-80c2-4f3daf21ebc2",
                                        "entry_id": "6717d62e-dc4a-34b9-a994-f4fd45ea2196",
                                        "glosses": [
                                            "One who opposes revolution, wanting to reverse it, favoring a return to a past golden age. Often used as a derogatory by revolutionaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a54872ea-2b98-44df-8978-eb296e5d8c71",
                                                "sense_id": "c64d8708-06e0-367b-80c2-4f3daf21ebc2",
                                                "text": "Hindu reactionaries, whose conception of a well-ordered society had not moved beyond the laws of Manu, fell into line for the moment with the intellectual products of the modern Indian University."
                                            },
                                            {
                                                "example_id": "72b8800a-2375-4804-8171-0973a7a7069d",
                                                "sense_id": "c64d8708-06e0-367b-80c2-4f3daf21ebc2",
                                                "text": "It is not simply a conservative preference for things as they are, with a few nudges back, but a passionate loathing of the status quo and a desire to return to the past in one emotionally cathartic revolt. If conservatives are pessimistic, reactionaries are apocalyptic."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e77865f4-01cc-4a7a-9241-8b705e0b7957",
                        "source_entry_id": "d32eb298-700b-353e-82c9-d051a1b8ff73",
                        "source_sense_id": "bda4cccc-496e-34a8-875e-171fd12d8f0b",
                        "target_lang_word": "réactionnaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réactionnaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "92444266-3bfb-3b52-9d26-c883a99365b6",
                                        "entry_id": "546f6e14-9862-3c7a-89ff-9572a77f47b8",
                                        "glosses": [
                                            "Qui sert à opérer une réaction ; qui travaille à une réaction politique : à un mouvement d’opinion qui agit dans un sens contraire au mouvement qui a précédé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8eaff29-2ddc-4401-9b9e-3455a9f71649",
                                                "sense_id": "92444266-3bfb-3b52-9d26-c883a99365b6",
                                                "text": "[…] : Charles X. Politiquement, le personnage est assez fascinant. Il représente le type le plus achevé du réactionnaire, c’est à dire celui qui, littéralement, pense qu’on peut faire avancer l’histoire en revenant en arrière […]."
                                            },
                                            {
                                                "example_id": "39d97ee6-c855-4e4b-8ba8-5cc006c68a7d",
                                                "sense_id": "92444266-3bfb-3b52-9d26-c883a99365b6",
                                                "text": "[…] : les amis de Jaurès, les cléricaux et les démocrates placent leur idéal de l’avenir dans le Moyen Âge : ils voudraient que la concurrence fût tempérée, que la richesse fût limitée, que la pro­duction fût subordonnée aux besoins. Ce sont des rêveries que Marx regardait comme réactionnaires […]."
                                            },
                                            {
                                                "example_id": "3f126624-783e-49cb-9f5a-915d971591b9",
                                                "sense_id": "92444266-3bfb-3b52-9d26-c883a99365b6",
                                                "text": "Ils se contentaient donc de ménager la chèvre républicaine et le chou réactionnaire avec une délicatesse, un doigté qu’eût pu leur envier tel politicien de plus grande envergure ; député, sénateur, voire sous-secrétaire d’État ou ministre."
                                            },
                                            {
                                                "example_id": "b0cee944-f748-46ad-af79-d965f7e80ea2",
                                                "sense_id": "92444266-3bfb-3b52-9d26-c883a99365b6",
                                                "text": "D'ailleurs, qui est sur l'autre liste ? Toute la fleur : le quincailler, le tailleur, le cordonnier… bref, un échantillon de tous les réactionnaires."
                                            },
                                            {
                                                "example_id": "8166f333-87a8-4ee9-90ba-768ca09421ba",
                                                "sense_id": "92444266-3bfb-3b52-9d26-c883a99365b6",
                                                "text": "La ploutocratie chilienne s’était appuyée sur deux forces : les milieux réactionnaires de la Marine et les intérêts impérialistes britanniques."
                                            },
                                            {
                                                "example_id": "681352ec-2f7f-4815-9ffc-afc78b401e3b",
                                                "sense_id": "92444266-3bfb-3b52-9d26-c883a99365b6",
                                                "text": "La gauche « qui ne sait plus ce qu’elle veut » ne se contente plus de se taire, mais prend l’habitude de faire sien le grand discours de régression d’une droite dont elle envie la bonne santé, d’une droite à l’entrain réactionnaire communicatif."
                                            },
                                            {
                                                "example_id": "b6854dc5-27ba-441a-bcac-e9ef3c17e0d1",
                                                "sense_id": "92444266-3bfb-3b52-9d26-c883a99365b6",
                                                "text": "En fait de rupture, le gouvernement nous fait entrer dans une période réactionnaire, au sens étymologique du terme, telle qu’en a connu périodiquement la France."
                                            },
                                            {
                                                "example_id": "4dc825c9-06a8-4b2d-863e-55799be8ebb0",
                                                "sense_id": "92444266-3bfb-3b52-9d26-c883a99365b6",
                                                "text": "Professeur à l’Institut universitaire européen de Florence, en Italie, où nous l’avons rencontré, Olivier Roy estime qu’« il y a plusieurs familles idéologiques qui se félicitent de la victoire de Donald Trump : une mouvance réactionnaire soutenue par une droite chrétienne, un populisme identitaire et une high-tech futuriste »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "réactionnaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "08efe9a7-1ef3-370f-b4e0-507dc92b0601",
                                        "entry_id": "72b05b1a-cc4a-30ed-98db-d20841425fb7",
                                        "glosses": [
                                            "Citoyen, élu, fonctionnaire, qui est réactionnaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbb9ca87-f0a1-4592-a679-ae7905b9d2cb",
                                                "sense_id": "08efe9a7-1ef3-370f-b4e0-507dc92b0601",
                                                "text": "Mordu bientôt par le désir de jouer un rôle, il détermina un libraire, un rival de Vuillet, à fonder un journal démocratique, dont il devint un des rédacteurs les plus âpres. L’Indépendant fit, sous son impulsion, une guerre sans merci aux réactionnaires."
                                            },
                                            {
                                                "example_id": "d88a108c-6954-4baa-bb73-75ff4efd13c7",
                                                "sense_id": "08efe9a7-1ef3-370f-b4e0-507dc92b0601",
                                                "text": "Les apostrophes injurieuses, les interpellations violentes des réactionnaires, interrompirent cent fois les discours des orateurs des gauches."
                                            },
                                            {
                                                "example_id": "3a30acf4-2b7b-421f-8e4e-e627aed167fa",
                                                "sense_id": "08efe9a7-1ef3-370f-b4e0-507dc92b0601",
                                                "text": "La Russie demeurait par force une puissance pacifique, divisée au-dedans, déchirée entre les révolutionnaires et les réactionnaires également incapables de reconstruction sociale, et elle s’enlisait dans un désordre tragique de vendetta politique à retours chroniques."
                                            },
                                            {
                                                "example_id": "ef17bec4-78fc-4923-b781-9eec032c2bdd",
                                                "sense_id": "08efe9a7-1ef3-370f-b4e0-507dc92b0601",
                                                "text": "Dans la Résistance intérieure, les éléments ex-vichyssois, les champions de l’électoralisme, les réactionnaires n'avaient qu'une minime influence. Dans l'appareil « gaulliste », au contraire, les hommes de la droite, et même d'anciens cagoulards, avaient des places éminentes."
                                            },
                                            {
                                                "example_id": "0644d882-68ab-45c1-80c8-3b3d04b093e6",
                                                "sense_id": "08efe9a7-1ef3-370f-b4e0-507dc92b0601",
                                                "text": "Ce Chilien s’appelait Diego Portales. Il est aujourd’hui considéré par les réactionnaires chiliens et par les généraux de la Junte comme leur grand précurseur."
                                            },
                                            {
                                                "example_id": "76781c1c-15dd-43af-bb39-acb52c4e061a",
                                                "sense_id": "08efe9a7-1ef3-370f-b4e0-507dc92b0601",
                                                "text": "C'est ainsi que pour Sheila Delany (1987), La Cité des Dames serait l'œuvre d’une misogyne, d’une réactionnaire pudibonde pro censura et d'une exploitante éhontée de la classe laborieuse. Nous voyons ainsi Christinophobes et Christinophiles renouveler l'ancienne querelle des femmes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8488584f-deb3-4afa-a7ba-756d2e119e3a",
                        "source_entry_id": "d32eb298-700b-353e-82c9-d051a1b8ff73",
                        "source_sense_id": "bda4cccc-496e-34a8-875e-171fd12d8f0b",
                        "target_lang_word": "reaccionario",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reaccionario",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "09ade78c-8465-3182-b428-f3f4e29c3188",
                                        "entry_id": "ba939cc6-91c0-33ab-8071-246e2095de02",
                                        "glosses": [
                                            "Que se opone a las ideologías progresistas."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cfd6cb0-6482-4507-bb1b-222609d23204",
                                                "sense_id": "09ade78c-8465-3182-b428-f3f4e29c3188",
                                                "text": "Bergoglio es ambiguo, decían: recibe a la “gran plutocracia internacional” que guía a la ofensiva abortista. Dirigían al papa las mismas acusaciones que el pontífice solía dirigir a los enemigos “ilustrados”. ¿Cuántas veces los curas villeros habían culpado por las campañas abortistas a los “potentes de la tierra”? ¿Cuántos obispos lo habían repetido? Católicos reaccionarios y católicos progresistas se disputaban la corona de “verdaderos peronistas” agarrándose a golpes del mito nacional-católico."
                                            }
