                        ],
                        "form": "die Miliz"
                    },
                    {
                        "form_id": "a7c1a50b-692a-40e7-a7e3-7f93f5c02cee",
                        "entry_id": "3420af43-204b-32eb-bb35-495868ac4747",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Milizen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3e35d897-ea94-3163-b38f-caac957d999f",
                        "entry_id": "3420af43-204b-32eb-bb35-495868ac4747",
                        "glosses": [
                            "nicht ständige Streitkräfte als Ergänzung der Kampftruppe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb0c13aa-b9a8-4dd6-839a-a6d946b8f809",
                                "sense_id": "3e35d897-ea94-3163-b38f-caac957d999f",
                                "text": "Während die Unruhen begannen, begann auch die Ausbildung der Miliz."
                            },
                            {
                                "example_id": "c3e54ce8-49d2-498d-94da-159cbac6edfd",
                                "sense_id": "3e35d897-ea94-3163-b38f-caac957d999f",
                                "text": "„Mit seinen Milizen zog er in das verlassene Caracas ein, das Bolívar eilig evakuiert hatte.“"
                            },
                            {
                                "example_id": "0fdfc93e-9a7d-415c-a434-97b56d06409d",
                                "sense_id": "3e35d897-ea94-3163-b38f-caac957d999f",
                                "text": "„Die Milizen hatten schweigend die Herankommenden beobachtet.“"
                            },
                            {
                                "example_id": "3d565f05-6968-469f-8661-543c4a2d8d08",
                                "sense_id": "3e35d897-ea94-3163-b38f-caac957d999f",
                                "text": "„An der Spitze der männlichen Milizen standen oft Offiziersanwärter, Offiziere und buddhistische Mönche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4fd32b27-cfb0-3e13-8d7c-9a9259bbfbce",
                        "entry_id": "3420af43-204b-32eb-bb35-495868ac4747",
                        "glosses": [
                            "polizeiähnliche Kräfte"
                        ],
                        "tags": [
                            "Polizei"
                        ],
                        "examples": [
                            {
                                "example_id": "d1ab20d1-c3e3-4873-8c91-34e9ff1a4044",
                                "sense_id": "4fd32b27-cfb0-3e13-8d7c-9a9259bbfbce",
                                "text": "Wir wurden von der Miliz angehalten und der Wagen wurde genauestens kontrolliert."
                            },
                            {
                                "example_id": "ae0fcb5a-d575-4efb-af3b-d2a296f910bb",
                                "sense_id": "4fd32b27-cfb0-3e13-8d7c-9a9259bbfbce",
                                "text": "„Eines Abends erscheint vor dem Hof der Steinborns polnische Miliz und verhaftet den Bauern.“"
                            },
                            {
                                "example_id": "bb9f1b67-2684-4fb8-88d6-d1d8820f75ae",
                                "sense_id": "4fd32b27-cfb0-3e13-8d7c-9a9259bbfbce",
                                "text": "„Wenn man sich bei der zuständigen Miliz meldet und für den Abtransport registrieren läßt, dann wird alles seinen ordentlichen, geregelten Gang gehen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
