                "senses": [
                    {
                        "sense_id": "159d56a0-3d48-32db-8981-b0be8586856d",
                        "entry_id": "51d7f16f-a307-3953-b0a8-3d76a999f16b",
                        "glosses": [
                            "Milch vom Kamel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de941353-cc20-40d1-90d9-aa44c16fc24a",
                                "sense_id": "159d56a0-3d48-32db-8981-b0be8586856d",
                                "text": "„Weder Kamelfleisch noch Kamelmilch können in der Lebensmittelversorgung der alten Israeliten jemals eine wesentliche Rolle gespielt haben.“"
                            },
                            {
                                "example_id": "66de7276-aa1a-472b-95e9-7308bcf56c73",
                                "sense_id": "159d56a0-3d48-32db-8981-b0be8586856d",
                                "text": "„Auf dem Basar gibt es Gefrorenes, die Portion zu einem Rubel ist ihr Geld wert, schmeckt ausgezeichnet. Das Eis wird aus Kamelmilch gemacht, vielleicht wird sich das vom Auto verdrängte Kamel ganz dieser Produktion widmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
