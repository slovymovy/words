                "senses": [
                    {
                        "sense_id": "c4ac668a-9bc3-335d-a8e0-1616df2f379e",
                        "entry_id": "c83a4b1c-2a53-321f-9e09-d56f254a6375",
                        "glosses": [
                            "Einstellung/Haltung, ernsthaft zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d08b37cb-9f19-4550-907a-476bca94dd58",
                                "sense_id": "c4ac668a-9bc3-335d-a8e0-1616df2f379e",
                                "text": "„Fabiola schaute Tom nun mit einer tiefen Ernsthaftigkeit an, so, als hätte sie für sich in diesem Moment eine sehr wichtige Entscheidung getroffen.“"
                            },
                            {
                                "example_id": "227802db-a6da-4bc8-a00d-b058966a9c7f",
                                "sense_id": "c4ac668a-9bc3-335d-a8e0-1616df2f379e",
                                "text": "„Manchmal sagte sie Sachen, die sehr dramatisch klangen, aber sie meinte es ernst, und ihre Ernsthaftigkeit sorgte dafür, dass ich ihr zuhörte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
