                                            {
                                                "example_id": "4493804d-8e31-4714-9160-e779a43b1bf5",
                                                "sense_id": "63994ed4-e321-3879-8e22-d7cf5c608db9",
                                                "text": "Police have been unable to ID the body found in the river."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07cc6e15-fb8f-3602-bed6-ba5722379abc",
                                        "entry_id": "15657384-be13-3e9d-9fd1-ab4e332707f9",
                                        "glosses": [
                                            "To request to see a person’s identification for proof of identity or age."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44f61810-5578-496d-a24a-70b36cbf2999",
                                                "sense_id": "07cc6e15-fb8f-3602-bed6-ba5722379abc",
                                                "text": "The bartender will have to ID you before serving you a drink."
                                            },
                                            {
                                                "example_id": "e147316f-9b34-48be-8317-cd4cdb8271bf",
                                                "sense_id": "07cc6e15-fb8f-3602-bed6-ba5722379abc",
                                                "text": "Anyway, Margiotti found the guard and showed him the picture. He ID'ed it. Sort of. It was dark."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e8ff75e-15c3-36b3-8ead-25122d88d3eb",
                                        "entry_id": "15657384-be13-3e9d-9fd1-ab4e332707f9",
                                        "glosses": [
                                            "To identify (as something)"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8de24588-ad0e-4f5e-9572-502c65333fa8",
                                                "sense_id": "0e8ff75e-15c3-36b3-8ead-25122d88d3eb",
                                                "text": "I have one black grandfather, but I don't ID as mixed race"
                                            }
                                        ]
