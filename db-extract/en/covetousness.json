                    {
                        "translation_id": "4517ddd7-9a73-4891-b8d4-4326943e2ee4",
                        "source_entry_id": "ff4c7187-3bb1-3bf6-8373-7822b1020ec2",
                        "source_sense_id": "3ad39934-2e34-37b7-9c62-6ac9dc1a3cf0",
                        "source_sense_description": "desire for the possession of something",
                        "target_lang_word": "Habsucht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Habsucht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6f862ce5-6533-3f1a-bf7b-df846f235c0e",
                                        "entry_id": "f39748c6-d7f6-3294-84ea-09d7858260d9",
                                        "glosses": [
                                            "zwanghafter Drang, immer mehr (Besitz) haben zu wollen, ohne Rücksicht auf andere und unabhängig vom Nutzen"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9c9f7df-d7aa-4e69-9043-c2849752d3fe",
                                                "sense_id": "6f862ce5-6533-3f1a-bf7b-df846f235c0e",
                                                "text": "Sein ganzes Verhalten offenbarte eine ungehemmte Habsucht."
                                            },
                                            {
                                                "example_id": "3582e3d1-8db5-41a7-9035-014078c6c327",
                                                "sense_id": "6f862ce5-6533-3f1a-bf7b-df846f235c0e",
                                                "text": "„Denn die Wurzel aller Übel ist die Habsucht.“"
                                            },
                                            {
                                                "example_id": "ff9c1664-dcc9-4311-83d3-66ff02ea5423",
                                                "sense_id": "6f862ce5-6533-3f1a-bf7b-df846f235c0e",
                                                "text": "„Mich zwang eine gewisse Habsucht zum Spiel.“"
                                            },
                                            {
                                                "example_id": "6c1725dd-1a4e-4fd8-9d48-5522a91b4ae9",
                                                "sense_id": "6f862ce5-6533-3f1a-bf7b-df846f235c0e",
                                                "text": "„Beinahe scheint es, als ob die Vorsehung ihn zugleich auch dazu bestimmt hätte, den Samen der Freiheit gleich Zugvögeln über die ganze Erde zu verbreiten und so die Habsucht zu veredeln, die seinem waghalsigen Spiele zum Grunde liegt.“"
                                            },
                                            {
                                                "example_id": "fab732b4-9ee6-4940-a32e-08c1f9b2c72e",
                                                "sense_id": "6f862ce5-6533-3f1a-bf7b-df846f235c0e",
                                                "text": "(Plural: alle möglichen/zeittypischen Ausprägungen der Habsucht:) „[…] Blätter, mit denen William Hogarth, die Brüder Cruikshank […] die Sitte der Geldheirat, die Trunk-, Herrsch- und Habsüchte geißelten und damit im 18. Jahrhundert erstmals die Karikatur zum öffentlichen Gesprächsthema machten.“"
                                            },
                                            {
                                                "example_id": "0091c06e-3a89-4843-a106-615cd3c7cb9b",
                                                "sense_id": "6f862ce5-6533-3f1a-bf7b-df846f235c0e",
                                                "text": "(Plural: Betonung unterschiedlicher Interessen bei jeweiliger Habsucht: )„Kein Bundestag konnte ihn da mit dem Schild der Gerechtigkeit stören; die Habsüchte von Preußen und Österreich waren allein, und als sie einander die feindliche Bruderhand gaben, hatte die Hofburg dem deutschen Bund die preußische Kränkung mit eigener Kränkung vergolten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d630cb09-b324-48e3-81a5-a9e401c5950b",
                        "source_entry_id": "ff4c7187-3bb1-3bf6-8373-7822b1020ec2",
                        "source_sense_id": "3ad39934-2e34-37b7-9c62-6ac9dc1a3cf0",
                        "source_sense_description": "desire for the possession of something",
                        "target_lang_word": "Gier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e812de3d-9b9d-3a45-af8c-2781db2a06a0",
                                        "entry_id": "2e2f7552-5aba-36dd-b72d-30997884f4b5",
                                        "glosses": [
                                            "unmäßiges, maßloses Verlangen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18ae766e-43bb-4ef0-873b-87057d754037",
                                                "sense_id": "e812de3d-9b9d-3a45-af8c-2781db2a06a0",
                                                "text": "Von blinder Gier gepackt raubte er den Stein und floh."
                                            },
                                            {
                                                "example_id": "307ae291-90af-401e-902e-8d30ab23d39b",
                                                "sense_id": "e812de3d-9b9d-3a45-af8c-2781db2a06a0",
                                                "text": "„Der General kommt herein, steht am Büfettisch und pickt nicht ohne Gier den geräucherten Truthahn und die Garnelen heraus, um die sie nach Boston geschickt hatte.“"
                                            },
                                            {
                                                "example_id": "926d4849-ba46-4a91-85dc-b8e5c81993c8",
                                                "sense_id": "e812de3d-9b9d-3a45-af8c-2781db2a06a0",
                                                "text": "„Wie ein unsichtbarer Virus verseucht uns die Gier.“"
                                            },
                                            {
                                                "example_id": "cc512d21-3d80-40f1-8dd7-2934783b10d3",
                                                "sense_id": "e812de3d-9b9d-3a45-af8c-2781db2a06a0",
                                                "text": "„Die Geschichte von Batumi zeugt einmal mehr von der Gier der Großmächte nach Öl.“"
                                            },
                                            {
                                                "example_id": "9944c652-7d78-4979-bfaa-94778ed398e1",
                                                "sense_id": "e812de3d-9b9d-3a45-af8c-2781db2a06a0",
                                                "text": "„Im Handlungsverlauf zeigen fast alle Personen des Stücks materielle und sexuelle Gier.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Gier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d9c5bbe2-bfec-30fb-902c-3802114128dc",
                                        "entry_id": "dc688548-e7d1-33fa-8abc-1a8ced92c5ad",
                                        "glosses": [
                                            "Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3a1e044-1ce3-4a49-b390-750c48b64e3e",
                                                "sense_id": "d9c5bbe2-bfec-30fb-902c-3802114128dc",
                                                "text": "Frau Gier ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "d81c24f5-16d9-4114-89ca-3e13a3988d78",
                                                "sense_id": "d9c5bbe2-bfec-30fb-902c-3802114128dc",
                                                "text": "Herr Gier wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "a2717911-3b3d-4a19-b55b-aaa3e9cea5a5",
                                                "sense_id": "d9c5bbe2-bfec-30fb-902c-3802114128dc",
                                                "text": "Die Giers fahren heute nach Lübeck."
                                            },
                                            {
                                                "example_id": "cdf70c61-68bc-48a4-affc-0b630eab9d59",
                                                "sense_id": "d9c5bbe2-bfec-30fb-902c-3802114128dc",
                                                "text": "Der Gier trägt nie die Schals, die die Gier ihm strickt."
                                            },
                                            {
                                                "example_id": "fbb1ec25-b1ec-4dcb-8c3d-a86bfcf6dcb7",
                                                "sense_id": "d9c5bbe2-bfec-30fb-902c-3802114128dc",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gier kommt, geht der Herr Gier.“"
                                            },
                                            {
                                                "example_id": "5b39fa3a-7de5-44d3-ada9-ade025422017",
                                                "sense_id": "d9c5bbe2-bfec-30fb-902c-3802114128dc",
                                                "text": "Gier kommt und geht."
                                            },
                                            {
                                                "example_id": "cf551a60-80c5-4156-b1a3-33507bf2add0",
                                                "sense_id": "d9c5bbe2-bfec-30fb-902c-3802114128dc",
                                                "text": "Giers kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2352d8e-f6e8-4981-ada6-0586796cf822",
