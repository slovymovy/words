                        "glosses": [
                            "Having the characteristics of a clique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9495376d-24bc-4079-8678-fec334e93826",
                                "sense_id": "cfc5f671-6ca2-3d28-bb71-72c17806bc46",
                                "text": "Jack McFarland: Um, look, Leo, I know you're new here, and, um, we don't want you to think we're really cliquey and don't let anyone in our little group, but, um, well, we're really cliquey and we don't want anyone in our little group.\nKaren Walker: So, if you want to break into the fag four, this symbol of gay oppression has got to go."
                            },
                            {
                                "example_id": "d3ffbe4e-2cc6-483c-87e7-c1febae9118d",
                                "sense_id": "cfc5f671-6ca2-3d28-bb71-72c17806bc46",
                                "text": "Do not form clubs on the playground that don't include everyone - they're cliquey and mean."
                            },
                            {
                                "example_id": "4be87752-700e-4882-9779-4598a7a8462b",
                                "sense_id": "cfc5f671-6ca2-3d28-bb71-72c17806bc46",
                                "text": "Cliquey is cooler. If you don't like it blame Kitch."
                            }
                        ]
                    }
