                        "glosses": [
                            "Fahrt, die unter Ausschluss der Öffentlichkeit stattfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a910e773-8742-4947-b2c0-3d5b1e0b4563",
                                "sense_id": "46d7ae85-357b-332a-8cc5-b4cc05aac0e0",
                                "text": "„Nach Art. 48 Abs. 3 Satz 2 GG und § 16 AbgG hat ein Mitglied des Bundestages das Recht auf freie Benutzung aller Verkehrsmittel der Deutschen Bahn; dies gilt ohne Einschränkung für sämtliche Fahrten, also auch für Privatfahrten.“"
                            },
                            {
                                "example_id": "9e354324-eb2f-4787-9e6b-e2258e310366",
                                "sense_id": "46d7ae85-357b-332a-8cc5-b4cc05aac0e0",
                                "text": "„Das Reichsverkehrsministerium erlässt für das Deutsche Reich mit Wirkung vom 1. April des Jahres ein Verbot für Privatfahrten mit Personenkraftwagen.“"
                            }
                        ],
