                                            {
                                                "example_id": "f3691ba1-d67b-4a98-88f4-640d01d8fc2d",
                                                "sense_id": "f0dd61ea-83ba-3852-929a-0cba26b175b0",
                                                "text": "mangiare cibi troppo salati ed, in generale, una dieta troppo ricca di sodio o troppo povera di potassio, possono contribuire a determinare l’ipertensione arteriosa"
                                            }
                                        ]
