                ],
                "senses": [
                    {
                        "sense_id": "ae3ad082-4c11-3628-aeed-2fdb535b1ea4",
                        "entry_id": "a4fc7753-4794-3132-b1f0-ee85f5387760",
                        "glosses": [
                            "größeres mit grobem Salz (oder Zucker) bestreutes Gebäck, dessen Form dem Buchstaben B ähnelt"
                        ],
                        "tags": [
                            "Bavarian"
                        ],
                        "examples": [
                            {
                                "example_id": "529aafdd-0291-4942-a23f-8c1805eea346",
                                "sense_id": "ae3ad082-4c11-3628-aeed-2fdb535b1ea4",
                                "text": "„Nach sechs Jahren Prüfung wird die bayerische Brezen nun von der EU geschützt. Das nährt die Hoffnung, dass die Minderung der Lebensqualität durch labbrige oder knochenharte Imitate ein Ende haben könnte.“"
                            },
                            {
                                "example_id": "2a1c60fd-16cd-4527-9980-c4b924404f7f",
                                "sense_id": "ae3ad082-4c11-3628-aeed-2fdb535b1ea4",
                                "text": "„Ein Teil des Brezens brach ab und stürzte in einem Regen aus Bröseln und Salzkörnern auf den Tisch hinab und sprang von dort aus weiter auf den Boden hinunter.“"
                            },
                            {
                                "example_id": "8d19fcf6-31ed-4cb0-83f0-28fd5db4e860",
                                "sense_id": "ae3ad082-4c11-3628-aeed-2fdb535b1ea4",
                                "text": "„Dass sich das Bundesjustizministerium darum mühte, nicht nur Brezn und Brezen zu schützen, sondern auch die Brez’n, hat einen markenrechtlichen Hintergrund.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
