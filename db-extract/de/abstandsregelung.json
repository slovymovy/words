                "senses": [
                    {
                        "sense_id": "3d8b0492-d925-3d21-8800-0665d1901815",
                        "entry_id": "fd1c49f6-e492-38f2-9615-709696596959",
                        "glosses": [
                            "Regelung des Sicherheitsabstandes von Fahrzeugen im Verkehr"
                        ],
                        "tags": [
                            "Verkehrsrecht"
                        ],
                        "examples": [
                            {
                                "example_id": "3e6994e1-0981-4e7b-a4f5-69a2cdee5f40",
                                "sense_id": "3d8b0492-d925-3d21-8800-0665d1901815",
                                "text": "Die Abstandsregelungen im Verkehr erfolgen gemäß § 4 StVO."
                            },
                            {
                                "example_id": "79ed6349-04ba-4965-a349-206fa4b7d11c",
                                "sense_id": "3d8b0492-d925-3d21-8800-0665d1901815",
                                "text": "Abstandsregelung Der Lenker der Beförderungseinheit hat zum vorausfahrenden Fahrzeug einen Mindestabstand von 100 m einzuhalten."
                            },
                            {
                                "example_id": "7871ad82-7649-4a61-a832-b2b975eb779c",
                                "sense_id": "3d8b0492-d925-3d21-8800-0665d1901815",
                                "text": "Der zentrale Zweck der Abstandsregelung ist die Verhinderung von Auffahrunfällen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9707c2d6-abc0-34b9-ab2c-be47d1de5896",
                        "entry_id": "fd1c49f6-e492-38f2-9615-709696596959",
                        "glosses": [
                            "Fahrerassistenzsystem für die Einhaltung eines definierten Abstandes zum vorausfahrenden Fahrzeug"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5876dd71-9090-467c-9fc7-134774b2ada0",
                                "sense_id": "9707c2d6-abc0-34b9-ab2c-be47d1de5896",
                                "text": "Bei der Abstandsregelung bieten alle getesteten ACC einen gewissen Komfortgewinn, speziell bei Fahrten auf längeren Straßen- oder Autobahnpassagen."
                            },
                            {
                                "example_id": "9e0c3106-9d01-4c30-b99a-98bb7601b1f2",
                                "sense_id": "9707c2d6-abc0-34b9-ab2c-be47d1de5896",
                                "text": "In den 1990er Jahren wurden Radarsysteme auf FMCW-Basis für Kraftfahrzeuge als Kollisionswarner und automatische Abstandsregelung (Abstandsregeltempomat, englisch Adaptive Cruise Control, ACC) entwickelt."
                            },
                            {
                                "example_id": "6d6b3853-7938-4f95-a600-6dd19ffd5e49",
                                "sense_id": "9707c2d6-abc0-34b9-ab2c-be47d1de5896",
                                "text": "Bei Ausstattung mit ACC übernimmt das Fahrzeug die Längsführung adaptiver Geschwindigkeits-und Abstandsregelung."
                            },
                            {
                                "example_id": "a1bf6677-17ae-42c1-98ac-3540b192299e",
                                "sense_id": "9707c2d6-abc0-34b9-ab2c-be47d1de5896",
                                "text": "Zukünftig sollen auch Dienste wie Spurhalteassistenz und Abstandsregelung durch die Infrastruktur unterstützt werden können."
                            },
                            {
                                "example_id": "6ef6d078-16f9-4006-b416-dab4f9a35ae1",
                                "sense_id": "9707c2d6-abc0-34b9-ab2c-be47d1de5896",
                                "text": "Ein Tempomat oder eine Abstandsregelung sind hilfreiche Techniken, die sich auf Autobahnen und in der Innenstadt bewähren."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "ee6e939b-f5ac-3404-b76f-440c533c195d",
                        "entry_id": "fd1c49f6-e492-38f2-9615-709696596959",
                        "glosses": [
                            "Regelung der Mindestabstände von Windkraftanlagen zu Siedlungen und Infrastruktureinrichtungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7e39f4b-eae7-4c7c-92f0-c827a5013706",
                                "sense_id": "ee6e939b-f5ac-3404-b76f-440c533c195d",
                                "text": "Als CSU-Ministerpräsident Horst Seehofer im Januar 2014 eine Verschärfung der Abstandsregelungen auf 2000 Meter forderte, kritisierte Straub anfänglich diese deutlich, schwenkte dann aber auf Parteilinie und stützt seitdem die 10H-Regelung."
                            },
                            {
                                "example_id": "fa97f9e8-9057-4b74-9492-1a68b1d07545",
                                "sense_id": "ee6e939b-f5ac-3404-b76f-440c533c195d",
                                "text": "Im Widerspruch zu diesem Ziel wurden 2014 deutlich verschärfte restriktive Abstandsregelungen in Form der 10-H-Regelung eingeführt und ein Jahr später das Windenergieausbauziel auf 5 bis 6 Prozent des Strombedarfes reduziert."
                            },
                            {
                                "example_id": "812c9ae7-c733-4767-b7b5-70dc4f3aa9c7",
                                "sense_id": "ee6e939b-f5ac-3404-b76f-440c533c195d",
                                "text": "Die bundesrechtliche Grundentscheidung für eine Privilegierung von Windenergieanlagen im Außenbereich dürfe durch eine landesrechtliche Abstandsregelung weder rechtlich noch faktisch ausgehebelt werden."
                            },
                            {
                                "example_id": "28543346-25e8-4ae6-962c-39c8c79b4c34",
                                "sense_id": "ee6e939b-f5ac-3404-b76f-440c533c195d",
                                "text": "Zusätzlich zu den Abstandsregelungen betreffend Siedlungsgebiete sind Mindestabstände zu Infrastruktureinrichtungen (Wege, Straße, Autobahnen, Leitungen und Hochspannungsleitungen) zu berücksichtigen."
                            },
                            {
                                "example_id": "9a04356a-504c-4c6a-8da6-6357d1ad3643",
                                "sense_id": "ee6e939b-f5ac-3404-b76f-440c533c195d",
                                "text": "Die Abstandsregelungen wurden im Raumordnungsgesetz 1976 (11. Novelle) festgelegt, um einen Wildwuchs von Windkraftanlagen hinten anzuhalten. Bei der Festlegung dieser Abstandsregelungen standen raumplanerische Überlegungen im Vordergrund."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
