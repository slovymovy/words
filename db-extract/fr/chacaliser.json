                "senses": [
                    {
                        "sense_id": "6fa5857d-4d88-3ae0-ad50-6e5d2fe9d5c5",
                        "entry_id": "6699707f-44db-38fb-92b5-c460ea683384",
                        "glosses": [
                            "Porter son dévolu sur quelque chose ou quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49d2fe52-304a-4301-aa61-3f6a59c03bdd",
                                "sense_id": "6fa5857d-4d88-3ae0-ad50-6e5d2fe9d5c5",
                                "text": "Ils sont tous affreusement prévisibles et n’ont qu’une idée en tête, chacaliser les PNJ et les pays à l’abandon."
                            },
                            {
                                "example_id": "6c010e6d-8f92-45b3-b171-52aa99ce75d5",
                                "sense_id": "6fa5857d-4d88-3ae0-ad50-6e5d2fe9d5c5",
                                "text": "Mes collègues, eux, ils ont toujours une langue dans la bouche pour parler, pour tuer le temps, pour s’abêtir, se chientiser, se chacaliser et se lézarder sur les terrasses des cafés."
                            },
                            {
                                "example_id": "4f0a3627-ecbe-475b-9e2d-503670c99e54",
                                "sense_id": "6fa5857d-4d88-3ae0-ad50-6e5d2fe9d5c5",
                                "text": "Je suis remonté dans ma tête, \"chacalisant\" moi-même ou les autres je ne suis pas vraiment connecté à mes besoins, ou aux leurs."
                            }
                        ]
                    }
                ],
