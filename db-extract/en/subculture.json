    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "724ac046-07cb-3525-a4f9-20c6b23ad15c",
                "word": "subculture",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "903c1aa3-a052-4a69-a9ba-4dc9769efd50",
                        "entry_id": "724ac046-07cb-3525-a4f9-20c6b23ad15c",
                        "tags": [
                            "plural"
                        ],
                        "form": "subcultures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f893a939-8117-3946-ac02-a581dd0ba138",
                        "entry_id": "724ac046-07cb-3525-a4f9-20c6b23ad15c",
                        "glosses": [
                            "A portion of a culture distinguished by its customs or other features, often in contrast to the larger mainstream culture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ad34ec0-bba7-4763-b04f-efba7d26d115",
                                "sense_id": "f893a939-8117-3946-ac02-a581dd0ba138",
                                "text": "The goth subculture has its own mode of dress, and it has a characteristic musical style."
                            },
                            {
                                "example_id": "1b70d3ec-e8e8-437e-b5e3-2370fecfe9ef",
                                "sense_id": "f893a939-8117-3946-ac02-a581dd0ba138",
                                "text": "Like those activities, bodybuilding is an obsession, a living (for a few), and a way of life for the people involved in it—a subculture, in a word, with its own values, aesthetics and vocabulary."
                            },
                            {
                                "example_id": "761fb294-374b-4ecf-919d-d737deaf4603",
                                "sense_id": "f893a939-8117-3946-ac02-a581dd0ba138",
                                "text": "Joybubbles (the legal name of the former Joe Engressia since 1991), a blind genius with perfect pitch who accidentally found he could make free phone calls by whistling tones and went on to play a pivotal role in the 1970s subculture of “phone phreaks,” died on Aug. 8 in Minneapolis."
                            },
                            {
                                "example_id": "00b8568c-a8d7-4db8-979d-1ddafb9bde09",
                                "sense_id": "f893a939-8117-3946-ac02-a581dd0ba138",
                                "text": "White Americans are transitioning toward minority status for the first time. As they do, perhaps their ways will be treated less as the default mainstream, and more as subcultures among subcultures."
                            },
                            {
                                "example_id": "bafa9997-ed69-4c08-bbc6-5b92da6e1eab",
                                "sense_id": "f893a939-8117-3946-ac02-a581dd0ba138",
                                "text": "White evangelicals once saw themselves “as the owners of mainstream American culture and morality and values,” said Jones. Now they are just another subculture."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e06e24a-93be-3022-87b5-af3a9bd9bc8c",
                        "entry_id": "724ac046-07cb-3525-a4f9-20c6b23ad15c",
                        "glosses": [
                            "A culture made by transferring microorganisms from a previous culture to a fresh growth medium"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "993a8987-2dce-433b-878c-f1eb19a26c93",
                        "source_entry_id": "724ac046-07cb-3525-a4f9-20c6b23ad15c",
                        "source_sense_description": "portion of a culture distinguished by its customs or other features",
                        "target_lang_word": "subcultuur",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
