                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1dc0324-b802-4482-8faf-dc24ffbe4268",
                                "sense_id": "c927c97a-6161-38a1-8c9b-c844122bd97f",
                                "text": "Beheerovereenkomsten ten behoeve van de natuur kunnen ook buiten de Ecologische Hoofdstructuur worden afgesloten, bijvoorbeeld in landbouwgebieden waar veel zeldzaam geworden weidevogels als grutto, tureluur en kievit voorkomen."
                            },
                            {
                                "example_id": "c003fdc9-1a60-4797-bb30-1b62a64a9cbe",
                                "sense_id": "c927c97a-6161-38a1-8c9b-c844122bd97f",
                                "text": "Sinds jaar en dag draagt de Wildbeheereenheid (WBE) West-Twente zorg voor het onderhoud van de vele houtwallen, singels en bosjes die de gemeente Wierden rijk is. De door Staatsbosbeheer beëindigde beheerovereenkomst met Stichting Beheer Natuur en Landelijk gebied (SBNL) maakt de ruim vijftig betrokken vrijwilligers van de WBE overbodig."
                            }
                        ]
                    }
