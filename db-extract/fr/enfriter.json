                "senses": [
                    {
                        "sense_id": "44727231-6d52-3d70-a9fb-7a6e391349bc",
                        "entry_id": "63ef75d1-78ef-3634-b02e-aa4fdf8518ec",
                        "glosses": [
                            "Jeter des frites à la figure de quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3360f3c-f732-4d0a-a84f-d1f760f86293",
                                "sense_id": "44727231-6d52-3d70-a9fb-7a6e391349bc",
                                "text": "Est-ce normal qu'un Premier ministre sous le coup de menaces de mort puisse être approché aussi facilement, fut-ce pour se faire enfriter?"
                            },
                            {
                                "example_id": "3ae13b9d-54eb-4c89-81e0-4a48dd8ffbe7",
                                "sense_id": "44727231-6d52-3d70-a9fb-7a6e391349bc",
                                "text": "Même si bon, quand on se fait « enfriter » par une bande d'activistes sexistes et violentes, on pourrait comprendre un peu d’agacement."
                            },
                            {
                                "example_id": "2f994acd-3b73-4908-a532-68be8ff8f17a",
                                "sense_id": "44727231-6d52-3d70-a9fb-7a6e391349bc",
                                "text": "Les militantes qui ont enfrité Charles Michel se sont faites passer pour des étudiantes de l’UCL."
                            }
                        ]
                    }
