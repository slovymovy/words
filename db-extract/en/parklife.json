                "senses": [
                    {
                        "sense_id": "7026ff4b-cc08-3dac-b75e-a92e13873863",
                        "entry_id": "483d6bb6-4d7e-3e52-9537-a4502aa7754f",
                        "glosses": [
                            "The lifestyle and culture of parkgoers."
                        ],
                        "tags": [
                            "rare",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "818a3aa1-70d8-4f01-a774-0310276f3aef",
                                "sense_id": "7026ff4b-cc08-3dac-b75e-a92e13873863",
                                "text": "In Stockholm parklife, certain behaviours are framed as bad, unacceptable, or pathological by institutions such as the police and the social services."
                            },
                            {
                                "example_id": "5ceb64d6-e87a-4c3b-bdb0-fa7c9c182b33",
                                "sense_id": "7026ff4b-cc08-3dac-b75e-a92e13873863",
                                "text": "Up in the boughs, a literate London Tarzan. Down to earth, a woman on the wait. All part of parklife, give or take the ups and downs."
                            },
                            {
                                "example_id": "c3014e83-88d6-43bb-82de-ae7f7965033d",
                                "sense_id": "7026ff4b-cc08-3dac-b75e-a92e13873863",
                                "text": "I feed the pigeons, I sometimes feed the sparrows too. It gives me a sense of enormous wellbeing. (Parklife!)"
                            },
                            {
                                "example_id": "b370759c-f0f8-4737-b14a-31ba2bf5310c",
                                "sense_id": "7026ff4b-cc08-3dac-b75e-a92e13873863",
                                "text": "From the zoological garden, via the nature reserve and the theme-town, to the TV reality-show — sequences from the evolution of \"parklife\"."
                            }
                        ]
                    }
