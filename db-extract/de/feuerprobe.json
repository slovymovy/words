                ],
                "senses": [
                    {
                        "sense_id": "36609588-af3a-310f-8855-98f5a3650043",
                        "entry_id": "4cac96c0-099f-36e8-9c76-aa6d533572a9",
                        "glosses": [
                            "Épreuve du feu, ordalie par le feu, forme de justice moyenâgeuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7882c29f-cf3a-48e1-9afd-8f2f469fc04e",
                                "sense_id": "36609588-af3a-310f-8855-98f5a3650043",
                                "text": "Bei der Feuerprobe musste man über glühende Kohlen laufen oder ein glühendes Eisen tragen. Heilte die Wunde, ohne zu eitern, galt das als Unschuldsbeweis.",
                                "translation": "Dans l’épreuve du feu, on devait courir sur des charbons ardents ou tenir un fer chauffé à blanc. Si la plaie guérissait sans suppurer, c’était une preuve d’innocence."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb8ea2e9-1052-35ab-9b92-ec98e32f6421",
                        "entry_id": "4cac96c0-099f-36e8-9c76-aa6d533572a9",
                        "glosses": [
                            "Épreuve du feu, test."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e862c1d-9a2e-4da1-8d46-7bfaf4096c8d",
                                "sense_id": "eb8ea2e9-1052-35ab-9b92-ec98e32f6421",
                                "text": "Er hat die Feuerprobe bestanden",
                                "translation": "Il a passé l’épreuve du feu, il a fait ses preuves"
                            },
                            {
                                "example_id": "3e7634ef-176a-493f-91e8-7c5308af93fe",
                                "sense_id": "eb8ea2e9-1052-35ab-9b92-ec98e32f6421",
                                "text": "Für Yehudi Menuhin waren die 24 Capricen für Violine solo von Niccolò Paganini die Feuerprobe der Geiger.",
                                "translation": "Pour Y. Menuhin, les 24 caprices de Paganini pour violon solo étaient l’épreuve du feu des violonistes."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
