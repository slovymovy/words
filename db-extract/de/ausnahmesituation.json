                "senses": [
                    {
                        "sense_id": "a2fb6654-d2c4-3221-bf67-0d1035536cdb",
                        "entry_id": "0eb71700-d66e-37ac-9254-38f614345201",
                        "glosses": [
                            "Lebensphase, die vom Gewohnten abweicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b220f3f-1a6e-40d1-b93e-75d819f0cb8c",
                                "sense_id": "a2fb6654-d2c4-3221-bf67-0d1035536cdb",
                                "text": "Ich habe das Buch „Mensch bleiben im Krankenhaus: zwischen Alltag und Ausnahmesituation“ von Max Müller ausgeliehen und muss es ihm bald zurückgeben."
                            },
                            {
                                "example_id": "2db2332d-6b6f-4784-86a5-66198b9bfed4",
                                "sense_id": "a2fb6654-d2c4-3221-bf67-0d1035536cdb",
                                "text": "„Psychologen argumentierten anschließend, dass solche gedanklichen Artefakte bei Menschen, die sich in extrem dramatischen Ausnahmesituationen befänden, nicht außergewöhnlich seien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
