        "nl-extract.jsonl": [
            {
                "entry_id": "d27d926f-dca1-3112-a7b0-56805909a155",
                "word": "kwellend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "08386029-8d2a-392e-b02f-f1553c0939b4",
                        "entry_id": "d27d926f-dca1-3112-a7b0-56805909a155",
                        "glosses": [
                            "van iets of iemand dat het heel vervelend is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb175c19-5718-4173-9f33-77d3f8dc6b97",
                                "sense_id": "08386029-8d2a-392e-b02f-f1553c0939b4",
                                "text": "'Het besluit om mijn racket aan de wilgen te hangen was heel wat moeilijker dan zeven partijen achtereen winnen in de Australische hitte. Het heeft me enkele kwellende maanden gekost om tot de conclusie te komen dat ik door mijn blessures nooit meer de tennisster zal worden die ik was."
                            },
                            {
                                "example_id": "955edae8-7b82-4753-928e-cca54b5784d6",
                                "sense_id": "08386029-8d2a-392e-b02f-f1553c0939b4",
                                "text": "Dankzij treffers van David Silva en Alcácer leidde Spanje bij de rust met 2-0. Na de pauze verloste Costa zich met een trefzekere knal van dichtbij van de kwellende nul waarna invaller Juan Bernat de eindstand op 0-4 bepaalde."
                            }
                        ]
                    }
