                    "sense_id": "35438b87-af11-338a-9fe0-c5f2a3eb8d8e",
                    "sense_definition": "Qui a de l'énergie, qui fait preuve de dynamisme, de vigueur ou de fermeté dans l'action.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vitalite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette directrice <w>énergique</w> sait motiver son équipe et résoudre les problèmes rapidement.",
                            "target_lang_translations": {
                                "en": "This <w>energetic</w> director knows how to motivate her team and solve problems quickly.",
                                "ru": "Эта <w>энергичная</w> руководительница умеет мотивировать свою команду и быстро решать проблемы.",
                                "nl": "Deze <w>energieke</w> directrice weet haar team te motiveren en problemen snel op te lossen.",
                                "de": "Diese <w>energische</w> Direktorin versteht es, ihr Team zu motivieren und Probleme schnell zu lösen.",
                                "pl": "Ta <w>energiczna</w> dyrektorka potrafi zmotywować swój zespół i szybko rozwiązywać problemy.",
                                "it": "Questa <w>energica</w> direttrice sa motivare la sua squadra e risolvere i problemi in fretta.",
                                "cs": "Tato <w>energická</w> ředitelka dokáže motivovat svůj tým a rychle řešit problémy.",
                                "tr": "Bu <w>enerjik</w> kadın müdür, ekibini motive etmeyi ve sorunları hızla çözmeyi biliyor.",
                                "es": "Esta directora <w>enérgica</w> sabe motivar a su equipo y resolver los problemas rápidamente.",
                                "zh": "这位<w>精力充沛</w>的女经理懂得激励团队，并能迅速解决问题。"
                            }
                        },
                        {
                            "text": "Le gouvernement a décidé d'adopter des mesures <w>énergiques</w> pour lutter contre le chômage.",
                            "target_lang_translations": {
                                "en": "The government has decided to adopt <w>tough</w> measures to fight unemployment.",
                                "ru": "Правительство решило принять <w>решительные</w> меры для борьбы с безработицей.",
                                "nl": "De regering heeft besloten <w>krachtdadige</w> maatregelen te nemen om de werkloosheid te bestrijden.",
                                "de": "Die Regierung hat beschlossen, <w>energische</w> Maßnahmen zur Bekämpfung der Arbeitslosigkeit zu ergreifen.",
                                "pl": "Rząd postanowił podjąć <w>energiczne</w> środki, aby walczyć z bezrobociem.",
                                "it": "Il governo ha deciso di adottare misure <w>energiche</w> per combattere la disoccupazione.",
                                "cs": "Vláda se rozhodla přijmout <w>rázná</w> opatření k boji proti nezaměstnanosti.",
                                "tr": "Hükümet, işsizlikle mücadele için <w>kararlı</w> önlemler almaya karar verdi.",
                                "es": "El Gobierno ha decidido adoptar medidas <w>drásticas</w> para combatir el desempleo.",
                                "zh": "政府决定采取<w>有力</w>措施来应对失业问题。"
                            }
                        }
                    ],
