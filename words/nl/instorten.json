                },
                {
                    "sense_id": "7ae724f3-d8d8-3cb8-a015-636765413079",
                    "sense_definition": "geestelijk of emotioneel de controle verliezen door grote spanning of verdriet",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mentaal bezwijken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen zij het vreselijke nieuws hoorde, <w>stortte</w> ze volledig <w>in</w> en begon hard te huilen.",
                            "target_lang_translations": {
                                "en": "When she heard the terrible news, she completely <w>broke down</w> and started crying hard."
                            }
                        },
                        {
                            "text": "Na maanden van overwerk <w>stortte</w> hij emotioneel <w>in</w> door de enorme druk.",
                            "target_lang_translations": {
                                "en": "After months of overwork, he <w>collapsed</w> emotionally due to the enormous pressure."
                            }
                        }
                    ],
                    "synonyms": [
