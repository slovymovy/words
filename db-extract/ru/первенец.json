                    },
                    {
                        "translation_id": "cdf66eec-4f8c-41b2-970b-f943f69fc0fe",
                        "source_entry_id": "41de430e-2670-3acf-bfe7-7219f8726e1d",
                        "source_sense_description": "первый ребёнок в семье",
                        "target_lang_word": "Erstlingswerk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erstlingswerk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4c1efac4-65ff-3d2c-8ea5-6db493521f24",
                                        "entry_id": "4645caa0-1624-3f5c-8294-bfa2c2ee3bec",
                                        "glosses": [
                                            "das erste Werk eines Schöpfers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d7f2fde-cee8-432b-aba6-e89aed5fa346",
                                                "sense_id": "4c1efac4-65ff-3d2c-8ea5-6db493521f24",
                                                "text": "„Schon in seinem Erstlingswerk »Waverley« versuchte er, das rebellische, wilde Hochland mit dem zivilisierten Süden zu versöhnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "330c4f71-a72e-4e67-9b6c-8be518d97356",
                        "source_entry_id": "41de430e-2670-3acf-bfe7-7219f8726e1d",
                        "source_sense_description": "то, что появилось первым",
                        "target_lang_word": "firstling",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "firstling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b73c627a-b86d-3693-ae5f-e49b65e91f73",
                                        "entry_id": "a8ba71e1-0214-309c-be61-6e710641edc0",
                                        "glosses": [
                                            "The first produce or result, notably firstborn offspring."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfa749c5-5978-4624-b468-456306024d3e",
                                                "sense_id": "b73c627a-b86d-3693-ae5f-e49b65e91f73",
                                                "text": "And Abel, he also brought of the firstlings of his flock and of the fat thereof. And the Lord had respect unto Abel and to his offering:"
                                            },
                                            {
                                                "example_id": "170a9d07-b7da-4066-9da3-7e733d493aa7",
                                                "sense_id": "b73c627a-b86d-3693-ae5f-e49b65e91f73",
                                                "text": "The seasons bring the flower again,\n⁠And bring the firstling to the flock;\n⁠And in the dusk of thee, the clock\nBeats out the little lives of men."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "135829b9-0a76-3004-80e9-b3ae14a578c2",
                                        "entry_id": "a8ba71e1-0214-309c-be61-6e710641edc0",
                                        "glosses": [
                                            "The first of a class or kind."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "885d34c0-2eef-32c2-bba3-38a8bdbeacbb",
                                        "entry_id": "a8ba71e1-0214-309c-be61-6e710641edc0",
                                        "glosses": [
                                            "The thing first thought or done."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ca3343c-fbbb-44fe-9405-94656bfb4ec1",
                                                "sense_id": "885d34c0-2eef-32c2-bba3-38a8bdbeacbb",
                                                "text": "From this moment the very firstlings of my heart shall be the firstlings of my hand."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "firstling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f0e3f11-ffb8-3860-b2e4-594a19851b58",
                                        "entry_id": "0b431473-3015-3497-9e73-b9ea8bd14e82",
                                        "glosses": [
                                            "Firstborn."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "072fe984-8afd-48d0-a80c-88e9d1555995",
                                                "sense_id": "5f0e3f11-ffb8-3860-b2e4-594a19851b58",
                                                "text": "All the firstling males that come of thy herd and of thy flock thou shalt sanctify unto the Lord thy God: thou shalt do no work with the firstling of thy bullock, nor shear the firstling of thy sheep."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
