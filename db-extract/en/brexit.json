                                "example_id": "fc9f4253-da45-4ebd-8b9f-609e07aa2654",
                                "sense_id": "d708c409-2835-3422-bf0c-969d8cadf90c",
                                "text": "Brexiting the EU, not leaving Europe"
                            },
