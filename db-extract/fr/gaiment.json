                    },
                    {
                        "sense_id": "6e42e73c-6318-3e54-822b-8dec8c6cd51e",
                        "entry_id": "b72fb7ae-3e08-3d8b-b324-a7901033dd18",
                        "glosses": [
                            "Rapidement, d'un bon train."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "e2d01f13-40a2-4227-955d-2136a827818f",
                                "sense_id": "6e42e73c-6318-3e54-822b-8dec8c6cd51e",
                                "text": "Aller gaiment. aller son train."
                            },
                            {
                                "example_id": "30fd0df0-953c-4bf7-a55a-452ca65636fe",
                                "sense_id": "6e42e73c-6318-3e54-822b-8dec8c6cd51e",
                                "text": "Allons-y gaiment."
