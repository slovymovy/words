                "senses": [
                    {
                        "sense_id": "b0d8b1e0-d41f-3d0e-a271-ff81bb1239fd",
                        "entry_id": "de7b0a14-d608-301e-b81d-d3367bec4f65",
                        "glosses": [
                            "Celle qui dirige une entreprise théâtrale ; celle qui s’occupe de la vie professionnelle d’un artiste ou d’un groupe d’artistes."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "9a1d4363-1d5d-4933-b165-8548e375d308",
                                "sense_id": "b0d8b1e0-d41f-3d0e-a271-ff81bb1239fd",
                                "text": "Dix-huit heures. Déjeuner avec Baptiste, Victoria et Béatrice Soulé, mon attachée de presse, imprésaria et amie, l’une des bonnes fées de ma vie…"
                            },
                            {
                                "example_id": "cc3e8c08-6bb5-4bb1-990c-28234803f7e3",
                                "sense_id": "b0d8b1e0-d41f-3d0e-a271-ff81bb1239fd",
                                "text": "Caroline Molé se fit l’“infatigable imprésaria” de plusieurs comédies qui se donnaient du dernier dimanche d’août au deuxième de septembre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed4eeffc-6eec-49f9-9879-fdbef654a5ce",
                        "source_entry_id": "de7b0a14-d608-301e-b81d-d3367bec4f65",
                        "source_sense_id": "b0d8b1e0-d41f-3d0e-a271-ff81bb1239fd",
