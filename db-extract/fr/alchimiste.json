                                        "glosses": [
                                            "muž zabývající se alchymií"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1857246a-2f80-4204-b494-7615b7563855",
                                                "sense_id": "79ee5873-cd62-363d-904f-0795660777b3",
                                                "text": "...a kde rozkoš, alchymista otrávený parami svého marného varu, šílí v halucinacích;..."
