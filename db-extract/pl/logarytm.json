                "translations": [
                    {
                        "translation_id": "980b9615-56a3-45c4-82c2-33cb5e70b61e",
                        "source_entry_id": "8a0f9fc1-61dd-37cd-a891-622a142b0b8e",
                        "source_sense_id": "daf1b1b1-ae86-30b2-8671-2c4134985de8",
                        "target_lang_word": "logarithm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "logarithm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f59083b-3925-3af7-b44d-33116a383a54",
                                        "entry_id": "b069c7de-b55a-3a12-abb9-54781a538ecd",
                                        "glosses": [
                                            "For a number x, the exponent by which a given base number must be raised in order to obtain the power x. Written log _bx. For example, log ₁₀1000=3 because 10³=1000 and log ₂16=4 because 2⁴=16."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58b22da0-e995-4f94-a94b-4daee3d22ea7",
                                                "sense_id": "7f59083b-3925-3af7-b44d-33116a383a54",
                                                "text": "For a currency which uses denominations of 1, 2, 5, 10, 20, 50, 100, 200, 500, 1000, etc., each jump in the base-10 logarithm from one denomination to the next higher is either 0.3010 or 0.3979."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bac2fa6a-6a97-4cda-b1fd-021ed818845c",
                        "source_entry_id": "8a0f9fc1-61dd-37cd-a891-622a142b0b8e",
                        "source_sense_id": "daf1b1b1-ae86-30b2-8671-2c4134985de8",
                        "target_lang_word": "logaritmus",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "logaritmus",
