                                        "entry_id": "a901c4f7-7f28-30cb-a64c-d3ecdf1b155c",
                                        "glosses": [
                                            "Qualité, ensemble de qualités constituant le caractère d’un style, soit dans les sentiments et les idées, soit dans le mouvement et la couleur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6371345b-4690-42d6-9d9b-a8d885855cb0",
                                                "sense_id": "8b2d5a61-c3ab-3e83-87b4-9cafaaf09259",
                                                "text": "Il y a trop de lyrisme dans sa prose."
                                            },
                                            {
                                                "example_id": "94acf25e-b6d3-4bee-9a79-a8352ab8078a",
                                                "sense_id": "8b2d5a61-c3ab-3e83-87b4-9cafaaf09259",
                                                "text": "Je te ferai bonne mesure de lyrisme funèbre, et l’orthographe sera mieux mise qu’une duchesse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb4160ed-ed56-3aac-ac9f-4dd033a62da8",
                                        "entry_id": "a901c4f7-7f28-30cb-a64c-d3ecdf1b155c",
                                        "glosses": [
                                            "Certaine exaltation d’esprit analogue à l’enthousiasme des poètes lyriques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6692b5d-65ba-4166-9c56-2fc8b808380e",
                                                "sense_id": "eb4160ed-ed56-3aac-ac9f-4dd033a62da8",
                                                "text": "Un lyrisme intime bouillonna dans cette âme pleine des belles illusions de la jeunesse."
                                            }
                                        ]
                                    },
