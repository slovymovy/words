{
    "word_family": [
        "stuifmeel",
        "stuifzand",
        "verstuiven",
        "opstuiven",
        "wegstuiven"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5aba6376-5ff3-349b-a7b4-c17d486316fb",
                    "sense_definition": "Zich snel en onstuimig voortbewegen, vaak plotseling of wild.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "snel_bewegen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen de bel ging, <w>stoof</w> de hond direct naar de voordeur.",
                            "target_lang_translations": {
                                "en": "When the bell rang, the dog immediately <w>dashed</w> to the front door."
                            }
                        },
                        {
                            "text": "De dieven <w>stoven</w> snel weg toen ze de politie in de verte zagen aankomen.",
                            "target_lang_translations": {
                                "en": "The thieves quickly <w>bolted</w> when they saw the police approaching in the distance."
                            }
                        }
                    ],
                    "synonyms": [
                        "rennen",
                        "vliegen",
                        "snellen",
                        "razen"
                    ],
                    "antonyms": [
                        "slenteren",
                        "wandelen"
                    ],
                    "common_phrases": [
                        "weg te stuiven",
                        "naar binnen stuiven"
                    ],
                    "target_lang_definitions": {
                        "en": "To move quickly and impetuously, often suddenly or wildly."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dash",
                                "target_lang_sense_clarification": "to run or move quickly and suddenly"
                            },
                            {
                                "target_lang_word": "rush",
                                "target_lang_sense_clarification": "to move with great speed or haste"
                            },
                            {
                                "target_lang_word": "scurry",
                                "target_lang_sense_clarification": "to move quickly with small, short steps"
                            },
                            {
                                "target_lang_word": "bolt",
                                "target_lang_sense_clarification": "to run away suddenly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "08119d6d-cd84-33ec-af10-5559ddf31893",
                    "sense_definition": "Door de wind in de lucht geblazen en verplaatst worden (van fijne deeltjes zoals zand of sneeuw).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wind_verplaatsing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de harde storm <w>stuift</w> het droge zand over de hele weg.",
                            "target_lang_translations": {
                                "en": "Due to the severe storm, the dry sand is <w>drifting</w> across the entire road."
                            }
                        },
                        {
                            "text": "Er <w>stuift</w> koude sneeuw in mijn gezicht tijdens deze winterse wandeling.",
                            "target_lang_translations": {
                                "en": "Cold snow is <w>blowing</w> into my face during this wintry walk."
                            }
                        }
                    ],
                    "synonyms": [
                        "waaien",
                        "opwaaien"
                    ],
                    "common_phrases": [
                        "stuivend zand"
                    ],
                    "target_lang_definitions": {
                        "en": "To be blown and drifted through the air by the wind (of fine particles like sand or snow)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drift",
                                "target_lang_sense_clarification": "of snow or sand, to be blown into heaps or carried by the wind"
                            },
                            {
                                "target_lang_word": "blow",
                                "target_lang_sense_clarification": "to be carried or moved by the wind"
                            },
                            {
                                "target_lang_word": "whirl",
                                "target_lang_sense_clarification": "to spin or drift rapidly in the air"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e6f4d2c-9c1e-32c6-86bd-be374b000d16",
                    "sense_definition": "Stof afgeven of stof doen opwaaien.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "stof_afgeven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet die oude boeken voorzichtig oppakken, want ze <w>stuiven</w> enorm.",
                            "target_lang_translations": {
                                "en": "You have to pick up those old books carefully, because they <w>raise a lot of dust</w>."
                            }
                        },
                        {
                            "text": "De droge kalk <w>stuift</w> door de hele kamer als je ertegen stoot.",
                            "target_lang_translations": {
                                "en": "The dry lime <w>puffs up as dust</w> throughout the room if you bump into it."
                            }
                        }
                    ],
                    "synonyms": [
                        "stoffen"
                    ],
                    "target_lang_definitions": {
                        "en": "To give off dust or cause dust to rise up into the air."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "raise dust",
                                "target_lang_sense_clarification": "to cause fine particles to rise into the air"
                            },
                            {
                                "target_lang_word": "be dusty",
                                "target_lang_sense_clarification": "to release or be covered in fine dust when disturbed"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}