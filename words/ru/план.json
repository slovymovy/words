    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dc47f9e8-e901-3648-84fa-8819386a0256",
                    "sense_definition": "Заранее обдуманный порядок действий, необходимых для достижения какой-либо цели.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "intention_scheme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У меня есть отличный <w>план</w> на эти выходные.",
                            "target_lang_translations": {
                                "en": "I have a great <w>plan</w> for this weekend.",
                                "de": "Ich habe einen tollen <w>Plan</w> für dieses Wochenende."
                            }
                        },
                        {
                            "text": "Всё идёт строго по <w>плану</w>, и мы успеем вовремя.",
                            "target_lang_translations": {
                                "en": "Everything is going strictly according to <w>plan</w>, and we will be on time.",
                                "de": "Alles läuft streng nach <w>Plan</w>, und wir werden rechtzeitig fertig."
                            }
                        },
                        {
                            "text": "Наш <w>план</w> действий требует тщательной подготовки.",
                            "target_lang_translations": {
                                "en": "Our action <w>plan</w> requires careful preparation.",
                                "de": "Unser Aktions<w>plan</w> erfordert eine sorgfältige Vorbereitung."
                            }
                        }
                    ],
                    "synonyms": [
                        "замысел",
                        "намерение",
                        "программа",
                        "проект",
                        "задумка",
                        "намётка",
                        "идея"
                    ],
                    "common_phrases": [
                        "строить планы",
                        "по плану",
                        "план действий",
                        "план работы",
                        "входит в планы"
                    ],
                    "target_lang_definitions": {
                        "en": "A pre-conceived order of actions necessary to achieve a goal.",
                        "de": "Ein im Voraus durchdachter Ablauf von Handlungen, die notwendig sind, um ein Ziel zu erreichen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "plan",
                                "target_lang_sense_clarification": "a set of intended actions"
                            },
                            {
                                "target_lang_word": "scheme",
                                "target_lang_sense_clarification": "a systematic plan or plot"
                            },
                            {
                                "target_lang_word": "roadmap",
                                "target_lang_sense_clarification": "a strategic plan defining a goal"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Plan",
                                "target_lang_sense_clarification": "ein durchdachtes Vorhaben oder eine Vorgehensweise"
                            },
                            {
                                "target_lang_word": "Konzept",
                                "target_lang_sense_clarification": "ein systematischer Entwurf oder eine Idee"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c97c456-eda2-3de8-9b7a-9ec6d7b0958b",
                    "sense_definition": "Чертёж, изображающий в масштабе местность, здание или предмет (обычно вид сверху).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "drawing_map",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Туристы внимательно изучали <w>план</w> старого города.",
                            "target_lang_translations": {
                                "en": "The tourists were carefully studying the <w>map</w> of the old city.",
                                "de": "Die Touristen studierten aufmerksam den <w>Plan</w> der Altstadt."
                            }
                        },
                        {
                            "text": "На стене висел <w>план</w> эвакуации при пожаре.",
                            "target_lang_translations": {
                                "en": "An evacuation <w>plan</w> hung on the wall.",
                                "de": "An der Wand hing ein Evakuierungs<w>plan</w> für den Brandfall."
                            }
                        },
                        {
                            "text": "Архитектор показал нам подробный <w>план</w> квартиры.",
                            "target_lang_translations": {
                                "en": "The architect showed us a detailed <w>plan</w> of the apartment.",
                                "de": "Der Architekt zeigte uns einen detaillierten <w>Plan</w> der Wohnung."
                            }
                        }
                    ],
                    "synonyms": [
                        "схема",
                        "чертёж",
                        "карта",
                        "проект"
                    ],
                    "common_phrases": [
                        "план города",
                        "план этажа",
                        "план местности",
                        "нанести на план",
                        "генеральный план"
                    ],
                    "target_lang_definitions": {
                        "en": "A drawing depicting an area, building, or object to scale (usually a top view).",
                        "de": "Eine maßstabsgetreue Zeichnung, die ein Gebiet, ein Gebäude oder ein Objekt darstellt (meist aus der Vogelperspektive)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "plan",
                                "target_lang_sense_clarification": "technical drawing of a building or floor"
                            },
                            {
                                "target_lang_word": "map",
                                "target_lang_sense_clarification": "visual representation of an area"
                            },
                            {
                                "target_lang_word": "layout",
                                "target_lang_sense_clarification": "arrangement of a space"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Plan",
                                "target_lang_sense_clarification": "technische Darstellung eines Gebäudes oder Grundrisses"
                            },
                            {
                                "target_lang_word": "Karte",
                                "target_lang_sense_clarification": "visuelle Darstellung eines geografischen Gebiets"
                            },
                            {
                                "target_lang_word": "Grundriss",
                                "target_lang_sense_clarification": "detaillierte Zeichnung der Raumaufteilung eines Gebäudes"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdb46a6f-eb86-3944-8d8b-fca0bd520006",
                    "sense_definition": "Место, расположение кого-либо или чего-либо в перспективе (ближе или дальше от зрителя); масштаб изображения.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "perspective",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На переднем <w>плане</w> картины художник изобразил реку.",
                            "target_lang_translations": {
                                "en": "In the <w>foreground</w> of the painting, the artist depicted a river.",
                                "de": "Im Vorder<w>plan</w> des Gemäldes stellte der Künstler einen Fluss dar."
                            }
                        },
                        {
                            "text": "Личные проблемы отошли на второй <w>план</w> из-за работы.",
                            "target_lang_translations": {
                                "en": "Personal problems faded into the <w>background</w> because of work.",
                                "de": "Persönliche Probleme traten wegen der Arbeit in den Hinter<w>plan</w>."
                            }
                        },
                        {
                            "text": "Режиссёр решил снять лицо актёра крупным <w>планом</w>.",
                            "target_lang_translations": {
                                "en": "The director decided to film the actor's face in <w>close-up</w>.",
                                "de": "Der Regisseur entschied sich, das Gesicht des Schauspielers in einer Großaufnahme (<w>Plan</w>) zu filmen."
                            }
                        }
                    ],
                    "synonyms": [
                        "перспектива",
                        "проекция"
                    ],
                    "common_phrases": [
                        "на первом плане",
                        "на задний план",
                        "крупным планом",
                        "отойти на второй план"
                    ],
                    "target_lang_definitions": {
                        "en": "The location of someone or something in perspective (closer or further from the viewer); the scale of an image.",
                        "de": "Die räumliche Anordnung von Objekten oder Personen in der Perspektive (näher oder weiter vom Betrachter entfernt); der Bildausschnitt."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "foreground",
                                "target_lang_sense_clarification": "part of a view that is nearest"
                            },
                            {
                                "target_lang_word": "background",
                                "target_lang_sense_clarification": "part of a view that is furthest"
                            },
                            {
                                "target_lang_word": "shot",
                                "target_lang_sense_clarification": "cinematographic view (e.g., close-up)"
                            },
                            {
                                "target_lang_word": "plane",
                                "target_lang_sense_clarification": "level of existence or thought"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Vordergrund",
                                "target_lang_sense_clarification": "der dem Betrachter am nächsten gelegene Teil eines Bildes"
                            },
                            {
                                "target_lang_word": "Hintergrund",
                                "target_lang_sense_clarification": "der am weitesten entfernte Teil eines Bildes"
                            },
                            {
                                "target_lang_word": "Einstellung",
                                "target_lang_sense_clarification": "filmischer Bildausschnitt, z. B. Großaufnahme"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3fa60721-04e1-3d88-8558-5172b6d2d5be",
                    "sense_definition": "Официальное производственное задание по количеству и качеству работы, обязательное для выполнения к определённому сроку.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quota",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Завод смог выполнить годовой <w>план</w> досрочно.",
                            "target_lang_translations": {
                                "en": "The factory was able to fulfill the annual <w>plan</w> ahead of schedule.",
                                "de": "Das Werk konnte das Jahres<w>soll</w> vorzeitig erfüllen."
                            }
                        },
                        {
                            "text": "Менеджер получил премию за то, что перевыполнил <w>план</w> продаж.",
                            "target_lang_translations": {
                                "en": "The manager received a bonus for exceeding the sales <w>target</w>.",
                                "de": "Der Manager erhielt eine Prämie dafür, dass er das Verkaufs<w>ziel</w> übertroffen hat."
                            }
                        }
                    ],
                    "synonyms": [
                        "показатель"
                    ],
                    "common_phrases": [
                        "выполнить план",
                        "перевыполнить план",
                        "производственный план",
                        "план продаж"
                    ],
                    "target_lang_definitions": {
                        "en": "An official production task regarding quantity and quality of work, mandatory for completion by a deadline.",
                        "de": "Eine offizielle Produktionsvorgabe bezüglich Menge und Qualität der Arbeit, die bis zu einem bestimmten Termin erfüllt werden muss."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "target",
                                "target_lang_sense_clarification": "a goal or objective to be reached"
                            },
                            {
                                "target_lang_word": "quota",
                                "target_lang_sense_clarification": "a fixed share or amount to be produced"
                            },
                            {
                                "target_lang_word": "plan",
                                "target_lang_sense_clarification": "economic or production goal"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Soll",
                                "target_lang_sense_clarification": "vorgegebene Zielgröße oder Produktionsvorgabe"
                            },
                            {
                                "target_lang_word": "Quote",
                                "target_lang_sense_clarification": "ein fester Anteil oder eine zu erreichende Menge"
                            },
                            {
                                "target_lang_word": "Zielvorgabe",
                                "target_lang_sense_clarification": "ein offiziell gesetztes Leistungsziel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9c285c3-0ad8-33cb-9507-44ec8768dda0",
                    "sense_definition": "Способ рассмотрения чего-либо, точка зрения, аспект.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "aspect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В <w>плане</w> финансов этот проект кажется мне очень рискованным.",
                            "target_lang_translations": {
                                "en": "In <w>terms</w> of finances, this project seems very risky to me.",
                                "de": "In finanzieller <w>Hinsicht</w> erscheint mir dieses Projekt sehr riskant."
                            }
                        },
                        {
                            "text": "В теоретическом <w>плане</w> эта задача решается довольно просто.",
                            "target_lang_translations": {
                                "en": "In theoretical <w>terms</w>, this problem is solved quite simply.",
                                "de": "In theoretischer <w>Hinsicht</w> lässt sich diese Aufgabe recht einfach lösen."
                            }
                        }
                    ],
                    "synonyms": [
                        "аспект",
                        "точка зрения"
                    ],
                    "common_phrases": [
                        "в этом плане",
                        "в плане того что",
                        "в эмоциональном плане"
                    ],
                    "target_lang_definitions": {
                        "en": "A way of considering something, point of view, aspect.",
                        "de": "Eine Art und Weise, etwas zu betrachten; ein Gesichtspunkt oder Aspekt."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "terms",
                                "target_lang_sense_clarification": "used in phrases like 'in terms of'"
                            },
                            {
                                "target_lang_word": "perspective",
                                "target_lang_sense_clarification": "point of view"
                            },
                            {
                                "target_lang_word": "aspect",
                                "target_lang_sense_clarification": "a particular part or feature"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Hinsicht",
