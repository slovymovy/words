                                            {
                                                "example_id": "4ccb51af-b5b4-4efe-aec4-926bf412a8bd",
                                                "sense_id": "84bacb36-6359-3eba-82e2-7cfc250b4841",
                                                "text": "The normal course of events seems to be just one damned thing after another."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01b9b931-6874-3a2b-bc7e-2091cbb2f7ad",
                                        "entry_id": "c523966a-30c9-3f43-950a-61a7f3c71735",
                                        "glosses": [
                                            "A sequence of events.",
                                            "A normal or customary sequence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f322a2a-97c6-45ae-8ee6-f31a18670e74",
                                                "sense_id": "01b9b931-6874-3a2b-bc7e-2091cbb2f7ad",
                                                "text": "The course of true love never did run smooth."
                                            },
                                            {
                                                "example_id": "e2fc818e-9c13-452c-ac60-8c0df675cf80",
                                                "sense_id": "01b9b931-6874-3a2b-bc7e-2091cbb2f7ad",
                                                "text": "Day and night, / Seedtime and harvest, heat and hoary frost, / Shall hold their course."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7975c6d-f4ec-3214-8ca2-4a2851b5deab",
                                        "entry_id": "c523966a-30c9-3f43-950a-61a7f3c71735",
                                        "glosses": [
                                            "A sequence of events.",
                                            "A programme, a chosen manner of proceeding."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7cab0b21-afc3-3383-8923-37980447ab1a",
                                        "entry_id": "c523966a-30c9-3f43-950a-61a7f3c71735",
                                        "glosses": [
                                            "A sequence of events.",
                                            "Any ordered process or sequence of steps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcba0a52-5680-4526-a423-34a10c51b06a",
                                                "sense_id": "7cab0b21-afc3-3383-8923-37980447ab1a",
                                                "text": "There is but one course for me to follow: I'LL MOIDER THE BUM!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20777b5a-8500-3bce-a4b3-16fbc274b783",
                                        "entry_id": "c523966a-30c9-3f43-950a-61a7f3c71735",
                                        "glosses": [
                                            "A sequence of events.",
                                            "A learning programme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "278a2e95-cf99-4fb6-9a9a-739727305181",
                                                "sense_id": "20777b5a-8500-3bce-a4b3-16fbc274b783",
                                                "text": "Her course will be ‘Communication Studies with Theatre Studies’: God, how tedious, how pointless."
                                            },
                                            {
                                                "example_id": "38fdb681-fc51-4320-be17-77b568273e46",
                                                "sense_id": "20777b5a-8500-3bce-a4b3-16fbc274b783",
                                                "text": "Since the launch early last year of […] two Silicon Valley start-ups offering free education through MOOCs, massive open online courses, the ivory towers of academia have been shaken to their foundations. University brands built in some cases over centuries have been forced to contemplate the possibility that information technology will rapidly make their existing business model obsolete."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ddb49de3-0ec7-3a39-b14f-cb6815edb6f6",
                                        "entry_id": "c523966a-30c9-3f43-950a-61a7f3c71735",
                                        "glosses": [
                                            "A sequence of events.",
                                            "A learning programme",
                                            "a series of lectures or lessons in a particular subject"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4cb2a85-ef4f-4f16-98a8-949fefd2129e",
                                                "sense_id": "ddb49de3-0ec7-3a39-b14f-cb6815edb6f6",
                                                "text": "I need to take a French course."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c5e4a62-2f3a-3c25-9ea5-74d424881b00",
                                        "entry_id": "c523966a-30c9-3f43-950a-61a7f3c71735",
                                        "glosses": [
                                            "A sequence of events.",
                                            "A learning programme",
                                            "an educational programme at a college or university leading to an academic degree or vocational qualification."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "Philippines",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "377e7f61-1b7f-44d2-9518-87958db43554",
                                                "sense_id": "6c5e4a62-2f3a-3c25-9ea5-74d424881b00",
                                                "text": "What's your course in university?\n—Business studies. And you?"
                                            },
                                            {
                                                "example_id": "88910189-9a22-4e9c-b689-462d16ca6d7a",
                                                "sense_id": "6c5e4a62-2f3a-3c25-9ea5-74d424881b00",
                                                "text": "During the whole time of his abode in the university he generally spent thirteen hours of the day in study; by which assiduity besides an exact dispatch of the whole course of philosophy, he read over in a manner all classic authors that are extant[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1af506e3-06eb-33ba-baca-4bd001322d06",
                                        "entry_id": "c523966a-30c9-3f43-950a-61a7f3c71735",
                                        "glosses": [
                                            "A sequence of events.",
                                            "A treatment plan."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48d123ca-987c-40ef-8b9c-e9773a9548a4",
                                                "sense_id": "1af506e3-06eb-33ba-baca-4bd001322d06",
                                                "text": "Miss Clark, alarmed at her increasing stoutness, was doing a course of what is popularly known as banting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8666e58e-c216-343a-aec8-7f3c48c3b246",
                                        "entry_id": "c523966a-30c9-3f43-950a-61a7f3c71735",
                                        "glosses": [
                                            "A sequence of events.",
                                            "A stage of a meal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bfe8b44-8a5e-459f-9e50-4c910e4c53c5",
                                                "sense_id": "8666e58e-c216-343a-aec8-7f3c48c3b246",
                                                "text": "We offer seafood as the first course."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83af5101-5a54-384a-b19b-265c30a18c73",
                                        "entry_id": "c523966a-30c9-3f43-950a-61a7f3c71735",
