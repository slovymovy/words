                "senses": [
                    {
                        "sense_id": "7e9a8d15-7903-3153-89a1-a4d48fa95e01",
                        "entry_id": "6898cb96-6c15-3567-8ce8-43d1a14494c4",
                        "glosses": [
                            "eine von Grund auf methodisch aufgebaute Wissenschaftssprache, in der die Verwendung der Worte normiert werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efa0a9dd-b0c9-492d-9fbc-60d9660cea7b",
                                "sense_id": "7e9a8d15-7903-3153-89a1-a4d48fa95e01",
                                "text": "Dementsprechend besteht die erste Aufgabe bei der Konstruktion einer Orthosprache darin die aus Sicht der Sprachanwender relevanten Fachbegriffe zu rekonstruieren."
                            },
                            {
                                "example_id": "16e74eb6-8cd7-45a8-aa65-f29b76797555",
                                "sense_id": "7e9a8d15-7903-3153-89a1-a4d48fa95e01",
                                "text": "„Die Wirtschaft rein von der Ethik her normieren zu wollen, hieße so gesehen ungefähr so viel, wie eine lebendige, immer auch kollektives Bewusstsein (und Unterbewusstsein) transportierende Sprache rein von der Logik her reformieren und auf eine „Orthosprache“ hin entwickeln zu wollen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
