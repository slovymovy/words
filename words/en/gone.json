{
    "word_family": [
        "go",
        "goer",
        "going"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ff8921e5-6a9d-30a4-9eec-637281b24be8",
                    "sense_definition": "Away or having left a place.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "state_of_absence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Are they <w>gone</w> already?",
                            "target_lang_translations": {
                                "ru": "Они уже <w>ушли</w>?"
                            }
                        },
                        {
                            "text": "Everyone has <w>gone</w> home for the evening.",
                            "target_lang_translations": {
                                "ru": "Все уже <w>ушли</w> домой на вечер."
                            }
                        }
                    ],
                    "synonyms": [
                        "absent",
                        "away"
                    ],
                    "antonyms": [
                        "present"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отсутствующий или покинувший место."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ушел",
                                "target_lang_sense_clarification": "о человеке, который покинул место"
                            },
                            {
                                "target_lang_word": "отсутствует",
                                "target_lang_sense_clarification": "в значении отсутствия на месте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c4826b5-d787-31c5-be9b-daafaf526134",
                    "sense_definition": "No longer existing or having passed in time.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "state_of_absence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The days of my youth are <w>gone</w>.",
                            "target_lang_translations": {
                                "ru": "Дни моей юности <w>прошли</w>."
                            }
                        },
                        {
                            "text": "All the little shops that used to be here are now <w>gone</w>.",
                            "target_lang_translations": {
                                "ru": "Все маленькие магазинчики, которые здесь были, теперь <w>исчезли</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "vanished",
                        "past"
                    ],
                    "target_lang_definitions": {
                        "ru": "Больше не существующий или прошедший во времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прошло",
                                "target_lang_sense_clarification": "о времени или событиях"
                            },
                            {
                                "target_lang_word": "исчез",
                                "target_lang_sense_clarification": "о том, чего больше нет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f57e5f1b-024a-302d-81d5-16cfa807a63d",
                    "sense_definition": "Completely consumed or used up.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "state_of_absence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am afraid all the coffee is <w>gone</w>.",
                            "target_lang_translations": {
                                "ru": "Боюсь, весь кофе <w>закончился</w>."
                            }
                        },
                        {
                            "text": "The milk is <w>gone</w> so we need to buy more.",
                            "target_lang_translations": {
                                "ru": "Молоко <w>закончилось</w>, поэтому нам нужно купить еще."
                            }
                        }
                    ],
                    "synonyms": [
                        "finished",
                        "depleted"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью израсходованный или съеденный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закончился",
                                "target_lang_sense_clarification": "о запасах или продуктах"
                            },
                            {
                                "target_lang_word": "съеден",
                                "target_lang_sense_clarification": "о еде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd46d1f2-88f4-3967-bf33-64d0fe2523ef",
                    "sense_definition": "Broken, failed, or no longer functioning.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "state_of_absence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The light bulb is <w>gone</w> so please put a new one in.",
                            "target_lang_translations": {
                                "ru": "Лампочка <w>перегорела</w>, пожалуйста, вкрути новую."
                            }
                        },
                        {
                            "text": "The car is not driveable because the steering is <w>gone</w>.",
                            "target_lang_translations": {
                                "ru": "Машина не на ходу, потому что рулевое управление <w>сломалось</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "broken",
                        "failed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сломанный, вышедший из строя или не функционирующий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сломался",
                                "target_lang_sense_clarification": "о механизме или детали"
                            },
                            {
                                "target_lang_word": "не работает",
                                "target_lang_sense_clarification": "о технике"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7d7b45e-2ff6-3a07-afee-a986a3eb2d14",
                    "sense_definition": "Dead or deceased.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "state_of_absence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many of my old friends are <w>gone</w> now.",
                            "target_lang_translations": {
                                "ru": "Многих моих старых друзей уже нет в живых (<w>умерли</w>)."
                            }
                        },
                        {
                            "text": "She felt very lonely after her husband was <w>gone</w>.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала себя очень одинокой после того, как ее муж <w>умер</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "deceased",
                        "dead"
                    ],
                    "target_lang_definitions": {
                        "ru": "Умерший или скончавшийся."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "умер",
                                "target_lang_sense_clarification": "о человеке"
                            },
                            {
                                "target_lang_word": "покойный",
                                "target_lang_sense_clarification": "эвфемизм для умершего"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1719cdf8-c133-3394-bb03-ed80c8d5ff0a",
                    "sense_definition": "Used with a duration to indicate how long a state has persisted, especially pregnancy.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is three months <w>gone</w>.",
                            "target_lang_translations": {
                                "ru": "Она <w>на третьем месяце</w> беременности."
                            }
                        },
                        {
                            "text": "The project has been six months <w>gone</w> since we started.",
                            "target_lang_translations": {
                                "ru": "Прошло шесть месяцев с тех пор, как мы начали проект."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется с указанием длительности, чтобы показать, как долго длится состояние (особенно беременность)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "на сроке",
                                "target_lang_sense_clarification": "о беременности"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "f318b927-1e0b-3293-8c5c-f8e397fdabb4",
                    "sense_definition": "Past, after, or later than a specific time.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You had better hurry up because it is <w>gone</w> four o'clock.",
                            "target_lang_translations": {
                                "ru": "Тебе лучше поторопиться, потому что уже <w>после</w> четырех часов."
                            }
                        },
                        {
                            "text": "We arrived when it was already <w>gone</w> midnight.",
                            "target_lang_translations": {
                                "ru": "Мы приехали, когда было уже <w>после</w> полуночи."
                            }
                        }
                    ],
                    "synonyms": [
                        "past",
                        "after"
                    ],
                    "target_lang_definitions": {
                        "ru": "После определенного времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "после",
                                "target_lang_sense_clarification": "указывает на время, прошедшее после указанного часа"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9c6a0998-6e9e-3570-be92-f28ca5edc4e1",
                    "sense_definition": "The past participle of <w>go</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has <w>gone</w> to the store.",
                            "target_lang_translations": {
                                "ru": "Он <w>ушел</w> в магазин."
                            }
                        },
                        {
                            "text": "They have <w>gone</w> on vacation.",
                            "target_lang_translations": {
                                "ru": "Они <w>уехали</w> в отпуск."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Past participle of the verb go."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие прошедшего времени от глагола go."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ушел",
                                "target_lang_sense_clarification": "форма глагола 'уйти'"
                            },
                            {
                                "target_lang_word": "уехал",
                                "target_lang_sense_clarification": "форма глагола 'уехать'"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}