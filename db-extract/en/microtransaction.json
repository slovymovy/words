                "entry_id": "45a1a109-aab9-398a-8312-4ac62d68096d",
                "word": "microtransaction",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d17df456-3e54-403d-b279-b605867adfd0",
                        "entry_id": "45a1a109-aab9-398a-8312-4ac62d68096d",
                        "tags": [
