                            {
                                "example_id": "241b750f-801b-4caa-a9bd-2f237c9b0578",
                                "sense_id": "188dbf8d-d3f5-3508-ae0d-a0f3808ba7f2",
                                "text": "The other took the card from his hand, read it in a rapid glance, looked again at Newman from head to foot, hesitated a moment, and then said, gravely but urbanely, “Madame de Cintré is not at home.”"
                            },
                            {
                                "example_id": "1aebb88a-f11c-4c97-9a7c-e8a6e327f818",
                                "sense_id": "188dbf8d-d3f5-3508-ae0d-a0f3808ba7f2",
                                "text": "Appleby[…]rose from his seat when Morales came in. He shook hands urbanely, unbuckled his sword, and laid his kepi on the table, and then sat down with an expression of concern in his olive face which Appleby fancied was assumed."
                            }
