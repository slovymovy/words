                    {
                        "sense_id": "7da3af15-6514-3cdb-94c4-930dcf57869b",
                        "entry_id": "a1b720d2-1ccf-3378-a48d-10b4b9b8b852",
                        "glosses": [
                            "To reverse a repeal; to restore a ruling or law that was repealed."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e25e4bcd-00dc-4ae6-a173-9d4c151bf3a8",
                                "sense_id": "7da3af15-6514-3cdb-94c4-930dcf57869b",
                                "text": "Mr. Chairman, the Stark amendment, as I see it, is a last-ditch effort to resurrect the cat, the catastrophic care bill, and to unrepeal the repeal which we just passed."
                            },
                            {
                                "example_id": "00049ba3-037f-4559-aa17-f5fdea6a5712",
                                "sense_id": "7da3af15-6514-3cdb-94c4-930dcf57869b",
                                "text": "But the one important reform would be to unrepeal Glass Steagall."
                            },
                            {
                                "example_id": "f0e99a15-60ed-4854-b41d-d69a9445f809",
                                "sense_id": "7da3af15-6514-3cdb-94c4-930dcf57869b",
                                "text": "Therefore it would unrepeal its repeal in the EU Withdrawal Bill."
                            }
                        ]
                    }
