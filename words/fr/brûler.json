{
    "word_family": [
        "brûlant",
        "brûleur",
        "brûlis",
        "brûloir",
        "brûlure"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "849cb7ba-56aa-34ba-9c1d-c92109564672",
                    "sense_definition": "Détruire, consumer ou endommager gravement par l'action du feu ou d'une forte chaleur.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action_du_feu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les jardiniers ont ramassé les branches mortes pour les <w>brûler</w> dans la cour."
                        },
                        {
                            "text": "Le vieil homme préfère <w>brûler</w> du bois dans sa cheminée pendant l'hiver."
                        }
                    ],
                    "synonyms": [
                        "calciner",
                        "carboniser",
                        "incendier",
                        "incinérer"
                    ]
                },
                {
                    "sense_id": "bc4d25d9-66ea-3bb3-9ac2-3e7eee122492",
                    "sense_definition": "Être en feu, être la proie des flammes.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action_du_feu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une vieille grange abandonnée a commencé à <w>brûler</w> au milieu de la nuit."
                        },
                        {
                            "text": "Le feu de camp <w>brûle</w> calmement sous un ciel étoilé."
                        }
                    ],
                    "synonyms": [
                        "cramer",
                        "flamber"
                    ]
                },
                {
                    "sense_id": "e947725b-2890-3ea5-99d4-561d8a98e7b3",
                    "sense_definition": "Blesser la peau ou une partie du corps par le contact du feu ou d'un objet très chaud.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "blessure_thermique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fais bien attention à ne pas te <w>brûler</w> avec cette casserole d'eau bouillante."
                        },
                        {
                            "text": "Il s'est <w>brûlé</w> la main en touchant la porte du four chaud."
                        }
                    ],
                    "common_phrases": [
                        "se brûler le doigt"
                    ]
                },
                {
                    "sense_id": "47e3e127-1947-3dc1-842c-6802043b1985",
                    "sense_definition": "Franchir sans s'arrêter un signal ou ignorer une étape obligatoire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "franchissement_irregulier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet automobiliste distrait a failli provoquer un accident en voulant <w>brûler</w> un feu rouge."
                        },
                        {
                            "text": "Pour réussir ce projet d'apprentissage, il ne faut surtout pas <w>brûler</w> les étapes."
                        }
                    ],
                    "common_phrases": [
                        "brûler un feu rouge",
                        "brûler les étapes"
                    ]
                },
                {
                    "sense_id": "f9e1ae43-364b-31e1-9a2f-d98cc7ceda62",
                    "sense_definition": "Être excessivement chaud ou dégager une chaleur intense, en parlant du corps.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "chaleur_corporelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant est très malade et son front <w>brûle</w> depuis hier soir."
                        },
                        {
                            "text": "Pose un linge frais sur son visage car ses tempes <w>brûlent</w> de fièvre."
                        }
                    ],
                    "common_phrases": [
                        "brûler de fièvre"
                    ]
                },
                {
                    "sense_id": "87d78bbc-ad86-3362-8d29-63a26e738bd6",
                    "sense_definition": "Être très près de découvrir une solution, une réponse ou un objet caché.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "decouverte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cherche encore un peu dans cette pièce, tu <w>brûles</w> presque !"
                        },
                        {
                            "text": "Les enquêteurs ont compris qu'ils <w>brûlaient</w> après avoir trouvé ce précieux indice."
                        }
                    ],
                    "synonyms": [
                        "toucher au but"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Dans les jeux de devinettes ou de recherche"
                        }
                    ]
                },
                {
                    "sense_id": "610a6812-b88c-33e7-b667-e88b8c8dd9d9",
                    "sense_definition": "Éprouver un désir violent, être agité par une vive passion ou une vive impatience.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "passion_interieure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs mois d'absence, elle <w>brûle</w> d'impatience de retrouver sa famille."
                        },
                        {
                            "text": "Le jeune homme <w>brûlait</w> de désir pour cette femme inaccessible."
                        }
                    ],
                    "common_phrases": [
                        "brûler d'impatience",
                        "brûler de désir"
                    ]
                },
                {
                    "sense_id": "d88e911a-248b-30ad-a4e0-73d17d6fb178",
                    "sense_definition": "Abattre ou blesser quelqu'un à l'aide d'une arme à feu tirée de près.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "arme_a_feu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le bandit a menacé de <w>brûler</w> quiconque ferait le moindre geste suspect."
                        },
                        {
                            "text": "Si le garde s'approche d'un pas supplémentaire, le complice le <w>brûle</w> immédiatement."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Argot criminel ou policier"
                        }
                    ]
                }
            ]
        }
    ]
}