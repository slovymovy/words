        "fr-extract.jsonl": [
            {
                "entry_id": "04d772e2-0324-33d2-b3e9-c4142f0385d0",
                "word": "mégalomanie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "77ef5200-ad09-4ac9-bd2b-1b8c0286e56f",
                        "entry_id": "04d772e2-0324-33d2-b3e9-c4142f0385d0",
                        "tags": [
                            "plural"
                        ],
                        "form": "mégalomanies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "67f16fa3-dba3-3aa5-a194-8ec65e2d9d6d",
                        "entry_id": "04d772e2-0324-33d2-b3e9-c4142f0385d0",
                        "glosses": [
                            "Manie qui consiste soit en un désir insatiable de gloire, de grandeur, soit dans l’illusion qu’on les possède."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ba6151b-fa7e-4bb2-8b95-3dbf2a83d524",
                                "sense_id": "67f16fa3-dba3-3aa5-a194-8ec65e2d9d6d",
                                "text": "Une faiblesse, cependant : son ambition démesurée, qui tourne à la mégalomanie. Il se rêve à la Chambre, au gouvernement."
                            },
                            {
                                "example_id": "a0d463d1-8e99-4b66-a592-a33815831446",
                                "sense_id": "67f16fa3-dba3-3aa5-a194-8ec65e2d9d6d",
                                "text": "La mégalomanie, quezaco ? Elle consiste en une surestimation de ses capacités qui se traduit par un désir immodéré de puissance et un amour exclusif ou excessif de soi."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3effbd23-7c26-4877-8bcd-c3b97c867692",
                        "source_entry_id": "04d772e2-0324-33d2-b3e9-c4142f0385d0",
                        "source_sense_id": "67f16fa3-dba3-3aa5-a194-8ec65e2d9d6d",
                        "target_lang_word": "Megalomanie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Megalomanie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07839bc7-74f2-3b3c-aa80-77b625a5e303",
                                        "entry_id": "15fb840a-517e-3698-b859-8c605f3f6e88",
                                        "glosses": [
                                            "eine mentale Störung, charakterisiert von einer gehobenen Selbstüberschätzung"
                                        ],
                                        "tags": [
                                            "Psychiatrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87c08a45-304c-42e6-b109-5e9db4a2b4a8",
                                                "sense_id": "07839bc7-74f2-3b3c-aa80-77b625a5e303",
                                                "text": "„Prince Charles ruft angesichts eines Booms von Hochhausprojekten in London zum Kampf gegen die Megalomanie auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a6699262-35a8-43ff-b578-aefd6a4e6d16",
                        "source_entry_id": "04d772e2-0324-33d2-b3e9-c4142f0385d0",
                        "source_sense_id": "67f16fa3-dba3-3aa5-a194-8ec65e2d9d6d",
                        "target_lang_word": "Größenwahn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Größenwahn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3942f076-bce4-3d0a-b440-60982b3ed749",
                                        "entry_id": "865b1482-d35a-30b8-92ff-301a62c110be",
                                        "glosses": [
                                            "schmeichelnde Fehleinschätzung der eigenen Möglichkeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1a243bb-8455-4783-b3db-963ee0007070",
                                                "sense_id": "3942f076-bce4-3d0a-b440-60982b3ed749",
                                                "text": "Größenwahn war und ist Merkmal der meisten Diktatoren."
                                            },
                                            {
                                                "example_id": "af4d13df-1da3-400c-9b8c-32ec5f855d93",
                                                "sense_id": "3942f076-bce4-3d0a-b440-60982b3ed749",
                                                "text": "„Johann Eckert hatte schon immer unter Größenwahn gelitten.“"
                                            },
                                            {
                                                "example_id": "b46b6316-ff7f-444e-b552-416ffc6c39f9",
                                                "sense_id": "3942f076-bce4-3d0a-b440-60982b3ed749",
                                                "text": "„Alle waren dem Größenwahn verfallen.“"
                                            },
                                            {
                                                "example_id": "41b9c093-5f11-4c14-9af9-c138f5d1e7c5",
                                                "sense_id": "3942f076-bce4-3d0a-b440-60982b3ed749",
                                                "text": "„In seinem Größenwahn öffnete und schloss er die Mine der Hoffnung, wie es ihm passte, obwohl ganz Stadtland von besagter Mine lebte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0e62f20c-69ba-3f89-b4ce-57055150075a",
                                        "entry_id": "865b1482-d35a-30b8-92ff-301a62c110be",
                                        "glosses": [
                                            "aus [1] sich ableitendes Bedürfnis nach Anerkennung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5df071bb-f602-4da7-8867-dfa9a3c3aee5",
                                                "sense_id": "0e62f20c-69ba-3f89-b4ce-57055150075a",
                                                "text": "Größenwahn war und ist Merkmal der meisten Diktatoren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
