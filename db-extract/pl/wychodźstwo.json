                "translations": [
                    {
                        "translation_id": "2fceab01-9685-4320-88fd-a5d06d4c91df",
                        "source_entry_id": "ddfbf06a-abf1-3201-ae85-202f860d71da",
                        "source_sense_id": "2e126f69-b155-3b36-8454-1d1909fee59d",
                        "target_lang_word": "Auswanderung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Auswanderung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3dd53847-35eb-3384-a8a3-bf98b45af283",
                                        "entry_id": "498119f4-c6e4-34a1-8a0f-cf924d2fb177",
                                        "glosses": [
                                            "dauerhaftes Verlassen des Heimatlandes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4c1a892-67b7-441d-9e6d-831f08e3d6f2",
                                                "sense_id": "3dd53847-35eb-3384-a8a3-bf98b45af283",
                                                "text": "Die Auswanderung deutscher Staatsbürger hat in den vergangenen Jahren zugenommen."
                                            },
                                            {
                                                "example_id": "dc229403-dd7a-41c4-b27b-a73c023a8fae",
                                                "sense_id": "3dd53847-35eb-3384-a8a3-bf98b45af283",
                                                "text": "„Sie hatten über die Bedeutung ihrer Auswanderung genauso wenig nachgedacht wie über das Land, in das sie gekommen waren.“"
                                            },
                                            {
                                                "example_id": "721af149-8256-45a2-ac2c-03a85de4f6c2",
                                                "sense_id": "3dd53847-35eb-3384-a8a3-bf98b45af283",
                                                "text": "„Deren Eltern hatten einen Ausreiseantrag bewilligt bekommen und bereiteten ihre Auswanderung vor.“"
                                            },
                                            {
                                                "example_id": "41c1fc02-7fcf-473c-b091-511845ae218f",
                                                "sense_id": "3dd53847-35eb-3384-a8a3-bf98b45af283",
                                                "text": "Der nun bestimmte Zeitraum für eine Auswanderung würde auch gut zu früheren genetischen Analysen passen, gemäss denen Homo-sapiens-Gruppen vor rund 220 000 Jahren aus Ostafrika in Richtung des Nahen Ostens ausgewandert sind."
                                            },
                                            {
                                                "example_id": "c2afdcfc-1efb-4be2-81d9-c44e4ba8f9ee",
                                                "sense_id": "3dd53847-35eb-3384-a8a3-bf98b45af283",
                                                "text": "„Das 19. Jahrhundert war die Zeit der großen europäischen Auswanderung nach Übersee.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
