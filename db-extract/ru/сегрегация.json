                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "5dcf5f8b-5f4b-3218-869a-f5beff1fc2b3",
                                        "entry_id": "4e8eaa82-c75c-3ada-b572-9a0449f55fb8",
                                        "glosses": [
                                            "oddzielenie w ramach jednego państwa grup ludzi, ze względu na ich rasę lub religię"
                                        ],
                                        "tags": [
                                            "np."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d628c79-9200-47da-b5c0-a68efccf6896",
                                                "sense_id": "5dcf5f8b-5f4b-3218-869a-f5beff1fc2b3",
                                                "text": "Zwieńczeniem tego systemu segregacji – wyprzedzającego apartheid, a nawet rasowe ustawy w hitlerowskich Niemczech – było wprowadzenie przez Belgów specjalnych paszportów, zawierających informację o przynależności do Tutsi lub Hutu"
