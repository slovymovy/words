                        "source_sense_id": "4c958b22-6509-3308-a0eb-fd37dbe3c980",
                        "target_lang_word": "sergent",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sergent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "70ea4fc4-b3ea-3556-8316-009b6453ab7a",
                                        "entry_id": "29b89798-5467-375c-9069-f449710fbfb3",
                                        "glosses": [
                                            "Officier de justice qui remplissait les fonctions d’un huissier d’aujourd’hui et qui était chargé d’arrêter ceux contre lesquels il y avait contrainte par corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52035400-14e3-45d1-9561-871aaef12c73",
                                                "sense_id": "70ea4fc4-b3ea-3556-8316-009b6453ab7a",
                                                "text": "Sergent à verge."
                                            },
                                            {
                                                "example_id": "2c9344fc-f3e1-4c40-b10b-315a5e1ff946",
                                                "sense_id": "70ea4fc4-b3ea-3556-8316-009b6453ab7a",
                                                "text": "S’il ne me paie, je lui enverrai un sergent, le sergent."
                                            },
                                            {
                                                "example_id": "2df2bbd1-fde7-4c1d-8330-19b587df1f0d",
                                                "sense_id": "70ea4fc4-b3ea-3556-8316-009b6453ab7a",
                                                "text": "Les sergents le tenaient au collet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1f8a257-f7a6-3f48-afc5-e48ac3d7c1c6",
                                        "entry_id": "29b89798-5467-375c-9069-f449710fbfb3",
                                        "glosses": [
                                            "Policier des villes médiévales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f499d392-7f5c-495a-814e-1b65b952b43a",
                                                "sense_id": "c1f8a257-f7a6-3f48-afc5-e48ac3d7c1c6",
                                                "text": "Un soir, au moment où le couvre-feu sonnait à tous les beffrois de Paris, les sergents du guet, s’il leur eût été donné d’entrer dans la redoutable cour des Miracles, auraient pu remarquer qu’il se faisait dans la taverne des truands […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cac064ec-f373-31bc-ac5a-63d7d52453a9",
                                        "entry_id": "29b89798-5467-375c-9069-f449710fbfb3",
                                        "glosses": [
                                            "Grade sous-officier dans certaines administrations publiques (armées, douanes, pompiers…)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c267c8c-9b3e-419b-91a5-984e5480d1e1",
                                                "sense_id": "cac064ec-f373-31bc-ac5a-63d7d52453a9",
                                                "text": "Le grade de sergent."
                                            },
                                            {
                                                "example_id": "8b405ce8-e4ec-4180-8b4e-72e3070045c5",
                                                "sense_id": "cac064ec-f373-31bc-ac5a-63d7d52453a9",
                                                "text": "Sergent des douanes, sergent des pompiers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa4d2788-bc2e-3d34-8752-6058a777a5fb",
                                        "entry_id": "29b89798-5467-375c-9069-f449710fbfb3",
                                        "glosses": [
                                            "Grade donné à un sous-officier dans l’armée de terre et l’armée de l’air françaises, situé entre son supérieur hiérarchique, le sergent-chef, et son subordonné, le caporal-chef. Le code OTAN : OR-5."
                                        ],
                                        "tags": [
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2e55096-4003-416c-bd76-62b162ddd4dc",
                                                "sense_id": "fa4d2788-bc2e-3d34-8752-6058a777a5fb",
                                                "text": "A-t-on le droit de mentir, quand on est sergent ? Certainement non. La preuve : le sergent Bobillot."
                                            },
                                            {
                                                "example_id": "32ca9e5e-a6cc-485a-8b3f-bdaa877ca089",
                                                "sense_id": "fa4d2788-bc2e-3d34-8752-6058a777a5fb",
                                                "text": "Devant lui le sergent Bellazzi, les cheveux en bataille et les yeux pleins de sommeil, alluma une allumette-bougie et la haussa pour éclairer l'intérieur : […]."
                                            },
                                            {
                                                "example_id": "d26af1d0-f73f-414a-895d-4371c4a03db1",
                                                "sense_id": "fa4d2788-bc2e-3d34-8752-6058a777a5fb",
                                                "text": "— Mais, chef ! C'est la meilleure infirmière du régiment ! Comment pouvez-vous la traiter de la sorte ?\n— Vos gueules, répondit le sergent, ou je vous descends sur le quai. Vous n'aurez qu'à attendre le train suivant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "785d6bdc-edd4-3fc4-839d-48377cb8e9a9",
                                        "entry_id": "29b89798-5467-375c-9069-f449710fbfb3",
                                        "glosses": [
                                            "Grade des Forces armées canadiennes."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sergent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "63ea63e4-970f-328b-8c63-39d420f2874d",
