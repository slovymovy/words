                "forms": [],
                "senses": [
                    {
                        "sense_id": "9f58a9e0-6e68-3fbe-8695-cb1a44bbb689",
                        "entry_id": "9efc0ec0-a12b-347f-b7b4-e06e59069801",
                        "glosses": [
                            "Help, advice, counsel."
                        ],
                        "tags": [
                            "archaic",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "88ecac5d-d3fd-4fc2-87e7-8d3d1a936110",
                                "sense_id": "9f58a9e0-6e68-3fbe-8695-cb1a44bbb689",
                                "text": "Ophelia:\nDo not, as some ungracious pastors do,\nShow me the steep and thorny way to heaven,\nWhiles, like a puffed and reckless libertine,\nHimself the primrose path of dalliance treads,\nAnd recks not his own rede."
                            },
                            {
                                "example_id": "666c156e-b20e-48d9-aad6-1e670c937a7f",
                                "sense_id": "9f58a9e0-6e68-3fbe-8695-cb1a44bbb689",
                                "text": "When the Bull heard these words he knew the Ass to be his friend and thanked him, saying, \"Right is thy rede\""
                            },
                            {
                                "example_id": "c975902c-660f-49a7-bf52-495dc29f593d",
                                "sense_id": "9f58a9e0-6e68-3fbe-8695-cb1a44bbb689",
                                "text": "‘Yet do not cast all hope away. Tomorrow is unknown. Rede oft is found at the rising of the Sun.’"
                            }
                        ]
                    },
                    {
                        "sense_id": "464e92d7-5338-384a-a328-516e29c60374",
