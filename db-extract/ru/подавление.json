                                        "sense_id": "72fb6eee-7c36-37c8-8480-554fe2dbb883",
                                        "entry_id": "7b3ce917-034d-3fd5-894d-5a7352450e47",
                                        "glosses": [
                                            "Défense, prohibition. Il se joint presque toujours avec le mot « défense » et il est plus usité au pluriel qu’au singulier."
                                        ],
                                        "tags": [
                                            "Ancienne Jurisprudence"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce468b79-0876-44c4-9d01-2b7ddddb5569",
                                                "sense_id": "72fb6eee-7c36-37c8-8480-554fe2dbb883",
                                                "text": "Inhibitions et défenses sont faites à toutes personnes."
                                            },
                                            {
                                                "example_id": "3365c571-482a-47d7-af29-0c398dbe4bdd",
                                                "sense_id": "72fb6eee-7c36-37c8-8480-554fe2dbb883",
                                                "text": "L’arrêt, l’ordonnance portait inhibitions et défenses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2e99e4a-c5fe-3192-8d11-62bdeb2ad9d7",
                                        "entry_id": "7b3ce917-034d-3fd5-894d-5a7352450e47",
                                        "glosses": [
                                            "Action d’inhiber."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f4ac2a8-9b5b-4700-b05b-ef868511d81f",
                                                "sense_id": "e2e99e4a-c5fe-3192-8d11-62bdeb2ad9d7",
                                                "text": "Ce jour d’huy, fuyant l’Angleterre pour ne point partager le mauvais sort de Hardquanonne, nous avons, par timidité et crainte, à cause des inhibitions et fulminations pénales édictées en parlement, abandonné, à la nuit tombante, sur la côte de Portland, ledit enfant Gwynplaine, qui est lord Fermain Clancharlie."
                                            },
                                            {
                                                "example_id": "9b619d85-5800-47b2-b20e-2caeee4eab2c",
                                                "sense_id": "e2e99e4a-c5fe-3192-8d11-62bdeb2ad9d7",
                                                "text": "Il fallait songer à la possibilité de cette mort par inhibition."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
