{
    "word_family": [
        "berusting",
        "onberustend"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3163c5e1-5b33-3186-b838-5f81f328e560",
                    "sense_definition": "gebaseerd zijn op iets of een bepaalde basis hebben",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "basis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn conclusies <w>berusten</w> op langdurig onderzoek naar de klimaatverandering.",
                            "target_lang_translations": {
                                "en": "His conclusions <w>are based</w> on long-term research into climate change."
                            }
                        },
                        {
                            "text": "Het succes van het project <w>berust</w> op de samenwerking van het hele team.",
                            "target_lang_translations": {
                                "en": "The success of the project <w>rests</w> on the cooperation of the entire team."
                            }
                        }
                    ],
                    "common_phrases": [
                        "berusten op feiten",
                        "berusten op een misverstand",
                        "berusten op waarheid"
                    ],
                    "target_lang_definitions": {
                        "en": "To be based on something or to have a specific foundation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be based on",
                                "target_lang_sense_clarification": "to have something as a foundation"
                            },
                            {
                                "target_lang_word": "rest on",
                                "target_lang_sense_clarification": "to depend or be founded on something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b320b46b-9a91-33f3-a784-7a91ed36ed4c",
                    "sense_definition": "iets onaangenaams zonder verzet aanvaarden omdat je er niets aan kunt veranderen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "acceptatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de nederlaag leek de speler te <w>berusten</w> in zijn lot.",
                            "target_lang_translations": {
                                "en": "After the defeat, the player seemed to <w>resign himself</w> to his fate."
                            }
                        },
                        {
                            "text": "Zij kon niet anders dan <w>berusten</w> in de beslissing van de directie.",
                            "target_lang_translations": {
                                "en": "She had no choice but to <w>acquiesce</w> in the board's decision."
                            }
                        }
                    ],
                    "synonyms": [
                        "neerleggen",
                        "opgeven",
                        "pikken",
                        "slikken",
                        "zich schikken"
                    ],
                    "antonyms": [
                        "opstaan",
                        "zich verdedigen",
                        "zich verweren",
                        "zich verzetten"
                    ],
                    "common_phrases": [
                        "berusten in je lot",
                        "berusten in de situatie"
                    ],
                    "target_lang_definitions": {
                        "en": "To accept something unpleasant without resistance because you cannot change it."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "acquiesce",
                                "target_lang_sense_clarification": "to accept something reluctantly but without protest"
                            },
                            {
                                "target_lang_word": "resign oneself to",
                                "target_lang_sense_clarification": "to accept that something undesirable cannot be avoided"
                            },
                            {
                                "target_lang_word": "submit to",
                                "target_lang_sense_clarification": "to yield to a situation or fate"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dbee6460-1402-309b-988b-727ef11c1a54",
                    "sense_definition": "ondergebracht zijn bij een bepaalde instantie of persoon die de verantwoordelijkheid draagt",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "beheer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het recht om daarover te beslissen <w>berust</w> bij de raad van bestuur.",
                            "target_lang_translations": {
                                "en": "The right to decide on that <w>rests</w> with the board of directors."
                            }
                        },
                        {
                            "text": "De uiteindelijke verantwoordelijkheid voor de veiligheid <w>berust</w> bij de burgemeester.",
                            "target_lang_translations": {
                                "en": "The ultimate responsibility for safety <w>lies</w> with the mayor."
                            }
                        }
                    ],
                    "synonyms": [
                        "beheren"
                    ],
                    "common_phrases": [
                        "berusten bij de raad",
                        "de macht berust bij"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak gebruikt in formele of juridische context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To be held by or vested in a specific authority or person who bears responsibility."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rest with",
                                "target_lang_sense_clarification": "to be the responsibility of a person or group"
                            },
                            {
                                "target_lang_word": "lie with",
                                "target_lang_sense_clarification": "to be vested in or belong to someone"
                            },
                            {
                                "target_lang_word": "vest in",
                                "target_lang_sense_clarification": "to be legally given to a person or body"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}