                "senses": [
                    {
                        "sense_id": "5f74d21f-4abf-37a1-84ea-4791539f8083",
                        "entry_id": "d00843ac-03a5-3397-9599-47200c9b04df",
                        "glosses": [
                            "vorgebackene Pizza, die nach der Produktion zur besseren Haltbarkeit tiefgefroren wird und so in den Handel gelangt, um beim Endverbraucher schließlich zum Verzehr (etwa im Backofen) fertig gebacken zu werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "327193be-9401-44ab-abc5-8c02e8aa5899",
                                "sense_id": "5f74d21f-4abf-37a1-84ea-4791539f8083",
                                "text": "Morgen gibt es Tiefkühlpizza."
                            },
                            {
                                "example_id": "6dfcc468-601a-44b3-be34-46c29f136a07",
                                "sense_id": "5f74d21f-4abf-37a1-84ea-4791539f8083",
                                "text": "Wir führen eine große Auswahl an Tiefkühlpizzen aller namhaften Hersteller."
                            },
                            {
                                "example_id": "72ba5a9e-8103-448d-8d9a-c43b075e4763",
                                "sense_id": "5f74d21f-4abf-37a1-84ea-4791539f8083",
                                "text": "Soll ich für die Party noch ein paar Tiefkühlpizzas besorgen?"
                            },
                            {
                                "example_id": "7276a412-ff1b-4e6f-b385-cae087c213af",
                                "sense_id": "5f74d21f-4abf-37a1-84ea-4791539f8083",
                                "text": "Wenn keiner Lust hat, zu kochen, essen wir meistens Tiefkühlpizza."
                            }
                        ],
                        "sense_index_json": "\"1\""
