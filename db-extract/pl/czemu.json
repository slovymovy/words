                                            {
                                                "example_id": "82b07dfe-7524-4229-b136-6f364fd2af08",
                                                "sense_id": "b56f49d5-7c8e-33dc-bdcb-495a2e265aa3",
                                                "text": "Weshalb machst Du so ein trauriges Gesicht?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "100ca17b-3fcf-3735-a240-86db71440f55",
                                        "entry_id": "eeab9db1-843f-36b6-927c-44de6469411d",
                                        "glosses": [
                                            "leitet indirekte Frage nach dem Grund ein"
                                        ],
                                        "tags": [
                                            "Relativadverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f69447b6-13a0-433c-b185-28290c260cdf",
                                                "sense_id": "100ca17b-3fcf-3735-a240-86db71440f55",
                                                "text": "Wir wissen nicht, weshalb Franz sich so entschieden hat."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "weshalb",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9c373c00-9934-30cc-88ed-5b940fe95d4d",
                                        "entry_id": "9dd83256-ab1a-3b1f-b8a3-b11e23145a54",
                                        "glosses": [
                                            "leitet einen Nebensatz ein, der eine Folge angibt"
                                        ],
                                        "tags": [
                                            "Subjunktion",
                                            "auch Relativadverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "430e7624-6ba4-4981-bfcf-964d16823170",
                                                "sense_id": "9c373c00-9934-30cc-88ed-5b940fe95d4d",
                                                "text": "Ich habe verschlafen, weshalb ich meinen Zug verpasst habe."
                                            },
                                            {
                                                "example_id": "3b2273f6-773a-46d6-90d5-641e382830a0",
                                                "sense_id": "9c373c00-9934-30cc-88ed-5b940fe95d4d",
                                                "text": "Er schrie sie an, weshalb sie das Zimmer verließ."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1879fd0-d50a-420c-b64d-813114aa1b42",
                        "source_entry_id": "bfdbe8c1-8c5d-3306-af54-5fd8eca88d45",
                        "source_sense_id": "0c962d73-4884-3268-a6b3-8955c7a75826",
                        "source_sense_description": "umgangssprachlich, interrogativ: warum, weshalb, wieso",
                        "target_lang_word": "wieso",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wieso",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "866663dd-b0de-3238-99d3-aa4637b752c8",
                                        "entry_id": "b8075ca2-9daa-3e45-9c4e-d78e89c795ac",
                                        "glosses": [
                                            "leitet eine indirekte Frage nach dem Grund ein"
                                        ],
                                        "tags": [
                                            "Interrogativadverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5073f7f-c3eb-4728-8ea0-5a9b645f82b6",
                                                "sense_id": "866663dd-b0de-3238-99d3-aa4637b752c8",
                                                "text": "Er fragte sie, wieso sie ihn geschlagen habe."
                                            },
                                            {
                                                "example_id": "25c5585f-ca2e-4aa4-b11d-93c18faa1a06",
                                                "sense_id": "866663dd-b0de-3238-99d3-aa4637b752c8",
                                                "text": "Sie wollte wissen, wieso er ihr gegenüber immer so aufbrausend sei."
                                            },
                                            {
                                                "example_id": "58f7368f-068f-4454-bc93-2585fce2a88c",
                                                "sense_id": "866663dd-b0de-3238-99d3-aa4637b752c8",
                                                "text": "„Ich frage Leute auf der Straße, in der U-Bahn, im Büro, alle woll'n Computer haben, keiner weiß genau wieso.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "48920f22-43a5-3235-bd3c-1fd5f46efad9",
                                        "entry_id": "b8075ca2-9daa-3e45-9c4e-d78e89c795ac",
                                        "glosses": [
                                            "leitet eine direkte Frage nach dem Grund ein"
                                        ],
                                        "tags": [
                                            "Interrogativadverb",
                                            "mit zweifelnder",
                                            "erstaunter Nuance"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23c3047f-30bc-43b8-b4c0-9783d7f03459",
                                                "sense_id": "48920f22-43a5-3235-bd3c-1fd5f46efad9",
                                                "text": "„Wieso sollte ich aufhören, wenn ich mich in guter Verfassung befinde?“"
                                            },
                                            {
                                                "example_id": "410ba2ab-d3bb-4198-96a5-a66d581de687",
                                                "sense_id": "48920f22-43a5-3235-bd3c-1fd5f46efad9",
                                                "text": "„Wieso ist er so schnell abgereist?“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fc183f07-58ea-3099-8aba-2e6ed607169a",
                                        "entry_id": "b8075ca2-9daa-3e45-9c4e-d78e89c795ac",
                                        "glosses": [
                                            "leitet einen Nebensatz ein, der einen Grund für etwas angibt"
                                        ],
                                        "tags": [
                                            "Relativadverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6da77f44-a668-4a95-9567-19e3ec53130c",
                                                "sense_id": "fc183f07-58ea-3099-8aba-2e6ed607169a",
                                                "text": "Die Frage, wieso das passieren konnte, steht immer noch unbeantwortet im Raum."
                                            },
                                            {
                                                "example_id": "a03a9e9a-b944-45a6-9c99-13ef60b15257",
                                                "sense_id": "fc183f07-58ea-3099-8aba-2e6ed607169a",
                                                "text": "Der Gedanke, wieso sie so spät gekommen war, ging ihm nicht mehr aus dem Kopf."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "2e01e187-ec70-3c60-836e-59079349f6e2",
                                        "entry_id": "b8075ca2-9daa-3e45-9c4e-d78e89c795ac",
                                        "glosses": [
                                            "wie kommst du darauf?"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edf3952b-9196-49d0-a6b8-810a7ef89c13",
                                                "sense_id": "2e01e187-ec70-3c60-836e-59079349f6e2",
                                                "text": "„Bist du sauer?“ - „Wieso?“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    }
