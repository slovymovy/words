                "senses": [
                    {
                        "sense_id": "60d10203-6629-35ec-b511-7c3c3c80f2e2",
                        "entry_id": "e3446dcb-61ba-3f7a-b0bd-87abfcd015c4",
                        "glosses": [
                            "lijkend op een standbeeld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "371482c7-620d-4279-8a4e-3135366c9588",
                                "sense_id": "60d10203-6629-35ec-b511-7c3c3c80f2e2",
                                "text": "Als eerste zijn daar de Hollywood-actrices; lange tijd hét toonbeeld van hoe een droomvrouw eruit zou moeten zien: statuesk als Nicole Kidman, voluptueus als Scarlett Johansson, atletisch als Gal Gadot. Allemaal winnaressen van de genetische loterij, maar onhaalbaar voor de gewone sterveling."
                            },
                            {
                                "example_id": "e3855a66-294f-48b6-a98f-de69eb8d4104",
                                "sense_id": "60d10203-6629-35ec-b511-7c3c3c80f2e2",
                                "text": "Zijn statueske houding zorgt ervoor dat je hem makkelijk voor een standbeeld zou kunnen nemen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a0e82a2-7ba3-4994-a328-94bf99bd8375",
                        "source_entry_id": "e3446dcb-61ba-3f7a-b0bd-87abfcd015c4",
                        "source_sense_id": "60d10203-6629-35ec-b511-7c3c3c80f2e2",
                        "source_sense_description": "lijkend op een standbeeld",
                        "target_lang_word": "statuesque",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "statuesque",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a7d2d8d-7a89-33ff-ab4d-ca540f1acc27",
                                        "entry_id": "5cacc618-0d49-368a-bc53-743bc4e60ce6",
                                        "glosses": [
                                            "Resembling or characteristic of a statue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d34614a-216f-451a-a0cb-4543e8254453",
                                                "sense_id": "7a7d2d8d-7a89-33ff-ab4d-ca540f1acc27",
                                                "text": "He was by no means a bad hero to look at, if such a thing were needed. His face was pale, melancholy, statuesque—and his large enthusiastic eyes, suggested a story and a secret—perhaps a horror."
                                            },
                                            {
                                                "example_id": "61c9bde0-e981-457b-bf17-868834b9aacf",
                                                "sense_id": "7a7d2d8d-7a89-33ff-ab4d-ca540f1acc27",
                                                "text": "We went out by his gate into the road, and there we made a minute examination of the statuesque passing traffic. The tops of the wheels and some of the legs of the horses of this char-a-banc, the end of the whip-lash and the lower jaw of the conductor — who was just beginning to yawn — were perceptibly in motion, but all the rest of the lumbering conveyance seemed still."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1db649b8-43f2-3f0f-bf71-af4bdabea9de",
                                        "entry_id": "5cacc618-0d49-368a-bc53-743bc4e60ce6",
                                        "glosses": [
                                            "Elegantly tall, graceful, and attractive."
                                        ],
                                        "tags": [
                                            "of a woman"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ab57dfc-828c-481b-989d-c8f98c7b4ae1",
                                                "sense_id": "1db649b8-43f2-3f0f-bf71-af4bdabea9de",
                                                "text": "Christy Turlington is a statuesque supermodel famous for her fashion ads."
                                            },
                                            {
                                                "example_id": "ed1fd3a0-31f1-4b2f-b931-0fa35c3976a9",
                                                "sense_id": "1db649b8-43f2-3f0f-bf71-af4bdabea9de",
                                                "text": "The grand, handsome, and much younger Mrs. Nettles, […] has the nose and cheekbones of a Cherokee and is so black and statuesque in her muscularity and boneyness that she seems carved by an ax from an effulgent vein of coal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
