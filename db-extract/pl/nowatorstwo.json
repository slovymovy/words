                "translations": [
                    {
                        "translation_id": "e0432e72-04b1-4998-93b0-217e2e19c1e3",
                        "source_entry_id": "ee86af46-881d-32b3-b847-9d34dd9a0a0f",
                        "source_sense_id": "6e973de7-9d49-35d2-9e67-d9e328975b09",
                        "target_lang_word": "innovation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "innovation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1defeefa-d970-3e78-aeb3-f427413ccb63",
                                        "entry_id": "1d7708fd-afa5-33f2-98ce-aefae1c9a395",
                                        "glosses": [
                                            "The act of innovating; the introduction of something new, in customs, rites, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c42cf61-eeea-481e-a482-198da0935f57",
                                                "sense_id": "1defeefa-d970-3e78-aeb3-f427413ccb63",
                                                "text": "The US supreme court has ruled unanimously that natural human genes cannot be patented, a decision that scientists and civil rights campaigners said removed a major barrier to patient care and medical innovation."
                                            },
                                            {
                                                "example_id": "c95c16b8-ec7e-422b-b75b-b8aa1f66caeb",
                                                "sense_id": "1defeefa-d970-3e78-aeb3-f427413ccb63",
                                                "text": "Innovation is more than a new method. It is a new view of the universe, as one of risk rather than of chance or of certainty. It is a new view of man's role in the universe; he creates order by taking risks. And this means that innovation, rather than being an assertion of human power, is an acceptance of human responsibility."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ae10a1f-7328-3eb3-93ac-bb140a8b58c8",
                                        "entry_id": "1d7708fd-afa5-33f2-98ce-aefae1c9a395",
                                        "glosses": [
                                            "A change effected by innovating; a change in customs"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05e9ff7a-0fc7-4857-9065-22b59cfa8e2a",
                                                "sense_id": "1ae10a1f-7328-3eb3-93ac-bb140a8b58c8",
                                                "text": "The others, whose time had been more actively employed, began to shew symptoms of innovation,—\"the good wine did its good office.\" The frost of etiquette, and pride of birth, began to give way before the genial blessings of this benign constellation, and the formal appellatives with which the three dignitaries had hitherto addressed each other, were now familiarly abbreviated into Tully, Bally, and Killie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb3f3455-73ca-34e9-b76f-7ac840ae3f4d",
                                        "entry_id": "1d7708fd-afa5-33f2-98ce-aefae1c9a395",
                                        "glosses": [
                                            "Something new, and contrary to established customs, manners, or rites."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "113f429b-517f-3de6-9cea-3fa36f54c1e5",
                                        "entry_id": "1d7708fd-afa5-33f2-98ce-aefae1c9a395",
                                        "glosses": [
                                            "A newly formed shoot, or the annually produced addition to the stems of many mosses."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
