                ],
                "translations": [
                    {
                        "translation_id": "3911974f-1f19-446f-b164-38f082eb1347",
                        "source_entry_id": "7aec0acb-1d6f-3524-b87b-5557c7160f4d",
                        "source_sense_description": "пропа́сть, исчезнуть, оказаться в неизвестном месте",
                        "target_lang_word": "get lost",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "get lost",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2db89de1-a42c-370a-926d-3a404f100748",
                                        "entry_id": "6fc6ecdd-2535-389c-aafa-21614f7e04ab",
                                        "glosses": [
                                            "Used to rudely tell somebody to go away or leave one alone."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "impolite"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "get lost",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "463fbc82-320a-30de-b07b-6a967e757dd5",
                                        "entry_id": "9cf0fb3c-8afa-3927-b9cf-1d49011c720c",
                                        "glosses": [
                                            "To lose one's way."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f2c442c-5259-4d72-9e4e-8109ab84d037",
                                                "sense_id": "463fbc82-320a-30de-b07b-6a967e757dd5",
                                                "text": "Don't you have a map? How did we get lost?"
                                            },
                                            {
                                                "example_id": "a77828cd-8144-4d3c-90a6-7f254c4d307b",
                                                "sense_id": "463fbc82-320a-30de-b07b-6a967e757dd5",
                                                "text": "I got lost in his reasoning."
                                            },
                                            {
                                                "example_id": "aaef4327-f9c6-43b5-a80a-edcbb546320a",
                                                "sense_id": "463fbc82-320a-30de-b07b-6a967e757dd5",
                                                "text": "\"But the Civil Aviation Authority is very worried about 'flyaway' - if someone has bought a GPS jammer on eBay because they don't want drones near their house, it can cause drones to get completely lost and shoot off in a random direction until they run out of battery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7af12309-29af-3d52-a32d-e10296abdba1",
                                        "entry_id": "9cf0fb3c-8afa-3927-b9cf-1d49011c720c",
                                        "glosses": [
                                            "To go missing; to be in a location unknown to someone who is looking for it."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83ec17ce-8704-4a6e-8a0d-e1f4cf139aa3",
                                                "sense_id": "7af12309-29af-3d52-a32d-e10296abdba1",
                                                "text": "My keys got lost while I was out today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e35b2341-8910-3597-94d1-7f56635800d3",
                                        "entry_id": "9cf0fb3c-8afa-3927-b9cf-1d49011c720c",
                                        "glosses": [
                                            "To be absent, to seem to be absent."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0b993aa-da09-454f-8398-a1ce5d9dec3a",
                                                "sense_id": "e35b2341-8910-3597-94d1-7f56635800d3",
                                                "text": "The violins get lost with the rest of the music."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f10fbd5e-dd5a-3c79-b4c4-ad5f49715516",
                                        "entry_id": "9cf0fb3c-8afa-3927-b9cf-1d49011c720c",
                                        "glosses": [
                                            "To exit from the scene."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21440b7d-77ff-4c74-84fd-48a123f8ab42",
                                                "sense_id": "f10fbd5e-dd5a-3c79-b4c4-ad5f49715516",
                                                "text": "I don't want to have to tell you again: Get lost!"
                                            },
                                            {
                                                "example_id": "af0e9a58-00cb-47c2-929c-5ec8977e2cbf",
                                                "sense_id": "f10fbd5e-dd5a-3c79-b4c4-ad5f49715516",
                                                "text": "They had a row and Fred told Jack to get lost."
                                            },
                                            {
                                                "example_id": "adc15df0-8cc8-48b9-adfb-ab43042bc7e5",
                                                "sense_id": "f10fbd5e-dd5a-3c79-b4c4-ad5f49715516",
                                                "text": "Jack did a good job of getting lost: nobody saw him for 4 years."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5390af0-74f8-4859-b7d1-eb035564a920",
                        "source_entry_id": "7aec0acb-1d6f-3524-b87b-5557c7160f4d",
                        "source_sense_description": "пропа́сть, исчезнуть, оказаться в неизвестном месте",
                        "target_lang_word": "se perdre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "se perdre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cd90a3a1-7c4b-3e13-8190-3114049a494d",
                                        "entry_id": "f7a272e2-ccf3-3de1-bb7f-d5c9032e8677",
                                        "glosses": [
                                            "Faire naufrage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92c80f8c-507d-4b2d-96c7-45d4c5312cf6",
                                                "sense_id": "cd90a3a1-7c4b-3e13-8190-3114049a494d",
                                                "text": "Dès le second jour de notre traversée, nous arrivâmes en vue des Orcades. […]. Dans ces parages se sont perdus des milliers de navires, au nombre desquels on compte les vaisseaux de l’Invincible Armada."
                                            },
                                            {
                                                "example_id": "629b0aa5-4de7-4ea1-966e-e73b0344919a",
                                                "sense_id": "cd90a3a1-7c4b-3e13-8190-3114049a494d",
                                                "text": "À 2 milles dans l’est-nord-est se trouverait une roche couverte de 2 mètres d’eau, désignée sous le nom de Helen, porté par un brigantin de Dundee qui s’y perdit le 19 avril 1824 : […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97ce6ad5-8c9e-3664-a3c7-4436354a12eb",
                                        "entry_id": "f7a272e2-ccf3-3de1-bb7f-d5c9032e8677",
                                        "glosses": [
                                            "Disparaître."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6d4cbaa-b18e-4534-87aa-7db4432abf52",
                                                "sense_id": "97ce6ad5-8c9e-3664-a3c7-4436354a12eb",
                                                "text": "Le paysage était d'une indicible grandeur. De tous côtés surgissaient des montagnes plongeant à pic dans la mer, tandis que leurs cimes neigeuses se perdaient dans les nuages; […]."
                                            },
                                            {
                                                "example_id": "0edb987c-b4ea-4bc6-b7d2-08d0682d21ff",
                                                "sense_id": "97ce6ad5-8c9e-3664-a3c7-4436354a12eb",
                                                "text": "Ils quittèrent la maison par la porte de derrière et s’engagèrent dans une petite allée bordée de troènes qui se perdait un peu plus loin entre des ormes et des sycomores."
                                            },
                                            {
                                                "example_id": "0b8ce3a2-c680-4693-803d-ffbc86852955",
                                                "sense_id": "97ce6ad5-8c9e-3664-a3c7-4436354a12eb",
                                                "text": "D'autres se perdront, exilés de nulle part, s’oublieront dans un anonymat total, sous un faux nom. Anonymes même dans la mort, parfois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a90d705-fcbe-3f91-b759-fa7159c377fb",
                                        "entry_id": "f7a272e2-ccf3-3de1-bb7f-d5c9032e8677",
                                        "glosses": [
                                            "S’égarer ; errer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aba5db8a-2585-4648-a8e3-fe81e8b03e2b",
                                                "sense_id": "3a90d705-fcbe-3f91-b759-fa7159c377fb",
                                                "text": "Achevons de nous mêler aux soixante mille habitants que renferme actuellement la capitale géorgienne. Perdons-nous à travers le labyrinthe de ses rues, au milieu de sa population cosmopolite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c23d1ba8-6a5c-3e46-970a-5773fd59b096",
                                        "entry_id": "f7a272e2-ccf3-3de1-bb7f-d5c9032e8677",
                                        "glosses": [
                                            "Se dissiper ; s'évaporer."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0462e53-6a77-4123-aced-a33026223d0c",
                                                "sense_id": "c23d1ba8-6a5c-3e46-970a-5773fd59b096",
                                                "text": "Le parfum de cette liqueur, de cette essence s’est perdu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cfaca28-e4ef-37c9-8a60-644e34cfb99c",
                                        "entry_id": "f7a272e2-ccf3-3de1-bb7f-d5c9032e8677",
                                        "glosses": [
                                            "Passer, s'effacer, s'atténuer insensiblement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db67b03d-621b-4f3e-8f10-54722ef5e147",
                                                "sense_id": "3cfaca28-e4ef-37c9-8a60-644e34cfb99c",
                                                "text": "Ces couleurs, ces nuances se perdent l’une dans l’autre."
                                            },
                                            {
                                                "example_id": "84c00e26-4563-445b-a284-bcdfcc3ba85c",
                                                "sense_id": "3cfaca28-e4ef-37c9-8a60-644e34cfb99c",
                                                "text": "Depuis la mort de son mari, elle travaillait si tard, que sa vue se perdait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da8a7fdb-631b-3e6f-9526-48419a374dc5",
                                        "entry_id": "f7a272e2-ccf3-3de1-bb7f-d5c9032e8677",
                                        "glosses": [
                                            "S’enfoncer en terre, y disparaître ; se jeter dans un confluent, en parlant de cours d’eau."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3faa9acc-248f-4c46-a056-f4e5ad25d61e",
                                                "sense_id": "da8a7fdb-631b-3e6f-9526-48419a374dc5",
                                                "text": "L’oued En-Nedja coule à nos pieds dans un ravin verdoyant et se perd dans un paysage rocheux au Sud-Ouest."
                                            },
                                            {
                                                "example_id": "98d774cb-c3cf-4a7d-9220-4679f1782170",
                                                "sense_id": "da8a7fdb-631b-3e6f-9526-48419a374dc5",
                                                "text": "Cette rivière se perd, va se perdre dans telle autre, dans un lac."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f49290e-8d6c-3f54-899a-a2ebce4221bb",
                                        "entry_id": "f7a272e2-ccf3-3de1-bb7f-d5c9032e8677",
                                        "glosses": [
                                            "Cesser d’être frayé, en parlant d'un chemin."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72ca95bf-ce57-4eec-bcc6-fde6bb0c1fb5",
                                                "sense_id": "1f49290e-8d6c-3f54-899a-a2ebce4221bb",
                                                "text": "Le sentier se perd dans les rochers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90dfd594-b106-3638-aac4-a1eef1f3dfe7",
                                        "entry_id": "f7a272e2-ccf3-3de1-bb7f-d5c9032e8677",
                                        "glosses": [
                                            "Cesser d'être pratiqué, d'être utilisé."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e66b41fe-bcaa-4d60-ab5d-fd4c74c19fb3",
                                                "sense_id": "90dfd594-b106-3638-aac4-a1eef1f3dfe7",
                                                "text": "Cet usage se perd de jour en jour."
                                            },
                                            {
                                                "example_id": "b39a6dd4-4e88-416f-8f1c-4d850485f52e",
                                                "sense_id": "90dfd594-b106-3638-aac4-a1eef1f3dfe7",
                                                "text": "Ce mot s’est perdu, cette acception du mot s’est perdue."
                                            },
                                            {
                                                "example_id": "b804c287-5a34-4f88-8b62-924ebfebb8b0",
                                                "sense_id": "90dfd594-b106-3638-aac4-a1eef1f3dfe7",
                                                "text": "Il y a des claques qui se perdent !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dab11af6-7e96-39e9-a0c1-43fef51f64ea",
                                        "entry_id": "f7a272e2-ccf3-3de1-bb7f-d5c9032e8677",
                                        "glosses": [
                                            "Se damner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac9ce87e-0476-4396-b9a2-7bf6b0ed6b63",
                                                "sense_id": "dab11af6-7e96-39e9-a0c1-43fef51f64ea",
                                                "text": "Beaucoup de pécheurs se perdent par gourmandise et par luxure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
