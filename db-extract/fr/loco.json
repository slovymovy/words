                    {
                        "sense_id": "791686e3-5530-3b9c-b61d-cd5f71cfd0f7",
                        "entry_id": "9942266b-6db1-3f43-9758-4ac410f19bb7",
                        "glosses": [
                            "Locomotive."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "875fe7c6-bcae-4a63-9ebe-a64e19deca68",
                                "sense_id": "791686e3-5530-3b9c-b61d-cd5f71cfd0f7",
                                "text": "Un léger coup de lime pour enlever une bavure, un soupçon d’antirouille orangée que l’on nomme minium, deux petits pas de recul façon Vélasquez contemplant ses Ménines, les bruits des locos comme fond sonore, alors elle est pas belle la vie ?"
                            },
                            {
                                "example_id": "bf7c3f30-1e7c-4aba-a19c-cd5a03d1ed64",
                                "sense_id": "791686e3-5530-3b9c-b61d-cd5f71cfd0f7",
                                "text": "Mal au bras. Manque de souffle. Et l'autre qui respire comme une loco."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "870f6b0f-3d54-4bd9-822a-c326473c5d56",
                        "source_entry_id": "9942266b-6db1-3f43-9758-4ac410f19bb7",
                        "source_sense_id": "791686e3-5530-3b9c-b61d-cd5f71cfd0f7",
