{
    "word_family": [
        "rage",
        "enragement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e6df80dd-d554-34d7-ae65-b5a0bfe8e2e5",
                    "sense_definition": "To make someone extremely angry or furious.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The decision to close the local library will <w>enrage</w> the entire community.",
                            "target_lang_translations": {
                                "ru": "Решение закрыть местную библиотеку <w>разъярит</w> всю общественность.",
                                "zh": "关闭当地图书馆的决定将会<w>激怒</w>整个社区。"
                            }
                        },
                        {
                            "text": "His constant lies and excuses <w>enrage</w> his parents every time they talk.",
                            "target_lang_translations": {
                                "ru": "Его постоянная ложь и оправдания <w>бесят</w> родителей каждый раз, когда они разговаривают.",
                                "zh": "他不断的谎言和借口每次谈话都会<w>激怒</w>他的父母。"
                            }
                        }
                    ],
                    "synonyms": [
                        "infuriate",
                        "incense",
                        "madden",
                        "outrage"
                    ],
                    "antonyms": [
                        "calm",
                        "pacify",
                        "placate",
                        "soothe",
                        "mollify"
                    ],
                    "common_phrases": [
                        "enrage the public",
                        "enrage the crowd"
                    ],
                    "target_lang_definitions": {
                        "ru": "Привести кого-либо в состояние крайнего гнева, ярости или бешенства.",
                        "zh": "使某人极其愤怒或狂怒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разъярить",
                                "target_lang_sense_clarification": "вызвать сильную ярость"
                            },
                            {
                                "target_lang_word": "взбесить",
                                "target_lang_sense_clarification": "довести до бешенства"
                            },
                            {
                                "target_lang_word": "привести в ярость",
                                "target_lang_sense_clarification": "сделать крайне злым"
                            },
                            {
                                "target_lang_word": "разгневать",
                                "target_lang_sense_clarification": "вызвать сильное негодование"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "激怒",
                                "target_lang_sense_clarification": "使人产生强烈的愤怒"
                            },
                            {
                                "target_lang_word": "惹恼",
                                "target_lang_sense_clarification": "使人感到非常生气"
                            },
                            {
                                "target_lang_word": "使……暴跳如雷",
                                "target_lang_sense_clarification": "形容极度愤怒的状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67463e6b-9359-38b8-a4bd-896b9eb120df",
                    "sense_definition": "To become wild or lose control due to intense anger.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "anger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The animal began to <w>enrage</w> when it felt cornered by the hunters.",
                            "target_lang_translations": {
                                "ru": "Животное начало <w>разъяряться</w>, когда почувствовало себя загнанным охотниками в угол.",
                                "zh": "当那只动物感到被猎人逼入绝境时，它开始<w>暴怒</w>起来。"
                            }
                        },
                        {
                            "text": "He seemed to <w>enrage</w> further as the argument continued without resolution.",
                            "target_lang_translations": {
                                "ru": "Казалось, он <w>приходил в еще большую ярость</w> по мере того, как спор продолжался без какого-либо решения.",
                                "zh": "随着争论持续且没有结果，他似乎变得更加<w>狂怒</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flare up"
                    ],
                    "antonyms": [
                        "calm",
                        "quiet",
                        "settle"
                    ],
                    "common_phrases": [
                        "begin to enrage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прийти в неистовство или потерять контроль над собой из-за сильного гнева.",
                        "zh": "因极度愤怒而变得狂暴或失去控制。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разъяриться",
                                "target_lang_sense_clarification": "прийти в состояние ярости"
                            },
                            {
                                "target_lang_word": "взбеситься",
                                "target_lang_sense_clarification": "потерять контроль от злости"
                            },
                            {
                                "target_lang_word": "прийти в ярость",
                                "target_lang_sense_clarification": "сильно разозлиться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "暴怒",
                                "target_lang_sense_clarification": "变得非常愤怒"
                            },
                            {
                                "target_lang_word": "狂怒",
                                "target_lang_sense_clarification": "失去理智的愤怒"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "107c24f8-a5d4-3732-8940-284436028893",
                    "sense_definition": "To drive someone to a state of madness or temporary insanity through provocation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "madness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant questioning will <w>enrage</w> him until he loses his mind completely.",
                            "target_lang_translations": {
                                "ru": "Постоянные расспросы будут <w>бесить</w> его до тех пор, пока он окончательно не потеряет рассудок.",
                                "zh": "不断的质问会让他<w>发狂</w>，直到他彻底失去理智。"
                            }
                        },
                        {
                            "text": "In the play, the character's betrayal was enough to <w>enrage</w> the king to madness.",
                            "target_lang_translations": {
                                "ru": "В пьесе предательства персонажа было достаточно, чтобы <w>довести</w> короля <w>до безумной ярости</w>.",
                                "zh": "在剧中，那个角色的背叛足以让国王<w>发狂</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "madden"
                    ],
                    "antonyms": [
                        "soothe",
                        "comfort"
                    ],
                    "common_phrases": [
                        "enrage to madness"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in literary contexts to mean driving to madness"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Довести кого-либо до состояния безумия или временного помешательства путем провокации.",
                        "zh": "通过挑衅使某人陷入疯狂或暂时失去理智的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сводить с ума",
                                "target_lang_sense_clarification": "доводить до безумия гневом"
                            },
                            {
                                "target_lang_word": "разъярить",
                                "target_lang_sense_clarification": "довести до исступления"
                            },
                            {
                                "target_lang_word": "взбесить",
                                "target_lang_sense_clarification": "лишить рассудка от злости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "逼疯",
                                "target_lang_sense_clarification": "因愤怒而导致精神失常"
                            },
                            {
                                "target_lang_word": "使……发狂",
                                "target_lang_sense_clarification": "导致某人失去理智"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}