                                        "entry_id": "acc14d60-cbb8-3c45-b284-b429f758e437",
                                        "glosses": [
                                            "A Persian measure of distance, equivalent to about four miles."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c376772e-88f3-42d6-96c3-3e1d95ce9ef9",
                                                "sense_id": "65ca0a2b-20f6-350c-94cb-d46e085026f1",
                                                "text": "That dayes journey was foure farsangs."
