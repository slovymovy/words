                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a5281e20-6c0d-3c3a-a1df-9de7878c7238",
                                        "entry_id": "8a26401c-ebda-37f8-81e9-4386d2c73dc3",
                                        "glosses": [
                                            "Handwerker, der Schuhe herstellt oder repariert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0f136a4-8a1a-4a3d-95c3-ca96c41cedf9",
                                                "sense_id": "a5281e20-6c0d-3c3a-a1df-9de7878c7238",
                                                "text": "Morgen bringe ich meine Stiefel zum Schuster, weil beim linken Stiefel der Absatz locker ist."
                                            },
                                            {
                                                "example_id": "d6bbc3e4-c7a1-4581-8e5d-916b1bbe9b21",
                                                "sense_id": "a5281e20-6c0d-3c3a-a1df-9de7878c7238",
                                                "text": "„Es hat der Schuster Franz zum Dichter sich entzückt. / Was er als Schuster tat, das tut er noch: er flickt.“"
                                            },
                                            {
                                                "example_id": "f374038d-592c-43e0-be3b-b1cc6f344b66",
                                                "sense_id": "a5281e20-6c0d-3c3a-a1df-9de7878c7238",
                                                "text": "„Der Vater war Schuster und arbeitete den ganzen Tag; er sprach nie mit jemandem, nicht einmal bei Tisch.“"
                                            },
                                            {
                                                "example_id": "9fb62dfc-61eb-4a71-b83e-86e31317ef96",
                                                "sense_id": "a5281e20-6c0d-3c3a-a1df-9de7878c7238",
                                                "text": "„Die Vorstellung, dass ein Schuster nicht bei seinen Leisten blieb, sondern ins Rathaus lief, um politische Entscheidungen zu treffen, ist völlig abwegig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3536f766-767e-3995-998c-19277d65b4a1",
                                        "entry_id": "8a26401c-ebda-37f8-81e9-4386d2c73dc3",
                                        "glosses": [
                                            "Gliederfüßer mit langen Beinen wie zum Beispiel"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
