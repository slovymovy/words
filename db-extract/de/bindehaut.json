                "senses": [
                    {
                        "sense_id": "51180a47-d07f-342f-85c2-31345fc48f27",
                        "entry_id": "d86bceec-55d7-3aae-81b2-5e804eca68d0",
                        "glosses": [
                            "Schleimhaut im Auge als Verbindung zwischen Augapfel und Lid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22ef1cac-9b1f-4cfb-baee-e26744795968",
                                "sense_id": "51180a47-d07f-342f-85c2-31345fc48f27",
                                "text": "„Auch die Bindehaut des Auges und die Deckschicht der Eichel und der Klitoris sind Schleimhäute.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6fc2ab7-c073-40f6-af24-a4c26f8ce16c",
                        "source_entry_id": "d86bceec-55d7-3aae-81b2-5e804eca68d0",
                        "source_sense_id": "51180a47-d07f-342f-85c2-31345fc48f27",
                        "source_sense_description": "Anatomie: Schleimhaut im Auge als Verbindung zwischen Augapfel und Lid",
                        "target_lang_word": "conjunctiva",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conjunctiva",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "709720b4-335a-38ab-bfcf-beafaf7a856e",
                                        "entry_id": "9fcebccc-2872-34eb-b0d0-40e75c9531fb",
                                        "glosses": [
                                            "A clear mucous membrane that lines the inner surface of the eyelid and the exposed surface of the eyeball or sclera."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51992dc6-2ed9-4317-bbae-526b675deae6",
                                                "sense_id": "709720b4-335a-38ab-bfcf-beafaf7a856e",
                                                "text": "There is a third inner eyelid, highly developed and of beautiful mechanism: this is the nictitating membrane, or \"winker\" (nictito, I wink), a delicate, elastic, translucent, pearly-white fold of the conjunctiva. While the other lids move vertically and have a horizontal commissure, the winker sweeps horizontally or obliquely across the ball, from the side next the beak to the opposite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c28c4f0b-29c9-4caa-a15a-e76e6f54b5ae",
                        "source_entry_id": "d86bceec-55d7-3aae-81b2-5e804eca68d0",
                        "source_sense_id": "51180a47-d07f-342f-85c2-31345fc48f27",
                        "source_sense_description": "Anatomie: Schleimhaut im Auge als Verbindung zwischen Augapfel und Lid",
                        "target_lang_word": "conjonctive",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conjonctive",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "74923b33-3a4a-3160-94d5-c203ae2c9a05",
                                        "entry_id": "277e32b8-979b-3eae-a211-e41cc549a557",
                                        "glosses": [
                                            "Membrane muqueuse transparente qui tapisse l’intérieur des paupières et les unit au globe oculaire sur lequel elle se poursuit jusqu’à la cornée. Cette membrane produit le mucus qui tapisse et lubrifie la surface de l’œil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d97ec8c9-8e2f-41d6-aa9c-71d656c714c2",
                                                "sense_id": "74923b33-3a4a-3160-94d5-c203ae2c9a05",
                                                "text": "Le front était brûlant ; il y avait de la rougeur aux conjonctives ; la température de tout le corps était très haute."
                                            },
                                            {
                                                "example_id": "e8b08fb4-d597-4d6a-b500-f81282df4df2",
                                                "sense_id": "74923b33-3a4a-3160-94d5-c203ae2c9a05",
                                                "text": "Ces allergies, qui portent aussi le nom de conjonctivites allergiques car elles se manifestent par une inflammation de la conjonctive, sont de deux ordres : la forme saisonnière, la plus fréquente, et la forme permanente."
                                            },
                                            {
                                                "example_id": "afea5cac-4a1f-40e6-aeb9-e07aee647b8b",
                                                "sense_id": "74923b33-3a4a-3160-94d5-c203ae2c9a05",
                                                "text": "Le liquide lacrymal est aqueux et salé.\nIl s'écoule à la surface externe de la cornée et de la conjonctive de l'œil."
                                            },
                                            {
                                                "example_id": "9da7882e-b1eb-4940-83da-62facebc5d70",
                                                "sense_id": "74923b33-3a4a-3160-94d5-c203ae2c9a05",
                                                "text": "La conjonctivite est l’inflammation de la conjonctive."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "conjonctive",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "03716d96-443c-36e0-876b-c2ec1e7f6ad3",
                                        "entry_id": "4c5e83d5-e36b-37db-b924-e2f2fe72d73e",
                                        "glosses": [
                                            "Féminin singulier de conjonctif."
                                        ],
                                        "tags": [
