                    {
                        "translation_id": "d8d882c8-aafe-43d9-aaf7-13c024d84619",
                        "source_entry_id": "d2d18e70-c662-3f2b-92af-ce08e44e2ed9",
                        "source_sense_id": "d90aea8b-36fb-358e-954e-6ef2f1562c7c",
                        "target_lang_word": "forfait",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "forfait",
