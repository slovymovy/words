                ],
                "senses": [
                    {
                        "sense_id": "95bc197d-6171-33d5-84b9-42366fb7cb77",
                        "entry_id": "2e93f316-761e-35f4-9de6-96e68da85ed1",
                        "glosses": [
                            "durch das Geruchsorgan wahrgenommene Ausdünstung aus Kunststoff; subjektive Sinneswahrnehmung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c71b52b-ad46-4685-a917-df2f60a3212e",
                                "sense_id": "95bc197d-6171-33d5-84b9-42366fb7cb77",
                                "text": "„Dann, nach 3 bis 4 Kochgängen, war der Kunststoffgeruch gänzlich verflogen.“"
                            },
                            {
                                "example_id": "f6c9fc8e-a95d-4a81-9d31-d7bc5e296718",
                                "sense_id": "95bc197d-6171-33d5-84b9-42366fb7cb77",
                                "text": "„Verband man früher noch nur die klassischen Folien und den Kunststoffgeruch im Kochertal mit Hornschuch, so ist von der Geruchsbelästigung heute fast nichts mehr zu bemerken.“"
                            },
                            {
                                "example_id": "e44bf49d-e54d-45c5-a755-66cb1743831f",
                                "sense_id": "95bc197d-6171-33d5-84b9-42366fb7cb77",
                                "text": "„Bei qualitativ minderwertigen Mineralwassermarken, können Sie sogar einen typischen, unangenehmen Kunststoffgeruch und Kunststoffgeschmack wahrnehmen.“"
                            },
                            {
                                "example_id": "febc93f2-85ba-4351-afc8-bdc9d7723720",
                                "sense_id": "95bc197d-6171-33d5-84b9-42366fb7cb77",
                                "text": "„Ist viel Weichmacher enthalten, erkennt man ihn am typischen Kunststoffgeruch.“"
                            },
                            {
                                "example_id": "d43f2b92-c713-44e5-878f-4efa9e5c98c6",
                                "sense_id": "95bc197d-6171-33d5-84b9-42366fb7cb77",
                                "text": "„Beim Test dieser Komponenten durch die menschliche Nase zeigte sich, dass die störenden Bestandteile gleich auf mehrere chemische Verbindungen zurückzuführen sind - der Kunststoffgeruch kommt nicht allein vom Gleitmittel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
