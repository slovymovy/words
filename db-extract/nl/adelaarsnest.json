        "nl-extract.jsonl": [
            {
                "entry_id": "92934694-b755-3700-be18-ea208553ccff",
                "word": "Adelaarsnest",
                "pos": "name",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "837f1b4c-3f55-36b2-bf4a-a4cc26622238",
                        "entry_id": "92934694-b755-3700-be18-ea208553ccff",
                        "glosses": [
                            "gebruikt als benaming voor de buitenverblijven van de Duitse dictator Adolf Hitler op de Obersalzberg en in het bijzonder het Kehlsteinhaus op de Kehlstein, gebouwd nabij het plaatsje Berchtesgaden in Beieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d30f52f3-72ec-41a8-9cfc-463b1ebb5a0e",
                                "sense_id": "837f1b4c-3f55-36b2-bf4a-a4cc26622238",
                                "text": "Shames was het eerste lid van de compagnie dat vlak na de bevrijding concentratiekamp Dachau binnenging. Na de overgave van Duitsland trokken Shames en zijn mannen Hitlers Adelaarsnest in Zuid-Duitsland binnen, waar hij een paar flessen cognac wist te bemachtigen met het opschrift \"uitsluitend voor gebruik door de Führer\". Later gebruikte hij de cognac om te proosten op de bar mitswa (een Joodse ceremonie als een jongen 13 wordt) van zijn oudste zoon."
                            },
                            {
                                "example_id": "71171310-8aae-484c-9a6e-570193d8753e",
                                "sense_id": "837f1b4c-3f55-36b2-bf4a-a4cc26622238",
                                "text": "Een wandkleed dat ooit een muur in Hitlers Adelaarsnest sierde keert vandaag terug naar Beieren. Een Amerikaanse militair nam het aan het einde van de Tweede Wereldoorlog mee naar de VS, zijn dochter geeft het nu terug."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
