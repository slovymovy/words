                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "48a50f55-6f36-46dd-aff4-243391a9e03c",
                                "sense_id": "79b46004-349c-32b2-a070-433ff026e39a",
                                "text": "Only after the first explosions did the people of Folkestone notice the sound of engines beating the air. They hardly understood what they heard. They screamed “Zepps! Zepps!” for until then Zeppelin dirigibles had been the only mechanism of air attack they knew."
                            }
                        ]
                    },
                    {
                        "sense_id": "0bfae87b-e2dc-324a-8cb8-16faf2268872",
                        "entry_id": "2d1d776c-a1c5-38fe-815b-7f5d84c8e34b",
                        "glosses": [
                            "A Zeppelin stamp."
                        ],
                        "tags": [
