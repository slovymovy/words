                        "glosses": [
                            "Someone who digs tunnels, especially as a hobby."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73772aca-3f87-4a8c-81ab-507a5fc094b0",
                                "sense_id": "6b1df881-564a-307a-baf8-728a54e7db55",
                                "text": "The tunnelist showed me the cellar he'd dug beneath his house."
                            },
                            {
                                "example_id": "299371bc-14ac-47d3-8127-025d59d72adc",
                                "sense_id": "6b1df881-564a-307a-baf8-728a54e7db55",
                                "text": "Details about the backyard tunnel in Queensland revealed by Calgary police today are scarce — we know it was an alleged storehouse for stolen goods, and little else. But building a 30-foot tunnel is a huge amount of work, even more so if you're trying to keep it secret, as the famous Toronto tunnelist proved."
                            },
                            {
                                "example_id": "2ffd5c40-f4fc-4cae-9b66-f3015724acf7",
                                "sense_id": "6b1df881-564a-307a-baf8-728a54e7db55",
                                "text": "Spending hours heaving dirt and rocks from the ground might seem like an unusual pastime, but it has a history: Hobby tunnelists of yore include the Fifth Duke of Portland, who in the 19th century built an underground ballroom on his property, and, more recently, the so-called mole man of London, who spent 40 years making tunnels before he was discovered."
                            }
                        ]
