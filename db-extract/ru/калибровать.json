                "senses": [
                    {
                        "sense_id": "1c2d4756-00b2-372e-a16d-ddd2d77f6af6",
                        "entry_id": "3bbc208d-7f6d-3558-b29e-39bc9c427634",
                        "glosses": [
                            "спец. измерять калибр чего-либо"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "300cc22d-2901-359d-a583-95e0de5beec1",
                        "entry_id": "3bbc208d-7f6d-3558-b29e-39bc9c427634",
                        "glosses": [
                            "придавать чему-либо нужный калибр"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b70e9222-1291-471e-95b1-244fdf277210",
                                "sense_id": "300cc22d-2901-359d-a583-95e0de5beec1",
                                "text": "Особо аккуратные и старательные стрелки для надежности калибруют патроны, чтобы не перекосило, не заело при стрельбе…"
                            }
                        ]
                    },
                    {
                        "sense_id": "422caf03-5bd9-3506-afe2-2c6cc9c2ea01",
                        "entry_id": "3bbc208d-7f6d-3558-b29e-39bc9c427634",
                        "glosses": [
                            "сортировать по размеру на специальных машинах плоды, овощи и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ddda685-b46b-4b95-a900-91b5f9e822db",
                                "sense_id": "422caf03-5bd9-3506-afe2-2c6cc9c2ea01",
                                "text": "Этот способ хотя и прост, но имеет недостатки: клубни предварительно нужно калибровать по размеру, да и много мякоти попадает в отходы."
                            }
                        ]
                    },
                    {
                        "sense_id": "c412c501-c3d1-31e0-b997-cf91e5e98a60",
                        "entry_id": "3bbc208d-7f6d-3558-b29e-39bc9c427634",
                        "glosses": [
                            "устанавливать или проверять шкалу делений измерительного прибора"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32d7b4dc-c164-432b-820d-f8fd1d29003f",
                                "sense_id": "c412c501-c3d1-31e0-b997-cf91e5e98a60",
                                "text": "Последние, а также современные автоматические и полуавтоматические аппараты с дисплеями перед использованием калибруют по ртутной шкале и периодически проверяют."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "87198241-0ef8-4747-8f36-5f4e1bb4a5e6",
                        "source_entry_id": "3bbc208d-7f6d-3558-b29e-39bc9c427634",
                        "source_sense_description": "измерять калибр чего-либо",
                        "target_lang_word": "calibrate",
                        "target_lang_code": "en",
