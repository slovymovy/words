                ],
                "senses": [
                    {
                        "sense_id": "860b3bfc-ac25-30f3-8744-60706331e9f2",
                        "entry_id": "765decf5-964c-3ddf-9f73-5e4703c023a6",
                        "glosses": [
                            "Schrift, bei der die einzelnen Zeichen (Schriftzeichen) für Wörter stehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f2ffb95-348f-4d8c-9892-70ff51f665dd",
                                "sense_id": "860b3bfc-ac25-30f3-8744-60706331e9f2",
                                "text": "In einer Wortschrift steht ein Schriftzeichen (Logogramm) für ein Wort und nicht nur für einen Laut, wie das bei alphabetischen Schriften der Fall ist."
                            },
                            {
                                "example_id": "6dada91b-ee25-4b06-9d2e-87fa837f8885",
                                "sense_id": "860b3bfc-ac25-30f3-8744-60706331e9f2",
                                "text": "Im deutschen Schriftsystem gibt es einige Beispiele für Wortschrift: §, $, &…"
                            },
                            {
                                "example_id": "1d72a335-05c6-4ed8-95ed-58394b5c1574",
                                "sense_id": "860b3bfc-ac25-30f3-8744-60706331e9f2",
                                "text": "„Da Wörter in isolierenden Sprachen in allen Kontexten in der gleichen Form vorkommen, ist eine Wortschrift für solche Sprachen prinzipiell geeignet - besser geeignet jedenfalls als für agglutinierende oder flektierende Sprachen.“"
                            },
                            {
                                "example_id": "0cba1efc-def8-42c6-abfd-73829aa0e1cb",
                                "sense_id": "860b3bfc-ac25-30f3-8744-60706331e9f2",
                                "text": "„In dieser Reform hätte man dann phonetische und ideographische Zeichen getrennt und damit einerseits die alte Wortschrift wiederhergestellt, andererseits eine neue Silbenschrift geschaffen…“"
                            },
                            {
                                "example_id": "3bf5ca45-ed4e-4313-9e3e-cfdb6aa5288e",
                                "sense_id": "860b3bfc-ac25-30f3-8744-60706331e9f2",
                                "text": "„In dieser langen Zeit schrieb man nach dem Prinzip der Wortschrift, was aber nicht heißt, daß jedes Wort im Satz schriftlich festgehalten worden wäre.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
