                "senses": [
                    {
                        "sense_id": "d1c58463-91ef-38f1-a2e5-2cfac4603fd4",
                        "entry_id": "f39e8ab4-33f7-3279-9780-87982aea438d",
                        "glosses": [
                            "weibliche Person, die im Gefolge einer Armee als Händlerin mitzieht"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "e8749bd6-d625-426f-8729-887a737b2735",
                                "sense_id": "d1c58463-91ef-38f1-a2e5-2cfac4603fd4",
                                "text": "„Händler und Marketenderinnen schlugen ihre Stände auf und verkauften den Soldaten, was sie begehrten.“"
                            },
                            {
                                "example_id": "b52fbe85-a79b-42b5-9839-b271e36dbd46",
                                "sense_id": "d1c58463-91ef-38f1-a2e5-2cfac4603fd4",
                                "text": "„Man denkt beim Tross zuerst an die Marketenderin, die Mann küssen darf, wenn er den Kuss bezahlen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
