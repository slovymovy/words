                                "example_id": "36f21ed8-e398-4703-8d61-3f0ebe7afde8",
                                "sense_id": "266a63ce-7e31-3282-8ba6-51b4839a4fe1",
                                "text": "Mój stryjeczny dziadek ma na imię Melchior."
                            },
                            {
                                "example_id": "26ab9636-bfbb-4c0d-9942-70280f86db2f",
                                "sense_id": "266a63ce-7e31-3282-8ba6-51b4839a4fe1",
                                "text": "Melchiorowie dzień swego patrona, czyli imieniny, obchodzą 6 stycznia, a także 7 września."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
