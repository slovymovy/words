        "fr-extract.jsonl": [
            {
                "entry_id": "1fc05520-01b8-387a-b33f-808a21186d40",
                "word": "stratigraphie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "73ce9714-3517-41bf-a9de-81491f5c6ca4",
                        "entry_id": "1fc05520-01b8-387a-b33f-808a21186d40",
                        "tags": [
                            "plural"
                        ],
                        "form": "stratigraphies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f31186e3-fccc-35f5-807b-d1398ddd4d53",
                        "entry_id": "1fc05520-01b8-387a-b33f-808a21186d40",
                        "glosses": [
                            "Étude de la succession des dépôts sédimentaires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6299f56-7666-4a43-addb-5e2c51350414",
                                "sense_id": "f31186e3-fccc-35f5-807b-d1398ddd4d53",
                                "text": "On s’efforce, au cours des fouilles, de dégager chaque niveau, dans l’ordre inverse de sa formation, en suivant la stratigraphie naturelle, ce qui correspond rarement à l’établissement de tranches régulièrement horizontales."
                            }
                        ]
                    },
                    {
                        "sense_id": "0a0a15aa-a9df-320e-8094-687e5c6b4c22",
                        "entry_id": "1fc05520-01b8-387a-b33f-808a21186d40",
                        "glosses": [
                            "Étude des couches de terrain et de leur contenu afin d'établir des séquences chronologiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12a94ca0-e5c1-450a-a715-7c4512632740",
                                "sense_id": "0a0a15aa-a9df-320e-8094-687e5c6b4c22",
                                "text": "Cette œuvre réunit à elle seule le champ des possibles de la photographie, ainsi que les sujets essentiels à l’archéologie : chronologie, superposition des faits humains et stratigraphie des sols, occupation de l’espace et traces laissées dans le paysage."
                            },
                            {
                                "example_id": "cc1cfc32-47e1-45f1-832e-f42ced8c34c3",
                                "sense_id": "0a0a15aa-a9df-320e-8094-687e5c6b4c22",
                                "text": "Occupé sur plus de 6 000 ans, ce lieu [= Megiddo] n’est pas sans poser des problèmes de stratigraphie et de concordances historiques… allant jusqu’à déstabiliser - avec raison - la grande chronologie traditionnelle établie en 1922, où les épisodes bibliques correspondraient aux périodes de la préhistoire."
                            }
                        ]
                    },
                    {
                        "sense_id": "687cca6f-872c-313e-85cb-dfc61075809d",
                        "entry_id": "1fc05520-01b8-387a-b33f-808a21186d40",
                        "glosses": [
                            "Autre nom pour la tomographie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86abc611-6e87-40d4-8a99-6f77b4e52018",
                                "sense_id": "687cca6f-872c-313e-85cb-dfc61075809d",
                                "text": "La tomographie, ou stratigraphie, permet de radiographier un plan déterminé du corps."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "206686c6-a85d-4568-a2cf-b6697ff39e1d",
                        "source_entry_id": "1fc05520-01b8-387a-b33f-808a21186d40",
                        "target_lang_word": "stratigraphy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stratigraphy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "02b18db6-0cd7-351c-93cc-c7dcc29099cc",
                                        "entry_id": "9b49b9df-2a39-3755-a287-61c64bf220e4",
                                        "glosses": [
                                            "The study of rock layers and the layering process (stratification)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e52e55db-83cb-485c-b686-a64bd02cbf89",
                                                "sense_id": "02b18db6-0cd7-351c-93cc-c7dcc29099cc",
                                                "text": "The study of stratigraphy was at this point in its infancy, but it was already understood that different layers of rocks had been formed during different periods."
                                            },
                                            {
                                                "example_id": "d298c5a9-6128-4fd8-b5ca-bd49477cfe5e",
                                                "sense_id": "02b18db6-0cd7-351c-93cc-c7dcc29099cc",
                                                "text": "On Earth, we chart the history of waterways by looking at sediment that is deposited over time. We call that stratigraphy, the idea that water transports sediment and you can measure the changes on Earth by understanding the way that sediment piles up. That's what we've done here—but it's Mars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "917f594d-9e3d-3417-af8f-b87649980d6e",
                                        "entry_id": "9b49b9df-2a39-3755-a287-61c64bf220e4",
                                        "glosses": [
                                            "The layering of deposits, with newer remains overlaying older ones, forming a chronology of the site."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9178e3e-6677-48bb-afc0-0126caf957e1",
