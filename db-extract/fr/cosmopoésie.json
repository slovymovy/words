                                "target_senses": [
                                    {
                                        "sense_id": "20c4fb01-eb5a-3088-8447-065b69cbffe9",
                                        "entry_id": "7d530603-f998-33e2-9329-6e33407d7a4b",
                                        "glosses": [
                                            "The conception and description of a fictional world, often as the setting of a work of fiction, particularly in speculative fiction."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e07f3267-38df-4448-bfa2-e11b471f2268",
                                                "sense_id": "20c4fb01-eb5a-3088-8447-065b69cbffe9",
                                                "text": "The purpose of worldbuilding isn't just to do a cool exercise, but to give a sense of place — and all of your thought experiments absolutely have to result in something vivid and alive."
                                            },
                                            {
                                                "example_id": "5dbb0d59-e5d7-4fcb-a6a3-ce38d285bbb0",
                                                "sense_id": "20c4fb01-eb5a-3088-8447-065b69cbffe9",
                                                "text": "High fantasy of the George RR Martin kind hinges on world-building. When there really is a whole world to build, and not just a historical period or a particular country, world-building does not take a few paragraphs in a short story; it takes chapters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "092dd18e-0bbd-3fde-884a-8a81832f6982",
                                        "entry_id": "7d530603-f998-33e2-9329-6e33407d7a4b",
                                        "glosses": [
                                            "Scientific research into the creation of the Earth and its geological features."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
