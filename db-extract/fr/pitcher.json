                "senses": [
                    {
                        "sense_id": "d2213e08-f2c9-3d17-83c8-6730a6df7ec8",
                        "entry_id": "9e9767db-1660-33c4-a15b-d09413eee1a9",
                        "glosses": [
                            "Lancer."
                        ],
                        "tags": [
                            "Anglicism",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "eb042fa5-fe23-47c9-97bd-7de075539fc8",
                                "sense_id": "d2213e08-f2c9-3d17-83c8-6730a6df7ec8",
                                "text": "Vous vous sentez prêts à pitcher vos plus beaux projets."
                            },
                            {
                                "example_id": "74b52cd3-ea07-4e79-8535-51b46c223153",
                                "sense_id": "d2213e08-f2c9-3d17-83c8-6730a6df7ec8",
                                "text": "Ta mère a coutume de dire « si tu pitches les pâtes au plafond pis que ça colle, c’est parce que c’est cuit. »"
                            }
                        ]
                    },
                    {
                        "sense_id": "038a6b90-f2ea-3f16-95ca-7bb4682cd657",
                        "entry_id": "9e9767db-1660-33c4-a15b-d09413eee1a9",
                        "glosses": [
                            "Faire une présentation très courte et convaincante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e618508-c9fe-441e-8da9-191c0e50e7ee",
                                "sense_id": "038a6b90-f2ea-3f16-95ca-7bb4682cd657",
                                "text": "En ressources humaines, il est fréquent que l’on demande à un candidat à l’embauche de « pitcher » son parcours, quand on lui demande de se présenter : on attend de lui qu’il raconte une histoire rythmée, et non son CV que l’on connaît déjà, en cinq minutes."
                            },
                            {
                                "example_id": "f053fbb7-ba56-4704-992e-1ec1c81a3920",
                                "sense_id": "038a6b90-f2ea-3f16-95ca-7bb4682cd657",
                                "text": "Trois minutes, c’est une durée clé, explique le créateur du concours, Jean-Luc Lasquellec. Certains réussissent à pitcher leur thèse en cent quatre-vingts secondes, alors pourquoi pas la blockchain ou le bitcoin."
                            },
                            {
                                "example_id": "62fee596-945b-4afd-97ce-c41b9498dd36",
                                "sense_id": "038a6b90-f2ea-3f16-95ca-7bb4682cd657",
                                "text": "Les millenials voulaient être youtubeurs et pitcher leurs idées de start-up."
                            }
                        ]
                    }
