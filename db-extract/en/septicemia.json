                                        "glosses": [
                                            "vergiftiging door ziekteverwekkende bacteriën in het bloed"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d58c2798-14ee-46b2-a71a-6f9d663bc483",
                                                "sense_id": "a302efb1-3169-3864-bc2e-13a439b220fb",
                                                "text": "Bloedvergiftiging blijkt veel vaker voor te komen dan gedacht. Volgens onderzoekers aan de University of Washington is sepsis wereldwijd zelfs de belangrijkste doodsoorzaak."
