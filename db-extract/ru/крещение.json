                                                "sense_id": "5eadd87d-04c7-35cb-9dae-4d837e1e43c4",
                                                "text": "Podczas chrztu tradycyjnie rozbija się o burtę butelkę szampana."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "41149e15-5aa3-3658-b98a-27e0af6581a8",
                                        "entry_id": "a04c65f9-3ba7-3895-865b-27a8378abffe",
                                        "glosses": [
                                            "w związkach wyrazowych: inicjacja, pierwszy udział w czymś"
