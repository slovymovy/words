    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "eafdea48-1e1b-32e2-8801-030b813b1360",
                    "sense_definition": "Deprived of or lacking something essential.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "lacking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the fire, the family was <w>bereft</w> of even the most basic necessities.",
                            "target_lang_translations": {
                                "fr": "Après l'incendie, la famille était <w>privée</w> même des produits de première nécessité."
                            }
                        },
                        {
                            "text": "The team looked <w>bereft</w> of ideas during the final minutes of the game.",
                            "target_lang_translations": {
                                "fr": "L'équipe semblait <w>dépourvue</w> d'idées durant les dernières minutes du match."
                            }
                        }
                    ],
                    "synonyms": [
                        "devoid",
                        "lacking",
                        "stripped"
                    ],
                    "common_phrases": [
                        "bereft of ideas",
                        "bereft of hope"
                    ],
                    "target_lang_definitions": {
                        "fr": "Privé ou totalement dépourvu de quelque chose d'essentiel."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "privé de",
                                "target_lang_sense_clarification": "dépourvu de quelque chose"
                            },
                            {
                                "target_lang_word": "dépourvu de",
                                "target_lang_sense_clarification": "manquant totalement de quelque chose"
                            },
                            {
                                "target_lang_word": "dénué de",
                                "target_lang_sense_clarification": "sans la moindre présence de"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22c3fd1e-96d7-3f1a-9cdc-52dd964b0fc4",
                    "sense_definition": "Feeling deep sadness or grief due to the loss of a loved one.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "grief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt completely <w>bereft</w> following the sudden death of his wife.",
                            "target_lang_translations": {
                                "fr": "Il se sentait totalement <w>anéanti</w> après la mort soudaine de son épouse."
                            }
                        },
                        {
                            "text": "The <w>bereft</w> family struggled to find comfort after the funeral.",
                            "target_lang_translations": {
                                "fr": "La famille <w>endeuillée</w> peinait à trouver du réconfort après les obsèques."
                            }
                        }
                    ],
                    "synonyms": [
                        "grieving",
                        "heartbroken"
                    ],
                    "target_lang_definitions": {
                        "fr": "Plongé dans une profonde tristesse ou dévasté par la perte d'un être cher."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "endeuillé",
                                "target_lang_sense_clarification": "frappé par le deuil"
                            },
                            {
                                "target_lang_word": "dévasté",
                                "target_lang_sense_clarification": "anéanti par le chagrin"
                            },
                            {
                                "target_lang_word": "éploré",
                                "target_lang_sense_clarification": "abattu par la douleur"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e2f8c7d0-bce3-3567-9d4e-b5674500ccc3",
                    "sense_definition": "Past tense and past participle of <w>bereave</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "grief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The war had <w>bereft</w> the village of all its young men.",
                            "target_lang_translations": {
                                "fr": "La guerre avait <w>privé</w> le village de tous ses jeunes hommes."
                            }
                        },
                        {
                            "text": "She was <w>bereft</w> of her belongings after the fire destroyed her home.",
                            "target_lang_translations": {
                                "fr": "Elle s'est retrouvée <w>dépouillée</w> de ses biens après que l'incendie a détruit sa maison."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb bereave."
                        }
                    ],
                    "target_lang_definitions": {
