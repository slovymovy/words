        "fr-extract.jsonl": [
            {
                "entry_id": "2ce6ec28-5070-3637-a16d-55741c0421cc",
                "word": "wagon-lit",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5200fc2f-876b-4794-8bfb-90cf0d9d0596",
                        "entry_id": "2ce6ec28-5070-3637-a16d-55741c0421cc",
                        "tags": [
                            "plural"
                        ],
                        "form": "wagons-lits"
                    },
                    {
                        "form_id": "38f0a897-e64e-4b43-9140-4c50298dc44a",
                        "entry_id": "2ce6ec28-5070-3637-a16d-55741c0421cc",
                        "tags": [],
                        "form": "wagon-lits"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0372d6e7-fd11-3554-a9de-40d4024bc2c9",
                        "entry_id": "2ce6ec28-5070-3637-a16d-55741c0421cc",
                        "glosses": [
                            "Wagon équipé de lits et de commodités pour permettre aux voyageurs d’y dormir à l'aise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8eb2662-06c8-4812-b475-8efda4c9478c",
                                "sense_id": "0372d6e7-fd11-3554-a9de-40d4024bc2c9",
                                "text": "Jadis existait la Compagnie internationale des wagons-lits et des grands express européens."
                            },
                            {
                                "example_id": "b681bd77-c38a-4941-b9ec-1e2d0f94ab97",
                                "sense_id": "0372d6e7-fd11-3554-a9de-40d4024bc2c9",
                                "text": "Mais je conseille peu l’Islande aux malades, aux invalides et à quiconque est habitué au confort des hôtels et des wagons-lits."
                            },
                            {
                                "example_id": "5c218282-0f52-4457-9fd1-57cb97527db7",
                                "sense_id": "0372d6e7-fd11-3554-a9de-40d4024bc2c9",
                                "text": "Alors que le train de nuit restait jusque dans les années 1970 le moyen le plus confortable et le mois onéreux pour parcourir un long trajet, plusieurs cinéastes avaient compris que le wagon-lit était susceptible de devenir le centre de gravité d’un film."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "855ba77c-b4c2-4c85-873f-1c0ee7f96946",
                        "source_entry_id": "2ce6ec28-5070-3637-a16d-55741c0421cc",
                        "source_sense_id": "0372d6e7-fd11-3554-a9de-40d4024bc2c9",
                        "target_lang_word": "Schlafwagen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlafwagen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f38e4cb6-e245-3a20-8656-872c13cdab94",
                                        "entry_id": "024ab661-e43f-32f9-ba4a-92a705f5612b",
                                        "glosses": [
                                            "Wagen in einem Personenzug, in dem Betten für Fahrgäste bereitgehalten werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61037b45-7385-480c-8c02-ab510503905c",
                                                "sense_id": "f38e4cb6-e245-3a20-8656-872c13cdab94",
                                                "text": "„Das Schönste auf der Welt sind Schlafwagen, ich liege am liebsten oben im Bett.“"
                                            },
                                            {
                                                "example_id": "fdbe27a5-d596-4fba-961b-d304addac46a",
                                                "sense_id": "f38e4cb6-e245-3a20-8656-872c13cdab94",
                                                "text": "„Im Schlafwagen ziehe ich meinen roten Morgenmantel an – immerhin hat Angie damit John Wayne beeeindruckt.“"
                                            },
                                            {
                                                "example_id": "86638292-c210-46dc-821e-24c831077ca1",
                                                "sense_id": "f38e4cb6-e245-3a20-8656-872c13cdab94",
                                                "text": "„Der planmäßige Nachtschnellzug nach Marseille, der Paris um 21 Uhr 50 verließ, führte drei Schlafwagen mit sich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15c3368e-3095-4430-954a-4d736c92966c",
                        "source_entry_id": "2ce6ec28-5070-3637-a16d-55741c0421cc",
                        "source_sense_id": "0372d6e7-fd11-3554-a9de-40d4024bc2c9",
                        "target_lang_word": "sleeping car",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sleeping car",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4ac5f55-e660-364a-97b2-1d39d21341d2",
                                        "entry_id": "8a8e85a0-2135-3543-9a31-8acfa3323eab",
                                        "glosses": [
                                            "A railroad car with sleeping facilities for passengers travelling overnight."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1a9c5e0-1ebe-4ace-8d33-79252f02883a",
                                                "sense_id": "b4ac5f55-e660-364a-97b2-1d39d21341d2",
                                                "text": "In August 1859, eighty years ago, a sleeping car appeared on the Chicago & Alton Railroad of the United States, a great advance on the primitive facilities previously available."
                                            },
                                            {
                                                "example_id": "beae1100-3930-47d1-a037-94c3eb5f4529",
                                                "sense_id": "b4ac5f55-e660-364a-97b2-1d39d21341d2",
                                                "text": "Today, the 'Night Riviera' is one of only two sleeping car services that survive in the UK."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
