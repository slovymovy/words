                    {
                        "sense_id": "fc709537-c672-3d16-8b5b-043234a47b88",
                        "entry_id": "674ef97a-5b0b-3cbd-8fc4-7d34b7376503",
                        "glosses": [
                            "een taal die is ontstaan uit een andere taal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bd2eedd-29d1-4417-b2a7-0c522d2a937e",
                                "sense_id": "fc709537-c672-3d16-8b5b-043234a47b88",
                                "text": "Volgens de ambassade komt de toename vooral door de economische crisis. De keuze voor Nederland komt onder meer voort uit de taalverwantschap; Afrikaans is een dochtertaal van het Nederlands."
                            },
                            {
                                "example_id": "f4a85979-4179-41eb-9332-07627dab9202",
                                "sense_id": "fc709537-c672-3d16-8b5b-043234a47b88",
                                "text": "Een taal evolueert niet de hele tijd in hetzelfde gezapige ritme, maar veeleer in korte opstoten van snelle veranderingen. Die opstoten doen zich voor wanneer talen splitsen, dat wil zeggen wanneer een moedertaal uiteengroeit tot twee onderscheiden dochtertalen."
                            }
                        ]
                    }
