                        "form": "traquenet"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7a292866-bdaf-3289-a57d-291ce9701128",
                        "entry_id": "addc363d-6dbf-39c9-bbfc-286506eecb9f",
                        "glosses": [
                            "Appareil qui sert à nettoyer le grain des balles et de la menue paille, après le battage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8efb7ad1-04d7-4920-a99e-1b46bb35b425",
                                "sense_id": "7a292866-bdaf-3289-a57d-291ce9701128",
                                "text": "[…] pendant une dizaine de jours, le fermier les retourne à la pelle, après quoi il les passe au tarare - « au traquinet » , comme on dit dans l’Ain - sorte de machine destinée à trier les grains."
                            },
                            {
                                "example_id": "95009516-2c5c-4a42-82ed-49f66917d50b",
                                "sense_id": "7a292866-bdaf-3289-a57d-291ce9701128",
                                "text": "Les tarares, appelés encore traquinets, moulins ou grands vans étaient rares ; mais dans les grandes fermes on en possédait généralement un qu’on prêtait aux voisins."
                            },
                            {
                                "example_id": "36a44b44-69c6-4455-9a78-b4bfc35b4e09",
                                "sense_id": "7a292866-bdaf-3289-a57d-291ce9701128",
                                "text": "Marie et Nicolas découvrirent le matériel agricole et les semences arrivés d’Angleterre par leur ami armateur à Nantes. Quatre charrues sur roues « imperial Norfolk » à deux socs, cinq traquinets à vanner, quatre semoirs mécaniques à cuiller et une vingtaine de faux du meilleur acier pour remplacer les faucilles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5db52d60-74b7-41bd-a9f0-ee41ba8d0390",
                        "source_entry_id": "addc363d-6dbf-39c9-bbfc-286506eecb9f",
                        "source_sense_id": "7a292866-bdaf-3289-a57d-291ce9701128",
                        "target_lang_word": "winnow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "winnow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a2128d3-82c2-3ea2-a50b-1ea7427dcb79",
                                        "entry_id": "2c5c3fa6-4555-317f-a3e0-a4d7590c7cf6",
                                        "glosses": [
                                            "To subject (granular material, especially food grain) to a current of air separating heavier and lighter components, as grain from chaff."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0826694-6851-46fe-8ada-7534e74d34fa",
                                                "sense_id": "1a2128d3-82c2-3ea2-a50b-1ea7427dcb79",
                                                "text": "[W]ind began to winnow the river delta's dried sediments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9924b05d-9dad-3be3-8f42-08f01de0046c",
                                        "entry_id": "2c5c3fa6-4555-317f-a3e0-a4d7590c7cf6",
                                        "glosses": [
                                            "To separate, sift, analyse, or test by separating items having different values."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "883ddc6f-45a3-4e25-9480-9deaadf9f5fa",
                                                "sense_id": "9924b05d-9dad-3be3-8f42-08f01de0046c",
                                                "text": "They winnowed the losers from the winners."
                                            },
                                            {
                                                "example_id": "28717366-c721-451c-9144-46b68c0a622d",
                                                "sense_id": "9924b05d-9dad-3be3-8f42-08f01de0046c",
                                                "text": "They winnowed the field to twelve."
                                            },
                                            {
                                                "example_id": "edd393d0-edde-40a1-81b7-64a022dff6f1",
                                                "sense_id": "9924b05d-9dad-3be3-8f42-08f01de0046c",
                                                "text": "They winnowed the winners from the losers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6808502-47f4-3de2-b9ea-1d113bde1218",
                                        "entry_id": "2c5c3fa6-4555-317f-a3e0-a4d7590c7cf6",
                                        "glosses": [
                                            "To blow upon or toss about by blowing; to set in motion as with a fan or wings."
                                        ],
                                        "tags": [
                                            "literary",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "529a34cd-0212-4004-9d77-416a63b437d1",
                                                "sense_id": "a6808502-47f4-3de2-b9ea-1d113bde1218",
                                                "text": "The light snow lay on the narrow and winding path before them, pure as if just fresh winnowed by the wind."
                                            },
                                            {
                                                "example_id": "e3b577dc-0071-4e2d-a380-fc5adec82618",
                                                "sense_id": "a6808502-47f4-3de2-b9ea-1d113bde1218",
                                                "text": "Gulls average much larger than terns, with stouter build; the feet are larger and more ambulatorial, the wings are shorter and not so thin; the birds winnow the air in a steady course unlike the buoyant dashing flight of their relatives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc604ea8-a2fe-3ddb-bda4-6fa53f22c6a1",
                                        "entry_id": "2c5c3fa6-4555-317f-a3e0-a4d7590c7cf6",
                                        "glosses": [
                                            "To move about with a flapping motion, as of wings; to flutter."
                                        ],
                                        "tags": [
                                            "dated",
                                            "intransitive",
                                            "literary"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
