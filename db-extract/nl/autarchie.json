                                        "sense_id": "339eb770-e8a5-3f59-8b41-64b8f2971579",
                                        "entry_id": "7d618c7d-bba3-3eb6-94bc-ecea1e8fa1c4",
                                        "glosses": [
                                            "Sovereignty or self-government (national political independence)."
                                        ],
                                        "tags": [
