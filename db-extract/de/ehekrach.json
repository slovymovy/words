                "senses": [
                    {
                        "sense_id": "310357f5-9604-3fc4-887d-ea228789e44f",
                        "entry_id": "c5e8eb4a-f5cd-3b65-b613-7aa3c501a80f",
                        "glosses": [
                            "ernsthafter Konflikt zwischen Eheleuten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5124a17-6673-4992-b309-b7d1a21466fb",
                                "sense_id": "310357f5-9604-3fc4-887d-ea228789e44f",
                                "text": "„Es ist kaum zu glauben, aber es ist unser erster Ehekrach, und der ist nicht sehr spektakulär, eher still und verhalten.“"
                            },
                            {
                                "example_id": "8df87e8e-c12c-421c-8291-652f2a6cbae3",
                                "sense_id": "310357f5-9604-3fc4-887d-ea228789e44f",
                                "text": "„Aus einem Grammofon krächzte Richard Tauber und übertönte den Ehekrach vom Tiefparterre.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d38bb3b-af99-4bc3-9e67-1836fe72489f",
                        "source_entry_id": "c5e8eb4a-f5cd-3b65-b613-7aa3c501a80f",
                        "source_sense_id": "310357f5-9604-3fc4-887d-ea228789e44f",
