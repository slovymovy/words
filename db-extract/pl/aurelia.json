                ],
                "senses": [
                    {
                        "sense_id": "f98b52ac-2d5f-363a-b6d8-12870e36902e",
                        "entry_id": "c120fc97-4d5e-3d17-89ae-b60ca5bc59ae",
                        "glosses": [
                            "imię żeńskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b84be8cb-656f-4bd0-aba4-72f99be33030",
                                "sense_id": "f98b52ac-2d5f-363a-b6d8-12870e36902e",
                                "text": "Aurelia pokazała mu jeszcze wiszącą na ścianie wyszywaną serwetkę, na której niebieski haft układał się w hasło „Miłość i zgoda – domu ozdoba”"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "56698bb2-d221-338c-be89-0193fabe70ce",
                        "entry_id": "c120fc97-4d5e-3d17-89ae-b60ca5bc59ae",
                        "glosses": [
                            "planetoida o numerze katalogowym 419"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f826d99c-171f-491b-9583-7362f9968609",
                                "sense_id": "56698bb2-d221-338c-be89-0193fabe70ce",
                                "text": "Aurelia porusza się w obszarze między orbitami Marsa i Jowisza, czyli w pasie głównym planetoid."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c8b1d22-e0e0-4703-aad8-7d1ecb1204f4",
                        "source_entry_id": "c120fc97-4d5e-3d17-89ae-b60ca5bc59ae",
                        "source_sense_id": "f98b52ac-2d5f-363a-b6d8-12870e36902e",
                        "target_lang_word": "Aurélie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aurélie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d68a3327-dae5-3614-a229-f1a77c437525",
                                        "entry_id": "460140a5-c6c1-3604-80cc-5721c3137d57",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65ba5632-f364-40d4-8b08-05e05580b926",
                                                "sense_id": "d68a3327-dae5-3614-a229-f1a77c437525",
                                                "text": "Mon cher Arthur, je t’avais donné le seul moyen que je connusse de garder Aurélie, et tu n’as pas voulu…"
                                            },
                                            {
                                                "example_id": "1293f4b5-1ec2-4287-a3f3-c9325a988224",
                                                "sense_id": "d68a3327-dae5-3614-a229-f1a77c437525",
                                                "text": "Une fois les voitures loin derrière, les deux chiennes d’Aurélie Thorel gambadent libres sur les sentiers de La Chapelle-des-Pots, plongeant même dans les cours d’eau."
                                            },
                                            {
                                                "example_id": "bc93dbc9-690f-464f-84a8-b8958da926cc",
                                                "sense_id": "d68a3327-dae5-3614-a229-f1a77c437525",
                                                "text": "Le programme est animé par le célèbre chef Norbert Tarayre, la journaliste Aurélie Chaigneau et le meilleur ouvrier de France Gilles Goujon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
