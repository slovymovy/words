                "senses": [
                    {
                        "sense_id": "f7e76117-990d-3730-8b38-491fb84b2111",
                        "entry_id": "e5e3c956-d44c-3d71-ac9e-7b898eacd4ef",
                        "glosses": [
                            "großer Haufen von Schnee"
                        ],
                        "tags": [
                            "übertrieben"
                        ],
                        "examples": [
                            {
                                "example_id": "b7f3d8df-0de4-49b4-a189-c6ec24fe1f78",
                                "sense_id": "f7e76117-990d-3730-8b38-491fb84b2111",
                                "text": "Während wir letztes Jahr Mitte März schon im Garten grillten, türmen sich dieses Jahr auf den Straßen riesige Schneeberge."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "46c5e6bf-893a-3875-991d-35350a7afc28",
                        "entry_id": "e5e3c956-d44c-3d71-ac9e-7b898eacd4ef",
                        "glosses": [
                            "Name mehrerer Berge"
                        ],
                        "tags": [
                            "Oronym",
                            "fast immer Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "8e5e416c-f684-4d76-b0c0-7d848f866f49",
                                "sense_id": "46c5e6bf-893a-3875-991d-35350a7afc28",
                                "text": "Der Schneeberg ist der höchste Berg Niederösterreichs."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "3fe4a360-a146-302b-ac31-d15e6f0fd23b",
                        "entry_id": "e5e3c956-d44c-3d71-ac9e-7b898eacd4ef",
                        "glosses": [
                            "mit Schnee bedeckter Berg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bea31237-eca8-4873-8780-1551b9b0b8f5",
                                "sense_id": "3fe4a360-a146-302b-ac31-d15e6f0fd23b",
                                "text": "„Die Sonne sank soeben hinter die Schneeberge, als sie an dem westlichen Ende des langen Tafelfelsens landeten, der, wie bekannt, am linken Ufer des roten Flusses wallartig, einem ungeheuern Würfel gleich, emporsteigt.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
