                                        "sense_id": "a13d036f-a60b-3729-a59f-056efdabfaa5",
                                        "entry_id": "babbc0a7-f76b-37b2-8a5a-f817697ff2e1",
                                        "glosses": [
                                            "Œuvre assez ancienne et ayant exercé une grande influence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8418acc9-e9ac-4c6f-bd83-238e8508a2e0",
                                                "sense_id": "a13d036f-a60b-3729-a59f-056efdabfaa5",
                                                "text": "Dans l’une des scènes du film, on notera l’hommage que rend Minnelli à un classique du cinéma fantastique : La Féline."
                                            },
                                            {
                                                "example_id": "95194581-1b48-42b3-a119-aabc8508a432",
                                                "sense_id": "a13d036f-a60b-3729-a59f-056efdabfaa5",
                                                "text": "Les ouvrages de Lévi-Strauss sont des classiques de l’ethnologie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "072d4ada-35fb-3898-a841-870d7ccd0887",
                                        "entry_id": "babbc0a7-f76b-37b2-8a5a-f817697ff2e1",
                                        "glosses": [
                                            "Partisan du classicisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1855143-0e81-475e-906f-a096f7445355",
                                                "sense_id": "072d4ada-35fb-3898-a841-870d7ccd0887",
                                                "text": "Dans les années 1820, on oppose les classiques et les romantiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28688521-4996-37b6-9c59-d8dd588f0c2e",
                                        "entry_id": "babbc0a7-f76b-37b2-8a5a-f817697ff2e1",
                                        "glosses": [
                                            "Musique classique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cdb9d97-3945-4c45-ab41-a8a188c26167",
                                                "sense_id": "28688521-4996-37b6-9c59-d8dd588f0c2e",
                                                "text": "Comment font ces gens là qui ne lisent pas la musique pour jouer du classique mieux pour les oreilles du grand public que les orchestres symphoniques ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69d5f991-bbe4-3e05-a0ea-bbae9a28a4ab",
                                        "entry_id": "babbc0a7-f76b-37b2-8a5a-f817697ff2e1",
                                        "glosses": [
                                            "Ce qui est courant ou banal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e65d3f2-653d-4f60-848c-dea93f0c265f",
                                                "sense_id": "69d5f991-bbe4-3e05-a0ea-bbae9a28a4ab",
                                                "text": "Le cadeau ou objet publicitaire de faible valeur est largement utilisé en de nombreuses occasions. […] Les classiques sont les stylos à bille, les briquets, les calendriers, les porte-clefs, les sacs, les pochettes d’allumettes, les cartes à jouer."
                                            },
                                            {
                                                "example_id": "1cf0d4cd-2a9a-4139-9987-d21c0ffa16a9",
                                                "sense_id": "69d5f991-bbe4-3e05-a0ea-bbae9a28a4ab",
                                                "text": "Je commence à leur montrer que ça vaut n(n-1)/2, avec une méthode simple – un grand classique. Je n’irai pas jusqu’à dire que c'est une démonstration élégante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "044d6d61-b70f-36e0-87ff-32201ed41f00",
                                        "entry_id": "babbc0a7-f76b-37b2-8a5a-f817697ff2e1",
                                        "glosses": [
                                            "Course hippique de très haut niveau."
                                        ],
                                        "tags": [
                                            "Sports hippiques"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "classique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ec0fd601-382d-38cd-bc6a-b8423247b673",
                                        "entry_id": "aac4e622-36d3-3798-8143-4d45d69f6864",
                                        "glosses": [
                                            "Compétition sportive ayant une grande renommée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cf9f6d3-28f8-49e5-9587-51a4ff710529",
                                                "sense_id": "ec0fd601-382d-38cd-bc6a-b8423247b673",
                                                "text": "Le vélo est devenu une mystique, un culte, avec ses rites, ses officiants, ses grands prêtres : les grands tours, les grandes classiques, le record de l’heure, les descentes à tombeau ouvert du VTT, les raids à travers la Cordillère des Andes ou le Désert de la Mort."
                                            },
                                            {
                                                "example_id": "1324dfe8-2a43-4f9f-a78e-1ab4b3d52647",
                                                "sense_id": "ec0fd601-382d-38cd-bc6a-b8423247b673",
                                                "text": "Faire les grandes classiques ne semblait plus aussi excitant. Grimper devenait la principale motivation."
                                            }
                                        ]
                                    }
