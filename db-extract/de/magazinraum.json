                        "entry_id": "79d06d9c-b495-33fb-b34a-4e16aabe21fd",
                        "glosses": [
                            "Raum eines Magazins; Raum, der als Magazin genutzt werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e12b812e-de0a-4bde-8e10-51f71a604e06",
                                "sense_id": "15289625-85db-353e-b270-06307a88b151",
                                "text": "„Zum Höhleninnern hin waren alle Räume durch einen Flur verbunden, der mit einem Magazinraum verbunden wurde.“"
                            },
                            {
                                "example_id": "a0ad4a60-27d6-4247-9f0c-fc13f313bf8b",
                                "sense_id": "15289625-85db-353e-b270-06307a88b151",
                                "text": "„Diese subterranen Magazinräume kommen in etwa auf eine Fläche von einem Fußballfeld, verteilt auf drei bis vier Stockwerke mit einer gigantischen Raumhöhe.“"
                            }
                        ],
