{
    "word_family": [
        "immaculateness",
        "immaculately"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b4d15b25-ff68-3139-9da2-29ea915652d0",
                    "sense_definition": "Extremely clean, spotless, and perfectly tidy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cleanliness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She kept her apartment in <w>immaculate</w> condition, never leaving even a speck of dust.",
                            "target_lang_translations": {
                                "ru": "Она содержала свою квартиру в <w>идеальной чистоте</w>, не оставляя ни единой пылинки."
                            }
                        },
                        {
                            "text": "He wore an <w>immaculate</w> suit to the interview to make a good first impression.",
                            "target_lang_translations": {
                                "ru": "На собеседование он надел <w>безукоризненный</w> костюм, чтобы произвести хорошее первое впечатление."
                            }
                        }
                    ],
                    "synonyms": [
                        "spotless",
                        "pristine",
                        "spick-and-span",
                        "stainless"
                    ],
                    "antonyms": [
                        "maculate"
                    ],
                    "common_phrases": [
                        "immaculate condition",
                        "immaculate suit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Исключительно чистый, безупречно опрятный и незапятнанный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безупречно чистый",
                                "target_lang_sense_clarification": "без малейшей грязи или пятен"
                            },
                            {
                                "target_lang_word": "безукоризненный",
                                "target_lang_sense_clarification": "об опрятности и внешнем виде"
                            },
                            {
                                "target_lang_word": "чистенький",
                                "target_lang_sense_clarification": "аккуратный, отчищенный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fa572b6-0123-3512-ba60-1e96359e2de4",
                    "sense_definition": "Free from errors, flaws, or mistakes; perfect.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "perfection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The musician gave an <w>immaculate</w> performance that earned a standing ovation.",
                            "target_lang_translations": {
                                "ru": "Музыкант продемонстрировал <w>безупречное</w> исполнение, заслужив овации стоя."
                            }
                        },
                        {
                            "text": "Her research paper was praised for its <w>immaculate</w> logic and flawless references.",
                            "target_lang_translations": {
                                "ru": "Её научную работу хвалили за <w>безошибочную</w> логику и безупречные ссылки."
                            }
                        }
                    ],
                    "synonyms": [
                        "flawless",
                        "impeccable",
                        "perfect"
                    ],
                    "antonyms": [
                        "unimmaculate"
                    ],
                    "common_phrases": [
                        "immaculate record",
                        "immaculate timing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не содержащий ошибок, изъянов или недостатков; идеальный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безупречный",
                                "target_lang_sense_clarification": "не имеющий недостатков или ошибок"
                            },
                            {
                                "target_lang_word": "безошибочный",
                                "target_lang_sense_clarification": "выполненный абсолютно точно"
                            },
                            {
                                "target_lang_word": "совершенный",
                                "target_lang_sense_clarification": "идеальный по качеству или исполнению"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d491288-b199-3d68-ade2-bae00347a634",
                    "sense_definition": "Free from sin, guilt, or moral corruption; pure.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "purity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He maintained an <w>immaculate</w> reputation despite the political scandals surrounding him.",
                            "target_lang_translations": {
                                "ru": "Он сохранил <w>незапятнанную</w> репутацию, несмотря на окружавшие его политические скандалы."
                            }
                        },
                        {
                            "text": "The ancient text described a hero with an <w>immaculate</w> soul.",
                            "target_lang_translations": {
                                "ru": "В древнем тексте описывался герой с <w>непорочной</w> душой."
                            }
                        }
                    ],
                    "synonyms": [
                        "pure",
                        "chaste",
                        "undefiled",
                        "unsullied"
                    ],
                    "antonyms": [
                        "pure"
                    ],
                    "common_phrases": [
                        "immaculate reputation",
                        "immaculate soul"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свободный от греха, вины или морального разложения; нравственно чистый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непорочный",
                                "target_lang_sense_clarification": "чистый нравственно, безгрешный"
                            },
                            {
                                "target_lang_word": "незапятнанный",
                                "target_lang_sense_clarification": "о репутации, совести или чести"
                            },
                            {
                                "target_lang_word": "безупречный",
                                "target_lang_sense_clarification": "в моральном отношении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "337e521f-a508-3266-9b35-58d02e5bd6e7",
                    "sense_definition": "Having no spots, blotches, or markings (used especially in biology).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cleanliness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The petals of the rare white lily were completely <w>immaculate</w>.",
                            "target_lang_translations": {
                                "ru": "Лепестки редкой белой лилии были совершенно <w>чистыми, без единого пятнышка</w>."
                            }
                        },
                        {
                            "text": "This species of moth has <w>immaculate</w> wings without any dark markings.",
                            "target_lang_translations": {
                                "ru": "У этого вида моли <w>однотонные</w> крылья без каких-либо тёмных отметин."
                            }
                        }
                    ],
                    "synonyms": [
                        "unspotted",
                        "spotless"
                    ],
                    "antonyms": [
                        "spotted",
                        "maculated"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не имеющий пятен, крапинок или отметин (в биологии)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "без пятен",
                                "target_lang_sense_clarification": "однородной окраски, без крапинок"
                            },
                            {
                                "target_lang_word": "однотонный",
                                "target_lang_sense_clarification": "без рисунка и отметин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}