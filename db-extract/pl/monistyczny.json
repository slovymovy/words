                "senses": [
                    {
                        "sense_id": "3d53734a-b94c-3984-ace7-840e10c3595b",
                        "entry_id": "c838a526-dcb6-311a-942b-2d102ef91df0",
                        "glosses": [
                            "związany z monizmem, dotyczący monizmu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "506406a4-0c86-4639-868b-87ba9a4bebce",
                                "sense_id": "3d53734a-b94c-3984-ace7-840e10c3595b",
                                "text": "Materializm dialektyczny ujmuje świat w nieustannym ruchu, nieustannym rozwoju. Jest to system monistycznych, który zjawiska świata duchowego wyprowadza z bytu materialnego"
                            },
                            {
                                "example_id": "110bf4a6-99cd-4b66-9793-5fa77887b4d8",
                                "sense_id": "3d53734a-b94c-3984-ace7-840e10c3595b",
                                "text": "Jeżeli w statucie SE przyjęto system monistyczny, zgodnie z art. 38 rozporządzenia 2157/2001, stosuje się przepisy tego rozporządzenia oraz niniejszego rozdziału"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7ab9035-1a7c-4802-a26a-05980c83bfa3",
                        "source_entry_id": "c838a526-dcb6-311a-942b-2d102ef91df0",
                        "source_sense_id": "3d53734a-b94c-3984-ace7-840e10c3595b",
                        "target_lang_word": "monistic",
