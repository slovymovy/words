                                "target_senses": [
                                    {
                                        "sense_id": "cbe84251-e711-31d0-854d-bd1d02f7f808",
                                        "entry_id": "20255677-f89f-33ca-83da-41dcfd1d5684",
                                        "glosses": [
                                            "Organ zur Verdauung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3efd1d4c-03a5-4822-897f-c7e2d57b6523",
                                                "sense_id": "cbe84251-e711-31d0-854d-bd1d02f7f808",
                                                "text": "Der Darm ist der wichtigste Teil des menschlichen Verdauungstraktes."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "40151601-2b31-3d8d-83dc-9bd567336a4c",
                                        "entry_id": "20255677-f89f-33ca-83da-41dcfd1d5684",
                                        "glosses": [
                                            "Hülle einer Wurst (traditionell aus [1] hergestellt)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd6d6e3e-3ad1-4007-801e-37bc0ae57a1b",
                                                "sense_id": "40151601-2b31-3d8d-83dc-9bd567336a4c",
                                                "text": "Das Würstchen schmeckt zwar gut, aber der Darm ist etwas zäh."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73bdba24-10db-4799-9c3f-8296780d10eb",
                        "source_entry_id": "6951125b-b5a5-3e6a-a568-4725590401fc",
                        "source_sense_id": "3dff6d0e-8fb4-371d-91d2-535fec40998f",
                        "source_sense_description": "onderdeel van het spijsverteringsstelsel tussen de maag en de anus",
                        "target_lang_word": "intestine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intestine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad0cda8d-776e-33e2-a2bb-b6b96f46cce9",
                                        "entry_id": "fb5d9652-bb96-31ee-8d2c-7dd3c902c3bb",
                                        "glosses": [
                                            "The alimentary canal of an animal through which food passes after having passed all stomachs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5a5202b0-975f-3489-95b4-e310984e369d",
                                        "entry_id": "fb5d9652-bb96-31ee-8d2c-7dd3c902c3bb",
                                        "glosses": [
                                            "One of certain subdivisions of this part of the alimentary canal, such as the small or large intestine in human beings."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "intestine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3560ddaf-b60d-32b9-9e30-7eaa6b9b52df",
                                        "entry_id": "117ae965-a885-336e-9507-e395e3da63ed",
                                        "glosses": [
                                            "Domestic; taking place within a given country or region."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6ad86e0-c856-429a-adfd-fe4367fe2d96",
                                                "sense_id": "3560ddaf-b60d-32b9-9e30-7eaa6b9b52df",
                                                "text": "It being true that now after fiue yeeres intestine warre with the reuengefull implacable Indians, a firme peace (not againe easily to be broken) hath bin lately concluded[…]."
                                            },
                                            {
                                                "example_id": "232dc51e-8067-41bf-aeac-fafc4d5eb496",
                                                "sense_id": "3560ddaf-b60d-32b9-9e30-7eaa6b9b52df",
                                                "text": "[W]riters ſhould ceaſe from inteſtine hoſtilities; and, inſtead of ſacrificing each other to malice and contempt, endeavour to avert perſecution from the meaneſt of their fraternity."
                                            },
                                            {
                                                "example_id": "3e9873a1-1a7e-4cec-b5ef-443ce5052eea",
                                                "sense_id": "3560ddaf-b60d-32b9-9e30-7eaa6b9b52df",
                                                "text": "Yet the success of Trajan, however transient, was rapid and specious. The degenerate Parthians, broken by intestine discord, fled before his arms."
                                            },
                                            {
                                                "example_id": "e506c702-537b-4f71-94d7-f52fd891aeec",
                                                "sense_id": "3560ddaf-b60d-32b9-9e30-7eaa6b9b52df",
                                                "text": "The subdivisions of the tribe have elders over them, to whose authority they frequently pay much more deference than to that of their Chan: they are appointed by popular election, and where distinguished by birth or affluence are called beys, elders, tarchans, or batuers; but if their conduct be such as to displease their constituents, they are deposed, and their office transferred to some other party—the natural consequence of these changes is intestine confusion and anarchy, and open defiance of the authority of the Chan and his council."
                                            },
                                            {
                                                "example_id": "31bb6f8e-df15-4eb7-ae00-f2aa1b199e62",
                                                "sense_id": "3560ddaf-b60d-32b9-9e30-7eaa6b9b52df",
                                                "text": "Now will any sensible person assert that five millions of Southerners, allowing all her white population to be in favor of Slavery, with an intestine foe, ready to spring upon her, as soon as the last chance of freedom presents itself, will be in danger of fighting twelve millions of free Northerners, who can call to their aid all these, and numerous other allies."
                                            },
                                            {
                                                "example_id": "9af1a6c5-bfd5-4c8b-9504-b8a65eb68a4d",
                                                "sense_id": "3560ddaf-b60d-32b9-9e30-7eaa6b9b52df",
                                                "text": "In the speech attributed to him in More's History of King Richard the Third: Buckingham argues that war is never so mischievous as when it is intestine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93a349dd-d2fe-33ed-89b5-37a534de7a3b",
                                        "entry_id": "117ae965-a885-336e-9507-e395e3da63ed",
                                        "glosses": [
                                            "Internal."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c0e2f91-6667-4bfe-9862-39004269047d",
                                                "sense_id": "93a349dd-d2fe-33ed-89b5-37a534de7a3b",
                                                "text": "Hoping here to end / Intestine war in heaven, the arch foe subdued."
                                            },
                                            {
                                                "example_id": "763cafd5-2eda-41ba-bd84-8fe078023550",
                                                "sense_id": "93a349dd-d2fe-33ed-89b5-37a534de7a3b",
                                                "text": "a perpetual intestine struggle[…]between authority and liberty"
                                            },
                                            {
                                                "example_id": "289f81b2-46aa-432b-9ad2-54a1ce970f0c",
                                                "sense_id": "93a349dd-d2fe-33ed-89b5-37a534de7a3b",
                                                "text": "If you wish this state to be immortal, if you wish your empire to be eternal, if you with your glory to continue everlasting, then it is our own passions, it is the turbulence and desire of revolution engendered among our own citizens, it is intestine evil, it is domestic plots that must be guarded against."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e6b8429-d558-3951-b34f-592abf69661e",
                                        "entry_id": "117ae965-a885-336e-9507-e395e3da63ed",
                                        "glosses": [
                                            "Depending upon the internal constitution of a body or entity; subjective."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db02bca9-7bac-4913-a58a-df57cbad4506",
                                                "sense_id": "1e6b8429-d558-3951-b34f-592abf69661e",
                                                "text": "When you have alleaged all the reasons you can, and beleeved all to disavow and reject her, she produceth, contrarie to your discourses, so intestine inclination, that you have small hold against her."
                                            },
                                            {
                                                "example_id": "3d5a92b2-64b7-4d82-912b-30b27c36e2f7",
                                                "sense_id": "1e6b8429-d558-3951-b34f-592abf69661e",
                                                "text": "Every thing labours under an intestine necessity."
                                            },
                                            {
                                                "example_id": "63137520-f576-4bd6-8377-af26386981b9",
                                                "sense_id": "1e6b8429-d558-3951-b34f-592abf69661e",
                                                "text": "There dwells in the hearts of all who are deeply sunk in hypocrisy, an intestine hatred against all who are truly spiritual;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a576d1c-e215-3b6b-bd1f-171ea6c9962a",
                                        "entry_id": "117ae965-a885-336e-9507-e395e3da63ed",
                                        "glosses": [
                                            "Shut up; enclosed."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66f69c31-c800-4d4a-823d-f7bce85ca6df",
                                                "sense_id": "1a576d1c-e215-3b6b-bd1f-171ea6c9962a",
                                                "text": "No thunders shook with deep intestine sound The blooming groves that girdled her around."
                                            },
                                            {
                                                "example_id": "7b3859e9-cd7c-4427-8f1c-6923806a64e0",
                                                "sense_id": "1a576d1c-e215-3b6b-bd1f-171ea6c9962a",
                                                "text": "Where now the vital energy that moved, While summer was, the pure and subtle lymph Through the imperceptible meandering veins Of leaf and flower? It sleeps; and the icy touch Of unprolific winter has impress'd A cold stagnation on the intestine tide."
                                            },
                                            {
                                                "example_id": "e886d7bb-bf02-40b5-a5d4-a11d9a8e8358",
                                                "sense_id": "1a576d1c-e215-3b6b-bd1f-171ea6c9962a",
                                                "text": "(see title)"
                                            },
                                            {
                                                "example_id": "a0548941-ea32-4551-8ee3-5cdd5cbe4028",
                                                "sense_id": "1a576d1c-e215-3b6b-bd1f-171ea6c9962a",
                                                "text": "Lambarde's metaphor seems to be slipping here, as he admits that the worst enemies are 'intestine', within the walls, so to speak, or even within the 'body' of the nation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59aa027b-0a0e-4f89-a201-7db923d23e05",
                        "source_entry_id": "6951125b-b5a5-3e6a-a568-4725590401fc",
                        "source_sense_id": "3dff6d0e-8fb4-371d-91d2-535fec40998f",
                        "source_sense_description": "onderdeel van het spijsverteringsstelsel tussen de maag en de anus",
                        "target_lang_word": "intestin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intestin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "01fbe337-6d89-3492-b4a0-d27cfeab8cca",
                                        "entry_id": "25fe8680-efe2-365c-a24a-170313ad1da4",
                                        "glosses": [
                                            "Viscère abdominal, partie du tube digestif qui suit l’estomac jusqu’à l’anus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "962697a5-83c5-33b2-87e3-71c7e9b65517",
                                        "entry_id": "25fe8680-efe2-365c-a24a-170313ad1da4",
                                        "glosses": [
                                            "Subdivision de ce viscère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bd43020-d702-4df8-941d-68ae145b6f80",
                                                "sense_id": "962697a5-83c5-33b2-87e3-71c7e9b65517",
                                                "text": "Des nausées l'assiégeaient et des borborygmes travaillaient sournoisement ses intestins."
                                            },
                                            {
                                                "example_id": "322933eb-d52f-4e23-9954-b0496e6df2b1",
                                                "sense_id": "962697a5-83c5-33b2-87e3-71c7e9b65517",
                                                "text": "Les viscères herniés se trouvaient donc à la partie supérieure : c'était une masse d’intestins réunis en bloc, toutes les circonvolutions réunies par de fausses membranes, une fausse membrane générale enveloppant toute la masse ; […]."
                                            },
                                            {
                                                "example_id": "89dbeafb-4344-48f0-92ea-9dccf2c9571f",
                                                "sense_id": "962697a5-83c5-33b2-87e3-71c7e9b65517",
                                                "text": "L'appareil ballottait comme un ivrogne dans l'air froid, oscillant dans un vent de travers. […]. Leurs intestins yoyotaient de bas en haut sous l'effet du tangage et du roulis."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "intestin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7f202a43-379d-3f9f-a2bb-adbd3475356c",
                                        "entry_id": "7036b56c-3fd9-3bcc-8020-a53223feed7c",
                                        "glosses": [
                                            "Qui est interne, dans le corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a26e1393-b3d5-4bf3-b882-99b2bafecd09",
                                                "sense_id": "7f202a43-379d-3f9f-a2bb-adbd3475356c",
                                                "text": "Douleur, chaleur, fièvre intestine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e40a514-5dfc-33bd-9c42-f02bac47907c",
                                        "entry_id": "7036b56c-3fd9-3bcc-8020-a53223feed7c",
                                        "glosses": [
                                            "Qui a lieu au sein d’une communauté (famille, société, pays,…), en évoquant une atmosphère conflictuelle."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46253ab9-cc5f-4b3b-a685-aca628f7fd93",
                                                "sense_id": "3e40a514-5dfc-33bd-9c42-f02bac47907c",
                                                "text": "C’est le seul moyen peut-être de mettre un terme aux dissensions intestines qui agitent les nouvelles républiques."
                                            },
                                            {
                                                "example_id": "a06e5407-9054-4852-9e15-9eecb420b28c",
                                                "sense_id": "3e40a514-5dfc-33bd-9c42-f02bac47907c",
                                                "text": "…sorcière ou non, il vaut mieux que cette misérable fille meure que de voir Bois-Guilbert perdu pour l’ordre des templiers, ou l’ordre divisé par des dissensions intestines."
                                            },
                                            {
                                                "example_id": "7c2a9c2f-f97c-4a52-bb7a-bdc6240657be",
                                                "sense_id": "3e40a514-5dfc-33bd-9c42-f02bac47907c",
                                                "text": "Les rois norvégiens cessèrent de s'intéresser à la lointaine colonie ; la discorde survint ; des luttes naquirent, soit intestines, soit entre colons et esquimaux."
                                            },
                                            {
                                                "example_id": "f6bc3f57-2493-4dc1-8e90-3a9b219ae464",
                                                "sense_id": "3e40a514-5dfc-33bd-9c42-f02bac47907c",
                                                "text": "Au Vᵉ siècle, l'empire romain, miné par les luttes intestines, tombe en déliquescence. Des invasions de peuples barbares désolent et bouleversent aussi bien Rome que les Gaules."
                                            },
                                            {
                                                "example_id": "1c5873bb-098f-466f-9534-6fd62da8708f",
                                                "sense_id": "3e40a514-5dfc-33bd-9c42-f02bac47907c",
                                                "text": "Si on voulait écrire une télésérie à saveur politique, on n’aurait qu’à noter ce qui se passe au Parti libéral du Québec depuis une semaine.\nJeux de pouvoir, intrigues, personnages plus grands que nature, comportements répréhensibles, guerre intestine, tout y est."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ed4d375-0c2d-4497-9fd7-62139b489736",
                        "source_entry_id": "6951125b-b5a5-3e6a-a568-4725590401fc",
