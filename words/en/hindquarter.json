                                "target_lang_sense_clarification": "круп или задняя часть животного"
                            },
                            {
                                "target_lang_word": "круп",
                                "target_lang_sense_clarification": "верхняя задняя часть туловища лошади и др."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb639869-e4d1-324f-b4c0-49c7325e3ad9",
                    "sense_definition": "The rear section of a side of beef, lamb, or other meat, typically including the leg and loin.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "meat_cut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The butcher prepared a beef <w>hindquarter</w> into steaks and roasts for the weekend market.",
                            "target_lang_translations": {
                                "ru": "Мясник разделал говяжью <w>заднюю четвертину</w> на стейки и жаркое для ярмарки выходного дня."
                            }
                        },
                        {
                            "text": "Valuable cuts of meat are usually carved from the <w>hindquarter</w> of the animal.",
                            "target_lang_translations": {
                                "ru": "Ценные куски мяса обычно вырезают из <w>задней части туши</w> животного."
                            }
                        }
                    ],
                    "antonyms": [
                        "forequarter"
                    ],
                    "common_phrases": [
                        "beef hindquarter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Задняя четвертина мясной туши (говядины, баранины и т. д.), обычно включающая бедро и поясничную часть."
                    },
                    "translations": {
