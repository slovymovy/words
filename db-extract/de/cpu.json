                                        "examples": [
                                            {
                                                "example_id": "06c5065a-6a67-42f9-b830-d564e26a8bdd",
                                                "sense_id": "1f476cdf-6f60-37a5-9705-4eeaa6bc5079",
                                                "text": "Dell has announced that the new XPS 13 and XPS 13 2-in-1 will be its first to feature 11th-Gen Intel CPUs and meet the Evo certification."
                                            },
                                            {
                                                "example_id": "932d499e-5f3b-442f-b215-ad03218b23fa",
                                                "sense_id": "1f476cdf-6f60-37a5-9705-4eeaa6bc5079",
                                                "text": "Looking for the best RAM for your PC in 2023 has gotten a little bit more complicated than before. With the advent of DDR5, you can now choose between a newer standard, and an older one. DDR4 has a differently keyed connector, and you’re also going to have to check that the RAM is compatible with your CPU in the first place. So, what should you buy?"
                                            }
                                        ]
                                    },
