                "senses": [
                    {
                        "sense_id": "304cdd48-fd93-3ab6-b27a-aefda093113e",
                        "entry_id": "7fe70a8e-b7e2-32d5-8dcd-3fce361085a9",
                        "glosses": [
                            "разг. глухое потрескивание; хруст"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce1763bb-ced6-4f85-ac6c-fb9a0571d96b",
                                "sense_id": "304cdd48-fd93-3ab6-b27a-aefda093113e",
                                "text": "Послышался тихий хруп, и, конвульсивно дрогнув, полицейский повалился набок."
                            }
                        ]
                    },
                    {
                        "sense_id": "51bb0b8b-95e6-375e-bc1e-f312d12972a5",
                        "entry_id": "7fe70a8e-b7e2-32d5-8dcd-3fce361085a9",
                        "glosses": [
                            "предик. разг. обозначение глухого потрескивания, хруста как действия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30c46c73-d31c-4429-8ed8-84610a809d10",
                                "sense_id": "51bb0b8b-95e6-375e-bc1e-f312d12972a5",
                                "text": "Знавал я одного типа, так он в метель почесал себе ухо, а мочка хруп, и отвалилась."
                            }
                        ]
                    },
                    {
                        "sense_id": "2cfa6a0d-3a5e-30e3-bb10-3d922210b400",
                        "entry_id": "7fe70a8e-b7e2-32d5-8dcd-3fce361085a9",
                        "glosses": [
                            "междометие разг. при обозначении, при передаче глухого потрескивания, хруста"
                        ],
                        "tags": [],
                        "examples": []
                    }
