                "senses": [
                    {
                        "sense_id": "a834ade9-b48e-3fcf-bc4e-4eddf0dfb76b",
                        "entry_id": "0d8a7442-b35c-3e83-bf67-51ecc07fcb79",
                        "glosses": [
                            "dasjenige Gelenk, das Schulter und Oberarm verbindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4812ba3-80af-4efe-b31b-a8359d971d42",
                                "sense_id": "a834ade9-b48e-3fcf-bc4e-4eddf0dfb76b",
                                "text": "„Rheuma war ihm auf den linken Arm samt Schultergelenk geschlagen, wohl eine Erinnerung an den Grabenkrieg, so daß er zu Freiübungen angehalten war.“"
                            },
                            {
                                "example_id": "9e41aab9-615a-4c88-af13-4e3a602694a6",
                                "sense_id": "a834ade9-b48e-3fcf-bc4e-4eddf0dfb76b",
                                "text": "„Welse reiben hingegen mit einem Stachel ihrer Brustflosse an ihrem Schultergelenk und produzieren so ganz andere, hochfrequente Laute.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
