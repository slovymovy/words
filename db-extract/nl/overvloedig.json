                        "sense_id": "5857f1d0-0fec-3366-8058-e1f6e54f1cf2",
                        "entry_id": "7a7c760f-bed7-3d34-a19c-563f0eddccd2",
                        "glosses": [
                            "in ruime hoeveelheid aanwezig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "240916eb-4805-4c34-b9bd-0bb14ba21dd9",
                                "sense_id": "5857f1d0-0fec-3366-8058-e1f6e54f1cf2",
                                "text": "Je ziet ook hoe het leven langzaam uit de Route is weggetrokken. De romantiek van het verval is overvloedig aanwezig. Verlaten, met gras en onkruid overwoekerde tankstations."
                            }
                        ]
                    }
                ],
                "translations": [
