                                                "example_id": "9f52eb2b-d187-412b-a3e8-fdea6a79ac23",
                                                "sense_id": "c41d89af-2b17-367f-8331-37e9f14b2881",
                                                "text": "„Wir wurden in ein Motorboot verstaut, das einer Barkasse glich.“"
                                            },
                                            {
                                                "example_id": "7ef75754-2723-4640-8f23-b64081487d40",
                                                "sense_id": "c41d89af-2b17-367f-8331-37e9f14b2881",
                                                "text": "„Er mietete ein Motorboot, fuhr Wasserski mit ihr.“"
                                            },
                                            {
                                                "example_id": "e2d50eb6-2340-4281-b785-f6148dbffd13",
                                                "sense_id": "c41d89af-2b17-367f-8331-37e9f14b2881",
                                                "text": "„Ich […] sprang in das Motorboot und fuhr es auf die andere Seite des Stegs, um es dort festzumachen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
