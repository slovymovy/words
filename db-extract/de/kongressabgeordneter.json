                ],
                "senses": [
                    {
                        "sense_id": "10bbf163-cbf6-3014-95f6-64d847687288",
                        "entry_id": "860ae4ae-8bda-3cd4-9590-531132531d5b",
                        "glosses": [
                            "gewählter Vertreter im Kongress"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b8af448-de73-4845-8fd5-0c2e38121de4",
                                "sense_id": "10bbf163-cbf6-3014-95f6-64d847687288",
                                "text": "„Etliche republikanische Kongressabgeordnete haben bereits angekündigt, dem umstrittenen Mauerprojekt die Zustimmung zu verweigern.“"
                            },
                            {
                                "example_id": "94197580-f8fa-4049-bc7a-e96c41338410",
                                "sense_id": "10bbf163-cbf6-3014-95f6-64d847687288",
                                "text": "„Seine Idee hatte viele Gegner, vor allem unter den Kongressabgeordneten aus dem landwirtschaftlich geprägten Süden.“"
                            },
                            {
                                "example_id": "2d83bbf1-d03c-4c37-994e-ba8aa76cdd72",
                                "sense_id": "10bbf163-cbf6-3014-95f6-64d847687288",
                                "text": "„Auf der Konferenz von Simla im Juli 1945 blockierte Jinnah das britische Vorhaben, einen muslimischen Kongressabgeordneten in die Regierung zu schicken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
