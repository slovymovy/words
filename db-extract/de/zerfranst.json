                        ],
                        "form": "sie sind zerfranst"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "04620afc-7cae-3a5d-9b8e-63b9bea8ed57",
                        "entry_id": "16eb9c39-7563-3d02-bfd1-4d3bea823cff",
                        "glosses": [
                            "sich am Rand in Fäden (Fransen) auflösend"
                        ],
                        "tags": [
                            "von Kleidungsstücken oder Textilien"
                        ],
                        "examples": [
                            {
                                "example_id": "9424933e-f571-459a-9e76-d39ac6c7502b",
                                "sense_id": "04620afc-7cae-3a5d-9b8e-63b9bea8ed57",
                                "text": "„Es war prall, zerfranst und wirkte mit dem dunkelroten Ledereinband wie ein uralter Schatz.“"
                            },
                            {
                                "example_id": "ba291aa9-22d3-4677-a4e8-69e2df0b97eb",
                                "sense_id": "04620afc-7cae-3a5d-9b8e-63b9bea8ed57",
                                "text": "„Sie hatte so viele solcher Mäntel gesehen, dass sie die Stellen erkannte, wo die Nähte zerfranst waren.“"
                            },
                            {
                                "example_id": "b6746314-5064-471c-9dfc-8c3d533abe00",
                                "sense_id": "04620afc-7cae-3a5d-9b8e-63b9bea8ed57",
                                "text": "„Der Boden war eiskalt, und nur an wenigen Stellen lagen zerfranste Matten aus einer Art Stroh, die sich wärmer anfühlten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
