{
    "word_family": [
        "eruption",
        "eruptive",
        "interruption",
        "rupture",
        "disrupt"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bfbe7e13-159b-3dac-a12d-e51655e11d95",
                    "sense_definition": "To eject lava, ash, or gases violently from a volcano or geyser.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geological_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The volcano <w>erupted</w> suddenly, spewing hot lava across the wide valley.",
                            "target_lang_translations": {
                                "ru": "Вулкан внезапно <w>извергся</w>, выбрасывая горячую лаву по всей широкой долине."
                            }
                        },
                        {
                            "text": "Scientists warned that the mountain might <w>erupt</w> again after years of silence.",
                            "target_lang_translations": {
                                "ru": "Ученые предупредили, что гора может снова <w>начать извержение</w> после многих лет тишины."
                            }
                        }
                    ],
                    "synonyms": [
                        "burst"
                    ],
                    "common_phrases": [
                        "volcano erupted",
                        "erupt violently"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно выбрасывать лаву, пепел или газы из вулкана или гейзера."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "извергаться",
                                "target_lang_sense_clarification": "о вулкане или гейзере"
                            },
                            {
                                "target_lang_word": "начать извержение",
                                "target_lang_sense_clarification": "процесс выброса лавы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62721ed6-46a3-344b-a898-cc3c924a260a",
                    "sense_definition": "To suddenly and intensely express a strong emotion or sound, such as anger or cheering.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_outburst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd <w>erupted</w> in cheers when the home team scored the winning goal.",
                            "target_lang_translations": {
                                "ru": "Толпа <w>разразилась</w> криками восторга, когда домашняя команда забила победный гол."
                            }
                        },
                        {
                            "text": "The peaceful protest <w>erupted</w> in violence after the police arrived.",
                            "target_lang_translations": {
                                "ru": "Мирный протест <w>вспыхнул</w> насилием после прибытия полиции."
                            }
                        }
                    ],
                    "synonyms": [
                        "burst"
                    ],
                    "common_phrases": [
                        "erupted in cheers",
                        "erupted in anger",
                        "erupted in laughter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапно и интенсивно выразить сильную эмоцию или звук, например, гнев или аплодисменты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разразиться",
                                "target_lang_sense_clarification": "криками, смехом или аплодисментами"
                            },
                            {
                                "target_lang_word": "взорваться",
                                "target_lang_sense_clarification": "эмоционально, о толпе"
                            },
                            {
                                "target_lang_word": "вспыхнуть",
                                "target_lang_sense_clarification": "о насилии или беспорядках"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34ea9c70-2280-3fb8-b95b-87349f1d1c82",
                    "sense_definition": "To break through the surface, especially regarding a tooth growing through the gums.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_emergence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baby was fussy because his first tooth was starting to <w>erupt</w>.",
                            "target_lang_translations": {
                                "ru": "Малыш капризничал, потому что у него начинал <w>прорезаться</w> первый зуб."
                            }
                        },
                        {
                            "text": "Wisdom teeth often <w>erupt</w> late in a person's life or not at all.",
                            "target_lang_translations": {
                                "ru": "Зубы мудрости часто <w>прорезываются</w> поздно или не появляются вовсе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tooth erupts"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "medical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пробиться сквозь поверхность, особенно о зубе, растущем через десну."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прорезаться",
                                "target_lang_sense_clarification": "о зубах"
                            },
                            {
                                "target_lang_word": "прорезываться",
                                "target_lang_sense_clarification": "процесс появления зуба"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "055eebcf-0004-39ca-be74-e00b089cf64e",
                    "sense_definition": "To suddenly appear in a specific region in unusually large numbers, typically said of animals or insects.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biological_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During the winter, snowy owls may <w>erupt</w> into areas much further south than usual.",
                            "target_lang_translations": {
                                "ru": "Зимой полярные совы могут внезапно <w>появиться</w> в районах гораздо южнее, чем обычно."
                            }
                        },
                        {
                            "text": "The insect population will <w>erupt</w> if the weather conditions remain this humid.",
                            "target_lang_translations": {
                                "ru": "Популяция насекомых резко <w>возрастет</w>, если погодные условия останутся такими же влажными."
                            }
                        }
                    ],
                    "common_phrases": [
                        "erupt from breeding grounds"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапно появиться в определенном регионе в необычно большом количестве (обычно о животных или насекомых)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внезапно появиться",
                                "target_lang_sense_clarification": "в большом количестве"
                            },
                            {
                                "target_lang_word": "наводнить",
                                "target_lang_sense_clarification": "территорию (о миграции)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}