                ],
                "senses": [
                    {
                        "sense_id": "6bf1455d-8854-37c0-8f89-9a6c40a9cd0c",
                        "entry_id": "2c3d2295-cf32-31be-bbe5-56929289b1cc",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c314f9a0-deb5-4151-8df7-3e71487b27ce",
                                "sense_id": "6bf1455d-8854-37c0-8f89-9a6c40a9cd0c",
                                "text": "Frau Jacobi ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "cdbfa05e-b7d9-4bca-8c68-8b08d9be12cf",
                                "sense_id": "6bf1455d-8854-37c0-8f89-9a6c40a9cd0c",
                                "text": "Herr Jacobi wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "95b8e8b9-575c-4eb9-b97f-1930c1002ddb",
                                "sense_id": "6bf1455d-8854-37c0-8f89-9a6c40a9cd0c",
                                "text": "Die Jacobis fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "c3eb1715-1d2c-4356-910a-063ddc80701f",
                                "sense_id": "6bf1455d-8854-37c0-8f89-9a6c40a9cd0c",
                                "text": "Der Jacobi trägt nie die Schals, die die Jacobi ihm strickt."
                            },
                            {
                                "example_id": "e2975857-05a7-4cba-a1a0-4fc8a8b6007b",
                                "sense_id": "6bf1455d-8854-37c0-8f89-9a6c40a9cd0c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Jacobi kommt, geht der Herr Jacobi.“"
                            },
                            {
                                "example_id": "781c5203-53d4-4110-9856-bfb0cf012949",
                                "sense_id": "6bf1455d-8854-37c0-8f89-9a6c40a9cd0c",
                                "text": "Jacobi kommt und geht."
                            },
                            {
                                "example_id": "0661f088-dcf7-4d1c-bfe3-e884a5f8f507",
                                "sense_id": "6bf1455d-8854-37c0-8f89-9a6c40a9cd0c",
                                "text": "Jacobis kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
