                                            {
                                                "example_id": "309a40a2-cc4a-4f15-ba99-dcaf42eaacca",
                                                "sense_id": "e6fd1f96-bff4-364f-aa25-4f8ea8a7673c",
                                                "text": "Vor dem Abitur stehen viele Schüler unter Druck."
                                            },
                                            {
                                                "example_id": "1d162f41-ec68-476e-9964-030ce30c02af",
                                                "sense_id": "e6fd1f96-bff4-364f-aa25-4f8ea8a7673c",
                                                "text": "„Auf Druck der Öffentlichkeit hatte der Polizeipräsident zunächst den Verein verboten, um das Verbot vier Wochen später wieder aufzuheben.“"
                                            },
                                            {
                                                "example_id": "2e96c4bc-6b4c-4cbe-8381-75aa3a98b3d2",
                                                "sense_id": "e6fd1f96-bff4-364f-aa25-4f8ea8a7673c",
                                                "text": "„Statt Linderung verspürte Irmgard Ried nach dem Besuch noch mehr Druck, weil es für ihr Leid offensichtlich keinen legitimen Grund gab.“"
                                            },
                                            {
                                                "example_id": "0c7f4e00-a847-417a-9c5e-c67425f3b3fe",
                                                "sense_id": "e6fd1f96-bff4-364f-aa25-4f8ea8a7673c",
                                                "text": "„Aber der Durchschnittsdeutsche aller sozialen Klassen sieht viel sauberer und ordentlicher aus, als man angesichts seiner wirklichen Lebensbedingungen, des Drucks und der Plackerei seines Lebens erwarten könnte.“"
                                            },
                                            {
                                                "example_id": "2ed35bec-ff1b-4f5e-b16c-70f57df39fcb",
                                                "sense_id": "e6fd1f96-bff4-364f-aa25-4f8ea8a7673c",
                                                "text": "„Mafiöse Gruppen versuchten an allen möglichen Stellen, korrumpierbare Helfer zu rekrutieren, mit Druck oder mit Geld.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0ea54895-c0f1-3c86-bebd-8c0915ecbf30",
                                        "entry_id": "8afd30af-7858-3383-960f-e4225c2e09d0",
                                        "glosses": [
                                            "Vorgang des Drückens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91e0117a-e2e2-4764-bf4e-ea3c4b958a18",
                                                "sense_id": "0ea54895-c0f1-3c86-bebd-8c0915ecbf30",
                                                "text": "Ein gelegentlicher Druck auf die Umschalttaste würde dem Schriftbild guttun."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Druck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8799910f-3620-3e78-98b4-267ccf59cfb3",
                                        "entry_id": "0bf06019-0fa2-3f48-8567-51cc2c98f4a1",
                                        "glosses": [
                                            "Reproduktionsverfahren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "366b197d-8076-48d6-b422-ca34ff9e3717",
                                                "sense_id": "8799910f-3620-3e78-98b4-267ccf59cfb3",
                                                "text": "Der Druck erlaubt die günstige Vervielfältigung von Text und Bildern; er wurde in Asien um 770 n. Chr. entwickelt und seitdem weltweit verbessert."
                                            },
                                            {
                                                "example_id": "ae5b0b1e-a5ae-423e-be9d-8dda2dcfa20f",
                                                "sense_id": "8799910f-3620-3e78-98b4-267ccf59cfb3",
                                                "text": "„Nach dem Druck kann diese Schicht vom Zylinder entfernt werden und ermöglicht nach erneuter Galvanisierung dessen Wiederverwendung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7cfc995e-da10-3ee5-8bff-f7d62b3cdb98",
                                        "entry_id": "0bf06019-0fa2-3f48-8567-51cc2c98f4a1",
                                        "glosses": [
                                            "Ergebnis des Reproduktionsverfahrens ^([2])"
                                        ],
                                        "tags": [
                                            "nur Plural 1"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d59f47e-48fd-4d87-afdd-b21bf2e5cdd8",
                                                "sense_id": "7cfc995e-da10-3ee5-8bff-f7d62b3cdb98",
                                                "text": "Ein guter Druck ist meist kaum vom Original zu unterscheiden."
                                            },
                                            {
                                                "example_id": "a5c0b0a8-2586-4e25-a97e-f67ffda96d86",
                                                "sense_id": "7cfc995e-da10-3ee5-8bff-f7d62b3cdb98",
                                                "text": "„Er stellte mehr als 200 Drucke her.“"
                                            },
                                            {
                                                "example_id": "3b2dc7c0-7a9b-4e46-86c4-5189f9333775",
                                                "sense_id": "7cfc995e-da10-3ee5-8bff-f7d62b3cdb98",
                                                "text": "„Sämtliche Glossen stammen aus der Entstehungszeit dieser Werke und werden seit jeher in den meisten Abschriften und Drucken mit aufgeführt.“"
                                            },
                                            {
                                                "example_id": "118ffa82-1c99-4e98-bf83-a69ca80edfc3",
                                                "sense_id": "7cfc995e-da10-3ee5-8bff-f7d62b3cdb98",
                                                "text": "„Bereits zu Luthers Zeiten gelangten Hunderttausende von Exemplaren unter die Leute: Drucke aus Wittenberg, Nachdrucke aus Augsburg, Leipzig oder Basel, Teildrucke im Kleinformat, einspaltige und zweispaltige, einbändige und mehrbändige Drucke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
