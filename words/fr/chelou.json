                    ],
                    "target_lang_definitions": {
                        "en": "Unusual in a surprising or unsettling way; strange or bizarre.",
                        "ru": "Необычный, вызывающий удивление или тревогу; странный, причудливый.",
                        "nl": "Op een verrassende of verontrustende manier afwijkend; vreemd of bizar.",
                        "de": "Ungewöhnlich auf überraschende oder verwirrende Weise; seltsam oder befremdlich.",
                        "pl": "Nietypowy w zaskakujący lub niepokojący sposób; dziwny, osobliwy.",
                        "it": "Che esce dall'ordinario in modo sorprendente o sconcertante; bizzarro, strano.",
                        "cs": "Neobvyklý překvapivým nebo znepokojivým způsobem; divný, podivný.",
                        "tr": "Olağandışı, şaşırtıcı ya da rahatsız edici bir biçimde alışılmadık; garip, tuhaf.",
                        "es": "Que se sale de lo común de forma sorprendente o desconcertante; raro, extraño.",
                        "zh": "形容事物出乎意料、令人费解或不安，与平常大不相同。"
