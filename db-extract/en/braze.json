                                            {
                                                "example_id": "a7682ce2-939c-4112-a142-6ecf2c3031bf",
                                                "sense_id": "5bcca0f7-5913-3ea9-99fd-b73ab8893bea",
                                                "text": "Il faudra braser ce joint de tuyaux à l’étain. C’est de la pâte à braser pour les composants électroniques."
                                            },
                                            {
                                                "example_id": "5f764137-41ad-4aba-814f-ab7754a56af6",
                                                "sense_id": "5bcca0f7-5913-3ea9-99fd-b73ab8893bea",
                                                "text": "Si au cours d’une chute la fourche avait été faussée, il devait à pied joindre le plus prochain village et chez le forgeron la redresser ou en braser les tronçons lorsque c’était possible."
                                            }
                                        ]
                                    }
