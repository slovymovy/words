{
    "word_family": [
        "gadgetry",
        "gadgeteer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bcea0fb5-1539-33aa-9c1d-d4572793ac96",
                    "sense_definition": "A small mechanical or electronic device or tool, often one that is clever or useful.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He bought a neat new <w>gadget</w> for shredding potatoes.",
                            "target_lang_translations": {
                                "tr": "Patatesleri rendelemek için kullanışlı yeni bir <w>alet</w> satın aldı."
                            }
                        },
                        {
                            "text": "That is quite a lot of <w>gadgets</w> you have collected.",
                            "target_lang_translations": {
                                "tr": "Topladığın bu <w>aletler</w> epey fazlaymış."
                            }
                        }
                    ],
                    "synonyms": [
                        "contraption",
                        "contrivance",
                        "gizmo",
                        "widget",
                        "device"
                    ],
                    "common_phrases": [
                        "kitchen gadget",
                        "electronic gadget"
                    ],
                    "target_lang_definitions": {
                        "tr": "Genellikle akıllıca tasarlanmış veya kullanışlı, küçük mekanik veya elektronik cihaz ya da alet."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "alet",
                                "target_lang_sense_clarification": "küçük ve pratik araç"
                            },
                            {
                                "target_lang_word": "cihaz",
                                "target_lang_sense_clarification": "küçük mekanik/elektronik aygıt"
                            },
                            {
                                "target_lang_word": "aparat",
                                "target_lang_sense_clarification": "belirli bir işe yarayan küçük araç"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c64528b-9750-33de-a136-e46539f0f6d5",
                    "sense_definition": "A consumer electronics product.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every time a new <w>gadget</w> arrives, people want to buy it.",
                            "target_lang_translations": {
                                "tr": "Piyasaya yeni bir <w>cihaz</w> çıktığında insanlar hemen onu satın almak istiyor."
                            }
                        },
                        {
                            "text": "The store sells every modern <w>gadget</w> you can imagine.",
                            "target_lang_translations": {
                                "tr": "Mağaza, aklınıza gelebilecek her modern <w>cihazı</w> satıyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "gizmo",
                        "device"
                    ],
                    "common_phrases": [
                        "new gadget"
                    ],
                    "target_lang_definitions": {
                        "tr": "Tüketici elektroniği ürünü veya teknolojik aygıt."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "cihaz",
                                "target_lang_sense_clarification": "elektronik tüketici ürünü"
                            },
                            {
                                "target_lang_word": "teknolojik alet",
                                "target_lang_sense_clarification": "tüketici elektroniği"
                            },
                            {
                                "target_lang_word": "aygıt",
                                "target_lang_sense_clarification": "elektronik cihaz"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb22b79b-8ce6-33d0-b7b4-d892f90ed806",
                    "sense_definition": "A placeholder name for a thing whose name is forgotten or unknown.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "placeholder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I forgot the name of that <w>gadget</w> used to open jars.",
                            "target_lang_translations": {
                                "tr": "Kavanozları açmak için kullanılan o <w>zamazingo</w>nun adını unuttum."
                            }
                        },
                        {
                            "text": "Pass me that <w>gadget</w> over there, the one for the screws.",
                            "target_lang_translations": {
                                "tr": "Şuradaki vidayla ilgili <w>şeyi</w> bana uzatır mısın?"
                            }
                        }
                    ],
                    "synonyms": [
                        "doohickey"
                    ],
                    "target_lang_definitions": {
                        "tr": "Adı unutulan veya bilinmeyen bir nesne için kullanılan geçici ad."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "zamazingo",
                                "target_lang_sense_clarification": "adı hatırlanmayan nesne"
                            },
                            {
                                "target_lang_word": "şey",
                                "target_lang_sense_clarification": "adı unutulan alet veya nesne"
                            },
                            {
                                "target_lang_word": "ıvır zıvır",
                                "target_lang_sense_clarification": "ufak tefek parça"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9a4cd1b-0a57-34a9-b7d4-fedd68f29b58",
                    "sense_definition": "A sequence of machine code instructions used in a computer security exploit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The security researcher identified a malicious <w>gadget</w> in the code.",
                            "target_lang_translations": {
                                "tr": "Güvenlik araştırmacısı kodda kötü amaçlı bir <w>gadget</w> tespit etti."
                            }
                        },
                        {
                            "text": "The exploit relies on a specific <w>gadget</w> to bypass system protections.",
                            "target_lang_translations": {
                                "tr": "İstismar, sistem korumalarını aşmak için belirli bir <w>komut parçacığına</w> dayanıyor."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bilgisayar güvenliği istismarında (exploit) kullanılan makine kodu komut dizisi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "gadget",
                                "target_lang_sense_clarification": "ROP/güvenlik istismar komut dizisi"
                            },
                            {
                                "target_lang_word": "komut parçacığı",
                                "target_lang_sense_clarification": "makine kodu dizisi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c98cad8f-d5fd-35a3-b6fc-b46157bff803",
                    "sense_definition": "A technique for converting one problem into another in computational complexity theory.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The proof uses a <w>gadget</w> to map the variables to the graph.",
                            "target_lang_translations": {
                                "tr": "Kanıt, değişkenleri grafiğe eşlemek için bir <w>gadget</w> kullanır."
                            }
                        },
                        {
                            "text": "We constructed a <w>gadget</w> to reduce the problem to 3-SAT.",
                            "target_lang_translations": {
                                "tr": "Problemi 3-SAT problemine indirgemek için bir <w>araç</w> kurguladık."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Hesaplamalı karmaşıklık teorisinde bir problemi diğerine dönüştürmek için kullanılan teknik veya alt yapı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "gadget",
                                "target_lang_sense_clarification": "karmaşıklık teorisinde indirgeme aracı"
                            },
                            {
                                "target_lang_word": "araç",
                                "target_lang_sense_clarification": "matematiksel dönüşüm parçası"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4af04bbd-6fcd-3671-8114-21d632dd814f",
                    "sense_definition": "A specialized tool used in glassblowing to hold the foot of a glass.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The glassblower used a <w>gadget</w> to finish the bowl of the glass.",
                            "target_lang_translations": {
                                "tr": "Cam ustası bardağın kadeh kısmını tamamlamak için bir <w>tutucu</w> kullandı."
                            }
                        },
                        {
                            "text": "A <w>gadget</w> is essential for shaping the foot without leaving marks.",
                            "target_lang_translations": {
                                "tr": "İz bırakmadan ayağı şekillendirmek için bir <w>kıskaç</w> şarttır."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Cam üflemede bardağın tabanını tutmak için kullanılan özel bir alet."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tutucu",
                                "target_lang_sense_clarification": "cam üflemede taban tutma aleti"
                            },
                            {
                                "target_lang_word": "kıskaç",
                                "target_lang_sense_clarification": "cam işleme aleti"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}