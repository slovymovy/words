                            }
                        },
                        {
                            "text": "Обычно <w>крепость</w> чая зависит от времени заваривания.",
                            "target_lang_translations": {
                                "de": "Normalerweise hängt die <w>Stärke</w> des Tees von der Ziehzeit ab."
                            }
