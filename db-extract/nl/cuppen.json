                "senses": [
                    {
                        "sense_id": "082236f4-fbc2-3888-ad17-af2750647809",
                        "entry_id": "f914c5f6-9ec8-37cf-8a2d-8e8c96d6c279",
                        "glosses": [
                            "met een bekertje muziek maken"
                        ],
                        "tags": [
                            "jongerentaal"
                        ],
                        "examples": [
                            {
                                "example_id": "061e7a59-0887-4a68-b520-3686eeec0fc7",
                                "sense_id": "082236f4-fbc2-3888-ad17-af2750647809",
                                "text": "Kinderen van de basisschool Het Talent in Heerde (…) spelen, zingen en cuppen voor Sinterklaas het liedje ‘Dag Sinterklaas!’."
                            }
                        ]
                    },
                    {
                        "sense_id": "a4b17236-4786-3744-aa6a-1326e37e6eaf",
                        "entry_id": "f914c5f6-9ec8-37cf-8a2d-8e8c96d6c279",
                        "glosses": [
                            "proeven van kleine hoeveelheden koffie bij het keuren van koffiebonen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "011f64c3-97a0-49d3-83e2-8d2e585a6ef4",
                                "sense_id": "a4b17236-4786-3744-aa6a-1326e37e6eaf",
                                "text": "Het cuppen of proeven van koffie is voor de koffiebrander van het allerhoogste belang. Het cuppen kan als kunst maar ook als wetenschap worden gezien. Eén ding staat vast: het is een absoluut noodzakelijke stap bij het nemen van een aankoopbeslissing."
                            }
                        ]
                    },
                    {
                        "sense_id": "18d7e47e-e1ee-32f0-bc8d-3df8cae49550",
                        "entry_id": "f914c5f6-9ec8-37cf-8a2d-8e8c96d6c279",
                        "glosses": [
                            "bekertjes op bepaalde plekken op de huid zetten en vacuüm zuigen als cosmetische behandeling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb1fa0fc-8b77-4b36-9fd1-23d4e18fe02a",
                                "sense_id": "18d7e47e-e1ee-32f0-bc8d-3df8cae49550",
                                "text": "Blijkbaar is het een effectieve techniek als zelfs celebrities het aandurven hun tedere gezicht te cuppen. Maar: de effecten zijn nog niet wetenschappelijk bewezen, dus we weten nog niet zeker of het doet wat het belooft."
                            }
                        ]
                    }
                ],
