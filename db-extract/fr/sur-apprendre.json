                        "source_sense_id": "782d3db5-dcb1-3392-81d3-db6ef170ddbe",
                        "target_lang_word": "overlearn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overlearn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7009708-e226-3cfd-9ee8-269505bc5301",
                                        "entry_id": "446531be-4ebd-3d8f-b097-0249a8fb29f3",
                                        "glosses": [
                                            "To learn (something) more than is necessary; to study excessively, to take (something) too much to heart."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7740b16-789e-4631-ace4-e67c9ed1408b",
                                                "sense_id": "c7009708-e226-3cfd-9ee8-269505bc5301",
                                                "text": "Why the rigmarole of a military survey before enacting a measure most Americans already favoured? Maybe he over-learned the lesson of the clobbering Bill Clinton got when he barged into this area right at the start of his presidency."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afcf2e89-8437-3b71-935b-25814d6d59a5",
                                        "entry_id": "446531be-4ebd-3d8f-b097-0249a8fb29f3",
                                        "glosses": [
                                            "To learn (something) to the point where responses become instinctive."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f78be139-de31-390d-9671-2ecb0f132768",
                                        "entry_id": "446531be-4ebd-3d8f-b097-0249a8fb29f3",
                                        "glosses": [
                                            "Mostly when talking about neural networks, to learn a task to the point where responses actually start to degrade. Compare with overfit, in model tuning contexts."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
