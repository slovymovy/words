    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6fb53ffe-04e4-3863-bcbc-fda1be8563b8",
                    "sense_definition": "Trembler de façon involontaire et répétée sous l'effet du froid ou de la fièvre.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tremblement_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sans manteau sous la neige, le jeune homme <w>grelotte</w> de froid en attendant son bus."
                        },
                        {
                            "text": "À cause d'une mauvaise grippe, elle est restée couchée et <w>grelottait</w> malgré ses couvertures épaisses."
                        }
                    ],
                    "synonyms": [
                        "frissonner",
                        "trembler"
                    ],
                    "common_phrases": [
                        "grelotter de froid",
                        "grelotter de fièvre"
                    ]
                },
                {
                    "sense_id": "0850796b-08d8-33d1-8174-3b247d1ae9b0",
                    "sense_definition": "Frémir ou trembler sous le coup d'une vive émotion, en particulier la peur ou l'angoisse.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "tremblement_emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Perdu tout seul au milieu de la forêt sombre, le pauvre enfant <w>grelottait</w> de peur."
                        },
                        {
                            "text": "Caché sous le lit pendant l'orage, le chien terrorisé <w>grelotte</w> sans pouvoir se calmer."
                        }
                    ],
                    "synonyms": [
                        "frémir",
                        "trembler"
                    ],
                    "common_phrases": [
                        "grelotter de peur",
                        "grelotter de frayeur"
                    ]
                },
                {
                    "sense_id": "51f001a5-fe98-3bdd-ab21-e7e5ef53011c",
                    "sense_definition": "En parlant d'une source lumineuse, vaciller faiblement d'une manière intermittente.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "lumiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La flamme de la bougie <w>grelottait</w> dans le courant d'air glacial qui traversait le couloir."
                        },
                        {
                            "text": "Au plafond de la cave abandonnée, une ampoule nue <w>grelottait</w> faiblement dans la pénombre."
                        }
                    ],
                    "synonyms": [
                        "vaciller",
                        "trembloter"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Sens figuré et littéraire"
                        }
                    ]
                }
            ]
        }
    ]
