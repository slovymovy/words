                                            {
                                                "example_id": "9afc8c68-5492-43e4-8a77-38a4878bbc5c",
                                                "sense_id": "b0ab46f2-36b5-3e5c-b88e-1df31010f942",
                                                "text": "Naše hokejová reprezentace navzdory intenzivní přípravě a velkému úsilí nezasáhla do bojů o medaile."
