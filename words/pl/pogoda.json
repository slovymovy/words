{
    "word_family": [
        "pogodny",
        "pogodnie",
        "pogodynka"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2e8a8a0a-f90d-348c-96d4-17e1e07db2f8",
                    "sense_definition": "Ogół zjawisk atmosferycznych (takich jak deszcz, wiatr, temperatura, zachmurzenie) występujących w danym miejscu i czasie.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "meteo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sprawdziłem w internecie, jaka będzie jutro <pogoda>.",
                            "target_lang_translations": {
                                "ru": "Я проверил в интернете, какая завтра будет <погода>.",
                                "en": "I checked online what the <weather> will be like tomorrow."
                            }
                        },
                        {
                            "text": "W górach <pogoda> potrafi zmienić się w ciągu kilku minut.",
                            "target_lang_translations": {
                                "ru": "В горах <погода> может измениться за несколько минут.",
                                "en": "In the mountains, the <weather> can change within a few minutes."
                            }
                        }
                    ],
                    "synonyms": [
                        "aura"
                    ],
                    "antonyms": [
                        "klimat"
                    ],
                    "common_phrases": [
                        "prognoza pogody",
                        "zmienna pogoda",
                        "brzydka pogoda",
                        "warunki pogodowe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совокупность атмосферных явлений (таких как дождь, ветер, температура, облачность) в данном месте и в данное время.",
                        "en": "The state of the atmosphere at a particular place and time, including temperature, wind, and precipitation."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "погода",
                                "target_lang_sense_clarification": "атмосферные условия"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "weather",
                                "target_lang_sense_clarification": "general atmospheric conditions"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eec56f90-eba8-3773-811b-56833649ca5d",
                    "sense_definition": "Słoneczne, bezdeszczowe i sprzyjające warunki atmosferyczne; ładna aura.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "meteo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jeśli w weekend będzie <pogoda>, pojedziemy na wycieczkę rowerową.",
                            "target_lang_translations": {
                                "ru": "Если в выходные будет <хорошая погода>, мы поедем на велосипедную прогулку.",
                                "en": "If the <weather> is good this weekend, we will go for a bike trip."
                            }
                        },
                        {
                            "text": "Musimy korzystać z <pogody>, póki świeci słońce.",
                            "target_lang_translations": {
                                "ru": "Мы должны пользоваться <погодой>, пока светит солнце.",
                                "en": "We must make the most of the <good weather> while the sun is shining."
                            }
                        }
                    ],
                    "synonyms": [
                        "aura"
                    ],
                    "antonyms": [
                        "niepogoda"
                    ],
                    "common_phrases": [
                        "korzystać z pogody",
                        "czekać na pogodę",
                        "mieć pogodę"
                    ],
                    "target_lang_definitions": {
                        "ru": "Солнечные, бездождевые и благоприятные атмосферные условия; хорошая погода.",
                        "en": "Sunny, dry, and pleasant atmospheric conditions; nice weather."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хорошая погода",
                                "target_lang_sense_clarification": "ясная, солнечная"
                            },
                            {
                                "target_lang_word": "погода",
                                "target_lang_sense_clarification": "в значении благоприятных условий"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "good weather",
                                "target_lang_sense_clarification": "pleasant conditions"
                            },
                            {
                                "target_lang_word": "fine weather",
                                "target_lang_sense_clarification": "sunny and clear"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8858e717-378c-3998-8345-bf1cca2a4c38",
                    "sense_definition": "Stan wewnętrznego spokoju, równowagi psychicznej i radości.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "psyche",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mimo wielu problemów życiowych, nigdy nie opuszczała go <pogoda> ducha.",
                            "target_lang_translations": {
                                "ru": "Несмотря на множество жизненных проблем, его никогда не покидала <бодрость> духа.",
                                "en": "Despite many life problems, he never lost his <cheerfulness>."
                            }
                        },
                        {
                            "text": "Jej wrodzona <pogoda> sprawia, że ludzie chętnie z nią rozmawiają.",
                            "target_lang_translations": {
                                "ru": "Её врождённая <жизнерадостность> располагает людей к общению с ней.",
                                "en": "Her innate <cheerfulness> makes people happy to talk to her."
                            }
                        }
                    ],
                    "antonyms": [
                        "smutek",
                        "troska"
                    ],
                    "common_phrases": [
                        "pogoda ducha",
                        "zachować pogodę"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние внутреннего спокойствия, душевного равновесия и радости.",
                        "en": "A state of inner peace, mental balance, and cheerfulness."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жизнерадостность",
                                "target_lang_sense_clarification": "черта характера"
                            },
                            {
                                "target_lang_word": "бодрость",
                                "target_lang_sense_clarification": "в выражении 'бодрость духа'"
                            },
                            {
                                "target_lang_word": "ясность",
                                "target_lang_sense_clarification": "душевное спокойствие"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "cheerfulness",
                                "target_lang_sense_clarification": "disposition"
                            },
                            {
                                "target_lang_word": "good spirits",
                                "target_lang_sense_clarification": "mental state"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25e25f53-747a-3b30-8904-23dcc88a2b4e",
                    "sense_definition": "Zgoda, harmonia i dobre relacje między ludźmi.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dawniej w tym domu panowała wielka <pogoda> i wzajemny szacunek.",
                            "target_lang_translations": {
                                "ru": "Раньше в этом доме царили великое <согласие> и взаимное уважение.",
                                "en": "In the past, great <harmony> and mutual respect reigned in this house."
                            }
                        },
                        {
                            "text": "Sąsiedzi żyli ze sobą w <pogodzie> przez długie lata.",
                            "target_lang_translations": {
                                "ru": "Соседи жили друг с другом в <мире> долгие годы.",
                                "en": "The neighbors lived together in <harmony> for many years."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "współcześnie rzadko używane w tym znaczeniu"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Согласие, гармония и хорошие отношения между людьми.",
                        "en": "Agreement, harmony, and good relationships between people."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "согласие",
                                "target_lang_sense_clarification": "гармония в отношениях"
                            },
                            {
                                "target_lang_word": "мир",
                                "target_lang_sense_clarification": "отсутствие ссор"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "harmony",
                                "target_lang_sense_clarification": "peaceful relations"
                            },
                            {
                                "target_lang_word": "accord",
                                "target_lang_sense_clarification": "agreement"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}