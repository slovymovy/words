                                "sense_id": "e4436898-1226-3682-9984-0bab5297367f",
                                "text": "Hij ging er niet tegenin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1337925-71af-47a2-b3ac-b10acd5ae4b6",
                        "source_entry_id": "4c6e77f3-ee11-38e9-9552-009237d1706d",
                        "source_sense_id": "e4436898-1226-3682-9984-0bab5297367f",
