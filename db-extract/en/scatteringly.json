                        "examples": [
                            {
                                "example_id": "88c5904e-f59d-485e-b0b0-f75a2f5bc7b0",
                                "sense_id": "da7e6564-252b-32b7-bd36-d4e51a0cf4c0",
                                "text": "She pushed cautiously down to the edge of the rocks where the bushes grew scatteringly, pretending to herself that she wanted a bit of wild geranium that flourished in a crevice far below the top."
                            },
                            {
                                "example_id": "7415b97d-db83-496c-8a8a-52b8bfeaed61",
                                "sense_id": "da7e6564-252b-32b7-bd36-d4e51a0cf4c0",
                                "text": "'My father went straight to the hiding-place in full sight of everybody, and got out the fish-hooks and brought them and flung them scatteringly over my head, so that they fell in glittering confusion on the platform at my lover's knee."
                            },
                            {
                                "example_id": "620937fc-96aa-44e1-9a49-d7b818143a7d",
                                "sense_id": "da7e6564-252b-32b7-bd36-d4e51a0cf4c0",
                                "text": "The other men trooped along scatteringly, dodging under the low boughs of the stunted trees."
                            }
                        ]
                    }
