    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0f815390-d380-347f-9b37-2ed3d32d4bc3",
                    "sense_definition": "Engager ou embaucher de nouveaux employés ou collaborateurs dans une entreprise ou une organisation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "embauche",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entreprise cherche à <w>recruter</w> un développeur pour renforcer son équipe technique."
                        },
                        {
                            "text": "Le directeur des ressources humaines a <w>recruté</w> trois nouveaux stagiaires ce mois-ci."
                        }
                    ],
                    "synonyms": [
                        "embaucher",
                        "engager"
                    ],
                    "antonyms": [
                        "licencier",
                        "renvoyer"
                    ],
                    "common_phrases": [
                        "recruter du personnel",
                        "recruter un candidat",
                        "recruter des talents"
                    ]
                },
                {
                    "sense_id": "95138ef6-8c63-37db-8953-6bfc5da9b8c1",
                    "sense_definition": "Amener des personnes à adhérer à un groupe, une association ou un mouvement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "adhesion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette association étudiante souhaite <w>recruter</w> des bénévoles pour organiser son prochain festival."
                        },
                        {
                            "text": "Le parti politique <w>recrute</w> activement de jeunes militants avant les élections régionales."
                        }
                    ],
                    "synonyms": [
                        "enrôler",
                        "rallier"
                    ],
                    "common_phrases": [
                        "recruter des bénévoles",
                        "recruter des adhérents"
                    ]
                },
                {
                    "sense_id": "0309f7ea-2464-301c-ab3b-be7ee47359c2",
                    "sense_definition": "Lever ou enrôler des personnes pour accomplir le service militaire ou intégrer l'armée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement a décidé de <w>recruter</w> des soldats supplémentaires pour surveiller les frontières."
                        },
                        {
                            "text": "Le général <w>recrutait</w> des volontaires dans les villages afin de former une nouvelle division."
                        }
                    ],
                    "synonyms": [
                        "enrôler",
                        "incorporer"
                    ],
                    "antonyms": [
                        "démobiliser"
                    ],
                    "common_phrases": [
                        "recruter des soldats",
                        "recruter une troupe"
                    ]
                },
                {
                    "sense_id": "4f62ca3b-d1aa-3518-a1b2-242672f2c391",
                    "sense_definition": "Repérer et sélectionner des arbres prometteurs destinés à être conservés et exploités plus tard en forêt.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sylviculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le forestier <w>recrute</w> les plus beaux chênes afin de favoriser leur croissance à long terme."
                        },
                        {
                            "text": "Dans cette parcelle, les techniciens ont <w>recruté</w> vingt tiges d'avenir par hectare."
                        }
                    ],
                    "common_phrases": [
                        "recruter des tiges"
                    ]
                }
            ]
        }
    ]
