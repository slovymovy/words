                                "example_id": "cf7b70a7-68da-4cc7-959a-1a525108241a",
                                "sense_id": "eea578ba-ecec-33e7-983b-cb5fec128c96",
                                "text": "Long analyses of this statement by the regular Kremlinologists conveyed the impression that the tripod..has been transferred to Moscow."
                            },
                            {
                                "example_id": "ae0a0d56-b435-4e37-b10a-3e0bbe2903fb",
                                "sense_id": "eea578ba-ecec-33e7-983b-cb5fec128c96",
                                "text": "In his La Russe^([sic]) en 1839, a work still quoted by Kremlinologists today, he warned: ‘They wish to rule the world by conquest.’"
                            }
                        ]
                    }
