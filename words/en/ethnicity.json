{
    "word_family": [
        "ethnic",
        "ethnical",
        "ethnically",
        "ethnocentrism",
        "ethnography",
        "ethnology"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f95782ee-4e70-3889-8c00-5b1c2325bb82",
                    "sense_definition": "The state or fact of belonging to a social group that has a common national or cultural tradition.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "identity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The application form asks for your name, age, and <w>ethnicity</w>.",
                            "target_lang_translations": {
                                "ru": "В анкете требуется указать ваше имя, возраст и <w>национальность</w>.",
                                "zh": "申请表上需要填写你的姓名、年龄和<w>族裔</w>。"
                            }
                        },
                        {
                            "text": "Discrimination based on race or <w>ethnicity</w> is strictly prohibited in this organization.",
                            "target_lang_translations": {
                                "ru": "Дискриминация по признаку расы или <w>этнической принадлежности</w> в этой организации строго запрещена.",
                                "zh": "在该机构中，严禁基于种族或<w>族裔</w>的歧视。"
                            }
                        }
                    ],
                    "synonyms": [
                        "background",
                        "heritage",
                        "descent",
                        "origin"
                    ],
                    "common_phrases": [
                        "mixed ethnicity",
                        "diverse ethnicity",
                        "regardless of ethnicity",
                        "race and ethnicity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принадлежность к социальной группе, имеющей общие национальные или культурные традиции",
                        "zh": "指属于具有共同民族、国家或文化传统的社会群体的状态或事实；族裔身份。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "национальность",
                                "target_lang_sense_clarification": "общеупотребительное"
                            },
                            {
                                "target_lang_word": "этническая принадлежность",
                                "target_lang_sense_clarification": "официальный термин"
                            },
                            {
                                "target_lang_word": "этничность",
                                "target_lang_sense_clarification": "научный/социологический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "族裔",
                                "target_lang_sense_clarification": "指文化或血统背景，常用于表格或正式语境"
                            },
                            {
                                "target_lang_word": "种族",
                                "target_lang_sense_clarification": "常与族裔并提，指社会或族群背景"
                            },
                            {
                                "target_lang_word": "民族",
                                "target_lang_sense_clarification": "指具有共同语言、文化和历史的群体归属"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af094677-f9a8-3687-a76d-a15b0b5561a8",
                    "sense_definition": "A distinct group of people who share a common cultural background or descent.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city is home to people of many different <w>ethnicities</w>.",
                            "target_lang_translations": {
                                "ru": "В этом городе живут люди самых разных <w>национальностей</w>.",
                                "zh": "这座城市居住着许多不同<w>族群</w>的人。"
                            }
                        },
                        {
                            "text": "Representatives from various <w>ethnicities</w> gathered to discuss community issues.",
                            "target_lang_translations": {
                                "ru": "Представители различных <w>этнических групп</w> собрались, чтобы обсудить проблемы общины.",
                                "zh": "来自各个<w>民族</w>的代表齐聚一堂，探讨社区事务。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ethnic group"
                    ],
                    "common_phrases": [
                        "different ethnicities",
                        "various ethnicities",
                        "minority ethnicities"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельная группа людей, имеющих общее культурное происхождение или родословную",
                        "zh": "具有共同文化背景、传统或血统的独立人群或族群。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "этническая группа",
                                "target_lang_sense_clarification": "группа людей"
                            },
                            {
                                "target_lang_word": "национальность",
                                "target_lang_sense_clarification": "в значении «народ»"
                            },
                            {
                                "target_lang_word": "этнос",
                                "target_lang_sense_clarification": "историческая общность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "族群",
                                "target_lang_sense_clarification": "指具有共同文化或血缘特征的人群"
                            },
                            {
                                "target_lang_word": "民族",
                                "target_lang_sense_clarification": "指特定的民族群体"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}