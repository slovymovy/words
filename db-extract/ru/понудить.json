                    },
                    {
                        "form_id": "e8b5291f-90da-4d7d-92e7-87242ae15e98",
                        "entry_id": "a178f5a4-b9c8-31cf-9994-0ab7b626cf1f",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "пону́дивши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3e7f21bb-338c-322f-b082-ccb3c90a2dba",
                        "entry_id": "a178f5a4-b9c8-31cf-9994-0ab7b626cf1f",
                        "glosses": [
                            "книжн. заставить что-нибудь сделать, принудить, побудить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d045bfed-66d3-4ddf-84ce-c3ae70a41ff2",
                                "sense_id": "3e7f21bb-338c-322f-b082-ccb3c90a2dba",
                                "text": "Я побежал к матушке, чтоб понудить её к решению моей судьбы, и поссорился с нею ужасно."
                            },
                            {
                                "example_id": "0999a5a1-c745-4d5c-b859-4000534cc884",
                                "sense_id": "3e7f21bb-338c-322f-b082-ccb3c90a2dba",
                                "text": "Ивор помолился мысленно и понудил коня своего идти живее."
                            },
                            {
                                "example_id": "e7a6374b-2bb7-4a8e-a8ed-246e776c7782",
                                "sense_id": "3e7f21bb-338c-322f-b082-ccb3c90a2dba",
                                "text": "По получении сего понудь себя сесть за стол и начертать мне хоть единое слово."
                            },
                            {
                                "example_id": "7ff461c7-a752-49fb-aa33-9dc8de438442",
                                "sense_id": "3e7f21bb-338c-322f-b082-ccb3c90a2dba",
                                "text": "И тотчас понудил Иисус учеников Своих войти в лодку и отправиться прежде Его на другую сторону, пока Он отпустит народ."
                            }
                        ]
                    }
                ],
