{
    "word_family": [
        "thickness",
        "thicken"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a934d1fc-a3cc-3287-bce6-4aa4f7f1b29b",
                    "sense_definition": "Having a relatively short, heavy, and muscular physical build.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>thickset</w> athlete easily pushed the heavy equipment across the gym floor.",
                            "target_lang_translations": {
                                "zh": "那位<w>矮壮</w>的运动员轻松地将沉重的器械推过了健身房的地板。"
                            }
                        },
                        {
                            "text": "He was a <w>thickset</w> man with broad shoulders and a powerful frame.",
                            "target_lang_translations": {
                                "zh": "他是一个<w>结实</w>的男人，肩膀宽阔，体格强健。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stocky",
                        "stout"
                    ],
                    "antonyms": [
                        "slender",
                        "slim"
                    ],
                    "common_phrases": [
                        "thickset man",
                        "thickset figure"
                    ],
                    "target_lang_definitions": {
                        "zh": "形容人身材矮壮、结实。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "矮壮",
                                "target_lang_sense_clarification": "形容身材矮小而强壮。"
                            },
                            {
                                "target_lang_word": "结实",
                                "target_lang_sense_clarification": "形容身体强壮、肌肉发达。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a1a86aa-61e6-3194-82d6-056fe9f96508",
                    "sense_definition": "Densely crowded together or closely planted.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "density",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They walked through the <w>thickset</w> forest where sunlight barely reached the ground.",
                            "target_lang_translations": {
                                "zh": "他们穿过那片<w>茂密</w>的森林，阳光几乎照不到地面。"
                            }
                        },
                        {
                            "text": "The garden was surrounded by a <w>thickset</w> hedge that provided complete privacy.",
                            "target_lang_translations": {
                                "zh": "花园被一道<w>稠密</w>的树篱环绕，提供了完全的隐私。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dense"
                    ],
                    "antonyms": [
                        "sparse"
                    ],
                    "common_phrases": [
                        "thickset hedge",
                        "thickset wood"
                    ],
                    "target_lang_definitions": {
                        "zh": "形容植物生长茂密，或物体排列紧密。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "茂密",
                                "target_lang_sense_clarification": "形容草木生长得非常繁茂。"
                            },
                            {
                                "target_lang_word": "稠密",
                                "target_lang_sense_clarification": "形容分布得非常密集。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29965458-0bda-3e4b-b2a7-f95b434b5f85",
                    "sense_definition": "Densely covered with many small items or features.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "density",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The path was <w>thickset</w> with sharp thorns that made walking difficult.",
                            "target_lang_translations": {
                                "zh": "小路上<w>布满</w>了尖刺，走起来很困难。"
                            }
                        },
                        {
                            "text": "The old wall was <w>thickset</w> with colorful moss and small flowers.",
                            "target_lang_translations": {
                                "zh": "古老的墙上<w>布满</w>了五颜六色的苔藓和小花。"
                            }
                        }
                    ],
                    "synonyms": [
                        "thick"
                    ],
                    "target_lang_definitions": {
                        "zh": "形容表面覆盖着大量细小物体。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "布满",
                                "target_lang_sense_clarification": "形容某处到处都是某种东西。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f2d457b0-6ed9-3fcb-851a-e31947bf99d3",
                    "sense_definition": "A durable, twilled cotton fabric similar to corduroy or velveteen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "textile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The worker wore trousers made of heavy <w>thickset</w> to protect his legs.",
                            "target_lang_translations": {
                                "zh": "工人穿着由<w>厚斜纹棉布</w>制成的裤子来保护双腿。"
                            }
                        },
                        {
                            "text": "His jacket was crafted from a sturdy <w>thickset</w> that lasted for many years.",
                            "target_lang_translations": {
                                "zh": "他的夹克是用一种耐用的<w>厚斜纹棉布</w>制成的，穿了很多年。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to a specific historical type of fabric."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种耐磨的斜纹棉布，类似于灯芯绒。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "厚斜纹棉布",
                                "target_lang_sense_clarification": "指代一种历史上的厚实棉质织物。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec832f2f-a2ea-3d05-9cbd-eb49abde1ac1",
                    "sense_definition": "A piece of clothing made from thickset fabric.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "textile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He replaced his worn-out <w>thicksets</w> with a new pair of trousers.",
                            "target_lang_translations": {
                                "zh": "他换掉了那条磨损的<w>厚棉布裤</w>，换上了一条新裤子。"
                            }
                        },
                        {
                            "text": "The farmer worked in the fields wearing his reliable <w>thicksets</w>.",
                            "target_lang_translations": {
                                "zh": "农夫穿着他那耐穿的<w>厚棉布裤</w>在田里干活。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to historical work clothing."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "用厚斜纹棉布制成的衣物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "厚棉布裤",
                                "target_lang_sense_clarification": "指代用该面料制成的旧式工作裤。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69f1f6af-5bac-3eda-9dfb-8138f851c90a",
                    "sense_definition": "A thick, dense hedge.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "density",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garden was enclosed by tall <w>thicksets</w> that blocked the wind.",
                            "target_lang_translations": {
                                "zh": "花园被高大的<w>密篱</w>围住，挡住了风。"
                            }
                        },
                        {
                            "text": "Birds often nested within the tangled <w>thicksets</w> at the edge of the property.",
                            "target_lang_translations": {
                                "zh": "鸟儿经常在庄园边缘那纠缠的<w>密篱</w>中筑巢。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "茂密的树篱。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "密篱",
                                "target_lang_sense_clarification": "指代生长得非常茂密的树篱。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}