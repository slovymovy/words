                "senses": [
                    {
                        "sense_id": "56e739d6-6399-3d51-986f-922b752b498c",
                        "entry_id": "81a6d35b-a281-3d49-97c9-5453bdedfb51",
                        "glosses": [
                            "To dismiss from the imagination as though never dreamed."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9408263e-0ea8-4588-9892-7adb3d892408",
                                "sense_id": "56e739d6-6399-3d51-986f-922b752b498c",
                                "text": "Dreams, whether waking or sleeping ones, continue part of us. We can't undream them. We are roused out of them, but they remain."
                            },
                            {
                                "example_id": "d37e047c-9c1c-4d9e-9d51-213e35cd7697",
                                "sense_id": "56e739d6-6399-3d51-986f-922b752b498c",
                                "text": "This is all like a dream now; but I can't undream it, and I can't resist it. I must go."
                            }
                        ]
                    }
                ],
