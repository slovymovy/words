                                        "entry_id": "c2ac6d80-c080-3988-8ee6-8d3185a7136b",
                                        "glosses": [
                                            "Qui peut être apprécié."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08507764-b78e-4511-8dfb-2d956b0f321c",
                                                "sense_id": "e34132f5-d206-3869-b914-ce04c27c7463",
                                                "text": "Même s’ils sont plus ou moins fréquentés, les espaces verts de la cité angérienne sont appréciés… et appréciables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ad5a9b2-cbb9-3e73-b14d-42eae47e5589",
                                        "entry_id": "c2ac6d80-c080-3988-8ee6-8d3185a7136b",
                                        "glosses": [
                                            "Qui peut être apprécié par les sens ou avec le secours des procédés physiques ; dont on peut évaluer le poids, l’intensité, la durée, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31b20a4b-e1d0-4691-8927-7005f0291d5e",
                                                "sense_id": "8ad5a9b2-cbb9-3e73-b14d-42eae47e5589",
                                                "text": "Cette quantité est si petite qu’elle n’est pas appréciable."
                                            },
                                            {
                                                "example_id": "c406c261-245b-489c-88e7-8d97d51f073e",
                                                "sense_id": "8ad5a9b2-cbb9-3e73-b14d-42eae47e5589",
                                                "text": "Un son appréciable."
                                            }
                                        ]
