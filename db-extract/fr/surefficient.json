                "senses": [
                    {
                        "sense_id": "719154df-62ff-3574-87b1-27a67f415b29",
                        "entry_id": "885b6c75-69f0-30f3-9654-05c621d67fb1",
                        "glosses": [
                            "Se dit d’un individu possédant des capacités naturelles (intellectuelles, mentales, etc.) ou des fonctionnements nettement différents de la moyenne de la population dans plusieurs domaines d’habileté : créatif, artistique, sportif, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52a11a65-1508-4cd1-bbfd-f358d0aa07d0",
                                "sense_id": "719154df-62ff-3574-87b1-27a67f415b29",
                                "text": "Du fait de cette finesse de perception, les personnes surefficientes vivent les évènements de leur vie avec une intensité hors norme."
                            },
                            {
                                "example_id": "ffb0ef53-8a55-42ae-8c01-6a638ff3959c",
                                "sense_id": "719154df-62ff-3574-87b1-27a67f415b29",
                                "text": "Les nombreux ouvrages consacrés à la souffrance de l’adulte surefficient incitent à douter de sa capacité à être heureux."
                            },
                            {
                                "example_id": "5c98d6dd-4163-4e47-8c32-acf7c924ef61",
                                "sense_id": "719154df-62ff-3574-87b1-27a67f415b29",
                                "text": "Si on se rappelle qu’un des critères pour remarquer un enfant surefficient est qu'il pose très tôt des questions dérangeantes sur la vie et la mort, l'infini, les tenants et aboutissants du bonheur, on comprend bien que se poser des questions, avoir le cerveau qui tourne en continue et surtout pour des questions sans réponses, c’est angoissant, voire seulement désespérant, triste."
                            }
                        ]
                    }
                ],
