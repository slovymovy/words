                ],
                "translations": [
                    {
                        "translation_id": "acd4b803-1e27-4bd3-8f0f-6031ae8d6cef",
                        "source_entry_id": "2af2288f-7c2a-394e-abae-c25a6f50d9c4",
                        "source_sense_id": "aa703b37-e216-3d50-8c33-7b7c8cc8ace0",
                        "source_sense_description": "Hausierer; Reisender in religiösen Büchern, Schriften und Traktaten",
                        "target_lang_word": "Kolporteur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kolporteur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6571ab86-90a4-3291-9d0e-a0fc26a7cff6",
                                        "entry_id": "2953dc65-a666-3a09-b39e-f056fa30dabe",
                                        "glosses": [
                                            "Hausierer in billigen Heften, Schriften und Büchern, besonders religiöser Art"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8813e879-1d51-4aea-8b28-44416c8ec860",
                                                "sense_id": "6571ab86-90a4-3291-9d0e-a0fc26a7cff6",
                                                "text": "Ab 1924 beteiligte er sich hauptamtlich als Kolporteur an der Verbreitung der biblischen Veröffentlichungen, die in Magdeburg gedruckt wurden."
                                            },
                                            {
                                                "example_id": "1874e5b8-0924-4d27-a685-4ec85cf9520d",
                                                "sense_id": "6571ab86-90a4-3291-9d0e-a0fc26a7cff6",
                                                "text": "„Als ich Signor Grimaldi fragte, wie ich mir das ›Journal des Savants‹, den ›Mercure de France‹ und andere Zeitschriften dieser Art verschaffen könne, versprach er, mir einen Kolporteur zu schicken, der alles besorgen würde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "289edeef-1d2c-349a-b550-86e81bd7b393",
                                        "entry_id": "2953dc65-a666-3a09-b39e-f056fa30dabe",
                                        "glosses": [
                                            "eine Person, die Gerüchte verbreitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7890191e-3265-401d-86d5-3c0250eef189",
                                                "sense_id": "289edeef-1d2c-349a-b550-86e81bd7b393",
                                                "text": "Dieser Kolporteur hat behauptet, ich sei ein feindlicher Agent!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a6f3385b-66e8-3584-917a-47c0d1bd3861",
                                        "entry_id": "2953dc65-a666-3a09-b39e-f056fa30dabe",
                                        "glosses": [
                                            "Straßenverkäufer von Zeitungen"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "400b4c38-e707-4389-b2cc-02e58894f6a9",
                                                "sense_id": "a6f3385b-66e8-3584-917a-47c0d1bd3861",
                                                "text": "Er verdiente sich ein paar Schilling als Kolporteur."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "822ed0fd-51ff-3200-aba5-b4f0788ecf88",
                                        "entry_id": "2953dc65-a666-3a09-b39e-f056fa30dabe",
                                        "glosses": [
                                            "Verteiler von Pendlerzeitungen"
                                        ],
                                        "tags": [
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06e022f8-84de-47f6-9516-81e7319a1ef1",
                                                "sense_id": "822ed0fd-51ff-3200-aba5-b4f0788ecf88",
                                                "text": "Als Kolporteur muss man früh aufstehen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "604ade6f-e57b-4914-aebc-c1dc11c528fc",
                        "source_entry_id": "2af2288f-7c2a-394e-abae-c25a6f50d9c4",
                        "source_sense_id": "aa703b37-e216-3d50-8c33-7b7c8cc8ace0",
                        "source_sense_description": "Hausierer; Reisender in religiösen Büchern, Schriften und Traktaten",
                        "target_lang_word": "colporteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "colporteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6ac81c37-7fda-3312-85e8-b43da9d790f4",
                                        "entry_id": "6f1f2977-1a1c-3cff-9277-773e9bfcdb8b",
                                        "glosses": [
                                            "Petit marchand ambulant qui portait ses marchandises sur son dos ou dans des mannes, dans des caisses, etc. de porte en porte."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e00f61b-294b-4ed1-9d6e-8790f5aef05e",
                                                "sense_id": "6ac81c37-7fda-3312-85e8-b43da9d790f4",
                                                "text": "Je vis, à cinquante pas devant moi, le colporteur Pinacle, avec sa grande hotte, son bonnet de loutre, ses gants de laine et son bâton à pointe de fer."
                                            },
                                            {
                                                "example_id": "af389c31-3986-4999-8f62-ba7ed5f1261c",
                                                "sense_id": "6ac81c37-7fda-3312-85e8-b43da9d790f4",
                                                "text": "Le colporteur a beau ne passer qu’une fois par an, il laisse quand même assez de Veillée des Chaumières à deux liards, pour qu’on connaisse jusqu’ici Garibaldi, le maréchal Prim et les exigences de la liberté. Déjà, on ne peut plus ignorer son siècle nulle part."
                                            },
                                            {
                                                "example_id": "278ab489-170e-4d06-98c3-c67d2c5ffb6e",
                                                "sense_id": "6ac81c37-7fda-3312-85e8-b43da9d790f4",
                                                "text": "C'est ce qui explique à la fois le caractère rachitique du secteur commercial créé par les petits colporteurs et boutiquiers chinois, et son développement à pas de tortue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b574fc2-de82-39c9-b195-a08ee4d1b1fb",
                                        "entry_id": "6f1f2977-1a1c-3cff-9277-773e9bfcdb8b",
                                        "glosses": [
                                            "Celui qui colporte des ragots ou des nouvelles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6ad463c-567f-4140-802c-ac4e29369a6a",
                                                "sense_id": "8b574fc2-de82-39c9-b195-a08ee4d1b1fb",
                                                "text": "Un colporteur de fausses nouvelles."
                                            }
                                        ]
                                    }
                                ]
                            }
