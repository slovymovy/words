                                    {
                                        "sense_id": "57bc1c3d-8ded-35c4-aaad-e5270f7f3d10",
                                        "entry_id": "63129d8a-214a-3157-91f9-c9e7e7288cc4",
                                        "glosses": [
                                            "baumbewohnendes australisches Beuteltier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72f47264-7dc2-48ef-8d1f-73de1a0b804e",
                                                "sense_id": "57bc1c3d-8ded-35c4-aaad-e5270f7f3d10",
                                                "text": "Koalas fressen fast ausschließlich Eukalyptus."
                                            },
                                            {
                                                "example_id": "61356c57-1f91-4555-a024-5dc808d886a0",
                                                "sense_id": "57bc1c3d-8ded-35c4-aaad-e5270f7f3d10",
                                                "text": "„Zudem sollen besonders unfallträchtige Straßenabschnitte gesichert werden, ein neues Koala-Hospital soll sich um erkrankte Tiere kümmern, und über eine neue Telefon-Hotline sollen Bürger Informationen über Koalas in Not übermitteln können.“"
                                            },
                                            {
                                                "example_id": "92d9b265-1ca7-4dfb-bb3f-c8557e620e11",
                                                "sense_id": "57bc1c3d-8ded-35c4-aaad-e5270f7f3d10",
                                                "text": "„Ein Tierarzt stellte fest, dass der Koala unverletzt war, lediglich das Fell war an einigen Stellen versengt worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
