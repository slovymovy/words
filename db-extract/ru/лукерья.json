                            {
                                "example_id": "fd67701f-c701-4855-b09e-f3de546b8dbb",
                                "sense_id": "b740d7b4-3c81-3167-b426-69d8e5c1242b",
                                "text": "Меня зовут Лукерья."
                            },
                            {
                                "example_id": "9874daab-9d9b-4c85-b9c5-7f5d83387143",
                                "sense_id": "b740d7b4-3c81-3167-b426-69d8e5c1242b",
                                "text": "Тётка Лукерья, ведущая праздник, рассказала об угро-финских купальских обрядах."
                            },
                            {
                                "example_id": "b760503e-785f-4cc9-a8c5-918f3a7d2b0c",
                                "sense_id": "b740d7b4-3c81-3167-b426-69d8e5c1242b",
                                "text": "Лукерья говорила очень тихо и слабо, но без остановки."
                            }
                        ]
                    }
