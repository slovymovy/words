                "senses": [
                    {
                        "sense_id": "edbdfe4e-aaab-33bf-9da2-bd857c1413bf",
                        "entry_id": "5ab68857-e66e-3f15-a989-396915ec4cf1",
                        "glosses": [
                            "Cépage donnant du raisin de table mais aussi de cuve (pour faire du vin). Son nom officiel au catalogue des espèces est chasselas blanc."
                        ],
                        "tags": [
                            "Viticulture"
                        ],
                        "examples": [
                            {
                                "example_id": "45ae947b-e85c-4a35-aff0-a2f9573b4bd0",
                                "sense_id": "edbdfe4e-aaab-33bf-9da2-bd857c1413bf",
                                "text": "Une grappe de chasselas."
                            },
                            {
                                "example_id": "15556ebc-c1a6-4b1e-bd0d-09a5173fa8b0",
                                "sense_id": "edbdfe4e-aaab-33bf-9da2-bd857c1413bf",
                                "text": "L’ombre endeuillait le lit à baldaquin, les solives du plafond où l’on avait suspendu des branches de chasselas de la dernière récolte, des grappes fripées et poussiéreuses."
                            },
                            {
                                "example_id": "d1e3344e-0ab2-4df9-b4cb-b79542eb7280",
                                "sense_id": "edbdfe4e-aaab-33bf-9da2-bd857c1413bf",
                                "text": "Pour le raisin de table, les cépages les plus connus sont le chasselas et le muscat."
                            },
                            {
                                "example_id": "7494621f-85ec-44b3-9502-2828a3da2ad4",
                                "sense_id": "edbdfe4e-aaab-33bf-9da2-bd857c1413bf",
                                "text": "Chasselas de Thomery."
                            }
                        ]
                    }
                ],
