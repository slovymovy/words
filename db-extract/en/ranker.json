                        "examples": [
                            {
                                "example_id": "e3bd629c-b523-46df-8e44-779fc3a5a1ab",
                                "sense_id": "5a6e68b6-517d-3733-8828-84bcee4f0a05",
                                "text": "But the difference between the first ranker Maharashtra and the second ranker Tamil Nadu was so sharp that Tamil Nadu's value added was just 40 per cent of that of Maharashtra."
                            },
                            {
                                "example_id": "bc6f58fe-22ec-46c4-98dd-f253f27e3c6f",
                                "sense_id": "5a6e68b6-517d-3733-8828-84bcee4f0a05",
                                "text": "Mike, as an adult chimpanzee, was a low ranker."
                            },
                            {
                                "example_id": "7164f3fd-5c43-4935-b686-24543ba6fa75",
                                "sense_id": "5a6e68b6-517d-3733-8828-84bcee4f0a05",
                                "text": "I become Starr high ranker the next Sunday, setting a school record for reaching Fifth Level in the minimum amount of time."
                            },
                            {
                                "example_id": "9f7e5cbb-7cd1-4b9f-82ea-654219bf8607",
                                "sense_id": "5a6e68b6-517d-3733-8828-84bcee4f0a05",
                                "text": "When it comes to academics, you are a first ranker throughout."
                            }
                        ]
                    }
