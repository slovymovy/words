                                        "glosses": [
                                            "Very, extremely; thoroughly but lamentably; excessively."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cba0326-7055-492f-8e20-a0e2174e50bc",
                                                "sense_id": "48923f7f-2834-37f6-b781-20b9b1768213",
                                                "text": "Teenage pregnancies are all too common in the UK."
                                            },
                                            {
                                                "example_id": "094b6948-513e-491e-beb9-5edbaebb47ca",
                                                "sense_id": "48923f7f-2834-37f6-b781-20b9b1768213",
                                                "text": "Sexism is all too familiar in this department."
                                            },
                                            {
                                                "example_id": "fb4095e4-3ed3-4cb2-9d02-b615919f3ac0",
                                                "sense_id": "48923f7f-2834-37f6-b781-20b9b1768213",
                                                "text": "They were all too ready to sell their stories to the press."
                                            },
                                            {
                                                "example_id": "bc2aba49-19be-4bb8-a817-9c1109e18cb5",
                                                "sense_id": "48923f7f-2834-37f6-b781-20b9b1768213",
                                                "text": "It was over all too soon."
                                            },
                                            {
                                                "example_id": "9f57e132-1c2f-4b65-a846-b498ed86a3b0",
                                                "sense_id": "48923f7f-2834-37f6-b781-20b9b1768213",
                                                "text": "a robot will not be subject to all-too-human fits of anger, sadism or cruelty."
                                            },
                                            {
                                                "example_id": "1f3e0e19-9898-4d2c-9067-55c638ccf50d",
                                                "sense_id": "48923f7f-2834-37f6-b781-20b9b1768213",
                                                "text": "And you call me up again just to break me like a promise\nSo casually cruel in the name of being honest\nI'm a crumpled up piece of paper lying here\n'Cause I remember it all, all, all too well"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
