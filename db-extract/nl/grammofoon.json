                    {
                        "translation_id": "b688b9fd-ce42-45d2-929b-8bc4f0a31b5f",
                        "source_entry_id": "9b1b5921-14ad-3184-8648-a907c061c17f",
                        "source_sense_id": "4170d016-444c-38d2-a2a3-53e1cb273b77",
                        "target_lang_word": "record-player",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "record-player",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef150ad8-0520-338b-9aa4-2fe54dbe67b8",
                                        "entry_id": "f75853d7-f8af-3304-8c72-f0539334f4d5",
                                        "glosses": [
                                            "Alternative form of record player."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf84fc7d-0659-4aba-838c-640c7c593986",
                                                "sense_id": "ef150ad8-0520-338b-9aa4-2fe54dbe67b8",
                                                "text": "“Hey, Clever,” he said to our bombardier, “will you-all do a fellow a big favor and carry my phonograph records under your seat? I’ll take my record-player along in my plane and we’ll meet in Chungking and have us some razz-ma-tazz,” and Shorty practically trucked on away from us through the turmoil. Clever shrugged and put the can of hot records under his seat."
                                            },
                                            {
                                                "example_id": "cbe161e3-1739-4590-a7d3-5540bce6e42e",
                                                "sense_id": "ef150ad8-0520-338b-9aa4-2fe54dbe67b8",
                                                "text": "Here’s a bit of humor from a website: “What makes you think the prisoner was drunk?” asked the judge. “Well, your honor,” replied the arresting officer, “I saw him lift up a manhole cover and walk away with it, and when I asked him what it was for, he said, ‘I want to listen to it on my record-player!’”"
                                            },
                                            {
                                                "example_id": "4ec19e35-cad5-446b-8876-ac22e149bb78",
                                                "sense_id": "ef150ad8-0520-338b-9aa4-2fe54dbe67b8",
                                                "text": "Getting to know a record is like reading a book. It’s like having characters in the room with you. I moved house recently and found my old record-player. I sat and listened to a dozen old records, it was very rewarding."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
