                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ff3452f-b00a-479a-994e-d4f17274631e",
                                                "sense_id": "dec24544-911d-3afd-bedb-7c9b5c622bd0",
                                                "text": "In der Satzfolge: „Peter ist krank. Er liegt im Bett. Er fühlt sich nicht wohl.“ ist „er“ eine Anapher."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5b6c0438-f2ff-3201-957f-65e22e81d59a",
                                        "entry_id": "93006b44-9cfd-301d-b809-ede6d0fed25e",
                                        "glosses": [
                                            "Wiederholung von Wörtern oder Wortgruppen am Anfang von Sätzen oder Versen"
                                        ],
