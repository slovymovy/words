                        "examples": [
                            {
                                "example_id": "7aab0e38-cfc4-4526-b98e-7cb95def5c62",
                                "sense_id": "077a577e-d3f1-3db9-8c12-7a9ddd5328c3",
                                "text": "One must especially be alert, moreover, to distinguish popular materials, whether literary or nonliterary, from a kind of “pseudopopular” based on the current marketing of the Renaissance, through star-system phenomena like Kenneth Branagh and theme park-style Renaissance festivals."
                            },
                            {
                                "example_id": "8b68213d-c7c6-400d-b78b-69e314564600",
                                "sense_id": "077a577e-d3f1-3db9-8c12-7a9ddd5328c3",
                                "text": "To us, the final step of Richard's coup, the pseudopopular offer of the crown, looks like a grand display of theatrical fireworks. But to the gullible spectators-within-the play, it is a political bludgeoning."
                            }
                        ]
                    }
