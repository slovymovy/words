                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b8d7f9d-ede8-4030-ab17-0858cc1365f9",
                                "sense_id": "f124edda-aced-3c53-88e9-ca4b7ba184f0",
                                "text": "Zo voelen wij ons eveneens genoodzaakt Gods goedgunstigheden nadrukkelijk bij u aan te bevelen."
                            }
                        ]
                    }
                ],
