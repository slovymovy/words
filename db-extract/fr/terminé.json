                                                "example_id": "1cbf42f1-f842-483f-a23a-267e6ceb7279",
                                                "sense_id": "aa4c638e-c060-3baa-9251-d1ae039779f1",
                                                "text": "I done made some real bad choices with my life"
                                            },
