                        "examples": [
                            {
                                "example_id": "a0ae9cab-0d77-4ebd-9660-6c8cceafa8ad",
                                "sense_id": "c5d87ca1-cdd4-339e-a494-7dd3cb474637",
                                "text": "[…], il venait d'apercevoir, penchée sur un morceau de chevreau auquel elle cousait des élastiques, la silhouette invraisemblable, mais trop connue pour qu'il s'y trompât, d'une ancienne greloteuse haut cotée sur l’asphalte parisien."
                            },
                            {
                                "example_id": "2a79bb0f-75dd-4ba5-abf0-1c3b153fa3f3",
                                "sense_id": "c5d87ca1-cdd4-339e-a494-7dd3cb474637",
                                "text": "La vieille grelotteuse qui tapinait rue Saint-Martin, toujours avec son cabas, d'où sortaient parfois des poireaux ou des fanes de carottes."
                            }
                        ]
                    },
                    {
                        "sense_id": "bfb19f5e-471a-3b90-a64c-4c804d9a92b3",
                        "entry_id": "1a392392-35ba-3429-827b-27df6a077855",
                        "glosses": [
                            "Un des noms vernaculaires de la bruyère cendrée."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "84b9e6ec-8294-4bfd-a661-d254a608db4b",
                                "sense_id": "bfb19f5e-471a-3b90-a64c-4c804d9a92b3",
                                "text": "Le rucher se composait de 75 ruches avec 10 à 12 k. d'abeilles. La récolte se faisait sur une petite bruyère, dite la grelotteuse (Erica cinerea). Le miel récolté était si clair, que le fond du seau en était visible."
                            }
                        ]
