                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d37b20a7-d8e3-4dc1-84f7-707076e2b302",
                                                "sense_id": "f5fcbea3-9176-30cc-a20c-cc80ce6f773f",
                                                "text": "That's a bearing wall."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bearing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f0b45a7-b31e-31db-a939-37e51b51219b",
                                        "entry_id": "8ae4688c-935d-3e28-933d-d807ac040fc5",
                                        "glosses": [
                                            "A mechanical device that supports another part or reduces friction."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d859cbab-fca3-31e8-beeb-201c4797e914",
                                        "entry_id": "8ae4688c-935d-3e28-933d-d807ac040fc5",
                                        "glosses": [
                                            "The horizontal angle between the direction of an object and another object, or between it and that of true north; a heading or direction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72861016-0dd3-463e-8158-24ccaec97c8d",
                                                "sense_id": "d859cbab-fca3-31e8-beeb-201c4797e914",
                                                "text": "This volume would have been at least twice as large, if I had not made bold to strike out innumerable passages relating to the winds and tides, as well as to the variations and bearings in the several voyages, together with the minute descriptions of the management of the ship in storms, in the style of sailors; likewise the account of longitudes and latitudes; [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0b3bc98-93dc-30a6-b675-be34dd9b9786",
                                        "entry_id": "8ae4688c-935d-3e28-933d-d807ac040fc5",
                                        "glosses": [
                                            "One's understanding of one's orientation or relative position, literally or figuratively."
                                        ],
                                        "tags": [
                                            "especially",
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28851b97-a0a4-4768-a1a8-720c49ee9e27",
                                                "sense_id": "f0b3bc98-93dc-30a6-b675-be34dd9b9786",
                                                "text": "Do we go left here or straight on? Hold on, let me just get my bearings."
                                            },
                                            {
                                                "example_id": "2803f8b1-eb9f-43d0-bacd-d5018a83c2fd",
                                                "sense_id": "f0b3bc98-93dc-30a6-b675-be34dd9b9786",
                                                "text": "I started a new job last week, and I still haven't quite found my bearings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d540f65-7abf-3399-96f2-d8f5246a7236",
                                        "entry_id": "8ae4688c-935d-3e28-933d-d807ac040fc5",
                                        "glosses": [
                                            "Relevance; a relationship or connection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0da9d22-d7b1-4824-a890-06488d35caa9",
                                                "sense_id": "9d540f65-7abf-3399-96f2-d8f5246a7236",
                                                "text": "That has no bearing on this issue."
                                            },
                                            {
                                                "example_id": "34ca4fa5-330a-4469-8178-a99a9e042e2d",
                                                "sense_id": "9d540f65-7abf-3399-96f2-d8f5246a7236",
                                                "text": "But of this frame, the bearings and the ties, / The strong connections, nice dependencies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "789bbc4b-6ca4-3058-bfe7-88801c68ccc0",
                                        "entry_id": "8ae4688c-935d-3e28-933d-d807ac040fc5",
                                        "glosses": [
                                            "One's posture, demeanor, or manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f15a8d0f-daee-49d7-84e7-2ddd39a5809d",
                                                "sense_id": "789bbc4b-6ca4-3058-bfe7-88801c68ccc0",
                                                "text": "She walks with a confident, self-assured bearing."
                                            },
                                            {
                                                "example_id": "83d34490-e4d3-447c-bfcf-4ee12cbc7edd",
                                                "sense_id": "789bbc4b-6ca4-3058-bfe7-88801c68ccc0",
                                                "text": "I know him by his bearing."
                                            },
                                            {
                                                "example_id": "d9c9fbd2-b52a-470b-bf64-b0fd761741cc",
                                                "sense_id": "789bbc4b-6ca4-3058-bfe7-88801c68ccc0",
                                                "text": "The little green men were clearly professional soldiers by their bearing, carried Russian weapons, and wore Russian combat fatigues, but they had no identifying insignia. Vladimir Putin originally denied they were Russian soldiers; that April, he confirmed they were."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a854e7cb-995c-3f74-9a5b-499608e46580",
                                        "entry_id": "8ae4688c-935d-3e28-933d-d807ac040fc5",
                                        "glosses": [
                                            "That part of any member of a building which rests upon its supports."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40b54fce-f325-4206-a5d7-4c657edbcf75",
                                                "sense_id": "a854e7cb-995c-3f74-9a5b-499608e46580",
                                                "text": "A lintel or beam may have four inches of bearing upon the wall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae5f22ff-307b-3c03-bba7-3b40cf7a69de",
                                        "entry_id": "8ae4688c-935d-3e28-933d-d807ac040fc5",
                                        "glosses": [
                                            "The portion of a support on which anything rests."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "39779bac-4d69-33d8-9aed-9d9051b2a96c",
                                        "entry_id": "8ae4688c-935d-3e28-933d-d807ac040fc5",
                                        "glosses": [
                                            "The unsupported span."
                                        ],
                                        "tags": [
                                            "proscribed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5395a862-a185-4747-9cbd-d35a28d51e59",
                                                "sense_id": "39779bac-4d69-33d8-9aed-9d9051b2a96c",
                                                "text": "The beam has twenty feet of bearing between its supports."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ec9fa3f-26a9-32f1-bd30-59f70fa6154e",
                                        "entry_id": "8ae4688c-935d-3e28-933d-d807ac040fc5",
                                        "glosses": [
                                            "Any single emblem or charge in an escutcheon or coat of arms."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c29a3c80-fc28-47d2-8861-4d4a0c1b48cc",
                                                "sense_id": "0ec9fa3f-26a9-32f1-bd30-59f70fa6154e",
                                                "text": "Holonyms: shield, escutcheon"
                                            },
                                            {
                                                "example_id": "daecac4a-3095-4062-9cfe-b3ac05c65113",
                                                "sense_id": "0ec9fa3f-26a9-32f1-bd30-59f70fa6154e",
                                                "text": "[…]when the French seized Malta they were by no means so delicate. They effaced armorial bearings with their usual hot-headed eagerness; and a few years after they had torn down the coats of arms of the gentry, the heroes of Malta and Egypt were busy devising heraldry for themselves, and were wild to be barons and counts of the empire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f85c5488-67f1-4adc-b758-6d54d18d4552",
                        "source_entry_id": "22efd5b9-e382-3839-b7ce-c2ed8dafb687",
                        "source_sense_id": "370f63e3-83c7-3350-ab21-55c72293c305",
                        "source_sense_description": "een constructie die er ...",
                        "target_lang_word": "roulement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roulement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "72564887-a116-3f05-8ad7-88ef1b4101ad",
                                        "entry_id": "8a7df267-ccb9-38ad-ad55-1652c44023d5",
                                        "glosses": [
                                            "Mouvement de ce qui roule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfc2f150-3dcb-4d01-adbf-516de1ac4787",
                                                "sense_id": "72564887-a116-3f05-8ad7-88ef1b4101ad",
                                                "text": "Le roulement de cette voiture fait grand bruit sur le pavé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44df59c7-3e7c-32b2-abd5-f91b2c8933f0",
                                        "entry_id": "8a7df267-ccb9-38ad-ad55-1652c44023d5",
                                        "glosses": [
                                            "Bruit produit par ce qui roule."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4857f090-e0d9-49ec-9e88-70d970b7955c",
                                                "sense_id": "44df59c7-3e7c-32b2-abd5-f91b2c8933f0",
                                                "text": "Le roulement des voitures."
                                            },
                                            {
                                                "example_id": "901f1e59-5564-4d24-b3d5-bf6d34874c25",
                                                "sense_id": "44df59c7-3e7c-32b2-abd5-f91b2c8933f0",
                                                "text": "— Entendez-vous ? dit-elle.\n— Oui, le roulement d’une voiture."
                                            },
                                            {
                                                "example_id": "25d998ff-fd95-46f9-9415-815dda10dba8",
                                                "sense_id": "44df59c7-3e7c-32b2-abd5-f91b2c8933f0",
                                                "text": "On n’entendait que le roulement monotone de l’eau heurtant à petits coups semi-métalliques le couvercle en fonte de la marmite […]."
                                            },
                                            {
                                                "example_id": "c051696f-74bd-49c5-898d-675b14bc495f",
                                                "sense_id": "44df59c7-3e7c-32b2-abd5-f91b2c8933f0",
                                                "text": "Un bruit semblable à un très furtif roulement de dés attira mon attention vers les marches de bois cru par où l’on accédait à la véranda. Lentement, délibérément, une gazelle gravissait le perron."
                                            },
                                            {
                                                "example_id": "220f5382-ad38-407f-aea3-c6da018a94e9",
                                                "sense_id": "44df59c7-3e7c-32b2-abd5-f91b2c8933f0",
                                                "text": "Pour mon père, j’ai conservé avec une perfection inouïe le roulement de son accent méridional, quand il citait ce vers de Victor Hugo : « Ce champ couvert de morts sur qui tombait la nuit »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82bb26b2-1a1b-3d0c-84fa-58503393ccef",
                                        "entry_id": "8a7df267-ccb9-38ad-ad55-1652c44023d5",
                                        "glosses": [
                                            "Bruit formé par un ou par plusieurs tambours que l’on bat continuellement à coups égaux et pressés."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38b317f1-4315-4923-be97-a2a2c6d0ef2c",
                                                "sense_id": "82bb26b2-1a1b-3d0c-84fa-58503393ccef",
                                                "text": "La fête se termina par des réjouissances bruyantes : musique, sonneries de clairons, roulements de tambours, fantasias échevelées, décharges retentissantes d’artillerie et de mousqueterie, — une orgie de couleurs, de mouvement et de bruit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fae22425-df71-3a96-b640-783d393a33cf",
                                        "entry_id": "8a7df267-ccb9-38ad-ad55-1652c44023d5",
                                        "glosses": [
                                            "Bruit lointain du tonnerre."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd21581c-6d76-46d7-ae69-b62bb1f453f0",
                                                "sense_id": "fae22425-df71-3a96-b640-783d393a33cf",
                                                "text": "Le roulement du tonnerre."
                                            },
                                            {
                                                "example_id": "8c9b9d66-b593-489c-824b-cd5c8108dbaf",
                                                "sense_id": "fae22425-df71-3a96-b640-783d393a33cf",
                                                "text": "On entendait de lointains roulements de tonnerre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97df5a16-038e-35d4-844b-fd1347bfc297",
                                        "entry_id": "8a7df267-ccb9-38ad-ad55-1652c44023d5",
                                        "glosses": [
                                            "Action de se remplacer alternativement dans certaines fonctions."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3931743a-88c6-4e54-a0a5-f93e4a274d37",
                                                "sense_id": "97df5a16-038e-35d4-844b-fd1347bfc297",
                                                "text": "Le docteur : Et des malades, vous en avez eu beaucoup ?\nKnock : Trente-cinq.\nLe docteur : Tout le monde alors ?\nKnock : Oui, tout le monde.\nLe docteur : Mais comment le bateau a-t-il pu marcher ?\nKnock : Un petit roulement à établir."
                                            },
                                            {
                                                "example_id": "70fdfa86-6acd-46e4-956a-590834c60ff0",
                                                "sense_id": "97df5a16-038e-35d4-844b-fd1347bfc297",
                                                "text": "C’est un dimanche après-midi que Tarrou et Rambert choisirent pour se diriger vers le stade. Ils étaient accompagnés de Gonzalès, le joueur de football, que Rambert avait retrouvé, et qui avait fini par accepter de diriger par roulement la surveillance du stade."
                                            }
