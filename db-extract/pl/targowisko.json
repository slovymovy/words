                                        "glosses": [
                                            "luogo tipico di città e paesi con differenti banchi o bancharelle, generalmente per acquisto di frutta, alimenti vari, abiti, fiori ed altro"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "becb1884-c3c1-43ac-aff9-b7b2c47f9315",
                                                "sense_id": "0e6e785c-38a1-3a17-a6b9-665c1597b5be",
                                                "text": "tra qualche giorno andremo a fare la spesa al mercato"
                                            },
                                            {
                                                "example_id": "3f0df954-d27f-4f33-baa5-5871b34cd1a8",
                                                "sense_id": "0e6e785c-38a1-3a17-a6b9-665c1597b5be",
                                                "text": "Ho trovato questa collana al mercato sotto casa mia"
                                            }
                                        ]
                                    },
