        "fr-extract.jsonl": [
            {
                "entry_id": "e6fcfd58-7802-3027-848b-84d6874bf88e",
                "word": "harmonieusement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ecbf0974-1683-3c96-9331-24c9be0ae328",
                        "entry_id": "e6fcfd58-7802-3027-848b-84d6874bf88e",
                        "glosses": [
                            "Avec harmonie, d’une manière harmonieuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f699a6f-3bea-4f61-9550-6892b9cac912",
                                "sense_id": "ecbf0974-1683-3c96-9331-24c9be0ae328",
                                "text": "Il lui semblait que, dans ce pays, les jours et les mois s'écoulaient plus doucement, plus harmonieusement qu'ailleurs.."
                            },
                            {
                                "example_id": "15ebed19-c458-4f89-b75e-8957b1e713ec",
                                "sense_id": "ecbf0974-1683-3c96-9331-24c9be0ae328",
                                "text": "Les Mangaréviens, qui chantaient harmonieusement, se servaient fort mal de la mandoline et de l'accordéon, et jadis leurs instruments préférés pour les danses étaient les tambours en bois."
                            }
                        ]
                    },
                    {
                        "sense_id": "e34d4c2b-3925-3ee1-b26a-7779e104daef",
                        "entry_id": "e6fcfd58-7802-3027-848b-84d6874bf88e",
                        "glosses": [
                            "Dans un arrangement harmonieux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0af57764-66a5-4f69-adc4-c13409c9243d",
                                "sense_id": "e34d4c2b-3925-3ee1-b26a-7779e104daef",
                                "text": "Répartissez harmonieusement les fruits sur 4 feuilles de papier sulfurisé grassement beurrées."
                            },
                            {
                                "example_id": "bece2bd6-a923-4986-828f-5e5f84392095",
                                "sense_id": "e34d4c2b-3925-3ee1-b26a-7779e104daef",
                                "text": "Ainsi Ondriane s’ennuyait. Présentement, les activités et les distractions du palais et de ses environs ne parvenaient plus à remplir harmonieusement ses journées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "478e9ef6-09ef-4687-a33f-0c84fa4e7531",
                        "source_entry_id": "e6fcfd58-7802-3027-848b-84d6874bf88e",
                        "target_lang_word": "harmoniously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "harmoniously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "39d26375-61b2-32bb-9f75-21811ce1a0c1",
                                        "entry_id": "7b33aece-e370-3d95-af43-c60a22234950",
                                        "glosses": [
                                            "In a harmonious manner; coordinately."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27bc641e-8445-4424-bdcc-e959af16fbb9",
                                                "sense_id": "39d26375-61b2-32bb-9f75-21811ce1a0c1",
                                                "text": "Close beside a tranquil pool, for the moonbeams melted harmoniously into its quiet depths, was an old tree."
                                            },
                                            {
                                                "example_id": "09466ca4-411a-4de6-995a-724b3c70051a",
                                                "sense_id": "39d26375-61b2-32bb-9f75-21811ce1a0c1",
                                                "text": "They, therefore, began to work more harmoniously, and finally were amalgamated on August 13, 1859, […]."
                                            },
                                            {
                                                "example_id": "1c95ef31-7c69-40df-bf7b-173f387b8652",
                                                "sense_id": "39d26375-61b2-32bb-9f75-21811ce1a0c1",
                                                "text": "Danziger’s new Green Dragon, a delicate and airy Lepidium, is a unique green filler for flower arrangements that blends harmoniously in any centerpiece or bouquet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc477647-cc4d-47a4-aa18-b1bc64bf1b2e",
                        "source_entry_id": "e6fcfd58-7802-3027-848b-84d6874bf88e",
                        "target_lang_word": "melodiously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "melodiously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01cbb16d-79a4-333e-a86f-b82c5e62e16e",
                                        "entry_id": "88871827-7c27-3581-ad89-26082a47254b",
                                        "glosses": [
                                            "In a melodious manner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e6546d5-f7df-4a5c-9e17-533395586dc9",
                        "source_entry_id": "e6fcfd58-7802-3027-848b-84d6874bf88e",
                        "target_lang_word": "musically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "musically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28d1700a-cea5-3de0-b71b-ed29cd04101f",
                                        "entry_id": "e182cc98-338e-32ad-9607-410731a03e80",
                                        "glosses": [
                                            "In a musical manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e82bf195-008e-4079-a3c6-fe54d9e5ccb4",
                                                "sense_id": "28d1700a-cea5-3de0-b71b-ed29cd04101f",
                                                "text": "The wind chimes tinkled musically in the breeze."
                                            },
                                            {
                                                "example_id": "8807fc57-f6ec-441e-a6b5-aa14c1158df6",
                                                "sense_id": "28d1700a-cea5-3de0-b71b-ed29cd04101f",
                                                "text": "Something might alſo be ſaid of the choice of Words, in our refined Engliſh Tongue; which are to be liked and approved according to their tone, and the ſweetneſs of their cadence, that is, as they run muſically in the Ear."
                                            },
                                            {
                                                "example_id": "2cf2c1c3-95b2-48cd-bb8b-a1015ee26473",
                                                "sense_id": "28d1700a-cea5-3de0-b71b-ed29cd04101f",
                                                "text": "[…] with accents muſically ſweet\nA tender voice his wondring ear allur'd."
                                            },
                                            {
                                                "example_id": "1038eb1c-01c2-47f4-8800-97e08c139019",
                                                "sense_id": "28d1700a-cea5-3de0-b71b-ed29cd04101f",
                                                "text": "A gentle breeze fills the huge sail of our dhow, and draws us through the water that ripples musically against her sides."
                                            },
                                            {
                                                "example_id": "94799692-345d-4893-bd42-2547f5d5c449",
                                                "sense_id": "28d1700a-cea5-3de0-b71b-ed29cd04101f",
                                                "text": "Prill laughed musically[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50e7454c-1450-36eb-9192-c7db6ce6d2c4",
                                        "entry_id": "e182cc98-338e-32ad-9607-410731a03e80",
                                        "glosses": [
                                            "In terms of music."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d851ff1d-41a3-49e9-b3a1-01f42de12534",
                                                "sense_id": "50e7454c-1450-36eb-9192-c7db6ce6d2c4",
                                                "text": "The film looked good, but was musically lacking."
                                            },
                                            {
                                                "example_id": "6648f021-e2c8-428e-a9a1-25a1cfba7c57",
                                                "sense_id": "50e7454c-1450-36eb-9192-c7db6ce6d2c4",
                                                "text": "He's alſo muſically given, and ſo light of Heel, that there are few People can out-walk him."
                                            },
                                            {
                                                "example_id": "00d6020e-7e15-4ebc-81a8-c09d1ab5b081",
                                                "sense_id": "50e7454c-1450-36eb-9192-c7db6ce6d2c4",
                                                "text": "Each sings the tune and words independently of his predecessor and follower, and their blending, though a collision of three sets of words and three sets of notes, is musically coherent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
