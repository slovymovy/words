                "senses": [
                    {
                        "sense_id": "3eda089d-6694-3236-a66f-df43f77402bf",
                        "entry_id": "add9dda2-5613-3291-9df9-e1ff34631d5e",
                        "glosses": [
                            "Eigenschaft/Einstellung einer Person, verständnisvolle, verzeihende Güte zu zeigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2576991c-4756-4314-9633-4432987172e7",
                                "sense_id": "3eda089d-6694-3236-a66f-df43f77402bf",
                                "text": "„Nachsichtigkeit ist ein Attribut, von Mitgefühl und Großherzigkeit geprägt, das uns, zunächst allgemein ausgedrückt, Fehler, Schwächen, Misserfolge verzeihen lässt.“"
                            },
                            {
                                "example_id": "7f1bdd53-52ef-47e1-b26e-95fc1d320f83",
                                "sense_id": "3eda089d-6694-3236-a66f-df43f77402bf",
                                "text": "„Es gab mit Sicherheit genügend Nachsichtigkeit gegenüber dem Benehmen des Jungen, seine feierliche Würde schien jedoch gänzlich zu fehlen.“"
                            },
                            {
                                "example_id": "211651b4-f612-4247-b1b5-e5abbdc6171e",
                                "sense_id": "3eda089d-6694-3236-a66f-df43f77402bf",
                                "text": "„Er dachte nicht daran, mich zu schonen, und hielt es für nötig, die kleinen Nachsichtigkeiten meiner Mutter zu korrigieren, dennoch gestand er mir eine gewisse zukünftige Macht zu, die er in den anderen nicht sah.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
