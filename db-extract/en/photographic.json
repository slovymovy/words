                        "examples": [
                            {
                                "example_id": "9633b0bc-a24b-4e07-b056-d8e5317ad007",
                                "sense_id": "fd72ebad-c458-3b18-b676-dee2d304be31",
                                "text": "This shop stocks all the latest photographic equipment."
                            },
                            {
                                "example_id": "c8816404-b3dc-4214-8dff-c1b03f1fca50",
                                "sense_id": "fd72ebad-c458-3b18-b676-dee2d304be31",
                                "text": "There is also a fine dance and concert hall, a capacious reading room, a well-appointed billiards room with five tables, various committee and games rooms, photographic dark rooms, and a small but compact ladies' lounge."
                            }
                        ]
                    },
                    {
                        "sense_id": "397d30a8-62a0-3ff6-b33e-43c709f097c5",
                        "entry_id": "7e0a0328-88b4-3247-a9a6-8c6a936234a6",
                        "glosses": [
                            "Synonym of accurate."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "3a0d3149-3b53-48b6-93dd-de808a57be25",
                                "sense_id": "397d30a8-62a0-3ff6-b33e-43c709f097c5",
                                "text": "What each evangelist preserved is not a photographic reproduction of the words and deeds of Jesus, but an interpretative portrait delineated in accord with the special needs of the early church."
                            }
                        ]
                    }
                ],
