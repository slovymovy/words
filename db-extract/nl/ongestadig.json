                "senses": [
                    {
                        "sense_id": "3f2d031e-8b4a-349b-bf85-8b10ffaa7fd5",
                        "entry_id": "e3b8aca3-2276-3fcf-9e35-94d77a2d15f3",
                        "glosses": [
                            "steeds veranderen in richting, gedrag en denkwijze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6d86fa6-0421-4be8-b409-44df9bd04f67",
                                "sense_id": "3f2d031e-8b4a-349b-bf85-8b10ffaa7fd5",
                                "text": "Liepen de mieren nu nog ongestadig heen en weer, aanstonds zouden ze ook stil blijven zitten: dat betekende dan, dat de feitelijke vraat was aangevangen."
                            },
                            {
                                "example_id": "6881ba77-462a-4b13-ab09-f92d2906942e",
                                "sense_id": "3f2d031e-8b4a-349b-bf85-8b10ffaa7fd5",
                                "text": "Jammer blijft ondertussen wel dat het in de politiek soms wel erg weinig lijkt te draaien om de beste ideeën, en wel erg veel om de best gecommuniceerde emoties. Wat regelmatig resulteert in een onduidelijke en ongestadige koers."
                            }
                        ]
                    }
