                "senses": [
                    {
                        "sense_id": "a73ba27c-bf5a-303a-a222-ac69542a3ff3",
                        "entry_id": "e2048c7b-7e88-3311-87ba-29f426c5c9fa",
                        "glosses": [
                            "spuitstuk op het einde van een brandslang waar water onder hoge druk en snelheid wegspuit om een brand te kunnen blussen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "406786cd-2643-44b7-b07f-d06283ac622b",
                                "sense_id": "a73ba27c-bf5a-303a-a222-ac69542a3ff3",
                                "text": "Glunderend zet de jongen de blinkende brandweerhelm op zijn hoofd en richt even de straalpijp. Met voldoening maakt vader de foto. Het is deze middag aardig druk in het Internationale Brandweermuseum van Rijssen."
                            },
                            {
                                "example_id": "491941ac-7ed5-42cc-9147-17d2177c4318",
                                "sense_id": "a73ba27c-bf5a-303a-a222-ac69542a3ff3",
                                "text": "'De uitrusting is beter dan toen in de jaren negentig de norm van zes werd vastgesteld', zegt Stephan Wevers, NVBR-bestuurslid en brandweercommandant in Twente. 'Negen van de tien keer hebben we door grote tanks op de wagen geen extra water meer nodig. En door hogedruk-straalpijpen en fijne nevels kunnen we sneller blussen.'"
                            }
                        ]
                    },
                    {
                        "sense_id": "0d19ae93-5ffe-3530-a3e1-b2b5c030c0e9",
                        "entry_id": "e2048c7b-7e88-3311-87ba-29f426c5c9fa",
                        "glosses": [
                            "uitstroom opening van een raketmotor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39a9f362-545e-4e80-ac90-6a57e0770758",
                                "sense_id": "0d19ae93-5ffe-3530-a3e1-b2b5c030c0e9",
                                "text": "In een resistojet wordt stuwstof in een buisje verhit door een verwarmingselement. De energie die daarvoor nodig is, wordt geleverd door de zonnepanelen van de satelliet. De opgewarmde stuwstof wordt vervolgens uitgestoten via een straalpijp, waarop de satelliet van koers verandert, legt Cervone uit."
                            }
                        ]
                    }
                ],
