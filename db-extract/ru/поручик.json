                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aaa4f239-b4d3-42ab-8aa9-e2a6656340b7",
                                                "sense_id": "aff38bc7-d74a-3299-a973-9a5cf8c16847",
                                                "text": "Porucznik momentalnie poczerwieniał na twarzy. Nic nie odpowiedział, bo najwyraźniej go zamurowało"
