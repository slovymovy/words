                    },
                    {
                        "translation_id": "748016d6-c70b-4083-af2c-4ad5f3f73a63",
                        "source_entry_id": "683b0a28-2700-3b3b-8a65-b8b722e85b00",
                        "source_sense_id": "f1795fa3-ee4a-39cc-81e6-15725198da2d",
                        "target_lang_word": "окта́эдр",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "окта́эдр",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1cbc6915-97cd-3ccc-b0a9-4cfda8a979ee",
                                        "entry_id": "2993b412-fbb6-3243-b8b9-3381ad48bb5a",
                                        "glosses": [
                                            "геометр. выпуклый правильный многогранник, имеющий восемь треугольных, в виде равностороннего треугольника, граней"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "285ba0bb-314e-47d7-b31a-738ecb00354d",
                                                "sense_id": "1cbc6915-97cd-3ccc-b0a9-4cfda8a979ee",
                                                "text": "Понятие золотого сечения, или пропорции, было известно ещё в Древнем Египте, его применяли при сооружении пирамид. Широкое распространение оно получило и в Древней Греции благодаря Пифагору, который использовал это правило для своей модели мира и построения симметричных многогранников: кубов, октаэдров, тетраэдров и додекаэдров .."
                                            },
                                            {
                                                "example_id": "3c01be8c-ed9d-4b57-b10e-af2c3b69c207",
                                                "sense_id": "1cbc6915-97cd-3ccc-b0a9-4cfda8a979ee",
                                                "text": ".. в правильном многоугольнике может быть какое угодно количество сторон, в правильном же многограннике количеством граней может служить лишь одно из следующих пяти чисел: четыре (у тетраэдра), шесть (у куба, он же гексаэдр), восемь (у октаэдра), двенадцать (у додекаэдра) или двадцать (у икосаэдра) .."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
