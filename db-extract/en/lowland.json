                    {
                        "translation_id": "f309b326-06a3-4416-86fd-7a135d1cc4bf",
                        "source_entry_id": "72079d56-3449-3f48-b9ef-d342818c308e",
                        "source_sense_id": "1f8fa0b2-0c5a-38af-96da-eea7e5c2f64b",
                        "source_sense_description": "area which is lower than surroundings",
                        "target_lang_word": "Tiefebene",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tiefebene",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f84ac27b-55d5-34e4-b47e-958635683131",
                                        "entry_id": "3c6992b2-91e4-3e4e-b300-1feca5a8bd46",
                                        "glosses": [
                                            "tief (das heißt: in geringer Höhe über dem Meeresspiegel) gelegene Ebene"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3350c1df-7cd7-492b-8c98-f511466d71f3",
                                                "sense_id": "f84ac27b-55d5-34e4-b47e-958635683131",
                                                "text": "„Um die norddeutsche Tiefebene aber machten die schönen Dinge der damaligen Zeit einen großen Bogen.“"
                                            },
                                            {
                                                "example_id": "e860b129-dd99-4ed9-8db8-488a6ceb87c8",
                                                "sense_id": "f84ac27b-55d5-34e4-b47e-958635683131",
                                                "text": "„Die Tiefebene blieb zurück, und die Berge begannen zu wachsen.“"
                                            },
                                            {
                                                "example_id": "69b2d485-6aa5-49c9-b397-ad3d25b36ebf",
                                                "sense_id": "f84ac27b-55d5-34e4-b47e-958635683131",
                                                "text": "„Er gründete seine eigene Dynastie der Changamire Rozvi und drängte die Portugiesen endgültig in die Tiefebene an der Ostküste ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "918db729-b444-4f1f-8127-aa8cbd1ea4e6",
                        "source_entry_id": "72079d56-3449-3f48-b9ef-d342818c308e",
                        "source_sense_id": "1f8fa0b2-0c5a-38af-96da-eea7e5c2f64b",
                        "source_sense_description": "area which is lower than surroundings",
                        "target_lang_word": "Tiefland",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tiefland",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7b4addfc-5ee3-397a-983b-e02898b0a1d4",
                                        "entry_id": "9244a736-dd31-3a58-a7ca-630346558e5e",
                                        "glosses": [
                                            "tiefer gelegene Landfläche ohne nennenswerte Erhebungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bea81c8c-a58e-4a22-99bb-ea4b82f7e3f1",
                                                "sense_id": "7b4addfc-5ee3-397a-983b-e02898b0a1d4",
                                                "text": "„Das am Rande der Alpen beginnende slowenische Tiefland erinnert an Süd- und Südwestdeutschland und auch an (Nord-)Frankreich.“"
                                            },
                                            {
                                                "example_id": "4edc13fa-6948-4873-a182-e292dbaf367c",
                                                "sense_id": "7b4addfc-5ee3-397a-983b-e02898b0a1d4",
                                                "text": "„Sioux-Sprachen waren ursprünglich über weite Teile des zentralen Tieflands Nordamerikas verbreitet, von Kanada bis zum Mississippi, von den Appalachen bis zu den Rocky Mountains.“"
                                            },
                                            {
                                                "example_id": "d9ec9efe-4b24-42cd-9b69-c5af14a44493",
                                                "sense_id": "7b4addfc-5ee3-397a-983b-e02898b0a1d4",
                                                "text": "„Auf der anderen Seite des Tieflandes beginnen die weiten Heiden, die Südland und Nordland voneinander trennen, Arnarvatnsheidi und Tvídaegra, und der Wanderer war hungrig und ohne Wegzehrung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de3f7383-6d4d-4351-980f-8611ec819e12",
                        "source_entry_id": "72079d56-3449-3f48-b9ef-d342818c308e",
                        "source_sense_id": "1f8fa0b2-0c5a-38af-96da-eea7e5c2f64b",
                        "source_sense_description": "area which is lower than surroundings",
                        "target_lang_word": "Flachland",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flachland",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "943f7a94-f202-3bba-88cf-63c0590a8e35",
                                        "entry_id": "4f5590b5-2892-395f-a524-99acb39c8a4a",
                                        "glosses": [
                                            "Gegend, Gelände ohne nennenswerte Erhebungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01f6c726-1110-49f6-a67e-8cbcd46772e4",
                                                "sense_id": "943f7a94-f202-3bba-88cf-63c0590a8e35",
                                                "text": "Norddeutschland ist vielerorts ein Flachland."
                                            },
                                            {
                                                "example_id": "c209c646-85bf-4e53-b3e1-a99439d1702c",
                                                "sense_id": "943f7a94-f202-3bba-88cf-63c0590a8e35",
                                                "text": "„Der Golfstrom, der an der Insel vorbeistreift, macht die Winter im Flachland milde.“"
                                            },
                                            {
                                                "example_id": "4b5cd000-07a1-4079-a1b1-7354557a8690",
                                                "sense_id": "943f7a94-f202-3bba-88cf-63c0590a8e35",
                                                "text": "„Der Aeroclub Hoyerswerda hat seit einiger Zeit auch eine Sektion Gleitschirmfliegen. Auch mitten im platten Flachland wird diese Trend-Luftsportart also betrieben.“"
                                            },
                                            {
                                                "example_id": "ed8f0f82-a442-42e8-b45e-6cb6443bc5d0",
                                                "sense_id": "943f7a94-f202-3bba-88cf-63c0590a8e35",
                                                "text": "„Das ist, besonders im Flachlande, auch mit dem besten VW nicht möglich.“"
                                            },
                                            {
                                                "example_id": "9da91f83-5882-4f04-82e9-5b62217f2cde",
                                                "sense_id": "943f7a94-f202-3bba-88cf-63c0590a8e35",
                                                "text": "„Und unter solchem Selbstgespräche trat er noch einmal ans offene Fenster und sah über die zunächst gelegene kleine Gartenanlage fort in das Flachland hinaus, an dessen äußerstem Rande die Türme von Quedlinburg aufragten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
