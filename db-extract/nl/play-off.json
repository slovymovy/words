                        "glosses": [
                            "een competitie of wedstrijd na de reguliere competitie om een bepaalde beslissing (kampioenschap, promotie, Europeesvoetbal) te bepalen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a749285-e310-4228-841b-fbafea749bf8",
                                "sense_id": "dd2abf7b-7b44-32b2-923d-c68e6204fc24",
                                "text": "Alle zeilen werden nog bijgezet om tenminste die historische play-off tegen Australië te organiseren in Libanon, Qatar of de Verenigde Arabische Emiraten – ergens waar je een soort thuisvoordeel zou voelen. Helaas, het wordt toch weer Maleisië."
                            },
                            {
                                "example_id": "b0476103-1f2f-40c8-af82-010302212df9",
                                "sense_id": "dd2abf7b-7b44-32b2-923d-c68e6204fc24",
                                "text": "De Nederlandse volleybalsters zijn in Bakoe overtuigend doorgedrongen tot de kwartfinales op het EK. In een play-off tegen Kroatië zegevierde Oranje met 3-0."
                            }
                        ]
                    }
