                "forms": [],
                "senses": [
                    {
                        "sense_id": "d0627e49-702f-3852-b951-902cb1a5416f",
                        "entry_id": "4d201a5b-47dc-31f1-bfae-b08938124b83",
                        "glosses": [
                            "A city in South Korea."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1fa2128-eaa5-4098-a08b-b1e6302c5a69",
                                "sense_id": "d0627e49-702f-3852-b951-902cb1a5416f",
                                "text": "The South Korean Coast Guard has confirmed that on Aug. 16 it found a man stranded with a Jet Ski-type vehicle on a mud flat off the country’s west coast, near the city of Incheon. In a statement, it said the man, whom it did not identify, had been detained Sunday on suspicion of entering South Korea illegally by sea from China."
                            },
                            {
                                "example_id": "73f2d72a-29c2-41d8-8653-3e2d6018b895",
                                "sense_id": "d0627e49-702f-3852-b951-902cb1a5416f",
                                "text": "South Korea's Yeonpyeong Island is situated in the Yellow Sea. It is located approximately 80 kilometres west of Incheon and 12 kilometres south of the coastline of Hwanghae Province, North Korea."
                            },
                            {
                                "example_id": "3bf53b32-f9e6-42c5-a2c3-ee306e151eb0",
                                "sense_id": "d0627e49-702f-3852-b951-902cb1a5416f",
                                "text": "At 8am local time, Seoul recorded about 440 micrograms per cubic meter of dust, while the nearby city of Incheon reported 349 micrograms, according to the Korean Meteorological Administration (KMA).\nGyeonggi Province, which surrounds the capital and Incheon, recorded 424 micrograms, and Gangwon Province, east of the capital region, recorded 329 micrograms."
                            }
                        ]
                    }
