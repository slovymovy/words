                "senses": [
                    {
                        "sense_id": "2cac7ddf-c36c-3f0d-9f74-b7ff6eb9da99",
                        "entry_id": "10365bd5-f30a-3658-8c4b-3e1f1298c30a",
                        "glosses": [
                            "Enlever le carbone qui s’est déposé à l’intérieur de (quelque chose)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88e2145d-3782-4e55-9918-20fbc8671500",
                                "sense_id": "2cac7ddf-c36c-3f0d-9f74-b7ff6eb9da99",
                                "text": "Si, d’un point de vue théorique, les fonctionnements des unités de distillation atmosphérique et sous vide sont liés (aucune raison de fonctionner l’une sans l’autre), une telle disposition entraîne une interdépendance des deux unités, qui peut constituer un handicap lorsque l’on décoke le four sous vide par exemple, alors que le four atmosphérique n’est généralement pas à décoker."
                            },
                            {
                                "example_id": "bb3b3bdd-4d38-4288-8c5b-0c56a7109bdd",
                                "sense_id": "2cac7ddf-c36c-3f0d-9f74-b7ff6eb9da99",
                                "text": "Grâce à elle, le carbone ne se dépose plus dans les tubes et le taux de conversion par passe peut être plus élevé; il n’est plus besoin d’arrêter fréquemment l’unité pour décoker;"
                            },
                            {
                                "example_id": "839178d6-ca85-469d-a669-10ae834b7848",
                                "sense_id": "2cac7ddf-c36c-3f0d-9f74-b7ff6eb9da99",
                                "text": "Mais un vapocraqueur industriel doit être arrêté tous les deux ou trois mois pour le décoker."
                            }
                        ]
                    }
                ],
