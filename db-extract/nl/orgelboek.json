                "senses": [
                    {
                        "sense_id": "3e8f5685-6501-3e09-a2df-c235e9682823",
                        "entry_id": "998ee288-f22f-3b83-983d-932cecd18f85",
                        "glosses": [
                            "boek dat een draaiorgel kan aansturen voor het spelen van bepaalde muziek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26951262-20d8-4dc5-b0d1-6183a85e13f6",
                                "sense_id": "3e8f5685-6501-3e09-a2df-c235e9682823",
                                "text": "De stichting Stadsorgel De Tukker Enschede ontvangt twee nieuwe orgelboeken. Hans Meijer van de landelijke Kring van Draaiorgelvrienden overhandigt Stichtingsvoorzitter Benno Molenkamp uit Haaksbergen een dik boek met draaiorgelmuziek van de Engelandvaardersmars."
                            }
                        ]
                    },
                    {
                        "sense_id": "560858ae-feaf-399c-a260-8575dfb9f407",
                        "entry_id": "998ee288-f22f-3b83-983d-932cecd18f85",
                        "glosses": [
                            "muziekboek waarin partituren voor orgelmuziek staan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f25dd5f5-28c3-480d-9bcf-31305920828c",
                                "sense_id": "560858ae-feaf-399c-a260-8575dfb9f407",
                                "text": "„Het nieuwe ”Orgelboek” is niet alleen bruikbaar voor organisten uit kerken die de nieuwe gezangbundel zullen gebruiken”, aldus de aankondiging. „Want het orgelboek bevat heel veel voorspelen en zettingen van gezangen uit de bundel ”Negentig Gezangen” en het Gereformeerd Kerkboek uit 2006.”"
                            },
                            {
                                "example_id": "2925e929-5775-4fb5-b97f-f7a6df155f8c",
                                "sense_id": "560858ae-feaf-399c-a260-8575dfb9f407",
                                "text": "De veerconstructie is van invloed op de manier waarop het orgel bespeeld moet worden, ontdekte Rühling. „Als je de toetsen met je duim aanslaat, maak je een zijwaartse beweging. Door de veer beweegt de toets dan ook zijwaarts; dat leidt tot onzuiver aanspelen en beschadigingen aan de veer. Later hoorde ik dat de vroegste orgelboeken uit de Renaissance ook aanraden om bij orgels met veerconstructies de duimen niet te gebruiken.”"
                            }
                        ]
                    }
