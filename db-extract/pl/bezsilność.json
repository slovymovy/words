                "senses": [
                    {
                        "sense_id": "855eb40a-9494-3069-a2e8-2bc1c4a5a5b1",
                        "entry_id": "b3b9acd2-96b2-3f8a-827b-67ce06fec6f9",
                        "glosses": [
                            "cecha tego, co bezsilne; cecha osoby bezsilnej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efb71f7f-205f-43b1-b3d8-839d0ad71668",
                                "sense_id": "855eb40a-9494-3069-a2e8-2bc1c4a5a5b1",
                                "text": "Pomyślał o tych, którzy musieli zginąć z bezsilności, wspomniał, jak święta Elżbieta, kiedy żyła jeszcze na ziemi, ona, święta jego domu i jego dzieciństwa, szlachetna księżna Turyngii, wysoko znamienita pani, sama chodziła w najuboższe miejsca i przynosiła chorym pocieszenie i odświeżenie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "639e1f61-64e5-439c-8047-14e66592f353",
                        "source_entry_id": "b3b9acd2-96b2-3f8a-827b-67ce06fec6f9",
                        "source_sense_id": "855eb40a-9494-3069-a2e8-2bc1c4a5a5b1",
                        "target_lang_word": "powerlessness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "powerlessness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1272f5d-e736-3f01-a382-471ec75e242f",
                                        "entry_id": "37f00ab7-a5b7-3c7f-b62f-a9752a5c635b",
                                        "glosses": [
                                            "The state or character of being powerless; absence or lack of power."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78840afb-0bde-4383-8c63-ddf7ef9012c6",
                                                "sense_id": "c1272f5d-e736-3f01-a382-471ec75e242f",
                                                "text": "Near-synonym: helplessness"
                                            },
                                            {
                                                "example_id": "f9ef7ef0-8d05-4c11-8a40-5a8699093894",
                                                "sense_id": "c1272f5d-e736-3f01-a382-471ec75e242f",
                                                "text": "In July 1717, a commission established by Orléans to adjudicate the issue had emphatically denied the successoral claims of the two brothers, and the Regent declared himself in a state of ‘happy powerlessness to alienate the crown's domain’."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6222ab3e-4d98-4324-a550-b956e0b09dcb",
                        "source_entry_id": "b3b9acd2-96b2-3f8a-827b-67ce06fec6f9",
                        "source_sense_id": "855eb40a-9494-3069-a2e8-2bc1c4a5a5b1",
                        "target_lang_word": "Hilflosigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hilflosigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3662122e-3269-3f38-a5e3-2ce17e9c3c46",
                                        "entry_id": "77738840-b399-3f0a-938c-0b52377ad400",
                                        "glosses": [
                                            "Zustand, dass man sich selbst nicht helfen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15718ecb-0403-42d4-968e-10a0c49137b9",
                                                "sense_id": "3662122e-3269-3f38-a5e3-2ce17e9c3c46",
                                                "text": "„Am Vorbend hält der Herzog eine Ansprache an die Mädchen und Frauen, worin er ihnen ihre Hilflosigkeit vor Augen führt.“"
                                            },
                                            {
                                                "example_id": "fae52608-9465-446e-a362-1a6f91f1e503",
                                                "sense_id": "3662122e-3269-3f38-a5e3-2ce17e9c3c46",
                                                "text": "„Oft fehlte etwas auf den Bildern, was wiederum die Hilflosigkeit symbolisierte.“"
                                            },
                                            {
                                                "example_id": "6d5d1acb-d797-40a7-a3a3-12971fd31a93",
                                                "sense_id": "3662122e-3269-3f38-a5e3-2ce17e9c3c46",
                                                "text": "„Jana sah Maxim an und spürte nichts als Hilflosigkeit.“"
                                            },
                                            {
                                                "example_id": "fa6cdf18-2efd-4dd8-8316-10224fed7792",
                                                "sense_id": "3662122e-3269-3f38-a5e3-2ce17e9c3c46",
                                                "text": "„Immer sagten sie das, diese Bündel aus Anmut, Selbstsucht und Hilflosigkeit, wenn sie darangingen, einem das Herz zu zerreißen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5758dcaa-7653-31fb-8777-6e5b0603ea8b",
                                        "entry_id": "77738840-b399-3f0a-938c-0b52377ad400",
                                        "glosses": [
                                            "Gefühl, nicht zu wissen, was man tun kann/sollte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "245569c6-9390-4963-940a-539f60ce5b65",
                                                "sense_id": "5758dcaa-7653-31fb-8777-6e5b0603ea8b",
                                                "text": "„Jana sah Maxim an und spürte nichts als Hilflosigkeit.“"
                                            },
                                            {
                                                "example_id": "2ae0dcb7-dfe7-45b1-b1d1-90495a784701",
                                                "sense_id": "5758dcaa-7653-31fb-8777-6e5b0603ea8b",
                                                "text": "„Immer sagten sie das, diese Bündel aus Anmut, Selbstsucht und Hilflosigkeit, wenn sie darangingen, einem das Herz zu zerreißen.“"
                                            },
                                            {
                                                "example_id": "2506d29b-8426-4b84-a176-643364d8bfe0",
                                                "sense_id": "5758dcaa-7653-31fb-8777-6e5b0603ea8b",
                                                "text": "„Elisabeth überkam ein Gefühl großer Hilflosigkeit.“"
                                            },
                                            {
                                                "example_id": "10421e31-c21f-4579-87a3-371895720133",
                                                "sense_id": "5758dcaa-7653-31fb-8777-6e5b0603ea8b",
                                                "text": "„Ihr Gesicht hat die Hilflosigkeit von jemandem, an den man nicht mehr glaubt.“"
                                            },
                                            {
                                                "example_id": "3ceba5cb-ed95-483a-b25f-68037d7b78fa",
                                                "sense_id": "5758dcaa-7653-31fb-8777-6e5b0603ea8b",
                                                "text": "„Mit diesem Gesicht konnte ich Karriere machen, konnte sogar an der Sache Heuchelei begehen, die mir in all ihrer Hilflosigkeit, in ihrer Dummheit, die relativ sympathischste war: die Sache, an die Edgar Wieneken glaubte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fdddb57a-742d-4ae1-afec-4aa40ff78e4f",
                        "source_entry_id": "b3b9acd2-96b2-3f8a-827b-67ce06fec6f9",
                        "source_sense_id": "855eb40a-9494-3069-a2e8-2bc1c4a5a5b1",
                        "target_lang_word": "Machtlosigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Machtlosigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e1f527ca-0496-37b2-9d51-5a373f5d11fd",
                                        "entry_id": "38d5b317-3168-3c19-b4cf-32f30bfe48c1",
                                        "glosses": [
                                            "die Eigenschaft, keine Macht zu haben; der Zustand machtlos zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6579dcee-7f25-4647-b5b6-ee53f212d768",
                                                "sense_id": "e1f527ca-0496-37b2-9d51-5a373f5d11fd",
                                                "text": "Die Machtlosigkeit der neuen Behörde lässt an ihrem Sinn zweifeln."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72fee1b2-fbe1-4e7d-a039-e2abf127c66c",
                        "source_entry_id": "b3b9acd2-96b2-3f8a-827b-67ce06fec6f9",
