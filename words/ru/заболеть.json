{
    "word_family": [
        "болезнь",
        "больной",
        "болеть",
        "болезненный"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2af6eba6-31b8-39ca-baf6-a2347ab3090c",
                    "sense_definition": "стать больным, начать страдать от какой-либо болезни",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "illness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вчера мой брат <w>заболел</w> гриппом и остался дома.",
                            "target_lang_translations": {
                                "en": "Yesterday my brother <w>fell ill</w> with the flu and stayed home."
                            }
                        },
                        {
                            "text": "Если ты не наденешь шапку, то можешь <w>заболеть</w>.",
                            "target_lang_translations": {
                                "en": "If you don't wear a hat, you might <w>get sick</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "захворать"
                    ],
                    "antonyms": [
                        "выздороветь",
                        "поправиться"
                    ],
                    "common_phrases": [
                        "заболеть гриппом",
                        "заболеть ангиной"
                    ],
                    "target_lang_definitions": {
                        "en": "To become ill, to start suffering from a disease or sickness."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fall ill",
                                "target_lang_sense_clarification": "Standard phrase for becoming sick."
                            },
                            {
                                "target_lang_word": "get sick",
                                "target_lang_sense_clarification": "Common, informal way to describe becoming ill."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af829ef8-fc57-3ea4-a497-725c15f19775",
                    "sense_definition": "начать причинять боль, стать источником болезненных ощущений",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После долгого бега у меня <w>заболели</w> ноги.",
                            "target_lang_translations": {
                                "en": "After a long run, my legs started to <w>ache</w>."
                            }
                        },
                        {
                            "text": "От громкой музыки у него внезапно <w>заболела</w> голова.",
                            "target_lang_translations": {
                                "en": "His head <w>started hurting</w> suddenly from the loud music."
                            }
                        }
                    ],
                    "synonyms": [
                        "разболеться"
                    ],
                    "antonyms": [
                        "пройти"
                    ],
                    "common_phrases": [
                        "заболела голова",
                        "заболели зубы"
                    ],
                    "target_lang_definitions": {
                        "en": "To start causing pain, to become a source of painful sensations."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ache",
                                "target_lang_sense_clarification": "To suffer from a continuous dull pain."
                            },
                            {
                                "target_lang_word": "start hurting",
                                "target_lang_sense_clarification": "To begin to feel pain in a specific body part."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05b610db-8788-3ff2-a523-2c57f1f24636",
                    "sense_definition": "сильно увлечься чем-либо, проявить глубокий интерес",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "passion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он так <w>заболел</w> шахматами, что проводит за ними всё свободное время.",
                            "target_lang_translations": {
                                "en": "He became so <w>obsessed with</w> chess that he spends all his free time on it."
                            }
                        },
                        {
                            "text": "Она <w>заболела</w> идеей путешествия вокруг света.",
                            "target_lang_translations": {
                                "en": "She <w>got hooked on</w> the idea of traveling around the world."
                            }
                        }
                    ],
                    "synonyms": [
                        "загореться",
                        "увлечься"
                    ],
                    "antonyms": [
                        "разочароваться"
                    ],
                    "target_lang_definitions": {
                        "en": "To become deeply interested or passionate about something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "become obsessed with",
                                "target_lang_sense_clarification": "To develop a strong, consuming interest in something."
                            },
                            {
                                "target_lang_word": "get hooked on",
                                "target_lang_sense_clarification": "Informal way to describe becoming very enthusiastic about a hobby or idea."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}