                        "entry_id": "26d2aadd-e95b-37b0-a0d5-9963c594fc0c",
                        "glosses": [
                            "een moerdijk in de provincie Noord-Brabant bij het Hollandsch Diep waar vroeger de veerdienst met Holland werd onderhouden"
                        ],
                        "tags": [
                            "obsolete",
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "7838ce92-18eb-4f56-b4fe-d47c504a3142",
                                "sense_id": "8e0836f5-874d-35b7-ace7-b893fe4cd188",
                                "text": "Tot onderkenning der Vaartuigen zullen dezelve, in groote leesbare letteren, tot opschrift voeren: Veer van Willemsdorp op den Moerdijk, of Veer van den Moerdijk op Willemsdorp."
                            }
                        ]
                    },
                    {
                        "sense_id": "961ab636-f1e6-3094-bb95-be0c233f6122",
                        "entry_id": "26d2aadd-e95b-37b0-a0d5-9963c594fc0c",
                        "glosses": [
                            "andere benaming voor het Hollandsch Diep"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "fa8074eb-2656-4dbd-80c4-283f28d430df",
                                "sense_id": "961ab636-f1e6-3094-bb95-be0c233f6122",
                                "text": "De brug over den Moerdijk, door de Regering op ƒ 8 millioenen, door anderen op een vierde meer geraamd, is natuurlijk het groote bezwaar voor het regeringsvoorstel."
                            }
                        ]
                    }
