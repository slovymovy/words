            {
                "entry_id": "edafa635-b5c7-31ea-b3d5-d9964147acb4",
                "word": "laïque",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9acf6656-aa5b-4bc7-a7b2-013d147e4e78",
                        "entry_id": "edafa635-b5c7-31ea-b3d5-d9964147acb4",
                        "tags": [
                            "plural"
                        ],
                        "form": "laïques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7d66cf7f-3618-31c3-9d4d-eda00619ef4b",
                        "entry_id": "edafa635-b5c7-31ea-b3d5-d9964147acb4",
                        "glosses": [
                            "Variante de laïc."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "1a6c06a1-9950-498a-b49b-3afce9340267",
                                "sense_id": "7d66cf7f-3618-31c3-9d4d-eda00619ef4b",
                                "text": "Le prix des matières premières étant peu considérable, la procure d'un séminaire pourrait livrer les pains d’autel à meilleur marché que ne le font les laïques , et ce serait un revenu net et assuré, que l'on pourrait appliquer à la fondation de quelques bourses."
                            },
                            {
                                "example_id": "668775a0-68c1-4f99-a74d-a6f6207f4f0e",
                                "sense_id": "7d66cf7f-3618-31c3-9d4d-eda00619ef4b",
                                "text": "il fallait être « de la chose ». Les laïques étaient mal vus."
                            },
                            {
                                "example_id": "d9786bd9-9e3e-4b56-8080-a927b370af35",
                                "sense_id": "7d66cf7f-3618-31c3-9d4d-eda00619ef4b",
                                "text": "Si le Ciel a enduré toute la nation de ces mécréants au cou serré pendant plus d’années que n’en saurait compter un laïque, nous pouvons bien, pendant quelques heures, endurer la présence d’un seul."
                            },
                            {
                                "example_id": "2d7e8b63-ec38-451c-ac1c-7eebdf0f8a87",
                                "sense_id": "7d66cf7f-3618-31c3-9d4d-eda00619ef4b",
                                "text": "Tout laïque qu’il était, il s’est fait directeur de filles."
                            },
                            {
                                "example_id": "42316dba-f946-4cf4-a3c4-c417a83a2d96",
                                "sense_id": "7d66cf7f-3618-31c3-9d4d-eda00619ef4b",
                                "text": "Le législateur canonique intervient aussi pour réprimer le rapt ; le Concile de Chalcédoine de 451 (canon 27) dépose les clercs coupables de complicité de rapt et excommunie les laïques dans ces cas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce0f9acc-4e1f-4e71-8dc2-e3874fc6f4f6",
                        "source_entry_id": "edafa635-b5c7-31ea-b3d5-d9964147acb4",
                        "source_sense_id": "7d66cf7f-3618-31c3-9d4d-eda00619ef4b",
                        "target_lang_word": "layman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "layman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2df0d25-e20a-32f4-b58a-53a8761e096e",
                                        "entry_id": "f4c0701c-5f3b-395f-b2dc-ab41cfe44ee1",
                                        "glosses": [
                                            "Layperson, someone who is not an ordained cleric or member of the clergy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5029e877-25f4-36e6-9a8b-4f9f74bacf83",
                                        "entry_id": "f4c0701c-5f3b-395f-b2dc-ab41cfe44ee1",
                                        "glosses": [
                                            "Someone who is not a professional in a given field."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "258bf4c0-6f15-4d22-8e39-d4c1d2bf8704",
                                                "sense_id": "5029e877-25f4-36e6-9a8b-4f9f74bacf83",
                                                "text": "Carmen is not a professional anthropologist, but strictly a layman."
                                            },
                                            {
                                                "example_id": "046f792f-708c-49b4-83a0-1f9cdb9670e8",
                                                "sense_id": "5029e877-25f4-36e6-9a8b-4f9f74bacf83",
                                                "text": "Let me explain it to you [[in layman's terms|in layman's terms]]."
                                            },
                                            {
                                                "example_id": "35ec6305-91dc-4b6c-94eb-f131df4b838f",
                                                "sense_id": "5029e877-25f4-36e6-9a8b-4f9f74bacf83",
                                                "text": "The layman, perhaps, is not fully aware to what extent even the popular reputations of scientists and scholars are made by that class and are inevitably affected by its views on subjects which have little to do with the merits of the real achievements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "228ab784-fa94-35ad-9b74-3c0e8592a809",
                                        "entry_id": "f4c0701c-5f3b-395f-b2dc-ab41cfe44ee1",
                                        "glosses": [
                                            "A common person."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c13e6a98-131d-31ff-a5a1-d075779aa846",
                                        "entry_id": "f4c0701c-5f3b-395f-b2dc-ab41cfe44ee1",
                                        "glosses": [
                                            "A person who is untrained or lacks knowledge of a subject."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07406d2b-3a54-4beb-943c-ab0f40b63ab7",
                                                "sense_id": "c13e6a98-131d-31ff-a5a1-d075779aa846",
                                                "text": "should he be held to be just a layman, or does he have some art?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22f7c41e-0f4f-33d1-8cbd-a2e6e889bc0e",
                                        "entry_id": "f4c0701c-5f3b-395f-b2dc-ab41cfe44ee1",
                                        "glosses": [
                                            "Lay-sister or lay-brother, person received into a convent of monks, following the vows, but not being member of the order."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
