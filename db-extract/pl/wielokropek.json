                "translations": [
                    {
                        "translation_id": "3ec456bd-8925-4b4e-b40f-c0dac4f64241",
                        "source_entry_id": "c4793e83-db6c-3cc9-8559-8ab421a068de",
                        "source_sense_id": "7314d0dc-bb19-3b78-b7e0-dc183d23242d",
                        "target_lang_word": "points de suspension",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "points de suspension",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "37156411-d263-363f-ad1d-b79b198dc19c",
                                        "entry_id": "c8998662-bebd-330c-8deb-0ddab85683cf",
                                        "glosses": [
                                            "Ellipse, signe typographique composé de trois points, « … » :"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "71cdc714-e9f6-365e-87a0-a7ebbde7e259",
                                        "entry_id": "c8998662-bebd-330c-8deb-0ddab85683cf",
                                        "glosses": [
                                            "Ellipse, signe typographique composé de trois points, « … » :",
                                            "indiquant une incomplétude de la phrase ;"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5002ba36-d83f-47d6-b874-4262813ab90e",
                                                "sense_id": "71cdc714-e9f6-365e-87a0-a7ebbde7e259",
                                                "text": "Les points de suspension ont la même signification grammaticale que les points si l’on s’arrête après eux, et sont donc suivi d’une majuscule."
                                            },
                                            {
                                                "example_id": "1f5fd248-2e8a-4a25-9691-00f54e009739",
                                                "sense_id": "71cdc714-e9f6-365e-87a0-a7ebbde7e259",
                                                "text": "Et points de suspension, si commodes pour exprimer tout ce qu’on ne dit pas ! Il devrait s’appeler point de sous-entendu, çui-là !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9ed00c5-db20-3541-90f4-3056aac543af",
                                        "entry_id": "c8998662-bebd-330c-8deb-0ddab85683cf",
                                        "glosses": [
                                            "Ellipse, signe typographique composé de trois points, « … » :",
                                            "indiquant une hésitation ;"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6df49c9-5a11-4643-b230-cf1b31b81f51",
                                                "sense_id": "b9ed00c5-db20-3541-90f4-3056aac543af",
                                                "text": "Si les points de suspension expriment une hésitation, ils jouent un rôle équivalent au point-virgule, et la reprise de la phrase se fait sans majuscule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdc2d588-1143-3172-9210-8558d78d7a4d",
                                        "entry_id": "c8998662-bebd-330c-8deb-0ddab85683cf",
                                        "glosses": [
                                            "Ellipse, signe typographique composé de trois points, « … » :",
                                            "indiquant une élision, une coupure ;"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bf2f91c-6617-4a06-87f6-1ea5dfbe93f1",
                                                "sense_id": "cdc2d588-1143-3172-9210-8558d78d7a4d",
                                                "text": "Pour indiquer un passage coupé dans une citation, on emploie les points de suspension entre crochets : « […] »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8abcee2d-70e9-3334-bc37-be06b0660f37",
                                        "entry_id": "c8998662-bebd-330c-8deb-0ddab85683cf",
                                        "glosses": [
                                            "Ellipse, signe typographique composé de trois points, « … » :",
                                            "équivalent de etc. dans une liste incomplète."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d44994a-cf19-422b-b1be-8b316ea0dc62",
                                                "sense_id": "8abcee2d-70e9-3334-bc37-be06b0660f37",
                                                "text": "Les points de suspension finaux dans la phrase « J’ai acheté des pommes, des poires, des ananas… » suggèrent que les emplettes ont été fructueuses."
                                            }
                                        ]
                                    }
                                ]
                            },
