                "senses": [
                    {
                        "sense_id": "a46116b6-3dde-3369-b0ab-59f5e07b611e",
                        "entry_id": "e871d937-b9ff-3935-ad62-1524ea9b600e",
                        "glosses": [
                            "jemand, der an einem Dom predigt (in der katholischen Kirche bis zum 20. Jahrhundert ein Amt an Bischofskirchen; im Protestantismus bis heute ein Titel für Pfarrer an großen Stadtkirchen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6652f19b-c573-4358-a6e8-9a1811535d26",
                                "sense_id": "a46116b6-3dde-3369-b0ab-59f5e07b611e",
                                "text": "„Giselher Quast (* 1951) ist Domprediger des Magdeburger Doms.“"
                            },
                            {
                                "example_id": "589f9cc5-632c-47a7-8236-0847e5d47d56",
                                "sense_id": "a46116b6-3dde-3369-b0ab-59f5e07b611e",
                                "text": "„In diesem Werk verzweifelt ein alter Domprediger an Anspruch und Wirklichkeit des Christentums und begeht Selbstmord.“"
                            },
                            {
                                "example_id": "82cd88bd-79a6-4bb0-9073-a0aa34bbbb73",
                                "sense_id": "a46116b6-3dde-3369-b0ab-59f5e07b611e",
                                "text": "„Das Wunder sei der Muttergottes zu verdanken, hieß es im Volk, und so wurde es vom Domprediger Balthasar Hubmaier verkündet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
