                "senses": [
                    {
                        "sense_id": "e07b6e68-f5e8-31f8-ae4f-3ba52ccd51b7",
                        "entry_id": "e8620d2f-07ab-383d-aeba-0a1c1287286e",
                        "glosses": [
                            "Donner un caractère maniéré à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07f2aa3e-6b9f-43eb-88f9-41bd38b0c3e7",
                                "sense_id": "e07b6e68-f5e8-31f8-ae4f-3ba52ccd51b7",
                                "text": "En isolant un court récit, je n’ai eu l’intention ni de « maniériser » Erasme ni d’« érasmiser » le maniérisme."
                            },
                            {
                                "example_id": "b711dd9e-c093-47a7-bd91-bf6c52c6e520",
                                "sense_id": "e07b6e68-f5e8-31f8-ae4f-3ba52ccd51b7",
                                "text": "On sait que lorsqu’une écriture a la prétention de s’approprier une langue en lui imposant académiquement un genre, cette langue tourne vite à la langue de bois et elle tend à se maniériser sur des formules."
                            }
                        ]
                    }
