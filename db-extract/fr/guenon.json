        "fr-extract.jsonl": [
            {
                "entry_id": "b834c31a-4fa6-3c09-ad1e-bcf25718f65d",
                "word": "guenon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "476c0c0b-858f-4940-aa2d-0c1475bcf62d",
                        "entry_id": "b834c31a-4fa6-3c09-ad1e-bcf25718f65d",
                        "tags": [
                            "plural"
                        ],
                        "form": "guenons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e9107ae8-a065-3b72-95fa-7eef5ca7c6ca",
                        "entry_id": "b834c31a-4fa6-3c09-ad1e-bcf25718f65d",
                        "glosses": [
                            "Cercopithèque."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3c1db221-ef65-3383-978f-73de36767534",
                        "entry_id": "b834c31a-4fa6-3c09-ad1e-bcf25718f65d",
                        "glosses": [
                            "Femelle d’un singe."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "d3bbe2bd-07e3-43bb-911d-ac7454d8f097",
                                "sense_id": "3c1db221-ef65-3383-978f-73de36767534",
                                "text": "Une petite guenon."
                            },
                            {
                                "example_id": "e68e1c6d-b02e-45c5-9bf6-9e240ce69fa5",
                                "sense_id": "3c1db221-ef65-3383-978f-73de36767534",
                                "text": "Un groupe d’enfants jouaient avec la guenon apprivoisée d’un Flamand efféminé, un habitant de l’impasse qui se faisait appeler Fifi, et qui ne portait que des chemises en pagne et des boubous africains. — (Gaël Faye, Petit Pays, Grasset, 2016, pages 108–109)"
                            }
                        ]
                    },
                    {
                        "sense_id": "a36b4e45-37cd-3be3-a37b-2d442aafdb30",
                        "entry_id": "b834c31a-4fa6-3c09-ad1e-bcf25718f65d",
                        "glosses": [
                            "Femme très laide."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "1051a99d-be2a-4204-8a22-b55ebf1f6e55",
                                "sense_id": "a36b4e45-37cd-3be3-a37b-2d442aafdb30",
                                "text": "Il ajouta entre ses dents, de manière à ne pouvoir être entendu : — Tas de guenons !"
                            },
                            {
                                "example_id": "1a7dda37-72da-4b97-8bd0-bafd5cccf8f7",
                                "sense_id": "a36b4e45-37cd-3be3-a37b-2d442aafdb30",
                                "text": "« Mon cher, je quitterai cette infâme danseuse ignoble, cette vieille toupie qui a tourné sous le fouet de tous les airs d’opéra, cette guenipe, cette guenon de Savoyard ! »"
                            },
                            {
                                "example_id": "da12fb67-2f01-4cfb-9d33-425665f830a6",
                                "sense_id": "a36b4e45-37cd-3be3-a37b-2d442aafdb30",
                                "text": "Comment alors aimâtes-vous cette guenon savoyarde, vous qui avez la peau blanche et des manières distinguées ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83cad465-85d7-4f6b-80c7-f5f1fa39e4dc",
                        "source_entry_id": "b834c31a-4fa6-3c09-ad1e-bcf25718f65d",
                        "target_lang_word": "apess",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apess",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0819e68b-d13f-3845-8bfe-113e764fa0c7",
                                        "entry_id": "e4cf7021-04e9-3ad1-8311-e17cd9c62f66",
                                        "glosses": [
                                            "A female ape."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2b69df9-aec6-4032-9db2-50936643a18e",
                                                "sense_id": "0819e68b-d13f-3845-8bfe-113e764fa0c7",
                                                "text": "Yet, though his limbs with pile were rough, / And though his tail was long enough / […] / Th’ apesses [he] treated with disdain[.]"
                                            },
                                            {
                                                "example_id": "b0df36c6-ceae-4a72-907a-83197f6fa6ec",
                                                "sense_id": "0819e68b-d13f-3845-8bfe-113e764fa0c7",
                                                "text": "I must run over & see you some day. Why not you & Mʳˢ Darwin run over here, when you have finished your Book—you can study my little Apes & Apesses—Kindest regards to Mʳˢ Darwin & thanks for her note—Always yours Affecˡʸ / W D Fox"
                                            },
                                            {
                                                "example_id": "67926230-ab1f-4269-bb86-401025029a9e",
                                                "sense_id": "0819e68b-d13f-3845-8bfe-113e764fa0c7",
                                                "text": "Suddenly then he rose, and thinking scorn of his fellows / Longed to be quit of them all, his Apess specially."
                                            },
                                            {
                                                "example_id": "5ee51333-1905-4de0-b229-8fee816911eb",
                                                "sense_id": "0819e68b-d13f-3845-8bfe-113e764fa0c7",
                                                "text": "The second movement, the allegro ironico, is a variation on the well-known theme “Je m’en fous.” An ape-like mockery whinnies through it. Cocoanuts are shied at all the four corners of the world. Some of them display a mysterious tendency to fall near the spot where the apess sits weeping over the children."
                                            },
                                            {
                                                "example_id": "af55527e-f6cd-4e95-9dda-7983e200eb9d",
                                                "sense_id": "0819e68b-d13f-3845-8bfe-113e764fa0c7",
                                                "text": "In negroes and in anthropoid apes, the index finger is much shorter than the ring finger. In negresses and in anthropoid apesses, the index finger is often longer."
                                            },
                                            {
                                                "example_id": "555c5d26-c83c-4867-809d-4db169c4535b",
                                                "sense_id": "0819e68b-d13f-3845-8bfe-113e764fa0c7",
                                                "text": "The apess doesn’t look her age."
                                            },
                                            {
                                                "example_id": "c4be688e-cbf6-4bd0-bde1-cef182e30171",
                                                "sense_id": "0819e68b-d13f-3845-8bfe-113e764fa0c7",
                                                "text": "I dunno; do apesses screech more than male orangutans 'n' gorillae?"
                                            },
                                            {
                                                "example_id": "6fbde12a-652b-4c79-abd4-241f9a8affe3",
                                                "sense_id": "0819e68b-d13f-3845-8bfe-113e764fa0c7",
                                                "text": "[A]pesses do all the child-rearing."
                                            },
                                            {
                                                "example_id": "77655387-a336-4358-a3fa-010ec4f2c0a4",
                                                "sense_id": "0819e68b-d13f-3845-8bfe-113e764fa0c7",
                                                "text": "She then remarks that some people refer to art as the “apess or ape of nature, because just as the apess greatly imitates the manners of humans, art greatly imitates the works of nature.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76e709ac-dcb2-4bb5-8c75-b3651ac77251",
                        "source_entry_id": "b834c31a-4fa6-3c09-ad1e-bcf25718f65d",
                        "target_lang_word": "mona",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mona",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "c55148e4-641c-3f48-abec-808b0ff5249b",
                                        "entry_id": "e3938592-9cc4-3539-a174-9bc2295e7441",
                                        "glosses": [
                                            "Hembra del mono."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4d5f0c3d-af10-341b-bead-ff480133674c",
                                        "entry_id": "e3938592-9cc4-3539-a174-9bc2295e7441",
                                        "glosses": [
                                            "Estado de embriaguez por consumo de alcohol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99bc338c-a8c0-476a-8b31-cd024db59f5a",
                                                "sense_id": "4d5f0c3d-af10-341b-bead-ff480133674c",
                                                "text": "Dáselos, Sancho dixo Don Quixote , no para tomar el Mono, sino la mona ; y docientos diera yo ahora en albricias á quien me dixera con certidumbre que la señora Dª. Melisendra y el señor D. Gayferos estaban ya en Francia y entre los suyos."
                                            },
                                            {
                                                "example_id": "8161434d-16cc-46b9-8856-9d2a02e191cf",
                                                "sense_id": "4d5f0c3d-af10-341b-bead-ff480133674c",
                                                "text": "Era este un hombre grandote, morrudo, guaso y muy borracho. Aquel día andaba con una tremenda mona á cuestas; con el alba puesta y con una imagen de Cristo en la mano, largaba en aquella concurrencia femenina cada exclamación que ruborizaba al vigilante mirón que había allí."
                                            },
                                            {
                                                "example_id": "3e417173-1e0c-48ee-bbd9-2fe6679b2352",
                                                "sense_id": "4d5f0c3d-af10-341b-bead-ff480133674c",
                                                "text": "Antes de cada comida hacían una suscripcibn entre todos, para comprar algunas botellas de vino. En medio del licor, Helio se encontraba en su elemento y entre copa y copa recordaba delicias, esos sueños dorados de las monas obligatorias de cada noche. Julio, más moderado en su corrupción, se revestía de hipócrita gravedad y dándose las ínfulas del joven de gran vida, solo untaba los labios después de cada plato, en ese vino que encontraba detestable."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
