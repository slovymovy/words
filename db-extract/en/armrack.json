                        "glosses": [
                            "A frame, generally vertical, for holding small arms."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73c80c43-db6a-45ea-b1d4-b6817c9bfc2d",
                                "sense_id": "57e2a305-90fb-3ae4-b7c9-961a7bb3f5a5",
                                "text": "1803, General Standing Orders for Third, or Prince of Wales’s Dragoon Guards, Edinburgh: R. Allan, Instructions for the Guard, Article 16, pp. 162-163,\nThe Carbines must be regularly place in the arm rack, according to each man’s number in the Guard."
                            },
                            {
                                "example_id": "3e8ab366-71c5-4807-be91-c1dd18ec2c2b",
                                "sense_id": "57e2a305-90fb-3ae4-b7c9-961a7bb3f5a5",
                                "text": "[The carbines] disappeared mysteriously from locked arm-racks, and in the hot weather when all the barrack doors and windows were opened they vanished like puffs of their own smoke."
                            },
                            {
                                "example_id": "ecfb2737-a319-4662-9a6a-d52a46dfa2be",
                                "sense_id": "57e2a305-90fb-3ae4-b7c9-961a7bb3f5a5",
                                "text": "It was a long time since Tunku Allang had had ammunition for the score or so of old muskets rusting in their arm-racks in the audience-hall."
                            }
                        ]
                    }
