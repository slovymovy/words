                        "target_lang_word": "Untergang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Untergang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3e74979c-a98c-34d4-b416-d96d20e42469",
                                        "entry_id": "189e4f1f-85d2-30ed-a21b-529fb7949a15",
                                        "glosses": [
                                            "Vorgang, bei dem etwas untergeht, bei dem etwas unter etwas anderem verschwindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de449315-8f0c-4e67-bbe3-6538d8c3e98e",
                                                "sense_id": "3e74979c-a98c-34d4-b416-d96d20e42469",
                                                "text": "Er sitzt seit zwei Wochen am Strand und beobachtet die Untergänge der Sonne."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9a5e327d-91a5-357f-8e1f-1074fb498cb2",
                                        "entry_id": "189e4f1f-85d2-30ed-a21b-529fb7949a15",
                                        "glosses": [
                                            "Ertrinken; Vorgang, bei dem etwas im Wasser verschwindet; Vorgang, bei dem etwas in einem See oder Meer versinkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30ca9613-726e-4d62-a4fd-5b33036a1a17",
                                                "sense_id": "9a5e327d-91a5-357f-8e1f-1074fb498cb2",
                                                "text": "Der Untergang der Titanic war eines der schlimmsten Ereignisse der zivilen Schifffahrt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4fd509db-ee03-3b5e-87a7-79a3e08be412",
                                        "entry_id": "189e4f1f-85d2-30ed-a21b-529fb7949a15",
                                        "glosses": [
                                            "Vernichtung von etwas; Verschwinden von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1e39f09-49de-42d1-b720-31843a89e2a8",
                                                "sense_id": "4fd509db-ee03-3b5e-87a7-79a3e08be412",
                                                "text": "In meinem Traum sah ich den Untergang der Menschheit."
                                            },
                                            {
                                                "example_id": "f765ef41-447b-4975-a4aa-2d00c656fc58",
                                                "sense_id": "4fd509db-ee03-3b5e-87a7-79a3e08be412",
                                                "text": "Mit dem Bau der Eisenbahn waren auch die letzten Indianer dem Untergang geweiht."
                                            },
                                            {
                                                "example_id": "926a448e-2692-4546-9442-3f6cb69baeab",
                                                "sense_id": "4fd509db-ee03-3b5e-87a7-79a3e08be412",
                                                "text": "Die panikartigen Aktienverkäufe haben den Untergang der Heuschreck AG noch beschleunigt."
                                            },
                                            {
                                                "example_id": "c5a57ef2-5849-4a62-b584-b04498116bac",
                                                "sense_id": "4fd509db-ee03-3b5e-87a7-79a3e08be412",
                                                "text": "Der Untergang des römischen Reiches veränderte die antike Weltordnung."
                                            },
                                            {
                                                "example_id": "b24953cc-7082-4063-985f-e5ecb71942dd",
                                                "sense_id": "4fd509db-ee03-3b5e-87a7-79a3e08be412",
                                                "text": "„Damit wurde die aristokratische Prägung der römischen Republik bis zu deren Untergang zementiert.“"
                                            },
                                            {
                                                "example_id": "780c925f-6727-4c36-be23-e7e4713d044c",
                                                "sense_id": "4fd509db-ee03-3b5e-87a7-79a3e08be412",
                                                "text": "„Im Untergang aber, wenn er unversehens denn eintritt, verliert das einseitig männliche Prinzip jeden Glanz.“"
                                            },
                                            {
                                                "example_id": "c4883b2a-0fae-4fa2-9e72-196e2d11a273",
                                                "sense_id": "4fd509db-ee03-3b5e-87a7-79a3e08be412",
                                                "text": "„Auch nach dem Untergang Weimars und der Niederschlagung des europäischen Faschismus hat die Geschichte von Paul Bäumer und seinen Kameraden jede heranwachsende Generation bewegt und gefesselt.“"
                                            },
                                            {
                                                "example_id": "6394c2f3-4935-4050-92a1-726da07edb87",
                                                "sense_id": "4fd509db-ee03-3b5e-87a7-79a3e08be412",
                                                "text": "„Die Ursache für Manchings Untergang bleibt nebulös, die Folgen aber sind deutlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
