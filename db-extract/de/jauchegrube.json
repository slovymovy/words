                ],
                "senses": [
                    {
                        "sense_id": "6a0e6649-d359-3cd4-a88e-c248cb68dda6",
                        "entry_id": "c2cd1b22-34aa-3346-b75e-f4e3c5f5bf39",
                        "glosses": [
                            "grubenartige Vertiefung zur Aufnahme und Lagerung von tierischen und menschlichen Exkrementen und Fäkalien"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "d74ee033-a04c-4346-ac02-f62a054fcbbd",
                                "sense_id": "6a0e6649-d359-3cd4-a88e-c248cb68dda6",
                                "text": "Der Bauer ermahnt seine Kinder, nicht zu nah an der Jauchegrube zu spielen."
                            },
                            {
                                "example_id": "e085411f-51ad-43d5-a589-1d29950ed692",
                                "sense_id": "6a0e6649-d359-3cd4-a88e-c248cb68dda6",
                                "text": "Die Jauchegrube wurde vollständig leergepumpt."
                            },
                            {
                                "example_id": "74f3d7bd-432b-4c47-8bd5-cbab4b8ba17c",
                                "sense_id": "6a0e6649-d359-3cd4-a88e-c248cb68dda6",
                                "text": "„Ein Delmenhorster Unternehmen, das über einschlägige Erfahrungen verfügt. Bevor es sich auf Bassins spezialisierte, baute es Jauchegruben.“"
                            },
                            {
                                "example_id": "e944178a-5991-4133-aa15-4a1c64420233",
                                "sense_id": "6a0e6649-d359-3cd4-a88e-c248cb68dda6",
                                "text": "„Man kann die Larven im Regenfass oder in Jauchegruben auch biologisch mit Tabletten bekämpfen.“"
                            },
                            {
                                "example_id": "411c49e5-5c3a-47f5-89e3-7156cca1d431",
                                "sense_id": "6a0e6649-d359-3cd4-a88e-c248cb68dda6",
                                "text": "„Man könnte die kräftigen Vierkantstücke aus den Trümmern ziehen, sie zu Zaunpfählen verarbeiten, zu Gartenpforten oder als Abdeckbohlen auf Jauchegruben legen.“"
                            },
                            {
                                "example_id": "24bd52ee-5506-440b-8587-a16fc3368418",
                                "sense_id": "6a0e6649-d359-3cd4-a88e-c248cb68dda6",
                                "text": "„Ich hatte einen Fuß auf der Himmelsleiter und den anderen in einer Jauchegrube.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
