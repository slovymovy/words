                "senses": [
                    {
                        "sense_id": "f89e7b36-0280-3c29-83bf-0bfc85fe56b3",
                        "entry_id": "9b31f104-5d0e-3ca0-a4ea-299c0a4dd86f",
                        "glosses": [
                            "Familie der Käfer"
                        ],
                        "tags": [
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "96da8430-2618-4a49-b56a-5eb3d7a2260b",
                                "sense_id": "f89e7b36-0280-3c29-83bf-0bfc85fe56b3",
                                "text": "„Bei den Blattrollern handelt es sich um eine kleine Käfergruppe, die früher als Unterfamilie den Rüsselkäfern (Curculionidae) zugeordnet wurde.“"
                            },
                            {
                                "example_id": "e9ae608b-09be-47f1-b3b2-481bba7ffe52",
                                "sense_id": "f89e7b36-0280-3c29-83bf-0bfc85fe56b3",
                                "text": "„Der Schwarze Birkenblattroller (Deporaus betulae) auch Trichterwickler genannt, gehört zur Familie der Blattroller (Attelabidae), einer den Rüsselkäfern nahestehenden Käferfamilie.“"
                            },
                            {
                                "example_id": "c31c7d03-157c-4dff-902b-938a10bbf0e5",
                                "sense_id": "f89e7b36-0280-3c29-83bf-0bfc85fe56b3",
                                "text": "„Entsprechende Brutstätten von Blattrollern gibt es in meinem Garten auch am Wilden Wein, der als aus Nordamerika eingeführter Fremdling kaum von anderen Insekten angegriffen wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d01b3970-0f62-3e79-91ed-39048638b4f7",
                        "entry_id": "9b31f104-5d0e-3ca0-a4ea-299c0a4dd86f",
                        "glosses": [
                            "Bezeichnung für einen nicht definierten Vertreter aus der Familie von [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "515d51f0-0c6a-4ab1-a87e-1e3d6ed2127f",
                                "sense_id": "d01b3970-0f62-3e79-91ed-39048638b4f7",
                                "text": "„Auch in der dritten Folge stellen wir einen Blattroller vor: den Roten Eichenkugelrüssler (Attelabus nitens).“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
