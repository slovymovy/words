    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "192d61dc-5d3f-3802-816b-3bbcd0e71b1b",
                "word": "underpoint",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0c634c10-ac9f-3854-8731-ba8c8c2d630e",
                        "entry_id": "192d61dc-5d3f-3802-816b-3bbcd0e71b1b",
                        "glosses": [
                            "Below the point (any sense)"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "0224342d-945b-46cb-8b07-f6a25f14fe74",
                                "sense_id": "0c634c10-ac9f-3854-8731-ba8c8c2d630e",
                                "text": "The wheat farmer, the corn farmer, the livestock farmer, all are receiving high prices for their produce. Until October 1917, the dairyman was distinctly underpoint."
                            },
                            {
                                "example_id": "f2719fa6-d0de-4903-81c8-a2c34844dc83",
                                "sense_id": "0c634c10-ac9f-3854-8731-ba8c8c2d630e",
                                "text": "The Johnstone Fourteen is similar to the Twelve except that boards up to Bearings of sealed slitters and underpoint springs of the tool steel slitter lever."
                            },
                            {
                                "example_id": "d673df74-8425-402f-9af0-d784d408a2fd",
                                "sense_id": "0c634c10-ac9f-3854-8731-ba8c8c2d630e",
                                "text": "The plow bottom is led into the ground and held to its work by the underpoint suction of the share."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "c1774193-dad3-321e-aac4-93ded0d7304b",
                "word": "underpoint",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d059d93d-f441-4749-9b1f-f3b76104a048",
                        "entry_id": "c1774193-dad3-321e-aac4-93ded0d7304b",
                        "tags": [
                            "plural"
                        ],
                        "form": "underpoints"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c9a54581-5d2d-3627-bacd-4e5723102b3a",
                        "entry_id": "c1774193-dad3-321e-aac4-93ded0d7304b",
                        "glosses": [
                            "A downward facing point on the underside."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57a33ef7-5968-4591-975c-3796ae4986f2",
                                "sense_id": "c9a54581-5d2d-3627-bacd-4e5723102b3a",
                                "text": "An object appears to present a difficulty to a flame that cannot surround it, or approach the so doing. This a mere upper-surface ignited affords little prospect of doing, an undersurface much more, an under edge still more, and an underpoint (never mind Euclid's definitions) again still more, being capable of being nearly surrounded by the smallest flame."
                            },
                            {
                                "example_id": "2f7aeb16-2094-4662-8fef-fdbfde7d9f5d",
                                "sense_id": "c9a54581-5d2d-3627-bacd-4e5723102b3a",
                                "text": "Every workman who filed the teeth had the model of a perfect tooth with him and was told to file the tooth to the shape of the underpoint of a man's little finger."
                            },
                            {
                                "example_id": "8a42e0fb-aa6b-4db8-83f4-87cdf58e72eb",
                                "sense_id": "c9a54581-5d2d-3627-bacd-4e5723102b3a",
                                "text": "Then he straightens up his right arm, which he swings quickly as a pivot to speed a left hand punch which travels from below the outside of his slightly bended left knee to the underpoint of the opponent's chin."
                            }
                        ]
                    },
                    {
                        "sense_id": "99f17f53-7dbe-3c98-81bd-3c79c6b3e5a8",
                        "entry_id": "c1774193-dad3-321e-aac4-93ded0d7304b",
                        "glosses": [
                            "The lowest intensity point of a diminuendo that is followed by an increase in volume and intensity."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbc53561-a0cb-44a9-bcee-05e7beda4458",
                                "sense_id": "99f17f53-7dbe-3c98-81bd-3c79c6b3e5a8",
                                "text": "In larger dimensions, recurrent formulas, articulation, and phrase structure become important, and it may be possible to abstract various general curve types by studying the location of peaks and underpoints."
                            },
                            {
                                "example_id": "fb87c2d2-11f4-4ada-9555-1e971981252a",
                                "sense_id": "99f17f53-7dbe-3c98-81bd-3c79c6b3e5a8",
                                "text": "Since his dynamic changes follow the development of the intensity of the music, they often indicate the direction of emotional movement to the climax or underpoints."
                            },
                            {
                                "example_id": "38aac171-66d0-4154-a9c6-c502a6394932",
                                "sense_id": "99f17f53-7dbe-3c98-81bd-3c79c6b3e5a8",
                                "text": "In skillful fugues the heightening tension of contrapuntal development finds confirmation in peaks and underpoints, dissonance quotient, and expansion or compression of tessitura, as well as other less direct sources of stress such as the largely intellectual pleasure of increasingly sophisticated and arcane manipulations."
                            }
                        ]
                    },
                    {
                        "sense_id": "11a832a5-5962-3467-8ebb-55c47b862ca6",
                        "entry_id": "c1774193-dad3-321e-aac4-93ded0d7304b",
                        "glosses": [
                            "The number of scored points below a specified criterion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3dd9588-26bd-416b-8ba4-a908e9a4592e",
                                "sense_id": "11a832a5-5962-3467-8ebb-55c47b862ca6",
                                "text": "If either player overcounts or undercounts his hand (or crib or play), after he has finished pegging the wrong number, not before, the opponent may say, \"Muggins,\" show him the error, have him peg correctly, and then add to his own score the number of overpoints or underpoints."
                            }
                        ]
                    },
                    {
                        "sense_id": "3f85defc-ba2b-3509-afc0-5fa1b44e2d0c",
                        "entry_id": "c1774193-dad3-321e-aac4-93ded0d7304b",
                        "glosses": [
                            "Something that calls attention to or emphasizes a particular conclusion within a topic of discussion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d139dfc-03bd-440a-9646-0543f790ec21",
                                "sense_id": "3f85defc-ba2b-3509-afc0-5fa1b44e2d0c",
                                "text": "I appreciate the comments by the distinguished Senator from Idaho. Mr. President, just a couple of more underpoints."
                            },
                            {
                                "example_id": "67206790-e8b4-4494-97de-1342e8780ec2",
                                "sense_id": "3f85defc-ba2b-3509-afc0-5fa1b44e2d0c",
                                "text": "With your permission, Mr. Chairman, he has brought some of his kids here, and they may sort of provide an underpoint, if I could ask them to stand up."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "45cc55b5-4ba6-3603-a60b-0cdb44572f76",
                "word": "underpoint",
                "pos": "verb",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5e545755-e519-4d33-9d30-20f9ea6429c2",
                        "entry_id": "45cc55b5-4ba6-3603-a60b-0cdb44572f76",
                        "tags": [
                            "present",
                            "singular",
