                    {
                        "translation_id": "67c567c0-9813-463a-9205-b815ce87ee66",
                        "source_entry_id": "824dbd1f-60d5-31e3-9fd7-b90b817b60ab",
                        "source_sense_id": "d025b29f-cf2d-393f-9bb4-d4b6869e68b7",
                        "source_sense_description": "leichte Viruserkrankung von Rindern, die auf Menschen übertragbar ist",
                        "target_lang_word": "vaccine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vaccine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8180b74f-0e0c-3b7c-b2d3-800271c433f5",
                                        "entry_id": "a1948231-74c2-3b38-8089-8cc5d2f74ad6",
                                        "glosses": [
                                            "Maladie propre à la vache et qu’on transmet à l’être humain au moyen de l’inoculation, pour le préserver de la variole."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edb2c644-fde0-4680-867d-6da7edceb039",
                                                "sense_id": "8180b74f-0e0c-3b7c-b2d3-800271c433f5",
                                                "text": "J'aurais moins circonstancié mon rapport, si la malveillance, l'esprit d'opposition, ne s'étaient emparés de l'événement de Cliron pour troubler la sécurité des sujets vaccinés et détourner les parents de soumettre leurs enfants à la salutaire inoculation de la vaccine."
                                            },
                                            {
                                                "example_id": "b73b2a63-d35e-4293-8e44-6a6c7c061ae9",
                                                "sense_id": "8180b74f-0e0c-3b7c-b2d3-800271c433f5",
                                                "text": "Edward Jenner, jeune médecin de campagne, a l’idée d’inoculer volontairement la vaccine, une infection bénigne qui se transmet à l’homme par l’intermédiaire des vaches, à un enfant."
                                            },
                                            {
                                                "example_id": "5945f580-1ea6-4bf8-9159-9b271b75e725",
                                                "sense_id": "8180b74f-0e0c-3b7c-b2d3-800271c433f5",
                                                "text": "C’était alors une femme de vingt-huit ans, au visage tanné, aux bras tannés comme la figure et noirs jusqu’au-dessus du coude, avec une large marque de vaccine blanche sur le biceps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5206640-2b4e-345b-8c0e-1f6ec2363a67",
                                        "entry_id": "a1948231-74c2-3b38-8089-8cc5d2f74ad6",
                                        "glosses": [
                                            "Procédé employé pour opérer cette sorte d’inoculation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed1c73fb-c7d1-4d41-828d-6bdc96fe4330",
                                                "sense_id": "c5206640-2b4e-345b-8c0e-1f6ec2363a67",
                                                "text": "Pratiquer, propager la vaccine."
                                            },
                                            {
                                                "example_id": "91d5ab23-80f4-45ff-8338-726c26f596a6",
                                                "sense_id": "c5206640-2b4e-345b-8c0e-1f6ec2363a67",
                                                "text": "Comité de vaccine."
                                            }
                                        ]
                                    }
                                ]
