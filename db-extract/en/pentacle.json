    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f0ec640d-babc-3d5a-9af1-7e5dd866d117",
                "word": "pentacle",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "085c43f2-4e5c-485c-92ce-5798844a2239",
                        "entry_id": "f0ec640d-babc-3d5a-9af1-7e5dd866d117",
                        "tags": [
                            "plural"
                        ],
                        "form": "pentacles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7c2f3dc2-94ad-3626-8a45-090d8f54dab7",
                        "entry_id": "f0ec640d-babc-3d5a-9af1-7e5dd866d117",
                        "glosses": [
                            "A flat talisman, almost always star-shaped, made of parchment, sheet metal, or other substance, marked with a magic symbol or symbols, used in magical evocation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01a93550-fa50-4d84-8549-e59d0cdd1887",
                                "sense_id": "7c2f3dc2-94ad-3626-8a45-090d8f54dab7",
                                "text": "ouer this pott and the cyrcle hold the pentacles, and perfume them; and say deuoutly theis psalmes followynge"
                            },
                            {
                                "example_id": "3335723b-03f9-4a43-8e65-364fd5eb6c17",
                                "sense_id": "7c2f3dc2-94ad-3626-8a45-090d8f54dab7",
                                "text": "of the same pentacles be certayne exorcizmes and names ineffable and carecters and signes of all the science, therefore, in them the whole science of all this art lyeth hydd"
                            },
                            {
                                "example_id": "ad3a9f9e-f0d9-4f85-83da-0ff3050601b2",
                                "sense_id": "7c2f3dc2-94ad-3626-8a45-090d8f54dab7",
                                "text": "if ye constraine any spirit to come before you and when ye haue shewed him ye secret pentacles, there is none dare say against your minde"
                            }
                        ]
                    },
                    {
                        "sense_id": "b6f10c73-45ae-3dc4-8ab7-6671381001a4",
                        "entry_id": "f0ec640d-babc-3d5a-9af1-7e5dd866d117",
                        "glosses": [
                            "A pentagram, or a disk with a pentagram on it, especially one that is used for magical or mystical purposes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b82d82cb-0155-4967-9aed-538edcda345b",
                                "sense_id": "b6f10c73-45ae-3dc4-8ab7-6671381001a4",
                                "text": "he drew a pentacle or five-pointed star."
                            },
                            {
                                "example_id": "6a73db7d-9a4d-44a8-93da-ecc88e830f92",
                                "sense_id": "b6f10c73-45ae-3dc4-8ab7-6671381001a4",
                                "text": "a five-pointed star (pentacle)."
                            },
                            {
                                "example_id": "44c3de5c-fcae-4e78-a674-cb76e1f85bda",
                                "sense_id": "b6f10c73-45ae-3dc4-8ab7-6671381001a4",
                                "text": "the figure of the pentacle, or pentagram."
                            }
                        ]
                    },
                    {
                        "sense_id": "24ec02f3-709a-3f0b-90c8-1e24ad188dec",
                        "entry_id": "f0ec640d-babc-3d5a-9af1-7e5dd866d117",
                        "glosses": [
                            "A circumscribed pentagram."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a67d4ceb-113d-40e1-85e2-8c6ee570f6ca",
                                "sense_id": "24ec02f3-709a-3f0b-90c8-1e24ad188dec",
                                "text": "The pentacle—a pentagram enclosed within a surrounding circle—as found as the centre-piece on a witch's altar is often worn as a silver pendant by witches and other neo-pagans alike repesenting their beliefs in the interconnectedness and interdependence of the powers of nature and spirit."
                            },
                            {
                                "example_id": "f1a6de85-a453-4dee-b0d8-1568fcce3d9a",
                                "sense_id": "24ec02f3-709a-3f0b-90c8-1e24ad188dec",
                                "text": "A pentacle is a pentagram with a circle drawn around it."
                            },
                            {
                                "example_id": "20ac1a6b-b8da-4e76-a100-af8919e26cfd",
                                "sense_id": "24ec02f3-709a-3f0b-90c8-1e24ad188dec",
                                "text": "The pentagram becomes a pentacle when it is enclosed within a circle and inscribed on a disc or stone."
                            }
                        ]
                    },
                    {
                        "sense_id": "a57ed80f-febd-325d-b600-e84c8aaf7232",
                        "entry_id": "f0ec640d-babc-3d5a-9af1-7e5dd866d117",
                        "glosses": [
                            "A figure formed by two equilateral triangles intersecting regularly so as to form a six-pointed star."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "148286f5-b071-4fed-80f6-699c8fd0bd76",
                        "source_entry_id": "f0ec640d-babc-3d5a-9af1-7e5dd866d117",
                        "source_sense_description": "pentagram",
                        "target_lang_word": "pentacle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pentacle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "09d06fcd-1d3f-3aad-bc11-9c7dacc59a00",
                                        "entry_id": "2b144387-d1c6-3cff-9242-36bc974fa4e4",
                                        "glosses": [
                                            "Forme géométrique, très souvent à base d’un pentagramme, accompagnée d’inscriptions à valeur ésotérique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aee942c-d877-48f6-bd0c-5c8082267e84",
                                                "sense_id": "09d06fcd-1d3f-3aad-bc11-9c7dacc59a00",
                                                "text": "Un pentacle est une étoile à cinq branches inscrite dans un cercle."
                                            },
                                            {
                                                "example_id": "673d0c7b-1737-450e-973e-1d53f0571edb",
                                                "sense_id": "09d06fcd-1d3f-3aad-bc11-9c7dacc59a00",
                                                "text": "Le rabbin Sichem, le dernier kabaliste […] lui donna les pentacles suprêmes et lui communiqua le secret arcane qui ne s’écrit jamais."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
