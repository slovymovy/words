                    {
                        "form_id": "51cae3f4-5874-4f02-a2bc-f28fd269f1ad",
                        "entry_id": "e647890a-ea32-36da-92f9-504ce4f00cd7",
                        "tags": [],
                        "form": "shōgun"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ac3988fc-756b-3abc-aa22-9bce3025aad8",
                        "entry_id": "e647890a-ea32-36da-92f9-504ce4f00cd7",
                        "glosses": [
                            "Chef militaire et civil du Japon, à partir de 1192 jusqu’en 1868, le commandement du pays restant à la charge de l’empereur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b378a78e-14c0-4fc0-a7db-a5e685dcd7d8",
                                "sense_id": "ac3988fc-756b-3abc-aa22-9bce3025aad8",
                                "text": "Un de ses descendants, Sujin (97-30 av. J.-C.), s’occupa le premier du développement de l’agriculture et constitua un rudiment de marine. Il eut quelques relations avec la Corée et divisa l’empire, encore fort mal équilibré, en quatre commandements militaires, à la tête desquels il placa un shogun."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "78283cec-6d77-49b9-ad9f-006439dc6216",
                        "source_entry_id": "e647890a-ea32-36da-92f9-504ce4f00cd7",
                        "source_sense_id": "ac3988fc-756b-3abc-aa22-9bce3025aad8",
                        "source_sense_description": "Chef militaire et civil du Japon",
                        "target_lang_word": "Shōgun",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Shōgun",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "53363054-4b66-3801-9126-2882a62c892d",
                                        "entry_id": "160b9e8e-01de-328c-9cf6-83f54ad34d7a",
                                        "glosses": [
                                            "japanischer Militärtitel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57eb9211-92c9-4e21-8f2f-8b9afa7679d8",
                                                "sense_id": "53363054-4b66-3801-9126-2882a62c892d",
                                                "text": "Wenn sie zu ihren fernen Lehnsgebieten reisten, hielt der Shōgun ihre Ehefrauen und Familien in Edo als Geiseln."
                                            },
                                            {
                                                "example_id": "4f917eb1-ce35-4164-a3b7-d377efe4ba20",
                                                "sense_id": "53363054-4b66-3801-9126-2882a62c892d",
                                                "text": "Nach diesem Verstäntnis war auch der Shōgun lediglich vom Tennō eingesetzt und konnte von diesem jederzeit abgesetzt werden."
                                            },
                                            {
                                                "example_id": "c0616888-ac93-4162-866e-feadb9664522",
                                                "sense_id": "53363054-4b66-3801-9126-2882a62c892d",
                                                "text": "Als sich im Jahr 1201 Hangakus Vater gegen den Shōgun Minamoto no Yoriie, dem Nachfolger von Yoritomo, erhebt, wird die Burg ihrer Familie von Truppen des Shōguns und den Kriegern des Samurai Sainen Niudo (früherer Name: Sasaki Moritsuna) belagert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d1f2745-a37c-4933-b432-a00fb185658b",
                        "source_entry_id": "e647890a-ea32-36da-92f9-504ce4f00cd7",
