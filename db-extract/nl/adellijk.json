                "senses": [
                    {
                        "sense_id": "ba89e8a7-dd53-3a91-bf84-19e456779ebd",
                        "entry_id": "315c0fac-3748-3f94-aa3f-3d28c4a1ac45",
                        "glosses": [
                            "van of behorende tot de adel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93e59e21-336d-4eda-8fed-de67edccc09a",
                                "sense_id": "ba89e8a7-dd53-3a91-bf84-19e456779ebd",
                                "text": "Hij is behoort tot een adellijk geslacht."
                            },
                            {
                                "example_id": "f0a905f1-fb37-410f-98ae-d3bcb1d33651",
                                "sense_id": "ba89e8a7-dd53-3a91-bf84-19e456779ebd",
                                "text": "Je opa Henri en je vader Antoine, allebei moderne, progressieve mannen, gebruiken de naam van het geslacht de Chantery zelden, en de adellijke titels nog minder, en dat is heel sympathiek."
                            }
                        ]
                    },
                    {
                        "sense_id": "5582a25b-bd6a-326d-8cf4-47e67ab7a40b",
                        "entry_id": "315c0fac-3748-3f94-aa3f-3d28c4a1ac45",
                        "glosses": [
                            "op het punt om tot bederf over te gaan."
                        ],
                        "tags": [
                            "van vlees"
                        ],
                        "examples": [
                            {
                                "example_id": "b0fd99f1-da57-43cc-99b2-54482b305ae0",
                                "sense_id": "5582a25b-bd6a-326d-8cf4-47e67ab7a40b",
                                "text": "De geur van adellijk vlees draagt bij aan de bijzondere smaak."
                            }
                        ]
                    }
