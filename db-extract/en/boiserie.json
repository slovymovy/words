                                "sense_id": "cefeba47-4daa-3143-8f73-9ab787757590",
                                "text": "Pot luck turned out to be an exquisite light lunch served at a round table in a room lined with rococo boiseries that had been removed wholesale from some grand Parisian town house and painted pale blue."
                            },
                            {
                                "example_id": "04b63c4d-8db6-4604-9c7c-6b29f6a635fa",
                                "sense_id": "cefeba47-4daa-3143-8f73-9ab787757590",
                                "text": "Around 1960 the town house — 1081 Fifth Avenue, at 89th Street — was pulled down to make way for 1080 Fifth Avenue, and the boiseries were removed."
                            }
                        ]
                    }
