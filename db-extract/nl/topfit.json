                        "glosses": [
                            "heel erg fit, een hele goede conditie hebben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff52a9f0-3802-4e49-a3e8-6b0439bb7c69",
                                "sense_id": "61e45bed-fb40-3052-bd79-fa4ce491e006",
                                "text": "De reus lacht. Die lelijke grijze broek die hij toen aan had, dat buikje… ,,De mensen gaan nu toch een hele andere Jamal zien: eentje die nu ook nog eens écht topfit is.’’"
                            },
                            {
                                "example_id": "a7ee33d4-2a11-48aa-b708-b2a8bca5e139",
                                "sense_id": "61e45bed-fb40-3052-bd79-fa4ce491e006",
                                "text": "Zverev oogde niet topfit, hij stond na langere rally's geregeld uit te hijgen, maar Haase had geen beperkingen bespeurd bij het toptalent van de ATP Tour. 'Zverev behoort tot de fitste spelers uit het circuit en hij speelde als vanouds supersnel. Ik denk eerder dat hij zich op die manier afreageerde, omdat ik beter was.'"
                            },
                            {
                                "example_id": "b0123592-1d55-45d7-8de7-ea1b3868ecca",
                                "sense_id": "61e45bed-fb40-3052-bd79-fa4ce491e006",
                                "text": "„Op mijn zestigste wil ik topfit zijn. Dan moet het lijf immers nog veertig jaar mee. Als ik nu naar mezelf kijk, ben ik al trots. Dat kon ik twee jaar geleden niet zeggen.”"
                            }
                        ]
                    }
