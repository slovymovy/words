                        "form": "more coxcombical"
                    },
                    {
                        "form_id": "90c4bc00-8e36-4408-a05e-4cfd959c2754",
                        "entry_id": "cf6a2bf4-440c-3e8a-853a-c612aa405c8b",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most coxcombical"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fdcaff7a-a333-3fd3-87d2-8ccfea367933",
                        "entry_id": "cf6a2bf4-440c-3e8a-853a-c612aa405c8b",
                        "glosses": [
                            "Like, or in the style of, a coxcomb."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb546fb7-11cf-4603-8f64-5b230c19e6f7",
                                "sense_id": "fdcaff7a-a333-3fd3-87d2-8ccfea367933",
                                "text": "The majority of these idlers were impudent-looking braggarts, who, with jaunty air and coxcombical show of superiority, endeavoured to enforce their own opinions, and to silence those of every one else."
                            },
                            {
                                "example_id": "b0dda23c-2a07-41a7-8359-9326f688373a",
                                "sense_id": "fdcaff7a-a333-3fd3-87d2-8ccfea367933",
                                "text": "Marlow is a coxcombical prig, that is the truth on't; and if a man will expose himself, why, he must even take what follows."
                            },
                            {
                                "example_id": "675a6c43-bd66-427f-aba7-9928363a9973",
                                "sense_id": "fdcaff7a-a333-3fd3-87d2-8ccfea367933",
                                "text": "Of Wordsworth's demeanour and physical presence, De Quincey's account, silly, coxcombical, and vulgar, is the worst; Carlyle's, as might be expected from his magical gift of portraiture, is the best."
                            }
                        ]
                    }
                ],
