{
    "word_family": [
        "deprecation",
        "deprecatory",
        "deprecative",
        "self-deprecating"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "01de2dfc-007a-3f8d-8ea3-cf3e3be184dc",
                    "sense_definition": "To recommend against using a feature, function, or standard, typically in software, because it is outdated and may be removed in future versions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Software developers tend to <w>deprecate</w> old functions to encourage users to adopt newer security features.    ",
                            "target_lang_translations": {
                                "ru": "Разработчики ПО обычно <w>объявляют устаревшими</w> старые функции, чтобы стимулировать пользователей переходить на новые функции безопасности."
                            }
                        },
                        {
                            "text": "The old application programming interface was <w>deprecated</w> in the latest release.    ",
                            "target_lang_translations": {
                                "ru": "Старый программный интерфейс приложения был <w>признан устаревшим</w> в последнем релизе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "deprecated feature",
                        "deprecated function"
                    ],
                    "target_lang_definitions": {
                        "ru": "Объявлять устаревшим и не рекомендуемым к использованию (о функциях, программах или стандартах)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объявлять устаревшим",
                                "target_lang_sense_clarification": "о функциях или коде"
                            },
                            {
                                "target_lang_word": "признавать устаревшим",
                                "target_lang_sense_clarification": "в разработке ПО"
                            },
                            {
                                "target_lang_word": "прекращать поддержку",
                                "target_lang_sense_clarification": "о стандарте или API"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3b6b788-e633-3c77-8154-2c5185020bb3",
                    "sense_definition": "To belittle or express a low opinion of something, often one's own achievements.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tends to <w>deprecate</w> his own achievements whenever someone compliments his work.    ",
                            "target_lang_translations": {
                                "ru": "Он склонен <w>принижать</w> собственные достижения каждый раз, когда кто-то хвалит его работу."
                            }
                        },
                        {
                            "text": "The artist would often <w>deprecate</w> his early paintings as simple experiments.    ",
                            "target_lang_translations": {
                                "ru": "Художник часто <w>умалял значение</w> своих ранних картин, называя их простыми экспериментами."
                            }
                        }
                    ],
                    "synonyms": [
                        "disparage",
                        "belittle"
                    ],
                    "antonyms": [
                        "praise",
                        "extol"
                    ],
                    "common_phrases": [
                        "deprecate one's own"
                    ],
                    "target_lang_definitions": {
                        "ru": "Умалять значение, принижать или выражать низкое мнение о чём-либо (особенно о собственных достижениях)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принижать",
                                "target_lang_sense_clarification": "собственные заслуги или значение"
                            },
                            {
                                "target_lang_word": "умалять",
                                "target_lang_sense_clarification": "достижения или достоинства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bab3949c-cc8a-3e2e-a462-5f11681021e1",
                    "sense_definition": "To express strong disapproval of an action, policy, or decision.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee members <w>deprecate</w> any action that might disrupt the ongoing negotiations.    ",
                            "target_lang_translations": {
                                "ru": "Члены комитета <w>осуждают</w> любые действия, которые могут сорвать текущие переговоры."
                            }
                        },
                        {
                            "text": "Many citizens began to <w>deprecate</w> the government's sudden decision to raise public transit fares.    ",
                            "target_lang_translations": {
                                "ru": "Многие граждане стали <w>протестовать против</w> внезапного решения правительства повысить стоимость проезда в общественном транспорте."
                            }
                        }
                    ],
                    "synonyms": [
                        "disapprove",
                        "condemn"
                    ],
                    "antonyms": [
                        "approve",
                        "endorse"
                    ],
                    "common_phrases": [
                        "deprecate any action"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражать решительное неодобрение или протест против какого-либо действия, политики или решения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резко осуждать",
                                "target_lang_sense_clarification": "действия или решения"
                            },
                            {
                                "target_lang_word": "не одобрять",
                                "target_lang_sense_clarification": "политику или поступки"
                            },
                            {
                                "target_lang_word": "протестовать",
                                "target_lang_sense_clarification": "против какого-либо шага"
                            },
                            {
                                "target_lang_word": "выступать против",
                                "target_lang_sense_clarification": "какого-либо решения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58f88636-8297-3df0-bd5d-dcdb088427b6",
                    "sense_definition": "To regret deeply or feel deep remorse about something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In his personal diary, he came to <w>deprecate</w> the harsh harsh decisions he made during his youth.    ",
                            "target_lang_translations": {
                                "ru": "В своем личном дневнике он выражал глубокое <w>сожаление</w> о суровых решениях, принятых в молодости."
                            }
                        },
                        {
                            "text": "She deeply <w>deprecated</w> the misunderstanding that ruined their long friendship.    ",
                            "target_lang_translations": {
                                "ru": "Она глубоко <w>сожалела</w> о недопонимании, разрушившем их долгую дружбу."
                            }
                        }
                    ],
                    "synonyms": [
                        "deplore",
                        "regret"
                    ],
                    "target_lang_definitions": {
                        "ru": "Глубоко сожалеть или испытывать сильное раскаяние по поводу чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оплакивать",
                                "target_lang_sense_clarification": "содеянное или ошибку"
                            },
                            {
                                "target_lang_word": "сожалеть",
                                "target_lang_sense_clarification": "о поступках или решениях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3f9f35b-db39-3ac9-8116-334170b07151",
                    "sense_definition": "To pray for deliverance from or prevention of evil, disaster, or punishment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient priest led a ritual to <w>deprecate</w> the impending famine facing the village.    ",
                            "target_lang_translations": {
                                "ru": "Древний жрец провел ритуал, чтобы <w>отвратить молитвою</w> надвигающийся на деревню голод."
                            }
                        },
                        {
                            "text": "They gathered at the temple to <w>deprecate</w> divine wrath during the storm.    ",
                            "target_lang_translations": {
                                "ru": "Они собрались в храме, чтобы <w>молить об отвращении</w> божественного гнева во время шторма."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used primarily in historical or religious contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Молиться об отвращении зла, бедствия или наказания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молить об отвращении",
                                "target_lang_sense_clarification": "беды или гнева"
                            },
                            {
                                "target_lang_word": "отвращать молитвою",
                                "target_lang_sense_clarification": "наказание или зло"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}