            "senses": [
                {
                    "sense_id": "e7c72f62-cc35-31a7-94c3-65d7267d5a55",
                    "sense_definition": "Zonder verzet; berustend in de situatie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij maakte een wel erg <w>gelaten</w> indruk na het slechte nieuws.",
                            "target_lang_translations": {
                                "en": "He made a very <w>resigned</w> impression after the bad news.",
                                "ru": "Он производил очень <w>покорное</w> впечатление после плохих новостей.",
                                "it": "Ha fatto un'impressione davvero molto <w>rassegnata</w> dopo la cattiva notizia."
                            }
                        },
                        {
                            "text": "Met een <w>gelaten</w> blik keek zij naar de vertrekkende trein.",
                            "target_lang_translations": {
                                "en": "With a <w>resigned</w> look, she watched the departing train.",
                                "ru": "С <w>смиренным</w> взглядом она смотрела на уходящий поезд.",
                                "it": "Con uno sguardo <w>rassegnato</w>, guardò il treno in partenza."
                            }
