                ],
                "senses": [
                    {
                        "sense_id": "078a0b84-d50d-30a6-80c2-39c4d369fa77",
                        "entry_id": "2e61b6dc-b2e7-30dc-829f-9bb974f0da61",
                        "glosses": [
                            "Donner un caractère toulousain à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea6fdf72-d9c3-4006-bd70-1f3ddba36c99",
                                "sense_id": "078a0b84-d50d-30a6-80c2-39c4d369fa77",
                                "text": "L'encens se toulousianise. Après les bonbons, la liqueur, les sirops, les savonnettes, la confiture, la moutarde et le miel parfumés à la violette. C'est au tour de l'encens d'embaumer la fleur-emblême du pays toulousain."
                            },
                            {
                                "example_id": "75871e5d-6897-483f-862c-30ce61cd380e",
                                "sense_id": "078a0b84-d50d-30a6-80c2-39c4d369fa77",
                                "text": "Mais chacun sait que l'air toulousain est bon pour le rugbyman donc attendons encore un peu, au moins qu'il ait joué quelque matchs et qu'il se soit toulousianisé"
                            },
                            {
                                "example_id": "e35ebbc8-5900-4f0b-9a38-718bccf215f5",
                                "sense_id": "078a0b84-d50d-30a6-80c2-39c4d369fa77",
                                "text": "Erreur de Parigo pas encore tout a fais toulousianisé"
                            },
                            {
                                "example_id": "0f3dd29f-d9f8-4589-8648-011c8756e2e1",
                                "sense_id": "078a0b84-d50d-30a6-80c2-39c4d369fa77",
                                "text": "Faut faire gaffe t'es en train de toulousianiser......"
                            }
                        ]
                    }
                ],
