                "translations": [
                    {
                        "translation_id": "1b92ca21-5c72-4e36-ab68-4e9a102dc409",
                        "source_entry_id": "d9ec021b-41ba-3918-a45d-842a00cac9b8",
                        "source_sense_description": "monk who lives in a religious community, rather than in solitude",
                        "target_lang_word": "cenobiet mkloosterling",
