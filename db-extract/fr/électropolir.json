                ],
                "senses": [
                    {
                        "sense_id": "368991e4-61f2-3a09-9a0a-d1fe97354525",
                        "entry_id": "e4d51f21-361b-38cb-b34e-bdfb376efaa5",
                        "glosses": [
                            "Polir par un procédé électrochimique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60b3f60b-16ec-4dec-926b-ecfbd062a9b4",
                                "sense_id": "368991e4-61f2-3a09-9a0a-d1fe97354525",
                                "text": "La pièce à électropolir est plongée dans un électrolyte approprié pour que l'on obtienne soit le poli et brillant, soit l'un ou l'autre et reliée au pôle positif d'un redresseur, le pôle négatif étant relié à la cathode ; cette dernière étant si possible de composition identique au matériau traité."
                            },
                            {
                                "example_id": "9ba30b33-05cb-45a9-a5d4-9b1de6790ddc",
                                "sense_id": "368991e4-61f2-3a09-9a0a-d1fe97354525",
                                "text": "Nous pouvons électropolir des bidons de série 300 d'acier inoxydable."
                            },
                            {
                                "example_id": "cfb96994-50f2-4456-823a-d8cfe8a6cc49",
                                "sense_id": "368991e4-61f2-3a09-9a0a-d1fe97354525",
                                "text": "La présente invention concerne l'utilisation d'un additif choisi à partir du groupe constitué par la silice amorphe, la poudre de graphite et un mélange de celles-ci, dans un procédé pour électroplaquer ou électropolir un métal sur substrat, à l'aide d'un liquide ionique comme électrolyte, pour augmenter l'épaisseur de couche métallique."
                            }
                        ]
                    }
                ],
