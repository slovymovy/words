                            {
                                "example_id": "dc78646c-b5b0-4f60-ad24-d6742607917b",
                                "sense_id": "179fb4dd-4c0c-3e80-bcf8-a6f17cc8d677",
                                "text": "De boer voedt zijn koeien met snijmais.",
                                "translation": "The farmer feeds his cows with chopped maize.",
                                "english": "The farmer feeds his cows with chopped maize."
                            },
                            {
                                "example_id": "d070483e-e9a5-4403-a120-8bc5ce7c022d",
                                "sense_id": "179fb4dd-4c0c-3e80-bcf8-a6f17cc8d677",
                                "text": "Snijmais is een belangrijk onderdeel van het dieet van het vee.",
                                "translation": "Chopped corn is an important part of the livestock's diet.",
                                "english": "Chopped corn is an important part of the livestock's diet."
                            },
                            {
                                "example_id": "eb5d77fc-5a87-423b-8c52-d042205e9abc",
                                "sense_id": "179fb4dd-4c0c-3e80-bcf8-a6f17cc8d677",
                                "text": "Ze gebruiken snijmais als goedkope voeding voor de varkens.",
                                "translation": "They use chopped maize as cheap fodder for the pigs.",
                                "english": "They use chopped maize as cheap fodder for the pigs."
                            }
                        ]
                    }
