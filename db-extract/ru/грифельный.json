                "translations": [
                    {
                        "translation_id": "34a28826-7dcc-4865-81d8-0c9b83923734",
                        "source_entry_id": "74015ddd-570a-34dc-8214-9c2794b9705a",
                        "source_sense_description": "связанный, соотносящийся по значению с существительным грифель",
                        "target_lang_word": "slate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c6a48b90-18ec-3dad-ae23-8a70dd41aae1",
                                        "entry_id": "b5061db8-77bd-30ac-820d-f6e1df4689e8",
                                        "glosses": [
                                            "A fine-grained homogeneous sedimentary rock composed of clay or volcanic ash which has been metamorphosed so that it cleaves easily into thin layers."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfb2e89c-3900-4b77-8546-2519dd57fd91",
                                                "sense_id": "c6a48b90-18ec-3dad-ae23-8a70dd41aae1",
                                                "text": "Some of the minor Welsh 2 ft. gauge railways, we hear from Mr. N. F. G. Dalston, are enjoying a miniature boom owing to the demand for slate for the repair of damaged roofs."
                                            },
                                            {
                                                "example_id": "bd9c3d0e-27ef-4b14-9a99-d29ed8c6391d",
                                                "sense_id": "c6a48b90-18ec-3dad-ae23-8a70dd41aae1",
                                                "text": "The Penrhyn slate quarry possibly dates back to the sixteenth century, as it appears that in 1580 Sion Tudor asked the Bishop of Bangor for a shipload of slate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c56f41c4-e9cc-30b1-931b-cac98a99c08d",
                                        "entry_id": "b5061db8-77bd-30ac-820d-f6e1df4689e8",
                                        "glosses": [
                                            "The bluish-grey colour of most slate."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "009d3348-8e94-3e5e-8de6-9cdb78020b25",
                                        "entry_id": "b5061db8-77bd-30ac-820d-f6e1df4689e8",
                                        "glosses": [
                                            "A chalkboard, sheet of slate for writing on with chalk or with a thin rod of slate (a slate pencil) formerly commonly used by both students and teachers in schools."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecac57fe-da05-4f13-b5fd-1d5821c950b6",
                                                "sense_id": "009d3348-8e94-3e5e-8de6-9cdb78020b25",
                                                "text": "He wrote all down one side of the slate and all up the other, and then remarked--\"As there's no time to finish that, The time has come to have our chat.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "421460f5-8393-3637-b387-a862b87058fe",
                                        "entry_id": "b5061db8-77bd-30ac-820d-f6e1df4689e8",
                                        "glosses": [
                                            "A roofing-tile made of slate."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f48955c-7a23-40bd-92ac-68227fb445b2",
                                                "sense_id": "421460f5-8393-3637-b387-a862b87058fe",
                                                "text": "In 1765 only 80 men were employed, and the annual output of slates did not exceed 1,000 tons, and large-scale quarrying was not begun by Lord Penrhyn until 1782."
                                            },
                                            {
                                                "example_id": "50367fba-8fb9-49e7-be9a-811f48ea6c98",
                                                "sense_id": "421460f5-8393-3637-b387-a862b87058fe",
                                                "text": "The necessary works were extensive and included replacing missing and damaged slates and other roof repairs (in order to make the building watertight), pointing and drainpipe replacement, and extensive replacement of rotten floorboarding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b21bf55-e1c3-3ce3-b3db-aaf12acb208c",
                                        "entry_id": "b5061db8-77bd-30ac-820d-f6e1df4689e8",
                                        "glosses": [
                                            "A record of money owed."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fde1a83c-effd-413c-b1cd-8f4e74202cbc",
                                                "sense_id": "5b21bf55-e1c3-3ce3-b3db-aaf12acb208c",
                                                "text": "Put it on my slate – I’ll pay you next week."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0967b976-e01a-35be-b4d5-3fea6586acef",
                                        "entry_id": "b5061db8-77bd-30ac-820d-f6e1df4689e8",
                                        "glosses": [
                                            "A list of affiliated candidates for an election."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "373b6f9f-0270-4e20-b9fa-540ce9fedc10",
                                                "sense_id": "0967b976-e01a-35be-b4d5-3fea6586acef",
                                                "text": "Ice is one of a slate of young, idealistic candidates for Move Forward who have joined mainstream politics in the hope that this election allows Thailand to break the cycle of military coups […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ef0b0ee-5f85-3334-9e1d-d4d5a5e0cc4b",
                                        "entry_id": "b5061db8-77bd-30ac-820d-f6e1df4689e8",
                                        "glosses": [
                                            "A schedule."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6768d9b2-878c-4367-abef-5cca8f2315f4",
                                                "sense_id": "0ef0b0ee-5f85-3334-9e1d-d4d5a5e0cc4b",
                                                "text": "The Chairman James Kaplan tended to his busy slate of record and film projects, while Mia, too, actively sought movie work, somewhat to her husband's chagrin."
                                            },
                                            {
                                                "example_id": "e309fa34-027b-481b-a986-d0c693241fc3",
                                                "sense_id": "0ef0b0ee-5f85-3334-9e1d-d4d5a5e0cc4b",
                                                "text": "If it sounds like an impossibly busy slate, it turned out to be just that."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d38d0c6-91f4-3c0b-9029-f0e7f066907c",
                                        "entry_id": "b5061db8-77bd-30ac-820d-f6e1df4689e8",
                                        "glosses": [
                                            "A collection of movie releases in a certain period, either from one studio or Hollywood as a whole."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ceac884-643a-4429-a9c4-2ef757cb96b9",
                                                "sense_id": "7d38d0c6-91f4-3c0b-9029-f0e7f066907c",
                                                "text": "Like many independents that have established a strong if narrow niche, Central Park says it prospers when \"A\" titles are in short supply, but Pascuzzi much prefers a crowded slate because of trickle-down economics."
                                            },
                                            {
                                                "example_id": "ca6bc959-da11-4471-b1eb-1edaca4fd952",
                                                "sense_id": "7d38d0c6-91f4-3c0b-9029-f0e7f066907c",
                                                "text": "MVL Film Finance LLC (MVL) was created to partially finance Marvel Studios' production of a slate of 10 live-action or animated films based on up to 10 of Marvel's comic book characters[…]"
                                            },
                                            {
                                                "example_id": "a9c99788-857a-409d-95cf-5bfed0c05b49",
                                                "sense_id": "7d38d0c6-91f4-3c0b-9029-f0e7f066907c",
                                                "text": "This overcrowded blockbuster slate has led to the death of the respectable mid-budget movie, which has arguably migrated to prestige television along with writers, directors and actors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3ee6c42-f73c-3e43-8223-09514780f41a",
                                        "entry_id": "b5061db8-77bd-30ac-820d-f6e1df4689e8",
                                        "glosses": [
                                            "An artificial material resembling slate and used for the same purposes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "48a7b40a-5137-34da-ad18-275270542d02",
                                        "entry_id": "b5061db8-77bd-30ac-820d-f6e1df4689e8",
                                        "glosses": [
                                            "A thin plate of any material; a flake."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "993f1441-5983-3d85-a933-6fd1f9019189",
                                        "entry_id": "b5061db8-77bd-30ac-820d-f6e1df4689e8",
                                        "glosses": [
                                            "A tablet computer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9af13048-3502-414f-870d-1784976c2f28",
                                                "sense_id": "993f1441-5983-3d85-a933-6fd1f9019189",
                                                "text": "Hearing Steve Ballmer and others talk about the availability of Windows 8 on slates, laptops, netbooks, notebooks, and screens from 7 to 70 inches might lead us to believe that Microsoft is attempting to gain market share solely through […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54b97dfa-1624-3813-833b-b3c3f781f9a7",
                                        "entry_id": "b5061db8-77bd-30ac-820d-f6e1df4689e8",
                                        "glosses": [
                                            "A clapperboard."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
