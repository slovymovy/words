{
    "word_family": [
        "mould"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f0c715f7-52b9-3acd-9e6d-9fb3c5b44135",
                    "sense_definition": "Covered with a fungal growth, typically due to decay.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "decay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bread had been in the cupboard for too long and was completely <w>mouldy</w>.",
                            "target_lang_translations": {
                                "ru": "Хлеб слишком долго пролежал в шкафу и был совершенно <w>заплесневелым</w>."
                            }
                        },
                        {
                            "text": "Do not eat that <w>mouldy</w> cheese because it might make you sick.",
                            "target_lang_translations": {
                                "ru": "Не ешь этот <w>заплесневелый</w> сыр, иначе тебе может стать плохо."
                            }
                        }
                    ],
                    "synonyms": [
                        "rotten",
                        "moldy"
                    ],
                    "common_phrases": [
                        "mouldy bread",
                        "mouldy cheese"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрытый плесенью, испорченный от гниения или сырости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плесневелый",
                                "target_lang_sense_clarification": "покрытый плесенью"
                            },
                            {
                                "target_lang_word": "заплесневелый",
                                "target_lang_sense_clarification": "испортившийся от плесени"
                            },
                            {
                                "target_lang_word": "заплесневевший",
                                "target_lang_sense_clarification": "подвергшийся плесени"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c22df386-e8d6-39c3-89d7-53476e3836d7",
                    "sense_definition": "Of poor quality, worthless, or unpleasant.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent his weekend stuck in a <w>mouldy</w> office finishing a boring report.",
                            "target_lang_translations": {
                                "ru": "Он провел выходные, торча в <w>паршивом</w> офисе и дописывая скучный отчет."
                            }
                        },
                        {
                            "text": "I am tired of listening to his <w>mouldy</w> excuses for being late every day.",
                            "target_lang_translations": {
                                "ru": "Мне надоело слушать его <w>гнилые</w> оправдания за ежедневные опоздания."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally to express strong dislike or dismissal."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Паршивый, убогий, неприятный или низкого качества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "паршивый",
                                "target_lang_sense_clarification": "дрянной, отвратительный"
                            },
                            {
                                "target_lang_word": "убогий",
                                "target_lang_sense_clarification": "жалкий, неприятный"
                            },
                            {
                                "target_lang_word": "гнилой",
                                "target_lang_sense_clarification": "дурной, фальшивый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e234a05b-6169-3079-8965-0eb56bc645e2",
                    "sense_definition": "Showing signs of neglect or having been left unused for a long time.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "neglect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old library was filled with <w>mouldy</w> books that nobody had touched for decades.",
                            "target_lang_translations": {
                                "ru": "Старая библиотека была заполнена <w>затхлыми</w> книгами, к которым никто не прикасался десятилетиями."
                            }
                        },
                        {
                            "text": "They found the <w>mouldy</w> equipment in the back of the shed after years of disuse.",
                            "target_lang_translations": {
                                "ru": "Они нашли <w>залежалое</w> оборудование в глубине сарая после многих лет простоя."
                            }
                        }
                    ],
                    "synonyms": [
                        "disused",
                        "neglected"
                    ],
                    "target_lang_definitions": {
                        "ru": "Затхлый, заброшенный или долго не использовавшийся."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затхлый",
                                "target_lang_sense_clarification": "залежавшийся, пропахший сыростью"
                            },
                            {
                                "target_lang_word": "залежалый",
                                "target_lang_sense_clarification": "старый от долгого лежания"
                            },
                            {
                                "target_lang_word": "замшелый",
                                "target_lang_sense_clarification": "перен. ветхий, забытый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "814a1869-7498-3287-8f2a-0673225f0089",
                    "sense_definition": "Having gray or white hair due to old age.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "age",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>mouldy</w> gentleman sat by the fire reflecting on his long life.",
                            "target_lang_translations": {
                                "ru": "<w>Седой</w> джентльмен сидел у камина, размышляя о своей долгой жизни."
                            }
                        },
                        {
                            "text": "He removed his hat to reveal a <w>mouldy</w> head of hair that had turned white with time.",
                            "target_lang_translations": {
                                "ru": "Он снял шляпу, обнажив <w>поседевшую</w> шевелюру, побелевшую от времени."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literary contexts to describe elderly people."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Седой или поседевший от старости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "седой",
                                "target_lang_sense_clarification": "с белыми или серыми волосами"
                            },
                            {
                                "target_lang_word": "поседелый",
                                "target_lang_sense_clarification": "побелевший от возраста"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}