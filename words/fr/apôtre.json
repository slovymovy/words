                {
                    "sense_id": "46be4137-ea87-3a6e-abd6-421b2a33595e",
                    "sense_definition": "Chacun des douze disciples choisis par Jésus-Christ pour propager l'Évangile à travers le monde.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pierre est considéré comme le chef des douze <w>apôtres</w> selon la tradition chrétienne."
                        },
                        {
                            "text": "Ce vitrail de l'église médiévale représente chaque <w>apôtre</w> avec son symbole traditionnel."
                        }
                    ],
                    "synonyms": [
                        "disciple"
                    ],
                    "common_phrases": [
                        "douze apôtres"
                    ]
                },
                {
                    "sense_id": "781f04ac-efdf-364c-b342-72f0672c3163",
                    "sense_definition": "Personne qui défend et propage avec ardeur une idée, une doctrine ou une cause.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "militantisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce philosophe s'est imposé tout au long de sa carrière comme un infatigable <w>apôtre</w> de la paix."
                        },
                        {
                            "text": "La journaliste est devenue une fervente <w>apôtre</w> du respect de l'environnement."
                        }
                    ],
                    "synonyms": [
                        "défenseur",
                        "propagateur",
                        "militant",
                        "héraut"
                    ],
                    "antonyms": [
                        "détracteur",
                        "adversaire"
                    ],
                    "common_phrases": [
