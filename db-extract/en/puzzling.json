                        "target_lang_word": "verwirrend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verwirrend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf47a5f7-b9c7-36f1-9a78-1acbdd5085bc",
                                        "entry_id": "873a218c-8619-3d51-8215-80fd1fafc183",
                                        "glosses": [
                                            "schwierig zu verstehen; durcheinander"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8986df3-08ac-4edf-8bfa-1aeead1c29e2",
                                                "sense_id": "cf47a5f7-b9c7-36f1-9a78-1acbdd5085bc",
                                                "text": "„Was für eine verwirrende Erklärung, ich verstehe kein Wort.“"
                                            },
                                            {
                                                "example_id": "1ec5fca2-1b7a-4a99-8da0-c481936c08b6",
                                                "sense_id": "cf47a5f7-b9c7-36f1-9a78-1acbdd5085bc",
                                                "text": "Beim Sender vermutete man, dass die Zuschauer der komplexen Handlung, in der es eine verwirrende Vielzahl von Protagonisten gab, die einen auch für Amerikaner schwer verständlichen Slang sprachen, einfach nicht folgen konnten."
                                            },
                                            {
                                                "example_id": "55212b49-91eb-4918-815d-ee4a7818091a",
                                                "sense_id": "cf47a5f7-b9c7-36f1-9a78-1acbdd5085bc",
                                                "text": "Naturidentisch, künstlich, natürlich - für Verbraucher waren die Bezeichnungen für Aromen in Lebensmitteln bislang ein beständiges Ärgernis: Verwirrende, unbestimmte Begriffe, bei denen keiner verstand, um welche Inhaltsstoffe es sich tatsächlich handelte."
                                            },
                                            {
                                                "example_id": "2ace1efc-789b-4e37-991e-f422473f3474",
                                                "sense_id": "cf47a5f7-b9c7-36f1-9a78-1acbdd5085bc",
                                                "text": "Einige Hunderassen haben verwirrende Namen. Die Dänische Dogge kommt eigentlich aus Deutschland."
                                            },
                                            {
                                                "example_id": "6e6b7133-5d14-4a77-8f9d-f7cdc4c50af7",
                                                "sense_id": "cf47a5f7-b9c7-36f1-9a78-1acbdd5085bc",
                                                "text": "Bisher verhinderten bestehende Gesetze, ihre [der US-Senatoren Ted Cruz und Chuck Schumer] Fälle vor Gericht zu bringen und Ansprüche geltend zu machen. Schuld war die verwirrende Vielfalt von Verjährungsfristen im US-Rechtssystem."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "verwirrend",
