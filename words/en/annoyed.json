                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant noise from the construction site <w>annoyed</w> the residents.",
                            "target_lang_translations": {
                                "ru": "Постоянный шум со стройки <w>раздражал</w> жителей.",
                                "nl": "Het constante lawaai van de bouwplaats <w>irriteerde</w> de bewoners.",
                                "pl": "Ciągły hałas z placu budowy <w>irytował</w> mieszkańców.",
                                "de": "Der ständige Lärm von der Baustelle hat die Anwohner <w>genervt</w>."
                            }
                        },
                        {
                            "text": "I hope I haven't <w>annoyed</w> you with all my questions.",
                            "target_lang_translations": {
                                "ru": "Надеюсь, я не <w>надоел</w> вам своими вопросами.",
                                "nl": "Ik hoop dat ik je niet heb <w>geïrriteerd</w> met al mijn vragen.",
                                "pl": "Mam nadzieję, że nie <w>zirytowałem</w> cię wszystkimi moimi pytaniami.",
                                "de": "Ich hoffe, ich habe dich mit all meinen Fragen nicht <w>verärgert</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола annoy (раздражать, надоедать).",
                        "nl": "Iemand een gevoel van ongenoegen of irritatie bezorgen.",
                        "pl": "Forma czasu przeszłego czasownika 'annoy', oznaczająca wywoływanie u kogoś irytacji, złości lub zniecierpliwienia.",
                        "de": "Vergangenheit und Partizip von 'nerven' oder 'verärgern' (jemanden stören oder wütend machen)."
                    },
