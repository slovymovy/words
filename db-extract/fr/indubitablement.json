        "fr-extract.jsonl": [
            {
                "entry_id": "a2c16199-e18a-3de3-b421-35dbb57795d8",
                "word": "indubitablement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ea83132a-a755-3da1-a3ae-705618a95aab",
                        "entry_id": "a2c16199-e18a-3de3-b421-35dbb57795d8",
                        "glosses": [
                            "D’une façon indubitable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f4d6896-0176-4439-a04d-3717b71548e8",
                                "sense_id": "ea83132a-a755-3da1-a3ae-705618a95aab",
                                "text": "C'est la muse indubitablement qui inspire les mauvais vielleurs."
                            },
                            {
                                "example_id": "5d578ea6-b45c-45aa-9da6-fb1bfbb1de53",
                                "sense_id": "ea83132a-a755-3da1-a3ae-705618a95aab",
                                "text": "Je vous jure par le Seigneur qu'indubitablement je vous prendrai."
                            },
                            {
                                "example_id": "5fee301d-78fa-4c53-bd0b-99f1c9714bdb",
                                "sense_id": "ea83132a-a755-3da1-a3ae-705618a95aab",
                                "text": "Il y a des gens, à la vérité, qui prétendent qu’un homme qui se vantait d’avoir un génie familier, était indubitablement un peu fou ou un peu fripon."
                            },
                            {
                                "example_id": "b0d4191c-99cf-42e1-a83c-4abf9da7f707",
                                "sense_id": "ea83132a-a755-3da1-a3ae-705618a95aab",
                                "text": "Par malheur, je n’ai point l’art de me contrefaire ; Il vient pour un sujet qui ne saurait me plaire, Et je le marquerais indubitablement."
                            },
                            {
                                "example_id": "d1a7c006-740e-400b-b80a-2713fa2df6d7",
                                "sense_id": "ea83132a-a755-3da1-a3ae-705618a95aab",
                                "text": "En effet, le cap Bathurst et le territoire y confinant se trouvaient indubitablement situés au-dessus du soixante-dixième parallèle."
                            },
                            {
                                "example_id": "8eafe666-3a30-4922-adae-77cab4266fe0",
                                "sense_id": "ea83132a-a755-3da1-a3ae-705618a95aab",
                                "text": "Les Français traversent indubitablement une crise qui n’est pas seulement économique et sociale mais qui est avant tout une crise de la morale."
                            },
                            {
                                "example_id": "7b14ad94-743c-4abc-ad77-b129106afaec",
                                "sense_id": "ea83132a-a755-3da1-a3ae-705618a95aab",
                                "text": "La forêt dense d'un Touareg du milieu saharien sera indubitablement moins boisée que celle d'un Sénoufo de la zone soudanienne, qui elle-même sera considérée comme une forêt claire ou secondaire par un habitant baoulé de la zone guinéenne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d65e80a-2a85-425f-88ba-d70cb8507acc",
                        "source_entry_id": "a2c16199-e18a-3de3-b421-35dbb57795d8",
                        "source_sense_id": "ea83132a-a755-3da1-a3ae-705618a95aab",
                        "target_lang_word": "sicherlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sicherlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b59b08bd-38c8-339d-82fb-37fa4b6a0718",
                                        "entry_id": "4975487c-8fdb-39fc-a7ae-31aa8c89778b",
                                        "glosses": [
                                            "mit ziemlicher Sicherheit; oftmals eine gewisse Beeinschränkung beinhaltend, die zum Beispiel mit aber angeschlossen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efcc9f1b-6ab4-4f17-9d7d-8a8f2666e8a4",
                                                "sense_id": "b59b08bd-38c8-339d-82fb-37fa4b6a0718",
                                                "text": "Sie hat sich sicherlich Mühe gegeben, aber Mühe alleine reicht eben nicht immer."
                                            },
                                            {
                                                "example_id": "9aa492dd-7788-4948-a9d6-9593849347cd",
                                                "sense_id": "b59b08bd-38c8-339d-82fb-37fa4b6a0718",
                                                "text": "Der Artikel ist gut, aber sicherlich ausbaufähig."
                                            },
                                            {
                                                "example_id": "aa2d1e30-b32b-478a-95e4-35dbf3762217",
                                                "sense_id": "b59b08bd-38c8-339d-82fb-37fa4b6a0718",
                                                "text": "Seine Schilderung der Ereignisse entspricht sicherlich der Wahrheit."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9270731d-38b1-4787-9d08-0661aae00680",
                        "source_entry_id": "a2c16199-e18a-3de3-b421-35dbb57795d8",
                        "source_sense_id": "ea83132a-a755-3da1-a3ae-705618a95aab",
                        "target_lang_word": "gewiss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gewiss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ec399d7d-a050-3c80-b455-a9d8b32b9490",
                                        "entry_id": "cfb6552f-a337-37cd-8693-6871937f120c",
                                        "glosses": [
                                            "nicht genau bestimmbar oder bestimmt"
                                        ],
                                        "tags": [
                                            "adjektivisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0a660f8-2617-4f6b-a56d-992b14de25a9",
                                                "sense_id": "ec399d7d-a050-3c80-b455-a9d8b32b9490",
                                                "text": "Ein gewisser Herr Berger hat angerufen und nach dir gefragt."
                                            },
                                            {
                                                "example_id": "9e8583f9-0505-4a4e-9965-cf63548c1137",
                                                "sense_id": "ec399d7d-a050-3c80-b455-a9d8b32b9490",
                                                "text": "Gewisse Anstrengungen sind schon nötig."
                                            },
                                            {
                                                "example_id": "426696fa-163d-49b5-81d1-28446053d61f",
                                                "sense_id": "ec399d7d-a050-3c80-b455-a9d8b32b9490",
                                                "text": "„Das ersehnte Bergerlebnis ist nur auf dem Wege über ein gewisses Wagnis erreichbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6f5608aa-94af-3b9b-99e3-fb0e9f9d630c",
                                        "entry_id": "cfb6552f-a337-37cd-8693-6871937f120c",
                                        "glosses": [
                                            "bekannt, aber nicht genannt"
                                        ],
                                        "tags": [
                                            "adjektivisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7786e86e-ef38-4c6b-9ed2-0535e434ac07",
                                                "sense_id": "6f5608aa-94af-3b9b-99e3-fb0e9f9d630c",
                                                "text": "„Dazu Jerzabek, wörtlich zitiert aus der offiziellen Parlamentsberichterstattung: Sie haben alle das gewisse Plakat schon gesehen, das eine gewisse Dame [nämlich die Tänzerin und Entertainerin Josephine Baker] im Naturkostüm darstellt. (Lebhafte Heiterkeit.)“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "96950a3f-28d3-31b6-8cb4-7197b9913f5b",
                                        "entry_id": "cfb6552f-a337-37cd-8693-6871937f120c",
                                        "glosses": [
                                            "ohne Zweifel bestehend, eintretend"
                                        ],
                                        "tags": [
                                            "adjektivisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa37d7b8-7a42-4f17-8bb4-f7f97f161cd0",
                                                "sense_id": "96950a3f-28d3-31b6-8cb4-7197b9913f5b",
                                                "text": "Nichts ist gewisser als der Tod."
                                            },
                                            {
                                                "example_id": "ef2562a9-1463-447d-93f0-f31f595d4cc6",
                                                "sense_id": "96950a3f-28d3-31b6-8cb4-7197b9913f5b",
                                                "text": "„Wir betten sie in die Erde, von der sie genommen sind, in der gewissen Hoffnung, dass sie auferstehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "ee280c2a-d1ab-3279-a015-4b0e02aa7c85",
                                        "entry_id": "cfb6552f-a337-37cd-8693-6871937f120c",
                                        "glosses": [
                                            "bestimmt, unbedingt, mit Sicherheit"
                                        ],
                                        "tags": [
                                            "adverbial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf3e9931-2f6d-4233-b078-043293092de0",
                                                "sense_id": "ee280c2a-d1ab-3279-a015-4b0e02aa7c85",
                                                "text": "Waren Sie schon mal in Berlin? – Ja gewiss."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2f08f36-c406-45f2-9174-77d685205c4c",
                        "source_entry_id": "a2c16199-e18a-3de3-b421-35dbb57795d8",
                        "source_sense_id": "ea83132a-a755-3da1-a3ae-705618a95aab",
                        "target_lang_word": "indubitably",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indubitably",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62071307-2d00-377e-a78c-6185f01c90c4",
                                        "entry_id": "faaef75f-2bc4-33f7-8a23-559169489018",
                                        "glosses": [
                                            "In a manner that leaves no possibility of doubt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86617ae7-a0da-4c8b-b229-aa6813c87142",
                                                "sense_id": "62071307-2d00-377e-a78c-6185f01c90c4",
                                                "text": "Now his first suspicion was indubitably confirmed."
                                            },
                                            {
                                                "example_id": "2983e14b-ccc8-4b30-94dc-1163495867da",
                                                "sense_id": "62071307-2d00-377e-a78c-6185f01c90c4",
                                                "text": "Near-synonyms: verifiably, provably"
                                            },
                                            {
                                                "example_id": "04471c59-748a-42e7-b85f-4970a6f826fd",
                                                "sense_id": "62071307-2d00-377e-a78c-6185f01c90c4",
                                                "text": "The world is indubitably one if you look at it in one way, but as indubitably is it many, if you look at it in another. It is both one and many—let us adopt a sort of pluralistic monism."
                                            },
                                            {
                                                "example_id": "b34a0cb4-9e16-4f0d-8f85-0b3304ac3e76",
                                                "sense_id": "62071307-2d00-377e-a78c-6185f01c90c4",
                                                "text": "They were all indubitably, aggressively alive! Everybody was alive once more!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98a40fc6-5d71-4a2c-a74f-2e6a77358515",
                        "source_entry_id": "a2c16199-e18a-3de3-b421-35dbb57795d8",
                        "source_sense_id": "ea83132a-a755-3da1-a3ae-705618a95aab",
                        "target_lang_word": "undoubtedly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "undoubtedly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d029404e-669d-37e2-b38e-453373cf8f8f",
                                        "entry_id": "c765d208-4c5e-32dd-9549-1f8c430d2e6c",
                                        "glosses": [
                                            "Without doubt; definitely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f14f2397-0f7b-4e01-bea5-73e800d079a6",
                                                "sense_id": "d029404e-669d-37e2-b38e-453373cf8f8f",
                                                "text": "The cane was undoubtedly of foreign make, for it had a solid silver ferrule at one end, which was not English hall–marked."
                                            },
                                            {
                                                "example_id": "1ce691d9-5a8c-4522-89d8-2374aeee8b87",
                                                "sense_id": "d029404e-669d-37e2-b38e-453373cf8f8f",
                                                "text": "He declared that these drastic steps would undoubtedly inconvenience a good many people, but the alternative was bankruptcy of the Ulster Transport Authority and the breakdown of public transport services."
                                            },
                                            {
                                                "example_id": "67475126-f87b-45d9-b8cc-5c05c8488998",
                                                "sense_id": "d029404e-669d-37e2-b38e-453373cf8f8f",
                                                "text": "“It’s been a long process and I’ve come close to giving up along the way, but this is undoubtedly the craziest archaeological excavation I’ve yet been part of,” Bloch said in the news release."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6198dc38-679e-4f5f-bc33-f01cf54fdc5c",
                        "source_entry_id": "a2c16199-e18a-3de3-b421-35dbb57795d8",
                        "source_sense_id": "ea83132a-a755-3da1-a3ae-705618a95aab",
