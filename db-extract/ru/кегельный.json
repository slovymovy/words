                        ],
                        "form": "ке́гельна"
                    },
                    {
                        "form_id": "021339dc-239d-4abc-bb14-910e2d1c1276",
                        "entry_id": "8ff13733-0ec5-3ecd-9f31-606380b5dcab",
                        "tags": [
                            "plural",
