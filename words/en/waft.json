{
    "word_family": [
        "wafter",
        "waftage"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d618bcbc-f3ae-3970-8ae0-f70a9b42fb4f",
                    "sense_definition": "To cause something to float easily or gently through the air.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A gentle breeze <w>wafted</w> the sweet scent of flowers through the open window.",
                            "target_lang_translations": {
                                "cs": "Jemný vánek <w>nesl</w> sladkou vůni květin otevřeným oknem."
                            }
                        },
                        {
                            "text": "The wind <w>wafted</w> the smoke from the campfire across the entire valley.",
                            "target_lang_translations": {
                                "cs": "Vítr <w>roznesl</w> kouř z táboráku po celém údolí."
                            }
                        }
                    ],
                    "common_phrases": [
                        "waft through air"
                    ],
                    "target_lang_definitions": {
                        "cs": "Způsobit, aby se něco lehce nebo jemně vznášelo vzduchem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nést se",
                                "target_lang_sense_clarification": "pohybovat se vzduchem"
                            },
                            {
                                "target_lang_word": "vát",
                                "target_lang_sense_clarification": "pohybovat se vlivem větru"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "744793cf-0294-38e2-a47f-7be2d2eee949",
                    "sense_definition": "To float or move gently on a buoyant medium like air or water.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sound of distant music <w>wafted</w> across the calm lake at night.",
                            "target_lang_translations": {
                                "cs": "Zvuk vzdálené hudby se v noci <w>nesl</w> přes klidné jezero."
                            }
                        },
                        {
                            "text": "Fragrant steam <w>wafted</w> from the hot bowl of soup on the table.",
                            "target_lang_translations": {
                                "cs": "Z horké mísy polévky na stole se <w>linula</w> vonná pára."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Vznášet se nebo se jemně pohybovat v médiu, jako je vzduch nebo voda."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nést se",
                                "target_lang_sense_clarification": "volně se šířit vzduchem"
                            },
                            {
                                "target_lang_word": "linout se",
                                "target_lang_sense_clarification": "šířit se (o vůni nebo zvuku)"
                            },
                            {
                                "target_lang_word": "vznášet se",
                                "target_lang_sense_clarification": "volně se pohybovat v prostoru"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ffed027-8360-36ae-9521-b143f35b3a6e",
                    "sense_definition": "To signal or beckon to someone by waving the hand or an object.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>wafted</w> to her friend across the crowded room to get her attention.",
                            "target_lang_translations": {
                                "cs": "Přes přeplněnou místnost <w>zamávala</w> na svou přítelkyni, aby upoutala její pozornost."
                            }
                        },
                        {
                            "text": "The guard <w>wafted</w> the car forward with a quick motion of his hand.",
                            "target_lang_translations": {
                                "cs": "Strážný rychlým pohybem ruky <w>pokynul</w> autu, aby jelo vpřed."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely literary or dated."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Dát znamení nebo pokyn mávnutím ruky či předmětem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zamávat",
                                "target_lang_sense_clarification": "dát znamení rukou"
                            },
                            {
                                "target_lang_word": "pokynout",
                                "target_lang_sense_clarification": "dát znamení k pohybu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a2e66bc4-c843-35e2-9b2d-1351b6673f78",
                    "sense_definition": "A light, gentle breeze or puff of air.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "air_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A cool <w>waft</w> of air greeted us as we stepped outside.",
                            "target_lang_translations": {
                                "cs": "Když jsme vyšli ven, přivítal nás chladný <w>závan</w> vzduchu."
                            }
                        },
                        {
                            "text": "The curtains moved slightly with every <w>waft</w> of the summer wind.",
                            "target_lang_translations": {
                                "cs": "Záclony se lehce pohnuly s každým <w>závanem</w> letního větru."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Lehký, jemný vánek nebo závan vzduchu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "závan",
                                "target_lang_sense_clarification": "krátký pohyb vzduchu"
                            },
                            {
                                "target_lang_word": "vánek",
                                "target_lang_sense_clarification": "jemný vítr"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32c31dbb-7f4c-3aba-8b7b-ca9f48a914d1",
                    "sense_definition": "A scent or odor carried through the air.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "air_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A delicious <w>waft</w> of freshly baked bread came from the kitchen.",
                            "target_lang_translations": {
                                "cs": "Z kuchyně se linul lahodný <w>závan</w> čerstvě upečeného chleba."
                            }
                        },
                        {
                            "text": "I caught a faint <w>waft</w> of perfume as she walked past me.",
                            "target_lang_translations": {
                                "cs": "Když kolem mě prošla, zachytil jsem slabý <w>závan</w> parfému."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Vůně nebo pach nesený vzduchem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "závan",
                                "target_lang_sense_clarification": "krátké ucítění vůně"
                            },
                            {
                                "target_lang_word": "vůně",
                                "target_lang_sense_clarification": "příjemný pach šířící se vzduchem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6448d303-f903-35ec-9fed-e5c6c9a4a71b",
                    "sense_definition": "A flag used as a signal or to show wind direction.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship raised a <w>waft</w> to signal its position to the harbor master.",
                            "target_lang_translations": {
                                "cs": "Loď vztyčila <w>signální vlajku</w>, aby oznámila svou polohu přístavnímu mistrovi."
                            }
                        },
                        {
                            "text": "The old sailor pointed to the <w>waft</w> fluttering at the top of the mast.",
                            "target_lang_translations": {
                                "cs": "Starý námořník ukázal na <w>vlajku</w> třepotající se na vrcholu stěžně."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This term is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Vlajka používaná jako signál nebo k určení směru větru."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "signální vlajka",
                                "target_lang_sense_clarification": "námořní signalizační prostředek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd4dc18d-f6bc-3bcc-8d96-9505d52e100c",
                    "sense_definition": "A loose, noncommittal cricket shot played to a ball pitched wide.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The batsman played a lazy <w>waft</w> at the ball outside the off stump.",
                            "target_lang_translations": {
                                "cs": "Pálkař provedl líný <w>odpal</w> na míč mimo branku."
                            }
                        },
                        {
                            "text": "His <w>waft</w> missed the ball entirely and nearly hit the wicket.",
                            "target_lang_translations": {
                                "cs": "Jeho <w>odpal</w> míč úplně minul a málem zasáhl branku."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Laxní, nezávazný odpal v kriketu mířený na míč mimo pálkaře."
                    },
                    "translations": {
                        "cs": []
                    }
                }
            ]
        }
    ]
}