                                        "sense_id": "289e073b-59ed-3ac4-bf6d-831790592b52",
                                        "entry_id": "e413ecf1-e908-3e20-a46b-cb05a4783626",
                                        "glosses": [
                                            "einen Text oder ein Dokument auslegend und erklärend"
