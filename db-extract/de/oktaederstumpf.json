                        "entry_id": "46fd850d-49fa-34d3-94ec-f626d353b4b4",
                        "glosses": [
                            "Polyeder, das durch Abstumpfung der Ecken eines Oktaeders entsteht"
                        ],
                        "tags": [
                            "geometry"
                        ],
                        "examples": [
                            {
                                "example_id": "d5b423be-7232-4708-8880-189aeb9089e3",
                                "sense_id": "7f9aeb72-ec02-33b4-b82b-9ae706eb800e",
