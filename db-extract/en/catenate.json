                    }
                ],
                "translations": [
                    {
                        "translation_id": "af02dcd0-f904-4195-b0ec-359e64a15542",
                        "source_entry_id": "5ae8565e-b934-3e83-b026-75575c06c868",
                        "source_sense_id": "d578a90f-f8c1-3d3d-af33-c6c5a368b451",
                        "source_sense_description": "eine Verbindung zwischen Teilen herstellen",
                        "target_lang_word": "verketten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verketten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bb3ebcb7-e245-39df-8b80-84e6a031696e",
                                        "entry_id": "3ac0970b-35db-385c-8896-901a8dd3708f",
                                        "glosses": [
                                            "einzelne Dinge/Elemente/Kettenglieder miteinander (mechanisch) fest verbinden"
                                        ],
                                        "tags": [
                                            "reflexive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4917fa0c-2c60-4dbd-a80b-25076b7aa47a",
                                                "sense_id": "bb3ebcb7-e245-39df-8b80-84e6a031696e",
                                                "text": "„Die grundsätzliche Aussage ist demnach, der Mensch verdaut Proteine und produziert sie bei Bedarf selbst durch verketten von Aminosäuren.“"
                                            },
                                            {
                                                "example_id": "7fe4806e-fca6-49de-938d-6f8d78c302ce",
                                                "sense_id": "bb3ebcb7-e245-39df-8b80-84e6a031696e",
                                                "text": "„Sie schauen sich in die Augen und lachen wie zwei sonnenhafte Kinder. Wie in einem Tango bewegen sich beide aufeinander, lassen los und verketten sich wieder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7e7813e0-cd4e-39e8-ac2f-a3cd482ef5b3",
                                        "entry_id": "3ac0970b-35db-385c-8896-901a8dd3708f",
                                        "glosses": [
                                            "etwas mit Hilfe eines gegliederten Verbindungsstücks (einer Kette) zusammenschließen/absperren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2241a963-d727-4704-89c6-ffe2add253e7",
                                                "sense_id": "7e7813e0-cd4e-39e8-ac2f-a3cd482ef5b3",
                                                "text": "„Auf dem Vorplatz stehen die Fahrräder der Pendler in wilden Knäueln und sind an Zäunen und Laternen verkettet.“"
                                            },
                                            {
                                                "example_id": "ddd48161-12fb-4afc-9c45-6b1842de208c",
                                                "sense_id": "7e7813e0-cd4e-39e8-ac2f-a3cd482ef5b3",
                                                "text": "Nachdem so oft eingebrochen wurde, verkettete Opa den Kellerverschlag und sicherte das Ganze mit einem dicken Vorhängeschloss der höchsten Sicherheitsklasse."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "131ef889-9197-3621-9ca8-628fd4b36ad6",
                                        "entry_id": "3ac0970b-35db-385c-8896-901a8dd3708f",
                                        "glosses": [
                                            "einzelne Dinge/Momente durch eine logische Verbindung zueinander in Bezug setzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79d4d2a4-f9ac-4f31-b1f1-a9c7816f75b7",
                                                "sense_id": "131ef889-9197-3621-9ca8-628fd4b36ad6",
                                                "text": "Wenn wir nun diese drei Begriffe unterschiedlicher Herkunft miteinander verketten, kommen wir zu völlig neuen Denkansätzen."
                                            },
                                            {
                                                "example_id": "6b35dcdd-a85d-4991-8b4b-d9642c31a890",
                                                "sense_id": "131ef889-9197-3621-9ca8-628fd4b36ad6",
                                                "text": "„Nichts Wichtiges auszulassen, nichts zu vergessen, alles mit allem zu verketten - darauf zielt diese Anlage der Bücher, darauf das Verfahren der - oft erst in weitem Abstand erfolgenden - wiederholten Rückkehren auf denselben Gegenstand aus jeweils anderer Perspektive.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
