                "senses": [
                    {
                        "sense_id": "54be2743-ad76-33e8-ba79-d0aef0e97a26",
                        "entry_id": "59ce79c6-6094-357b-88fe-63482c944c80",
                        "glosses": [
                            "Action de paramétrer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8debae76-20c1-4218-aa64-c6c087761ad5",
                                "sense_id": "54be2743-ad76-33e8-ba79-d0aef0e97a26",
                                "text": "J'ai fini le paramétrage de ton logiciel de messagerie, tu peux l'utiliser."
                            },
                            {
                                "example_id": "3e38de82-e15d-4b3f-8e42-0e412498cc92",
                                "sense_id": "54be2743-ad76-33e8-ba79-d0aef0e97a26",
                                "text": "Le paramétrage consiste à rendre effective cette adaptation du progiciel aux caractéristiques et aux besoins de l’entreprise par la détermination des paramètres à considérer et des valeurs qu'ils devront prendre."
                            }
                        ]
                    },
                    {
                        "sense_id": "cd772c36-dacb-3af7-95cb-a435d8769abb",
                        "entry_id": "59ce79c6-6094-357b-88fe-63482c944c80",
                        "glosses": [
                            "Ensemble des paramètres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "864f0832-1499-459f-b7f6-1d1faf9d4ffc",
                                "sense_id": "cd772c36-dacb-3af7-95cb-a435d8769abb",
                                "text": "Quel est le paramétrage de votre logiciel de messagerie ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd55e74a-73ae-4740-af19-7b525a2b19ff",
                        "source_entry_id": "59ce79c6-6094-357b-88fe-63482c944c80",
                        "source_sense_description": "Action de paramétrer",
                        "target_lang_word": "setup",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "setup",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "727d668a-3006-3306-9d5e-7a224d4f1061",
                                        "entry_id": "cc8f7334-7751-3680-abf8-966c3b65887b",
                                        "glosses": [
                                            "Equipment designed for a particular purpose; an apparatus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "459df6b6-3f3e-4ac8-bd3d-f53aeea86eca",
                                                "sense_id": "727d668a-3006-3306-9d5e-7a224d4f1061",
                                                "text": "The laboratory included an elaborate setup for measuring the energy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ae11673-18d3-31b3-b284-988604462870",
                                        "entry_id": "cc8f7334-7751-3680-abf8-966c3b65887b",
                                        "glosses": [
                                            "The fashion in which something is organized or arranged."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dca3097d-9efc-408c-ae29-1a846b7e5529",
                                                "sense_id": "5ae11673-18d3-31b3-b284-988604462870",
                                                "text": "The classroom setup was simple and efficient."
                                            },
                                            {
                                                "example_id": "bced881e-ea13-4da9-a6b3-b46a65b3c763",
                                                "sense_id": "5ae11673-18d3-31b3-b284-988604462870",
                                                "text": "Shapiro says KYW would keep two separate news staffs that would work together, similar to WBZ's setup."
                                            },
                                            {
                                                "example_id": "7f348368-dfa9-437b-a995-258343fc2eda",
                                                "sense_id": "5ae11673-18d3-31b3-b284-988604462870",
                                                "text": "For some stretches, Berhalter’s usual 4-3-3 setup played more as a 4-4-2, with Tim Weah pushing up alongside Wright and McKennie moving to the right side."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3488a74a-06dd-3edf-b2c2-44d2c7092497",
                                        "entry_id": "cc8f7334-7751-3680-abf8-966c3b65887b",
                                        "glosses": [
                                            "A situation orchestrated to frame someone; a covert effort to place the blame on somebody."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd8a844b-37df-4b6f-819e-f526349c5b12",
                                                "sense_id": "3488a74a-06dd-3edf-b2c2-44d2c7092497",
                                                "text": "Trust me, that was a setup!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdf71571-a710-396b-9aff-531ea8fad06f",
                                        "entry_id": "cc8f7334-7751-3680-abf8-966c3b65887b",
                                        "glosses": [
                                            "An installer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b9d7450-8ee6-4493-8ea3-3d1286ce3baf",
                                                "sense_id": "fdf71571-a710-396b-9aff-531ea8fad06f",
                                                "text": "You still have to run the setup and select the display driver after restarting Windows. Installing Windows NT drivers was tedious (but we could back up system files), and OS/2 was tiresome; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d3a58b3-8b58-3dfb-a218-277023b15fcf",
                                        "entry_id": "cc8f7334-7751-3680-abf8-966c3b65887b",
                                        "glosses": [
                                            "The process or instance of arranging resources for performing a specific operation, as a run of a particular product."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc453edb-5e0a-40b0-af7e-b2b88ea1ba7a",
                                                "sense_id": "5d3a58b3-8b58-3dfb-a218-277023b15fcf",
                                                "text": "A simple setup on the bottling line involves reloading bottles and labels; emptying, cleaning, and reloading the tanks; and a test run."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c35ad78-09d3-33da-be1e-d8e35e2e8f1c",
                                        "entry_id": "cc8f7334-7751-3680-abf8-966c3b65887b",
                                        "glosses": [
                                            "The tendency of persistent wind to produce higher water levels at the downwind shore of a body of water and lower at the upwind shore."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15a89406-d8f2-451a-9b0d-d9329b159575",
                                                "sense_id": "5c35ad78-09d3-33da-be1e-d8e35e2e8f1c",
                                                "text": "There was a strong wind setup at the south end of the lake after a day of northerly gales."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92b34854-a00c-3049-aed9-e56b1265fc73",
                                        "entry_id": "cc8f7334-7751-3680-abf8-966c3b65887b",
                                        "glosses": [
                                            "A move or set of moves which are meant to draw out a reaction which leaves an exploitable opening in defense."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "455b2c69-d67e-4f1a-8c09-4eeaa35809fb",
                                                "sense_id": "92b34854-a00c-3049-aed9-e56b1265fc73",
                                                "text": "The jab is most commonly used as a setup for other strikes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "setup",
