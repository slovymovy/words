                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90efee1f-d168-47dc-8acf-37e55b3edd7e",
                        "source_entry_id": "c239721b-13ff-3190-aa09-744b9154a4e4",
                        "source_sense_id": "20be6067-261f-378b-b113-9e89ce1d2eeb",
                        "target_lang_word": "Keton",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Keton",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3d1b49fc-830a-3939-9e86-dac70008da90",
                                        "entry_id": "183a079e-c189-3b43-845d-e9020b7df88e",
                                        "glosses": [
                                            "organische Verbindung, die eine oder mehrere, an Kohlenwasserstoffreste gebundene, Carbonylgruppen (C=O) enthält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4fdeecc-691f-4790-a8fd-dcc205324855",
                                                "sense_id": "3d1b49fc-830a-3939-9e86-dac70008da90",
                                                "text": "Beim Menschen entstehen Ketone als Stoffwechselprodukte bei verstärktem Fettmetabolismus."
                                            },
                                            {
                                                "example_id": "512f35ac-c956-41df-a99f-74c9c1d0c64e",
                                                "sense_id": "3d1b49fc-830a-3939-9e86-dac70008da90",
                                                "text": "Ein Keton kann durch Oxidation und Dehydrierung eines sekundären Alkohols hergestellt werden."
                                            },
                                            {
                                                "example_id": "f43be78c-7c71-462b-ae1d-7ecc0b9ae908",
                                                "sense_id": "3d1b49fc-830a-3939-9e86-dac70008da90",
                                                "text": "Ketone finden sich in ätherischen Ölen, Pflanzenwurzeln und auch in der Rinde."
                                            },
                                            {
                                                "example_id": "09c49b9c-2044-40f5-98de-4f3910d325fb",
                                                "sense_id": "3d1b49fc-830a-3939-9e86-dac70008da90",
                                                "text": "Durch Versetzen mit Ozon wandeln sich die Bestandteile des Öls in Aldehyde und Ketone um, die beim anschließenden Sickern durch einen Sandfilter entfernt werden oder von Mikroben abgebaut werden können."
                                            },
                                            {
                                                "example_id": "2fa70f53-55fe-4c3e-bb3a-6cab72b64695",
                                                "sense_id": "3d1b49fc-830a-3939-9e86-dac70008da90",
                                                "text": "Des Rätsels Lösung waren Hexanol und Butandion - ein Alkohol und ein sogenanntes Keton, die ebenfalls aus überreifem Obst entweichen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
