                        "sense_id": "c17cec70-68be-3cf4-9ee2-bf190df00f36",
                        "entry_id": "46b99611-3ed2-3767-87cf-bee99cc196d5",
                        "glosses": [
                            "Orthèse permettant de maintenir la tête et le cou en extension dans une position normale pendant les soins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a47217a4-5b94-40c1-8b70-e4094956cc95",
                                "sense_id": "c17cec70-68be-3cf4-9ee2-bf190df00f36",
                                "text": "Ainsi en est-il au printemps 2004, quand je t’apprends que je dois porter une minerve."
                            }
                        ]
                    },
                    {
                        "sense_id": "d031fbcc-12f0-392f-89b0-1f348ff5586e",
                        "entry_id": "46b99611-3ed2-3767-87cf-bee99cc196d5",
                        "glosses": [
                            "Presse typographique à platine, de dimensions réduites, actionnée à l’aide d’une pédale, permettant l’impression rapide de travaux de petit format. Argot d’atelier : une pédale. Les minerves « automatiques » étaient équipées d’un moteur."
                        ],
                        "tags": [
                            "Imprimerie"
                        ],
                        "examples": [
                            {
                                "example_id": "d9fb5e00-e35a-49d1-a1d5-a24dd4212328",
                                "sense_id": "d031fbcc-12f0-392f-89b0-1f348ff5586e",
                                "text": "Quelques modèles types de machines : Les petites machines à imprimer, à pédale, genre minerve, jadis actionnées par le pied de lʼouvrier, mises en mouvement aujourdʼhui à l'aide dʼ'un moteur."
                            }
                        ]
                    },
                    {
                        "sense_id": "c2382639-b2c5-383c-939a-3599a0c0b693",
                        "entry_id": "46b99611-3ed2-3767-87cf-bee99cc196d5",
                        "glosses": [
                            "Cerveau, esprit, tête."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "352f81e7-5176-4a22-aeff-0fd240166930",
                                "sense_id": "c2382639-b2c5-383c-939a-3599a0c0b693",
                                "text": "Se fatiguer la minerve."
                            }
                        ]
                    }
