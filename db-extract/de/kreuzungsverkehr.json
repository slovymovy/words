                ],
                "senses": [
                    {
                        "sense_id": "f1063bf1-30d6-3d51-81b3-609b42a4e7cf",
                        "entry_id": "9514ce62-3da0-3e69-abb9-0ff67ce0d2fe",
                        "glosses": [
                            "Verkehrsgeschehen, bei dem sich zwei Verkehrsströme überschneiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc2c13a6-fa37-4b2f-a938-2ca901dc1631",
                                "sense_id": "f1063bf1-30d6-3d51-81b3-609b42a4e7cf",
                                "text": "„Beim Kreuzungsverkehr werden die höchsten Anforderungen an räumliche und zeitliche Präzision gestellt (im Vergleich dazu sind Situationen im Längsverkehr, also mit Überholen oder Gegenverkehr, oft allein durch räumliche Präzision beherrschbar).“"
                            },
                            {
                                "example_id": "e5c12d7a-76dc-40ec-b561-b0fd8cae0483",
                                "sense_id": "f1063bf1-30d6-3d51-81b3-609b42a4e7cf",
                                "text": "„Mit der selbstständigen Regelung eines fließenden Kreuzungsverkehrs durch die Kinder ist bereits eine wesentliche Erkenntnisstufe im Verkehrsvermittlungsprozess auf kindgerechte Weise erreicht.“"
                            },
                            {
                                "example_id": "e33838cb-6ab6-408f-b383-037026f324db",
                                "sense_id": "f1063bf1-30d6-3d51-81b3-609b42a4e7cf",
                                "text": "„Bei einem Anteil des Kreuzungsverkehrs von über 10 % beträgt dagegen die Zunahme der Unfallziffer bei Verdoppelung des Gesamtverkehrs nahezu das Dreifache, wobei allerdings die hohen Unfallhäufigkeiten der vierspurigen Straßen den Ausschlag geben.“"
                            },
                            {
                                "example_id": "eb95c2ea-1bb0-4106-a9e2-798335f3dab7",
                                "sense_id": "f1063bf1-30d6-3d51-81b3-609b42a4e7cf",
                                "text": "„Rund 80 Prozent aller Fahrzeugunfälle haben ihre Ursache im Gegen- und Kreuzungsverkehr.“"
                            },
                            {
                                "example_id": "3d2bb674-1bb9-4af7-bec3-3b63344ab068",
                                "sense_id": "f1063bf1-30d6-3d51-81b3-609b42a4e7cf",
                                "text": "„Für den Individualverkehr schließen die neuen Ebenen durch Wegfall des Gegen- und Kreuzungsverkehrs etwa 80 Prozent der heutigen Unfallursachen aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
