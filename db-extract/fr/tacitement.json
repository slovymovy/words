                        ]
                    },
                    {
                        "translation_id": "d0a0f037-cd75-4c63-96a1-c15eb0850743",
                        "source_entry_id": "ae076d72-f647-307e-b61a-291cf4e2ae0e",
                        "source_sense_id": "03123fb5-993f-3bf0-8a68-d30148fa13d4",
                        "target_lang_word": "tacitly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tacitly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f111e198-1621-353a-84e3-07362fcd7fd5",
                                        "entry_id": "da3237bc-0adc-3025-8255-9611b3da52fb",
                                        "glosses": [
                                            "In a tacit manner; done in silence or implied."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43c855a7-5594-490e-adca-57cd6ceb4000",
                                                "sense_id": "f111e198-1621-353a-84e3-07362fcd7fd5",
                                                "text": "Your failure to object to the request resulted in you tacitly approving the change."
                                            },
                                            {
                                                "example_id": "3ba137f2-530d-429d-83ad-7e5063616ee7",
                                                "sense_id": "f111e198-1621-353a-84e3-07362fcd7fd5",
                                                "text": "The new accusation brought by Urban against Manfred of murdering his sister-in-law's embassador – it may be observed that, tacitly, he acquits him of parricide, fratricide, and nepoticide – requires a little explanation."
                                            },
                                            {
                                                "example_id": "9e5592a0-2a44-454f-b309-ebdfb87bd8e1",
                                                "sense_id": "f111e198-1621-353a-84e3-07362fcd7fd5",
                                                "text": "Since old Waziri’s death Tarzan had been directing the warriors in battle, and the temporary command had been tacitly conceded to him."
                                            },
                                            {
                                                "example_id": "5c9e3986-58da-4bc9-b586-610c8ef0621c",
                                                "sense_id": "f111e198-1621-353a-84e3-07362fcd7fd5",
                                                "text": "The assumption that these are identical in meaning and usage between Indian English and Anglo-American English, while tacitly accepted, is untested, and fundamentally unknown."
                                            },
                                            {
                                                "example_id": "5cc2ec04-1d8e-4076-b64a-03a97f5a6722",
                                                "sense_id": "f111e198-1621-353a-84e3-07362fcd7fd5",
                                                "text": "Regarding the “3.5% rule”, she [Erica Chenoweth] points out that while 3.5% is a small minority, such a level of active participation probably means many more people tacitly agree with the cause."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
