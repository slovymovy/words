                "senses": [
                    {
                        "sense_id": "ed432508-3e4a-30d0-8778-222edf3ce425",
                        "entry_id": "e84294d2-e7fb-35b3-9edb-9e6c650602f4",
                        "glosses": [
                            "Jeune femme."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "dbbf92f2-a201-4d21-8fc7-ce750c6cd041",
                                "sense_id": "ed432508-3e4a-30d0-8778-222edf3ce425",
                                "text": "Sans corset, les cheveux coupés sur la nuque, des gosselines entouraient François l’Espagnol, parce qu’on le disait informé."
                            },
                            {
                                "example_id": "acbf1ebd-6cbf-4a31-bdf6-788c88a8154d",
                                "sense_id": "ed432508-3e4a-30d0-8778-222edf3ce425",
                                "text": "Il serait cet équivoque délicieux et tentateur, cette gosseline, cette poupée vicieuse et sentimentale qui repose d’un amant autoritaire et qui se prête à tous les jeux."
                            },
                            {
                                "example_id": "66b2c826-2641-448d-b4cf-7f7848a5ba7a",
                                "sense_id": "ed432508-3e4a-30d0-8778-222edf3ce425",
                                "text": "… ; on voit le « Père des peuples » au visage épanoui serrer tendrement dans ses bras quelque brune gosseline Ouzbeke ou Mongole."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a4afff0-7b58-3db6-a51c-3cdf582d8d83",
                        "entry_id": "e84294d2-e7fb-35b3-9edb-9e6c650602f4",
                        "glosses": [
                            "Jeune fille (adolescente)."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "a1651748-315e-4f51-9e84-587cbdb3fb31",
                                "sense_id": "3a4afff0-7b58-3db6-a51c-3cdf582d8d83",
                                "text": "Ma passion de garçonnet qui naissait brusquement pour Jeanne Hugo, alors une gosseline, passion que je me disais sans espoir, sans triomphe possible, et l’immense tristesse qui me poignait alors, déjà, de n’être pas riche, fils de roi, un je ne savais quoi de beau, d’angélique, de riche et de prodigieux."
                            },
                            {
                                "example_id": "84cd9849-0677-49c3-bffd-cf666befbcc4",
                                "sense_id": "3a4afff0-7b58-3db6-a51c-3cdf582d8d83",
                                "text": "Mais pourquoi n’arrivaient-ils pas, les pillards, les gosses morveux, les gosselines hirsutes du treizième ?"
                            },
                            {
                                "example_id": "e49b5e90-a0a7-41da-bd39-2b0ec1f4f644",
                                "sense_id": "3a4afff0-7b58-3db6-a51c-3cdf582d8d83",
                                "text": "Elles ont de quatorze à dix-sept ans ; presque toutes sont de vraies gosselines de Paris, des momignardes des faubourgs, élevées à la diable dans des milieux grouillants et tapageurs, parmi les disputes, les gros mots et les scènes d'amour des parents, et les récits des grandes sœurs."
                            }
                        ]
                    }
                ],
