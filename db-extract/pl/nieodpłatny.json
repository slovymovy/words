                                                "example_id": "4be1ed80-aae3-430f-be02-c20e4f9755d2",
                                                "sense_id": "adeed873-29e0-3b11-b9b5-df8438ee4081",
                                                "text": "Dort erhalten Sie kostenlose Informationsprospekte."
                                            },
