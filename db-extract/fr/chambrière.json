                    },
                    {
                        "sense_id": "1a8d6703-9d0b-3130-9a23-9be16d5af3cc",
                        "entry_id": "3a659973-2803-3c2f-bdfa-b962f2c21c19",
                        "glosses": [
                            "Petit ruban qui tenait la quenouille."
