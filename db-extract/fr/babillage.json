                                        "examples": [
                                            {
                                                "example_id": "7a11075a-c304-468c-8e63-deb3c511ae2d",
                                                "sense_id": "4eb5f59e-9996-38bb-9917-dfe414ed04b7",
                                                "text": "I haue heard of your pratlings too wel enough."
                                            },
                                            {
                                                "example_id": "27dd2d9b-d69c-4a68-b7cf-baacf419f92d",
                                                "sense_id": "4eb5f59e-9996-38bb-9917-dfe414ed04b7",
                                                "text": "The boy, who had been regarding him with the tolerant curiousness one accords to the prattlings of the feeble-minded, answered promptly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "099bd13d-6f0b-46f1-886b-2930cc384329",
                        "source_entry_id": "3103dbc9-f6ca-3b86-9e0f-b50528b62399",
                        "source_sense_id": "40c6a34e-9c87-319e-adc1-328ebd9b1764",
