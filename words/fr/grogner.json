{
    "word_family": [
        "grogne",
        "grognement",
        "grogneur",
        "grognon"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "59087540-0ea5-3bf6-9bea-cb20f9dba8e6",
                    "sense_definition": "Émettre un cri sourd et rauque, en parlant du porc, du chien ou d'autres animaux.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cri_animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quand le facteur approche de la barrière, le gros chien commence à <w>grogner</w> férocement."
                        },
                        {
                            "text": "Dans leur enclos, les cochons affamés <w>grognent</w> dès que le fermier apporte le seau de grains."
                        }
                    ],
                    "common_phrases": [
                        "entendre grogner",
                        "grogner contre un intrus"
                    ]
                },
                {
                    "sense_id": "f8414a11-d888-3931-8022-d1268b6d2f43",
                    "sense_definition": "Témoigner son mécontentement ou sa mauvaise humeur par des bruits sourds ou des plaintes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mecontentement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'adolescent range sa chambre mais finit par obéir en <w>grognant</w> sous le regard de ses parents."
                        },
                        {
                            "text": "Les usagers ont commencé à <w>grogner</w> de mécontentement après l'annonce d'un retard de deux heures."
                        }
                    ],
                    "synonyms": [
                        "bougonner",
                        "maugréer",
                        "ronchonner",
                        "râler"
                    ],
                    "common_phrases": [
                        "grogner de mécontentement",
                        "obéir en grognant"
                    ]
                },
                {
                    "sense_id": "2c53b7bf-2fe0-3f7e-b9de-032b9843b171",
                    "sense_definition": "Dire ou articuler des paroles d'un ton sourd, bourru et hostile.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "parole_bourrue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le serveur fatigué a <w>grogné</w> une réponse brève avant de tourner le dos aux clients."
                        },
                        {
                            "text": "« Laissez-moi tranquille », <w>grogna</w> le vieil homme en refermant brusquement la porte de sa maison."
                        }
                    ],
                    "synonyms": [
                        "grommeler",
                        "marmonner"
                    ],
                    "common_phrases": [
                        "grogner entre ses dents",
                        "grogner une réponse"
                    ]
                },
                {
                    "sense_id": "5edc0c80-ada2-3761-913a-6dc98d765d97",
                    "sense_definition": "Produire un bruit sourd et continu semblable à un grognement, en parlant d'un mécanisme.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bruit_mecanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La vieille voiture s'est remise en route en <w>grognant</w> péniblement sous la charge des bagages."
                        },
                        {
                            "text": "Le tuyau de chauffage commence à <w>grogner</w> chaque fois que la chaudière s'allume au sous-sol."
                        }
                    ],
                    "common_phrases": [
                        "moteur qui grogne"
                    ]
                }
            ]
        }
    ]
}