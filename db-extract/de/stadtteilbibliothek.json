                "senses": [
                    {
                        "sense_id": "47256a6e-f0f4-3fd5-957e-e9afc1f11706",
                        "entry_id": "237ee6af-90e8-3d61-af21-ce172ef0493f",
                        "glosses": [
                            "meist kleinere Bibliothek, deren Einzugsbereich ein bestimmter Teil einer Stadt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44d4cfd4-a8bf-4138-801c-de2193c7eeba",
                                "sense_id": "47256a6e-f0f4-3fd5-957e-e9afc1f11706",
                                "text": "„Tobias Frey ist glücklich verheiratet und leitet seit 2014 die Stadtteilbibliothek Stuttgart-Ost.“"
                            },
                            {
                                "example_id": "d6809d74-0b7b-476c-9c82-fe1853db9161",
                                "sense_id": "47256a6e-f0f4-3fd5-957e-e9afc1f11706",
                                "text": "„Es gab hier etliche kleinere Läden, eine Stadtteilbibliothek, einen winzigen Park.“"
                            },
                            {
                                "example_id": "d453d8eb-3f23-4e5c-bfde-2c0c2918bbcc",
                                "sense_id": "47256a6e-f0f4-3fd5-957e-e9afc1f11706",
                                "text": "„Die Ausleihe ist über eine Stadtteilbibliothek problemlos möglich, da nicht immer eine Fach- oder Universitätsbibliothek in unmittelbarer Nähe zum Wohn- oder Arbeitsort liegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
