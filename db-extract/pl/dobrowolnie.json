                                            {
                                                "example_id": "33926eac-f084-4458-b48e-977fb8fd6138",
                                                "sense_id": "b26a7865-ec36-32d7-9a07-f2a666761307",
                                                "text": "But no state has voluntarily sought a statewide remedy to segregation in the 70 years since the Brown v. Board of Education decision outlawed government sanctioned, racially separate schools."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "728a9f0f-646c-4a4d-92db-6a70e4c51f49",
                        "source_entry_id": "ef1819ca-3da6-39b9-ad34-2af2303c5dc7",
                        "source_sense_id": "39f65040-dc2c-33c7-b823-f6f1540304fa",
                        "target_lang_word": "dobrovolně",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dobrovolně",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "705ad79f-0766-3800-93d8-455c160e407c",
                                        "entry_id": "55505a69-6d8e-3c2b-8669-aefd24b45cbe",
                                        "glosses": [
                                            "bez nucení, dobrovolným způsobem, z vlastní vůle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61757145-41ca-4335-8f70-ab7dcbac2adb",
                                                "sense_id": "705ad79f-0766-3800-93d8-455c160e407c",
                                                "text": "Mezitím jednala rozmnožená říšská rada o dalších potřebách říše, a císař patentem ze dne 17. července dobrovolně uložil své panovnické moci meze tak, aby bez svolení říšské rady nesměla žádná daň býti nově zavedena nebo zvýšena, ani žádná půjčka učiněna."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b291410e-8d0e-47c1-97cf-b278e6eb4a01",
                        "source_entry_id": "ef1819ca-3da6-39b9-ad34-2af2303c5dc7",
                        "source_sense_id": "39f65040-dc2c-33c7-b823-f6f1540304fa",
                        "target_lang_word": "volontairement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "volontairement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b8523b9d-5c5d-3c29-81b0-b7a629d5c543",
                                        "entry_id": "d83c7db8-5e00-3c98-b295-3c912578741d",
                                        "glosses": [
                                            "D’une manière volontaire, de bonne volonté, sans contrainte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3560ade4-c937-40fa-aec7-9de8a981959e",
                                                "sense_id": "b8523b9d-5c5d-3c29-81b0-b7a629d5c543",
                                                "text": "Ne vous laisse-t-elle pas votre liberté ? vient-elle d’un pied jaloux jeter un coup d’œil dans les salons de Paris ? vous impose-t-elle les devoirs d’une emprinse, les chaînes que les paladins se mettaient jadis au bras volontairement ?"
                                            },
                                            {
                                                "example_id": "c46e3143-b991-4f01-b770-a2251ad22be4",
                                                "sense_id": "b8523b9d-5c5d-3c29-81b0-b7a629d5c543",
                                                "text": "Le denier à Dieu, donné d’abord volontairement, était quelquefois exigé ; ainsi dans une vente à l’encan, le dernier enchérisseur devait toujours consigner son denier à Dieu."
                                            },
                                            {
                                                "example_id": "73c81931-b60f-419a-80b0-a605301fbaec",
                                                "sense_id": "b8523b9d-5c5d-3c29-81b0-b7a629d5c543",
                                                "text": "Il a fait cela volontairement."
                                            },
                                            {
                                                "example_id": "b51c4cba-b15d-4d7e-b9d2-e3dac166bbf9",
                                                "sense_id": "b8523b9d-5c5d-3c29-81b0-b7a629d5c543",
                                                "text": "Il s’y est obligé volontairement."
                                            },
                                            {
                                                "example_id": "733b611d-1d3d-4b8b-8c22-b96d7e4b2d52",
                                                "sense_id": "b8523b9d-5c5d-3c29-81b0-b7a629d5c543",
                                                "text": "Il se démit volontairement de son emploi."
                                            },
                                            {
                                                "example_id": "86151aa9-9db8-47aa-990d-319c0858e5e3",
                                                "sense_id": "b8523b9d-5c5d-3c29-81b0-b7a629d5c543",
                                                "text": "Cette semaine, la Douma doit également examiner un texte visant à sanctionner les Russes qui choisissent volontairement de ne pas avoir d’enfant, quelle qu’en soit la raison."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "618aee14-9153-4f41-b5cd-5d9eaa1e654c",
                        "source_entry_id": "ef1819ca-3da6-39b9-ad34-2af2303c5dc7",
                        "source_sense_id": "39f65040-dc2c-33c7-b823-f6f1540304fa",
                        "target_lang_word": "voluntariamente",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voluntariamente",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "29800ee3-be05-3b5e-8bd9-b4bb9b7e0824",
                                        "entry_id": "0b7305af-85b6-36a2-9a75-ce8e576156c0",
                                        "glosses": [
                                            "Con libertad, gusto o voluntad, o por propia determinación."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b17a055-5bea-4822-b7b9-4b623b6cd98f",
                                                "sense_id": "29800ee3-be05-3b5e-8bd9-b4bb9b7e0824",
                                                "text": "Estaba abierta... ¡y él, al marcharse, había oído a su mujer cerrarla con llave, tranca y cerrojo!\nPor consiguiente, nadie más que su propia mujer había podido abrirla.\nPero ¿cómo?, ¿cuándo?, ¿por qué? ¿De resultas de un engaño? ¿A consecuencia de una orden? ¿O bien deliberada y voluntariamente, en virtud de previo acuerdo con el Corregidor?\n¿Qué iba a ver? ¿Qué iba a saber? ¿Qué le aguardaba dentro de su casa? ¿Se había fugado la señá Frasquita? ¿Se la habrían robado? ¿Estaría muerta? ¿O estaría en brazos de su rival?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "82540d65-ce63-3444-8df6-88f3dd5a76cf",
                                        "entry_id": "0b7305af-85b6-36a2-9a75-ce8e576156c0",
                                        "glosses": [
                                            "De suyo, de su natural o sin el concurso de causa externa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91bc8b75-fd1b-4a5a-af92-577d2b084988",
                                                "sense_id": "82540d65-ce63-3444-8df6-88f3dd5a76cf",
                                                "text": "Luego, bajo el círculo de la luz de una lámpara de aceite, en la atmósfera encerrada de su cuarto de estudiante, noche a noche, las veladas se sucedían, las veladas sin fin, interminables, prolongadas hasta las horas cercanas de la madrugada, arrebatado, febriciente, en la enorme tensión intelectual a que voluntariamente llegara a someterse, clavados los codos sobre su escritorio -un escritorio de paño verde, enchapado de nogal- oprimida la frente entre las manos, los ojos fijos en algún libro de texto."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "97a34bd7-bb3d-3861-85d7-43ce5608f8ff",
                                        "entry_id": "0b7305af-85b6-36a2-9a75-ce8e576156c0",
                                        "glosses": [
                                            "Por sola determinación de la voluntad propia, sin otra razón."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b38f5145-8be1-4d81-8ae1-87e9ca36c927",
                                                "sense_id": "97a34bd7-bb3d-3861-85d7-43ce5608f8ff",
                                                "text": "Y cuando, después de haber vagado, perdido durante muchos días, voluntariamente, en ese hermoso laberinto de canales, seducido por su belleza, grandiosa a la vez que deliciosa, llegó al magnífico dominio donde se extiende el río en toda la majestad del vasto estuario, extático, se arrodilló el Indio, débil y pequeño, en la verde ribera, saludando a su dios, -cuyo misterio acababa de descubrir-, con el nombre merecido de Padre del Mar."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c63ac98-b1c0-401f-90d3-296b97ba50db",
                        "source_entry_id": "ef1819ca-3da6-39b9-ad34-2af2303c5dc7",
