                ],
                "senses": [
                    {
                        "sense_id": "32c5acb9-4807-3713-86a8-13b0938a8c03",
                        "entry_id": "9b9663f9-03cb-37b8-82a9-901581fa9031",
                        "glosses": [
                            "inexhaustible"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec4f643e-b0a1-4a42-b4c3-99b3dbf01711",
                                "sense_id": "32c5acb9-4807-3713-86a8-13b0938a8c03",
                                "text": "Неистощи́мая насме́шка разорвала́ на ча́сти его́ се́рдце.",
                                "translation": "Its boundless irony rent his heart.",
                                "english": "Its boundless irony rent his heart."
                            },
                            {
                                "example_id": "e4c8cfc8-2d3b-4cba-a87e-26222067be5d",
                                "sense_id": "32c5acb9-4807-3713-86a8-13b0938a8c03",
                                "text": "Об оде́ждах свои́х она́ не забо́тилась, как бу́дто инстинкти́вно чу́вствовала, что си́ла её не в цветны́х сарафа́нах, а в той неистощи́мой струе́ молодо́го бессты́жества, кото́рое неудержи́мо прорыва́лось во вся́ком её движе́нии.",
                                "translation": "She did not bother about clothes, for she seemed to know by instinct that her strength lay not in bright coloured frocks, but in that inexhaustible flow of youthful brazenness which burst irrepressibly through in her every movement.",
                                "english": "She did not bother about clothes, for she seemed to know by instinct that her strength lay not in bright coloured frocks, but in that inexhaustible flow of youthful brazenness which burst irrepressibly through in her every movement."
                            }
                        ]
                    }
                ],
