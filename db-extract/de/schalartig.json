                "senses": [
                    {
                        "sense_id": "f2246cba-7ba1-3253-82dd-69f6703c569d",
                        "entry_id": "4d5d4fbc-eebd-37c4-ac19-d27267912d77",
                        "glosses": [
                            "wie ein Schal aussehend; einem Schal ähnelnd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "531fbc8b-94ac-4ffd-bad7-732a02b086cd",
                                "sense_id": "f2246cba-7ba1-3253-82dd-69f6703c569d",
                                "text": "„Panisch zerrte ich an meinen Fesseln, offenbar weiche, schalartige Tücher, die fest um meine Handgelenke und Unterarme gebunden waren.“"
                            },
                            {
                                "example_id": "89627c52-5395-441d-8f60-329be7987ab6",
                                "sense_id": "f2246cba-7ba1-3253-82dd-69f6703c569d",
                                "text": "„Sie trägt einen gestrickten schwarzen Pullover, über der Brust durch eine schräge schalartige Wollhälfte mit drei großen Knöpfen geschlossen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
