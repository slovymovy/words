                    {
                        "sense_id": "151d628e-723e-3dfb-aa69-2a7caf436179",
                        "entry_id": "c6de856c-4083-36ef-b77d-dd02bd24c04a",
                        "glosses": [
                            "Gardien ou éleveur de bétail en Espagne et en Amérique latine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22028cc9-2126-4890-9916-e048a2dd2360",
                                "sense_id": "151d628e-723e-3dfb-aa69-2a7caf436179",
                                "text": "Tout en faisant cet aparté entre ses dents, le vaquero déroula le lasso qu’il portait attaché à sa ceinture et se mit à courir dans la direction du cavalier."
                            },
                            {
                                "example_id": "36991f3c-c3bf-4e96-a7ea-567e4be6e710",
                                "sense_id": "151d628e-723e-3dfb-aa69-2a7caf436179",
                                "text": "Le jeune homme s’y était employé de son mieux au moyen d’eau chaude salée, mais le vaquero s’était énervé et lui avait tiré dessus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f0dc5850-c427-4f7f-ae8d-6a9cb4738f00",
                        "source_entry_id": "c6de856c-4083-36ef-b77d-dd02bd24c04a",
                        "source_sense_id": "151d628e-723e-3dfb-aa69-2a7caf436179",
                        "target_lang_word": "vaquero",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vaquero",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a3a4415-d94d-38e2-afe8-a6244ee54986",
                                        "entry_id": "6b608717-dc73-3c08-9df6-635cbe5f6bd6",
                                        "glosses": [
                                            "A cowboy; a herdsman."
                                        ],
                                        "tags": [
                                            "Southwestern",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38f794d7-c6a6-4f23-b562-59cd94fb034e",
                                                "sense_id": "2a3a4415-d94d-38e2-afe8-a6244ee54986",
                                                "text": "A day or two before a number of vaqueroes set out for the Santa Cruz Mountains and lassoed a very big grizzly."
                                            },
                                            {
                                                "example_id": "e09dae18-657c-4d01-8ef7-2fc8e380d2eb",
                                                "sense_id": "2a3a4415-d94d-38e2-afe8-a6244ee54986",
                                                "text": "Voices from the Wild Horse Desert is the story of vaquero families who have lived and worked on the prominent King and Kenedy Ranches of South Texas for six generations. Vaqueros (Mexican cowboys) are the highly skilled work force that cares for and works the cattle day by day."
                                            },
                                            {
                                                "example_id": "4ef7b75a-7b77-41c2-9aaa-35c19f35fdf2",
                                                "sense_id": "2a3a4415-d94d-38e2-afe8-a6244ee54986",
                                                "text": "Of course the vaqueros do not help: because of his weight and his high voice they call him Don Castrado behind his back."
                                            },
                                            {
                                                "example_id": "82dded2d-ac27-42ad-8176-716b1c8117d2",
                                                "sense_id": "2a3a4415-d94d-38e2-afe8-a6244ee54986",
                                                "text": "Cattle drives became common between Mexico and California and Mexico and Texas. Vaqueros were the drivers. In time, as vaqueros worked for a particular ranch or within the confines of a particular territory, regional styles evolved. In essence, two types were prominent: that of the California vaquero and that of the vaquero from Texas.\nThe Texas vaquero was identified as a free spirit, lived out in the open range, and went from ranch to ranch as work opportunities surfaced. The Californian vaquero remained loyal to a ranch or ranching family."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
