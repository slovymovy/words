                    {
                        "sense_id": "8653506e-25bb-3db6-ae54-2389ce70167e",
                        "entry_id": "72f75598-4004-36cb-948f-a75f95eec5df",
                        "glosses": [
                            "To glance shyly or slyly; look askance; make eyes; leer; peer; pry."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "0f95ec73-c20b-4aa6-bc34-6c4c83915040",
                                "sense_id": "8653506e-25bb-3db6-ae54-2389ce70167e",
                                "text": "I saw the wench that twired and twinkled at thee."
                            },
                            {
                                "example_id": "417db6d3-50e9-4692-b333-64ac25b2a2bd",
                                "sense_id": "8653506e-25bb-3db6-ae54-2389ce70167e",
                                "text": "Which maids will twire at 'tween their fingers."
                            }
                        ]
                    },
                    {
                        "sense_id": "096700ad-0a1c-3ce5-a15d-7cebfd38cde1",
                        "entry_id": "72f75598-4004-36cb-948f-a75f95eec5df",
                        "glosses": [
                            "To twinkle; sparkle; wink."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1c21661f-1358-4ece-b00b-57eb33bedcf7",
                                "sense_id": "096700ad-0a1c-3ce5-a15d-7cebfd38cde1",
                                "text": "When sparkling stars twire not, thou gild'st the even."
                            }
                        ]
                    }
