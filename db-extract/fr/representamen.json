                    {
                        "sense_id": "187d45ba-6372-31b9-b003-dc2a6d37412a",
                        "entry_id": "2600af6c-139c-339a-8e3a-5b1930b27f87",
                        "glosses": [
                            "Objet ayant la possibilité de signifier."
                        ],
                        "tags": [
                            "Sémiotique"
                        ],
                        "examples": [
                            {
                                "example_id": "e6d5461f-02c8-4c9d-b24a-7b5587559af2",
                                "sense_id": "187d45ba-6372-31b9-b003-dc2a6d37412a",
                                "text": "Signe et representamen, dans un premier temps confondus, sont préscindés (et non dissociés) en considérant qu’un signe est un representamen qui a un interprétant mental."
                            },
                            {
                                "example_id": "f18469a3-5a98-44a1-ac04-7dde9165ce84",
                                "sense_id": "187d45ba-6372-31b9-b003-dc2a6d37412a",
                                "text": "Le representamen n’est pas l’image sensible, la reproduction sensorielle de l’objet qu’il représente (encore qu’il puisse l’être)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc1877d1-8856-4dd9-bbcd-fee4c82e1f67",
                        "source_entry_id": "2600af6c-139c-339a-8e3a-5b1930b27f87",
                        "source_sense_id": "187d45ba-6372-31b9-b003-dc2a6d37412a",
                        "target_lang_word": "representamen",
