                        "examples": [
                            {
                                "example_id": "cb3f1959-db30-41d9-a5f5-6ccc90e59059",
                                "sense_id": "d9bbf382-08b1-3c6c-baca-9960fea6441a",
                                "text": "”Jesus bleibet meine Freude” van Bach is op musicalion.com te vinden in achttien varianten. Instrumentaal en vocaal, of een combinatie daarvan. Voor koor of solozang. Koralen en bewerkingen. Voor orgel, blokfluit, gitaar of viool. Eenvoudig, voor gevorderden, of daartussenin."
                            },
                            {
                                "example_id": "1fbc9ab4-d3d8-44cf-99ec-e1adf49921b8",
                                "sense_id": "d9bbf382-08b1-3c6c-baca-9960fea6441a",
                                "text": "In Roden startte de dirigent in ruste in 2012 de Koor en Solozang Academie (KSA), een praktijkgerichte opleiding voor zangers vanaf 7 jaar."
                            }
                        ]
                    }
