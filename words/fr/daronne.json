                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ouvriers redoutaient la vieille <w>daronne</w> qui inspectait l'atelier chaque matin.",
                            "target_lang_translations": {
                                "en": "The workers dreaded the old <w>proprietress</w> who inspected the workshop every morning.",
                                "ru": "Рабочие боялись старой <w>хозяйки</w>, которая каждое утро осматривала мастерскую.",
                                "nl": "De arbeiders vreesden de oude <w>bazin</w>, die elke ochtend de werkplaats inspecteerde.",
                                "de": "Die Arbeiter fürchteten die alte <w>Chefin</w>, die jeden Morgen die Werkstatt inspizierte.",
                                "pl": "Robotnicy bali się starej <w>właścicielki</w>, która każdego ranka kontrolowała warsztat.",
                                "it": "Gli operai temevano la vecchia <w>padrona</w>, che ogni mattina ispezionava l'officina.",
                                "cs": "Dělníci se báli staré <w>šéfové</w>, která každé ráno kontrolovala dílnu.",
                                "tr": "İşçiler, her sabah atölyeyi denetleyen yaşlı <w>kadın patrondan</w> çekinirdi.",
                                "es": "Los obreros temían a la vieja <w>patrona</w>, que inspeccionaba el taller cada mañana.",
                                "zh": "工人们都害怕那位年迈的<w>女老板</w>，她每天早上都会巡视车间。"
                            }
                        },
                        {
                            "text": "La servante obéissait docilement à tous les ordres donnés par la <w>daronne</w>.",
                            "target_lang_translations": {
                                "en": "The maid meekly obeyed all the orders given by the <w>mistress</w>.",
                                "ru": "Служанка покорно выполняла все распоряжения <w>хозяйки</w>.",
                                "nl": "De dienstmeid gehoorzaamde gedwee alle bevelen van de <w>meesteres</w>.",
                                "de": "Die Magd gehorchte allen Anordnungen der <w>Hausherrin</w> widerspruchslos.",
                                "pl": "Służąca posłusznie wykonywała wszystkie polecenia wydawane przez <w>gospodynię</w>.",
                                "it": "La domestica obbediva docilmente a tutti gli ordini impartiti dalla <w>padrona</w>.",
                                "cs": "Služka poslušně plnila všechny příkazy, které dávala <w>paní</w>.",
                                "tr": "Hizmetçi, <w>ev sahibesinin</w> verdiği tüm emirlere uysalca itaat ederdi.",
                                "es": "La criada obedecía dócilmente todas las órdenes que le daba el <w>ama</w>.",
                                "zh": "女佣总是乖乖服从<w>女主人</w>下达的所有命令。"
                            }
                        }
