                {
                    "sense_id": "f1a2db08-cd8f-3bce-baec-086c730e4632",
                    "sense_definition": "będący czymś zwykłym, powszednim i skupionym na codziennych sprawach materialnych",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "filozofia_religia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zwykłe troski <w>ziemskie</w> nie pozwalały mu cieszyć się chwilą spokoju.",
                            "target_lang_translations": {
                                "en": "Ordinary <w>mundane</w> worries did not allow him to enjoy a moment of peace."
                            }
                        },
                        {
                            "text": "Poeta z trudem odnajdywał się w świecie prozaicznych spraw <w>ziemskich</w>.",
                            "target_lang_translations": {
                                "en": "The poet struggled to find his place in the world of prosaic, <w>earthly</w> affairs."
                            }
                        }
