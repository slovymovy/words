                    {
                        "translation_id": "1e48d78a-0598-4b76-8dd7-8a2fd6cd1861",
                        "source_entry_id": "85960e0a-7e90-37e6-b4b2-f8a2aa26c118",
                        "source_sense_id": "7a579c2d-5ca0-352a-8dd4-d5ccae73f329",
                        "source_sense_description": "in an indiscriminate manner",
                        "target_lang_word": "querbeet",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "querbeet",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f72cd9df-116e-3859-b85c-0af9397cbb0f",
                                        "entry_id": "bf76d298-baee-3c05-a603-8c3ee4bc2cc4",
                                        "glosses": [
                                            "ohne bestimmte Richtung, ohne besondere Überlegung oder Auswahl, ohne irgendwelche Ordnung"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3249400c-8ce3-4f96-8fd2-c27bdef31ad8",
                                                "sense_id": "f72cd9df-116e-3859-b85c-0af9397cbb0f",
                                                "text": "Als ich das Pferd erschreckte, rannte es querbeet über das Feld."
                                            },
                                            {
                                                "example_id": "3e903380-d29e-461e-95c6-849da50f96e9",
                                                "sense_id": "f72cd9df-116e-3859-b85c-0af9397cbb0f",
                                                "text": "„Alles lief querbeet durcheinander, es herrschte Chaos, ich schaffte es, keinen klaren Gedanken zu fassen.“"
                                            },
                                            {
                                                "example_id": "cd1d9822-1631-40cf-b973-3afa6078842b",
                                                "sense_id": "f72cd9df-116e-3859-b85c-0af9397cbb0f",
                                                "text": "„Dachdecker, Elektriker, ein Matrose, ehemaliger Zeitsoldat der Marine - es ging querbeet durch alle Berufe.“"
                                            },
                                            {
                                                "example_id": "218948f2-4f58-453a-8dfa-347f00ef4a16",
                                                "sense_id": "f72cd9df-116e-3859-b85c-0af9397cbb0f",
                                                "text": "„Sie hatten nicht auf dem Weg bleiben können, sondern waren querbeet durch das Grundstück gefahren und hatten natürlich ihre Spuren hinterlassen.“"
                                            },
                                            {
                                                "example_id": "574132ab-802b-49eb-88b7-52f0096a0972",
                                                "sense_id": "f72cd9df-116e-3859-b85c-0af9397cbb0f",
                                                "text": "„Da nun die verschiedenen Menschenarten querbeet durch alle Familien verteilt sind, müssen sie miteinander auskommen und zusammenleben.“"
                                            },
                                            {
                                                "example_id": "2d2ce48e-e696-4c01-b360-13b383ead6bd",
                                                "sense_id": "f72cd9df-116e-3859-b85c-0af9397cbb0f",
                                                "text": "„Ich schlage mich jedesmal querbeet in die Büsche bzw. über den Friedhof, um rechtzeitig das Gipfelareal zu erreichen.“"
                                            },
                                            {
                                                "example_id": "1acaa274-ae7b-4278-b1af-916d4de4d5bd",
                                                "sense_id": "f72cd9df-116e-3859-b85c-0af9397cbb0f",
                                                "text": "„IT-Profis werden gesucht, und das querbeet durch alle Branchen: […].“"
                                            },
                                            {
                                                "example_id": "5f0ee3a7-a9b0-43c5-b755-ed9fd311cd6e",
                                                "sense_id": "f72cd9df-116e-3859-b85c-0af9397cbb0f",
                                                "text": "„Unkontrolliert begann er querbeet zu lesen […].“"
                                            },
                                            {
                                                "example_id": "66190eab-15e6-48c0-b53a-66543866bc27",
                                                "sense_id": "f72cd9df-116e-3859-b85c-0af9397cbb0f",
                                                "text": "„Querbeet ging es nun zu Fuß nach Pressoire; dort sah es übel aus, die Häuser waren nur noch Trümmerhaufen, die Straßen zerwühlt von Granaten.“"
                                            },
                                            {
                                                "example_id": "33b818a9-7c36-4a95-811f-38dc4c70bce1",
                                                "sense_id": "f72cd9df-116e-3859-b85c-0af9397cbb0f",
                                                "text": "„Schließlich begann ich mit Tempowechseln, lief querbeet durch die Hindernisse, blieb abrupt stehen und ging mit ihm rückwärts.“"
                                            },
                                            {
                                                "example_id": "bdf1e822-d3b8-4568-9ccf-6f9a1c982323",
                                                "sense_id": "f72cd9df-116e-3859-b85c-0af9397cbb0f",
                                                "text": "„Zu trotzig, umzukehren, lief ich weiter, querbeet über die vielleicht geschützte, vielleicht von jemandem gepachtete Wiese, schmatzender Boden, der unter meinen Füßen nachgab, weicher wurde, je näher ich dem Wald kam.“"
                                            },
                                            {
                                                "example_id": "b8329192-cd0f-47a0-9fbe-19756a589e07",
                                                "sense_id": "f72cd9df-116e-3859-b85c-0af9397cbb0f",
                                                "text": "„Die ersten Tage ging es querbeet durch alle möglichen Gassen und Straßen, ich lernte die Durchgangs- und Hauptstraßen kennen und prägte mir erste Stadtteilnamen ein.“"
                                            },
                                            {
                                                "example_id": "4e314534-fc94-42a6-93a5-f2919ae56cfd",
                                                "sense_id": "f72cd9df-116e-3859-b85c-0af9397cbb0f",
                                                "text": "„Jetzt las sie sich in die Geschichte Ghanas und überhaupt des des Kolonialismus ein, dazu stöberte sie querbeet in Zeitungen und Heften.“"
                                            },
                                            {
                                                "example_id": "549e4a4a-6e66-46bc-8178-94b1de09904a",
                                                "sense_id": "f72cd9df-116e-3859-b85c-0af9397cbb0f",
                                                "text": "„100 Jahre später lockten die beheizte Terrasse und das elegante Interieur mit Piano die Literaten an. Heute wiederum kommen alle querbeet: Jugendliche mit Handys, Geschäftsleute im Anzug und aufgetakelte ältere Damen, die sich zum Tee treffen.“"
                                            },
                                            {
                                                "example_id": "26fc92ce-d222-47cb-8f04-c41d3d0d5336",
                                                "sense_id": "f72cd9df-116e-3859-b85c-0af9397cbb0f",
                                                "text": "„Während Untersuchungen des Mageninhalts frei lebender Tiere zeigten, dass Dermogenys sich in der Natur auch dann ausschließlich an Anflugnahrung halten, wenn es in ihrem Heimatgewässer ein Großangebot an Kleingarnelen gibt, haben Nomorhamphus sich mit ihrem Abstieg in tiefere Gefilde zusätzlich weitere Nahrungsquellen erschlossen, sodass ihr Nahrungsspektrum querbeet alles umfasst, was in ihrem Biotop an Lebewesen in passender Größe vorhanden ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
