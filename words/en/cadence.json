                    "frequency": "Middle",
                    "semantic_group_id": "rhythm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The normal <w>cadence</w> of life in the small village was interrupted by the festival.",
                            "target_lang_translations": {
                                "ru": "Привычный <w>ритм</w> жизни в маленькой деревне был нарушен фестивалем."
                            }
                        },
                        {
                            "text": "He enjoyed the steady <w>cadence</w> of his daily routine during the summer months.",
                            "target_lang_translations": {
                                "ru": "Ему нравилась размеренная <w>последовательность</w> его распорядка дня в летние месяцы."
                            }
