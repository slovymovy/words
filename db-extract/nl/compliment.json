                "senses": [
                    {
                        "sense_id": "3ae666af-0d39-3710-9410-49a829f5cfd3",
                        "entry_id": "6b5a4847-15e2-3d11-a47e-45183f7a3eb5",
                        "glosses": [
                            "een lovende of vleiende opmerking"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d939d5d1-56ba-46cc-9d59-21eaf9a043da",
                                "sense_id": "3ae666af-0d39-3710-9410-49a829f5cfd3",
                                "text": "De leerlingen gaven hun docente een groot compliment voor haar grote inzet."
                            },
                            {
                                "example_id": "1869debd-e6d7-42dd-b749-36862016afdb",
                                "sense_id": "3ae666af-0d39-3710-9410-49a829f5cfd3",
                                "text": "Ik verloor geleidelijk mijn gevoel voor leeftijd. Omdat ik voornamelijk optrok met jonge mensen voelde ik me zelf ook weer jong. Zo merkte Genie een keer op dat ze het gevoel had dat ze met een opgewonden kind zat te ontbijten. ‘Je verhaal gaat alle kanten op, er is geen peil op te trekken waar je nu weer mee komt.’ Ik koos ervoor om dit als een compliment op te vatten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ceaecd66-4171-4603-b427-b5d9bc862674",
                        "source_entry_id": "6b5a4847-15e2-3d11-a47e-45183f7a3eb5",
                        "source_sense_id": "3ae666af-0d39-3710-9410-49a829f5cfd3",
                        "source_sense_description": "een lovende of vleiende opmerking",
                        "target_lang_word": "Kompliment",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kompliment",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c5d62f70-7db7-3d1d-8ff0-813970262a1f",
                                        "entry_id": "af6bd0c9-47f4-3a60-a044-ad17f5b142bb",
                                        "glosses": [
                                            "eine Äußerung, die positiv bei dem Gesprächspartner gewertet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af59a7b7-36c3-444e-8b2e-e77880b8dbb4",
                                                "sense_id": "c5d62f70-7db7-3d1d-8ff0-813970262a1f",
                                                "text": "Das fasse ich als Kompliment auf."
                                            },
                                            {
                                                "example_id": "8c384354-b4c8-4773-97c2-d0613f51094f",
                                                "sense_id": "c5d62f70-7db7-3d1d-8ff0-813970262a1f",
                                                "text": "„In punkto Komplimente haben Polinnen und Polen in Deutschland ein schweres Leben.“"
                                            },
                                            {
                                                "example_id": "e7300f20-a170-448a-9706-2862a6d74e4f",
                                                "sense_id": "c5d62f70-7db7-3d1d-8ff0-813970262a1f",
                                                "text": "Das war eine respektable Leistung, Kompliment."
                                            },
                                            {
                                                "example_id": "cbbea660-469a-4a38-a004-03c2136ac337",
                                                "sense_id": "c5d62f70-7db7-3d1d-8ff0-813970262a1f",
                                                "text": "Mein Schwager kann wunderbare Komplimente machen."
                                            },
                                            {
                                                "example_id": "1b56c5e9-ce68-4581-9231-0b470519e0fd",
                                                "sense_id": "c5d62f70-7db7-3d1d-8ff0-813970262a1f",
                                                "text": "„Die alte Frau im Lebensmittelladen machte Val und Rosa ein Kompliment wegen ihrer Hüte.“"
                                            },
                                            {
                                                "example_id": "ee3521f1-c15a-4dca-b31a-bb99b568c241",
                                                "sense_id": "c5d62f70-7db7-3d1d-8ff0-813970262a1f",
                                                "text": "„Ich wußte, daß sie über dieses Kompliment erröten mußte.“"
                                            },
                                            {
                                                "example_id": "dfac6e49-f0ff-4da1-8463-4ff245b652ac",
                                                "sense_id": "c5d62f70-7db7-3d1d-8ff0-813970262a1f",
                                                "text": "„Bisher hatte Sylvia für alles, was sie vollbracht hatte, nie mehr als ein paar Komplimente von Familie und Freunden bekommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ab59ebd1-7e53-3aa3-bff9-3357ebccb859",
                                        "entry_id": "af6bd0c9-47f4-3a60-a044-ad17f5b142bb",
                                        "glosses": [
                                            "Gruß"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab592fbf-0560-4aab-a65e-657bb921c3f3",
                                                "sense_id": "ab59ebd1-7e53-3aa3-bff9-3357ebccb859",
                                                "text": "Darf ich Ihnen eine Rose mit dem Kompliment des Hauses Niendorf überreichen?"
                                            },
                                            {
                                                "example_id": "8456cb05-94cf-484b-ba44-1a6450038e38",
                                                "sense_id": "ab59ebd1-7e53-3aa3-bff9-3357ebccb859",
                                                "text": "Mein Kompliment an die Frau Mamá."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a65ff37f-0d47-33a2-8584-16ec8c834e99",
                                        "entry_id": "af6bd0c9-47f4-3a60-a044-ad17f5b142bb",
                                        "glosses": [
                                            "Verbeugung"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6d8e295-5a4f-4b67-97c9-0d670660359c",
                                                "sense_id": "a65ff37f-0d47-33a2-8584-16ec8c834e99",
                                                "text": "In der Quadrille kommt das Kompliment als Verbeugung und als Knicks vor."
                                            },
                                            {
                                                "example_id": "2608174f-6d48-4de0-afbd-d983fde46caf",
                                                "sense_id": "a65ff37f-0d47-33a2-8584-16ec8c834e99",
                                                "text": "Der Herr Sowert machte ein tiefes Kompliment, als er dem Bürgermeister begegnete."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59ee40cc-bbff-4d9e-b1c9-97fd1a717559",
                        "source_entry_id": "6b5a4847-15e2-3d11-a47e-45183f7a3eb5",
                        "source_sense_id": "3ae666af-0d39-3710-9410-49a829f5cfd3",
                        "source_sense_description": "een lovende of vleiende opmerking",
                        "target_lang_word": "compliment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "compliment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1540a966-07eb-3e8d-939b-1ecb6885ad14",
                                        "entry_id": "3c40c940-8d16-3632-aaf8-c243a4e65053",
                                        "glosses": [
                                            "An expression of praise, congratulation, or respect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9dfb6d5-be1e-4092-85b6-814506a3c5ab",
                                                "sense_id": "1540a966-07eb-3e8d-939b-1ecb6885ad14",
                                                "text": "pay someone a compliment"
                                            },
                                            {
                                                "example_id": "65a86250-65f2-4bdf-ab19-c77241533fc2",
                                                "sense_id": "1540a966-07eb-3e8d-939b-1ecb6885ad14",
                                                "text": "[…] I met him\nWith customary compliment; when he,\nWafting his eyes to the contrary and falling\nA lip of much contempt, speeds from me and\nSo leaves me to consider what is breeding\nThat changeth thus his manners."
                                            },
                                            {
                                                "example_id": "f7bc4c40-a54a-435e-a54f-a63ac6c71f11",
                                                "sense_id": "1540a966-07eb-3e8d-939b-1ecb6885ad14",
                                                "text": "[...] what honour that,\nbut tedious waste of time, to sit and hear\nSo many hollow compliments and lies,\nOutlandish flatteries?"
                                            },
                                            {
                                                "example_id": "707c4699-12e6-4d33-b61e-15aafdbb6fc8",
                                                "sense_id": "1540a966-07eb-3e8d-939b-1ecb6885ad14",
                                                "text": "Virtue indeed meets many a rhiming friend,\nAnd many a compliment politely penn’d,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57dbb3e9-40ea-362e-aa1b-c8d551b37a10",
                                        "entry_id": "3c40c940-8d16-3632-aaf8-c243a4e65053",
                                        "glosses": [
                                            "Complimentary language; courtesy, flattery."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02981f5f-dd9f-4a96-8c10-55bb7c467d03",
                                                "sense_id": "57dbb3e9-40ea-362e-aa1b-c8d551b37a10",
                                                "text": "He told the Captain, He was heartily sorry for his Misfortunes; tho’ in my Opinion that was nothing but a Compliment: For, as I found afterwards, he was more brutish, and dishonest, than most of the other Kings on the Island […]"
                                            },
                                            {
                                                "example_id": "4823951a-7420-4977-8010-864db318dc75",
                                                "sense_id": "57dbb3e9-40ea-362e-aa1b-c8d551b37a10",
                                                "text": "This accomplished man condescended to think of a young girl, and take the pains to talk to her, not with absurd compliment, but with an appeal to her understanding, and sometimes with instructive correction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a60acd49-08f5-3cdc-85c2-7c0dce0f2d33",
                                        "entry_id": "3c40c940-8d16-3632-aaf8-c243a4e65053",
                                        "glosses": [
                                            "Misspelling of complement."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "misspelling"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "compliment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "147c62db-e873-32f0-b756-e4333a52063b",
                                        "entry_id": "44515e76-bc58-3207-af95-364f53f3e396",
                                        "glosses": [
                                            "To pay a compliment (to someone); to express a favourable opinion (of someone)."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5858d8b9-1bdd-40f7-9f44-04628ae0dcf1",
                                                "sense_id": "147c62db-e873-32f0-b756-e4333a52063b",
                                                "text": "[…] She transferr'd the curs'd Advice, / That Monarchs ſhould their inward Soul diſguise, / Diſſemble, and command; be falſe, and wiſe; / By ignominous Arts for ſervile Ends / Should compliment their Foes, and ſhun their Friends."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fab78440-c277-33bc-9fab-7bd22e6f4ec5",
                                        "entry_id": "44515e76-bc58-3207-af95-364f53f3e396",
                                        "glosses": [
                                            "Misspelling of complement."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "misspelling"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2af5c1f5-c5ab-4f04-bca2-fdac999228a2",
                        "source_entry_id": "6b5a4847-15e2-3d11-a47e-45183f7a3eb5",
                        "source_sense_id": "3ae666af-0d39-3710-9410-49a829f5cfd3",
                        "source_sense_description": "een lovende of vleiende opmerking",
                        "target_lang_word": "compliment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "compliment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f1718038-a332-3c38-ba76-2a530eb5bec1",
                                        "entry_id": "66c21ebf-d88d-3a7d-9fbb-74f07be3c2c7",
                                        "glosses": [
                                            "Paroles louant la qualité d’une chose ou d’une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0a96a88-ca09-4d09-ae33-b1396328ee6c",
                                                "sense_id": "f1718038-a332-3c38-ba76-2a530eb5bec1",
                                                "text": "Tout en faisant oublier adroitement Nicolas, pour dissiper la méfiance dans cette âme naïve, Catherine y distillait superfinement l’ambroisie des compliments."
                                            },
                                            {
                                                "example_id": "1344d884-9d32-4a36-bd8b-320e51d164f1",
                                                "sense_id": "f1718038-a332-3c38-ba76-2a530eb5bec1",
                                                "text": "— Vous avez de beaux yeux.\n— Merci pour le compliment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df50efaf-70c4-3ac9-8eee-c3e9857274da",
                                        "entry_id": "66c21ebf-d88d-3a7d-9fbb-74f07be3c2c7",
                                        "glosses": [
                                            "Paroles de civilité, obligeantes, flatteuses, par lesquelles on témoigne à quelqu’un le respect, l’affection, l’estime qu’on a pour lui, ou la part que l’on prend à ce qui lui arrive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb37859e-7886-4ecf-8db5-c71fd78adf86",
                                                "sense_id": "df50efaf-70c4-3ac9-8eee-c3e9857274da",
                                                "text": "— À présent, dit la tante, il faut, Jeanne, faire tes compliments à M. le curé et à ton parrain."
                                            },
                                            {
                                                "example_id": "76ffc183-e439-4e3a-8689-faf86be788a4",
                                                "sense_id": "df50efaf-70c4-3ac9-8eee-c3e9857274da",
                                                "text": "Tous les chrétiens de la paroisse venaient réciter leurs compliments aux parents d’en dessous. Penchés sur leurs tombes, ils ôtaient un brin d’herbe, un pied de chicorée, avec les doigts ratissaient la terre, comme pour apaiser les défunts, leur passer la main dans les cheveux."
                                            },
                                            {
                                                "example_id": "bca19e23-045f-4f3b-848d-13e32b3055e4",
                                                "sense_id": "df50efaf-70c4-3ac9-8eee-c3e9857274da",
                                                "text": "Puis il fallut écouter les compliments des paysans et leurs doléances enveloppées dans des protestations de respect."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0db4b841-b842-30ee-bc17-5cf2f821d1ad",
                                        "entry_id": "66c21ebf-d88d-3a7d-9fbb-74f07be3c2c7",
                                        "glosses": [
                                            "Simple terme de civilité pour se rappeler au souvenir de quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "170f9401-d5a3-4a46-a2e3-4f9af76df170",
                                                "sense_id": "0db4b841-b842-30ee-bc17-5cf2f821d1ad",
                                                "text": "Il m’a chargé de vous faire mille compliments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9924057b-a016-3c2f-815c-50d319a42f5c",
                                        "entry_id": "66c21ebf-d88d-3a7d-9fbb-74f07be3c2c7",
                                        "glosses": [
                                            "Paroles désobligeantes ou injurieuses."
                                        ],
                                        "tags": [],
                                        "note": "Il est alors toujours accompagné d’une épithète qui indique le sens détourné qu’on lui donne",
                                        "examples": [
                                            {
                                                "example_id": "5d14357d-ee88-4054-a460-7f5816e46352",
                                                "sense_id": "9924057b-a016-3c2f-815c-50d319a42f5c",
                                                "text": "Vous lui avez fait là un mauvais compliment. - Voilà un fâcheux compliment. - Il m’est venu faire un étrange compliment, un sot compliment."
                                            },
                                            {
                                                "example_id": "31d55fe6-c087-455b-a391-bbf4d64eb7b4",
                                                "sense_id": "9924057b-a016-3c2f-815c-50d319a42f5c",
                                                "text": "— Voilà un joli compliment, un compliment très flatteur, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57e56c25-7fac-3a00-aca6-7e8124d49c83",
                                        "entry_id": "66c21ebf-d88d-3a7d-9fbb-74f07be3c2c7",
                                        "glosses": [
                                            "Opposé de l’intention réelle, des promesses effectives."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "556971b3-32c1-4d15-a64a-cc0f14e1d727",
                                                "sense_id": "57e56c25-7fac-3a00-aca6-7e8124d49c83",
                                                "text": "Il vous fait des offres de service, c’est pour compliment. - Tout cela se passera, s’est passé en compliments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9221836-9ddd-3df3-abc9-1f121bcf0579",
                                        "entry_id": "66c21ebf-d88d-3a7d-9fbb-74f07be3c2c7",
                                        "glosses": [
                                            "Petit discours en vers ou en prose qu’on fait réciter ou présenter par un enfant à son père, à sa mère, ou à une autre personne, le jour de leur fête ou le premier jour de l’an, pour les complimenter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef802165-897e-4c4e-9726-3e420855f9bb",
                                                "sense_id": "e9221836-9ddd-3df3-abc9-1f121bcf0579",
                                                "text": "Apprendre, réciter un compliment. - Un recueil de compliments."
                                            },
                                            {
                                                "example_id": "35b58a78-5b2c-425b-a0be-ba3efef589e3",
                                                "sense_id": "e9221836-9ddd-3df3-abc9-1f121bcf0579",
                                                "text": "Une petite fille, qui portait l’ancien costume du pays, un costume qui ne se porte plus depuis soixante ans, jupon rayé, corsage de velours, coiffe de dentelle, s’avança vers M. le président, s’arrêta à trois pas, lui débita un compliment que personne n’entendit, et lui offrit enfin une gerbe de fleurs tricolores, cueillies, dit Le Petit F[ouger]ais, dans nos campagnes."
                                            },
                                            {
                                                "example_id": "fc502d57-9411-4d8d-8243-08183db73ea1",
                                                "sense_id": "e9221836-9ddd-3df3-abc9-1f121bcf0579",
                                                "text": "Le jour de sa première communion, c’est lui qui a été choisi pour réciter le compliment à l’évêque, et je vous prie de croire qu’il ne bégayait pas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
