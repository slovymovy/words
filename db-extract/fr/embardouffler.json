                ],
                "senses": [
                    {
                        "sense_id": "4daac595-5dd7-3474-af82-f715a7d7620d",
                        "entry_id": "b918123d-e890-3749-9860-a24e06b037e0",
                        "glosses": [
                            "Salir, barbouiller."
                        ],
                        "tags": [
                            "Genève"
                        ],
                        "examples": [
                            {
                                "example_id": "f5e9110e-ab39-4a4b-8f25-867972a3029f",
                                "sense_id": "4daac595-5dd7-3474-af82-f715a7d7620d",
                                "text": "Vous avez du caoutchouc qui se colle sur lui même sans \"embardouffler\" de colle son support."
                            },
                            {
                                "example_id": "f71549aa-c75e-4a23-b161-b6516fa7673d",
                                "sense_id": "4daac595-5dd7-3474-af82-f715a7d7620d",
                                "text": "Aucun ET qui se respecte n'irait embardouffler ses révélations, s'il en fait, dans un magma de contrevérités."
                            },
                            {
                                "example_id": "43d10896-2da5-4e88-992b-6bc137c6eb6a",
                                "sense_id": "4daac595-5dd7-3474-af82-f715a7d7620d",
                                "text": "Les jeunes en ont marre de patauger dans la marre des contre-valeurs et de s'embardouffler dans le mal-être et le mal vivre."
                            }
                        ]
                    }
                ],
