                "translations": [
                    {
                        "translation_id": "23eb42c7-47f5-40b3-9fbb-23c1daf524be",
                        "source_entry_id": "133a4a1d-7136-3454-9006-bde5ab46f2cb",
                        "source_sense_id": "fc7e76bb-3dcb-333a-aa69-df403516d2f1",
                        "source_sense_description": "Outil permettant de déboucher une bouteille.",
                        "target_lang_word": "Flaschenöffner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flaschenöffner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81e9228d-c25b-33ea-a59c-7b5c0e3bdb15",
                                        "entry_id": "d17d2393-4f42-31d1-8063-72a1a038eb02",
                                        "glosses": [
                                            "Küchengerät, um Flaschen mit Kronkorken zu öffnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec9dd5ae-3304-4a87-affc-d3107af60b9a",
                                                "sense_id": "81e9228d-c25b-33ea-a59c-7b5c0e3bdb15",
                                                "text": "Gibst du mir bitte den Flaschenöffner?"
                                            },
                                            {
                                                "example_id": "3f691266-5874-4e70-9e14-b6fdcead8085",
                                                "sense_id": "81e9228d-c25b-33ea-a59c-7b5c0e3bdb15",
                                                "text": "„Es werden klassische Pop-Artikel wie mit dem SPÖ-Logo bedruckte Baseballkappen, Kaffeehäferln, Flaschenöffner und Umhängetaschen verkauft.“"
                                            },
                                            {
                                                "example_id": "9f146df3-dde3-4af3-b8b5-f6c84aec5cd5",
                                                "sense_id": "81e9228d-c25b-33ea-a59c-7b5c0e3bdb15",
                                                "text": "„Dirk Stermann hat eine bunte Häkeldecke, ein rosa Plastikarmband und einen Flaschenöffner in Form eines Schlüssels bekommen.“"
                                            },
                                            {
                                                "example_id": "1baf944d-e8bb-403f-9a29-b45acc270e7d",
                                                "sense_id": "81e9228d-c25b-33ea-a59c-7b5c0e3bdb15",
                                                "text": "„Smoaks machte die Flaschen mit einem Flaschenöffner auf, der an einem Schlüsselbund hing.“"
                                            },
                                            {
                                                "example_id": "07bea5e3-a0e0-4b7f-8c14-cf8d43a00838",
                                                "sense_id": "81e9228d-c25b-33ea-a59c-7b5c0e3bdb15",
                                                "text": "„Ich nehme mir noch ein dunkles Leffe und öffne es mit dem Flaschenöffner in Form eines Seehunds, den mir Sóley über den Tisch zuschiebt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
