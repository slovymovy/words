                "senses": [
                    {
                        "sense_id": "0e97a63b-1679-3bf4-bf45-21874de875e2",
                        "entry_id": "15b94d35-ed7b-3a3c-8c1f-f8549519631a",
                        "glosses": [
                            "ein (übernatürliches/unnatürliches) Wesen, das einem Angst macht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86f2eca9-dae4-4898-a796-f0c351659915",
                                "sense_id": "0e97a63b-1679-3bf4-bf45-21874de875e2",
                                "text": "Das Schreckgespenst verfolgte ihn in seinen Träumen."
                            },
                            {
                                "example_id": "ae56aa79-f1d6-408d-8bbd-81bfa06efae4",
                                "sense_id": "0e97a63b-1679-3bf4-bf45-21874de875e2",
                                "text": "Das Schreckgespenst hat sich heute wieder mit Schminke vollgeschmiert, so dass, wenn man ihr auf den Rücken schlägt, eine große Staubwolke entsteht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "aecf0be0-b66e-301a-ad8b-2ee72cd008ad",
                        "entry_id": "15b94d35-ed7b-3a3c-8c1f-f8549519631a",
                        "glosses": [
                            "eine Sache oder ein Ereignis, die Schrecken, Unruhe und Angst verbreiten, abgeleitet von [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d333ab8-1135-424f-903a-c053245d3ae2",
                                "sense_id": "aecf0be0-b66e-301a-ad8b-2ee72cd008ad",
                                "text": "Das Schreckgespenst Bankenpleite ist nicht aus den Medien zu bekommen."
                            },
                            {
                                "example_id": "eb87a242-41bf-4c07-acce-65e81c61735e",
                                "sense_id": "aecf0be0-b66e-301a-ad8b-2ee72cd008ad",
                                "text": "Du musst doch nicht überall gleich Schreckgespenster sehen!"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "47380512-e48e-4f6a-ac34-2ecbb25f0a4f",
