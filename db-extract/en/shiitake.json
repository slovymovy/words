                    {
                        "translation_id": "bc06cc90-d708-492f-8bb7-6dafe9b67f03",
                        "source_entry_id": "dae4b6eb-7d9d-33da-bd41-be9afa4f6eb3",
                        "source_sense_id": "571b3902-7a94-398d-bd68-74ce98e08fa3",
