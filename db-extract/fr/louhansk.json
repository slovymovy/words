                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3bcb5075-553f-4cf4-a62d-c7ae49bc6289",
                        "entry_id": "52962e3a-e8d0-376f-b73a-a15cf3405743",
                        "tags": [],
                        "form": "Lougansk"
