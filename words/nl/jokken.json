{
    "word_family": [
        "jokkebrok"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0d63fea1-9551-32ad-acbb-f4c2bdc16895",
                    "sense_definition": "Een kleine onwaarheid vertellen, vaak over iets onschuldigs of om straf te ontlopen (vooral gebruikt in de context van kinderen).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je mag niet <w>jokken</w> over wie de laatste koekjes heeft opgegeten.",
                            "target_lang_translations": {
                                "ru": "Нельзя <w>врать</w> о том, кто съел последнее печенье.",
                                "en": "You shouldn't <w>fib</w> about who ate the last cookies.",
                                "pl": "Nie wolno <w>zmyślać</w> o tym, kto zjadł ostatnie ciastka."
                            }
                        },
                        {
                            "text": "Volgens mij zat jij net een beetje te <w>jokken</w> toen je dat verhaal vertelde.",
                            "target_lang_translations": {
                                "ru": "Мне кажется, ты немного <w>привирал</w>, когда рассказывал эту историю.",
                                "en": "I think you were <w>fibbing</w> a little when you told that story.",
                                "pl": "Wydaje mi się, że trochę <w>zmyślałeś</w>, kiedy opowiadałeś tę historię."
                            }
                        }
                    ],
                    "synonyms": [
                        "liegen",
                        "fantaseren",
                        "verzinnen"
                    ],
                    "common_phrases": [
                        "niet jokken",
                        "zitten te jokken",
                        "staan te jokken"
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить небольшую неправду, часто о чем-то безобидном или чтобы избежать наказания (преимущественно используется в разговоре с детьми).",
                        "en": "To tell a small untruth, often about something innocent or to avoid punishment (mainly used in the context of children).",
                        "pl": "Mówić drobne kłamstwa, często o czymś niewinnym lub po to, by uniknąć kary (używane głównie w kontekście dzieci)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "врать",
                                "target_lang_sense_clarification": "говорить неправду (разговорное)"
                            },
                            {
                                "target_lang_word": "обманывать",
                                "target_lang_sense_clarification": "вводить в заблуждение"
                            },
                            {
                                "target_lang_word": "привирать",
                                "target_lang_sense_clarification": "немного преувеличивать или искажать факты"
                            },
                            {
                                "target_lang_word": "выдумывать",
                                "target_lang_sense_clarification": "сочинять небылицы"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "fib",
                                "target_lang_sense_clarification": "to tell a small, trivial lie (informal)"
                            },
                            {
                                "target_lang_word": "tell a fib",
                                "target_lang_sense_clarification": "to tell a minor untruth"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zmyślać",
                                "target_lang_sense_clarification": "wymyślać nieprawdę"
                            },
                            {
                                "target_lang_word": "cyganić",
                                "target_lang_sense_clarification": "niewinnie kłamać (potoczne)"
                            },
                            {
                                "target_lang_word": "kłamać",
                                "target_lang_sense_clarification": "mówić nieprawdę ogólnie"
                            },
                            {
                                "target_lang_word": "bujnąć",
                                "target_lang_sense_clarification": "skłamać w drobnej sprawie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6a7abd1-ccdb-3059-b6bf-4239bf0f691b",
                    "sense_definition": "Plezier maken, stoeien of grappen maken.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "jesting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In oude verhalen lees je hoe de kinderen op het plein met elkaar <w>jokten</w>.",
                            "target_lang_translations": {
                                "ru": "В старых рассказах можно прочитать, как дети на площади <w>резвились</w> друг с другом.",
                                "en": "In old stories, you read how the children <w>romped</w> with each other in the square.",
                                "pl": "W starych opowieściach można przeczytać, jak dzieci <w>dokazywały</w> ze sobą na placu."
                            }
                        },
                        {
                            "text": "De nar <w>jokte</w> om de koning aan het lachen te maken.",
                            "target_lang_translations": {
                                "ru": "Шут <w>шутил</w>, чтобы рассмешить короля.",
                                "en": "The jester <w>jested</w> to make the king laugh.",
                                "pl": "Błazen <w>żartował</w>, żeby rozśmieszyć króla."
                            }
                        }
                    ],
                    "synonyms": [
                        "schertsen",
                        "grappen"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "deze betekenis is verouderd en wordt in modern Nederlands niet meer gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Веселиться, дурачиться или шутить (устаревшее значение).",
                        "en": "To have fun, romp, or make jokes (archaic meaning).",
                        "pl": "Bawić się, dokazywać lub żartować (znaczenie przestarzałe)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шутить",
                                "target_lang_sense_clarification": "говорить или делать что-то смешное"
                            },
                            {
                                "target_lang_word": "дурачиться",
                                "target_lang_sense_clarification": "вести себя несерьезно, играть"
                            },
                            {
                                "target_lang_word": "резвиться",
                                "target_lang_sense_clarification": "играть, бегать (о детях)"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "jest",
                                "target_lang_sense_clarification": "to joke or act playfully (archaic)"
                            },
                            {
                                "target_lang_word": "romp",
                                "target_lang_sense_clarification": "to play energetically"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "dokazywać",
                                "target_lang_sense_clarification": "swawolić, bawić się wesoło"
                            },
                            {
                                "target_lang_word": "błaznować",
                                "target_lang_sense_clarification": "stroić żarty"
                            },
                            {
                                "target_lang_word": "żartować",
                                "target_lang_sense_clarification": "mówić lub robić coś dla żartu"
                            }
                        ]
                    }
                }
            ]
