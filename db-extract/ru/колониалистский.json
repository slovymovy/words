                                        "glosses": [
                                            "Of or pertaining to colonialism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "171cbdf5-8441-41a0-9030-0b061feab801",
                                                "sense_id": "449d46d0-ef37-3bdd-be5c-95070d2c66bb",
                                                "text": "Outlines of a systemic relation between society and ecology are evident with the theoretical innovations underlying the ecoimperialist and colonialist critiques."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "colonialist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8fc56b3f-07e2-37b5-ae34-b418e9ce23d1",
                                        "entry_id": "b350e3e1-c2cd-3665-ad1d-9db8906c4ce3",
                                        "glosses": [
                                            "One who supports or advocates colonialism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61bda205-7a61-4880-9b50-2173787bf648",
                                                "sense_id": "8fc56b3f-07e2-37b5-ae34-b418e9ce23d1",
                                                "text": "[Marc Jacobs] is a colonialist, an extender of brands, and in very good shape."
                                            },
                                            {
                                                "example_id": "726e5923-b9eb-466c-93c9-370e24f8b94b",
                                                "sense_id": "8fc56b3f-07e2-37b5-ae34-b418e9ce23d1",
                                                "text": "So far, the daily dose of quinine had been bitter and very unpalatable. […] To make the medicine go down more easily, colonialists occasionally mixed the powder with sugar, water and gin."
                                            }
                                        ]
                                    }
                                ]
                            }
