                                "target_senses": [
                                    {
                                        "sense_id": "54819f02-3efc-3ab3-94de-609b6ecdd29c",
                                        "entry_id": "2084a8ba-d10e-3bdd-bdf2-b746399d6efa",
                                        "glosses": [
                                            "Stelle in einer homogenen Masse, an der Substanz fehlt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a3c49f9-dcde-422e-9afc-fd80089b04be",
                                                "sense_id": "54819f02-3efc-3ab3-94de-609b6ecdd29c",
                                                "text": "In den Zeiten geringeren Wohlstandes wurden die Löcher in den Socken noch gestopft."
                                            },
                                            {
                                                "example_id": "51f59d34-4987-46dc-a153-1e7bd0a4be04",
                                                "sense_id": "54819f02-3efc-3ab3-94de-609b6ecdd29c",
                                                "text": "„Dieses Loch im Strumpf muss gestopft werden. Zeig mal her, ich mach' das.“"
                                            },
                                            {
                                                "example_id": "18437108-2a8e-422e-9714-8bc86f6e89a2",
                                                "sense_id": "54819f02-3efc-3ab3-94de-609b6ecdd29c",
                                                "text": "Die Sandwespen benutzen Löcher in der Uferböschung als Behausung."
                                            },
                                            {
                                                "example_id": "97dbbf9d-4b40-45e0-8033-fa922c382d3a",
                                                "sense_id": "54819f02-3efc-3ab3-94de-609b6ecdd29c",
                                                "text": "Stundenlange Staus, Löcher in den Fahrbahnen und marode Brücken: Deutschlands Straßen \"verrotten\", warnen Lobbyverbände, Wissenschaftler und Politiker einstimmig. Doch wer soll die Reparaturen bezahlen?"
                                            },
                                            {
                                                "example_id": "3aa36e88-a1a2-4fa9-8555-d1874b12783c",
                                                "sense_id": "54819f02-3efc-3ab3-94de-609b6ecdd29c",
                                                "text": "Erst wenn sich die ersten Löcher in seinen Zähnen schmerzhaft bemerkbar machen, wird die Einsicht kommen, dass die heimlich unter der Bettdecke gegessenen Bonbons doch besser in der Tüte geblieben wären."
                                            },
                                            {
                                                "example_id": "19008dff-0e70-40f1-854c-7ed3b54f4e3d",
                                                "sense_id": "54819f02-3efc-3ab3-94de-609b6ecdd29c",
                                                "text": "Durch die hochpräzise gebohrten winzigen Löcher wird das Benzin bei einem sehr hohen Druck von fast 1000 bar im Motorraum zerstäubt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b496930a-5d90-3059-b336-6bc1f0506f78",
                                        "entry_id": "2084a8ba-d10e-3bdd-bdf2-b746399d6efa",
                                        "glosses": [
                                            "Stelle in einer homogenen Masse, an der Substanz fehlt",
                                            "Defektelektron"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94fbc00b-62ed-4c6c-833f-eaead57ca140",
                                                "sense_id": "b496930a-5d90-3059-b336-6bc1f0506f78",
                                                "text": "„Als Defektelektron, Elektronenfehlstelle oder Loch wird der (gedachte) positive bewegliche Ladungsträger in Halbleitern bezeichnet und stellt die äquivalente Beschreibung des Fehlens eines (realen) Valenzelektrons dar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "ba2d9c22-cb67-33ab-8061-6747dcf54686",
                                        "entry_id": "2084a8ba-d10e-3bdd-bdf2-b746399d6efa",
                                        "glosses": [
                                            "kleiner, dunkler Wohnraum oder Wohnung"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2552381c-47d8-4cb4-8eb2-d2e9aaa11986",
                                                "sense_id": "ba2d9c22-cb67-33ab-8061-6747dcf54686",
                                                "text": "In dieses Loch ziehe ich nicht ein."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1603c8ef-7d17-306f-9184-7eceb4918617",
                                        "entry_id": "2084a8ba-d10e-3bdd-bdf2-b746399d6efa",
                                        "glosses": [
                                            "Justizvollzugsanstalt, Gefängnis"
                                        ],
