                "senses": [
                    {
                        "sense_id": "d29c2c08-f3bc-3665-ba98-79bb9b61878a",
                        "entry_id": "af3a554f-e784-3b15-ac2d-167d6fa92442",
                        "glosses": [
                            "darauf aus, eine Sensation zu erleben, Augenzeuge einer bemerkenswerten Tat zu werden"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "02a9612c-428b-4474-a931-ee8fef3e8804",
                                "sense_id": "d29c2c08-f3bc-3665-ba98-79bb9b61878a",
                                "text": "„Aber nicht nur in Berlin erregte der Roman Aufsehen, sondern auch außerhalb, wo man der sensationsgeilen deutschen Hauptstadt ohnehin skeptisch gegenüberstand.“"
                            },
                            {
                                "example_id": "25399460-89d0-4c1e-8824-4f3458a35329",
                                "sense_id": "d29c2c08-f3bc-3665-ba98-79bb9b61878a",
                                "text": "Die beiden mussten sich anhören, sie seien sensationsgeiles Pack, das hier nichts zu suchen hätte."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
