                        "examples": [
                            {
                                "example_id": "48204f09-7448-49f8-89bb-4c4a60b90af6",
                                "sense_id": "62adadc8-8547-3a1f-9e9d-4c68da4af159",
                                "text": "В деся́том часу́ официа́нты бро́сились к крыльцу́, заслы́шав бубе́нчики подъезжа́вшего экипа́жа ста́рого кня́зя.",
                                "translation": "Toward ten o'clock the menservants rushed to the front door, hearing the bells of the old prince's carriage approaching.",
                                "english": "Toward ten o'clock the menservants rushed to the front door, hearing the bells of the old prince's carriage approaching."
                            }
                        ]
                    }
