                    {
                        "translation_id": "35e22d47-58fd-41b8-8d36-52b6fe2e8d1a",
                        "source_entry_id": "daee5863-6acf-35a5-bba2-81bfcef99339",
                        "source_sense_id": "6d1aaacc-00ea-3a59-8ab1-9385f6dd0333",
                        "source_sense_description": "Region im Südosten Italiens",
                        "target_lang_word": "Pouille",
