                        "glosses": [
                            "Douleur cervicale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4ef49e9-f4f7-405d-8a25-1a3016d6297b",
                                "sense_id": "e9464f91-ac52-3590-aca3-a31a58d4ea91",
                                "text": "La pratique s’est établie de ne parler de cervicalgie que pour les douleurs postérieures et postérolatérales du cou, à l’exclusion des douleurs antérieures viscérales, œsophagiennes, trachéales, thyroïdiennes ou autres."
                            },
                            {
                                "example_id": "7766f7de-75fc-49b5-89de-2e07e41c0f2f",
                                "sense_id": "e9464f91-ac52-3590-aca3-a31a58d4ea91",
                                "text": "Tour d’horizon des stratégies et des exercices qui permettent au quotidien de ne plus « en avoir plein le dos » ou du moins de prévenir lombalgies, dorsalgies et autres cervicalgies."
                            }
                        ]
                    }
