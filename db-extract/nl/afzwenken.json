        "nl-extract.jsonl": [
            {
                "entry_id": "2709a63d-a31e-332c-80a7-aba93dc7e164",
                "word": "afzwenken",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "63720225-917f-396d-920c-0460e72eb052",
                        "entry_id": "2709a63d-a31e-332c-80a7-aba93dc7e164",
                        "glosses": [
                            "van richting veranderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f76c1d7-d497-450c-8780-d17ae874f4b9",
                                "sense_id": "63720225-917f-396d-920c-0460e72eb052",
                                "text": "Zeker mogen er in onze dichtbevolkte regio geen landings- of opstijgbanen bijkomen. Wij verwerpen de gevraagde verlenging van baan 25 L, die het mogelijk zou moeten maken vliegtuigen ook in westelijke richting te doen opstijgen, met onmiddellijk afzwenken naar het zuiden."
                            },
                            {
                                "example_id": "eb0a83e1-b91d-453a-bf7e-e9cee85a113b",
                                "sense_id": "63720225-917f-396d-920c-0460e72eb052",
                                "text": "De minister wil tevens bewijzen dat de regering niet plots naar links zal afzwenken als hij premier wordt. Hoe groter de woede van de linkervleugel van Labour, hoe beter Browns imago bij de gemiddelde Brit in het politieke centrum."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a4eeb063-b200-472f-b288-4417f8f284f9",
                        "source_entry_id": "2709a63d-a31e-332c-80a7-aba93dc7e164",
                        "source_sense_id": "63720225-917f-396d-920c-0460e72eb052",
                        "target_lang_word": "turn off",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "turn off",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b9362cb-229c-3d37-a412-0cc4d81d313d",
                                        "entry_id": "9099752d-b19f-34d7-9ea6-1465f5abf814",
                                        "glosses": [
                                            "To dismiss; to fire."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09079baa-4808-4052-9c36-59190ced927f",
                                                "sense_id": "7b9362cb-229c-3d37-a412-0cc4d81d313d",
                                                "text": "[H]e came to this country in the service of an English gentleman, whom he was obliged to quit through the malice of the valet de chambre, who taking advantage of the young man's being overtaken with liquor on the last St.Andrew's day, turned him off, on the pretext of his being an habitual drunkard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5ec893d-57e0-39fe-bf8c-c0e0479d34a2",
                                        "entry_id": "9099752d-b19f-34d7-9ea6-1465f5abf814",
                                        "glosses": [
                                            "To power down, to switch off, to put out of operation, to deactivate (an appliance, light, mechanism, functionality etc.)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "785b2188-7611-4921-b6e3-6af9950347b3",
                                                "sense_id": "d5ec893d-57e0-39fe-bf8c-c0e0479d34a2",
                                                "text": "Turn off the machine and unplug it when you leave."
                                            },
                                            {
                                                "example_id": "87653262-0747-4644-9d3c-591585f56424",
                                                "sense_id": "d5ec893d-57e0-39fe-bf8c-c0e0479d34a2",
                                                "text": "\"Will it ever stop?\" Yo, I don't know / Turn off the lights, and I'll glow"
                                            },
                                            {
                                                "example_id": "cb59a988-5b69-4cca-828e-66668db25715",
                                                "sense_id": "d5ec893d-57e0-39fe-bf8c-c0e0479d34a2",
                                                "text": "Hello, IT. Have you tried turning it off and turning it on again? Ok. Well, are you sure that it's plugged in?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af3b52e1-f3fb-31a6-8cb5-6a9a24805fce",
                                        "entry_id": "9099752d-b19f-34d7-9ea6-1465f5abf814",
                                        "glosses": [
                                            "To become deactivated; to become powered down."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc7b6ec5-b881-445b-8fce-aac1f66dd19b",
                                                "sense_id": "af3b52e1-f3fb-31a6-8cb5-6a9a24805fce",
                                                "text": "My computer turned off!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e95e19c6-d611-301a-b2d9-683ac689db18",
                                        "entry_id": "9099752d-b19f-34d7-9ea6-1465f5abf814",
                                        "glosses": [
                                            "To rotate a tap or valve so as to interrupt the outflow of liquid or gas."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebe28fe4-c2c9-4025-824f-a7f4fa3bb23c",
                                                "sense_id": "e95e19c6-d611-301a-b2d9-683ac689db18",
                                                "text": "Remember to turn the tap off once you've finished so you don't waste water."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52df038b-d42d-3a73-aa9e-476d190660f1",
                                        "entry_id": "9099752d-b19f-34d7-9ea6-1465f5abf814",
                                        "glosses": [
                                            "To repulse, disgust, or discourage (someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd5f1bc2-eb66-4f51-838f-19c702710b32",
                                                "sense_id": "52df038b-d42d-3a73-aa9e-476d190660f1",
                                                "text": "Cigarette smoking really turns me off."
                                            },
                                            {
                                                "example_id": "a3e95eac-bdd1-43e8-9e3a-5e8a4d02d69a",
                                                "sense_id": "52df038b-d42d-3a73-aa9e-476d190660f1",
                                                "text": "Better be a gentleman, or you'll turn me off"
                                            },
                                            {
                                                "example_id": "a406cd08-326d-486b-9d79-98ddb4b991b4",
                                                "sense_id": "52df038b-d42d-3a73-aa9e-476d190660f1",
                                                "text": "\"They are turning people off travelling. And the removal of catering on such a long-distance route is just bonkers.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1578da1e-6b16-3879-b7fd-2539bcace40b",
                                        "entry_id": "9099752d-b19f-34d7-9ea6-1465f5abf814",
                                        "glosses": [
                                            "To leave a road; to exit."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7fc8b9c-af61-4a12-8e9b-f60ca95795a5",
                                                "sense_id": "1578da1e-6b16-3879-b7fd-2539bcace40b",
                                                "text": "Turn off at the next exit so we can have lunch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14e54c8c-9e27-3670-8337-9184bd69a9e2",
                                        "entry_id": "9099752d-b19f-34d7-9ea6-1465f5abf814",
                                        "glosses": [
                                            "To turn out; to produce."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2763d88-d5ee-4918-80bf-1748855f590f",
                                                "sense_id": "14e54c8c-9e27-3670-8337-9184bd69a9e2",
                                                "text": "According to D. A. Wells, one boy and a machine can turn off 9,000 pair of sleeve buttons in a day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59b03007-065a-385d-bcc6-5d4199e5db66",
                                        "entry_id": "9099752d-b19f-34d7-9ea6-1465f5abf814",
                                        "glosses": [
                                            "To execute by hanging."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf5aafc0-3776-4d0e-9318-6912e0199e6f",
                                                "sense_id": "59b03007-065a-385d-bcc6-5d4199e5db66",
                                                "text": "The fell had not only put its cap on, it was drawn down over its white face as that other white cap, still more terrible to look upon, covers the features of the poor wretch about to be \"turned off\" on the gallows."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
