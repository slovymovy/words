                    {
                        "translation_id": "176b7b79-699d-47a9-a8b4-ff66f308ce3a",
                        "source_entry_id": "0cd66e4e-62fe-3d61-aca3-5dd5afe1afa9",
                        "source_sense_id": "62b503a9-bef0-3b5b-96a6-c79491fa6b09",
                        "target_lang_word": "clientèle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clientèle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0bef3c45-4f08-3ff3-9c54-8b8bdc6ee800",
                                        "entry_id": "6d7f3e00-abf1-37d9-8c55-1d0e1f9a5dd7",
                                        "glosses": [
                                            "Chez les Romains, ensemble des clients d’un patron."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9a529b9-e27a-43ee-a2cb-da839c999309",
                                                "sense_id": "0bef3c45-4f08-3ff3-9c54-8b8bdc6ee800",
                                                "text": "Il avait assemblé toute sa clientèle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c79fd87e-fd98-3027-9bc7-3fc9d3daa4c4",
                                        "entry_id": "6d7f3e00-abf1-37d9-8c55-1d0e1f9a5dd7",
                                        "glosses": [
                                            "Tous ceux qui s’attachent à la personne d’un homme puissant pour en obtenir des faveurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e87d5afc-1008-48af-886f-77159f86f2c5",
                                                "sense_id": "c79fd87e-fd98-3027-9bc7-3fc9d3daa4c4",
                                                "text": "Je ne pouvais avoir ces prompts amis que donne la fortune, car il n’y avait rien à gagner avec un pauvre polisson qui n’avait pas même d’argent de semaine ; je ne m’enrôlai point non plus dans une clientèle, car je hais les protecteurs."
                                            },
                                            {
                                                "example_id": "d428420f-22f2-4db1-943b-9857d4444fbb",
                                                "sense_id": "c79fd87e-fd98-3027-9bc7-3fc9d3daa4c4",
                                                "text": "La clientèle d’un ministre."
                                            },
                                            {
                                                "example_id": "e3288cdd-be18-44a2-9e6f-9c1dfff4bcbc",
                                                "sense_id": "c79fd87e-fd98-3027-9bc7-3fc9d3daa4c4",
                                                "text": "Il a placé toute sa clientèle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96b38707-e50f-3241-943f-3706b380b41e",
                                        "entry_id": "6d7f3e00-abf1-37d9-8c55-1d0e1f9a5dd7",
                                        "glosses": [
                                            "Tous les clients d’un avocat, d’un avoué, d’un notaire, d’un médecin, d’un marchand, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4de5c1ac-aa9a-4e65-8856-4d5509e64adb",
                                                "sense_id": "96b38707-e50f-3241-943f-3706b380b41e",
                                                "text": "Mais les collecteurs ne sont que marchands : ils fournissent leur clientèle, s'engraissent du travail des uns, de la gourmandise des autres."
                                            },
                                            {
                                                "example_id": "1c589965-649c-4af7-bcef-cf7beee497ae",
                                                "sense_id": "96b38707-e50f-3241-943f-3706b380b41e",
                                                "text": "Lorsqu'une grande marque de produits agroalimentaires souhaite lancer un nouveau yahourt 0 % de matière grasse dédié à une clientèle féminine, elle recourt au marketing opérationnel."
                                            },
                                            {
                                                "example_id": "ab6af9f7-5bd6-4887-a110-1117b5048b50",
                                                "sense_id": "96b38707-e50f-3241-943f-3706b380b41e",
                                                "text": "S’il faut toujours dire la vérité à la clientèle, il n’y a pas de commerce possible."
                                            },
                                            {
                                                "example_id": "0875f004-1b18-438e-86c0-88d30a8f96f1",
                                                "sense_id": "96b38707-e50f-3241-943f-3706b380b41e",
                                                "text": "Cependant, il convient de retenir que les honoraires du radiesthésiste ne doivent pas être excessifs, sans quoi il perdrait rapidement sa clientèle."
                                            },
                                            {
                                                "example_id": "2379aa00-4c2d-482f-b448-164034999f5e",
                                                "sense_id": "96b38707-e50f-3241-943f-3706b380b41e",
                                                "text": "En fait de saint-émilion, Marthe achète sa piquette à Anselme. […]. Le vin vaut ce qu'il vaut, mais Marthe le touche à bon prix et comme la clientèle est soiffarde,tout le monde est content."
                                            },
                                            {
                                                "example_id": "096a6567-c68b-48e7-8697-906c9fd6a88d",
                                                "sense_id": "96b38707-e50f-3241-943f-3706b380b41e",
                                                "text": "Ce café-bar rétro au style décalé mitonne salades, sandwichs, quiches, houmous, assiettes de fromage et de charcuterie et nombreux plats végétariens pour une clientèle tendance."
                                            }
                                        ]
                                    }
                                ]
                            }
