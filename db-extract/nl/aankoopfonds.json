                        "examples": [
                            {
                                "example_id": "3c79f57e-c762-4845-bef2-4bb222950ff4",
                                "sense_id": "3c3b2c90-fdce-3181-9c94-e0a02120dbd3",
                                "text": "De commissie raadt daarom ook aan het Museaal Aankoopfonds aan te vullen tot 100 miljoen. Daarnaast moeten er fiscale maatregelen komen die de geefcultuur in Nederland kunnen stimuleren."
                            },
                            {
                                "example_id": "dec12bed-3f62-4bbf-909a-f62ca4689a58",
                                "sense_id": "3c3b2c90-fdce-3181-9c94-e0a02120dbd3",
                                "text": "Verder worden dit jaar voor 30 miljoen euro grote monumenten, zoals kerken, gerestaureerd. Het kabinet gaat ook het budget van het Nationaal Aankoopfonds aanvullen. Door de aankoop van de twee huwelijksportretten van Rembrandt van Marten en Oopjen is dit fonds vrijwel leeg."
                            }
