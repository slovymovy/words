                },
                {
                    "sense_id": "61ae03af-5617-3085-9037-5624708f0fa4",
                    "sense_definition": "een informele aanspreekvorm voor een mannelijke vriend",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vriendschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hey <w>broer</w>, hoe heb jij opeens geld voor een nieuwe waggie?",
                            "target_lang_translations": {
