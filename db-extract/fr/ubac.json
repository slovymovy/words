                "senses": [
                    {
                        "sense_id": "b908c8ec-f8d2-30f9-bd7a-917130ac82f4",
                        "entry_id": "365afc0a-3bcc-30f0-9cd8-bb191a212658",
                        "glosses": [
                            "Versant d’une montagne qui est le moins exposé au soleil, et donc le versant le plus froid."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64304e04-4034-428d-99f9-e783ea96f696",
                                "sense_id": "b908c8ec-f8d2-30f9-bd7a-917130ac82f4",
                                "text": "Le Hêtre réfugié aux ubacs n’a pu se maintenir que dans les parties à sol profond, formant, çà et là, quelques « bouquets »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46cf438e-c4d8-4464-892a-3e2ab60fa4b4",
                        "source_entry_id": "365afc0a-3bcc-30f0-9cd8-bb191a212658",
                        "source_sense_id": "b908c8ec-f8d2-30f9-bd7a-917130ac82f4",
                        "target_lang_word": "ubac",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ubac",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04a973b5-9393-3cd8-ae07-9d703fa85bdf",
                                        "entry_id": "cf9c557c-20c1-36dd-967c-1e29bae547fb",
                                        "glosses": [
                                            "The shady side of a mountain; in the northern hemisphere, especially a north-facing slope."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e4d9566-9eb0-426c-8aa2-704e2d942ae1",
                                                "sense_id": "04a973b5-9393-3cd8-ae07-9d703fa85bdf",
                                                "text": "The distribution of barley is generally on the adret slope, the ubac seeming to be disregarded. A sunny slope is the most important natural factor in the cultivation of barley and wheat. Very rarely they are cultivated in ubac fields, but close investigation showed them to be of secondary adret nature. In this case seeds are sown a month earlier and mown ten days later than on the adret slope."
                                            },
                                            {
                                                "example_id": "6e8896e6-6d46-4153-b248-e92eb7a0f49e",
                                                "sense_id": "04a973b5-9393-3cd8-ae07-9d703fa85bdf",
                                                "text": "Viticulure in an alpine (Savoie) or sub-alpine environment (like the Jura) is a precarious activity […] Exposure, by contrast, exaggerates or modifies the quantity of the altitudinal elements in terms of ubac (shady) versus adret (sunny) positions, wet and dry positions, or windy and protected positions, respectively. The advantages of adret slopes, which are usually drier and more protected, are evident and of paramount importance. Adret aspects receive much higher levels of direct sunlight, which produces higher soil and plant temperatures."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
