{
    "word_family": [
        "concomitance",
        "concomitant"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a3bedefa-735e-3e6a-89e0-c738a45289d1",
                    "sense_definition": "At the same time as something else; simultaneously.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "occurrence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The price of oil dropped, and <w>concomitantly</w>, airline ticket prices decreased across the country.",
                            "target_lang_translations": {
                                "ru": "Цены на нефть упали, и <w>одновременно</w> с этим по всей стране снизились цены на авиабилеты."
                            }
                        },
                        {
                            "text": "As the population grew, the demand for clean water increased <w>concomitantly</w>.",
                            "target_lang_translations": {
                                "ru": "По мере роста населения <w>параллельно</w> увеличивался спрос на чистую воду."
                            }
                        }
                    ],
                    "synonyms": [
                        "concurrently",
                        "simultaneously"
                    ],
                    "common_phrases": [
                        "occur concomitantly",
                        "increase concomitantly"
                    ],
                    "target_lang_definitions": {
                        "ru": "В то же самое время, что и что-то другое; одновременно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одновременно",
                                "target_lang_sense_clarification": "в одно и то же время"
                            },
                            {
                                "target_lang_word": "параллельно",
                                "target_lang_sense_clarification": "происходя в то же время"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f5ce776-54bb-32e6-be73-90d9185b8715",
                    "sense_definition": "In close association with or as an accompanying result of something else.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "occurrence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient developed a secondary infection <w>concomitantly</w> during her prolonged hospital stay.",
                            "target_lang_translations": {
                                "ru": "Во время длительного пребывания в больнице у пациентки <w>сопутствующе</w> развилась вторичная инфекция."
                            }
                        },
                        {
                            "text": "The economic reform was introduced <w>concomitantly</w> with strict environmental regulations.",
                            "target_lang_translations": {
                                "ru": "Экономическая реформа проводилась <w>вместе со</w> строгими экологическими предписаниями."
                            }
                        }
                    ],
                    "synonyms": [
                        "incidentally"
                    ],
                    "target_lang_definitions": {
                        "ru": "В тесной связи с чем-либо или как сопутствующее следствие чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сопутствующе",
                                "target_lang_sense_clarification": "в качестве сопутствующего фактора"
                            },
                            {
                                "target_lang_word": "вместе с тем",
                                "target_lang_sense_clarification": "наряду с этим, попутно"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}