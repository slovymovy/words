                    {
                        "sense_id": "c649369c-d743-3a15-908a-5cec1f273788",
                        "entry_id": "621b0dfe-23b1-3d4e-ba38-269ea7d684ff",
                        "glosses": [
                            "Celui qui colle du papier peint sur les parois d’un appartement ou des affiches sur les murailles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "333ec5af-7c09-49d5-bcc9-8de148186794",
                                "sense_id": "c649369c-d743-3a15-908a-5cec1f273788",
                                "text": "De ce fait, il ne prit point garde à un colleur d’affiches qui descendait les marches unissant le pont des Arts au quai Malaquais."
                            },
                            {
                                "example_id": "6feb9554-8ab2-4adc-8cf1-1164250052e3",
                                "sense_id": "c649369c-d743-3a15-908a-5cec1f273788",
                                "text": "Les colleurs d’affiches après avoir enduit de colle très liquide le panneau d’affichage appliquent leur papier en le noyant littéralement de colle pour que l'allongement soit rapide et le glissement facile."
                            }
                        ]
                    },
                    {
