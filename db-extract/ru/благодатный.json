                    {
                        "sense_id": "5257a2f8-beb5-3dce-ac70-32ef07933f89",
                        "entry_id": "bb6b6e4e-affb-3167-bc0d-01e72d11e968",
                        "glosses": [
                            "blissful, blessed, happy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09126bee-0cc3-43b3-92b7-28de4230f377",
                                "sense_id": "5257a2f8-beb5-3dce-ac70-32ef07933f89",
                                "text": "благода́тная тишина́",
                                "translation": "blessed/blissful silence",
                                "english": "blessed/blissful silence"
                            },
                            {
                                "example_id": "7d765182-51c4-47ea-b7e1-fae8af003f77",
                                "sense_id": "5257a2f8-beb5-3dce-ac70-32ef07933f89",
                                "text": "— Име́ю удово́льствие и благода́тное утеше́ние ви́деть вас в до́бром здоро́вье, — сказа́л он ба́бушке, и тру́дно бы́ло поня́ть, шу́тит э́то он и́ли говори́т серьёзно.",
                                "translation": "“I have the pleasure and blessed consolation of seeing you in excellent health,” he said to Grandmother, and it was hard to say whether he spoke in earnest or in jest.",
                                "english": "“I have the pleasure and blessed consolation of seeing you in excellent health,” he said to Grandmother, and it was hard to say whether he spoke in earnest or in jest."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a7734ff-f649-3038-9a9c-a3330003ae02",
                        "entry_id": "bb6b6e4e-affb-3167-bc0d-01e72d11e968",
                        "glosses": [
                            "beneficial, godsent"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "115830f5-b991-4cd3-a65b-f6c5713a0b66",
                                "sense_id": "6a7734ff-f649-3038-9a9c-a3330003ae02",
                                "text": "благода́тная пого́да",
                                "translation": "propitious/benign weather",
                                "english": "propitious/benign weather"
                            },
                            {
                                "example_id": "66e2c130-3bf1-4689-bead-93bb64262d4b",
                                "sense_id": "6a7734ff-f649-3038-9a9c-a3330003ae02",
                                "text": "благода́тный во́здух",
                                "translation": "salubrious/healthful air",
                                "english": "salubrious/healthful air"
                            },
                            {
                                "example_id": "93c35867-59f8-4eeb-b91c-19e52adc1f53",
                                "sense_id": "6a7734ff-f649-3038-9a9c-a3330003ae02",
                                "text": "благода́тный дождь",
                                "translation": "godsent/fertile rain",
                                "english": "godsent/fertile rain"
                            }
                        ]
                    },
