                                                "text": "Herr Steinmetz ist als Kaninchenzüchter erfolgreich."
                                            },
                                            {
                                                "example_id": "3a6d694d-d993-4421-aa59-b1e8a155da50",
                                                "sense_id": "76aa317e-a300-3b9c-a917-9b3d88eafda5",
                                                "text": "Herr Steinmetz heiratet im September auf Hawaii."
                                            },
                                            {
                                                "example_id": "e65e0575-d3db-4fc8-a871-974975ec5012",
                                                "sense_id": "76aa317e-a300-3b9c-a917-9b3d88eafda5",
                                                "text": "Frau Steinmetz liebt es, an Weihnachten Plätzchen zu backen."
                                            },
                                            {
                                                "example_id": "ae92e811-58dd-4a29-898b-9e80dac1ad0d",
                                                "sense_id": "76aa317e-a300-3b9c-a917-9b3d88eafda5",
                                                "text": "Die Steinmetzes lieben die Natur und die Tiere."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eed7f28c-358e-4335-bced-55c91fc2e8c7",
                        "source_entry_id": "923ba50e-3419-3414-8f7a-e0813f213c75",
                        "source_sense_id": "1cf45412-1183-37c4-afe5-b3bf938adebf",
                        "target_lang_word": "tailleur de pierre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tailleur de pierre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7cac7d21-1123-3a51-903b-eabb66ae7446",
                                        "entry_id": "2952b7da-24e1-3377-ae00-1bd143cb9fb9",
                                        "glosses": [
                                            "Professionnel du bâtiment qui réalise des éléments architecturaux en pierre de taille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbfe4f2a-0096-440a-a80c-2fd42547ffa5",
                                                "sense_id": "7cac7d21-1123-3a51-903b-eabb66ae7446",
                                                "text": "Difficile de dire si l’incendie du 15 avril a suscité des vocations de charpentier, couvreur ou tailleur de pierre car ceux qui ont démarré leur apprentissage en septembre ont généralement cherché leur entreprise entre janvier et mai."
                                            },
                                            {
                                                "example_id": "f747092b-d2f2-4027-a802-cee8fab5f9d8",
                                                "sense_id": "7cac7d21-1123-3a51-903b-eabb66ae7446",
                                                "text": "Selon les versions, le chenal doit son nom aux petites huttes où les sauniers s’abritaient, qu’on appelle les cayennes ou à la franc-maçonnerie, le Cayenne étant la maison mère où étaient alors reçus les apprentis tailleurs de pierre."
                                            }
                                        ]
                                    }
                                ]
                            }
