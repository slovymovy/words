                ],
                "senses": [
                    {
                        "sense_id": "dd0a185d-442e-32ea-9237-5b51887bd3d0",
                        "entry_id": "dca417ca-66c7-3bab-81cb-7d17fb33e543",
                        "glosses": [
                            "geschikt voor kinderen, met voorzieningen die gezinnen met kinderen waarderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da86ed2a-f84c-431c-8ef0-d5bbd26cab52",
                                "sense_id": "dd0a185d-442e-32ea-9237-5b51887bd3d0",
                                "text": "Wij zijn verhuisd naar een rustige, kindvriendelijke wijk."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f72959ef-40be-4b41-9d13-3c54bbfcb988",
                        "source_entry_id": "dca417ca-66c7-3bab-81cb-7d17fb33e543",
                        "source_sense_id": "dd0a185d-442e-32ea-9237-5b51887bd3d0",
                        "source_sense_description": "geschikt voor kinderen, met voorzieningen die gezinnen met kinderen waarderen",
                        "target_lang_word": "kinderfreundlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kinderfreundlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "001971a7-5a1d-3350-b02d-7c8d4a6df41a",
                                        "entry_id": "eebed7f3-fad9-3dba-ae53-af995c9a3195",
                                        "glosses": [
                                            "Kinder positiv beeinflussend; gut für Kinder geeignet; die Interessen/Bedürfnisse von Kindern besonders berücksichtigend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db3b9716-32e4-4576-8c6e-d45e507f8a00",
                                                "sense_id": "001971a7-5a1d-3350-b02d-7c8d4a6df41a",
                                                "text": "Der circa 20 km langen Sandbadestrand im Südosten der Insel Falster „ist sehr kinderfreundlich, weil er flach ins Wasser abfällt.“"
                                            },
                                            {
                                                "example_id": "f59826f1-3574-47e5-a839-6aaed0b76a89",
                                                "sense_id": "001971a7-5a1d-3350-b02d-7c8d4a6df41a",
                                                "text": "„Der Strand ist kilometerlang, feinsandig und fast überall ziemlich breit, flach abfallend und damit sehr kinderfreundlich.“"
                                            },
                                            {
                                                "example_id": "d5fa76be-6397-4086-a219-f34797658551",
                                                "sense_id": "001971a7-5a1d-3350-b02d-7c8d4a6df41a",
                                                "text": "„Der Animationsfilm der Regisseure Ralf Kukula und Matthias Bruhn beschäftigt sich auf kinderfreundliche Weise mit den Geschehnissen rund um den Mauerfall.“"
                                            },
                                            {
                                                "example_id": "5cf2b2bc-3a04-4718-bdb0-08b13643f105",
                                                "sense_id": "001971a7-5a1d-3350-b02d-7c8d4a6df41a",
                                                "text": "[Italien:] „Laut vorläufigen Statistiken ist die Geburtenrate in dem eigentlich als kinderfreundlich geltenden Land so niedrig wie nie zuvor.“"
                                            },
                                            {
                                                "example_id": "877a1382-5b82-4a06-91da-7d6cc8549b8f",
                                                "sense_id": "001971a7-5a1d-3350-b02d-7c8d4a6df41a",
                                                "text": "„In der sehr wettbewerbsorientierten Gesellschaft Chinas wird es jedoch nicht einfach, die Unternehmen von einer kinderfreundlichen Politik zu überzeugen.“"
                                            },
                                            {
                                                "example_id": "a6671e80-a18b-4eee-bcf8-3b9577748e26",
                                                "sense_id": "001971a7-5a1d-3350-b02d-7c8d4a6df41a",
                                                "text": "„Viele Unternehmen in China sehen die neue kinderfreundliche Politik mit Missmut und versuchen, möglichst keine Mitarbeiterinnen mit Kinderwunsch einzustellen, um Kosten zu sparen.“"
                                            },
                                            {
                                                "example_id": "d04b552d-e05e-4b35-83c8-eb2fb56febf0",
                                                "sense_id": "001971a7-5a1d-3350-b02d-7c8d4a6df41a",
                                                "text": "„Der frühe industrielle Kapitalismus war nämlich keineswegs kinderfreundlich: Die Jüngeren stellten eine billige Arbeitskraft dar. Beim Spinnen waren die kleinen Finger der Mädchen oder in der Baugrube die Beweglichkeit der Knaben gefragt.“"
                                            },
                                            {
                                                "example_id": "4f7698b8-eeb8-43f9-b885-c90212cfeeab",
                                                "sense_id": "001971a7-5a1d-3350-b02d-7c8d4a6df41a",
                                                "text": "„2004 wurde Münster von der Initiative „Ein Herz für Kinder“ als kinderfreundlichste Stadt Deutschlands ausgezeichnet,“ […]."
                                            },
                                            {
                                                "example_id": "01e0ba51-9081-4583-8b93-72d0415aa6a7",
                                                "sense_id": "001971a7-5a1d-3350-b02d-7c8d4a6df41a",
                                                "text": "„Sind wir ein kinderfreundliches Land?“"
                                            },
                                            {
                                                "example_id": "2e3756d1-4804-4fbf-aa79-33e4f84bcbdc",
                                                "sense_id": "001971a7-5a1d-3350-b02d-7c8d4a6df41a",
                                                "text": "„Wie kinderfreundlich ist Wien?“"
                                            },
                                            {
                                                "example_id": "faf9ee9d-33db-43af-b1f2-090080b244f9",
                                                "sense_id": "001971a7-5a1d-3350-b02d-7c8d4a6df41a",
                                                "text": "„Die Österreicher sehen ihr Land immer weniger kinderfreundlich.“"
                                            },
                                            {
                                                "example_id": "de356600-3b6a-4771-8331-3f8143a6bb27",
                                                "sense_id": "001971a7-5a1d-3350-b02d-7c8d4a6df41a",
                                                "text": "„Und noch eine nützliche App: Wer mit kleinen Kindern verreist, kennt sich am Reiseziel oft nicht aus und sucht lange nach geeigneten Spielplätzen oder dem nächsten Wickelplatz. Für Deutschland-Urlauber ist die App BabyPlaces die Lösung: Sie zeigt kinderfreundliche Orte in der Umgebung an.“"
                                            },
                                            {
                                                "example_id": "30f85e33-c358-4474-941b-b1c1a6f0602e",
                                                "sense_id": "001971a7-5a1d-3350-b02d-7c8d4a6df41a",
                                                "text": "„Die App, mit der man die Räder nutzen konnte, ist so kinderfreundlich, dass sogar Minderjährige die Räder einfach nutzen können, sofern sie ein Smartphone haben.“"
                                            },
                                            {
                                                "example_id": "336d3822-235d-4d7a-bc73-8550423ba813",
                                                "sense_id": "001971a7-5a1d-3350-b02d-7c8d4a6df41a",
                                                "text": "[Mit dem Auto in den Urlaub:] „Sind Sie tagsüber unterwegs, sollten Sie regelmäßige Stopps einplanen. Das kann an einer kinderfreundlichen Autoraststätte sein oder auf der grünen Wiese. Geben Sie Ihren Kindern und sich auf jeden Fall genügend Erholungszeit mit viel Bewegung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8d60a4eb-da09-386e-bd08-6ec42bd481e7",
                                        "entry_id": "eebed7f3-fad9-3dba-ae53-af995c9a3195",
                                        "glosses": [
                                            "ein besonders positives Verhältnis zu Kindern suchend, weil man Kinder mag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01183cf6-25b2-4b3d-8dca-a22a9cf98c12",
                                                "sense_id": "8d60a4eb-da09-386e-bd08-6ec42bd481e7",
                                                "text": "Ich mochte meine kinderfreundliche Klassenlehrerin sehr – und sie mich."
                                            },
                                            {
                                                "example_id": "42943eee-4058-49ac-a95e-4abbfeac8399",
                                                "sense_id": "8d60a4eb-da09-386e-bd08-6ec42bd481e7",
                                                "text": "[Maria Peschek:] „Genau diese Engstirnigkeit und Schadenfreude hasst Peschek in ihrem Leben abseits der Bühne. Ihre soziale, menschen- und insbesondere kinderfreundliche Ader hat mittlerweile auch auf ihr Alter Ego durchgeschlagen.“"
                                            },
                                            {
                                                "example_id": "e1a1fa08-98b5-4090-a4da-0f8b74d6d308",
                                                "sense_id": "8d60a4eb-da09-386e-bd08-6ec42bd481e7",
                                                "text": "Der Scottish Terrier „ist im Allgemeinen recht mutig und unerschrocken, in der Familie aber auch sehr kinderfreundlich und sanft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
