                "senses": [
                    {
                        "sense_id": "78463713-935b-35f4-ab71-80dbdb7b1d30",
                        "entry_id": "7c384034-cffd-34ce-943d-b7bf3367d020",
                        "glosses": [
                            "Gestell aus Holz, auf dem menschliche Schädel aufgereiht sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f74f40aa-3c33-4d13-937c-3ee196487e5a",
                                "sense_id": "78463713-935b-35f4-ab71-80dbdb7b1d30",
                                "text": "„Diese Befestigungsform gilt auch für die Schädelgerüste (Tzompantli), auf denen die Azteken die Schädel Geopferter öffentlich zur Schau stellten.“"
                            },
                            {
                                "example_id": "4c1d2c6c-9cba-4a74-b37c-3369fe37df6b",
                                "sense_id": "78463713-935b-35f4-ab71-80dbdb7b1d30",
                                "text": "„Dort entdeckten die Männer einen Opferstein und die Leichen einiger gerade geopferter Menschen sowie ein Gerüst mit Totenschädeln und Knochen, ein Tzompantli.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
