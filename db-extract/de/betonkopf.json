                "senses": [
                    {
                        "sense_id": "d93189d5-ed89-3f77-ada3-f41caf671058",
                        "entry_id": "f1ccab6c-1af6-33f5-b6d3-2d785775a766",
                        "glosses": [
                            "jemand, der (fast immer) stur bei seiner Meinung bleibt"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "deed9ae1-9320-4b79-89b3-ea8bf59b3cf9",
                                "sense_id": "d93189d5-ed89-3f77-ada3-f41caf671058",
                                "text": "„»Betonkopf ist ein hartes Wort, und es trifft männliche Finnen an einer empfindlichen Stelle«, sagt mein Freund Perttu.“"
                            },
                            {
                                "example_id": "042b0072-edd8-474c-962b-02fda77a920f",
                                "sense_id": "d93189d5-ed89-3f77-ada3-f41caf671058",
                                "text": "„Ein witziges Reimwort gegen Betonköpfe, vor allem, wenn sie zugleich provokant beim Namen genannt wurden, konnte wie ein Scheinwerfer die grauen Machtgespenster ins Licht zerren.“"
                            },
                            {
                                "example_id": "05272601-e4eb-4365-8f53-9ba779a0ea38",
                                "sense_id": "d93189d5-ed89-3f77-ada3-f41caf671058",
                                "text": "„Diese Betonköpfe in Pankow werden Almuth niemals freigeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a7cb8ce1-3401-4036-9640-c0f6c8f70eb8",
                        "source_entry_id": "f1ccab6c-1af6-33f5-b6d3-2d785775a766",
                        "source_sense_id": "d93189d5-ed89-3f77-ada3-f41caf671058",
                        "source_sense_description": "abwertend: jemand, der (fast immer) stur bei seiner Meinung bleibt",
                        "target_lang_word": "tête de mule",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tête de mule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "08cfd4e4-0a62-3697-911b-0232033b62e8",
                                        "entry_id": "c7237534-c352-3e47-893d-555eed44d910",
                                        "glosses": [
                                            "Personne têtue, qui ne prête pas attention aux conseils et remarques des autres et suit obstinément son idée de départ."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1184a61f-211d-4bc5-9cea-dc3bfa715797",
                                                "sense_id": "08cfd4e4-0a62-3697-911b-0232033b62e8",
                                                "text": "Ce Jean-Claude, alors, c’est une vraie tête de mule : il trouve toujours le moyen de faire compliqué alors qu’on lui a donné une solution simple."
                                            },
                                            {
                                                "example_id": "986f34f5-33ea-49cf-ae5c-2140cb76933a",
                                                "sense_id": "08cfd4e4-0a62-3697-911b-0232033b62e8",
                                                "text": "Il faut une tête de mule pour faire entendre raison à une autre tête de mule."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tête de mule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "834e0b6c-b415-3628-a2c8-209e5da532f9",
                                        "entry_id": "ea4ac5d7-6ff3-3390-861e-01b001ed55dc",
                                        "glosses": [
                                            "Têtu, obstiné."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d096dfb-0e55-4f9e-938d-86f3c8d19211",
                                                "sense_id": "834e0b6c-b415-3628-a2c8-209e5da532f9",
                                                "text": "Tu es vraiment tête de mule, alors ! Je t’ai dit dix fois qu’il fallait tourner à gauche après le feu, et toi, tu n’écoutes pas et tu tournes à droite. Bravo !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ee163c1-fe11-45fa-bb4f-2e6656983991",
                        "source_entry_id": "f1ccab6c-1af6-33f5-b6d3-2d785775a766",
