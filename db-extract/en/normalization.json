            {
                "entry_id": "d45937fa-8abc-32a0-8deb-4d727781bb7b",
                "word": "normalization",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ea9f38ab-d889-468c-a600-8d6d9f2f769f",
