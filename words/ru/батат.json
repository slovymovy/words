                {
                    "sense_id": "0b529442-a818-3241-a08f-ab8cf7dbc067",
                    "sense_definition": "Клубень сладкого картофеля, употребляемый в пищу как овощ.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "растение_и_плод",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На ужин мы приготовили запечённый <w>батат</w> с ароматными специями и каплей оливкового масла.",
                            "target_lang_translations": {
                                "en": "For dinner, we made baked <w>sweet potato</w> with aromatic spices and a drop of olive oil."
                            }
                        },
                        {
                            "text": "В супермаркете возле дома всегда можно купить свежий <w>батат</w> по доступной цене.",
                            "target_lang_translations": {
                                "en": "At the supermarket near my house, you can always buy fresh <w>sweet potato</w> at an affordable price."
                            }
                        }
                    ],
                    "synonyms": [
                        "сладкий картофель"
                    ],
                    "common_phrases": [
                        "запечённый батат",
                        "жареный батат",
                        "пюре из батата"
                    ],
                    "target_lang_definitions": {
                        "en": "A sweet, starchy root tuber eaten as a vegetable."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sweet potato",
                                "target_lang_sense_clarification": "tuber eaten as a vegetable"
                            },
                            {
                                "target_lang_word": "batata",
                                "target_lang_sense_clarification": "sweet potato tuber"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20ea0ca6-04b7-303f-992c-619133c8d76e",
                    "sense_definition": "Вид травянистых клубнеплодных растений рода Ипомея семейства Вьюнковые.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "растение_и_плод",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В тёплых тропических странах фермеры массово выращивают <w>батат</w> на больших полях.",
                            "target_lang_translations": {
                                "en": "In warm tropical countries, farmers widely cultivate <w>sweet potato</w> on large fields."
                            }
                        },
                        {
                            "text": "Это травянистое растение образует длинные ползучие стебли, поэтому <w>батат</w> быстро разрастается по земле.",
                            "target_lang_translations": {
                                "en": "This herbaceous plant forms long creeping stems, which is why <w>sweet potato</w> quickly spreads across the ground."
                            }
                        }
                    ],
                    "synonyms": [
                        "сладкий картофель"
                    ],
                    "common_phrases": [
                        "выращивать батат"
                    ],
                    "target_lang_definitions": {
                        "en": "A species of tuberous creeping vine in the morning glory family (Ipomoea batatas)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sweet potato",
                                "target_lang_sense_clarification": "the plant species (Ipomoea batatas)"
                            },
                            {
                                "target_lang_word": "sweet potato vine",
                                "target_lang_sense_clarification": "the botanical plant"
                            }
                        ]
                    }
                }
            ]
        },
