                            {
                                "target_word": "aanbiddelijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c3bd8ec7-2a67-3286-b535-6922687297ff",
                                        "entry_id": "5642195e-fcab-3978-868d-31ffe27030e5",
                                        "glosses": [
                                            "waard om aanbeden te worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16424d65-3826-4fef-a964-0699d897575b",
                                                "sense_id": "c3bd8ec7-2a67-3286-b535-6922687297ff",
                                                "text": "De mooie, jonge, aanbiddelijke zangeres had vele bewonderaars."
                                            },
                                            {
                                                "example_id": "d850d8d7-fa8d-4199-bcb0-738ff98cc250",
                                                "sense_id": "c3bd8ec7-2a67-3286-b535-6922687297ff",
                                                "text": "Ze had een uitweg voor me gevonden en nu ik het aanbiddelijkste kind ter wereld had kon ik mijn verdriet van me afzetten en gelukkig zijn."
                                            },
                                            {
                                                "example_id": "9ea9a38e-ea81-4e6b-be58-19b92e3f9e23",
                                                "sense_id": "c3bd8ec7-2a67-3286-b535-6922687297ff",
                                                "text": "Hij streelde mijn haar en vertelde me dat ik mooi was, aanbiddelijk, en dat hij me altijd zou blijven liefhebben."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
