                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gaston",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "03c3d36d-88d8-3446-9fc0-d92e75eda16a",
                                        "entry_id": "8bde6b86-be3a-3437-aab5-21101ea56170",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80a1e955-cb6a-45f8-84e5-57c987285810",
                                                "sense_id": "03c3d36d-88d8-3446-9fc0-d92e75eda16a",
                                                "text": "Gaston se leva, se mit au piano et commença cette merveilleuse mélodie de Weber, dont la musique était ouverte sur le pupitre."
                                            },
                                            {
                                                "example_id": "dc06d746-3e45-4cd4-bdf8-7b3cf16b1779",
                                                "sense_id": "03c3d36d-88d8-3446-9fc0-d92e75eda16a",
                                                "text": "Gaston y a l'téléfon qui son\n Et y a jamais person qui y répond\n Gaston y a l'téléfon qui son\n Et y a jamais person qui y répond."
                                            },
                                            {
                                                "example_id": "cb17f8d0-6065-4e50-a16a-adacc6d00e10",
                                                "sense_id": "03c3d36d-88d8-3446-9fc0-d92e75eda16a",
                                                "text": "Sa tête est partagée en deux. Il y a une moitié qui ne cesse de répéter : « Gaston Dubois, tu es stupide. Tu as soixante-dix ans et tu parles à une charrette exactement comme un gosse de quatre ans parlerait à son train mécanique. »"
                                            },
                                            {
                                                "example_id": "e9536779-abc6-4b00-9859-6b518cc6a3a8",
                                                "sense_id": "03c3d36d-88d8-3446-9fc0-d92e75eda16a",
                                                "text": "À la première épicerie venue nous achetâmes sur les conseils de Gaston une énorme boîte ovale de pilchards. Personne à part lui ne savait ce que c'était, donc il n'y eut pas d'objection."
                                            },
                                            {
                                                "example_id": "238dc36e-bcdd-4c32-97ad-7284e6855307",
                                                "sense_id": "03c3d36d-88d8-3446-9fc0-d92e75eda16a",
                                                "text": "À partir de l’extrait d’un livre de Gaston Deschamps, le photographe Clément Chapillon joue avec le lecteur grâce à des feuilles transparentes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
