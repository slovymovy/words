                                "target_senses": [
                                    {
                                        "sense_id": "1ed84772-59fe-3206-936b-815bc01fef4b",
                                        "entry_id": "6c7246f8-4ae6-3ec9-b020-fd75e586c661",
                                        "glosses": [
                                            "keinen Körper habend, ohne Körper"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c65b0ba-c7f0-49ba-bd8b-c334175e4100",
                                                "sense_id": "1ed84772-59fe-3206-936b-815bc01fef4b",
                                                "text": "„Es scheint sogar möglich, dass die Besitzer jener zahllosen Knochen, als sie in den entfernten Abgründen vergessener Zeiten noch von ihrem Kleid aus sterblichem Fleisch umhüllt waren, durch den vierdimensionalen Eingang, den ich zufällig geöffnet hatte, in jene Totenstadt gelangt waren, um sich dort selbst zu opfern oder getötet zu werden, nachdem sie aus freiem Willen oder gezwungenermaßen gekommen waren, um zu sterben und mit ihrem Fleisch oder ihrem körperlosen Sein eine unbekannte körperliche oder körperlose Wesenheit zu nähren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fe1b9f37-2dbb-3bc6-9601-2de151afbc47",
                                        "entry_id": "6c7246f8-4ae6-3ec9-b020-fd75e586c661",
                                        "glosses": [
                                            "ohne/nur mit minimalem physischen Kontakt zwischen den Sportlern (gemäß Reglement)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b09e5b56-154b-40c4-b029-48a53b637ba5",
                                                "sense_id": "fe1b9f37-2dbb-3bc6-9601-2de151afbc47",
                                                "text": "„Im Unterschied zu anderen Ballsportarten ist Hockey grundsätzlich ein körperloses Spiel, d. h. der Gegenspieler darf nicht abgedrängt oder aktiv abgeblockt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
