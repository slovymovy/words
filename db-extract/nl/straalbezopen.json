                                                "sense_id": "f3b0401b-4feb-30c1-8677-6d34536a9ee4",
                                                "text": "Nach seinem Kneipenbesuch kam er sturzbetrunken zuhause an."
                                            },
                                            {
                                                "example_id": "bdaa51ac-5968-4e5c-b6d8-e2139ae46986",
                                                "sense_id": "f3b0401b-4feb-30c1-8677-6d34536a9ee4",
                                                "text": "„Der Major, sturzbetrunken, hatte es sich in einer Wohnung bequem gemacht, um seinen Rausch auszuschlafen.“"
                                            },
                                            {
                                                "example_id": "87d9b681-91a4-4376-82dd-9757bbf3e06e",
                                                "sense_id": "f3b0401b-4feb-30c1-8677-6d34536a9ee4",
                                                "text": "„Lars-Erik und Robban waren sturzbetrunken.“"
                                            }
                                        ],
