                        "examples": [
                            {
                                "example_id": "1333a2e9-f412-492a-a268-1ac5eb91f123",
                                "sense_id": "d29226bd-752d-37e6-aeab-dae990b1673b",
                                "text": "\"One cluttery night in November, thirty of our Ashbury chaps thay started down to Longcott, and dug 'un up, and brought 'un cler away on handspikes, all the waay to the Crown'd Inn at Ashbury, and 'tis quite vour mil'd.\""
                            },
                            {
                                "example_id": "46ce573f-bd15-4bed-88e7-e0df9c5bb51f",
                                "sense_id": "d29226bd-752d-37e6-aeab-dae990b1673b",
                                "text": "\"'tis cluttery weather, an' no mistake. Fight my way up your path I did, though I baint so easy to upset, neither.\""
                            },
                            {
                                "example_id": "e7b4e16b-5d4e-460b-a8d5-b09aba20cdec",
                                "sense_id": "d29226bd-752d-37e6-aeab-dae990b1673b",
                                "text": "... days were dark and rainy, not, perhaps, days of a steady, dull downpour, but wild and gusty with bursts of rain that make puddles everywhere- \"cluttery weather\" I have heard my friend the gamekeeper call this when it comes in spring."
                            },
                            {
                                "example_id": "64810b92-e393-43c4-9a8e-6a4b0afb935d",
                                "sense_id": "d29226bd-752d-37e6-aeab-dae990b1673b",
                                "text": "[...] wind changed too, with the schooner being assailed by gusts and squalls that kept turning her sails aback, with thunderous detonations of canvas. Mr Crowle was on the first watch of the night, and Zachary knew that the cluttery weather would serve to keep him occupied on deck."
                            }
                        ]
