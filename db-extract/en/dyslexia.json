                                        "entry_id": "74474328-0f4c-3c34-8789-0fe3289358f3",
                                        "glosses": [
                                            "Entwicklungsverzögerung im Lesen oder Schreiben, massive und lang andauernde Störung des Erwerbs der Schriftsprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d894529-67cc-4c50-8b65-7b0b96acdf04",
                                                "sense_id": "25e4d720-f4e5-35ca-8c14-519769c46e4b",
                                                "text": "Dass Markus an Legasthenie leidet, wurde erst in der dritten Klasse entdeckt."
                                            },
                                            {
                                                "example_id": "889ba2e0-746f-4c8f-94b8-a99e1ce426b9",
                                                "sense_id": "25e4d720-f4e5-35ca-8c14-519769c46e4b",
                                                "text": "Legasthenie ist eine der Dyskalkulie vergleichbare Lernstörung."
                                            },
                                            {
                                                "example_id": "40521ffa-4e51-499e-a62a-9516ffe51649",
                                                "sense_id": "25e4d720-f4e5-35ca-8c14-519769c46e4b",
                                                "text": "„Die Legasthenie hat an sich eine gute Prognose, d.h., sie hat die Tendenz, sich zu bessern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
