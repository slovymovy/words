                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dance floor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21cd62a7-c6af-3976-80bf-9e49a61bff18",
                                        "entry_id": "49285fa7-ffae-37ea-bb58-a357daa8f507",
                                        "glosses": [
                                            "A large floor, usually made of hardwood, used primarily for dancing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "018de7b9-95ce-4d74-865a-e1ed33d9679c",
                                                "sense_id": "21cd62a7-c6af-3976-80bf-9e49a61bff18",
                                                "text": "I bet that you look good on the dancefloor / I don't know if you're looking for romance or / I don't know what you're looking for"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41717890-70c8-4f4d-a24c-0db316d8bd7e",
                        "source_entry_id": "5e4c983e-457a-3112-a5c8-92cc0b8a5a24",
                        "source_sense_id": "91306e7c-34e6-34fb-b087-f0d7f5fdf3c6",
                        "target_lang_word": "Tanzfläche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tanzfläche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e922e0fe-5892-3985-999f-ae064222abaf",
                                        "entry_id": "04805296-b602-3c8f-8a69-360efc94cde6",
                                        "glosses": [
                                            "derjenige Bereich einer Lokalität, in dem getanzt werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a602599b-21a0-49eb-8f78-c8c9d5ea9aee",
                                                "sense_id": "e922e0fe-5892-3985-999f-ae064222abaf",
                                                "text": "„Alle stürmten auf die Tanzfläche und bewegten sich ausgelassen zu bekannten Schlagern und sizilianischen Volksliedern.“"
                                            },
                                            {
                                                "example_id": "3469c40f-b961-4727-b08d-b636198fcbeb",
                                                "sense_id": "e922e0fe-5892-3985-999f-ae064222abaf",
                                                "text": "„Zum späten Abend füllte sich das Restaurant, wir waren die Ersten, die auf die Tanzfläche gingen.“"
                                            },
                                            {
                                                "example_id": "b3087436-c8a5-4afc-864c-2bf17072ad29",
                                                "sense_id": "e922e0fe-5892-3985-999f-ae064222abaf",
                                                "text": "„Ihr Mann schlurfte mit kleinen Schritten hinter ihr her auf die Tanzfläche.“"
                                            },
                                            {
                                                "example_id": "5aacddd3-ad16-48b2-99db-2c2d891cecdb",
                                                "sense_id": "e922e0fe-5892-3985-999f-ae064222abaf",
                                                "text": "„Um eine kleine Tanzfläche herum waren etwa fünfzehn Tische gruppiert, an denen aber nur wenige Gäste saßen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
