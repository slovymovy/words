                "senses": [
                    {
                        "sense_id": "3c206831-c589-3133-94ee-0bcaf41c4ccd",
                        "entry_id": "e768a7e0-2185-3764-8a97-dd4dd3525b33",
                        "glosses": [
                            "hoes waarin een zak past met zacht materiaal, waarop je prettiger zit of waarop je je hoofd kunt leggen als je gaat liggen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26d61ae1-b483-4bcb-8bd7-ad8482de6547",
                                "sense_id": "3c206831-c589-3133-94ee-0bcaf41c4ccd",
                                "text": "De Dulle-van-den-Ast ligt in het diepe bed onder een bijna zwarte sargie. Geen lakens, maar een wit fluwijn. Daarop ligt een pak woest haar, gelijk vlas, en een aangezicht merkt men er niet in, behalve de sterke buizerdsneus, die bovenuitsteekt als verkleurde kalk."
                            },
                            {
                                "example_id": "1bdfba8a-464c-4e04-9509-645d5d1230fa",
                                "sense_id": "3c206831-c589-3133-94ee-0bcaf41c4ccd",
                                "text": "Hij zonk uitgeput in 't fluwijn."
                            },
                            {
                                "example_id": "c22df4a8-baaa-4610-830b-835f61808276",
                                "sense_id": "3c206831-c589-3133-94ee-0bcaf41c4ccd",
                                "text": "Moeder heeft de fluwijn gewassen!"
                            }
                        ]
                    }
