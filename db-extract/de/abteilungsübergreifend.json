                        "glosses": [
                            "mehr als eine Abteilung betreffend; mehrere Abteilungen umfassend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86153be1-7345-472a-b0c2-6ad905cebc65",
                                "sense_id": "57d182c3-f875-3a62-8b0d-4111fbe649fa",
                                "text": "„Schüler aus allen Abteilungen und Jahrgängen lernen und forschen gemeinsam und abteilungsübergreifend.“"
                            },
                            {
                                "example_id": "d4d6f017-7b3d-4304-9d55-b6ca07f18cd6",
                                "sense_id": "57d182c3-f875-3a62-8b0d-4111fbe649fa",
                                "text": "„Überweisungen müssten künftig abteilungsübergreifend beaufsichtigt werden.“"
                            },
                            {
