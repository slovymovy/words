                ],
                "senses": [
                    {
                        "sense_id": "89aa9ad0-bd35-33ce-85d3-337115eebff7",
                        "entry_id": "7a68f860-1b4a-3e6a-919d-ad04c718e421",
                        "glosses": [
                            "Nebel ähnelnd, an Nebel erinnernd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "911ab1a0-e8c1-4986-9a1c-c0058881533b",
                                "sense_id": "89aa9ad0-bd35-33ce-85d3-337115eebff7",
                                "text": "„Es war sehr eigenartig, doch als der kleine Junge seine Bitte vorbrachte, schienen sich schattenhafte, nebelartige Gestalten fremdartiger Wesen über ihnen zu formen, Zwitterwesen, gekrönt mit hornumfassten Scheiben.“"
                            },
                            {
                                "example_id": "0b16f007-37ac-4407-84f0-2f6b5d5c851b",
                                "sense_id": "89aa9ad0-bd35-33ce-85d3-337115eebff7",
                                "text": "„Und als ich im trüben Moor einen enormen, nebelartigen Schatten sah, der von einem Hügel zum andern huschte, schloss ich die Augen und warf mich bäuchlings auf den Boden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
