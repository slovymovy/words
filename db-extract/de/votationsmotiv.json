                "senses": [
                    {
                        "sense_id": "40ef6608-7ab9-30b1-b1c4-438723d86383",
                        "entry_id": "895fa2f2-5bfb-373c-8b7d-994f9c7d39b6",
                        "glosses": [
                            "der Anreiz oder Grund für ein Gelübde und einer entscheidenden Handlung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd679166-e75e-4b4f-9790-2d70129a4372",
                                "sense_id": "40ef6608-7ab9-30b1-b1c4-438723d86383",
                                "text": "„Die Votivtafel zeichnet sich, trotz stark variierender Ausdruckskraft und formalen Elementen, durch das relativ strenge und einheitliche Schema der Darstellung aus. Abgebildet sind der Votant, die von ihm angerufene Himmelsmacht, das Votationsmotiv und eine Inschrift.“"
                            },
                            {
                                "example_id": "97627204-1aab-4155-8fc0-7fb8dcce8bee",
                                "sense_id": "40ef6608-7ab9-30b1-b1c4-438723d86383",
                                "text": "„Das vollständige Votivbild umfasst den Bittflehenden (den Votanten oder das Votationssubjekt), die angerufene Person (das Kultobjekt), den äusseren Anlass zum Bittruf oder zur Dankbezeugung (den Votationsgrund oder das Votationsmotiv) und eine Inschrift.“"
                            },
                            {
                                "example_id": "19ddf44b-9652-4798-976b-31e97ac3af37",
                                "sense_id": "40ef6608-7ab9-30b1-b1c4-438723d86383",
                                "text": "„Votivtafeln folgen einer einheitlichen Grundstruktur, die aus den dargestellten Elemente des Votationssubjektes (einer oder mehrere Votanten), dem Kultobjekt (einer oder mehrere Patronen), dem Votationsmotiv sowie der Inschrift besteht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
