                    {
                        "sense_id": "3005d134-d8ed-3e1a-888f-70f6eadbc2f4",
                        "entry_id": "9c688a03-bd74-3883-b480-f3ce9e00422d",
                        "glosses": [
                            "Transformator mit nur einer Spule, der zur Entnahme der Sekundärspannung eine Anzapfung hat"
                        ],
                        "tags": [
                            "speziell Elektrotechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "8ed0bd2c-337a-4cb8-b9d7-727de54d165f",
                                "sense_id": "3005d134-d8ed-3e1a-888f-70f6eadbc2f4",
                                "text": "„Eine derartige Anordnung bezeichnet man als Spar- oder Autotransformator (wegen seiner Ähnlichkeit mit der Zündspule eines Kfz).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
