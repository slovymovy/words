                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Begeisterung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c2b8b1c1-be1f-3b4f-ad76-27bc241a26a0",
                                        "entry_id": "4a1bbdab-1db3-3be4-9d28-316cb805acb0",
                                        "glosses": [
                                            "überschwängliche Freude, Erregung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "251375aa-e2fc-4ecf-a22f-0a24619686d8",
                                                "sense_id": "c2b8b1c1-be1f-3b4f-ad76-27bc241a26a0",
                                                "text": "Ich erwarte den ersten September, an dem ich meine Tätigkeit mit Begeisterung wieder aufnehmen werde."
                                            },
                                            {
                                                "example_id": "7e301391-0b44-4b57-b74a-391a5eb0e006",
                                                "sense_id": "c2b8b1c1-be1f-3b4f-ad76-27bc241a26a0",
                                                "text": "„Aus Joes unverhohlener Begeisterung ging deutlich hervor, dass es eine Weile her war, seit er saubere Socken getragen hatte.“"
                                            },
                                            {
                                                "example_id": "b2c75552-5c94-4d8b-8cdb-334c8a44ca5d",
                                                "sense_id": "c2b8b1c1-be1f-3b4f-ad76-27bc241a26a0",
                                                "text": "„Ich wollte ihm nicht zeigen, dass mit dem schwindenden Nachmittag auch meine Begeisterung abnahm.“"
                                            },
                                            {
                                                "example_id": "0d6907b7-9543-43ec-bd25-deac4b3ae109",
                                                "sense_id": "c2b8b1c1-be1f-3b4f-ad76-27bc241a26a0",
                                                "text": "„Diese Woge der Begeisterung machte aber auch die zunehmende Spaltung der deutschen Gesellschaft offensichtlich.“"
                                            },
                                            {
                                                "example_id": "ad9b38ee-5b4c-46eb-89a8-a06b1cb2cb03",
                                                "sense_id": "c2b8b1c1-be1f-3b4f-ad76-27bc241a26a0",
                                                "text": "„Und nicht nur mich betrifft diese Begeisterung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
