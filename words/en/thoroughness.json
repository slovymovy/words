{
    "word_family": [
        "thorough",
        "thoroughly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7211c7de-72ea-32d8-8f63-e27aa8f9e71c",
                    "sense_definition": "The quality of being extremely attentive to detail and leaving nothing out.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "detail_and_completeness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager praised her <w>thoroughness</w> in preparing the financial report.",
                            "target_lang_translations": {
                                "es": "El gerente elogió su <w>minuciosidad</w> al preparar el informe financiero."
                            }
                        },
                        {
                            "text": "Such jobs could be done with a <w>thoroughness</w> impossible to human beings.",
                            "target_lang_translations": {
                                "es": "Tales trabajos podrían realizarse con una <w>meticulosidad</w> imposible para los seres humanos."
                            }
                        }
                    ],
                    "synonyms": [
                        "meticulousness",
                        "rigorousness",
                        "carefulness"
                    ],
                    "antonyms": [
                        "carelessness",
                        "negligence",
                        "superficiality"
                    ],
                    "common_phrases": [
                        "admirable thoroughness",
                        "characteristic thoroughness",
                        "painstaking thoroughness"
                    ],
                    "target_lang_definitions": {
                        "es": "Cualidad de ser sumamente atento a los detalles y no omitir nada."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "minuciosidad",
                                "target_lang_sense_clarification": "gran atención al detalle y precisión"
                            },
                            {
                                "target_lang_word": "meticulosidad",
                                "target_lang_sense_clarification": "cuidado extremo y esmero al hacer algo"
                            },
                            {
                                "target_lang_word": "detenimiento",
                                "target_lang_sense_clarification": "calma y esmero cuidadoso en el trabajo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ea3ff6b-22df-34d7-a684-31b20dab9500",
                    "sense_definition": "The state or property of being completely exhaustive or fully realized.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "detail_and_completeness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>thoroughness</w> of the police investigation left no stone unturned.",
                            "target_lang_translations": {
                                "es": "La <w>exhaustividad</w> de la investigación policial no dejó ningún cabo suelto."
                            }
                        },
                        {
                            "text": "We were all impressed by the sheer <w>thoroughness</w> of the scientific study.",
                            "target_lang_translations": {
                                "es": "Todos quedamos impresionados por la absoluta <w>rigurosidad</w> del estudio científico."
                            }
                        }
                    ],
                    "synonyms": [
                        "comprehensiveness",
                        "completeness",
                        "exhaustiveness"
                    ],
                    "antonyms": [
                        "incompleteness"
                    ],
                    "common_phrases": [
                        "sheer thoroughness",
                        "remarkable thoroughness"
                    ],
                    "target_lang_definitions": {
                        "es": "Carácter o propiedad de ser completamente exhaustivo, profundo o integral."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "exhaustividad",
                                "target_lang_sense_clarification": "cualidad de abarcar todo por completo"
                            },
                            {
                                "target_lang_word": "profundidad",
                                "target_lang_sense_clarification": "alcance riguroso y detallado de un análisis"
                            },
                            {
                                "target_lang_word": "rigurosidad",
                                "target_lang_sense_clarification": "rigor y exactitud plena"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}