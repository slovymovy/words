                    {
                        "sense_id": "13d4155e-cde1-3481-9bb9-12c2ccf9fab6",
                        "entry_id": "42c41225-4027-350d-8ed5-6afe2c920847",
                        "glosses": [
                            "kleiner Gegenstand aus Holz zum Verschließen einer Öffnung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cc07eac-f4c8-47db-8ea6-0e3492687d40",
                                "sense_id": "13d4155e-cde1-3481-9bb9-12c2ccf9fab6",
                                "text": "„Er holte einen geschnitzten Holzpfropfen hervor, geformt wie eine Knolle mit einem schmalen Stiel, nach dem sie sich wieder verbreiterte.“"
                            },
                            {
                                "example_id": "ae757ca1-5d33-48fd-a470-118af2f5f75e",
                                "sense_id": "13d4155e-cde1-3481-9bb9-12c2ccf9fab6",
                                "text": "„Jemand hatte den Wachsverschluss entfernt und ihn durch einen einfachen Holzpfropfen ersetzt.“"
                            },
                            {
                                "example_id": "1bc8e715-5c11-43a6-9c4d-966cf3a188ed",
                                "sense_id": "13d4155e-cde1-3481-9bb9-12c2ccf9fab6",
                                "text": "„Am unteren Ende sind die kurzen Holzrohre mit einem Holzpfropfen verschlossen und zuletzt habe ich die Rohre nur noch zusammengebunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
