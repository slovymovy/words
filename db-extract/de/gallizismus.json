                    {
                        "translation_id": "2337559b-ada6-48f5-9d8a-8cdf00948065",
                        "source_entry_id": "189a829b-347f-3f1b-b340-f3cdbfa62f23",
                        "source_sense_id": "3645f5c8-d2ab-34d0-bb05-20d12e91ca71",
