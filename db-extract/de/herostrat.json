                ],
                "senses": [
                    {
                        "sense_id": "8353ad69-2ef0-3e53-8fd9-9718f3b88184",
                        "entry_id": "62e2d6e2-2842-36ac-b07f-1d6253e123c6",
                        "glosses": [
                            "jemand, der aus Ruhmsucht oder Ehrgeiz Straftaten begeht"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "a3813b27-2c5e-41f2-98c7-2605ce7101ff",
                                "sense_id": "8353ad69-2ef0-3e53-8fd9-9718f3b88184",
                                "text": "„In der Zeitung hatte er gelesen, dass Lennon Millionär war, aber nicht alles den Armen gab. Chapman, ein Verrückter, ein Herostrat, konnte das nicht ertragen.“"
                            },
                            {
                                "example_id": "909130b1-b879-44e3-b5e4-b84948912353",
                                "sense_id": "8353ad69-2ef0-3e53-8fd9-9718f3b88184",
                                "text": "„Ich war und bin kein Herostrat, der durch die Zerstörung der Union in die Geschichte eingehen will.“"
                            },
                            {
                                "example_id": "6856c084-989f-440f-bff0-b48223f77dc0",
                                "sense_id": "8353ad69-2ef0-3e53-8fd9-9718f3b88184",
                                "text": "„Nachdem zwei antisemitische Herostraten namens Strunk und Schönen am Heiligabend die Kölner Synagoge mit Hakenkreuz und antijüdischem Spruchgut beschmiert hatten, gab Nordrhein-Westfalens Innenminister Dufhues der Büberei mit mehrfachen Auftritten im Fernsehen üppige Publizität.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
