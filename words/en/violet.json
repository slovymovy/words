{
    "word_family": [
        "ultraviolet"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cc56d64f-7cc8-3708-8c63-e36167ee74c9",
                    "sense_definition": "A small plant of the genus Viola, typically having purple, blue, or white flowers with a sweet scent.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "plants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She planted a beautiful <w>violet</w> in the flower pot near the window.",
                            "target_lang_translations": {
                                "ru": "Она посадила красивую <w>фиалку</w> в цветочный горшок у окна.",
                                "zh": "她在窗边的花盆里种了一株美丽的<w>紫罗兰</w>。"
                            }
                        },
                        {
                            "text": "The sweet smell of the <w>violet</w> reminded him of spring.",
                            "target_lang_translations": {
                                "ru": "Сладкий запах <w>фиалки</w> напомнил ему о весне.",
                                "zh": "<w>紫罗兰</w>的甜美香气让他想起了春天。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "African violet",
                        "sweet violet",
                        "shrinking violet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое растение рода Viola, обычно с фиолетовыми, синими или белыми цветами и сладким ароматом.",
                        "zh": "一种堇菜属的小型植物，通常开紫色、蓝色或白色的花，有甜美的香气。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фиалка",
                                "target_lang_sense_clarification": "растение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "堇菜",
                                "target_lang_sense_clarification": "植物学名称"
                            },
                            {
                                "target_lang_word": "紫罗兰",
                                "target_lang_sense_clarification": "常用名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0310b327-3799-35f8-9761-dd7537bfd98e",
                    "sense_definition": "A bluish-purple color seen at the end of the visible spectrum.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "colors",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist used a deep <w>violet</w> to paint the shadows of the mountains.",
                            "target_lang_translations": {
                                "ru": "Художник использовал насыщенный <w>фиолетовый цвет</w>, чтобы нарисовать тени гор.",
                                "zh": "艺术家用深<w>紫色</w>来描绘山峦的阴影。"
                            }
                        },
                        {
                            "text": "You can see <w>violet</w> at the very bottom of the rainbow.",
                            "target_lang_translations": {
                                "ru": "Вы можете увидеть <w>фиолетовый цвет</w> в самом низу радуги.",
                                "zh": "你可以在彩虹的最底部看到<w>紫色</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "purple"
                    ],
                    "common_phrases": [
                        "violet light",
                        "dark violet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сине-фиолетовый цвет, видимый на конце светового спектра.",
                        "zh": "可见光谱末端的蓝紫色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фиолетовый цвет",
                                "target_lang_sense_clarification": "существительное"
                            },
                            {
                                "target_lang_word": "фиолетовый",
                                "target_lang_sense_clarification": "цвет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "紫色",
                                "target_lang_sense_clarification": "颜色名词"
                            },
                            {
                                "target_lang_word": "紫罗兰色",
                                "target_lang_sense_clarification": "特定色调"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4a44ffc-88b8-3658-a3a9-06c08b4bc2d0",
                    "sense_definition": "A person regarded as shy, delicate, or modest.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is no shrinking <w>violet</w> when it comes to expressing her opinions.",
                            "target_lang_translations": {
                                "ru": "Она отнюдь не <w>скромница</w>, когда дело доходит до выражения своего мнения.",
                                "zh": "在表达观点时，她可一点也不<w>害羞</w>。"
                            }
                        },
                        {
                            "text": "Although he looks like a tough guy, he is actually a gentle <w>violet</w> at heart.",
                            "target_lang_translations": {
                                "ru": "Хотя он выглядит как крутой парень, в душе он нежный <w>тихоня</w>.",
                                "zh": "虽然他看起来像个硬汉，但内心其实是个<w>内向</w>温柔的人。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "shrinking violet"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in the phrase 'shrinking violet'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, которого считают застенчивым, ранимым или скромным.",
                        "zh": "指性格害羞、内向或谦逊的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скромница",
                                "target_lang_sense_clarification": "о застенчивой девушке/женщине"
                            },
                            {
                                "target_lang_word": "тихоня",
                                "target_lang_sense_clarification": "о тихом, скромном человеке"
                            },
                            {
                                "target_lang_word": "недотрога",
                                "target_lang_sense_clarification": "разг. обидчивый или слишком скромный человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "害羞的人",
                                "target_lang_sense_clarification": "描述性格"
                            },
                            {
                                "target_lang_word": "内向者",
                                "target_lang_sense_clarification": "描述性格"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6ff1ecb7-f8a7-3340-8945-cb0d31c637fe",
                    "sense_definition": "Having a bluish-purple color.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "colors",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a lovely <w>violet</w> dress to the evening party.",
                            "target_lang_translations": {
                                "ru": "Она надела прелестное <w>фиолетовое</w> платье на вечеринку.",
                                "zh": "她穿了一件可爱的<w>紫色</w>连衣裙去参加晚会。"
                            }
                        },
                        {
                            "text": "The sky turned a soft <w>violet</w> color just after the sun went down.",
                            "target_lang_translations": {
                                "ru": "Небо приобрело мягкий <w>фиолетовый</w> оттенок сразу после захода солнца.",
                                "zh": "太阳落山后，天空变成了柔和的<w>紫色</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "purple"
                    ],
                    "common_phrases": [
                        "violet eyes",
                        "violet sky"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий сине-фиолетовый цвет.",
                        "zh": "具有蓝紫色的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фиолетовый",
                                "target_lang_sense_clarification": "прилагательное"
                            },
                            {
                                "target_lang_word": "лиловый",
                                "target_lang_sense_clarification": "светло-фиолетовый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "紫色的",
                                "target_lang_sense_clarification": "形容词"
                            },
                            {
                                "target_lang_word": "紫罗兰色的",
                                "target_lang_sense_clarification": "形容词"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "1765c091-5708-3baf-a5b9-8af2cfb2ec18",
                    "sense_definition": "A female given name.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My aunt <w>Violet</w> always sends me a card on my birthday.",
                            "target_lang_translations": {
                                "ru": "Моя тетя <w>Виолетта</w> всегда присылает мне открытку на день рождения.",
                                "zh": "我的<w>维奥莱特</w>阿姨总会在我生日时寄给我贺卡。"
                            }
                        },
                        {
                            "text": "They decided to name their new baby daughter <w>Violet</w>.",
                            "target_lang_translations": {
                                "ru": "Они решили назвать свою новорожденную дочь <w>Виолетта</w>.",
                                "zh": "他们决定给刚出生的女儿取名为<w>维奥莱特</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское личное имя.",
                        "zh": "女性名字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Виолетта",
                                "target_lang_sense_clarification": "аналог имени"
                            },
                            {
                                "target_lang_word": "Вайолет",
                                "target_lang_sense_clarification": "транслитерация"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "维奥莱特",
                                "target_lang_sense_clarification": "音译名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "213efa7e-7e6a-3f2a-9bb1-ec5954a4b80b",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Violet</w> has been working at the company for twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Вайолет</w> работает в компании уже двадцать лет.",
                                "zh": "<w>维奥莱特</w>先生在这家公司已经工作了二十年。"
                            }
                        },
                        {
                            "text": "We looked up the <w>Violet</w> family in the local records.",
                            "target_lang_translations": {
                                "ru": "Мы искали семью <w>Вайолет</w> в местных архивах.",
                                "zh": "我们在当地记录中查找了<w>维奥莱特</w>家族的信息。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Вайолет",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "维奥莱特",
                                "target_lang_sense_clarification": "音译姓氏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53486093-be25-3a6a-b547-c9ec784dff5c",
                    "sense_definition": "A name for various places in the United States and Canada.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They drove through the small community of <w>Violet</w> on their road trip.",
                            "target_lang_translations": {
                                "ru": "Во время поездки они проехали через небольшое поселение <w>Вайолет</w>.",
                                "zh": "他们在公路旅行中开车穿过了<w>维奥莱特</w>这个小社区。"
                            }
                        },
                        {
                            "text": "The town of <w>Violet</w> is located near the river.",
                            "target_lang_translations": {
                                "ru": "Город <w>Вайолет</w> расположен недалеко от реки.",
                                "zh": "<w>维奥莱特</w>镇坐落在河边。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Название различных населенных пунктов в США и Канаде.",
                        "zh": "美国和加拿大等地名。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Вайолет",
                                "target_lang_sense_clarification": "географическое название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "维奥莱特",
                                "target_lang_sense_clarification": "音译地名"
                            }
                        ]
