                "senses": [
                    {
                        "sense_id": "5fb9916e-8807-359b-8c32-a6675c3a5f30",
                        "entry_id": "4541945f-03b6-346f-b844-ae66f733931a",
                        "glosses": [
                            "To live or come before; precede"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4e663d9-cd69-465f-b126-490aa0cbf687",
                                "sense_id": "5fb9916e-8807-359b-8c32-a6675c3a5f30",
                                "text": "[…] Or if I seek the visitation, then He fills me, and my foul is carried on, And then do I forelive the race of men, So that the things that will be, are to me […]"
                            },
                            {
                                "example_id": "603a956b-c2a7-4419-89c3-2c21dfeabf4b",
                                "sense_id": "5fb9916e-8807-359b-8c32-a6675c3a5f30",
                                "text": "Considering in how small a room do lie, And yet lie safe (as fresh as if alive), All those great worthies of antiquity, Which long forelived thee, and shall long survive; Who stronger tombs found for eternity, […]"
                            },
                            {
                                "example_id": "7b66e9a4-692b-46f5-a125-df80708d95c8",
                                "sense_id": "5fb9916e-8807-359b-8c32-a6675c3a5f30",
                                "text": "When the wind is moaning a dreary dirge, And the curtain of night is blackly drawn; When the swirling breakers higher surge, And never a star forelives the dawn,— 'Tis then that the Lighthouse Man keeps watch, And stands by his lamps like a hero true […]"
                            },
                            {
                                "example_id": "58bad0d4-e501-450f-ad79-0858409626c3",
                                "sense_id": "5fb9916e-8807-359b-8c32-a6675c3a5f30",
                                "text": "But where, in those scant days we task'd ourselves,— As we were wont in that anterior time,— To forelive future being to excess, To scale youth's daring, sublimated heights, […]"
                            },
                            {
                                "example_id": "92fb4fc8-4898-4496-975b-0f5bd49615b1",
                                "sense_id": "5fb9916e-8807-359b-8c32-a6675c3a5f30",
                                "text": "Patterson, the guiding spirit of the many fruitless expeditions which were launched with such high hopes, forelived his time."
                            }
                        ]
                    }
                ],
