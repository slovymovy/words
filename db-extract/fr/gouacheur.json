                        ],
                        "examples": [
                            {
                                "example_id": "e8da11c4-8ff8-4e59-ae11-6c95e4cd05fb",
                                "sense_id": "90675558-4960-333b-966b-f960e9cce2aa",
                                "text": "Moins connu comme pastelliste que comme gouacheur, Claude Hoin doit pourtant occuper un très honorable rang parmi les virtuoses du pastel. Son dessin est ferme, son coloris animé et son exécution facile."
                            }
