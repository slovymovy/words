                                    {
                                        "sense_id": "c7edd9a5-3a8b-3917-8470-ff6b4777bece",
                                        "entry_id": "8b92b876-651a-3fc7-9c96-2fa1aa16f995",
                                        "glosses": [
                                            "The capacity of people to maintain belief in an institution or a goal, or even in oneself and others."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "221ce407-92f9-4645-a3bf-48279f7a59e8",
                                                "sense_id": "c7edd9a5-3a8b-3917-8470-ff6b4777bece",
                                                "text": "After the layoffs, morale was at an all time low; the staff were so dispirited nothing was getting done."
                                            },
                                            {
                                                "example_id": "43bbaac6-e3da-4f6f-bea5-551bf9366cf6",
                                                "sense_id": "c7edd9a5-3a8b-3917-8470-ff6b4777bece",
                                                "text": "Morale is an important quality in soldiers. With good morale they'll charge into a hail of bullets; without it they won't even cross a street."
                                            },
                                            {
                                                "example_id": "96019fa6-276c-479a-83d0-adc1495ed5aa",
                                                "sense_id": "c7edd9a5-3a8b-3917-8470-ff6b4777bece",
                                                "text": "A morale-boosting exercise"
                                            },
                                            {
                                                "example_id": "00fa3614-1b1f-4e59-80ba-cc9f39eaade6",
                                                "sense_id": "c7edd9a5-3a8b-3917-8470-ff6b4777bece",
                                                "text": "Proponents of the race — notably Mayor Michael R. Bloomberg and Mary Wittenberg, director of the marathon — said the event would provide a needed morale boost, as well as an economic one."
                                            }
                                        ]
                                    }
                                ]
                            }
