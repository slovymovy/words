                "senses": [
                    {
                        "sense_id": "17ce75de-cf0e-345b-b958-98688b566f0e",
                        "entry_id": "b1d19481-83c3-3778-944d-5466da760496",
                        "glosses": [
                            "Kapelle, in der der Leib Christi aufbewahrt wird (zur stillen Anbetung)"
                        ],
                        "tags": [
                            "Katholizismus"
                        ],
                        "examples": [
                            {
                                "example_id": "18fd5553-9268-455c-9cf1-37e5ca9775b3",
                                "sense_id": "17ce75de-cf0e-345b-b958-98688b566f0e",
                                "text": "Sakramentskapellen finden sich häufig in größeren Kirchen und Kathedralen, z. B. im Kölner Dom oder auch Liebfrauendom München."
                            },
                            {
                                "example_id": "eaef49d0-1735-4853-b749-4f0d3cc216be",
                                "sense_id": "17ce75de-cf0e-345b-b958-98688b566f0e",
                                "text": "„Nach 1620 ging er nach Ravenna, wo er in der Sakramentskapelle des Domes einige Fresken ausführte, 1621 nach Neapel, kehrte aber, von den dortigen Malern angefeindet, nach kurzem Aufenthalt in Rom in seine Vaterstadt zurück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
