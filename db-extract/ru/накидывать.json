                "senses": [
                    {
                        "sense_id": "094c32bd-3fca-3f13-96ce-84c916f12c22",
                        "entry_id": "09ce71f6-e1e1-387e-8ac9-3e2a82b64770",
                        "glosses": [
                            "набрасывать поверх чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "722d7031-e0ba-43d1-baaf-8ce252611adf",
                                "sense_id": "094c32bd-3fca-3f13-96ce-84c916f12c22",
                                "text": "Благовоспитанный автор надевает на свою фантазию крепкую узду и накидывает на текущие события тёмную вуаль таинственности."
                            }
                        ]
                    },
                    {
                        "sense_id": "62ccfc8c-2e14-30c7-8ee0-2d769dd6796b",
                        "entry_id": "09ce71f6-e1e1-387e-8ac9-3e2a82b64770",
                        "glosses": [
                            "перен. разг. наспех надевать на себя какую-либо одежду"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c57fa48-49f2-4379-a8c3-86b3e091dbc9",
                                "sense_id": "62ccfc8c-2e14-30c7-8ee0-2d769dd6796b",
                                "text": "Зайкин поднимается, накидывает на себя халат и, взявши подушку, плетётся в кабинет…"
                            }
                        ]
                    },
                    {
                        "sense_id": "6dd4a108-9170-30fb-9228-7c8c9ab9b085",
                        "entry_id": "09ce71f6-e1e1-387e-8ac9-3e2a82b64770",
                        "glosses": [
                            "перен. разг. делать надбавку, увеличивать что-либо (например, цену, плату)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "653f0daf-020f-4268-a3ac-40901bca931e",
                                "sense_id": "6dd4a108-9170-30fb-9228-7c8c9ab9b085",
                                "text": "Правительство накидывает полчасика к тому рабочему дню, за который ходатайствовали капиталисты."
                            }
                        ]
                    }
