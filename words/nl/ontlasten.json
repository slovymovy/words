{
    "word_family": [
        "ontlasting",
        "belasten",
        "last"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4948796d-a205-3ec4-af93-054187507a76",
                    "sense_definition": "Een fysieke of figuurlijke last verminderen of wegnemen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verlichten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij wierpen alles wat niet absoluut noodzakelijk was weg om zo de pakdieren te <w>ontlasten</w>.",
                            "target_lang_translations": {
                                "en": "They threw away everything that was not absolutely necessary in order to <w>lighten the load</w> of the pack animals."
                            }
                        },
                        {
                            "text": "We moeten de druk op de werknemers verminderen om het team te <w>ontlasten</w>.",
                            "target_lang_translations": {
                                "en": "We need to reduce the pressure on the employees to <w>relieve</w> the team."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de druk ontlasten",
                        "het team ontlasten"
                    ],
                    "target_lang_definitions": {
                        "en": "To reduce or remove a physical or figurative burden."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "relieve",
                                "target_lang_sense_clarification": "to ease a burden or pressure"
                            },
                            {
                                "target_lang_word": "unburden",
                                "target_lang_sense_clarification": "to free from a physical or mental load"
                            },
                            {
                                "target_lang_word": "ease",
                                "target_lang_sense_clarification": "to make less heavy or difficult"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e5441dc-33fa-3375-a77a-5738de1a7303",
                    "sense_definition": "De belasting of intensiteit van iets (zoals verkeer of een systeem) verminderen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verlichten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nieuwe rondweg <w>ontlastte</w> het verkeer in de stad maar voor een korte tijd; daarna waren de opstoppingen weer een dagelijks verschijnsel.",
                            "target_lang_translations": {
                                "en": "The new bypass <w>relieved</w> traffic in the city for only a short time; after that, congestion was a daily occurrence again."
                            }
                        },
                        {
                            "text": "Deze maatregelen zijn bedoeld om het drukke elektriciteitsnet te <w>ontlasten</w>.",
                            "target_lang_translations": {
                                "en": "These measures are intended to <w>ease the load on</w> the busy electricity grid."
                            }
                        }
                    ],
                    "common_phrases": [
                        "het verkeer ontlasten",
                        "het netwerk ontlasten"
                    ],
                    "target_lang_definitions": {
                        "en": "To reduce the load or intensity of something (such as traffic or a system)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "relieve",
                                "target_lang_sense_clarification": "to reduce pressure on a system or network"
                            },
                            {
                                "target_lang_word": "ease",
                                "target_lang_sense_clarification": "to alleviate traffic or load"
                            },
                            {
                                "target_lang_word": "alleviate",
                                "target_lang_sense_clarification": "to make a system's load less severe"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05de6474-fa0e-3beb-9d48-b88b8a8eb3fb",
                    "sense_definition": "Iemand bevrijden of ontheffen van een bepaalde plicht, taak of verantwoordelijkheid.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ontheffen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De manager besloot de medewerker tijdelijk te <w>ontlasten</w> van zijn zwaarste taken.",
                            "target_lang_translations": {
                                "en": "The manager decided to temporarily <w>relieve</w> the employee of his heaviest tasks."
                            }
                        },
                        {
                            "text": "Zij vroeg of iemand haar kon <w>ontlasten</w> van de wekelijkse administratie.",
                            "target_lang_translations": {
                                "en": "She asked if someone could <w>take over</w> the weekly administration from her."
                            }
                        }
                    ],
                    "common_phrases": [
                        "van taken ontlasten"
                    ],
                    "target_lang_definitions": {
                        "en": "To free or exempt someone from a specific duty, task, or responsibility."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "relieve",
                                "target_lang_sense_clarification": "to free someone from a duty or task"
                            },
                            {
                                "target_lang_word": "exempt",
                                "target_lang_sense_clarification": "to release someone from an obligation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35dd59d0-0ea0-38d1-b9dd-ffb0d9a8ad1e",
                    "sense_definition": "Zich ontdoen van ontlasting; de darmen legen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "defeceren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na inneming van laxatieven wist hij zich eindelijk te <w>ontlasten</w>.",
                            "target_lang_translations": {
                                "en": "After taking laxatives, he finally managed to <w>empty his bowels</w>."
                            }
                        },
                        {
                            "text": "De patiënt had al drie dagen moeite om zich op een natuurlijke manier te <w>ontlasten</w>.",
                            "target_lang_translations": {
                                "en": "The patient had been having difficulty <w>relieving himself</w> naturally for three days."
                            }
                        }
                    ],
                    "synonyms": [
                        "poepen",
                        "drukken",
                        "schijten",
                        "kakken"
                    ],
                    "common_phrases": [
                        "zich ontlasten"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formeel of medisch taalgebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To discharge feces; to empty the bowels."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "defecate",
                                "target_lang_sense_clarification": "to excrete feces (formal/medical)"
                            },
                            {
                                "target_lang_word": "relieve oneself",
                                "target_lang_sense_clarification": "to urinate or defecate"
                            },
                            {
                                "target_lang_word": "empty one's bowels",
                                "target_lang_sense_clarification": "to pass stool"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}