                "senses": [
                    {
                        "sense_id": "ed61a3de-55c8-35f0-8528-c1b9699ba43e",
                        "entry_id": "f2482d0f-f73e-39f6-8216-9cd7638134f9",
                        "glosses": [
                            "unerwünschte Gewichtszunahme nach einer beendeten Diät in einem höheren Maße als die Diät Gewichtsreduzierung gebracht hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce33ec85-9f6f-4d00-b87e-b75a5521060f",
                                "sense_id": "ed61a3de-55c8-35f0-8528-c1b9699ba43e",
                                "text": "Ich hatte so schön abgenommen, aber dann kam der Jo-Jo-Effekt."
                            },
                            {
                                "example_id": "4e9918f1-c95e-452d-b69f-aa46825174f8",
                                "sense_id": "ed61a3de-55c8-35f0-8528-c1b9699ba43e",
                                "text": "Die Diäten führen ganz häufig zu dem Jojo-Effekt, dass man eben erst mal abnimmt und anschließend wieder zunimmt und mehr als vorher wiegt."
                            },
                            {
                                "example_id": "9e83ed27-5842-4c75-8c3e-4ffec0737730",
                                "sense_id": "ed61a3de-55c8-35f0-8528-c1b9699ba43e",
                                "text": "Wie schafft man es aus dem Kreislauf auszubrechen und den Jo-Jo-Effekt zu vermeiden?"
                            },
                            {
                                "example_id": "05368a31-9374-4a85-8e2d-7d0d4b9d2aa1",
                                "sense_id": "ed61a3de-55c8-35f0-8528-c1b9699ba43e",
                                "text": "Diäten sind der sicherste Weg, langfristig sein Gewicht zu steigern, der Jo-Jo-Effekt macht es möglich."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
