                "senses": [
                    {
                        "sense_id": "3aa91555-662d-340c-a181-e56853d2318f",
                        "entry_id": "8d92c56b-7800-37d7-baa4-3a4b76c28690",
                        "glosses": [
                            "de waarde van het verzekerde is hoger dan het bedrag waarvoor je verzekerd bent"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71a83328-2cf3-472f-a035-930286d39c06",
                                "sense_id": "3aa91555-662d-340c-a181-e56853d2318f",
                                "text": "Verzekeraars gebruiken berekeningen die voor de meeste klanten voldoende dekking bieden, om te voorkomen dat je onderverzekerd bent. Dat is het geval als de waarde van je spullen hoger is dan het bedrag waarvoor je bent verzekerd."
                            }
                        ]
                    },
                    {
                        "sense_id": "bed7cfe9-ab5a-3252-9c7d-75914272de7c",
                        "entry_id": "8d92c56b-7800-37d7-baa4-3a4b76c28690",
                        "glosses": [
                            "te weinig verzekeringen hebbende in het algemeen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b000c9fb-5a1a-4e13-8349-0ec09d521276",
                                "sense_id": "bed7cfe9-ab5a-3252-9c7d-75914272de7c",
                                "text": "Prudential is een internationale financiële dienstverlener met belangrijke activiteiten in zowel Azië, de Verenigde Staten als het Verenigd Koninkrijk (alwaar ze gevestigd is). Het bedrijf heeft een ruim netwerk opgebouwd in Azië (voornamelijk Verre Oosten en Zuid-Oost Azië) dat algemeen genomen nog steeds onderverzekerd is. Het bedrijf is goed gepositioneerd om de vruchten te plukken van de groeiende middenklasse in Azië, waar er een appetijt is voor levensverzekeringen, gezondheids- en pensioenproducten."
                            }
                        ]
                    }
