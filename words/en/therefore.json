                {
                    "sense_id": "643be500-cd4b-3d4e-81a0-8fafa6358794",
                    "sense_definition": "For that object or purpose.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "purpose_archaic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They have labored in the fields all day and shall receive their wages <w>therefore</w>.",
                            "target_lang_translations": {
                                "ru": "Они трудились в полях весь день и получат <w>за это</w> плату.",
                                "tr": "Bütün gün tarlalarda çalıştılar ve <w>bunun karşılığında</w> ücretlerini alacaklar."
                            }
                        },
                        {
                            "text": "He sought to build a house and gathered the wood <w>therefore</w>.",
                            "target_lang_translations": {
                                "ru": "Он хотел построить дом и собрал <w>для этого</w> древесину.",
                                "tr": "Bir ev inşa etmek istedi ve <w>bu amaçla</w> oduun topladı."
                            }
                        }
                    ],
                    "synonyms": [
                        "to that end"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "mostly found in older texts or biblical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Для этой цели; ради этого (устаревшее значение).",
                        "tr": "Eski veya resmi kullanımda 'bu amaçla', 'bunun için' anlamına gelir."
                    },
