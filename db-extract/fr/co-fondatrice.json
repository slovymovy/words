                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecb48326-28a2-4cfc-af2e-de4e927a1cdb",
                                "sense_id": "229aabf9-ee8d-3b58-95c9-bbb1076d5f6a",
                                "text": "Très nombreuses et particulièrement exposées dans les réseaux, les femmes peuvent en être les co-fondatrices et co-animatrices."
                            },
                            {
                                "example_id": "762bb48e-c23d-4a7d-ada3-335e1b3c9ec2",
                                "sense_id": "229aabf9-ee8d-3b58-95c9-bbb1076d5f6a",
                                "text": "Elle est co-fondatrice (en 2005) et co-animatrice du « Pari(s) du Vivre-Ensemble »."
                            },
                            {
                                "example_id": "ae48494f-8db4-4e2e-a2ba-c0b274b9a9c5",
                                "sense_id": "229aabf9-ee8d-3b58-95c9-bbb1076d5f6a",
                                "text": "« En tant que policiers, ils sont là pour interpeller. En tant qu’association, nous sommes présents pour une prise en charge globale de la victime », rappelle Frédérique Martz, co-fondatrice et Directrice Générale de Women Safe & Children."
                            }
                        ]
