                            {
                                "example_id": "18c040f4-3aaf-4531-bbbe-56c6f4d53dd7",
                                "sense_id": "47aacde9-93f1-3cb0-8c70-f2f0c6ec0e00",
                                "text": "Dat blijkt uit een rondgang van Omroep Gelderland onder de waterschappen. Boeren mogen door de verboden geen water uit beken, sloten en vijvers gebruiken voor hun land. Daarom plaatsen steeds meer agrariërs een grondwaterpomp."
                            },
                            {
                                "example_id": "2218d3eb-7986-4768-9e91-0c66e91bba27",
                                "sense_id": "47aacde9-93f1-3cb0-8c70-f2f0c6ec0e00",
                                "text": "Ze nam de overige sleutels mee en schakelde de grondwaterpomp uit."
                            }
                        ]
