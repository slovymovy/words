    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e3698c34-e266-3839-88d9-dd337a18fcb3",
                "word": "unashamed",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6b74c1d9-5549-3173-bebd-b6515d6bd319",
                        "entry_id": "e3698c34-e266-3839-88d9-dd337a18fcb3",
                        "glosses": [
                            "feeling or showing no shame, embarrassment or remorse"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "940a5f56-adab-4e11-aacb-20937f77f267",
                                "sense_id": "6b74c1d9-5549-3173-bebd-b6515d6bd319",
                                "text": "And smiling as a Master smiles at one / That is not of his school, nor any school / But that where blind and naked Ignorance / Delivers brawling judgments, unashamed, / On all things all day long ; he answer’d her."
                            },
                            {
                                "example_id": "30b96d1c-4d1b-49dc-a8ac-16b7ded8b17b",
                                "sense_id": "6b74c1d9-5549-3173-bebd-b6515d6bd319",
                                "text": "\"How else shall we go back unashamed to our women?\""
                            },
                            {
                                "example_id": "43fed825-4a0e-4e9d-af6c-7956effe6606",
                                "sense_id": "6b74c1d9-5549-3173-bebd-b6515d6bd319",
                                "text": "There is a similarity between the dynamics of the streets of New York and the dynamics of a Latin American plaza. Menendez suggests that they both capture a fascination with fashion, the appreciation for that which is done merely for effect, its unashamed desire to squander it all."
                            },
                            {
                                "example_id": "4cf3e83e-1911-4eda-b00e-d079dee572e2",
                                "sense_id": "6b74c1d9-5549-3173-bebd-b6515d6bd319",
                                "text": "Critics suggest that Fernández, an unashamed populist and nationalist, is seeking to deflect attention from social disharmony at home."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fb708b32-f823-41ec-b0b5-feb359c1b75c",
                        "source_entry_id": "e3698c34-e266-3839-88d9-dd337a18fcb3",
                        "source_sense_id": "6b74c1d9-5549-3173-bebd-b6515d6bd319",
                        "source_sense_description": "feeling or showing no shame, embarrassment or remorse",
                        "target_lang_word": "éhonté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éhonté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "155f8c8e-0cdf-3f80-b466-67649649d99a",
                                        "entry_id": "6a3470f5-3ba9-39a6-939a-5cfea5347b19",
                                        "glosses": [
                                            "Qui est sans honte, sans pudeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c57fd7b4-f9be-469a-8c3d-dc74758a1737",
                                                "sense_id": "155f8c8e-0cdf-3f80-b466-67649649d99a",
                                                "text": "Dès lors, Antoine et Ursule furent pour lui des parasites éhontés, des bouches qui dévoraient son bien."
                                            },
                                            {
                                                "example_id": "c8541b8d-4cf7-4704-8a79-3426208e054b",
                                                "sense_id": "155f8c8e-0cdf-3f80-b466-67649649d99a",
                                                "text": "— Est-ce lui qui aime notre voisine ?\n— Quelle voisine ?— Cette éhontée !\n— Quelle éhontée ?\n— La Pharmacienne !"
                                            },
                                            {
                                                "example_id": "a7996ddc-9816-4bd2-9019-a6a3c86c1b27",
                                                "sense_id": "155f8c8e-0cdf-3f80-b466-67649649d99a",
                                                "text": "Poutine a violé de manière éhontée les principes des Nations unies."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "éhonté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3c233e43-2c9b-32d1-952f-b73959a048d1",
                                        "entry_id": "623693ef-9325-3c11-80a7-a56f7ae4d641",
