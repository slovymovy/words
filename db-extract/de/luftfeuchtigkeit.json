                "senses": [
                    {
                        "sense_id": "06568a61-823c-390a-a722-de0f3af01f98",
                        "entry_id": "1fb8d3f1-16fa-3af6-89ff-727b14624f9d",
                        "glosses": [
                            "Humidité de l’air."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6ff637b-44c9-40a5-b828-182bef59757a",
                                "sense_id": "06568a61-823c-390a-a722-de0f3af01f98",
                                "text": "Wenn sich Wasser an den Scheiben sammelt, ist die Luftfeuchtigkeit im Raum zu hoch.",
                                "translation": "Si de l'eau s'accumule sur les vitres, cela signifie que l'humidité de l'air dans la pièce est trop élevée."
                            },
                            {
                                "example_id": "cf3b128b-3c11-4171-b863-8a4ac7d50b92",
                                "sense_id": "06568a61-823c-390a-a722-de0f3af01f98",
                                "text": "Schon seit mehreren Tagen sorgt das Hochdruckgebiet für große Hitze, die in Verbindung mit einer verhältnismäßig hohen Luftfeuchtigkeit für schwer erträgliche Temperaturen sorgt."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
