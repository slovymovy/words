                        "examples": [
                            {
                                "example_id": "42ba67fd-e969-44ba-bca3-d0136b8471b9",
                                "sense_id": "b26342f0-8f63-3926-8f9a-b637965dd504",
                                "text": "De D66-voorvrouw herinnerde eraan dat ook in het geldende coalitieakkoord van Berkelland nadrukkelijk vermeld staat: de gemeente moet door zelfsturing en zelfredzaamheid inwoners laten bouwen aan een levendige gemeenschap."
                            },
                            {
                                "example_id": "89746d90-0eb9-4f3b-8c01-918e3bf3415e",
                                "sense_id": "b26342f0-8f63-3926-8f9a-b637965dd504",
                                "text": "In het rotsvaste vertrouwen dat het allemaal goed komt en er in elk team medewerkers als ‘natuurlijk leider’ opstaan en zorgen dat het allemaal goed komt. Het woord ‘zelfsturing’ ligt hier op de loer; reden te meer om je hardop af te vragen wat de toegevoegde waarde is van zo’n baas."
                            }
