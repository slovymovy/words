                "translations": [
                    {
                        "translation_id": "5a4fcec4-0755-42d9-a24c-aecc2707cc5d",
                        "source_entry_id": "0ea19f27-cdfd-3f75-a37e-5cbc1c513da7",
                        "source_sense_id": "bb8d35ef-c5ef-3ba0-bb51-0953fd3fb59c",
                        "source_sense_description": "Jargon: jemand, der für das Personal eines Betriebs zuständig ist; Mitarbeiter der Personalabteilung",
                        "target_lang_word": "recruiter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recruiter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab45c265-06d7-3bc7-8ac8-20292c34edcb",
                                        "entry_id": "29f42173-c048-3f01-8b4f-34a63ed8bb56",
                                        "glosses": [
                                            "Agent noun of recruit; one who recruits, particularly one employed to recruit others."
                                        ],
                                        "tags": [
                                            "agent",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac2e439b-4363-4aea-a1d1-e2d9e661cc75",
                                                "sense_id": "ab45c265-06d7-3bc7-8ac8-20292c34edcb",
                                                "text": "The army recruiter promised that I'd see the world and learn useful skills if I enlisted."
                                            },
                                            {
                                                "example_id": "93bb1699-ae2f-4659-ab96-21cf3ec6b91d",
                                                "sense_id": "ab45c265-06d7-3bc7-8ac8-20292c34edcb",
                                                "text": "BBV expects to be one of the biggest recruiters in the region over the next two years."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3539186b-84a1-4370-bd25-7a9e70cf1482",
                        "source_entry_id": "0ea19f27-cdfd-3f75-a37e-5cbc1c513da7",
                        "source_sense_id": "bb8d35ef-c5ef-3ba0-bb51-0953fd3fb59c",
                        "source_sense_description": "Jargon: jemand, der für das Personal eines Betriebs zuständig ist; Mitarbeiter der Personalabteilung",
                        "target_lang_word": "headhunter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "headhunter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce73516a-6391-3c93-82dd-269b044d3e79",
                                        "entry_id": "b64d2bc5-41b1-3d28-8e14-e9ddaf55e402",
                                        "glosses": [
                                            "A person who practises headhunting, the taking and preserving of a person's head after killing them."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b0edf13-de62-4ecc-b09f-0905b11d3944",
                                                "sense_id": "ce73516a-6391-3c93-82dd-269b044d3e79",
                                                "text": "Theirs was the spirit which upheld Darwin among the gauchos of the Argentine or Wallace among the head-hunters of Malaya."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bada4bd-1e7f-3f67-aed0-b85cc28f3761",
                                        "entry_id": "b64d2bc5-41b1-3d28-8e14-e9ddaf55e402",
                                        "glosses": [
                                            "One who recruits skilled personnel, especially executive-level ones, for a company."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aed638ae-7108-4278-8d37-9e738f3b2d05",
                                                "sense_id": "8bada4bd-1e7f-3f67-aed0-b85cc28f3761",
                                                "text": "Near-synonyms: recruiter, talent scout"
                                            },
                                            {
                                                "example_id": "93409954-8799-49fa-8ce1-a930b61ad2ac",
                                                "sense_id": "8bada4bd-1e7f-3f67-aed0-b85cc28f3761",
                                                "text": "A headhunter called me out of the blue with an offer I couldn't refuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c53d037-8365-3e81-a9a2-aaae1fedbf94",
                                        "entry_id": "b64d2bc5-41b1-3d28-8e14-e9ddaf55e402",
                                        "glosses": [
                                            "A pitcher who throws at the batter's head."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0701d93c-589a-4570-b880-563268d65e8f",
                                                "sense_id": "9c53d037-8365-3e81-a9a2-aaae1fedbf94",
                                                "text": "Thankfully, there aren't many headhunters in the modern game."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c1b36dc-f98a-3746-bf9a-0da1fef0d4bb",
                                        "entry_id": "b64d2bc5-41b1-3d28-8e14-e9ddaf55e402",
                                        "glosses": [
                                            "A player who uses a hockey stick to attempt to strike an opponent's head."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "151db6b2-bd25-4c8b-923d-5b9863992f45",
                                                "sense_id": "5c1b36dc-f98a-3746-bf9a-0da1fef0d4bb",
                                                "text": "He is known as a goon and a headhunter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "989a513f-dc4f-44db-a88f-d3c9b3ff0de1",
                        "source_entry_id": "0ea19f27-cdfd-3f75-a37e-5cbc1c513da7",
                        "source_sense_id": "bb8d35ef-c5ef-3ba0-bb51-0953fd3fb59c",
                        "source_sense_description": "Jargon: jemand, der für das Personal eines Betriebs zuständig ist; Mitarbeiter der Personalabteilung",
                        "target_lang_word": "recruteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recruteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "18bd4962-4ca2-3ae5-8b88-a222883ad988",
                                        "entry_id": "c1042212-d8ef-3e33-924d-dddb390d7436",
                                        "glosses": [
                                            "Personne qui recrute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9eb2b48-de1b-4bd0-b25e-7ab066295266",
                                                "sense_id": "18bd4962-4ca2-3ae5-8b88-a222883ad988",
                                                "text": "Rien n’arrête le zèle des recruteurs monastiques. Vous les voyez frétiller autour des héritiers, des héritières…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bc29cde-11f4-35be-a887-d6eabfdc6c02",
                                        "entry_id": "c1042212-d8ef-3e33-924d-dddb390d7436",
                                        "glosses": [
                                            "Celui qui recrutait des soldats."
                                        ],
                                        "tags": [
                                            "dated",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd561f51-6ee0-469b-97b0-f2f6c872a462",
                                                "sense_id": "7bc29cde-11f4-35be-a887-d6eabfdc6c02",
                                                "text": "Dans un nouveau livre consacré au fondateur de la célèbre chaîne de meubles, Elisabeth Asbrink accuse Ingvar Kamprad d’avoir été un recruteur nazi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b84c9de-3a86-3784-b625-6f78d1c6299d",
                                        "entry_id": "c1042212-d8ef-3e33-924d-dddb390d7436",
                                        "glosses": [
                                            "Celui qui recrute ou qui embauche du personnel."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f783b6ce-a9a7-493e-b6c6-a76bbae34fad",
                                                "sense_id": "2b84c9de-3a86-3784-b625-6f78d1c6299d",
                                                "text": "Après tout, un recruteur n’a aucun pouvoir de décision finale."
                                            },
                                            {
                                                "example_id": "2da6f023-16b7-4b1d-9270-d40f3ce3c948",
                                                "sense_id": "2b84c9de-3a86-3784-b625-6f78d1c6299d",
                                                "text": "Une nouvelle méthode graphologique pourrait être détournée par les recruteurs : la frappologie."
                                            },
                                            {
                                                "example_id": "d802d75f-b112-4afc-866f-abba94e51bdf",
                                                "sense_id": "2b84c9de-3a86-3784-b625-6f78d1c6299d",
                                                "text": "Le parquet de Bari (sud) a déposé ses conclusions en annonçant des poursuites notamment contre l’entrepreneur Giampaolo Tarantini ainsi que Sabina Began, une starlette allemande surnommée « la reine mère » et considérée comme la recruteuse d’une sorte de harem au service de M. Berlusconi."
                                            },
                                            {
                                                "example_id": "15c18776-c33e-4e5d-8e53-c1851127834b",
                                                "sense_id": "2b84c9de-3a86-3784-b625-6f78d1c6299d",
                                                "text": "Même les recruteurs francophones font passer des tests d’entretien dans la langue de Shakespeare."
                                            }
                                        ]
                                    }
                                ]
                            }
