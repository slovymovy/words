{
    "word_family": [
        "piercing",
        "piercer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6e724744-510f-3ddf-9186-8a0ddc89ee88",
                    "sense_definition": "To puncture or break through a surface.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "penetrate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The diver <w>pierced</w> the surface of the water with scarcely a splash.",
                            "target_lang_translations": {
                                "zh": "潜水员几乎没溅起水花就<w>穿透</w>了水面。"
                            }
                        },
                        {
                            "text": "A sharp needle can easily <w>pierce</w> through thick fabric.",
                            "target_lang_translations": {
                                "zh": "锋利的针可以轻易<w>刺破</w>厚布。"
                            }
                        }
                    ],
                    "synonyms": [
                        "transfix"
                    ],
                    "common_phrases": [
                        "pierce through"
                    ],
                    "target_lang_definitions": {
                        "zh": "穿透或刺破表面。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "穿透",
                                "target_lang_sense_clarification": "指物体穿过表面。"
                            },
                            {
                                "target_lang_word": "刺破",
                                "target_lang_sense_clarification": "指用尖锐物体弄破表面。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fec424c7-3cd9-39c4-93a1-ca7622909548",
                    "sense_definition": "To penetrate or affect someone deeply with an emotion.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "penetrate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sudden stab of fear <w>pierced</w> my heart when I heard the noise.",
                            "target_lang_translations": {
                                "zh": "听到那个声音时，一阵突如其来的恐惧<w>刺痛</w>了我的心。"
                            }
                        },
                        {
                            "text": "She was <w>pierced</w> with grief after hearing the sad news.",
                            "target_lang_translations": {
                                "zh": "听到那个悲伤的消息后，她感到内心被悲痛<w>刺痛</w>了。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指情感深深地触动或刺痛某人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "刺痛",
                                "target_lang_sense_clarification": "形容情感上的剧烈冲击。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8196c4ef-7dad-36d1-bda6-0437314b2fd8",
                    "sense_definition": "To break or interrupt a period of silence or stillness abruptly.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "penetrate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A loud, dreadful scream <w>pierced</w> the silence of the night.",
                            "target_lang_translations": {
                                "zh": "一声凄厉的尖叫<w>打破</w>了夜晚的寂静。"
                            }
                        },
                        {
                            "text": "The sudden whistle <w>pierced</w> the quiet air.",
                            "target_lang_translations": {
                                "zh": "突如其来的哨声<w>打破</w>了宁静的空气。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "突然打破寂静或宁静。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "打破",
                                "target_lang_sense_clarification": "指声音突然中断了安静。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45037f46-037e-3e42-86aa-f7883f7058b6",
                    "sense_definition": "To create a hole in the skin to insert jewelry.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "penetrate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many teenagers decide to <w>pierce</w> their ears or nose.",
                            "target_lang_translations": {
                                "zh": "许多青少年决定去<w>穿孔</w>耳洞或鼻洞。"
                            }
                        },
                        {
                            "text": "He decided to <w>pierce</w> his tongue last summer.",
                            "target_lang_translations": {
                                "zh": "他去年夏天决定去<w>穿孔</w>舌头。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在皮肤上打孔以佩戴首饰。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "穿孔",
                                "target_lang_sense_clarification": "指身体穿孔艺术。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15d17299-8ca6-30bc-85de-356daa91dee8",
                    "sense_definition": "To understand or get to the heart of a complex matter.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "penetrate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective tried to <w>pierce</w> the mystery surrounding the old house.",
                            "target_lang_translations": {
                                "zh": "侦探试图<w>看穿</w>围绕着那座老房子的谜团。"
                            }
                        },
                        {
                            "text": "It is difficult to <w>pierce</w> the truth behind such complicated lies.",
                            "target_lang_translations": {
                                "zh": "很难<w>看穿</w>这些复杂谎言背后的真相。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "洞察或弄清复杂事物的真相。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "看穿",
                                "target_lang_sense_clarification": "指识破真相。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "28b07b5c-ef6f-3acb-a391-f91e6c4bc947",
                    "sense_definition": "An earring that requires a hole in the body to be worn.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought a new silver <w>pierce</w> for her ear.",
                            "target_lang_translations": {
                                "zh": "她为自己的耳朵买了一副新的银色<w>耳环</w>。"
                            }
                        },
                        {
                            "text": "He lost one of his favorite <w>pierces</w> at the gym.",
                            "target_lang_translations": {
                                "zh": "他在健身房弄丢了一只他最喜欢的<w>耳环</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "需要身体穿孔才能佩戴的耳环或饰品。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "耳环",
                                "target_lang_sense_clarification": "指需要穿耳洞佩戴的饰品。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "86af279f-18e3-3c07-911e-98477ebd82f8",
                    "sense_definition": "A male given name.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "<w>Pierce</w> is a classic name that has been used for centuries.",
                            "target_lang_translations": {
                                "zh": "<w>皮尔斯</w>是一个沿用了几个世纪的经典名字。"
                            }
                        },
                        {
                            "text": "My friend <w>Pierce</w> is coming to visit us this weekend.",
                            "target_lang_translations": {
                                "zh": "我的朋友<w>皮尔斯</w>这个周末要来看我们。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Can also function as a surname."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "男性名字。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "皮尔斯",
                                "target_lang_sense_clarification": "英文名音译。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58e865dc-b090-30b5-ad26-ac7165d8e499",
                    "sense_definition": "A common English surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The famous actor's last name is <w>Pierce</w>.",
                            "target_lang_translations": {
                                "zh": "那位著名演员的姓是<w>皮尔斯</w>。"
                            }
                        },
                        {
                            "text": "Mr. <w>Pierce</w> will be our new history teacher this year.",
                            "target_lang_translations": {
                                "zh": "<w>皮尔斯</w>先生今年将担任我们的新历史老师。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "常见的英文姓氏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "皮尔斯",
                                "target_lang_sense_clarification": "英文姓氏音译。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0994d59d-37af-3364-a6f8-28f777250710",
                    "sense_definition": "A city in Nebraska, United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They live in a small town called <w>Pierce</w>.",
                            "target_lang_translations": {
                                "zh": "他们住在一个叫<w>皮尔斯</w>的小镇上。"
                            }
                        },
                        {
                            "text": "The county seat of the region is <w>Pierce</w>.",
                            "target_lang_translations": {
                                "zh": "该地区的县治是<w>皮尔斯</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "美国内布拉斯加州的一个城市。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "皮尔斯",
                                "target_lang_sense_clarification": "地名音译。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}