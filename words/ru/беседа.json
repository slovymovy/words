            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ca2b682e-7dda-3b5c-b618-7079724d6360",
                    "sense_definition": "Спокойный, дружеский и обычно продолжительный обмен мнениями, разговор.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "conversation_types",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У нас состоялась очень приятная и долгая <w>беседа</w>.",
                            "target_lang_translations": {
                                "en": "We had a very pleasant and long <w>conversation</w>.",
                                "de": "Wir hatten eine sehr angenehme und lange <w>Unterhaltung</w>."
                            }
                        },
                        {
                            "text": "Мы провели весь вечер за дружеской <w>беседой</w> о книгах.",
                            "target_lang_translations": {
                                "en": "We spent the whole evening in friendly <w>conversation</w> about books.",
                                "de": "Wir verbrachten den ganzen Abend bei einer freundschaftlichen <w>Unterhaltung</w> über Bücher."
                            }
                        }
                    ],
                    "synonyms": [
                        "разговор",
                        "диалог",
                        "общение"
                    ],
                    "common_phrases": [
                        "дружеская беседа",
                        "приятная беседа",
                        "вести беседу",
                        "светская беседа"
                    ],
                    "target_lang_definitions": {
                        "en": "A calm, friendly, and usually prolonged exchange of opinions; a conversation.",
                        "de": "Ein ruhiger, freundschaftlicher und meist längerer Austausch von Meinungen; ein Gespräch."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "conversation",
                                "target_lang_sense_clarification": "general exchange of ideas"
                            },
                            {
