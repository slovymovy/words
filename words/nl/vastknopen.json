    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2b630ff3-be91-3393-b387-8fe8fd3a8aa3",
                    "sense_definition": "iets door middel van een knoop ergens aan bevestigen of twee uiteinden met elkaar verbinden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bevestigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vergeet niet om de boot goed aan de steiger <w>vast</w> te <w>knopen</w>.",
                            "target_lang_translations": {
                                "en": "Don't forget to <w>tie</w> the boat securely to the pier."
                            }
                        },
                        {
                            "text": "Hij <w>knoopte</w> het touw stevig <w>vast</w> om de stapel dozen bij elkaar te houden.",
                            "target_lang_translations": {
                                "en": "He <w>tied</w> the rope securely to hold the stack of boxes together."
                            }
                        }
                    ],
                    "synonyms": [
                        "knopen",
                        "binden"
                    ],
                    "antonyms": [
                        "losknopen"
                    ],
                    "common_phrases": [
                        "een touw vastknopen",
                        "stevig vastknopen"
                    ],
                    "target_lang_definitions": {
                        "en": "to attach something to something else using a knot, or to tie two ends together"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tie",
                                "target_lang_sense_clarification": "fastening with a knot"
                            },
                            {
                                "target_lang_word": "tie up",
                                "target_lang_sense_clarification": "securing firmly with a rope or knot"
                            },
                            {
                                "target_lang_word": "knot",
                                "target_lang_sense_clarification": "fastening by tying into a knot"
                            },
                            {
                                "target_lang_word": "bind together",
                                "target_lang_sense_clarification": "tying multiple parts together"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d88f2e3b-c437-33d8-8fd1-e17c2d4ed75b",
                    "sense_definition": "een bepaalde tijdsperiode of activiteit laten aansluiten op een vorige; verlengen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verlengen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De burgemeester wil graag nog een nieuwe termijn aan zijn ambt <w>vastknopen</w>.",
                            "target_lang_translations": {
                                "en": "The mayor would like to <w>tack on</w> another term to his office."
                            }
                        },
                        {
                            "text": "Na de succesvolle tournee besloot de band er nog enkele concerten aan <w>vast</w> te <w>knopen</w>.",
                            "target_lang_translations": {
                                "en": "After the successful tour, the band decided to <w>add on</w> a few more concerts."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanknopen"
                    ],
                    "common_phrases": [
                        "een termijn aan vastknopen",
                        "er een vakantie aan vastknopen"
                    ],
                    "target_lang_definitions": {
                        "en": "to follow up or extend a time period or activity by tacking on something additional"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tack on",
                                "target_lang_sense_clarification": "adding or appending an extra period or activity"
                            },
                            {
                                "target_lang_word": "tag on",
                                "target_lang_sense_clarification": "attaching an additional period or event to the end"
                            },
                            {
                                "target_lang_word": "add on",
                                "target_lang_sense_clarification": "extending by adding another duration or event"
                            }
                        ]
                    }
                }
            ]
        }
    ]
