                        "glosses": [
                            "Able to be survived."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36c9a6cb-8473-4c96-973c-9edcb0ef51aa",
                                "sense_id": "c9a65612-e6f1-39eb-b325-5c24bbfd70ef",
                                "text": "The conditions they are living in are harsh but survivable."
                            }
                        ]
                    },
                    {
                        "sense_id": "31b462bc-1440-3fa0-a359-e2e58b282549",
                        "entry_id": "f7266ac6-66ba-3030-9ca9-fa920ceb923c",
                        "glosses": [
                            "Capable of surviving an attack, especially a nuclear strike."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0203037-665a-4c55-8ae0-79bcc89db2c4",
                                "sense_id": "31b462bc-1440-3fa0-a359-e2e58b282549",
                                "text": "In order for a weapon system to be an effective deterrent it must be highly survivable. Weapon systems based in the world's ocean waters are the most survivable systems."
                            },
                            {
                                "example_id": "428f16bf-ea4c-434d-9f98-f0638708ff3d",
                                "sense_id": "31b462bc-1440-3fa0-a359-e2e58b282549",
                                "text": "As Desert Storm demonstrated, heavily defended targets can be successfully attacked by cruise missiles and a limited number of highly capable and survivable aircraft, leaving other targets to be attacked by less survivable aircraft. A recent CNA study reinforced this point."
                            },
                            {
                                "example_id": "dbd2bcdb-1223-40c4-b3cb-b9e372b462d9",
                                "sense_id": "31b462bc-1440-3fa0-a359-e2e58b282549",
                                "text": "“I think that what we found is that our command and control needs to be more survivable,” said Col. Robert S. McChrystal, commander of the 2nd Cavalry Regiment, which is based in Vilseck, Germany, near the Czech border."
                            }
                        ]
                    }
