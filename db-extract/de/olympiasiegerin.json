                "senses": [
                    {
                        "sense_id": "ebb9d98d-1b70-3830-a59f-cadfdb9e6e82",
                        "entry_id": "75f48845-132f-36a2-95f7-82c5de46dc77",
                        "glosses": [
                            "Sportlerin, die bei den Olympischen Spielen mindestens einen sportlichen Wettbewerb gewonnen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6690ecc-52df-4bc8-9f62-13f0a5780246",
                                "sense_id": "ebb9d98d-1b70-3830-a59f-cadfdb9e6e82",
                                "text": "„Die US-Amerikanerin Mikaela Shiffrin ist Weltmeisterin, Olympiasiegerin und Weltcupsiegerin im Slalom.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c20404d9-ec02-4faf-af5a-a49ea133eff0",
                        "source_entry_id": "75f48845-132f-36a2-95f7-82c5de46dc77",
                        "source_sense_id": "ebb9d98d-1b70-3830-a59f-cadfdb9e6e82",
                        "source_sense_description": "Sportlerin, die bei den Olympischen Spielen mindestens einen sportlichen Wettbewerb gewonnen hat",
                        "target_lang_word": "Olympic champion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "72a676f1-3054-46ed-bfbf-9a17aa8d0576",
                        "source_entry_id": "75f48845-132f-36a2-95f7-82c5de46dc77",
                        "source_sense_id": "ebb9d98d-1b70-3830-a59f-cadfdb9e6e82",
                        "source_sense_description": "Sportlerin, die bei den Olympischen Spielen mindestens einen sportlichen Wettbewerb gewonnen hat",
                        "target_lang_word": "championne olympique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "championne olympique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "10489f93-523c-3dc6-9efc-7f0ed2864615",
                                        "entry_id": "500d13c6-8c67-307e-8511-7f123747e8b2",
                                        "glosses": [
                                            "Athlète qui a remporté une épreuve olympique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a7b8576-438f-4701-a57b-0c02d13c23d8",
                                                "sense_id": "10489f93-523c-3dc6-9efc-7f0ed2864615",
                                                "text": "Le championnat simple fut gagné avec d’autant plus de facilité par Mˡˡᵉ Spéranza que la championne olympique avait abandonné avant d’atteindre les demi-finales."
                                            },
                                            {
                                                "example_id": "e613aacd-d246-4919-8365-01f344812e4d",
                                                "sense_id": "10489f93-523c-3dc6-9efc-7f0ed2864615",
                                                "text": "Puis au pas, en cadence, je défile dans le Stade avec les autres Français vainqueurs. Le cœur en fête, je monte à la tribune d’honneur, où je m’incline devant une Reine qui me remet une médaille d’or. Je suis proclamée championne olympique Française des jeux de la IXᵉ Olympiade."
                                            },
                                            {
                                                "example_id": "6140caa8-ad0d-4881-a28b-89c178c827d0",
                                                "sense_id": "10489f93-523c-3dc6-9efc-7f0ed2864615",
                                                "text": "Comme Julien, j’ai passé une grande partie de mon enfance sur la face cachée de la lune. Là, je pouvais voyager du toit de ma maison à celui de l’école, à bord de mon minuscule hélicoptère. Je virevoltais sur mes patins comme une championne olympique. Je n’avais peur de rien. Je parcourais à volonté les contrées les plus secrètes de notre monde et plusieurs autres univers plus fabuleux encore."
                                            },
                                            {
                                                "example_id": "e335b7cd-dd17-4a10-9819-407d5bc45169",
                                                "sense_id": "10489f93-523c-3dc6-9efc-7f0ed2864615",
                                                "text": "C’est là que se dessine le destin fabuleux d’une future championne olympique qui fera chavirer de bonheur la France entière en 1968. Elle s’appelle Colette Besson."
                                            },
                                            {
                                                "example_id": "ee58746c-c5d6-469a-9fda-47a161083904",
                                                "sense_id": "10489f93-523c-3dc6-9efc-7f0ed2864615",
                                                "text": "La couverture des Jeux olympiques de Berlin a principalement été une affaire d’hommes. En effet, parmi les journaux dépouillés dans les quatre pays étudiés (France, Belgique, Suisse et Canada), une seule signature de femmes est apparue, celle de Myrtle Cook, chroniqueuse sportive au Montreal Daily Star. Originaire de Toronto, Cook est une ancienne championne olympique qui a remporté l’or au quatre fois 100 mètres lors des Jeux d’Amsterdam en 1928."
                                            },
                                            {
                                                "example_id": "f1e9c458-6963-4500-a0e6-d60a30bb8524",
                                                "sense_id": "10489f93-523c-3dc6-9efc-7f0ed2864615",
                                                "text": "S’y illustrent des stars dont les noms sont parvenus jusqu’à nous, comme le lutteur Milon de Crotone dont on assure qu'il mangeait un demi-bœuf pendant la durée des Jeux, ou la princesse Cynisca de Sparte, première femme championne olympique en tant que propriétaire d’un char à quatre chevaux sacrée en 396 avant J.-C."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
