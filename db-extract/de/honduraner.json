                                "target_senses": [
                                    {
                                        "sense_id": "aae1f0b1-4b2b-3271-b53f-050b73b6afc6",
                                        "entry_id": "e83a9e46-1780-323f-ba9f-5a6ac49ea246",
                                        "glosses": [
                                            "Habitant ou originaire du Honduras."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40873d65-b10b-4d1e-9eb4-a31cb873f2ec",
                                                "sense_id": "aae1f0b1-4b2b-3271-b53f-050b73b6afc6",
                                                "text": "«Les héros c’est nous : les Colombiens, les Honduriens, les Chinois, l’équipage qui est composé de gens de 20 nationalités», a estimé M. Lopez, qui a admis que «les ordres d’évacuation sont arrivés tard»."
                                            },
                                            {
                                                "example_id": "6b2e894a-462a-4c21-a953-94bf1aea1b78",
                                                "sense_id": "aae1f0b1-4b2b-3271-b53f-050b73b6afc6",
                                                "text": "Cette opération terminée, nous avons remis le fort aux Honduriens, et nous étant rembarqués, nous sommes revenus à Port-Royal."
                                            },
                                            {
                                                "example_id": "976e58e6-13b0-409f-a4c0-cc829ee01cdb",
                                                "sense_id": "aae1f0b1-4b2b-3271-b53f-050b73b6afc6",
                                                "text": "Le Hondurien pourrait être titularisé sur l’aile droite, Bakwa passant à gauche."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
