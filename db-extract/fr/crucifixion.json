                                "target_senses": [
                                    {
                                        "sense_id": "dbce47fd-c835-35a4-a7a4-90cab05dbafe",
                                        "entry_id": "bd0208d7-0e64-3bb9-bb20-9ca28d8b2ac1",
                                        "glosses": [
                                            "истор. действие по значению гл. распинать, распять; разновидность казни, при которой осуждённого прибивали к кресту"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5268c2b-ed4b-4fb8-a2fd-32538b64125d",
                                                "sense_id": "dbce47fd-c835-35a4-a7a4-90cab05dbafe",
                                                "text": "Тогда гора эта была местом казни преступников, которых здесь предавали распятию, считавшемуся позорной смертью."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68ed9710-29ab-353a-ba0e-c12b2d4c4c68",
                                        "entry_id": "bd0208d7-0e64-3bb9-bb20-9ca28d8b2ac1",
                                        "glosses": [
                                            "религ. изображение креста с распятым на нём Иисусом Христом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "177a2492-3bac-4360-9f21-8235fd9a4170",
                                                "sense_id": "68ed9710-29ab-353a-ba0e-c12b2d4c4c68",
                                                "text": "Я оглядел комнату и увидел на стене большое деревянное распятие с изящной серебряной фигуркой Христа, при взгляде на которую у меня мелькнуло странное чувство, похожее на deja vu, — словно я уже видел это металлическое тело в каком-то недавнем сне."
                                            }
                                        ]
                                    },
