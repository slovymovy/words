                                        "entry_id": "942f6c4b-e00c-3856-858c-b97e4d4abebe",
                                        "glosses": [
                                            "A door that is opened by either pushing or pulling from either side (i.e. opens both ways) and is not normally capable of being locked."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2d56d80-7a57-43c8-b2c0-a8946c58f9c1",
                                                "sense_id": "644704dc-75a4-3c54-9a15-ff69c0444c24",
                                                "text": "The swing-doors which opened on to his dining-room creaked[.]"
                                            },
                                            {
                                                "example_id": "d99dcdbe-efc2-4b6b-ad3c-c5fc461ad6a6",
                                                "sense_id": "644704dc-75a4-3c54-9a15-ff69c0444c24",
                                                "text": "The restaurant's kitchen was separated from the dining room by a swing door."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
