                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c992a95b-4141-4868-887c-73e5800571e1",
                                "sense_id": "f73e1f7d-41df-3308-a60b-cb2d19794dbf",
                                "text": "„Wir setzten uns eine Weile auf einen Erdhügel, dann gingen wir weiter über das Feld, und Staszek sagte, daß Frau Zdulko heut eine Hühnersuppe kochen würde und Zbigniew selbstverständlich mitessen müsse.“"
                            },
                            {
                                "example_id": "8bce830c-cc0c-46dc-8375-8973206d9927",
                                "sense_id": "f73e1f7d-41df-3308-a60b-cb2d19794dbf",
                                "text": "„Hanni brachte Hühnersuppe in einem Henkelmann.“"
                            }
                        ],
