{
    "word_family": [
        "тресковый"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4ef46299-1c1b-37e9-8fbd-c512639abcd0",
                    "sense_definition": "Морская промысловая рыба северных морей семейства тресковых с белым мясом, а также её мясо, употребляемое в пищу.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "рыба",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На ужин мама приготовила жареную <w>треску</w> со свежими овощами и рисом.",
                            "target_lang_translations": {
                                "en": "For dinner, mom prepared fried <w>cod</w> with fresh vegetables and rice."
                            }
                        },
                        {
                            "text": "Консервированная печень <w>трески</w> считается очень полезным и питательным продуктом.",
                            "target_lang_translations": {
                                "en": "Canned <w>cod</w> liver is considered a very healthy and nutritious product."
                            }
                        }
                    ],
                    "common_phrases": [
                        "печень трески",
                        "филе трески",
                        "атлантическая треска"
                    ],
                    "target_lang_definitions": {
                        "en": "A marine commercial fish of northern seas from the Gadidae family with white meat, as well as its meat eaten as food; cod."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cod",
                                "target_lang_sense_clarification": "fish or fish meat"
                            },
                            {
                                "target_lang_word": "codfish",
                                "target_lang_sense_clarification": "the fish"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d83f3c77-2667-33d0-9464-42d1640a0ab7",
                    "sense_definition": "Форма родительного падежа единственного числа существительного <w>треск</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "звук",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В ночной тишине мы не услышали даже слабого <w>треска</w> сухих веток под ногами.",
                            "target_lang_translations": {
                                "en": "In the silence of the night, we didn't hear even the faint <w>cracking</w> of dry branches underfoot."
                            }
                        },
                        {
                            "text": "Старое дерево упало на дорогу без предупреждающего <w>треска</w> от сильного ветра.",
                            "target_lang_translations": {
                                "en": "The old tree fell onto the road from the strong wind without any warning <w>crack</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "без треска"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "грамматическая форма"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Genitive singular form of the noun треск (crack, crackle, crunch)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crack",
                                "target_lang_sense_clarification": "genitive form: of a crack"
                            },
                            {
                                "target_lang_word": "crackle",
                                "target_lang_sense_clarification": "genitive form: of crackling"
                            },
                            {
                                "target_lang_word": "crunch",
                                "target_lang_sense_clarification": "genitive form: of crunching"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}