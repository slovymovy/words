                                            {
                                                "example_id": "0557b119-921e-4066-831d-cfad012407e9",
                                                "sense_id": "e296ff6a-2450-3b08-b4c8-2ce8e1b6cbb7",
                                                "text": "Er is hier op de hoek net een nieuwe winkel opengegaan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26d59d19-459e-3a3d-8928-e3f34c20a281",
                                        "entry_id": "19c5aeea-8bfc-3a43-97f4-07cb80c8d67a",
                                        "glosses": [
                                            "in gebruik nemen"
                                        ],
                                        "tags": [
                                            "weer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fecef8f0-b832-46d3-be2c-4360067c53df",
                                                "sense_id": "26d59d19-459e-3a3d-8928-e3f34c20a281",
                                                "text": "Rijkswaterstaat heeft vervanging gezocht. „Het is altijd even puzzelen. We hopen hem snel weer open te zetten”, zei de woordvoerder. Rijkswaterstaat verwachtte eerder vanochtend dat de tunnel rond 08.00 uur weer open zou gaan, maar dat is niet gelukt. Later stelde Rijkswaterstaat die verwachting bij naar 09.00 uur."
                                            },
                                            {
                                                "example_id": "0405d47d-556f-4e8c-a1e0-1bb34f1d3608",
                                                "sense_id": "26d59d19-459e-3a3d-8928-e3f34c20a281",
                                                "text": "Toen het loket in maart voor de eerste keer openging, was het geld ook binnen enkele uren vergeven. Door de grote toestroom ontstonden toen zelfs IT-problemen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
