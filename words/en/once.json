                {
                    "sense_id": "7de93e3e-ffde-3709-a11d-71c8db85470e",
                    "sense_definition": "At any time; ever (used chiefly in conditional clauses).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "conditional_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If the secret <w>once</w> becomes known, we will be in trouble.",
                            "target_lang_translations": {
                                "ru": "Если секрет <w>однажды</w> станет известен, у нас будут неприятности.",
                                "nl": "Als het geheim <w>eenmaal</w> bekend wordt, hebben we een probleem.",
                                "pl": "Jeśli ta tajemnica <w>kiedykolwiek</w> wyjdzie na jaw, będziemy mieć kłopoty.",
                                "de": "Wenn das Geheimnis <w>erst einmal</w> bekannt wird, haben wir Ärger.",
                                "fr": "Si jamais le secret <w>une fois</w> révélé s'ébruite, nous aurons des ennuis.",
                                "it": "Se il segreto <w>una volta</w> diventa noto, saremo nei guai.",
                                "cs": "Pokud se to tajemství <w>jednou</w> provalí, budeme mít potíže.",
