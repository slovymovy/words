                    },
                    {
                        "sense_id": "b30eddfd-71b9-3f78-bfad-3fb8d02b02ec",
                        "entry_id": "14ba85fa-ceae-3932-b844-546af3c33ae0",
                        "glosses": [
                            "uitstraling, halo"
                        ],
