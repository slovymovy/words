                        "examples": [
                            {
                                "example_id": "c95c665a-5ea6-4154-9255-0f958a654511",
                                "sense_id": "49f8f6e4-303e-39af-a136-6951dcaa6fc9",
                                "text": "― Послушай! ― сказал твёрдым голосом Азамат, ― видишь, я на всё решаюсь."
                            },
                            {
                                "example_id": "90aab891-7664-4bac-b15e-f62b84f3f826",
                                "sense_id": "49f8f6e4-303e-39af-a136-6951dcaa6fc9",
                                "text": "Азамат в своем гараже занимается восстановлением запчастей к технике тракторного завода."
                            }
                        ]
                    }
