                        "examples": [
                            {
                                "example_id": "ad5a6f3a-23c0-4938-9fb0-6fa8696b77fe",
                                "sense_id": "ba085a42-4b45-3bbd-b9fe-cf93681586b2",
                                "text": "[1839-1840] Owing to the vagaries and unpatriotism of the Garrisonians, there was from 1840 schism in the abolition ranks."
                            },
                            {
                                "example_id": "92ffbc09-b979-433e-af46-418380c6f278",
                                "sense_id": "ba085a42-4b45-3bbd-b9fe-cf93681586b2",
                                "text": "Haynes suggested that Philip's behaviour savoured of unpatriotism, and that the one thing needful was the immediate appointment of a caterpillar controller."
                            },
                            {
                                "example_id": "e4a06cdd-a4d7-4f45-8f3a-465b3fa6937e",
                                "sense_id": "ba085a42-4b45-3bbd-b9fe-cf93681586b2",
                                "text": "The human being is born with no innate proclivity to crime or special kind of unpatriotism."
                            }
                        ]
                    }
                ],
