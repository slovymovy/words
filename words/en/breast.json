                {
                    "sense_id": "9859153d-62c1-3879-bd30-d860c1b5d7fd",
                    "sense_definition": "Either of the two soft, fleshy parts on the front of a woman's chest that can produce milk.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mother sat down quietly to <w>breastfeed</w> her baby.",
                            "target_lang_translations": {
                                "ru": "Мать тихо села, чтобы покормить ребенка <w>грудью</w>.",
                                "zh": "母亲静静地坐下来给孩子<w>喂奶</w>。",
                                "fr": "La mère s'est assise tranquillement pour <w>allaiter</w> son bébé."
                            }
                        },
                        {
                            "text": "Doctors recommend regular exams to check for <w>breast</w> cancer.",
                            "target_lang_translations": {
                                "ru": "Врачи рекомендуют регулярные обследования для проверки на рак <w>груди</w>.",
                                "zh": "医生建议定期检查以预防<w>乳腺</w>癌。",
                                "fr": "Les médecins recommandent des examens réguliers pour dépister le cancer du <w>sein</w>."
                            }
                        }
