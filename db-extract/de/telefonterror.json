                        "entry_id": "4d9f8d66-f645-3062-b4e9-9590b51903a3",
                        "glosses": [
                            "die über einen längeren Zeitraum wiederholte Belästigung mit Anrufen/Telefonaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e69e5be7-781e-4136-8e1d-18d029a86232",
                                "sense_id": "0b209417-385f-360f-b4e8-a7fc14e039c6",
                                "text": "Er belästigte seine Exfreundin mit Telefonterror."
                            },
                            {
                                "example_id": "a0e75a3a-8726-45d2-89fa-b98935cf338d",
                                "sense_id": "0b209417-385f-360f-b4e8-a7fc14e039c6",
                                "text": "Wenn der Stalker Sie am Telefon belästigt, so gibt es technische Hilfsmittel, die Belastung zu minimieren und den Stalker zu ermitteln bzw. des Telefonterrors zu überführen."
                            },
                            {
                                "example_id": "ccdc9e89-265d-43d1-a9ae-f13830add7dc",
                                "sense_id": "0b209417-385f-360f-b4e8-a7fc14e039c6",
                                "text": "Sollten Sie immer wieder von Firmen mit Werbeanrufen belästigt werden handelt es sich nicht automatisch um Telefonterror."
                            }
