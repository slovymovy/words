                "senses": [
                    {
                        "sense_id": "c8ba870d-d91a-3bbd-a04a-73c6cb26bec0",
                        "entry_id": "3fbb5e74-df1e-391a-b4af-478459825dad",
                        "glosses": [
                            "Leder, aus dem Schuhe gefertigt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94bb6257-c02e-4e5c-9165-97da717ded4a",
                                "sense_id": "c8ba870d-d91a-3bbd-a04a-73c6cb26bec0",
                                "text": "„Teile von Schuhleder und Kleidungsfetzen waren im ganzen Raum verstreut, und unmittelbar unter dem Fenster lag ein leerer Leinwandsack, der dort offensichtlich fallen gelassen worden war.“"
                            },
                            {
                                "example_id": "7c5be6b8-0cf8-460f-b520-8d98da11ec90",
                                "sense_id": "c8ba870d-d91a-3bbd-a04a-73c6cb26bec0",
                                "text": "„Am Ladentisch vorbei sieht man in einen Raum mit hohen Regalen, die bis obenhin mit Leisten aller Größen gefüllt sind, auf die das Schuhleder aufgespannt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
