                "forms": [],
                "senses": [
                    {
                        "sense_id": "c1a03c3c-9533-3266-8a86-747e69977a7e",
                        "entry_id": "f24f4329-cee8-3003-8972-68574a628e2c",
                        "glosses": [
                            "określenie poprzedzające datę lub przedział dat dla wskazania, kiedy dana osoba bądź też organizacja czy szkoła była aktywna"
                        ],
