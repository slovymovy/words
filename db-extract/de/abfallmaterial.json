                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7da9121-f6c7-42cd-9507-98ea2c996a4c",
                                "sense_id": "142ebc12-c41e-334d-842f-eb156c61ca3b",
                                "text": "„Eine verstärkte Schlickbildung, zum Beispiel durch Öl, das ins Meer gelangt, oder Abfallmaterial vom Straßenbau, lässt die Korallen ersticken.“"
                            },
                            {
                                "example_id": "1356fbe0-2650-4d44-b255-ce2f0976339e",
                                "sense_id": "142ebc12-c41e-334d-842f-eb156c61ca3b",
                                "text": "„Einige Designer haben sich etwa aufs sogenannte Upcycling spezialisiert, also darauf, aus Abfallmaterialien trendige Mode zu kreieren.“"
                            }
                        ],
