                    {
                        "sense_id": "8aedb1ea-e95c-3e7a-9a33-25d8a82cb2e2",
                        "entry_id": "4243de19-468d-3e91-a295-98e2952b982d",
                        "glosses": [
                            "Qui est admissible, qui peut être admis, qui doit être reçu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "695f9fb5-8513-4e45-9d53-76d896edd245",
                                "sense_id": "8aedb1ea-e95c-3e7a-9a33-25d8a82cb2e2",
                                "text": "Fournir des marchandises bonnes et recevables."
                            },
                            {
                                "example_id": "9dc6d6bc-6dc9-43b5-8269-2cdab6788a1f",
                                "sense_id": "8aedb1ea-e95c-3e7a-9a33-25d8a82cb2e2",
                                "text": "Cette excuse n’est pas recevable."
                            },
                            {
                                "example_id": "08e9629e-6e2a-4e05-b1cf-a5f236604852",
                                "sense_id": "8aedb1ea-e95c-3e7a-9a33-25d8a82cb2e2",
                                "text": "Ce délai passé, on ne sera plus recevable à produire de nouveaux titres."
                            },
                            {
                                "example_id": "68bedc22-3d55-4fe0-b8af-a5f0d3ad6797",
                                "sense_id": "8aedb1ea-e95c-3e7a-9a33-25d8a82cb2e2",
                                "text": "Des offres recevables, des offres non recevables, etc."
                            }
                        ]
                    },
                    {
                        "sense_id": "e369ff66-1607-37f5-b179-9f5afe123a7c",
                        "entry_id": "4243de19-468d-3e91-a295-98e2952b982d",
                        "glosses": [
                            "Qui peut être utilisé dans une procédure."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "d4f862c0-d480-4be0-9329-bd186f5a3c54",
                                "sense_id": "e369ff66-1607-37f5-b179-9f5afe123a7c",
                                "text": "Il a été déclaré non recevable dans sa demande."
                            },
                            {
                                "example_id": "405bea1d-f54d-4dce-b727-53abb6fdb15c",
                                "sense_id": "e369ff66-1607-37f5-b179-9f5afe123a7c",
                                "text": "Lorsqu’un texte a été élaboré par la commission mixte paritaire, le Gouvernement peut, en application du troisième alinéa de l’article 45 de la Constitution, le soumettre pour approbation aux deux assemblées. Cette transmission est effectuée par le Premier ministre (SGG). Aucun amendement n’est recevable sauf accord du Gouvernement."
                            }
                        ]
                    }
