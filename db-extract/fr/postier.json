                    }
                ],
                "senses": [
                    {
                        "sense_id": "86bad69d-50c2-35b6-be4f-203ba9e5e635",
                        "entry_id": "5e72ef58-5478-377f-a3bb-614eac7cb789",
                        "glosses": [
                            "Agent, employé du service des postes."
                        ],
                        "tags": [
                            "Poste"
                        ],
                        "examples": [
                            {
                                "example_id": "3191d3e7-5056-4a2a-a654-edce918e3cea",
                                "sense_id": "86bad69d-50c2-35b6-be4f-203ba9e5e635",
                                "text": "Le postier n’a rien, mais le gardien de l’immeuble qui a voulu le ceinturer a été blessé."
                            },
                            {
                                "example_id": "37cabf69-7350-4fca-8165-2892fe505324",
                                "sense_id": "86bad69d-50c2-35b6-be4f-203ba9e5e635",
                                "text": "Il y a dix ans, en 2005, on a connu une grève très marquante de deux semaines. Déclenchée à Aix-en-Provence, elle s’est propagée comme une traînée de poudre à l’ensemble du département, avec des milliers de postiers chauds comme la braise."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "19dc703f-6d34-4877-8739-9854adb60229",
                        "source_entry_id": "5e72ef58-5478-377f-a3bb-614eac7cb789",
                        "source_sense_id": "86bad69d-50c2-35b6-be4f-203ba9e5e635",
                        "target_lang_word": "Briefträger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Briefträger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb81db25-fa9e-31ba-938a-b6a3a070d377",
                                        "entry_id": "34904c0b-c7c5-336b-8354-e7aa2d7dd7c7",
                                        "glosses": [
                                            "Person, die beruflich Briefe zustellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61b67869-3c6e-45a0-be90-cfb841905c55",
                                                "sense_id": "fb81db25-fa9e-31ba-938a-b6a3a070d377",
                                                "text": "Der Briefträger teilt die Briefe schnell aus."
                                            },
                                            {
                                                "example_id": "62e23568-c917-4f78-a554-9c7a561ccc5b",
                                                "sense_id": "fb81db25-fa9e-31ba-938a-b6a3a070d377",
                                                "text": "„Da es zu dieser Zeit in Wien noch keine Briefkästen gab, wurde die Post mehrmals am Tag durch Briefträger eingesammelt, die sich auf ihren Stadtrundgängen durch eine laute Klapper bemerkbar machten.“"
                                            },
                                            {
                                                "example_id": "e750345c-2eac-446e-9ec4-0e280681f542",
                                                "sense_id": "fb81db25-fa9e-31ba-938a-b6a3a070d377",
                                                "text": "„Er schärft Mietze ein, dem Briefträger zu sagen, er soll klingeln.“"
                                            },
                                            {
                                                "example_id": "2d4a57af-c908-4da7-9a9c-d9d09fed4c26",
                                                "sense_id": "fb81db25-fa9e-31ba-938a-b6a3a070d377",
                                                "text": "„Dieser Briefträger war es auch, der den Gedanken äußerte, daß man etwas zu trinken beschaffen müsse, und da er auf starke Zustimmung stieß, rüstete er unverzüglich einen Beutezug aus.“"
                                            },
                                            {
                                                "example_id": "85e01f45-258e-4afe-8337-0797b7d28461",
                                                "sense_id": "fb81db25-fa9e-31ba-938a-b6a3a070d377",
                                                "text": "„Und gleich danach trat der Briefträger ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "922e170c-3314-39f5-a907-ce5269678422",
                                        "entry_id": "34904c0b-c7c5-336b-8354-e7aa2d7dd7c7",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb2e55c3-a421-4c67-a412-3818a52669a0",
                                                "sense_id": "922e170c-3314-39f5-a907-ce5269678422",
                                                "text": "„Aber damit war Wilhelm Krogel das Amt des Briefträgers nicht etwa abgenommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86eccf3c-3120-4371-8da6-edc6ec6eee22",
                        "source_entry_id": "5e72ef58-5478-377f-a3bb-614eac7cb789",
                        "source_sense_id": "86bad69d-50c2-35b6-be4f-203ba9e5e635",
                        "target_lang_word": "Postmann",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Postmann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7938b637-0d81-3d65-9706-018af8f10347",
                                        "entry_id": "e0656c8c-3610-353d-ab5f-3afe64fb04b7",
                                        "glosses": [
                                            "Person, die Briefe und andere Postsendungen zustellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45e0655b-d9f2-493a-934c-b779f231f8ad",
                                                "sense_id": "7938b637-0d81-3d65-9706-018af8f10347",
                                                "text": "Der Postmann hat ein Päckchen für dich gebracht."
                                            },
                                            {
                                                "example_id": "b6744b0f-a8c4-4ac7-ac46-44a5af4848b2",
                                                "sense_id": "7938b637-0d81-3d65-9706-018af8f10347",
                                                "text": "„Wenn der Postmann zweimal laut pfiff, rannte ihm Johann Georg, der ihn längst entdeckt hatte, schnell entgegen, um keine Nachricht zu versäumen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35eec792-e142-40f7-822c-597b3666ccc8",
                        "source_entry_id": "5e72ef58-5478-377f-a3bb-614eac7cb789",
                        "source_sense_id": "86bad69d-50c2-35b6-be4f-203ba9e5e635",
                        "target_lang_word": "Postbote",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Postbote",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f83c96ca-050e-34d2-b383-55a7a806cbf0",
                                        "entry_id": "a9f642cb-c486-30a4-8f48-9ad646a70192",
                                        "glosses": [
                                            "jemand, der Post zustellt"
                                        ],
                                        "tags": [
                                            "Berufsbezeichnung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50d6df89-8a11-4b8e-ace1-39012ffe4cfe",
                                                "sense_id": "f83c96ca-050e-34d2-b383-55a7a806cbf0",
                                                "text": "Immer wenn der Postbote kommt, bellt der Hund."
                                            },
                                            {
                                                "example_id": "1a5948ab-e855-49af-bafb-7ead2c926c65",
                                                "sense_id": "f83c96ca-050e-34d2-b383-55a7a806cbf0",
                                                "text": "„Der Postbote nickte, er selbst schien nichts dagegen zu haben, und er ließ auch weiter offen, welche Meinung er persönlich vertrat.“"
                                            },
                                            {
                                                "example_id": "1f8ecec4-6e7f-4296-8f31-2d14b376548a",
                                                "sense_id": "f83c96ca-050e-34d2-b383-55a7a806cbf0",
                                                "text": "„In dem Bündel, das der Postbote am Dienstag in der Hand hielt, war Leskovs Brief.“"
                                            },
                                            {
                                                "example_id": "82ac040d-8e80-401c-9e0f-efbb20bba35d",
                                                "sense_id": "f83c96ca-050e-34d2-b383-55a7a806cbf0",
                                                "text": "„Verpassen kann ich den Postboten nicht, er muß zu uns kommen.“"
                                            },
                                            {
                                                "example_id": "5ecf3841-8ccb-4953-a053-5f054f767535",
                                                "sense_id": "f83c96ca-050e-34d2-b383-55a7a806cbf0",
                                                "text": "„Dann erwischte ich Andrew eines Morgens dabei, wie er ein großes, flaches Paket für den Postboten verschnürte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c22059e-9917-4949-aeb1-a63455c6f8ef",
                        "source_entry_id": "5e72ef58-5478-377f-a3bb-614eac7cb789",
                        "source_sense_id": "86bad69d-50c2-35b6-be4f-203ba9e5e635",
                        "target_lang_word": "postman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "postman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80555d8b-c812-34b9-b342-1ca97035d7c7",
                                        "entry_id": "805a16e7-f3d6-3ef7-8b6b-1d37cf434926",
                                        "glosses": [
                                            "Someone who delivers the post (mail) to, and/or collects the post from, residential or commercial addresses, or from public mailboxes."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8a34950-5ffd-4a12-a236-5afb01ed97cd",
                                                "sense_id": "80555d8b-c812-34b9-b342-1ca97035d7c7",
                                                "text": "The total of their members amounts to 342,723 for 1875. Among these number … 6,968 male and sixty-three female postmen, imperial railway, telegraph, and post officials, railway workmen, dependent boatmen, waiters, &c.; …"
                                            },
                                            {
                                                "example_id": "f98ffdbf-5275-4153-9fbe-b21c1e32242d",
                                                "sense_id": "80555d8b-c812-34b9-b342-1ca97035d7c7",
                                                "text": "A single narrow iron-clamped door formed the only means of entrance. On this our guide knocked with a peculiar postman-like rat-tat."
                                            },
                                            {
                                                "example_id": "4a3da9dc-1c66-4e45-a759-de689c6e549f",
                                                "sense_id": "80555d8b-c812-34b9-b342-1ca97035d7c7",
                                                "text": "Please, Mr. Postman, look and see / Is there a letter in your bag for me? / Please, please, Mr. Po-o-ostman"
                                            },
                                            {
                                                "example_id": "dacf7bd5-b854-41f0-81b4-ad8a20107b86",
                                                "sense_id": "80555d8b-c812-34b9-b342-1ca97035d7c7",
                                                "text": "The headmistress entered and told the girls \"I want you to do everything you can to help the war effort—you are old enough to do it now.\" The girls changed into women postmen, head waiters, soldiers, landgirls, butchers and carpenters."
                                            },
                                            {
                                                "example_id": "0543c322-f292-439a-80ee-d9afe2d3d659",
                                                "sense_id": "80555d8b-c812-34b9-b342-1ca97035d7c7",
                                                "text": "Postmen, binmen, dock workers, even barristers are now on strike. Where will all this end?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcf5011e-7293-3ea6-9743-1774571cd720",
                                        "entry_id": "805a16e7-f3d6-3ef7-8b6b-1d37cf434926",
                                        "glosses": [
                                            "One of the two most experienced barristers in the Court of Exchequer, who have precedence in motions, so called from the place where he sits, the other of the two being the tubman."
                                        ],
                                        "tags": [
                                            "England",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62483e68-5cd2-4ed3-9881-88c730d3bc6a",
                                                "sense_id": "fcf5011e-7293-3ea6-9743-1774571cd720",
                                                "text": "Postman of the Court of Exchequer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5cd28065-93dd-473c-b750-85a2eb9f4b88",
                        "source_entry_id": "5e72ef58-5478-377f-a3bb-614eac7cb789",
