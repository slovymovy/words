                                        "entry_id": "eefa24ae-4639-38f8-b6c6-9171d982d753",
                                        "glosses": [
                                            "Any of various edible fish, formerly species of the genus Tilapia, but now placed in other cichlid genera (such as Oreochromis), native to Africa and the Middle East but cultivated worldwide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aec13e19-4b90-42e8-8de4-18249de1f6bc",
                                                "sense_id": "7f76ebb4-e299-331a-b32c-9c01c3e89a67",
                                                "text": "Well I dined last night with Scarface Ron\nOn tilapia fishcakes and fried black swan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bfa1086-613b-3e34-9401-7a412544a824",
                                        "entry_id": "eefa24ae-4639-38f8-b6c6-9171d982d753",
                                        "glosses": [
                                            "A fishy (resembling a cisgender woman) drag queen; a drag queen who could pass for a woman, as opposed to one who is exaggeratedly feminine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1c56c40-14ec-4478-b686-6ca36d11504a",
                                                "sense_id": "1bfa1086-613b-3e34-9401-7a412544a824",
                                                "text": "Vietnamese tilapia Plastique Tiara was at the forefront of one of Drag Race's most controversial eliminations earlier this year. Although the Texan performer and biological woman was leaving us gooped week-after-week with her runways, she was – spoiler alert! – eliminated in eighth place after lip-syncing against Miss Vanjie, despite having a better track record."
                                            }
                                        ]
                                    }
                                ]
