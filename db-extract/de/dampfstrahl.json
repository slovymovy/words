                "senses": [
                    {
                        "sense_id": "c264141b-bf12-3fd0-9a35-2cf1005b13f2",
                        "entry_id": "c55d32cd-a83f-3cbc-a7ee-4f3d1efc8960",
                        "glosses": [
                            "gerichteter Ausstoß von Wasserdampf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8809181-d7d2-474b-8ad1-52d12f7d76ad",
                                "sense_id": "c264141b-bf12-3fd0-9a35-2cf1005b13f2",
                                "text": "„Der Dampfstrahl aus einem in Gegenrichtung vorbeifahrenden Zug machte ihm Beine, aber beim Ausweichen stolperte er erneut.“"
                            },
                            {
                                "example_id": "8f81fcfd-2960-4477-8f92-1473a2023101",
                                "sense_id": "c264141b-bf12-3fd0-9a35-2cf1005b13f2",
                                "text": "„In der Dampfturbine erzeugt die hohe Geschwindigkeit eines Dampfstrahles direkt eine Drehbewegung.“"
                            },
                            {
                                "example_id": "4c558ada-f84c-4938-8ab2-b36d507f4214",
                                "sense_id": "c264141b-bf12-3fd0-9a35-2cf1005b13f2",
                                "text": "„Für zirkumskripte Stellen, speziell für das Kiefergelenk, verwendet man den aus einem Inhalationsapparate entströmenden feinen Dampfstrahl, nachdem von dem Apparat das Mundstück entfernt worden ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
