{
    "word_family": [
        "tight",
        "tightness",
        "tightly",
        "tightener"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d0d9e918-93ab-3604-b106-9474797b5448",
                    "sense_definition": "To make something more firm, fixed, or less loose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_tension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>tighten</w> that screw a quarter-turn to stop the wobbling.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>подтяните</w> этот винт на четверть оборота, чтобы он не шатался.",
                                "zh": "请把那个螺丝<w>拧紧</w>四分之一圈，这样它就不会晃动了。",
                                "es": "Por favor, <w>aprieta</w> ese tornillo un cuarto de vuelta para que deje de tambalearse."
                            }
                        },
                        {
                            "text": "You should <w>tighten</w> your grip on the handle so you do not drop it.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>сжать</w> рукоятку покрепче, чтобы не уронить её.",
                                "zh": "你应该<w>握紧</w>把手，以免把它掉在地上。",
                                "es": "Deberías <w>apretar</w> más el agarre del mango para que no se te caiga."
                            }
                        }
                    ],
                    "synonyms": [
                        "clench",
                        "tauten",
                        "tense"
                    ],
                    "antonyms": [
                        "loosen"
                    ],
                    "common_phrases": [
                        "tighten a screw",
                        "tighten your grip",
                        "tighten the bolts"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать что-либо более прочным, закрепленным или менее свободным.",
                        "zh": "使某物变得更紧、更牢固或不再松动。",
                        "es": "Hacer que algo sea más firme, esté más sujeto o sea menos holgado."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затянуть",
                                "target_lang_sense_clarification": "болты, гайки, узлы"
                            },
                            {
                                "target_lang_word": "подтянуть",
                                "target_lang_sense_clarification": "крепления или хватку"
                            },
                            {
                                "target_lang_word": "натянуть",
                                "target_lang_sense_clarification": "веревку или струну"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拧紧",
                                "target_lang_sense_clarification": "用于螺丝、螺母等"
                            },
                            {
                                "target_lang_word": "拉紧",
                                "target_lang_sense_clarification": "用于绳索、带子等"
                            },
                            {
                                "target_lang_word": "握紧",
                                "target_lang_sense_clarification": "用于手部动作"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "apretar",
                                "target_lang_sense_clarification": "oprimir o ajustar algo"
                            },
                            {
                                "target_lang_word": "tensar",
                                "target_lang_sense_clarification": "aplicar tensión a cuerdas o cables"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "660b9059-82c0-3b9f-8fe5-77db00c80176",
                    "sense_definition": "To become more firm, fixed, or less loose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_tension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That wooden joint is <w>tightening</w> as the wood dries out over time.",
                            "target_lang_translations": {
                                "ru": "Это деревянное соединение <w>уплотняется</w> по мере того, как дерево со временем высыхает.",
                                "zh": "随着木材逐渐干燥，那个木接头正在<w>变紧</w>。",
                                "es": "Esa unión de madera se está <w>tensando</w> a medida que la madera se seca con el tiempo."
                            }
                        },
                        {
                            "text": "His muscles began to <w>tighten</w> as he prepared for the race.",
                            "target_lang_translations": {
                                "ru": "Его мышцы начали <w>напрягаться</w>, когда он готовился к забегу.",
                                "zh": "当他为比赛做准备时，他的肌肉开始<w>绷紧</w>了。",
                                "es": "Sus músculos empezaron a <w>tensarse</w> mientras se preparaba para la carrera."
                            }
                        }
                    ],
                    "synonyms": [
                        "constrict",
                        "tauten"
                    ],
                    "antonyms": [
                        "loosen"
                    ],
                    "common_phrases": [
                        "muscles tighten",
                        "chest tightens"
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться более прочным, закрепленным или менее свободным.",
                        "zh": "变得更紧、更牢固或不再松动。",
                        "es": "Volverse más firme, estar más sujeto o ser menos holgado."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "натягиваться",
                                "target_lang_sense_clarification": "о тросе или мышцах"
                            },
                            {
                                "target_lang_word": "сжиматься",
                                "target_lang_sense_clarification": "о мышцах или груди"
                            },
                            {
                                "target_lang_word": "затягиваться",
                                "target_lang_sense_clarification": "об узлах или соединениях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "变紧",
                                "target_lang_sense_clarification": "通用描述"
                            },
                            {
                                "target_lang_word": "绷紧",
                                "target_lang_sense_clarification": "用于肌肉或绳索"
                            },
                            {
                                "target_lang_word": "收紧",
                                "target_lang_sense_clarification": "用于身体部位或结构"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "tensarse",
                                "target_lang_sense_clarification": "ponerse tenso, como los músculos o una cuerda"
                            },
                            {
                                "target_lang_word": "apretarse",
                                "target_lang_sense_clarification": "volverse más estrecho o compacto"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6d44f4f-db07-3075-a654-df8e3264ed68",
                    "sense_definition": "To make rules, laws, or financial conditions more strict or difficult.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government decided to <w>tighten</w> security at the airport after the incident.",
                            "target_lang_translations": {
                                "ru": "Правительство решило <w>усилить</w> меры безопасности в аэропорту после инцидента.",
                                "zh": "事件发生后，政府决定<w>加强</w>机场的安保工作。",
                                "es": "El gobierno decidió <w>endurecer</w> las medidas de seguridad en el aeropuerto tras el incidente."
                            }
                        },
                        {
                            "text": "If the central bank does not <w>tighten</w> the money supply, inflation will rise.",
                            "target_lang_translations": {
                                "ru": "Если центральный банк не <w>ограничит</w> денежную массу, инфляция вырастет.",
                                "zh": "如果中央银行不<w>收紧</w>货币供应，通货膨胀就会加剧。",
                                "es": "Si el banco central no <w>endurece</w> la oferta monetaria, la inflación subirá."
                            }
                        }
                    ],
                    "synonyms": [
                        "constrict"
                    ],
                    "common_phrases": [
                        "tighten security",
                        "tighten the rules",
                        "tighten the belt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать правила, законы или финансовые условия более строгими.",
                        "zh": "使规则、法律或财务条件变得更加严格。",
                        "es": "Hacer que las reglas, leyes o condiciones financieras sean más estrictas."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ужесточить",
                                "target_lang_sense_clarification": "правила, контроль или меры"
                            },
                            {
                                "target_lang_word": "усилить",
                                "target_lang_sense_clarification": "безопасность или надзор"
                            },
                            {
                                "target_lang_word": "затянуть",
                                "target_lang_sense_clarification": "в выражении «затянуть пояса»"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "加强",
                                "target_lang_sense_clarification": "用于安全、管理等"
                            },
                            {
                                "target_lang_word": "收紧",
                                "target_lang_sense_clarification": "用于政策、预算等"
                            },
                            {
                                "target_lang_word": "严加",
                                "target_lang_sense_clarification": "用于限制或控制"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "endurecer",
                                "target_lang_sense_clarification": "hacer más estrictas las normas o medidas"
                            },
                            {
                                "target_lang_word": "reforzar",
                                "target_lang_sense_clarification": "hacer más fuertes las medidas de seguridad"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cbb2564f-4821-3359-93f9-d39f069a1657",
                    "sense_definition": "To raise short-term interest rates in order to control the economy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Fed is expected to <w>tighten</w> by a quarter-point at the next meeting.",
                            "target_lang_translations": {
                                "ru": "Ожидается, что ФРС <w>повысит ставку</w> на четверть пункта на следующем заседании.",
                                "zh": "预计美联储将在下次会议上<w>加息</w>25个基点。",
                                "es": "Se espera que la Fed <w>endurezca</w> su política en un cuarto de punto en la próxima reunión."
                            }
                        },
                        {
                            "text": "Economists predict the bank will <w>tighten</w> monetary policy to combat rising prices.",
                            "target_lang_translations": {
                                "ru": "Экономисты прогнозируют, что банк будет <w>ужесточать</w> монетарную политику для борьбы с ростом цен.",
                                "zh": "经济学家预测，银行将<w>收紧</w>货币政策以应对物价上涨。",
                                "es": "Los economistas predicen que el banco <w>endurecerá</w> la política monetaria para combatir el aumento de los precios."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tighten monetary policy"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "financial context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Повысить краткосрочные процентные ставки для контроля экономики.",
                        "zh": "提高短期利率以调控经济。",
                        "es": "Aumentar los tipos de interés a corto plazo para controlar la economía."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ужесточить",
                                "target_lang_sense_clarification": "денежно-кредитную политику"
                            },
                            {
                                "target_lang_word": "повысить ставки",
                                "target_lang_sense_clarification": "в финансовом контексте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "加息",
                                "target_lang_sense_clarification": "金融政策术语"
                            },
                            {
                                "target_lang_word": "收紧",
                                "target_lang_sense_clarification": "指货币政策"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "endurecer la política monetaria",
                                "target_lang_sense_clarification": "contexto financiero y económico"
                            },
                            {
                                "target_lang_word": "subir los tipos de interés",
                                "target_lang_sense_clarification": "acción específica de los bancos centrales"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}