                "senses": [
                    {
                        "sense_id": "78eb023b-6b1b-3e19-8037-71a62decb60b",
                        "entry_id": "597ed55b-f3cd-3247-8646-77c6dd5b07fc",
                        "glosses": [
                            "что; прост. поддеть, подцепить, подхватить"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "65568ae2-8d27-3739-aa67-ec136e0fdb72",
                        "entry_id": "597ed55b-f3cd-3247-8646-77c6dd5b07fc",
                        "glosses": [
                            "кого; перен., прост. задеть кого-либо колким замечанием, уязвить"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "358153fe-b0d7-39fd-970d-c35f7f1b874f",
                        "entry_id": "597ed55b-f3cd-3247-8646-77c6dd5b07fc",
                        "glosses": [
                            "что, кого; перен., устар., прост. добыть, заполучить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf3bf99b-cfde-44cb-9616-c97b56b5db5a",
                                "sense_id": "358153fe-b0d7-39fd-970d-c35f7f1b874f",
                                "text": "На мичманское жалованье не разгуляешься, в Кронштадте или в плавании невесты богатой не поддедюлишь, а Маевский теперь его балует, а потом и забудет."
                            },
                            {
                                "example_id": "3af14e2f-d870-4e86-9b97-0441038e15b8",
                                "sense_id": "358153fe-b0d7-39fd-970d-c35f7f1b874f",
                                "text": "А что, хороша Домна-то? Да ничего себе, телеса сдобные. Ишь ты, ишь ты! Где ж он, Нагин-Беда-то, такую поддедюлил?"
                            }
                        ]
                    },
                    {
                        "sense_id": "7383886d-9668-37e3-8bb0-5552b0018b9d",
                        "entry_id": "597ed55b-f3cd-3247-8646-77c6dd5b07fc",
                        "glosses": [
                            "что; перен., устар., прост. присвоить, взять без разрешения"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6eb46901-fe9e-34ab-b726-c5e9a5dccfa6",
                        "entry_id": "597ed55b-f3cd-3247-8646-77c6dd5b07fc",
                        "glosses": [
                            "кого; перен., устар., прост. обмануть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07b74dbb-0580-4868-82d1-9fc2d942a8bc",
                                "sense_id": "6eb46901-fe9e-34ab-b726-c5e9a5dccfa6",
                                "text": "А ведь признайся, брат, ведь ты, право, преподло поступил тогда со мною, помнишь, как играли в шашки, ведь я выиграл. Да, брат, ты просто поддедюлил меня."
                            },
                            {
                                "example_id": "3dab5a48-81b7-4a53-8631-356b828fc857",
                                "sense_id": "6eb46901-fe9e-34ab-b726-c5e9a5dccfa6",
                                "text": "Да ведь как иначе, друг? — сознавался Ефимушка, а серьёзный Пётр говорил: Тем и жив, что украдешь, а что выработаешь — богу да царю… Вот и мне охота объегорить вас! — смеялся хозяин. Они добродушно поддерживали его: Поддедюлить, значит? Подкузьмить?"
                            }
                        ]
                    }
                ],
