                    },
                    {
                        "form_id": "648f794f-ea31-4d0b-9275-37c132dc3650",
                        "entry_id": "86a7ca7c-5eea-32a6-ad59-8ce7a7c88709",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Finanziers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b3d6aa8c-c9a8-37d7-8a3f-bba4490c9d0a",
                        "entry_id": "86a7ca7c-5eea-32a6-ad59-8ce7a7c88709",
                        "glosses": [
                            "jemand, der mit seinem Vermögen Projekte anderer finanziert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f90e0616-189a-4e64-a90b-3a0ca4610d62",
                                "sense_id": "b3d6aa8c-c9a8-37d7-8a3f-bba4490c9d0a",
                                "text": "Der Galerist konnte für die geplante Ausstellung keinen Finanzier finden."
                            },
                            {
                                "example_id": "344759c8-9f5a-4b00-b1ca-6ac6436a183d",
                                "sense_id": "b3d6aa8c-c9a8-37d7-8a3f-bba4490c9d0a",
                                "text": "„Weil kein neuer Direktor und Finanzier gefunden werden konnte, muss die legendäre Theaterbühne in der Wiener Urania schließen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6e9dbb3-3186-4980-b976-9e5220d5dcca",
                        "source_entry_id": "86a7ca7c-5eea-32a6-ad59-8ce7a7c88709",
                        "source_sense_id": "b3d6aa8c-c9a8-37d7-8a3f-bba4490c9d0a",
                        "source_sense_description": "Wirtschaft: jemand, der mit seinem Vermögen Projekte anderer finanziert",
                        "target_lang_word": "financier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "financier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c6d6d4d1-069d-3fc7-9fb0-c31f0a2baa8a",
                                        "entry_id": "29a5fcbe-7e3e-36a6-b6bb-745637ed5fa8",
                                        "glosses": [
                                            "Relatif aux finances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "143312f3-ff06-4b01-8a30-f33ea11e9496",
                                                "sense_id": "c6d6d4d1-069d-3fc7-9fb0-c31f0a2baa8a",
                                                "text": "Il se plongeait dans l’aridité des études financières, le jargon des affaires, la jonglerie des chiffres et, lentement, ces choses, hier hermétiques, lui devenaient familières."
                                            },
                                            {
                                                "example_id": "eb8d3a87-2555-464a-a790-96c439cd19f8",
                                                "sense_id": "c6d6d4d1-069d-3fc7-9fb0-c31f0a2baa8a",
                                                "text": "Le départ des juifs n’avait pas supprimé les embarras financiers de leurs clients et ceux qui avaient besoin de capitaux n’eurent d’autre ressource que de s’adresser aux prêteurs chrétiens (lombards ou cahorsins)."
                                            },
                                            {
                                                "example_id": "a27da95c-f8c6-4a63-b67f-984ca12c0f2d",
                                                "sense_id": "c6d6d4d1-069d-3fc7-9fb0-c31f0a2baa8a",
                                                "text": "Il ne faisait aucun doute que la poignée de musulmans restant sur l’île céderait, sous la pression d’offres financières acceptables, les dernières terres qui lui restaient […]."
                                            },
                                            {
                                                "example_id": "b6ae8964-a13c-40fc-b139-0272cf2b7b72",
                                                "sense_id": "c6d6d4d1-069d-3fc7-9fb0-c31f0a2baa8a",
                                                "text": "Ce serait un comble que pour sortir de la crise financière, on oriente l’épargne vers les dettes souveraines. Je préfère qu’on stimule l’économie par la production."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "490a51ac-30cc-32e0-af82-5ef2bb4d292d",
                                        "entry_id": "29a5fcbe-7e3e-36a6-b6bb-745637ed5fa8",
                                        "glosses": [
                                            "Qui a rapport aux gens de finance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a05a694-2ffc-4a16-b28d-161a336b8d45",
                                                "sense_id": "490a51ac-30cc-32e0-af82-5ef2bb4d292d",
                                                "text": "Le monde financier."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "financier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "910e257c-32b8-3b81-8411-fc2a7a4ed496",
                                        "entry_id": "6c897146-7a73-3487-82a4-e0325fd6af77",
                                        "glosses": [
                                            "Celui dont le métier est de faire des affaires de finance, des opérations bancaires, de la gestion de patrimoine, privé ou public."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a21cab36-ea66-4a91-8118-b9a727603c52",
                                                "sense_id": "910e257c-32b8-3b81-8411-fc2a7a4ed496",
                                                "text": "M. Necker […] jouissait alors de la double réputation de politique à haute vue et de financier consommé ; il la devait à ses écrits sur le commerce et à son immense fortune, acquise dans des spéculations de banque."
                                            },
                                            {
                                                "example_id": "812681b4-0c08-429c-972d-6d8cd86ce103",
                                                "sense_id": "910e257c-32b8-3b81-8411-fc2a7a4ed496",
                                                "text": "Gilles Perret a réuni Lætitia Dosch, Pierre Deladonchamps, Grégory Montel et Vincent Deniard pour un grand pied de nez à la morosité, avec cette histoire d’ouvriers d’une usine de Haute-Savoie qui se font passer pour des financiers, afin de racheter leur entreprise promise à un fonds d’investissement."
                                            },
                                            {
                                                "example_id": "e408b801-3f5e-42df-b064-e8c93552c4a1",
                                                "sense_id": "910e257c-32b8-3b81-8411-fc2a7a4ed496",
                                                "text": "Il n’ignorait pas les malpropretés auxquelles donne souvent lieu l’attribution de la Légion d’honneur à des industriels, à des commerçants, à des financiers."
                                            },
                                            {
                                                "example_id": "e223365f-69b1-45a4-b563-6cdcbf878b29",
                                                "sense_id": "910e257c-32b8-3b81-8411-fc2a7a4ed496",
                                                "text": "Le Second Empire est considéré comme l’âge d’or des financiers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6093b107-332d-3c2e-bb6d-0cd2b813a5db",
                                        "entry_id": "6c897146-7a73-3487-82a4-e0325fd6af77",
                                        "glosses": [
                                            "Personne qui maniait les deniers de l’État, qui avait la ferme ou la régie des droits du roi."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "219ac352-feac-46e1-a722-b488f708e7c3",
                                                "sense_id": "6093b107-332d-3c2e-bb6d-0cd2b813a5db",
                                                "text": "Un gros, un riche financier. Les exactions des financiers. Le savetier et le financier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "064711b1-990b-3cf2-a5de-b8ac80f69249",
                                        "entry_id": "6c897146-7a73-3487-82a4-e0325fd6af77",
                                        "glosses": [
                                            "Rôle d’homme de finance, de personnage cossu, bien établi dans la vie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10407a33-2041-4ec3-8405-5a827e0246c1",
