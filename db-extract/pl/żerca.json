                    }
                ],
                "senses": [
                    {
                        "sense_id": "fde36736-c3f0-365d-806c-a4fb1de985da",
                        "entry_id": "7fe1a573-db3b-36b2-8c5e-2f25f4bec4a2",
                        "glosses": [
                            "kapłan słowianowierczy zajmujący się żertwą, czyli składaniem bogom ofiar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a24ba46-edfd-4abe-903f-8def8dd4f069",
                                "sense_id": "fde36736-c3f0-365d-806c-a4fb1de985da",
                                "text": "Zgodnie z przekazami kronikarskimi żercy nosili długie szaty i nie obcinali włosów."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "71dafa10-3fda-3ba5-93f7-0230eda99101",
                        "entry_id": "7fe1a573-db3b-36b2-8c5e-2f25f4bec4a2",
                        "glosses": [
                            "ktoś pożerający coś"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ee4f733-88f3-49cb-9a53-ce6e7cdb492f",
                        "source_entry_id": "7fe1a573-db3b-36b2-8c5e-2f25f4bec4a2",
                        "source_sense_id": "fde36736-c3f0-365d-806c-a4fb1de985da",
                        "target_lang_word": "жрец",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "жрец",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "eeb8781d-4026-3624-b367-93e122a158f9",
                                        "entry_id": "5224c874-6148-3b1a-b060-b918fac8d8e6",
                                        "glosses": [
                                            "религ. служитель религиозного культа"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34abba41-c22b-4698-bca5-15dbddf5bbef",
                                                "sense_id": "eeb8781d-4026-3624-b367-93e122a158f9",
                                                "text": "Деспот, имеющий своих жрецов и рабов, деспот, пред которым все преклонилось с любовью и с суеверием, до сих пор немыслимым, пред которым трепещет даже сама наука и постыдно потакает ему."
                                            },
                                            {
                                                "example_id": "5a57cad3-1e33-40b8-a7f4-7efe9c0a20d2",
                                                "sense_id": "eeb8781d-4026-3624-b367-93e122a158f9",
                                                "text": "Позволяю себе сказать даже и то, что я неоднократно замечал, что, точно так же как, не будучи никем, кроме своими же жрецами, проверяемы, древние жрецы смело лгали и выдавали за истину то, что им взбредало в голову, точно так же нередко случается делать то же самое и так называемым людям науки."
                                            },
                                            {
                                                "example_id": "6dd50767-6069-4fd9-9406-1292902a4d71",
                                                "sense_id": "eeb8781d-4026-3624-b367-93e122a158f9",
                                                "text": "Жрецы, колдуны, заклинатели собрались со всех островов, пели гимны, творили молитвы, приносили жертвы и, наконец, предложили прибегнуть к крайнему средству ― к человеческому жертвоприношению, но король наотрез отказал дать свое согласие на это."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6266d484-2907-370a-ad5b-7214be6df6b0",
                                        "entry_id": "5224c874-6148-3b1a-b060-b918fac8d8e6",
                                        "glosses": [
                                            "устар. перен. тот, кто посвятил себя служению чему-либо"
                                        ],
                                        "tags": [
                                            "искусству, науке и т.п."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69462e2a-82e1-46bc-9de2-32942879ad2f",
                                                "sense_id": "6266d484-2907-370a-ad5b-7214be6df6b0",
                                                "text": "Да кто же доктора? Жрецы науки."
                                            },
                                            {
                                                "example_id": "81838d6f-ba9a-423c-a525-cc66ed79ad04",
                                                "sense_id": "6266d484-2907-370a-ad5b-7214be6df6b0",
                                                "text": "Не без волнения молодой жрец науки начинает говорить мне, что в этом году он выдержал экзамен на докторанта и что ему остается теперь только написать диссертацию."
                                            },
                                            {
                                                "example_id": "48bd1694-310f-489e-8c49-c06deab35437",
                                                "sense_id": "6266d484-2907-370a-ad5b-7214be6df6b0",
                                                "text": "Андрей Ефимыч знает, что при теперешних взглядах и вкусах такая мерзость, как палата 6, возможна разве только в двухстах верстах от железной дороги, в городке, где городской голова и все гласные ― полуграмотные мещане, видящие во враче жреца, которому нужно верить без всякой критики, хотя бы он вливал в рот расплавленное олово;"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
                        "linkage_id": "d59d904f-d25a-4cd6-bf94-16cc2a7c4f98",
