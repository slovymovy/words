                    {
                        "sense_id": "e1735b08-1b5b-3425-8b0f-e7b1475b696e",
                        "entry_id": "4cf2805d-2327-39cb-b0d3-f94f8004d1cd",
                        "glosses": [
                            "Arme de jet en forme de flèche parfois garnie d'étoupe enflammée qui se lançait soit à la main, soit avec une machine."
                        ],
                        "tags": [
                            "Armement"
                        ],
                        "examples": [
                            {
                                "example_id": "e8d75498-fa71-4c8e-a778-f4c17d200619",
                                "sense_id": "e1735b08-1b5b-3425-8b0f-e7b1475b696e",
                                "text": "La redoutable falarique, ce javelot que l'on lançait enflammé."
                            },
                            {
                                "example_id": "1e46743c-6f42-4daa-b5f8-187f0f7610d1",
                                "sense_id": "e1735b08-1b5b-3425-8b0f-e7b1475b696e",
                                "text": "Les falariques que l'on lançait à la main avaient une extrémité pointue, et un poids de l'autre, celles utilisées par les machines étaient plus lourdes, avaient une partie en bois, et comportaient une pointe en fer sur laquelle on montait parfois de l'étoupe enflammée."
                            }
                        ]
                    }
