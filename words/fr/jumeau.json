                    "frequency": "Low",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le sportif s'est étiré le muscle <w>jumeau</w> après une longue course."
                        },
                        {
                            "text": "Une douleur soudaine aux <w>jumeaux</w> l'a forcé à abandonner la compétition."
