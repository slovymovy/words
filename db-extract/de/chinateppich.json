                        "examples": [
                            {
                                "example_id": "410bfa3c-47a6-42f2-b80c-345d3146e601",
                                "sense_id": "a2ab27cc-0e5e-333a-ac20-5e4e90644f2d",
                                "text": "„Besonders kostbar sind Chinateppiche aus Seide.“"
                            },
                            {
                                "example_id": "ef46bf8a-d3e8-4e15-9f52-8e239cf8b43b",
                                "sense_id": "a2ab27cc-0e5e-333a-ac20-5e4e90644f2d",
                                "text": "„Erst oben, im fünften Stock, ändert sich das Bild schlagartig: Hier residiert Klaus Krone in einem Arbeitszimmer, im englischen Stil gehalten, mit blauem Chinateppich und Stichen an den Wänden. Der Mittvierziger ist vom Erfolg verwöhnt.“"
                            }
                        ],
