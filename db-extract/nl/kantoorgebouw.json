                    {
                        "sense_id": "93ef2ef4-97b3-3760-9cf0-a0947b217cf8",
                        "entry_id": "9d884881-9b5b-3b74-af96-76abbf527626",
                        "glosses": [
                            "een gebouw waarin één of meer organisaties hun kantoor hebben ondergebracht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac9daa4c-6546-44b9-ab15-60bdfd838434",
                                "sense_id": "93ef2ef4-97b3-3760-9cf0-a0947b217cf8",
                                "text": "Een spijkerbroek die je huurt en teruggeeft aan de maker als je hem niet meer draagt. Een kantoorgebouw dat je uit elkaar kunt halen zodat je de materialen voor iets anders kunt gebruiken. Zomaar twee voorbeelden van de circulaire economie."
                            },
                            {
                                "example_id": "0221f244-9c3b-4342-9471-5c96eb9b2a55",
                                "sense_id": "93ef2ef4-97b3-3760-9cf0-a0947b217cf8",
                                "text": "Na twintig jaar hard werken in glimmende kantoorgebouwen had ik behoefte aan meer natuur en avontuur."
                            }
                        ]
                    }
                ],
