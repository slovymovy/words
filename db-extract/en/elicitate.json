                "senses": [
                    {
                        "sense_id": "0c7a850d-8361-35c3-a165-c47a64759039",
                        "entry_id": "7318e1f8-dd30-3b07-aff9-5c7196aa2024",
                        "glosses": [
                            "To elicit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1199b0d-0446-4efa-a28a-158d433adea7",
                                "sense_id": "0c7a850d-8361-35c3-a165-c47a64759039",
                                "text": "The ideas elicitated in this manner, are, in every respect, similar to those proceeding from the senses."
                            },
                            {
                                "example_id": "7c1985ee-bb8b-4fa8-a48b-bc8f1a5429ea",
                                "sense_id": "0c7a850d-8361-35c3-a165-c47a64759039",
                                "text": "\"You say that Miss Eleanore refused to see him,\" I interrupted in the hope that the simple suggestion would be enough to elicitate further details of his interview with Eleanore."
                            },
                            {
                                "example_id": "fdcd1dd4-e863-47ed-ae05-7409dff5506d",
                                "sense_id": "0c7a850d-8361-35c3-a165-c47a64759039",
                                "text": "Well, if he is mine, why, when I wish to elicitate the truth, do you interrupt me with your ghosts?"
                            },
                            {
                                "example_id": "2ed1d010-ad45-4ee9-bd6a-64699549270b",
                                "sense_id": "0c7a850d-8361-35c3-a165-c47a64759039",
                                "text": "Thus, markets can only elicitate environmental preferences if new property rights are introduced."
                            },
                            {
                                "example_id": "5216aa20-e10d-41b1-ac8e-c64c256050e4",
                                "sense_id": "0c7a850d-8361-35c3-a165-c47a64759039",
                                "text": "To elicitate knowledge for complex systems design, we argue that is necessary to carry out cognitive task analysis in actual work situations, understanding how and why operators make their actions, and the intrinsic human-system relations (human-organization, human-technology, and human-human actions)."
                            },
                            {
                                "example_id": "0d56d71d-f5b5-4ca0-b919-4d2595ade657",
                                "sense_id": "0c7a850d-8361-35c3-a165-c47a64759039",
                                "text": "Therefore Agile will elicitate just enough initial requirements to identify the project scope and develop a high-level schedule and estimate; that's all you really need early in a project, so that's all you should do."
                            }
                        ]
                    }
