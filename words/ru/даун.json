                },
                {
                    "sense_id": "51dd9d08-5702-3049-b92c-22a7bac3435b",
                    "sense_definition": "оскорбительное обозначение глупого или неадекватного человека",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "insult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не называй его так, это слово звучит как грубый <w>даун</w> в адрес человека.",
                            "target_lang_translations": {
                                "en": "Don't call him that; that word is a rude <w>insult</w> to use against someone."
                            }
                        },
                        {
                            "text": "Он вел себя как полный <w>даун</w>, поэтому никто не хотел с ним разговаривать.",
                            "target_lang_translations": {
                                "en": "He was acting like a complete <w>idiot</w>, so no one wanted to talk to him."
                            }
                        }
                    ],
                    "synonyms": [
                        "дура́к",
                        "идио́т"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "оскорбительное, пренебрежительное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An offensive term used to describe a stupid or inadequate person."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "idiot",
                                "target_lang_sense_clarification": "A general offensive term for a foolish person."
                            },
                            {
                                "target_lang_word": "moron",
                                "target_lang_sense_clarification": "A derogatory term for someone perceived as stupid."
                            }
                        ]
                    }
                }
            ]
        },
