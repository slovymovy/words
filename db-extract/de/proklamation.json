                        ],
                        "form": "die Proklamationen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "19ce4906-bd50-3eee-9b62-231eb5559106",
                        "entry_id": "5fc4f281-d4fa-398d-83af-de25975960bd",
                        "glosses": [
                            "öffentliche Bekanntmachung einer wichtigen Neuerung/Veränderung, die durch eine amtliche Stelle, zum Beispiel die Regierung, den Herrscher, herbeigeführt wurde; Verkündung einer Botschaft, die eine spezielle Gruppe an die Öffentlichkeit richtet"
                        ],
                        "tags": [
                            "auch allgemeiner"
                        ],
                        "examples": [
                            {
                                "example_id": "764e2af1-8a52-46e5-b16f-e745e8698093",
                                "sense_id": "19ce4906-bd50-3eee-9b62-231eb5559106",
                                "text": "„Und doch scheinen die Menschen, die hartnäckig weiter glücklich werden wollen, die moralischen Proklamationen ihrer eigenen Gesellschaft nicht wahrnehmen zu wollen; es tut sich vielmehr ein merkwürdiger Abgrund zwischen Diskursen und Handlungen auf.“"
                            },
                            {
                                "example_id": "827ee0ce-841f-47af-843a-82461267927c",
                                "sense_id": "19ce4906-bd50-3eee-9b62-231eb5559106",
                                "text": "„Zum erstenmal haben die Herausgeber den Versuch gemacht, die wichtigsten literarischen und autobiographischen Schriften, Briefe, Proklamationen und Bulletins Napoleons zu sammeln und in chronologischer Reihenfolge in einem starken Band herauszugeben.“"
                            },
                            {
                                "example_id": "a1221907-9510-42d9-b2bf-97fac6c7bc1d",
                                "sense_id": "19ce4906-bd50-3eee-9b62-231eb5559106",
                                "text": "„April 1945 erfolgte die Proklamation über die Unabhängigkeit Österreichs von der damaligen provisorischen Staatsregierung.“"
                            },
                            {
                                "example_id": "fff9b495-6a34-4553-b807-8b1ce96becb3",
                                "sense_id": "19ce4906-bd50-3eee-9b62-231eb5559106",
                                "text": "„Auf dem Balkon, […], hielt Titl. Herr Kommissär von Schilcher eine kurze Anrede, welcher dann die Proklamation des Königs folgte.“ (1806)"
                            },
                            {
                                "example_id": "418d50bd-ed42-4f1d-a8ae-c34149535df4",
                                "sense_id": "19ce4906-bd50-3eee-9b62-231eb5559106",
                                "text": "„Die Proklamation, mit der sie die Herrschaft über Indien übernahm, war eine Botschaft der Hoffnung und des guten Willens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f156f39a-7241-4cb5-8a00-85e942b7107e",
                        "source_entry_id": "5fc4f281-d4fa-398d-83af-de25975960bd",
                        "source_sense_id": "19ce4906-bd50-3eee-9b62-231eb5559106",
