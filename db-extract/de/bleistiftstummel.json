                        "examples": [
                            {
                                "example_id": "6494ec49-951b-4fdd-93ac-07d8eda893c9",
                                "sense_id": "a13e7753-23c5-3ce2-a567-84be4ef522f3",
                                "text": "„Einer der Jungen, die die ganze Zeit still in sich verkrochen in der Ecke saßen, holt einen leeren Feldpostbrief aus der Tasche und beginnt im Schein der flackernden Kerzen mit einem Bleistiftstummel zu schreiben.“"
                            },
                            {
                                "example_id": "7cee0548-715a-4375-941e-35b807641db8",
                                "sense_id": "a13e7753-23c5-3ce2-a567-84be4ef522f3",
                                "text": "„In der anderen Hosentasche war ein abgebrochener Bleisiftstummel.“"
                            }
                        ],
