                    {
                        "translation_id": "43ce4841-2785-428b-80fd-34ce527efcc5",
                        "source_entry_id": "bd34131e-e33d-3a6b-9e38-a497d0de2673",
                        "source_sense_description": "very dry",
                        "target_lang_word": "xérique",
