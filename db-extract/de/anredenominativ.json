                "senses": [
                    {
                        "sense_id": "7186542b-3f34-33e4-b767-6ee7947190d7",
                        "entry_id": "4c750f1e-231e-3c41-a991-9ee9d8794939",
                        "glosses": [
                            "Nominativ in der Funktion eines Vokativs, also des Kasus der Anrede"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6a6ed98-33ee-464f-9a41-b24e5de4d5e9",
                                "sense_id": "7186542b-3f34-33e4-b767-6ee7947190d7",
                                "text": "In dem Satz \"Mama, kommst du mal her?\" ist \"Mama\" ein Anredenominativ, hat also die Funktion eines Vokativs."
                            },
                            {
                                "example_id": "3fa8e0bf-4172-4648-9114-dbe194eab90f",
                                "sense_id": "7186542b-3f34-33e4-b767-6ee7947190d7",
                                "text": "In manchen Sprachen, die keinen eigenen Kasus Vokativ haben, so auch im Deutschen, übernimmt der Anredenominativ dessen Funktion."
                            },
                            {
                                "example_id": "3426476b-78cb-4a5c-a466-917e75f8e9ae",
                                "sense_id": "7186542b-3f34-33e4-b767-6ee7947190d7",
                                "text": "Die Duden-Grammatik verweist beim Stichwort Vokativ auf den Anredenominativ und setzt damit beide in etwa gleich."
                            },
                            {
                                "example_id": "285451c2-35e4-4c88-a7ef-7b5aa49a7c24",
                                "sense_id": "7186542b-3f34-33e4-b767-6ee7947190d7",
                                "text": "In manchen Texten wird der Anredenominativ durch die Partikel o oder oh eingeleitet: „O Tannenbaum…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
