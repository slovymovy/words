                        "examples": [
                            {
                                "example_id": "abf5e4ba-ce12-43d8-a36e-b05e77bdf219",
                                "sense_id": "e8d9d5a9-eb88-398f-9853-3c723750f1bb",
                                "text": "The language of Yarriba has no affinity to either of the Sudanian idioms."
                            },
                            {
                                "example_id": "ed2dba06-95d2-4b70-a00c-1cfc3432655c",
                                "sense_id": "e8d9d5a9-eb88-398f-9853-3c723750f1bb",
                                "text": "It is present in the majority of the north-western Bantu languages, and in some of the adjoining forms of Sudanian speech, as well as in the westernmost Nilotic."
                            },
                            {
                                "example_id": "c0d1f89e-6cda-4d76-a18c-4f96b1575488",
                                "sense_id": "e8d9d5a9-eb88-398f-9853-3c723750f1bb",
                                "text": "The Sudanian speech-group thus reaches in an irregular band right across Africa, from Cape Verd on the west to the confines of Abyssinia on the east […]"
                            }
                        ]
