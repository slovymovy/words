                        "glosses": [
                            "Se gaver de soi-même, sans y être contraint (en général en parlant de canards ou d’oies)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb626625-7e95-41c7-8161-a51eec418a70",
                                "sense_id": "72afa310-4d5c-324e-81f6-27b10de620af",
                                "text": "Dans leur élevage, on ouvre les trémies à des heures fixes donc le canard s’auto-gave lorsqu’il le peut."
                            },
                            {
                                "example_id": "964cb08e-a472-4814-a91c-dc5110247ecc",
                                "sense_id": "72afa310-4d5c-324e-81f6-27b10de620af",
                                "text": "Elles s’auto-gavent et sont très appréciées aussi pour leur chair savoureuse."
                            },
                            {
                                "example_id": "c7537c8f-9fe3-445c-8a08-1d36a5f38774",
                                "sense_id": "72afa310-4d5c-324e-81f6-27b10de620af",
                                "text": "Comme je « m’auto-gave » à toujours me retrouver dans ce genre de situation !!"
                            }
                        ]
                    }
