                ],
                "senses": [
                    {
                        "sense_id": "23ec1ee7-f466-3fda-a1dd-18d2178058c0",
                        "entry_id": "d9165adc-f9a4-3dee-a0ee-e0cf3c6ff144",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf3fd5fa-c5b6-45bb-b9e2-c171bcaacdb8",
                                "sense_id": "23ec1ee7-f466-3fda-a1dd-18d2178058c0",
                                "text": "Frau Birkle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "eb485c67-f177-48ee-b884-90db72a3dd1c",
                                "sense_id": "23ec1ee7-f466-3fda-a1dd-18d2178058c0",
                                "text": "Herr Birkle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b15e8679-427b-485b-bfc0-54bc86151eec",
                                "sense_id": "23ec1ee7-f466-3fda-a1dd-18d2178058c0",
                                "text": "Die Birkles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "727b65fc-5e7c-4812-8201-ca619d9df641",
                                "sense_id": "23ec1ee7-f466-3fda-a1dd-18d2178058c0",
                                "text": "Der Birkle trägt nie die Pullover, die die Birkle ihm strickt."
                            },
                            {
                                "example_id": "9cf43746-b13a-4636-9263-c6fdf65470e5",
                                "sense_id": "23ec1ee7-f466-3fda-a1dd-18d2178058c0",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Birkle kommt, geht der Herr Birkle.“"
                            },
                            {
                                "example_id": "d0198137-9a24-4df9-b86f-66ebd9de20ad",
                                "sense_id": "23ec1ee7-f466-3fda-a1dd-18d2178058c0",
                                "text": "Birkle kommt und geht."
                            },
                            {
                                "example_id": "c0b649aa-8c64-4371-9a4b-2e3326a227d2",
                                "sense_id": "23ec1ee7-f466-3fda-a1dd-18d2178058c0",
                                "text": "Birkles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
