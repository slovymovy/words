                                                "text": "The E number E100 represents turmeric."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dd980d1-e50b-3894-a14f-cb26acaafbb5",
                                        "entry_id": "0a7616da-66e8-3249-9306-581b2428ff7c",
                                        "glosses": [
                                            "Any such additive, often regarded as undesirable."
                                        ],
                                        "tags": [
                                            "British",
                                            "Ireland",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3d29eca-b068-45ed-b8fa-d3a7c42b2f55",
                                                "sense_id": "1dd980d1-e50b-3894-a14f-cb26acaafbb5",
                                                "text": "I finger Padre Pio paperweights and Our Lady of Knock sticks of rock that are packed with more e-numbers than could be safe at one sitting."
                                            },
                                            {
                                                "example_id": "74d8d154-1b84-4635-be8a-8724e12ee5ef",
                                                "sense_id": "1dd980d1-e50b-3894-a14f-cb26acaafbb5",
                                                "text": "...how long it took corpses to go off these days, because everyone was so full of E-numbers and preservatives."
                                            }
                                        ]
                                    }
