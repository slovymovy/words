                "senses": [
                    {
                        "sense_id": "326c89a5-cefd-34d2-9c00-69739f596f1c",
                        "entry_id": "6829ce42-a1e7-3251-a6ea-340990d6c8c6",
                        "glosses": [
                            "zoals op school"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a88f9e0-f0c4-473c-93f3-b32bc574128d",
                                "sense_id": "326c89a5-cefd-34d2-9c00-69739f596f1c",
                                "text": "Op die universiteit geven ze erg schoolse colleges."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c89b516-4365-4007-802a-e1ce4687524c",
                        "source_entry_id": "6829ce42-a1e7-3251-a6ea-340990d6c8c6",
                        "source_sense_id": "326c89a5-cefd-34d2-9c00-69739f596f1c",
                        "source_sense_description": "zoals op school",
                        "target_lang_word": "schulisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schulisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e226ea45-ec5b-3866-be52-5871fd0f42c4",
                                        "entry_id": "a771bf9c-5040-3d5e-bb29-49f45f5da57f",
                                        "glosses": [
                                            "im Unterricht/an der Schule (stattfindend); die Schule betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5970c71-f9ad-4eb6-ac6a-b03d1bd24287",
                                                "sense_id": "e226ea45-ec5b-3866-be52-5871fd0f42c4",
                                                "text": "Ihre schulischen Leistungen sind gut."
                                            },
                                            {
                                                "example_id": "31ed74ae-04ea-4a90-a764-c542a2158c93",
                                                "sense_id": "e226ea45-ec5b-3866-be52-5871fd0f42c4",
                                                "text": "„Besteht ein Zusammenhang zwischen Eisenmangel und schlechten schulischen Leistungen?“"
                                            },
                                            {
                                                "example_id": "bebb13c3-57bb-4543-aee7-048feba2a8d4",
                                                "sense_id": "e226ea45-ec5b-3866-be52-5871fd0f42c4",
                                                "text": "„Um die Bedürfnisse von Kindern hat sich die politische Debatte […] bisher kaum gedreht. Es sei denn, es ging um ihre schulischen Leistungen.“"
                                            },
                                            {
                                                "example_id": "fb5f73e4-2fa5-4642-8ea8-ab17feee9dde",
                                                "sense_id": "e226ea45-ec5b-3866-be52-5871fd0f42c4",
                                                "text": "„Herausragende Sportler erhalten an vielen [US-amerikanischen] Universitäten eine Zulassung auch ohne entsprechende schulische Leistungen.“"
                                            },
                                            {
                                                "example_id": "cb9aab97-0f51-49cd-883b-ff39ac7996d1",
                                                "sense_id": "e226ea45-ec5b-3866-be52-5871fd0f42c4",
                                                "text": "Seine schulische Entwicklung verläuft planmäßig."
                                            },
                                            {
                                                "example_id": "6a9da327-f129-46fc-a43c-39ad4c985a57",
                                                "sense_id": "e226ea45-ec5b-3866-be52-5871fd0f42c4",
                                                "text": "„Die Folgen der Depression für die Kinder und Jugendlichen sind vielfältig. Oft geht die Störung mit schulischen Problemen einher.“"
                                            },
                                            {
                                                "example_id": "ace66650-0b1b-4eea-a01d-fdc52eb44730",
                                                "sense_id": "e226ea45-ec5b-3866-be52-5871fd0f42c4",
                                                "text": "„Nach ihrer schulischen Ausbildung studierte sie Journalismus an der Hawaii Pacific University in Honolulu.“"
                                            },
                                            {
                                                "example_id": "deb3fba4-1702-4fe6-af3c-80efeba59373",
                                                "sense_id": "e226ea45-ec5b-3866-be52-5871fd0f42c4",
                                                "text": "[Bundeswirtschaftsminister Peter Altmaier zu Gastarbeitern aus den 1960er/1970er Jahre:] „»Man hat sich über schulische Integration, über Ausbildung, über Sprachkenntnisse damals keine Gedanken gemacht, daraus sind soziale Spannungen entstanden.«“"
                                            },
                                            {
                                                "example_id": "fbb3179d-67e8-493f-b98f-1c9b26ed9848",
                                                "sense_id": "e226ea45-ec5b-3866-be52-5871fd0f42c4",
                                                "text": "„Von den 7,1 Millionen Kindern, die ihre Heimat verlassen mussten, haben 3,7 Millionen keinen Zugang zu schulischen Einrichtungen.“"
                                            },
                                            {
                                                "example_id": "620dd870-1708-4b60-a7de-6d42cfef2381",
                                                "sense_id": "e226ea45-ec5b-3866-be52-5871fd0f42c4",
                                                "text": "„Wie in keinem anderen Land in Europa hängt der schulische und berufliche Werdegang in Deutschland weiterhin vom Bildungsgrad und der Geldbörse des Elternhauses ab.“"
                                            },
                                            {
                                                "example_id": "3bea9b27-d342-47f5-927a-2fb30e2d4b0b",
                                                "sense_id": "e226ea45-ec5b-3866-be52-5871fd0f42c4",
                                                "text": "„Eine gute Beherrschung der deutschen Sprache ist die Voraussetzung für schulischen und beruflichen Erfolg.“"
                                            },
                                            {
                                                "example_id": "b417d8c0-9544-4cd7-b60b-35af51074530",
                                                "sense_id": "e226ea45-ec5b-3866-be52-5871fd0f42c4",
                                                "text": "„Zeugnisse zeigen Eltern, ob sich ihre Kinder schulisch auf dem richtigen Weg befinden.“"
                                            },
                                            {
                                                "example_id": "aa829396-0c6c-4402-a5d1-aec8d3e4c8b4",
                                                "sense_id": "e226ea45-ec5b-3866-be52-5871fd0f42c4",
                                                "text": "„In Deutschland wird zu wenig vorgelesen, sagt die Stiftung Lesen, obwohl es Kinder schulisch und in ihrer Entwicklung voranbringt.“"
                                            },
                                            {
                                                "example_id": "0d802936-c8ec-48ba-bef2-f68ace45c994",
                                                "sense_id": "e226ea45-ec5b-3866-be52-5871fd0f42c4",
                                                "text": "[Homeschooling in der Coronapandemie 2020:] „Vater Torsten Zarnikow macht sich Sorgen. […] Er hat Angst, dass seine Kinder schulisch abgehängt werden […].“"
                                            },
                                            {
                                                "example_id": "54bdfeba-4ad4-43e2-8418-15f452417c84",
                                                "sense_id": "e226ea45-ec5b-3866-be52-5871fd0f42c4",
                                                "text": "[Homeschooling in der Coronapandemie 2020:] „Stefanie hat Angst, dass die Schulen noch mal schließen und sie damit schlechter auf die Prüfungen vorbereitet wird. Im ersten \"Lockdown\" hat sie sich schulisch verschlechtert. […] Ihre Mutter kommt aus Ecuador, spricht nur wenig Deutsch und konnte sie in schulischen Angelegenheiten kaum unterstützen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ac6346a-28d9-464e-8b12-5171b60c0d93",
                        "source_entry_id": "6829ce42-a1e7-3251-a6ea-340990d6c8c6",
                        "source_sense_id": "326c89a5-cefd-34d2-9c00-69739f596f1c",
                        "source_sense_description": "zoals op school",
                        "target_lang_word": "schoolish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schoolish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f811192-8a2f-3ec1-a865-c164189c35eb",
                                        "entry_id": "6b3a5315-b41b-3172-b01f-b1c9bd7e2850",
                                        "glosses": [
                                            "Of or pertaining to school; scholastic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92e147a8-524d-40d1-b9f2-d4f785638326",
                                                "sense_id": "0f811192-8a2f-3ec1-a865-c164189c35eb",
                                                "text": "[...] it has studied the trend of the school, but not the trend of business, its leadership has been scholastic, not commercial. Today, commercial education finds itself of the school, schoolish, and not of the business house, business-like."
                                            },
                                            {
                                                "example_id": "ce09c59b-f0ce-4b03-b62d-6759639e619c",
                                                "sense_id": "0f811192-8a2f-3ec1-a865-c164189c35eb",
                                                "text": "By assessing this situation we have come to consider the dimensions of pedagogical–didactic interaction and communication that we, together with Antonio Viñao Frago (1996) and others, consider to be just as essential for examining the particular nature of schoolish institutions."
                                            },
                                            {
                                                "example_id": "5fdce885-5d05-4288-8449-f2f54713ec7e",
                                                "sense_id": "0f811192-8a2f-3ec1-a865-c164189c35eb",
                                                "text": "As a struggling student, Lo was fed up with “schoolish practices” and refused to perform for the sake of pleasing her teachers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16f21782-8ee4-32ed-9b74-1e277cc90d91",
                                        "entry_id": "6b3a5315-b41b-3172-b01f-b1c9bd7e2850",
                                        "glosses": [
                                            "Characteristic of school rather than real life; pedantic, pedagogical, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96f46563-1f76-4f97-ba2a-02a4a1ea1ec0",
                                                "sense_id": "16f21782-8ee4-32ed-9b74-1e277cc90d91",
                                                "text": "Its structure, which could strike one as derived from an arithmetic or geometry lesson, is schoolish, as is its content..."
                                            },
                                            {
                                                "example_id": "dbd2d6fc-e1a9-4b10-b2ca-e58758c7ae45",
                                                "sense_id": "16f21782-8ee4-32ed-9b74-1e277cc90d91",
                                                "text": "When we reflect on it, many of the things we teachers do are artificial and schoolish. They look very different from how real readers, writers, and speakers operate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1608c6fe-ca7d-463c-b540-3fdef4b5a151",
                        "source_entry_id": "6829ce42-a1e7-3251-a6ea-340990d6c8c6",
                        "source_sense_id": "326c89a5-cefd-34d2-9c00-69739f596f1c",
                        "source_sense_description": "zoals op school",
                        "target_lang_word": "scolaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scolaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "565c4cbd-e3d9-3eeb-9f5e-e11e33ff1757",
                                        "entry_id": "675d910b-d9f3-3a8f-9b0e-32dce0e74b45",
                                        "glosses": [
                                            "Qui se rapporte à l’école, que ce soit à l'enseignement qui y est prodigué, aux bâtiments qu'elle occupe ou aux personnes qui la fréquentent, notamment les élèves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08f7366f-e48a-4ac4-b8d8-d53990850bca",
                                                "sense_id": "565c4cbd-e3d9-3eeb-9f5e-e11e33ff1757",
                                                "text": "On étudiera également les possibilités d’épellation du malade pour des mots en rapport avec son niveau scolaire."
                                            },
                                            {
                                                "example_id": "4a5bf716-cd22-48f9-adbd-8f897b136fc7",
                                                "sense_id": "565c4cbd-e3d9-3eeb-9f5e-e11e33ff1757",
                                                "text": "Partout dans le monde les manuels scolaires sont quelque peu malmenés, dans des sens divers : les chantres de l'électronique en prédisent la disparition au profit du multimédia ; […]."
                                            },
                                            {
                                                "example_id": "d199bd5d-8e05-423c-bca7-d40065e23cb4",
                                                "sense_id": "565c4cbd-e3d9-3eeb-9f5e-e11e33ff1757",
                                                "text": "Laurence était une femme de très petite taille, un mètre trente à la toise du médecin scolaire, occupée à rassembler les enfants pour les faire rentrer dans le bâtiment."
                                            },
                                            {
                                                "example_id": "4cfcfd17-2213-4f69-9fda-dd25d137ebf1",
                                                "sense_id": "565c4cbd-e3d9-3eeb-9f5e-e11e33ff1757",
                                                "text": "Notre mot scolaire vient du grec scholè, qui signifie « loisir » : pouvait s'éduquer celui qui avait le loisir de le faire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aedb6072-716d-3749-b39b-0c63653233e2",
                                        "entry_id": "675d910b-d9f3-3a8f-9b0e-32dce0e74b45",
                                        "glosses": [
                                            "Qui se rapporte à un enseignement formaté, sans créativité."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4fab445-4a94-4ba1-bf90-c6c41618b746",
                                                "sense_id": "aedb6072-716d-3749-b39b-0c63653233e2",
                                                "text": "Arsène André étend ce mépris aux méthodes scolaires. […], une pédagogie qui refuse par système le bénéfice éprouvé des leçons sues par cœur."
                                            },
                                            {
                                                "example_id": "f15655c4-8b82-4b72-88b3-ab81b319fad0",
                                                "sense_id": "aedb6072-716d-3749-b39b-0c63653233e2",
                                                "text": "Au-delà des critiques que l’on pourrait faire sur les oublis et les libertés prises par rapport aux faits (Napoléon n’aurait jamais tiré des boulets de canon sur les pyramides) prises par le réalisateur, c’est son angle, ainsi que l’aspect scolaire et linéaire de son portrait, qui nous enlisent dans un certain ennui."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scolaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dad2e764-e2c4-3203-8095-9868aa7628c8",
                                        "entry_id": "ae2f81af-2082-3b9e-9555-ef851dd8b802",
                                        "glosses": [
                                            "Élève d'une école."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5da2869b-8fa7-4a5d-9a84-cb199d4bec47",
                                                "sense_id": "dad2e764-e2c4-3203-8095-9868aa7628c8",
                                                "text": "De fait, certains programmes de sciences participatives, comme « sauvages de ma rue » consacré aux fleurs et herbes folles qui colonisent les interstices de la ville, proposent depuis longtemps des formats pour les scolaires."
                                            },
                                            {
                                                "example_id": "bfd8fc6d-2dae-42ae-8235-515a8c879112",
                                                "sense_id": "dad2e764-e2c4-3203-8095-9868aa7628c8",
                                                "text": "Ils produisent ici un « miel de Nanterre », crémeux et délicieux, et forment des particuliers et des scolaires aux mystères du miel et aux rudiments de l'apiculture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f50c294f-4699-321c-bba3-2e2602273497",
                                        "entry_id": "ae2f81af-2082-3b9e-9555-ef851dd8b802",
                                        "glosses": [
                                            "Élève formaté étudiant selon la méthode apprise à l'école, mais sans créativité."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecbc5a27-0fc0-42e0-b6ce-6c266d4434df",
                                                "sense_id": "f50c294f-4699-321c-bba3-2e2602273497",
                                                "text": "Collégien en ZEP (zone d'éducation prioritaire) il traîne son ennui : il est le dernier de la classe. « Ce n'est pas un scolaire, se souvient Laurent l'un de ses copains d'enfance, mais il apprend rapidement ce qui l'intéresse. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
