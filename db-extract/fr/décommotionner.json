                "senses": [
                    {
                        "sense_id": "ec1264af-9b18-333d-99cf-b8f546576df5",
                        "entry_id": "24665926-5bfd-3a43-9ac0-3f5a2f382acf",
                        "glosses": [
                            "Rétablir d’une commotion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae76055a-192b-41c6-9b22-7f617e4d01b7",
                                "sense_id": "ec1264af-9b18-333d-99cf-b8f546576df5",
                                "text": "Cette petite cérémonie contribua plus que tout le reste à décommotionner ma sœur."
                            },
                            {
                                "example_id": "cbb682b4-af25-4cb0-b047-371b0582b073",
                                "sense_id": "ec1264af-9b18-333d-99cf-b8f546576df5",
                                "text": "Par les affaires d’un maître de manoir, avec des propriétés à approprier, des exploits à exploiter, des procès à procéder, des fermages à affermer, de la mangeaille à manger, de la monnaie à monnayer, des bateaux à bateler, des visites à faire et des visites à rendre, des hôtes à hôter, des dispositions à disposer, des articles à articuler dans l'inventaire, des commotions à décommotionner, le temps à… tuer, et tout le tintouin, tout le foutu fastidieux fatigant tintouin."
                            }
                        ]
                    }
