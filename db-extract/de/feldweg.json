                        ]
                    },
                    {
                        "translation_id": "3b7d527b-b388-4f4d-b316-63a3bc92ef59",
                        "source_entry_id": "b76a61bb-392d-3c24-804d-cdad15c82f46",
                        "source_sense_id": "dde23d49-c9d1-3c90-ae20-f3ffad398ce6",
                        "source_sense_description": "schmaler, meist unbefestigter Weg zwischen Feldern",
                        "target_lang_word": "chemin de terre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chemin de terre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d96f3d8c-2e58-31d8-ad95-f45fbcde56f3",
                                        "entry_id": "34db712a-73ca-3ae9-b462-5b2e32986fff",
                                        "glosses": [
                                            "Sorte de chemin rural qui parcourt un terroir et dont la chaussée en terre (avec ou sans ornières)"
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74a4cc2f-7801-47ad-a6f2-a9348bcacaf4",
                                                "sense_id": "d96f3d8c-2e58-31d8-ad95-f45fbcde56f3",
                                                "text": "Après avoir dépassé Mazerny, les véhicules avaient emprunté les chemins de terre et les bois. Le bruit du canon se rapprochait de plus en plus et au loin, Malétras apercevait des rougeurs et des fusées."
                                            },
                                            {
                                                "example_id": "f9901018-9883-4e16-ac6a-886e156d4899",
                                                "sense_id": "d96f3d8c-2e58-31d8-ad95-f45fbcde56f3",
                                                "text": "Avant 1987, la route pavée en provenance de Stephenville s'arrêtait à Lourdes, tandis que ses prolongements vers La Grand’Terre au sud et L’Anse-à-Canards au nord n'étaient que des chemins de terre, parfois goudronnés, toujours pleins d'ornières."
                                            },
                                            {
                                                "example_id": "ede48c2a-7723-43d8-8343-c0a54d9aae02",
                                                "sense_id": "d96f3d8c-2e58-31d8-ad95-f45fbcde56f3",
                                                "text": "Un ami raconte qu’il a pris soin de descendre au village voisin par le sentier mais qu’il s’est fait repérer par la maréchaussée sur un chemin de terre. Heureusement, il avait son attestation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7dc89e05-6a90-42e8-89f8-6be930f6c22c",
