                "senses": [
                    {
                        "sense_id": "8f90bb4b-8535-3ee5-a6c8-0f42d17f1ea7",
                        "entry_id": "ecde095c-4c32-3be5-a2db-e6f015a1d4d5",
                        "glosses": [
                            "so, dass es nicht bezogen werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2a0e8f1-f331-4983-b0e9-9bb6cfec504d",
                                "sense_id": "8f90bb4b-8535-3ee5-a6c8-0f42d17f1ea7",
                                "text": "„Amerikas Botschaftsneubau in der russischen Hauptstadt, hieß es in Washington, sei nicht nur wegen baulicher Mängel (»Es regnet 'rein«) unbeziehbar, sondern mit hochmodernen Abhörgeräten derart durchsetzt, daß der bisher 200 Millionen Dollar teure Bau eigentlich abgerissen werden müsse.“"
                            },
                            {
                                "example_id": "70b1011e-c5a6-421c-8076-6e8e376f5e65",
                                "sense_id": "8f90bb4b-8535-3ee5-a6c8-0f42d17f1ea7",
                                "text": "„Die Kinder hätten nun zwar wieder Spielsachen, doch der Kindergarten sei nach wie vor unbeziehbar.“"
                            },
                            {
                                "example_id": "47cbd9b9-f803-4a29-9810-1b2e34c1fd28",
                                "sense_id": "8f90bb4b-8535-3ee5-a6c8-0f42d17f1ea7",
                                "text": "„Zum Glück wurde bei dem Feuer, das am späten Abend des vergangenen Sonntags in der Flüchtlingsunterkunft an der Wittener Straße ausbrach, niemand verletzt. Doch bis zum Abschluss der Sanierung bleiben alle Wohnungen unbeziehbar.“"
                            },
                            {
                                "example_id": "ffd30402-1295-4216-91d9-bbf27e6697d0",
                                "sense_id": "8f90bb4b-8535-3ee5-a6c8-0f42d17f1ea7",
                                "text": "„[Spatzen] belegen vor allem ältere Naturnester und machen diese für Mehlschwalben unbeziehbar. Kunstnester sind hingegen zumindest in den ersten Jahren wegen der zu schmalen Einflugöffnung für Spatzen nicht zugänglich.“"
                            },
                            {
                                "example_id": "0a9a706d-ccba-4517-9d34-903611dda76a",
                                "sense_id": "8f90bb4b-8535-3ee5-a6c8-0f42d17f1ea7",
                                "text": "„Neben der Einsturzgefahr hat der Rauch zumindest die an die Brandwohnung angrenzenden Quartiere unbeziehbar gemacht.“"
                            },
                            {
                                "example_id": "b4076086-7426-4e98-98c3-b6a55d4fc88d",
                                "sense_id": "8f90bb4b-8535-3ee5-a6c8-0f42d17f1ea7",
                                "text": "„Deutsche Modelsammlungen sind heute so gut wie unbeziehbar, weder Siemens noch TFK noch Intermetal Modelbanken gibt es noch aktuell.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
