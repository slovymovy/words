                "senses": [
                    {
                        "sense_id": "a7823f41-ca2a-384d-9dff-8b4e894ea1c6",
                        "entry_id": "835ffd22-7ce2-36cb-8b8d-349789fd8b9a",
                        "glosses": [
                            "weibliche Person, die eine Gruppe leitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8befae0-e0eb-4015-b828-d219e6083d2d",
                                "sense_id": "a7823f41-ca2a-384d-9dff-8b4e894ea1c6",
                                "text": "Sie ist die Anführerin der Räuberbande."
                            },
                            {
                                "example_id": "247fb4d5-a7d9-48f1-aeda-b8c6d4849589",
                                "sense_id": "a7823f41-ca2a-384d-9dff-8b4e894ea1c6",
                                "text": "„Als Anführerin einer Bande brauchte man einen klaren Kopf und musste in jeder Situation absolute Ruhe bewahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9837e4b6-627d-367c-ab63-35ee2ce5429a",
                        "entry_id": "835ffd22-7ce2-36cb-8b8d-349789fd8b9a",
                        "glosses": [
                            "weibliche Person oder Gruppe weiblicher Individuen (oder auch Person/Gruppe, deren grammatisches Genus das Femininum ist), die den ersten Platz eines noch nicht entschiedenen Ereignisses belegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c504c563-7bbc-4398-9988-60a8cc0aa16b",
                                "sense_id": "9837e4b6-627d-367c-ab63-35ee2ce5429a",
                                "text": "Eine der Begleitpersonen ist die Anführerin, die andere bildet sozusagen die Nachhut."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
