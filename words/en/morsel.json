{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c0d7e5ee-d182-34da-af6b-3903805dc8fc",
                    "sense_definition": "A small piece or amount of something, especially food.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "small_amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hungry dog waited patiently for a <w>morsel</w> of food to fall from the table.",
                            "target_lang_translations": {
                                "cs": "Hladový pes trpělivě čekal, až ze stolu spadne <w>sousto</w> jídla."
                            }
                        },
                        {
                            "text": "She enjoyed every delicious <w>morsel</w> of the cake she had baked for the party.",
                            "target_lang_translations": {
                                "cs": "Vychutnala si každý lahodný <w>kousek</w> dortu, který upekla na oslavu."
                            }
                        }
                    ],
                    "synonyms": [
                        "bit",
                        "crumb",
                        "tidbit",
                        "scrap"
                    ],
                    "common_phrases": [
                        "tasty morsel"
                    ],
                    "target_lang_definitions": {
                        "cs": "Malý kousek nebo množství něčeho, zejména jídla."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "sousto",
                                "target_lang_sense_clarification": "množství jídla na jedno polknutí"
                            },
                            {
                                "target_lang_word": "kousek",
                                "target_lang_sense_clarification": "obecné označení pro malý fragment"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a3237b3-ae72-32d8-a91d-007d117a6350",
                    "sense_definition": "A very small quantity or trace of something abstract.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "small_amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was not a <w>morsel</w> of truth in his entire story.",
                            "target_lang_translations": {
                                "cs": "V celém jeho příběhu nebyla ani <w>špetka</w> pravdy."
                            }
                        },
                        {
                            "text": "He did not show a <w>morsel</w> of regret for his actions.",
                            "target_lang_translations": {
                                "cs": "Neprojevil ani <w>náznak</w> lítosti nad svými činy."
                            }
                        }
                    ],
                    "synonyms": [
                        "iota",
                        "trace",
                        "shred",
                        "whit"
                    ],
                    "target_lang_definitions": {
                        "cs": "Velmi malé množství nebo náznak něčeho abstraktního."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "špetka",
                                "target_lang_sense_clarification": "malé množství, často používané v přeneseném významu"
                            },
                            {
                                "target_lang_word": "náznak",
                                "target_lang_sense_clarification": "velmi malá stopa nebo projev něčeho"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d78dad9b-fda7-32d7-ad1a-1e5379eab300",
                    "sense_definition": "To divide something into small pieces.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef began to <w>morsel</w> the bread into tiny portions for the soup.",
                            "target_lang_translations": {
                                "cs": "Šéfkuchař začal <w>rozkouskovávat</w> chléb na malé porce do polévky."
                            }
                        },
                        {
                            "text": "They had to <w>morsel</w> the large block of cheese to serve all the guests.",
                            "target_lang_translations": {
                                "cs": "Museli velký blok sýra <w>rozkouskovat</w>, aby obsloužili všechny hosty."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Rozdělit něco na malé kousky."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "rozkouskovat",
                                "target_lang_sense_clarification": "rozdělit na menší části"
                            },
                            {
                                "target_lang_word": "nadrobit",
                                "target_lang_sense_clarification": "rozdělit na drobné kousky (zejména u pečiva)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}