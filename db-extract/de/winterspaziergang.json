                ],
                "senses": [
                    {
                        "sense_id": "b0092369-ec1b-371c-bee9-895652927e59",
                        "entry_id": "d8442f2c-f674-3d0c-bdf9-803c801d7642",
                        "glosses": [
                            "Spaziergang im Winter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c191f5ae-cb35-46dd-89e6-d8663bd5fb8a",
                                "sense_id": "b0092369-ec1b-371c-bee9-895652927e59",
                                "text": "Wir genossen unseren ruhigen Winterspaziergang im verschneiten Wäldchen."
                            },
                            {
                                "example_id": "046346a0-690c-48b8-825a-e47ddab5aa01",
                                "sense_id": "b0092369-ec1b-371c-bee9-895652927e59",
                                "text": "„Es kribbelt schon eine ganze Weile, die Unruhe, endlich wieder einmal zu einem endlos weiten Winterspaziergang aufzubrechen, ist riesengroß. Viel zu lang ist es her, seit zuletzt Gelegenheit da war, wohlig eingepackt und gedankenverloren über weiße Felder zu schlendern, stundenlang kein Ziel zu haben als nur den kaum begangenen Wanderweg selbst.“"
                            },
                            {
                                "example_id": "34b06b3c-b070-45e0-abf9-bbbf2ce353b3",
                                "sense_id": "b0092369-ec1b-371c-bee9-895652927e59",
                                "text": "„Wenn Sie einen Winterspaziergang durch ein Waldstück, einen Park, entlang einer Straße mit Hecken oder durch eine Allee – also überall dort, wo Bäume oder Gehölze ziemlich eng beieinanderstehen – machen, werden Sie vielleicht erst einmal denken, dass sich dort gar keine Vögel aufhalten.“"
                            },
                            {
                                "example_id": "658944f2-f4e3-493c-991e-fd9b4974c9a8",
                                "sense_id": "b0092369-ec1b-371c-bee9-895652927e59",
                                "text": "„Auch schön für einen Winterspaziergang sind die Schären, wenn die Klippen und Wiesen vom Weiß bedeckt sind und das flache Wasser am Ufer in Eis erstarrt ist.“"
                            },
                            {
                                "example_id": "9cd3e7b1-bcc2-434d-bb4b-46a14ea9d4f5",
                                "sense_id": "b0092369-ec1b-371c-bee9-895652927e59",
                                "text": "„Ich genoss die paar Tage daheim in meinem stillen tief verschneiten Tal und machte viele Winterspaziergänge zu meinen Verwandten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
