                    {
                        "sense_id": "1de133d7-8d95-38b3-9336-abd60432a4ac",
                        "entry_id": "ff24952b-6bc0-3585-b6ff-5fc8eb1002e2",
                        "glosses": [
                            "Een landkaart waarop de wegen nadrukkelijk staan aangegeven."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2affb03a-4524-4ccd-8729-7918ce0e3871",
                                "sense_id": "1de133d7-8d95-38b3-9336-abd60432a4ac",
                                "text": "Vrouwen draaien een wegenkaart altijd zo dat de rijrichting bovenaan is."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "084f7880-baab-4235-8e69-609cef7d2dd8",
                        "source_entry_id": "ff24952b-6bc0-3585-b6ff-5fc8eb1002e2",
                        "source_sense_id": "1de133d7-8d95-38b3-9336-abd60432a4ac",
                        "target_lang_word": "Straßenkarte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Straßenkarte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8d3d4e55-5fb2-345d-b373-7a3b283ef216",
                                        "entry_id": "bf1695d7-a28f-39b1-bac5-0b7f816bcdca",
                                        "glosses": [
                                            "eine Landkarte, auf der vorrangig die Straßen eingetragen sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86722333-2b57-4bb3-860c-c1a575b7785d",
                                                "sense_id": "8d3d4e55-5fb2-345d-b373-7a3b283ef216",
                                                "text": "Diese Straßenkarte ist veraltet; es fehlen Teilstücke der Fernstraße."
                                            },
                                            {
                                                "example_id": "fd2d6956-7c33-461b-9b37-c44ea44d91f4",
                                                "sense_id": "8d3d4e55-5fb2-345d-b373-7a3b283ef216",
                                                "text": "„Die früheste Straßenkarte Mitteleuropas ist die 1500 anlässlich des Heiligen Jahres gedruckte Romwegkarte von Erhard Etzlaub.“"
                                            },
                                            {
                                                "example_id": "e048e6f6-3fb8-4b8e-8827-12d4801f3818",
                                                "sense_id": "8d3d4e55-5fb2-345d-b373-7a3b283ef216",
                                                "text": "„Falk hatte in Deutschland eine Straßenkarte für Äthiopien besorgt.“"
                                            },
                                            {
                                                "example_id": "b8be65c6-ecfd-4503-b0d5-9138fd9179f9",
                                                "sense_id": "8d3d4e55-5fb2-345d-b373-7a3b283ef216",
                                                "text": "„Ich kaufte mir eine Straßenkarte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60ca39a7-46c0-46d6-8055-b8496c5c847e",
                        "source_entry_id": "ff24952b-6bc0-3585-b6ff-5fc8eb1002e2",
                        "source_sense_id": "1de133d7-8d95-38b3-9336-abd60432a4ac",
