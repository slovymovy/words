                        "entry_id": "276c8313-dcb2-3bed-9b56-a98ee3cad2b4",
                        "glosses": [
                            "η υγειονομική περίθαλψη, οι υπηρεσίες που παρέχουν ιατρική περίθαλψη"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e923dd2-e018-42e5-8f39-366aee42c4d6",
                                "sense_id": "9fb06756-9e11-38c6-a77e-ed535ee79443",
                                "text": "Healthcare in our country has improved in recent years.",
                                "translation": "Η υγειονομική περίθαλψη στη χώρα μας έχει βελτιωθεί τα τελευταία χρόνια."
                            },
                            {
                                "example_id": "de2c772f-6085-4247-bba1-d517b7f9ebbd",
                                "sense_id": "9fb06756-9e11-38c6-a77e-ed535ee79443",
                                "text": "Private clinics offer fast healthcare, but at a higher cost.",
                                "translation": "Οι ιδιωτικές κλινικές προσφέρουν γρήγορη υγειονομική περίθαλψη, αλλά με υψηλότερο κόστος."
                            },
                            {
                                "example_id": "fbf9491e-3bce-43ce-898b-d39f678c4854",
                                "sense_id": "9fb06756-9e11-38c6-a77e-ed535ee79443",
                                "text": "Citizens have the right to healthcare regardless of their financial situation.",
                                "translation": "Οι πολίτες έχουν δικαίωμα στην υγειονομική περίθαλψη ανεξαρτήτως οικονομικής κατάστασης."
                            },
                            {
                                "example_id": "c15114d8-3ead-4ca9-86e6-0e2ecae4985f",
                                "sense_id": "9fb06756-9e11-38c6-a77e-ed535ee79443",
                                "text": "The government is restructuring the healthcare system to make it more efficient.",
                                "translation": "Η κυβέρνηση αναδιαρθρώνει το σύστημα υγείας για να γίνει πιο αποτελεσματικό."
                            }
                        ]
                    }
