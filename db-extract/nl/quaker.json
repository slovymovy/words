                                        "entry_id": "d5f1e202-a6dd-35c8-ac77-4709fb5eeac6",
                                        "glosses": [
                                            "Mitglied einer christlichen Religionsgemeinschaft, die vor allem in den englischsprachigen Teilen der Welt und in Afrika Verbreitung fand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb2b1422-d91a-4f77-86fe-daf2a87ef28f",
                                                "sense_id": "c9c95626-d329-398c-a399-75d83c8dcef0",
                                                "text": "„Diese beiden verkleidete William als Quäker und brachte ihnen bei, wie solche zu sprechen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
