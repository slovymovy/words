{
    "word_family": [
        "assess",
        "assessor",
        "reassessment",
        "assessable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "626cd684-276e-3c7a-a0c9-2f1af49754ed",
                    "sense_definition": "An appraisal or evaluation of the nature, quality, or ability of someone or something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "evaluation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher wrote a detailed <w>assessment</w> of the student's progress this term.",
                            "target_lang_translations": {
                                "ru": "Учитель написал подробную <w>оценку</w> успеваемости ученика в этом семестре.",
                                "zh": "老师写了一份关于该学生本学期进步情况的详细<w>评估</w>。"
                            }
                        },
                        {
                            "text": "We need to perform a risk <w>assessment</w> before we can approve the new project.",
                            "target_lang_translations": {
                                "ru": "Нам нужно провести <w>оценку</w> рисков, прежде чем мы сможем утвердить новый проект.",
                                "zh": "在批准新项目之前，我们需要进行风险<w>评估</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "evaluation",
                        "appraisal",
                        "judgment",
                        "estimation",
                        "analysis"
                    ],
                    "common_phrases": [
                        "risk assessment",
                        "needs assessment",
                        "impact assessment",
                        "initial assessment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оценка или анализ характера, качества или способностей кого-либо или чего-либо.",
                        "zh": "对某人或某事物的性质、质量或能力的评价或估量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оценка",
                                "target_lang_sense_clarification": "мнение, суждение о качестве"
                            },
                            {
                                "target_lang_word": "оценивание",
                                "target_lang_sense_clarification": "процесс определения качества"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "评估",
                                "target_lang_sense_clarification": "对事物价值或质量的系统性分析"
                            },
                            {
                                "target_lang_word": "评价",
                                "target_lang_sense_clarification": "对人或事物的判断或看法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77bd4bdd-a286-3433-9a72-a60e2c4d756c",
                    "sense_definition": "The specific amount of money determined to be payable, typically for taxes or other official charges.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "financial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He received a tax <w>assessment</w> that was much higher than he had anticipated.",
                            "target_lang_translations": {
                                "ru": "Он получил налоговое <w>начисление</w>, которое оказалось намного выше, чем он ожидал.",
                                "zh": "他收到的税款<w>核定</w>比他预期的要高得多。"
                            }
                        },
                        {
                            "text": "The property <w>assessment</w> determines how much the owners must pay to the city each year.",
                            "target_lang_translations": {
                                "ru": "<w>Оценка</w> недвижимости определяет, сколько владельцы должны платить городу каждый год.",
                                "zh": "房产<w>评估</w>决定了业主每年必须向城市缴纳多少费用。"
                            }
                        }
                    ],
                    "synonyms": [
                        "levy",
                        "charge"
                    ],
                    "common_phrases": [
                        "tax assessment",
                        "self assessment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретная сумма денег, определенная к уплате, обычно в виде налогов или сборов.",
                        "zh": "确定的应缴金额，通常指税款或其他官方费用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оценка",
                                "target_lang_sense_clarification": "определение стоимости имущества"
                            },
                            {
                                "target_lang_word": "начисление",
                                "target_lang_sense_clarification": "сумма налога или сбора"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "核定",
                                "target_lang_sense_clarification": "官方对税额或费用的核定"
                            },
                            {
                                "target_lang_word": "税额",
                                "target_lang_sense_clarification": "应缴纳的税款金额"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}