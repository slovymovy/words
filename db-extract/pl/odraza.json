                "senses": [
                    {
                        "sense_id": "86ded64e-a73a-3ab2-bfc7-502f4b6f4699",
                        "entry_id": "fae25a2e-084e-30a0-a799-2975d0a2b6c5",
                        "glosses": [
                            "uczucie wstrętu, obrzydzenia, niechęci do kogoś lub czegoś"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44c4419c-aeb1-4fcf-8977-b5478ffbf8d5",
                                "sense_id": "86ded64e-a73a-3ab2-bfc7-502f4b6f4699",
                                "text": "Wystające włosy z nosa budzą we mnie odrazę."
                            },
                            {
                                "example_id": "2f8414a9-5248-4807-b977-63befc56573e",
                                "sense_id": "86ded64e-a73a-3ab2-bfc7-502f4b6f4699",
                                "text": "Odrazę wzbudzam u bliskich, / nastają na mnie kochani"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "50456e83-b8a9-4938-878b-6f3cba37b993",
                        "source_entry_id": "fae25a2e-084e-30a0-a799-2975d0a2b6c5",
                        "source_sense_id": "86ded64e-a73a-3ab2-bfc7-502f4b6f4699",
                        "target_lang_word": "disgust",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disgust",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "954a3684-0fee-3374-86e3-5412d73f36fc",
                                        "entry_id": "dbe037de-479d-3247-ae69-deb7a8e707fa",
                                        "glosses": [
                                            "To cause an intense dislike for something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d29b74f-85d8-4fb7-9b08-ff01667ea6d2",
                                                "sense_id": "954a3684-0fee-3374-86e3-5412d73f36fc",
                                                "text": "It disgusts me to see her chew with her mouth open."
                                            },
                                            {
                                                "example_id": "65fd8c42-b8b2-4ec0-9142-b488cbfa50f4",
                                                "sense_id": "954a3684-0fee-3374-86e3-5412d73f36fc",
                                                "text": "Tuc[ca]. […] Can thy Author doe it impudently enough? / Hiſt[rio]. O, I warrant you, Captaine: and ſpitefully inough too; he ha's one of the moſt ouerflowing villanous wits, in Rome. He will ſlander any man that breathes; If he diſguſt him. / Tucca. I'le know the poor, egregious, nitty Raſcall; and he haue ſuch commendable Qualities, I'le cheriſh him: […]"
                                            },
                                            {
                                                "example_id": "6c4df528-51da-4a0d-af0e-fadf09e11a6a",
                                                "sense_id": "954a3684-0fee-3374-86e3-5412d73f36fc",
                                                "text": "Mud This is a very specious piece of business; and above my implication—Dear me—dear me—what a thing it is, that one never can disgust one’s meals in peace—but one must be torn piecemeal with defamations—convocations—and other informalities—If I’d any of the fees and requisites of office for my pains—it would be a different thing—but every body knows I’m an ignoramous, and commit justice gratis—I must disperse the complaint."
                                            },
                                            {
                                                "example_id": "4fbd8aee-0860-481f-89d3-e011f510ab47",
                                                "sense_id": "954a3684-0fee-3374-86e3-5412d73f36fc",
                                                "text": "1874, Marcus Clarke, For the Term of His Natural Life Chapter V\nIt is impossible to convey, in words, any idea of the hideous phantasmagoria of shifting limbs and faces which moved through the evil-smelling twilight of this terrible prison-house. Callot might have drawn it, Dante might have suggested it, but a minute attempt to describe its horrors would but disgust."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "disgust",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7f1f533-596c-3c76-b3cd-57e066e5eafc",
                                        "entry_id": "69300267-907c-34be-90f1-343193572dc0",
                                        "glosses": [
                                            "An intense dislike or loathing someone feels for something bad or nasty."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f0c47f2-9c9f-4cb1-97e1-6989601ac8a0",
                                                "sense_id": "b7f1f533-596c-3c76-b3cd-57e066e5eafc",
                                                "text": "With an air of disgust, she stormed out of the room."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa8493fb-f2e4-4396-b44d-ef0760101b01",
                        "source_entry_id": "fae25a2e-084e-30a0-a799-2975d0a2b6c5",
                        "source_sense_id": "86ded64e-a73a-3ab2-bfc7-502f4b6f4699",
                        "target_lang_word": "отвращение",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "отвращение",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b2d58f58-636b-304b-b0d5-cf782f4af3b6",
                                        "entry_id": "51a717ef-58b1-3cd5-a315-3b8dbed5267b",
                                        "glosses": [
                                            "устар. действие по значению гл. отвращать, отвратить"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c68b467e-c863-4245-803d-c6f943eedabe",
                                                "sense_id": "b2d58f58-636b-304b-b0d5-cf782f4af3b6",
                                                "text": "Он думал, что клятва церковная достаточна для отвращения людей слабых от подобных заблуждений."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5de3acfe-cb9f-3426-8c3c-2592fab20bf0",
                                        "entry_id": "51a717ef-58b1-3cd5-a315-3b8dbed5267b",
                                        "glosses": [
                                            "устар. предотвращение, устранение чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8115e20-4c42-46b9-931a-0a9d26a6409e",
                                                "sense_id": "5de3acfe-cb9f-3426-8c3c-2592fab20bf0",
                                                "text": "Попечительное начальство приняло все меры для отвращения голода и монополий перекупщиков."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afebba55-fdb1-3e19-a2d6-32ceb157958b",
                                        "entry_id": "51a717ef-58b1-3cd5-a315-3b8dbed5267b",
                                        "glosses": [
                                            "крайняя неприязнь, в высшей степени отрицательное чувство по отношению к кому-либо или чему-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4b5779d-2c63-4bfe-b3dc-0c7a49a44bf8",
                                                "sense_id": "afebba55-fdb1-3e19-a2d6-32ceb157958b",
                                                "text": "И с отвращением читая жизнь мою, // Я трепещу и проклинаю, // И горько жалуюсь, и горько слёзы лью, // Но строк печальных не смываю."
                                            },
                                            {
                                                "example_id": "8f70e328-ec85-45f8-8eff-fe5843aa475d",
                                                "sense_id": "afebba55-fdb1-3e19-a2d6-32ceb157958b",
                                                "text": "И почувствовал к ней отвращение и дал себе слово стать другим человеком."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
