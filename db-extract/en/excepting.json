                "senses": [
                    {
                        "sense_id": "8dc5390b-7bc8-3dfa-9827-2a6bcca9d930",
                        "entry_id": "778e231b-fd32-390c-a442-90a3a02fe89f",
                        "glosses": [
                            "with the exception of"
