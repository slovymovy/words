                "senses": [
                    {
                        "sense_id": "b4fc8038-5585-3fd8-9440-cc3b7f0679b0",
                        "entry_id": "9c002562-d40b-31be-ae24-a6d87c8c6f5c",
                        "glosses": [
                            "Donner un caractère siamois à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f904033-3234-48c4-831f-b5dbb4804e33",
                                "sense_id": "b4fc8038-5585-3fd8-9440-cc3b7f0679b0",
                                "text": "Rien n’était fait pour siamiser ces populations qui conservaient leur langue, leurs coutumes, leur religion, leurs prêtres, et jusqu’à la façon de construire leurs demeures."
                            },
                            {
                                "example_id": "b55945be-95a8-4f5e-ad63-1c6151ef4bed",
                                "sense_id": "b4fc8038-5585-3fd8-9440-cc3b7f0679b0",
                                "text": "Depuis son intégration en 1902, les Thaïs s’efforcent de siamiser les quatre provinces qui le constituaient (Pattani, Yala, Narathivvat et Satun), en imposant des écoles et des noms thaïs."
                            }
                        ]
                    }
