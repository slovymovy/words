{
    "word_family": [
        "vergelijking",
        "vergelijkbaar"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bd894bd8-9ba7-3844-b7aa-ef9744c7de9e",
                    "sense_definition": "Een minnelijke schikking of overeenkomst tussen partijen om een conflict te beëindigen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "overeenkomst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De twee partijen troffen een <w>vergelijk</w> waardoor de crisissituatie werd verholpen.",
                            "target_lang_translations": {
                                "en": "The two parties reached a <w>settlement</w> that resolved the crisis situation."
                            }
                        },
                        {
                            "text": "Na lang onderhandelen bereikten zij eindelijk een <w>vergelijk</w> over de verdeling van de kosten.",
                            "target_lang_translations": {
                                "en": "After long negotiations, they finally reached a <w>compromise</w> regarding the distribution of costs."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vergelijk treffen"
                    ],
                    "target_lang_definitions": {
                        "en": "An amicable settlement or agreement between parties to end a conflict."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "settlement",
                                "target_lang_sense_clarification": "A formal agreement to resolve a dispute."
                            },
                            {
                                "target_lang_word": "compromise",
                                "target_lang_sense_clarification": "An agreement reached by each side making concessions."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a7b2af7c-6fe6-3ea3-be6e-22cf1fd854c7",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>vergelijken</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>vergelijk</w> de prijzen van deze twee producten in de winkel.",
                            "target_lang_translations": {
                                "en": "I <w>compare</w> the prices of these two products in the store."
                            }
                        },
                        {
                            "text": "Elke dag <w>vergelijk</w> ik mijn resultaten met die van mijn collega.",
                            "target_lang_translations": {
                                "en": "Every day I <w>compare</w> my results with those of my colleague."
                            }
                        }
                    ],
                    "synonyms": [
                        "verg.",
                        "vgl."
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Vervoeging van het werkwoord vergelijken"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First person singular present tense of 'to compare'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "compare",
                                "target_lang_sense_clarification": "To examine the differences or similarities between things."
                            }
                        ]
