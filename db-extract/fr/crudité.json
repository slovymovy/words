                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fda7fde-1d2e-4d36-a895-8b37395c872d",
                                                "sense_id": "d9bf713c-418b-3ff2-8b8f-ade83b255a48",
                                                "text": "For there is no meat whatſoeuer, though otherwiſe wholeſome and good, but if it be vnſeaſonably taken, or immoderatly vſed, more then the ſtomack can well beare, will ingender crudity, and doe much harme."
                                            }
                                        ]
                                    }
