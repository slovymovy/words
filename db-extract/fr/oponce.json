            {
                "entry_id": "6fa29556-c34e-368d-9999-b715fefd5be2",
                "word": "oponce",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3c02edea-c27f-4556-8b88-e761ea5a190b",
                        "entry_id": "6fa29556-c34e-368d-9999-b715fefd5be2",
                        "tags": [
                            "plural"
