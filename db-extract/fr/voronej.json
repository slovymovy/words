                                        "glosses": [
                                            "город в европейской части России, областной центр Воронежской области"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b341d62c-9c79-42c7-9050-3c26cc804a0e",
