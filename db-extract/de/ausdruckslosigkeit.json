                    {
                        "sense_id": "28011ecb-8325-3787-b6e2-c824072eeada",
                        "entry_id": "06ee4990-9364-31ea-aeed-e5c552f7d5c4",
                        "glosses": [
                            "die Eigenschaft, ausdruckslos zu sein"
