        "fr-extract.jsonl": [
            {
                "entry_id": "2022dbc1-7e1b-34e3-9ac1-88171b944d06",
                "word": "surplace",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "df4b4361-5604-4ca8-a528-de2060479cc6",
                        "entry_id": "2022dbc1-7e1b-34e3-9ac1-88171b944d06",
                        "tags": [
                            "plural"
                        ],
                        "form": "surplaces"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b79b2f70-af61-3fe9-8f69-c5ca9d0b07b0",
                        "entry_id": "2022dbc1-7e1b-34e3-9ac1-88171b944d06",
                        "glosses": [
                            "Immobilité, absence de progression."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad73e376-12bb-41dc-8cf9-deff22b8d145",
                                "sense_id": "b79b2f70-af61-3fe9-8f69-c5ca9d0b07b0",
                                "text": "La réforme du permis de conduire, entre surplace et marche arrière."
                            },
                            {
                                "example_id": "a882e05d-0b66-4036-a138-8722d89f0911",
                                "sense_id": "b79b2f70-af61-3fe9-8f69-c5ca9d0b07b0",
                                "text": "Le surplace économique de la classe moyenne."
                            },
                            {
                                "example_id": "fb925e3c-ba69-4e6b-951c-faea510a3e43",
                                "sense_id": "b79b2f70-af61-3fe9-8f69-c5ca9d0b07b0",
                                "text": "Des surplaces reggae indolents aux accélérations rock percussives et percutantes, le rythme de croisière oscille toujours entre tangage et roulis."
                            },
                            {
                                "example_id": "c38d540b-d0fc-4b6c-9af8-97f115f36c9f",
                                "sense_id": "b79b2f70-af61-3fe9-8f69-c5ca9d0b07b0",
                                "text": "Si le Québec fait du surplace pour la création d’aires protégées, notamment dans le sud, c’est beaucoup en raison d’une mainmise de son ministère."
                            }
                        ]
                    },
                    {
                        "sense_id": "44c6c9a8-dfd1-34b7-8b37-76669b17333b",
                        "entry_id": "2022dbc1-7e1b-34e3-9ac1-88171b944d06",
                        "glosses": [
                            "Position en équilibre immobile où le coureur a les deux pieds sur les pédales."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "100b0a48-202e-4136-95d6-433a134cd8e1",
                                "sense_id": "44c6c9a8-dfd1-34b7-8b37-76669b17333b",
                                "text": "Le départ du track s’effectue en surplace et le coureur accélère le plus rapidement possible jusqu’à la vitesse maximum, et la maintient, si possible, jusqu’à la ligne d’arrivée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f0e0b10-8f64-46c3-8bf5-a6af9b168e77",
                        "source_entry_id": "2022dbc1-7e1b-34e3-9ac1-88171b944d06",
                        "source_sense_description": "Absence de progression",
                        "target_lang_word": "Stillstand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stillstand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9d926c54-937d-397a-aca5-8c88ddfd76c4",
                                        "entry_id": "9913e17d-7615-3bfe-90c5-4955e09f0210",
                                        "glosses": [
                                            "Ende einer Bewegung, eines Prozesses/Vorgangs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "433cdc29-43da-4cb3-a4bc-107919c75c3c",
                                                "sense_id": "9d926c54-937d-397a-aca5-8c88ddfd76c4",
                                                "text": "Wegen der Schäden an den Anlagen kam es zu einem Stillstand der Produktion."
                                            },
                                            {
                                                "example_id": "1de5832f-5f64-4224-9d30-72c793204b19",
                                                "sense_id": "9d926c54-937d-397a-aca5-8c88ddfd76c4",
                                                "text": "„Tatsächlich war der Zug schon nach wenigen hundert Metern wieder zum Stillstand gekommen, so daß die Frau ihr Buch hatte sinken lassen.“"
                                            },
                                            {
                                                "example_id": "1e8af26a-b6a9-46f1-99a8-3b197fca610a",
                                                "sense_id": "9d926c54-937d-397a-aca5-8c88ddfd76c4",
                                                "text": "„In erster Linie hatte er dafür gesorgt, dass die starke Blutung aus dem Oberschenkel des Halbtoten zum Stillstand kam, und dann den gebrochenen rechten Unterarm stabilisiert.“"
                                            },
                                            {
                                                "example_id": "ed97b5cc-73e0-4eed-8c76-24e5f1c153d7",
                                                "sense_id": "9d926c54-937d-397a-aca5-8c88ddfd76c4",
                                                "text": "„Dies schafft auf der einen Seite einen sehr engen gesellschaftlichen Zusammenhang innerhalb einer biraderi-Einheit. Es wirkt aber auf der anderen Seite auch häufig als Blockade und bedingt weitgehenden gesellschaftlichen Stillstand in den ländlichen Regionen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86479349-502f-465b-a8dd-23ae3f91af49",
                        "source_entry_id": "2022dbc1-7e1b-34e3-9ac1-88171b944d06",
                        "source_sense_description": "Absence de progression",
                        "target_lang_word": "standstill",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "standstill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0145d136-954b-3f1c-82bb-e4e2c1191421",
                                        "entry_id": "adc1dea7-0f62-3268-99da-f59182086cbb",
                                        "glosses": [
                                            "Complete immobility; a halt."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e3c5cba-2629-4d50-a0b7-07085bc210c5",
                                                "sense_id": "0145d136-954b-3f1c-82bb-e4e2c1191421",
                                                "text": "The wreck brought traffic to a standstill for hours."
                                            },
                                            {
                                                "example_id": "6819d745-4646-4f6e-ba84-b93e52a2a0bd",
                                                "sense_id": "0145d136-954b-3f1c-82bb-e4e2c1191421",
                                                "text": "Despite all these precautions, however, severe storms sometimes caused drifts which brought traffic completely to a standstill."
                                            },
                                            {
                                                "example_id": "91928c60-1e22-4261-9032-ca62bf71edb5",
                                                "sense_id": "0145d136-954b-3f1c-82bb-e4e2c1191421",
                                                "text": "[...] but in the damp conditions prevailing the driver sensibly was unwilling to attempt the climb up through Combe Down tunnel without help, for fear of slipping to a standstill in the unventilated bore, [...]."
                                            },
                                            {
                                                "example_id": "dbe8314a-fd8e-45dd-96d9-c50208514d07",
                                                "sense_id": "0145d136-954b-3f1c-82bb-e4e2c1191421",
                                                "text": "For the caller the advantage relies on a fast solution of his service request, leading to less standstill and non-productive periods for the service customer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
