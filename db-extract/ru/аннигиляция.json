                        "cross_references": [
                            {
                                "target_word": "annihilation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b674e5f-0886-304a-8847-bd45df93080a",
                                        "entry_id": "d795def4-03f1-3ec6-8119-1706fe60d672",
                                        "glosses": [
                                            "The act of destroying or otherwise turning into nothing, or nonexistence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f04818dc-9364-3f4b-99be-7a5f8a8f40ac",
                                        "entry_id": "d795def4-03f1-3ec6-8119-1706fe60d672",
                                        "glosses": [
                                            "The act of destroying the form or combination of parts under which a thing exists, so that the name can no longer be applied to it."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b876e38-599c-4315-8498-345be95703d5",
                                                "sense_id": "f04818dc-9364-3f4b-99be-7a5f8a8f40ac",
                                                "text": "the annihilation of a corporation"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a620426-f51a-30d7-8cd5-2e6794c5984b",
                                        "entry_id": "d795def4-03f1-3ec6-8119-1706fe60d672",
                                        "glosses": [
                                            "The state of being annihilated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c25408ba-b3aa-4470-b6bb-3a222516f182",
                                                "sense_id": "5a620426-f51a-30d7-8cd5-2e6794c5984b",
                                                "text": "If you ask how religion thus falls on the thorns and faces death, and in the very act annuls annihilation, I cannot explain the matter, for it is religion's secret, and to understand it you must yourself have been a religious man of the extremer type."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0130ff04-0f7c-327d-ae77-0a0fca0ef33a",
                                        "entry_id": "d795def4-03f1-3ec6-8119-1706fe60d672",
                                        "glosses": [
                                            "The process of a particle and its corresponding antiparticle combining to produce energy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "642efd1b-4e8d-44c2-8f99-8dd4bddcf817",
                        "source_entry_id": "988fb1f9-6514-3e67-b8cb-1f2bb8b8b6a7",
                        "source_sense_id": "6c3d4546-c4a8-33b7-915b-2d8a18eaef44",
                        "target_lang_word": "Annihilation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Annihilation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5da4bcbc-231b-3450-a95e-eca1e85aaf2f",
                                        "entry_id": "cab82cbd-c927-3f65-802c-bc141310e923",
                                        "glosses": [
                                            "Vernichtung, Zunichtemachung, Ungültigkeitserklärung einer Sache"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75015cb5-d804-4176-8209-3ed84c40d046",
                                                "sense_id": "5da4bcbc-231b-3450-a95e-eca1e85aaf2f",
                                                "text": "Und doch gab es nur eine Antwort: Das Zeugnis war unterschrieben und eine Annihilation desselben gänzlich ausgeschlossen."
                                            },
                                            {
                                                "example_id": "139d6a33-20f6-4e98-b3c6-4c6678fd5249",
                                                "sense_id": "5da4bcbc-231b-3450-a95e-eca1e85aaf2f",
                                                "text": "Mit dem umfassenden Geist des Cartesius ließe sich die Annihilation der Natur, welcher sich der Idealismus in der oben angegebenen Gestalt rühmt, ebenso wahr und faktisch machen, als sie es in seiner Physik wirklich war."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "91251963-34b8-34a9-a0da-30feaf3b689b",
                                        "entry_id": "cab82cbd-c927-3f65-802c-bc141310e923",
                                        "glosses": [
                                            "Auflösung von Materie und Antimaterie bei ihrem Aufeinandertreffen unter Aussendung von Energie nahe ihrem Massenäquivalent"
                                        ],
                                        "tags": [
                                            "Teilchenphysik",
                                            "Atomphysik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ed62480-de07-486c-aeba-45ddad2c39c6",
                                                "sense_id": "91251963-34b8-34a9-a0da-30feaf3b689b",
                                                "text": "Bei der Annihilation muss die Energie- und Impulserhaltung gewährleistet sein."
                                            },
                                            {
                                                "example_id": "9da0f675-c9ce-41ad-bc5f-1a1ffd79fc17",
                                                "sense_id": "91251963-34b8-34a9-a0da-30feaf3b689b",
                                                "text": "Für die Anwendung am bedeutungsvollsten ist die Annihilation eines Positrons und eines Elektrons."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
