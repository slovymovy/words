                    }
                ],
                "senses": [
                    {
                        "sense_id": "303f45e0-6139-36ba-aaa3-149e68ee9b9e",
                        "entry_id": "c24360de-da45-385d-a906-3d24bc8cb405",
                        "glosses": [
                            "One of the ways something exists, or the ways a set of objects can be ordered."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "16cd5564-02fd-4ca3-85f6-200235187186",
                                "sense_id": "303f45e0-6139-36ba-aaa3-149e68ee9b9e",
                                "text": "Which permutation for completing our agenda items makes the most sense?"
                            }
                        ]
                    },
                    {
                        "sense_id": "6edd8f46-1f35-3e20-8cb0-f6dd4bb73cb8",
                        "entry_id": "c24360de-da45-385d-a906-3d24bc8cb405",
                        "glosses": [
                            "A one-to-one mapping from a finite set to itself."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3ea4369a-c6ec-4a14-b895-d4eb71b2de92",
                                "sense_id": "6edd8f46-1f35-3e20-8cb0-f6dd4bb73cb8",
                                "text": "This permutation takes each element to the one following it, with the last mapped back to the first."
                            }
                        ]
                    },
                    {
                        "sense_id": "8a72039e-e47b-3920-a407-5604ed5ab9d4",
                        "entry_id": "c24360de-da45-385d-a906-3d24bc8cb405",
                        "glosses": [
                            "An ordering of a finite set of distinct elements."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e6267eed-9948-4751-919b-cb929b1d1a23",
                                "sense_id": "8a72039e-e47b-3920-a407-5604ed5ab9d4",
                                "text": "There are six permutations of three elements, e.g. {abc, acb, bac, bca, cab, cba}."
                            }
                        ]
                    },
                    {
                        "sense_id": "f07a41a6-94c1-3067-a65a-0f4a2ebfb854",
                        "entry_id": "c24360de-da45-385d-a906-3d24bc8cb405",
                        "glosses": [
                            "A transformation of a set's prime form, by applying one or more of certain operations, specifically, transposition, inversion, and retrograde."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
