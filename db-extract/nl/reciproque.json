                                                "example_id": "c0ae431d-e374-40fb-b2bf-4cf5987f4d9a",
                                                "sense_id": "cafd9367-a796-3cea-9e8f-2ff426e0be9c",
                                                "text": "Genies denken oft ziemlich durchschnittlich. Umgekehrt kann jeder geniale Ideen haben."
                                            },
