                                "target_word": "infusion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f1525e2-eb3d-3574-9412-2030edeefa93",
                                        "entry_id": "9e3a171c-6cad-3b82-9573-77b92afdf500",
                                        "glosses": [
                                            "A product consisting of a liquid which has had other ingredients steeped in it to extract useful qualities."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9850d5f0-2bda-49f2-8982-e8e9ff85347a",
                                                "sense_id": "7f1525e2-eb3d-3574-9412-2030edeefa93",
                                                "text": "An extract of rooibos and chamomile makes a refreshing infusion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28ad15b6-d859-34ad-a72a-3956f0d06492",
                                        "entry_id": "9e3a171c-6cad-3b82-9573-77b92afdf500",
                                        "glosses": [
                                            "The act of steeping or soaking a substance in liquid so as to extract medicinal or herbal qualities."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bd77a647-38e6-3a04-94bc-a7c862ae65f7",
                                        "entry_id": "9e3a171c-6cad-3b82-9573-77b92afdf500",
                                        "glosses": [
                                            "The act of installing a quality into a person."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d3279206-7a24-3732-b6ec-d69e2ad6341c",
                                        "entry_id": "9e3a171c-6cad-3b82-9573-77b92afdf500",
                                        "glosses": [
                                            "A giving of money or other resources, typically a large amount, to an organization."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "543393ab-65e4-44bd-a467-a5a9860e4983",
                                                "sense_id": "d3279206-7a24-3732-b6ec-d69e2ad6341c",
                                                "text": "He made a number of other changes at the Transit Police, including revamping audio equipment, moving the force to nine-millimeter semiautomatic weapons, and designing new uniforms. These changes were all part of a $40 million infusion into the Transit Police in 1990 from Governor Mario Cuomo."
                                            },
                                            {
                                                "example_id": "ec32ea49-090d-463e-a5f8-2b196a4d8363",
                                                "sense_id": "d3279206-7a24-3732-b6ec-d69e2ad6341c",
                                                "text": "[...] but in the verity of extolment / I take him to be a soul of great article and his infusion / of such dearth and rareness as, to make true diction of / him, his semblable in his mirror, and who else would / trace him, his umbrage, nothing more."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6589ce0-8257-3dd5-aaf6-46ce414a4aaa",
                                        "entry_id": "9e3a171c-6cad-3b82-9573-77b92afdf500",
                                        "glosses": [
                                            "The act of dipping into a fluid."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b11066c-68df-366c-9864-735d7104cb8a",
                                        "entry_id": "9e3a171c-6cad-3b82-9573-77b92afdf500",
                                        "glosses": [
                                            "The administration of liquid substances directly into a vein for medical purposes; perfusion."
                                        ],
                                        "tags": [
                                            "countable",
