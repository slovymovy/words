                        "glosses": [
                            "jemand, etwas Weibliches, der/das beim Aufspüren, Jagen und Fangen beziehungsweise Erlegen von Wild hilft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58f58b1f-5f66-45fb-a941-5f6d59926148",
                                "sense_id": "ae42d03d-33c5-387b-935f-b63ae72f3c9f",
                                "text": "„Es ist meine Tochter und Jagdgehilfin, die auf einem Nachbarhochsitz nach Wild Ausschau hält.“"
                            },
                            {
                                "example_id": "46e32d69-f2eb-4676-93ce-1bc2025a4ae0",
                                "sense_id": "ae42d03d-33c5-387b-935f-b63ae72f3c9f",
                                "text": "„Ein einziges Mal nur wagt sie [die Löwin] einen prüfenden Blick zu ihren Jagdgehilfinnen. Die liegen regungslos da.“"
                            }
                        ],
