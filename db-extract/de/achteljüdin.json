                "senses": [
                    {
                        "sense_id": "a27d62ce-4b6a-3287-a03d-613580cbc2b6",
                        "entry_id": "10de8e00-af4e-307b-97a7-0076de2ef03e",
                        "glosses": [
                            "Frau/Mädchen mit einer Abstammung, die gemäß den Nürnberger Rassengesetzen einen Achtel jüdischer Herkunft umfasst; Frau/Mädchen, deren/dessen ein Urgroßelternteil jüdischer Abstammung ist"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "08c5d902-5c48-4098-a060-d8cbd6ea7235",
                                "sense_id": "a27d62ce-4b6a-3287-a03d-613580cbc2b6",
                                "text": "„Wir galten als jüdische Mischlinge; ich selbst bin Achteljüdin, unser Vater wurde als Vierteljude aus seiner Professur für Anatomie vertrieben, und ich erlebte mit, wie Kollegen ihn mieden, auf die andere Straßenseite gingen, wann wir kamen, und wie meine Klassenkameradinnen seit seiner Entlassung nicht mehr den gleichen Schulweg hatten, sondern mich allein gehen ließen.“"
                            },
                            {
                                "example_id": "e75c3dbe-48d4-479d-94bf-3e8f479b2275",
                                "sense_id": "a27d62ce-4b6a-3287-a03d-613580cbc2b6",
                                "text": "„Meine Mutter war, nach damaliger präziser Berechnung, Achteljüdin.“"
                            },
                            {
                                "example_id": "c4636f03-3cca-4ccf-ab64-94e2919cb052",
                                "sense_id": "a27d62ce-4b6a-3287-a03d-613580cbc2b6",
                                "text": "„Seine Mutter ist Achteljüdin, und sein Vater war als Balte ursprünglich Klasse I und ist vor seiner Heirat eingedeutscht worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
