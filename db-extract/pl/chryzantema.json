                                    {
                                        "sense_id": "06117fd7-fe9a-3d11-8015-0818a58ff01f",
                                        "entry_id": "d750f95f-f666-3dc3-b062-7f49115e2381",
                                        "glosses": [
                                            "Zierpflanze (Chrysanthemum) aus der Familie der Korbblütler (Asteraceae)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "904fd124-455e-4ec3-be34-b7e9272a7db3",
                                                "sense_id": "06117fd7-fe9a-3d11-8015-0818a58ff01f",
                                                "text": "Die Chrysantheme ist eine der beliebtesten Blumen in Europa."
                                            },
                                            {
                                                "example_id": "c7c46be6-8811-46f1-9093-a6eda4dca067",
                                                "sense_id": "06117fd7-fe9a-3d11-8015-0818a58ff01f",
                                                "text": "In China ist die Chrysantheme ein Symbol des Herbstes."
                                            },
                                            {
                                                "example_id": "803345c9-918c-4bf0-9a79-94c98c4d5e52",
                                                "sense_id": "06117fd7-fe9a-3d11-8015-0818a58ff01f",
                                                "text": "„Er hatte auch weiße Chrysanthemen und einige weiße Orchideen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6e27cbf-2c03-4447-90ed-150bb607dbf5",
                        "source_entry_id": "96de2888-6aa0-3baa-9d55-879ad347a2f8",
                        "source_sense_id": "e54a1519-0acb-3ca9-9458-50c33aafcae7",
                        "target_lang_word": "хризанте́ма",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "хризанте́ма",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "99b60f93-85a2-311e-9006-bc9f0a752ea5",
                                        "entry_id": "3a4b0dbc-9c7a-349b-a78a-e27a4d9ce2d6",
                                        "glosses": [
                                            "ботан. однолетнее или многолетнее травянистое растение семейства сложноцветных с пышными цветками, собранными в корзинки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad1ddf6c-1e6e-4049-9b78-6d58a1a4aa64",
                                                "sense_id": "99b60f93-85a2-311e-9006-bc9f0a752ea5",
                                                "text": "В сухую погоду и после подкормки хризантемам необходим обильный полив."
                                            },
                                            {
                                                "example_id": "66f2fb75-b8fb-4b40-87ec-819e40a2ffd2",
                                                "sense_id": "99b60f93-85a2-311e-9006-bc9f0a752ea5",
                                                "text": "У нас в саду чудесно цветут хризантемы и будут цвести ещё долго, целый месяц."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4facaed-19e3-38ef-9805-c3a51a0c3643",
                                        "entry_id": "3a4b0dbc-9c7a-349b-a78a-e27a4d9ce2d6",
                                        "glosses": [
                                            "цветок такого растения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed1adada-fc13-4adf-9117-b055eedfecde",
                                                "sense_id": "b4facaed-19e3-38ef-9805-c3a51a0c3643",
                                                "text": "― Но завтра, Тата, я приду раньше. Да? ― он вынимает из петлички бледно-лиловую хризантему, втыкает мне её в волосы и, поцеловав мою щеку, идёт к двери."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
