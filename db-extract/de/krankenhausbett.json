                "senses": [
                    {
                        "sense_id": "fc566d8a-fceb-3f67-8f44-c7bead40b0f6",
                        "entry_id": "01e3144a-475c-33cf-abc4-03f98ec5943b",
                        "glosses": [
                            "Bett, in dem ein stationär aufgenommener Patient (einer Krankeneinrichtung) liegen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "578191be-3010-4da0-80e7-865d49fdc1fb",
                                "sense_id": "fc566d8a-fceb-3f67-8f44-c7bead40b0f6",
                                "text": "Die Krankenschwester half dem Patienten aus dem Krankenhausbett."
                            },
                            {
                                "example_id": "b651d9d1-b346-4205-b337-e0664d89ecd2",
                                "sense_id": "fc566d8a-fceb-3f67-8f44-c7bead40b0f6",
                                "text": "Diese Woche mussten schon fünf Krankenhausbetten ausgewechselt werden."
                            },
                            {
                                "example_id": "1927edb0-bd98-4fff-baae-a6c46eadd1fb",
                                "sense_id": "fc566d8a-fceb-3f67-8f44-c7bead40b0f6",
                                "text": "„Ich ging ins Schlafzimmer, setzte mich für fünfzehn oder zwanzig Minuten an das Krankenhausbett, das man dort aufgestellt hatte, und nahm seine Hand, die Hand, in der er noch etwas spürte, doch er war immer ohne Bewusstsein.“"
                            },
                            {
                                "example_id": "d4373ab1-c669-47df-a193-51e81935c8e2",
                                "sense_id": "fc566d8a-fceb-3f67-8f44-c7bead40b0f6",
                                "text": "„Ich saß neben seinem Krankenhausbett und überlegte gerade, worüber wir reden könnten.“"
                            },
                            {
                                "example_id": "e3a45875-9166-422e-a825-115db709ff9d",
                                "sense_id": "fc566d8a-fceb-3f67-8f44-c7bead40b0f6",
                                "text": "„So lief ich in meinem Krankenhausbett liegend in Gedanken am Park entlang.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
