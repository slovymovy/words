                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "19367e0c-cf2c-4c84-9a76-52fc07e734ce",
                                "sense_id": "9f2e1a12-c254-3e69-b4e7-edd4b2c2f489",
                                "text": "As society evolves, education must change to keep apace with it, so may this text serve as a waypost, not a goal."
                            },
                            {
                                "example_id": "f99dd0cb-234b-4e56-b0ce-84683e80c439",
                                "sense_id": "9f2e1a12-c254-3e69-b4e7-edd4b2c2f489",
                                "text": "The war makes many oblique appearances in a work which, despite its saturation with traditional images, is regarded as a waypost of artistic modernism because of its fashionable anthropological references, jazz-like rhythms and random snatches of the pulsing city's polyphonic argot."
