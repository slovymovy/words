                        "entry_id": "c20709be-b1ad-319c-9dfa-0ee67add50d5",
                        "glosses": [
                            "A person who constantly hangs around with someone they are attracted to, but too shy to talk to."
                        ],
                        "tags": [
                            "derogatory",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "3395ad10-1e2b-4e69-8902-f0097bf1edfd",
                                "sense_id": "98ff5e00-6cb0-3826-b6f9-29e0b5c676eb",
                                "text": "The orbiters in her life in high likelihood like to talk about this and make themselves her emotional tampon and outlet."
                            }
                        ]
                    }
