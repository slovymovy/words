        "nl-extract.jsonl": [
            {
                "entry_id": "f125e47e-7981-31ba-8ca2-30d6cc500bad",
                "word": "bloeddruk",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f3eeb3dc-f10a-3082-84a9-c1195b2d59fe",
                        "entry_id": "f125e47e-7981-31ba-8ca2-30d6cc500bad",
                        "glosses": [
                            "de hydrostatische druk die het bloed op het vaatstelsel van de slagaderen uitoefent"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4aa3a955-700e-4786-9398-cac474eec7e9",
                                "sense_id": "f3eeb3dc-f10a-3082-84a9-c1195b2d59fe",
                                "text": "Door drop en zout te eten kun je een hoge bloeddruk krijgen."
                            },
                            {
                                "example_id": "f6344a2c-9471-4659-90d7-331666b0912b",
                                "sense_id": "f3eeb3dc-f10a-3082-84a9-c1195b2d59fe",
                                "text": "Vooral veel oudere mensen hebben een hoge bloeddruk."
                            },
                            {
                                "example_id": "d0a83fa6-0ae0-4836-b7f8-c2b4e1fd80b2",
                                "sense_id": "f3eeb3dc-f10a-3082-84a9-c1195b2d59fe",
                                "text": "Exact zoals de dokter haar had verzocht te doen. De eerste dag van Jeroens ziekenhuisopname had men zich beziggehouden met elementaire zaken zoals bloedafname, bloeddruk en het in kaart brengen van zijn algehele toestand."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07ca5f25-25ab-4dba-9a08-b9fd33c8d49c",
                        "source_entry_id": "f125e47e-7981-31ba-8ca2-30d6cc500bad",
                        "source_sense_id": "f3eeb3dc-f10a-3082-84a9-c1195b2d59fe",
                        "target_lang_word": "Blutdruck",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blutdruck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cae1d9fc-b466-3a3f-ad9d-f57388a73c00",
                                        "entry_id": "f1ec0a6a-c450-3759-9cec-0dcb9429d4ed",
                                        "glosses": [
                                            "Druck des Blutes in einem arteriellen oder venösen Blutgefäß"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "640965be-cedb-481f-9ca4-d3bead6292ed",
                                                "sense_id": "cae1d9fc-b466-3a3f-ad9d-f57388a73c00",
                                                "text": "Er hat einen viel zu hohen Blutdruck."
                                            },
                                            {
                                                "example_id": "4dcfabb0-af2e-44bc-b665-2e488a81250e",
                                                "sense_id": "cae1d9fc-b466-3a3f-ad9d-f57388a73c00",
                                                "text": "„Der Tonmann bleibt cool, denn wenn es Schwierigkeiten gibt, haben Westfalen den Blutdruck einer ägyptischen Mumie.“"
                                            },
                                            {
                                                "example_id": "b5540e39-332b-4f3d-a5c1-33b778482262",
                                                "sense_id": "cae1d9fc-b466-3a3f-ad9d-f57388a73c00",
                                                "text": "„Ihr Blutdruck stieg auf einen Wert von 240.“"
                                            },
                                            {
                                                "example_id": "68be4594-5786-4b79-a1bc-ace0df4d28c8",
                                                "sense_id": "cae1d9fc-b466-3a3f-ad9d-f57388a73c00",
                                                "text": "„Er konnte in kurzer Zeit lernen, seinen Blutdruck zu verringern, seinen Pulsschlag, ja sogar seine innere Sekretion zu verändern und sich in den Zustand der Kontemplation zu versetzen…“"
                                            },
                                            {
                                                "example_id": "dacce8ba-ad33-4d68-b242-8099af5d06fb",
                                                "sense_id": "cae1d9fc-b466-3a3f-ad9d-f57388a73c00",
                                                "text": "„Der Blutdruck steigt von 120 auf 180.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1dc47b8-9739-4ee9-892e-81e93f3ab7bd",
                        "source_entry_id": "f125e47e-7981-31ba-8ca2-30d6cc500bad",
                        "source_sense_id": "f3eeb3dc-f10a-3082-84a9-c1195b2d59fe",
                        "target_lang_word": "blood pressure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blood pressure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0cd7efbb-70d7-3124-852a-82977a54c569",
                                        "entry_id": "d6f2ab67-1080-3fc4-abeb-6f9975e35534",
                                        "glosses": [
                                            "The pressure exerted by the blood against the walls of the arteries and veins; it varies during the heartbeat cycle, and according to a person's age, health and physical condition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad4cd7e2-4978-4657-9ae5-5d46608c57bb",
                                                "sense_id": "0cd7efbb-70d7-3124-852a-82977a54c569",
                                                "text": "the great majority of people who have serious conditions from high blood pressure suffer debilitating illness"
                                            },
                                            {
                                                "example_id": "8b380d42-794c-44b9-b5b4-785400d2c041",
                                                "sense_id": "0cd7efbb-70d7-3124-852a-82977a54c569",
                                                "text": "The nurse spent all day taking blood pressures at the hospital."
                                            },
                                            {
                                                "example_id": "eb1e9d00-abc3-4b58-b70a-83407bd1a6b9",
                                                "sense_id": "0cd7efbb-70d7-3124-852a-82977a54c569",
                                                "text": "She threw her head back and inflated the lungs. “UPJOHN!” she boomed, rather like someone calling the cattle home across the sands of Dee, and I issued a kindly word of warning. “Watch that blood pressure, old ancestor.” “Never you mind my blood pressure. You let it alone, and it'll leave you alone. UPJOHN!”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0e52441-8b43-4d66-8364-8f371db493aa",
                        "source_entry_id": "f125e47e-7981-31ba-8ca2-30d6cc500bad",
