                        "entry_id": "74428420-9161-3cd5-9973-0a1bb4388998",
                        "glosses": [
                            "Single-threaded; blocking; occurring in the same thread as other computations, thereby preventing those computations from resuming until the communication is complete."
                        ],
                        "tags": [
                            "of communication"
                        ],
                        "examples": [
                            {
                                "example_id": "3bb84cca-63e6-4ad7-93a8-3bb14dc6a658",
                                "sense_id": "381cbf6c-d5d7-3698-b2ea-754b87c80114",
                                "text": "Post is a “fire and forget” where the UI thread work is performed asynchronously; Send is synchronous in that the call blocks until the UI thread work has been performed."
                            }
                        ]
                    }
                ],
