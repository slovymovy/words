                        "examples": [
                            {
                                "example_id": "030d5105-5b7e-4447-977e-627ced25a884",
                                "sense_id": "c07c4544-c636-3c36-a75b-6aed0b27856e",
                                "text": "L’année 1824 se déroule essentiellement sous le signe de Beethoven - dont le mythe a été introduit à Berlin par le chef d’orchestre et quartettiste Carl Möser et l’écrivain Hoffmann – en raison des liens que Felix noue avec deux aînés : Marx, déjà spécialiste du maître de Bonn, et Moscheles, autrefois transcripteur de Fidelio."
                            },
                            {
                                "example_id": "786721d1-404a-42c5-9412-e134929f5c06",
                                "sense_id": "c07c4544-c636-3c36-a75b-6aed0b27856e",
                                "text": "Il est connu de tous les bons quartettistes. Quand on fait partie d’un ensemble, jouer fort est une hérésie : il faut jouer doux."
                            }
                        ]
