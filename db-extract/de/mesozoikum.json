                                        "entry_id": "517c86ee-3c00-38db-be0f-cf7a7f45ff86",
                                        "glosses": [
                                            "era geológica situada entre a paleozoica e a cenozoica, caracterizada pelo desenvolvimento das gimnospermas, pela preponderância e variedade dos répteis e pelo aparecimento das aves e de algumas espécies de mamíferos, com duração de 125 milhões de anos"
                                        ],
