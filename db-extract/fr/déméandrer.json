                "senses": [
                    {
                        "sense_id": "9145f7cc-5ba1-3dcf-8cdd-00e4b4617b4c",
                        "entry_id": "1b6af067-0b7b-3b6a-8810-ec37655c10d8",
                        "glosses": [
                            "Enlever ses méandres à quelque chose (généralement un cours d’eau)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47aa55c4-c2be-4de8-875f-ed932ed8a042",
                                "sense_id": "9145f7cc-5ba1-3dcf-8cdd-00e4b4617b4c",
                                "text": "Le bassin-versant du ruisseau NOLANGE a été débocagé, déméandré, privé de sa ripisylve, de ses zones humides."
                            },
                            {
                                "example_id": "352178f0-fd33-4798-a615-05eac8234930",
                                "sense_id": "9145f7cc-5ba1-3dcf-8cdd-00e4b4617b4c",
                                "text": "Non loin de là, il y a quelques années, une politique en tout point opposée à celle du PNR a été menée : dans l’Orne, nombre de cours d’eau ont été « déméandrés », ce qui a considérablement accru les risques d’inondation."
                            }
                        ]
                    }
