                                "target_senses": [
                                    {
                                        "sense_id": "f9e110ed-2d55-3d28-bd6a-951005f47a28",
                                        "entry_id": "612530a4-f939-378e-978a-db56a4e4c908",
                                        "glosses": [
                                            "A physician; a member of the medical profession; one who is trained and licensed to heal the sick or injured. The final examination and qualification may award a doctor degree in which case the post-nominal letters are DO, DPM, MD, DMD, or DDS in the US, or MBBS or BDS in the UK."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b16753c-c3bc-4aa7-9501-fcccc2837da5",
                                                "sense_id": "f9e110ed-2d55-3d28-bd6a-951005f47a28",
                                                "text": "If you still feel unwell tomorrow, see your doctor."
                                            },
                                            {
                                                "example_id": "84747bc6-fdce-4be4-8862-ec0544a10d14",
                                                "sense_id": "f9e110ed-2d55-3d28-bd6a-951005f47a28",
                                                "text": "By medicine life may be prolonged, yet death / Will seize the doctor too."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ef39560-fd3c-3c40-8281-4c1960590953",
                                        "entry_id": "612530a4-f939-378e-978a-db56a4e4c908",
                                        "glosses": [
                                            "A person who has attained a doctorate, such as a Ph.D. or Th.D. or one of many other terminal degrees conferred by a college or university."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d7a9f674-56f5-3258-a3f4-9bcef4b9ed67",
                                        "entry_id": "612530a4-f939-378e-978a-db56a4e4c908",
                                        "glosses": [
                                            "A veterinarian; a medical practitioner who treats non-human animals."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d4a9a912-b858-333b-9c1b-602470af3c61",
                                        "entry_id": "612530a4-f939-378e-978a-db56a4e4c908",
                                        "glosses": [
                                            "A nickname for a person who has special knowledge or talents to manipulate or arrange transactions."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2855094f-96be-3f6b-97e0-9bd31bd39fb0",
                                        "entry_id": "612530a4-f939-378e-978a-db56a4e4c908",
                                        "glosses": [
                                            "A teacher; one skilled in a profession or a branch of knowledge; a learned man."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9530578c-c142-452e-8dca-ed2bd6f1d12b",
                                                "sense_id": "2855094f-96be-3f6b-97e0-9bd31bd39fb0",
                                                "text": "So from that tyme forwarde I began to ſmell the word of god, and forſoke the ſchole doctors and ſuch foolries."
                                            },
                                            {
                                                "example_id": "07ba8817-ce5c-4d72-93c7-d25e07dfed60",
                                                "sense_id": "2855094f-96be-3f6b-97e0-9bd31bd39fb0",
                                                "text": "one of the doctors of Italy, Nicholas Macciavel"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82bed945-a580-33bd-a21a-1abe3af11082",
                                        "entry_id": "612530a4-f939-378e-978a-db56a4e4c908",
                                        "glosses": [
                                            "Any mechanical contrivance intended to remedy a difficulty or serve some purpose in an exigency."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc60f4ac-a31f-4f0d-aca1-23f4fbff4657",
                                                "sense_id": "82bed945-a580-33bd-a21a-1abe3af11082",
                                                "text": "the doctor of a calico-printing machine, which is a knife to remove superfluous colouring matter"
                                            },
                                            {
                                                "example_id": "aa444a25-2588-459d-8f22-227f71e256a1",
                                                "sense_id": "82bed945-a580-33bd-a21a-1abe3af11082",
                                                "text": "the doctor, or auxiliary engine, also called \"donkey engine\""
                                            },
                                            {
                                                "example_id": "e465c322-c42b-41c5-9f49-02aad5a29977",
                                                "sense_id": "82bed945-a580-33bd-a21a-1abe3af11082",
                                                "text": "The use of a disk doctor may be the only way of recovering valuable data following a disk crash."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb91185a-d9c5-339f-bf3e-a071b7bcd851",
                                        "entry_id": "612530a4-f939-378e-978a-db56a4e4c908",
                                        "glosses": [
                                            "A fish, the friar skate."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "abab7140-2d72-3c88-ae99-198e1ac6e338",
                                        "entry_id": "612530a4-f939-378e-978a-db56a4e4c908",
                                        "glosses": [
                                            "A ship's cook."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6770bbd6-375e-4ed0-a192-c8156f7b59db",
                                                "sense_id": "abab7140-2d72-3c88-ae99-198e1ac6e338",
                                                "text": "His galley is small, and, microscopic as it is, it is shared by his brother in misery, the ship's cook, he whom the crew familiarly know as the “Doctor.”"
                                            },
                                            {
                                                "example_id": "e32b552e-fe7c-4c32-bc6d-9f2af754610d",
                                                "sense_id": "abab7140-2d72-3c88-ae99-198e1ac6e338",
                                                "text": "[…] old Scotch Jem the boatswain, tunes his fiddle, and the doctor, (ship's cook,) produces his tambourine; the men dance on deck, […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "doctor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22d7317e-5eff-32cd-87a3-c70650cccac1",
                                        "entry_id": "bada4727-eb1a-3667-a7e5-b32702728e04",
                                        "glosses": [
                                            "To act as a medical doctor to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b311443f-7808-43b0-9325-cfc0845f3be6",
                                                "sense_id": "22d7317e-5eff-32cd-87a3-c70650cccac1",
                                                "text": "Her children doctored her back to health."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ba73d35-26e8-3ece-a118-f947b8e8df7b",
                                        "entry_id": "bada4727-eb1a-3667-a7e5-b32702728e04",
                                        "glosses": [
                                            "To act as a medical doctor."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce13c3ca-cd8c-4e66-9ed8-4569f0cbcad7",
                                                "sense_id": "7ba73d35-26e8-3ece-a118-f947b8e8df7b",
                                                "text": "2017, \"Do No Harm\", season 8, episode 2 of Adventure Time\nDoctor Princess: Put this on. [gives her lab coat to Finn] OK, you're a doctor now. Good luck.\nFinn: Wait, wait, whoa, whoa, whoa, wait! I don't know how to doctor!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9044f328-fa28-32ec-bf2f-022bbe91a129",
                                        "entry_id": "bada4727-eb1a-3667-a7e5-b32702728e04",
                                        "glosses": [
                                            "To make (someone) into an (academic) doctor; to confer a doctorate upon."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "64571445-f55a-39ed-82dc-0ab22a442255",
                                        "entry_id": "bada4727-eb1a-3667-a7e5-b32702728e04",
                                        "glosses": [
                                            "To physically alter (medically or surgically) a living being in order to change growth or behavior."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "191f8089-5991-4a02-8645-6ab884bc7ace",
                                                "sense_id": "64571445-f55a-39ed-82dc-0ab22a442255",
                                                "text": "They doctored their apple trees by vigorous pruning, and now the dwarfed trees are easier to pick."
                                            },
                                            {
                                                "example_id": "28b97d35-37ec-4f39-96aa-84081f5fd8d9",
                                                "sense_id": "64571445-f55a-39ed-82dc-0ab22a442255",
                                                "text": "We may legally doctor a pet to reduce its libido."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5080cc5f-7b2d-3d0f-9457-41a5dc6b3167",
                                        "entry_id": "bada4727-eb1a-3667-a7e5-b32702728e04",
                                        "glosses": [
                                            "To genetically alter an extant species."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e44bf521-16ce-438d-8bfa-ab51f3b9aa4a",
                                                "sense_id": "5080cc5f-7b2d-3d0f-9457-41a5dc6b3167",
                                                "text": "Mendel's discoveries showed how the evolution of a species may be doctored."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dea2afae-1a12-3289-95b2-dcf766733847",
                                        "entry_id": "bada4727-eb1a-3667-a7e5-b32702728e04",
                                        "glosses": [
                                            "To alter or make obscure, as with the intention to deceive, especially a document."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cfc4163-bf0f-4e58-9d6a-c1a1efebcbd9",
                                                "sense_id": "dea2afae-1a12-3289-95b2-dcf766733847",
                                                "text": "To doctor the signature of an instrument with intent to defraud is an example of forgery."
                                            },
                                            {
                                                "example_id": "d339416f-f701-4018-b267-778de9c15c62",
                                                "sense_id": "dea2afae-1a12-3289-95b2-dcf766733847",
                                                "text": "That picture – the one that Andrew claimed on BBC’s Newsnight might have been doctored, since he had “no recollection” of then or ever meeting Giuffre at Tramp nightclub in London – will likely serve as both a prequel and postscript of the saga."
                                            },
                                            {
                                                "example_id": "5d7903d8-a472-4ce2-bf23-2907b07a74ef",
                                                "sense_id": "dea2afae-1a12-3289-95b2-dcf766733847",
                                                "text": "Catherine, the Princess of Wales, apologized on Monday for doctoring a photo of her with her three children, which was recalled by several news agencies on Sunday after they determined the image had been manipulated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb477c9f-1b03-3b53-9179-27aa396e8b78",
                                        "entry_id": "bada4727-eb1a-3667-a7e5-b32702728e04",
                                        "glosses": [
                                            "To adulterate, drug, or poison (drink)."
                                        ],
