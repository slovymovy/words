                ],
                "senses": [
                    {
                        "sense_id": "82434e02-da99-3306-8797-fa0988fb3eaf",
                        "entry_id": "b30e9446-3540-3a98-aaed-c21725dc32eb",
                        "glosses": [
                            "A judicial officer with limited authority to administer and enforce the law. A magistrate's court may have jurisdiction in civil or criminal cases, or both."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52a9e480-f0e3-427c-a1f0-8f3b93884ac0",
                                "sense_id": "82434e02-da99-3306-8797-fa0988fb3eaf",
                                "text": "In any case, however, I saw that part of her injuries might easily have been redressed, and I urged her often and earnestly to lay her complaint before a magistrate."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c813584-352b-30e2-a908-6147d3b3d571",
                        "entry_id": "b30e9446-3540-3a98-aaed-c21725dc32eb",
                        "glosses": [
                            "A high official of the state or a municipality in ancient Greece or Rome."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ec5a7821-e8af-3f5e-be14-c4d24e182cf8",
                        "entry_id": "b30e9446-3540-3a98-aaed-c21725dc32eb",
                        "glosses": [
                            "A comparable official in medieval or modern institutions."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "1442b933-0289-4c75-b8a5-77b14847485f",
                                "sense_id": "ec5a7821-e8af-3f5e-be14-c4d24e182cf8",
                                "text": "Like other civil servants, Ashok Kumar started his career as an Assistant Collector cum Sub-divisional Magistrate."
                            }
                        ]
                    },
                    {
                        "sense_id": "b0eb660d-db94-366e-b7b5-cb6d3be5be3f",
                        "entry_id": "b30e9446-3540-3a98-aaed-c21725dc32eb",
                        "glosses": [
                            "A master's degree."
                        ],
