{
    "word_family": [
        "subtlety",
        "subtly",
        "subtleness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bf493103-97da-31a1-8a45-29fb6d1dae0c",
                    "sense_definition": "Not loud, bright, noticeable, or obvious in any way; delicate and understated.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "not_obvious",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a <w>subtle</w> difference in the color of the two paintings.",
                            "target_lang_translations": {
                                "ru": "В цвете двух картин было <w>едва заметное</w> различие.",
                                "de": "Es gab einen <w>subtilen</w> Unterschied in der Farbe der beiden Gemälde."
                            }
                        },
                        {
                            "text": "She gave a <w>subtle</w> hint that she wanted to leave the party early.",
                            "target_lang_translations": {
                                "ru": "Она сделала <w>тонкий</w> намёк на то, что хочет уйти с вечеринки пораньше.",
                                "de": "Sie gab einen <w>dezenten</w> Hinweis, dass sie die Party früh verlassen wollte."
                            }
                        }
                    ],
                    "synonyms": [
                        "faint",
                        "slight",
                        "delicate",
                        "understated",
                        "indistinct"
                    ],
                    "antonyms": [
                        "obvious",
                        "manifest",
                        "gross",
                        "straightforward"
                    ],
                    "common_phrases": [
                        "subtle difference",
                        "subtle change",
                        "subtle hint",
                        "subtle flavor",
                        "subtle shade"
                    ],
                    "target_lang_definitions": {
                        "ru": "Негромкий, неяркий, едва заметный или неочевидный; деликатный и сдержанный.",
                        "de": "Nicht laut, hell, auffällig oder offensichtlich; zart und zurückhaltend."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тонкий",
                                "target_lang_sense_clarification": "о намеке, вкусе, аромате или юморе"
                            },
                            {
                                "target_lang_word": "едва заметный",
                                "target_lang_sense_clarification": "о различиях или изменениях"
                            },
                            {
                                "target_lang_word": "нежный",
                                "target_lang_sense_clarification": "о цвете или свете"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "dezent",
                                "target_lang_sense_clarification": "unauffällig, zurückhaltend, oft in Bezug auf Farben oder Verhalten"
                            },
                            {
                                "target_lang_word": "fein",
                                "target_lang_sense_clarification": "zart, kaum wahrnehmbar"
                            },
                            {
                                "target_lang_word": "subtil",
                                "target_lang_sense_clarification": "auf eine differenzierte, feine Art vorhanden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21084675-377a-372f-84ba-47b70ee37095",
                    "sense_definition": "Difficult to understand or perceive because it is deep, complex, or involves fine distinctions.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "complex",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author makes a <w>subtle</w> distinction between the two types of freedom.",
                            "target_lang_translations": {
                                "ru": "Автор проводит <w>тонкое</w> различие между двумя типами свободы.",
                                "de": "Der Autor macht eine <w>subtile</w> Unterscheidung zwischen den beiden Arten von Freiheit."
                            }
                        },
                        {
                            "text": "His <w>subtle</w> argument confused many people in the audience.",
                            "target_lang_translations": {
                                "ru": "Его <w>тонкий</w> аргумент сбил с толку многих в аудитории.",
                                "de": "Sein <w>feinsinniges</w> Argument verwirrte viele Leute im Publikum."
                            }
                        }
                    ],
                    "synonyms": [
                        "fine",
                        "complex",
                        "deep",
                        "profound"
                    ],
                    "antonyms": [
                        "simple",
                        "straightforward"
                    ],
                    "common_phrases": [
                        "subtle distinction",
                        "subtle point",
                        "subtle argument",
                        "subtle reasoning"
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудный для понимания или восприятия из-за глубины, сложности или наличия мелких нюансов.",
                        "de": "Schwer zu verstehen oder wahrzunehmen, da es tiefgründig, komplex ist oder feine Unterschiede aufweist."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тонкий",
                                "target_lang_sense_clarification": "о различии, нюансе или аргументе"
                            },
                            {
                                "target_lang_word": "неуловимый",
                                "target_lang_sense_clarification": "сложный для понимания или определения"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "subtil",
                                "target_lang_sense_clarification": "in die Feinheiten gehend, differenziert"
                            },
                            {
                                "target_lang_word": "feinsinnig",
                                "target_lang_sense_clarification": "mit viel Einfühlungsvermögen oder Differenzierung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c667b30-a16e-32fa-b072-26a56ec26480",
                    "sense_definition": "Able to notice or understand very small details or differences; having a sharp and quick mind.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "perceptive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has a <w>subtle</w> mind that can solve even the hardest puzzles.",
                            "target_lang_translations": {
                                "ru": "У неё <w>острый</w> ум, способный решать даже самые сложные задачи.",
                                "de": "Sie hat einen <w>scharfsinnigen</w> Verstand, der selbst die schwierigsten Rätsel lösen kann."
                            }
                        },
                        {
                            "text": "Only a <w>subtle</w> observer would have seen the mistake in the report.",
                            "target_lang_translations": {
                                "ru": "Только <w>проницательный</w> наблюдатель заметил бы ошибку в отчёте.",
                                "de": "Nur ein <w>feinsinniger</w> Beobachter hätte den Fehler im Bericht bemerkt."
                            }
                        }
                    ],
                    "synonyms": [
                        "astute",
                        "shrewd",
                        "perceptive",
                        "discerning",
                        "keen"
                    ],
                    "common_phrases": [
                        "subtle mind",
                        "subtle intellect",
                        "subtle observer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способный замечать или понимать очень мелкие детали или различия; обладающий острым умом.",
                        "de": "Fähig, sehr kleine Details oder Unterschiede zu bemerken; einen scharfen und schnellen Verstand habend."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проницательный",
                                "target_lang_sense_clarification": "о человеке или взгляде"
                            },
                            {
                                "target_lang_word": "тонкий",
                                "target_lang_sense_clarification": "о наблюдателе или уме"
                            },
                            {
                                "target_lang_word": "острый",
                                "target_lang_sense_clarification": "об уме"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "scharfsinnig",
                                "target_lang_sense_clarification": "mit hohem Verstand, intelligent"
                            },
                            {
                                "target_lang_word": "feinsinnig",
                                "target_lang_sense_clarification": "mit viel Einfühlungsvermögen und Beobachtungsgabe"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4800652-eda0-3d0e-85fc-20a6b7f93843",
                    "sense_definition": "Clever and skilful in a way that is intended to deceive or trick people.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "cunning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spy used a <w>subtle</w> plan to steal the documents without being caught.",
                            "target_lang_translations": {
                                "ru": "Шпион использовал <w>хитроумный</w> план, чтобы украсть документы и не попасться.",
                                "de": "Der Spion nutzte einen <w>raffinierten</w> Plan, um die Dokumente zu stehlen, ohne erwischt zu werden."
                            }
                        },
                        {
                            "text": "He is a <w>subtle</w> enemy who strikes when you least expect it.",
                            "target_lang_translations": {
                                "ru": "Это <w>коварный</w> враг, который наносит удар, когда вы меньше всего этого ожидаете.",
                                "de": "Er ist ein <w>raffinierter</w> Feind, der zuschlägt, wenn man es am wenigsten erwartet."
                            }
                        }
                    ],
                    "synonyms": [
                        "cunning",
                        "crafty",
                        "sly",
                        "wily",
                        "artful"
                    ],
                    "common_phrases": [
                        "subtle plan",
                        "subtle trick",
                        "subtle trap"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often literary or archaic in modern use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Искусный и хитрый, действующий скрытно (часто с целью обмана).",
                        "de": "Clever und geschickt auf eine Weise, die darauf abzielt, Menschen zu täuschen oder auszutricksen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коварный",
                                "target_lang_sense_clarification": "о враге или замысле"
                            },
                            {
                                "target_lang_word": "хитроумный",
                                "target_lang_sense_clarification": "о плане или уловке"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "raffiniert",
                                "target_lang_sense_clarification": "durchtrieben, ausgeklügelt"
                            },
                            {
                                "target_lang_word": "geschickt",
                                "target_lang_sense_clarification": "erfolgreich und strategisch handelnd"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}