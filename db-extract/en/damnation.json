                "translations": [
                    {
                        "translation_id": "812afef0-c1e2-43f9-b0c9-9c03d101fb02",
                        "source_entry_id": "5ed775db-99e1-3396-b511-9b0de2f31095",
                        "source_sense_description": "The state of being damned; condemnation; openly expressed disapprobation",
                        "target_lang_word": "Verdammnis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verdammnis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fca9f7ff-046a-3189-9d5d-359ce7f8dc8c",
                                        "entry_id": "93ed56db-e648-3a88-8d83-29546524fd92",
                                        "glosses": [
                                            "Verurteilung der Sünder zu ihrer Bestrafung in der Hölle"
                                        ],
                                        "tags": [
                                            "Theologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d097f39-2911-4f97-b4e6-7682082dff4b",
                                                "sense_id": "fca9f7ff-046a-3189-9d5d-359ce7f8dc8c",
                                                "text": "Ihre Seelen erwartet die Verdammnis."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "46b38ec0-4b3d-3515-a207-9f94e19cccf4",
                                        "entry_id": "93ed56db-e648-3a88-8d83-29546524fd92",
                                        "glosses": [
                                            "(schuldhafter) Verlust der Gnade Gottes, Zustand schwerer Schuld"
                                        ],
                                        "tags": [
                                            "Theologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7177f462-9ea5-4d02-be65-dafdc765e2d4",
                                                "sense_id": "46b38ec0-4b3d-3515-a207-9f94e19cccf4",
                                                "text": "„Wie nun durch die Sünde des Einen die Verdammnis über alle Menschen gekommen ist, so ist auch durch die Gerechtigkeit des Einen für alle Menschen die Rechtfertigung gekommen, die zum Leben führt.“"
                                            },
                                            {
                                                "example_id": "8787c163-ba1d-4342-aa00-983c72cf27ec",
                                                "sense_id": "46b38ec0-4b3d-3515-a207-9f94e19cccf4",
                                                "text": "„Da antwortete der andere, wies ihn zurecht und sprach: Fürchtest du nicht einmal Gott, der du doch in gleicher Verdammnis bist?“"
                                            },
                                            {
                                                "example_id": "9e3414bd-ff2d-4b50-93fe-3c3e79920f52",
                                                "sense_id": "46b38ec0-4b3d-3515-a207-9f94e19cccf4",
                                                "text": "„Er fühle bereits die Verdammnis nahen, die der von mir herabbeschworenen Rache der Heiligen Jungfrau entspringe; er fühle Krämpfe in seinen Eingeweiden wühlen, und seine Zunge sei von Geschwüren bedeckt.“"
                                            },
                                            {
                                                "example_id": "75167e9e-a760-467f-a3c0-df3be0f563f3",
                                                "sense_id": "46b38ec0-4b3d-3515-a207-9f94e19cccf4",
                                                "text": "„Und Verdammnis lauerte überall.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
