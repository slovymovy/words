                "senses": [
                    {
                        "sense_id": "ef4827cb-407b-3b14-b711-71371656c0c6",
                        "entry_id": "ea6aaa20-fda2-3ede-9560-14315017e8b8",
                        "glosses": [
                            "uczestnik seminarium uczelnianego"
                        ],
                        "tags": [
                            "stud."
                        ],
                        "examples": [
                            {
                                "example_id": "6c930aa6-f86b-4e11-a984-0ab0894a0f7c",
                                "sense_id": "ef4827cb-407b-3b14-b711-71371656c0c6",
                                "text": "W przerwie między wykładami seminarzystki i seminarzyści mogą zakupić potrzebny podręcznik w uczelnianym sklepiku wydawniczym."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "fc5bb1bb-e5c9-347b-8e3d-05465560d619",
                        "entry_id": "ea6aaa20-fda2-3ede-9560-14315017e8b8",
                        "glosses": [
                            "student seminarium duchownego"
                        ],
                        "tags": [
                            "stud."
                        ],
                        "examples": [
                            {
                                "example_id": "282ac95e-ca62-40d1-9f8f-05c37f7b46d4",
                                "sense_id": "fc5bb1bb-e5c9-347b-8e3d-05465560d619",
                                "text": "W części seminarium, w której mieszkają seminarzyści, zgasły już wszystkie światła."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
