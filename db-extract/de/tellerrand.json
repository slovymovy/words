                                "example_id": "ac1bf2f4-08d4-4366-ab2b-b895d9cc203a",
                                "sense_id": "d58ab3b4-3a68-3fec-9142-f8aeb6732b28",
                                "text": "Er schob das verschmähte Gemüse über den Tellerrand auf den Boden."
                            },
                            {
                                "example_id": "aa9c98a7-efbc-483a-bed9-19e6371748aa",
                                "sense_id": "d58ab3b4-3a68-3fec-9142-f8aeb6732b28",
                                "text": "„Das Stück Eisbombe zerfließt sofort, es läuft über den Tellerrand fort, der ganze Teller quillt über.“"
                            },
                            {
                                "example_id": "32a56c03-6f3c-4b93-940a-018255c63c3f",
                                "sense_id": "d58ab3b4-3a68-3fec-9142-f8aeb6732b28",
                                "text": "„Bevor sie in das Pizzastück, das sie sich genommen hat, hineinbeißt, nimmt sie den Käse mit ihren langen, silber lackierten Fingernägeln herunter und legt ihn auf den Tellerrand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4c2254eb-5306-3af8-a803-164bd2047158",
                        "entry_id": "474da86b-995d-3cc3-88ca-68cde198b262",
                        "glosses": [
                            "im übertragenen Sinne: der geographische beziehungsweise kulturelle Horizont einer Person oder Personengruppe"
                        ],
                        "tags": [],
                        "examples": [
