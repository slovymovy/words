                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65b8a5ca-f26b-4212-8fcf-ad035ee23bb5",
                                                "sense_id": "06e4bec4-7211-3f10-aacd-8bc4d3194224",
                                                "text": "Im Fernsehen läuft gerade eine hitzige Diskussion zwischen zwei sehr streitbaren Politikern."
