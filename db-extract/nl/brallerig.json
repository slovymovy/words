                ],
                "senses": [
                    {
                        "sense_id": "59a5b91c-3aff-3977-9577-4b8f93adcd03",
                        "entry_id": "9b60f0ae-b77c-3e94-9655-bd163bea11a9",
                        "glosses": [
                            "luidruchtig en opschepperig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f7fbd56-25de-4c92-b7f8-78264f685bb9",
                                "sense_id": "59a5b91c-3aff-3977-9577-4b8f93adcd03",
                                "text": "Een week eerder zit ik op het terras, met vriendin M. Er komt een nogal brallerig type aan het tafeltje naast ons zitten, die er eens lekker voor gaat zitten. Het resultaat: hij zit bijna óp mijn vriendin."
                            },
                            {
                                "example_id": "3abe88d8-957e-4d2a-890e-131d0f09fdcd",
                                "sense_id": "59a5b91c-3aff-3977-9577-4b8f93adcd03",
                                "text": "Van Ekelenburg: „Wij kennen Hitler allemaal van zijn brallerige toespraken. Maar als schrijver was hij een stuk netter en bezadigder. Ik heb getracht vanuit zijn psyche te schrijven.” Hij laat Hitler zaken zeggen als: ‘Het bevattingsvermogen van de grote massa is maar zeer beperkt, het begrip gering; de vergeetachtigheid is daarentegen groot’. En: ‘Mijn visie, een verenigd Europa onder Duitse leiding waarin iedereen in vrede en vrijheid kan leven, heeft immer als baken gediend’."
                            },
                            {
                                "example_id": "005ce878-c9fd-46d8-8a40-1b9c21aa4dd2",
                                "sense_id": "59a5b91c-3aff-3977-9577-4b8f93adcd03",
                                "text": "Joshua en zijn vriendin Katia hebben besloten samen verder het Caribische Gebied in te zeilen. Het jonge stel vaart paradijselijke baaien in bij exotische eilanden. Alleen jammer dat er af door het beeld een luidruchtige charterboot vaart met achter het stuurwiel een brallerige zondagsschipper."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b0205f2-eb62-4f59-8c34-1b94cbfe4295",
                        "source_entry_id": "9b60f0ae-b77c-3e94-9655-bd163bea11a9",
                        "source_sense_id": "59a5b91c-3aff-3977-9577-4b8f93adcd03",
                        "target_lang_word": "grandiloquent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grandiloquent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "400423a9-c04e-34c2-8adb-2ff429751280",
                                        "entry_id": "d4e1299b-e682-3d7c-a639-7a0ae5c33a6c",
                                        "glosses": [
                                            "Given to using language in a showy way by using an excessive number of difficult words to impress others; bombastic; turgid."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a764eb62-4b34-4845-9d09-b221ddfa41a0",
                                                "sense_id": "400423a9-c04e-34c2-8adb-2ff429751280",
                                                "text": "The American people believe that they have a free country, and we are treated to grandiloquent speeches about our flag and our reputation for freedom and enlightenment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c904610-b7e4-4495-91e0-0358ff97b440",
                        "source_entry_id": "9b60f0ae-b77c-3e94-9655-bd163bea11a9",
                        "source_sense_id": "59a5b91c-3aff-3977-9577-4b8f93adcd03",
                        "target_lang_word": "boastful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boastful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7437c9f-4a28-332b-9085-b23d999a86ff",
                                        "entry_id": "e21e2ca6-d70c-317c-9d5b-365ca5c872fb",
                                        "glosses": [
                                            "Tending to boast or brag."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ec77222-765b-4093-a706-2248ae60e3f9",
                                                "sense_id": "f7437c9f-4a28-332b-9085-b23d999a86ff",
                                                "text": "He wrote a boastful autobiography, recording all his great deeds."
                                            },
                                            {
                                                "example_id": "66b42905-06fc-4aae-b316-40363fedc417",
                                                "sense_id": "f7437c9f-4a28-332b-9085-b23d999a86ff",
                                                "text": "It makes one's blood boil, yet heart tremble, to think that we Englishmen and our American descendants, with their boastful cry of liberty, have been and are so guilty"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f9a8dc50-49d0-408a-b785-5d0bb9f4c4a2",
                        "source_entry_id": "9b60f0ae-b77c-3e94-9655-bd163bea11a9",
                        "source_sense_id": "59a5b91c-3aff-3977-9577-4b8f93adcd03",
                        "target_lang_word": "boasting",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boasting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97abc835-3d58-3097-8133-5a8e14cd5d8d",
                                        "entry_id": "84bfa3f1-e469-3222-9074-7dc04f374d1a",
