                        "source_sense_id": "12869ec7-de59-3d1d-a984-a0e526d821f8",
                        "source_sense_description": "Finanzen: Investition von Geld in etwas, von dem man sich einen Ertrag verspricht",
                        "target_lang_word": "investment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "investment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7af667ac-0d7c-3ad1-8f22-cdb88c2f1f35",
                                        "entry_id": "e5b81574-b404-3893-9821-273d3ce723a9",
                                        "glosses": [
                                            "The act of investing, or state of being invested."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0decc7e6-7191-4cb5-98c5-de59a30c8ba4",
                                                "sense_id": "7af667ac-0d7c-3ad1-8f22-cdb88c2f1f35",
                                                "text": "Giving your children a good education is a wise long-term investment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d2f42ee-f1a5-31bd-ad35-644ea1109b02",
                                        "entry_id": "e5b81574-b404-3893-9821-273d3ce723a9",
                                        "glosses": [
                                            "A placement of capital in expectation of deriving income or profit from its use or appreciation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "365efd08-79ee-40a0-9b6e-0f9bedabbcec",
                                                "sense_id": "3d2f42ee-f1a5-31bd-ad35-644ea1109b02",
                                                "text": "An investment in ink, paper, and steel pens."
                                            },
                                            {
                                                "example_id": "78de4469-1ecd-4d1c-bea3-9e9b1e4d9ea7",
                                                "sense_id": "3d2f42ee-f1a5-31bd-ad35-644ea1109b02",
                                                "text": "Hidden behind thickets of acronyms and gorse bushes of detail, a new great game is under way across the globe.[…]The current power play consists of an extraordinary range of countries simultaneously sitting down to negotiate big free trade and investment agreements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77b81535-9e7c-314c-9391-355b653911d5",
                                        "entry_id": "e5b81574-b404-3893-9821-273d3ce723a9",
                                        "glosses": [
                                            "A vestment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6bb2ae8-b95e-40e3-ba9a-048333ba68e6",
                                                "sense_id": "77b81535-9e7c-314c-9391-355b653911d5",
                                                "text": "Whose white investments figure innocence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44646829-2264-371c-8efa-038b2a33b9d2",
                                        "entry_id": "e5b81574-b404-3893-9821-273d3ce723a9",
                                        "glosses": [
                                            "The act of surrounding, blocking up, or besieging by an armed force, or the state of being so surrounded."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "342032f4-07b8-4ba5-90e4-acb172c11a1e",
                                                "sense_id": "44646829-2264-371c-8efa-038b2a33b9d2",
                                                "text": "the investment of the fort"
                                            },
                                            {
                                                "example_id": "37458221-a874-4c6a-8456-d49e7771053b",
                                                "sense_id": "44646829-2264-371c-8efa-038b2a33b9d2",
                                                "text": "In 1858, the Governor of Kuangsi applied for his services, but the Viceroy Tsêng Kuo-fan, under whom he had served for a number of years and who recognised his value, declined to part with him. In 1860 he assisted in the defeat of the rebel reinforcements at the Hsiao-ch‘ih post station and took part in the capture of Taihu, investment of An-ch‘ing and destruction of the rebel camp at Linghu. For his services in the capture of Anch‘ing he was rewarded with the title of Baturu and placed on the list of Brigade Generals. He was next sent to Chihchow in Anhui to make reconnaissances of the country and occupy the commanding situations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4df2e5fe-fa93-3e2e-bc43-ddc3b1b0be59",
                                        "entry_id": "e5b81574-b404-3893-9821-273d3ce723a9",
                                        "glosses": [
                                            "A mixture of silica sand and plaster which, by surrounding a wax pattern, creates a negative mold of the form used for casting, among other metals, bronze."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f7ec34a-0f64-408d-90b5-77fdfd98cb50",
                        "source_entry_id": "d8b67e77-3a6c-30c1-bb1a-6a384ea56a38",
                        "source_sense_id": "12869ec7-de59-3d1d-a984-a0e526d821f8",
                        "source_sense_description": "Finanzen: Investition von Geld in etwas, von dem man sich einen Ertrag verspricht",
                        "target_lang_word": "investissement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "investissement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e6519bcb-93e0-3abd-b528-1e31f306673d",
                                        "entry_id": "a3fb540c-d7a5-3a9f-9ccf-1216aac4aa7c",
                                        "glosses": [
                                            "Action d’investir une place, une ville, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c37e621f-90bf-42fc-b9a8-89f4523ef950",
                                                "sense_id": "e6519bcb-93e0-3abd-b528-1e31f306673d",
                                                "text": "La bataille s’est livrée avant qu'il y arrivât. Il a échappé au désastre et il s’est replié sur Paris, où il est rentré, trois jours avant que l’investissement fût complet."
                                            },
                                            {
                                                "example_id": "49b5565b-84ce-4cdd-a9f8-0a1effbf77a1",
                                                "sense_id": "e6519bcb-93e0-3abd-b528-1e31f306673d",
                                                "text": "« Le premier jour de l’investissement, je montai chez eux — je me souviens — très ému, avec cette angoisse au cœur que nous donnaient à tous les portes de Paris fermées, la bataille sous les murs, nos banlieues devenues frontières."
                                            },
                                            {
                                                "example_id": "da0874c3-9ad1-49bb-8b9a-ee62d6924451",
                                                "sense_id": "e6519bcb-93e0-3abd-b528-1e31f306673d",
                                                "text": "Le 19, l'investissement de la capitale était complet, et le siège commençait."
                                            },
                                            {
                                                "example_id": "a4fbe11a-b824-4645-8c05-1084fae288cb",
                                                "sense_id": "e6519bcb-93e0-3abd-b528-1e31f306673d",
                                                "text": "Les toiles avaient été roulées dès les premiers jours de l’investissement, mises dans des caisses et transportées en des magasins où il ne put jamais les découvrir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdf2fb97-5d9e-35b2-b19f-faa188493605",
                                        "entry_id": "a3fb540c-d7a5-3a9f-9ccf-1216aac4aa7c",
                                        "glosses": [
                                            "Placement de capitaux dans une activité économique."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f75da55-4d36-4302-ab75-c34a4c43af2d",
                                                "sense_id": "cdf2fb97-5d9e-35b2-b19f-faa188493605",
                                                "text": "Le double objectif de la tontine est de permettre au membre de libérer sa cotisation (comme s'il faisait une épargne) et de pouvoir bénéficier d'une importante somme en vue de réaliser un investissement ou une dépense."
                                            },
                                            {
                                                "example_id": "2bed3855-5c78-4912-9ac5-1d3f7ff54cb7",
                                                "sense_id": "cdf2fb97-5d9e-35b2-b19f-faa188493605",
                                                "text": "Une commission d’enquête du Sénat américain a déjà montré que le prix du Sovaldi avait été fixé par le laboratoire Gilead, non pas en fonction de son coût d’investissement, mais après une fine étude de marketing."
                                            },
                                            {
                                                "example_id": "c96e84c9-a550-45e6-8732-e4628cdcb3dd",
                                                "sense_id": "cdf2fb97-5d9e-35b2-b19f-faa188493605",
                                                "text": "Les investissements récents l’ont déjà démontré, notamment les 26 M€ posés pour Jérémy Doku en 2020 ou les 15 M€ pour Laborde fin août dernier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79536b05-3263-33d9-9136-65f11e7692ed",
                                        "entry_id": "a3fb540c-d7a5-3a9f-9ccf-1216aac4aa7c",
                                        "glosses": [
                                            "Fait de s'investir personnellement dans une activité, un projet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5f03def-4a7f-4f47-a29c-60c18888d68f",
                                                "sense_id": "79536b05-3263-33d9-9136-65f11e7692ed",
                                                "text": "« Tout s’est déroulé dans un excellent climat, les enfants faisant preuve d’un grand investissement dans le calme et la sérénité » , constatait Patrick Jorge, le mentor de l’événement, jamais bien loin de la caméra."
                                            },
                                            {
                                                "example_id": "f1fcb7d5-b072-451c-b577-49d98bdec73b",
                                                "sense_id": "79536b05-3263-33d9-9136-65f11e7692ed",
                                                "text": "L’investissement des arpètes dans ce don de soi a été marqué par plusieurs temps forts."
                                            },
                                            {
                                                "example_id": "f7d07d65-7cc0-48b9-bdfb-ccdc4163f1cc",
                                                "sense_id": "79536b05-3263-33d9-9136-65f11e7692ed",
                                                "text": "En l’honneur de son investissement pour la féminisation du langage, ce fut d’ailleurs un femmage et non un hommage qui lui fut rendu sur ce même site."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
