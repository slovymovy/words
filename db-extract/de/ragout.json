                        ]
                    },
                    {
                        "translation_id": "3d8fb64d-cbb0-4ee3-9076-f0842b279598",
                        "source_entry_id": "15100ea2-9bbf-3a43-9e89-6dcfee53db81",
                        "source_sense_id": "81c100c2-4a25-300e-b939-b7603127c3b1",
                        "source_sense_description": "aus klein geschnittenem Fleisch, Fisch oder anderen Zutaten zubereitetes Schmorgericht",
                        "target_lang_word": "ragoût",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ragoût",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d1681e84-50cd-3ccd-b83e-82ea56d9b76e",
                                        "entry_id": "08008aa4-ce0a-3dbe-ab4f-047166e827be",
                                        "glosses": [
                                            "Viande accommodée avec une sauce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e081f17-95ea-4c50-8c2e-ade7cd267db3",
                                                "sense_id": "d1681e84-50cd-3ccd-b83e-82ea56d9b76e",
                                                "text": "Une porte latérale s'ouvrit, et nous entrâmes dans une pièce voûtée où, sur un long potager, bouillaient dix ragoûts."
                                            },
                                            {
                                                "example_id": "8ff64917-31a3-4b6b-9795-c982dd0bf1c4",
                                                "sense_id": "d1681e84-50cd-3ccd-b83e-82ea56d9b76e",
                                                "text": "Entre deux falaises de primeurs étagées en munitions, les effluves toniques du ragoût de mouton luttaient désespérément contre ceux, plus sucrés, de la marijuana."
                                            },
                                            {
                                                "example_id": "e084dfca-a77e-4fb8-9c68-99a9e38250c7",
                                                "sense_id": "d1681e84-50cd-3ccd-b83e-82ea56d9b76e",
                                                "text": "Ma mère faisait un délicieux ragoût de mouton qu'elle appelait barboton."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06f8d1f5-7d10-3a0b-813c-a01a7dd882f6",
                                        "entry_id": "08008aa4-ce0a-3dbe-ab4f-047166e827be",
                                        "glosses": [
                                            "Mets goûteux, même préparé sans viande."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f910a908-fe35-46c3-976c-3ba8b1bcb451",
                                                "sense_id": "06f8d1f5-7d10-3a0b-813c-a01a7dd882f6",
                                                "text": "Une nourriture commune donne autant de plaisir qu’un festin somptueux, et c’est un ragoût admirable que l’eau et le pain lorsque l’on en trouve dans le temps de sa faim et de si soif."
                                            },
                                            {
                                                "example_id": "aa4ec90c-eda8-4e3d-93a2-b1577325edd1",
                                                "sense_id": "06f8d1f5-7d10-3a0b-813c-a01a7dd882f6",
                                                "text": "Ah ! s’il avait su, il n’aurait jamais eu cette marmaille, qui le forçait à ne plus fumer que quatre sous de tabac par jour, et qui ramenait par trop souvent, au dîner, des ragoûts de pomme de terre, un plat qu’il méprisait profondément."
                                            },
                                            {
                                                "example_id": "b5ba7106-2e1a-48c9-907f-9d10d207f687",
                                                "sense_id": "06f8d1f5-7d10-3a0b-813c-a01a7dd882f6",
                                                "text": "La cacasse à cul nu, repas habituel était la fricassée du pauvre. On faisait brûler légèrement les pommes de terre au lard au fond d'une casserole en fonte pour donner à ce simple ragoût un petit goût de roussi agréable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06989a13-09cf-3970-905d-407f1fce593a",
                                        "entry_id": "08008aa4-ce0a-3dbe-ab4f-047166e827be",
                                        "glosses": [
                                            "Ce qui rend appétissant, ce qui excite le désir, l’intérêt."
                                        ],
                                        "tags": [
                                            "dated",
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a74b45e6-16d5-4dd2-9034-4202b43635ae",
                                                "sense_id": "06989a13-09cf-3970-905d-407f1fce593a",
                                                "text": "La difficulté est une espèce de ragoût."
                                            },
                                            {
                                                "example_id": "1cc71097-2116-406e-b2ca-cca5d9aab03b",
                                                "sense_id": "06989a13-09cf-3970-905d-407f1fce593a",
                                                "text": "Il y a un ragoût dans la nouveauté."
                                            },
                                            {
                                                "example_id": "4b58c861-37db-4e22-a6c3-8f182b7348ab",
                                                "sense_id": "06989a13-09cf-3970-905d-407f1fce593a",
                                                "text": "Quel ragoût trouvez-vous à cela ? : Quel plaisir y trouvez-vous ?"
                                            },
                                            {
                                                "example_id": "7b1c258c-1169-4404-b3ec-b3048cffe3a7",
                                                "sense_id": "06989a13-09cf-3970-905d-407f1fce593a",
                                                "text": "Quel plaisir de baiser ces lèvres qui vous disent : « Je t’abhorre ! » Cela a plus de ragoût que cet éternel et fade : « Je t’aime, » dont les femmes vous écœurent. »"
                                            },
                                            {
                                                "example_id": "9c03ee68-d162-4229-8981-a27d9794d8b1",
                                                "sense_id": "06989a13-09cf-3970-905d-407f1fce593a",
                                                "text": "Le ragoût était que ces filles réservaient pour les salons des danses plus libres encore, d’un tel abandon charnel, qu’on ne les aurait certainement pas autorisées dans un théâtre."
                                            },
                                            {
                                                "example_id": "6cd8e717-a0c0-4a67-b3a2-878a2cacf189",
                                                "sense_id": "06989a13-09cf-3970-905d-407f1fce593a",
                                                "text": "En effet, il projetait dans le débat des clartés qui me paraissaient admirables… Étaient-elles en somme si admirables ?… Je crois bien que je vomirais aujourd’hui ce ragoût."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
