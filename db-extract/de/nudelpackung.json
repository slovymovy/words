                                "example_id": "d599d133-d70e-4671-ad01-70d9df359155",
                                "sense_id": "199326fb-9e82-3707-a5bb-887420d96ea9",
                                "text": "„Papierkörbe quollen über von zerknüllten Telefaxen, Nudelpackungen und Bierdosen, und auf jedem Schreibtisch stand ein Computer.“"
                            },
                            {
                                "example_id": "b0edd0f9-33d8-471e-a1f6-1568f7a543e4",
                                "sense_id": "199326fb-9e82-3707-a5bb-887420d96ea9",
                                "text": "„Fortuna schlich in die fensterlose Vorratskammer, die sich an die Küche anschloss, schob auf einem breiten, brusthohen Regal ein paar Nudelpackungen beiseite und kletterte hinauf, sodass er sich auf Augenhöhe mit der Tür befand.“"
                            }
