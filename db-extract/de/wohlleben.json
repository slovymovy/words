                ],
                "senses": [
                    {
                        "sense_id": "6f36f156-9029-3643-b6ea-8eb7772e9f9b",
                        "entry_id": "bba70970-26b8-35b6-95d8-1c475ed7e7e4",
                        "glosses": [
                            "durch Privilegien und Wohlstand ermöglichtes üppiges und sorgloses Leben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4fc5a36-2b16-433e-b972-3ea6f3dda94c",
                                "sense_id": "6f36f156-9029-3643-b6ea-8eb7772e9f9b",
                                "text": "„Zur öffentlichen Darstellung des Wohllebens gehörte auch Wohlbeleibtheit und eine demonstrative Effeminiertheit.“"
                            },
                            {
                                "example_id": "9f54e313-4634-4c68-a3d7-8f2d5d2ad5f8",
                                "sense_id": "6f36f156-9029-3643-b6ea-8eb7772e9f9b",
                                "text": "„… der Adel sage ich, der von eurem Schweiße schwelgte, der sich überall Steuern und Abgaben frei erklärte, fürchtete den Verlust seines Wohllebens, und der sogenannten hohen Vorrechte.“"
                            },
                            {
                                "example_id": "8724c675-6719-4131-815e-d72f94e6c998",
                                "sense_id": "6f36f156-9029-3643-b6ea-8eb7772e9f9b",
                                "text": "„Doch so sehr auf Wohlleben bedacht Murr auch sein mag, er ist ein vollständiges Individuum mit Gefühlen und Gedanken, das in langen, verworren geschwätzigen Aperçus die simplistische Philosophie entwickelt, die seinem Temperament ansteht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
