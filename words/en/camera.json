                {
                    "sense_id": "89c62c8f-8df8-3bb8-9aca-168f74f2bee5",
                    "sense_definition": "The viewpoint in a three-dimensional game or simulation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "viewpoint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can adjust the <w>camera</w> angle to see behind the character.",
                            "target_lang_translations": {
                                "ru": "Вы можете настроить угол <w>камеры</w>, чтобы видеть, что находится за персонажем.",
                                "nl": "Je kunt de hoek van de <w>camera</w> aanpassen om achter het personage te kijken.",
                                "pl": "Możesz dostosować kąt <w>kamery</w>, aby widzieć, co jest za postacią.",
                                "de": "Du kannst den <w>Kamera</w>winkel anpassen, um hinter die Spielfigur zu sehen.",
                                "fr": "Vous pouvez ajuster l'angle de la <w>caméra</w> pour voir derrière le personnage.",
                                "it": "Puoi regolare l'angolazione della <w>telecamera</w> per vedere dietro il personaggio.",
                                "cs": "Můžete upravit úhel <w>kamery</w>, abyste viděli za postavu.",
                                "tr": "Karakterin arkasını görmek için <w>kamera</w> açısını ayarlayabilirsiniz.",
                                "es": "Puedes ajustar el ángulo de la <w>cámara</w> para ver detrás del personaje."
                            }
                        },
                        {
                            "text": "The game allows you to invert the <w>camera</w> controls.",
                            "target_lang_translations": {
                                "ru": "Игра позволяет инвертировать управление <w>камерой</w>.",
                                "nl": "Het spel stelt je in staat om de besturing van de <w>camera</w> om te keren.",
                                "pl": "Gra pozwala na odwrócenie sterowania <w>kamerą</w>.",
                                "de": "Das Spiel ermöglicht es dir, die <w>Kamera</w>steuerung umzukehren.",
                                "fr": "Le jeu vous permet d'inverser les commandes de la <w>caméra</w>.",
                                "it": "Il gioco ti permette di invertire i controlli della <w>telecamera</w>.",
                                "cs": "Hra umožňuje invertovat ovládání <w>kamery</w>.",
                                "tr": "Oyun, <w>kamera</w> kontrollerini tersine çevirmenize olanak tanır.",
                                "es": "El juego te permite invertir los controles de la <w>cámara</w>."
                            }
