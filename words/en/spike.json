{
    "word_family": [
        "spiky",
        "spiked",
        "spiking",
        "spikeless"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c5219de2-69ff-3ca0-a6bd-ba072c8497d8",
                    "sense_definition": "To increase sharply and suddenly in value, amount, or degree.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Traffic accidents <w>spiked</w> in December when there was ice on the roads.",
                            "target_lang_translations": {
                                "ru": "Количество дорожных происшествий резко <w>подскочило</w> в декабре, когда на дорогах был гололед."
                            }
                        },
                        {
                            "text": "The demand for cold drinks tends to <w>spike</w> during the summer holidays.",
                            "target_lang_translations": {
                                "ru": "Спрос на прохладительные напитки обычно резко <w>возрастает</w> во время летних каникул."
                            }
                        }
                    ],
                    "antonyms": [
                        "plummet",
                        "drop"
                    ],
                    "common_phrases": [
                        "spike in prices",
                        "demand spikes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Резко и внезапно возрастать в цене, количестве или степени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подскочить",
                                "target_lang_sense_clarification": "о цене, температуре или показателях"
                            },
                            {
                                "target_lang_word": "резко вырасти",
                                "target_lang_sense_clarification": "о значениях или количестве"
                            },
                            {
                                "target_lang_word": "подпрыгнуть",
                                "target_lang_sense_clarification": "разговорное о ценах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2091855-7b4c-39e2-92cd-5ec52ab9824a",
                    "sense_definition": "To secretly add alcohol or a drug to a drink.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "adulterate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She realized someone had <w>spiked</w> her drink at the party when she started feeling dizzy.",
                            "target_lang_translations": {
                                "ru": "Она поняла, что кто-то <w>подмешал</w> что-то ей в напиток на вечеринке, когда у неё закружилась голова."
                            }
                        },
                        {
                            "text": "It is dangerous to <w>spike</w> someone's tea without their knowledge.",
                            "target_lang_translations": {
                                "ru": "Опасно <w>подсыпать</w> что-либо в чей-то чай без ведома человека."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spike a drink",
                        "spiked with vodka"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in social contexts regarding drinks"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тайно подмешать алкоголь или наркотик в напиток."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подмешать",
                                "target_lang_sense_clarification": "что-то в напиток"
                            },
                            {
                                "target_lang_word": "подсыпать",
                                "target_lang_sense_clarification": "наркотик или порошок"
                            },
                            {
                                "target_lang_word": "разбавить",
                                "target_lang_sense_clarification": "алкоголем"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b9993a4-2f69-374b-a8f5-cf550d9b2008",
                    "sense_definition": "In sports like volleyball, to hit the ball forcefully downwards into the opponent's court.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sports_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player jumped high to <w>spike</w> the ball over the net.",
                            "target_lang_translations": {
                                "ru": "Игрок высоко подпрыгнул, чтобы <w>пробить</w> мяч через сетку."
                            }
                        },
                        {
                            "text": "She managed to <w>spike</w> the volleyball perfectly to win the final point.",
                            "target_lang_translations": {
                                "ru": "Ей удалось идеально <w>погасить</w> волейбольный мяч и выиграть решающее очко."
                            }
                        }
                    ],
                    "synonyms": [
                        "attack",
                        "hit"
                    ],
                    "common_phrases": [
                        "spike the ball"
                    ],
                    "target_lang_definitions": {
                        "ru": "В волейболе: наносить сильный удар по мячу сверху вниз на сторону противника."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пробивать",
                                "target_lang_sense_clarification": "нападающий удар"
                            },
                            {
                                "target_lang_word": "гасить",
                                "target_lang_sense_clarification": "сильно бить сверху вниз"
                            },
                            {
                                "target_lang_word": "атаковать",
                                "target_lang_sense_clarification": "в спорте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "747b7963-5ca7-32be-8e6f-d16555b7174e",
                    "sense_definition": "To stop a story from being published or to cancel a plan.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "cancel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor decided to <w>spike</w> the story because it lacked sufficient evidence.",
                            "target_lang_translations": {
                                "ru": "Редактор решил <w>зарезать</w> статью, так как в ней не хватало доказательств."
                            }
                        },
                        {
                            "text": "An unexpected injury <w>spiked</w> his plans to turn professional this year.",
                            "target_lang_translations": {
                                "ru": "Неожиданная травма <w>похоронила</w> его планы перейти в профессионалы в этом году."
                            }
                        }
                    ],
                    "antonyms": [
                        "publish"
                    ],
                    "common_phrases": [
                        "spike the story",
                        "spike the plans"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in journalism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Снять материал с печати или отменить план."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зарезать",
                                "target_lang_sense_clarification": "статью или проект"
                            },
                            {
                                "target_lang_word": "заброковать",
                                "target_lang_sense_clarification": "материал"
                            },
                            {
                                "target_lang_word": "похоронить",
                                "target_lang_sense_clarification": "планы или историю"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f54475f-356b-32b1-8e7d-350b4274f0fd",
                    "sense_definition": "To fasten or secure something using long, heavy nails.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fasten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers had to <w>spike</w> down the heavy wooden planks to the deck.",
                            "target_lang_translations": {
                                "ru": "Рабочим пришлось <w>прибить</w> тяжелые деревянные доски к палубе."
                            }
                        },
                        {
                            "text": "They used long metal rods to <w>spike</w> the timber into place.",
                            "target_lang_translations": {
                                "ru": "Они использовали длинные металлические стержни, чтобы <w>закрепить</w> брус на месте."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spike down planks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Закреплять или прибивать что-либо длинными тяжелыми гвоздями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прибивать",
                                "target_lang_sense_clarification": "крупными гвоздями"
                            },
                            {
                                "target_lang_word": "закреплять",
                                "target_lang_sense_clarification": "штырями или костылями"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f5a39d16-d334-3498-8c57-4c370b7b8a35",
                    "sense_definition": "A very large, thick nail used for heavy construction.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fastener",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter used a heavy iron <w>spike</w> to hold the beams together.",
                            "target_lang_translations": {
                                "ru": "Плотник использовал тяжелый железный <w>костыль</w>, чтобы скрепить балки."
                            }
                        },
                        {
                            "text": "He hammered a large <w>spike</w> into the wood to secure the fence.",
                            "target_lang_translations": {
                                "ru": "Он вбил в дерево большой <w>штырь</w>, чтобы закрепить забор."
                            }
                        }
                    ],
                    "common_phrases": [
                        "iron spike",
                        "metal spike"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень большой, толстый гвоздь, используемый в тяжелом строительстве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "костыль",
                                "target_lang_sense_clarification": "железнодорожный или строительный гвоздь"
                            },
                            {
                                "target_lang_word": "штырь",
                                "target_lang_sense_clarification": "металлический стержень"
                            },
                            {
                                "target_lang_word": "нагель",
                                "target_lang_sense_clarification": "крупный крепежный элемент"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5616c800-dff2-3c0b-baae-7f851926de1d",
                    "sense_definition": "A sudden and brief increase in something, such as price, power, or activity.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Consumers saw an immediate <w>spike</w> in food prices after the border was closed.",
                            "target_lang_translations": {
                                "ru": "Потребители увидели немедленный <w>скачок</w> цен на продукты после закрытия границы."
                            }
                        },
                        {
                            "text": "The hospital prepared for a <w>spike</w> in patients during the flu season.",
                            "target_lang_translations": {
                                "ru": "Больница подготовилась к <w>всплеску</w> числа пациентов во время сезона гриппа."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spike in prices",
                        "sudden spike"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапный и кратковременный рост чего-либо (цены, напряжения, активности)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скачок",
                                "target_lang_sense_clarification": "резкое изменение показателей"
                            },
                            {
                                "target_lang_word": "всплеск",
                                "target_lang_sense_clarification": "активности или интереса"
                            },
                            {
                                "target_lang_word": "пик",
                                "target_lang_sense_clarification": "на графике"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61d85051-c8dc-3b32-baf1-38a73482fe76",
                    "sense_definition": "A sports shoe with metal points on the sole to prevent slipping.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "footwear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sprinter put on his <w>spikes</w> before heading to the starting blocks.",
                            "target_lang_translations": {
                                "ru": "Спринтер надел свои <w>шиповки</w>, прежде чем отправиться к стартовым колодкам."
                            }
                        },
                        {
                            "text": "You should wear your <w>spikes</w> to get better grip on the muddy track.",
                            "target_lang_translations": {
                                "ru": "Тебе стоит надеть <w>бутсы</w>, чтобы лучше держаться на грязной дорожке."
                            }
                        }
                    ],
                    "common_phrases": [
                        "running spikes",
                        "track spikes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Спортивная обувь с металлическими шипами на подошве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шиповки",
                                "target_lang_sense_clarification": "беговая обувь"
                            },
                            {
                                "target_lang_word": "бутсы",
                                "target_lang_sense_clarification": "с шипами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4aa7ad82-c6f6-3f35-84ce-e45cfd3fff7b",
                    "sense_definition": "A powerful downward hit of the ball in volleyball.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sports_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The opponent could not block the powerful <w>spike</w> from the star player.",
                            "target_lang_translations": {
                                "ru": "Противник не смог заблокировать мощный <w>удар</w> звездного игрока."
                            }
                        },
                        {
                            "text": "Her perfectly timed <w>spike</w> sent the ball straight to the floor.",
                            "target_lang_translations": {
                                "ru": "Её своевременная <w>атака</w> отправила мяч прямо в пол."
                            }
                        }
                    ],
                    "common_phrases": [
                        "volleyball spike"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мощный удар по мячу сверху вниз в волейболе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нападающий удар",
                                "target_lang_sense_clarification": "в волейболе"
                            },
                            {
                                "target_lang_word": "атака",
                                "target_lang_sense_clarification": "завершающий удар"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f755100-b6b9-3801-8c2b-9acc7687dd2c",
                    "sense_definition": "A group of flowers growing along an unbranched stem.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lavender plant produces a beautiful purple <w>spike</w> of flowers.",
                            "target_lang_translations": {
                                "ru": "Лаванда выпускает красивый фиолетовый <w>колос</w> цветов."
                            }
                        },
                        {
                            "text": "Each <w>spike</w> of grain was heavy and ready for the harvest.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>колос</w> зерна был тяжелым и готовым к жатве."
                            }
                        }
                    ],
                    "common_phrases": [
                        "flower spike",
                        "spike of grain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соцветие, в котором цветки расположены вдоль неразветвленного стебля."
                    },
                    "translations": {
                        "ru": [
