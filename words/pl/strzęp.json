{
    "word_family": [
        "strzępić",
        "postrzępić",
        "strzępienie",
        "strzępiasty"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a79a70e0-2dea-3a32-9481-26d21c83202c",
                    "sense_definition": "oderwany, nieregularny kawałek materiału lub innej substancji",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fragment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na podłodze leżał tylko <w>strzęp</w> starej gazety.",
                            "target_lang_translations": {
                                "ru": "На полу лежал только <w>обрывок</w> старой газеты."
                            }
                        },
                        {
                            "text": "Wiatr porwał <w>strzęp</w> materiału z płotu.",
                            "target_lang_translations": {
                                "ru": "Ветер сорвал <w>лоскут</w> ткани с забора."
                            }
                        }
                    ],
                    "synonyms": [
                        "kłak"
                    ],
                    "common_phrases": [
                        "strzęp materiału"
                    ],
                    "target_lang_definitions": {
                        "ru": "оторванный, неровный кусок ткани или другого материала"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лоскут",
                                "target_lang_sense_clarification": "кусок ткани или материала"
                            },
                            {
                                "target_lang_word": "обрывок",
                                "target_lang_sense_clarification": "оторванная часть чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f9270ea-f671-3080-b1a3-9a280de615b5",
                    "sense_definition": "poszarpana resztka czegoś",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fragment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Z dawnej sukni zostały tylko <w>strzępy</w>.",
                            "target_lang_translations": {
                                "ru": "От старого платья остались только <w>клочья</w>."
                            }
                        },
                        {
                            "text": "Wściekły pies rozerwał ubranie na <w>strzępy</w>.",
                            "target_lang_translations": {
                                "ru": "Разъяренная собака разорвала одежду в <w>клочья</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rozerwać na strzępy"
                    ],
                    "target_lang_definitions": {
                        "ru": "разорванный остаток чего-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клочья",
                                "target_lang_sense_clarification": "множественное число, часто используется в выражении 'разорвать в клочья'"
                            },
                            {
                                "target_lang_word": "обрывки",
                                "target_lang_sense_clarification": "остатки чего-то порванного"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8c0d585-cf6c-3543-9ed3-a5c77494d292",
                    "sense_definition": "krótki, wyrwany z kontekstu fragment tekstu lub wypowiedzi",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fragment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Usłyszałem tylko <w>strzęp</w> rozmowy w korytarzu.",
                            "target_lang_translations": {
                                "ru": "Я услышал только <w>обрывок</w> разговора в коридоре."
                            }
                        },
                        {
                            "text": "W gazecie wydrukowano jedynie <w>strzęp</w> jego wypowiedzi.",
                            "target_lang_translations": {
                                "ru": "В газете напечатали лишь <w>фрагмент</w> его высказывания."
                            }
                        }
                    ],
                    "common_phrases": [
                        "strzęp informacji"
                    ],
                    "target_lang_definitions": {
                        "ru": "короткий, вырванный из контекста фрагмент текста или высказывания"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обрывок",
                                "target_lang_sense_clarification": "неполная часть информации или фразы"
                            },
                            {
                                "target_lang_word": "фрагмент",
                                "target_lang_sense_clarification": "часть целого текста или речи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "209b605a-543f-3075-ab67-c639d1a0b02e",
                    "sense_definition": "drobny, niepotrzebny odpad lub zanieczyszczenie na powierzchni",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "odpad",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po remoncie na podłodze zostały same <w>strzępy</w>.",
                            "target_lang_translations": {
                                "ru": "После ремонта на полу остались одни <w>обрезки</w>."
                            }
                        },
                        {
                            "text": "Musisz dokładnie sprzątnąć te <w>strzępy</w> z dywanu.",
                            "target_lang_translations": {
                                "ru": "Ты должен тщательно убрать эти <w>обрезки</w> с ковра."
                            }
                        }
                    ],
                    "synonyms": [
                        "reg. białost. farfocel"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "używane w niektórych regionach jako określenie paprocha"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "мелкий, ненужный мусор или загрязнение на поверхности"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обрезки",
                                "target_lang_sense_clarification": "мелкие остатки после работы с материалами"
                            },
                            {
                                "target_lang_word": "мусор",
                                "target_lang_sense_clarification": "общий термин для отходов"
                            }
                        ]
                    }
                }
            ]
        },
        {
