                        "examples": [
                            {
                                "example_id": "0ea6fb8d-740b-41c6-8c6b-67ec69bdb001",
                                "sense_id": "0d923e81-64c8-3832-8d45-51c9e0e7a425",
                                "text": "Go and talk to your mucker!"
                            },
                            {
                                "example_id": "04781c95-591c-4d98-bb1b-82dafcd44209",
                                "sense_id": "0d923e81-64c8-3832-8d45-51c9e0e7a425",
                                "text": "Too fucking late, son. I didn't want my mucker blown into tiny bits."
                            }
                        ]
