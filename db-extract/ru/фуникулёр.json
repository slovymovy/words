                                ]
                            },
                            {
                                "target_word": "funicular",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97d52baa-d7b8-3b45-8991-c3237aec7c8a",
                                        "entry_id": "f9e794ab-201a-3e75-8763-dec3060cc0bd",
                                        "glosses": [
                                            "A particular type of rail transit system which ascends a steep urban or mountain incline, having usually two cars sharing a single pair of tracks, with the cars linked by a moving cable and an arrangement of pulleys such that the descending car assists in the hoisting of the ascending car, i.e. the two cars serve as counterweights for each other."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a07d7db3-712d-4872-af7a-eb9e4392bb7b",
                                                "sense_id": "97d52baa-d7b8-3b45-8991-c3237aec7c8a",
                                                "text": "England's funiculars mostly hug the coast, and this is no coincidence. The development of the Victorian and Edwardian seaside resort played a central role in the uptake of funicular railways across England."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a48d2dd5-2697-49f8-bb14-96236e5bdd9d",
                        "source_entry_id": "0938051e-343e-3255-bb73-d98d1dd95712",
                        "source_sense_id": "3b4e1c3d-fe0b-370b-b0d4-018209672343",
                        "target_lang_word": "funicular railway",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "funicular railway",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c098e34-e874-3484-a9da-5d3a7c49ef91",
                                        "entry_id": "a2809140-0369-3c35-adff-1be9e7bb3f81",
                                        "glosses": [
                                            "A cable railway on an incline; especially one which operates on two tracks (or with a passing loop), with a pair of vehicles counterbalancing each other."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6be346e-7f2c-439f-934e-ef71f96d250f",
                                                "sense_id": "7c098e34-e874-3484-a9da-5d3a7c49ef91",
                                                "text": "Funicular railways take gradients to the extreme, running two cars in counterbalanced, contrary motion over often-perilous cliff inclines. [...] Britain's first funicular railways arrived in Scarborough in the 1870s."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3fb5164b-8358-4e58-b9bc-27d9c5b873be",
                        "source_entry_id": "0938051e-343e-3255-bb73-d98d1dd95712",
                        "source_sense_id": "3b4e1c3d-fe0b-370b-b0d4-018209672343",
                        "target_lang_word": "incline",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4adf33d0-1629-342e-8cb4-fd993309cf06",
                                        "entry_id": "d39d5c49-4ff9-3b93-b975-5cf8ac1cca5b",
                                        "glosses": [
                                            "To bend or move (something) out of a given plane or direction, often the horizontal or vertical."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "706726f2-f310-4bd6-8707-e3716b08958f",
                                                "sense_id": "4adf33d0-1629-342e-8cb4-fd993309cf06",
                                                "text": "He had to incline his body against the gusts to avoid being blown down in the storm."
                                            },
                                            {
                                                "example_id": "2bcb42e4-ffb5-48a9-bdf0-75579a8114fc",
                                                "sense_id": "4adf33d0-1629-342e-8cb4-fd993309cf06",
                                                "text": "The people following the coffin inclined their heads in grief."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "141706c2-c6a4-3510-81a8-3f8c52b40166",
                                        "entry_id": "d39d5c49-4ff9-3b93-b975-5cf8ac1cca5b",
                                        "glosses": [
                                            "To slope."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a42f58b2-8649-425a-ae18-0094ff8c8ea0",
                                                "sense_id": "141706c2-c6a4-3510-81a8-3f8c52b40166",
                                                "text": "Over the centuries the wind made the walls of the farmhouse incline."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8dbae7d6-55d2-31f0-8c50-347aaedfedf7",
                                        "entry_id": "d39d5c49-4ff9-3b93-b975-5cf8ac1cca5b",
                                        "glosses": [
                                            "To tend to do or believe something, or move or be moved in a certain direction, away from a point of view, attitude, etc."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c0ab46c-9ca6-4fa4-ac49-94011ef9184e",
                                                "sense_id": "8dbae7d6-55d2-31f0-8c50-347aaedfedf7",
                                                "text": "He inclines to believe anything he reads in the newspapers."
                                            },
                                            {
                                                "example_id": "d7fa1d59-b400-47a7-a6ab-c5a865794a90",
                                                "sense_id": "8dbae7d6-55d2-31f0-8c50-347aaedfedf7",
                                                "text": "I'm inclined to give up smoking after hearing of the risks to my health."
                                            },
                                            {
                                                "example_id": "2d87a473-b8a1-4c57-9e33-85891ae67a31",
                                                "sense_id": "8dbae7d6-55d2-31f0-8c50-347aaedfedf7",
                                                "text": "\"My tastes,\" he said, still smiling, \"incline me to the garishly sunlit side of this planet.\" And, to tease her and arouse her to combat: \"I prefer a farandole to a nocturne; I'd rather have a painting than an etching; Mr. Whistler bores me with his monochromatic mud; I don't like dull colours, dull sounds, dull intellects;[…].\""
                                            },
                                            {
                                                "example_id": "9d3f7679-da36-4a32-840e-d6c31aa6a6a4",
                                                "sense_id": "8dbae7d6-55d2-31f0-8c50-347aaedfedf7",
                                                "text": "The terp farmer made use of the plough, as is shown by the discovery of three ploughshares and four coulters. […] Those who inclined to the stock-breeding theory based their arguments on the absence of ploughs, […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "incline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "98463d2b-6ec6-39d9-b7fc-d5dd08090197",
                                        "entry_id": "0448fbf5-54c8-3f1c-aaff-ccf0ccb8dbf5",
                                        "glosses": [
                                            "A slope."
                                        ],
                                        "tags": [],
                                        "examples": [
