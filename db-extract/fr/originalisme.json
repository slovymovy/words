                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8dda7526-a8bb-4e3d-999a-03481a1c45f0",
                                                "sense_id": "97711938-a210-3845-be16-933393b34bf3",
                                                "text": "I've known Badalamenti since then, and have chatted with him over the years. Last fall, I spoke at the originalism conference he organized, which hosted the entire Florida Supreme Court, several members of the Eleventh Circuit, and scholars from across the ideological spectrum. I include these facts to show the high regard that Badalamenti is held in by his community."
                                            },
                                            {
                                                "example_id": "10ac967e-d977-49a3-802f-42efe600884c",
                                                "sense_id": "97711938-a210-3845-be16-933393b34bf3",
                                                "text": "One of the points that you’ve made in the past is that when originalism was first taking hold as a popular theory, one of the reasons for its popularity was that it was seen as offering a kind of restraint on justices."
                                            }
