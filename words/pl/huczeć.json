{
    "word_family": [
        "huk",
        "huczny"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2493ce11-2d1a-3357-a9d1-b7de1c8d77ed",
                    "sense_definition": "wydawać głośny, niski, dudniący dźwięk",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dźwięk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W oddali <w>huczy</w> wzburzone morze.",
                            "target_lang_translations": {
                                "ru": "Вдали <w>гудит</w> взволнованное море."
                            }
                        },
                        {
                            "text": "Wiatr <w>huczy</w> w kominie podczas burzy.",
                            "target_lang_translations": {
                                "ru": "Во время бури ветер <w>гудит</w> в дымоходе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "morze huczy",
                        "wiatr huczy"
                    ],
                    "target_lang_definitions": {
                        "ru": "издавать громкий, низкий, гудящий звук"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гудеть",
                                "target_lang_sense_clarification": "о звуке ветра, моря или механизмов"
                            },
                            {
                                "target_lang_word": "шуметь",
                                "target_lang_sense_clarification": "общий термин для громкого звука"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8ca2702-f8ec-38ae-b35c-be0052ea157f",
                    "sense_definition": "wydawać głuchy, przeciągły dźwięk przez zwierzęta lub owady",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "dźwięk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W lesie <w>huczą</w> sowy w nocy.",
                            "target_lang_translations": {
                                "ru": "Ночью в лесу <w>ухают</w> совы."
                            }
                        },
                        {
                            "text": "Wielkie owady <w>huczą</w> nad łąką.",
                            "target_lang_translations": {
                                "ru": "Над лугом <w>жужжат</w> крупные насекомые."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "издавать глухой, протяжный звук (о животных или насекомых)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ухать",
                                "target_lang_sense_clarification": "о звуках, издаваемых совами"
                            },
                            {
                                "target_lang_word": "жужжать",
                                "target_lang_sense_clarification": "о звуках, издаваемых насекомыми"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a2f0da5-6888-38eb-aed2-08a360f25456",
                    "sense_definition": "odczuwać silny, pulsujący ból w głowie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ból",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ale <w>huczy</w> mi w głowie po tej nieprzespanej nocy.",
                            "target_lang_translations": {
                                "ru": "У меня просто <w>гудит</w> в голове после этой бессонной ночи."
                            }
                        },
                        {
                            "text": "Od rana <w>huczy</w> mi w głowie z powodu silnego stresu.",
                            "target_lang_translations": {
                                "ru": "С самого утра у меня <w>гудит</w> в голове из-за сильного стресса."
                            }
                        }
                    ],
                    "common_phrases": [
                        "huczy w głowie"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane w odniesieniu do bólu głowy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "ощущать сильную, пульсирующую боль или шум в голове"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гудеть в голове",
                                "target_lang_sense_clarification": "разговорное выражение для пульсирующей боли или шума"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b835ef52-5c25-3441-bf6b-02b8c1864b84",
                    "sense_definition": "głośno krzyczeć, nawoływać się lub strofować kogoś",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "krzyk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ludzie <w>hukali</w> po lesie, szukając zaginionego dziecka.",
                            "target_lang_translations": {
                                "ru": "Люди <w>кричали</w> в лесу, разыскивая пропавшего ребенка."
                            }
                        },
                        {
                            "text": "Nie <w>hucz</w> na mnie, bo nie zrobiłem nic złego.",
                            "target_lang_translations": {
                                "ru": "Не <w>кричи</w> на меня, я не сделал ничего плохого."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "często używane w kontekście nawoływania w terenie"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "громко кричать, перекликаться или отчитывать кого-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кричать",
                                "target_lang_sense_clarification": "громко звать или выражать недовольство"
                            },
                            {
                                "target_lang_word": "орать",
                                "target_lang_sense_clarification": "разговорный вариант, часто с оттенком гнева"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}