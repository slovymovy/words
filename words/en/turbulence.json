{
    "word_family": [
        "turbulent",
        "turbulently"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "86270554-3c19-38aa-922e-5578da474454",
                    "sense_definition": "Irregular, violent motion or disturbance in the air that causes an aircraft to shake.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "fluid_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The flight experienced sudden <w>turbulence</w> while flying over the mountain range.",
                            "target_lang_translations": {
                                "zh": "飞机飞越山脉时遭遇了突发的<w>气流</w>。"
                            }
                        },
                        {
                            "text": "Please return to your seat and fasten your seatbelt during severe <w>turbulence</w>.",
                            "target_lang_translations": {
                                "zh": "遇到剧烈<w>颠簸</w>时，请回到座位并系好安全带。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "severe turbulence",
                        "clear air turbulence",
                        "experience turbulence",
                        "hit turbulence"
                    ],
                    "target_lang_definitions": {
                        "zh": "空中不规则的剧烈气流或扰动，会导致飞机颠簸"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "气流",
                                "target_lang_sense_clarification": "使飞机颠簸的扰乱气流"
                            },
                            {
                                "target_lang_word": "颠簸",
                                "target_lang_sense_clarification": "飞行中遇到的气流颠簸"
                            },
                            {
                                "target_lang_word": "湍流",
                                "target_lang_sense_clarification": "航空气象学中的气流湍动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9177deb6-b454-323e-9225-8236a9ab77f9",
                    "sense_definition": "A state of great commotion, disorder, unrest, or emotional turmoil.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unrest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The country entered a period of political <w>turbulence</w> after the sudden election.",
                            "target_lang_translations": {
                                "zh": "突然举行选举后，该国进入了一段政治<w>动荡</w>期。"
                            }
                        },
                        {
                            "text": "Her early years were marked by emotional <w>turbulence</w> and constant moving.",
                            "target_lang_translations": {
                                "zh": "她的早年生活伴随着情感上的<w>动荡</w>和不断的搬家。"
                            }
                        }
                    ],
                    "synonyms": [
                        "turmoil",
                        "upheaval",
                        "agitation",
                        "instability"
                    ],
                    "antonyms": [
                        "calm",
                        "peace",
                        "stability"
                    ],
                    "common_phrases": [
                        "political turbulence",
                        "economic turbulence",
                        "period of turbulence"
                    ],
                    "target_lang_definitions": {
                        "zh": "混乱、骚乱、动荡或情感起伏不定的状态"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "动荡",
                                "target_lang_sense_clarification": "指局势、政局等不安定"
                            },
                            {
                                "target_lang_word": "混乱",
                                "target_lang_sense_clarification": "指秩序或状态不安定"
                            },
                            {
                                "target_lang_word": "骚乱",
                                "target_lang_sense_clarification": "指社会或群体的骚动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b411fc7-2db6-3e1a-8241-ecb42a8a612e",
                    "sense_definition": "Irregular or chaotic flow of a fluid or gas, characterized by eddies, vortices, and rapid variation of pressure.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "fluid_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Engineers redesigned the car's body to minimize air <w>turbulence</w> at high speeds.",
                            "target_lang_translations": {
                                "zh": "工程师重新设计了车身，以尽量减少高速行驶时的空气<w>湍流</w>。"
                            }
                        },
                        {
                            "text": "The rapid current created dangerous <w>turbulence</w> in the narrow river channel.",
                            "target_lang_translations": {
                                "zh": "湍急的水流在狭窄的河道中形成了危险的<w>湍流</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "流体（液体或气体）的不规则或混沌流动，特征是产生涡流及压力剧烈变化"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "湍流",
                                "target_lang_sense_clarification": "流体力学中的紊乱流动"
                            },
                            {
                                "target_lang_word": "紊流",
                                "target_lang_sense_clarification": "工程和物理学中的非层流流动"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}