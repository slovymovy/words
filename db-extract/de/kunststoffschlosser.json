                "senses": [
                    {
                        "sense_id": "d614b362-985f-3876-8cf5-e9aa9e76831e",
                        "entry_id": "326ae72a-dfc9-3309-b9aa-99aecbd62aaf",
                        "glosses": [
                            "Person, die Kunststoffe ver- oder bearbeitet oder Gegenstände aus Kunststoff repariert, montiert oder instand hält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcf680c5-414a-4a26-a506-5711621194d3",
                                "sense_id": "d614b362-985f-3876-8cf5-e9aa9e76831e",
                                "text": "Der Industrieberuf Kunststoffschlosser erfordert eine dreieinhalbjährige Ausbildungszeit."
                            },
                            {
                                "example_id": "a098eb06-2898-47f3-bccf-12d317f54e4a",
                                "sense_id": "d614b362-985f-3876-8cf5-e9aa9e76831e",
                                "text": "Die geläufige Berufsbezeichnung Kunststoffschlosser wurde vor einigen Jahren in \"Verfahrensmechaniker für Kunststoff- und Kautschuktechnik\" geändert."
                            },
                            {
                                "example_id": "1c900843-5c39-455d-a5a7-fc301b9effa8",
                                "sense_id": "d614b362-985f-3876-8cf5-e9aa9e76831e",
                                "text": "„Kunststoffschlosser/innen sind zuständig für die Verarbeitung von Kunststoffhalbzeug zu Apparaturen und Produktionseinrichtungen, Rohrleitungen und Behältern, Armaturen und ganzen Anlagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
