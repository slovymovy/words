                    {
                        "sense_id": "eedcaa74-7278-359f-8f67-8a3ac5b6ef12",
                        "entry_id": "928213ca-0947-3052-97c2-821184e8cd51",
                        "glosses": [
                            "Kraftwerk, das den Tidenhub zur Stromerzeugung nutzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e87560ad-13c9-4837-abe0-887c6fe51e63",
                                "sense_id": "eedcaa74-7278-359f-8f67-8a3ac5b6ef12",
                                "text": "„Geplant ist Severn Barrage, das größte Gezeitenkraftwerk der Welt, eine 16 Kilometer lange Sperre zwischen Südengland und Südwales.“"
                            },
                            {
                                "example_id": "cf0b993c-ed95-4aa8-b8ef-e79d394f106f",
                                "sense_id": "eedcaa74-7278-359f-8f67-8a3ac5b6ef12",
                                "text": "„Gezeitenkraftwerke nutzen die unterschiedlichen Pegelstände bei Ebbe und Flut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
