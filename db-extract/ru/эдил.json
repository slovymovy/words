                "senses": [
                    {
                        "sense_id": "e23438f5-8346-32f9-a780-34b29c0ba7bd",
                        "entry_id": "f39ff7be-36cb-3bc0-b307-85983242f7f9",
                        "glosses": [
                            "истор. выборное должностное лицо в Древнем Риме, которому вменялось в обязанность наблюдение за общественными зданиями и храмами, дорогами, рынками и т. п."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8964ccb-b098-4bcf-ac63-399b947dabc9",
                        "source_entry_id": "f39ff7be-36cb-3bc0-b307-85983242f7f9",
                        "source_sense_id": "e23438f5-8346-32f9-a780-34b29c0ba7bd",
                        "target_lang_word": "aedile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aedile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8bc29975-c131-3677-bfcb-696adfe959d4",
                                        "entry_id": "574f6229-b5e5-37ce-b34a-0272ab0e2aae",
                                        "glosses": [
                                            "An elected official who was responsible for the maintenance of public buildings, regulation of festivals, supervision of markets and the supply of grain and water."
                                        ],
                                        "tags": [
                                            "Ancient-Rome",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec8d7a7e-5e31-4627-aa94-cf4b4a776943",
                                                "sense_id": "8bc29975-c131-3677-bfcb-696adfe959d4",
                                                "text": "Some of these encroachments may have received permission from the town council or the local aediles. A handful of painted notices found on the outside of the Amphitheatre suggest that it was the aediles who authorised the street vendors plying their trade underneath the monument’s arches, and assigned their pitches: ‘By permission of the aediles. Licensed to Caius Aninius Fortunatus’ etc., as the faint and fragmentary Latin seems to say."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
