                            "target_lang_translations": {
                                "en": "The <w>model</w> stood still for hours so that the painter could capture every detail properly.",
                                "ru": "<w>Модель</w> часами стояла неподвижно, чтобы художник мог точно запечатлеть каждую деталь."
