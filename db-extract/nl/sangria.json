                "senses": [
                    {
                        "sense_id": "6491d839-777c-30d7-a3a8-8ae6ca809372",
                        "entry_id": "8bb94bb2-3fe9-343f-8cf8-8f54da7dc349",
                        "glosses": [
                            "een Spaanse licht-alcoholische drank, bestaande uit rode wijn op smaak gebracht met vruchtjes"
                        ],
                        "tags": [],
