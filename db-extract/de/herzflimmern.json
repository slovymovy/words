                    {
                        "sense_id": "59709e83-ac89-313f-b0bd-48950da2dc41",
                        "entry_id": "3ca92f42-7ed8-3fbf-974a-b25e422fde86",
                        "glosses": [
                            "Störung des Herzrhythmus mit stark verringerter und im Extremfall ausfallender Pumpleistung des Herzens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ba26b14-e251-4a12-a58d-89e9e0300b25",
                                "sense_id": "59709e83-ac89-313f-b0bd-48950da2dc41",
                                "text": "„Freudig erregt bestellte sich Herr Rösselmann noch einen Kaffee, während mir der erste schon nicht bekommen war und ich also, um ein erneutes leichtes Herzflimmern einzudämmen, einen Magenbitter nachgoß, das hilft immer ein bißchen.“"
                            },
                            {
                                "example_id": "ec6fed64-cab7-4968-807c-cf10f252bea7",
                                "sense_id": "59709e83-ac89-313f-b0bd-48950da2dc41",
                                "text": "„Und vielleicht würde sogar ein Herzflimmern ins engmaschige Netz der Aufzeichnung gehen.“"
                            },
                            {
                                "example_id": "059570bb-c679-41f6-91a1-b4efd993b4ee",
                                "sense_id": "59709e83-ac89-313f-b0bd-48950da2dc41",
                                "text": "„Das Herzflimmern hatte er kurz nach Saras Verschwinden zum ersten Mal bemerkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
