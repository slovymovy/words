                "senses": [
                    {
                        "sense_id": "5b094408-1518-317f-93a1-9ee11b5abea2",
                        "entry_id": "de34d165-16c5-3f2f-893f-910d46eff1a8",
                        "glosses": [
                            "Encombré de broussailles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "beaf8f98-0048-49bb-94b0-af1c3ba3b8ba",
                                "sense_id": "5b094408-1518-317f-93a1-9ee11b5abea2",
                                "text": "Aros est un îlot très rugueux, dont la surface, jonchée de gros rochers, est tout embroussaillée de fougères et de bruyères."
                            }
                        ]
                    },
                    {
                        "sense_id": "cbc2669e-9763-3a47-96bf-344019153a0a",
                        "entry_id": "de34d165-16c5-3f2f-893f-910d46eff1a8",
                        "glosses": [
                            "Qui ressemble à une broussaille, à quelque chose d’emmêlé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "013b4495-1c9a-4765-8bef-311bef6865ed",
                                "sense_id": "cbc2669e-9763-3a47-96bf-344019153a0a",
                                "text": "Bourras était un grand vieillard à tête de prophète, chevelu et barbu, avec des yeux perçants sous de gros sourcils embroussaillés."
                            },
                            {
                                "example_id": "9afe9932-78ad-4beb-8a9e-2368743d9a35",
                                "sense_id": "cbc2669e-9763-3a47-96bf-344019153a0a",
                                "text": "Si elle ne donnait pas l’image d’une jeune fille bien habillée, au moins ne donnait-elle plus celle de la pauvre diablesse de la veille, aux cheveux embroussaillés et au visage terreux."
                            },
                            {
                                "example_id": "5ff9a907-c06d-400d-8479-ab2365e7504c",
                                "sense_id": "cbc2669e-9763-3a47-96bf-344019153a0a",
                                "text": "Un « muchacho » d'une dizaine d'années, à la tignasse embroussaillée, essaya de me démontrer les inconvénients de voyager seul, […]."
                            },
                            {
                                "example_id": "09901f7e-048b-40c2-9e28-cb3e20e6b13d",
                                "sense_id": "cbc2669e-9763-3a47-96bf-344019153a0a",
                                "text": "Les yeux, d’un bleu vif, un rien sorciers, brillaient enfoncés sous des sourcils embroussaillés."
                            }
                        ]
                    }
                ],
