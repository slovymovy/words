                "senses": [
                    {
                        "sense_id": "dfedb637-adda-359c-a78a-27f43f28705b",
                        "entry_id": "5dfdc516-9a24-3110-855d-e90dd686c156",
                        "glosses": [
                            "Namenszusatz bei Nachnamen von Adeligen, der als Präposition die zugehörig zu einem Ort angibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4a7d4bb-d70a-401e-9654-e07da2660905",
                                "sense_id": "dfedb637-adda-359c-a78a-27f43f28705b",
                                "text": "Deutsche Adelsprädikate sind: ‚von‘ und ‚zu‘, manchmal sogar ‚von und zu‘; ein englisches Adelsprädikat ist das Wörtchen ‚of‘, welches ‚von‘ bedeutet wie das französische ‚de‘ und das italienische ‚di‘."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
