                ],
                "senses": [
                    {
                        "sense_id": "d09012d2-feae-3d3c-a4b8-f6864966632b",
                        "entry_id": "09060ddf-4bba-38fd-9cfc-747779393355",
                        "glosses": [
                            "Genre d’épée franque (voire germanique) à un tranchant, dont l’autre coté de la lame n’était affuté que sur le dernier tiers, et dont les plus petits étaient vraisemblablement utilisés comme couteaux."
                        ],
                        "tags": [
                            "Armement"
                        ],
                        "examples": [
                            {
                                "example_id": "37777b6a-9001-4323-9f26-6c1782cbbfe0",
                                "sense_id": "d09012d2-feae-3d3c-a4b8-f6864966632b",
                                "text": "Sigebert Iᵉʳ est assassiné, poignardé par des pages de Frédégonde, à coups de scramasaxes dans les flancs."
                            },
                            {
                                "example_id": "c4a1ced6-7041-4aef-bcf2-fd796a425341",
                                "sense_id": "d09012d2-feae-3d3c-a4b8-f6864966632b",
                                "text": "À côté, se tenaient plusieurs petits meubles vitrés présentant effectivement des armes d'inspirations médiévale : deux ou trois épées, des poignards, des dagues, des scramasaxes et même une magnifique hache à double tranchant."
                            },
                            {
                                "example_id": "b6baa222-a80c-4d6a-9c94-c8fc5af6ed93",
                                "sense_id": "d09012d2-feae-3d3c-a4b8-f6864966632b",
                                "text": "Une des tombelles renfermait un grand coutelas en forme de scramasaxe, c'est à dire à un seul tranchant et à dos épais."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "404aa708-513b-4718-87a7-24aba4393b8b",
                        "source_entry_id": "09060ddf-4bba-38fd-9cfc-747779393355",
                        "source_sense_id": "d09012d2-feae-3d3c-a4b8-f6864966632b",
                        "target_lang_word": "seax",
