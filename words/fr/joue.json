            "senses": [
                {
                    "sense_id": "fc895a61-2e49-334f-b3c0-ad5db74f917a",
                    "sense_definition": "Partie latérale du visage humain, située au-dessous des yeux et s'étendant du nez à l'oreille et jusqu'au menton.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant a donné un tendre bisou sur la <w>joue</w> de sa grand-mère."
                        },
                        {
                            "text": "Une larme silencieuse a coulé lentement le long de sa <w>joue</w> droite."
                        }
                    ],
                    "common_phrases": [
                        "bisou sur la joue",
                        "caresser la joue"
                    ]
                },
                {
                    "sense_id": "54075f5a-568b-35ac-a73b-adf786df05a2",
                    "sense_definition": "Morceau de viande prélevé sur la tête d'un bœuf ou d'un porc, préparé en ragoût ou mijoté.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cuisine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chef prépare une délicieuse <w>joue</w> de bœuf braisée au vin rouge pour ses invités."
                        },
                        {
                            "text": "Ce plat traditionnel met à l'honneur la <w>joue</w> de porc cuite pendant plusieurs heures."
                        }
                    ],
                    "common_phrases": [
                        "joue de bœuf",
                        "joue de porc"
                    ]
                },
                {
                    "sense_id": "eaff6421-3281-3b9a-994b-be551fdef1fe",
                    "sense_definition": "Partie arrondie de l'avant de la coque d'un navire située entre le mât de misaine et l'étrave.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "marine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les vagues puissantes venaient s'écraser violemment contre la <w>joue</w> bâbord du vieux navire."
                        },
                        {
                            "text": "Le charpentier inspecte la <w>joue</w> de la coque afin de repérer les planches endommagées."
                        }
                    ]
                },
                {
                    "sense_id": "e8a0422b-b634-3971-ba20-11324f2df819",
                    "sense_definition": "Chacune des deux faces latérales d'une poulie ou d'une pièce mécanique.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mecanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La corde métallique frotte contre la <w>joue</w> de la poulie et risque de s'user."
                        },
                        {
                            "text": "L'ouvrier a remplacé la <w>joue</w> déformée du mécanisme pour éviter tout blocage."
                        }
                    ]
                }
            ]
        },
