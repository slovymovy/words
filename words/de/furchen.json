            "senses": [
                {
                    "sense_id": "94d7b214-2880-3a21-8568-a5b6e42bf152",
                    "sense_definition": "einen Teil des Gesichts, vor allem die Stirn, in Falten legen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mimik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Lehrer <w>furchte</w> verärgert die Stirn, als die Schüler nicht zuhörten."
                        },
                        {
                            "text": "Jahrelange harte Arbeit und Sorgen hatten das Gesicht des alten Bauern tief <w>gefurcht</w>."
                        }
                    ],
                    "synonyms": [
                        "runzeln"
                    ],
                    "antonyms": [
                        "glätten"
                    ],
                    "common_phrases": [
                        "die Stirn furchen"
                    ]
                },
                {
                    "sense_id": "b4e106e2-422a-3647-9317-af68f7b576e7",
                    "sense_definition": "eine längliche Vertiefung in den Boden oder eine Oberfläche graben bzw. eine Spur im Wasser hinterlassen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vertiefung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die schweren Lastwagen <w>furchen</w> tiefe Rillen in den aufgeweichten Waldweg."
                        },
                        {
                            "text": "Das gewaltige Schiff <w>furchte</w> zielstrebig die unruhigen Wellen des Meeres."
                        }
                    ],
                    "synonyms": [
                        "pflügen",
                        "einritzen"
                    ],
                    "antonyms": [
                        "ebnen"
                    ],
                    "common_phrases": [
                        "das Wasser furchen",
                        "den Boden furchen"
                    ]
                }
            ]
        },
        {
