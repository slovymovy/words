                    {
                        "translation_id": "1151db44-e4e0-41bb-a3b6-8daac0462965",
                        "source_entry_id": "551d6295-e615-3690-97d0-1ec9a75e6dba",
                        "source_sense_description": "Transnistria, an autonomous territory in Moldova",
