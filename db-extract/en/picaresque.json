                                        "entry_id": "dbe4af32-3261-3fad-87d6-153ef9e11f02",
                                        "glosses": [
                                            "„Roman (besonders des 16. und 17. Jahrhunderts), dessen Held sich als Umhergetriebener niederer Abkunft mit allen Mitteln, Listen und Schlichen durchs Leben schlägt“"
                                        ],
                                        "tags": [
                                            "Literaturwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efdb4bea-bd5e-4727-86b8-833f841e1116",
                                                "sense_id": "dc803933-cac2-3a5d-a16b-a5a06ba65dec",
                                                "text": "„Keine Biographien in einem quellenkritischen Sinn, verbreiten sie in bewusster Anknüpfung an die frühneuzeitliche Geusenliteratur und den Schelmenroman durch Legenden und Anekdoten den Ruhm des 1721 auf der Place de Grève hingerichteten französischen Banditen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
