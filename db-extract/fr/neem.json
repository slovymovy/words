                                        "glosses": [
                                            "Azadirachta indica, a large, mostly evergreen tree from India, whose seeds yield neem oil, the insecticide azadirachtin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c51bd315-77d6-4b51-abb8-42af61115efd",
                                                "sense_id": "17995017-5f37-3706-91f5-6afdaf061e4a",
                                                "text": "He was standing at the gate, rubbing his teeth with a twig broken from a neem tree – which is what many poor people in my country do, Mr Premier, when they want to clean their teeth."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
