                    "frequency": "Low",
                    "semantic_group_id": "letterlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De plechtige <w>bekroning</w> van de nieuwe monarch vond plaats in de kathedraal.",
