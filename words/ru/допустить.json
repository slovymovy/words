{
    "word_family": [
        "допуск",
        "допустимый",
        "допущение",
        "недопустимый",
        "пускать",
        "пустить"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8335579c-5d49-3707-8941-2e4aaa081e3b",
                    "sense_definition": "Не воспрепятствовать чему-либо, позволить чему-либо случиться; совершить (ошибку, оплошность).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "allow_happen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы должны быть внимательными и не <допустить> глупую ошибку в расчётах.",
                            "target_lang_translations": {
                                "en": "We must be careful and not <make> a stupid mistake in the calculations.",
                                "es": "Debemos tener cuidado y no <cometer> un error tonto en los cálculos.",
                                "fr": "Nous devons être attentifs et ne pas <commettre> une bête erreur dans les calculs."
                            }
                        },
                        {
                            "text": "Охрана сделала всё возможное, чтобы не <допустить> посторонних в здание.",
                            "target_lang_translations": {
                                "en": "Security did everything possible not to <allow> strangers into the building.",
                                "es": "La seguridad hizo todo lo posible para no <permitir> la entrada de extraños al edificio.",
                                "fr": "La sécurité a fait tout son possible pour ne pas <laisser entrer> d'inconnus dans le bâtiment."
                            }
                        },
                        {
                            "text": "Нельзя <допустить>, чтобы этот конфликт продолжался так долго.",
                            "target_lang_translations": {
                                "en": "We cannot <allow> this conflict to continue for so long.",
                                "es": "No se puede <permitir> que este conflicto continúe por tanto tiempo.",
                                "fr": "On ne peut pas <permettre> que ce conflit dure si longtemps."
                            }
                        }
                    ],
                    "synonyms": [
                        "позволить"
                    ],
                    "antonyms": [
                        "предотвратить",
                        "избежать"
                    ],
                    "common_phrases": [
                        "допустить ошибку",
                        "не допустить повторения",
                        "допустить возможность"
                    ],
                    "target_lang_definitions": {
                        "en": "To not prevent something from happening; to commit a mistake or error",
                        "es": "No impedir que algo suceda, permitir que ocurra; cometer un error o fallo.",
                        "fr": "Ne pas empêcher quelque chose de se produire, permettre que cela arrive ; commettre une erreur ou une faute."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "allow",
                                "target_lang_sense_clarification": "to let happen"
                            },
                            {
                                "target_lang_word": "make",
                                "target_lang_sense_clarification": "a mistake or error"
                            },
                            {
                                "target_lang_word": "permit",
                                "target_lang_sense_clarification": "formal permission"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "permitir",
                                "target_lang_sense_clarification": "no impedir que algo suceda"
                            },
                            {
                                "target_lang_word": "cometer",
                                "target_lang_sense_clarification": "referido a un error o fallo"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "permettre",
                                "target_lang_sense_clarification": "laisser se produire"
                            },
                            {
                                "target_lang_word": "commettre",
                                "target_lang_sense_clarification": "une erreur, une faute"
                            },
                            {
                                "target_lang_word": "tolérer",
                                "target_lang_sense_clarification": "ne pas empêcher"
                            },
                            {
                                "target_lang_word": "faire",
                                "target_lang_sense_clarification": "une erreur"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "601a9901-1ba1-36d0-81d5-3dad50235080",
                    "sense_definition": "Разрешить доступ к чему-либо, позволить участвовать в чём-либо или войти куда-либо.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "access",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Врач решил <допустить> пациента к работе после полного выздоровления.",
                            "target_lang_translations": {
                                "en": "The doctor decided to <allow> the patient to work after a full recovery.",
                                "es": "El médico decidió <autorizar> al paciente a trabajar tras su total recuperación.",
                                "fr": "Le médecin a décidé d'<autoriser> le patient à reprendre le travail après son rétablissement complet."
                            }
                        },
                        {
                            "text": "Студента могут не <допустить> к экзаменам из-за плохой посещаемости.",
                            "target_lang_translations": {
                                "en": "The student might not be <admitted> to the exams due to poor attendance.",
                                "es": "Es posible que no <admitan> al estudiante a los exámenes debido a la mala asistencia.",
                                "fr": "L'étudiant pourrait ne pas être <admis> aux examens en raison d'une mauvaise assiduité."
                            }
                        }
                    ],
                    "synonyms": [
                        "разрешить"
                    ],
                    "antonyms": [
                        "отстранить",
                        "запретить"
                    ],
                    "common_phrases": [
                        "допустить к работе",
                        "допустить к экзаменам",
                        "допустить к участию"
                    ],
                    "target_lang_definitions": {
                        "en": "To grant access to something, to allow to participate or enter",
                        "es": "Permitir el acceso a algo, autorizar la participación o la entrada a un lugar.",
                        "fr": "Autoriser l'accès à quelque chose, permettre de participer ou d'entrer."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "admit",
                                "target_lang_sense_clarification": "to allow entry or access"
                            },
                            {
                                "target_lang_word": "allow",
                                "target_lang_sense_clarification": "to give permission"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "admitir",
                                "target_lang_sense_clarification": "dar acceso o entrada"
                            },
                            {
                                "target_lang_word": "permitir",
                                "target_lang_sense_clarification": "dar autorización"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "admettre",
                                "target_lang_sense_clarification": "autoriser l'accès ou la participation"
                            },
                            {
                                "target_lang_word": "autoriser",
                                "target_lang_sense_clarification": "donner la permission d'accéder"
                            },
                            {
                                "target_lang_word": "permettre",
                                "target_lang_sense_clarification": "donner le droit d'entrer"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "caf3082d-5311-3489-8235-0a420941dcb0",
                    "sense_definition": "Счесть возможным, предположить существование чего-либо.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "assume",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Давайте на минуту <допустим>, что ваше утверждение верно.",
                            "target_lang_translations": {
                                "en": "Let's <assume> for a minute that your statement is correct.",
                                "es": "<Supongamos> por un minuto que su afirmación es correcta.",
                                "fr": "<Supposons> une minute que votre affirmation soit vraie."
                            }
                        },
                        {
                            "text": "Я даже в мыслях не мог <допустить>, что он способен на предательство.",
                            "target_lang_translations": {
                                "en": "I could not even <imagine> in my thoughts that he was capable of betrayal.",
                                "es": "Ni siquiera en mis pensamientos podía <imaginar> que él fuera capaz de una traición.",
                                "fr": "Je ne pouvais même pas <imaginer> un instant qu'il soit capable de trahison."
                            }
                        }
                    ],
                    "synonyms": [
                        "предположить"
                    ],
                    "antonyms": [
                        "исключить"
                    ],
                    "common_phrases": [
                        "допустим что",
                        "трудно допустить"
                    ],
                    "target_lang_definitions": {
                        "en": "To consider something possible or to assume its existence",
                        "es": "Considerar algo posible o suponer su existencia.",
                        "fr": "Juger possible, supposer l'existence de quelque chose."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "assume",
                                "target_lang_sense_clarification": "to suppose to be true"
                            },
                            {
                                "target_lang_word": "suppose",
                                "target_lang_sense_clarification": "to hypothesize"
                            },
                            {
                                "target_lang_word": "admit",
                                "target_lang_sense_clarification": "to concede as possible"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "suponer",
                                "target_lang_sense_clarification": "dar por sentado como hipótesis"
                            },
                            {
                                "target_lang_word": "admitir",
                                "target_lang_sense_clarification": "aceptar como posible"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "supposer",
                                "target_lang_sense_clarification": "émettre une hypothèse"
                            },
                            {
                                "target_lang_word": "admettre",
                                "target_lang_sense_clarification": "reconnaître comme possible"
                            },
                            {
                                "target_lang_word": "envisager",
                                "target_lang_sense_clarification": "considérer une possibilité"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}