                    {
                        "translation_id": "63165dc2-c245-4118-9855-54b39afffe97",
                        "source_entry_id": "6f604a85-f6e3-3838-aaf1-73258ebfe081",
                        "source_sense_description": "break down",
                        "target_lang_word": "abbauen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abbauen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "852bdac7-6af4-395e-93de-5bac447b3a7a",
                                        "entry_id": "bef6a78e-94ab-3e93-a3b1-a495e672d0a1",
                                        "glosses": [
                                            "bauliche und andere (auch zeitweilig errichteten) technische oder künstliche Anlagen, Einrichtungen, Aufbauten und Ähnliches beseitigen, zurückbauen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4b03e17-89ca-4260-87f1-8ffb49fadab2",
                                                "sense_id": "852bdac7-6af4-395e-93de-5bac447b3a7a",
                                                "text": "Die Häuser sind so konstruiert, dass sie leicht wieder abzubauen sind."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ec637431-d20c-3b3d-a994-67e0b00b0cca",
                                        "entry_id": "bef6a78e-94ab-3e93-a3b1-a495e672d0a1",
                                        "glosses": [
                                            "Rohstoffe, Baustoffe vor allem durch Bergbau und ähnliche Technologien gewinnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d502779-0818-43ff-8b39-b74d83987242",
                                                "sense_id": "ec637431-d20c-3b3d-a994-67e0b00b0cca",
                                                "text": "Im Mittelalter wurde hier Silber abgebaut."
                                            },
                                            {
                                                "example_id": "79ec1ae7-e4e2-4f48-9694-60fad4094af4",
                                                "sense_id": "ec637431-d20c-3b3d-a994-67e0b00b0cca",
                                                "text": "„Die Schwäche des E-Autos liegt darin, dass es so viel mehr mineralische Rohstoffe benötigt als die Verbrenner, darunter etliche kritische Materialien, die oft unter fragwürdigen Bedingungen abgebaut werden.“"
                                            },
                                            {
                                                "example_id": "59376e30-cfca-42b0-aefa-f2615e523eb5",
                                                "sense_id": "ec637431-d20c-3b3d-a994-67e0b00b0cca",
                                                "text": "„Torf wird in Mooren abgebaut, die so unwiederbringlich zerstört werden.“"
                                            },
                                            {
                                                "example_id": "5324267b-699a-4006-88e3-d2bdac56baea",
                                                "sense_id": "ec637431-d20c-3b3d-a994-67e0b00b0cca",
                                                "text": "„In direkter Nähe von Quell- und Moorgebieten im Dresdner Heidebogen“ […] „wird im großen Stil Kies abgebaut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4062b852-fc15-387f-bf03-0b3cc8687c2e",
                                        "entry_id": "bef6a78e-94ab-3e93-a3b1-a495e672d0a1",
                                        "glosses": [
                                            "(vor allem auch übertragen) verringern, beseitigen; mindern von Hindernissen, die Prozesse behindern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2731586b-cde4-404e-b5b5-40bbc44e14df",
                                                "sense_id": "4062b852-fc15-387f-bf03-0b3cc8687c2e",
                                                "text": "Wegen der verschärften Konkurrenzsituation wurden 234 Arbeitsplätze abgebaut."
                                            },
                                            {
                                                "example_id": "f89469d5-0723-4c5a-9d6d-714701c5f674",
                                                "sense_id": "4062b852-fc15-387f-bf03-0b3cc8687c2e",
                                                "text": "Deutschlands Kindertagesstätten und Schulen bauen die Spaltung der Gesellschaft in Gewinner und Verlierer nicht ab, sondern verfestigen sie."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "3ae026c2-0efa-3143-a950-f16a9723cb09",
                                        "entry_id": "bef6a78e-94ab-3e93-a3b1-a495e672d0a1",
                                        "glosses": [
                                            "von komplexeren in einfachere Strukturen und Formen, in geringerwertige Zustände oder Qualitäten umwandeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6027eca-0565-4d9a-a7f0-cd842310e8d1",
                                                "sense_id": "3ae026c2-0efa-3143-a950-f16a9723cb09",
                                                "text": "Die Mikroorganismen bauen das Laub zu Humus und Mineralstoffen ab."
                                            },
                                            {
                                                "example_id": "6466385b-4780-4ef4-a11b-0e1a7f5f81ab",
                                                "sense_id": "3ae026c2-0efa-3143-a950-f16a9723cb09",
                                                "text": "„Frauen bauen viele Antidepressiva langsamer ab, weil das aber bei der Dosierung nicht genug beachtet wird, leiden sie häufiger an Nebenwirkungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "656d3746-de3d-336e-943f-79fbad929b92",
                                        "entry_id": "bef6a78e-94ab-3e93-a3b1-a495e672d0a1",
                                        "glosses": [
                                            "sich körperlich oder geistig zurückentwickeln"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e078a201-25c9-4fd7-b1b0-30e4f4ce0c2b",
                                                "sense_id": "656d3746-de3d-336e-943f-79fbad929b92",
                                                "text": "Oliver hat in letzter Zeit ganz schön abgebaut!"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
