                "senses": [
                    {
                        "sense_id": "63cb9b82-a571-37b2-9c18-b7494b1fb5a4",
                        "entry_id": "342085b5-a28b-343a-a969-476dcfe0b90a",
                        "glosses": [
                            "Eigenschaft, Jungfer/sexuell unberührt zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cae35e59-7f30-4665-a7a8-6558770db874",
                                "sense_id": "63cb9b82-a571-37b2-9c18-b7494b1fb5a4",
                                "text": "„Sie fragte mich mit heiterer Miene, was sie ihm antworten könne, wenn er sie in der ersten Nacht frage, welcher Liebhaber ihr die Jungfernschaft geraubt habe.“"
                            },
                            {
                                "example_id": "5a593da2-d7c1-4c8d-a76e-4ddf935d6606",
                                "sense_id": "63cb9b82-a571-37b2-9c18-b7494b1fb5a4",
                                "text": "„Er will dabeisein, wenn Otto Bambuss seine Jungfernschaft verliert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f3938946-8389-4b91-b411-909c4951b7a6",
