                    },
                    {
                        "form_id": "71468e96-9b49-493b-bf81-f196670a2415",
                        "entry_id": "9d44aa67-254d-313b-a26a-c166ad45806d",
                        "tags": [
                            "rare"
                        ],
                        "form": "aptronyme"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "35e890db-ec5b-36df-bc7e-247d2dd9dfa1",
                        "entry_id": "9d44aa67-254d-313b-a26a-c166ad45806d",
                        "glosses": [
                            "Nom de famille possédant un sens lié à la personne qui le porte, le plus souvent en relation avec son métier ou ses occupations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e29098f5-bfbf-4616-95d0-696c8cfd9319",
                                "sense_id": "35e890db-ec5b-36df-bc7e-247d2dd9dfa1",
                                "text": "De plus il ne cite pas les deux Centres de Recherches Aptonymiques existant en France et au Canada, qui eux ne publient que des aptonymes ou contraptonymes avérés."
                            },
                            {
                                "example_id": "04ba9036-798a-40a3-9adb-686c32cde2d9",
                                "sense_id": "35e890db-ec5b-36df-bc7e-247d2dd9dfa1",
                                "text": "Demandons à chacun de nos députés de soutenir Mme Abeille. Si par hasard votre député refuse et qu’il s’appelle M. Enfoiré, nous aurons là, cher Tonino, un aptonyme idéal."
                            },
                            {
                                "example_id": "ead1c89d-c576-4526-add9-255c153a8335",
                                "sense_id": "35e890db-ec5b-36df-bc7e-247d2dd9dfa1",
                                "text": "De ce fait, aptonyme désigne un nom prédestiné, qui convient bien à la personne qui le porte, car il se rapporte au métier qu’elle exerce ou à ses occupations. Le contraire d’un aptonyme s’appelle un contraptonyme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d3bce6e-b1a8-44e5-8f90-93f35f20d53f",
                        "source_entry_id": "9d44aa67-254d-313b-a26a-c166ad45806d",
                        "source_sense_id": "35e890db-ec5b-36df-bc7e-247d2dd9dfa1",
                        "target_lang_word": "aptronym",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aptronym",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8ca2b6e-cd29-3b99-85a3-0665b3da00ab",
                                        "entry_id": "1a93895f-74ba-386f-a20f-d00724265ce7",
                                        "glosses": [
                                            "A name that is aptly suited to its owner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84f003e2-d0e9-45f2-b663-3896c52d64bc",
                                                "sense_id": "e8ca2b6e-cd29-3b99-85a3-0665b3da00ab",
                                                "text": "Speck also turns out to be a shopkeeper whose small-town mentality finds a reflection in his aptronym: \"Speck\" in German meaning bacon, he is the local butcher concerned with selling his merchandise regardless of its real quality."
                                            },
                                            {
                                                "example_id": "1ae881a9-240f-4ff0-bbf3-40b6e52d9313",
                                                "sense_id": "e8ca2b6e-cd29-3b99-85a3-0665b3da00ab",
                                                "text": "This contradiction is condensed within the aptronym Casey Falls: her first name recalls Jim Casy, the preacher who is sacrificed helping migrant workers in John Steinbeck’s The Grapes of Wrath, while her surname evokes Eve and the Fall."
                                            },
                                            {
                                                "example_id": "6bb07c07-2416-4fee-93a4-d43bdf91ffa4",
                                                "sense_id": "e8ca2b6e-cd29-3b99-85a3-0665b3da00ab",
                                                "text": "The latter after marrying Sir Ulick's steward becomes Mrs. M'Crule, an aptronym expressing her excessive bigotry in preventing the Catholic boy, Tommy Dunshaughlin, from attending a charity school."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1fae9b18-c8b1-4426-99f6-2a1c094cb15a",
                        "source_entry_id": "9d44aa67-254d-313b-a26a-c166ad45806d",
                        "source_sense_id": "35e890db-ec5b-36df-bc7e-247d2dd9dfa1",
                        "target_lang_word": "aptonym",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aptonym",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9abaf4f5-57a4-3a20-b622-17a470bdcc82",
                                        "entry_id": "936caf38-3620-3740-b0de-ef13e6001b97",
                                        "glosses": [
                                            "A proper name that aptly describes the occupation or character of the person, especially by coincidence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e39db23-777d-43c4-9018-e4194c6fc299",
                                                "sense_id": "9abaf4f5-57a4-3a20-b622-17a470bdcc82",
                                                "text": "The following is a selected list of aptonyms, i.e., people whose names and occupations or situation (e.g., workplace) have a close correspondence"
                                            },
                                            {
                                                "example_id": "b012c77a-6fd2-44eb-a63f-87cf03d5e903",
                                                "sense_id": "9abaf4f5-57a4-3a20-b622-17a470bdcc82",
                                                "text": "New aptonyms appeared for both Matt and Donna at this juncture — \"DoorMatt\" and \"Donnasaur.\""
                                            },
                                            {
                                                "example_id": "17a1859f-146c-4972-8383-3f0204dd5fd6",
                                                "sense_id": "9abaf4f5-57a4-3a20-b622-17a470bdcc82",
                                                "text": "Stocked with characters whose names are representative of their failings (aptonyms, a standard comic technique), The Stepsure Letters is not read today outside the university classroom"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
