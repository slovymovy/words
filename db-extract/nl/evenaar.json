                                                "example_id": "681aecbd-c8cb-408d-ae71-0e9e0de16b9d",
                                                "sense_id": "028aaa3f-fd2f-3cbc-9c9a-754be482cc70",
                                                "text": "Baishui is about as close to the equator as Tampa, Florida."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af5695f4-b587-3154-8cf3-18ad64a0c125",
                                        "entry_id": "b2800174-8ae1-3de8-a0d4-d9c0351db141",
                                        "glosses": [
                                            "A similar great circle on any sphere, especially on a celestial body, or on another reasonably symmetrical three-dimensional body."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4a366661-1169-3c07-a1bb-24f141e0c42c",
                                        "entry_id": "b2800174-8ae1-3de8-a0d4-d9c0351db141",
                                        "glosses": [
                                            "The midline of any generally spherical object, such as a fruit or vegetable, that has identifiable poles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b343c41-aecc-4d94-be93-67106c713a2c",
                                                "sense_id": "4a366661-1169-3c07-a1bb-24f141e0c42c",
