                "forms": [],
                "senses": [
                    {
                        "sense_id": "d6cb0c95-350e-30d0-aa1a-76e14b523204",
                        "entry_id": "0474b01b-daad-3b90-a6f9-bdb8f2f70589",
                        "glosses": [
                            "w sposób niezwyciężony"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2cfda3c-3487-4ec4-96fd-3f50a22bac94",
                                "sense_id": "d6cb0c95-350e-30d0-aa1a-76e14b523204",
                                "text": "Bohaterowie ci trwali niezłomnie w obronie Polski."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b316c518-9547-42f0-a53e-5c695a3d7c1f",
                        "source_entry_id": "0474b01b-daad-3b90-a6f9-bdb8f2f70589",
                        "source_sense_id": "d6cb0c95-350e-30d0-aa1a-76e14b523204",
                        "target_lang_word": "sturdily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sturdily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3fdfd72d-62d6-3fde-9ae1-efcbcdf550cc",
                                        "entry_id": "f031a176-0cd6-390f-b756-feb028874da0",
                                        "glosses": [
                                            "In a sturdy manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6f2c7ed-45c7-42cb-8525-183cc673bffd",
                                                "sense_id": "3fdfd72d-62d6-3fde-9ae1-efcbcdf550cc",
                                                "text": "This table is so sturdily built that I can stand on it without fear of it breaking."
                                            },
                                            {
                                                "example_id": "c72cab89-f215-4c6d-855e-94ea4ae69822",
                                                "sense_id": "3fdfd72d-62d6-3fde-9ae1-efcbcdf550cc",
                                                "text": "Look at the little fellows, mere bundles of fluff, paddling along so busily and sturdily."
                                            },
                                            {
                                                "example_id": "7ad05f7c-8e3e-4036-8135-22bef67b6661",
                                                "sense_id": "3fdfd72d-62d6-3fde-9ae1-efcbcdf550cc",
                                                "text": "I love the idea of setting a mystery in the midst of a women's newspaper; and the lesbian community, with our controversies and our collectives for local color, is a juicy topic for satire. However, most of the time, Schulman is incapable of setting us up sturdily enough to make knocking us down into an interesting enterprise."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f76d5db7-fae2-485c-94a2-b368b2652e4c",
                        "source_entry_id": "0474b01b-daad-3b90-a6f9-bdb8f2f70589",
                        "source_sense_id": "d6cb0c95-350e-30d0-aa1a-76e14b523204",
                        "target_lang_word": "steelily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "steelily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9c1f204e-6b68-3ab8-88c2-b59782e3c339",
                                        "entry_id": "2d592031-5509-3f39-80ee-59a0c81f864d",
                                        "glosses": [
                                            "In a steely way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94845aac-6b3b-4ebe-8c15-8e08ec102f83",
                                                "sense_id": "9c1f204e-6b68-3ab8-88c2-b59782e3c339",
                                                "text": "My aunt looked at her daughter; brilliant of complexion, coldly and steelily handsome at eighteen—why should she not have admirers?"
                                            },
                                            {
                                                "example_id": "654f691f-4259-4ed2-b6ac-0ab57119de29",
                                                "sense_id": "9c1f204e-6b68-3ab8-88c2-b59782e3c339",
                                                "text": "'Meat,' he said steelily. 'I was right. It was a bloody butcher's knife that bastard tried to rearrange me with.'"
                                            },
                                            {
                                                "example_id": "a23e2336-ade4-437e-86a6-2900c3b11409",
                                                "sense_id": "9c1f204e-6b68-3ab8-88c2-b59782e3c339",
                                                "text": "2016, Anne Fogarty, Chapter 1: ‘A World of Hotels and Gaols’, Paige Reynolds (editor), Modernist Afterlives in Irish Literature and Culture, Wimbledon Publishing Company (Anthem Press), page 19,\nAs she steelily lives through the death of Christy, she recognizes that she herself now moves irretrievably 'in a world of hotels and gaols' (145)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce1b0cc5-23ab-4a09-a885-dc2ad737c165",
                        "source_entry_id": "0474b01b-daad-3b90-a6f9-bdb8f2f70589",
                        "source_sense_id": "d6cb0c95-350e-30d0-aa1a-76e14b523204",
                        "target_lang_word": "unerschütterlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unerschütterlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "981e454f-aeaf-3976-89e9-936c3bdfc7cb",
                                        "entry_id": "4852bb70-54f4-3f91-a195-91c00667f983",
                                        "glosses": [
                                            "durch nichts zu erschüttern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8619178-0ec5-41c5-8d5f-f998f85360c2",
                                                "sense_id": "981e454f-aeaf-3976-89e9-936c3bdfc7cb",
                                                "text": "Sein Selbstvertrauen ist unerschütterlich."
                                            },
                                            {
                                                "example_id": "f4ccacfe-15bb-4801-adf8-4e959b8ed6ff",
                                                "sense_id": "981e454f-aeaf-3976-89e9-936c3bdfc7cb",
                                                "text": "„Er erzählte mit unerschütterlicher Sicherheit unglaubliche Dinge; man mußte sich so stellen, als glaube man sie, denn er war stets Augenzeuge gewesen oder war selber der Held der Geschichte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef5e03cc-6c48-4134-a216-fbe1e26c18a3",
                        "source_entry_id": "0474b01b-daad-3b90-a6f9-bdb8f2f70589",
                        "source_sense_id": "d6cb0c95-350e-30d0-aa1a-76e14b523204",
                        "target_lang_word": "standhaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "standhaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5d7633ea-4784-3d81-a269-59e299b8c3f4",
                                        "entry_id": "aebbf4d6-1d5c-31b9-9575-8596ecdf0d06",
                                        "glosses": [
                                            "fähig, gegen etwas Widerstand zu leisten, Beharrlichkeit zeigend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b10808c-79f2-44a9-9992-1b6ae71f5f81",
                                                "sense_id": "5d7633ea-4784-3d81-a269-59e299b8c3f4",
                                                "text": "„Stellt Wagemut eine Initiativkraft dar, die befähigt, trotz Bedrohung und Angst ein Wagnis einzugehen, so äußert sich in der Tapferkeit eine Dulderkraft, die es ermöglicht, die Gefahren standhaft durchzustehen.“"
                                            },
                                            {
                                                "example_id": "409327ab-faef-437e-ac52-cbc7cce2986d",
                                                "sense_id": "5d7633ea-4784-3d81-a269-59e299b8c3f4",
                                                "text": "Er wehrte sich standhaft gegen alle Verleumdungen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53587f84-2d39-410d-ac61-af33c45d4323",
                        "source_entry_id": "0474b01b-daad-3b90-a6f9-bdb8f2f70589",
                        "source_sense_id": "d6cb0c95-350e-30d0-aa1a-76e14b523204",
                        "target_lang_word": "ungebrochen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ungebrochen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6b76a7b4-9afa-3124-b2dc-87e373628597",
                                        "entry_id": "3d8b4c90-78fa-35ed-8b0f-2c00dc260242",
                                        "glosses": [
                                            "ohne Unterbrechung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73b14344-138d-430f-825b-691719892e68",
                                                "sense_id": "6b76a7b4-9afa-3124-b2dc-87e373628597",
                                                "text": "„Zwar gab es Aufstände gegen die Fremden, und im gebirgigen Norden und Westen des Landes lebte die keltische Kultur ungebrochen weiter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "62e4bfff-7dd7-3014-b5d5-67a5a16f9fe6",
                                        "entry_id": "3d8b4c90-78fa-35ed-8b0f-2c00dc260242",
                                        "glosses": [
                                            "nicht in seiner Einstellung/Haltung beeinträchtigt/gestört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cefc0add-7caa-48bd-a97e-0bb22a0e7d43",
                                                "sense_id": "62e4bfff-7dd7-3014-b5d5-67a5a16f9fe6",
                                                "text": "Er hat seine lebensbedrohliche Krankheit ungebrochen überstanden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e8e20b11-da29-3621-9353-40aa2427d011",
                                        "entry_id": "3d8b4c90-78fa-35ed-8b0f-2c00dc260242",
                                        "glosses": [
                                            "nicht abgelenkt"
                                        ],
                                        "tags": [],
                                        "examples": [
