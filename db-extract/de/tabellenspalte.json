                "senses": [
                    {
                        "sense_id": "ebdbd744-de3d-3b77-bc0f-1311883234a8",
                        "entry_id": "10616f7d-e7b3-3854-ad57-4134d56d378e",
                        "glosses": [
                            "untereinander stehende Einträge (Spalte) einer Tabelle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51cf853a-4542-4904-bea8-f94f8cb278e4",
                                "sense_id": "ebdbd744-de3d-3b77-bc0f-1311883234a8",
                                "text": "„In der linken Tabellenspalte wurden die Texte aus der der ersten Überschrift der Einzelbewertung eingetragen.“"
                            },
                            {
                                "example_id": "1e10db0f-6162-483d-a029-e2171f7713cb",
                                "sense_id": "ebdbd744-de3d-3b77-bc0f-1311883234a8",
                                "text": "„Beide Tabellenspalten enthalten jeweils nicht alle Materialien und Produkte, so wie es für den Matrizenansatz notwendig wäre.“"
                            },
                            {
                                "example_id": "bcfe9f8c-7728-472a-ba89-823ddab15c5d",
                                "sense_id": "ebdbd744-de3d-3b77-bc0f-1311883234a8",
                                "text": "„Die Eingangssignale in der linken Tabellenspalte ergeben die Ausgänge in der rechten Tabellenspalte.“"
                            },
                            {
                                "example_id": "300d4312-780d-4aa3-9ec2-2e05d84baebe",
                                "sense_id": "ebdbd744-de3d-3b77-bc0f-1311883234a8",
                                "text": "„Mit Hilfe von T-SQL ist es kein Problem, auch Tabellenspalten umzubenennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
