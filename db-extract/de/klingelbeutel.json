                ],
                "senses": [
                    {
                        "sense_id": "a58a3767-5622-3fd7-8376-e7df9e4f1cb6",
                        "entry_id": "5f688d8d-e295-3de4-9c48-fbb5d56d2fed",
                        "glosses": [
                            "ein mit Glöckchen versehener, meist an einer langen Stange angebrachter Beutel zum Einsammeln der Kollekte während des Gottesdienstes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73ff0aa7-f72b-4474-abb4-aae679efc031",
                                "sense_id": "a58a3767-5622-3fd7-8376-e7df9e4f1cb6",
                                "text": "„Mit seinem Holzstiel und dem versteiften Ring sah er aus wie ein Klingelbeutel für die Kollekte in der Kirche.“"
                            },
                            {
                                "example_id": "f795164e-9dbc-4697-8ee7-52c5b57e063a",
                                "sense_id": "a58a3767-5622-3fd7-8376-e7df9e4f1cb6",
                                "text": "In der Messe wird vielfach anstatt eines Klingelbeutels ein einfaches Sammelkörbchen verwendet."
                            },
                            {
                                "example_id": "07012a77-6634-4b4b-ad51-1e18f9e49dac",
                                "sense_id": "a58a3767-5622-3fd7-8376-e7df9e4f1cb6",
                                "text": "„Bauer Kämper war ganz nah an den Pastor herangetreten und hatte ihn vor die Wahl gestellt, den Schöning entweder ordentlich zu bezahlen oder sich darauf gefasst zu machen, in Zukunft in einen leeren Klingelbeutel zu blicken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
