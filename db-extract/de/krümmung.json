                        ],
                        "form": "die Krümmung"
                    },
                    {
                        "form_id": "52866254-6fc3-4d92-ba07-a01b480e47ad",
                        "entry_id": "ee904146-e0be-367e-8c52-ce0fe713a996",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Krümmungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "707f05d2-5dd8-36bb-843c-19a2a80595c4",
                        "entry_id": "ee904146-e0be-367e-8c52-ce0fe713a996",
                        "glosses": [
                            "Abweichung von einer geraden Linie oder ebenen Fläche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25c344f5-4e6b-4be1-bcb5-43931aca00bb",
                                "sense_id": "707f05d2-5dd8-36bb-843c-19a2a80595c4",
                                "text": "„Wirklich, hinter der nächsten Krümmung des Flusses wurde er schon erwartet.“"
                            },
                            {
                                "example_id": "7954c1cc-f3fa-4c25-9678-55e0dcb4a50a",
                                "sense_id": "707f05d2-5dd8-36bb-843c-19a2a80595c4",
                                "text": "„Als die Befestigung neu erbaut wurde, entstand 1563 anstelle der Ringmauer eine Kurtine […], die die Krümmung beibehielt […].“"
                            },
                            {
                                "example_id": "751fccab-9ec5-4af9-b57b-4441c2e1c2da",
                                "sense_id": "707f05d2-5dd8-36bb-843c-19a2a80595c4",
                                "text": "„Die Windung beschreibt zusammen mit der Krümmung das lokale Verhalten der Kurve und kommt wie die Krümmung als Koeffizient in den Frenet'schen Formeln vor.“"
                            },
                            {
                                "example_id": "1863a186-6672-4425-82c5-34a2ae8e3b5a",
                                "sense_id": "707f05d2-5dd8-36bb-843c-19a2a80595c4",
                                "text": "„Ein silbergrauer Streifen, in dem Robert den Fluß erkannte, zog sich in einer fernen Krümmung hin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9613d32d-8af9-4f2d-9bcd-7ce92a27cbd3",
                        "source_entry_id": "ee904146-e0be-367e-8c52-ce0fe713a996",
                        "source_sense_id": "707f05d2-5dd8-36bb-843c-19a2a80595c4",
                        "source_sense_description": "Abweichung von einer geraden Linie oder ebenen Fläche",
                        "target_lang_word": "curvature",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "curvature",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9cada65-ac81-3ae0-b687-6c1b19f0974e",
                                        "entry_id": "5e89bd86-980a-32aa-a5ec-360528b53c04",
                                        "glosses": [
                                            "The shape of something curved."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9afad349-22db-4d3f-939f-d8a37654a7ec",
                                                "sense_id": "e9cada65-ac81-3ae0-b687-6c1b19f0974e",
                                                "text": "Constructional costs are kept to a minimum by the admissibility of heavy grades and sharp curvature."
                                            },
                                            {
                                                "example_id": "02761719-bd68-4c77-91b3-b9d8556052dc",
                                                "sense_id": "e9cada65-ac81-3ae0-b687-6c1b19f0974e",
                                                "text": "In the first of the movie's many striking images, we share his majestic view from the top, the curvature of the planet and the glow of the horizon brilliantly reflected in his helmet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ae986b2-e16e-302f-8f1a-bd7b44a5dcea",
                                        "entry_id": "5e89bd86-980a-32aa-a5ec-360528b53c04",
                                        "glosses": [
                                            "The extent to which a subspace is curved within a metric space."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b42cf6e0-19d4-45fa-9cb1-6c6797acd3a2",
                                                "sense_id": "2ae986b2-e16e-302f-8f1a-bd7b44a5dcea",
                                                "text": "A turtle drawing an ellipse would have to turn more per distance traveled to get around its “pointy” sides than to get around its flatter top and bottom. This notion of how “pointy something is,” expressed as the ratio of angle turned to distance traveled, is the intrinsic quantity that mathematicians call curvature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "662510e7-046c-3dc8-8e6d-6de58cea1cf3",
                                        "entry_id": "5e89bd86-980a-32aa-a5ec-360528b53c04",
                                        "glosses": [
                                            "The extent to which a Riemannian manifold is intrinsically curved."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ac159d9-c876-40af-8866-129fe67d6a88",
                        "source_entry_id": "ee904146-e0be-367e-8c52-ce0fe713a996",
                        "source_sense_id": "707f05d2-5dd8-36bb-843c-19a2a80595c4",
                        "source_sense_description": "Abweichung von einer geraden Linie oder ebenen Fläche",
                        "target_lang_word": "courbure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "courbure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3aff51b3-9fee-3bb4-84e0-87cb941870d7",
                                        "entry_id": "fb1cefa4-d0b1-31d3-bd2f-d38ff9f7bf3d",
                                        "glosses": [
                                            "Forme d’une chose courbée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0af06a06-6b6b-4a82-8c58-87c1ffdea69e",
                                                "sense_id": "3aff51b3-9fee-3bb4-84e0-87cb941870d7",
                                                "text": "Cette pièce de bois a plus de courbure."
                                            },
                                            {
                                                "example_id": "28e4f28c-5b2c-442b-b948-e3166191e748",
                                                "sense_id": "3aff51b3-9fee-3bb4-84e0-87cb941870d7",
                                                "text": "Courbure d’un arc."
                                            },
                                            {
                                                "example_id": "ddcdb8c8-c9e8-4899-84d1-ada9e00dccfb",
                                                "sense_id": "3aff51b3-9fee-3bb4-84e0-87cb941870d7",
                                                "text": "La courbure de cette poutre vient de ce qu’on l’a trop chargée."
                                            },
                                            {
                                                "example_id": "4e7b976a-e543-41d6-9209-c0f1daf82a4c",
                                                "sense_id": "3aff51b3-9fee-3bb4-84e0-87cb941870d7",
                                                "text": "Les courbures de la colonne vertébrale."
                                            },
                                            {
                                                "example_id": "60a702a3-3390-4b5c-a852-0716fffb193a",
                                                "sense_id": "3aff51b3-9fee-3bb4-84e0-87cb941870d7",
                                                "text": "À la naissance, le rachis forme une courbe concave en avant, puis progressivement l’enfant redresse la tête et se crée la courbure cervicale en lordose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8b46449-55ab-32b9-b6ed-aa065a3a5052",
                                        "entry_id": "fb1cefa4-d0b1-31d3-bd2f-d38ff9f7bf3d",
                                        "glosses": [
                                            "En géométrie riemannienne, tenseur qui décrit les variations secondes d'une métrique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afb79d83-9b05-43d1-950c-8ba71f7d5ded",
                                                "sense_id": "e8b46449-55ab-32b9-b6ed-aa065a3a5052",
                                                "text": "Courbure sectionnelle."
                                            },
