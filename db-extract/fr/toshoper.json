                ],
                "senses": [
                    {
                        "sense_id": "6316f490-380f-3b12-b6c5-544ea5339ae3",
                        "entry_id": "10d8fc6a-387c-31e8-bc96-5997147051c0",
                        "glosses": [
                            "Retoucher une photo ou une image au moyen d’un logiciel."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "b8072654-838f-4695-8956-2125e959f04b",
                                "sense_id": "6316f490-380f-3b12-b6c5-544ea5339ae3",
                                "text": "Il suffit de toshoper un peu cette photo pour qu’elle soit réussie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dadefd91-7ea1-4203-8941-ab0cbb08e6c9",
                        "source_entry_id": "10d8fc6a-387c-31e8-bc96-5997147051c0",
                        "source_sense_id": "6316f490-380f-3b12-b6c5-544ea5339ae3",
                        "source_sense_description": "Retoucher une photo ou une image au moyen d’un logiciel",
                        "target_lang_word": "photoshop",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "photoshop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7858f787-43d9-3205-be86-96321d539646",
                                        "entry_id": "08f38dd9-56c8-36ab-87b7-31808519cb3c",
                                        "glosses": [
                                            "To digitally edit or alter (a picture or photograph)."
                                        ],
                                        "tags": [
                                            "transitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71356195-6898-4caa-a340-d038e24c8332",
                                                "sense_id": "7858f787-43d9-3205-be86-96321d539646",
                                                "text": "She charged that the prosecutor had photoshopped the image to incriminate her."
                                            },
                                            {
                                                "example_id": "64acf611-317f-4809-9b8b-df5c7e0b920d",
                                                "sense_id": "7858f787-43d9-3205-be86-96321d539646",
                                                "text": "Photographs can be manipulated, too; while a \"Photoshopped\" image may look beautiful, it might not give a correct impression of a place (this is a whole other column)."
                                            },
                                            {
                                                "example_id": "7c62f6a4-bd52-41a7-bc95-766601116e26",
                                                "sense_id": "7858f787-43d9-3205-be86-96321d539646",
                                                "text": "Ned Shaw, a former illustrator for PC Magazine, has gathered a huge collection of classic examples from such artists and illustrators as Maxfield Parish and Edmund Dulac. He then Photoshopped it (a new verb; you heard it first here) and produced two volumes of fantastic art. The cool part is that the product comes in two resolutions."
                                            },
                                            {
                                                "example_id": "f3acaa98-4ed7-4896-913b-acc852637679",
                                                "sense_id": "7858f787-43d9-3205-be86-96321d539646",
                                                "text": "The feisty brunette star of The Mummy [sc. Rachel Weisz] boasts: \"I really did hold that snake. People thought it was Photoshopped in, but it was the real thing. I had to stay relaxed.\" What about the snake?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "photoshop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fab312e7-e1bd-3ab7-bdf6-18bedbba0083",
                                        "entry_id": "70d5011e-8ee9-3f61-90d9-d49546387b55",
                                        "glosses": [
                                            "A digitally altered image."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b78f8f48-87a5-495b-9ff9-c24ea0305ac1",
                                                "sense_id": "fab312e7-e1bd-3ab7-bdf6-18bedbba0083",
                                                "text": "I reckon the image is a photoshop."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
