                "senses": [
                    {
                        "sense_id": "99603ebd-5641-3d5c-88b2-ec26d56d8ebc",
                        "entry_id": "7f603b81-5d09-3cd0-9ed0-76e69b054336",
                        "glosses": [
                            "An avenging spirit or deity, variously associated with the Erinyes, Nemesis, and more."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "949a7eb6-f12f-4293-af99-e0ba97b4d61e",
                                "sense_id": "99603ebd-5641-3d5c-88b2-ec26d56d8ebc",
                                "text": "Dog, leave thy snarling, or I'll cut thy tongue out !\nThou unlick'd bear, dar'st thou yet stand my fury,\nMy generous rage? yet? By the sulphureous damps\nThat feed the hungry and incessant darkness,\nWhich curls around the grim Alastor's back,\nMutter again, and with one powerful word,\nI'll call an host up from the Stygian lakes,\nShall waft thee to the Acherontick fens;\nWhere, choak'd with mists as black as thy impostures,"
                            }
                        ]
                    },
                    {
                        "sense_id": "994b98c7-66a7-3fc9-9824-dd7df816d637",
                        "entry_id": "7f603b81-5d09-3cd0-9ed0-76e69b054336",
                        "glosses": [
                            "In more recent ages, a term of rebuke for a pestilent rascal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d74ae4aa-83df-4b05-933b-b7128939a922",
                                "sense_id": "994b98c7-66a7-3fc9-9824-dd7df816d637",
                                "text": "1852 James Orton: \"Excelsior\" or \"The Realms of Poesie by Alastor\". Private publication printed by William Pickering, London\nJames Orton's choice of \"Alastor\" seems to have been an ironic pen name, suggesting a presumptuous voice."
                            }
                        ]
                    },
                    {
                        "sense_id": "cda4ee5c-a459-395f-8f4b-30621573cd91",
                        "entry_id": "7f603b81-5d09-3cd0-9ed0-76e69b054336",
                        "glosses": [
                            "A genus of hunting wasp"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4afe125-bb4b-42cc-9daa-76a738949f74",
                                "sense_id": "cda4ee5c-a459-395f-8f4b-30621573cd91",
                                "text": "Alastor eriurgus. . . A very common \"mason wasp\" in the neighbourhood of Sydney; very plentiful in February and March.\nThey are subject to the attacks of cuckoo wasps and other parasitic Hymenoptera; in one nest I found a small Bracon larva beside the young Alastor, which it soon devoured, and then spun an elongate white silken cocoon, out of which it emerged ten days after; . . . I have bred out several specimens. These inquilines are placed in the Alastor nest while the builders are out hunting for caterpillars, their active mothers being on the watch to crawl in and deposit the eggs in the owner's absence."
                            }
                        ]
                    }
