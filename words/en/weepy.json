{
    "word_family": [
        "weep",
        "weeper"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ed5eaabc-deb9-3095-b5aa-bc9851c7355a",
                    "sense_definition": "Inclined to cry or shed tears easily",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt a bit <w>weepy</w> after watching the sad news report.",
                            "target_lang_translations": {
                                "pl": "Poczuła się nieco <w>płaczliwa</w> po obejrzeniu smutnego serwisu informacyjnego."
                            }
                        },
                        {
                            "text": "The tired child became <w>weepy</w> when it was time to leave the park.",
                            "target_lang_translations": {
                                "pl": "Zmęczone dziecko stało się <w>płaczliwe</w>, gdy nadszedł czas wyjścia z parku."
                            }
                        }
                    ],
                    "synonyms": [
                        "tearful",
                        "emotional"
                    ],
                    "antonyms": [
                        "cheerful"
                    ],
                    "target_lang_definitions": {
                        "pl": "Skłonny do płaczu, łatwo wpadający w łzy"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "płaczliwy",
                                "target_lang_sense_clarification": "osoba skłonna do częstego płaczu"
                            },
                            {
                                "target_lang_word": "bekliwy",
                                "target_lang_sense_clarification": "potoczne określenie osoby łatwo wpadającej w płacz"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e07ae5c-e21e-37ef-bc62-d68a9da68481",
                    "sense_definition": "Characterized by excessive or tragic sentimentality",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie was a <w>weepy</w> drama that left the entire audience in tears.",
                            "target_lang_translations": {
                                "pl": "Film był <w>wyciskającym łzy</w> dramatem, który doprowadził całą widownię do płaczu."
                            }
                        },
                        {
                            "text": "He avoided watching that <w>weepy</w> film because he did not want to feel sad.",
                            "target_lang_translations": {
                                "pl": "Unikał oglądania tego <w>wyciskacza łez</w>, ponieważ nie chciał czuć się smutny."
                            }
                        }
                    ],
                    "synonyms": [
                        "sentimental",
                        "melodramatic"
                    ],
                    "common_phrases": [
                        "weepy movie"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used to describe sentimental media"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Cechujący się nadmierną lub przesadną sentymentalnością, wyciskający łzy"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wyciskacz łez",
                                "target_lang_sense_clarification": "o filmie lub książce mającej na celu wzruszenie odbiorcy"
                            },
                            {
                                "target_lang_word": "sentymentalny",
                                "target_lang_sense_clarification": "o utworze pełnym przesadnego wzruszenia"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6fac6410-e478-3ca1-a91e-c7dd3afcf301",
                    "sense_definition": "A film or book that is designed to make the audience cry",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "media",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She loves watching a good <w>weepy</w> on a rainy Sunday afternoon.",
                            "target_lang_translations": {
                                "pl": "Uwielbia oglądać dobry <w>wyciskacz łez</w> w deszczowe niedzielne popołudnie."
                            }
                        },
                        {
                            "text": "The director is famous for creating every classic <w>weepy</w> of the decade.",
                            "target_lang_translations": {
                                "pl": "Reżyser słynie z tworzenia każdego klasycznego <w>wyciskacza łez</w> dekady."
                            }
                        }
                    ],
                    "synonyms": [
                        "tear-jerker"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal term for a tear-jerker"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Film lub książka zaprojektowana tak, aby wywołać u odbiorcy płacz"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wyciskacz łez",
                                "target_lang_sense_clarification": "potoczne określenie wzruszającego filmu lub książki"
                            },
                            {
                                "target_lang_word": "melodramat",
                                "target_lang_sense_clarification": "gatunek filmowy często mający charakter wyciskacza łez"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}