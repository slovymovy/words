                {
                    "sense_id": "f56f568a-78b2-3c26-bcbb-2dd52ed764af",
                    "sense_definition": "The metric system of measurement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "measurement_system",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It took some time for the older generation to get used to <w>metric</w>.",
                            "target_lang_translations": {
                                "ru": "Старшему поколению потребовалось некоторое время, чтобы привыкнуть к <w>метрической системе</w>.",
                                "zh": "老一辈人花了一些时间才习惯使用<w>公制</w>。"
                            }
                        },
                        {
                            "text": "The industry decided to go <w>metric</w> to align with international standards.",
                            "target_lang_translations": {
                                "ru": "Промышленность решила перейти на <w>метрическую систему</w>, чтобы соответствовать международным стандартам.",
                                "zh": "该行业决定采用<w>公制</w>以符合国际标准。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "go metric"
                    ],
                    "target_lang_definitions": {
                        "ru": "Метрическая система мер.",
                        "zh": "公制测量系统。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "метрическая система",
                                "target_lang_sense_clarification": "система измерений"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "公制",
                                "target_lang_sense_clarification": "测量系统"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f06a3a45-60e5-31f5-ae15-3c307f6b1595",
                    "sense_definition": "A mathematical function that defines the distance between two points in a specific set or space.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "math_function",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this geometry class, we will define a <w>metric</w> on a curved surface.",
                            "target_lang_translations": {
                                "ru": "На этом уроке геометрии мы определим <w>метрику</w> на криволинейной поверхности.",
                                "zh": "在这堂几何课上，我们将定义曲面上的<w>度量</w>。"
                            }
                        },
                        {
                            "text": "The Euclidean <w>metric</w> is the most common way to measure distance in a plane.",
                            "target_lang_translations": {
                                "ru": "Евклидова <w>метрика</w> — наиболее распространенный способ измерения расстояния на плоскости.",
                                "zh": "欧几里得<w>度量</w>是平面上测量距离最常用的方法。"
                            }
                        }
                    ],
                    "synonyms": [
                        "distance function"
                    ],
                    "common_phrases": [
                        "Euclidean metric",
                        "Riemannian metric"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "mathematics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Математическая функция, определяющая расстояние между двумя точками в заданном множестве или пространстве.",
                        "zh": "定义特定集合或空间中两点之间距离的数学函数。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "метрика",
                                "target_lang_sense_clarification": "математическая функция"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "度量",
                                "target_lang_sense_clarification": "数学中的距离函数"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "79959209-984a-363b-8eaa-550ce02d5cde",
                    "sense_definition": "To measure or analyze data regarding the quality or effectiveness of a process.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "evaluation_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to <w>metric</w> the system failures to understand the root cause.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>измерить</w> сбои системы, чтобы понять первопричину.",
                                "zh": "我们需要<w>量化</w>系统故障以了解根本原因。"
                            }
                        },
                        {
                            "text": "The team is currently <w>metricking</w> the results of the new marketing campaign.",
                            "target_lang_translations": {
                                "ru": "Команда в данный момент <w>оценивает</w> результаты новой маркетинговой кампании.",
                                "zh": "团队目前正在<w>衡量</w>新营销活动的结果。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business jargon"
                        }
                    ],
                    "target_lang_definitions": {
