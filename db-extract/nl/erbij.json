                            {
                                "example_id": "20f451f2-d4fe-4e13-ae03-cd882df7f917",
                                "sense_id": "fd6d8d21-a4ee-325a-9b51-a11d93ef9b47",
                                "text": "erbij zijn : être présent"
                            },
                            {
                                "example_id": "e803b8ed-e747-4a1f-bf0c-b8c64bba5aed",
                                "sense_id": "fd6d8d21-a4ee-325a-9b51-a11d93ef9b47",
                                "text": "erbij zijn : être fait (comme un rat)"
                            },
                            {
                                "example_id": "1690b433-142d-4fb1-8edb-b26eabb168a3",
                                "sense_id": "fd6d8d21-a4ee-325a-9b51-a11d93ef9b47",
                                "text": "dat moest er nog bij komen : il ne manquerait plus que ça"
                            },
                            {
                                "example_id": "f80238b1-9d8b-41b8-b64a-df10047ca1f9",
                                "sense_id": "fd6d8d21-a4ee-325a-9b51-a11d93ef9b47",
                                "text": "ik blijf erbij dat ik gelijk heb : je maintiens que j’ai raison"
