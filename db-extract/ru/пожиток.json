                            }
                        ]
                    },
                    {
                        "translation_id": "be53ee64-03e2-40dc-957e-938c993b4600",
                        "source_entry_id": "0f347b05-8100-38ac-8135-ea25ccebe3f9",
                        "source_sense_id": "1bb64d91-b5d2-350c-aa20-0c4e3d862f96",
                        "target_lang_word": "effets",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "effets",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d9812953-032e-3ab7-941c-d7f8e8b60a13",
                                        "entry_id": "dcdadca3-3f48-3260-af57-8b08e47239a4",
                                        "glosses": [
                                            "Pluriel de effet."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "134ac88b-8946-4810-8e1b-2dfaada71f39",
                                                "sense_id": "d9812953-032e-3ab7-941c-d7f8e8b60a13",
                                                "text": "Déjà, dans une des discussions relatives à la septicémie, auxquelles j’ai pris part, j’ai exprimé le vœu que l’on mît à profit cette possibilité de septicémiser les lapins à volonté pour expérimenter les moyens thérapeutiques que l’on pouvait opposer à la septicémie, soit en préparant l’organisme à lui résister par une médication ou un régime préalables, soit en cherchant à détruire les effets du virus transmis par l’action d’agents antiseptiques."
                                            },
                                            {
                                                "example_id": "da4a209b-aba7-4228-a74e-2c6289230386",
                                                "sense_id": "d9812953-032e-3ab7-941c-d7f8e8b60a13",
                                                "text": "Mon cheval, sellé et bridé, ronge son frein et piaffe à ma porte; mes effets encombrent le patio, ficelés et prêts à être chargés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
