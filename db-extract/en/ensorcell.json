                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "84437a37-6e4e-3d78-ac66-8e25ed18dc70",
                                        "entry_id": "ad7cea1d-7cff-3864-845f-4c194b79b29d",
                                        "glosses": [
                                            "durch geschickte Bewegungen, Ablenkung und Täuschung einem Publikum Tricks vorführen, die wie Zauberei oder Magie aussehen; einen Zaubertrick vorführen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f450665-e40b-49ac-b1f1-bffb78966c66",
                                                "sense_id": "84437a37-6e4e-3d78-ac66-8e25ed18dc70",
                                                "text": "Leute wie David Copperfield zaubern nicht einfach; sie sind Großillusionisten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "92361cb0-6f24-3698-aeaf-a6e2ae7f82ca",
                                        "entry_id": "ad7cea1d-7cff-3864-845f-4c194b79b29d",
                                        "glosses": [
                                            "etwas unter nicht optimalen Voraussetzungen oder mit bescheidenen Mitteln sehr gut oder sehr schnell bewerkstelligen oder gutes Ergebnis erzielen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e34d343-cf37-4bec-a28a-29bc32c3d482",
                                                "sense_id": "92361cb0-6f24-3698-aeaf-a6e2ae7f82ca",
                                                "text": "Marko zauberte aus dem bisschen Mehl, das er noch zu Hause hatte, einen wunderbaren Kuchen."
                                            },
                                            {
                                                "example_id": "ea3a497f-333d-4e4f-9388-8b0423f9299e",
                                                "sense_id": "92361cb0-6f24-3698-aeaf-a6e2ae7f82ca",
                                                "text": "Der Bergführer zaubert aus den mitgebrachten Zutaten ein deftiges Mittagessen für seine Gäste."
                                            }
                                        ],
