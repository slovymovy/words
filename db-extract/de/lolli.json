                "senses": [
                    {
                        "sense_id": "ddc7ab4e-daf9-3d50-9455-1f12ace94add",
                        "entry_id": "35c7a51d-1419-37ca-a718-f020370daf89",
                        "glosses": [
                            "Bonbon am Stiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51b07bcd-eb06-451e-90e6-02f4bced7f70",
                                "sense_id": "ddc7ab4e-daf9-3d50-9455-1f12ace94add",
                                "text": "Ich lutsche einen Lolli."
                            },
                            {
                                "example_id": "dfbdcb3d-5e58-492d-ac27-0d944a3e87f5",
                                "sense_id": "ddc7ab4e-daf9-3d50-9455-1f12ace94add",
                                "text": "Sie hat den Lolli ihrem Sohn geschenkt."
                            },
                            {
                                "example_id": "814491d5-b1de-4e22-a69f-565446ddf3b5",
                                "sense_id": "ddc7ab4e-daf9-3d50-9455-1f12ace94add",
                                "text": "„Der Verkäufer streichelte Chrissi zum Abschied über den Kopf, und sie strahlte über das ganze Gesicht, weil der Honig ihren Finger in einen süßen Lolli verwandelt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c013432-e6a7-4752-af3c-12dd74ec99f9",
                        "source_entry_id": "35c7a51d-1419-37ca-a718-f020370daf89",
                        "source_sense_id": "ddc7ab4e-daf9-3d50-9455-1f12ace94add",
                        "source_sense_description": "Bonbon am Stiel",
                        "target_lang_word": "lollipop",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lollipop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "657d3f6e-7f22-3c2f-89d4-d9284725786a",
                                        "entry_id": "07c14d42-f92c-3437-b405-9dc93f07670c",
                                        "glosses": [
                                            "An item of confectionery consisting of a piece of candy or sweet attached to a stick."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d3205ecc-48c8-3486-9fca-50d0411d5835",
                                        "entry_id": "07c14d42-f92c-3437-b405-9dc93f07670c",
                                        "glosses": [
                                            "Something having the shape of a lollipop: a linear stem connected to a round body."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03f07fc2-c33b-4a55-ac1e-e2d7e15f550a",
                                                "sense_id": "d3205ecc-48c8-3486-9fca-50d0411d5835",
                                                "text": "The gene III proteins appear as five lollipops protruding from the end of the phage, and these “balls” can be removed by treatment of the phage with subtilisin, rendering the phage noninfectious."
                                            },
                                            {
                                                "example_id": "9e29430c-48e7-4cb0-b6f4-6f8e4e984d01",
                                                "sense_id": "d3205ecc-48c8-3486-9fca-50d0411d5835",
                                                "text": "The reasons for this containment of gated communities and private streets are not to be sought in morphology (suburban residential developments with lollipops and dead ends are common in France), but rather in local practices by residents."
                                            },
                                            {
                                                "example_id": "9983c532-fece-4621-ad3d-679ff7fa8762",
                                                "sense_id": "d3205ecc-48c8-3486-9fca-50d0411d5835",
                                                "text": "Mount Pleasant itself is a lollipop trail. Walking along the handle of the lollipop is a breeze—the perfect warm-up for the uphill climb at the beginning of the loop."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7334424a-af3f-326c-a7f0-394589e83fb3",
                                        "entry_id": "07c14d42-f92c-3437-b405-9dc93f07670c",
                                        "glosses": [
                                            "A sign on a stick held in front of the vehicle during a pit stop."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lollipop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ede13c6c-51c3-30eb-96e7-c632559255dd",
                                        "entry_id": "d3cced2b-bc36-3862-886d-ca07e708b08d",
                                        "glosses": [
                                            "To prune the lower branches of a tree or other plant so that new growth appears only at the top, where more light is received."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
