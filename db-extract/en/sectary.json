                        "glosses": [
                            "A member of a particular sect, school of thought or practice, party, or profession; a sectarian."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60e2d31f-0d4c-4401-a1ab-ff6bb7ad7f39",
                                "sense_id": "89e551a0-fd22-3e61-a4b1-bc7d78d1f253",
                                "text": "Be it as it may: within the Land of Penn / The sectary yielded to the citizen, / And peaceful dwelt the many-creeded men."
                            },
                            {
                                "example_id": "e833c495-6e45-40a2-aee4-9b68fb5681a3",
                                "sense_id": "89e551a0-fd22-3e61-a4b1-bc7d78d1f253",
                                "text": "It is this spirit which inspires sectaries to deprecate the public schools and, if they cannot divert part of the tax support, then to foist upon this free system the shadow of their own beclouded vision."
                            }
                        ]
                    },
                    {
                        "sense_id": "1905d54b-0bba-3733-a37b-5893ef57214c",
                        "entry_id": "50d472ea-ee9e-31ad-bd03-8c3767ba5109",
                        "glosses": [
                            "A Protestant dissenter or nonconformist."
