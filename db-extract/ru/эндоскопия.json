                ],
                "translations": [
                    {
                        "translation_id": "305f33ba-b195-48d6-b18b-3280cf6dcfc1",
                        "source_entry_id": "db90f331-f323-3612-b3d4-5c998e0267bd",
                        "source_sense_id": "d652776c-9b3a-3393-ba33-49e3d28ce9ac",
                        "target_lang_word": "endoscopy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "endoscopy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6fd995e2-3b6e-31c1-b781-a068dca6363f",
                                        "entry_id": "8002e539-3d49-34c5-88e7-bf7d2686a7c6",
                                        "glosses": [
                                            "The examination of a bodily orifice, canal or organ using an endoscope."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18a86044-56d1-4b27-96d5-8db3f0484885",
                                                "sense_id": "6fd995e2-3b6e-31c1-b781-a068dca6363f",
                                                "text": "But less complex scopes also pose contamination risks – and they’re used on far more people: Each year in the United States, doctors perform more than 15 million colonoscopies and 7 million endoscopies of the upper GI tract."
                                            },
                                            {
                                                "example_id": "a830661b-d70c-4180-b94a-5ef79b2d37d0",
                                                "sense_id": "6fd995e2-3b6e-31c1-b781-a068dca6363f",
                                                "text": "One insurance company, UnitedHealthcare, has announced that starting in June, members with commercial plans seeking gastroenterology endoscopy services – including colonoscopies – will be required to have “prior authorizations” for those services."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "779680d6-9b5a-4030-91d4-5c0a669fffa8",
                        "source_entry_id": "db90f331-f323-3612-b3d4-5c998e0267bd",
                        "source_sense_id": "d652776c-9b3a-3393-ba33-49e3d28ce9ac",
