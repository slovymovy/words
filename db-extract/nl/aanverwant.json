                    {
                        "translation_id": "ff83be10-37c1-42d3-8418-c7c27aa70a7c",
                        "source_entry_id": "39b8791d-299c-3dd5-b2e2-695409b72c3c",
                        "source_sense_id": "9b4f2c86-1df9-3b08-aec4-42795e66b752",
                        "target_lang_word": "akin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "akin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4edcefd3-7503-39d8-bc44-a62a67b26b4f",
                                        "entry_id": "5b0de05e-b1a4-30b2-a905-866ab6682087",
                                        "glosses": [
                                            "Of the same kin; related by blood."
                                        ],
                                        "tags": [
                                            "of persons"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8531855-fbfc-4830-9e44-43914656f88e",
                                                "sense_id": "4edcefd3-7503-39d8-bc44-a62a67b26b4f",
                                                "text": "[W]e are too near a kin to lye together, tho' vve may Lodge near one another; […]"
                                            },
                                            {
                                                "example_id": "fa3d8af1-7a02-4225-ae0c-19f91b19ee9c",
                                                "sense_id": "4edcefd3-7503-39d8-bc44-a62a67b26b4f",
                                                "text": "The faces changed, passing in rotation. Youthful faces, bearded faces, dark faces: faces serene, or faces moody, but all akin with the brotherhood of the sea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17a81156-0140-34c3-bf6c-f8f378246729",
                                        "entry_id": "5b0de05e-b1a4-30b2-a905-866ab6682087",
                                        "glosses": [
                                            "Allied by nature; similar; partaking of the same properties; of the same kind."
                                        ],
                                        "tags": [
                                            "often",
                                            "with-to"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88378fd6-3047-4c6c-93c5-ed8e641dcb2b",
                                                "sense_id": "17a81156-0140-34c3-bf6c-f8f378246729",
                                                "text": "Is not then Fruition near akin to Love?"
                                            },
                                            {
                                                "example_id": "aa532c39-d268-42a6-9906-cb40b8d61c3b",
                                                "sense_id": "17a81156-0140-34c3-bf6c-f8f378246729",
                                                "text": "She told me that she hoped my Face was not akin to my Tongue."
                                            },
                                            {
                                                "example_id": "64ff60e1-e9cd-41b6-8c1b-194abb6fe3f4",
                                                "sense_id": "17a81156-0140-34c3-bf6c-f8f378246729",
                                                "text": "Mr. Winkle . . . took his hand with a feeling of regard, akin to veneration."
                                            },
                                            {
                                                "example_id": "ae065d5d-820d-414d-b8bc-40ad3e1c8406",
                                                "sense_id": "17a81156-0140-34c3-bf6c-f8f378246729",
                                                "text": "Something akin to a smile shone on his face."
                                            },
                                            {
                                                "example_id": "d45b7edc-18d4-4c00-94a9-c40b383815c9",
                                                "sense_id": "17a81156-0140-34c3-bf6c-f8f378246729",
                                                "text": "I'll be interested to see how this service does. It will be basic with fares to match, so will be akin to a budget airline taking on a flag-carrier."
                                            },
                                            {
                                                "example_id": "672d2673-8271-4bf3-8017-906874bf5faf",
                                                "sense_id": "17a81156-0140-34c3-bf6c-f8f378246729",
                                                "text": "Picking up speed with each passing second, the rod would then penetrate the ground and generate an explosion akin to a small nuclear weapon using nothing but gravity for its propulsion."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "akin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b1e92e02-8c00-37b9-af93-da412d346ae6",
                                        "entry_id": "3a4a05e3-6fcf-3ffd-a028-e502c2ca46df",
                                        "glosses": [
                                            "To relate or compare; to liken."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0edac036-67f0-4632-a96f-0904b1a0792b",
                                                "sense_id": "b1e92e02-8c00-37b9-af93-da412d346ae6",
                                                "text": "I like to akin the P-Diddy case to Gen-Z's version of the O.J. Simpson trial."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
