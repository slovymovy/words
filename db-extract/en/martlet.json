                "senses": [
                    {
                        "sense_id": "2a691dac-2ea8-3cd4-9f41-3f8e2e23dd0b",
                        "entry_id": "7e512fdf-ed35-39e9-aab9-7a930b19de1f",
                        "glosses": [
                            "A bird, the martin."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "157cb350-8106-4248-8386-1295dc481bc6",
                                "sense_id": "2a691dac-2ea8-3cd4-9f41-3f8e2e23dd0b",
                                "text": "“As in a drought the thirsty creatures cry,\nAnd gape upon the gather'd clouds for rain;\nThen, first, the Martlet meets it in the sky,\nAnd, with wet wings, joys all the feather'd train.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "ed3676fb-1ccd-3a7f-841e-63f199e08a14",
                        "entry_id": "7e512fdf-ed35-39e9-aab9-7a930b19de1f",
                        "glosses": [
                            "A depiction of a bird similar to a house martin or swallow with stylized feet."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
