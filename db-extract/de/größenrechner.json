                "senses": [
                    {
                        "sense_id": "1aa67bb4-06e5-3431-893b-3e77705911db",
                        "entry_id": "c63dc2d9-6307-397e-a050-9ef6a3d69a09",
                        "glosses": [
                            "Programm, mit dem die voraussichtliche Größe berechnet werden kann, die eine Person erreichen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21e78947-3238-41ce-8546-d978a917ad51",
                                "sense_id": "1aa67bb4-06e5-3431-893b-3e77705911db",
                                "text": "„Ich hatte auf dem Handy einen Größenrechner gefunden und ihre Größe eingegeben.“"
                            },
                            {
                                "example_id": "171dccbc-d7ff-4a90-96fd-4f35d683df54",
                                "sense_id": "1aa67bb4-06e5-3431-893b-3e77705911db",
                                "text": "„Außerdem gibt es die Möglichkeit, die zukünftige Körpergröße eines Kindes oder Jugendlichen mit Hilfe eines Größenrechners berechnen zu lassen.“"
                            },
                            {
                                "example_id": "83cf6bb2-9db8-4a52-8a9f-f5e48f7d803f",
                                "sense_id": "1aa67bb4-06e5-3431-893b-3e77705911db",
                                "text": "„Mit unserem Größenrechner kannst du die voraussichtliche Körperendgröße deines Kindes berechnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "49bd9da5-daa6-36fe-9c25-3ea7270a512a",
                        "entry_id": "c63dc2d9-6307-397e-a050-9ef6a3d69a09",
                        "glosses": [
                            "Programm/Verfahren zur Bestimmung der Größe von etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66e95d57-ed37-424a-9875-967f4b8c64e2",
                                "sense_id": "49bd9da5-daa6-36fe-9c25-3ea7270a512a",
                                "text": "„Bei unserem Größenrechner solltest Du berücksichtigen, dass es sich hierbei nicht um eine Kaufberatung für die Auswahl des richtigen Kletterschuhmodells handelt.“"
                            },
                            {
                                "example_id": "39a2e981-cd8c-4576-aebd-a1919859b614",
                                "sense_id": "49bd9da5-daa6-36fe-9c25-3ea7270a512a",
                                "text": "„Beachten Sie dabei bitte, dass der Größenrechner nur mit Zenitmeterangaben arbeitet.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
