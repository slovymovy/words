                                "sense_id": "a628585f-1e6e-3c16-86f6-a829900a07b5",
                                "text": "Der chauvinistische Gedanke, dass Frankreich der Erbfeind Deutschlands ist, wurde im Zuge der Deutsch-Französischen Freundschaft nach 1945 überwunden."
                            },
                            {
                                "example_id": "8d321dac-b7ed-4553-b071-f9ad431da22b",
                                "sense_id": "a628585f-1e6e-3c16-86f6-a829900a07b5",
                                "text": "„Offen trat Walter Mehring gegen das Gerede vom Erbfeind Frankreich ein.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
