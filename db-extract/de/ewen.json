                "senses": [
                    {
                        "sense_id": "f2d3e90c-4f1d-3f2f-a707-1cd2b6b5d38c",
                        "entry_id": "b71a7b5c-bd9b-3aac-98eb-295204cae0f7",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "325332c0-5fa8-42c7-b44c-5604a35f6f2b",
                                "sense_id": "f2d3e90c-4f1d-3f2f-a707-1cd2b6b5d38c",
                                "text": "Frau Ewen ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "59c93086-4d44-42b1-a60f-a1a7e8de2ee8",
                                "sense_id": "f2d3e90c-4f1d-3f2f-a707-1cd2b6b5d38c",
                                "text": "Herr Ewen wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "fe00d795-f792-412c-9341-cd5f151815e0",
                                "sense_id": "f2d3e90c-4f1d-3f2f-a707-1cd2b6b5d38c",
                                "text": "Die Ewens fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "84aa0279-f6c6-467a-819e-09adf890bb7c",
                                "sense_id": "f2d3e90c-4f1d-3f2f-a707-1cd2b6b5d38c",
                                "text": "Der Ewen trägt nie die Pullover, die die Ewen ihm strickt."
                            },
                            {
                                "example_id": "119f6b7b-c2a8-42d2-be17-7666dc62d1d3",
                                "sense_id": "f2d3e90c-4f1d-3f2f-a707-1cd2b6b5d38c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ewen kommt, geht der Herr Ewen.“"
                            },
                            {
                                "example_id": "db7622e3-e32f-44d3-b5eb-27c27368c3ee",
                                "sense_id": "f2d3e90c-4f1d-3f2f-a707-1cd2b6b5d38c",
                                "text": "Ewen kommt und geht."
                            },
                            {
                                "example_id": "ef576048-ef88-44cb-9371-bc45f7cf4ab1",
                                "sense_id": "f2d3e90c-4f1d-3f2f-a707-1cd2b6b5d38c",
                                "text": "Ewens kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
