{
    "word_family": [
        "goggler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5abcbde3-5ebe-3b8c-b007-8301b7f6bbe4",
                    "sense_definition": "To stare at something with wide eyes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "staring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not <w>goggle</w> at the people passing by on the street.",
                            "target_lang_translations": {
                                "zh": "别<w>瞪</w>着街上走过的人看。"
                            }
                        },
                        {
                            "text": "The children <w>goggled</w> at the magician as he performed his tricks.",
                            "target_lang_translations": {
                                "zh": "孩子们<w>瞪</w>大眼睛看着魔术师表演戏法。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gape"
                    ],
                    "common_phrases": [
                        "goggle at"
                    ],
                    "target_lang_definitions": {
                        "zh": "睁大眼睛盯着看。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "瞪",
                                "target_lang_sense_clarification": "指睁大眼睛直视。"
                            },
                            {
                                "target_lang_word": "目瞪口呆",
                                "target_lang_sense_clarification": "形容因吃惊而睁大眼睛盯着看。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b473ac5-0b08-3806-a5ae-3fac698813c3",
                    "sense_definition": "To roll the eyes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "staring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He began to <w>goggle</w> his eyes in frustration during the long meeting.",
                            "target_lang_translations": {
                                "zh": "在漫长的会议中，他开始因为沮丧而<w>翻白眼</w>。"
                            }
                        },
                        {
                            "text": "The actor had to <w>goggle</w> to portray the character's confusion.",
                            "target_lang_translations": {
                                "zh": "演员必须<w>翻白眼</w>来表现角色的困惑。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often used in older literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "转动眼球。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "翻白眼",
                                "target_lang_sense_clarification": "指转动眼球以表示不满或困惑。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e72ad7c4-0cbf-3c10-99b1-94a2f5df3b46",
                    "sense_definition": "A pair of protective eyeglasses.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "eyewear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Put on your <w>goggles</w> before you start swimming in the pool.",
                            "target_lang_translations": {
                                "zh": "在泳池游泳前，请戴上你的<w>泳镜</w>。"
                            }
                        },
                        {
                            "text": "The scientist wore safety <w>goggles</w> to protect her eyes from chemicals.",
                            "target_lang_translations": {
                                "zh": "科学家戴上<w>护目镜</w>以保护眼睛免受化学物质伤害。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "safety goggles",
                        "swimming goggles"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种保护眼睛的眼镜。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "护目镜",
                                "target_lang_sense_clarification": "用于保护眼睛的防护眼镜。"
                            },
                            {
                                "target_lang_word": "泳镜",
                                "target_lang_sense_clarification": "游泳时佩戴的护目镜。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6ca9079-8644-35ec-bd9a-0714b4eb9efb",
                    "sense_definition": "A wide-eyed stare or affected rolling of the eye.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "staring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave a surprised <w>goggle</w> when he saw the expensive gift.",
                            "target_lang_translations": {
                                "zh": "看到那份昂贵的礼物时，他惊讶地<w>瞪</w>大了眼睛。"
                            }
                        },
                        {
                            "text": "She took a quick <w>goggle</w> at the newspaper headline.",
                            "target_lang_translations": {
                                "zh": "她快速地<w>瞪</w>了一眼报纸标题。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "have a goggle"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "睁大眼睛的凝视或转动眼球的动作。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "瞪眼",
                                "target_lang_sense_clarification": "指睁大眼睛的动作。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}