                "senses": [
                    {
                        "sense_id": "2b66d310-4269-3121-996c-6b223fa2ad49",
                        "entry_id": "815e6ac9-7aa6-357b-9243-9d6c131d03fb",
                        "glosses": [
                            "Person, die nicht empfinden kann; eine gefühlsblinde Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b0d03d0-f851-4dc2-a22c-b5db75100216",
                                "sense_id": "2b66d310-4269-3121-996c-6b223fa2ad49",
                                "text": "„Und falls doch einmal einer ärztliche Hilfe sucht, dann meist wegen psychosomatischer Krankheiten. Denn die Körper von Gefühlsblinden stehen häufig unter diffuser Anspannung und Dauerstress. Viele von ihnen leiden an Kopfschmerzen, Bluthochdruck oder anderen Symptomen, für die es keine unmittelbare Ursache gibt.“"
                            }
                        ],
