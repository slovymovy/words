                "senses": [
                    {
                        "sense_id": "26c59aa4-b12a-3839-adeb-4eef47f7fa01",
                        "entry_id": "050dd95d-b17f-3fc6-87df-e881397e1211",
                        "glosses": [
                            "религ., церк. общее название нескольких церковнослужебных и четьих книг"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "641fc526-4b86-4c9a-82f0-706ee9f401be",
                                "sense_id": "26c59aa4-b12a-3839-adeb-4eef47f7fa01",
                                "text": "Перед ним и октоих, и служебник, и минея, стихиры на стиховне выписаны на отдельном листочке — но всё спуталось!"
                            },
                            {
                                "example_id": "b92973cf-2051-48bc-a728-ff93ac30bd8a",
                                "sense_id": "26c59aa4-b12a-3839-adeb-4eef47f7fa01",
                                "text": "Например, непорочное зачатие Богородицы упоминается в текстах четьих миней и акафистов."
                            }
                        ]
                    }
