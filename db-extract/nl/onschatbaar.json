                "senses": [
                    {
                        "sense_id": "19ca424c-d7e0-34f5-bf02-5f0904dbec66",
                        "entry_id": "89172fb6-afd7-30e6-84c3-deae3d52436c",
                        "glosses": [
                            "invaluable, priceless"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9460f090-9e8c-4474-8009-c40c4daaa836",
                                "sense_id": "19ca424c-d7e0-34f5-bf02-5f0904dbec66",
                                "text": "Deze oude schilderijen zijn onschatbaar en kunnen niet worden verkocht.",
                                "translation": "These old paintings are priceless and cannot be sold.",
                                "english": "These old paintings are priceless and cannot be sold."
                            },
                            {
                                "example_id": "cd8cbf2b-c6fc-4404-a9ef-5f7122db7eb0",
                                "sense_id": "19ca424c-d7e0-34f5-bf02-5f0904dbec66",
                                "text": "Uw hulp is onschatbaar geweest voor dit project.",
                                "translation": "Your help has been invaluable to this project.",
                                "english": "Your help has been invaluable to this project."
                            },
                            {
                                "example_id": "16892bac-ec44-459c-b29f-a06c8c01d3ba",
                                "sense_id": "19ca424c-d7e0-34f5-bf02-5f0904dbec66",
                                "text": "De onschatbare waarde van vriendschap kan niet in geld worden uitgedrukt.",
                                "translation": "The priceless value of friendship cannot be expressed in money.",
                                "english": "The priceless value of friendship cannot be expressed in money."
                            }
                        ]
                    }
                ],
