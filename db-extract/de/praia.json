                "senses": [
                    {
                        "sense_id": "a6a29324-71fe-3fdc-8fd8-84013ac54b3e",
                        "entry_id": "3a1ccf49-f625-33ba-b4ab-9cd58655df15",
                        "glosses": [
                            "Hauptstadt von Kap Verde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36180762-f61c-4bb4-bdd9-9d7fe87bc4e3",
                                "sense_id": "a6a29324-71fe-3fdc-8fd8-84013ac54b3e",
                                "text": "Warst du schon einmal in Praia?"
                            },
                            {
                                "example_id": "d2804884-61f0-4bcc-ab60-6fba9432fa26",
                                "sense_id": "a6a29324-71fe-3fdc-8fd8-84013ac54b3e",
                                "text": "«Praia auf der südlichen Insel Santiago ist die politische Kapitale von Cabo Verde; rund um den natürlichen Hafen Porto Grande auf der kleinen Insel São Vicente im Norden gewachsen, ist Mindelo mit seinen inzwischen über 65 000 Einwohnern das historische Zentrum des kapverdischen Kulturlebens.»"
                            },
                            {
                                "example_id": "e547fa7d-38f0-46b5-b013-87bb58b67735",
                                "sense_id": "a6a29324-71fe-3fdc-8fd8-84013ac54b3e",
                                "text": "„Das gilt für Kap Verde, wo die Hauptstadt Praia boomt, aber Städtchen wie Ribeira da Barca verarmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
