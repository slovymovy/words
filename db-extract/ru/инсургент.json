                "senses": [
                    {
                        "sense_id": "453250b2-65d5-31c1-b503-b02185026d6a",
                        "entry_id": "00669be3-5f02-33a4-a8de-7b8660f6800e",
                        "glosses": [
                            "устар. участник вооружённого восстания; повстанец"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae479307-f866-4bc3-8b0d-4fe5b6cf5a35",
                                "sense_id": "453250b2-65d5-31c1-b503-b02185026d6a",
                                "text": "Что вам стоит одним махом пера убить наповал несколько десятков тысяч турок или американских инсургентов?"
                            },
                            {
                                "example_id": "6275c83d-46c7-449b-9b57-7c2adcee1bab",
                                "sense_id": "453250b2-65d5-31c1-b503-b02185026d6a",
                                "text": "Напрасно вожди инсургентов собирали толпу, напрасно с яростью многократно бросались на чугунные чудовища Наполеона, — всюду картечь опрокидывала их и возвращала вспять."
                            }
                        ]
                    }
