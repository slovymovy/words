                                        "entry_id": "88e54685-0541-351d-a0f6-b4ce0c969c5d",
                                        "glosses": [
                                            "Pertaining to mirrors; mirror-like, reflective."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdd7aeeb-a964-480e-a689-9a2fd8629923",
                                                "sense_id": "5beb338d-e7d1-3376-984a-8d1d16fabdf6",
                                                "text": "a perfect likeness would rather suggest a specular, and hence speculatory, phenomenon [...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e1c8461-84dc-3104-b808-baf5d6cc74cf",
                                        "entry_id": "88e54685-0541-351d-a0f6-b4ce0c969c5d",
                                        "glosses": [
                                            "Of or relating to a speculum; conducted with the aid of a speculum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5682a8f-1415-4d99-b31f-1c7dfa78b231",
                                                "sense_id": "4e1c8461-84dc-3104-b808-baf5d6cc74cf",
                                                "text": "a specular examination"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fd1fcbc-1315-3b7f-9d83-a9572f9ff4ac",
                                        "entry_id": "88e54685-0541-351d-a0f6-b4ce0c969c5d",
                                        "glosses": [
                                            "Assisting sight, like a lens etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aeb0e8c5-bb54-4412-8e6a-66ac585d4547",
                                                "sense_id": "8fd1fcbc-1315-3b7f-9d83-a9572f9ff4ac",
                                                "text": "Thy specular orb / Apply to well-dissected kernels; lo! / In each observe the slender threads / Of first-beginning trees."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89dd6f3b-a429-3ea4-8b4c-8d0003a4910a",
                                        "entry_id": "88e54685-0541-351d-a0f6-b4ce0c969c5d",
                                        "glosses": [
                                            "Offering an expansive view; picturesque."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df828d35-15d7-477e-ac83-5c4ce626f6db",
                                                "sense_id": "89dd6f3b-a429-3ea4-8b4c-8d0003a4910a",
                                                "text": "Calm as the Universe, from specular towers / Of heaven contemplated by Spirits pure."
                                            },
                                            {
                                                "example_id": "ba3206c3-ff5a-40c2-9519-a8ccef2d2b6f",
                                                "sense_id": "89dd6f3b-a429-3ea4-8b4c-8d0003a4910a",
                                                "text": "Look once more, e're we leave this specular mount."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
