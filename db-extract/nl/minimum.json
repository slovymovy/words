                "translations": [
                    {
                        "translation_id": "b7d94661-705d-40fa-9ef1-2979405ac4b6",
                        "source_entry_id": "4ddba286-e5f2-347e-9a16-ddc0a3652d2a",
                        "source_sense_id": "a79f410e-559b-3fce-9dab-d93aaf024986",
                        "source_sense_description": "kleinst mogelijke hoeveelheid",
                        "target_lang_word": "Minimum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Minimum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7db9167b-c3bd-30dc-a68e-dc8ef76df8ee",
                                        "entry_id": "aac205b2-5829-33ba-b657-e8242fa3d7fd",
                                        "glosses": [
                                            "der kleinste Anteil, das kleinste Maß"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5915f7a5-fb9e-4df4-84c5-8b7f09e691f4",
                                                "sense_id": "7db9167b-c3bd-30dc-a68e-dc8ef76df8ee",
                                                "text": "Der Umsatz sank auf ein Minimum."
                                            },
                                            {
                                                "example_id": "884516b9-f750-4573-bb8f-dbdadef8e751",
                                                "sense_id": "7db9167b-c3bd-30dc-a68e-dc8ef76df8ee",
                                                "text": "Du könntest mal ein Minimum an Rücksicht an den Tag legen."
                                            },
                                            {
                                                "example_id": "c2d11ed2-8b13-4f2c-89a6-422b3b086711",
                                                "sense_id": "7db9167b-c3bd-30dc-a68e-dc8ef76df8ee",
                                                "text": "Wir konnten nur ein Minimum an Lebensmitteln mitnehmen."
                                            },
                                            {
                                                "example_id": "c1c4e912-9361-4208-98b5-96ad9cf13d70",
                                                "sense_id": "7db9167b-c3bd-30dc-a68e-dc8ef76df8ee",
                                                "text": "„Die Bedürfnisse von Janoschs Helden sind auf ein Minimum eingestellt, oft reduziert auf rein biologische Funktionen.“"
                                            },
                                            {
                                                "example_id": "20fc2497-77f9-4f6b-876e-0ccdce9cdf98",
                                                "sense_id": "7db9167b-c3bd-30dc-a68e-dc8ef76df8ee",
                                                "text": "„Da ein lokales Minimum […] auch ein globales Minimum ist, berechnet das Simplex-Verfahren ausgehend von einem ersten zulässigen Punkt schrittweise weitere zulässige Punkte mit von Schritt zu Schritt abnehmenden Zielfunktionswerten und dadurch, im Falle eines existierenden Minimums, nach endlich vielen Schritten ein Minimum.“"
                                            },
                                            {
                                                "example_id": "899c7e72-ccc5-4f73-82f9-6d997f4b7090",
                                                "sense_id": "7db9167b-c3bd-30dc-a68e-dc8ef76df8ee",
                                                "text": "„Alkohol in jeder Form schien ihn allzu sehr anzugreifen und schließlich zu vergiften, und ich nahm mir vor, am nächsten Tag das Trinken auf ein Minimum zu beschränken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be45fead-c357-4000-bfe5-a284b77459b0",
                        "source_entry_id": "4ddba286-e5f2-347e-9a16-ddc0a3652d2a",
                        "source_sense_id": "a79f410e-559b-3fce-9dab-d93aaf024986",
