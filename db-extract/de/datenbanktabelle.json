                                        "examples": [
                                            {
                                                "example_id": "eeef7188-0997-4d37-a4c8-590c6ae66c0c",
                                                "sense_id": "bcbe157c-2cb2-3a83-9f49-96636c02cbca",
                                                "text": "'April 13 1638, Henry Wotton, letter to John Milton\nAt Siena I was tabled in the house of one Alberto Scipioni"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "522abbd4-1db1-3e69-b311-59440d2f1980",
                                        "entry_id": "f5daabfb-fd57-37a0-954e-59af680b3440",
                                        "glosses": [
                                            "To delineate; to represent, as in a picture; to depict."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad4d475d-b1ca-40c3-a80a-fd04949aa051",
                                                "sense_id": "522abbd4-1db1-3e69-b311-59440d2f1980",
                                                "text": "c. 1607, Francis Bacon, letter to Tobie Matthew\ntabled and pictured in the chambers of meditation"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df915c4e-c299-34ab-ab38-06383392d86a",
                                        "entry_id": "f5daabfb-fd57-37a0-954e-59af680b3440",
                                        "glosses": [
                                            "To put on the table of a commission or legislative assembly; to propose for formal discussion or consideration, to put on the agenda."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "956ca129-5508-498e-931d-84c4976efd51",
                                                "sense_id": "df915c4e-c299-34ab-ab38-06383392d86a",
                                                "text": "In a raucous Commons, the Labour leader, Jeremy Corbyn, confirmed he had tabled a formal motion of confidence in the government, backed by other opposition leaders, which MPs would vote on on Wednesday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3806ae2c-863c-3ac4-be46-3ebd64d9bb4f",
                                        "entry_id": "f5daabfb-fd57-37a0-954e-59af680b3440",
                                        "glosses": [
                                            "To remove from the agenda, to postpone dealing with; to shelve (to indefinitely postpone consideration or discussion of something)."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b41dda3d-316a-4cd5-9832-cc183b45655d",
                                                "sense_id": "3806ae2c-863c-3ac4-be46-3ebd64d9bb4f",
                                                "text": "The legislature tabled the amendment, so they will not be discussing it until later."
                                            },
                                            {
                                                "example_id": "b273fe9c-db81-4d0f-9680-a5708c90ed6b",
                                                "sense_id": "3806ae2c-863c-3ac4-be46-3ebd64d9bb4f",
                                                "text": "The motion was tabled, ensuring that it would not be taken up until a later date."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80977e66-855f-36e3-ac30-634d6ee531cc",
                                        "entry_id": "f5daabfb-fd57-37a0-954e-59af680b3440",
                                        "glosses": [
                                            "To represent a company or organization (at an exposition, fair, etc.), usually at a booth or display."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "043f3336-5101-3cb7-aca2-3cf32bd7fe4a",
                                        "entry_id": "f5daabfb-fd57-37a0-954e-59af680b3440",
                                        "glosses": [
                                            "To join (pieces of timber) together using coaks."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1fef2ae0-f326-31d4-83b9-087d8b607ad6",
                                        "entry_id": "f5daabfb-fd57-37a0-954e-59af680b3440",
                                        "glosses": [
                                            "To put on a table."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e56e157a-869c-4216-a20e-c167e4f07499",
                                                "sense_id": "1fef2ae0-f326-31d4-83b9-087d8b607ad6",
                                                "text": "1833 Thomas Carlyle, letter to his Mother, The Correspondence of Thomas Carlyle and Ralph Waldo Emerson\n[A]fter some clatter offered us a rent of five pounds for the right to shoot here, and even tabled the cash that moment, and would not pocket it again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d55ff2ea-05b6-3855-96ca-2f7e2ac65a1e",
                                        "entry_id": "f5daabfb-fd57-37a0-954e-59af680b3440",
                                        "glosses": [
                                            "To show one's cards face-up, especially during showdown."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "01fead4f-c920-3a02-a261-50defbacff96",
                                        "entry_id": "f5daabfb-fd57-37a0-954e-59af680b3440",
                                        "glosses": [
                                            "To make board hems in the skirts and bottoms of (sails) in order to strengthen them in the part attached to the bolt-rope."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
