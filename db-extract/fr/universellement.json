        "fr-extract.jsonl": [
            {
                "entry_id": "1af366fb-04eb-34c4-aa95-880d0743b90b",
                "word": "universellement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e97eebc1-44de-3bfd-bf42-17b118a27e64",
                        "entry_id": "1af366fb-04eb-34c4-aa95-880d0743b90b",
                        "glosses": [
                            "D’une manière universelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "192cfb7d-74b9-4586-8d92-487d8bc0a3be",
                                "sense_id": "e97eebc1-44de-3bfd-bf42-17b118a27e64",
                                "text": "Le procédé du décilage a été imaginé par Ed. Claparède et adopté universellement."
                            },
                            {
                                "example_id": "748557c8-0e26-470b-b393-004e7056c7b3",
                                "sense_id": "e97eebc1-44de-3bfd-bf42-17b118a27e64",
                                "text": "Il [Juste Lipse] a été universellement estimé, et son grand mérite le fit désirer du feu roi Henri le Grand,"
                            },
                            {
                                "example_id": "aa072005-0e9d-449b-be0f-70bd67d53f02",
                                "sense_id": "e97eebc1-44de-3bfd-bf42-17b118a27e64",
                                "text": "Dieu…. qui a gardé la famille de Noé sur un bois fragile contre la fureur inévitable des eaux universellement débordées,"
                            },
                            {
                                "example_id": "06e96875-a5d5-4a5b-84ec-e039d0f8b45e",
                                "sense_id": "e97eebc1-44de-3bfd-bf42-17b118a27e64",
                                "text": "Madame la comtesse de Sérizy […] dictait des arrêts, qui, reçus dans le cercle où elle régnait, lui semblaient universellement adoptés ; […]."
                            },
                            {
                                "example_id": "675095fc-4605-454d-859a-faaad8f6b310",
                                "sense_id": "e97eebc1-44de-3bfd-bf42-17b118a27e64",
                                "text": "[…], mais c'est au Bombyx du mûrier que l'on attribue spécialement la production de soie telle qu'elle est universellement employée."
                            },
                            {
                                "example_id": "61092925-71de-4a13-999f-10dc5bd0cd4b",
                                "sense_id": "e97eebc1-44de-3bfd-bf42-17b118a27e64",
                                "text": "Le curé de Melotte était donc encore universellement aimé et respecté : n’était-il pas un des plus vieux du village et des plus anciens de la paroisse !"
                            }
                        ]
                    },
                    {
                        "sense_id": "acdc457a-d487-3738-b824-9cf2ce9f0f6e",
                        "entry_id": "1af366fb-04eb-34c4-aa95-880d0743b90b",
                        "glosses": [
                            "En embrassant un genre, une classe ou toute chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26900cae-499c-4621-b68b-19073467702b",
                                "sense_id": "acdc457a-d487-3738-b824-9cf2ce9f0f6e",
                                "text": "Les termes ne doivent pas être pris plus universellement dans la conclusion, qu’ils ne l’ont été dans les prémisses,"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db988e5c-430a-4697-a7b3-cab2400c3902",
                        "source_entry_id": "1af366fb-04eb-34c4-aa95-880d0743b90b",
                        "target_lang_word": "comprehensively",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comprehensively",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01d2eb43-0c13-3b17-9d01-e958f7d35b38",
                                        "entry_id": "71ace61e-2d53-3c44-ac69-5b9c198e4c7f",
                                        "glosses": [
                                            "In a comprehensive manner; in an all-inclusive or wide-ranging fashion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "579cf5d0-a5c5-4e63-9c21-52e6ab4240d9",
                                                "sense_id": "01d2eb43-0c13-3b17-9d01-e958f7d35b38",
                                                "text": "Ferguson, perhaps recalling how United had been comprehensively outfought in the 3-1 defeat at Liverpool last season, opted for a side with a more pragmatic look with Phil Jones moved into a midfield role."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e30c6e13-fb2c-47a6-aabd-0eafffecf2e6",
                        "source_entry_id": "1af366fb-04eb-34c4-aa95-880d0743b90b",
                        "target_lang_word": "universally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "universally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9f72c94-c08d-33bf-930f-440daf914a0f",
                                        "entry_id": "0ef9f812-83aa-3c43-bbfd-b3f92250ded3",
                                        "glosses": [
                                            "In a universal manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "246344bb-b622-420a-a853-e265631ac701",
                                                "sense_id": "d9f72c94-c08d-33bf-930f-440daf914a0f",
                                                "text": "My experience of the people was that they were universally polite, civil, and clean, and during the whole time I spent in the country, I only saw one drunken man."
                                            },
                                            {
                                                "example_id": "2d0a01f2-3188-470b-81c9-4de3e1c939b4",
                                                "sense_id": "d9f72c94-c08d-33bf-930f-440daf914a0f",
                                                "text": "If successful, Edison and Ford—in 1914—would move society away from the ever more expensive and then universally known killing hazards of gasoline cars: […] ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0252eba3-1c1a-339b-a601-375f661c61f8",
                                        "entry_id": "0ef9f812-83aa-3c43-bbfd-b3f92250ded3",
                                        "glosses": [
                                            "By everyone or by the vast majority of people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10ee8142-eca6-45c8-adc2-22fe962a7750",
                                                "sense_id": "0252eba3-1c1a-339b-a601-375f661c61f8",
                                                "text": "The movie was universally praised by its audience."
                                            },
                                            {
                                                "example_id": "c6598b29-01ff-4aad-82c7-28912e531725",
                                                "sense_id": "0252eba3-1c1a-339b-a601-375f661c61f8",
                                                "text": "It is a truth universally acknowledged, that a single man in possession of a good fortune, must be in want of a wife."
                                            },
                                            {
                                                "example_id": "6a75743a-eb32-4559-a395-cb6c641f6bf0",
                                                "sense_id": "0252eba3-1c1a-339b-a601-375f661c61f8",
                                                "text": "Each written word when spoken is mutually incomprehensible between a Mandarin speaker in Beijing and a Cantonese speaker in Hong Kong. If you think that’s odd, consider our number system: the symbol “9” is universally recognized but it’s pronounced “nine” in English and “devet” in Slovenian."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25782d71-777a-4c5f-802d-1ad6690cc6d8",
                        "source_entry_id": "1af366fb-04eb-34c4-aa95-880d0743b90b",
