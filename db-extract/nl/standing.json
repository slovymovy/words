                                        "sense_id": "3419f0ec-635f-3479-a53c-29ff9a3e5fa1",
                                        "entry_id": "2494892e-6be8-3c64-8794-610b49a9b0c7",
                                        "glosses": [
                                            "Position or reputation in society or a profession."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbfaf495-1afe-4bd2-a866-d7b4263496ca",
                                                "sense_id": "3419f0ec-635f-3479-a53c-29ff9a3e5fa1",
                                                "text": "He does not have much of a standing as a chemist."
                                            },
                                            {
                                                "example_id": "07b9ac21-9014-4b0c-8bd5-80d86cce1a4d",
                                                "sense_id": "3419f0ec-635f-3479-a53c-29ff9a3e5fa1",
                                                "text": "The males constantly test their standing, looking to move up in the hierarchy."
                                            },
                                            {
                                                "example_id": "da9f2406-7289-4796-bffb-5f2344a505fd",
                                                "sense_id": "3419f0ec-635f-3479-a53c-29ff9a3e5fa1",
                                                "text": "The Russian president has given a series of public addresses this week in a bid to repair his public standing, and portray Wagner’s march on Moscow as a moment that unified Russia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f42d2d43-c54c-32dd-bea3-9cacb7787e8a",
                                        "entry_id": "2494892e-6be8-3c64-8794-610b49a9b0c7",
                                        "glosses": [
                                            "Duration."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a59604a-80b6-4182-b69b-d504a8a63df0",
                                                "sense_id": "f42d2d43-c54c-32dd-bea3-9cacb7787e8a",
                                                "text": "a member of long standing"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1c2a882-707e-3afc-86ed-24c0658c0599",
                                        "entry_id": "2494892e-6be8-3c64-8794-610b49a9b0c7",
                                        "glosses": [
                                            "The act of a person who stands, or a place where someone stands."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d309189-f0c3-458b-9c52-45f839696d29",
                                                "sense_id": "a1c2a882-707e-3afc-86ed-24c0658c0599",
                                                "text": "Tech[elles]. I heare them come, ſhall wee encounter them?\nTam[burlaine]. Keep all your ſtandings, and not ſtir a foot,\nMyſelfe will bide the danger of the brunt."
                                            },
                                            {
                                                "example_id": "dfb9bb4c-3cfd-4d14-a812-fbf466f4f91c",
                                                "sense_id": "a1c2a882-707e-3afc-86ed-24c0658c0599",
                                                "text": "I sinke in deepe mire, where there is no standing: I am come into deepe waters, where the flouds ouerflow me."
                                            },
                                            {
                                                "example_id": "f310159e-99e4-4cbe-834f-df7cef659362",
                                                "sense_id": "a1c2a882-707e-3afc-86ed-24c0658c0599",
                                                "text": "I will provide you and your fellows of a good standing to see his entry"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "117a8051-1f10-3789-9f9d-24efda503347",
                                        "entry_id": "2494892e-6be8-3c64-8794-610b49a9b0c7",
                                        "glosses": [
                                            "The position of a team in a league or of a player in a list."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e81fe125-f705-4f76-a1bb-901148d947fa",
                                                "sense_id": "117a8051-1f10-3789-9f9d-24efda503347",
                                                "text": "After their last win, their standing went up three places."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a88aadc-7447-3087-bdad-02a246c2ca0b",
                                        "entry_id": "2494892e-6be8-3c64-8794-610b49a9b0c7",
                                        "glosses": [
                                            "Room in which to park a vehicle or vehicles"
                                        ],
                                        "tags": [
                                            "British",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5b28447-ce67-442e-9bfa-f41d35a46bf2",
                                                "sense_id": "5a88aadc-7447-3087-bdad-02a246c2ca0b",
                                                "text": "\"There was no garage at Lathbury Road, but we had standing for two cars in front of the house.\""
                                            },
                                            {
                                                "example_id": "8dacc42e-b920-4bff-b558-82ed397ca1af",
                                                "sense_id": "5a88aadc-7447-3087-bdad-02a246c2ca0b",
                                                "text": "\"The engineering crisis boiled down to roads, hard standing, and waste.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7119a0d1-e29e-32d8-96c1-8edaa370c714",
                                        "entry_id": "2494892e-6be8-3c64-8794-610b49a9b0c7",
                                        "glosses": [
                                            "The right of a party to bring a legal action, based on the relationship between that party and the matter to which the action relates."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b44140d-0c9f-48a3-98b5-df92cb423e24",
                                                "sense_id": "7119a0d1-e29e-32d8-96c1-8edaa370c714",
                                                "text": "He may be insulting, a miserable rotter and a fool, but unless he slanders or libels you, or damages your property, you do not have standing to sue him."
                                            },
                                            {
                                                "example_id": "d669fe06-244d-46eb-91c1-b02db2f0c82e",
                                                "sense_id": "7119a0d1-e29e-32d8-96c1-8edaa370c714",
                                                "text": "to have standing"
                                            },
                                            {
                                                "example_id": "66bc4433-8f3c-4695-81da-77376e95c7b5",
                                                "sense_id": "7119a0d1-e29e-32d8-96c1-8edaa370c714",
                                                "text": "Lambda Legal Defense and Education Fund and the NGTF Fund for Human Dignity retained Erie attorney James E. Marsh, Jr. to argue the case. Boston's Gay and Lesbian Advocates and Defenders (GLAD) also sought standing with the court in a memorandum of law prepared by Sandra L. Smales with Stephen Ansolabehere and Gary Buseck."
                                            },
                                            {
                                                "example_id": "7ac749bc-21f1-40df-95ec-ee83766a472c",
                                                "sense_id": "7119a0d1-e29e-32d8-96c1-8edaa370c714",
                                                "text": "Legal experts noted earlier this week that while Epps will have to prove that Carlson’s claims damaged his reputation, he presents a strong argument and therefore likely has standing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cab52fc8-de67-3797-b6db-fce11476cd7f",
                                        "entry_id": "2494892e-6be8-3c64-8794-610b49a9b0c7",
                                        "glosses": [
                                            "The location on a street where a market trader habitually operates."
                                        ],
