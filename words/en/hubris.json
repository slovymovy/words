                    "sense_id": "2d10cdc0-b88e-30a5-b678-58c2f8ddf2e9",
                    "sense_definition": "Excessive pride, presumption, or arrogance.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "pride",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The CEO's <w>hubris</w> led him to ignore the warnings about the company's financial instability.",
                            "target_lang_translations": {
                                "de": "Die <w>Hybris</w> des Geschäftsführers führte dazu, dass er die Warnungen vor der finanziellen Instabilität des Unternehmens ignorierte."
                            }
                        },
                        {
                            "text": "His <w>hubris</w> was his downfall, as he believed he was above the law.",
                            "target_lang_translations": {
                                "de": "Seine <w>Überheblichkeit</w> wurde ihm zum Verhängnis, da er glaubte, über dem Gesetz zu stehen."
                            }
                        }
                    ],
                    "synonyms": [
                        "arrogance",
                        "conceit",
                        "presumption"
                    ],
                    "antonyms": [
                        "humility",
                        "modesty"
                    ],
                    "target_lang_definitions": {
                        "de": "Übermäßiger Stolz, Anmaßung oder Arroganz."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Hybris",
                                "target_lang_sense_clarification": "Bezeichnet ein maßloses, oft realitätsfernes Selbstvertrauen, das häufig zu einem tragischen Scheitern führt."
                            },
                            {
                                "target_lang_word": "Überheblichkeit",
                                "target_lang_sense_clarification": "Beschreibt eine ungerechtfertigte Selbstüberschätzung und eine herablassende Haltung gegenüber anderen."
                            },
                            {
                                "target_lang_word": "Hochmut",
                                "target_lang_sense_clarification": "Eine tief verwurzelte, oft moralisch negativ bewertete Form der Arroganz und Selbstüberhöhung."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}