                        ],
                        "examples": [
                            {
                                "example_id": "af7f623f-7fdc-4ed9-a0cb-8df15945a588",
                                "sense_id": "2621e557-1c66-3066-99de-45d634647de3",
                                "text": "There’s a good 20 million or so Clashers in the world (there or thereabouts), including Liam Neeson."
                            },
                            {
                                "example_id": "ee62d91b-3de4-4737-b3c0-3e7229809543",
                                "sense_id": "2621e557-1c66-3066-99de-45d634647de3",
                                "text": "After two months of five intense Clash of Clans (CoC) battles around the country, Globe Telecom rounded up the champion clashers from Manila, La Union, Cavite, Cebu, and Davao for the recently held #NextLevelKa Clash of Clans Ultimate Clash."
                            },
                            {
                                "example_id": "3a128834-8174-4faa-b568-8209aa75f3da",
                                "sense_id": "2621e557-1c66-3066-99de-45d634647de3",
                                "text": "The first ever biggest nationwide #NextLevelKa Clash of Clans tournament brought together the country’s top clashers and gaming enthusiasts for the two-day competition."
                            },
                            {
                                "example_id": "6037b9eb-a30f-4c63-aa40-2dd461b1a8fa",
                                "sense_id": "2621e557-1c66-3066-99de-45d634647de3",
                                "text": "Fear not, fellow clashers! While the exact event details haven't been disclosed, we've still got a pretty solid idea of what to expect from the promotion."
                            }
                        ]
