                        "glosses": [
                            "แท่งไม้ปลายแหลมสำหรับทำรั้ว"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ce5a6dc-8cab-438f-9214-02d8f8fbc96b",
                                "sense_id": "e7027446-367d-3b28-aca0-fb068ce68185",
                                "text": "The boys continued hitting the tennis ball with pailings snatched from a fence […]"
                            },
                            {
                                "example_id": "6ed7b83d-b839-498e-a214-3f4c2ccd79c6",
                                "sense_id": "e7027446-367d-3b28-aca0-fb068ce68185",
                                "text": "The smell of the damp eucalypt palings that clad the walls exhaling their aromatic resin into the house, mingling with the fragrance of the myrtle burning in the fireplace."
                            }
                        ]
                    },
                    {
                        "sense_id": "84ef423f-7074-3289-8202-7eae6a5a75fd",
                        "entry_id": "572aace3-1f6f-3f44-8fe9-b885c798d87f",
