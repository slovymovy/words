                        "source_sense_description": "hochbeiniger Stuhl in Lokalen an der Theke (= Bar) oder hohen Tischen",
                        "target_lang_word": "bar chair",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bar chair",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "793b7a43-d0d8-362c-a4f3-cafdf0806599",
                                        "entry_id": "c1aa6667-306d-369b-850d-a0a827c8101f",
                                        "glosses": [
                                            "A tall chair-like seat usually having a foot rest, commonly placed in bars and in front of kitchen counters."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1682bfc6-c94d-4d1f-8dcf-edcfb3b0618e",
                                                "sense_id": "793b7a43-d0d8-362c-a4f3-cafdf0806599",
                                                "text": "Past the bar was a little area in an alcove that contained a few tall, round tables and bar chairs."
                                            },
                                            {
                                                "example_id": "8e671840-c520-48e0-8df5-c3d721c48777",
                                                "sense_id": "793b7a43-d0d8-362c-a4f3-cafdf0806599",
                                                "text": "He ordered a Corona, stretched and groaned as he lowered himself into a too small bar chair."
                                            },
                                            {
                                                "example_id": "2ee4b830-9083-4db4-aa37-e7c79435116c",
                                                "sense_id": "793b7a43-d0d8-362c-a4f3-cafdf0806599",
                                                "text": "Bar chairs were heavy with high backs that prevented many a drunk’s reverse gainer."
                                            },
                                            {
                                                "example_id": "6b01ec1c-8d42-4e7e-a590-41bebff95ac2",
                                                "sense_id": "793b7a43-d0d8-362c-a4f3-cafdf0806599",
                                                "text": "The door was guarded by a retired cop named Frankie the Golfer, who sat by the door in an upholstered bar chair that he leaned back against the wall."
                                            },
                                            {
                                                "example_id": "7fa408ae-fab4-4271-8cd5-224778249020",
                                                "sense_id": "793b7a43-d0d8-362c-a4f3-cafdf0806599",
                                                "text": "Roy pulled his bulk off the bar chair. Joe held it for Megan, who had to step onto the bar rail to lift herself onto the chair."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16c55148-6a91-4c70-aede-9cc745b45d73",
                        "source_entry_id": "8f68920a-92d3-3383-82c3-b96333f3525c",
