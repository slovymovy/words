                                                "sense_id": "40ed65f4-f16f-3a26-b004-c07388ef81bc",
                                                "text": "He forgot his car keys upstairs."
                                            },
                                            {
                                                "example_id": "24f1ef70-17e0-4b95-8deb-016b865f9ae9",
                                                "sense_id": "40ed65f4-f16f-3a26-b004-c07388ef81bc",
                                                "text": "I back up against the double sink, rooting in my purse for my car keys."
                                            }
