            "pos": "noun",
            "senses": [
                {
                    "sense_id": "615a705a-b7a4-309f-b407-660d148201e7",
                    "sense_definition": "Femme adulte, que l'on désigne avec politesse.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "femme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une <w>dame</w> très gentille m'a aidé à porter ma valise dans le train."
                        },
                        {
                            "text": "La <w>dame</w> du guichet m'a expliqué comment acheter un billet."
                        },
                        {
                            "text": "Cette vieille <w>dame</w> habite seule au deuxième étage de notre immeuble."
                        }
                    ],
                    "common_phrases": [
                        "une vieille dame",
                        "une dame âgée",
                        "une jeune dame"
                    ]
                },
                {
                    "sense_id": "146d7974-a2c8-327a-a7d9-13d5d5695c78",
                    "sense_definition": "Au pluriel, jeu de société pour deux joueurs, qui se joue avec des pions sur un damier.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "jeux",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le dimanche, mon grand-père joue aux <w>dames</w> avec moi dans le jardin."
                        },
                        {
                            "text": "Nous avons fait une partie de <w>dames</w> pendant que la pluie tombait dehors."
                        }
