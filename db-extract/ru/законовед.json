                    }
                ],
                "translations": [
                    {
                        "translation_id": "06b54f41-16ad-4b43-a2d1-c631cc7db508",
                        "source_entry_id": "3c68f097-36c9-32d2-9021-7bfe678fb15d",
                        "source_sense_id": "b9e270cb-9b43-3ff0-ab6b-f5b23893774e",
                        "target_lang_word": "lawyer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lawyer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aa24c1f2-8943-3dbb-b27d-17b1f91cc9e6",
                                        "entry_id": "fae9bf20-67a6-35f7-bd40-f8d543926622",
                                        "glosses": [
                                            "A professional person with a graduate law degree that qualifies for legal work (such as Juris Doctor)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3515212e-6050-302e-81e4-a2125de1887f",
                                        "entry_id": "fae9bf20-67a6-35f7-bd40-f8d543926622",
                                        "glosses": [
                                            "A professional person qualified (as by a law degree or bar exam) and authorized to practice law as an attorney-at-law, solicitor, advocate, barrister or equivalent, i.e. represent parties in lawsuits or trials and give legal advice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf793a1f-50fc-4e08-b0bd-6a67b291aacb",
                                                "sense_id": "3515212e-6050-302e-81e4-a2125de1887f",
                                                "text": "His forefathers had been, as a rule, professional men—physicians and lawyers; his grandfather died under the walls of Chapultepec Castle while twisting a tourniquet for a cursing dragoon; an uncle remained indefinitely at Malvern Hill;[…]."
                                            },
                                            {
                                                "example_id": "580e9ac6-3b6f-4123-a246-ca1326efce80",
                                                "sense_id": "3515212e-6050-302e-81e4-a2125de1887f",
                                                "text": "Mr. Wells was a pleasant man of middle-age, with keen eyes, and the typical lawyer’s mouth."
                                            },
                                            {
                                                "example_id": "2d54dbe5-7b93-415d-9853-d9376f578b84",
                                                "sense_id": "3515212e-6050-302e-81e4-a2125de1887f",
                                                "text": "A lawyer's time and advice are his stock in trade. - aphorism often credited to Abraham Lincoln, but without attestation"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "029e6592-1f32-3723-83c6-f9c032db1260",
                                        "entry_id": "fae9bf20-67a6-35f7-bd40-f8d543926622",
                                        "glosses": [
                                            "A legal layman who argues points of law."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bb33ca35-23ba-3efc-9be2-16be870b8c06",
                                        "entry_id": "fae9bf20-67a6-35f7-bd40-f8d543926622",
                                        "glosses": [
                                            "The burbot."
                                        ],
                                        "tags": [
                                            "UK",
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b587d666-11ff-3528-836d-43016f29eae7",
                                        "entry_id": "fae9bf20-67a6-35f7-bd40-f8d543926622",
                                        "glosses": [
                                            "The stem of a bramble."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dialectal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "307054fd-39c7-39ca-8672-e1b4f4421e1d",
                                        "entry_id": "fae9bf20-67a6-35f7-bd40-f8d543926622",
                                        "glosses": [
                                            "Any of various plants that have hooked thorns.",
                                            "A relative of the raspberry found in Australia and New Zealand, Rubus australis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b55da88b-d57c-4670-a43b-4b4c109d8815",
                                                "sense_id": "307054fd-39c7-39ca-8672-e1b4f4421e1d",
                                                "text": "The species of Eugnomus are very partial to the lawyer (Rubus australis ) when in bloom."
                                            },
                                            {
                                                "example_id": "c2d54302-5c67-4bf8-8131-ddf7b1687c33",
                                                "sense_id": "307054fd-39c7-39ca-8672-e1b4f4421e1d",
                                                "text": "In the lawyer (Rubus australis) a considerable differentiation has taken place. All the alllies of this plant (such as the true roses, brambles, rasps, &c.), exhibit a strong development of epidermal structures in the form of hooks, spines, or hairs, but in none are these structures so perfect as in our lawyer."
                                            },
                                            {
                                                "example_id": "fada63de-ca65-427c-8d04-c7273576dc7d",
                                                "sense_id": "307054fd-39c7-39ca-8672-e1b4f4421e1d",
                                                "text": "A plant that is excessively troublesome in the localities where the native vegetation has been least disturbed is the “lawyer” (Rubus australis)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b2adaaf-8fbc-3c91-a53f-60abea232222",
                                        "entry_id": "fae9bf20-67a6-35f7-bd40-f8d543926622",
                                        "glosses": [
                                            "Any of various plants that have hooked thorns.",
                                            "Various species of Calamus, including Calamus australis, Calamus muelleri, Calamus obstruens, Calamus vitiensis, Calamus warburgii, and Calamus moti."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02184a2a-97c0-4b44-8d05-f2fd0c892684",
                                                "sense_id": "2b2adaaf-8fbc-3c91-a53f-60abea232222",
                                                "text": "Besides the bags and nets common throughout the continent, these tribes have water-bags, which they make of closely-plaited “lawyer” (Calamus Australis), and also of palm-leaf sewn with the sinews of animals."
                                            },
                                            {
                                                "example_id": "aa386e13-33e0-44c7-bcc4-370fcfafda8e",
                                                "sense_id": "2b2adaaf-8fbc-3c91-a53f-60abea232222",
                                                "text": "The nest was a foot or two from the ground, and placed in a bunch of lawyer (Calamus ) canes."
                                            },
                                            {
                                                "example_id": "2bc9760b-33b7-4130-9b00-ef68587baef5",
                                                "sense_id": "2b2adaaf-8fbc-3c91-a53f-60abea232222",
                                                "text": "This lawyer (Calamus australis) is a climbing palm, throwing up shoots from its roots as thick as a man's finger and tough as wire, covered with sharp spines, and bearing much divided leaves, alternating with tendrils twenty feel long."
                                            },
                                            {
                                                "example_id": "e4ed2732-fb4a-4b75-9793-233e7134414d",
                                                "sense_id": "2b2adaaf-8fbc-3c91-a53f-60abea232222",
                                                "text": "They were usually very neatly laid out under arching masses of the exasperating lawyer-palm vines ( Calamus moti and C. australis ), and consequently not too easy to examine."
                                            },
                                            {
                                                "example_id": "4b2b0361-c6be-48b8-b5d2-a00d4ba07f39",
                                                "sense_id": "2b2adaaf-8fbc-3c91-a53f-60abea232222",
                                                "text": "Lawyer Vine (Calamus muelleri), also known as Hairy Mary and Wait-a-while, is actually a palm, that grows in long canes that loop and snake through the undergrowth."
                                            },
                                            {
                                                "example_id": "c0e28164-31b3-4824-98de-d02c694d1950",
                                                "sense_id": "2b2adaaf-8fbc-3c91-a53f-60abea232222",
                                                "text": "The trail of the lawyer vine (CALAMUS OBSTRUENS), with its leaf sheath and long tentacles bristling with incurved hooks, is over it all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c884c745-04ee-396d-8c73-62cbe9d18ff6",
                                        "entry_id": "fae9bf20-67a6-35f7-bd40-f8d543926622",
                                        "glosses": [
                                            "Any of various plants that have hooked thorns.",
                                            "A woody climbing rainforest vine, Flagellaria indica."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84dcb89d-71f1-44b5-b53d-56658c7797a4",
                                                "sense_id": "c884c745-04ee-396d-8c73-62cbe9d18ff6",
                                                "text": "The stems of the \"lawyer vine\" (Flagellaria indica), buz or buzi (W.), boz (E.), are used in house-building, tying fences, etc."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lawyer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e2af8c1-9007-3a27-a7af-d599c8e6ef02",
                                        "entry_id": "eb103e53-db05-3ad7-8a41-bd362f0b3052",
                                        "glosses": [
                                            "To practice law."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4e6d9888-6323-312d-9068-47d8e4e41fc8",
                                        "entry_id": "eb103e53-db05-3ad7-8a41-bd362f0b3052",
                                        "glosses": [
                                            "To perform, or attempt to perform, the work of a lawyer."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7cde3ee1-5a94-36c3-b9c8-1e7525c955b0",
                                        "entry_id": "eb103e53-db05-3ad7-8a41-bd362f0b3052",
                                        "glosses": [
                                            "To make legalistic arguments."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8b86bebc-a59d-3f00-be9b-9ebb2301382b",
                                        "entry_id": "eb103e53-db05-3ad7-8a41-bd362f0b3052",
                                        "glosses": [
                                            "To barrage (a person) with questions in order to get them to admit something."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1feecf9-d173-4425-ac4f-79ef8b444b6a",
                                                "sense_id": "8b86bebc-a59d-3f00-be9b-9ebb2301382b",
                                                "text": "You've been lawyered!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8aed3bd2-848f-4212-85c7-af49b903a3f2",
                        "source_entry_id": "3c68f097-36c9-32d2-9021-7bfe678fb15d",
                        "source_sense_id": "b9e270cb-9b43-3ff0-ab6b-f5b23893774e",
                        "target_lang_word": "légiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "légiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4cd21c5b-154c-3f7d-9910-4da54e550174",
                                        "entry_id": "e54ac4d5-d16f-3a3c-ac8d-372e48d605c8",
                                        "glosses": [
                                            "Celui qui est versé dans la connaissance et l’étude des lois."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "648b9a57-3549-419c-a7de-cc9d09bb2194",
                                                "sense_id": "4cd21c5b-154c-3f7d-9910-4da54e550174",
                                                "text": "Tous les légistes sont du même avis sur cette question."
                                            },
                                            {
                                                "example_id": "65235c1d-6475-4abc-937d-38bba5d35bf5",
                                                "sense_id": "4cd21c5b-154c-3f7d-9910-4da54e550174",
                                                "text": "Réduit à cette seule preuve, la vérité m’échappe, — et il n'y a pas un légiste qui ne fût fondé à contester l’existence matérielle de l’individu !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa5cf992-799e-3f7d-969a-0061d0845180",
                                        "entry_id": "e54ac4d5-d16f-3a3c-ac8d-372e48d605c8",
                                        "glosses": [
                                            "Juriste qui, en France, a soutenu et organisé l’autorité monarchique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73c11e87-73d4-4646-bfa8-2a57ea42e4d0",
                                                "sense_id": "fa5cf992-799e-3f7d-969a-0061d0845180",
                                                "text": "Philippe le Bel s’appuya sur les légistes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "802cb1cb-0ae4-353e-9371-b2c282204400",
                                        "entry_id": "e54ac4d5-d16f-3a3c-ac8d-372e48d605c8",
                                        "glosses": [
                                            "Médecin légiste."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d452ea2-72f1-4784-9c8a-644b7187456a",
                                                "sense_id": "802cb1cb-0ae4-353e-9371-b2c282204400",
                                                "text": "Le légiste reboutonna prestement son imperméable, avec une satisfaction visible."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
