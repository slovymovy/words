                "senses": [
                    {
                        "sense_id": "479987f4-5a54-3c0e-89ab-2d73a7ad5019",
                        "entry_id": "9e8ae0ae-f776-3ac9-8ab9-9dfc59a9e13b",
                        "glosses": [
                            "разг. начать шикать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c8a4657-d949-4593-a925-b67a02a1f5b5",
                                "sense_id": "479987f4-5a54-3c0e-89ab-2d73a7ad5019",
                                "text": "Многие зашумели, зашикали, затопали, ― это дошло до Петербурга."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8f36282-3626-4df5-a8cd-815b641c57f5",
                        "source_entry_id": "9e8ae0ae-f776-3ac9-8ab9-9dfc59a9e13b",
                        "source_sense_id": "479987f4-5a54-3c0e-89ab-2d73a7ad5019",
                        "target_lang_word": "shush",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shush",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11a21d3d-c5eb-3bce-a81b-737ea62e9a25",
                                        "entry_id": "a22dcd12-a461-3ea2-8d69-82323a9c27dd",
                                        "glosses": [
                                            "To be quiet; to keep quiet."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "onomatopoeic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78d3cc5d-d650-4ac9-8f3c-826f358404dd",
                                                "sense_id": "11a21d3d-c5eb-3bce-a81b-737ea62e9a25",
                                                "text": "He wouldn't shush so I kicked him."
                                            },
                                            {
                                                "example_id": "e1e152f8-378d-4beb-8f58-ee36ff3d25f8",
                                                "sense_id": "11a21d3d-c5eb-3bce-a81b-737ea62e9a25",
                                                "text": "Shush, my parents are back!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2628d626-7eb1-37b7-8f02-a1ace18e5b32",
                                        "entry_id": "a22dcd12-a461-3ea2-8d69-82323a9c27dd",
                                        "glosses": [
                                            "To ask someone to be quiet, especially by saying shh."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "onomatopoeic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98f4a0a9-9c1b-49dc-981c-a947367fe7fb",
                                                "sense_id": "2628d626-7eb1-37b7-8f02-a1ace18e5b32",
                                                "text": "The boy in front of us was making too much noise, so we shushed him."
                                            },
                                            {
                                                "example_id": "9d1e8340-1d5d-4c54-88ae-3a05d030dae0",
                                                "sense_id": "2628d626-7eb1-37b7-8f02-a1ace18e5b32",
                                                "text": "The sequence where Sam carves off Jorah’s infected tissue in secret, stopping every few moments to shush his patient, is presented as comic relief why? Jorah reels back into a diagonal close-up whimpering like a dog. Yellow pus oozes to get those good gross-out laughs. Is the substance of this operation funny to anyone on its face?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
