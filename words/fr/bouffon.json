                {
                    "sense_id": "b5c40204-0447-3470-b4a2-c043fc486c11",
                    "sense_definition": "Personne stupide, ridicule ou méprisable.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "insulte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Arrête de te comporter comme un <w>bouffon</w> devant tout le monde.",
                            "target_lang_translations": {
                                "en": "Stop behaving like a <w>buffoon</w> in front of everyone.",
                                "ru": "Перестань вести себя как <w>дурак</w> на глазах у всех.",
                                "de": "Hör auf, dich vor allen Leuten wie ein <w>Trottel</w> zu benehmen.",
                                "es": "Deja de comportarte como un <w>payaso</w> delante de todo el mundo.",
                                "zh": "别在大家面前表现得像个<w>傻瓜</w>一样了。"
                            }
                        },
                        {
                            "text": "Ne fais pas attention à cet individu, c'est juste un sale <w>bouffon</w>.",
                            "target_lang_translations": {
                                "en": "Don't pay any attention to that guy, he's just a nasty <w>buffoon</w>.",
                                "ru": "Не обращай внимания на этого типа, он просто паршивый <w>дурак</w>.",
                                "de": "Achte nicht auf diesen Typen, der ist nur ein mieser <w>Trottel</w>.",
                                "es": "No hagas caso a ese individuo, es solo un maldito <w>payaso</w>.",
                                "zh": "别理那个人，他不过是个讨厌的<w>蠢货</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "espèce de bouffon"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "terme péjoratif et familier"
                        }
                    ],
                    "target_lang_definitions": {
