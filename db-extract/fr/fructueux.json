                    {
                        "sense_id": "64822d42-a69d-3a12-91a7-fb653a4100b7",
                        "entry_id": "cc221613-32cc-3279-beb3-52d73a95cc5e",
                        "glosses": [
                            "Qui produit du fruit."
                        ],
                        "tags": [
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "20c997b0-4e45-4a37-a3f9-489c1b7ad7df",
                                "sense_id": "64822d42-a69d-3a12-91a7-fb653a4100b7",
                                "text": "Rameaux fructueux."
                            }
                        ]
                    },
                    {
                        "sense_id": "74a57558-1982-34f1-b97c-2cc27eb56afb",
                        "entry_id": "cc221613-32cc-3279-beb3-52d73a95cc5e",
                        "glosses": [
                            "Qui produit un effet ou un résultat avantageux."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "5efc9042-530a-452f-bfac-82c8bc6177a5",
                                "sense_id": "74a57558-1982-34f1-b97c-2cc27eb56afb",
                                "text": "Pendant tout ce mois d’août, ces expéditions furent très fructueuses, et le grenier aux provisions se remplit à vue d’œil."
                            },
                            {
                                "example_id": "3045f3f1-5e97-4487-8705-48d4e5012f34",
                                "sense_id": "74a57558-1982-34f1-b97c-2cc27eb56afb",
                                "text": "Au carrefour des années 1900, l’estuaire de la Gironde faisait partie des rares endroits où on pouvait trouver les esturgeons, localement appelés créac, en grande quantité. C’est spécifiquement au Saint-Seurin-d’Uzet (17), appelé capitale du caviar, que l’activité était la plus fructueuse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11b18e59-1670-4c8b-97b4-2d5c64a8658e",
                        "source_entry_id": "cc221613-32cc-3279-beb3-52d73a95cc5e",
                        "source_sense_id": "64822d42-a69d-3a12-91a7-fb653a4100b7",
                        "source_sense_description": "Qui produit du fruit",
                        "target_lang_word": "erfolgreich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erfolgreich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce603f78-aa53-3fa7-932c-c36e15482d09",
                                        "entry_id": "383a405a-2501-321f-a52e-42ca32361f17",
                                        "glosses": [
                                            "reich an Erfolgen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d7d4b8d-31e2-4c9e-84a2-52e7068aac4e",
                                                "sense_id": "ce603f78-aa53-3fa7-932c-c36e15482d09",
                                                "text": "Die Fußballmannschaft hatte ein erfolgreiches Spiel."
                                            },
                                            {
                                                "example_id": "71e9a4c2-5b31-42c1-8e76-6ada64a80b73",
                                                "sense_id": "ce603f78-aa53-3fa7-932c-c36e15482d09",
                                                "text": "Ein Mann ist erfolgreich, wenn er mehr verdient, als seine Frau ausgibt. Eine erfolgreiche Frau hat so einen Mann. (Volksmund)"
                                            },
                                            {
                                                "example_id": "3bd43304-8093-4e29-8dbc-ba1184198a1d",
                                                "sense_id": "ce603f78-aa53-3fa7-932c-c36e15482d09",
                                                "text": "„Sehen Sie sich Michel Houellebecq oder Stephen Hawking an, Männer, die alles andere als schön zu bezeichnen sind, und doch in der Liebe sehr erfolgreich waren, jüngere, gesündere und attraktivere Frauen anzogen, die auch noch gerne für sie sorgten.“"
                                            },
                                            {
                                                "example_id": "048795f9-811d-4215-abed-30fb0874e6e4",
                                                "sense_id": "ce603f78-aa53-3fa7-932c-c36e15482d09",
                                                "text": "„An die 2 000 Gleitflüge hatte der Flugpionier erfolgreich absolviert, als er am 9. August 1896 am Gollenberg abstürzte und dabei ums Leben kam.“"
                                            },
                                            {
                                                "example_id": "eb3a26b3-11b7-405c-896e-5b80fc80a3c0",
                                                "sense_id": "ce603f78-aa53-3fa7-932c-c36e15482d09",
                                                "text": "„Der Norden, der inzwischen erfolgreich Fabriken mit Wasserkraft und Dampfmaschinen betrieb, hatte sich auch gesellschaftlich modernisiert und forderte die Abschaffung der Sklaverei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f03f3857-d9b2-4f0b-8aa8-e805e92d50fa",
                        "source_entry_id": "cc221613-32cc-3279-beb3-52d73a95cc5e",
