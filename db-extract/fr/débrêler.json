                "senses": [
                    {
                        "sense_id": "a49d397b-8d49-3298-beeb-d7207f6d6beb",
                        "entry_id": "ddea0e8e-9a5d-3503-a8ab-aecf20969b12",
                        "glosses": [
                            "Détacher (ce qui avait été brêlé)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4181ad64-8d78-4851-8705-bdfaef337d77",
                                "sense_id": "a49d397b-8d49-3298-beeb-d7207f6d6beb",
                                "text": "Débrêler et enlever les guindages."
                            },
                            {
                                "example_id": "374feb7a-36bb-4840-905d-b6fa07a0ad33",
                                "sense_id": "a49d397b-8d49-3298-beeb-d7207f6d6beb",
                                "text": "Jusque là, ça n’est pas encore trop le pétrole, bien que ce soit déjà une petite partie de plaisir à débrêler tous les câbles electriques, les circuits de freins."
                            },
                            {
                                "example_id": "d78c090b-ea99-4d96-95ca-1c6f2fd51b7e",
                                "sense_id": "a49d397b-8d49-3298-beeb-d7207f6d6beb",
                                "text": "Pour l’atteindre, il suffit juste de débrêler son harnais, lequel est un classique multipoints."
                            }
                        ]
                    }
