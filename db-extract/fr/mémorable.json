                                                "example_id": "ff07b41e-3dcc-4740-bd34-68f8e0e7eff5",
                                                "sense_id": "25c107fd-442d-3068-84c3-f7775951eb7b",
                                                "text": "Maar vooral actrice Olivia Colman is onvergetelijk als de zon waaromheen dit universum draait."
                                            },
                                            {
                                                "example_id": "621d2896-75e1-4ffa-8345-a76ee895bee5",
                                                "sense_id": "25c107fd-442d-3068-84c3-f7775951eb7b",
                                                "text": "Het was namelijk de eerste keer dat ze had gezien hoe een jongen zich zo totaal gewonnen gaf in een discussie. En zoiets was natuurlijk onvergetelijk."
                                            }
