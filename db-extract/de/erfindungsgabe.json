                "senses": [
                    {
                        "sense_id": "9b3ed2d6-0518-35f6-b5d6-1df1f398b137",
                        "entry_id": "3bc920e1-38ec-36ec-b43d-6b377114b998",
                        "glosses": [
                            "persönliche Gabe oder Fähigkeit, Erfindungen machen zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59b4a40c-a7a7-4dd5-adbe-d67b9e9fea0b",
                                "sense_id": "9b3ed2d6-0518-35f6-b5d6-1df1f398b137",
                                "text": "„Die wahre Geschichte jedoch handelt vom Triumph über das Unmögliche, von außergewöhnlicher Erfindungsgabe und vom brennenden Verlangen eines Mannes nach Unsterblichkeit."
                            },
                            {
                                "example_id": "882d5167-2319-4b0e-9ff1-85ea85a373f5",
                                "sense_id": "9b3ed2d6-0518-35f6-b5d6-1df1f398b137",
                                "text": "„Siliziumprozessoren sind kleine Maschinen menschlicher Erfindungsgabe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70ad4481-10f4-4889-97f4-78147959d5d9",
                        "source_entry_id": "3bc920e1-38ec-36ec-b43d-6b377114b998",
                        "source_sense_id": "9b3ed2d6-0518-35f6-b5d6-1df1f398b137",
                        "source_sense_description": "persönliche Gabe oder Fähigkeit, Erfindungen machen zu können",
                        "target_lang_word": "inventivité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inventivité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0dd70a34-a2ff-3878-b2c5-2854ad93d2f8",
                                        "entry_id": "f938d10a-572b-34e6-8d3c-10176b851d81",
                                        "glosses": [
                                            "Capacité à inventer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3267a53e-98d9-465c-a8bc-df3c7b4b6f04",
                                                "sense_id": "0dd70a34-a2ff-3878-b2c5-2854ad93d2f8",
                                                "text": "L’humour, l’inventivité, dont témoignaient les slogans et affiches d’époque, avaient cannibalisé, « bisounoursisé » toutes les effervescences browniennes d’un événement qui charria tout, le meilleur et le pire, ce que charrient toujours les torrentielles bifurcations, fussent-elles régénératrices."
                                            },
                                            {
                                                "example_id": "6b395be0-2a9f-42e0-a32d-7b32e3a6eb6f",
                                                "sense_id": "0dd70a34-a2ff-3878-b2c5-2854ad93d2f8",
                                                "text": "Le théoricien est quelqu’un qui aime jouer avec des idées, qui aime déployer son inventivité, son imagination, dans le monde des idées."
                                            },
                                            {
                                                "example_id": "064aea2c-9d14-4e10-a577-a54a9d788743",
                                                "sense_id": "0dd70a34-a2ff-3878-b2c5-2854ad93d2f8",
                                                "text": "Au-delà de l’aspect émotionnel, l’œuvre fascine par son inventivité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad2a2688-b6eb-4be5-8228-ccd6f8a22291",
                        "source_entry_id": "3bc920e1-38ec-36ec-b43d-6b377114b998",
                        "source_sense_id": "9b3ed2d6-0518-35f6-b5d6-1df1f398b137",
                        "source_sense_description": "persönliche Gabe oder Fähigkeit, Erfindungen machen zu können",
                        "target_lang_word": "imagination",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imagination",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "41a795df-668c-364d-9812-ef7d2610f891",
                                        "entry_id": "86ba5dec-f4de-3968-a2e5-346715504126",
                                        "glosses": [
                                            "Faculté d’imaginer, de se représenter quelque chose dans l’esprit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03bb7da1-8bce-4dfe-bd0b-780f1beee7a5",
                                                "sense_id": "41a795df-668c-364d-9812-ef7d2610f891",
                                                "text": "Loin du danger, il ne rêve qu’exploits héroïques, entreprises surhumaines et gigantesques ; mais, quand vient le péril, son imagination trop vive lui représente la douleur des blessures, le visage camard de la mort, et le cœur lui manque ; […]."
                                            },
                                            {
                                                "example_id": "0bc5380e-fc7b-4f1f-946e-25fc0fa8b0c4",
                                                "sense_id": "41a795df-668c-364d-9812-ef7d2610f891",
                                                "text": "Il était la proie de Carmen […]. Et non seulement il la subissait, mais encore il la recherchait, épris de sa chair de grande amoureuse lascive et insatisfaite, parfois ruée dans des débordements insensés, de quoi combler l’imagination la plus follement macérée dans les laves de l'érotisme épuisant."
                                            },
                                            {
                                                "example_id": "c069e7b0-d181-4deb-b78c-8baa26137c4f",
                                                "sense_id": "41a795df-668c-364d-9812-ef7d2610f891",
                                                "text": "Moyennant quoi rien ne réfrénait sa connardise que le manque d’imagination. Il ne faisait de doute pour personne que le connard n’était pas réformable."
                                            },
                                            {
                                                "example_id": "cbea8a0e-8f1d-4281-9393-ce0cad8280d4",
                                                "sense_id": "41a795df-668c-364d-9812-ef7d2610f891",
                                                "text": "Mais la figure de la quarante-huitarde en culottes partage dans l’imagination des humoristes la place avec des révoltées enjuponnées, montrant sans pudeur leurs jambes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1faffb54-53d0-3a3a-b451-ee3be27a4e59",
                                        "entry_id": "86ba5dec-f4de-3968-a2e5-346715504126",
                                        "glosses": [
                                            "Faculté d’inventer, de concevoir, jointe au talent de rendre vivement ses conceptions."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48f35b6d-2b5d-4b5c-ac50-7351cdffcaa3",
                                                "sense_id": "1faffb54-53d0-3a3a-b451-ee3be27a4e59",
                                                "text": "Ce poète, ce peintre a une imagination créatrice."
                                            },
                                            {
                                                "example_id": "97c97bbd-e767-4eb0-b6d0-cebc16587d0a",
                                                "sense_id": "1faffb54-53d0-3a3a-b451-ee3be27a4e59",
                                                "text": "Avoir l’imagination fertile, riche, heureuse, brillante, forte, hardie, fougueuse."
                                            },
                                            {
                                                "example_id": "2fbd72e2-e57a-4988-abfb-d1053656a4c6",
                                                "sense_id": "1faffb54-53d0-3a3a-b451-ee3be27a4e59",
                                                "text": "Une grande vivacité d’imagination."
                                            },
                                            {
                                                "example_id": "26ded37a-5e8f-4359-81a9-8cdd40129ae9",
                                                "sense_id": "1faffb54-53d0-3a3a-b451-ee3be27a4e59",
                                                "text": "Les écarts de l’imagination."
                                            },
                                            {
                                                "example_id": "7a5e85a9-9714-45b5-860e-9293d3c09fa3",
                                                "sense_id": "1faffb54-53d0-3a3a-b451-ee3be27a4e59",
                                                "text": "S’abandonner à son imagination."
                                            },
                                            {
                                                "example_id": "25fd0cfa-3e58-4486-860d-155f4bc4a076",
                                                "sense_id": "1faffb54-53d0-3a3a-b451-ee3be27a4e59",
                                                "text": "Le feu de l’imagination."
                                            },
                                            {
                                                "example_id": "e678d5e3-0880-4605-891e-156f41e176cb",
                                                "sense_id": "1faffb54-53d0-3a3a-b451-ee3be27a4e59",
                                                "text": "Littérature d’imagination."
                                            },
                                            {
                                                "example_id": "3f94ff88-3865-4604-8a5f-3244998fb14a",
                                                "sense_id": "1faffb54-53d0-3a3a-b451-ee3be27a4e59",
                                                "text": "ouvrages d’imagination."
                                            },
                                            {
                                                "example_id": "8455c17d-cc70-4ff0-b53e-486eaa2f3967",
                                                "sense_id": "1faffb54-53d0-3a3a-b451-ee3be27a4e59",
                                                "text": "Les arts de l’imagination."
                                            },
                                            {
                                                "example_id": "060901b2-e6fc-4df4-9ded-40578a945dba",
                                                "sense_id": "1faffb54-53d0-3a3a-b451-ee3be27a4e59",
                                                "text": "Roman plein d’imagination."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fde267e-675a-3529-aaf2-4feca40f9ee7",
                                        "entry_id": "86ba5dec-f4de-3968-a2e5-346715504126",
                                        "glosses": [
                                            "Produit de ces inventions talentueuses."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e821fd4f-579b-4140-ab9f-ef2b7f085184",
                                                "sense_id": "4fde267e-675a-3529-aaf2-4feca40f9ee7",
                                                "text": "— Ah ! ma pauvre fille, lui dit ce jour-là le docteur, peut-on perdre son temps à de telles imaginations !"
                                            },
                                            {
                                                "example_id": "db402d5a-9709-46b9-ad7f-8065261448a8",
                                                "sense_id": "4fde267e-675a-3529-aaf2-4feca40f9ee7",
                                                "text": "À première vue, on attribuerait au gothique flamboyant cette maîtresse œuvre où l'on découvre bientôt les volutes, les ornements, toutes les riches imaginations de la Renaissance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "147cd422-1b00-3663-ad4a-1e8aad2cbaba",
                                        "entry_id": "86ba5dec-f4de-3968-a2e5-346715504126",
                                        "glosses": [
                                            "Pensée, conception."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "412bbcf0-4b16-4f64-9855-3701cfe9d041",
                                                "sense_id": "147cd422-1b00-3663-ad4a-1e8aad2cbaba",
                                                "text": "Une belle imagination. Une agréable imagination."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d5456c4-1711-33a5-9bce-f0bd18394c7c",
                                        "entry_id": "86ba5dec-f4de-3968-a2e5-346715504126",
                                        "glosses": [
                                            "Croyance, opinion qu’on a de quelque chose sans beaucoup de fondement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6caa5353-1364-41c6-bf89-f19433054d63",
                                                "sense_id": "6d5456c4-1711-33a5-9bce-f0bd18394c7c",
                                                "text": "Ainsi va l'activité incessante de l'imagination humaine, défaisant, refaisant sans cesse, brodant le vieux, cousant le neuf; […]."
                                            },
                                            {
                                                "example_id": "6e559bd0-b2da-46c6-8cc0-f89204ade1ba",
                                                "sense_id": "6d5456c4-1711-33a5-9bce-f0bd18394c7c",
                                                "text": "La Vouivre, dans l’imagination du peuple séquanien, qui lui prête d'ailleurs une figure assez uniforme, est un serpent ailé, dont le corps est souvent de feu, […]."
                                            },
                                            {
                                                "example_id": "28ebbef6-80ea-4a67-bd7c-256b6e1db234",
                                                "sense_id": "6d5456c4-1711-33a5-9bce-f0bd18394c7c",
                                                "text": "Si le Dieu s’oubliait, devenait un tyran, voulait enténébrer l’imagination de terreurs serviles, l'esprit armé d'une telle langue, lui retrouvant ses origines, dirait : « Qui t'a créé, c'est moi. »"
                                            },
                                            {
                                                "example_id": "f0c9ceaa-1234-48ca-8e26-1dc531015e00",
                                                "sense_id": "6d5456c4-1711-33a5-9bce-f0bd18394c7c",
                                                "text": "Cependant, ce que Jacques aimait en Yasmina, en son ignorance absolue de l'âme de la Bédouine, c'était un être purement imaginaire, issu de son imagination, et bien certainement fort peu semblable à la réalité..."
                                            },
                                            {
                                                "example_id": "4e1650c6-add8-47dd-81d7-6667683cc978",
                                                "sense_id": "6d5456c4-1711-33a5-9bce-f0bd18394c7c",
                                                "text": "Ce miracle, ignoré du clergé local au XVIIᵉ s., est sûrement le produit de l'imagination de certains spécialistes en hagiographie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "521b19cf-6aff-3466-b203-9b426fa558b4",
                                        "entry_id": "86ba5dec-f4de-3968-a2e5-346715504126",
                                        "glosses": [
                                            "Fantaisie bizarre, idée chimérique et extravagante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd39fd79-5f31-47cf-9f40-2feadee52169",
                                                "sense_id": "521b19cf-6aff-3466-b203-9b426fa558b4",
                                                "text": "Il y a toujours, dans l’imagination d'un gamin de quinze ans, quelque modèle dont il imite jusqu'à la voix."
                                            },
                                            {
                                                "example_id": "43997f6a-5453-497b-8781-599fc2383605",
                                                "sense_id": "521b19cf-6aff-3466-b203-9b426fa558b4",
                                                "text": "Quelques jeunes clubmen, dont l’imagination aventureuse s’était enflammée de patriotisme, s’entassèrent dans cinq ou six automobiles et partirent clandestinement pour Beacon Hill."
                                            },
                                            {
                                                "example_id": "15485a91-ca31-46f5-99a7-e758bc919af5",
                                                "sense_id": "521b19cf-6aff-3466-b203-9b426fa558b4",
                                                "text": "Ne regardons donc plus comme des principes absolus des faits n’ayant jamais existé que dans l’imagination de ceux qui les ont conçus ; […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
