                    },
                    {
                        "translation_id": "a59c0d94-7f21-4931-a46a-d3947e12de04",
                        "source_entry_id": "bb90c622-6ddc-3b2a-a86f-c80b3d483ca0",
                        "target_lang_word": "tendentious",
                        "target_lang_code": "en",
