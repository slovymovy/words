                        "glosses": [
                            "Langue bodique parlée, de nos jours ou auparavant, par des personnes de culture tibétaine."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "f9d5dbf0-cee9-44ca-9b92-c9ce95808454",
                                "sense_id": "290ec5a7-ebcc-310f-af4e-508b26632184",
                                "text": "En effet, chacune des expressions philosophiques ou des dénominations mythologiques qui se rapportent à Bouddha, est là en cinq langues : en sanscrit, en chinois, en mantchou, en mongol et en thibétain."
                            },
                            {
                                "example_id": "bfa0c04a-27b9-4fbd-9e9d-c76714f8dca3",
                                "sense_id": "290ec5a7-ebcc-310f-af4e-508b26632184",
                                "text": "De sorte que je ressemble ici à ces professeurs de chinois ou de thibétain que l’on a la malice de mettre en rapport avec des naturels de ce pays…"
                            }
                        ]
                    }
