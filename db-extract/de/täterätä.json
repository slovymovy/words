                "senses": [
                    {
                        "sense_id": "3584e044-6eb1-3cbf-b111-87b3d6da936b",
                        "entry_id": "ebfb455a-d88a-3b65-968e-0a2ec7ebc47a",
                        "glosses": [
                            "große Umstände, oft im Sinne von überflüssigem Getue"
                        ],
                        "tags": [
                            "casual",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "8777f667-d4f3-49f5-9fd2-693d8835bfaf",
                                "sense_id": "3584e044-6eb1-3cbf-b111-87b3d6da936b",
                                "text": "Karl-Heinz Rieck, Gastwirt, steht da, und nichts von vormals Klempner in einer Zuckerfabrik in Dömitz an Elbe und Eldekanal und nichts von Bruder, Nachbar und Kommilitone und verjagter Tbc und Täterätä."
                            },
                            {
                                "example_id": "3fae010a-4f33-4978-b925-13853122c309",
                                "sense_id": "3584e044-6eb1-3cbf-b111-87b3d6da936b",
                                "text": "Mach nicht solch ein Täterätä!"
                            },
                            {
                                "example_id": "08a17d2d-66e2-44a5-8d65-580d75ef530b",
                                "sense_id": "3584e044-6eb1-3cbf-b111-87b3d6da936b",
                                "text": "Das ganze Täterätä kannst du dir sparen."
                            },
                            {
                                "example_id": "3b9f25c5-c957-4f16-bb7a-02a734902857",
                                "sense_id": "3584e044-6eb1-3cbf-b111-87b3d6da936b",
                                "text": "Wenn ich fahren kann, dann schicke ich Euch 1 Telegramm, damit ihr mich abholen könnt vom Bahnhof, aber bitte schön mit recht viel Täterätä, damit ich lachen muß."
                            },
                            {
                                "example_id": "31667c26-3bc9-4a2a-afbd-8541b8b7dc5f",
                                "sense_id": "3584e044-6eb1-3cbf-b111-87b3d6da936b",
                                "text": "Am 10. November erlebte ich den St. Martinstag, an dem 12.000 Kinder mit ihren Lampions durch Bonns Straßen zogen und am Tage darauf, am 11.11.1953, wurde mit viel Lärm und Täterätä die Faschingszeit eingeläutet."
                            },
                            {
                                "example_id": "8663e98d-59f1-44a6-88fa-4dcb4fbf64e3",
                                "sense_id": "3584e044-6eb1-3cbf-b111-87b3d6da936b",
                                "text": "In der Hauptstadt dagegen großes Täterätä: Das siebenhundertjährige Stadtjubiläum feiern eine Woche lang alle Bezirke mit Aufführungen von Volkstanzgruppen, Platzkonzerten und öffentlichen Sportvorführungen."
                            },
                            {
                                "example_id": "fae75272-2fa3-467f-903d-b119b172e4ae",
                                "sense_id": "3584e044-6eb1-3cbf-b111-87b3d6da936b",
                                "text": "Muß doch ein offenes Wort reden, ganz offen, verstehen Sie, wäre das ganze Nest hier krepiert, an Typhus krepiert damals, wenn ich nicht gewesen wäre, eingegriffen hätte, ohne viel Täterätä, verstehen Sie?"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
