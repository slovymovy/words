{
    "word_family": [
        "knol",
        "raap"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "20b6f183-ddc2-3097-9f65-eb10c5f3db16",
                    "sense_definition": "De eetbare, vlezige wortel of knol van de plant Brassica rapa, gebruikt als groente of veevoer.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "brassica_rapa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de winter aten ze vaak traditionele stamppot met <w>knolraap</w> en spekjes.",
                            "target_lang_translations": {
                                "de": "Im Winter aßen sie oft traditionellen Eintopf mit <w>Mairüben</w> und Speck."
                            }
                        },
                        {
                            "text": "Hij sneed de geschilde <w>knolraap</w> in kleine blokjes voor de groentesoep.",
                            "target_lang_translations": {
                                "de": "Er schnitt die geschälte <w>Rübe</w> in kleine Würfel für die Gemüsesuppe."
                            }
                        }
                    ],
                    "synonyms": [
                        "meiraap"
                    ],
                    "common_phrases": [
                        "verse knolraap"
                    ],
                    "target_lang_definitions": {
                        "de": "Die essbare, fleischige Knolle oder Rübe der Pflanze Brassica rapa, die als Gemüse oder Viehfutter verwendet wird."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Mairübe",
                                "target_lang_sense_clarification": "als Speisegemüse"
                            },
                            {
                                "target_lang_word": "Wasserrübe",
                                "target_lang_sense_clarification": "Speise- oder Futterrübe"
                            },
                            {
                                "target_lang_word": "Rübe",
                                "target_lang_sense_clarification": "allgemeine Bezeichnung"
                            },
                            {
                                "target_lang_word": "Stoppelrübe",
                                "target_lang_sense_clarification": "häufig als Futterrübe angebaut"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06cb73ed-8940-38f0-829f-924f0a0969e4",
                    "sense_definition": "Tweejarige plant uit de kruisbloemenfamilie (Brassica rapa) die gekweekt wordt om zijn eetbare knol.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "brassica_rapa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer zaait de <w>knolraap</w> laat in de zomer om in het najaar te kunnen oogsten.",
                            "target_lang_translations": {
                                "de": "Der Bauer sät die <w>Stoppelrübe</w> im Spätsommer aus, um im Herbst ernten zu können."
                            }
                        },
                        {
                            "text": "Tijdens zijn wandeling zag hij hoe de <w>knolraap</w> op het veld begon te bloeien.",
                            "target_lang_translations": {
                                "de": "Während seines Spaziergangs sah er, wie die <w>Rübe</w> auf dem Feld zu blühen begann."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Zweijährige Pflanze aus der Familie der Kreuzblütler (Brassica rapa), die wegen ihrer essbaren Rübe angebaut wird."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Rübe",
                                "target_lang_sense_clarification": "die Pflanze selbst"
                            },
                            {
                                "target_lang_word": "Wasserrübe",
                                "target_lang_sense_clarification": "die Kulturpflanze Brassica rapa subsp. rapa"
                            },
                            {
                                "target_lang_word": "Stoppelrübe",
                                "target_lang_sense_clarification": "die Pflanzenart im landwirtschaftlichen Anbau"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}