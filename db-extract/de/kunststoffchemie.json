                ],
                "senses": [
                    {
                        "sense_id": "cb73e3b3-aec0-3a54-a4aa-1d392a556c0a",
                        "entry_id": "fcfe504b-91cc-3a71-b7a0-b1d727b52b7a",
                        "glosses": [
                            "Naturwissenschaft, die sich mit der Zusammensetzung und den Eigenschaften von Polymeren, sowie deren Veränderungen befasst"
                        ],
                        "tags": [
                            "Polymerchemie"
                        ],
                        "examples": [
                            {
                                "example_id": "3f2cfdb9-2008-4bbf-85e6-0ca825027e0a",
                                "sense_id": "cb73e3b3-aec0-3a54-a4aa-1d392a556c0a",
                                "text": "„Erklärtes Ziel des Buches ist es denn auch, dieses Minimum an Kunststoffchemie an die Adresse der Ingenieure zu vermitteln. Dabei steht das Bemühen im Vordergrund -insbesondere wenn der Leser über keine oder nur geringe chemische Vorkenntnisse verfügt- den Einstieg in das faszinierende Gebiet der Kunststoffchemie behutsam vorzunehmen.“"
                            },
                            {
                                "example_id": "16c71202-2514-4c8c-937d-cc2ff4969621",
                                "sense_id": "cb73e3b3-aec0-3a54-a4aa-1d392a556c0a",
                                "text": "„Mit der Pyrolyse von Kunststoffabfällen wurde demzufolge eine Methode gefunden, die der Kunststoffchemie kostengünstig Rohstoffe liefern könnte.“"
                            },
                            {
                                "example_id": "5f173f2e-b004-4333-bd8a-b9b48c57ddf0",
                                "sense_id": "cb73e3b3-aec0-3a54-a4aa-1d392a556c0a",
                                "text": "„Das theoretische Studium wird durch praktische Laborübungen in der Kunststoffchemie und der Kunststoffverarbeitung ergänzt.“"
                            },
                            {
                                "example_id": "0122cded-ff33-4cef-b554-ebe353be1573",
                                "sense_id": "cb73e3b3-aec0-3a54-a4aa-1d392a556c0a",
                                "text": "„Der Chemie-Leistungskurs in der Schule hat mein Interesse für die organische und besonders die Kunststoffchemie geweckt, ein Chemie-Studium war wegen der langen Studiendauer (Promotion!) uninteressant und so stieß ich bei der Suche nach dem passenden Studiengang im Internet auf die TU Clausthal und den Studiengang Kunststofftechnik.“"
                            },
                            {
                                "example_id": "c41b9b10-aca6-4a41-b87c-2afd1945cd82",
                                "sense_id": "cb73e3b3-aec0-3a54-a4aa-1d392a556c0a",
                                "text": "„Die Kunststoffchemie ist damit eine Untergruppe der Polymerchemie, die synthetische Herstellung erfolgt über chemische Reaktionen, die als Polymerisation bezeichnet wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
