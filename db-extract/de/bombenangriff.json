                "senses": [
                    {
                        "sense_id": "a04b1498-b79f-37d4-9f89-6869661f1a0f",
                        "entry_id": "5bb9ca86-c74c-38cf-ba63-d7082f6d4001",
                        "glosses": [
                            "Angriff mit aus Flugzeugen abgeworfenen Bomben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b55c0c64-cfe3-4c86-89f4-2beaad7aaa62",
                                "sense_id": "a04b1498-b79f-37d4-9f89-6869661f1a0f",
                                "text": "Die Bombenangriffe während des Zweiten Weltkrieges hatten in vielen deutschen Städten verheerende Schäden angerichtet."
                            },
                            {
                                "example_id": "e5bae0f4-8741-4fe7-b6b3-f98c1e5ba94c",
                                "sense_id": "a04b1498-b79f-37d4-9f89-6869661f1a0f",
                                "text": "„Doch da verbrannte bei einem Bombenangriff auf Leipzig kurz vor der Auslieferung die gesamte Auflage.“"
                            },
                            {
                                "example_id": "baf065f6-55e7-4476-9e87-55411e6f4be5",
                                "sense_id": "a04b1498-b79f-37d4-9f89-6869661f1a0f",
                                "text": "„Den folgenschwersten Einschnitt in der jüngeren Stadtgeschichte verursachten die alliierten Bombenangriffe in den Jahren 1944/45; sie führten zur fast vollständigen Zerstörung von weiten Teilen des Zentrums und der angrenzenden Wohngebiete.“"
                            },
                            {
                                "example_id": "21b28b62-2403-4a64-9b6d-b10155a4d1d2",
                                "sense_id": "a04b1498-b79f-37d4-9f89-6869661f1a0f",
                                "text": "„In Berlin verloren sie während eines Bombenangriffs ihr erstes Kind.“"
                            },
                            {
                                "example_id": "b256e6ac-4660-4701-a3f3-a342940279f9",
                                "sense_id": "a04b1498-b79f-37d4-9f89-6869661f1a0f",
                                "text": "„Die Kinder in London hatten nicht einschlafen können, als die Bombenangriffe aufhörten und damit eine Lebensweise zerstörten, an die sie sich gewöhnt hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "53d27bd0-da40-4718-b73d-e9968e3ef73c",
