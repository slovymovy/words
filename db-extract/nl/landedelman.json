                        "entry_id": "05cdbf28-0c28-3165-9c67-6a15be1783a5",
                        "glosses": [
                            "iemand van adel die op een landgoed leeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7a02cff-3210-4f11-833b-a0aecec5dd13",
                                "sense_id": "3c23a16a-f03f-3a49-9299-862b8dd38efb",
                                "text": "De dokter van zijn kant onderdrukte met moeite de minachting, die hij voor deze oude landedelman voelde en trachtte zich begrijpelijk te maken voor diens beperkt verstand."
                            },
                            {
                                "example_id": "20d8876a-879d-47e1-9aef-a01c96039827",
                                "sense_id": "3c23a16a-f03f-3a49-9299-862b8dd38efb",
                                "text": "In het statige woonvertrek blikt de achterneef van koningin Beatrix terug op het leven van Emma en vertelt de landedelman over zijn contacten met de Oranjes: „Wij zijn er in goede en in slechte tijden bij.”"
                            }
                        ]
                    }
