                ],
                "senses": [
                    {
                        "sense_id": "39e47e20-1d43-3e83-9a9b-c6a9cf9ec7ed",
                        "entry_id": "dcde7af8-e835-3748-a98f-d45198e1baa3",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af17abb6-3e65-41c4-9a82-53fced923836",
                                "sense_id": "39e47e20-1d43-3e83-9a9b-c6a9cf9ec7ed",
                                "text": "Frau Kieble ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7cafe9d6-8d8c-49f4-bdf8-bb3af671ca43",
                                "sense_id": "39e47e20-1d43-3e83-9a9b-c6a9cf9ec7ed",
                                "text": "Herr Kieble wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "15e6a498-2b00-4701-89d9-d0746eb20300",
                                "sense_id": "39e47e20-1d43-3e83-9a9b-c6a9cf9ec7ed",
                                "text": "Die Kiebles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "13196886-122f-4fe1-a7cb-847b2b09206e",
                                "sense_id": "39e47e20-1d43-3e83-9a9b-c6a9cf9ec7ed",
                                "text": "Der Kieble trägt nie die Schals, die die Kieble ihm strickt."
                            },
                            {
                                "example_id": "0dc0e0ff-030a-4b94-83eb-3543bbd584ab",
                                "sense_id": "39e47e20-1d43-3e83-9a9b-c6a9cf9ec7ed",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kieble kommt, geht der Herr Kieble.“"
                            },
                            {
                                "example_id": "82afcd08-b212-42d1-8b70-ed23c1d11d47",
                                "sense_id": "39e47e20-1d43-3e83-9a9b-c6a9cf9ec7ed",
                                "text": "Kieble kommt und geht."
                            },
                            {
                                "example_id": "fb4b73c1-83ab-467b-a619-be87457569a3",
                                "sense_id": "39e47e20-1d43-3e83-9a9b-c6a9cf9ec7ed",
                                "text": "Kiebles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
