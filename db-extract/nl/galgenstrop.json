                                            "Jagd"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0e88d6d-faea-4d05-8739-ae94137dfa0a",
                                                "sense_id": "1671a24c-bf66-383a-af61-15bad4635651",
                                                "text": "Das Jagen mit Schlingen ist bei uns verboten."
