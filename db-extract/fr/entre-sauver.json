                        "examples": [
                            {
                                "example_id": "dbfc3f1c-e81d-4043-acce-cc28ce8f0edb",
                                "sense_id": "bee314e9-9198-36f6-886d-584d989d642b",
                                "text": "On a si souvent contribué à s’entre-sauver la peau, tous les trois, qu’on est devenus comme des prolongements les uns des autres : trois membres d’une trinité indissoluble."
                            },
                            {
                                "example_id": "5179c6a0-71ad-4380-88f9-956f88479aef",
                                "sense_id": "bee314e9-9198-36f6-886d-584d989d642b",
                                "text": "Leur relation va sûrement consister à se taper dessus tout en s'entre-sauvant lorsqu'ils se retrouvent dans le même bateau à frôler la mort..."
                            },
                            {
                                "example_id": "c8cb9074-07bb-4488-8b6d-d7da360e7007",
                                "sense_id": "bee314e9-9198-36f6-886d-584d989d642b",
                                "text": "Nous étions constamment en train de nous entre-sauver et ceci donnait lieu à de très belles actions du genre qu'on n'oublie pas si facilement !"
                            }
                        ]
