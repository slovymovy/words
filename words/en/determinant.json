{
    "word_family": [
        "determinable",
        "determinacy",
        "determinate",
        "determination",
        "determinative",
        "determine",
        "determiner",
        "determinism",
        "determinist",
        "deterministic",
        "indeterminant",
        "indetermination"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0a9c9b0a-e789-3111-962f-467242a99339",
                    "sense_definition": "A factor or element that decisively affects the outcome, nature, or development of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "causal_factor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Education level is often a key <w>determinant</w> of future income.",
                            "target_lang_translations": {
                                "zh": "受教育程度往往是未来收入的关键<w>决定因素</w>。"
                            }
                        },
                        {
                            "text": "Researchers studied the major <w>determinants</w> of customer satisfaction in online retail.",
                            "target_lang_translations": {
                                "zh": "研究人员探讨了在线零售中影响客户满意度的主要<w>决定因素</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "factor"
                    ],
                    "common_phrases": [
                        "key determinant",
                        "major determinant",
                        "social determinants of health"
                    ],
                    "target_lang_definitions": {
                        "zh": "对某事的结果、性质或发展起决定性作用的因素或要素。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "决定因素",
                                "target_lang_sense_clarification": "起决定作用的因素"
                            },
                            {
                                "target_lang_word": "决定条件",
                                "target_lang_sense_clarification": "起决定作用的条件或要素"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85601563-5000-3dd9-a6b4-e8894e8b29e6",
                    "sense_definition": "A scalar value calculated from the elements of a square matrix that characterizes certain properties of the matrix and its linear transformation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "math_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If the <w>determinant</w> of the matrix is zero, the system of equations has no unique solution.",
                            "target_lang_translations": {
                                "zh": "如果该矩阵的<w>行列式</w>为零，则方程组没有唯一解。"
                            }
                        },
                        {
                            "text": "The professor asked us to calculate the <w>determinant</w> of a three-by-three matrix.",
                            "target_lang_translations": {
                                "zh": "教授让我们计算一个三阶方阵的<w>行列式</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "calculate the determinant"
                    ],
                    "target_lang_definitions": {
                        "zh": "由方阵元素计算出的标量值，表征矩阵及其线性变换的特定性质。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "行列式",
                                "target_lang_sense_clarification": "数学中方阵所对应的标量值"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1397e9d9-7d71-301c-a969-90bc3a816321",
                    "sense_definition": "A substance or localized cytoplasmic factor that directs an embryonic cell toward a specific developmental fate.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biology_factor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The asymmetric inheritance of a cytoplasmic <w>determinant</w> causes the two daughter cells to differentiate.",
                            "target_lang_translations": {
                                "zh": "细胞质<w>决定子</w>的不对称分配会导致两个子细胞发生分化。"
                            }
                        },
                        {
                            "text": "This specific maternal <w>determinant</w> plays a vital role in early body patterning.",
                            "target_lang_translations": {
                                "zh": "这种特殊的母体<w>决定子</w>在早期胚胎体轴建成中起着至关重要的作用。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cytoplasmic determinant"
                    ],
                    "target_lang_definitions": {
                        "zh": "引导胚胎细胞走向特定发育命运的物质或细胞质定位因子。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "决定簇",
                                "target_lang_sense_clarification": "生物学中诱导或决定细胞命运的因子"
                            },
                            {
                                "target_lang_word": "决定子",
                                "target_lang_sense_clarification": "胚胎发育中决定细胞命运的物质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92e5d3a0-abc7-300a-b562-42c47d6ab458",
                    "sense_definition": "A sequence or molecular feature that directs a nuclease enzyme to cut at a specific location.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biology_factor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The RNA sequence functions as a <w>determinant</w> directing the enzyme cleavage site.",
                            "target_lang_translations": {
                                "zh": "该RNA序列充当指导酶切割位点的<w>决定区</w>。"
                            }
                        },
                        {
                            "text": "Modifying the nucleotide sequence of the <w>determinant</w> prevented the enzyme from cutting.",
                            "target_lang_translations": {
                                "zh": "修改该<w>决定基</w>的核苷酸序列阻止了酶的切割。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "引导核酸内切酶在特定位置进行切割的序列或分子特征。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "决定区",
                                "target_lang_sense_clarification": "指导酶切割位置的识别序列或特征"
                            },
                            {
                                "target_lang_word": "决定基",
                                "target_lang_sense_clarification": "特异性识别位点或决定特征"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6ddae74d-8509-30c8-923c-45ecb740027a",
                    "sense_definition": "Serving to determine, define, or set limits; determinative.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "causal_factor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Geographic isolation was the most <w>determinant</w> condition in the evolution of this species.",
                            "target_lang_translations": {
                                "zh": "地理隔离是该物种演化过程中最具有<w>决定性</w>的条件。"
                            }
                        },
                        {
                            "text": "Cost proved to be a highly <w>determinant</w> factor when choosing between the two suppliers.",
                            "target_lang_translations": {
                                "zh": "在两家供应商之间做选择时，成本证明是一个极具<w>决定性的</w>因素。"
                            }
                        }
                    ],
                    "synonyms": [
                        "determinative",
                        "decisive"
                    ],
                    "common_phrases": [
                        "determinant factor"
                    ],
                    "target_lang_definitions": {
                        "zh": "起决定、界定或限制作用的；决定性的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "决定性的",
                                "target_lang_sense_clarification": "起支配或决定作用的"
                            },
                            {
                                "target_lang_word": "决定的",
                                "target_lang_sense_clarification": "起确定或限制作用的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}