                "senses": [
                    {
                        "sense_id": "19c9b2dc-3d9e-3547-a955-044aba4af154",
                        "entry_id": "405e10cd-5ce9-313b-8db6-a5770d269b12",
                        "glosses": [
                            "Name für eine Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c0edb4b-d059-469f-bfc6-81280f030431",
                                "sense_id": "19c9b2dc-3d9e-3547-a955-044aba4af154",
                                "text": "„Solche Bezeichnungen sind naturgemäß externe Sprachnamen, die vom sozialen Gegner gegeben werden.“"
                            },
                            {
                                "example_id": "a47822ea-471e-491d-8c29-e9b728a59446",
                                "sense_id": "19c9b2dc-3d9e-3547-a955-044aba4af154",
                                "text": "„»Hundeshagener Kochum«, so lautet der selbstgewählte Sprachname für diesen Rotwelschdialekt.“"
                            },
                            {
                                "example_id": "14ac33f8-c212-493d-a80b-1f2fa9df55f8",
                                "sense_id": "19c9b2dc-3d9e-3547-a955-044aba4af154",
                                "text": "„Das von den Arbeitern damals gesprochene Pidgin wurde mit dieser Tätigkeit assoziiert, so dass sich der Sprachname etablierte.“"
                            },
                            {
                                "example_id": "f1900e8d-ef3c-491e-81b8-0973eeb72be7",
                                "sense_id": "19c9b2dc-3d9e-3547-a955-044aba4af154",
                                "text": "„Der ursprüngliche Sprachname latino wird für diese romanische Sprache seit Beginn ihrer schriftlichen Überlieferung nicht mehr verwendet (wohl aber für das Ladinische).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
