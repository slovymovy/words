                    {
                        "sense_id": "96fab667-9011-35de-965e-8fa0d10d84cc",
                        "entry_id": "bf065bb9-1e1a-309b-a655-ee9baa7eb092",
                        "glosses": [
                            "Qui est en cage, enfermé."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "782e5402-883d-41b0-9b55-b16d7c5288b4",
                                "sense_id": "96fab667-9011-35de-965e-8fa0d10d84cc",
                                "text": "La journée est trop belle pour rester encagé. Allons prendre l’air des champs !"
                            },
                            {
                                "example_id": "82f135c1-7de9-49a3-8525-ba31cd53fbe9",
                                "sense_id": "96fab667-9011-35de-965e-8fa0d10d84cc",
                                "text": "Diables noirs des patriotismes que, pour la peur réciproque des nations encagées, manient imprudemment des montreurs intéressés."
                            },
                            {
                                "example_id": "fa4968f0-ae9e-42ad-884d-68b683744f35",
                                "sense_id": "96fab667-9011-35de-965e-8fa0d10d84cc",
                                "text": "Mon cœur, petit animal encagé, se cogne à ses barreaux de chair."
                            },
                            {
                                "example_id": "1c3132c9-d481-4f1f-9198-771f57c601d9",
                                "sense_id": "96fab667-9011-35de-965e-8fa0d10d84cc",
                                "text": "Les fortifications d’acier poli élevées autour d’une femme anglaise, encagée dans son ménage par des fils d’or, mais où sa mangeoire et son abreuvoir, où ses bâtons et sa pâture sont des merveilles, lui prêtent d’irrésistibles attraits."
                            }
                        ]
                    }
