                "senses": [
                    {
                        "sense_id": "d7f26660-a77a-30bc-8175-972112acc543",
                        "entry_id": "35921419-75ef-3cd8-81a4-57a956754e31",
                        "glosses": [
                            "User de coquetterie ou échanger des propos galants."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "0363e0e5-12a2-46fe-b8f1-2fda9099da9d",
                                "sense_id": "d7f26660-a77a-30bc-8175-972112acc543",
                                "text": "Mais que deviendras-tu si, folle en son caprice, N’aimant que le scandale et l’éclat dans le vice, Bien moins pour son plaisir que pour t’inquiéter, Au fond peu vicieuse, elle aime à coquetter ?"
                            },
                            {
                                "example_id": "11d1591b-b1d6-4ced-a50d-adcb2ffc35dc",
                                "sense_id": "d7f26660-a77a-30bc-8175-972112acc543",
                                "text": "Le château, ranimé par un bain de soleil, se défublait de ses mines grognonnes, rajeunissait, s’affétait, coquettait, pour son départ."
                            }
                        ]
                    }
