                                "example_id": "3cc1c25f-5663-4320-b4cf-ab34f586a7a9",
                                "sense_id": "f4e336dc-66a9-32b7-a4f2-bef139438f06",
                                "text": "I won't soon forget Ben handing me the first of those printouts, literally covered with his notes, arrows, X's, redlinings...My heart sank."
                            }
                        ]
                    },
                    {
                        "sense_id": "2b61d368-0cd4-39e9-a36a-278a7f76b3d2",
                        "entry_id": "f5341a5a-bfc4-326d-a89b-3ce1c7dcdbad",
                        "glosses": [
                            "The systematic denial of various services to residents of specific, often racially associated, neighborhoods or communities, either directly or through the selective raising of prices."
                        ],
                        "tags": [
                            "Canada",
                            "US",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "61fcc11a-90c5-4394-a7b0-e7e7dd335791",
                                "sense_id": "2b61d368-0cd4-39e9-a36a-278a7f76b3d2",
                                "text": "Admittedly, our metropolitan plan was an exercise in hope. There were million reasons why it might not have worked. But it represented a responsible way to try to begin atoning for the public housing ghettos, the racial zoning and covenants, the redlining, the “Negro removal,” and the other policies and practices that had given us the two separate and unequal societies described by the Kerner report."
                            }
                        ]
