                            {
                                "example_id": "b48e7b28-c3bb-4fdd-af9b-848bae6c1d29",
                                "sense_id": "c4858d08-d774-3253-ac36-ac3b9662d320",
                                "text": "Tijdens een persconferentie in Leinster House heeft de minister-president van Stabiliteit vanochtend bevestigd dat de Pearl Occident Company de Leasegewesten Overeenkomst van 2028 waarin het Chinese consortium handelsrechten met de stad Cork en de West-Cork Nijverheidszone, beter bekend als de Leasegewesten, werden verleend eenzijdig heeft opgezegd"
                            }
                        ]
                    },
                    {
