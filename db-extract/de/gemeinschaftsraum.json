                "senses": [
                    {
                        "sense_id": "f52ac3c8-8fc8-3196-b08f-71f6941b2518",
                        "entry_id": "c15aba19-3267-3be5-a9a7-f7dad5586cf2",
                        "glosses": [
                            "zum Aufenthalt, als Treffpunkt oder für unterschiedliche Nutzung bestimmtes Zimmer, zu dem eine definierte Gruppe von Personen Zugang hat, wie beispielsweise Mitbewohner, Mitarbeiter, Mitschüler oder Vereinsmitglieder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c49764a-8ad4-469c-9a58-d672e7034db5",
                                "sense_id": "f52ac3c8-8fc8-3196-b08f-71f6941b2518",
                                "text": "In fast jedem Gefängnis gib es einen Gemeinschaftsraum."
                            },
                            {
                                "example_id": "8e6b7672-26c7-4746-b6a4-88cbf417b503",
                                "sense_id": "f52ac3c8-8fc8-3196-b08f-71f6941b2518",
                                "text": "„Gemeinsam mit einigen Mitarbeitern hat Nößler gerade erst an der Dart-WM auf Mallorca teilgenommen. Geübt wird täglich an der Dartscheibe, die im Gemeinschaftsraum der priorIT hängt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
