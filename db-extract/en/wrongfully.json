                "senses": [
                    {
                        "sense_id": "8fc22389-0a52-32fd-816e-aa04a0d4c2f8",
                        "entry_id": "59b0e3d7-4378-342d-ba6a-9ad6877f793f",
                        "glosses": [
                            "In a wrongful manner; unjustly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be15b660-996c-4659-a927-66c2cf1cd12b",
                                "sense_id": "8fc22389-0a52-32fd-816e-aa04a0d4c2f8",
                                "text": "If you do wrongfully ſeize Herford's right, / call in his Letters Patents that he hath / By his Atturneyes generall, to ſue[…]"
                            },
                            {
                                "example_id": "d71bd463-418f-4a02-a0ca-a665e3048299",
                                "sense_id": "8fc22389-0a52-32fd-816e-aa04a0d4c2f8",
                                "text": "There is a clear line of distinction in this matter. An equity judge could not unhang a man who had been wrongfully hanged; but he could set aside a precedent which was manifestly contrary to law and justice."
                            },
                            {
                                "example_id": "b85fb4ac-2987-46ce-8cae-75aa86237c6f",
                                "sense_id": "8fc22389-0a52-32fd-816e-aa04a0d4c2f8",
                                "text": "Wrongfully imprisoned action heroes rarely have the time to wait for an appeal."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
