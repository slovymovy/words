                ],
                "senses": [
                    {
                        "sense_id": "e8c1667b-5a70-34bd-b2e1-249206ce17f6",
                        "entry_id": "81d12ecb-686e-310f-a055-217006ca7349",
                        "glosses": [
                            "Behältnis, in dem physikalische oder chemische Reaktionen vor sich gehen"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "1d9da14b-8117-44fb-ba06-70ba78a152a6",
                                "sense_id": "e8c1667b-5a70-34bd-b2e1-249206ce17f6",
                                "text": "„Kalk und Sand werden im Verhältnis 1:12 unter Zugabe von Wasser gemischt und in den Reaktionsbehälter geleitet.“"
                            },
                            {
                                "example_id": "dcac940d-f06b-4ef3-bbe5-c5bf8aed4923",
                                "sense_id": "e8c1667b-5a70-34bd-b2e1-249206ce17f6",
                                "text": "„Der Multiparallelreaktor an der Chemnitzer Universität arbeitet mit 16 autonom und unabhängig voneinander laufenden Reaktionsbehältern.“"
                            },
                            {
                                "example_id": "bec7b431-7bd8-45f6-9dcc-db4a253d89f4",
                                "sense_id": "e8c1667b-5a70-34bd-b2e1-249206ce17f6",
                                "text": "„Ist der Reaktionsbehälter gefüllt, wird das Rührwerk gestartet und eine definierte Menge des Spaltmittels wird in die Lösung dosiert.“"
                            },
                            {
                                "example_id": "3561612b-d096-4ecb-bd69-fdd5dacac914",
                                "sense_id": "e8c1667b-5a70-34bd-b2e1-249206ce17f6",
                                "text": "„Um einen sicheren Prozess zu gewährleisten, muss der Füllstand im Reaktionsbehälter kontinuierlich überwacht werden.“"
                            },
                            {
                                "example_id": "9d42dfb6-ca57-473a-b61a-30583d8c33d1",
                                "sense_id": "e8c1667b-5a70-34bd-b2e1-249206ce17f6",
                                "text": "„Sowohl die Ausführung eines stabilen und sicheren Reaktionsbehälters als auch die Weiterentwicklung des Verfahrens bei höheren Reaktionstemperaturen wird mit diesen Werkstoffen gewährleistet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
