                ],
                "senses": [
                    {
                        "sense_id": "5c02357f-80c0-3aaa-acb7-136103dd0d34",
                        "entry_id": "141ea4af-a50f-34fc-809b-a7b1c328af51",
                        "glosses": [
                            "Angrenzung (Grenzlinie) zum Gegner"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f8ddfe6-cc14-4b9d-bfb5-db0253885d5d",
                                "sense_id": "5c02357f-80c0-3aaa-acb7-136103dd0d34",
                                "text": "„Ende Oktober 1944 stabilisiert sich die neue Frontlinie zunächst.“"
                            },
                            {
                                "example_id": "9781440f-99bf-401a-b5ea-9165f9a32f71",
                                "sense_id": "5c02357f-80c0-3aaa-acb7-136103dd0d34",
                                "text": "„Sie kannten die Wege durch die Frontlinien und halfen als Spione oder Kuriere, um Nachrichten aus der Stadt zu schmuggeln.“"
                            },
                            {
                                "example_id": "b998ccf2-ae64-4335-b7f9-ce9ae76a6e4d",
                                "sense_id": "5c02357f-80c0-3aaa-acb7-136103dd0d34",
                                "text": "„Von der Schelde-Mündung bis zum Oberlauf des Rheins gab es nun eine durchgehende Frontlinie.“"
                            },
                            {
                                "example_id": "69cc5e75-5dee-440f-89cb-19f81ba8a7d3",
                                "sense_id": "5c02357f-80c0-3aaa-acb7-136103dd0d34",
                                "text": "„Die Trommelschläge, die die Regimenter zur Frontlinie führten, leiteten das Schauspiel ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
