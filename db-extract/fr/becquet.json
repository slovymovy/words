                                "target_senses": [
                                    {
                                        "sense_id": "347ed1de-3225-3905-86c7-86f94a2ac1f2",
                                        "entry_id": "da84b120-81f8-3ac6-a001-404376a3b075",
                                        "glosses": [
                                            "One who spoils; a plunderer; a pillager; a robber; a despoiler."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5913d2e3-4184-314d-a5d0-4f3561ba800e",
                                        "entry_id": "da84b120-81f8-3ac6-a001-404376a3b075",
                                        "glosses": [
                                            "One who corrupts, mars, or renders useless."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8361f6f8-6640-366a-8c46-6a15d76e703c",
                                        "entry_id": "da84b120-81f8-3ac6-a001-404376a3b075",
                                        "glosses": [
                                            "A document, review or comment that discloses the ending or some key surprise or twist in a story, or the internal rules controlling the behaviour of a video game, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4228facd-9055-4102-a670-9086d25fccfa",
                                                "sense_id": "8361f6f8-6640-366a-8c46-6a15d76e703c",
                                                "text": "Good netiquette dictates that one warn of spoilers before discussing them, so that readers who wish to do so may experience the surprises for themselves."
                                            },
                                            {
                                                "example_id": "07e3c86f-6956-4f7c-963b-92c7309e5130",
                                                "sense_id": "8361f6f8-6640-366a-8c46-6a15d76e703c",
                                                "text": "Devotees of ‘expanded universe’ books say they will publish spoilers of latest film online unless Disney studio agrees to film their favourite stories"
                                            },
                                            {
                                                "example_id": "ae1136df-7b6b-4026-bb5d-e1b5bb5eb6c2",
                                                "sense_id": "8361f6f8-6640-366a-8c46-6a15d76e703c",
                                                "text": "TV shows and movies are a rare form of atemporality, and in an ever-changing, always-on world, spoilers feel irrefutable — sheer access to them gives the illusion of control."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1796d5b7-9b28-3f22-a182-35e7c267092f",
                                        "entry_id": "da84b120-81f8-3ac6-a001-404376a3b075",
                                        "glosses": [
                                            "A device to reduce lift and increase drag."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "63c33355-f382-3f78-b39b-67714d5d638c",
                                        "entry_id": "da84b120-81f8-3ac6-a001-404376a3b075",
                                        "glosses": [
                                            "A device to reduce lift and increase downforce."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d2243027-986f-3287-9760-1e90002fa6d5",
                                        "entry_id": "da84b120-81f8-3ac6-a001-404376a3b075",
                                        "glosses": [
                                            "A competitor, unable to win themselves, who spoils the chances of another’s victory."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "167b1b86-ba96-4288-8e7b-d70eb6695941",
                                                "sense_id": "d2243027-986f-3287-9760-1e90002fa6d5",
                                                "text": "The optimism at the opening of the talks could not be dampened even by a few spoilers."
                                            },
                                            {
                                                "example_id": "d938f8f9-75c1-41d0-a7fc-7277a42d0c3b",
                                                "sense_id": "d2243027-986f-3287-9760-1e90002fa6d5",
                                                "text": "Several experts do not believe Jorgensen was a Trump “spoiler” in 2020."
                                            },
                                            {
                                                "example_id": "bfccf1ff-768e-4bc7-adc0-40461153c359",
                                                "sense_id": "d2243027-986f-3287-9760-1e90002fa6d5",
                                                "text": "Shortly thereafter, came a torrent of nearly identical political fliers seemingly intended to siphon away support from Democratic candidates by tricking voters into casting their ballots for purported spoiler candidates who demonstrated no real interest in getting elected. […] Candidates for a state senate seat race in South Florida in which a spoiler appeared to help Republican challenger Ileana Garcia unseat incumbent Democrat Jose Javier Rodriguez."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "spoiler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c197f91-28e0-3174-8087-f2392337f015",
                                        "entry_id": "3346f7c0-0a90-398e-819e-5537c092f340",
                                        "glosses": [
                                            "To mark (a document or message) with a spoiler warning, to prevent readers from accidentally learning details they would prefer not to know."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fdacd2ff-d52c-3087-b8cf-cf5c74e9b9e0",
                                        "entry_id": "3346f7c0-0a90-398e-819e-5537c092f340",
                                        "glosses": [
                                            "To tell (a person) details of how a story ends etc."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c850754-b243-484b-9fa8-ba7dbad63ca8",
                                                "sense_id": "fdacd2ff-d52c-3087-b8cf-cf5c74e9b9e0",
                                                "text": "I've been spoilered, so I doubt I'll be able to enjoy the final episode."
                                            }
                                        ]
