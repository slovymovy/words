                                            {
                                                "example_id": "a3f3cff6-a7a0-4e74-9e43-f110be51f965",
                                                "sense_id": "4c2af886-b6a5-3230-9ec7-a1cb021157e5",
                                                "text": "Die pyromaan heeft nu al verscheidene branden gesticht."
