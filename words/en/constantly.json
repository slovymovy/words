                {
                    "sense_id": "157e0abe-7a1e-3337-8402-59cfe7738528",
                    "sense_definition": "With firm loyalty, resolution, or steadfastness.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He served his king <w>constantly</w> throughout the long and difficult war.",
                            "target_lang_translations": {
                                "ru": "Он <w>верно</w> служил своему королю на протяжении всей долгой и тяжелой войны.",
                                "tr": "Uzun ve zorlu savaş boyunca kralına <w>sadakatle</w> hizmet etti.",
                                "zh": "在漫长而艰难的战争中，他<w>忠诚地</w>侍奉着他的国王。",
                                "nl": "Hij diende zijn koning <w>trouw</w> tijdens de lange en moeilijke oorlog.",
                                "pl": "Służył swojemu królowi <w>wiernie</w> przez całą tę długą i trudną wojnę.",
                                "de": "Er diente seinem König während des langen und schweren Krieges <w>treu</w>.",
                                "fr": "Il servit son roi <w>avec constance</w> tout au long de cette guerre longue et difficile.",
                                "it": "Servì il suo re <w>fedelmente</w> per tutta la lunga e difficile guerra.",
                                "cs": "Během dlouhé a těžké války sloužil svému králi <w>věrně</w>.",
                                "es": "Sirvió a su rey <w>fielmente</w> a lo largo de la larga y difícil guerra.",
                                "ja": "彼は長く困難な戦争の間、国王に<w>忠実に</w>仕えました。",
                                "pt": "Serviu o seu rei <w>fielmente</w> durante toda a longa e difícil guerra."
                            }
                        },
                        {
