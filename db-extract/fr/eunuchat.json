                        "glosses": [
                            "Fonction ou rôle d'eunuque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03a3d054-d9ab-4b11-877a-f0886656851b",
                                "sense_id": "4650fc5e-09f6-3cdc-8971-f3a49d048bbf",
                                "text": "Il serait délicat d'insister sur les tires que Taxis avait fait valoir pour poser sa candidature à l'eunuchat général : délicat et d'ailleurs peu intéressant, - Taxis bénéficiait d'une vocation toute naturelle pour ce poste de privilège."
                            },
                            {
                                "example_id": "904cc792-9a53-4b5a-9b69-d4e74af6e9a4",
                                "sense_id": "4650fc5e-09f6-3cdc-8971-f3a49d048bbf",
                                "text": "Mais cette Novelle marque une régression dans la voie de la répression de l’eunuchat. Estimant l'ancienne législation trop draconienne, Léon VI abolissait la peine du talion contre les opérateurs et adoucissait les autres pénalités."
                            }
                        ]
                    }
