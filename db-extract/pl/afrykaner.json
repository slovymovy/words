                "senses": [
                    {
                        "sense_id": "bdd1207d-f039-39fa-b2f9-fdb00ce0eb86",
                        "entry_id": "de1e4451-d84d-3184-95b2-72b9b96d197a",
                        "glosses": [
                            "biały mieszkaniec Republiki Południowej Afryki oraz Namibii, potomek holenderskich kolonizatorów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a01ea21a-cbf7-4a20-a44f-494a2aec4771",
                                "sense_id": "bdd1207d-f039-39fa-b2f9-fdb00ce0eb86",
                                "text": "Od momentu powstania Związku Południowej Afryki Afrykanerzy współrządzili wraz z Brytyjczykami"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "313f548e-b223-4949-a195-a66d6d4753dd",
                        "source_entry_id": "de1e4451-d84d-3184-95b2-72b9b96d197a",
                        "source_sense_id": "bdd1207d-f039-39fa-b2f9-fdb00ce0eb86",
                        "target_lang_word": "Afrikaner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Afrikaner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a1dfa80f-9a1a-386b-b297-e7ad1a6766a0",
                                        "entry_id": "5b965154-5cea-384f-b03f-4a8d2412336b",
                                        "glosses": [
                                            "A member of an ethnic group of northwestern European ancestry and associated with southern Africa and the Afrikaans language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21cc0222-c839-428b-991b-29dddcf2bf04",
                                                "sense_id": "a1dfa80f-9a1a-386b-b297-e7ad1a6766a0",
                                                "text": "“Despite the Administration’s actions, CWS remains committed to serving all eligible refugee populations seeking safety in the United States, including Afrikaners who are eligible for services,” he said. “Our faith compels us to serve each person in our care with dignity and compassion.”"
                                            },
                                            {
                                                "example_id": "9cac347c-0470-4d5a-85b0-c318f34e7960",
                                                "sense_id": "a1dfa80f-9a1a-386b-b297-e7ad1a6766a0",
                                                "text": "In February, Trump suspended aid to South Africa, alleging discrimination against White farmers. In that same executive order, the president said the US would “promote the resettlement of Afrikaner refugees escaping government-sponsored race-based discrimination, including racially discriminatory property confiscation.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc7193f5-0c08-3d6c-8c71-4cf8124f4ce6",
                                        "entry_id": "5b965154-5cea-384f-b03f-4a8d2412336b",
                                        "glosses": [
                                            "A breed of cattle; Afrikander."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a52454df-bd36-4ab7-9a23-a1ff8aefc205",
                        "source_entry_id": "de1e4451-d84d-3184-95b2-72b9b96d197a",
                        "source_sense_id": "bdd1207d-f039-39fa-b2f9-fdb00ce0eb86",
                        "target_lang_word": "Afrikaner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Afrikaner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4bad3e00-9b2e-3cd2-9295-9088b44818d9",
                                        "entry_id": "3cf27fb0-066c-3131-9af6-74da60170e4c",
                                        "glosses": [
                                            "Sud-Africain blanc parlant l’afrikaans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfcf99a4-d1d5-45a5-8adc-9e6f3387342f",
                                                "sense_id": "4bad3e00-9b2e-3cd2-9295-9088b44818d9",
                                                "text": "L’Afrique du Sud, avec la fin de l’apartheid a vu ainsi affluer des migrants venus du Mozambique, de Zambie ou d’Angola quand les Afrikaners partaient vers l’Australie ou l’Amérique."
                                            },
                                            {
                                                "example_id": "8aff25d1-8cef-424c-87f0-a083c3ccc702",
                                                "sense_id": "4bad3e00-9b2e-3cd2-9295-9088b44818d9",
                                                "text": "François Hugo était un Afrikaner, un descendant de ces premiers colons hollandais, français ou allemands, tous fervents calvinistes, qui avaient débarqué dans la baie de la Table, non loin du Cap de Bonne-Espérance au XVIIe siècle. Mais lui préférait se définir comme un Burgher, un Boer. Un paysan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f3ba234-6408-45a7-9079-1e3dd9a12cfa",
                        "source_entry_id": "de1e4451-d84d-3184-95b2-72b9b96d197a",
                        "source_sense_id": "bdd1207d-f039-39fa-b2f9-fdb00ce0eb86",
