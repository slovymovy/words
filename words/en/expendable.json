{
    "word_family": [
        "expend",
        "expenditure",
        "expense",
        "expensive",
        "inexpendable"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7d4f7a48-841b-3da9-b376-7200d605b65a",
                    "sense_definition": "Regarded as not worth preserving or saving; able to be sacrificed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sacrificial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cruel commander treated ordinary soldiers as <w>expendable</w> pawns in his campaign.",
                            "target_lang_translations": {
                                "nl": "De wrede commandant behandelde gewone soldaten als <w>opofferbare</w> pionnen in zijn veldtocht."
                            }
                        },
                        {
                            "text": "During corporate restructuring, many low-level employees felt completely <w>expendable</w>.",
                            "target_lang_translations": {
                                "nl": "Tijdens de herstructurering van het bedrijf voelden veel werknemers op een laag niveau zich volkomen <w>misbaar</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "sacrificable"
                    ],
                    "antonyms": [
                        "essential",
                        "invaluable"
                    ],
                    "common_phrases": [
                        "feel expendable",
                        "considered expendable"
                    ],
                    "target_lang_definitions": {
                        "nl": "Beschouwd als niet de moeite waard om te behouden of te redden; opofferbaar."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "opofferbaar",
                                "target_lang_sense_clarification": "kunnen worden opgeofferd"
                            },
                            {
                                "target_lang_word": "misbaar",
                                "target_lang_sense_clarification": "niet onmisbaar, te vervangen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15fb41af-3439-3b1c-a9ee-6a7b6b46dd73",
                    "sense_definition": "Not essential or mandatory in order to achieve a goal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dispensable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The research department was deemed <w>expendable</w>, and its funding was not renewed.",
                            "target_lang_translations": {
                                "nl": "De onderzoeksafdeling werd als <w>misbaar</w> beschouwd en de financiering werd niet verlengd."
                            }
                        },
                        {
                            "text": "When reducing the project budget, luxuries were identified as <w>expendable</w> costs.",
                            "target_lang_translations": {
                                "nl": "Bij het verlagen van het projectbudget werden luxes aangemerkt als <w>overbodige</w> kosten."
                            }
                        }
                    ],
                    "synonyms": [
                        "dispensable",
                        "redundant",
                        "superfluous"
                    ],
                    "antonyms": [
                        "vital",
                        "necessary",
                        "essential"
                    ],
                    "common_phrases": [
                        "deemed expendable"
                    ],
                    "target_lang_definitions": {
                        "nl": "Niet noodzakelijk of essentieel om een doel te bereiken; overbodig."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "misbaar",
                                "target_lang_sense_clarification": "niet noodzakelijk"
                            },
                            {
                                "target_lang_word": "overbodig",
                                "target_lang_sense_clarification": "onnodig of overtollig"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17ad9b58-980e-36f1-8da7-3a52effeab21",
                    "sense_definition": "Designed for a single use or short life; not reusable.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disposable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The satellite was launched into orbit using an <w>expendable</w> rocket booster.",
                            "target_lang_translations": {
                                "nl": "De satelliet werd in een baan om de aarde gebracht met behulp van een <w>niet-herbruikbare</w> draagraket."
                            }
                        },
                        {
                            "text": "Engineers developed an <w>expendable</w> probe to measure the interior heat of the volcano.",
                            "target_lang_translations": {
                                "nl": "Ingenieurs ontwikkelden een <w>wegwerp-</w>sonde om de interne hitte van de vulkaan te meten."
                            }
                        }
                    ],
                    "synonyms": [
                        "disposable",
                        "throwaway"
                    ],
                    "antonyms": [
                        "reusable"
                    ],
                    "common_phrases": [
                        "expendable launch vehicle"
                    ],
                    "target_lang_definitions": {
                        "nl": "Ontworpen voor eenmalig gebruik; niet herbruikbaar."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "wegwerp-",
                                "target_lang_sense_clarification": "voor eenmalig gebruik"
                            },
                            {
                                "target_lang_word": "niet-herbruikbaar",
                                "target_lang_sense_clarification": "kan niet opnieuw gebruikt worden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b2f95f6-36c2-364c-95d9-4719377af52b",
                    "sense_definition": "Able to be completely consumed or used up; not inexhaustible.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "exhaustible",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fossil fuels are <w>expendable</w> supplies that will eventually run out.",
                            "target_lang_translations": {
                                "nl": "Fossiele brandstoffen zijn <w>uitputbare</w> voorraden die uiteindelijk op zullen raken."
                            }
                        },
                        {
                            "text": "Oil and other <w>expendable</w> resources are frequently the subject of military disputes.",
                            "target_lang_translations": {
                                "nl": "Olie en andere <w>eindige</w> hulpbronnen vormen regelmatig het onderwerp van militaire conflicten."
                            }
                        }
                    ],
                    "synonyms": [
                        "exhaustible",
                        "finite",
                        "limited"
                    ],
                    "antonyms": [
                        "inexhaustible",
                        "renewable"
                    ],
                    "common_phrases": [
                        "expendable resources",
                        "expendable supplies"
                    ],
                    "target_lang_definitions": {
                        "nl": "In staat om volledig verbruikt of opgebruikt te worden; uitputbaar."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "uitputbaar",
                                "target_lang_sense_clarification": "eindig, kan opraken"
                            },
                            {
                                "target_lang_word": "eindig",
                                "target_lang_sense_clarification": "beperkt in voorraad"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1b50ccae-c232-3862-89af-4b9052e7f7a9",
                    "sense_definition": "A person or item regarded as replaceable or capable of being sacrificed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sacrificial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In dangerous undercover operations, informants often fear they are treated merely as <w>expendables</w>.",
                            "target_lang_translations": {
                                "nl": "Bij gevaarlijke undercoveroperaties vrezen informanten vaak dat ze louter als <w>opofferbaar</w> worden behandeld."
                            }
                        },
                        {
                            "text": "The budget allocated money for expensive machinery, but not for minor office <w>expendables</w>.",
                            "target_lang_translations": {
                                "nl": "Het budget reserveerde geld voor dure machines, maar niet voor kleine <w>kantoorverbruiksartikelen</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een persoon of voorwerp dat als vervangbaar of opofferbaar wordt beschouwd, of een verbruiksartikel."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verbruiksartikelen",
                                "target_lang_sense_clarification": "goederen voor eenmalig gebruik of verbruik (meervoud)"
                            },
                            {
                                "target_lang_word": "opofferbaar persoon",
                                "target_lang_sense_clarification": "iemand die als vervangbaar wordt gezien"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}