                    "frequency": "VeryLow",
                    "semantic_group_id": "mythologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans la mythologie grecque, Zeus <w>foudroyant</w> punissait sans pitié les mortels imprudents."
