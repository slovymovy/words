                {
                    "sense_id": "6e735962-506f-38ef-a9b9-e177ef327af9",
                    "sense_definition": "Accroître l'intensité, l'importance, l'efficacité ou la portée de quelque chose d'abstrait.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "augmentation_abstraite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement souhaite <w>renforcer</w> les mesures de sécurité dans les gares.",
                            "target_lang_translations": {
                                "en": "The government wants to <w>strengthen</w> security measures at train stations.",
                                "ru": "Правительство хочет <w>усилить</w> меры безопасности на вокзалах.",
                                "de": "Die Regierung will die Sicherheitsmaßnahmen an Bahnhöfen <w>verstärken</w>.",
                                "es": "El Gobierno quiere <w>reforzar</w> las medidas de seguridad en las estaciones de tren.",
                                "zh": "政府希望<w>加强</w>火车站的安保措施。"
                            }
                        },
                        {
                            "text": "Cette victoire importante va certainement <w>renforcer</w> la confiance de tous les joueurs.",
                            "target_lang_translations": {
                                "en": "This important victory will certainly <w>bolster</w> the confidence of all the players.",
                                "ru": "Эта важная победа, несомненно, <w>укрепит</w> уверенность всех игроков.",
                                "de": "Dieser wichtige Sieg wird das Vertrauen aller Spieler sicherlich <w>stärken</w>.",
                                "es": "Esta importante victoria, sin duda, <w>reforzará</w> la confianza de todos los jugadores.",
                                "zh": "这场重要的胜利必定会<w>增强</w>所有球员的信心。"
                            }
                        }
                    ],
