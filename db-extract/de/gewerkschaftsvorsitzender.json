                ],
                "senses": [
                    {
                        "sense_id": "72ec2d15-5275-305e-accb-39dd30688c96",
                        "entry_id": "8d789b57-749c-34c5-9e4c-35519fe63ab0",
                        "glosses": [
                            "Vorsitzender eine Gewerkschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27811faa-98b9-4cc4-b29f-19b6ff532c00",
                                "sense_id": "72ec2d15-5275-305e-accb-39dd30688c96",
                                "text": "„Die Flitterwochen mit dem neuen Premier, den viele Gewerkschaftsvorsitzende lange Zeit für einen linken Labour-Politiker hielten, sind zwar vorbei.“"
                            },
                            {
                                "example_id": "2f05635f-37c0-402a-81c2-e2fcfb3f8caf",
                                "sense_id": "72ec2d15-5275-305e-accb-39dd30688c96",
                                "text": "„Man wolle auf Überlastung der Justizwachebeamten aufmerksam machen, kündigte der Gewerkschaftsvorsitzende Albin Simma an.“"
                            },
                            {
                                "example_id": "45cb8483-ca17-438b-9831-5327116a64d2",
                                "sense_id": "72ec2d15-5275-305e-accb-39dd30688c96",
                                "text": "„Verdi-Chef Bsirske geht es generell um die Aufwertung des Berufsfeldes der kommunalen Beschäftigten im Sozial- und Erziehungsdienst und nebenbei um die eigene Wiederwahl als Gewerkschaftsvorsitzender.“"
                            },
                            {
                                "example_id": "5c77c71c-92a7-42a3-9ae2-b97fcce55b64",
                                "sense_id": "72ec2d15-5275-305e-accb-39dd30688c96",
                                "text": "„An anderen Dienststellen würde der Personalmangel zu einer Besetzung von nur noch 70 Prozent führen, erklärt Gewerkschaftsvorsitzender Jörg Radek weiter.“"
                            },
                            {
                                "example_id": "352d864c-1e29-4831-874b-6c1b820cd101",
                                "sense_id": "72ec2d15-5275-305e-accb-39dd30688c96",
                                "text": "„‚Es wurde eine richtige Entscheidung getroffen, weil sie dazu beiträgt, die dringend benötigten Lehrkräfte im Land zu halten‘, erklärte der Gewerkschaftsvorsitzende Klaus-Peter Hammer.“"
                            },
                            {
                                "example_id": "b987c621-6b4a-4d19-b2ad-237ba51a742d",
                                "sense_id": "72ec2d15-5275-305e-accb-39dd30688c96",
                                "text": "„Aus Sicht des Gewerkschaftsvorsitzenden Jürgen Köhnlein handelt es sich dabei um einen Einzelfall.“"
                            },
                            {
                                "example_id": "edb6d576-65ec-4d69-9a42-fd5d239bafbb",
                                "sense_id": "72ec2d15-5275-305e-accb-39dd30688c96",
                                "text": "„Der Gewerkschaftsvorsitzende forderte die Innenminister dazu auf, mehr in die Ausstattung der Polizei zu investieren.“"
                            },
                            {
                                "example_id": "f65f21cc-2a5b-4619-824c-5285a2f0737b",
                                "sense_id": "72ec2d15-5275-305e-accb-39dd30688c96",
                                "text": "„Noch nie sei man derart unterstützt worden, sagt Gewerkschaftsvorsitzender Anton Polivka.“"
                            },
                            {
                                "example_id": "64307e6e-e1e6-479e-85f9-c7c6f12ca1e9",
                                "sense_id": "72ec2d15-5275-305e-accb-39dd30688c96",
                                "text": "„Von Mittwoch bis Montag ruft der Gewerkschaftsvorsitzende Claus Weselsky seine Mitglieder zur Arbeitsniederlegung auf.“"
                            },
                            {
                                "example_id": "40a14378-9307-4dff-9189-212d34e301a2",
                                "sense_id": "72ec2d15-5275-305e-accb-39dd30688c96",
                                "text": "„Der aus Herzogenrath stammende Mertens wird auf seine langjährige Tätigkeit als Gewerkschaftsvorsitzender zurückblicken, aber auch die sicherheitspolitischen Vorhaben der neuen Bundesregierung kritisch betrachten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
