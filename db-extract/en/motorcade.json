                "senses": [
                    {
                        "sense_id": "12c94536-62eb-364b-8746-f7fbeb99054d",
                        "entry_id": "9657db13-d234-3ec9-a55f-9acea311e741",
                        "glosses": [
                            "A procession of cars carrying VIPs, especially political figures."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4112626e-ea85-4d7b-8c08-fc7ede3864e6",
                                "sense_id": "12c94536-62eb-364b-8746-f7fbeb99054d",
                                "text": "JFK was assassinated in a motorcade."
                            },
                            {
                                "example_id": "3c503eca-6082-486f-aa2c-992a8ceac48b",
                                "sense_id": "12c94536-62eb-364b-8746-f7fbeb99054d",
                                "text": "The aide rides, along with the president's physician, in the “control car,” third in line in the motorcade."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e433202d-3707-4dd9-9e5a-2a81ac4dfebf",
                        "source_entry_id": "9657db13-d234-3ec9-a55f-9acea311e741",
                        "source_sense_id": "12c94536-62eb-364b-8746-f7fbeb99054d",
                        "source_sense_description": "procession of cars",
                        "target_lang_word": "autocolonne",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autocolonne",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "65f55c71-65e7-3741-b8b0-f03d1a4d22ad",
                                        "entry_id": "b6de917c-109d-34d6-a0a4-dd6f28abb2db",
                                        "glosses": [
                                            "een rij auto's die samen van de ene naar de andere plaats rijden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6262faf0-cf3b-4506-aecd-7ce04b22a81d",
                                                "sense_id": "65f55c71-65e7-3741-b8b0-f03d1a4d22ad",
                                                "text": "De autocolonne van de Zweedse kroonprinses Victoria heeft in Uppsala een verkeersongeluk veroorzaakt."
                                            },
                                            {
                                                "example_id": "346871d8-b27e-4c0d-8dd9-414109b2eef8",
                                                "sense_id": "65f55c71-65e7-3741-b8b0-f03d1a4d22ad",
                                                "text": "Vanaf het stadion van FC Groningen zal een autocolonne vertrekken en een rondje langs de gasvelden maken. Na de demonstratie wordt een eisenlijst opgesteld die de FNV aan minister Kamp wil overhandigen."
                                            },
                                            {
                                                "example_id": "3dc61dad-8b67-40d1-814c-e3853da451c8",
                                                "sense_id": "65f55c71-65e7-3741-b8b0-f03d1a4d22ad",
                                                "text": "Na de mislukte Varkensbaai-invasie in 1961 moesten CIA-baas Allen Dulles en tweede man Charles Cabell het veld ruimen. Cabells broer Earle was burgemeester van Dallas op die beruchte dag in november 1963. Deze burgemeester zou op het laatste moment de route die Kennedy aflegde hebben veranderd. In plaats via Main Street ging de autocolonne over Elm Street, langs het schoolboekenmagazijn van waaruit Kennedy werd doodgeschoten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef9bc524-221b-4bbe-b868-9c3f276d5968",
                        "source_entry_id": "9657db13-d234-3ec9-a55f-9acea311e741",
                        "source_sense_id": "12c94536-62eb-364b-8746-f7fbeb99054d",
