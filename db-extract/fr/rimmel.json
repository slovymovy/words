                    {
                        "sense_id": "39eb0b27-2b15-3521-beb4-e9e7fcd3a34f",
                        "entry_id": "8490ee9f-5768-3373-aa38-06712d46e481",
                        "glosses": [
                            "Produit cosmétique qui surligne les yeux et colore les cils."
                        ],
                        "tags": [
                            "Cosmétologie"
                        ],
                        "examples": [
                            {
                                "example_id": "7e6d8586-10dd-4ec9-bdd7-27048ce59939",
                                "sense_id": "39eb0b27-2b15-3521-beb4-e9e7fcd3a34f",
                                "text": "Son visage était maquillé en épaisseur. Un fort poids de rimmel lui donnait le regard éperdu et vitreux des vieilles idoles. Ses lèvres étaient collées de fard."
                            },
                            {
                                "example_id": "7af4bf43-354b-4e7e-8e0a-196892714e45",
                                "sense_id": "39eb0b27-2b15-3521-beb4-e9e7fcd3a34f",
                                "text": "Jolie môme\n T’ as l’ rimmel\n Qui fout l’ camp\n C’est l’ dégel\n Des amants\n Jolie môme"
                            },
                            {
                                "example_id": "3cdb7a8b-ff4f-48cf-bd39-05ff2295ec05",
                                "sense_id": "39eb0b27-2b15-3521-beb4-e9e7fcd3a34f",
                                "text": "Elle avait économisé sur ses heures de baby-sitting, et à Paris elle s'achèterait son premier jean et son premier rimmel."
                            }
                        ]
                    }
                ],
