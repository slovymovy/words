                                "example_id": "464e866c-cbfd-4d96-b8bd-8a3c3fd325b1",
                                "sense_id": "ec54f2cf-e3c3-332e-9315-7b4aaef55002",
                                "text": "„Ashcroft stellte uns Lieutenant Colonel Martin Gregson vor, den britischen Befehlshaber der Truppen an Bord der drei Transportschiffe.“"
                            },
                            {
                                "example_id": "0d6f0677-e73b-4d97-8124-6cdc2b91c6b7",
                                "sense_id": "ec54f2cf-e3c3-332e-9315-7b4aaef55002",
                                "text": "„Am selben Tag passierten wir einen Konvoi Transportschiffe, die eine Brigade von Pendennis Castle nach Yarmouth brachte, um sich dort der Hauptflotte anzuschließen.“"
                            }
