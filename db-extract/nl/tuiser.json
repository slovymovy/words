                            {
                                "example_id": "2d776883-b85b-4cba-a123-f66580eb5ad8",
                                "sense_id": "0ad86007-1fca-32cf-9930-5a2565c8da38",
                                "text": "Een tuiser of tuischer, zoals men vroeger schreef, is een speler, een dobbelaar, iemand die \"zich overgeeft aan het spel genaamd tuischen\". De spel-betekenis, zo veronderstelde ik twee weken geleden, is vermoedelijk afgeleid van de oudere betekenis van tuisen: \"wisselen, ruilen\". De Standaard 25 OKTOBER 2004 OM 00:00 UUR"
                            }
                        ]
                    },
