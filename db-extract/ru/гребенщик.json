                "senses": [
                    {
                        "sense_id": "96a62bf8-cf81-3e23-8d19-9a71da1dc5f6",
                        "entry_id": "8337f8b8-e2f7-3c9f-82b7-e6043ad95782",
                        "glosses": [
                            "кустарниковое растение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efafd843-fa93-4652-92ea-0d8ae28ee05d",
                                "sense_id": "96a62bf8-cf81-3e23-8d19-9a71da1dc5f6",
                                "text": "Тамариск (лат.), гребенщик ― небольшое дерево или кустарник из сем. гребенщиковых, обладающее приспособлениями для борьбы с засухой ― игловидными листьями и отложениями солей на листьях."
                            },
                            {
                                "example_id": "6789e56c-568d-40f4-95a9-2a6bfba8de3e",
                                "sense_id": "96a62bf8-cf81-3e23-8d19-9a71da1dc5f6",
                                "text": "Все виды гребенщиков в той или иной степени являются солевыносливыми."
                            }
                        ]
                    }
                ],
