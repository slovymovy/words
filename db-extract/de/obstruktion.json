                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26ba956f-57f9-4c0d-a3f9-e0d6dd5b1146",
                                                "sense_id": "8e1085d6-4785-36b3-b6b8-ec983c5ea5f9",
                                                "text": "Faire de l’obstruction."
