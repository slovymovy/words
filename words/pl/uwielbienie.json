                        "nienawiść",
                        "wstręt"
                    ],
                    "common_phrases": [
                        "ślepe uwielbienie",
                        "patrzeć z uwielbieniem",
                        "darzyć uwielbieniem"
                    ],
                    "target_lang_definitions": {
                        "en": "deep admiration, love, boundless respect, or reverence shown to someone or something"
                    },
                    "translations": {
