                    "target_lang_definitions": {
                        "ru": "Способ возобновления игры в хоккее на траве, при котором два игрока ударяют клюшками друг о друга перед ударом по мячу.",
                        "nl": "Een methode om het spel bij hockey te hervatten waarbij twee tegenstanders hun hockeysticks tegen elkaar tikken voordat ze de bal proberen te raken.",
                        "de": "Eine Methode zur Spielfortsetzung beim Hockey, bei der zwei Spieler ihre Schläger gegeneinander schlagen, bevor sie den Ball spielen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спорный мяч",
                                "target_lang_sense_clarification": "розыгрыш мяча"
                            },
                            {
                                "target_lang_word": "вбрасывание",
                                "target_lang_sense_clarification": "ввод мяча в игру"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "bully",
                                "target_lang_sense_clarification": "de officiële term voor deze spelhervatting in het hockey"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Bully",
                                "target_lang_sense_clarification": "die offizielle Bezeichnung für diese Spielfortsetzung im Hockey"
                            }
                        ]
                    }
