                        "sense_id": "db456025-b1c9-3674-941d-e0f92cc4100c",
                        "entry_id": "38dd7277-f499-39cd-bcda-4cf9aa54157e",
                        "glosses": [
                            "een schiereiland in het noordwesten van Frankrijk"
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "6a8e6b51-7f93-4cbf-a91c-dfda2feee219",
                                "sense_id": "db456025-b1c9-3674-941d-e0f92cc4100c",
                                "text": "In delen van Bretagne wordt nog een Keltische taal, het Bretons, gesproken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d2b02aa-1e3e-4658-9ae0-24042e6141f9",
                        "source_entry_id": "38dd7277-f499-39cd-bcda-4cf9aa54157e",
                        "source_sense_id": "db456025-b1c9-3674-941d-e0f92cc4100c",
                        "source_sense_description": "een schiereiland in het noordwesten van Frankrijk",
                        "target_lang_word": "Bretagne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bretagne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "71ca958f-c993-38d1-864c-e3d1a3a884f9",
                                        "entry_id": "c8916920-0b9d-374a-971c-0dc1fe7996db",
                                        "glosses": [
                                            "Region im Nordwesten Frankreichs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40cf2353-fb78-4ff8-bf8a-4dbbd3e2ee7a",
                                                "sense_id": "71ca958f-c993-38d1-864c-e3d1a3a884f9",
                                                "text": "Wir fahren im Sommer in die Bretagne."
                                            },
                                            {
                                                "example_id": "a4b643ac-c11f-4266-b974-437b354652f1",
                                                "sense_id": "71ca958f-c993-38d1-864c-e3d1a3a884f9",
                                                "text": "„Napoleon schuf damit eine französische Identität, die sich auf gallische und römische Traditionen berief – auch, um separatistischen Tendenzen in der Bretagne zu begegnen.“"
                                            },
                                            {
                                                "example_id": "4c2057d0-38e5-49ca-9929-333a3208df68",
                                                "sense_id": "71ca958f-c993-38d1-864c-e3d1a3a884f9",
                                                "text": "„Das war jedoch kein Grund, die Reise in die Bretagne aufzugeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "eef7ffd6-ead2-31a6-b6e2-351b33c9bd18",
                                        "entry_id": "c8916920-0b9d-374a-971c-0dc1fe7996db",
                                        "glosses": [
                                            "größte Halbinsel Frankreichs"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8f75384-02b6-4f1a-b5b5-2233b6beb628",
                        "source_entry_id": "38dd7277-f499-39cd-bcda-4cf9aa54157e",
                        "source_sense_id": "db456025-b1c9-3674-941d-e0f92cc4100c",
                        "source_sense_description": "een schiereiland in het noordwesten van Frankrijk",
                        "target_lang_word": "Brittany",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brittany",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5f7439c-80aa-35c1-b8b9-e2ea39c66c6d",
                                        "entry_id": "fc20cabc-2cf4-3cbd-a379-a504d851e31f",
                                        "glosses": [
                                            "A cultural region, historical province, and peninsula in northwest France."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b5424db-d032-4b29-84a4-a8ae471fcddf",
                                                "sense_id": "c5f7439c-80aa-35c1-b8b9-e2ea39c66c6d",
                                                "text": "First, will I see the Coronation, / And then to Britanny Ile crosse the Sea, / To effect this marriage, so it please my Lord."
                                            },
                                            {
                                                "example_id": "f3dbd663-1efe-45b9-9db9-620cb59f889f",
                                                "sense_id": "c5f7439c-80aa-35c1-b8b9-e2ea39c66c6d",
                                                "text": "So Aurelius Ambrosius and Uther Pendragon fled away to that part of France called Brittany, where they remained in saftey for many years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "918595d2-61a5-3e5c-953e-be673eb97f61",
                                        "entry_id": "fc20cabc-2cf4-3cbd-a379-a504d851e31f",
                                        "glosses": [
                                            "An administrative region of northwest France, including most of the historic region of Brittany."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c29a67bc-779a-3c0e-a53d-074eee1202b8",
                                        "entry_id": "fc20cabc-2cf4-3cbd-a379-a504d851e31f",
                                        "glosses": [
                                            "The British Isles."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3fbe70e-f7c3-4028-b6ae-354d9983c836",
                                                "sense_id": "c29a67bc-779a-3c0e-a53d-074eee1202b8",
                                                "text": "The noble Thamis […] seem'd to stoupe afore / With bowed backe, by reason of the lode / And auncient heavy burden which he bore / Of that faire City, wherein make abode / So many learned impes, that shoote abrode, / And with their braunches spred all Britany […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "153f413d-ac50-3c2d-8523-15be4ebab307",
                                        "entry_id": "fc20cabc-2cf4-3cbd-a379-a504d851e31f",
                                        "glosses": [
                                            "A female given name transferred from the place name, of 1980s and 1990s American usage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b604d047-0f2d-499c-933b-f032f9c2a5ac",
                                                "sense_id": "153f413d-ac50-3c2d-8523-15be4ebab307",
                                                "text": "- - - No one has family names. These girls with rooster hair I see on the streets. They pick the names. They're the mothers.\" \"I have a granddaughter named Brittany,\" Hazel said. \" And I have heard of a little girl called Cappuccino.\" \"Cappuccino! Is that true? Why don't they call one Cassaulet? Fettuccini? Alsace-Lorraine?\""
                                            },
                                            {
                                                "example_id": "306e6866-ae54-4837-a9e8-2fab6050b4da",
                                                "sense_id": "153f413d-ac50-3c2d-8523-15be4ebab307",
                                                "text": "Names of the times. Borrowed from soap opera characters of prominence fifteen years ago, who have since been replaced by spiffy new models: the social-climbing Brittany now an unscrupulous Burke, the generous Pamela a refitted, urbanized Parker."
                                            },
                                            {
                                                "example_id": "e3e30a72-212f-490e-b08a-e8baeb01f435",
                                                "sense_id": "153f413d-ac50-3c2d-8523-15be4ebab307",
                                                "text": "The leading voices of the womanosphere are using a similar strategy. As Brittany Hugoboom put it in an op–ed for the rightwing outlet Quillette: “Conservatives will never win if they imagine themselves as combatants atop defensive battlements, hurling abuse on the mass media. We need to involve ourselves in the creation of pop culture.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Brittany",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4be003e3-f65a-3103-aa29-f51cce5f050c",
                                        "entry_id": "dd3c8326-423e-3f2b-abc0-fffe330ceb53",
                                        "glosses": [
                                            "A coward."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "33629b4c-bdfa-3e9b-8829-169156e24f41",
                                        "entry_id": "dd3c8326-423e-3f2b-abc0-fffe330ceb53",
                                        "glosses": [
                                            "A gun dog of a particular breed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b794b64b-e8a0-4b90-a8a3-2b6dd7b714b5",
                                                "sense_id": "33629b4c-bdfa-3e9b-8829-169156e24f41",
                                                "text": "A dish face is not desirable in the Brittany. A dished or upturned muzzle is considered a fault in the Redbone Coonhound."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19cceacb-4357-49e7-b19d-e6987e8c05d5",
                        "source_entry_id": "38dd7277-f499-39cd-bcda-4cf9aa54157e",
                        "source_sense_id": "db456025-b1c9-3674-941d-e0f92cc4100c",
                        "source_sense_description": "een schiereiland in het noordwesten van Frankrijk",
                        "target_lang_word": "Bretagne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bretagne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9dc6367c-c17b-3a6b-8fa3-0f46d3efbbb7",
                                        "entry_id": "53658112-1045-3023-9f1a-39d48e6ab414",
                                        "glosses": [
                                            "Grande péninsule de l’ouest de la France s'identifiant avec la région historique dont la superficie avoisine celle des cinq départements qui se situent sur ce territoire : le Finistère, le Morbihan, l’Ille-et-Vilaine, la Loire-Atlantique et les Côtes-d’Armor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13f3202d-d55c-41f6-a2bf-2d9c4d3a0cbf",
                                                "sense_id": "9dc6367c-c17b-3a6b-8fa3-0f46d3efbbb7",
                                                "text": "Il ne faut pas croire que tous les chevaux qui s’élèvent dans le Perche y soient nés; les éleveurs vont les chercher en Bretagne, en Franche-Comté, en Bourgogne, en Poitou."
                                            },
                                            {
                                                "example_id": "6751817c-9e67-4a2c-9a49-5724d56daba8",
                                                "sense_id": "9dc6367c-c17b-3a6b-8fa3-0f46d3efbbb7",
                                                "text": "Mais l’odeur dépassait tout. Pour en trouver l’équivalent, il me fallait combiner en mon esprit celle qui règne chez les doux Chippewayans – les seuls sauvages vraiment sales – et les Esquimaux. Même en y ajoutant le relent propre aux demeures islandaises des pêcheries du lac Winnipeg, je n’arrivais pas à trouver un équivalent. Grâce à la Bretagne, la France battait enfin un record !"
                                            },
                                            {
                                                "example_id": "7cb73dff-52b4-4820-8782-eb545370c9b1",
                                                "sense_id": "9dc6367c-c17b-3a6b-8fa3-0f46d3efbbb7",
                                                "text": "Que la Bretagne, considérée dans son ensemble, soit encore aujourd’hui, une province de zélée pratique religieuse, voilà, je crois, un point qui ne sera contesté sérieusement par personne."
                                            },
                                            {
                                                "example_id": "8e4e5c38-a98b-4e67-907e-0888325d5353",
                                                "sense_id": "9dc6367c-c17b-3a6b-8fa3-0f46d3efbbb7",
                                                "text": "La Rochefortaise Violette Dorange (« Devenir »), désormais basée en Bretagne, à Port-la-Forêt, a elle aussi un bel appétit."
                                            },
                                            {
                                                "example_id": "8c6582aa-a7d8-4915-908a-d0f1e277dd4a",
                                                "sense_id": "9dc6367c-c17b-3a6b-8fa3-0f46d3efbbb7",
                                                "text": "Ailleurs ce sont des landes où poussent de durs petits buissons, la mer qu'on sent et qu'on devnie, l'âpreté, la virilité. Terre à tempête. Endroit de semaine. Bretagne. Je préfère ce pays à celui du sud qui est au bord de la Méditerranée, peut-être parce qu'il ressemble plus à la Gaspésie de mon pays. J'aime moins le sud où c'est tous les jours dimanche."
                                            },
                                            {
                                                "example_id": "844ca216-f411-4c9c-9678-7ec80e4a3f29",
                                                "sense_id": "9dc6367c-c17b-3a6b-8fa3-0f46d3efbbb7",
                                                "text": "Il ne saurait être question en Bretagne d’un État impérialiste au point de galliciser les Bretonnants pas plus que celtiser linguistiquement les Bretons Gallots."
                                            },
                                            {
                                                "example_id": "d747cf54-bb2a-4d0d-b372-a27067cffa23",
                                                "sense_id": "9dc6367c-c17b-3a6b-8fa3-0f46d3efbbb7",
                                                "text": "Moi je rigole quand je pense\nÀ ceux qui partent en vacances\nEn Bretagne ou en Provence\nRien ne vaut l’air de Paris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ea474d2-0ee1-3a30-9296-bd778df0a30d",
                                        "entry_id": "53658112-1045-3023-9f1a-39d48e6ab414",
                                        "glosses": [
                                            "Ancien royaume, puis duché rattaché au royaume de France."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dbe6254-d0b1-4500-9112-7056c3ea6e26",
                                                "sense_id": "2ea474d2-0ee1-3a30-9296-bd778df0a30d",
                                                "text": "Le lendemain, il prend le château de Damville, à vingt kilomètres de Verneuil, et regagne ensuite Rouen, d’où il envoie aussitôt ses mercenaires en Bretagne, vers Fougères et Dol."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e62f6ee4-bd2e-3652-b6e6-a25a5d14b387",
                                        "entry_id": "53658112-1045-3023-9f1a-39d48e6ab414",
                                        "glosses": [
                                            "Région administrative française composée de quatre départements : le Finistère, le Morbihan, l’Ille-et-Vilaine et les Côtes-d’Armor."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
