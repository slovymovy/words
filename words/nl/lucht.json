                    "sense_id": "feee6172-fe35-39a2-b7db-85772e4b38bb",
                    "sense_definition": "Het onzichtbare mengsel van gassen dat de aarde omringt en dat mensen en dieren inademen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "group_gas",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik zet het raam even open voor wat frisse <w>lucht</w>.",
                            "target_lang_translations": {
                                "en": "I'm opening the window for some fresh <w>air</w>.",
                                "ru": "Я ненадолго открою окно, чтобы впустить свежий <w>воздух</w>.",
                                "pl": "Otworzę na chwilę okno, żeby wpuścić trochę świeżego <w>powietrza</w>.",
                                "de": "Ich mache kurz das Fenster auf für etwas frische <w>Luft</w>.",
                                "fr": "J'ouvre un peu la fenêtre pour avoir de l'<w>air</w> frais.",
                                "it": "Apro un attimo la finestra per un po' d'aria <w>fresca</w>.",
                                "cs": "Otevřu na chvíli okno, abych pustil trochu čerstvého <w>vzduchu</w>.",
                                "tr": "Biraz temiz <w>hava</w> almak için pencereyi açıyorum.",
                                "es": "Abro la ventana un momento para que entre un poco de <w>aire</w> fresco."
                            }
                        },
                        {
                            "text": "Zonder <w>lucht</w> kunnen mensen en dieren niet leven.",
                            "target_lang_translations": {
                                "en": "Without <w>air</w>, people and animals cannot live.",
                                "ru": "Без <w>воздуха</w> люди и животные не могут жить.",
                                "pl": "Bez <w>powietrza</w> ludzie i zwierzęta nie mogą żyć.",
                                "de": "Ohne <w>Luft</w> können Menschen und Tiere nicht leben.",
                                "fr": "Sans <w>air</w>, les humains et les animaux ne peuvent pas vivre.",
                                "it": "Senza <w>aria</w> le persone e gli animali non possono vivere.",
                                "cs": "Bez <w>vzduchu</w> nemohou lidé ani zvířata žít.",
                                "tr": "İnsanlar ve hayvanlar <w>hava</w> olmadan yaşayamazlar.",
                                "es": "Sin <w>aire</w>, las personas y los animales no pueden vivir."
                            }
                        }
                    ],
                    "synonyms": [
                        "atmosfeer"
                    ],
                    "common_phrases": [
                        "frisse lucht",
                        "in de open lucht",
                        "lucht scheppen"
                    ],
                    "target_lang_definitions": {
                        "en": "The invisible mixture of gases that surrounds the earth and that people and animals breathe.",
                        "ru": "Невидимая смесь газов, окружающая Землю, которой дышат люди и животные.",
                        "pl": "Niewidzialna mieszanina gazów otaczająca Ziemię, którą oddychają ludzie i zwierzęta.",
                        "de": "Das unsichtbare Gasgemisch, das die Erde umgibt und das Menschen und Tiere einatmen.",
                        "fr": "Le mélange invisible de gaz qui entoure la Terre et que les humains et les animaux respirent.",
                        "it": "La miscela invisibile di gas che circonda la terra e che le persone e gli animali respirano.",
                        "cs": "Neviditelná směs plynů, která obklopuje Zemi a kterou lidé a zvířata dýchají.",
                        "tr": "Dünyayı çevreleyen, insanların ve hayvanların soluduğu görünmez gaz karışımı.",
                        "es": "La mezcla invisible de gases que rodea la Tierra y que respiran las personas y los animales."
