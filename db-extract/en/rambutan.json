                                "target_senses": [
                                    {
                                        "sense_id": "2e8618d3-490a-3ec6-93f7-d41ddef47382",
                                        "entry_id": "7b87ff7a-cb89-3c87-8f11-09216fb387c6",
                                        "glosses": [
                                            "Nom vernaculaire de Nephelium lappaceum, arbre de la famille des Sapindacées (Sapindaceae, originaire d’Asie et dont le fruit qui ressemble au litchi est comestible."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8ba74a5b-cee9-34ae-8a75-08e89aecf699",
                                        "entry_id": "7b87ff7a-cb89-3c87-8f11-09216fb387c6",
                                        "glosses": [
                                            "Fruit de cet arbre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b87168a-f856-4244-bced-7adb0de432be",
                                                "sense_id": "8ba74a5b-cee9-34ae-8a75-08e89aecf699",
                                                "text": "Le ramboutan. Ce fruit est peu connu aux Européens. II ressemble beaucoup à la châtaigne enveloppée de sa gousse, et comme elle, il est couvert de petites pointes émoussées et d'un rouge foncé. Le fruit se trouve sous cette peau, et il y a un noyau en dedans du fruit. La partie bonne à manger est en petite quantité ; mais son acide est peut-être plus agréable que celui d'aucun des autres végétaux."
                                            },
                                            {
                                                "example_id": "ea5e72b9-b414-494a-a9d4-aba04d8c5183",
                                                "sense_id": "8ba74a5b-cee9-34ae-8a75-08e89aecf699",
                                                "text": "Le litchi et le ramboutan sont cultivés pour leurs fruits qui sont généralement consommés crus. Ils sont riches en vitamine C et en glucides […] Les noyaux grillés du ramboutan donnent une graisse entrant dans la fabrication des bougies (Asie)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "507ed621-794f-45a7-acf0-6484b6ee69c1",
                        "source_entry_id": "41317a1e-8268-319b-9355-d1ae0708ae47",
                        "source_sense_description": "fruit",
                        "target_lang_word": "litchi chevelu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "litchi chevelu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e86c3a2-7c73-3e39-b849-035e839ef8a7",
                                        "entry_id": "541f676c-43cb-3a92-9628-99447bea74ad",
                                        "glosses": [
                                            "Synonyme de ramboutan (fruit et plante)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05e96b23-d1b4-4504-9458-94d81c9f0ed7",
                                                "sense_id": "5e86c3a2-7c73-3e39-b849-035e839ef8a7",
                                                "text": "Les exigences climatiques varient selon les espèces : le ramboutan (litchi chevelu) est une essence tropicale et le litchi est une essence de climat tropical à saison froide marquée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52dfbed8-6f0f-44d4-91b1-42f84af692c9",
                        "source_entry_id": "41317a1e-8268-319b-9355-d1ae0708ae47",
                        "source_sense_description": "fruit",
                        "target_lang_word": "Rambutan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rambutan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "16c52a84-1ce9-338e-bce3-7e4265360f9a",
                                        "entry_id": "7f7ccd6f-008e-3d94-aab6-17ea92a1d493",
                                        "glosses": [
                                            "Pflanzenart innerhalb der Familie der Seifenbaumgewächse (Sapindaceae)"
                                        ],
                                        "tags": [
                                            "nur",
                                            "maskulin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4075d68-e735-40c0-ba11-a7df3fdb9927",
                                                "sense_id": "16c52a84-1ce9-338e-bce3-7e4265360f9a",
                                                "text": "„Das Tal des Flusses Ayung eignet sich gut für das Gedeihen des Rambutan, da es tiefgründige und dränierte Sedimente aufweist und durch die Kanalisierung eine gleichmäßige Bewässerung stattfinden kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b0972456-2efe-338d-bc6d-db25897c105b",
                                        "entry_id": "7f7ccd6f-008e-3d94-aab6-17ea92a1d493",
                                        "glosses": [
                                            "etwa pflaumengroße, rotbraune, mit langen, weichen Stacheln bedeckte Frucht von [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fa9a22d-06aa-45f3-a6ac-e2cdce59bd34",
                                                "sense_id": "b0972456-2efe-338d-bc6d-db25897c105b",
                                                "text": "„Von der nämlichen Größe ist auch der Rambutan (nephelium lapsaceum).“"
                                            },
                                            {
                                                "example_id": "9a805d03-dca3-444f-8077-f16ad161a19a",
                                                "sense_id": "b0972456-2efe-338d-bc6d-db25897c105b",
                                                "text": "„Trage die tiefen Seufzer zu jenen, die unserm Blick entschwunden, In das Land, wo der rote reife Rambutan wächst!“"
                                            },
                                            {
                                                "example_id": "0e04be8c-dea1-4fdd-9170-7c2a8c22d462",
                                                "sense_id": "b0972456-2efe-338d-bc6d-db25897c105b",
                                                "text": "„Dafür blieb mir die haarige Litschi – pardon – die Rambutan verwehrt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
