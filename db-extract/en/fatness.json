                "senses": [
                    {
                        "sense_id": "c1cf09eb-81a7-3c38-bcbd-7258de6e5abb",
                        "entry_id": "a610bf5b-d8b1-3ac9-89ec-1c1c9fc6d777",
                        "glosses": [
                            "The state, quality, or condition of being fat."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8a08d3a7-7d5b-40fd-83cb-9a60a4c08dac",
                                "sense_id": "c1cf09eb-81a7-3c38-bcbd-7258de6e5abb",
                                "text": "Bread made of Pannick nouriſheth little, and is cold and dry, verie brittle, hauing in it neither clammineſſe, nor fatneſſe; and therefore it drieth a moiſt belly."
                            },
                            {
                                "example_id": "d27af340-8d14-425b-a9fd-28d736a89bd9",
                                "sense_id": "c1cf09eb-81a7-3c38-bcbd-7258de6e5abb",
                                "text": "As therefore the morning devv, is a pavvne of the evenings fatneſſe, ſo, O Lord, let this daies comfort be the earneſt of to morrowes, […]"
                            },
                            {
                                "example_id": "f332152b-d4e5-4056-8cd5-b7591a59c7f1",
                                "sense_id": "c1cf09eb-81a7-3c38-bcbd-7258de6e5abb",
                                "text": "This fatness was Kartar Singh: it was the flesh singing, in bulging cantilenas and plump pedal-notes, a congenital and contented stupidity, a stupidity itself as positive as the sun."
                            }
                        ]
                    }
                ],
