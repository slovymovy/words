                                                "sense_id": "c54e260c-d08a-3985-800e-50c02a4c0cd4",
                                                "text": "Daniel ist auch so ein fieser Kerl."
                                            },
                                            {
                                                "example_id": "411bf430-4b04-460d-b3c0-ff12551cccc2",
                                                "sense_id": "c54e260c-d08a-3985-800e-50c02a4c0cd4",
                                                "text": "Musst du immer so fies zu mir sein?"
                                            },
                                            {
                                                "example_id": "4438a4e7-483e-482c-8118-a90d78b0c818",
                                                "sense_id": "c54e260c-d08a-3985-800e-50c02a4c0cd4",
