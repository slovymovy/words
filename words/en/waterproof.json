{
    "word_family": [
        "waterproofing",
        "waterproofer"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4355131b-a779-3812-9ec3-5145e9fb658a",
                    "sense_definition": "Made of or covered with material that does not allow water to penetrate.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "impermeable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should wear a <w>waterproof</w> jacket because it is starting to rain heavily.",
                            "target_lang_translations": {
                                "ru": "Тебе стоит надеть <w>непромокаемую</w> куртку, потому что начинается сильный дождь."
                            }
                        },
                        {
                            "text": "This new watch is <w>waterproof</w> up to fifty meters under the sea.",
                            "target_lang_translations": {
                                "ru": "Эти новые часы <w>водонепроницаемы</w> на глубине до пятидесяти метров."
                            }
                        }
                    ],
                    "synonyms": [
                        "waterfast",
                        "watertight"
                    ],
                    "antonyms": [
                        "leaky",
                        "permeable"
                    ],
                    "common_phrases": [
                        "waterproof jacket",
                        "waterproof boots",
                        "waterproof mascara"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изготовленный из материала или покрытый материалом, который не пропускает воду."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "водонепроницаемый",
                                "target_lang_sense_clarification": "не пропускающий воду"
                            },
                            {
                                "target_lang_word": "непромокаемый",
                                "target_lang_sense_clarification": "одежда или обувь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e7ad2a7-e753-3a75-9dcd-20849e78449d",
                    "sense_definition": "Resistant to the damaging effects of water.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "impermeable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The construction crew used <w>waterproof</w> sealant to protect the wooden deck from rot.",
                            "target_lang_translations": {
                                "ru": "Строительная бригада использовала <w>водостойкий</w> герметик, чтобы защитить деревянный настил от гниения."
                            }
                        },
                        {
                            "text": "Make sure the outdoor speakers are <w>waterproof</w> before installing them near the pool.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что уличные колонки <w>влагозащищенные</w>, прежде чем устанавливать их у бассейна."
                            }
                        }
                    ],
                    "common_phrases": [
                        "waterproof sealant",
                        "waterproof coating"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устойчивый к разрушительному воздействию воды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "водостойкий",
                                "target_lang_sense_clarification": "устойчивый к влаге"
                            },
                            {
                                "target_lang_word": "водоупорный",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "206e80fb-0771-3500-adc4-4494a3515be7",
                    "sense_definition": "Incapable of failing or being proven wrong; unassailable.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "perfect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer presented a <w>waterproof</w> argument that the jury could not ignore.",
                            "target_lang_translations": {
                                "ru": "Адвокат представил <w>неопровержимый</w> аргумент, который присяжные не могли игнорировать."
                            }
                        },
                        {
                            "text": "Unless you have a <w>waterproof</w> plan to finish the project, we cannot start today.",
                            "target_lang_translations": {
                                "ru": "Пока у вас не будет <w>безупречного</w> плана завершения проекта, мы не можем начать сегодня."
                            }
                        }
                    ],
                    "synonyms": [
                        "watertight",
                        "watertight",
                        "watertight"
                    ],
                    "antonyms": [
                        "flawed",
                        "weak"
                    ],
                    "common_phrases": [
                        "waterproof plan",
                        "waterproof alibi"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неоспоримый, безупречный или не имеющий слабых мест."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неопровержимый",
                                "target_lang_sense_clarification": "об аргументах или алиби"
                            },
                            {
                                "target_lang_word": "безупречный",
                                "target_lang_sense_clarification": "о плане или логике"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "380aaebe-855f-3eab-803f-cb1ece110184",
                    "sense_definition": "To treat something with a substance so that it does not allow water to pass through.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to <w>waterproof</w> the basement before the spring rains arrive.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>сделать водонепроницаемым</w> подвал до начала весенних дождей."
                            }
                        },
                        {
                            "text": "Ancient civilizations used natural bitumen to <w>waterproof</w> boats for long journeys.",
                            "target_lang_translations": {
                                "ru": "Древние цивилизации использовали природный битум, чтобы <w>сделать</w> лодки <w>водонепроницаемыми</w> для долгих путешествий."
                            }
                        }
                    ],
                    "common_phrases": [
                        "waterproof the roof",
                        "waterproof the leather"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обрабатывать что-либо веществом, чтобы сделать его непроницаемым для воды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать водонепроницаемым",
                                "target_lang_sense_clarification": "общая обработка"
                            },
                            {
                                "target_lang_word": "пропитывать",
                                "target_lang_sense_clarification": "специальным составом"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2fc6eced-5f75-3721-8305-e612c3a1edda",
                    "sense_definition": "A garment, such as a raincoat, made from fabric that does not let water through.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't forget to take your <w>waterproof</w> if you are going hiking in the mountains.",
                            "target_lang_translations": {
                                "ru": "Не забудь взять свой <w>дождевик</w>, если собираешься в поход в горы."
                            }
                        },
                        {
                            "text": "She took off her dripping <w>waterproof</w> and hung it in the hallway.",
                            "target_lang_translations": {
                                "ru": "Она сняла свой промокший <w>плащ</w> и повесила его в прихожей."
                            }
                        }
                    ],
                    "synonyms": [
                        "waterfast",
                        "watertight"
                    ],
                    "common_phrases": [
                        "heavy waterproof",
                        "yellow waterproof"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет одежды, например плащ, сделанный из непромокаемой ткани."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дождевик",
                                "target_lang_sense_clarification": "легкий плащ"
                            },
                            {
                                "target_lang_word": "непромокаемый плащ",
                                "target_lang_sense_clarification": "верхняя одежда"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b8b71ce-01a9-35e7-a200-9b41c039ab94",
                    "sense_definition": "A substance or preparation used to make materials impervious to water.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chemist developed a new <w>waterproof</w> for treating industrial canvas.",
                            "target_lang_translations": {
                                "ru": "Химик разработал новое <w>водоотталкивающее средство</w> для обработки промышленного брезента."
                            }
                        },
                        {
                            "text": "Apply the <w>waterproof</w> evenly over the surface of the leather boots.",
                            "target_lang_translations": {
                                "ru": "Равномерно нанесите <w>пропитку</w> на поверхность кожаных ботинок."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещество или состав, используемый для придания материалам водонепроницаемости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "водоотталкивающее средство",
                                "target_lang_sense_clarification": "состав для обработки"
                            },
                            {
                                "target_lang_word": "пропитка",
                                "target_lang_sense_clarification": "защитный слой"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}