                                                "example_id": "47c75712-715a-4272-8ed3-10ba130ede3b",
                                                "sense_id": "9da3559c-ff6e-3487-9651-7e781107d852",
                                                "text": "„Zukimoto hat Briefe an einen Händler in Nagasaki geschickt und es den Portugiesen zum Verkauf angeboten.“"
                                            }
