                        "target_lang_word": "Nordamerika",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nordamerika",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c0bdb053-f262-30d6-ad5c-9f1a196b0200",
                                        "entry_id": "4fd60cab-a736-36fb-98dd-6dfa6a7469d7",
                                        "glosses": [
                                            "Kontinent, nördlicher Teil des Doppelkontinents Amerika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e91922dc-710e-405f-9c1d-943ecf6a9651",
                                                "sense_id": "c0bdb053-f262-30d6-ad5c-9f1a196b0200",
                                                "text": "Kanada liegt in Nordamerika."
                                            },
                                            {
                                                "example_id": "fb48dbe7-f994-4c4e-8ec9-9a156ae09b17",
                                                "sense_id": "c0bdb053-f262-30d6-ad5c-9f1a196b0200",
                                                "text": "„Schon seit mehr als einem Jahrhundert rivalisierten Frankreich und Großbritannien in Nordamerika um Pelze und Land.“"
                                            },
                                            {
                                                "example_id": "aa430b13-4402-40f0-9e5e-97c7a4b0587b",
                                                "sense_id": "c0bdb053-f262-30d6-ad5c-9f1a196b0200",
                                                "text": "„Frühe Archäologen und Anthropologen fanden immer mehr Ähnlichkeiten zwischen den indigenen Bevölkerungen der polaren Regionen Sibiriens, Nordamerikas und Grönlands.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e52b3bf3-b9e1-41bb-955d-949ac0b8ba52",
                        "source_entry_id": "c79b06f6-1d9b-308a-a3fc-8611c0f99035",
                        "source_sense_id": "72f9a85b-5542-3aba-9445-40713e7eb6a0",
                        "source_sense_description": "het continent dat ten noorden van Zuid-Amerika ligt, tussen de Grote, Arctische en de Atlantische Oceaan",
                        "target_lang_word": "North America",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "North America",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d8bd32c-f631-3b05-a6d6-0595c6aa7429",
                                        "entry_id": "6db38de7-fd25-3b5e-95c5-9ea3df5cfae1",
                                        "glosses": [
                                            "The continent forming the northern part of the Americas; that part east of the Pacific Ocean, west of the Atlantic Ocean, north of South America and south of the Arctic Ocean."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cd6a6ed-f533-4d47-a6a2-08a8ca5a068f",
                                                "sense_id": "5d8bd32c-f631-3b05-a6d6-0595c6aa7429",
                                                "text": "Jeeves: Foreign travel often liberates emotions best kept in check, sir. The air of North America is notoriously stimulating in this regard, as witness the regrettable behavior of its inhabitants in 1776.\nB. Wooster: Hm? What happened in 1776, Jeeves?\nJeeves: I prefer not to dwell on it, if it's convenient to you, sir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e3f078c-3271-3514-a667-7a7fdb895c04",
                                        "entry_id": "6db38de7-fd25-3b5e-95c5-9ea3df5cfae1",
                                        "glosses": [
                                            "Canada and the United States as a unit to the exclusion of Mexico, Central America, the Caribbean nations, and Greenland; roughly equivalent to Northern America. Often used to describe objects in a context that includes only the US and Canada."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
