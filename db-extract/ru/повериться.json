                "senses": [
                    {
                        "sense_id": "b4bc13a1-42e1-3a09-8c81-a053ce360cd2",
                        "entry_id": "c2acb674-5f6d-376d-8aad-eb0f8dec40e0",
                        "glosses": [
                            "разг., безл. о появлении уверенности в истинности чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0408c919-710a-48ef-a3d6-aa0acb342396",
                                "sense_id": "b4bc13a1-42e1-3a09-8c81-a053ce360cd2",
                                "text": "Но тогда всё было впереди, а теперь всё сзади; теперь с меня довольно того, что есть, и мне славно, — заключил он так уверенно небрежно, что, как мне ни больно было слышать это, мне поверилось, что он говорит правду."
                            }
                        ]
                    }
