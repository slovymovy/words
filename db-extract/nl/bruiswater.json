                "senses": [
                    {
                        "sense_id": "af7d65ab-f92f-3cfc-82c1-d3b691d5eba4",
                        "entry_id": "1bc792f0-6cfc-36ff-9b13-eb02c262166b",
                        "glosses": [
                            "gewoon leidingwater, waarin koolzuurgas (kooldioxide) onder druk is opgelost"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84d35aea-30c5-4f58-951a-2d819ea85737",
                                "sense_id": "af7d65ab-f92f-3cfc-82c1-d3b691d5eba4",
                                "text": "De gemalen bast van de cinchonaplant (ook wel kinine of jezuïetenpoeder genoemd) bood uitkomst, maar smaakte vreselijk bitter. Door het aan te lengen met suiker en bruiswater was het beter te doen, en soldaten kregen een rantsoen gin om het verder te veraangenamen."
                            },
                            {
                                "example_id": "935824e6-8793-4ad1-8c32-9321a0b092a2",
                                "sense_id": "af7d65ab-f92f-3cfc-82c1-d3b691d5eba4",
                                "text": "Het bruiswater dat we bestellen wordt een eindje verderop gezet en vervolgens niet bijgeschonken. Zelf maar even halen dan?"
                            }
                        ]
                    }
                ],
