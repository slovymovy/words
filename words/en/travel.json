{
    "word_family": [
        "traveler",
        "traveller",
        "travelogue"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b2501de7-932c-31bf-8bd0-88057d7397c5",
                    "sense_definition": "To go from one place to another, typically over a long distance, for pleasure or business.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "travel_journey",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We plan to <w>travel</w> to Japan next year for our summer vacation.",
                            "target_lang_translations": {
                                "ru": "Мы планируем <w>поехать</w> в Японию в следующем году в летний отпуск.",
                                "pl": "Planujemy <w>polecieć</w> do Japonii w przyszłym roku na letnie wakacje."
                            }
                        },
                        {
                            "text": "She prefers to <w>travel</w> light so she does not have to carry heavy bags.",
                            "target_lang_translations": {
                                "ru": "Она предпочитает <w>путешествовать</w> налегке, чтобы не носить тяжелые сумки.",
                                "pl": "Ona woli <w>podróżować</w> z lekkim bagażem, żeby nie musieć nosić ciężkich toreb."
                            }
                        }
                    ],
                    "synonyms": [
                        "tour",
                        "go"
                    ],
                    "common_phrases": [
                        "travel light",
                        "travel abroad",
                        "travel around",
                        "travel by train"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перемещаться из одного места в другое, обычно на большие расстояния, ради удовольствия или по делам.",
                        "pl": "Podróżować z jednego miejsca do drugiego, zazwyczaj na dużą odległość, w celach turystycznych lub służbowych."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "путешествовать",
                                "target_lang_sense_clarification": "совершать путешествие"
                            },
                            {
                                "target_lang_word": "ездить",
                                "target_lang_sense_clarification": "перемещаться транспортом"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "podróżować",
                                "target_lang_sense_clarification": "odbywać podróż"
                            },
                            {
                                "target_lang_word": "jeździć",
                                "target_lang_sense_clarification": "przemieszczać się środkiem transportu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd30d1fc-bc9f-3d48-b0e1-9e1a27993ea1",
                    "sense_definition": "To move or be transmitted from one point to another, used especially for light, sound, or news.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "travel_transmit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Light <w>travels</w> much faster than sound, which is why we see lightning before thunder.",
                            "target_lang_translations": {
                                "ru": "Свет <w>распространяется</w> гораздо быстрее звука, поэтому мы видим молнию раньше, чем слышим гром.",
                                "pl": "Światło <w>rozchodzi się</w> znacznie szybciej niż dźwięk, dlatego widzimy błyskawicę przed usłyszeniem grzmotu."
                            }
                        },
                        {
                            "text": "Bad news <w>travels</w> fast in a small town where everyone knows each other.",
                            "target_lang_translations": {
                                "ru": "Плохие новости <w>распространяются</w> быстро в маленьком городке, где все знают друг друга.",
                                "pl": "Złe wieści szybko się <w>rozchodzą</w> w małym miasteczku, gdzie wszyscy się znają."
                            }
                        }
                    ],
                    "common_phrases": [
                        "news travels fast",
                        "sound travels"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться или передаваться из одной точки в другую (о свете, звуке или новостях).",
                        "pl": "Przemieszczać się lub rozchodzić z jednego punktu do drugiego, szczególnie w odniesieniu do światła, dźwięku lub wiadomości."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распространяться",
                                "target_lang_sense_clarification": "о новостях, звуке, свете"
                            },
                            {
                                "target_lang_word": "перемещаться",
                                "target_lang_sense_clarification": "двигаться в пространстве"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "rozchodzić się",
                                "target_lang_sense_clarification": "o dźwięku, świetle lub wiadomościach"
                            },
                            {
                                "target_lang_word": "przemieszczać się",
                                "target_lang_sense_clarification": "poruszać się w przestrzeni"
                            },
                            {
                                "target_lang_word": "rozprzestrzeniać się",
                                "target_lang_sense_clarification": "o wiadomościach"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1bad5da9-1fe4-38c4-bdf5-a78949e6009a",
                    "sense_definition": "To journey throughout a specific area or region.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "travel_journey",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has <w>travelled</w> the world documenting rare species of birds.",
                            "target_lang_translations": {
                                "ru": "Он <w>объездил</w> весь мир, документируя редкие виды птиц.",
                                "pl": "On <w>przemierzył</w> cały świat, dokumentując rzadkie gatunki ptaków."
                            }
                        },
                        {
                            "text": "They <w>traveled</w> the country in a van for six months.",
                            "target_lang_translations": {
                                "ru": "Они шесть месяцев <w>путешествовали по</w> стране в фургоне.",
                                "pl": "Przez sześć miesięcy <w>podróżowali po</w> kraju vanem."
                            }
                        }
                    ],
                    "common_phrases": [
                        "travel the world",
                        "travel the country"
                    ],
                    "target_lang_definitions": {
                        "ru": "Путешествовать по определенной территории или региону.",
                        "pl": "Podróżować po określonym obszarze lub regionie."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объездить",
                                "target_lang_sense_clarification": "побывать во многих местах"
                            },
                            {
                                "target_lang_word": "путешествовать по",
                                "target_lang_sense_clarification": "ездить по территории"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przemierzać",
                                "target_lang_sense_clarification": "pokonywać znaczną przestrzeń"
                            },
                            {
                                "target_lang_word": "podróżować po",
                                "target_lang_sense_clarification": "jeździć po jakimś terenie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "603743fd-3d41-3c6a-9f5e-e5797ae8b3e6",
                    "sense_definition": "To move illegally in basketball by taking too many steps while holding the ball without dribbling.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "travel_sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The referee blew the whistle because the player <w>traveled</w> with the ball.",
                            "target_lang_translations": {
                                "ru": "Судья дал свисток, потому что игрок <w>сделал пробежку</w> с мячом.",
                                "pl": "Sędzia użył gwizdka, ponieważ zawodnik <w>zrobił kroki</w> z piłką."
                            }
                        },
                        {
                            "text": "If you take three steps without dribbling, you <w>travel</w> and lose possession.",
                            "target_lang_translations": {
                                "ru": "Если вы сделаете три шага без ведения мяча, вы <w>совершите пробежку</w> и потеряете владение.",
                                "pl": "Jeśli zrobisz trzy kroki bez kozłowania, <w>robisz błąd kroków</w> i tracisz piłkę."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершать пробежку (нарушение правил в баскетболе).",
                        "pl": "Popełnić błąd kroków w koszykówce, robiąc zbyt wiele kroków z piłką bez kozłowania."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать пробежку",
                                "target_lang_sense_clarification": "нарушение в баскетболе"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zrobić błąd kroków",
                                "target_lang_sense_clarification": "w koszykówce"
                            },
                            {
                                "target_lang_word": "zrobić kroki",
                                "target_lang_sense_clarification": "błąd w koszykówce"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bb69fb67-8900-394f-920c-28a90d38f0c6",
                    "sense_definition": "The act of going from one place to another, especially over a long distance.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "travel_journey",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "International <w>travel</w> has become much more affordable in recent years.",
                            "target_lang_translations": {
                                "ru": "Международные <w>путешествия</w> стали гораздо доступнее в последние годы.",
                                "pl": "Międzynarodowe <w>podróże</w> stały się w ostatnich latach znacznie bardziej przystępne cenowo."
                            }
                        },
                        {
                            "text": "My job involves a lot of business <w>travel</w> to different cities.",
                            "target_lang_translations": {
                                "ru": "Моя работа включает множество деловых <w>поездок</w> в разные города.",
                                "pl": "Moja praca wiąże się z wieloma <w>wyjazdami</w> służbowymi do różnych miast."
                            }
                        }
                    ],
                    "synonyms": [
                        "journey",
                        "trip",
                        "voyage"
                    ],
                    "common_phrases": [
                        "air travel",
                        "space travel",
                        "business travel",
                        "time travel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по перемещению из одного места в другое, особенно на большие расстояния.",
                        "pl": "Akt przemieszczania się z jednego miejsca do drugiego, zwłaszcza na dużą odległość."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "путешествие",
                                "target_lang_sense_clarification": "процесс странствия"
                            },
                            {
                                "target_lang_word": "поездка",
                                "target_lang_sense_clarification": "перемещение куда-либо"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "podróż",
                                "target_lang_sense_clarification": "przemieszczanie się z miejsca na miejsce"
                            },
                            {
                                "target_lang_word": "podróżowanie",
                                "target_lang_sense_clarification": "czynność podróżowania"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71f88d60-762f-3a6a-8c10-992e9cbdfb2c",
                    "sense_definition": "A series of journeys or trips, often undertaken over a period of time.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "travel_journey",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought many interesting souvenirs during her <w>travels</w> in Asia.",
                            "target_lang_translations": {
                                "ru": "Она купила много интересных сувениров во время своих <w>путешествий</w> по Азии.",
                                "pl": "Kupiła wiele ciekawych pamiątek podczas swoich <w>podróży</w> po Azji."
                            }
                        },
                        {
                            "text": "I wish you safe <w>travels</w> on your way back home.",
                            "target_lang_translations": {
                                "ru": "Желаю вам счастливого <w>пути</w> домой.",
                                "pl": "Życzę bezpiecznej <w>drogi</w> powrotnej do domu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "safe travels",
                        "on my travels"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Серия поездок или странствий, часто совершаемых в течение определенного периода времени.",
                        "pl": "Seria podróży lub wypraw, często odbywanych w pewnym okresie czasu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "путешествия",
                                "target_lang_sense_clarification": "множественное число"
                            },
                            {
                                "target_lang_word": "странствия",
                                "target_lang_sense_clarification": "скитания"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "podróże",
                                "target_lang_sense_clarification": "liczba mnoga, seria wyjazdów"
                            },
                            {
                                "target_lang_word": "wojaże",
                                "target_lang_sense_clarification": "częste wyjazdy, zwykle dla przyjemności"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c034abad-35d7-3303-b163-181996631e7d",
                    "sense_definition": "The distance a part of a mechanism moves during its operation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "travel_mechanical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The brake pedal has too much <w>travel</w> before it actually engages the brakes.",
                            "target_lang_translations": {
                                "ru": "У педали тормоза слишком большой <w>ход</w> до момента срабатывания тормозов.",
                                "pl": "Pedał hamulca ma zbyt duży <w>skok</w>, zanim faktycznie uruchomi hamulce."
                            }
                        },
                        {
                            "text": "This keyboard is designed with a short key <w>travel</w> for faster typing.",
                            "target_lang_translations": {
                                "ru": "Эта клавиатура разработана с коротким <w>ходом</w> клавиш для более быстрой печати.",
                                "pl": "Ta klawiatura została zaprojektowana z krótkim <w>skokiem</w> klawiszy dla szybszego pisania."
                            }
                        }
                    ],
                    "synonyms": [
                        "stroke",
                        "movement"
                    ],
                    "common_phrases": [
                        "suspension travel",
                        "key travel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расстояние, на которое перемещается часть механизма во время работы.",
                        "pl": "Odległość, o jaką przemieszcza się część mechanizmu podczas swojej pracy."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ход",
                                "target_lang_sense_clarification": "движение механизма"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "skok",
                                "target_lang_sense_clarification": "ruch elementu mechanicznego"
                            },
                            {
                                "target_lang_word": "skok klawisza",
                                "target_lang_sense_clarification": "w klawiaturze"
                            },
                            {
                                "target_lang_word": "skok pedału",
                                "target_lang_sense_clarification": "w samochodzie"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}