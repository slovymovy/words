                "forms": [],
                "senses": [
                    {
                        "sense_id": "23397a65-f3cf-3b68-9c28-8a6eedbf44eb",
                        "entry_id": "1d5cf9d8-b470-30a4-a138-c6014ad3b95c",
                        "glosses": [
                            "Tribu amérindienne de la nation des Montagnais habitant traditionnellement la région du lac Saint-Jean au Québec."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42e6a181-81af-43da-9251-ae60f73d41c5",
                                "sense_id": "23397a65-f3cf-3b68-9c28-8a6eedbf44eb",
                                "text": "Ainsi, les Porcs-Épics du lac Saint-Jean, les Montagnais de Tadoussac et de Québec, et les Bersiamites formaient la nation des Montagnais."
                            },
                            {
                                "example_id": "11e41ce8-add3-4af8-868f-16fe946eed8b",
                                "sense_id": "23397a65-f3cf-3b68-9c28-8a6eedbf44eb",
                                "text": "Énumération des bandes montagnaises du bassin hydrographique du Saguenay–Lac-Saint-Jean par Pierre Laure 1732 : Tadoussaciens, Chicoutimiens, Kakouchaks (ou Porcs-Épics), Piékouagamiens, Chomonchouanistes, Nekoubanistes, Petits-Mistassins, Outakamis."
                            },
                            {
                                "example_id": "e23f991f-fbf4-40c8-9406-b4a284132653",
                                "sense_id": "23397a65-f3cf-3b68-9c28-8a6eedbf44eb",
                                "text": "Les Montagnais de l'intérieur : Le bassin hydrographique du Saguenay et du Piékouagami (le lac Saint-Jean) est exploité par la tribu Porc-Épic ou Kakouchak qui aurait créé avec d'autres tribus alliées montagnaises un réseau d'échanges ... les peuples de Nicabau (Outakouamiouèques), ceux de Mistassini (Mistassinouèques) et de Mouchau Ouraganish (Mouchaouauastiirinouèques)."
                            }
                        ]
                    }
