                                        "entry_id": "dc82ad5d-7392-3039-95fe-2f6a1a2a1f12",
                                        "glosses": [
                                            "Werkzeug mit rauer/stacheliger Oberfläche für die Bearbeitung von Werkstücken"
                                        ],
                                        "tags": [],
