                                            "Iran",
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a84666a9-f29a-37f8-8c9c-7f32ef12277a",
                                        "entry_id": "13f8f1e6-31ea-3aa7-9010-9aacd99f48c8",
                                        "glosses": [
                                            "A low-level cleric who specializes in telling stories of Ashura, rather than teaching or issuing fatwas.\\nSee also: ruhani",
                                            "See also: ruhani"
