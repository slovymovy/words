                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d07cfb17-460c-4b52-9a01-ce11511ef7fc",
                                                "sense_id": "978531c8-3a70-3f28-a94f-3fce0725947a",
                                                "text": "Zum Schwimmen benötigt man die dazugehörige Ausstattung (Badehaube, Tauchermaske, …)."
                                            },
                                            {
                                                "example_id": "8c998afe-9306-4afe-bf78-838015aa364d",
                                                "sense_id": "978531c8-3a70-3f28-a94f-3fce0725947a",
                                                "text": "Die Expedition in den Regenwald hatte eine umfangreiche Ausstattung."
                                            },
                                            {
                                                "example_id": "9433220c-c555-4b65-9dcf-f17f3124f339",
                                                "sense_id": "978531c8-3a70-3f28-a94f-3fce0725947a",
                                                "text": "Die Ausstattung dieses Neuwagens ist ungewöhnlich hochwertig."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "216f1280-661b-3978-9e86-21fe86ba71a8",
                                        "entry_id": "99e699bf-fb5b-3ef4-ab31-33118ffbbfdb",
                                        "glosses": [
                                            "Gestaltung des Äußeren"
                                        ],
                                        "tags": [
                                            "meistens kein Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf2ad5c7-1900-4802-832c-92057e200cdd",
                                                "sense_id": "216f1280-661b-3978-9e86-21fe86ba71a8",
                                                "text": "Die Ausstattung des neuen Theaterstücks lässt nichts zu wünschen übrig."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "f7886248-4d5e-3e21-a3b1-5a5db4a50d21",
                                        "entry_id": "99e699bf-fb5b-3ef4-ab31-33118ffbbfdb",
                                        "glosses": [
                                            "alles, was einem Kind mit Rücksicht auf seine Verheiratung oder auf die Erlangung einer selbständigen Lebensstellung zur Begründung oder zur Erhaltung der Wirtschaft oder der Lebensstellung von dem Vater oder der Mutter zugewendet wird (§ 1624 I BGB)"
                                        ],
                                        "tags": [
                                            "Rechtsprechung"
                                        ],
                                        "examples": [
                                            {
