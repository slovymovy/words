{
    "word_family": [
        "vernissen",
        "vernislaag"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "be81bdb2-8e28-3c0f-af25-100ffcb4d3b5",
                    "sense_definition": "Een transparante vloeistof die op hout of andere oppervlakken wordt aangebracht om deze te beschermen en te laten glanzen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij bracht een nieuwe laag <w>vernis</w> aan op de oude houten tafel.",
                            "target_lang_translations": {
                                "pl": "Nałożył nową warstwę <w>lakieru</w> na stary drewniany stół."
                            }
                        },
                        {
                            "text": "De <w>vernis</w> zorgt ervoor dat het schilderij beschermd blijft tegen vuil en zonlicht.",
                            "target_lang_translations": {
                                "pl": "<w>Werniks</w> sprawia, że obraz pozostaje chroniony przed brudem i światłem słonecznym."
                            }
                        }
                    ],
                    "synonyms": [
                        "lak"
                    ],
                    "common_phrases": [
                        "een laag vernis",
                        "met vernis behandelen"
                    ],
                    "target_lang_definitions": {
                        "pl": "Przezroczysta ciecz nakładana na drewno lub inne powierzchnie w celu ich ochrony i nadania połysku."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "werniks",
                                "target_lang_sense_clarification": "często w malarstwie lub konserwacji sztuki"
                            },
                            {
                                "target_lang_word": "lakier",
                                "target_lang_sense_clarification": "ogólnie do ochrony drewna lub innych powierzchni"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "52168041-eae6-367f-86ff-8bc459bb980f",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>vernissen</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>vernis</w> deze houten stoel morgenochtend in de schuur.",
                            "target_lang_translations": {
                                "pl": "Jutro rano <w>polakieruję</w> to drewniane krzesło w szopie."
                            }
                        },
                        {
                            "text": "Elk jaar <w>vernis</w> ik de houten boot om het hout mooi te houden.",
                            "target_lang_translations": {
                                "pl": "Co roku <w>lakieruję</w> drewnianą łódź, aby drewno zachowało ładny wygląd."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging van vernissen"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Pierwsza osoba liczby pojedynczej czasu teraźniejszego od czasownika vernissen (lakierować, werniksować)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "lakieruję",
                                "target_lang_sense_clarification": "forma 1. os. lp czasownika lakierować"
                            },
                            {
                                "target_lang_word": "werniksuję",
                                "target_lang_sense_clarification": "forma 1. os. lp czasownika werniksować"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c050994-02e3-3f4d-bdca-be93ad27a311",
                    "sense_definition": "Gebiedende wijs van <w>vernissen</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Vernis</w> de tafel eerst voordat je hem buiten in de tuin neerzet.",
                            "target_lang_translations": {
                                "pl": "<w>Polakieruj</w> najpierw stół, zanim postawisz go na zewnątrz w ogrodzie."
                            }
                        },
                        {
                            "text": "<w>Vernis</w> het oppervlak voorzichtig met een zachte en schone kwast.",
                            "target_lang_translations": {
                                "pl": "<w>Lakieruj</w> powierzchnię ostrożnie za pomocą miękkiego i czystego pędzla."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "gebiedende wijs van vernissen"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Tryb rozkazujący od czasownika vernissen (lakierować, werniksować)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "polakieruj",
                                "target_lang_sense_clarification": "tryb rozkazujący (dokonany)"
                            },
                            {
                                "target_lang_word": "lakieruj",
                                "target_lang_sense_clarification": "tryb rozkazujący (niedokonany)"
                            },
                            {
                                "target_lang_word": "werniksuj",
                                "target_lang_sense_clarification": "tryb rozkazujący (malarstwo)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07512caa-d6db-344b-824e-c49018e9e666",
                    "sense_definition": "Tweede persoon enkelvoud tegenwoordige tijd van <w>vernissen</w> (bij inversie).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Vernis</w> je die oude houten kast vandaag nog zelf?",
                            "target_lang_translations": {
                                "pl": "Czy sam <w>polakierujesz</w> jeszcze dzisiaj tę starą drewnianą szafę?"
                            }
                        },
                        {
                            "text": "Waarom <w>vernis</w> je de kozijnen niet voordat het gaat regenen?",
                            "target_lang_translations": {
                                "pl": "Dlaczego nie <w>polakierujesz</w> ram okiennych, zanim zacznie padać?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "inversievorm van vernissen"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Druga osoba liczby pojedynczej czasu teraźniejszego od czasownika vernissen przy inwersji."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "lakierujesz",
                                "target_lang_sense_clarification": "forma 2. os. lp czasownika lakierować"
                            },
                            {
                                "target_lang_word": "werniksujesz",
                                "target_lang_sense_clarification": "forma 2. os. lp czasownika werniksować"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}