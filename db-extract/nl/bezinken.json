                "senses": [
                    {
                        "sense_id": "652e34e9-f6e2-32cb-89b1-4e7ee0fd1b18",
                        "entry_id": "6f2d3548-a831-3dd5-8919-593a0c4fe251",
                        "glosses": [
                            "langzaam naar de bodem zakken van deeltjes die in een vloeistof gemengd waren"
                        ],
                        "tags": [
                            "ergative"
                        ],
                        "examples": [
                            {
                                "example_id": "0120a248-34f1-45cb-9866-3a987f208783",
                                "sense_id": "652e34e9-f6e2-32cb-89b1-4e7ee0fd1b18",
                                "text": "In deze put van 300 m op 150 m groot zouden zand en slib bezinken alvorens ze het Zwin binnenstromen."
                            }
                        ]
                    },
                    {
                        "sense_id": "a45d93c7-4ae5-33bf-82e7-1ffa05ace441",
                        "entry_id": "6f2d3548-a831-3dd5-8919-593a0c4fe251",
                        "glosses": [
                            "geleidelijk inwerken op de gedachten, zodat het oordeel zich geleidelijk kan verhelderen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "8c0cbc94-6381-438a-a54f-70ad79649c64",
                                "sense_id": "a45d93c7-4ae5-33bf-82e7-1ffa05ace441",
                                "text": "Wij zijn de onrustigen, de wispelturigen, die altijd aan het prutsen en het veranderen zijn. Daardoor zitten wij in een ongezellig kaal land. Wij laten niets met rust. Wij laten de dingen om ons heen niet bezinken."
                            }
                        ]
                    }
