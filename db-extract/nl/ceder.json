                        "sense_id": "6fac94f2-6768-3786-a92f-36710e36601a",
                        "entry_id": "ef38593e-7ad1-3d1f-b8a7-5fbb4d9348e0",
                        "glosses": [
                            "benaming voor bomen uit het geslacht Cedrus dat behoort tot de dennenfamilie"
                        ],
                        "tags": [
                            "coniferen"
                        ],
                        "examples": [
                            {
                                "example_id": "63133f1d-6adf-49c1-a95d-a54903d4bc87",
                                "sense_id": "6fac94f2-6768-3786-a92f-36710e36601a",
                                "text": "Ceders hebben een bast die bestaat uit dikke ribbels of vierkante richels en wijduitstaande, rechte takken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9a0a5ae-6a5b-4fa7-9190-f2e11b9f1d13",
                        "source_entry_id": "ef38593e-7ad1-3d1f-b8a7-5fbb4d9348e0",
                        "source_sense_id": "6fac94f2-6768-3786-a92f-36710e36601a",
                        "source_sense_description": "benaming voor bomen uit het geslacht Cedrus",
                        "target_lang_word": "Zeder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zeder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ad2fa25f-8d08-30b9-9f55-317ab4dffeb9",
                                        "entry_id": "e283d4f6-3704-360d-9f11-08c24c643e10",
                                        "glosses": [
                                            "ein besonders im Mittelmeerraum auftretender immergrüner Nadelbaum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b33e47aa-80a8-4788-80ac-a68cc4456531",
                                                "sense_id": "ad2fa25f-8d08-30b9-9f55-317ab4dffeb9",
                                                "text": "Aufgrund von Fossilfunden ist bekannt, dass Zedern einst weitere Bereiche des Mittelmeerraumes und auch den zwischen Mittelmeer und Himalaya liegenden Raum besiedelten."
                                            },
                                            {
                                                "example_id": "886889ef-f9a0-4fdf-bdd8-a6ed29db3845",
                                                "sense_id": "ad2fa25f-8d08-30b9-9f55-317ab4dffeb9",
                                                "text": "„Nur einige Föhren und Zedern krochen kümmerlich am hohen Uferrande hin.“"
                                            },
                                            {
                                                "example_id": "7e021796-4acb-44fb-a9ce-d9c0df3766f5",
                                                "sense_id": "ad2fa25f-8d08-30b9-9f55-317ab4dffeb9",
                                                "text": "„Vor mir ein einstöckiges Gebäude, aus Naturstein gehauen, versteckt hinter drei Zedern und einem Johannisbrotbaum.“"
                                            },
                                            {
                                                "example_id": "002274cd-6968-4bc2-8ce1-7c91782236a5",
                                                "sense_id": "ad2fa25f-8d08-30b9-9f55-317ab4dffeb9",
                                                "text": "„Was sie an der Zeder bewunderten, war, daß man sie in einem Hut herbeigeschafft hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4d232528-a384-3255-8ac7-9ff61a3d8ae7",
                                        "entry_id": "e283d4f6-3704-360d-9f11-08c24c643e10",
                                        "glosses": [
                                            "Holz der Zeder, das aromatisch duftet"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01fe0c84-8aae-4086-96ce-d3856dbd3b0f",
                                                "sense_id": "4d232528-a384-3255-8ac7-9ff61a3d8ae7",
                                                "text": "Diese Duftkerze riecht nach Vanille und Zeder."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f12d814f-8055-4dc7-9bf0-9c536ce2c57d",
                        "source_entry_id": "ef38593e-7ad1-3d1f-b8a7-5fbb4d9348e0",
