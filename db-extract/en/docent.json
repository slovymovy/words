                                                "sense_id": "8a96e09b-f8df-3ed3-bfe3-4b0eb54adf9d",
                                                "text": "Hij is universitair docent in Leiden."
                                            },
                                            {
                                                "example_id": "ab503905-1102-4e99-9890-e4e5b9821542",
                                                "sense_id": "8a96e09b-f8df-3ed3-bfe3-4b0eb54adf9d",
                                                "text": "Docenten van de muziekschool gaven een concert."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69823b3a-a9fa-4c98-8176-f3a7b142ac5b",
                        "source_entry_id": "5380d1fe-7e5f-3ac7-9632-48403b2783ed",
                        "source_sense_description": "teacher or lecturer in university",
                        "target_lang_word": "Dozent",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dozent",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "75f1c586-4af0-3a44-a21c-7c063cc73c21",
                                        "entry_id": "885aeffd-6cb1-3df8-b786-adae2e9669fc",
                                        "glosses": [
                                            "eine Person, die in der Lehre tätig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b16358b0-f2c1-4710-9fc8-7a7982f49ddd",
                                                "sense_id": "75f1c586-4af0-3a44-a21c-7c063cc73c21",
                                                "text": "Die Lehrtätigkeit des Dozenten bzw. der Dozentin erstreckt sich hauptsächlich auf Vorlesungen und Seminare."
                                            },
                                            {
                                                "example_id": "1e55d67e-4a5c-4c71-a6b9-29246fd3cea0",
                                                "sense_id": "75f1c586-4af0-3a44-a21c-7c063cc73c21",
                                                "text": "„Betreut wurde die Arbeit von einem Doktorvater, der seine Laufbahn als Dozent an den Pädagogischen Hochschulen in Braunschweig und Neuss begonnen hatte - jeweils Einrichtungen, die kein Promotionsrecht hatten.“"
                                            },
                                            {
                                                "example_id": "c713ef76-10b9-4a7a-9e0d-9d467a4f5fd6",
                                                "sense_id": "75f1c586-4af0-3a44-a21c-7c063cc73c21",
                                                "text": "„Ihrer Ansicht nach war der Mann ein hervorragender Dozent gewesen.“"
                                            },
                                            {
                                                "example_id": "1d1442d8-34bd-4247-9888-e44e01a86bb1",
                                                "sense_id": "75f1c586-4af0-3a44-a21c-7c063cc73c21",
                                                "text": "„Ich wurde Lehrer an einer kleinen Schule in Malawi und danach Dozent an der Universität Makere in Uganda.“"
                                            },
                                            {
                                                "example_id": "a0c72069-68fc-4d96-9a4a-a32ad19c4195",
                                                "sense_id": "75f1c586-4af0-3a44-a21c-7c063cc73c21",
                                                "text": "„Gib deinem Dozenten die Hausarbeit, geh nach Hause und leg dich schlafen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e47a316-710c-4255-94b3-0b246ae76a75",
                        "source_entry_id": "5380d1fe-7e5f-3ac7-9632-48403b2783ed",
                        "source_sense_description": "teacher or lecturer in university",
                        "target_lang_word": "Dozentin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dozentin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6ddb21e7-9cf6-3d50-ae4f-6d207dc38c9e",
                                        "entry_id": "9d87c1b0-81f7-31ed-bb25-53702410de70",
                                        "glosses": [
                                            "Lehrende (vor allem) an Hochschulen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73940581-4f0f-4ce9-8c98-8336393f4fa7",
                                                "sense_id": "6ddb21e7-9cf6-3d50-ae4f-6d207dc38c9e",
                                                "text": "„Der Lehrstuhl hat im sprachwissenschaftlichen Teil zwei Professorinnen, eine Dozentin, zwei Assistentinnen und vier einheimische Lektoren.“"
                                            },
                                            {
                                                "example_id": "f2f03762-36dd-47dd-bdf7-8df07bebdee6",
                                                "sense_id": "6ddb21e7-9cf6-3d50-ae4f-6d207dc38c9e",
                                                "text": "„Bei der anderen Frau hatte es sich um Marianne Bøge gehandelt, einer Dozentin für Nordische Literatur.“"
                                            },
                                            {
                                                "example_id": "25056a0e-878c-4139-a192-ff2c97f67b43",
                                                "sense_id": "6ddb21e7-9cf6-3d50-ae4f-6d207dc38c9e",
                                                "text": "„Doch auch dies hält ihre Dozentin für falsch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
