                        "source_sense_id": "fb4bdb2c-eb80-3817-9c6d-9c91c3da42ee",
                        "source_sense_description": "groepering van goederen of natuurlijke personen die kan deelnemen aan het rechtsverkeer",
                        "target_lang_word": "personne morale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "personne morale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d44362ce-219c-393b-b2e3-9a140c2b5bdb",
                                        "entry_id": "f4b6bd55-c002-365b-ac5c-04711a8a198b",
                                        "glosses": [
                                            "Groupement doté de la personnalité juridique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c333771-c1de-477a-a66d-d91085d59728",
                                                "sense_id": "d44362ce-219c-393b-b2e3-9a140c2b5bdb",
                                                "text": "Je n'ai jamais dîné avec une personne morale."
                                            },
                                            {
                                                "example_id": "3ab8dbb7-8d50-444f-b926-f516433d7ae9",
                                                "sense_id": "d44362ce-219c-393b-b2e3-9a140c2b5bdb",
                                                "text": "Toute personne morale est autorisée à installer son siège au domicile de son représentant légal et y exercer une activité, sauf dispositions législatives ou stipulations contractuelles contraires. — (Article L123-11-1; Code de commerce français)"
                                            },
                                            {
                                                "example_id": "d04095eb-7aa5-4c95-9043-83cb9042f9e2",
                                                "sense_id": "d44362ce-219c-393b-b2e3-9a140c2b5bdb",
                                                "text": "Pour contourner la difficulté liée à cette imputation, la loi a parfois déterminé expressément les personnes physiques pénalement responsables des faits infractionnels commis au sein de la personne morale."
                                            },
                                            {
                                                "example_id": "2f79bfe4-2b41-47a6-b2d6-911ca4850fa4",
                                                "sense_id": "d44362ce-219c-393b-b2e3-9a140c2b5bdb",
                                                "text": "Si le MOA est une personne morale, une faute simple suffit toutefois pour engager sa responsabilité pénale, même en cas de causalité indirecte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
