                        "source_sense_id": "051b84e0-042a-313b-88a9-b4f84ed68dfd",
                        "source_sense_description": "Angelegenheit höchster Wichtigkeit, die der Chef persönlich erledigt",
                        "target_lang_word": "chefsache",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chefsache",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0b62e8e5-e578-3489-83cd-62f89f7cdbb6",
                                        "entry_id": "d22c0551-5bf9-3ce7-99e2-cfc1df82a834",
                                        "glosses": [
                                            "belangrijke kwestie die zo gevoelig is dat leden van een dagelijks bestuur of een fractie de afwikkeling aan de voorzitter daarvan moeten overlaten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "273f0d07-12ab-4509-b184-04da48db42f9",
                                                "sense_id": "0b62e8e5-e578-3489-83cd-62f89f7cdbb6",
                                                "text": "Dinsdag hadden de fractieleiders tot het laatste moment met Rutte en de andere ministers aan tafel gezeten om het hele pakket uit te tekenen. Maar het debat lieten ze liever over aan de specialisten uit hun fracties – een bron van ergernis voor de oppositie. „Dit is chefsache”, zei GroenLinks-leider Jesse Klaver. „Ook voor alle fracties hier in de Kamer.”"
                                            },
                                            {
                                                "example_id": "43b64467-8060-46e2-a6a9-9ba2971c4305",
                                                "sense_id": "0b62e8e5-e578-3489-83cd-62f89f7cdbb6",
                                                "text": "Bondskanselier Angela Merkel wil dat „de ministers van Financiën het probleem oplossen”. (…) Waarom Merkel ditmaal niet wil dat dit chefsache is? Omdat ze de politieke dialoog met Tsipras niet aan wil."
                                            },
                                            {
                                                "example_id": "2e8d6273-18c5-410f-80de-9f51fc6ce73c",
                                                "sense_id": "0b62e8e5-e578-3489-83cd-62f89f7cdbb6",
                                                "text": "De gevolgen van de moord op Theo van Gogh zijn in de Tweede Kamer al chefsache geworden. Morgen sturen de fracties hun voorzitters naar het debat met de ministers Remkes en Donner (Justitie, CDA)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "942125f1-e7c3-3101-9180-a1966b1bd03a",
                                        "entry_id": "d22c0551-5bf9-3ce7-99e2-cfc1df82a834",
                                        "glosses": [
                                            "kwestie die zo belangrijk en gevoelig is dat de leidinggevende er zelf over moet beslissen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a79e6a81-ce9a-4421-aca0-64b8d718f8aa",
                                                "sense_id": "942125f1-e7c3-3101-9180-a1966b1bd03a",
                                                "text": "Cees Renckens blikt terug op drie ‘chefsachen’ uit de recente kwakzalverij."
                                            },
                                            {
                                                "example_id": "f58c82a2-ec2b-4e18-9229-bf9544eab2df",
                                                "sense_id": "942125f1-e7c3-3101-9180-a1966b1bd03a",
                                                "text": "De zaak roept juridische vragen op over aansprakelijkheid van leidinggevenden in grote bedrijven. Huges zegt dat hij niet op de hoogte was van de details rond de aanbesteding. Anderen zeggen dat de aanbesteding wel degelijk ‘chefsache’ was. Het OM beschouwt Huges als ‘feitelijk leidinggevende’."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
