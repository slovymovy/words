                        ]
                    },
                    {
                        "translation_id": "a236bfad-e611-406e-9b17-6bf43aaf0fbe",
                        "source_entry_id": "5ed3252e-3918-30b8-a33c-58bee82cd1e4",
                        "source_sense_id": "553fd7e2-6337-39b8-a2f8-3aa5ddc19628",
                        "target_lang_word": "artilleur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "artilleur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "02b56476-e839-3c64-b23d-37076543b404",
                                        "entry_id": "2a5e8209-12b9-3d35-9d05-183cd6c90c13",
                                        "glosses": [
                                            "Soldat employé au service de l’artillerie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f09a92b-9f97-4311-85d1-273ee6b05cdb",
                                                "sense_id": "02b56476-e839-3c64-b23d-37076543b404",
                                                "text": "Près de Maidstone, ils tombèrent sur une rangée de onze canons automobiles de construction spéciale, autour desquels des artilleurs affairés surveillaient avec des jumelles une sorte de retranchement qu’on établissait sur la crête de la colline."
                                            },
                                            {
                                                "example_id": "28eabe3c-609d-4a0f-ad82-b9a37d500c15",
                                                "sense_id": "02b56476-e839-3c64-b23d-37076543b404",
                                                "text": "Les légations de Russie et d’Angleterre ont reçu des obus autrichiens malgré le drapeau espagnol qui flottait sur leurs toit, et les artilleurs autrichiens trouèrent, à deux reprises, leur propre légation."
                                            },
                                            {
                                                "example_id": "04eeab08-940a-4655-8c76-a2d1d36468b1",
                                                "sense_id": "02b56476-e839-3c64-b23d-37076543b404",
                                                "text": "L'artillerie passe, se dirigeant vers le nord et le nord-est, vers Grandpré, vers le Chesne. Les artilleurs, cavaliers et servants, sont graves, silencieux; leurs officiers ont l'air réfléchi."
                                            },
                                            {
                                                "example_id": "18acbd3a-5790-4bf1-80d2-702b7e392403",
                                                "sense_id": "02b56476-e839-3c64-b23d-37076543b404",
                                                "text": "Comme disait Gontier, grand expert formé aux observatoires, quelques soins que prenne l’artilleur il tire toujours à côté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41dc994b-474b-38ae-b2ad-d2bc1e3aed56",
                                        "entry_id": "2a5e8209-12b9-3d35-9d05-183cd6c90c13",
                                        "glosses": [
                                            "Désignation du grade d’un membre d’un régiment d’artillerie détenant le grade de soldat."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cd400edc-233c-353c-a2cd-0c36dac02092",
                                        "entry_id": "2a5e8209-12b9-3d35-9d05-183cd6c90c13",
                                        "glosses": [
                                            "Lanceur."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8d73d04-75a6-41e6-a9d9-80a3e08529c9",
                                                "sense_id": "cd400edc-233c-353c-a2cd-0c36dac02092",
                                                "text": "L’artilleur des Blue Jays Brad Penny se retire après 14 saisons dans la MLB."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee97b345-412f-4f4a-ae8b-2b1830476868",
                        "source_entry_id": "5ed3252e-3918-30b8-a33c-58bee82cd1e4",
                        "source_sense_id": "553fd7e2-6337-39b8-a2f8-3aa5ddc19628",
                        "target_lang_word": "Artillerist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Artillerist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f444f86a-3ce1-39e9-afab-cf89797887e2",
                                        "entry_id": "8945ec5b-c0fa-3d7a-bba9-844244bd56ad",
                                        "glosses": [
                                            "Soldat, der in der Artillerie dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26932eab-d35c-47ca-b93c-7d51c5159dc4",
                                                "sense_id": "f444f86a-3ce1-39e9-afab-cf89797887e2",
                                                "text": "„Nachdem sich der Rauch verzogen hat, können die Artilleristen wieder schießen.“"
                                            },
                                            {
                                                "example_id": "d3c00f4b-f8f9-49a1-8dc8-3d392e918300",
                                                "sense_id": "f444f86a-3ce1-39e9-afab-cf89797887e2",
                                                "text": "„Ein Artillerist von der Schießschule kam vorbei, mit hohen Stiefeln und klingenden Sporen, und grüßte.“"
                                            },
                                            {
                                                "example_id": "f5e26a94-9d96-4b82-b8c6-53269ecf1861",
                                                "sense_id": "f444f86a-3ce1-39e9-afab-cf89797887e2",
                                                "text": "„Von rechts kamen ein paar Artilleristen und schleppten einen zwischen sich.“"
                                            },
                                            {
                                                "example_id": "c366ed02-89c3-4447-9743-9b013e82b278",
                                                "sense_id": "f444f86a-3ce1-39e9-afab-cf89797887e2",
                                                "text": "„Und im selben Augenblick stürzten die Artilleristen auch schon von ihren Lagerfeuern auf die Geschütze zu und begannen zu laden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb73a9b7-6af7-4e29-a426-48c9aec366b1",
                        "source_entry_id": "5ed3252e-3918-30b8-a33c-58bee82cd1e4",
                        "source_sense_id": "553fd7e2-6337-39b8-a2f8-3aa5ddc19628",
