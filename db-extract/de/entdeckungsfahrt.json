                "senses": [
                    {
                        "sense_id": "09f5caef-d573-3899-91d2-3415bb6f7d4e",
                        "entry_id": "5414b8de-9b36-3fd4-b3c5-21f7e689891e",
                        "glosses": [
                            "Reise, die dem Ziel dient, etwas zuvor Unbekanntes zu finden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78c44c97-c1e0-4a40-a042-22a2df249cf3",
                                "sense_id": "09f5caef-d573-3899-91d2-3415bb6f7d4e",
                                "text": "Kolumbus erreichte auf seiner Entdeckungsfahrt nicht Indien, sondern Amerika."
                            },
                            {
                                "example_id": "9a0a2950-fabb-42ac-86c4-3db04f9e786e",
                                "sense_id": "09f5caef-d573-3899-91d2-3415bb6f7d4e",
                                "text": "„Er wünschte sich zunächst der oberen Stadt in einem größeren Umkreis zu vergewissern, ehe er in dem Katakombenbereich auf Entdeckungsfahrt ging.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c93b3ef-d18b-4bdb-b45a-c9f02effbc96",
                        "source_entry_id": "5414b8de-9b36-3fd4-b3c5-21f7e689891e",
                        "source_sense_id": "09f5caef-d573-3899-91d2-3415bb6f7d4e",
                        "source_sense_description": "Reise, die dem Ziel dient, etwas zuvor Unbekanntes zu finden",
                        "target_lang_word": "expedition",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "expedition",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e719a58-bca7-3512-a9f4-6c5408ab3fbd",
                                        "entry_id": "c21134e6-509b-354c-9e3f-2cfde9748669",
                                        "glosses": [
                                            "The act of expediting something; prompt execution."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16a6b3dd-a242-4a62-9922-ca49716c1149",
                                                "sense_id": "2e719a58-bca7-3512-a9f4-6c5408ab3fbd",
                                                "text": "My Lord the great Commander of the worlde, […]\nHath now in armes ten thouſand Ianiſaries, […]\nAnd for the expedition of this war,\nIf he thinke good, can from his garriſons,\nUUithdraw as many more to follow him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "defa4c75-5270-30fe-bf64-e2c6f1ce7647",
                                        "entry_id": "c21134e6-509b-354c-9e3f-2cfde9748669",
                                        "glosses": [
                                            "A military journey; an enterprise against some enemy or into enemy territory."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce7cdd58-68a7-4cdc-b8cc-953d71702365",
                                                "sense_id": "defa4c75-5270-30fe-bf64-e2c6f1ce7647",
                                                "text": "Once established in their capital at Nanking, occupied March, 1853, and renamed “Heavenly Capital” (T’ien-ching), the Taipings sent out an expedition to take Peking which again made striking gains initially, but was eventually slowed, isolated, and defeated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c47434a-4a90-314b-bedb-007dd34ef4cb",
                                        "entry_id": "c21134e6-509b-354c-9e3f-2cfde9748669",
                                        "glosses": [
                                            "The quality of being expedite; speed, quickness."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e991846e-aa97-4773-ae79-10553027c1da",
                                                "sense_id": "4c47434a-4a90-314b-bedb-007dd34ef4cb",
                                                "text": "one of them began to come nearer our boat than at first I expected; but I lay ready for him, for I had loaded my gun with all possible expedition […]."
                                            },
                                            {
                                                "example_id": "f3b9e304-800c-4a20-9aeb-368bb3a04931",
                                                "sense_id": "4c47434a-4a90-314b-bedb-007dd34ef4cb",
                                                "text": "he presently exerted his utmost agility, and with surprizing expedition ascended the hill."
                                            },
                                            {
                                                "example_id": "5240bad1-f3be-41a3-b8c5-09b168f96242",
                                                "sense_id": "4c47434a-4a90-314b-bedb-007dd34ef4cb",
                                                "text": "He saw the same Turnkey unfetter a man / With but little expedition, / Which put him in mind of the long debate / On the Slave-trade abolition."
                                            },
                                            {
                                                "example_id": "4d33f8eb-5aff-475f-ac6c-ae78c8366856",
                                                "sense_id": "4c47434a-4a90-314b-bedb-007dd34ef4cb",
                                                "text": "The photographer had photographed, the doctor had certified life extinct, the pathologist had inspected the body in situ as a prelude to conducting his autopsy – all with an expedition quite contrary to the proper pace of things, merely in order to clear the way for the visiting irregular, as the Deputy Assistant Commissioner (Crime and Ops) had liked to call him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91750e49-e761-38c8-a752-0bfc38fdf889",
                                        "entry_id": "c21134e6-509b-354c-9e3f-2cfde9748669",
                                        "glosses": [
                                            "An important or long journey, for example a march or a voyage"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c7053a26-14d5-3962-88f2-4c464879666f",
                                        "entry_id": "c21134e6-509b-354c-9e3f-2cfde9748669",
                                        "glosses": [
                                            "A trip, especially a long one, made by a person or a group of people for a specific purpose"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90dd73ef-e432-4bd6-83d8-ff013e91321a",
                                                "sense_id": "c7053a26-14d5-3962-88f2-4c464879666f",
                                                "text": "a naval expedition"
                                            },
                                            {
                                                "example_id": "28286943-a365-4238-b424-96a5b5024f62",
                                                "sense_id": "c7053a26-14d5-3962-88f2-4c464879666f",
                                                "text": "a scientific expedition"
                                            },
                                            {
                                                "example_id": "6247bb9a-39bc-48f9-a5e7-48ce8a90adb3",
                                                "sense_id": "c7053a26-14d5-3962-88f2-4c464879666f",
                                                "text": "an expedition across the Alps"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b791982-16d7-3344-89b1-cb5cdb252087",
                                        "entry_id": "c21134e6-509b-354c-9e3f-2cfde9748669",
                                        "glosses": [
                                            "The group of people making such excursion."
                                        ],
                                        "tags": [
                                            "collective",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "877fbd2e-957a-3b8d-986c-47774b827386",
                                        "entry_id": "c21134e6-509b-354c-9e3f-2cfde9748669",
                                        "glosses": [
                                            "The process or activities of performing expediter tasks."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "expedition",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ada0ed17-ef5c-36a4-a111-46468ded4bec",
                                        "entry_id": "5f6af8cc-3809-3dc6-9645-895f29963a54",
                                        "glosses": [
                                            "To take part in a trip or expedition; to travel."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "639bd225-447a-4220-be29-9c4fcccbc8b2",
                                                "sense_id": "ada0ed17-ef5c-36a4-a111-46468ded4bec",
                                                "text": "The attendance was given color by the ISO women who graced some of the sessions, attended the social events and expeditioned around the famous spots in Washington and its periphery area."
                                            },
                                            {
                                                "example_id": "77e7a186-6ad5-4db3-b6ca-7c5038df5399",
                                                "sense_id": "ada0ed17-ef5c-36a4-a111-46468ded4bec",
                                                "text": "I feel uprooted from the vital connections to Salley, to home, stranded with only the mountain and my fellow madmen as company. These thoughts appear like a mirage, a hallucination, a symptom of the schizophrenia of expeditioning."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
