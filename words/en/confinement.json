            "senses": [
                {
                    "sense_id": "2aba8758-9140-3c1c-be4d-d35cd264cd1d",
                    "sense_definition": "The state of being restricted to a specific place or area.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prisoner was held in solitary <w>confinement</w> for several weeks.",
                            "target_lang_translations": {
                                "de": "Der Gefangene wurde mehrere Wochen lang in <w>Einzelhaft</w> gehalten."
                            }
                        },
                        {
                            "text": "Strict <w>confinement</w> to the house was necessary during the recovery period.",
                            "target_lang_translations": {
                                "de": "Während der Genesungsphase war striktes <w>Hausebleiben</w> erforderlich."
                            }
                        }
                    ],
                    "common_phrases": [
                        "solitary confinement",
                        "pretrial confinement"
                    ],
                    "target_lang_definitions": {
                        "de": "Der Zustand des Eingesperrtseins oder der Beschränkung auf einen bestimmten Ort oder Bereich."
                    },
                    "translations": {
