                ],
                "senses": [
                    {
                        "sense_id": "01703f28-321c-3939-be9b-5ccb33b16e49",
                        "entry_id": "b72ddab5-8f24-3038-939a-7f0e11e59233",
                        "glosses": [
                            "Zimmer zum Lesen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83d805d3-0373-4d79-bb82-24980af29e38",
                                "sense_id": "01703f28-321c-3939-be9b-5ccb33b16e49",
                                "text": "„Sofort lief er rot an, mümmelte etwas und verließ überstürzt das Lesezimmer.“"
                            },
                            {
                                "example_id": "18746b58-7962-4b88-a6df-c2042c528eaa",
                                "sense_id": "01703f28-321c-3939-be9b-5ccb33b16e49",
                                "text": "„Er ging die Treppe hinauf, die zum Lesezimmer führte, und blieb in der Mitte stehen und lauschte.“"
                            },
                            {
                                "example_id": "cdd086d0-ba60-4a4b-a5fa-41668db9224a",
                                "sense_id": "01703f28-321c-3939-be9b-5ccb33b16e49",
                                "text": "„Sie saßen im Lesezimmer, und das Knistern der Zeitungen verstummte plötzlich.“"
                            },
                            {
                                "example_id": "5bff730e-4b89-4974-8bdd-3066d8e7c143",
                                "sense_id": "01703f28-321c-3939-be9b-5ccb33b16e49",
                                "text": "„Das also war die Bibliothek, das Lesezimmer der Klinik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7dd2a753-8bf7-44cd-8380-fb39cd9787d1",
                        "source_entry_id": "b72ddab5-8f24-3038-939a-7f0e11e59233",
                        "source_sense_id": "01703f28-321c-3939-be9b-5ccb33b16e49",
                        "source_sense_description": "Zimmer zum Lesen",
                        "target_lang_word": "salle de lecture",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salle de lecture",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2e071f43-4de3-3fba-9e80-78d3b6707045",
                                        "entry_id": "ae1feadf-8bfe-3e9f-bd3d-8935d751acfb",
                                        "glosses": [
                                            "Espace aménagé dans une bibliothèque ou un service d’archives permettant la consultation des documents sur place."
                                        ],
                                        "tags": [
                                            "Bibliothéconomie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65368a82-b4c4-4001-9646-05656df78edc",
                                                "sense_id": "2e071f43-4de3-3fba-9e80-78d3b6707045",
                                                "text": "Ils entrèrent avec précaution dans la salle de lecture : un homme jeune et de méchante humeur y feuilletait des journaux sous la lampe, près d’un général chauve absorbé par sa lecture."
                                            },
                                            {
                                                "example_id": "f3c95044-4b6e-4206-ab1e-65db30f2dae2",
                                                "sense_id": "2e071f43-4de3-3fba-9e80-78d3b6707045",
                                                "text": "Je le félicitai, en lui recommandant de ne pas se faire d’amis, la Bibliothèque nationale regorgeant d’aimables causeurs qui semblent ne pas aimer la lecture des autres et qui se relayent pour vous empêcher de prendre connaissance du livre que vous venez d’ouvrir. Il me répondit qu’il avait sa méthode, et que, dès qu’un de ceux pour qui la salle de lecture est une salle de conversation venait s’accouder à son fauteuil, il s’endormait immédiatement, ce qui, dans une salle de lecture, comme à un cours public, est dans les mœurs, ne peut froisser personne et n’a pas besoin qu’on s’en excuse."
                                            },
                                            {
                                                "example_id": "c32e5507-9a07-4a01-b7eb-0f9c098144c9",
                                                "sense_id": "2e071f43-4de3-3fba-9e80-78d3b6707045",
                                                "text": "Dans la vaste salle de lecture, un seul lecteur prend place sur chaque ensemble de tables qui, initialement en accueillait quatre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88a4d05b-acc2-4afd-b501-f1d53d9b1cd4",
                        "source_entry_id": "b72ddab5-8f24-3038-939a-7f0e11e59233",
                        "source_sense_id": "01703f28-321c-3939-be9b-5ccb33b16e49",
                        "source_sense_description": "Zimmer zum Lesen",
                        "target_lang_word": "salon de lecture",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salon de lecture",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "74160ebe-71b2-357a-9ad6-5d4004d940fe",
                                        "entry_id": "43d569ba-049f-376d-9cf1-7d8ba114bbb4",
                                        "glosses": [
                                            "Lieu où, moyennant une rétribution, on lisait sur place ou l’on emprunte des journaux et des livres, au XVIIIᵉ et au XIXᵉ siècle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a400c68-80a2-4b33-9481-d9d03b1c21d8",
                                                "sense_id": "74160ebe-71b2-357a-9ad6-5d4004d940fe",
                                                "text": "Dès les premiers jours, sa présence avait suffi pour achalander son salon de lecture ; il y vint plusieurs vieillards du quartier, entre autres un ancien carrossier, nommé Croizeau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45b8892e-e549-31bc-a4d7-7bf014242002",
                                        "entry_id": "43d569ba-049f-376d-9cf1-7d8ba114bbb4",
                                        "glosses": [
                                            "Endroit analogue à un salon et prévu pour la lecture."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
