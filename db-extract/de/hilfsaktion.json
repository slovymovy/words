                "senses": [
                    {
                        "sense_id": "c87cccfa-f9ac-3642-b8c6-cd41abcd4c23",
                        "entry_id": "7ab8e20c-44ca-3225-9c36-a7207f4b268e",
                        "glosses": [
                            "Unternehmung mit dem Ziel, jemandem zu helfen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c632d320-094a-4d01-8a70-d053572a8e62",
                                "sense_id": "c87cccfa-f9ac-3642-b8c6-cd41abcd4c23",
                                "text": "„Trocmé schwebte eine Hilfsaktion für die internierten Juden vor.“"
                            },
                            {
                                "example_id": "b93f678c-a04e-4628-8e4b-861325d2cac4",
                                "sense_id": "c87cccfa-f9ac-3642-b8c6-cd41abcd4c23",
                                "text": "„Er sieht die Leiden der Zivilbevölkerung und leitet – völlig auf sich gestellt – eine der größten Hilfsaktionen jener Jahre ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
