                    {
                        "form_id": "5b025dd4-5602-4e6c-be02-df92cc1c4000",
                        "entry_id": "843ca512-d2a7-3b0f-9115-20e96477abb5",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Beletagen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "92a8b9e1-f714-3042-9d86-93f21e5207eb",
                        "entry_id": "843ca512-d2a7-3b0f-9115-20e96477abb5",
                        "glosses": [
                            "erster Stock; besonders ausgestattete, bevorzugte Etage der Hauseigentümer, vor allem in großstädtischen Mietshäusern des 19. Jahrhunderts"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "c67a6ef3-c19d-4668-8d37-4e42b67bbffd",
                                "sense_id": "92a8b9e1-f714-3042-9d86-93f21e5207eb",
                                "text": "Die Zimmerdecken der Beletage sind reich mit Stuck verziert."
                            },
                            {
                                "example_id": "0b2b0f31-4b0b-425a-8405-3e6a7f760409",
                                "sense_id": "92a8b9e1-f714-3042-9d86-93f21e5207eb",
                                "text": "„Er steigt auch nicht wie die Herrschaften fünf Stufen hinauf in die Beletage mit den Spiegelscheiben, sondern fünf Stufen abwärts in das Souterrain mit Traljen vor den Fenstern, er geht den Küchenweg…“"
                            },
                            {
                                "example_id": "68c342e2-0118-4633-ba2a-07e613c70db1",
                                "sense_id": "92a8b9e1-f714-3042-9d86-93f21e5207eb",
                                "text": "„Nein, nein, wehrte Hugo ab, als wir der Villa in ihrem Konditorputz der Jahrhundertwende näher kamen, Arnfried bewohne dort nur die Beletage, die Eltern lebten in Marienburg, wie die seinen, entschlüpfte es ihm, und ich merkte, er bereute dies sogleich.“"
                            },
                            {
                                "example_id": "52316451-ff2c-42ec-b823-2bd513b1aae7",
                                "sense_id": "92a8b9e1-f714-3042-9d86-93f21e5207eb",
                                "text": "„Ich stieg die Treppe zur Beletage des Hotels hinauf, fand die Rezeption unbesetzt und die Tür zum Büro des Hoteliers offen.“"
                            },
                            {
                                "example_id": "0640e1db-986a-4c4b-a69d-e09573ca1b86",
                                "sense_id": "92a8b9e1-f714-3042-9d86-93f21e5207eb",
                                "text": "„Schon von fern her sah er nach der Beletage hinauf und nahm nicht ohne Sorge wahr, daß die zusammengesteckten Gardinen nach wie vor die ganze Fensterbreite verdeckten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d53a15ec-2ed7-3adb-8411-e4fba9849629",
                        "entry_id": "843ca512-d2a7-3b0f-9115-20e96477abb5",
                        "glosses": [
                            "oberste Klasse, Spielklasse, Liga; in den höheren Rängen"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "208698be-62eb-4c57-8c81-32a14d423ddf",
                                "sense_id": "d53a15ec-2ed7-3adb-8411-e4fba9849629",
                                "text": "„Ein Remis reicht, um erstmals in der Clubgeschichte und zudem als erster Verein aus Schleswig-Holstein in die Beletage des deutschen Fußballs aufzusteigen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "69146472-36a0-459c-8ca8-b963141c81e7",
                        "source_entry_id": "843ca512-d2a7-3b0f-9115-20e96477abb5",
                        "source_sense_id": "92a8b9e1-f714-3042-9d86-93f21e5207eb",
                        "source_sense_description": "erster Stock; besonders ausgestattete, bevorzugte Etage der Hauseigentümer",
                        "target_lang_word": "étage noble",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étage noble",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e5f49b43-aa19-3f4b-ad6a-14b6795a53cd",
                                        "entry_id": "6b776976-7218-31d4-ae07-6710f2df43bc",
                                        "glosses": [
                                            "Bel étage, étage situé au premier niveau d’un palais ou d’un grand immeuble résidentiel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdbacf4f-661b-4e4f-a44f-e862b35ca472",
                                                "sense_id": "e5f49b43-aa19-3f4b-ad6a-14b6795a53cd",
                                                "text": "Mettant le pied sur le tapis rouge baguetté de cuivre, qui mène à ce qu’on appelle en Italie l’étage noble, il monte d’un pas ni trop rapide, ni trop ralenti, se demandant comment finira tout ça."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a30cced2-b064-4113-b0ae-223edcbdf37f",
                        "source_entry_id": "843ca512-d2a7-3b0f-9115-20e96477abb5",
                        "source_sense_id": "92a8b9e1-f714-3042-9d86-93f21e5207eb",
                        "source_sense_description": "erster Stock; besonders ausgestattete, bevorzugte Etage der Hauseigentümer",
                        "target_lang_word": "бельэтаж",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "бельэтаж",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "79544ed0-3088-3e83-80cc-e15d5f020e06",
                                        "entry_id": "ce6d5961-3808-3b03-aacb-acca315ed459",
                                        "glosses": [
                                            "архит. второй снизу, обычно лучший этаж дома в постройках XIX — начала XX века"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b081e0a-e78a-4ecc-818a-7d1dfd7c7129",
                                                "sense_id": "79544ed0-3088-3e83-80cc-e15d5f020e06",
                                                "text": "В одном доме с Карлом жила в бельэтаже русская княгиня, приехавшая из Петербурга."
                                            },
                                            {
                                                "example_id": "5320a3db-2734-48fd-afa3-6aa03272e570",
                                                "sense_id": "79544ed0-3088-3e83-80cc-e15d5f020e06",
                                                "text": "На мраморной площадке повеяло теплом от труб, ещё раз повернули и вот — бельэтаж."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d07c446d-5485-3f06-82b3-5c55b0ae643f",
                                        "entry_id": "ce6d5961-3808-3b03-aacb-acca315ed459",
                                        "glosses": [
                                            "театр. ярус, расположенный выше бенуара и амфитеатра в зрительном зале"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f55dbec-944b-41e2-a441-af7cb123d44a",
                                                "sense_id": "d07c446d-5485-3f06-82b3-5c55b0ae643f",
                                                "text": "Когда Печорин вошёл, увертюра ещё не начиналась и в ложи не все ещё съехались; — между прочим прямо над ним в бельэтаже была пустая ложа, возле пустой ложи сидели Негуровы, отец, мать и дочь…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
