                "senses": [
                    {
                        "sense_id": "b1936216-c650-3978-a217-3478f2356f59",
                        "entry_id": "605632c8-a6bf-3f90-bd61-df7d62c73fc4",
                        "glosses": [
                            "Historiker mit dem Forschungsschwerpunkt Antike"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "598a170a-b9dc-4df8-ad24-83e510eebf8f",
                                "sense_id": "b1936216-c650-3978-a217-3478f2356f59",
                                "text": "„Die undurchsichtigen Vorgänge von der Levanteküste haben bei Althistorikern, Ausgräbern und Kunstgeschichtlern Unbehagen ausgelöst.“"
                            },
                            {
                                "example_id": "38a2663d-df31-40e4-af12-7cfdc9107e01",
                                "sense_id": "b1936216-c650-3978-a217-3478f2356f59",
                                "text": "„Nach Meinung von Althistorikern ist Bao oder Kalaha das älteste Spiel der Welt.“"
                            },
                            {
                                "example_id": "8562f0a1-35c0-4610-abef-20ba5c6e06ed",
                                "sense_id": "b1936216-c650-3978-a217-3478f2356f59",
                                "text": "„Außerdem befassen sich noch die Althistoriker mit den Kelten, die die Berichte antiker Autoren auswerten, sowie Genetiker und Anthropologen, die versuchen, aus Knochen und anderen biologischen Materialien Befunde abzuleiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
