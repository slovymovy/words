                "senses": [
                    {
                        "sense_id": "c6feb59f-b912-3ccf-ba65-7825a99d34b1",
                        "entry_id": "7f9023e9-d221-33ec-97f5-37816ce44598",
                        "glosses": [
                            "het achterste deel van het hoofd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d420f851-4693-4c34-a468-d6982fa2a0ce",
                                "sense_id": "c6feb59f-b912-3ccf-ba65-7825a99d34b1",
                                "text": "Hoewel ze niet precies wist wat Olive zou aantreffen, had ze er een redelijk goed idee van. Toen ze Olive door het raam had nagekeken en haar kale achterhoofd zag, had ze iets gevoeld wat op trots leek. Wanneer de dag des oordeels kwam - en dat zou nu niet lang meer duren - zouden ze haar inborst onder de loep nemen, dat wist ze."
                            }
                        ]
                    },
                    {
                        "sense_id": "040adffe-83b6-3d4c-b50a-d6db445c87be",
                        "entry_id": "7f9023e9-d221-33ec-97f5-37816ce44598",
                        "glosses": [
                            "een niet helemaal bewuste gedachte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac7b9d9d-e89f-42a5-8527-05c3d83836cb",
                                "sense_id": "040adffe-83b6-3d4c-b50a-d6db445c87be",
                                "text": "Hoewel ergens in haar achterhoofd een couppoging plaatsvond, bleef Chantal baas over haar eigen waarnemingsvermogen."
                            }
                        ]
                    }
