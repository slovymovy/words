                    {
                        "translation_id": "f64368f7-b303-4f1e-b901-96dbd41ce9d1",
                        "source_entry_id": "e2293e56-fb8d-32d5-886b-45ccec3aa7fb",
                        "source_sense_id": "afd85a6f-605c-3ea9-9980-130eba994332",
