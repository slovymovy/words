                        "entry_id": "45267b3b-3870-3dd6-a38f-c895950f4ea5",
                        "glosses": [
                            "leuchtendes, oft rötliches Licht, das während der Abendstunden am Himmel erscheint"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2601014b-b445-4725-8aa6-a9c2956650db",
                                "sense_id": "c840c695-c401-363f-82ee-44f17db5bf0e",
                                "text": "„Ein Fremder saß am Lido und blickte träumerisch in die glutenden Abendgluten der Lagunen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6501d575-5b11-3ef7-90d5-1b663aad466f",
                        "entry_id": "45267b3b-3870-3dd6-a38f-c895950f4ea5",
                        "glosses": [
                            "zur Gattung der Bergenien gehörende Pflanzenart mit dunkelpurpurroten Blüten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5371a4c3-42e1-449a-a7dc-23a8808dc1e9",
                                "sense_id": "6501d575-5b11-3ef7-90d5-1b663aad466f",
                                "text": "„Das dunkele Purpurrot der Blüte macht dem Namen ‘Abendglut’ alle Ehren.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
