{
    "word_family": [
        "sudderlapje",
        "sudderpot",
        "sudderpan"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6b53129f-a4dc-350b-89dc-3bb0227c3a21",
                    "sense_definition": "op een laag vuur zachtjes en langzaam koken of gaar worden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "koken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De soep moet nog minstens een half uur zachtjes <w>sudderen</w>.",
                            "target_lang_translations": {
                                "it": "La zuppa deve ancora <w>sobbollire</w> a fuoco lento per almeno mezz'ora."
                            }
                        },
                        {
                            "text": "In de keuken <w>sudderde</w> het vlees langzaam in een grote pan.",
                            "target_lang_translations": {
                                "it": "In cucina la carne <w>sobbolliva</w> lentamente in una grande pentola."
                            }
                        }
                    ],
                    "synonyms": [
                        "pruttelen"
                    ],
                    "antonyms": [
                        "aanbakken"
                    ],
                    "common_phrases": [
                        "zachtjes laten sudderen",
                        "langzaam sudderen"
                    ],
                    "target_lang_definitions": {
                        "it": "bollire dolcemente e lentamente a fuoco lento (intransitivo)"
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "sobbollire",
                                "target_lang_sense_clarification": "cuocere a fuoco lento con un bollore appena percettibile"
                            },
                            {
                                "target_lang_word": "pippiare",
                                "target_lang_sense_clarification": "sobbollire lentamente tipico del ragù"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "192610c6-cfb0-32aa-bff8-c94271a2bd52",
                    "sense_definition": "voedsel op laag vuur langzaam laten koken of gaar maken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "koken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De chef-kok <w>suddert</w> de saus met zorg tot hij dik genoeg is.",
                            "target_lang_translations": {
                                "it": "Lo chef <w>fa sobbollire</w> la salsa con cura finché non è abbastanza densa."
                            }
                        },
                        {
                            "text": "Hij heeft de runderlapjes urenlang op het fornuis <w>gesudderd</w>.",
                            "target_lang_translations": {
                                "it": "Ha <w>stufato</w> le fettine di manzo per ore sui fornelli."
                            }
                        }
                    ],
                    "synonyms": [
                        "stoven"
                    ],
                    "common_phrases": [
                        "vlees sudderen"
                    ],
                    "target_lang_definitions": {
                        "it": "far cuocere lentamente del cibo a fuoco basso (transitivo)"
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "stufare",
                                "target_lang_sense_clarification": "cuocere lentamente a fuoco dolce con poco liquido"
                            },
                            {
                                "target_lang_word": "brasare",
                                "target_lang_sense_clarification": "cuocere lentamente carne a lungo in umido"
                            },
                            {
                                "target_lang_word": "far sobbollire",
                                "target_lang_sense_clarification": "tenere a fuoco lento"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}