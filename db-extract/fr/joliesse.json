                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e5bde210-9789-4d05-9f05-8e43602ed897",
                        "entry_id": "dc57ff52-01fc-30b2-a7d3-0f9b62a4e060",
                        "tags": [
                            "plural"
                        ],
                        "form": "joliesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "97946a36-9350-328d-a70f-e56ec64b657e",
                        "entry_id": "dc57ff52-01fc-30b2-a7d3-0f9b62a4e060",
                        "glosses": [
                            "Qualité de ce qui est joli."
                        ],
                        "tags": [
                            "Mélioratif"
                        ],
                        "examples": [
                            {
                                "example_id": "47a5d568-bf06-4d3c-9459-0be6c55130ba",
                                "sense_id": "97946a36-9350-328d-a70f-e56ec64b657e",
                                "text": "Le Picard de la côte est moins dru, d'une charpente moins massive que celui qui habite l'intérieur des terres; j'ai vu dans le Vimeu des visages virils d'une rare noblesse; et la joliesse des Abbevilloises est légendaire."
                            },
                            {
                                "example_id": "c303e836-b0e3-4f96-a62d-cd795deda5ff",
                                "sense_id": "97946a36-9350-328d-a70f-e56ec64b657e",
                                "text": "Vers sa dix-huitième année, il devait perdre tout d’un coup le fruit de ses expériences, comme se préparant à entrer dans un monde où les raffinements, les joliesses devenaient un bagage encombrant."
                            },
                            {
                                "example_id": "ac48ee34-95f0-4d16-a562-6425912ad62b",
                                "sense_id": "97946a36-9350-328d-a70f-e56ec64b657e",
                                "text": "Que m’importe d’être laide ? disait-elle régulièrement à la jeune femme. La joliesse n’eût jamais pu m’apporter un destin plus heureux que de vivre avec vous."
                            },
                            {
                                "example_id": "04ed4169-545a-4551-95c7-658e915026cb",
                                "sense_id": "97946a36-9350-328d-a70f-e56ec64b657e",
                                "text": "Leur grâce fragile disait la joliesse de l’infante défunte."
                            },
                            {
                                "example_id": "443ceeea-76cc-4fc5-b1b8-7d713f7fe461",
                                "sense_id": "97946a36-9350-328d-a70f-e56ec64b657e",
                                "text": "Que cette représentation soit une construction fantaisiste née de la joliesse des enluminures importe peu."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52192f39-a2af-4a0d-8dae-4d567bd221fd",
                        "source_entry_id": "dc57ff52-01fc-30b2-a7d3-0f9b62a4e060",
