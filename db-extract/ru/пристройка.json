                                    },
                                    {
                                        "sense_id": "3c03dc28-89bc-360d-832c-679ed77303bd",
                                        "entry_id": "eabf3048-81f0-3e6f-a49c-6e698bf4eb96",
                                        "glosses": [
                                            "A making more obvious or serious; exacerbation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f08190b2-cfd9-4f19-a1dc-6d27633d6b5a",
                                                "sense_id": "3c03dc28-89bc-360d-832c-679ed77303bd",
                                                "text": "Bathsheba underwent the enlargement of her husband's absence from hours to days with a slight feeling of surprise, and a slight feeling of relief; yet neither sensation rose at any time far above the level commonly designated as indifference."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a368e524-a47f-3628-be31-4d47100cc2a4",
                                        "entry_id": "eabf3048-81f0-3e6f-a49c-6e698bf4eb96",
                                        "glosses": [
                                            "An image, particularly a photograph, that has been enlarged."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3a9093e6-6d4d-3f93-87d0-0eda2555ddee",
                                        "entry_id": "eabf3048-81f0-3e6f-a49c-6e698bf4eb96",
                                        "glosses": [
                                            "Freedom from confinement; liberty."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fed65ecd-c35b-458b-af79-a3212ecc5880",
                                                "sense_id": "3a9093e6-6d4d-3f93-87d0-0eda2555ddee",
                                                "text": "Go, tenderness of years; take this key, give enlargement to the swain, bring him festinately hither."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65b9d621-f628-3681-8646-b8736d3db862",
                                        "entry_id": "eabf3048-81f0-3e6f-a49c-6e698bf4eb96",
                                        "glosses": [
                                            "Diffuseness of speech or writing; a speaking at length."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b353eab-e5df-41e7-aa5c-3aee28217986",
                                                "sense_id": "65b9d621-f628-3681-8646-b8736d3db862",
                                                "text": "Briefly, a discourse generally consists in some prefatory remarks which pave the way as it were for the enlargement upon which a speaker usually enters when he speaks to any purpose."
                                            }
