                                                "example_id": "9262f257-8858-4905-b4cc-edd340bf63a9",
                                                "sense_id": "9222a25f-f331-3766-963b-a0361d6ae81f",
                                                "text": "Les os métacarpiens, ou, substantivement, les métacarpiens, les os du métacarpe."
                                            },
                                            {
                                                "example_id": "82621a73-d7ce-41a0-ae7e-e4ad788ada37",
                                                "sense_id": "9222a25f-f331-3766-963b-a0361d6ae81f",
                                                "text": "Patrick remarqua que ses artères métacarpiennes dorsales étaient bleu ciel sur le dos de ses mains pâles."
                                            }
