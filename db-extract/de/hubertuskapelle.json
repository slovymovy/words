                "senses": [
                    {
                        "sense_id": "3dd6b5a4-7e8d-3c91-bb80-cfca0509f58a",
                        "entry_id": "3a924c5b-425e-3971-8d34-912f9f719d45",
                        "glosses": [
                            "Kapelle, die dem Heiligen Hubertus von Lüttich geweiht ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "586ef982-829c-4216-a3e9-ae584125c5dc",
                                "sense_id": "3dd6b5a4-7e8d-3c91-bb80-cfca0509f58a",
                                "text": "„Die Jägerschaft der Marktgemeinde Seewalchen hat im Jahr 2003 ein seit vielen Jahren geplantes Vorhaben umgesetzt und fertiggestellt - die Errichtung einer dem Jagdpatron Hl. Hubertus geweihten \"Hubertuskapelle\" im Gerlhamer Moor.“"
                            },
                            {
                                "example_id": "8cc6f122-89a6-4e7a-828a-22a0fa50c53d",
                                "sense_id": "3dd6b5a4-7e8d-3c91-bb80-cfca0509f58a",
                                "text": "„Die Bezirksvertretung 5 hat beschlossen, die Sanierung der kleinen weißen Hubertuskapelle bei Gut Großwinkelhausen mit weiteren Geldern zu fördern.“"
                            },
                            {
                                "example_id": "522b1db8-89d8-4acd-925e-c6ae80de670d",
                                "sense_id": "3dd6b5a4-7e8d-3c91-bb80-cfca0509f58a",
                                "text": "„Die St. Hubertuskapelle lebt schon seit ihrer Gründung vom Engagement der Ückesdorfer Bürger.“"
                            },
                            {
                                "example_id": "55a8dbf0-0f31-436d-a399-2b85b4f6d145",
                                "sense_id": "3dd6b5a4-7e8d-3c91-bb80-cfca0509f58a",
                                "text": "„Die Hubertuskapelle im Stadtteil Kaarst wurde 1980 nördlich der Bundesautobahn 52 auf Initiative von vier Kaarster Familien (Hügen, Johnen, Langenfels und Meyer) errichtet.“"
                            },
                            {
                                "example_id": "e0fc09fc-33ff-43cf-83cb-c71e8c7d89c5",
                                "sense_id": "3dd6b5a4-7e8d-3c91-bb80-cfca0509f58a",
                                "text": "„Die Hubertuskapelle ist eine barocke Kapelle in Düsseldorf-Angermund mit dem Patrozinium des heiligen Hubertus, des Schutzpatrons der Jagdleute.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
