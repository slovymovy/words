                                        "entry_id": "df47979d-2a52-3bb1-bcaf-03aa2177af9f",
                                        "glosses": [
                                            "iemand die vaak slechte huizen (woningen) tegen woekerprijzen verhuurt, een onbarmhartige woekeraar ofwel malafide huiseigenaar"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3d64a41-1833-4962-a522-7576ce064eed",
                                                "sense_id": "9efd06f3-6501-33f4-9f8e-925c9b9552bf",
                                                "text": "Het voornaamste bezwaar tegen huisjesmelkers is dat ze huurders een onfatsoenlijk hoge huur laten betalen."
                                            },
                                            {
                                                "example_id": "3d978d96-4e7f-453c-86ba-75caf605e817",
                                                "sense_id": "9efd06f3-6501-33f4-9f8e-925c9b9552bf",
                                                "text": "Prins Bernhard genomineerd voor \"Huisjesmelker van het Jaar\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb9c35e6-fc89-4865-be5e-9c0c1a705620",
                        "source_entry_id": "02c82cc1-13ad-35ca-9617-6f613fa08025",
                        "source_sense_id": "9f18b68c-1f7a-385a-ac03-d8ff9bd9409e",
