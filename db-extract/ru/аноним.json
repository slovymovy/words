                                                "sense_id": "06f280db-812c-34de-aa45-5b3a57d84fa8",
                                                "text": "Już pierwszy kronikarz polski w zaraniu XI wieku, tajemniczy anonim, nosi ogólnikowe imię „Gallus” […]"
                                            }
                                        ],
                                        "sense_index_json": "\"2.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d640a349-d87b-46eb-9499-a212b0d2dd4e",
                        "source_entry_id": "5ba5fb7c-83e7-34db-8bc6-ddba67634f07",
