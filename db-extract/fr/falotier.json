                        "sense_id": "0323adf6-1e67-3ce4-9136-bc566837fa65",
                        "entry_id": "94aae7d4-14cc-31c7-8ed9-51f0ef2d0a51",
                        "glosses": [
                            "Celui qui plaçait ou portait les falots."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "7984e688-0242-4792-9cdb-e1f6580dfb27",
                                "sense_id": "0323adf6-1e67-3ce4-9136-bc566837fa65",
                                "text": "Un autre serviteur, non moins modeste, mais aussi utile de la Confrérie, était le « falotier », chargé de précéder, vêtu d’une soutane, d’un surplis et d’un « camail dans la saison », coiffé d’un bonnet, et porteur d’un falot allumé et d’une clochette, le prêtre qui portait le viatique aux malades."
                            }
                        ]
                    },
                    {
                        "sense_id": "95556327-707a-3240-99d8-0b42b25c82f4",
                        "entry_id": "94aae7d4-14cc-31c7-8ed9-51f0ef2d0a51",
                        "glosses": [
                            "Celui qui était chargé d’allumer les réverbères."
                        ],
                        "tags": [
