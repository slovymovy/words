                        "glosses": [
                            "One who is new (to something); a newcomer; a novice; a newbie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f79fea4-4c54-4b66-a70c-8e8f04da43d3",
                                "sense_id": "4ad70d0f-6dac-39fc-b15c-fdfb76dd6ae3",
                                "text": "\"[…] Seest thou not by the stripling's face that he be a newling (newcomer) in the town.\""
                            },
                            {
                                "example_id": "507951b5-b33a-4a54-90ef-2414980345e8",
                                "sense_id": "4ad70d0f-6dac-39fc-b15c-fdfb76dd6ae3",
                                "text": "“A newling!” Fascinated, but wary not to stand and reach for it, Rhiana kept her ears pricked—and heard another. A newling and its elder protector."
                            },
                            {
                                "example_id": "4a95eb9b-d966-414e-b309-81f3b1e3c792",
                                "sense_id": "4ad70d0f-6dac-39fc-b15c-fdfb76dd6ae3",
                                "text": "Unlike a newling, I have to have air to breathe, and this idiot is squeezing so hard I can barely draw in a breath."
                            }
                        ]
                    }
                ],
