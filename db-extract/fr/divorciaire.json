                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99cc1794-b8bb-436d-82aa-7f41a84c4dab",
                                "sense_id": "4b6f58c6-09b1-3329-ad27-e0b8f3e02ae3",
                                "text": "Les divorciaires et anti-divorciaires s’affrontent à coups de controverses théologicohistoriques souvent spécieuses."
                            },
                            {
                                "example_id": "73d93527-98ff-4ea5-b5ab-c2d1c111f4a3",
                                "sense_id": "4b6f58c6-09b1-3329-ad27-e0b8f3e02ae3",
                                "text": "Les divorciaires français, à nouveau actifs depuis la Révolution de juillet, ont subi plusieurs échecs parlementaires en 1831, 1834 puis 1848 avant de voir leurs efforts couronnés de succès en 1884."
                            },
                            {
                                "example_id": "8df291ea-9739-4d41-815e-381004a5e8f5",
                                "sense_id": "4b6f58c6-09b1-3329-ad27-e0b8f3e02ae3",
                                "text": "Un divorciaire aussi convaincu que Bouchotte admet que « rien n’était plus sage que cette motion », mais note que sa présentation a été prématurée."
                            }
                        ]
                    }
