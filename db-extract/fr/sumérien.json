                ],
                "senses": [
                    {
                        "sense_id": "bfe1ffee-633e-3deb-aaeb-bcd51f3d0867",
                        "entry_id": "9159ee88-dc1f-32bd-a703-d5bdbecfb9bd",
                        "glosses": [
                            "Relatif à Sumer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fab49f6b-4ec7-44e9-b5ef-acda00e4b8a4",
                                "sense_id": "bfe1ffee-633e-3deb-aaeb-bcd51f3d0867",
                                "text": "Le Louvre conserve une tablette votive sumérienne, venant de l’embouchure de l’Euphrate et datant de 2850 avant J.C., faite d’un mélange artificiel de bitume et d’argile."
                            },
                            {
                                "example_id": "451da930-d26e-4cdd-b3af-7db070fc5916",
                                "sense_id": "bfe1ffee-633e-3deb-aaeb-bcd51f3d0867",
                                "text": "Depuis toujours, la bière a été associée au sexe, ainsi qu’en témoignent les représentations sumériennes, selon Swinnen et Briski."
                            },
                            {
                                "example_id": "01b39f4f-0288-4882-8969-26baf6954ae5",
                                "sense_id": "bfe1ffee-633e-3deb-aaeb-bcd51f3d0867",
                                "text": "Le logogramme sumérien pouvant être polysémique, le corpus des signes permet donc d'écrire plusieurs milliers de mots."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6f61606-b3f2-4b44-9028-ab48f6eab594",
                        "source_entry_id": "9159ee88-dc1f-32bd-a703-d5bdbecfb9bd",
                        "source_sense_id": "bfe1ffee-633e-3deb-aaeb-bcd51f3d0867",
                        "target_lang_word": "sumerisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sumerisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a02f6212-64a1-3cda-89ee-6b46317da177",
                                        "entry_id": "0c5aea70-bdcf-3a40-a0e5-72d88e934fb8",
                                        "glosses": [
                                            "Sumerer und / oder Region Sumer betreffend"
                                        ],
                                        "tags": [
                                            "Vorderer Orient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "061f5f34-ade8-481e-bbc6-093655149d14",
                                                "sense_id": "a02f6212-64a1-3cda-89ee-6b46317da177",
                                                "text": "„Für die frühen sumerischen Städte (Frühdynastische Periode, ca. 2900–2334 v. Chr.) mit ihren zentralisierten Wirtschafts- und Tempelkomplexen ist eine Königsliste erhalten, die die Regierungszeiten von Herrschern vor und nach der »Flut« aufzählt, […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2968bd75-d7ac-3194-aec9-8a18e522390c",
                                        "entry_id": "0c5aea70-bdcf-3a40-a0e5-72d88e934fb8",
                                        "glosses": [
                                            "Sumerisch, die Sprache der Sumerer, betreffend"
                                        ],
                                        "tags": [
                                            "Sprache",
                                            "Orientalistik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a723fac5-3f00-40b2-809e-41a6768e0c30",
                                                "sense_id": "2968bd75-d7ac-3194-aec9-8a18e522390c",
                                                "text": "„In altbabylonischer Zeit fügte man der sumerischen Kolumne eine babylonische Übersetzung hinzu und schuf damit die ersten zweisprachigen Glossare oder Wörterbücher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ae23b3d-ccf4-475a-a785-845e4b9853a6",
                        "source_entry_id": "9159ee88-dc1f-32bd-a703-d5bdbecfb9bd",
