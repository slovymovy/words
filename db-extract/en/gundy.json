                        "entry_id": "a42c0eb9-e89d-34ee-8ca6-7abfc0ace1ff",
                        "glosses": [
                            "A front claw of a crab."
                        ],
                        "tags": [
                            "Trinidad-and-Tobago"
                        ],
                        "examples": [
                            {
                                "example_id": "b21e95c7-fb1b-4f58-9226-eb64d6c41a31",
                                "sense_id": "23f0e3bb-2825-3978-89e8-7254f8c55b96",
                                "text": "They said that crabs folded their gundies inwards when the crabs were in their holes and were therefore unable to bite anyone from that position."
                            },
                            {
                                "example_id": "a9a66392-db9a-4568-8a84-a2e344336b01",
                                "sense_id": "23f0e3bb-2825-3978-89e8-7254f8c55b96",
                                "text": "The experience of eating crab meat out of a gundy, if you film a session on that it's a big thing for experiential tourism."
                            }
                        ]
                    }
                ],
                "translations": [],
