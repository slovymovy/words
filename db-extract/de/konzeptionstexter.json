                            {
                                "example_id": "6342e492-b10b-4ffa-a13a-9309ddfcf812",
                                "sense_id": "480f0111-8a0f-3750-8d8e-f7367e6b338f",
                                "text": "„Dieter Brecheis arbeitete nach dem Studium der Wirtschafts- und Sozialwissenschaften als Konzeptionstexter in der Werbung.“"
                            },
                            {
