                    }
                ],
                "senses": [
                    {
                        "sense_id": "1a9a7312-d8f2-30cf-ba3f-2a910af14352",
                        "entry_id": "6b7121d3-3590-3d1d-9f46-12b4733146cb",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным архив; свойственный, характерный для него"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "644794d2-ba8a-4154-b316-914961010d6b",
                                "sense_id": "1a9a7312-d8f2-30cf-ba3f-2a910af14352",
                                "text": "Архивные материалы."
                            },
                            {
                                "example_id": "be067b9d-351d-4318-8296-96ca7aa49f8a",
                                "sense_id": "1a9a7312-d8f2-30cf-ba3f-2a910af14352",
                                "text": "Архивные исследования."
                            },
                            {
                                "example_id": "c878596d-21ef-4b74-a823-17003569c249",
                                "sense_id": "1a9a7312-d8f2-30cf-ba3f-2a910af14352",
                                "text": "Архивные работники."
                            },
                            {
                                "example_id": "fc199462-d48f-4fc0-b8f2-764431f0b922",
                                "sense_id": "1a9a7312-d8f2-30cf-ba3f-2a910af14352",
                                "text": "Архивные записи."
                            },
                            {
                                "example_id": "b0316f68-be52-437a-95d3-35aab51f7e4e",
                                "sense_id": "1a9a7312-d8f2-30cf-ba3f-2a910af14352",
                                "text": "Вообще между тогдашними архивными юношами было довольно талантов в зерне; отчего, не созрев, они гибли?"
                            },
                            {
                                "example_id": "3a21d875-c73c-46c8-b205-8a2ea934e92a",
                                "sense_id": "1a9a7312-d8f2-30cf-ba3f-2a910af14352",
                                "text": "Прошу извинить меня, Павел Николаевич, что задержал архивную выписку."
                            }
                        ]
                    }
                ],
                "translations": [
