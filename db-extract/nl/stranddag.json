                    {
                        "sense_id": "80bd3108-87b6-37a7-a600-3df424f63d6b",
                        "entry_id": "580caf83-7f21-3a85-b719-6733118599e5",
                        "glosses": [
                            "een dag die geschikt is om naar het strand te gaan, het gaat dan over een warme, zonnige dag zonder regen en niet te veel wind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78973487-7204-4763-97f0-8b2ca5210971",
                                "sense_id": "80bd3108-87b6-37a7-a600-3df424f63d6b",
                                "text": "Het is de meeste van jullie wel bekend dat je voor een goede najaarszon naar de Canarische Eilanden kunt afreizen. Leuke tip is wel om eens verder te kijken dan Gran Canaria, Fuerteventura en Tenerife. Ook niets mis mee uiteraard, maar overweeg eens een tripje naar La Gomera of La Palma. Het laatste eiland staat bekend om haar fenomenale sterrenhemels. Dat worden dus wel heel lange stranddagen…"
                            },
                            {
                                "example_id": "947b253d-be9e-4580-9a59-dc76bfd894a7",
                                "sense_id": "80bd3108-87b6-37a7-a600-3df424f63d6b",
                                "text": "Er staat zowaar een goede stranddag aan te komen. Tot nu toe is het aantal stranddagen deze zomervakantie beperkt gebleven maar aanstaande woensdag wordt het 24 tot 28 graden."
                            }
                        ]
                    }
                ],
