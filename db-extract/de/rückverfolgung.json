                        "entry_id": "efea5b95-ecec-39d1-8e32-110c86f76f29",
                        "glosses": [
                            "Untersuchung der Vergangenheit, um schrittweise die Entstehung eines vorhandenen Phänomens zu verstehen; zum Beispiel, wie ein Produkt hergestellt wurde oder wie sich eine Person angesteckt hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2ea0bf9-40ee-43e2-b008-20c99ae1d708",
                                "sense_id": "a72289b1-261c-381c-848c-da73d556d6b8",
                                "text": "„Das Einbringen von eindeutigen kundenspezifischen Markierungen in das Datenmaterial als Wasserzeichen wird als digitaler Fingerabdruck (digital fingerprinting) bezeichnet und erlaubt die Rückverfolgung einer illegalen Kopie zum Verursacher der Urheberrechtsverletzung.“"
                            },
                            {
                                "example_id": "a0c84601-f739-4a72-b4c9-4a9e611fe18f",
                                "sense_id": "a72289b1-261c-381c-848c-da73d556d6b8",
                                "text": "Im Kampf gegen das Coronavirus funktioniert die Rückverfolgung der Kontakte eines Infizierten mal besser und mal schlechter."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
