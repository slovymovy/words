                        "examples": [
                            {
                                "example_id": "bee13f65-f5df-45aa-b738-fc9c80829704",
                                "sense_id": "d140d754-d6b3-3210-94c7-cc5c1c81f2b1",
                                "text": "No longer would our profession’s stoical symbol of equality be the blindfolded, long-dressed lady holding scales. She would be replaced by a mini-skirted beautiful chick whose blindfold has been pushed up to be used as a head band."
                            },
                            {
                                "example_id": "63585fcb-13b4-433a-9306-d4ae2605c9ba",
                                "sense_id": "d140d754-d6b3-3210-94c7-cc5c1c81f2b1",
                                "text": "hatted gentlemen and their long-dressed ladies rode on two-horse wagons"
                            },
                            {
                                "example_id": "2825ed62-d5f7-4e13-9654-6775f737ad21",
                                "sense_id": "d140d754-d6b3-3210-94c7-cc5c1c81f2b1",
                                "text": "She had offered him a lift home from the county ball, a night for long-dressed ladies and uniforms."
                            }
                        ]
                    }
