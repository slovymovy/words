                                                "example_id": "63954b45-d954-41d0-a3c3-fe97d803bcd0",
                                                "sense_id": "00421f6f-9130-3d6e-b978-db04282107ab",
                                                "text": "I got fired and I'm back on the sausage again."
                                            }
