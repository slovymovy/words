                "senses": [
                    {
                        "sense_id": "66c1636a-bb56-3338-afb5-d0e5a341b295",
                        "entry_id": "2a1d4f30-fa76-3c44-a40e-885f90386059",
                        "glosses": [
                            "A Usenetter."
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "52c4d320-ac69-491f-9c19-72a55a04f1f3",
                                "sense_id": "66c1636a-bb56-3338-afb5-d0e5a341b295",
                                "text": "Daß viele MausNet-Gruppen nicht in's Usenet exportiert werden, haben sich letzlich die Useneter selbst zuzuschreiben."
                            },
                            {
                                "example_id": "a94f0680-3f32-4636-a47a-9064e7d62627",
                                "sense_id": "66c1636a-bb56-3338-afb5-d0e5a341b295",
                                "text": "Es ging doch nie darum, die UseNeter rauszuschmeißen, es gab sogar schon ne Mailingliste für Interessierte, was soll der Vorwurf also ?"
                            },
                            {
                                "example_id": "31c0f5f6-7595-4d48-a6b8-5e21dcb302a4",
                                "sense_id": "66c1636a-bb56-3338-afb5-d0e5a341b295",
                                "text": "Darauf hast du oder die Useneter keinerlei Einfluß (!=Demokratie, ==Anarchie)."
                            },
                            {
                                "example_id": "292bab15-3322-4fb8-82b7-8d9fae56fa91",
                                "sense_id": "66c1636a-bb56-3338-afb5-d0e5a341b295",
                                "text": "Du, als ehemaliger Mauser und jetzt supergeiler, pfeilschneller Useneter hängst dich hier also am vollkommen falschen Platz bis zu den Zehenspitzen aus dem Fenster."
                            }
                        ]
                    }
