            "senses": [
                {
                    "sense_id": "7f88843c-f780-33fb-80e7-365c2b50ca68",
                    "sense_definition": "Faire un ou plusieurs bonds après avoir heurté un obstacle ou une surface.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ballon a heurté le poteau avant de <w>rebondir</w> directement dans les bras du gardien."
                        },
                        {
                            "text": "Les enfants s'amusent à faire <w>rebondir</w> la balle contre le mur de l'école."
                        }
                    ],
                    "synonyms": [
