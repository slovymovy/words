                    {
                        "translation_id": "57b9dfc8-a1d1-48a2-97fc-3085944fdf38",
                        "source_entry_id": "bb113953-2e25-3346-8071-f51a9e32cd82",
                        "source_sense_id": "e0a46b20-38ed-3271-94ac-e03b063b8063",
