                        ],
                        "examples": [
                            {
                                "example_id": "f6249f16-2ca7-4b4b-88d4-a749f465c1d0",
                                "sense_id": "c6f8ece4-101f-35e4-9aa9-e2734fa88623",
                                "text": "L’éclat de ce titre rejaillit sur les épouses des dignitaires qui, à leur tour, s’intitulent conseillères, secrétairesses, doctoresses, etc."
                            },
                            {
                                "example_id": "a04a3b92-36c9-4e5f-b99e-b0dfcb3296e1",
                                "sense_id": "c6f8ece4-101f-35e4-9aa9-e2734fa88623",
                                "text": "Là une vieille dame mit pied à terre ; cette dame n’était autre que la Korobotchka, la secrétairesse de collège que nous avons vue chez elle, …."
                            },
                            {
                                "example_id": "98e6ca88-b023-4195-8c37-66d7ef2c16ba",
                                "sense_id": "c6f8ece4-101f-35e4-9aa9-e2734fa88623",
                                "text": "— Korobotchka, secrétairesse de collège."
