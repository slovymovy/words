                        "entry_id": "f9ba44de-02db-3713-8237-a8c230835011",
                        "glosses": [
                            "Seemingly, but not actually, medieval; resembling the Middle Ages, or something from that era."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "395bcb4e-7b4c-4dd8-a8df-28dfc9588304",
                                "sense_id": "3d72793c-309b-3f19-a85d-a15d2e9c83b4",
                                "text": "This pseudomedieval Grand Kremlin Palace may be the most apt symbol of a regime that was trying to go backward all the while it was going forward."
                            },
                            {
                                "example_id": "441c9fab-2552-4e1d-9705-00d3be035555",
                                "sense_id": "3d72793c-309b-3f19-a85d-a15d2e9c83b4",
                                "text": "The fantasy worlds of simulation gaming are commonly pseudomedieval, involving swords and sorcery — spell-casting wizards, knights in armor, unicorns and dragons, demons and goblins."
                            },
                            {
                                "example_id": "f5f9e4c8-f6e8-4bbd-a79f-303841c7c796",
                                "sense_id": "3d72793c-309b-3f19-a85d-a15d2e9c83b4",
                                "text": "Indeed, the national enthusiasm for matters medieval outran the ability to unearth the genuine article, and as a result manufacturing pseudomedieval texts became a cottage industry of the 1760s."
                            }
                        ]
                    }
                ],
