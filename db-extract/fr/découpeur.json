                "senses": [
                    {
                        "sense_id": "f95a9bee-b2af-3433-b3a5-3e994a9b084b",
                        "entry_id": "7a86436b-f939-3f8e-b30b-01e636ff1217",
                        "glosses": [
                            "Celui qui travaille en découpure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e8f2ea0-8b4a-49d2-9b2d-4effbf770e63",
                                "sense_id": "f95a9bee-b2af-3433-b3a5-3e994a9b084b",
                                "text": "Au mot CEINTURIER nous avons fait connaître , une sorte d'emporte-pièce , qu'on appelle à dents de rat, et dont le découpeur se sert. Il en emploie dans le même genre qui forment des arcs de cercle, d'autres des étoiles, …."
                            }
                        ]
                    },
                    {
                        "sense_id": "68085659-4c7c-34ae-b302-4595d574ac50",
                        "entry_id": "7a86436b-f939-3f8e-b30b-01e636ff1217",
                        "glosses": [
                            "Celui qui découpe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92e3c973-a060-4eb5-8a4f-51e9836a03ad",
                                "sense_id": "68085659-4c7c-34ae-b302-4595d574ac50",
                                "text": "… et un découpeur servit les plats de viandes diverses et leur offrit des coupes d'or;"
                            }
                        ]
                    },
                    {
                        "sense_id": "0c738718-f43d-321b-9362-6e8f11b185ab",
                        "entry_id": "7a86436b-f939-3f8e-b30b-01e636ff1217",
                        "glosses": [
                            "Machine, appareil destiné à découper."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87dcb35b-f123-47ec-a22e-61178848ff4c",
                                "sense_id": "0c738718-f43d-321b-9362-6e8f11b185ab",
                                "text": "Il aura monté le découpeur plasma par l'escalier."
                            },
                            {
                                "example_id": "5e0de60c-375d-4211-bae1-dfe674f811f2",
                                "sense_id": "0c738718-f43d-321b-9362-6e8f11b185ab",
                                "text": "Et tenu par les mains expertes du nyctalope le découpeur commença d'entamer le plafond... Deux, trois, quatre minutes s'écoulèrent... Mais soudain le découpeur ne ronronna plus."
                            }
                        ]
                    }
