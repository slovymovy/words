    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "6c80bfe3-0819-3f89-99c9-5d4291a9161f",
                "word": "thraldom",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "77a17e29-45c8-49d9-bc4f-80a58f56a8b4",
                        "entry_id": "6c80bfe3-0819-3f89-99c9-5d4291a9161f",
                        "tags": [
                            "plural"
                        ],
                        "form": "thraldoms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1b2055f5-eecc-399a-999c-78d977bfb4f3",
                        "entry_id": "6c80bfe3-0819-3f89-99c9-5d4291a9161f",
                        "glosses": [
                            "A state of bondage, slavery, or subjugation to another person."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b053790c-4617-40b4-9328-83377d7a28dd",
                                "sense_id": "1b2055f5-eecc-399a-999c-78d977bfb4f3",
                                "text": "For ye into like thraldome me did throw,\nAnd kept from complishing the faith which I did owe."
                            },
                            {
                                "example_id": "abd67d68-49a9-40a5-862a-47cb91ebdd90",
                                "sense_id": "1b2055f5-eecc-399a-999c-78d977bfb4f3",
                                "text": "Beauteous Penthea […] is novv ſo yoak'd / To a moſt barbarous thraldome, miſery, / Affliction, that [s]he ſauors not humanity."
                            },
                            {
                                "example_id": "b1181d3e-b2e9-4c41-a141-a06704dc1ac7",
                                "sense_id": "1b2055f5-eecc-399a-999c-78d977bfb4f3",
                                "text": "The wretched thraldom was over,—and what had it left?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9850ac96-5ab8-4317-ac3a-2dc2825a6272",
                        "source_entry_id": "6c80bfe3-0819-3f89-99c9-5d4291a9161f",
                        "source_sense_id": "1b2055f5-eecc-399a-999c-78d977bfb4f3",
                        "source_sense_description": "state of bondage, slavery, or subjugation to another person",
                        "target_lang_word": "esclavage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "esclavage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "085f3bfe-a76e-3b75-ab50-a7e3b4473150",
                                        "entry_id": "a67896f8-d68f-3b68-9bcd-27904ae8d3ba",
                                        "glosses": [
                                            "État ou condition d’un ou d’une esclave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b89223f-149b-4f95-b568-e51351932b88",
                                                "sense_id": "085f3bfe-a76e-3b75-ab50-a7e3b4473150",
                                                "text": "[…] ; jamais un peuple moral et religieux ne peut continuer à rester dans l’esclavage; il devient trop puissant pour ses oppresseurs."
                                            },
                                            {
                                                "example_id": "692f8119-855f-4e29-be30-022d5166c4d5",
                                                "sense_id": "085f3bfe-a76e-3b75-ab50-a7e3b4473150",
                                                "text": "Plus loin, Marx nous fait voir comment l’aurore des temps modernes fut marquée par la conquête de l'Amérique, l’esclavage des nègres et les guerres coloniales : […]."
                                            },
                                            {
                                                "example_id": "121903fc-78f9-480f-ade0-2e5b11fc4dc6",
                                                "sense_id": "085f3bfe-a76e-3b75-ab50-a7e3b4473150",
                                                "text": "Mais nos clercs entendaient que le favorisé prît possession du disgracié, le réduisît en esclavage, comme fait l’homme pour l’animal dont il veut qu’il le serve, […]."
                                            },
                                            {
                                                "example_id": "365468de-2eff-4672-b33e-c9339385ad55",
                                                "sense_id": "085f3bfe-a76e-3b75-ab50-a7e3b4473150",
                                                "text": "La forme de l’esclavage était celle de l’esclavage domestique et le sort des esclaves était certainement moins dur que celui des nègres qui travaillaient dans les plantations d’Amérique ou même des coolies chinois ou canaques qui les ont remplacés."
                                            },
                                            {
                                                "example_id": "6d9bf3be-58f0-4d40-ad98-cca924453a3f",
                                                "sense_id": "085f3bfe-a76e-3b75-ab50-a7e3b4473150",
                                                "text": "Les esclaves africains l’avaient bien compris. Ils avaient compris que l’esclavage leur ôterait leur humanité, qu’il ferait d’eux non plus des êtres, mais des choses. Qu’ils aient pris les Blancs pour des cannibales n’a rien de surprenant."
                                            },
                                            {
                                                "example_id": "945a3010-405c-49ff-be1d-1cfbf6b88359",
                                                "sense_id": "085f3bfe-a76e-3b75-ab50-a7e3b4473150",
                                                "text": "Les défenseurs des droits humains mauritaniens dénoncent là un procès politique et pointent du doigt l'acharnement de l’État contre les abolitionnistes, alors que l’esclavage a officiellement été aboli en 1981 et criminalisé en 2007."
                                            },
                                            {
                                                "example_id": "fc33ce04-dc2b-491d-bdfc-6397602239d5",
                                                "sense_id": "085f3bfe-a76e-3b75-ab50-a7e3b4473150",
                                                "text": "Le retour des émigrés se fait dans le cadre autoritaire du régime consulaire et s’accompagne du rétablissement de l’esclavage et du préjugé de couleur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fed3a9a2-b61c-390c-a041-6c8ca0371aa4",
                                        "entry_id": "a67896f8-d68f-3b68-9bcd-27904ae8d3ba",
                                        "glosses": [
                                            "Tout ce qui tient une personne ou un groupe dans une sorte d’assujettissement ou de dépendance."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75d91fc4-8e9b-4eb4-a3b5-ea157322c13f",
                                                "sense_id": "fed3a9a2-b61c-390c-a041-6c8ca0371aa4",
                                                "text": "Cet emploi est lucratif, mais c’est un véritable esclavage."
                                            },
                                            {
                                                "example_id": "68f3a415-0af3-4ad8-a0d0-83964ba99a39",
                                                "sense_id": "fed3a9a2-b61c-390c-a041-6c8ca0371aa4",
                                                "text": "Camarades lycéens, Il est temps que vous secouiez le joug d’un aussi avilissant esclavage."
                                            },
                                            {
                                                "example_id": "f1ba3c40-f2c6-4bd2-997f-c1a6e0cf572b",
                                                "sense_id": "fed3a9a2-b61c-390c-a041-6c8ca0371aa4",
                                                "text": "L’humanité entière est menacée d’une réduction à un immense système d’esclavage pour tous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "091bf50a-4180-347b-a5dd-22c4f59f9c4c",
                                        "entry_id": "a67896f8-d68f-3b68-9bcd-27904ae8d3ba",
                                        "glosses": [
                                            "Tout ce qui tient une personne ou un groupe dans une sorte d’assujettissement ou de dépendance.",
                                            "État d’une personne dominée par une passion."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd3f3b10-e050-41fc-8004-f2cf063c6210",
                                                "sense_id": "091bf50a-4180-347b-a5dd-22c4f59f9c4c",
                                                "text": "L’amour est un esclavage. — L’esclavage des passions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8a08df8-10e2-3b10-901d-eeecc10edd22",
                                        "entry_id": "a67896f8-d68f-3b68-9bcd-27904ae8d3ba",
                                        "glosses": [
                                            "Tout ce qui tient une personne ou un groupe dans une sorte d’assujettissement ou de dépendance.",
                                            "Contrainte formelle que quelque chose ou quelqu’un impose."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3a706dc-ac7d-492d-a3b6-b33426426ee9",
                                                "sense_id": "c8a08df8-10e2-3b10-901d-eeecc10edd22",
                                                "text": "L’esclavage de la rime."
                                            }
                                        ]
                                    }
                                ]
                            },
