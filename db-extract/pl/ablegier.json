                                                "sense_id": "5ac4c369-24d6-3058-8669-2f8c36591cc9",
                                                "text": "Alle Nachkommen haben schwarze Haare."
                                            },
                                            {
                                                "example_id": "29bd97e2-b407-4e60-b76c-81f03bc44079",
                                                "sense_id": "5ac4c369-24d6-3058-8669-2f8c36591cc9",
                                                "text": "„Andrew und ich waren die letzten Nachkommen einer ziemlich erfolglosen Familie.“"
                                            },
                                            {
                                                "example_id": "84870027-fd09-43b1-98e6-14b4153215d5",
                                                "sense_id": "5ac4c369-24d6-3058-8669-2f8c36591cc9",
                                                "text": "„In den Herren von Friesack und von Plotho hat man zur Erklärung ihrer Stellung ebenfalls Nachkommen wendischer Dynasten erblickt.“"
                                            },
                                            {
                                                "example_id": "b6ff95aa-c3ee-42b7-9c98-7a83baa93c27",
                                                "sense_id": "5ac4c369-24d6-3058-8669-2f8c36591cc9",
                                                "text": "„Er hatte sich dann in Kabul gestgesetzt und startete von dort aus seinen Feldzug nach Indien, das er als Nachkomme Timurs als sein rechtmäßiges Erbe betrachtete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
