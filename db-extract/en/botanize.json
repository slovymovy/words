                                        "glosses": [
                                            "Récolter des herbes, des plantes, dans la nature, soit pour apprendre à les connaître ou pour en former des collections, soit pour les employer aux usages qu’elles ont en médecine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34c9a216-5d2d-4fd9-95de-eb4ff03800d3",
                                                "sense_id": "8024c78f-c0f4-3cd4-91d6-8181d9715f52",
                                                "text": "Il faut botaniser cette région avant de l’ouvrir au développement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
