                "senses": [
                    {
                        "sense_id": "1ca12538-75bf-32aa-a06f-e48b63996b6e",
                        "entry_id": "58036a74-1f05-35df-a5dd-102530d3767c",
                        "glosses": [
                            "psychiatrische Anstalt"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "d98502bd-120c-413c-b1b6-aacc67b38105",
                                "sense_id": "1ca12538-75bf-32aa-a06f-e48b63996b6e",
                                "text": "Wenn du so weiter machst, kommst du noch in die Klapsmühle."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "efd8f89f-8c76-423f-8a67-9aa1663ea71f",
                        "source_entry_id": "58036a74-1f05-35df-a5dd-102530d3767c",
                        "source_sense_id": "1ca12538-75bf-32aa-a06f-e48b63996b6e",
                        "source_sense_description": "umgangssprachlich: psychiatrische Anstalt",
                        "target_lang_word": "madhouse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "madhouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "828e97ae-f1a8-314d-97d7-1a6aa324f7fe",
                                        "entry_id": "de39eb44-eb82-3ac4-ae0a-fe43fe474cbc",
                                        "glosses": [
                                            "A house where insane persons are confined; an insane asylum."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "150b41a1-31d9-48cf-8e14-a539890a0ee2",
                                                "sense_id": "828e97ae-f1a8-314d-97d7-1a6aa324f7fe",
                                                "text": "The palace, the night-cellar, the jail, the madhouse: the chambers of birth and death, of health and sickness, the rigid face of the corpse and the calm sleep of the child: midnight was upon them all."
                                            },
                                            {
                                                "example_id": "4ef54370-49ef-412e-846d-e662ee61f077",
                                                "sense_id": "828e97ae-f1a8-314d-97d7-1a6aa324f7fe",
                                                "text": "The king experienced his first attack in autumn 1788, and as his condition worsened and the physicians-in-ordinary proved unable to cope or cure, the Reverend Dr Francis Willis (1717–1807), a clergyman doctor who ran a madhouse in Lincolnshire, was called in."
                                            },
                                            {
                                                "example_id": "68f76e75-e61d-414b-867b-960510073a8c",
                                                "sense_id": "828e97ae-f1a8-314d-97d7-1a6aa324f7fe",
                                                "text": "He is almost a tourist of his own book. There is a hint of the fad a couple of centuries ago for visiting madhouses in search of the exotic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc20f6ef-c103-3d74-93fb-b0dbb0fdaddc",
                                        "entry_id": "de39eb44-eb82-3ac4-ae0a-fe43fe474cbc",
                                        "glosses": [
                                            "A chaotic, uproarious, noisy place."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f39bab47-c3ea-4c4e-b495-068a6befefa6",
                                                "sense_id": "dc20f6ef-c103-3d74-93fb-b0dbb0fdaddc",
                                                "text": "This taut, soldierly, professional story is something of a stranger among American novels about war making. Angry civilians have writ ten most of the best fiction on the subject, from “Three Soldiers” through “Catch‐22,” to make the point (with a good deal of literary overkill) that wars are mass insanity and that armies are madhouses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ebc90a4b-034a-495d-842d-2d791df92343",
                        "source_entry_id": "58036a74-1f05-35df-a5dd-102530d3767c",
                        "source_sense_id": "1ca12538-75bf-32aa-a06f-e48b63996b6e",
                        "source_sense_description": "umgangssprachlich: psychiatrische Anstalt",
                        "target_lang_word": "дурдом",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "дурдом",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8ccfe2ca-fdce-3287-8d47-629dd81a185d",
                                        "entry_id": "9bc01182-1828-3a57-bcbe-704a60f47f88",
                                        "glosses": [
                                            "разг. то же, что психиатрическая больница"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c551b4f6-a8b6-4929-aae7-d679299e4b32",
                                                "sense_id": "8ccfe2ca-fdce-3287-8d47-629dd81a185d",
                                                "text": "И ещё какое-то время пройдёт, мы будем встречаться то чаще, то реже, прежде чем врач в хорошем платном дурдоме, куда родители и невеста попытаются спрятать Андрюху теперь уже от самых настоящих бандитов, которым он умудрится задолжать ни много ни мало тысяч полтораста долларов, расставит точки над десятеричными «и», отлив истину в тяжёлую латынь диагноза."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "623eeea6-1446-3dbf-9600-c457a5d39cf7",
                                        "entry_id": "9bc01182-1828-3a57-bcbe-704a60f47f88",
                                        "glosses": [
                                            "перен., разг. абсурдная ситуация, положение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51976adf-1610-4762-aea2-6457623f1068",
                                                "sense_id": "623eeea6-1446-3dbf-9600-c457a5d39cf7",
                                                "text": "Практически у всех к Президенту набралось немало острых, нелицеприятных вопросов, и я решил, что буду как бы выразителем скопившихся недоумений, озадаченностей, буду спрашивать обо всех странностях, о загадках, о дурдоме, которого так много в политике и стране."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "665ccf2d-9ffd-4c8e-83a6-0c6f75105f95",
                        "source_entry_id": "58036a74-1f05-35df-a5dd-102530d3767c",
