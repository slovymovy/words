                                        "entry_id": "04fa9565-a578-38e5-af04-845232a348d5",
                                        "glosses": [
                                            "unwillig oder unfähig gefasste Meinungen oder Ansichten zu revidieren; nicht von besseren oder richtigeren Standpunkten zu überzeugen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d7dcdb8-2f0e-40dd-bafd-19394f5be227",
                                                "sense_id": "34df0141-c1fb-3a25-a46a-87ded6fa3ccb",
                                                "text": "Du wirst ihn nicht überzeugen können. Er ist in dieser Hinsicht unbelehrbar."
                                            }
