                                "target_senses": [
                                    {
                                        "sense_id": "f5b89e13-62ab-3b38-9e53-f94b5800314e",
                                        "entry_id": "e1f21d7b-5561-33cd-b3bf-81da005f60c0",
                                        "glosses": [
                                            "Ensemble de voies terrestres fluctuantes reliant de proche en proche, la Chine et l’Iran via l’Asie centrale entre l’Antiquité et le Moyen Âge."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cc1a4544-a7e5-3a67-b8d7-6b34663255c8",
                                        "entry_id": "e1f21d7b-5561-33cd-b3bf-81da005f60c0",
                                        "glosses": [
                                            "Nouvelle route de la soie."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbf92c2b-562c-48d6-9aa8-dfb56da33ecd",
                                                "sense_id": "cc1a4544-a7e5-3a67-b8d7-6b34663255c8",
                                                "text": "La faillite de ce paradis touristique constitue un sérieux avertissement pour tous les pays voisins qui ont suivi la voie des « routes de la soie » ouvertes par la Chine. A commencer par le Pakistan, qui présente de fortes similitudes : surendettement, maigres retombées économiques des chantiers chinois, inflation, dépréciation de sa monnaie, baisse des réserves de change, croissance au ralenti."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
