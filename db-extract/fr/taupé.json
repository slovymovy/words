                    {
                        "sense_id": "3f316f95-2cdc-363c-aeff-aed2b9625443",
                        "entry_id": "92356ee7-a203-3a48-a161-ad45784a18ab",
                        "glosses": [
                            "Chapeau de feutre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfa6e97f-3a1f-4d42-b356-69dfeef5cafd",
                                "sense_id": "3f316f95-2cdc-363c-aeff-aed2b9625443",
                                "text": "Elle avait un tailleur marine et sur la tête, sur ses cheveux blonds, un taupé relevé de côté, presque un chapeau d’homme."
                            },
                            {
                                "example_id": "3be6589c-96a5-41b2-88db-0a2b2494fe0b",
                                "sense_id": "3f316f95-2cdc-363c-aeff-aed2b9625443",
                                "text": "Il peut être impérieux, avec une sorte de chapka en phoque. Pensif, avec un petit taupé de chasseur, comme sur la couverture de Time Magazine."
                            },
                            {
                                "example_id": "ecaa9cf8-83d4-417d-af97-03ac4d3cf477",
                                "sense_id": "3f316f95-2cdc-363c-aeff-aed2b9625443",
                                "text": "Depuis vingt ans, il promène son taupé à bords plats et sa lavallière noire dans les couloirs de la P.J."
                            }
                        ]
                    }
