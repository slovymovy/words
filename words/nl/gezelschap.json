                },
                {
                    "sense_id": "abce561f-d7d0-3086-ab43-e66ee1b772bb",
                    "sense_definition": "Een vereniging of organisatie, vaak gericht op kunst, toneel of muziek.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het bekende toneel<w>gezelschap</w> treedt vanavond op in de grote zaal van de schouwburg.",
                            "target_lang_translations": {
                                "ru": "Известная театральная <w>труппа</w> выступает сегодня вечером в большом зале театра.",
                                "en": "The famous theater <w>company</w> is performing tonight in the main auditorium of the theater.",
                                "zh": "这个著名的剧院<w>剧团</w>今晚将在剧场大厅演出。"
                            }
                        },
                        {
                            "text": "Zij is al jaren lid van een exclusief <w>gezelschap</w> voor literatuurliefhebbers.",
                            "target_lang_translations": {
                                "ru": "Она уже много лет является членом эксклюзивного <w>общества</w> любителей литературы.",
                                "en": "She has been a member of an exclusive <w>society</w> for literature lovers for years.",
                                "zh": "多年来她一直是一个专属文学爱好者<w>社团</w>的成员。"
                            }
                        }
                    ],
