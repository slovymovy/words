    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f6cd5170-4d2d-3756-90c1-9e7011f78e76",
                    "sense_definition": "Qui est pareil, semblable, de même nature ou d'une qualité équivalente.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "similitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je n'ai jamais vu un <w>tel</w> désordre dans cette maison."
                        },
                        {
                            "text": "Pour ce poste exigeant, une <w>telle</w> expérience constitue un atout précieux."
                        }
                    ],
                    "synonyms": [
                        "pareil",
                        "semblable"
                    ],
                    "common_phrases": [
                        "en tant que tel",
                        "rien de tel"
                    ]
                },
                {
                    "sense_id": "3f720324-2713-3c1b-89b7-136da378538e",
                    "sense_definition": "Sert à introduire une comparaison ou à énumérer des exemples concrets.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "similitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle aime beaucoup les fruits d'été, <w>tels</w> que les pêches et les abricots."
                        },
                        {
                            "text": "Une décision délicate <w>telle</w> que celle-ci demande une longue réflexion préalable."
