                        "examples": [
                            {
                                "example_id": "2d152d8f-b223-4034-8b5e-f565c2bf0cb3",
                                "sense_id": "2473c112-1520-353f-bbf0-e6ca155ff9e3",
                                "text": "A resource that profiles the important language of secondary disciplines by adapting the methods of EAP research could therefore be very useful for such pedagogy."
                            },
                            {
                                "example_id": "b78e48e1-dc10-47d7-b3d7-00ba46c99952",
                                "sense_id": "2473c112-1520-353f-bbf0-e6ca155ff9e3",
                                "text": "To explore effective pedagogies to motivate these bilingual doctoral researchers to theorise translingually, this paper draws upon methodologies about translingualism and intercultural doctoral education to dispel the recurrent doubts raised by these bilingual doctoral researchers."
                            }
                        ]
