                },
                {
                    "sense_id": "a2fd542b-f60f-3dbb-9aa0-272d1d62c395",
                    "sense_definition": "Zonder beschadigingen; helemaal heel en compleet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_intact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De archeologen vonden een volledig <w>gave</w> kruik uit de Romeinse tijd.",
                            "target_lang_translations": {
                                "en": "The archaeologists found a completely <w>intact</w> jug from the Roman era.",
                                "ru": "Археологи нашли совершенно <w>целый</w> кувшин римской эпохи."
                            }
                        },
                        {
                            "text": "Deze appel heeft een perfect <w>gaaf</w> oppervlak zonder beurse plekken.",
                            "target_lang_translations": {
                                "en": "This apple has a perfectly <w>flawless</w> surface without bruised spots.",
                                "ru": "У этого яблока идеально <w>чистая</w> поверхность без вмятин."
                            }
                        }
