                ],
                "senses": [
                    {
                        "sense_id": "0bcd6ca5-b13e-3ac5-b222-49579b9cf709",
                        "entry_id": "bf9f65fe-8d98-3eaa-9508-3efe02ae78ae",
                        "glosses": [
                            "eine feingemahlene Zuckersorte, die sich besonders leicht im Backteig löst; etwa zwischen Kristall- und Staubzucker"
                        ],
                        "tags": [
                            "Besonders im österreichischen Sprachraum"
                        ],
                        "examples": [
                            {
                                "example_id": "49c43d03-7b58-46f9-a507-edec05a22aad",
                                "sense_id": "0bcd6ca5-b13e-3ac5-b222-49579b9cf709",
                                "text": "Die Butter mit dem Backzucker und dem Vanillezucker schaumig rühren, nach und nach die Dotter einrühren, dann die vorgewärmte Schokolade dazugeben und gut durchmengen."
                            },
                            {
                                "example_id": "167e1b46-57fa-4212-9019-29b794bd6b9f",
                                "sense_id": "0bcd6ca5-b13e-3ac5-b222-49579b9cf709",
                                "text": "Zucker ist als üblicher weißer Haushaltszucker für die meisten Teige geeignet. Feinster Backzucker löst sich noch leichter auf - ideal für Biskuit."
                            },
                            {
                                "example_id": "9b17035a-3acb-4080-93ee-2408a0af4067",
                                "sense_id": "0bcd6ca5-b13e-3ac5-b222-49579b9cf709",
                                "text": "Erfolge konnten dagegen beim Produkt „Backzucker“ verzeichnet werden."
                            },
                            {
                                "example_id": "061e36e4-0438-4ab6-a50a-75cfc0344b9d",
                                "sense_id": "0bcd6ca5-b13e-3ac5-b222-49579b9cf709",
                                "text": "Um den Schnee die nötige Konsistenz zu geben, ist es gut, etwas Backzucker darunterzuschlagen."
                            },
                            {
                                "example_id": "3d4c92b7-6b98-4a93-b025-723be85486a1",
                                "sense_id": "0bcd6ca5-b13e-3ac5-b222-49579b9cf709",
                                "text": "Kunsthonig ist invertierter Backzucker mit Honigaroma."
                            },
                            {
                                "example_id": "773a2be5-0f5f-4b2d-b676-08fd7361599d",
                                "sense_id": "0bcd6ca5-b13e-3ac5-b222-49579b9cf709",
                                "text": "Man nehme ein Viertel Kilogramm Backzucker, ebensoviel Soda und in das schon brodelnde Fett füge man die kleinen Fleischstückchen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
