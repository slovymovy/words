                ],
                "senses": [
                    {
                        "sense_id": "f7ff3408-c641-35bb-8470-6619f289e6a8",
                        "entry_id": "c4da4b0b-9569-375b-9189-06f31ede8805",
                        "glosses": [
                            "Qui ressemble à une tortue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00a7ce72-e1a8-46ec-b9d9-a834cdfec6c7",
                                "sense_id": "f7ff3408-c641-35bb-8470-6619f289e6a8",
                                "text": "Tous les jours, c’était la même comédie pour qu’il se lève, mange, se lave. Un supplice. Il se retourna, montra sa tête chélonienne, écarquilla deux yeux gris aux blancs presque liquide. Gardamone l’exhorta à avoir un peu de nerfs, se pencha sur lui, le souleva, le porta dans ses bras comme une jeune mariée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ffc6b2a8-224b-408a-9f17-5c27b12b9dc6",
                        "source_entry_id": "c4da4b0b-9569-375b-9189-06f31ede8805",
                        "source_sense_id": "f7ff3408-c641-35bb-8470-6619f289e6a8",
                        "target_lang_word": "chelonian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chelonian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cde58806-88e8-3973-a373-2313b76af482",
                                        "entry_id": "9c227651-b798-3272-8e7e-56f2cc6174b3",
                                        "glosses": [
                                            "Of, relating to, or belonging to the order Chelonia (Testudines), which includes the turtles and tortoises."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d600e235-bbf9-47ff-b8bc-117a75d62284",
                                                "sense_id": "cde58806-88e8-3973-a373-2313b76af482",
                                                "text": "Chelonian eggs may be leathery or parchment-shelled that indent easily when laid and expand due to water uptake during incubation; harder-shelled but expansible eggs which behave much like parchment eggs during incubation; and brittle-shelled eggs which do not indent when laid and usually take up little or no external water during incubation (Ewert, 1979, 1985; Kuchling, 1999)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chelonian",
                                "target_lang_code": "en",
                                "target_senses": [
