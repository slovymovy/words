                    {
                        "translation_id": "8bc95574-93bd-4c7c-8eeb-42c90ec0c29f",
                        "source_entry_id": "9fe9421b-5106-3926-aca0-5f6b0988ca9f",
                        "target_lang_word": "Temperament",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Temperament",
