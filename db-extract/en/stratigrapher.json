                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9eacc36b-7962-42a6-a696-699bb6b5d55f",
                                "sense_id": "f26013c2-84d1-3b0b-afdf-7b800d866fa6",
                                "text": "The barren hills south of Beipiao, swept by an icy wind from Mongolia, stand in stark contrast to the ancient environment, which stratigrapher Hao Zhaolin of the Beipiao Bureau of Mineral Resources Administration describes as \"a shallow, warm lake whose waters teemed with shoals of fish,\" with flocks of birds overhead."
                            },
                            {
                                "example_id": "791946e4-068e-404b-96cc-7dcc26af291c",
                                "sense_id": "f26013c2-84d1-3b0b-afdf-7b800d866fa6",
                                "text": "A senior stratigrapher at the Nanjing Institute of Geology and Paleontology (NIGP), Jin spent up to 6 months before each trip meeting such bureaucratic requirements as advance approval for every piece of correspondence."
                            }
                        ]
                    }
