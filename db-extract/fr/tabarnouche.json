                                "sense_id": "11f54d93-cb19-3d04-b226-f9473162cee4",
                                "text": "Il y a eu des bombardements, en tabarnouche"
                            },
                            {
                                "example_id": "b698f127-9476-4b23-8f45-4de2666a34ae",
                                "sense_id": "11f54d93-cb19-3d04-b226-f9473162cee4",
                                "text": "Ben, tabarnouche, il y en a encore qui se font prendre."
                            }
