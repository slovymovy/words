                                    {
                                        "sense_id": "fd08cfa2-b039-3564-9561-664abd06d892",
                                        "entry_id": "d3d07d5e-2293-342d-be7b-458d7d784022",
                                        "glosses": [
                                            "Wissenschaft und Lehre von Zahn-, Mund-, und Kiefererkrankungen und den in der Mundhöhle liegenden Strukturen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58646402-c448-4fda-a222-0e2c32b769ab",
                                                "sense_id": "fd08cfa2-b039-3564-9561-664abd06d892",
                                                "text": "1904 definierte der ungarische Zahnarzt Josef Arkövy (1851- 1922) die Stomatologie als „einen Zweig der Medizin, dessen Kenntnis- und Tätigkeitsgebiet die Mundhöhle umfasst.\""
                                            },
                                            {
                                                "example_id": "57219ece-2199-47b2-a6a0-7466078e6042",
                                                "sense_id": "fd08cfa2-b039-3564-9561-664abd06d892",
                                                "text": "1953 tauchte unter dem Vorsitz des Hallenser Ordinarius Erwin Reichenbach (1897–1973) vom Wissenschaftlichen Beirat für Zahnmedizin beim Staatssekretariat für Hochschulwesen und Fachschulwesen (SHF) überarbeiteten Studienplan erstmals die „Stomatologie“ anstatt der „Zahn-, Mund- und Kiefer-Heilkunde“ auf."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "360fc13e-bf8b-41f7-9136-a166800dcf62",
                        "source_entry_id": "2accc050-2e4d-37f6-a467-a9c551c1a831",
                        "source_sense_id": "86a66330-0dbc-3b1b-8372-57366ca009da",
                        "target_lang_word": "Zahnmedizin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zahnmedizin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8336b8b6-6b0d-3a59-9d48-fa8d9c065033",
                                        "entry_id": "d0a06105-cfef-3c32-ad3f-c64549ca86e9",
                                        "glosses": [
                                            "Teilgebiet der Medizin, das sich mit der Erkennung, Vorbeugung und Behandlung von Zahn-, Mund- und Kieferkrankheiten beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8bc16dc-0d0a-42dc-8632-b12c21c40840",
                                                "sense_id": "8336b8b6-6b0d-3a59-9d48-fa8d9c065033",
                                                "text": "„Seit diesem Sommer studiert Andrés Zahnmedizin.“"
                                            },
                                            {
                                                "example_id": "c003551e-1bcb-4298-9d06-203aedadfbd5",
                                                "sense_id": "8336b8b6-6b0d-3a59-9d48-fa8d9c065033",
                                                "text": "„Die Geschäfte gehen gut: Die Firma vertreibt ihre Waren in etwa 40 Ländern, bei Implantaten für die Zahnmedizin verzeichnet sie Zuwachsraten von bis zu 30 Prozent.“"
                                            },
                                            {
                                                "example_id": "61d91994-f956-4906-a956-e20ff085845b",
                                                "sense_id": "8336b8b6-6b0d-3a59-9d48-fa8d9c065033",
                                                "text": "„Der älteste aufgefundene Zahnstocher stammt aus der Zeit um 3500 vor Christi. Die Mundhygiene ist damit älter als die Schrift und sehr viel älter als die Zahnmedizin, die vor 300 Jahren noch im Milieu der Jahrmärkte angesiedelt war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40caad08-3c47-408e-8021-482927528b17",
                        "source_entry_id": "2accc050-2e4d-37f6-a467-a9c551c1a831",
                        "source_sense_id": "86a66330-0dbc-3b1b-8372-57366ca009da",
                        "target_lang_word": "Zahnheilkunde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zahnheilkunde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b9e191ba-a93d-331a-8305-ef13cf64d0ab",
                                        "entry_id": "6e0cd434-fd2f-3d65-9337-6dba87a47908",
                                        "glosses": [
                                            "Teilgebiet der Medizin, das sich mit der Vorbeugung, Erkennung und Behandlung von Erkrankungen im Zahn-, Mund- und Kieferbereich beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a6b3731-f62d-44c8-8b8a-515ce0ecab5e",
                                                "sense_id": "b9e191ba-a93d-331a-8305-ef13cf64d0ab",
                                                "text": "Zahnärzte üben die Zahnheilkunde aus."
                                            },
                                            {
                                                "example_id": "7f48da3d-1fe2-4594-9063-6c504693e7b5",
                                                "sense_id": "b9e191ba-a93d-331a-8305-ef13cf64d0ab",
                                                "text": "„Mit Freiheitsstrafe bis zu einem Jahr oder mit Geldstrafe wird bestraft, 1. wer die Zahnheilkunde ausübt, ohne eine Approbation oder Erlaubnis als Zahnarzt zu besitzen […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "85d13d5e-f9d5-40aa-a355-1e60746accbd",
                        "source_entry_id": "2accc050-2e4d-37f6-a467-a9c551c1a831",
                        "source_sense_id": "86a66330-0dbc-3b1b-8372-57366ca009da",
