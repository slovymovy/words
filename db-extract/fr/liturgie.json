        "fr-extract.jsonl": [
            {
                "entry_id": "ccad8aea-0889-305e-b8b8-2583c85a133c",
                "word": "liturgie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "683d3065-cd44-4535-884d-379788913249",
                        "entry_id": "ccad8aea-0889-305e-b8b8-2583c85a133c",
                        "tags": [
                            "plural"
                        ],
                        "form": "liturgies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e8330302-8c3d-353c-9ff5-12b2dcbb7f78",
                        "entry_id": "ccad8aea-0889-305e-b8b8-2583c85a133c",
                        "glosses": [
                            "Ensemble des cérémonies et des prières qui constituent le service divin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff66b798-9290-42e9-a01f-3a3e1e07d81b",
                                "sense_id": "e8330302-8c3d-353c-9ff5-12b2dcbb7f78",
                                "text": "Il n’avait que cela pour lui, mais il l’avait au moins, l’amour passionné de la mystique et de la liturgie, du plain-chant et des Cathédrales !"
                            },
                            {
                                "example_id": "57de9fd7-afb7-4a19-a56b-15341ef100c2",
                                "sense_id": "e8330302-8c3d-353c-9ff5-12b2dcbb7f78",
                                "text": "L’efflorescence de cultes protestants, prometteurs de « guérisons » et d’autres « miracles » et, en attendant, dispensateurs d’entraide et de moments fusionnels grâce à des liturgies participatives, est souvent résumée dans le terme \"révolution charismatique\"."
                            }
                        ]
                    },
                    {
                        "sense_id": "c05d9052-fe80-3688-aa51-e433cd149206",
                        "entry_id": "ccad8aea-0889-305e-b8b8-2583c85a133c",
                        "glosses": [
                            "Appareil cérémoniel."
                        ],
                        "tags": [
                            "analogy",
                            "ironic"
                        ],
                        "examples": [
                            {
                                "example_id": "53d86886-a82e-4381-82bd-feb825cec5a5",
                                "sense_id": "c05d9052-fe80-3688-aa51-e433cd149206",
                                "text": "On le voit, l'idéologie méa-culpiste et les liturgies pénitentielles de Vichy trouvèrent en lui un réfractaire immédiat : il ne refusait certes pas l'examen de conscience mais ce moralisme stérile, déplacé, unilatéral, cette « fuite dans la morale »."
                            }
                        ]
                    },
                    {
                        "sense_id": "2ecc8720-250c-39eb-aac1-606139a27f19",
                        "entry_id": "ccad8aea-0889-305e-b8b8-2583c85a133c",
                        "glosses": [
                            "Ordre des prières et des cérémonies de la messe."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f620be8e-5971-3ab2-a939-81831e045a58",
                        "entry_id": "ccad8aea-0889-305e-b8b8-2583c85a133c",
                        "glosses": [
                            "Dans la Grèce antique, sorte de service civil et d'impôts que payaient les liturges."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d0695f1-9af7-465c-82b4-ccf9b2102ed6",
                        "source_entry_id": "ccad8aea-0889-305e-b8b8-2583c85a133c",
                        "target_lang_word": "Liturgie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Liturgie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "172ac9d5-e84f-31f6-9800-a6860a093a4f",
                                        "entry_id": "62959811-a22d-3179-af81-babdd80e5254",
                                        "glosses": [
                                            "alle ordnungsgemäß bestehenden gottesdienstlichen Handlungen"
                                        ],
                                        "tags": [
                                            "Theologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58f6fdc4-c088-4792-aa76-7240a5453fb0",
                                                "sense_id": "172ac9d5-e84f-31f6-9800-a6860a093a4f",
                                                "text": "Die Reform der Liturgie bedeutet, von liebgewonnenen Ritualen Abschied zu nehmen."
                                            },
                                            {
                                                "example_id": "95a5c955-9887-4961-a80d-81d01758c678",
                                                "sense_id": "172ac9d5-e84f-31f6-9800-a6860a093a4f",
                                                "text": "„Die Bücher, die für die Liturgie gebraucht wurden, die Evangeliare, Sakramente, Perikopenbücher, Graduale, Antiphonare und Epistolare, gehörten nicht so sehr dem Bereich der Bibliothek und der Studierstube als der Sphäre der Kirche an.“"
                                            },
                                            {
                                                "example_id": "2f132e0b-5d98-4e9b-822c-b8a4c47451c0",
                                                "sense_id": "172ac9d5-e84f-31f6-9800-a6860a093a4f",
                                                "text": "„Die Liturgie des Kirchenjahres ist die Theaterkunst, die die Menschheit erfunden hat, um der Zeit eine symbolische Gestalt zu verleihen, von Jahreszeit zu Jahreszeit.“"
                                            },
                                            {
                                                "example_id": "eae46917-0141-40e1-85d4-1f6dc39cde67",
                                                "sense_id": "172ac9d5-e84f-31f6-9800-a6860a093a4f",
                                                "text": "„Sie bekreuzte sich, sie verneigte sich, und wenn sie den Worten der Liturgie nicht folgen konnte, so bat sie, ganz erschrocken über ihre Verworfenheit, Gott möge ihr alles, alles verzeihen und sich ihrer erbarmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b50dc72-2b4d-4115-8358-011ac9942b37",
                        "source_entry_id": "ccad8aea-0889-305e-b8b8-2583c85a133c",
