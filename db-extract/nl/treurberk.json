                        "examples": [
                            {
                                "example_id": "5f9d51e6-3a76-4b0d-906a-4d3f446f2248",
                                "sense_id": "7198733f-4f93-3483-9b0e-6f3f251eb604",
                                "text": "De twintig gerenoveerde woningen vormen straks een hofje rond een bestaande treurberk."
                            },
                            {
                                "example_id": "7af47f5c-1633-4f0f-b2ee-aaee31bc0ecc",
                                "sense_id": "7198733f-4f93-3483-9b0e-6f3f251eb604",
                                "text": "De treurberk direct na de ingang van de klimaatconferentie in Parijs doet zijn naam eer aan. Om de twee hallen van het conferentiecentrum in Le Bourget met elkaar te verbinden, is een overkapping over de gekortwiekte boom gebouwd."
                            }
