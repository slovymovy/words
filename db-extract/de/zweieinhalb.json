                "senses": [
                    {
                        "sense_id": "40181454-2896-3b6c-8643-3ba0c036135c",
                        "entry_id": "b1246415-6925-3ebc-a6ca-73797c26ca56",
                        "glosses": [
                            "zwei Ganze und ein Halbes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0053e3fc-0675-4d23-85c9-80d01ec439e1",
                                "sense_id": "40181454-2896-3b6c-8643-3ba0c036135c",
                                "text": "Für den Kuchen brauche ich zweieinhalb Kilogramm Zwetschgen."
                            },
                            {
                                "example_id": "76440ead-eb27-448c-ba3a-f29e06e4391e",
                                "sense_id": "40181454-2896-3b6c-8643-3ba0c036135c",
                                "text": "Erst zweieinhalb Stunden später waren alle Fragen geklärt und die Sitzung wurde geschlossen."
                            },
                            {
                                "example_id": "224a566b-1548-4f0a-8daa-f54289bdabf0",
                                "sense_id": "40181454-2896-3b6c-8643-3ba0c036135c",
                                "text": "„Aber in der politischen Nachkriegskultur des ostasiatischen Landes […] verschleißen sich Premiers im Schnitt nach kaum zweieinhalb Jahren.“"
                            },
                            {
                                "example_id": "ae966cb1-3a0f-4a00-989c-dddbf9b09546",
                                "sense_id": "40181454-2896-3b6c-8643-3ba0c036135c",
                                "text": "„Erst zweieinhalb Wochen vor der Auslosung begann der wegen Corona verschobene Wettbewerb im Landespokal.“"
                            },
                            {
                                "example_id": "bca7c014-dc40-425a-85ce-860d7212691e",
                                "sense_id": "40181454-2896-3b6c-8643-3ba0c036135c",
                                "text": "„Die Diskussion dauerte zweieinhalb Stunden, bis das Schulgebäude abgesperrt werden mußte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
