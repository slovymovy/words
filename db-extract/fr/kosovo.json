                    },
                    {
                        "form_id": "df657c51-d672-4493-ad15-843789e0de05",
                        "entry_id": "d96bf821-298b-3d8e-9757-10ca145c5d32",
                        "tags": [],
                        "form": "Kossovo"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "02c568dc-153e-3c44-82a1-3b4537276051",
                        "entry_id": "d96bf821-298b-3d8e-9757-10ca145c5d32",
                        "glosses": [
                            "Vaste plaine constituant la partie orientale de la province du Kosovo telle qu’on la connaît actuellement."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "9815c10c-ee15-4554-a6df-c0e58cdc63b0",
                                "sense_id": "02c568dc-153e-3c44-82a1-3b4537276051",
                                "text": "Marko Kraliévitch, homme rocher, était l’image virile de la force ; les veuves de Kosovo enlacées et pleurant leurs morts me chuchotaient que le deuil est encore une forme de volupté."
                            },
                            {
                                "example_id": "b126d4a8-dcde-40e4-aa8d-a015510233e1",
                                "sense_id": "02c568dc-153e-3c44-82a1-3b4537276051",
                                "text": "En 2000, je suis allé au Kosovo et j'ai revêtu une de ces cuirasses des démineurs. C'est lourd, ça pèse trente-cinq kilos."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d4d72f7-f2b6-39da-b0e3-e7f33976c2c0",
                        "entry_id": "d96bf821-298b-3d8e-9757-10ca145c5d32",
                        "glosses": [
                            "Territoire au statut contesté (pays indépendant ou région autonome serbe) situé en Europe du Sud dans les Balkans et en ex-Yougoslavie."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": [
                            {
                                "example_id": "ffa8421d-2293-4497-8361-e50098392295",
                                "sense_id": "9d4d72f7-f2b6-39da-b0e3-e7f33976c2c0",
                                "text": "La présidente du Kosovo, Vjosa Osmani, a assuré qu’elle était « prête à envisager » ces élections."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d0b1418-8135-41db-a8c9-03f75a70b06d",
                        "source_entry_id": "d96bf821-298b-3d8e-9757-10ca145c5d32",
                        "source_sense_description": "région d’Europe",
                        "target_lang_word": "Kosovo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kosovo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95067a10-c50b-39d4-9617-b3f8101be816",
                                        "entry_id": "ed90ac89-81f1-3125-b551-c2fbb9b67fd6",
                                        "glosses": [
                                            "ein De-facto-Regime auf dem Balkan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26ca583c-8db3-4774-95e2-575b69e63cc3",
                                                "sense_id": "95067a10-c50b-39d4-9617-b3f8101be816",
                                                "text": "Kosovo grenzt an Serbien, Mazedonien, Albanien und Montenegro."
                                            },
                                            {
                                                "example_id": "974258b0-8299-4790-87de-985fa20f4542",
                                                "sense_id": "95067a10-c50b-39d4-9617-b3f8101be816",
                                                "text": "„Bei den Kämpfen zwischen der UCK, der separatistischen Befreiungsarmee der mehrheitlich von Albanern bewohnten serbischen Provinz Kosovo, hatte die Nato 1999 mit Luftangriffen interveniert.“"
                                            },
                                            {
                                                "example_id": "0dfb1e2b-6a27-4e5a-ba66-e487e332ba2d",
                                                "sense_id": "95067a10-c50b-39d4-9617-b3f8101be816",
                                                "text": "„Das Gebiet des späteren Kosovo war in der Antike von den Illyrern besiedelt (das römische Theranda in der Nähe des heutigen Prizren war ursprünglich eine illyrische Siedlung).“"
                                            },
                                            {
                                                "example_id": "116cc59a-43d9-4b6d-9784-486b517afd19",
                                                "sense_id": "95067a10-c50b-39d4-9617-b3f8101be816",
                                                "text": "„Als der Balkankrieg 1912 die Osmanenherrschaft endgültig beendete, wurde das Kosovo tatsächlich dem Königreich Serbien angegliedert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be614097-cbe2-4264-ae86-20f9b81233ee",
                        "source_entry_id": "d96bf821-298b-3d8e-9757-10ca145c5d32",
                        "source_sense_description": "région d’Europe",
                        "target_lang_word": "Kosovo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kosovo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0911230c-49ba-3afb-a7b8-b0f26174d5f8",
                                        "entry_id": "73e86c34-e757-37d3-affe-45aaa7258195",
                                        "glosses": [
                                            "A partly-recognized country on the Balkan Peninsula in Southeast Europe. Official name: Republic of Kosovo. Capital and largest city: Pristina. Considered by the Republic of Serbia to be one of its two autonomous provinces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d821cadf-f327-4383-bf06-62e6be3f2c9b",
                                                "sense_id": "0911230c-49ba-3afb-a7b8-b0f26174d5f8",
                                                "text": "Yugoslavia’s President, Slobodan Milosevic, has rejected all efforts at meaningful diplomacy and, in violation of his own previous commitments, has ratcheted up his military campaign against the innocent civilians of Kosovo."
                                            },
                                            {
                                                "example_id": "93629df5-941e-48da-b486-d135d8302b6e",
                                                "sense_id": "0911230c-49ba-3afb-a7b8-b0f26174d5f8",
                                                "text": "After Milosevic’s overthrow in October 2000, international pressure on the new authorities in Belgrade to extradict Milosevic for alleged war crimes committed during the Kosovo conflict was intense."
                                            },
                                            {
                                                "example_id": "be7d6c04-a698-48b0-ab06-98fe763996d8",
                                                "sense_id": "0911230c-49ba-3afb-a7b8-b0f26174d5f8",
                                                "text": "A prominent Kosovo Serb politician, Oliver Ivanovic, was shot dead outside his party offices Tuesday morning, halting talks between Kosovar and Serb delegates that had been set to resume that day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1755dff0-befd-3e68-8c40-7aa21521f9ab",
                                        "entry_id": "73e86c34-e757-37d3-affe-45aaa7258195",
                                        "glosses": [
                                            "One of five administrative districts of the above region as viewed by the Serbian government."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
