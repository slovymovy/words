                "senses": [
                    {
                        "sense_id": "3482fa91-5caf-3126-a508-f970d045fdfd",
                        "entry_id": "7b0634cd-5eaa-3e75-ab00-ff0a80107aed",
                        "glosses": [
                            "zastępowanie jednego składnika majątku innym"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46c77a2b-39c0-47f1-b399-6ad6be3b4fe4",
                                "sense_id": "3482fa91-5caf-3126-a508-f970d045fdfd",
                                "text": "Artykuł omawia zasadę surogacji, zgodnie z którą przedmioty majątkowe nabyte w zamian za przedmioty wchodzące w skład majątku osobistego małżonka, stanowią majątek osobisty tego małżonka"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "122d9e55-14bc-3c4a-8083-33c0b232bcac",
                        "entry_id": "7b0634cd-5eaa-3e75-ab00-ff0a80107aed",
                        "glosses": [
                            "udostępnianie przez kobietę własnego łona zapłodnionej in vitro komórce jajowej innej kobiety lub utrzymanie dziecka w fazie prenatalnej i urodzenie go dla innych osób"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bf6a7f5-f2a4-41e1-af3f-5894488f3e8f",
                                "sense_id": "122d9e55-14bc-3c4a-8083-33c0b232bcac",
                                "text": "Zupełnie niechcący pandemia obnażyła ogromną machinę stojącą za praktyką surogacji, której europejską stolicą jest Ukraina"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
