                    {
                        "translation_id": "3f9d684c-48a7-4154-967e-5d6a0b3fb031",
                        "source_entry_id": "938227ee-d328-3fa5-b2d2-ea1300882751",
                        "source_sense_description": "type of small flute",
                        "target_lang_word": "флажоле́т",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "флажоле́т",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e5dc4656-7c50-3749-b995-5aee9f064545",
                                        "entry_id": "eaf54b68-92ad-362f-bff5-d049c978c13a",
                                        "glosses": [
                                            "продольная флейта высокого регистра"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcebd47a-08e0-4047-99b3-46a9a5dade3a",
                                                "sense_id": "e5dc4656-7c50-3749-b995-5aee9f064545",
                                                "text": "Сегодня чем свет французская военная музыка играла так близко от наших биваков, что я подлаживал ей на моём флажолете; а около двенадцатого часа у нас завязалось жаркое аванпостное дело."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ae91ac0-2a5d-37da-a01e-35c061921116",
                                        "entry_id": "eaf54b68-92ad-362f-bff5-d049c978c13a",
                                        "glosses": [
                                            "органный регистр флейтового типа"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c854879e-78b1-3b70-aa91-7324aa357d8a",
                                        "entry_id": "eaf54b68-92ad-362f-bff5-d049c978c13a",
                                        "glosses": [
                                            "мягкий свистящий звук, напоминающий звучание флейты, получаемый при прикосновении пальца к определённым точкам струны в щипковых и смычковых музыкальных инструментах"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "181c2c9e-4a64-4446-8034-b2c89fe4b10c",
                                                "sense_id": "c854879e-78b1-3b70-aa91-7324aa357d8a",
                                                "text": "Медленное становление в начальной фазе звучало, как всегда у Мартынова, аскетично, зато в финале с помощью сочных струнных басов и скрипичных флажолетов был достигнут эффект красивой, протяженной, как бы повисающей звучности."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed6c004c-bd86-4316-b206-089a94fc4bab",
                        "source_entry_id": "938227ee-d328-3fa5-b2d2-ea1300882751",
                        "source_sense_description": "type of kidney bean",
                        "target_lang_word": "flageolet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flageolet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dccc8593-87bf-3b65-aa40-253ff3a3c37c",
                                        "entry_id": "3a2198e0-b899-3c8f-b223-8ad2524a5c64",
                                        "glosses": [
                                            "Famille de flute à bec possédant un ou plusieurs tuyaux percés et quelquefois munie de clefs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58cb62c8-38b9-4fb8-aa7b-dca34505b58f",
                                                "sense_id": "dccc8593-87bf-3b65-aa40-253ff3a3c37c",
                                                "text": "[…] j’entendais le bruit mat du tambour sur lequel l’homme frappait, le son aigu du flageolet dans lequel il soufflait."
                                            },
                                            {
                                                "example_id": "f9062d71-b644-460c-8f00-a49ef30d5250",
                                                "sense_id": "dccc8593-87bf-3b65-aa40-253ff3a3c37c",
                                                "text": "Oh ! les chastes églogues ! Oh ! les idylles chantées par les poètes ! Oh ! les paysanneries enrubannées et naïves qui défilent, conduites par la muse de Mme Deshoulières, au son des flageolets et des tambourins !"
                                            },
                                            {
                                                "example_id": "19b7cd56-8fb0-4cb2-868b-ff8bad6c6011",
                                                "sense_id": "dccc8593-87bf-3b65-aa40-253ff3a3c37c",
                                                "text": "J'ai vu sur la place de la Cathédrale, un garçon moins fort que lui qui jouait du flageolet en faisant danser une marmotte."
                                            },
                                            {
                                                "example_id": "9a390824-eda2-4774-80d4-e56615a90813",
                                                "sense_id": "dccc8593-87bf-3b65-aa40-253ff3a3c37c",
                                                "text": "Le flageolet, c’est la flûte des bastringues. On suppose qu’elle porte un nom de haricot parce qu’elle produit des sonorités panachées. — (Conférence sur les instruments de musique, Le Cri catalan (Perpignan) du 15 juillet 1911, page 1)"
                                            },
                                            {
                                                "example_id": "957f64f1-c8b2-4712-bf38-8fd49ddaf321",
                                                "sense_id": "dccc8593-87bf-3b65-aa40-253ff3a3c37c",
                                                "text": "Et sur mon flageolet, je fis un joyeux trait, qui fendit l’air, ainsi qu’avec son cri aigu, l’hirondelle."
                                            },
                                            {
                                                "example_id": "e0449f0d-44a5-4b91-b99b-1d668fe93e11",
                                                "sense_id": "dccc8593-87bf-3b65-aa40-253ff3a3c37c",
                                                "text": "Une vieille tradition poétique veut que les bergers vivent allongés sous des ormeaux en jouant du flageolet ou de la cornemuse et en se grisant de laitages fermentés ; moyennant quoi ils vivent jusqu’à cent ans parce qu’ils ne mangent que du yaourt, qui fait les centenaires bulgares."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85878236-337e-342e-bf12-7e0b6737ef1f",
                                        "entry_id": "3a2198e0-b899-3c8f-b223-8ad2524a5c64",
                                        "glosses": [
                                            "Jeu d’orgue aigu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32e1b897-ddd5-49c5-b5c9-11c04b726be6",
                                                "sense_id": "85878236-337e-342e-bf12-7e0b6737ef1f",
                                                "text": "Flageolet. C’est le nom de cette technique. On pose juste le doigt sur la corde et on arrive à chatouiller les harmoniques. Comment ça marche acoustiquement, je ne vais pas me mettre à vous l’expliquer, ça nous entraînerait trop loin. N’avez qu’à regarder dans un dictionnaire, tout à l’heure."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "flageolet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "00efe95c-0751-305e-9dc0-a054033b1e8b",
                                        "entry_id": "d4a84783-a45c-321e-9d57-371539b8af51",
                                        "glosses": [
                                            "Variété de haricots secs dont on consomme les graines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8989feb-4548-4ee1-ab72-08b9cd4d2490",
                                                "sense_id": "00efe95c-0751-305e-9dc0-a054033b1e8b",
                                                "text": "Après un gigot flageolets avalé chez belle-maman, qu’il appelle « ma mère », monsieur met à profit l’après-midi dominical pour s’immerger dans la comptabilité familiale."
                                            },
                                            {
                                                "example_id": "0d2920d8-681e-49c2-b3d8-ef7930dd3cd1",
                                                "sense_id": "00efe95c-0751-305e-9dc0-a054033b1e8b",
                                                "text": "Un gigot d’agneau aux flageolets."
                                            },
                                            {
                                                "example_id": "57c0358a-6471-495c-842c-60d1aad951e3",
                                                "sense_id": "00efe95c-0751-305e-9dc0-a054033b1e8b",
                                                "text": "J’allais chercher le sac contenant les flageolets, il était percé de mille petits trous et il grouillait de charançons. Adieu, beaux rêves de nourritures fastueuses ! Il fallut tout jeter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
