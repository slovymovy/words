                                "example_id": "f78ece03-3549-4135-adc5-1ad805ea72c0",
                                "sense_id": "1f84eb52-cc56-3ab1-bcf5-9fde2096410a",
                                "text": "Un poison arsenical."
                            },
                            {
                                "example_id": "2f700513-e599-413d-bf42-a11357fb5265",
                                "sense_id": "1f84eb52-cc56-3ab1-bcf5-9fde2096410a",
                                "text": "Des poisons arsenicaux."
