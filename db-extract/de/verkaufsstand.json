                    {
                        "translation_id": "9848658f-6dbe-488f-b8ef-3941e75e0242",
                        "source_entry_id": "de6d3461-6fdb-335a-9f51-3bcdaff9a54f",
                        "source_sense_id": "153a2343-da5b-3404-ac74-a7168acd080f",
