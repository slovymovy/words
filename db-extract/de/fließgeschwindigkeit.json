                        "sense_id": "321f620c-2b88-35a3-84d5-95a1614d418e",
                        "entry_id": "aa58d38e-d517-35e9-9f0e-b4ce39de9ecd",
                        "glosses": [
                            "Geschwindigkeit, mit der sich das Wasser eines Fließgewässers durch sein Bett bewegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cd6d51d-4aea-4b0c-b7fb-0ed5d96ddb98",
                                "sense_id": "321f620c-2b88-35a3-84d5-95a1614d418e",
                                "text": "„Der Fluss da unten sah zwar wunderschön aus, aber Shaw wusste, dass er kalt wie Metall im Januar sein und seine Fließgeschwindigkeit mehr als dreißig Kilometer pro Stunde betragen würde.“"
                            }
                        ],
