                        "entry_id": "ad5f58e0-6c59-3257-8bcc-207ffcc37b58",
                        "glosses": [
                            "Narcotrafiquante, vendeuse de drogue, de stupéfiants."
                        ],
                        "tags": [
                            "Anglicism",
                            "slang"
                        ],
                        "examples": [
                            {
