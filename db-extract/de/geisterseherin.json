                        "glosses": [
                            "weibliche Person, die glaubt, wandelnde Seelen von Toten zu sehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61164684-bd2c-4fcb-85cd-aaee4c6de186",
                                "sense_id": "85aaef56-de00-36bd-86d3-ca7da0d7d51e",
                                "text": "„Ein gebürtiger Rudolf Leder nannte sich als Dichter Stephan Hermlin; aus dem Kärntner-Mädel Gertrude Wirschinger wurde die führende Geisterseherin Penny McLean; quälend ungewiß bleibt, ob Shakespeare so hieß oder bloß unter diesem Namen seine Stücke schrieb.“"
                            },
                            {
                                "example_id": "d7c99ec7-2376-47a8-85f9-9f5b21f8f06d",
                                "sense_id": "85aaef56-de00-36bd-86d3-ca7da0d7d51e",
                                "text": "„Ich fand meinen angeblichen Sohn bei Frau von Urfé, oder besser gesagt, in den Armen meiner lieben Geisterseherin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
