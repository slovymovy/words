                ],
                "senses": [
                    {
                        "sense_id": "d528efe6-0474-3834-8f75-1c6c69ea7a21",
                        "entry_id": "e34293a8-be16-307f-9718-ca5eee1a8952",
                        "glosses": [
                            "A good character in a story, often a hero."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "c9abfac1-23c2-4fa7-b935-4566919b6c4c",
                                "sense_id": "d528efe6-0474-3834-8f75-1c6c69ea7a21",
                                "text": "What really gets to me in these goodies versus baddies movies is just how useless the baddies are."
                            }
                        ]
                    },
                    {
                        "sense_id": "a97ef47e-02e7-3717-b132-938683cea207",
                        "entry_id": "e34293a8-be16-307f-9718-ca5eee1a8952",
                        "glosses": [
                            "Alternative spelling of goody."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b99fe83-824b-48fd-9a28-fdd5ae81c2f1",
                        "source_entry_id": "e34293a8-be16-307f-9718-ca5eee1a8952",
                        "source_sense_description": "a good character in a story",
                        "target_lang_word": "gentil",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gentil",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7baa132a-1410-3507-a50c-1432f97cddc4",
                                        "entry_id": "6035e60f-da6d-3579-b73d-6d93e8f964bb",
                                        "glosses": [
                                            "Agréable, charmant, mignon, aimable. Qui a une certaine grâce, un certain agrément délicat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4b447eb-f061-47c4-a962-b43fd183bf34",
                                                "sense_id": "7baa132a-1410-3507-a50c-1432f97cddc4",
                                                "text": "C’est alors que l’on vit passer une gentille petite souris grise."
                                            },
                                            {
                                                "example_id": "8a91a00e-b0e5-40cd-90aa-5dcbf68c805a",
                                                "sense_id": "7baa132a-1410-3507-a50c-1432f97cddc4",
                                                "text": "Charles est un trop gentil garçon, il est facile à tromper."
                                            },
                                            {
                                                "example_id": "08f0bc32-7be1-42e7-b003-b71ce5d10625",
                                                "sense_id": "7baa132a-1410-3507-a50c-1432f97cddc4",
                                                "text": "Il a des défauts, mais nous l’aimons quand même, car nous sommes gentils."
                                            },
                                            {
                                                "example_id": "968b955f-5f98-4241-8797-5d708d070add",
                                                "sense_id": "7baa132a-1410-3507-a50c-1432f97cddc4",
                                                "text": "C’est un gentil petit pays, une gentille petite bourgade."
                                            },
                                            {
                                                "example_id": "6d2197b8-cbb3-4ee0-b0df-fdd9095f1d19",
                                                "sense_id": "7baa132a-1410-3507-a50c-1432f97cddc4",
                                                "text": "Il n’est guère gentil avec moi, j’ai à me plaindre de lui."
                                            },
                                            {
                                                "example_id": "e23f461d-430a-40de-bffa-bbf2d37acb94",
                                                "sense_id": "7baa132a-1410-3507-a50c-1432f97cddc4",
                                                "text": "Parce que Indiana est si jalouse !… elle va croire des choses !… Vous seriez bien gentils de lui dire que j'ai passé la nuit chez vous à jouer au bézigue… ou au mistron."
                                            },
                                            {
                                                "example_id": "3018d5a7-ab6e-4088-a414-6cda964bf31f",
                                                "sense_id": "7baa132a-1410-3507-a50c-1432f97cddc4",
                                                "text": "Vous pouvez amener qui vous voulez. Je ne dirais pas cela à tout le monde. Mais je suis sûre que vos amis sont gentils, je vois tout de suite que nous nous comprenons."
                                            },
                                            {
                                                "example_id": "3319878a-3706-4dc4-87a8-858b45f9ec8e",
                                                "sense_id": "7baa132a-1410-3507-a50c-1432f97cddc4",
                                                "text": "Vous aurez la même robe qu’elle, mais vous serez élégante. Vous serez coiffée comme elle, mais vous serez gentille."
                                            },
                                            {
                                                "example_id": "f81a4350-ece1-4abd-a3c7-29fd259a9981",
                                                "sense_id": "7baa132a-1410-3507-a50c-1432f97cddc4",
                                                "text": "Elle se prit à regarder toutes choses autour de nous. Elle disait, de temps en temps : « C’est assez gentil… Oui… Ce n’est pas si mal… » Mais toute la gymnastique de ses rides signifiait : « Peuh… on me les donnerait, vos meubles, que je n’en voudrais pour rien au monde. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56b687a7-cf01-31a9-a974-130c1edcf688",
                                        "entry_id": "6035e60f-da6d-3579-b73d-6d93e8f964bb",
                                        "glosses": [
                                            "Chouette, sympa."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf74b3f6-59d3-4e96-8ebf-aaf0583c8db5",
                                                "sense_id": "56b687a7-cf01-31a9-a974-130c1edcf688",
                                                "text": "— Est-ce que nous n’allons pas sortir, mon chéri ?… Ce serait si gentil de faire un tour de Bois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1428d033-a2aa-3a31-aeaf-1ecabea13ad8",
                                        "entry_id": "6035e60f-da6d-3579-b73d-6d93e8f964bb",
                                        "glosses": [
                                            "Sage, tranquille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cecc346-0d2f-4f17-8903-dacaf1b08bc9",
                                                "sense_id": "1428d033-a2aa-3a31-aeaf-1ecabea13ad8",
                                                "text": "Les enfants ont été gentils, ce soir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f5aaae5-8c79-3d86-944c-d52fe7c30bdc",
                                        "entry_id": "6035e60f-da6d-3579-b73d-6d93e8f964bb",
                                        "glosses": [
                                            "Coquet, important."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2afa31d4-19bf-4aec-850d-b716c69f426a",
                                                "sense_id": "2f5aaae5-8c79-3d86-944c-d52fe7c30bdc",
                                                "text": "C’est une gentille somme d’argent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92172340-0d79-3b9e-9bc0-4c8254c3e708",
                                        "entry_id": "6035e60f-da6d-3579-b73d-6d93e8f964bb",
                                        "glosses": [
                                            "Noble."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "688f6c5b-ad46-4681-895a-eb1c40301de0",
                                                "sense_id": "92172340-0d79-3b9e-9bc0-4c8254c3e708",
                                                "text": "Gentil compagnon."
                                            },
                                            {
                                                "example_id": "6a3ca2b5-23eb-4158-803b-2ab8524560b8",
                                                "sense_id": "92172340-0d79-3b9e-9bc0-4c8254c3e708",
                                                "text": "Dans le gentil pays de France, le gentilhomme se préparait à un tournoi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "339555ba-ebc2-3344-95d6-f8353e82f1b5",
                                        "entry_id": "6035e60f-da6d-3579-b73d-6d93e8f964bb",
                                        "glosses": [
                                            "Qui est bête, simplet."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edcc8bf1-8eb1-490c-bca7-d6e025d7b696",
                                                "sense_id": "339555ba-ebc2-3344-95d6-f8353e82f1b5",
                                                "text": "Dominique ? Oh, oui, il est gentil…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "794020cb-c7a5-39d9-a64a-ebdb0a3c48cc",
                                        "entry_id": "6035e60f-da6d-3579-b73d-6d93e8f964bb",
                                        "glosses": [
                                            "Peu sympathique."
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6f69650-ffcf-45d8-92ca-4801ea4a18b8",
                                                "sense_id": "794020cb-c7a5-39d9-a64a-ebdb0a3c48cc",
                                                "text": "Vous faites là un gentil personnage, un gentil métier : vous jouez là un rôle peu sympathique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2dd48268-66d0-3e40-8dbd-f49236dc26b2",
                                        "entry_id": "6035e60f-da6d-3579-b73d-6d93e8f964bb",
                                        "glosses": [
                                            "Qualifie celui dont on désapprouve l’impertinence ou la sottise."
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09c7ad23-7840-4568-a6eb-99a21a66ea44",
                                                "sense_id": "2dd48268-66d0-3e40-8dbd-f49236dc26b2",
                                                "text": "Je vous trouve gentil de me dire cela."
                                            },
                                            {
                                                "example_id": "c9e96a0d-36fc-4a24-8303-048896918d4d",
                                                "sense_id": "2dd48268-66d0-3e40-8dbd-f49236dc26b2",
                                                "text": "Pour exprimer poliment une désapprobation : C’est bien gentil, mais…"
                                            },
                                            {
                                                "example_id": "939595d6-35ea-46b7-b6d8-e40ed943013a",
                                                "sense_id": "2dd48268-66d0-3e40-8dbd-f49236dc26b2",
                                                "text": "— Guillaume est revenu ! Guillaume est revenu !… Et vous ne me le dites pas ! Et vous me laissez tout déballer !… Ah bien ! je suis gentille, moi, à vous vanter mon beurre et mes œufs, lorsque Guillaume est revenu !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gentil",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c69c8392-0967-351d-a0e2-ed369a243eab",
                                        "entry_id": "013c9c8a-2690-3645-b03d-61f450cdf7c5",
                                        "glosses": [
                                            "Personnage d’une œuvre de fiction qui incarne le bien, par opposition au méchant qui fait le mal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "499cc7e3-2baa-4372-b219-400d265da979",
                                                "sense_id": "c69c8392-0967-351d-a0e2-ed369a243eab",
                                                "text": "De nombreux contes ou films pour enfants reposent sur l’opposition manichéenne entre les gentils et les méchants : Cendrillon, Peau d’Âne ou Blanche-Neige victimes d’une méchante belle-mère, Tintin et Milou contre Rastapopoulos et son complice Allan, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cf17ff7-dd85-34ba-9703-97f3513c5807",
                                        "entry_id": "013c9c8a-2690-3645-b03d-61f450cdf7c5",
                                        "glosses": [
                                            "Personne bienveillante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "970926e1-307e-4a48-96c1-7bf5c72a31de",
                                                "sense_id": "8cf17ff7-dd85-34ba-9703-97f3513c5807",
                                                "text": "Depuis ma naissance, une seule fois j'avais croisé un gentil. Barnabé, le garde champêtre qui avait dessiné une poule dans son carnet, plutôt que d'y inscrire que je venais de volet trois œufs au paysan Maurel. … Ça n'existait pas, les gentils. Dans la vie il y avait les hypocrites, les menteurs, les sournois, mais jamais de gentils. Cet homme ne pouvait pas l'être. Il avait une saloperie en tête."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bc4d1be-3168-3ebd-94d8-08f5a2035c17",
                                        "entry_id": "013c9c8a-2690-3645-b03d-61f450cdf7c5",
                                        "glosses": [
                                            "Personne qui respecte la loi, la morale et l'ordre public."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10c0c339-9ce0-4ced-bb89-ddfe20100952",
                                                "sense_id": "4bc4d1be-3168-3ebd-94d8-08f5a2035c17",
                                                "text": "Qui fait des économies? Les gentils!\nEt qui gaspille son argent? Les méchants!\nQui c'est qui vend des fusils? Les gentils!\nQui c'est qui s'retrouve devant? Les méchants!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gentil",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5fd83a0e-7fc2-3da8-8c67-b1120d3a18c0",
                                        "entry_id": "a978fe8f-1848-33bf-8e33-ef973a5626f2",
                                        "glosses": [
                                            "Non-juif, se dit dans le Nouveau Testament indifféremment des premiers chrétiens non-juifs et de l’ensemble des païens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37ccd363-3746-48a5-b321-e37fe2378697",
                                                "sense_id": "5fd83a0e-7fc2-3da8-8c67-b1120d3a18c0",
                                                "text": "Saint Paul est appelé « l’apôtre des gentils »."
                                            },
                                            {
                                                "example_id": "dda22579-2df9-472e-963c-5218ca8fe5ae",
                                                "sense_id": "5fd83a0e-7fc2-3da8-8c67-b1120d3a18c0",
                                                "text": "Les juifs, on le sait bien, étaient aussi généreux dans l’exercice des devoirs de la charité et de l’hospitalité envers leurs frères, qu’ils passaient pour être récalcitrants et ladres quand il s’agissait de les appliquer à ceux qu’ils nommaient gentils, et qui, par leur conduite, méritaient peu certainement cette hospitalité de leur part."
                                            },
                                            {
                                                "example_id": "fff55f9c-d021-4af1-aa55-c40fe44cff5d",
                                                "sense_id": "5fd83a0e-7fc2-3da8-8c67-b1120d3a18c0",
                                                "text": "Les hellénistes [les Juifs hellénisés] se mirent donc à vivre selon les coutumes des gentils ; ils établirent à Jérusalem un gymnase où les jeunes gens s’exerçaient aux jeux et aux sciences de la Grèce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4dc5218-4d20-306b-a03f-06c2328532c4",
                                        "entry_id": "a978fe8f-1848-33bf-8e33-ef973a5626f2",
                                        "glosses": [
                                            "Tout incroyant par rapport à telle ou telle religion."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff1815b8-bb16-41a6-bcb3-334843d3385f",
                                                "sense_id": "c4dc5218-4d20-306b-a03f-06c2328532c4",
                                                "text": "Enfin, la Somme contre les gentils est aussi à la fois un développement et une réfutation de la pensée de philosophes antérieurs commentateurs d’Aristote, l’arabe musulman Averroès (1126-1198) et le juif Maïmonide (1138-1204)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
