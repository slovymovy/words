                "translations": [
                    {
                        "translation_id": "3393989b-3569-4be8-bbca-825ae4630b54",
                        "source_entry_id": "139be775-104e-3f83-b25f-2e5d2d4d545e",
                        "source_sense_id": "2a644e7c-5e3d-3af1-9a68-d174a5a69bcc",
                        "target_lang_word": "adultération",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adultération",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c9f67d4e-bdf3-398d-aad8-c7a5e9044d4e",
                                        "entry_id": "f4f45f53-7a0f-3541-b3f3-c9c0ecf768b9",
                                        "glosses": [
                                            "Action d’adultérer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f63e6c4d-584e-4b53-b1e0-1e4cceb23474",
                                                "sense_id": "c9f67d4e-bdf3-398d-aad8-c7a5e9044d4e",
                                                "text": "Aujourd’hui, cette frelaterie des produits, cette adultération criminelle a gagné le commerce intérieur et le commerce des choses les plus nécessaires à la vie."
                                            },
                                            {
                                                "example_id": "cee12b7e-67b2-44c1-bcb1-bed59e1bd3b3",
                                                "sense_id": "c9f67d4e-bdf3-398d-aad8-c7a5e9044d4e",
                                                "text": "Le mouillage est une véritable adultération du lait, car non seulement il diminue ses qualités nutritives, mais il introduit directement dans un aliment populaire les germes morbides que peuvent contenir les eaux de toute provenance employées par les falsificateurs."
                                            },
                                            {
                                                "example_id": "81840324-1cca-4495-81bb-7197c033a7db",
                                                "sense_id": "c9f67d4e-bdf3-398d-aad8-c7a5e9044d4e",
                                                "text": "Mandin n’a pas, tort quand il fait remonter ces incorrections, ces fautes, ce travail de destruction de la langue aux Symbolistes. Le fait est qu’ils ont été des artistes en charabia et en adultération."
                                            },
                                            {
                                                "example_id": "1b6fd8b1-580f-4780-8fc2-0e70da55cee8",
                                                "sense_id": "c9f67d4e-bdf3-398d-aad8-c7a5e9044d4e",
                                                "text": "Actuellement, il n’existe aucun moyen absolu de déterminer quantitativement l’adultération."
                                            },
                                            {
                                                "example_id": "e782ce7b-2920-46f6-80bb-f7523bbb24b7",
                                                "sense_id": "c9f67d4e-bdf3-398d-aad8-c7a5e9044d4e",
                                                "text": "En 1889, Cazeneuve et Hugounenq signalent à leur collègue Barral l’existence d’empoisonnements liés à des adultérations d’anis étoilé par des « badianes toxiques »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
