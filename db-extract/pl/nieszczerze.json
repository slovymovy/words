                        "examples": [
                            {
                                "example_id": "0acdd985-dafc-491c-a088-05b4b693a0da",
                                "sense_id": "e5184f0f-11ac-3bd7-9efa-4799bb2b0a9f",
                                "text": "Nawet siostry Stelli, które zawsze okazywały jej prawdziwą sympatię, teraz, widocznie zrażone zepchnięciem ich w półfinale do roli adiutantek Magdy, uśmiechały się do niej z przymusem i nieszczerze."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c16dbc7-a29a-40d3-9dd3-e5cff6dbc131",
                        "source_entry_id": "886e6eb7-661d-36bd-9d7e-3908ff17f2ce",
                        "source_sense_id": "e5184f0f-11ac-3bd7-9efa-4799bb2b0a9f",
                        "target_lang_word": "dishonestly",
