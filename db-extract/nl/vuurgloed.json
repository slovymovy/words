                        "source_entry_id": "81269b8e-1604-3d91-8a9b-ea607bae098e",
                        "source_sense_id": "338e59b9-7ff4-35b6-ad9f-0f978bdf4b78",
                        "target_lang_word": "firelight",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
