                        "cross_references": [
                            {
                                "target_word": "Акапулько",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5966c6c9-6c3e-35e0-98c5-4b79fde2a974",
                                        "entry_id": "40db0f53-5f57-3ece-9a75-35be6eb66390",
                                        "glosses": [
                                            "геогр. город в Мексике"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b2485b0-f2ea-4665-a725-7ad5f3f4ac21",
                                                "sense_id": "5966c6c9-6c3e-35e0-98c5-4b79fde2a974",
                                                "text": "Молодой человек совершил очень удачное путешествие в Японию, на Филиппины, в Маниллу, а оттуда в Акапулько, на западном берегу Мексики."
                                            },
                                            {
                                                "example_id": "ad6b67e5-d35b-4307-97ac-d0ba2237237b",
                                                "sense_id": "5966c6c9-6c3e-35e0-98c5-4b79fde2a974",
                                                "text": "Из Кито Гумбольдт и его спутник продолжали путешествие на юг до Лимы, а затем из гавани Каллао направились морем на север, в Гваякиль, пробыв в котором некоторое время, двинулись далее в мексиканский порт Акапулько."
                                            },
                                            {
                                                "example_id": "1fec1157-bdf2-4764-b2d6-57345a22f09a",
                                                "sense_id": "5966c6c9-6c3e-35e0-98c5-4b79fde2a974",
                                                "text": "Внезапно он встретил там испанское купеческое судно, шедшее из Манилы, столицы Филиппинских островов, в Акапулько, порт Мексики."
                                            },
                                            {
                                                "example_id": "8be6d938-7e28-4268-bbe6-99eb18009bf8",
                                                "sense_id": "5966c6c9-6c3e-35e0-98c5-4b79fde2a974",
                                                "text": "Во многих странах мира с нетерпением ожидают выхода на экран киноэпопеи С. Бондарчука «Война и мир». После её успеха на IV Международном московском кинофестивале с двумя первыми сериями ознакомились и зрители на фестивалях в Венеции, Риме, Мар-дель-Плата и Акапулько (Мексика)."
                                            },
                                            {
                                                "example_id": "4d753895-1756-4ca7-868d-656e63931363",
                                                "sense_id": "5966c6c9-6c3e-35e0-98c5-4b79fde2a974",
                                                "text": "Празднество проходило в курортном городе Акапулько, одном из красивейших мест Мексики."
                                            },
                                            {
                                                "example_id": "ede98822-d662-4b14-8ba2-c4e191b0ab0c",
                                                "sense_id": "5966c6c9-6c3e-35e0-98c5-4b79fde2a974",
                                                "text": "Мы покупались в море-океане и в бассейне, а поутру выехали в Мехико через Акапулько."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
