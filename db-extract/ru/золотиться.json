                ],
                "senses": [
                    {
                        "sense_id": "cfb62a9b-d980-39b0-a10f-6f0849d8cd6a",
                        "entry_id": "29aa26af-af45-3189-85c9-a59d677d5679",
                        "glosses": [
                            "быть золотистым, иметь золотистый оттенок"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca40ddbe-9563-4bc1-b32a-6616971e95a4",
                                "sense_id": "cfb62a9b-d980-39b0-a10f-6f0849d8cd6a",
                                "text": "Небо уже бело, и на верхушке самого высокого дерева уже начинают золотиться лучи восходящего солнца."
                            },
                            {
                                "example_id": "37120306-cf39-4c00-8d43-7dc194fb072a",
                                "sense_id": "cfb62a9b-d980-39b0-a10f-6f0849d8cd6a",
                                "text": "В синем просвете расступившихся гор золотились кресты издали белевшего монастыря."
                            }
                        ]
                    },
                    {
                        "sense_id": "ef1d9325-b254-3224-a0ff-ff583a211d48",
                        "entry_id": "29aa26af-af45-3189-85c9-a59d677d5679",
                        "glosses": [
                            "страд. к золотить"
                        ],
                        "tags": [
                            "passive"
                        ],
                        "examples": [
                            {
                                "example_id": "06791248-827d-4b68-a33d-c975a3ef1d42",
                                "sense_id": "ef1d9325-b254-3224-a0ff-ff583a211d48",
                                "text": "Все эти вещи делывались обыкновенно из серебра и золотились."
                            }
                        ]
                    }
                ],
