                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60207cdd-ecf1-46c8-ad78-98576a9fb1f3",
                                "sense_id": "690c124d-3ed4-300b-82cc-f2efc12c5ae4",
                                "text": "Tot nu is het ontstane tekort aan gas en elektriciteit, veroorzaakt door een inflexibele vraag en een wegvallend aanbod, vooral opgevat als een financieel probleem."
                            },
                            {
                                "example_id": "9234c14a-8a7e-4001-b116-f0fdafebf2f5",
                                "sense_id": "690c124d-3ed4-300b-82cc-f2efc12c5ae4",
                                "text": "Ouders bij haar op de poli omschrijven hun kind vaak als koppig, inflexibel en in het bezit van een sterke eigen wil."
                            }
                        ]
                    }
