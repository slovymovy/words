    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b6ae6e39-d331-31e3-8d35-01e46651d135",
                    "sense_definition": "zamknąć zamek błyskawiczny lub spiąć brzegi czegoś za pomocą suwaka",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "zamykanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przed wyjściem na mróz szybko <w>zasunął</w> ciepłą kurtkę pod samą szyję.",
                            "target_lang_translations": {
                                "ru": "Перед выходом на мороз он быстро <w>застегнул</w> тёплую куртку до самой шеи."
                            }
                        },
                        {
                            "text": "Zapomniałeś <w>zasunąć</w> bocznej kieszeni w plecaku i mogły ci wypaść klucze.",
                            "target_lang_translations": {
                                "ru": "Ты забыл <w>застегнуть</w> боковой карман на рюкзаке, и у тебя могли выпасть ключи."
                            }
                        }
                    ],
                    "antonyms": [
                        "rozsunąć"
                    ],
                    "common_phrases": [
                        "zasunąć zamek",
                        "zasunąć suwak",
                        "zasunąć kurtkę",
                        "zasunąć plecak"
                    ],
                    "target_lang_definitions": {
                        "ru": "застегнуть молнию или соединить края чего-либо с помощью застёжки-молнии"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "застегнуть",
                                "target_lang_sense_clarification": "молнию, куртку"
                            },
                            {
                                "target_lang_word": "закрыть",
                                "target_lang_sense_clarification": "на молнию, например карман или рюкзак"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94a0fa25-f672-3e43-91ed-a73e6cbd6e3f",
                    "sense_definition": "zasłonić lub zasunąć coś, przesuwając to wzdłuż jakiejś powierzchni",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "zamykanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gdy wieczorem zrobiło się ciemno, <w>zasunęła</w> grube zasłony w sypialni.",
                            "target_lang_translations": {
                                "ru": "Когда вечером стемнело, она <w>задёрнула</w> плотные шторы в спальне."
                            }
                        },
                        {
                            "text": "W słoneczny dzień warto <w>zasunąć</w> rolety, aby pokój się zbytnio nie nagrzał.",
                            "target_lang_translations": {
                                "ru": "В солнечный день стоит <w>опустить</w> жалюзи, чтобы комната слишком сильно не нагревалась."
                            }
                        }
                    ],
                    "synonyms": [
                        "zaciągnąć"
                    ],
                    "antonyms": [
                        "rozsunąć",
                        "odsunąć"
                    ],
                    "common_phrases": [
                        "zasunąć zasłony",
                        "zasunąć firanki",
                        "zasunąć rolety"
                    ],
                    "target_lang_definitions": {
                        "ru": "задёрнуть, прикрыть или закрыть что-либо, перемещая вдоль поверхности (шторы, занавески)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задёрнуть",
                                "target_lang_sense_clarification": "шторы, занавески"
                            },
                            {
                                "target_lang_word": "задвинуть",
                                "target_lang_sense_clarification": "шторы, жалюзи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb79bf6f-ddb9-3e4d-9b85-de08c7cfd3b7",
                    "sense_definition": "zamknąć coś ruchomego przez wepchnięcie na właściwe miejsce",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zamykanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wyjął z biurka ważny dokument i ostrożnie <w>zasunął</w> szufladę z powrotem.",
                            "target_lang_translations": {
                                "ru": "Он достал из стола важный документ и осторожно <w>задвинул</w> ящик обратно."
                            }
                        },
                        {
                            "text": "Pamiętaj, aby dokładnie <w>zasunąć</w> drzwi przesuwne w korytarzu.",
                            "target_lang_translations": {
                                "ru": "Не забудь плотно <w>задвинуть</w> раздвижную дверь в коридоре."
                            }
                        }
                    ],
                    "antonyms": [
                        "wysunąć",
                        "odsunąć"
                    ],
                    "common_phrases": [
                        "zasunąć szufladę"
                    ],
                    "target_lang_definitions": {
                        "ru": "закрыть что-либо подвижное, задвинув на место"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задвинуть",
                                "target_lang_sense_clarification": "ящик стола, раздвижную дверь"
                            },
                            {
                                "target_lang_word": "закрыть",
                                "target_lang_sense_clarification": "сдвинув на место"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c426baeb-5dd1-337b-a607-06b8ed69d004",
                    "sense_definition": "zadać komuś cios ręką lub przedmiotem; mocno uderzyć",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uderzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Podczas bójki przed klubem nieznajomy mężczyzna nagle <w>zasunął</w> mu prosto w nos.",
                            "target_lang_translations": {
                                "ru": "Во время драки перед клубом незнакомый мужчина вдруг <w>заехал</w> ему прямо в нос."
                            }
                        },
                        {
                            "text": "Zawodnik stracił panowanie nad sobą i niespodziewanie <w>zasunął</w> przeciwnikowi pięścią.",
                            "target_lang_translations": {
                                "ru": "Игрок потерял самообладание и неожиданно <w>врезал</w> сопернику кулаком."
                            }
                        }
                    ],
                    "synonyms": [
                        "uderzyć",
                        "walnąć",
                        "przywalić",
                        "trzasnąć"
                    ],
                    "common_phrases": [
                        "zasunąć pięścią",
                        "zasunąć w nos"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "нанести кому-либо удар рукой или предметом; сильно ударить"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "врезать",
                                "target_lang_sense_clarification": "сильно ударить, дать тумака"
                            },
                            {
                                "target_lang_word": "заехать",
                                "target_lang_sense_clarification": "ударить, например в нос или по лицу"
                            },
                            {
                                "target_lang_word": "треснуть",
                                "target_lang_sense_clarification": "ударить кулаком или предметом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63a4abfd-9384-3a76-894f-e3a3f8975e94",
                    "sense_definition": "przywłaszczyć sobie cudzą rzecz niezgodnie z prawem; ukraść",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ktoś bezczelnie <w>zasunął</w> mój portfel, kiedy na chwilę zostawiłem płaszcz na krześle.",
                            "target_lang_translations": {
                                "ru": "Кто-то внаглую <w>стащил</w> мой бумажник, когда я на минутку оставил пальто на стуле."
                            }
                        },
                        {
                            "text": "Złodzieje sprytnie <w>zasunęli</w> drogi rower stojący pod klatką schodową.",
                            "target_lang_translations": {
                                "ru": "Воры ловко <w>увели</w> дорогой велосипед, стоявший под подъездом."
                            }
                        }
                    ],
                    "synonyms": [
                        "ukraść",
                        "buchnąć",
                        "zwędzić",
                        "zakosić"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "slangowe"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "незаконно присвоить чужую вещь; украсть"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стащить",
                                "target_lang_sense_clarification": "украсть, умыкнуть"
                            },
                            {
                                "target_lang_word": "увести",
                                "target_lang_sense_clarification": "украсть вещь"
                            },
                            {
                                "target_lang_word": "свистнуть",
                                "target_lang_sense_clarification": "быстро и незаметно украсть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7ff6846-b95f-364c-aaae-1511e4fab983",
                    "sense_definition": "powiedzieć coś niespodziewanego, niestosownego lub zaskakującego",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nauczyciel zamilkł ze zdziwienia, gdy uczeń nagle <w>zasunął</w> taką dziwną teorię.",
                            "target_lang_translations": {
                                "ru": "Учитель онемел от удивления, когда ученик вдруг <w>выдал</w> такую странную теорию."
                            }
                        },
                        {
                            "text": "Podczas uroczystego obiadu wujek nieoczekiwanie <w>zasunął</w> bardzo żenujący dowcip.",
                            "target_lang_translations": {
                                "ru": "Во время торжественного обеда дядя неожиданно <w>ляпнул</w> очень неловкую шутку."
                            }
                        }
                    ],
                    "synonyms": [
