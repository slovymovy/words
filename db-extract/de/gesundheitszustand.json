                ],
                "senses": [
                    {
                        "sense_id": "8765482d-d52d-3d24-918b-419bc3dac455",
                        "entry_id": "c78e2894-706c-33ef-8d15-4f954c77318a",
                        "glosses": [
                            "Zustand der Gesundheit einer Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2a5aadb-e6d8-4c4c-af00-ef592f0aa086",
                                "sense_id": "8765482d-d52d-3d24-918b-419bc3dac455",
                                "text": "Sein Gesundheitszustand ist stabil, wir müssen den Patienten aber weiter beobachten."
                            },
                            {
                                "example_id": "c0358f3b-d7a2-47d7-b2d3-1296601b8c8f",
                                "sense_id": "8765482d-d52d-3d24-918b-419bc3dac455",
                                "text": "„Der erschütterte Gesundheitszustand fast aller Kulturvölker der Gegenwart hat seine Ursache im Genuß entwerteter und künstlich verfeinerter Nahrung.“"
                            },
                            {
                                "example_id": "0bf9deab-525d-4b41-b732-e4e6d96fc50f",
                                "sense_id": "8765482d-d52d-3d24-918b-419bc3dac455",
                                "text": "„Im Februar 1854 verschlechterte sich sein Gesundheitszustand in dramatischer Weise.“"
                            },
                            {
                                "example_id": "5a810903-4120-4830-9c69-8d066dc1a1f1",
                                "sense_id": "8765482d-d52d-3d24-918b-419bc3dac455",
                                "text": "„Die Mutter war an seinem Gesundheitszustand nicht unschuldig.“"
                            },
                            {
                                "example_id": "b84e788e-4325-4304-9ee7-9c31ace5bb3e",
                                "sense_id": "8765482d-d52d-3d24-918b-419bc3dac455",
                                "text": "„Hoffmanns Gesundheitszustand ist schlecht, sein Organismus so angegriffen, daß er die Notwendigkeit fühlt, eine Erholungsreise in die Schlesischen Berge zu machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b59585ca-081b-4e94-82f1-30b52f89f96c",
                        "source_entry_id": "c78e2894-706c-33ef-8d15-4f954c77318a",
                        "source_sense_id": "8765482d-d52d-3d24-918b-419bc3dac455",
                        "source_sense_description": "Zustand der Gesundheit einer Person",
                        "target_lang_word": "health",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "health",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7beb81ce-2867-3fe0-ab1c-05ba41be4591",
                                        "entry_id": "d7df74ec-e188-3dee-8df5-01530f23ed26",
                                        "glosses": [
                                            "The state of being free from physical or psychological disease, illness, or malfunction; wellness."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb75a5c3-6719-45f6-86e0-8cde48cbadd3",
                                                "sense_id": "7beb81ce-2867-3fe0-ab1c-05ba41be4591",
                                                "text": "Her mental health is really affected by stressful environments."
                                            },
                                            {
                                                "example_id": "db9c10aa-6dc3-4dca-9257-745001126b55",
                                                "sense_id": "7beb81ce-2867-3fe0-ab1c-05ba41be4591",
                                                "text": "My granpa still enjoys very good health."
                                            },
                                            {
                                                "example_id": "d1c00a47-e3fc-4a11-927a-a80351d8edf1",
                                                "sense_id": "7beb81ce-2867-3fe0-ab1c-05ba41be4591",
                                                "text": "Then he commenced to talk, really talk. and inside of two flaps of a herring's fin he had me mesmerized, like Eben Holt's boy at the town hall show. He talked about the ills of humanity, and the glories of health and Nature and service and land knows what all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d5c9253-18df-3da9-a00a-f4400d5380be",
                                        "entry_id": "d7df74ec-e188-3dee-8df5-01530f23ed26",
                                        "glosses": [
                                            "A state of well-being or balance, often physical but sometimes also mental and social; the overall level of function of an organism from the cellular (micro) level to the social (macro) level."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa60c953-2427-4fa4-b1cd-1d8500152ea9",
                                                "sense_id": "3d5c9253-18df-3da9-a00a-f4400d5380be",
                                                "text": "The directors are concerned about the financial health of the project."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4edd05ac-fe3a-3949-8967-3d579ad6bc59",
                                        "entry_id": "d7df74ec-e188-3dee-8df5-01530f23ed26",
                                        "glosses": [
                                            "Physical condition."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0863a153-2208-3585-9ece-3856d67455ca",
                                        "entry_id": "d7df74ec-e188-3dee-8df5-01530f23ed26",
                                        "glosses": [
                                            "Cure, remedy."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
