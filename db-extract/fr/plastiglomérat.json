                "senses": [
                    {
                        "sense_id": "c1d1fd1b-e55d-332c-9d74-7312a49389ac",
                        "entry_id": "a8c2a1a9-0524-395e-9549-1e9f1aef3030",
                        "glosses": [
                            "Roche détritique composée en partie d’éléments artificiels et créée sous l’action d’une forte chaleur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71f5345b-4576-4e5c-832c-0d32e08fe64d",
                                "sense_id": "c1d1fd1b-e55d-332c-9d74-7312a49389ac",
                                "text": "Nous avons suscité l’émergence de roches nouvelles, dont le fameux plastiglomérat, résultant de la traversée de décharges par les laves volcaniques, etc."
                            },
                            {
                                "example_id": "1abf0a5a-974c-4db0-9ce1-3d50095e451a",
                                "sense_id": "c1d1fd1b-e55d-332c-9d74-7312a49389ac",
                                "text": "Pour la géologue, les plastiglomérats sont certainement présents sur d’autres littoraux du monde, mais ils n’ont simplement pas encore été repérés. Naturellement déposés sur les fonds marins, ils sont ensuite enfouis dans les sédiments où ils peuvent être conservés au cours du temps."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b68fe60e-d9aa-4362-a342-62de1a4b58f4",
