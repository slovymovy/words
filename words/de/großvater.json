                {
                    "sense_id": "d9676d47-c742-3d9f-9411-85538dae9726",
                    "sense_definition": "ein Mann von hohem Alter",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "alter_mensch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Auf der Bank im Park saß ein alter <w>Großvater</w> und fütterte Tauben.",
                            "target_lang_translations": {
                                "en": "An old <w>grandfather</w> sat on the bench in the park feeding pigeons.",
                                "ru": "На скамейке в парке сидел старый <w>дедушка</w> и кормил голубей.",
                                "nl": "Op het bankje in het park zat een oude <w>opa</w> en voerde duiven.",
                                "pl": "Na ławce w parku siedział stary <w>dziadek</w> i karmił gołębie.",
                                "fr": "Sur le banc du parc, un vieux <w>grand-père</w> était assis et nourrissait les pigeons.",
                                "it": "Sulla panchina nel parco sedeva un vecchio <w>nonno</w> che dava da mangiare ai piccioni.",
                                "cs": "Na lavičce v parku seděl starý <w>dědeček</w> a krmil holuby.",
                                "tr": "Parktaki bankta yaşlı bir <w>dede</w> oturmuş, güvercinleri besliyordu.",
                                "es": "En el banco del parque estaba sentado un viejo <w>abuelo</w> que daba de comer a las palomas.",
                                "zh": "公园的长椅上坐着一位年迈的<w>老爷爷</w>，正在喂鸽子。"
                            }
                        },
                        {
                            "text": "Der freundliche <w>Großvater</w> half dem Kind über die Straße.",
                            "target_lang_translations": {
                                "en": "The friendly <w>old man</w> helped the child across the street.",
                                "ru": "Приветливый <w>дедушка</w> помог ребёнку перейти через дорогу.",
                                "nl": "De vriendelijke <w>oude man</w> hielp het kind bij het oversteken.",
                                "pl": "Życzliwy <w>starszy pan</w> pomógł dziecku przejść przez ulicę.",
                                "fr": "L'aimable <w>vieil homme</w> aida l'enfant à traverser la rue.",
                                "it": "Il gentile <w>anziano</w> aiutò il bambino ad attraversare la strada.",
                                "cs": "Laskavý <w>dědeček</w> pomohl dítěti přejít ulici.",
                                "tr": "Güler yüzlü <w>yaşlı adam</w> çocuğun yolun karşısına geçmesine yardım etti.",
                                "es": "El amable <w>anciano</w> ayudó al niño a cruzar la calle.",
                                "zh": "那位和蔼的<w>老爷爷</w>帮孩子过了马路。"
                            }
                        }
                    ],
