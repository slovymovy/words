                        "examples": [
                            {
                                "example_id": "be242ec0-6ddb-4be8-bd2b-f49eea5d9444",
                                "sense_id": "c94e2f0d-3cc7-3413-a2ea-9bf4fb11e9a3",
                                "text": "It was as unstock as a hot rod . But it was all we had for a practice car ."
                            },
                            {
                                "example_id": "7b5f3423-5274-4f31-93a3-3ee803df75ba",
                                "sense_id": "c94e2f0d-3cc7-3413-a2ea-9bf4fb11e9a3",
                                "text": "And pinned to the seats of Tyler Wilson's outlandishly unstock Ford While, from the opposite side of the valley, scalding in each curve, came the black din And brunt of Sonny Walker's highjacker Chevrolet, everyone screaming"
                            },
                            {
                                "example_id": "507788f3-b734-4cfb-8907-26de0c774f7e",
                                "sense_id": "c94e2f0d-3cc7-3413-a2ea-9bf4fb11e9a3",
                                "text": "Proust's novel is filled with people who behave in unstock ways."
