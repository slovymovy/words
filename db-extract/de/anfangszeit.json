                "senses": [
                    {
                        "sense_id": "0d95119d-b868-33bd-bf5b-e357ecc2737c",
                        "entry_id": "9882b317-a15e-339d-a3cd-a743361b1394",
                        "glosses": [
                            "Zeitabschnitt, in dem etwas beginnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b32d5d0-0d25-4881-846a-94fe5ab58ad4",
                                "sense_id": "0d95119d-b868-33bd-bf5b-e357ecc2737c",
                                "text": "„Die Hoffnung aus der Anfangszeit der Zukunftsforschung, Langzeitprognosen stellen zu können, hat sich nicht erfüllt.“"
                            },
                            {
                                "example_id": "15c23cb1-7c3c-4281-825b-f7338da07824",
                                "sense_id": "0d95119d-b868-33bd-bf5b-e357ecc2737c",
                                "text": "„Seit den Apollo-Missionen kennt man magnetisiertes Mondgestein, der Mond muss also in seiner Anfangszeit vor rund vier Milliarden Jahren ein Magnetfeld besessen haben.“"
                            },
                            {
                                "example_id": "472afca8-6082-4376-91e3-e075a4e348ab",
                                "sense_id": "0d95119d-b868-33bd-bf5b-e357ecc2737c",
                                "text": "„Einmal, als ich in der Anfangszeit noch viele Leichtsinnsverluste erlebte, hatte ich ein Erfolgserlebnis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
