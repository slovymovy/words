                        "glosses": [
                            "Of, pertaining to, or affecting multiple generations; multigeneration."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea1d0b79-28e8-4398-bfda-114464320215",
                                "sense_id": "78130b6e-4d84-3ac6-a27e-fa7fef1506f9",
                                "text": "The sons and daughters in a multigenerational household go to work while the grandparents watch the grandchildren. That arrangement of family life is much more resilient to economic hardship."
                            }
                        ]
                    }
                ],
