                        "translation_id": "e71f4d88-453c-4cd2-b138-252811f9bef9",
                        "source_entry_id": "0da7ac32-e0a2-326d-9e20-ffbd88082bae",
                        "source_sense_id": "1baf6dda-a6a6-3717-a9d4-c57960de36b6",
                        "target_lang_word": "hoar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hoar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bf742186-68a2-3a37-ad44-a24ca5ce4b61",
                                        "entry_id": "711c2e1b-d2e6-3118-90b0-deff00d51a1c",
                                        "glosses": [
                                            "A white or greyish-white colour."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ff9bc1ac-e521-3459-ac41-c8dbe2466b5e",
                                        "entry_id": "711c2e1b-d2e6-3118-90b0-deff00d51a1c",
                                        "glosses": [
                                            "Hoariness; antiquity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d163e2ca-c94a-4037-9a87-c7e74e9a963c",
                                                "sense_id": "ff9bc1ac-e521-3459-ac41-c8dbe2466b5e",
                                                "text": "His grants are engrafted on the public law of Europe, covered with the awful hoar of innumerable ages."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hoar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30eb8c69-8256-327f-90b1-96b4c994fc8c",
                                        "entry_id": "7c86e4e2-7f6d-3f6a-8c86-29d077df680a",
                                        "glosses": [
                                            "Of a white or greyish-white colour."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d77be5b2-4463-47d7-8da1-e3d19761aa51",
                                                "sense_id": "30eb8c69-8256-327f-90b1-96b4c994fc8c",
                                                "text": "hoar waters"
                                            },
                                            {
                                                "example_id": "e74b2f56-c0db-4192-bc85-0de0048774f1",
                                                "sense_id": "30eb8c69-8256-327f-90b1-96b4c994fc8c",
                                                "text": "old trees with trunks all hoar"
                                            },
                                            {
                                                "example_id": "1681a84c-8f39-42c9-ac22-45df45f90324",
                                                "sense_id": "30eb8c69-8256-327f-90b1-96b4c994fc8c",
                                                "text": "Bright fell the moonlight on pillar and court and shattered wall, hiding all their rents and imperfections in its silver garment, and clothing their hoar majesty with the peculiar glory of the night."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42ba19d0-df75-3d5d-94e1-9ddf0b89db20",
                                        "entry_id": "7c86e4e2-7f6d-3f6a-8c86-29d077df680a",
                                        "glosses": [
                                            "Hoarily bearded."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fac3b6fb-bffa-4ca2-8a28-87b987cff233",
                                                "sense_id": "42ba19d0-df75-3d5d-94e1-9ddf0b89db20",
                                                "text": "And lo, where rapt in beauty's heavenly dream\nHoar Plato walks his olived Academe."
                                            },
                                            {
                                                "example_id": "524c26bd-ecf2-4d5b-922b-c59d6c052556",
                                                "sense_id": "42ba19d0-df75-3d5d-94e1-9ddf0b89db20",
                                                "text": "This is the forest primeval. The murmuring pines and the hemlocks,\nBearded with moss, and in garments green, indistinct in the twilight,\nStand like Druids of eld, with voices sad and prophetic,\nStand like harpers hoar, with beards that rest on their bosoms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "362517a8-589b-388e-9522-9fdfaf816c62",
                                        "entry_id": "7c86e4e2-7f6d-3f6a-8c86-29d077df680a",
                                        "glosses": [
                                            "Musty; mouldy; stale."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd78a45f-b8e3-40db-bc5c-f6cedfadef82",
                                                "sense_id": "362517a8-589b-388e-9522-9fdfaf816c62",
                                                "text": "But a hare that is hoar / Is too much for a score / When it hoars ere it be spent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd33e90d-3ef2-3d7a-b92c-313b4f8a923a",
                                        "entry_id": "7c86e4e2-7f6d-3f6a-8c86-29d077df680a",
                                        "glosses": [
                                            "Figuratively, grey-haired with age."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01c4d48f-3ab9-4126-bb5c-68a1bb72d6bf",
                                                "sense_id": "bd33e90d-3ef2-3d7a-b92c-313b4f8a923a",
                                                "text": "Be Thou with me until Old-age, and even to hoar hairs do Thou carrie me. P. Isa. 46.4."
                                            },
                                            {
                                                "example_id": "aa0458c8-d24e-409a-8922-9f57e0c66873",
                                                "sense_id": "bd33e90d-3ef2-3d7a-b92c-313b4f8a923a",
                                                "text": "The great popularity of the Stuarts—certainly more allied to personal causes than we can at present calculate—is a curious fact. It was not one of those feelings drawn from hoar antiquity, when habit has become religion."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hoar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54329646-d76c-3f87-be45-b7bb84381bdd",
                                        "entry_id": "35f825cc-1aa8-382b-87ef-b87e39112828",
                                        "glosses": [
                                            "To become mouldy or musty."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
