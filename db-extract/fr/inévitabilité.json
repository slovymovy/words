                ],
                "senses": [
                    {
                        "sense_id": "9111062e-bed6-35bd-a53e-b01de4f87731",
                        "entry_id": "1d2498f8-b934-37a7-ac98-8c557efe76a7",
                        "glosses": [
                            "Caractère de ce qui est inévitable."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "889cbc52-bb72-453a-870f-0bdecfb942b1",
                                "sense_id": "9111062e-bed6-35bd-a53e-b01de4f87731",
                                "text": "Tout au long de notre existence, nous ressentons la tension entre l’inévitabilité de la mort et l'envie de continuer à exister. Que nous en soyons conscients ou non, l’inévitabilité de la fin est source d'anxiété."
                            },
                            {
                                "example_id": "cddb8d41-f0f0-441d-a767-5512a022ddf0",
                                "sense_id": "9111062e-bed6-35bd-a53e-b01de4f87731",
                                "text": "Les deux auteurs, qui ont rencontré dans leur quête de trois ans aussi bien Julian Assange et sa galaxie WikiLeaks dans son refuge londonien, que Henry Kissinger, le vieux cynique de la realpolitik, mettent en avant une « inévitabilité » des tendances qu’ils annoncent. Et restent optimistes pour un avenir pourtant sacrément parsemé de dangers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03d27861-116f-407c-ad8f-94c59e9c80d9",
                        "source_entry_id": "1d2498f8-b934-37a7-ac98-8c557efe76a7",
                        "source_sense_id": "9111062e-bed6-35bd-a53e-b01de4f87731",
                        "target_lang_word": "inevitability",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inevitability",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63dc2c67-7103-322b-b996-f29ad6b9de30",
                                        "entry_id": "674744b3-ce40-3af8-8932-2674fc0b3334",
                                        "glosses": [
                                            "The condition of being inevitable."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2eeb36a-e773-48d9-b3bc-ec3738e8c57c",
                                                "sense_id": "63dc2c67-7103-322b-b996-f29ad6b9de30",
                                                "text": "Now, cramped and outclassed as Euston has become, rebuilding hangs over it with an awful inevitability."
                                            },
                                            {
                                                "example_id": "77ba60bb-026f-4b87-a121-1a53403d4095",
                                                "sense_id": "63dc2c67-7103-322b-b996-f29ad6b9de30",
                                                "text": "Surveillance capitalism is a human creation. It lives in history, not in technological inevitability."
                                            },
                                            {
                                                "example_id": "aebd9271-04a6-4e6a-bd78-921654eb799e",
                                                "sense_id": "63dc2c67-7103-322b-b996-f29ad6b9de30",
                                                "text": "Manchester United's 27-year-old captain cut a distracted and chaotic figure as he endured a personal nightmare, its conclusion with a red card carrying an air of inevitability from the moment he recklessly launched himself at Yussuf Poulsen to pick up an early yellow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06810141-0240-327f-94d5-74540bd48645",
                                        "entry_id": "674744b3-ce40-3af8-8932-2674fc0b3334",
                                        "glosses": [
                                            "An inevitable condition or outcome."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "30574f07-5c2f-4fc6-9291-46824b41937b",
                        "source_entry_id": "1d2498f8-b934-37a7-ac98-8c557efe76a7",
                        "source_sense_id": "9111062e-bed6-35bd-a53e-b01de4f87731",
