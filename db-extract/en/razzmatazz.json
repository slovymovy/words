                "senses": [
                    {
                        "sense_id": "e26d3ba1-d52a-362c-a2fe-1ad3f3205679",
                        "entry_id": "10de17fc-a3be-3b3a-a3f6-52b457a1c980",
                        "glosses": [
                            "Ambiguous or meaningless language."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "ecf834bd-0f1c-4af6-bc6e-7458f71dc809",
                                "sense_id": "e26d3ba1-d52a-362c-a2fe-1ad3f3205679",
                                "text": "He says he's late for the meeting because his daughter had an emergency at school, but I don't buy this razzmatazz."
                            }
                        ]
                    },
                    {
                        "sense_id": "15cff854-1f5b-3da1-ad43-327fe9c1cb47",
                        "entry_id": "10de17fc-a3be-3b3a-a3f6-52b457a1c980",
                        "glosses": [
                            "Empty and tiresome speculation."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "58e1c3af-a46f-4cdd-8e4b-5d18e002f23f",
                                "sense_id": "15cff854-1f5b-3da1-ad43-327fe9c1cb47",
                                "text": "A few politicians are creating some razzmatazz about reinstating the draft."
                            }
                        ]
                    },
                    {
                        "sense_id": "810394ef-bf16-376a-a936-6f2897cf4fee",
                        "entry_id": "10de17fc-a3be-3b3a-a3f6-52b457a1c980",
                        "glosses": [
                            "Something presenting itself in a fanciful and showy, often unrealistic manner, especially when intended to impress and confuse."
                        ],
                        "tags": [
                            "informal",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "30c2075b-7ffe-4d89-be88-26d5dad759f1",
                                "sense_id": "810394ef-bf16-376a-a936-6f2897cf4fee",
                                "text": "Is he really the next big thing, or is all the media attention just a bunch of razzmatazz?"
                            },
                            {
                                "example_id": "2ecea0d8-1564-4afd-9e46-3c844676ca6b",
                                "sense_id": "810394ef-bf16-376a-a936-6f2897cf4fee",
                                "text": "But plans to build a stage over water at the Bellagio hotel fountains had to be abandoned, along with the traditional 'war rooms', where team officials discuss their strategy throughout.\nWhile the unique circumstances meant the draft lacked its usual razzmatazz, it more than made up for it by offering fans a rare glimpse into the homes and lives of some of the game's biggest names."
                            }
                        ]
                    },
                    {
                        "sense_id": "f601f2db-fcb3-3014-993e-fa735cc2958f",
                        "entry_id": "10de17fc-a3be-3b3a-a3f6-52b457a1c980",
                        "glosses": [
                            "A long and imposing series of mindless but necessary tasks."
                        ],
                        "tags": [
                            "rare",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "6a33056a-026c-4a37-bcbb-a653e7903b8b",
                                "sense_id": "f601f2db-fcb3-3014-993e-fa735cc2958f",
                                "text": "When I finally got done dealing with all the razzmatazz of college registration, I decided to go out and have a drink."
                            }
                        ]
                    },
                    {
                        "sense_id": "27f525b9-da8a-3f98-a11b-073d01ab7677",
                        "entry_id": "10de17fc-a3be-3b3a-a3f6-52b457a1c980",
                        "glosses": [
                            "Energy, excitement, vigor."
                        ],
                        "tags": [
                            "obsolete",
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    }
