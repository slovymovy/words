                        "glosses": [
                            "Relatif à Pablo Picasso, à son œuvre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1624ba14-9751-4a16-887c-4b9f8a3b25e1",
                                "sense_id": "e6b82e43-8193-363d-a8ea-9048cc64de92",
                                "text": "Je souffle un nuage bleuté qui se transforme en une figure picassienne puis j’attaque, l’œil en accent circonflexe pour mieux me concentrer."
                            },
                            {
                                "example_id": "20154cb5-2f5e-4ee4-9f8c-c692a7247778",
                                "sense_id": "e6b82e43-8193-363d-a8ea-9048cc64de92",
                                "text": "Une fois dépassé le séquençage artificiel des périodes s’impose cette unité signifiante de l’art picassien dont tous les éléments ou moments apparaissent d’importance égale et concourent à produire l’œuvre dans sa polysémie."
                            }
                        ]
                    }
