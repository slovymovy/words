                ],
                "senses": [
                    {
                        "sense_id": "5e6aa10b-a6d4-338a-baa6-ce0635a38408",
                        "entry_id": "453abb98-bb3c-3813-b31c-49327bad4c3f",
                        "glosses": [
                            "Selbstverpflichtung/Verpflichtung zu gemeinnütziger Arbeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0fd6169-9a44-4f70-9696-c81f8a7c2dc3",
                                "sense_id": "5e6aa10b-a6d4-338a-baa6-ce0635a38408",
                                "text": "„Im Mai 1945 wird er von den Briten verhaftet und als Kriegsgefangener zum Arbeitsdienst auf einem Hof in der Nähe von Stade verurteilt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b20d1ff2-1d60-31ad-8501-be6b28e05b9b",
                        "entry_id": "453abb98-bb3c-3813-b31c-49327bad4c3f",
                        "glosses": [
                            "Nationalsozialismus: Kurzwort für Reichsarbeitsdienst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3196dc5-d908-478a-b6d3-084e0db39c7f",
                                "sense_id": "b20d1ff2-1d60-31ad-8501-be6b28e05b9b",
                                "text": "„Denn kaum war der Arbeitsdienst vorüber, stürzte der 20-jährige sich in ein besonders veritables Abenteuer: eine Fahrt mit seinem Faltboot Marke Klepper auf der Donau von Passau bis zum Schwarzen Meer.“"
                            },
                            {
                                "example_id": "197691d1-3bdf-4cf0-9274-0d33c4117667",
                                "sense_id": "b20d1ff2-1d60-31ad-8501-be6b28e05b9b",
                                "text": "„Jeder vierte Weißrusse ist im Zweiten Weltkrieg umgekommen, ein weiteres Viertel von den Deutschen zum Arbeitsdienst verschleppt worden – die Hälfte der Bevölkerung war 1944 tot oder deportiert.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
