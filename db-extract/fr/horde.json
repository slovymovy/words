        "fr-extract.jsonl": [
            {
                "entry_id": "03c11698-7b0d-3047-a373-86ecbec4639e",
                "word": "horde",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "df4d84a6-07f0-4c07-9f4d-a35419efc577",
                        "entry_id": "03c11698-7b0d-3047-a373-86ecbec4639e",
                        "tags": [
                            "plural"
                        ],
                        "form": "hordes"
                    },
                    {
                        "form_id": "df18676e-de0c-405b-9f4f-f477907faea2",
                        "entry_id": "03c11698-7b0d-3047-a373-86ecbec4639e",
                        "tags": [
                            "singular",
                            "plural"
                        ],
                        "form": "^((h aspiré))\\ɔʁd\\"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "828d21af-bc42-3164-90be-9cb35c5e35ff",
                        "entry_id": "03c11698-7b0d-3047-a373-86ecbec4639e",
                        "glosses": [
                            "Tribu nomade d’Asie centrale."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5371e2c2-50f7-3042-bac7-1393b302cc5d",
                        "entry_id": "03c11698-7b0d-3047-a373-86ecbec4639e",
                        "glosses": [
                            "Troupe nombreuse d’hommes qui vivent en société, mais sans avoir d’établissement fixe."
                        ],
                        "tags": [
                            "collective"
                        ],
                        "examples": [
                            {
                                "example_id": "7c42f1e0-b2d2-45ab-88a5-7fcb17009c5d",
                                "sense_id": "5371e2c2-50f7-3042-bac7-1393b302cc5d",
                                "text": "Le gros des troupes était une horde de barbares dans toute la force du terme. C’était de ces figures étranges qui avaient parcouru la Gaule au temps d’Attila et de Chlodowig."
                            }
                        ]
                    },
                    {
                        "sense_id": "04947498-9141-3453-9586-7d457f573eb7",
                        "entry_id": "03c11698-7b0d-3047-a373-86ecbec4639e",
                        "glosses": [
                            "Peuplade ou groupement d’hommes errants."
                        ],
                        "tags": [
                            "collective"
                        ],
                        "examples": [
                            {
                                "example_id": "f01c4b1c-8537-478e-936a-5d5b3fd9a0dc",
                                "sense_id": "04947498-9141-3453-9586-7d457f573eb7",
                                "text": "C'est ainsi que, dans l'Antiquité, les riches vallées du Nil et de l’Euphrate (Mésopotamie) furent toujours convoitées par des hordes conquérantes."
                            },
                            {
                                "example_id": "a68e3cc5-c6c5-4701-8a66-44ff0ab65d4f",
                                "sense_id": "04947498-9141-3453-9586-7d457f573eb7",
                                "text": "En 1223, première alerte. Du Caucase dévale une nuée de cavaliers. Ce n’est plus une horde : c’est une armée structurée, disciplinée d'un immense empire."
                            }
                        ]
                    },
                    {
                        "sense_id": "187b6f0e-1d54-3a4e-81d6-f938b5c1a9f8",
                        "entry_id": "03c11698-7b0d-3047-a373-86ecbec4639e",
                        "glosses": [
                            "Groupement humain temporaire et instable."
                        ],
                        "tags": [
                            "collective"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0dcc61c6-ffa6-3749-8309-854329049d2d",
                        "entry_id": "03c11698-7b0d-3047-a373-86ecbec4639e",
                        "glosses": [
                            "Troupe d’hommes indisciplinés, qui se plaisent au carnage, à la dévastation, etc."
                        ],
                        "tags": [
                            "collective",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "c9560a35-487e-4170-b174-7a8adf588ce5",
                                "sense_id": "0dcc61c6-ffa6-3749-8309-854329049d2d",
                                "text": "Les nouaïb […] sont des hordes absolument indisciplinées, mais parmi lesquelles on trouve certainement d'excellents cavaliers, des fantassins durs à la fatigue et de bons tireurs."
                            },
                            {
                                "example_id": "11b773e7-e0d6-472b-9d40-1af5efbc8258",
                                "sense_id": "0dcc61c6-ffa6-3749-8309-854329049d2d",
                                "text": "Et les hordes fanatisées par les prédicateurs de la Croisade trouvèrent tout naturel, avant de régler leur compte à ceux qui avaient profané (soi-disant) le tombeau du Christ, de châtier les descendants des « déicides »."
                            },
                            {
                                "example_id": "4db22d09-5df3-45f7-b6d1-b9db531398af",
                                "sense_id": "0dcc61c6-ffa6-3749-8309-854329049d2d",
                                "text": "Les petits chevaux des Cosaques escaladent les amas de décombres, entre des lambeaux de murs placardés d’affiches portant la dernière proclamation de Gœbbels : « Tout Allemand doit défendre sa capitale. Les hordes rouges seront arrêtées. »"
                            },
                            {
                                "example_id": "8fabccc9-1a5a-4353-813e-c04e4467f6bc",
                                "sense_id": "0dcc61c6-ffa6-3749-8309-854329049d2d",
                                "text": "Au bout de la vallée on entendait le son d’une corne\n D’un chef ennemi qui rappelait toute sa horde."
                            }
                        ]
                    },
                    {
                        "sense_id": "52c5ca70-8eef-3f16-a5cb-b5d2e51b1ac9",
                        "entry_id": "03c11698-7b0d-3047-a373-86ecbec4639e",
                        "glosses": [
                            "Groupe de personnes indisciplinées."
                        ],
                        "tags": [
                            "collective"
                        ],
                        "examples": [
                            {
                                "example_id": "c7007fc6-b556-448f-a29d-3716d056498d",
                                "sense_id": "52c5ca70-8eef-3f16-a5cb-b5d2e51b1ac9",
                                "text": "Invariablement les fonctionnaires, arrivés récemment ici des autres parties de la France, éprouvent de l'étonnement en voyant ces classes drues, ces hordes de galopins qui déambulent par les routes."
                            },
                            {
                                "example_id": "b058eb5e-8723-4904-bcc0-89af4d19eaea",
                                "sense_id": "52c5ca70-8eef-3f16-a5cb-b5d2e51b1ac9",
                                "text": "C’était le branle-bas de combat au paradis. Dieu le Père observait d’un œil distrait ses hordes d’anges astiquer les nuages pour la fête de Noël."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2322f712-76ac-4fbe-b137-5e5040292803",
                        "source_entry_id": "03c11698-7b0d-3047-a373-86ecbec4639e",
                        "target_lang_word": "Horde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Horde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "39637ec4-ca2e-3067-b50c-3eac29d7fedb",
                                        "entry_id": "e9bc3c65-d116-3349-8f73-f372a4700c10",
                                        "glosses": [
                                            "organisierte Gruppe von Individuen (meist Säugetieren), welche sich einen Lebensraum teilen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79113c67-4a56-4b1e-9c17-32e104453ed5",
                                                "sense_id": "39637ec4-ca2e-3067-b50c-3eac29d7fedb",
                                                "text": "Eine der ersten Formen menschlichen Zusammenlebens war die in einer Horde, die den gemeinsamen Lagerplatz teilte."
                                            },
                                            {
                                                "example_id": "a48d6898-a7ac-4ac7-b0d9-5a5eced98c51",
                                                "sense_id": "39637ec4-ca2e-3067-b50c-3eac29d7fedb",
                                                "text": "Eine organisierte Affengruppe nennt man oft nicht Herde oder Rotte, sondern Horde."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6983c585-836e-31b1-921c-c8c092c482e9",
                                        "entry_id": "e9bc3c65-d116-3349-8f73-f372a4700c10",
                                        "glosses": [
                                            "wilde Menge, ungeordnete Schar, eine nicht einschätzbare Gruppe, die man als bedrohlich auffasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c2dd3ca-497f-49fc-832e-0cefc21ebd57",
                                                "sense_id": "6983c585-836e-31b1-921c-c8c092c482e9",
                                                "text": "Eine Horde seltsamer Gestalten machte einen bedrohlichen Eindruck auf uns."
                                            },
                                            {
                                                "example_id": "118ddbc3-9903-4362-8599-681ecdf4789d",
                                                "sense_id": "6983c585-836e-31b1-921c-c8c092c482e9",
                                                "text": "Unsere Armee stand einer Horde von Wilden gegenüber."
                                            },
                                            {
                                                "example_id": "b643812e-2d4f-4a43-be9c-4d5518647c45",
                                                "sense_id": "6983c585-836e-31b1-921c-c8c092c482e9",
                                                "text": "„Es war nur gut, daß die lachende Horde verschwunden war.“"
                                            },
                                            {
                                                "example_id": "2d75114d-9d5a-495f-816e-f24345a7ac48",
                                                "sense_id": "6983c585-836e-31b1-921c-c8c092c482e9",
                                                "text": "„Wie bei einem außer Kontrolle geratenen Brainstorming einer Horde zugekokster Drehbuchschreiber morgens um fünf flipperten mir Szenarien durch die Hirnwindungen.“"
                                            },
                                            {
                                                "example_id": "25e70870-4500-40db-aa76-a782b3658d1e",
                                                "sense_id": "6983c585-836e-31b1-921c-c8c092c482e9",
                                                "text": "„Die Horden beschäftigungslos im Land umherziehender Söldner beunruhigten die Zivilobrigkeit der gleichen Territorialherren, in deren militärischen Diensten sie gestanden hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6457ef3f-57e9-3286-876c-340ad1e64641",
                                        "entry_id": "e9bc3c65-d116-3349-8f73-f372a4700c10",
                                        "glosses": [
                                            "Flechtwerk, Lattengestell"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a386d1b7-7a34-47b3-b355-545b84422d7a",
                                                "sense_id": "6457ef3f-57e9-3286-876c-340ad1e64641",
                                                "text": "Im Keller standen die vor Licht geschützten Horden mit Äpfeln und Kartoffeln."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f86a7a66-e967-4c97-b178-b0218cd59551",
                        "source_entry_id": "03c11698-7b0d-3047-a373-86ecbec4639e",
