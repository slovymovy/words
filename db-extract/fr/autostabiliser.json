                        "sense_id": "220ac5e5-57f0-3523-ab0a-f6af023f6db5",
                        "entry_id": "07ba8125-04a1-3d2e-85c6-0bb37f4f5046",
                        "glosses": [
                            "Faire se stabiliser par ses propres moyens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "318fa4b2-783b-436f-8318-db6ede6b2939",
                                "sense_id": "220ac5e5-57f0-3523-ab0a-f6af023f6db5",
                                "text": "En regardant sur d'autre forum, j'ai trouvé qu'il fallait aussi baisser le centre de gravité pour autostabiliser l'xufo."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d6f1ef9-d013-344a-863e-79e34ec9006f",
                        "entry_id": "07ba8125-04a1-3d2e-85c6-0bb37f4f5046",
                        "glosses": [
                            "Se stabiliser de soi-même."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "5f03303d-fc6f-4c14-b00a-8827a5557549",
                                "sense_id": "1d6f1ef9-d013-344a-863e-79e34ec9006f",
                                "text": "Il faut savoir qu'un remblai demande de 15 à 20 ans pour s'autostabiliser."
                            },
                            {
                                "example_id": "4243ec47-a557-42ed-898f-9a47adc4edc1",
                                "sense_id": "1d6f1ef9-d013-344a-863e-79e34ec9006f",
                                "text": "Priant de toutes leurs forces pour que Merlin réussisse à s'autostabiliser."
                            }
                        ]
                    }
