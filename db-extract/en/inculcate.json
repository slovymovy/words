                                                "sense_id": "4da921f5-be0d-3bf0-a45e-1c42fb6be93d",
                                                "text": "Meine Mutter hat mir die Regeln für das Verhalten im Straßenverkehr regelrecht eingeimpft."
                                            },
                                            {
                                                "example_id": "76a54110-cbd2-4fb4-a048-f99c24fa2194",
                                                "sense_id": "4da921f5-be0d-3bf0-a45e-1c42fb6be93d",
                                                "text": "„Den meisten Spaniern, da darf man guten Gewissens verallgemeinern, wird dagegen von der Wiege an ein tadelloser Kleidungsstil eingeimpft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
