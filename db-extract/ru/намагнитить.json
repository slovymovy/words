                "translations": [
                    {
                        "translation_id": "1f6560a6-b624-4c5b-8294-07dc0686d6a4",
                        "source_entry_id": "1b17af7c-1768-33e3-b510-3fdfa6abe3f7",
                        "source_sense_id": "07adee07-2daf-37e1-b465-5df11e429a94",
                        "target_lang_word": "magnetize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magnetize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2bc2dcc1-13ca-316b-bc71-4d2a12f23db2",
                                        "entry_id": "31bbeba1-b064-3676-8f52-44cb0794ffba",
                                        "glosses": [
                                            "To make magnetic."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "be96c357-49d7-3388-bf59-bced853ae5cb",
                                        "entry_id": "31bbeba1-b064-3676-8f52-44cb0794ffba",
                                        "glosses": [
                                            "To become magnetic."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "47311a7b-7766-3f7f-860a-295957eb9093",
                                        "entry_id": "31bbeba1-b064-3676-8f52-44cb0794ffba",
                                        "glosses": [
                                            "To hypnotize using mesmerism."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edc6ccc2-7fa4-46bf-8145-566c73cee137",
                                                "sense_id": "47311a7b-7766-3f7f-860a-295957eb9093",
                                                "text": "c. 1789, Elizabeth Inchbald, Animal Magnetism: A Farce, Dublin, P. Byron, Act III, p. 82,\nLisette let him alone, it is dangerous to push the poor creature to extremities, Doctor, suppose we Magnetize him?"
                                            },
                                            {
                                                "example_id": "df72eea2-3d79-4c1a-bf55-9cd0ebc60151",
                                                "sense_id": "47311a7b-7766-3f7f-860a-295957eb9093",
                                                "text": "Dr. Bertrand tells us that the first patient he ever magnetized, being attacked by a disease of an hysterical character, became subject to convulsions of so long duration and so violent in character, that he had never, in all his practice, seen the like […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "748aedd8-5a3a-3825-be1f-864237a70b03",
                                        "entry_id": "31bbeba1-b064-3676-8f52-44cb0794ffba",
                                        "glosses": [
                                            "To attract, allure or entice; to captivate or entrance."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f405c2e8-1816-43a1-b524-00422a300c13",
                                                "sense_id": "748aedd8-5a3a-3825-be1f-864237a70b03",
                                                "text": "As for Dudley Venner, no beauty in all the world could have so soothed and magnetized him as the very repose and subdued gentleness which the Widow had thought would make the best possible background for her own more salient and effective attractions."
                                            },
                                            {
                                                "example_id": "02239c72-a641-4e18-af3b-e49a008bcf23",
                                                "sense_id": "748aedd8-5a3a-3825-be1f-864237a70b03",
                                                "text": "Mr. Hamlin’s hand passed carressingly twice or thrice along her sleeve with a peculiar gentleness that seemed to magnetize her."
                                            },
                                            {
                                                "example_id": "04ec9da0-43c2-447b-99cf-92577fac6d81",
                                                "sense_id": "748aedd8-5a3a-3825-be1f-864237a70b03",
                                                "text": "Subdued and magnetized into submission, Ursula sat turning her tearful eyes from one uncompromising face to the other; but their attention was soon diverted to another weeper."
                                            },
                                            {
                                                "example_id": "441ca161-53ee-4923-a695-5bc7fead251d",
                                                "sense_id": "748aedd8-5a3a-3825-be1f-864237a70b03",
                                                "text": "Drawing his material from the black hole of ghetto life and death, Pryor uses his dramatic power to magnetize his listeners into the fire-flash fear of the moment—even as his skewed comic perspective offers distance, safety, reassurance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
