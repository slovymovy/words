                "senses": [
                    {
                        "sense_id": "365a7295-e87d-33eb-be6c-9b8293ad7079",
                        "entry_id": "6d31531b-04c0-3621-9eca-bc308abfcade",
                        "glosses": [
                            "technieken voor het voorkomen van zwangerschap na geslachtsgemeenschap"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed2bce0b-0e06-4030-853a-2cc2907748ab",
                                "sense_id": "365a7295-e87d-33eb-be6c-9b8293ad7079",
                                "text": "Het condoom en de pil zijn de belangrijkste vormen van anticonceptie."
                            },
                            {
                                "example_id": "13e47fc7-b609-4603-ab4a-336e30c1dab8",
                                "sense_id": "365a7295-e87d-33eb-be6c-9b8293ad7079",
                                "text": "Iets minder dan een kwart van de getrouwde Afrikaanse vrouwen gebruikt moderne anticonceptie tegen 60 procent van de getrouwde vrouwen in Azië en Latijns-Amerika."
                            },
                            {
                                "example_id": "eae77c1c-eea7-4b77-9f55-344ad31c89bd",
                                "sense_id": "365a7295-e87d-33eb-be6c-9b8293ad7079",
                                "text": "Het was in die tijd niet eenvoudig voor een ongehuwd meisje om aan de pil te komen; geen enkele arts zou hem voorschrijven. 'Hoe kom je eraan?' vroeg ik.Ze knipoogde.'Gewoon even over een lamp gewreven.Nee, echt, hoe?Bij zo'n consultatiebureau voor anticonceptie,' bekende ze. 'Puur goud."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e66662c8-dd64-41d7-bd8b-737bec65818f",
                        "source_entry_id": "6d31531b-04c0-3621-9eca-bc308abfcade",
                        "source_sense_id": "365a7295-e87d-33eb-be6c-9b8293ad7079",
                        "source_sense_description": "technieken voor het voorkomen van zwangerschap na geslachtsgemeenschap",
                        "target_lang_word": "Empfängnisverhütung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Empfängnisverhütung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bfd62e6c-a1aa-331c-babc-1697518bafd2",
                                        "entry_id": "0b66100f-d7fe-3aa9-b878-b396fa3abf6a",
                                        "glosses": [
                                            "Verhinderung einer unerwünschte Schwangerschaft durch entsprechende Mittel und Methoden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64bbe666-b652-49e6-af1b-b88a21a30b74",
                                                "sense_id": "bfd62e6c-a1aa-331c-babc-1697518bafd2",
                                                "text": "Die Antibabypille ist das bekannteste Mittel zur Empfängnisverhütung."
                                            },
                                            {
                                                "example_id": "a45d1378-f81c-4cac-bf52-6fbc9430c6f8",
                                                "sense_id": "bfd62e6c-a1aa-331c-babc-1697518bafd2",
                                                "text": "Für viele Mädchen ist die Empfängnisverhütung der Schutz vor einer ungewollten Schwangerschaft."
                                            },
                                            {
                                                "example_id": "08791e60-64fe-46de-8941-f4543f854fd4",
                                                "sense_id": "bfd62e6c-a1aa-331c-babc-1697518bafd2",
                                                "text": "Die Empfängnisverhütung dient in erster Linie der Familienplanung."
                                            },
                                            {
                                                "example_id": "45e4a989-2c51-4a41-97d7-44d7134beb69",
                                                "sense_id": "bfd62e6c-a1aa-331c-babc-1697518bafd2",
                                                "text": "Der sogenannte Coitus interruptus ist eine der unsichersten Arten der Empfängnisverhütung."
                                            },
                                            {
                                                "example_id": "21ff9d44-4742-4dd9-8a9f-84e3a58e4fd1",
                                                "sense_id": "bfd62e6c-a1aa-331c-babc-1697518bafd2",
                                                "text": "„Tabuiert sind natürlich auch alle möglichen Mittel und Wege der Empfängnisverhütung.“"
                                            },
                                            {
                                                "example_id": "fed9b2be-0287-4092-9b5d-b7cceb929b75",
                                                "sense_id": "bfd62e6c-a1aa-331c-babc-1697518bafd2",
                                                "text": "„Allerdings betreiben die Ägypter auch Maßnahmen zur Empfängnisverhütung (Diaphragma-Prinzip) und nehmen Abtreibungen vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
