                    },
                    {
                        "translation_id": "b1f859bc-0701-4021-9a3e-3bb4d6d426c1",
                        "source_entry_id": "a90c9fa1-cfd8-3ceb-8f94-f92134f847b1",
                        "source_sense_id": "6e3f92a3-6c41-3d9b-ac41-927150ff0668",
                        "source_sense_description": "jemand, der ein Vermögen von mindestens einer Milliarde einer Währungseinheit hat",
                        "target_lang_word": "billionaire",
