                                "target_senses": [
                                    {
                                        "sense_id": "00035fd4-c8f9-3de5-a65e-c3c333edd2d3",
                                        "entry_id": "f47ab479-78b9-3949-8b9d-59d6f03c304f",
                                        "glosses": [
                                            "An act in which someone mumbles something"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db608d3a-70e9-48c9-aaaf-fd9be87e18a5",
                                                "sense_id": "00035fd4-c8f9-3de5-a65e-c3c333edd2d3",
                                                "text": "The second is the contrast with the inarticulate stumblings, mumblings, evasions and half-truths of our current president."
                                            }
                                        ]
