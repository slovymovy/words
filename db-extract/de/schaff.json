                "senses": [
                    {
                        "sense_id": "f75878f5-0234-3fa0-b559-c277229f6c6d",
                        "entry_id": "c14fa998-f553-3194-8264-65d8f848c60a",
                        "glosses": [
                            "Baquet."
                        ],
                        "tags": [
                            "Autriche",
                            "Bavière"
                        ],
                        "examples": [
                            {
                                "example_id": "0da584f3-85a0-4953-8e4c-5e34e8d0d1e4",
                                "sense_id": "f75878f5-0234-3fa0-b559-c277229f6c6d",
                                "text": "Das Schaff ist ein meist ovaler, bis etwa 0,5 m hoher, größerer, im Allgemeinen wasserdichter Behälter aus Holz oder verzinktem Blech, der sich nach obenhin verbreitert und normalerweise keinen Deckel hat."
                            }
                        ]
                    },
                    {
                        "sense_id": "9858ab33-f448-329f-9664-c99cad6754dd",
                        "entry_id": "c14fa998-f553-3194-8264-65d8f848c60a",
                        "glosses": [
                            "Armoire, étagère."
                        ],
                        "tags": [
                            "Régional"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b7f73c39-f141-3d42-900b-fa3753448f01",
                        "entry_id": "c14fa998-f553-3194-8264-65d8f848c60a",
                        "glosses": [
                            "Affaire, travail."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d28d75a-21b0-41a4-832a-4088c1ea911a",
                                "sense_id": "b7f73c39-f141-3d42-900b-fa3753448f01",
                                "text": "Seinen Schaff haben.",
                                "translation": "Avoir à faire, être occupé."
                            },
                            {
                                "example_id": "d10be0d2-4991-43e1-9b37-cb3b135969fb",
                                "sense_id": "b7f73c39-f141-3d42-900b-fa3753448f01",
                                "text": "Mit den fünf Kindern hat sie schon ihren Schaff.",
                                "translation": "Avec ses cinq enfants, elle a beaucoup à faire."
                            }
                        ]
                    }
                ],
