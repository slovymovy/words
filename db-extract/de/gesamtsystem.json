                "senses": [
                    {
                        "sense_id": "78100020-3c99-3e0a-b959-d89b71759ba7",
                        "entry_id": "7088ed02-f03c-3eff-a4da-7f56ac5bf3f5",
                        "glosses": [
                            "komplexe Einheit mit allen zugehörigen Komponenten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87a9ae4e-853d-4640-b666-47f57b2fdfda",
                                "sense_id": "78100020-3c99-3e0a-b959-d89b71759ba7",
                                "text": "Auftrag war es, die einzelnen Teillösungen, die man zum Teil schon seit vielen Jahren praktizierte, zu einem Gesamtsystem zu kombinieren."
                            },
                            {
                                "example_id": "0c6ea3ec-5ee5-4904-992b-be4d52a094b6",
                                "sense_id": "78100020-3c99-3e0a-b959-d89b71759ba7",
                                "text": "„Das Gesamtsystem für blendfreies Fernlicht besteht aus den drei wesentlichen Komponenten: der Fahrzeugkamera, dem Lichtsteuergerät und dem MatrixBeam—LED-Scheinwerfer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
