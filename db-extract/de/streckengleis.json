                "senses": [
                    {
                        "sense_id": "9cdc8e2f-4638-32ea-bae3-c33b18a5abda",
                        "entry_id": "108017b9-67a9-3eaa-b906-4a6d0c23144d",
                        "glosses": [
                            "Bahngleis, das sich auf der freien Strecke befindet"
                        ],
                        "tags": [
                            "Eisenbahn"
                        ],
                        "examples": [
                            {
                                "example_id": "85529cfe-780f-4ce4-9bcb-8513c311298e",
                                "sense_id": "9cdc8e2f-4638-32ea-bae3-c33b18a5abda",
                                "text": "„Ebenfalls ab 19. März fallen Züge auf dem S1-Abschnitt zwischen Gänserndorf und Deutsch Wagram aus, weil die ÖBB auf einer Länge von knapp fünf Kilometern das Streckengleis 1 erneuern.“"
                            },
                            {
                                "example_id": "15ffa748-21d5-46d7-be2b-3d70d1d7cf2e",
                                "sense_id": "9cdc8e2f-4638-32ea-bae3-c33b18a5abda",
                                "text": "„Vorerst werde die Verbindung eingleisig geführt, bis zum Wochenende folge das zweite Streckengleis, so Posch.“"
                            },
                            {
                                "example_id": "475c1356-65fd-4165-80df-f965742b9af4",
                                "sense_id": "9cdc8e2f-4638-32ea-bae3-c33b18a5abda",
                                "text": "„In diesen Tagen beginnen die Bauarbeiten für das vierte Streckengleis zwischen der Verzweigung Hürlistein und Effretikon.“"
                            },
                            {
                                "example_id": "1fd3d521-fb04-46f1-90fe-4f702ed56b92",
                                "sense_id": "9cdc8e2f-4638-32ea-bae3-c33b18a5abda",
                                "text": "„Die Zuschauer jubeln, als Lokführer Klaus Mühleisen den mehr als 100 Tonnen schweren Champion der Historischen Eisenbahn Frankfurt aus dem Meininger Dampflokwerk auf das Streckengleis bugsiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
