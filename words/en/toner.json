{
    "word_family": [
        "tone",
        "tonal",
        "tonality",
        "toning"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9fe9a751-8a03-3f61-9a89-47a7aab8678e",
                    "sense_definition": "Powder used in laser printers and photocopiers to form the text and images on the printed paper.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "printing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The office manager ordered a new black <w>toner</w> cartridge for the laser printer.",
                            "target_lang_translations": {
                                "ru": "Офис-менеджер заказал новый картридж с черным <w>тонером</w> для лазерного принтера."
                            }
                        },
                        {
                            "text": "If the print quality is fading, you might need to replace the <w>toner</w>.",
                            "target_lang_translations": {
                                "ru": "Если качество печати ухудшается, возможно, вам нужно заменить <w>тонер</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "black toner",
                        "toner cartridge",
                        "replace the toner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Порошок, используемый в лазерных принтерах и копировальных аппаратах для формирования текста и изображений на бумаге."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тонер",
                                "target_lang_sense_clarification": "для принтера"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ce8d27f-6f4e-394e-aa3d-1125023716d1",
                    "sense_definition": "A cosmetic lotion designed to cleanse the skin and shrink the appearance of pores.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cosmetics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She applied a gentle facial <w>toner</w> to her skin after washing her face.",
                            "target_lang_translations": {
                                "ru": "После умывания она нанесла на кожу мягкий <w>тоник</w> для лица."
                            }
                        },
                        {
                            "text": "Using a skin <w>toner</w> can help remove any remaining traces of dirt.",
                            "target_lang_translations": {
                                "ru": "Использование <w>тоника</w> для кожи помогает удалить оставшиеся следы загрязнений."
                            }
                        }
                    ],
                    "common_phrases": [
                        "facial toner",
                        "skin toner",
                        "apply toner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Косметический лосьон, предназначенный для очищения кожи и сужения пор."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тоник",
                                "target_lang_sense_clarification": "для лица"
                            },
                            {
                                "target_lang_word": "тонер",
                                "target_lang_sense_clarification": "косметическое средство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2d79571-b66a-352e-8be2-ae24331b1147",
                    "sense_definition": "A hair product used to neutralize brassy tones and add shine to bleached or dyed hair.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cosmetics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stylist applied a purple <w>toner</w> to remove the yellow tints from her blonde hair.",
                            "target_lang_translations": {
                                "ru": "Стилист нанес фиолетовый <w>тонер</w>, чтобы убрать желтый оттенок с ее светлых волос."
                            }
                        },
                        {
                            "text": "You should use a hair <w>toner</w> to keep your color looking fresh between salon visits.",
                            "target_lang_translations": {
                                "ru": "Вам следует использовать <w>тоник</w> для волос, чтобы поддерживать свежесть цвета между визитами в салон."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hair toner",
                        "apply a toner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Средство для волос, используемое для нейтрализации желтизны и придания блеска осветленным или окрашенным волосам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тоник",
                                "target_lang_sense_clarification": "оттеночное средство для волос"
                            },
                            {
                                "target_lang_word": "тонер",
                                "target_lang_sense_clarification": "для волос"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d69aaf67-2684-3333-a613-8a15c96ca404",
                    "sense_definition": "A musician, particularly one who plays a wind instrument.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old <w>toner</w> played a haunting melody on his flute.",
                            "target_lang_translations": {
                                "ru": "Старый <w>музыкант</w> исполнил на флейте чарующую мелодию."
                            }
                        },
                        {
                            "text": "As a skilled <w>toner</w>, he was highly respected among the woodwind players.",
                            "target_lang_translations": {
                                "ru": "Как умелого <w>исполнителя</w>, его очень уважали среди музыкантов, играющих на деревянных духовых инструментах."
                            }
                        }
                    ],
                    "synonyms": [
                        "musician",
                        "player"
                    ],
                    "target_lang_definitions": {
                        "ru": "Музыкант, в частности тот, кто играет на духовом инструменте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "музыкант",
                                "target_lang_sense_clarification": "играющий на духовых"
                            },
                            {
                                "target_lang_word": "духовик",
                                "target_lang_sense_clarification": "исполнитель"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "765b08b5-54e3-3328-9f94-3ae24eb223a7",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Toner</w> has been working at the university for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Тонер</w> работает в университете уже более двадцати лет."
                            }
                        },
                        {
                            "text": "We are meeting with the <w>Toner</w> family to discuss the property sale.",
                            "target_lang_translations": {
                                "ru": "Мы встречаемся с семьей <w>Тонер</w>, чтобы обсудить продажу недвижимости."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Тонер",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
