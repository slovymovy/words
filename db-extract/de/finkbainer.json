                "senses": [
                    {
                        "sense_id": "56b6f027-a5d4-3599-bc7e-8dd12ecedcde",
                        "entry_id": "05bb05fb-8f18-396d-a4a4-0e2c816582b0",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d547476-1dbd-44a4-b025-4b08d21e8664",
                                "sense_id": "56b6f027-a5d4-3599-bc7e-8dd12ecedcde",
                                "text": "Frau Finkbainer ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "57aa43d3-2f34-455f-b5f1-0cd20c053543",
                                "sense_id": "56b6f027-a5d4-3599-bc7e-8dd12ecedcde",
                                "text": "Herr Finkbainer wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d8bb3f29-5050-446e-9971-1bc0005b5a65",
                                "sense_id": "56b6f027-a5d4-3599-bc7e-8dd12ecedcde",
                                "text": "Die Finkbainers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "a56cf958-f951-46d4-a03a-c0328bb264bd",
                                "sense_id": "56b6f027-a5d4-3599-bc7e-8dd12ecedcde",
                                "text": "Der Finkbainer trägt nie die Schals, die die Finkbainer ihm strickt."
                            },
                            {
                                "example_id": "18b51965-45f3-44fa-9c07-3696097759bb",
                                "sense_id": "56b6f027-a5d4-3599-bc7e-8dd12ecedcde",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Finkbainer kommt, geht der Herr Finkbainer.“"
                            },
                            {
                                "example_id": "6211548f-2ad7-404d-89fb-6418ffa3bada",
                                "sense_id": "56b6f027-a5d4-3599-bc7e-8dd12ecedcde",
                                "text": "Finkbainer kommt und geht."
                            },
                            {
                                "example_id": "d2ee1724-1001-4d19-8085-96d4ca4bb661",
                                "sense_id": "56b6f027-a5d4-3599-bc7e-8dd12ecedcde",
                                "text": "Finkbainers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
