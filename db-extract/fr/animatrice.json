        "fr-extract.jsonl": [
            {
                "entry_id": "069e9643-e4bf-38f2-b11c-f64d87bfdc72",
                "word": "animatrice",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9a730601-9a17-4339-b228-a3c8419e7c64",
                        "entry_id": "069e9643-e4bf-38f2-b11c-f64d87bfdc72",
                        "tags": [
                            "plural"
                        ],
                        "form": "animatrices"
                    },
                    {
                        "form_id": "0a9e8708-b6c3-4842-b432-3332edcbf706",
                        "entry_id": "069e9643-e4bf-38f2-b11c-f64d87bfdc72",
                        "tags": [
                            "masculine"
                        ],
                        "form": "animateur"
                    },
                    {
                        "form_id": "68b894ac-3cd0-4a10-8633-26ad9c8e65ce",
                        "entry_id": "069e9643-e4bf-38f2-b11c-f64d87bfdc72",
                        "tags": [
                            "neuter"
                        ],
                        "form": "animateurice"
                    },
                    {
                        "form_id": "8e8d8496-b563-4d45-8dfe-4d45932fe3b6",
                        "entry_id": "069e9643-e4bf-38f2-b11c-f64d87bfdc72",
                        "tags": [
                            "neuter"
                        ],
                        "form": "animateur·ice"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "57681f3e-821d-3a00-a5e7-02b52f0f50d4",
                        "entry_id": "069e9643-e4bf-38f2-b11c-f64d87bfdc72",
                        "glosses": [
                            "Celle qui anime un groupe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf51166a-52d4-47f4-89f4-39e99acc25f0",
                                "sense_id": "57681f3e-821d-3a00-a5e7-02b52f0f50d4",
                                "text": "Pourtant, le rôle tenu par l’animatrice, le type d’animation qu’elle propose lors de ces temps collectifs, ainsi que son mode de réactions vis-à-vis des uns et des autres, essentiellement les enfants, les autres assistantes maternelles, sont très importants dans la professionnalisation des assistantes maternelles."
                            }
                        ]
                    },
                    {
                        "sense_id": "bef50a85-bdae-33c0-974a-5fa350381627",
                        "entry_id": "069e9643-e4bf-38f2-b11c-f64d87bfdc72",
                        "glosses": [
                            "Celle qui réalise l’animation d’un dessin animé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "904d0381-db23-4b84-b7de-42a099c37b39",
                                "sense_id": "bef50a85-bdae-33c0-974a-5fa350381627",
                                "text": "Gyogyi Peluce, animatrice des Simpson, se souvient qu’elle a choisi la couleur jaune pour la famille parce qu’elle symbolisait « une rupture avec tous les concepts qu’on avait toujours appris sur l’animation »."
                            }
                        ]
                    },
                    {
                        "sense_id": "016b1d95-cfeb-3203-a64b-b6f100611daa",
                        "entry_id": "069e9643-e4bf-38f2-b11c-f64d87bfdc72",
                        "glosses": [
                            "Celle qui est chargée de préparer, de présenter, et de coordonner les éléments constitutifs d'une émission télévisée ou radiophonique."
                        ],
                        "tags": [
                            "Audiovisuel"
                        ],
                        "examples": [
                            {
                                "example_id": "32d2aa68-afc9-448e-b551-cfdf6cd1f21f",
                                "sense_id": "016b1d95-cfeb-3203-a64b-b6f100611daa",
                                "text": "À la suite du succès des Clés de Fort Boyard, Antenne 2 a envoyé son animatrice en plein cœur du Mexique, à la recherche des statuettes mayas"
                            }
                        ]
                    },
                    {
                        "sense_id": "9ce2251b-18d4-30a6-9306-94b91f7ebc56",
                        "entry_id": "069e9643-e4bf-38f2-b11c-f64d87bfdc72",
                        "glosses": [
                            "Une travailleuse sociale, plus particulièrement une animatrice socioculturelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "390ba7ec-4c30-4b18-a26f-3716a53e745c",
                                "sense_id": "9ce2251b-18d4-30a6-9306-94b91f7ebc56",
                                "text": "Effectivement, le groupe de travail reconnaît qu’il est difficile pour l’animatrice d’approcher ce jeune, compte tenu de l’isolement de sa famille dans le quartier ainsi que de la crainte qu’elle inspire à tous."
                            }
                        ]
                    },
                    {
                        "sense_id": "65b89690-6434-3aea-9ba7-b211d3418da3",
                        "entry_id": "069e9643-e4bf-38f2-b11c-f64d87bfdc72",
                        "glosses": [
                            "Une enseignante dans le secteur de la formation professionnelle pour adulte ou dans la réadaptation professionnelle, dénommée animatrice de formation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0ea7f3c-15d9-484a-986a-9d138a450a98",
                                "sense_id": "65b89690-6434-3aea-9ba7-b211d3418da3",
                                "text": "Objectif à court terme : être la meilleure animatrice de formation que la ville ait jamais connue. Obstacles : aucun, en fait. Le coin manque cruellement de bonnes formatrices."
                            }
                        ]
                    },
                    {
                        "sense_id": "d9b60782-8612-385b-afb0-2fa0545bec35",
                        "entry_id": "069e9643-e4bf-38f2-b11c-f64d87bfdc72",
                        "glosses": [
                            "Celle qui passe de la musique, notamment de variétés, dans une réunion publique ou privée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "faa76ef5-416d-48ba-9b9b-b00c10813451",
                                "sense_id": "d9b60782-8612-385b-afb0-2fa0545bec35",
                                "text": "Il n’existe pas d’autres enregistrements de cette chanson, mais plusieurs auditeurs en ont fait la demande au cours des derniers mois, précise l’animatrice avant de passer le disque."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "343a0093-eefe-4ec4-8d47-f98a11efb73e",
                        "source_entry_id": "069e9643-e4bf-38f2-b11c-f64d87bfdc72",
                        "source_sense_description": "1",
                        "target_lang_word": "hostess",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hostess",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e06374c-b3b2-3659-aae7-c280c8ae848c",
                                        "entry_id": "eb7f1b3f-d0a9-39e2-b2f6-1132c7906f43",
                                        "glosses": [
                                            "A female host."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5e5102f-755b-49ab-bfe8-b6b9d2d3361a",
                                                "sense_id": "6e06374c-b3b2-3659-aae7-c280c8ae848c",
                                                "text": "The host and hostess greeted their guests at the door."
                                            },
                                            {
                                                "example_id": "fef5e017-910a-47b4-b083-8ca1359bb0d8",
                                                "sense_id": "6e06374c-b3b2-3659-aae7-c280c8ae848c",
                                                "text": "The [Washington] Post's proprietor through those turbulent [Watergate] days, Katharine Graham, held a double place in Washington’s hierarchy: at once regal Georgetown hostess and scrappy newshound, ready to hold the establishment to account."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6587cd55-8b72-34be-b78c-96ef7cd35586",
                                        "entry_id": "eb7f1b3f-d0a9-39e2-b2f6-1132c7906f43",
                                        "glosses": [
                                            "A female innkeeper."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "58e6db8c-1daa-34f4-bc7d-3c70efa1445b",
                                        "entry_id": "eb7f1b3f-d0a9-39e2-b2f6-1132c7906f43",
                                        "glosses": [
                                            "Stewardess: a woman steward on an airplane."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c4abd70-1fe6-302f-bdd7-c0283a5c2ff7",
                                        "entry_id": "eb7f1b3f-d0a9-39e2-b2f6-1132c7906f43",
                                        "glosses": [
                                            "A bar hostess or bargirl; a paid female companion offering conversation and in some cases sex."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "83348956-3ea3-379d-a50f-c887bcc86cca",
                                        "entry_id": "eb7f1b3f-d0a9-39e2-b2f6-1132c7906f43",
                                        "glosses": [
                                            "A female prostitute."
                                        ],
                                        "tags": [
                                            "Philippines"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hostess",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8803db3f-2e46-3122-b18b-6ab76372cac0",
                                        "entry_id": "afa93739-fb09-3a25-9707-b1d30a3f40e2",
                                        "glosses": [
                                            "To host, as a woman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "037bfe1c-738e-49f3-92b2-dec5ca76f84b",
                                                "sense_id": "8803db3f-2e46-3122-b18b-6ab76372cac0",
                                                "text": "Later in January, the alum club hostessed the initiation brunch at the Pi Beta Phi chapter house. It was thrilling to see so many girls with such enthusiasm!"
                                            },
                                            {
                                                "example_id": "b66db123-b373-4a77-8fb5-3a3a4a0914b7",
                                                "sense_id": "8803db3f-2e46-3122-b18b-6ab76372cac0",
                                                "text": "Over the years she has maintained a close relationship with several former students. Currently, she alternates between visiting and hostessing two in Roanoke and Greenville, N.C., respectively, and is a proud godgrandmother to one’s new baby."
                                            },
                                            {
                                                "example_id": "89aeec64-884e-42c9-8eb1-da5141c9d2fd",
                                                "sense_id": "8803db3f-2e46-3122-b18b-6ab76372cac0",
                                                "text": "Dad and I had left early to make sure to get a booth in the back. But when I got there, Teddy Selander’s older sister was hostessing and she said, ‘You’re meeting Dean West? He’s sitting right over here,’ loud enough for everyone to hear."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
