        "nl-extract.jsonl": [
            {
                "entry_id": "83ef8f4d-9e0a-30fa-8b4a-a96843134c51",
                "word": "zoektocht",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "6db9f2ce-641e-49a5-9684-70c57f0fa97c",
                        "entry_id": "83ef8f4d-9e0a-30fa-8b4a-a96843134c51",
                        "tags": [
