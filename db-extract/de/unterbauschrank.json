                "senses": [
                    {
                        "sense_id": "26696c7c-712a-3730-985f-d900fbb97b58",
                        "entry_id": "68880640-e2d6-3a36-a7f8-7de34d4f8014",
                        "glosses": [
                            "Ein (Küchen-)Schrank, der unter einer Arbeitsplatte eingebaut wird"
                        ],
                        "tags": [
                            "Haushalt"
                        ],
                        "examples": [
                            {
                                "example_id": "d36940f6-87fb-4d53-a1ac-4afc0cfb717d",
                                "sense_id": "26696c7c-712a-3730-985f-d900fbb97b58",
                                "text": "Bei uns sind Mülleimer und Reinigungsmittel im Unterbauschrank."
                            },
                            {
                                "example_id": "bd20dfc7-456e-49c5-afb0-9b0f779fee6c",
                                "sense_id": "26696c7c-712a-3730-985f-d900fbb97b58",
                                "text": "Der große Spiegel über dem neuen Waschtisch mit Unterbauschrank lässt den Raum großzügiger erscheinen."
                            },
                            {
                                "example_id": "c4d705f2-ec72-48da-b3a7-0333b85d6e9b",
                                "sense_id": "26696c7c-712a-3730-985f-d900fbb97b58",
                                "text": "Die Küchenzeile besteht aus […] einem Einbaukühlschrank, einem Unterstellschrank, einem Gasherd, einem weiteren Unterbauschrank, einer Spüle und einer Spülmaschine."
                            },
                            {
                                "example_id": "086689e5-4616-44f6-ae58-bebdf4b69c82",
                                "sense_id": "26696c7c-712a-3730-985f-d900fbb97b58",
                                "text": "Den Unterbauschrank mit Vollauszug gibt es fur Waschtische verschiedener Hersteller."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
