                        "sense_id": "2ecf499f-9799-34d3-9fe6-b3053f0e055f",
                        "entry_id": "87ad80a6-7959-34c9-bfef-464b867de024",
                        "glosses": [
                            "Que l’on ne peut pas solidifier."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "40922ed0-22cf-4190-9550-2fa86a1e996c",
                                "sense_id": "2ecf499f-9799-34d3-9fe6-b3053f0e055f",
                                "text": "Elle a en outre une propriété particulière qui permet de ne pas la confondre, c’est qu’elle se solidifie par la magnésie, et que, ajoutée à du copahu, (insolidifiable par la magnésie, comme on le sait), elle donne à celui-ci de la consistance."
                            },
                            {
                                "example_id": "05aabadd-6d38-41f9-9a13-3afcd8b988a2",
                                "sense_id": "2ecf499f-9799-34d3-9fe6-b3053f0e055f",
                                "text": "Mais évidemment cette condition n’était point remplie dans la substance obtenue par MM. Posselt, Reimann, Davy, Henry et Boutron, puisque, entre autres imperfections, il s’y formait un précipité cristallin, tandis que la nicotine est insolidifiable."
                            },
                            {
                                "example_id": "bd3ea18a-0b76-4550-8a80-2e983460a29f",
                                "sense_id": "2ecf499f-9799-34d3-9fe6-b3053f0e055f",
                                "text": "L’addition de carbonate de potasse à la solution en précipite une huile insolidifiable."
                            }
                        ]
                    }
