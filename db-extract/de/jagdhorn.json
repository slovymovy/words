                                                "sense_id": "20b1aaf9-db69-3f3f-844f-973ea181caac",
                                                "text": "Trompe en angle, en niche, en tour ronde etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0da2056f-0791-3c94-9993-e2fb142d553a",
                                        "entry_id": "c38db6a2-de42-3d92-b1da-cd83b1934310",
