                "senses": [
                    {
                        "sense_id": "2cff3b1c-c3b0-3ea5-8ede-8a002d1e72f7",
                        "entry_id": "64a07be1-b2f6-3d10-94b5-c660fa246359",
                        "glosses": [
                            "heel erg rijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cefde454-d288-4eb2-9b64-372ad0ad0a1d",
                                "sense_id": "2cff3b1c-c3b0-3ea5-8ede-8a002d1e72f7",
                                "text": "De steenrijke zakenman investeerde in sociale ondernemingen."
                            },
                            {
                                "example_id": "004a647d-026a-403d-896b-0e2cd43ecd04",
                                "sense_id": "2cff3b1c-c3b0-3ea5-8ede-8a002d1e72f7",
                                "text": "'t Was moeder Hertha zelf, wier macht,\nVoor eeuwen tijds, de rijke schatten,\nDie 't steenrijk Drenthe mocht bevatten,\nIn Wirons woud had saêmvergaêrd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3838980b-f61c-4b66-ace8-845fa26bd8e2",
                        "source_entry_id": "64a07be1-b2f6-3d10-94b5-c660fa246359",
                        "source_sense_id": "2cff3b1c-c3b0-3ea5-8ede-8a002d1e72f7",
                        "target_lang_word": "steinreich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "steinreich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b8f343e5-fefb-3b09-9c27-f9117e2e1217",
                                        "entry_id": "2b940757-5fbd-3f19-9661-95800efba2f5",
                                        "glosses": [
                                            "sehr reich, außerordentlich wohlhabend"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "no-comparative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe229092-6395-488c-9cf5-ed569350bcc2",
                                                "sense_id": "b8f343e5-fefb-3b09-9c27-f9117e2e1217",
                                                "text": "Mit dieser Geschäftsidee wurde er steinreich."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e07166d6-b211-3999-8494-1f0bfaee9394",
                                        "entry_id": "2b940757-5fbd-3f19-9661-95800efba2f5",
                                        "glosses": [
                                            "reich an Steinen, steinig"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b368581f-57ed-4393-8068-26bf352bfe0c",
                                                "sense_id": "e07166d6-b211-3999-8494-1f0bfaee9394",
                                                "text": "„Für die Landwirte sind solche steinreichen Felder keine rechte Freude.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "069631b9-c7e6-41b0-828b-6f626411383f",
                        "source_entry_id": "64a07be1-b2f6-3d10-94b5-c660fa246359",
                        "source_sense_id": "2cff3b1c-c3b0-3ea5-8ede-8a002d1e72f7",
                        "target_lang_word": "richissime",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "richissime",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "68e59668-df15-3014-9aae-5a43667ed07c",
                                        "entry_id": "48afe62c-1ee9-3277-b07e-0150419b03e7",
                                        "glosses": [
                                            "Très riche, riche à l'extrême."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0bc1e37-5e3a-4dcf-b0bd-3fc96b038d20",
                                                "sense_id": "68e59668-df15-3014-9aae-5a43667ed07c",
                                                "text": "Il était superbe cet hôtel, acheté d'un richissime étranger, et il valait plus d'argent que toutes les terres et tous les châteaux du dernier des Scaër"
                                            },
                                            {
                                                "example_id": "2d3a9c45-1c73-48ea-8753-c93a25e45216",
                                                "sense_id": "68e59668-df15-3014-9aae-5a43667ed07c",
                                                "text": "Rien de tel que ce château tout en plafonds peints et cheminées de marbre pour mesurer la folle ascension de son propriétaire : le richissime et tout-puissant duc d’Épernon."
                                            },
                                            {
                                                "example_id": "1ca4a2e1-c360-4179-a591-34a1a33ba162",
                                                "sense_id": "68e59668-df15-3014-9aae-5a43667ed07c",
                                                "text": "Combien de fois des Maliens humbles ont été dépossédés de leurs biens en plein midi au profit de richissimes hommes d’affaires aux « bras longs » avec la complicité de juges véreux ? ."
                                            },
                                            {
                                                "example_id": "30b39d0d-5921-4095-9321-1480ed0689ae",
                                                "sense_id": "68e59668-df15-3014-9aae-5a43667ed07c",
                                                "text": "Mr. Price n'était pas riche, il était richissime. Et, durant les années qui suivirent la grande crise de 1929, aucun superlatif ne pouvait estimer ni établir nettement la valeur de sa richesse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
