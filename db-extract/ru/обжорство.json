                "translations": [
                    {
                        "translation_id": "d92374f7-0f9e-49d2-97d4-bf484515767f",
                        "source_entry_id": "30073e77-b633-3876-9cf7-a7a742d7c4f7",
                        "source_sense_id": "ddff7841-c6c2-35fa-bbf5-6f911dd05719",
                        "target_lang_word": "Völlerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Völlerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f8617bf2-ac96-3655-b298-8b49f88eaff5",
                                        "entry_id": "55990e57-4d0c-3dbd-a4bd-3b015441e376",
                                        "glosses": [
                                            "Essen und Trinken im Übermaß"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c1e78ab-202e-462a-be74-bca733a8fe31",
                                                "sense_id": "f8617bf2-ac96-3655-b298-8b49f88eaff5",
                                                "text": "„Nach der weihnachtlichen Völlerei sehnen sich viele nach leichten Speisen.“"
                                            },
                                            {
                                                "example_id": "9b479b91-9a73-4678-b68a-b32dbab2fed8",
                                                "sense_id": "f8617bf2-ac96-3655-b298-8b49f88eaff5",
                                                "text": "„Wo das Lebensmittel zur Lebensmitte wird, da beginnt die Völlerei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac65dc5d-5158-4939-a538-3535c1c8d773",
                        "source_entry_id": "30073e77-b633-3876-9cf7-a7a742d7c4f7",
                        "source_sense_id": "ddff7841-c6c2-35fa-bbf5-6f911dd05719",
                        "target_lang_word": "goinfrerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "goinfrerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4e7853fa-cc46-3973-9b97-18112cb35450",
                                        "entry_id": "a544251b-12be-305a-9046-cd2c0c0a03ab",
                                        "glosses": [
                                            "action de se goinfrer, de manger comme un goinfre."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c5fd128-6a84-489f-b1ce-8f0eed0dbe36",
                                                "sense_id": "4e7853fa-cc46-3973-9b97-18112cb35450",
                                                "text": "Une inscription symbolique et funèbre, une de ces menaçantes sentences bibliques qui donnent au néant humain de si terribles avertissements, est écrite au bas de ce tableau sépulcral, singulièrement choisi pour un réfectoire. Je ne sais pas si toutes les histoires sur les goinfreries des moines sont vraies ; mais, pour ma part, je ne me sentirais qu’un appétit médiocre dans une salle à manger ainsi décorée."
                                            },
                                            {
                                                "example_id": "cf322e5a-081a-44a3-ba5d-90ea87e1eb05",
                                                "sense_id": "4e7853fa-cc46-3973-9b97-18112cb35450",
                                                "text": "D’abord, il n’y eut qu’un tapage violent de fourchettes, une goinfrerie de grands gaillards aux estomacs creusés par treize heures de fatigues quotidiennes."
                                            },
                                            {
                                                "example_id": "d08889bd-1ca2-4520-9cc6-5682e6cfee20",
                                                "sense_id": "4e7853fa-cc46-3973-9b97-18112cb35450",
                                                "text": "Nous […] surprenions tous les secrets de la jungle : la goinfrerie du tapir qui, sitôt réveillé, se mettait à avaler des fourmis."
                                            },
                                            {
                                                "example_id": "d2477d30-4481-483b-923f-a41074955138",
                                                "sense_id": "4e7853fa-cc46-3973-9b97-18112cb35450",
                                                "text": "Mais la plupart se montraient modérés, comme il sied à des pèlerins ; quelques-uns, qui tenaient à se mortifier, ne touchaient presque pas à la nourriture et, regardant avec dégoût la goinfrerie autour d’eux, échangeaient des murmures d’indignation."
                                            },
                                            {
                                                "example_id": "9783b007-6848-4112-93c4-2e10e31a29fc",
                                                "sense_id": "4e7853fa-cc46-3973-9b97-18112cb35450",
                                                "text": "La goinfrerie est à la gastronomie ce que la muflerie est à la courtoisie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc474c1c-29ec-41f9-970b-2180894c8bb4",
                        "source_entry_id": "30073e77-b633-3876-9cf7-a7a742d7c4f7",
                        "source_sense_id": "ddff7841-c6c2-35fa-bbf5-6f911dd05719",
                        "target_lang_word": "gloutonnerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gloutonnerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "28d4286d-aed4-3124-a1f3-782f407ab618",
                                        "entry_id": "83021be3-4806-3d14-8680-dfb553c4d89a",
                                        "glosses": [
                                            "Défaut de celui qui est glouton."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c7a1527-bff6-46be-9f36-9164d8504fe1",
                                                "sense_id": "28d4286d-aed4-3124-a1f3-782f407ab618",
                                                "text": "En se livrant aux plaisirs de la table, ils recherchaient la délicatesse et évitaient les excès, et avaient l’habitude de reprocher l’ivrognerie et la gloutonnerie aux Saxons vaincus, comme des vices inhérents à leur basse condition."
                                            },
                                            {
                                                "example_id": "3bf33594-d5c8-4c00-a9bc-c3f2d5432acf",
                                                "sense_id": "28d4286d-aed4-3124-a1f3-782f407ab618",
                                                "text": "L'œsophage est court et large, grâce à quoi le crapaud restitue aisément ce qui lui disconvient, disposition pour lui précieuse, eu égard à sa gloutonnerie."
                                            },
                                            {
                                                "example_id": "4736663f-2250-4721-bc46-01108d92b802",
                                                "sense_id": "28d4286d-aed4-3124-a1f3-782f407ab618",
                                                "text": "Le couple, qui avait nagé et qui s’était embrassé, avait perdu ses lunettes de soleil. Elle les vit se plaindre auprès d’Agustin, comme s’il était responsable de la force et de la gloutonnerie de la mer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d68376dd-3027-4a5b-80a6-54d45a458e9a",
                        "source_entry_id": "30073e77-b633-3876-9cf7-a7a742d7c4f7",
                        "source_sense_id": "ddff7841-c6c2-35fa-bbf5-6f911dd05719",
                        "target_lang_word": "gourmandise",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gourmandise",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "075ac087-7fc7-304f-b853-b28533edb067",
                                        "entry_id": "057ac995-0208-34a6-9c9f-f7e0151ed272",
                                        "glosses": [
                                            "Défaut de celui qui est gourmand, qui mange plus que de raison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "354cdf1e-fc81-498b-a873-4b0cc389ddfd",
                                                "sense_id": "075ac087-7fc7-304f-b853-b28533edb067",
                                                "text": "Ce très léger excès, péché de gourmandise dont il s’accusait d’ailleurs véhémentement, et duquel il n’était guère coutumier, l’avait vivement dérangé, […]."
                                            },
                                            {
                                                "example_id": "c0c0ce50-3a3a-4255-b1eb-4186472f5ade",
                                                "sense_id": "075ac087-7fc7-304f-b853-b28533edb067",
                                                "text": "Honni par le Talmud et le Coran, diabolisé par les chrétiens comme symbole de luxure et de gourmandise, le cochon est tout aussi triquard dans la société laïque, obligatoire, gonadoclaste et de surcroît xyloglotte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c080b70-990d-3873-81ef-d35a00c64d9b",
                                        "entry_id": "057ac995-0208-34a6-9c9f-f7e0151ed272",
                                        "glosses": [
                                            "Petit plat gourmand."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38702f75-48d5-4fac-a34a-d2529692b979",
                                                "sense_id": "1c080b70-990d-3873-81ef-d35a00c64d9b",
                                                "text": "Les amateurs de gourmandises du terroir."
                                            }
                                        ]
                                    }
                                ]
