                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2622c2cc-e89f-3c9d-9a32-9ed59737c558",
                                        "entry_id": "63fea28f-9b5b-3a41-b6e6-c19c8f226ac4",
                                        "glosses": [
                                            "Sorte d’étoffe de laine, de coton ou de soie, qui est un peu frisée et ressemble au crêpe, mais est beaucoup plus épaisse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe11261a-c5c8-4a34-9bbc-e04318d9acc8",
                                                "sense_id": "2622c2cc-e89f-3c9d-9a32-9ed59737c558",
                                                "text": "Elle sentait la sueur et le crépon mouillé."
                                            },
                                            {
                                                "example_id": "223c8d9c-63eb-4b97-8036-34462e770c99",
                                                "sense_id": "2622c2cc-e89f-3c9d-9a32-9ed59737c558",
                                                "text": "Alignés sur le devant de l'estrade dans des chasubles de crépon rouge, les enfants chantaient une comptine."
                                            },
                                            {
                                                "example_id": "1873c6fd-ced5-4bfb-9427-393614c5d23c",
                                                "sense_id": "2622c2cc-e89f-3c9d-9a32-9ed59737c558",
                                                "text": "J'en bricole un avec du papier crépon, comme dans mon imagerie des fêtes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c554a90f-9e3a-321b-bc79-26310bda2e22",
                                        "entry_id": "63fea28f-9b5b-3a41-b6e6-c19c8f226ac4",
                                        "glosses": [
                                            "Rouleau de cheveux postiches que l’on met sous les cheveux pour les faire bouffer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8af8bca3-0a12-47f3-ae8e-208f499af8e8",
                                                "sense_id": "c554a90f-9e3a-321b-bc79-26310bda2e22",
                                                "text": "Elle avait eu à peine le temps de remettre en place nattes, chignon et crépons, et de rattacher sa robe avec quelques épingles, que le convoi arrêta."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
