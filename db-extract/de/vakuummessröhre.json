                "senses": [
                    {
                        "sense_id": "53f53606-0cbb-3cf3-bf09-be5ef3e25fb0",
                        "entry_id": "62c46cdb-9b8b-39f1-9ecb-c4857fb54dba",
                        "glosses": [
                            "elektrische Messröhre, die atmosphärischen Unterdruck misst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd73aed7-f16a-484e-bbf7-1414d6f79e08",
                                "sense_id": "53f53606-0cbb-3cf3-bf09-be5ef3e25fb0",
                                "text": "„Die Vakuummessröhren brauchten nach fast einer Woche Stillstand sehr lange, bis sie wieder vernünftige Werte anzeigten.“"
                            },
                            {
                                "example_id": "2b47d38a-80b1-40e9-b514-c05ecce7bf8d",
                                "sense_id": "53f53606-0cbb-3cf3-bf09-be5ef3e25fb0",
                                "text": "„In einer 1963 erschienenen Arbeit wurde eine eingehende Analyse der Fehlerquellen angegeben, die bei der Eichung von Vakuummessröhren auftreten.“"
                            },
                            {
                                "example_id": "4e6b0c5a-ac5d-49fe-a859-bd9a038807c1",
                                "sense_id": "53f53606-0cbb-3cf3-bf09-be5ef3e25fb0",
                                "text": "„Der erreichte Kolbeninnendruck konnte durch eine Vakuummessröhre der Firma ILMVAC (Ilmenau) kontrolliert werden.“"
                            },
                            {
                                "example_id": "c93e6584-55b0-4075-9a21-a62980a4f3c3",
                                "sense_id": "53f53606-0cbb-3cf3-bf09-be5ef3e25fb0",
                                "text": "„Die Vakuummessröhren brauchten nach fast einer Woche Stillstand sehr lange, bis sie wieder vernünftige Werte anzeigten.“"
                            },
                            {
                                "example_id": "0c4f0f8d-8238-4df3-8193-43df2efdad71",
                                "sense_id": "53f53606-0cbb-3cf3-bf09-be5ef3e25fb0",
                                "text": "„Die Penning-Falle ist nach dem holländischen Physiker Frans Michel Penning benannt, da das Prinzip der Speicherung der geladenen Teilchen auf seinem Vorschlag von 1936 beruht, durch Hinzufügen eines Magnetfeldes die Speicherzeit von geladenen Teilchen in Vakuummessröhren zu verlängern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
