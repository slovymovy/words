                                                "sense_id": "9416129d-8a7a-367a-889a-d092d0cba68b",
                                                "text": "Das leichteste Molekül ist ein Wasserstoffmolekül."
                                            },
                                            {
                                                "example_id": "722eeff5-9002-44a9-9c5f-a898a89b188e",
                                                "sense_id": "9416129d-8a7a-367a-889a-d092d0cba68b",
                                                "text": "„Im offenen Meer vermischen sich chemische Stoffe gut, doch für das Überleben komplexer Moleküle ist es nicht ideal.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
