                                        ]
                                    },
                                    {
                                        "sense_id": "a9300804-febc-3025-bfe1-8726d39c6c5a",
                                        "entry_id": "83ee2a37-9789-34d1-94cd-8ef3c140b4b0",
                                        "glosses": [
                                            "technische hulpmiddelen"
