                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d91d2aa2-735d-4c97-94cc-f4b2fab26389",
                                "sense_id": "58a1770f-effd-35f7-bae8-a305c68d4110",
                                "text": "Het is alweer negen uur.",
                                "translation": "It’s 9 o'clock already.",
                                "english": "It’s 9 o'clock already."
                            },
                            {
                                "example_id": "c7132ed3-2f06-4731-b701-f4e49c3e983f",
                                "sense_id": "58a1770f-effd-35f7-bae8-a305c68d4110",
                                "text": "Is het alweer oktober? Wat gaat de tijd snel!",
                                "translation": "Is it October already? Time flies!",
                                "english": "Is it October already? Time flies!"
                            }
                        ]
                    }
                ],
