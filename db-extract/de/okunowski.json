                        "examples": [
                            {
                                "example_id": "e66a2beb-41ba-47c1-a126-bb54392b7135",
                                "sense_id": "db21a25f-c74d-3b1f-9c31-61382cce166a",
                                "text": "„Gemeinsam erinnerten sich Kinder und Erzieherin Renate Okunowski an die Abschlussfahrt, die in den Magdeburger Zoo führte.“"
                            },
                            {
                                "example_id": "565675ca-e7f0-4a50-8b3d-4aca9ad25bfa",
                                "sense_id": "db21a25f-c74d-3b1f-9c31-61382cce166a",
                                "text": "„Nachdrückliche Unterstützung erhält die Gruppe von Martina Fromm und Yasmin Grein, den sozialpädagogischen Fachkräften der Schule am Dohlberg und des Wolfgang-Ernst-Gymnasiums, sowie von Kathrin Okunowski, einer Lehrerin der Haupt- und Realschule.“"
                            }
                        ],
