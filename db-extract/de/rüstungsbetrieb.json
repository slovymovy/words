                    {
                        "sense_id": "0acfcf00-6b24-3fa7-8d85-d901ef68c736",
                        "entry_id": "a37e1556-5b78-32d9-a37f-f57ce70fedde",
                        "glosses": [
                            "Betrieb, in dem Rüstungsgüter hergestellt und/oder gewartet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93ca7b20-f138-4583-afd0-f0e386d178d7",
                                "sense_id": "0acfcf00-6b24-3fa7-8d85-d901ef68c736",
                                "text": "„Große, wirklich wirksame Sabotageakte in den Rüstungsbetrieben gab es nicht.“"
                            },
                            {
                                "example_id": "b2116a59-6ad5-4e17-988c-46d3e6820e79",
                                "sense_id": "0acfcf00-6b24-3fa7-8d85-d901ef68c736",
                                "text": "„Zwar gingen auch die Franzosen unverzüglich daran, sich aus der laufenden Produktion für die erlittenen Schäden zu bedienen und Rüstungsbetriebe zu demontieren; allerdings planlos, wo die Sowjets massiv und systematisch vorgingen.“"
                            }
                        ],
