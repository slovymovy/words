                "senses": [
                    {
                        "sense_id": "abf4f9d6-e9dc-3fb5-a10c-18d9cae5c1a5",
                        "entry_id": "a4c4545b-d042-3b02-89d0-8dafc022186d",
                        "glosses": [
                            "das Mindern von Geruch, geringer werden oder vermindern, verringern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b548bfd-347d-4fb7-bf7a-1987db582638",
                                "sense_id": "abf4f9d6-e9dc-3fb5-a10c-18d9cae5c1a5",
                                "text": "„Dieser Teil der Europäischen Norm legt Planungsgrundsätze und Leistungsanforderungen für die Geruchsminderung und die damit verbundene Lüftungstechnik in Kläranlagen fest.“"
                            },
                            {
                                "example_id": "47938aab-4f8e-4e6d-adc8-d37971a9da53",
                                "sense_id": "abf4f9d6-e9dc-3fb5-a10c-18d9cae5c1a5",
                                "text": "„Bereitstellung von analytischen und olfaktometrischen Messverfahren zur Bestimmung des Wirkungsgrades der Geruchsminderung.“"
                            },
                            {
                                "example_id": "d1786adf-45a7-4d20-8f47-5b4bebee5c27",
                                "sense_id": "abf4f9d6-e9dc-3fb5-a10c-18d9cae5c1a5",
                                "text": "„Die Geruchsminderung bei Tierhaltungen sei im Baugenehmigungsverfahren zu berücksichtigen, aber nicht im Bebauungsplan.“"
                            },
                            {
                                "example_id": "d2341d8e-d925-4256-b83a-8c58645d7f00",
                                "sense_id": "abf4f9d6-e9dc-3fb5-a10c-18d9cae5c1a5",
                                "text": "„Die erforderliche Bestimmtheit der Abluftreinigung wird durch den Grad der Geruchsminderung erreicht.“"
                            },
                            {
                                "example_id": "8c1f8e6f-d5fa-41c0-82c2-35adff9e65ea",
                                "sense_id": "abf4f9d6-e9dc-3fb5-a10c-18d9cae5c1a5",
                                "text": "„Es wird ein Verfahren zur Geruchsminderung in Ölkomponenten beansprucht, welches dadurch gekennzeichnet ist, dass die Ölkomponenten zusätzlich zur Desodorierung durch Trägerdampf- oder Trägergasdestillation noch mittels Adsorption an polymeren Adsorbentien aufgereinigt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
