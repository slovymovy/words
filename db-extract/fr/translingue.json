                                    },
                                    {
                                        "sense_id": "01ce24b4-1a93-3a76-8a82-1fe069463076",
                                        "entry_id": "1dcbab76-0a78-378e-a8d9-46e7e820afa0",
                                        "glosses": [
                                            "Having the same meaning in many languages."
                                        ],
