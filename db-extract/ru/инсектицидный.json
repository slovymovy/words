                                        "entry_id": "2dca2f5b-7e00-35c9-a4f9-92232181996d",
                                        "glosses": [
                                            "Of, relating to, or being insecticide; insect-killing."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79e261b0-f74c-4dbd-afaf-c4873ff69e7e",
                                                "sense_id": "2d460d4d-4d85-359b-a0e2-a2135132ff0c",
                                                "text": "The insecticidal properties of sulphur were also known to the Romans, for in about 200 B.C. Cato suggested that its fumes should be allowed to blow through trees to kill the vine fetter."
                                            }
                                        ]
