                        "glosses": [
                            "Science qui décrit les images, les tableaux, médailles, statues, bustes, camées, etc."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e751d37e-6a38-300a-8f3f-cef4c1f8de46",
