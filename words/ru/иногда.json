{
    "word_family": [
        "год"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "b6d84404-f281-3c1e-b1e5-8a82071c168d",
                    "sense_definition": "В некоторые моменты времени, не постоянно.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "frequency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Иногда</w> я хожу в парк гулять вечером.",
                            "target_lang_translations": {
                                "nl": "<w>Soms</w> ga ik 's avonds in het park wandelen.",
                                "en": "<w>Sometimes</w> I go for a walk in the park in the evening."
                            }
                        },
                        {
                            "text": "Мы <w>иногда</w> встречаемся с друзьями в кафе.",
                            "target_lang_translations": {
                                "nl": "Wij spreken <w>af en toe</w> af met vrienden in een café.",
                                "en": "We meet up with friends in a café <w>from time to time</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "временами",
                        "порой",
                        "подчас",
                        "время от времени",
                        "по временам",
                        "иной раз"
                    ],
                    "antonyms": [
                        "всегда"
                    ],
                    "target_lang_definitions": {
                        "nl": "Op sommige momenten, niet constant.",
                        "en": "At certain moments in time, not constantly."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "soms",
                                "target_lang_sense_clarification": "De meest gebruikelijke en neutrale term voor 'af en toe'."
                            },
                            {
                                "target_lang_word": "af en toe",
                                "target_lang_sense_clarification": "Een veelgebruikte uitdrukking voor onregelmatige gebeurtenissen."
                            },
                            {
                                "target_lang_word": "somtijds",
                                "target_lang_sense_clarification": "Een formeler synoniem voor 'soms'."
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "sometimes",
                                "target_lang_sense_clarification": "The most common and neutral term for occasional occurrences."
                            },
                            {
                                "target_lang_word": "from time to time",
                                "target_lang_sense_clarification": "Used to describe events that happen irregularly."
                            },
                            {
                                "target_lang_word": "occasionally",
                                "target_lang_sense_clarification": "Indicates something that happens now and then."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "370a1dee-16b4-3eea-bd19-156464741108",
                    "sense_definition": "В отдельных, редких случаях.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "frequency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Даже опытные мастера <w>иногда</w> совершают ошибки в работе.",
                            "target_lang_translations": {
                                "nl": "Zelfs ervaren vakmensen maken <w>soms</w> fouten in hun werk.",
                                "en": "Even experienced professionals <w>sometimes</w> make mistakes in their work."
                            }
                        },
                        {
                            "text": "Такие редкие цветы <w>иногда</w> можно встретить в горах.",
                            "target_lang_translations": {
                                "nl": "Dergelijke zeldzame bloemen kun je <w>bij gelegenheid</w> in de bergen tegenkomen.",
                                "en": "Such rare flowers can <w>on occasion</w> be found in the mountains."
                            }
                        }
                    ],
                    "synonyms": [
                        "иной раз"
                    ],
                    "target_lang_definitions": {
                        "nl": "In enkele, zeldzame gevallen.",
                        "en": "In individual, rare cases."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "soms",
                                "target_lang_sense_clarification": "Kan ook worden gebruikt om incidentele gebeurtenissen aan te duiden."
                            },
                            {
                                "target_lang_word": "bij gelegenheid",
                                "target_lang_sense_clarification": "Geeft aan dat iets niet vaak, maar wel onder bepaalde omstandigheden gebeurt."
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "sometimes",
                                "target_lang_sense_clarification": "Can be used to describe rare or incidental occurrences."
                            },
                            {
                                "target_lang_word": "on occasion",
                                "target_lang_sense_clarification": "Suggests that something happens only under specific circumstances."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}