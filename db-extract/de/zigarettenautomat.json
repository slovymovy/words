                        "examples": [
                            {
                                "example_id": "34595d0d-ae12-482d-8ef9-6c1bcdb324d0",
                                "sense_id": "1a5fdc31-5331-3d81-a109-235b1e0f3d5f",
                                "text": "„Nun fordern die Grünen auch in Österreich das Aus der Zigarettenautomaten, berichtete das Ö1-Morgenjournal am Freitag.“"
                            },
                            {
                                "example_id": "7100ec7f-019a-49aa-baeb-eb7e3f46f9c2",
                                "sense_id": "1a5fdc31-5331-3d81-a109-235b1e0f3d5f",
                                "text": "„Die Grünen halten die Altersperre an Zigarettenautomaten für nutzlos - Jugendliche zögen ja trotzdem ihre Schachteln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
