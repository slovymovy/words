            {
                "entry_id": "43384ff7-6fc0-381f-afcc-16ca8381cd6f",
                "word": "pompadour",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3026c08c-0e57-4998-a780-235d35981e8a",
                        "entry_id": "43384ff7-6fc0-381f-afcc-16ca8381cd6f",
                        "tags": [
