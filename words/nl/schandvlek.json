                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>schandvlek</w> je de reputatie van je eigen bedrijf op deze manier?",
                            "target_lang_translations": {
                                "en": "Why do you <w>disgrace</w> the reputation of your own company in this way?"
