{
    "word_family": [
        "filcher",
        "filching"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "eb2b6551-4158-33e1-b011-927217c7bafd",
                    "sense_definition": "To illegally take possession of (something, especially items of low value); to pilfer, to steal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "steal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hey, someone <w>filched</w> my wallet while I was not looking!",
                            "target_lang_translations": {
                                "ru": "Эй, кто-то <w>стащил</w> мой кошелек, пока я не смотрел!"
                            }
                        },
                        {
                            "text": "He would often <w>filch</w> small items like pens and paperclips from the office.",
                            "target_lang_translations": {
                                "ru": "Он часто <w>таскал</w> из офиса всякие мелочи вроде ручек и скрепок."
                            }
                        }
                    ],
                    "synonyms": [
                        "pilfer",
                        "pinch",
                        "steal",
                        "swipe",
                        "purloin",
                        "nick"
                    ],
                    "common_phrases": [
                        "filch small items",
                        "filch a wallet"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used informally to describe minor thefts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Незаконно завладеть (чем-либо, особенно малоценными предметами); стянуть, стащить, украсть."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стащить",
                                "target_lang_sense_clarification": "разговорное, о мелкой краже"
                            },
                            {
                                "target_lang_word": "стянуть",
                                "target_lang_sense_clarification": "разговорное, незаметно украсть"
                            },
                            {
                                "target_lang_word": "украсть",
                                "target_lang_sense_clarification": "совершить кражу"
                            },
                            {
                                "target_lang_word": "своровать",
                                "target_lang_sense_clarification": "совершить мелкую кражу"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fbc8c835-ec20-381f-9d3b-789e4732eaf4",
                    "sense_definition": "An act of filching; larceny, theft.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "theft_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden disappearance of the keys was a clever <w>filch</w> by the thief.",
                            "target_lang_translations": {
                                "ru": "Внезапное исчезновение ключей было ловкой <w>кражей</w>, совершенной вором."
                            }
                        },
                        {
                            "text": "He was caught in the act of a minor <w>filch</w> at the local market.",
                            "target_lang_translations": {
                                "ru": "Его поймали с поличным во время мелкого <w>воровства</w> на местном рынке."
                            }
                        }
                    ],
                    "synonyms": [
                        "larceny",
                        "theft",
                        "pilferage"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rarely used as a noun in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт мелкой кражи; воровство, хищение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мелкая кража",
                                "target_lang_sense_clarification": "действие по хищению мелких вещей"
                            },
                            {
                                "target_lang_word": "воровство",
                                "target_lang_sense_clarification": "процесс или акт кражи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50c24a5d-d4d0-3ea7-b979-3e17f95bbfa2",
                    "sense_definition": "A person who filches; a filcher, a pilferer, a thief.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "thief_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young <w>filch</w> slipped through the crowded streets unnoticed.",
                            "target_lang_translations": {
                                "ru": "Молодой <w>воришка</w> незаметно проскользнул по многолюдным улицам."
                            }
                        },
                        {
                            "text": "Watch your pockets, as there is a known <w>filch</w> operating in this area.",
                            "target_lang_translations": {
                                "ru": "Берегите карманы, так как в этом районе орудует известный <w>карманник</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "filcher",
                        "pilferer",
                        "thief"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical slang for a petty thief"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который совершает мелкие кражи; мелкий воришка, карманник."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воришка",
                                "target_lang_sense_clarification": "мелкий вор"
                            },
                            {
                                "target_lang_word": "вор",
                                "target_lang_sense_clarification": "тот, кто крадет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cdff34a1-3a3c-3921-89a4-c8edf0fed373",
                    "sense_definition": "Something which has been filched or stolen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "stolen_property",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police recovered the stolen goods, which turned out to be a mere <w>filch</w> of cheap trinkets.",
                            "target_lang_translations": {
                                "ru": "Полиция вернула украденные вещи, которые оказались всего лишь <w>добычей</w> из дешевых безделушек."
                            }
                        },
                        {
                            "text": "He hid his small <w>filch</w> under the floorboards of his room.",
                            "target_lang_translations": {
                                "ru": "Он спрятал свое небольшое <w>украденное</w> добро под половицами в своей комнате."
                            }
                        }
                    ],
                    "synonyms": [
                        "booty",
                        "loot",
                        "spoils"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rarely used to refer to the stolen object itself"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, что было украдено или стянуто."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "украденное",
                                "target_lang_sense_clarification": "похищенные вещи"
                            },
                            {
                                "target_lang_word": "добыча",
                                "target_lang_sense_clarification": "награбленное или украденное имущество"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9468e190-18a0-35da-8518-1b4df4cffc9d",
                    "sense_definition": "A hooked stick used to filch objects.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "theft_tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The vagabond carried a long staff called a <w>filch</w> to grab linen from clotheslines.",
                            "target_lang_translations": {
                                "ru": "Бродяга носил с собой длинный шест, называемый <w>багром</w>, чтобы стаскивать белье с веревок."
                            }
                        },
                        {
                            "text": "With a hook attached to his <w>filch</w>, he could reach items through open windows.",
                            "target_lang_translations": {
                                "ru": "С помощью крюка, прикрепленного к его <w>шесту</w>, он мог доставать вещи через открытые окна."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical cant/slang term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Палка с крюком, использовавшаяся для совершения мелких краж (например, белья с веревок)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шест с крюком",
                                "target_lang_sense_clarification": "воровское приспособление"
                            },
                            {
                                "target_lang_word": "багор",
                                "target_lang_sense_clarification": "инструмент в виде шеста с крюком"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}