            "pos": "verb",
            "senses": [
                {
                    "sense_id": "57afcd8b-d801-3778-9a9c-ffda2c7b2ada",
                    "sense_definition": "Jouer ou incarner un personnage au théâtre ou au cinéma.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "spectacle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette actrice talentueuse va <w>interpréter</w> le rôle principal dans le nouveau film."
                        },
                        {
                            "text": "Il a magnifiquement <w>interprété</w> ce personnage complexe tout au long de la pièce."
                        }
                    ],
                    "synonyms": [
                        "jouer"
                    ],
                    "common_phrases": [
                        "interpréter un rôle",
                        "interpréter un personnage"
                    ]
                },
                {
                    "sense_id": "1bb889cd-c99e-3408-b66a-2f35e81d161b",
                    "sense_definition": "Jouer ou chanter une œuvre musicale.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "spectacle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'orchestre a choisi d'<w>interpréter</w> une symphonie classique pour l'ouverture du festival."
                        },
                        {
                            "text": "Le jeune pianiste a <w>interprété</w> ce morceau avec beaucoup d'émotion et de précision."
                        }
                    ],
                    "synonyms": [
                        "jouer",
                        "exécuter"
                    ],
                    "common_phrases": [
                        "interpréter une chanson",
                        "interpréter un morceau"
                    ]
                },
                {
                    "sense_id": "e7c29b79-4291-3377-b7ae-b6bdc56a8e6e",
                    "sense_definition": "Expliquer et éclaircir le sens d'un texte, d'un texte juridique ou d'un acte obscur.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "signification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le juge doit souvent <w>interpréter</w> la loi lorsque la situation n'est pas clairement définie."
                        },
                        {
                            "text": "Les étudiants apprennent à <w>interpréter</w> ce poème ancien selon différentes approches critiques."
                        }
                    ],
                    "common_phrases": [
                        "interpréter un texte",
                        "interpréter la loi"
                    ]
                },
                {
                    "sense_id": "567c7f71-1f91-3fa4-87f5-8780c782d133",
                    "sense_definition": "Attribuer une signification particulière à des paroles ou des actes, en bonne ou mauvaise part.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne va pas mal <w>interpréter</w> mes remarques, je voulais seulement t'aider."
                        },
                        {
                            "text": "Elle craignait que son geste ne soit mal <w>interprété</w> par ses collègues de travail."
                        }
                    ],
                    "common_phrases": [
                        "mal interpréter",
                        "bien interpréter"
                    ]
                },
                {
                    "sense_id": "b752e5ac-2ca9-3068-a231-ab21a1bb54c3",
                    "sense_definition": "Tirer des déductions ou donner un sens à des indices, des données ou des phénomènes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "signification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les chercheurs tentent d'<w>interpréter</w> les résultats obtenus lors de la dernière expérience."
                        },
                        {
                            "text": "Il est parfois difficile d'<w>interpréter</w> ces graphiques sans disposer d'informations complémentaires."
                        }
                    ],
                    "common_phrases": [
                        "interpréter des résultats",
                        "interpréter des données"
                    ]
                },
                {
                    "sense_id": "79a23052-41fe-3d74-a237-d2e86fe4d607",
                    "sense_definition": "Traduire oralement les propos d'une personne d'une langue vers une autre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "traduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a été engagée pour <w>interpréter</w> le discours officiel devant les délégués étrangers."
                        },
                        {
                            "text": "Pendant toute la réunion internationale, il a <w>interprété</w> les débats avec une grande fluidité."
                        }
                    ],
                    "synonyms": [
                        "traduire"
                    ],
                    "common_phrases": [
                        "interpréter un discours"
                    ]
                }
            ]
        }
    ]
}