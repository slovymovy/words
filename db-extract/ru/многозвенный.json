                ],
                "senses": [
                    {
                        "sense_id": "3c00b8c8-32db-3c8f-95f2-f3823a5bcac4",
                        "entry_id": "97fef622-4b59-3ab7-a3d7-243c91a12da6",
                        "glosses": [
                            "состоящий из нескольких звеньев"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f590e5ad-c726-4869-9b98-908469501f46",
                                "sense_id": "3c00b8c8-32db-3c8f-95f2-f3823a5bcac4",
                                "text": "А если направляющий аппарат включает четыре или пять элементов, то он вполне заслуживает универсального определения «многозвенный» или «многорычажный»."
                            },
                            {
                                "example_id": "9a56b6c2-277a-4aa4-9f5b-5d67fe406f1a",
                                "sense_id": "3c00b8c8-32db-3c8f-95f2-f3823a5bcac4",
                                "text": "Авторы ознакомили участников конференции с проблемой траектории многозвенного манипулятора в сложном рабочем пространстве с препятствиями на основе генетического подхода и использования параллельных вычислений."
                            }
                        ]
                    }
