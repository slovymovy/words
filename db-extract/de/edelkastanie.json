                                    },
                                    {
                                        "sense_id": "0d860c54-e073-34ac-9e5c-d10d0a7f833a",
                                        "entry_id": "0d857fff-14b1-3481-a789-6408cacd6ef3",
                                        "glosses": [
                                            "A dark, reddish-brown colour, as seen on the fruit of the chestnut tree."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5f6b59ac-faea-3871-9ccf-95eb6c9ae3bc",
                                        "entry_id": "0d857fff-14b1-3481-a789-6408cacd6ef3",
                                        "glosses": [
                                            "A reddish-brown horse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b847e12c-ed98-4a28-a55d-f05b3dfaf6de",
                                                "sense_id": "5f6b59ac-faea-3871-9ccf-95eb6c9ae3bc",
                                                "text": "Lord Carington […] led the way with his chestnuts […]"
                                            },
                                            {
                                                "example_id": "5839a25c-fcbf-4444-bd75-4f48f56c2b26",
                                                "sense_id": "5f6b59ac-faea-3871-9ccf-95eb6c9ae3bc",
                                                "text": "[…] browns are the soberest, bays are the worst tempered, and chestnuts are the most foolish."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d27daefe-7b79-303e-8286-58a62b8d3fa4",
                                        "entry_id": "0d857fff-14b1-3481-a789-6408cacd6ef3",
                                        "glosses": [
                                            "Wood of a chestnut tree."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61006ac9-e25e-382e-ae45-70d6879a2399",
                                        "entry_id": "0d857fff-14b1-3481-a789-6408cacd6ef3",
                                        "glosses": [
                                            "An old joke; a worn-out meme, phrase, ploy, etc. so often repeated as to have grown tiresome or ineffective (often in the phrase \\\"old chestnut\\\")."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd8e59f1-49ca-4ed0-a5c9-52efd865b5e3",
                                                "sense_id": "61006ac9-e25e-382e-ae45-70d6879a2399",
                                                "text": "Yep, this is a dance-leaning cover of the Matthew Wilder '80s pop chestnut. It has already saturated radio airwaves throughout Europe, with a number of programmers here already giving it positive feedback."
                                            },
                                            {
                                                "example_id": "c9e9baea-86aa-4c96-8fd1-c65c5e4398f7",
                                                "sense_id": "61006ac9-e25e-382e-ae45-70d6879a2399",
                                                "text": "Take greed. He’s been cited many times for what now has become a chestnut: “The point is, you can’t be too greedy.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd16f896-4c56-3874-acfd-da9fc79d7297",
                                        "entry_id": "0d857fff-14b1-3481-a789-6408cacd6ef3",
                                        "glosses": [
                                            "A round or oval horny plate found on the inner side of the leg of a horse or other animal, similar to a birthmark on a human."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
