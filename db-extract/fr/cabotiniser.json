                "senses": [
                    {
                        "sense_id": "f3253d82-69a1-360f-82db-d400d6d0a55d",
                        "entry_id": "9a1347d8-8bcb-39ae-bab5-b3cc233b0d62",
                        "glosses": [
                            "Donner un caractère cabotin à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39fb09e9-29ab-4140-8c80-cdc77fdfdd29",
                                "sense_id": "f3253d82-69a1-360f-82db-d400d6d0a55d",
                                "text": "J’ai vu cabotiniser la plus grande douleur humaine, véhément, clownesquement parodiée…"
                            },
                            {
                                "example_id": "4dc5c8dd-72d5-4648-938a-d7bef9a7d1b2",
                                "sense_id": "f3253d82-69a1-360f-82db-d400d6d0a55d",
                                "text": "Nous verrons donc les concurrents de Max Linder « cabotiniser » leurs exploits cinématographiques dans le public des Cinémas."
                            }
                        ]
                    },
                    {
                        "sense_id": "0154788f-5540-348e-8379-313ddfffe137",
                        "entry_id": "9a1347d8-8bcb-39ae-bab5-b3cc233b0d62",
                        "glosses": [
                            "Cabotiner, être cabotin."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "360f86f4-724c-4a6b-98b2-d44a579f3321",
                                "sense_id": "0154788f-5540-348e-8379-313ddfffe137",
                                "text": "Sophie Marceau joue faux et cabotinise, mais tu as raison, elle se ridiculise elle-même, pas grave."
                            },
                            {
                                "example_id": "f5338f82-b1af-4b82-b84c-c1341b77359b",
                                "sense_id": "0154788f-5540-348e-8379-313ddfffe137",
                                "text": "Ils sont bien, mais je les vois toujours en train de cabotiniser, là."
                            }
                        ]
                    }
