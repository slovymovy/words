                        "form": "das Gehabe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1490ab18-838b-31f6-abef-655142dbc013",
                        "entry_id": "6dc44c83-329d-3253-87b6-2d8b2291051d",
                        "glosses": [
                            "meist negativ: (affektiertes) Verhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1965919f-cc80-4968-a2cb-017d2436dbe0",
                                "sense_id": "1490ab18-838b-31f6-abef-655142dbc013",
                                "text": "Dein blödes Gehabe geht mir langsam auf die Nerven."
                            },
                            {
                                "example_id": "28d4d2e4-6501-475a-892b-617cbf83f99d",
                                "sense_id": "1490ab18-838b-31f6-abef-655142dbc013",
                                "text": "„An seiner Kleidung, und offenbar auch an seinem Gehabe ist zu sehen, dass er ein Wessi ist.“"
                            },
                            {
                                "example_id": "f7515f85-2c02-48e2-b10f-46c409b513e8",
                                "sense_id": "1490ab18-838b-31f6-abef-655142dbc013",
                                "text": "„Die beiden Frauen auf dem Hintersitz waren jung und hübsch; ihre Kleidung war sehr ordentlich, ihr Gehabe ungezwungen und doch gesittet.“"
                            },
                            {
                                "example_id": "7ab7bd69-aad8-4a30-a2f7-149b10ebeec5",
                                "sense_id": "1490ab18-838b-31f6-abef-655142dbc013",
                                "text": "„Er verstand nicht, warum ihr Gehabe bald stolz, bald erschrocken war, warum sie ihr schönes Gesicht bedeckte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "99f8cabc-5287-4a74-9c0d-42c95aee469a",
                        "source_entry_id": "6dc44c83-329d-3253-87b6-2d8b2291051d",
                        "source_sense_id": "1490ab18-838b-31f6-abef-655142dbc013",
                        "source_sense_description": "meist negativ: (affektiertes) Verhalten",
                        "target_lang_word": "affectation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "affectation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69ea6a0d-447c-39c8-8b17-8b6728dd1378",
                                        "entry_id": "b7931b8d-4e43-3934-96a0-da2e1a2131e5",
                                        "glosses": [
                                            "An attempt to assume or exhibit what is not natural or real; false display; artificial show."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c4f4156-3393-474b-a90d-78107f773696",
                                                "sense_id": "69ea6a0d-447c-39c8-8b17-8b6728dd1378",
                                                "text": "This poem is strongly tinctured with those pedantic affectations concerning the passion of love ..."
                                            },
                                            {
                                                "example_id": "78902a0f-bae1-44d7-95de-210fb4790ba0",
                                                "sense_id": "69ea6a0d-447c-39c8-8b17-8b6728dd1378",
                                                "text": "[T]hey were not the spoiled children of affectation and refinement, but a bold, vigorous, independent race of thinkers, with prodigious strength and energy, with none but natural grace, and heartfelt unobtrusive delicacy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9eb08ea4-47be-3e1e-8113-a37f50d0f483",
                                        "entry_id": "b7931b8d-4e43-3934-96a0-da2e1a2131e5",
                                        "glosses": [
                                            "An unusual mannerism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5444e6f2-571e-37a8-82a8-89fa7f4b95eb",
                                        "entry_id": "b7931b8d-4e43-3934-96a0-da2e1a2131e5",
                                        "glosses": [
                                            "An ostentatious fondness for something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "uncountable",
                                            "with-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b67f58e-abb3-4115-a918-48c5319dc089",
                                                "sense_id": "5444e6f2-571e-37a8-82a8-89fa7f4b95eb",
                                                "text": "The grace diuineſt Mercvrie hath done me, / In this vouchſafde diſcouerie of himſelfe, / Binds my obſeruance in the vtmoſt terme / Of ſatisfaction, to his godly will: / Though I profeſſe (without the affectation / Of an enforc’d, and form’d auſteritie) / I could be willing to enioy no place / With ſo vnequall natures."
                                            },
                                            {
                                                "example_id": "0250ba52-5340-467a-a55a-63e8d277cf39",
                                                "sense_id": "5444e6f2-571e-37a8-82a8-89fa7f4b95eb",
                                                "text": "Her upper part of decent diſcipline / Shew’d affecation of an ancient line: / And fathers, councils, church and churches head, / Were on her reverend Phylacteries read."
                                            },
                                            {
                                                "example_id": "db3e4624-b956-4992-90ce-320db17d55bf",
                                                "sense_id": "5444e6f2-571e-37a8-82a8-89fa7f4b95eb",
                                                "text": "While for some, women’s lack of knowledge is a matter for censure, throughout the century both male and female writers emphasize that affectation of knowledge, for example when it is not properly assimilated (Du Bosc 1633: 78), and above all pedantry from women, are far more unacceptable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "811e86d8-c707-42c4-b7c1-bbbcd1e7377a",
                        "source_entry_id": "6dc44c83-329d-3253-87b6-2d8b2291051d",
                        "source_sense_id": "1490ab18-838b-31f6-abef-655142dbc013",
                        "source_sense_description": "meist negativ: (affektiertes) Verhalten",
                        "target_lang_word": "conduite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conduite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "227974bd-0312-3e61-96d9-d5faa1a82255",
                                        "entry_id": "2737d648-1103-3804-b847-a4e6934a5654",
                                        "glosses": [
                                            "Action de conduire, de mener, de guider, d’accompagner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd8c6c97-a4f8-4fa5-835f-8aa32ef1bda4",
                                                "sense_id": "227974bd-0312-3e61-96d9-d5faa1a82255",
                                                "text": "Voilà pourquoi il faut franchir les rivières sous la conduite d'un guide local qui connaisse les points guéables."
                                            },
                                            {
                                                "example_id": "f6adf633-3d75-4a08-ade4-149febc30f1d",
                                                "sense_id": "227974bd-0312-3e61-96d9-d5faa1a82255",
                                                "text": "Être chargé de la conduite d’un aveugle, de la conduite d’un convoi. — La conduite d’un troupeau."
                                            },
                                            {
                                                "example_id": "920a537a-84a8-4786-9450-3fb25968d0b3",
                                                "sense_id": "227974bd-0312-3e61-96d9-d5faa1a82255",
                                                "text": "Le terme « système de conduite automatisé » désigne un dispositif associant des éléments matériels et logiciels permettant d’assurer le contrôle dynamique d’un véhicule de façon ininterrompue."
                                            },
                                            {
                                                "example_id": "10a4ca2f-a0ce-4b2b-ac6b-850f65942906",
                                                "sense_id": "227974bd-0312-3e61-96d9-d5faa1a82255",
                                                "text": "— Faire la conduite à un ami, à un camarade qui part."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fe130c3-ce5a-3c9c-8013-06fb85130874",
                                        "entry_id": "2737d648-1103-3804-b847-a4e6934a5654",
                                        "glosses": [
                                            "Direction d’un ouvrage, d’un projet, d’une affaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a36deeb9-0022-4439-b5fb-a5b11e4d7741",
                                                "sense_id": "1fe130c3-ce5a-3c9c-8013-06fb85130874",
                                                "text": "Avoir la conduite d’un bâtiment, d’un travail. — Prendre la conduite d’une entreprise."
                                            },
                                            {
                                                "example_id": "ea7b2d65-717a-4510-9295-bc239aa20a40",
                                                "sense_id": "1fe130c3-ce5a-3c9c-8013-06fb85130874",
                                                "text": "Se charger de la conduite d’une affaire, d’un procès."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf14f233-8674-350e-9ad8-538d254cb68d",
                                        "entry_id": "2737d648-1103-3804-b847-a4e6934a5654",
                                        "glosses": [
                                            "Manière dont les éléments, les incidents sont disposés et amenés dans un ouvrage."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "492a60bb-147a-4054-96fc-ab2895dbb8ac",
                                                "sense_id": "cf14f233-8674-350e-9ad8-538d254cb68d",
                                                "text": "La conduite d’un poème épique, d’un poème dramatique,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86663b1a-575a-3a41-b68b-17696df9d884",
                                        "entry_id": "2737d648-1103-3804-b847-a4e6934a5654",
                                        "glosses": [
                                            "Gouvernement soit politique, soit militaire, soit ecclésiastique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00c39976-ba3f-4125-b379-0b1745836dfe",
                                                "sense_id": "86663b1a-575a-3a41-b68b-17696df9d884",
                                                "text": "Non content de s'immiscer dans la conduite des affaires publiques, en imposant son point de vue et ses préjugés aux souverains, le clergé prétendit s'immiscer également dans la vie religieuse du judaïsme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32e2fde6-d8da-3191-9a09-555b785802ce",
                                        "entry_id": "2737d648-1103-3804-b847-a4e6934a5654",
                                        "glosses": [
                                            "Inspection qu’on a sur les mœurs, sur les actions de quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76e46233-b2b6-43d1-8d53-da24f6218f2b",
                                                "sense_id": "32e2fde6-d8da-3191-9a09-555b785802ce",
                                                "text": "Se charger de la conduite d’un jeune homme, en abandonner la conduite à quelqu’un. — Ce jeune homme est sous ma conduite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbe2efcc-cbcb-3f40-b77c-e25ba4082c88",
                                        "entry_id": "2737d648-1103-3804-b847-a4e6934a5654",
                                        "glosses": [
                                            "Manière d’agir, façon dont chacun se gouverne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e838558-ef09-4afb-b665-1c989f282e4e",
                                                "sense_id": "cbe2efcc-cbcb-3f40-b77c-e25ba4082c88",
                                                "text": "Le compositeur particulièrement désigné comme homme de conscience doit être excellent ouvrier, minutieux, et d'une conduite régulière."
                                            },
                                            {
                                                "example_id": "0d91531d-660b-45ff-8506-ffcd4a57816f",
                                                "sense_id": "cbe2efcc-cbcb-3f40-b77c-e25ba4082c88",
                                                "text": "En réfléchissant longuement à son plan de conduite pendant ce voyage, Marthe s’était imposé le devoir d’être brave et de ne pas s’arrêter ou s’intimider devant les dangers qu’elle pourrait rencontrer."
                                            },
                                            {
                                                "example_id": "c870436e-dd18-4608-920b-0b77c7594f2a",
                                                "sense_id": "cbe2efcc-cbcb-3f40-b77c-e25ba4082c88",
                                                "text": "Tout autre est la conduite du véritable chrétien. Il doit d’abord s’en tenir à la foi, et seulement ensuite chercher à la justifier en raison."
                                            },
                                            {
                                                "example_id": "1f5d3a2f-702a-4b8c-9fe6-a772fdcec787",
                                                "sense_id": "cbe2efcc-cbcb-3f40-b77c-e25ba4082c88",
                                                "text": "« Vous ne punirez pas ce pauvre petit Frédéric. Il a déjà assez de chagrin...\n– Il me copiera les Bucoliques, déclara le vétérinaire. J’exige que l’on ait de la conduite, et c’est un point sur lequel je serai toujours intraitable. »"
                                            },
                                            {
                                                "example_id": "c1dc260d-7637-492f-b0c9-48c8be2e84cb",
                                                "sense_id": "cbe2efcc-cbcb-3f40-b77c-e25ba4082c88",
                                                "text": "Les paroles indignées du lieutenant sur la conduite de ses poilus, les amplifications moins vertueuses mais ultra-séduisantes qu’y ajouta Lénac, mirent l’eau à la bouche des hommes de la 8ᵉ."
                                            },
                                            {
                                                "example_id": "8a7d85f2-857c-4f8c-8b8c-f01c77070088",
                                                "sense_id": "cbe2efcc-cbcb-3f40-b77c-e25ba4082c88",
                                                "text": "Ces malfaiteurs littéraires voudraient persuader de tels hommes qu’ils n’ont pas besoin d’excuse et que leur conduite se conforme au dictamen de la nature."
                                            },
                                            {
                                                "example_id": "4879e610-cb6a-4da6-9a2a-f03ea32a12c5",
                                                "sense_id": "cbe2efcc-cbcb-3f40-b77c-e25ba4082c88",
                                                "text": "Nous avions pour jardinier un ancien forçat que sa bonne conduite au bagne avait racheté de ses fautes."
                                            },
                                            {
                                                "example_id": "6b00c38b-a222-4977-b614-c82b740b3569",
                                                "sense_id": "cbe2efcc-cbcb-3f40-b77c-e25ba4082c88",
                                                "text": "Il me restait les femmes avec qui la meilleure conduite est de n’en avoir pas du tout, les femmes pour qui il n’est pas bon de se faire une trop haute idée de soi-même : elle en souffrirait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aab8cd86-da4c-3678-8a12-14c7c110cc44",
                                        "entry_id": "2737d648-1103-3804-b847-a4e6934a5654",
                                        "glosses": [
                                            "Tuyau ou aqueduc, gros conduit, qui porte d’un lieu à un autre les eaux d’une fontaine, d’un étang, d’une rivière, etc."
                                        ],
                                        "tags": [
                                            "Hydraulique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67eb4cb1-3a5c-45bd-92a4-3c5edd818b13",
                                                "sense_id": "aab8cd86-da4c-3678-8a12-14c7c110cc44",
                                                "text": "Viennent ensuite les conduites forcées qui mènent l'eau jusqu'aux turbines. Ces impressionnants tuyaux en acier de 1,9 à 2,3 mètres de diamètre peuvent supporter une pression de 28 bars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3439126e-9272-3b6d-a8f1-b5cbb639d84d",
                                        "entry_id": "2737d648-1103-3804-b847-a4e6934a5654",
                                        "glosses": [
                                            "Tuyauterie, canalisation destinée à amener un gaz ou à distribuer l’électricité."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d1ca065-959b-4228-99c9-4dd3646123dc",
                                                "sense_id": "3439126e-9272-3b6d-a8f1-b5cbb639d84d",
                                                "text": "Une conduite de gaz, d’électricité, de téléphone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06649493-c6d2-3d08-a93a-b9c46c857962",
                                        "entry_id": "2737d648-1103-3804-b847-a4e6934a5654",
                                        "glosses": [
                                            "Frais de route engendrés par les déplacements que font les marins entre le domicile et le lieu d'embarquement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6d720826-8fa0-3057-8522-f60b7d30fde6",
                                        "entry_id": "2737d648-1103-3804-b847-a4e6934a5654",
                                        "glosses": [
                                            "Ensemble des opérations de commande et de contrôle d’un réacteur nucléaire."
                                        ],
                                        "tags": [
                                            "Nucléaire"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "conduite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "125874f1-255c-3535-9422-8f9bb05e84cb",
                                        "entry_id": "b6fd4d6b-a396-3cea-b526-0643533bd6ff",
                                        "glosses": [
                                            "Participe passé féminin singulier de conduire."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2344b8e-3f13-445a-907e-23f728df6b99",
                                                "sense_id": "125874f1-255c-3535-9422-8f9bb05e84cb",
                                                "text": "Une machine teignant cent kilos de matière est conduite par un seul ouvrier qui a le temps, pendant la durée de la passe, de préparer la matière pour la passe suivante et de débâtonner ensuite la matière teinte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
