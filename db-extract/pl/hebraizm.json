                "forms": [],
                "senses": [
                    {
                        "sense_id": "f1cb0f35-c24f-3eb6-bca5-aeda4b8da9fe",
                        "entry_id": "9c9d8983-9255-36ac-9e9c-a56648ea822d",
                        "glosses": [
                            "wyraz, zwrot, forma gramatyczna zapożyczona do jakiegoś języka z języka hebrajskiego"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bac7548e-9113-4457-bd1f-701877312ff7",
                        "source_entry_id": "9c9d8983-9255-36ac-9e9c-a56648ea822d",
                        "source_sense_id": "f1cb0f35-c24f-3eb6-bca5-aeda4b8da9fe",
                        "target_lang_word": "Hebraismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hebraismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7a654427-44ee-3ad3-9026-da7000e68c1a",
                                        "entry_id": "8f335f83-94f6-3630-bd3c-9f60b40a957b",
                                        "glosses": [
                                            "ein Wort oder sonstiger sprachlicher Ausdruck der hebräischen Sprache als Entlehnung (zum Beispiel als Fremd- oder Lehnwort) in einer anderen Sprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6bd31f2-e780-4d5a-b565-ccb01eaf7307",
                                                "sense_id": "7a654427-44ee-3ad3-9026-da7000e68c1a",
                                                "text": "Eine ganze Reihe von Wörtern, die ursprünglich Hebraismen waren, sind über das Jiddische, also als Jiddismen ins Deutsche gelangt, so etwa das bekannte Adjektiv „koscher“."
                                            },
                                            {
                                                "example_id": "4a8736db-dfc6-4571-8f20-ffe7c08d7b72",
                                                "sense_id": "7a654427-44ee-3ad3-9026-da7000e68c1a",
                                                "text": "„Im Jiddischen ist nun eine Komponente die der Hebraismen, die für die alte Zeit schwer oder gar nicht von zitierten hebräischen Wörtern oder Wendungen sauber zu trennen sind, von Elementen also, die gar nicht dem Jiddischen zugehören.“"
                                            },
                                            {
                                                "example_id": "1799f947-3529-43e0-9b5a-97c51009517a",
                                                "sense_id": "7a654427-44ee-3ad3-9026-da7000e68c1a",
                                                "text": "„Hebraismen und Aramäismen des Jiddischen beschränken sich nicht nur auf Substantive, sondern es gibt auch Verben, Adjektive, Adverbien und Partikel…“"
                                            },
                                            {
                                                "example_id": "603067f7-6237-4ea7-9f60-1ff8916e0263",
                                                "sense_id": "7a654427-44ee-3ad3-9026-da7000e68c1a",
                                                "text": "„Sollten ihre Schriften von den einfachen Juden überhaupt verstanden werden, mußten sie sich deren Sprache mit all ihren Slawismen und Hebraismen bedienen.“"
                                            },
                                            {
                                                "example_id": "c07ebc5d-4895-450d-a6a4-3b77057df76f",
                                                "sense_id": "7a654427-44ee-3ad3-9026-da7000e68c1a",
                                                "text": "„Die Untersuchung hat ergeben, dass in der Gemeinsprache mit rund 150 mehr oder weniger geläufigen Hebraismen zu rechnen ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62e4f5cb-cd93-414e-b429-620173b49d51",
                        "source_entry_id": "9c9d8983-9255-36ac-9e9c-a56648ea822d",
                        "source_sense_id": "f1cb0f35-c24f-3eb6-bca5-aeda4b8da9fe",
                        "target_lang_word": "ebraismo",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ebraismo",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "0e9baf04-0f22-3805-a082-209b26898536",
                                        "entry_id": "33bad3b1-10da-3f84-992e-9e67ab2574f6",
                                        "glosses": [
                                            "religione del popolo ebraico"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f299f33-db81-430a-a042-ff0c86ad5919",
                                                "sense_id": "0e9baf04-0f22-3805-a082-209b26898536",
                                                "text": "l'ebraismo coinvolge religiosamente l'intera esistenza dell'ebreo"
                                            },
                                            {
                                                "example_id": "f1e99416-5519-40b1-b899-3633808d2ea7",
                                                "sense_id": "0e9baf04-0f22-3805-a082-209b26898536",
                                                "text": "come ovvio, molti cattolici si sono convertiti all’ebraismo; così anche musulmani ed orientali, persino africani… ma, pur se raro, è vero anche l’opposto…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fe0f2e7-ebef-3411-9294-3ef4d5d6c12c",
                                        "entry_id": "33bad3b1-10da-3f84-992e-9e67ab2574f6",
                                        "glosses": [
                                            "ebraismo ortodosso: per lo più coinvolge gruppi chassidici e Haredi... ma non soltanto (ne deriva l'ortodosso moderno: appunto estrema l'espressione \\\"ultra-ortodosso\\\"... infatti non accetta dagli ebrei)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b2e82aeb-9f12-38d1-8225-40fe87404725",
                                        "entry_id": "33bad3b1-10da-3f84-992e-9e67ab2574f6",
                                        "glosses": [
                                            "ebraismo rabbinico: epoca talmudica"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b7c5a096-f9db-321b-94b1-a10e6906648c",
                                        "entry_id": "33bad3b1-10da-3f84-992e-9e67ab2574f6",
                                        "glosses": [
                                            "ebraismo conservatore: lett. secondo la tradizione (forse il più \\\"numeroso\\\"), viene definito Masorti"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7ef8687e-9a27-39ca-b0d2-fdde2530fcd5",
                                        "entry_id": "33bad3b1-10da-3f84-992e-9e67ab2574f6",
                                        "glosses": [
                                            "ebraismo reformer: appunto non pienamente osservante (ne derivano variegate modalità con pratiche non sempre condivise nel \\\"mondo ebraico religioso\\\")"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "68ca9a37-3491-3f1d-aa33-abe749e604fa",
                                        "entry_id": "33bad3b1-10da-3f84-992e-9e67ab2574f6",
                                        "glosses": [
                                            "ebraismo umanista: sintetizzando... è chi abbraccia in toto i principi tratti dall'Haskalah (essa si formò nel tentativo di conciliare la tradizione religiosa ebraica con gli altri saperi, con ciò in parte riuscendovi ma non sempre al meglio)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "602cd169-8914-324c-a1e5-17934aa4683f",
                                        "entry_id": "33bad3b1-10da-3f84-992e-9e67ab2574f6",
                                        "glosses": [
                                            "ebraismo laico: afferma di essere ebreo laico chi, difficilmente per una completa scelta autonoma, non riesce ad osservare tutte le prescrizioni religiose della Torah, spesso per consistenti impegni lavorativi, per mancanza di guide appropriate, ovvero di riferimenti adeguati, e per incombenze del periodo vissuto, siano queste personali e quindi per lo più per causa di forza maggiore, siano pure storiche collettive"
                                        ],
                                        "tags": [],
                                        "examples": []
