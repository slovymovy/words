                                    {
                                        "sense_id": "c0b63e02-ff9f-30c5-8595-44308e6bfd0d",
                                        "entry_id": "9a5afb91-f6ba-38d2-b2b8-f719ecb32e77",
                                        "glosses": [
                                            "Staatsform, bei der Herrschaft durch Eigentum legitimiert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b92a09bb-55ef-45cc-9a6c-4558ea450976",
                                                "sense_id": "c0b63e02-ff9f-30c5-8595-44308e6bfd0d",
                                                "text": "Die Plutokratie lässt sich vergleichen mit dem Zensuswahlrecht von 1791 in Frankreich."
                                            },
                                            {
                                                "example_id": "3ec9419e-5400-4df9-8e85-ae9f85e0fc8e",
                                                "sense_id": "c0b63e02-ff9f-30c5-8595-44308e6bfd0d",
                                                "text": "„Die feinen Damen aus der Plutokratie und die schicken Parvenüs waren überaus gespannt, ob Frau L. heute Frau K. grüßen würde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
