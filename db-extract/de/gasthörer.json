                "senses": [
                    {
                        "sense_id": "756a1bbe-03d5-3ad7-b9c0-fe7e9a529f29",
                        "entry_id": "9189f5be-3537-3b37-9442-1d30d48c926a",
                        "glosses": [
                            "Person, die nicht in einer Schule oder Universität eingeschrieben ist und freiwillig an Lehrveranstaltungen oder Unterrichtsstunden teilnimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df050e5e-2f24-4f6c-99da-4b5baed46b10",
                                "sense_id": "756a1bbe-03d5-3ad7-b9c0-fe7e9a529f29",
                                "text": "„Pauly hatte sich als Gasthörer eingetragen, nachdem seine Mutter ihm den Tip gegeben hatte.“"
                            },
                            {
                                "example_id": "ea6385e5-0655-469c-b49d-99a1451a9b47",
                                "sense_id": "756a1bbe-03d5-3ad7-b9c0-fe7e9a529f29",
                                "text": "„Böses Blut verursacht dies schon deshalb, weil Regelstudierende pro Semester um 500 Euro Studiengebühren zahlen, der Höchstsatz für Gasthörer aber um 200 Euro beträgt.“"
                            },
                            {
                                "example_id": "b3af4a17-a0e1-423b-aaf2-c5891608fa78",
                                "sense_id": "756a1bbe-03d5-3ad7-b9c0-fe7e9a529f29",
                                "text": "„Wer als Ruheständler im Vorlesungsverzeichnis des Vereins nicht das Passende findet, kann sich in Frankfurt wie an anderen Unis auch als Gasthörer einschreiben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
