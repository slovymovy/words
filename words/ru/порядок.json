                        {
                            "text": "Мы проверили мотор, там полный <w>порядок</w>.",
                            "target_lang_translations": {
                                "en": "We checked the engine, everything is in perfect <w>order</w>.",
                                "zh": "我们检查了引擎，一切<w>没问题</w>。"
                            }
