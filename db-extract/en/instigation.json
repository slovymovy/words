                "entry_id": "9c89233a-6fef-3bba-8194-2524cc581c63",
                "word": "instigation",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4efdeafe-60e8-45d8-8d3d-ab4675d512cd",
