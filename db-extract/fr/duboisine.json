                        "glosses": [
                            "Alcaloïde extrait de certaines duboisies, aujourd’hui assimilé à l’hyoscyamine."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "2afbb0b6-7ece-43e0-9ab8-59e30d43d86c",
                                "sense_id": "cbce3d85-5b8b-38b1-b4cd-0c73a49bb260",
                                "text": "\"Duboisia hopwoodii\" contient différents alcaloïdes fortement stimulants mais aussi toxiques : la piturine, la duboisine, et la nicotine."
                            },
                            {
                                "example_id": "e6ee7ee5-a1de-421f-bd4a-db6b2e1b96e9",
                                "sense_id": "cbce3d85-5b8b-38b1-b4cd-0c73a49bb260",
                                "text": "On lui doit l’introduction de la duboisine comme traitement de la maladie de Parkinson."
                            },
                            {
                                "example_id": "09011f82-2f92-49f4-afe8-227851976aba",
                                "sense_id": "cbce3d85-5b8b-38b1-b4cd-0c73a49bb260",
                                "text": "La duboisine possède une action comparable, mais non tout à fait semblable, à celle de l’atropine."
                            }
                        ]
                    }
