                    {
                        "sense_id": "f52c5f9a-5281-3bdc-96f4-e7f9aed28bea",
                        "entry_id": "5bc419f4-d92a-38b9-8d9b-9babdd4cd963",
                        "glosses": [
                            "Raumdecke in Form eines Gewölbes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5a1da74-a3e2-4404-a309-28f9edadfd9c",
                                "sense_id": "f52c5f9a-5281-3bdc-96f4-e7f9aed28bea",
                                "text": "„Als er im Jahr 1508 den Auftrag für die Gestaltung des Deckengewölbes der Sixtinischen Kapelle erhalten hatte, war er mit einunddreißig Jahren genauso alt wie ich.“"
                            },
                            {
                                "example_id": "c334dfe9-c2e1-470c-b517-2ee0bc6d07c9",
                                "sense_id": "f52c5f9a-5281-3bdc-96f4-e7f9aed28bea",
                                "text": "„Robert hatte selbst den Kopf nach hinten zurückgeworfen, um für den Blick an dem Deckengewölbe des Spiegelgefängnisses einen Halt zu gewinnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "206ee81c-083e-4d84-be59-b487fe0601a5",
