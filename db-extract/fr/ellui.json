                                            "pronoun",
                                            "third-person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77468942-12a3-44bf-892b-527685629803",
                                                "sense_id": "2591b88e-4fdb-385e-9eb6-e2ef0ab7089b",
                                                "text": "She treated them for a cold."
                                            },
                                            {
                                                "example_id": "146cf02c-9925-49b9-a48c-8e3cd8792549",
                                                "sense_id": "2591b88e-4fdb-385e-9eb6-e2ef0ab7089b",
                                                "text": "Proponents of adding a gender-neutral option to state identification documents say it would remove a form of discrimination against nonbinary people by providing them with the means to carry identification that matches their identity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "810f6631-6e54-347b-b1f0-da7626078f7c",
                                        "entry_id": "06633ad1-254d-3cbc-9139-effb08ed5d37",
                                        "glosses": [
                                            "Those ones.",
                                            "Used as the indirect object of a verb."
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "personal",
                                            "pronoun",
                                            "third-person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ddd6d4e-8280-40f7-b79c-be292319db25",
                                                "sense_id": "810f6631-6e54-347b-b1f0-da7626078f7c",
                                                "text": "She wrote them a letter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b889efd-957f-3caf-acd9-02a075010507",
                                        "entry_id": "06633ad1-254d-3cbc-9139-effb08ed5d37",
                                        "glosses": [
                                            "Those ones.",
                                            "Used as the object of a preposition."
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "personal",
                                            "pronoun",
                                            "third-person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e27475d5-30ad-44e9-a226-a6976773e884",
                                                "sense_id": "8b889efd-957f-3caf-acd9-02a075010507",
                                                "text": "Give it to them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca78098f-26d4-3bba-807a-ce0ba0fc9cd2",
                                        "entry_id": "06633ad1-254d-3cbc-9139-effb08ed5d37",
                                        "glosses": [
                                            "A single person, previously mentioned, whose gender is unknown, irrelevant, or (since 21st c.) non-binary.",
                                            "Used as the direct object of a verb."
                                        ],
                                        "tags": [
                                            "personal",
                                            "pronoun",
                                            "singular",
                                            "third-person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa14855d-3e7d-4dae-9047-0b088646f5fc",
                                                "sense_id": "ca78098f-26d4-3bba-807a-ce0ba0fc9cd2",
                                                "text": "If a student has an inappropriate question, whatever you do, do not berate them."
                                            },
                                            {
                                                "example_id": "2f09d3cf-b236-4914-be24-ea246acfaad4",
                                                "sense_id": "ca78098f-26d4-3bba-807a-ce0ba0fc9cd2",
                                                "text": "If there be found among you, within any of thy gates which the Lord thy God giveth thee, man or woman, that hath wrought wickedness in the sight of the Lord thy God, […] [t]hen shalt thou bring forth that man or that woman, which have committed that wicked thing, unto thy gates, even that man or that woman, and shalt stone them with stones, till they die."
                                            },
                                            {
                                                "example_id": "c32fbc84-7cca-44fb-bcee-cdc0b4b4bd27",
                                                "sense_id": "ca78098f-26d4-3bba-807a-ce0ba0fc9cd2",
                                                "text": "Place the casualty on their back with feet and legs raised—this is called the shock position. [emphasis in original] Once the casualty is positioned, cover them to preserve body heat, but do not overheat."
                                            },
                                            {
                                                "example_id": "c5397c2a-5fca-4580-81ce-55a541925403",
                                                "sense_id": "ca78098f-26d4-3bba-807a-ce0ba0fc9cd2",
                                                "text": "Someone in the crowd around the lifts called sycophantically, ‘Morning, Yaxley!’ Yaxley ignored them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc767915-89e2-36de-bfbd-968948c7718c",
                                        "entry_id": "06633ad1-254d-3cbc-9139-effb08ed5d37",
                                        "glosses": [
                                            "A single person, previously mentioned, whose gender is unknown, irrelevant, or (since 21st c.) non-binary.",
                                            "Used as the indirect object of a verb."
                                        ],
                                        "tags": [
                                            "personal",
                                            "pronoun",
                                            "singular",
                                            "third-person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6a38ee3-16a8-453f-bbc4-0eb4dd2210c2",
                                                "sense_id": "dc767915-89e2-36de-bfbd-968948c7718c",
                                                "text": "If one of my patients calls, please bring them their dinner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85794a49-a58e-336c-9893-8ccf40d63f2b",
                                        "entry_id": "06633ad1-254d-3cbc-9139-effb08ed5d37",
                                        "glosses": [
                                            "A single person, previously mentioned, whose gender is unknown, irrelevant, or (since 21st c.) non-binary.",
                                            "Used as the object of a preposition."
                                        ],
                                        "tags": [
                                            "personal",
                                            "pronoun",
                                            "singular",
                                            "third-person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad60d0e7-9250-4557-8bba-b5b5c38db895",
                                                "sense_id": "85794a49-a58e-336c-9893-8ccf40d63f2b",
                                                "text": "If someone comes and asks for the ticket, just give it to them."
                                            },
                                            {
                                                "example_id": "40a8bf4f-be77-4ed2-8f07-d980f38331ad",
                                                "sense_id": "85794a49-a58e-336c-9893-8ccf40d63f2b",
                                                "text": "Each adolescent girl with ASD has needs specific to her because each of them has variable characteristics and different degrees of sensory and perceptual difficulties."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39ab44d6-f74b-3c93-beb6-f945295680e7",
                                        "entry_id": "06633ad1-254d-3cbc-9139-effb08ed5d37",
                                        "glosses": [
                                            "They or those."
                                        ],
                                        "tags": [
                                            "dialectal",
                                            "personal",
                                            "pronoun",
                                            "third-person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6265ae5e-a848-4753-9c62-599839ea1459",
                                                "sense_id": "39ab44d6-f74b-3c93-beb6-f945295680e7",
                                                "text": "I know it seems unfair, but them's the rules."
                                            },
                                            {
                                                "example_id": "26bfc0ab-754a-436d-a89c-ed2ba5de0476",
                                                "sense_id": "39ab44d6-f74b-3c93-beb6-f945295680e7",
                                                "text": "And his mercy is on them that fear him from generation to generation. He hath shewed strength with his arm; he hath scattered the proud in the imagination of their hearts."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "them",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "730b78cd-1837-3493-a06b-04e83933fc82",
                                        "entry_id": "15b165b0-71bb-32db-977e-132af98331cf",
                                        "glosses": [
                                            "Those."
                                        ],
                                        "tags": [
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a11e7d0a-f610-4591-8138-8306389d6604",
                                                "sense_id": "730b78cd-1837-3493-a06b-04e83933fc82",
                                                "text": "Gimme two of them yellow ones."
                                            },
                                            {
                                                "example_id": "63bbbd7d-46a8-4114-ba56-9aaf9a797394",
                                                "sense_id": "730b78cd-1837-3493-a06b-04e83933fc82",
                                                "text": "How would you like a scrummage, Andy, with them Scotchmen that stole your mother's chickens this morning?"
                                            },
                                            {
                                                "example_id": "dca5b1d7-6be4-4d6a-a570-516ad3d17a8f",
                                                "sense_id": "730b78cd-1837-3493-a06b-04e83933fc82",
                                                "text": "The world 'as got me snouted jist a treat; / Crool Forchin's dirty left 'as smote me soul. / An' all them joys o' life I 'eld so sweet / Is up the pole."
                                            },
                                            {
                                                "example_id": "e57f5514-b08e-40aa-a409-3598b08fdf57",
                                                "sense_id": "730b78cd-1837-3493-a06b-04e83933fc82",
                                                "text": "\"I say it's a shame, Silas Linden, the way them children is treated.\""
                                            },
                                            {
                                                "example_id": "7d2f1f3c-e6d7-49d2-b4d5-4f6c3374c47d",
                                                "sense_id": "730b78cd-1837-3493-a06b-04e83933fc82",
                                                "text": "America you don’t really want to go to war.\nAmerica it's them bad Russians.\nThem Russians them Russians and them Chinamen. And them Russians."
                                            },
                                            {
                                                "example_id": "bd076b27-d373-452c-96ef-a3ddbc496ed1",
                                                "sense_id": "730b78cd-1837-3493-a06b-04e83933fc82",
                                                "text": "\"[…] Them two wild horses ain't fit to ride, and I been wonderin' how I was goin' to get you out of this place before them Spanish maybe circle back and finish the job.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
