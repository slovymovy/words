                                "target_senses": [
                                    {
                                        "sense_id": "14e698b5-0cc1-3a76-947c-4b2ede91ba58",
                                        "entry_id": "69826e5f-ccc6-3757-8834-c7c5961a2387",
                                        "glosses": [
                                            "een onzedelijke uiting of handeling"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "997596ac-4fe8-4695-a61d-5492dec825bb",
                                                "sense_id": "14e698b5-0cc1-3a76-947c-4b2ede91ba58",
                                                "text": "Zijn satirische kijk op de mensheid zou Dix later nog danig parten spelen. Twee keer kreeg hij een proces aan zijn broek voor obsceniteit. Hij kwam in beide gevallen goed weg, door de heilige te spelen en zich listig voor te stellen als aanklager van zedenverval. De nazi’s verklaarden zijn kunst nadien ‘ontaard’. Een aantal van zijn sleutelwerken is nog altijd vermist."
                                            },
                                            {
                                                "example_id": "c72b32d0-bd8a-4282-93f0-585d0287e133",
                                                "sense_id": "14e698b5-0cc1-3a76-947c-4b2ede91ba58",
                                                "text": "De feiten zouden tussen 1975 en 1978 hebben plaatsgevonden in het Newman Theological College in Edmonton, waar hij toen studeerde. Volgens CBC bekende Dejaeger twee aanklachten wegens grove obsceniteiten. Ook gaf hij toe een jongen en een meisje te hebben aangerand. Een gerechtelijke uitspraak wordt op 22 oktober verwacht."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "714d022e-9c11-41fc-ad0b-b30656c4df7e",
                        "source_entry_id": "b89fb53e-de65-3ae1-a481-b1294f08d26c",
                        "source_sense_id": "ad9ac499-a973-30e5-abaa-7a795ce62fdc",
                        "source_sense_description": "promiscuity",
                        "target_lang_word": "Anzüglichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anzüglichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef7d70b0-d962-38e9-8e0e-d2e3ea5f9140",
                                        "entry_id": "dae67207-0066-3aa3-80e5-ee7fda0450a6",
                                        "glosses": [
                                            "Äußerung/Verhalten anrüchiger/anstößiger Art"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a287778c-0258-4484-9bd7-960e57103477",
                                                "sense_id": "ef7d70b0-d962-38e9-8e0e-d2e3ea5f9140",
                                                "text": "„Die Spottlust hat über die Begebenheiten neben und auf der psychoanalytischen Couch soviele Anzüglichkeiten produziert wie ehedem über die Beichtstühle."
                                            },
                                            {
                                                "example_id": "aa35ed31-ae82-4a1d-a292-d9301caf6512",
                                                "sense_id": "ef7d70b0-d962-38e9-8e0e-d2e3ea5f9140",
                                                "text": "„Heute ist dergleichen nur noch Anlass für kleine Anzüglichkeiten, die Benn gerne in Briefe an Tilly einflicht“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8a9a906-850f-448d-a718-a1d276aa86e6",
                        "source_entry_id": "b89fb53e-de65-3ae1-a481-b1294f08d26c",
                        "source_sense_id": "ad9ac499-a973-30e5-abaa-7a795ce62fdc",
