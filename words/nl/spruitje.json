                    "frequency": "Middle",
                    "semantic_group_id": "groente",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Veel jonge kinderen houden niet van de bittere smaak van een <w>spruitje</w>.",
                            "target_lang_translations": {
                                "en": "Many young children do not like the bitter taste of a <w>Brussels sprout</w>."
                            }
                        },
                        {
                            "text": "In de winter eten we vaak gekookte aardappelen met een <w>spruitje</w> en vlees.",
                            "target_lang_translations": {
                                "en": "In the winter, we often eat boiled potatoes with a <w>Brussels sprout</w> and meat."
                            }
                        }
                    ],
                    "synonyms": [
                        "spruitkool"
                    ],
                    "common_phrases": [
                        "gekookte spruitjes"
                    ],
                    "target_lang_definitions": {
                        "en": "Small, round green vegetable that grows as an axillary bud on the Brussels sprout plant."
                    },
                    "translations": {
