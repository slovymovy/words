                "senses": [
                    {
                        "sense_id": "4a5d01dc-1ff9-3367-8eba-3fae27d24566",
                        "entry_id": "1b0c229c-cf64-3de9-8dca-0bc69a370783",
                        "glosses": [
                            "politische Wahl, die über die Zukunft einer Regierung, Partei oder Ähnliches wesentlichen Einfluss hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "516670f4-9035-44b2-9fa6-706fd9b83c65",
                                "sense_id": "4a5d01dc-1ff9-3367-8eba-3fae27d24566",
                                "text": "„2024 wird insbesondere für die Republikanische Partei zur Schicksalswahl, da eine erneute Niederlage dem Verschwinden Donald Trumps und seiner Bewegung von der politischen Bühne gleichkäme.“"
                            },
                            {
                                "example_id": "c333eed8-9a5a-4c6b-832e-b22e4a97012e",
                                "sense_id": "4a5d01dc-1ff9-3367-8eba-3fae27d24566",
                                "text": "„Riemanns Stimmenanteil wuchs von Woche zu Woche, lag jetzt, einen guten Monat vor der Schicksalswahl, bei fast zehn Prozent.“"
                            },
                            {
                                "example_id": "53fcea1c-21b0-4bd3-8a90-9d008e1870e4",
                                "sense_id": "4a5d01dc-1ff9-3367-8eba-3fae27d24566",
                                "text": "„Auch bei dieser Schicksalswahl hatte er kurz vor 18 Uhr eine Flasche Rotwein geöffnet, das erste Programm des öffentlich-rechtlichen Rundfunks angeschaltet und es sich in seinem Sessel bequem gemacht.“"
                            },
                            {
                                "example_id": "4c9e0cb8-920d-4b40-a34d-db421ab56103",
                                "sense_id": "4a5d01dc-1ff9-3367-8eba-3fae27d24566",
                                "text": "„Die Demokratie der Wähler (people) lebt, weil in dieser Schicksalswahl die Wahlbeteiligung so hoch ist wie noch nie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
