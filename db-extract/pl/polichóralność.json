                    {
                        "translation_id": "9fa907fa-dffd-490f-9ad2-f07b46976f37",
                        "source_entry_id": "63b69546-5dea-3fe6-8962-d9d6c29e016e",
                        "source_sense_id": "a90b81a8-4886-3178-9400-75d6137e25d5",
                        "target_lang_word": "vénitien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vénitien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9528d428-4246-3954-a017-1d9f9801bac5",
                                        "entry_id": "185796dd-cd9a-359a-ba08-07ed61477b18",
                                        "glosses": [
                                            "Qui vient de Venise, relatif à Venise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f1a496a-6735-4504-b4bb-5dc7659428aa",
                                                "sense_id": "9528d428-4246-3954-a017-1d9f9801bac5",
                                                "text": "La république vénitienne."
                                            },
                                            {
                                                "example_id": "e3606537-04d1-4ebe-a77e-b69b901ecbf8",
                                                "sense_id": "9528d428-4246-3954-a017-1d9f9801bac5",
                                                "text": "Ainsi, ce paresseux génie a fondu la couleur vénitienne, la composition florentine, le style raphaëlesque dans les rares tableaux qu’il a daigné peindre et dont les cartons étaient dessinés, dit-on, par Michel-Ange."
                                            },
                                            {
                                                "example_id": "32dd4119-78ac-44e9-a412-94d5206992d6",
                                                "sense_id": "9528d428-4246-3954-a017-1d9f9801bac5",
                                                "text": "C'était une maison de rendez-vous berlinoise : canapés et fauteuils profonds, piano à queue, tableaux de maîtres, riches tapisseries, glaces et lustres vénitiens. Dans ce somptueux décor, un phonographe distillait de la musique classique, parfois légère."
                                            },
                                            {
                                                "example_id": "3c362837-8ea2-4acf-bfdb-c835358b2a63",
                                                "sense_id": "9528d428-4246-3954-a017-1d9f9801bac5",
                                                "text": "Du lit nuptial au bobinard, il n’y eut alors qu’un pas que les péripatéticiennes vénitiennes familières du Ponte delle Tette, le pont des Tétons, eurent vite fait de franchir, boulottant du tiramisu pour se donner du nerf à l’ouvrage, tout comme leurs clients, soucieux de « tirer vers le haut » ce qui tendait à fléchir…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8156fc5-c5a0-3b6c-b64d-adb96ab24206",
                                        "entry_id": "185796dd-cd9a-359a-ba08-07ed61477b18",
                                        "glosses": [
                                            "Se dit d’un store constitué de lamelles amovibles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6dec4b2-9d4e-4195-8aed-f39827c6f5ef",
                                                "sense_id": "a8156fc5-c5a0-3b6c-b64d-adb96ab24206",
                                                "text": "Un store vénitien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcb18feb-2588-38e9-840c-2d8eacf81563",
                                        "entry_id": "185796dd-cd9a-359a-ba08-07ed61477b18",
                                        "glosses": [
                                            "En parlant des cheveux, couleur blonde tirant sur le roux. #E7A854"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "535cbc37-ab4e-4036-bd81-4d58bf0d920d",
                                                "sense_id": "dcb18feb-2588-38e9-840c-2d8eacf81563",
                                                "text": "Le roux vénitien de ses cheveux brilla d'un reflet de feu."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vénitien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e8d40d8e-81ed-384f-b02c-350b9ea87d38",
                                        "entry_id": "414422ec-1ee8-3bb7-a4f6-73bc7fc5e105",
                                        "glosses": [
                                            "Langue romane parlée en Vénétie, dans les provinces de Trente, Trieste et Gorizia, en Lombardie orientale, en Slovénie à Nova Gorica, en Croatie dans l’Istrie et la Dalmatie, au Mexique à Chipilo (en régression) et au Brésil dans les états de Rio Grande do Sul et Santa Catarina."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d17faee-b248-4fe8-a594-abf06ae47640",
                                                "sense_id": "e8d40d8e-81ed-384f-b02c-350b9ea87d38",
                                                "text": "Les pêcheurs qui passent en barque sous leur fenêtre crient en vénitien, différent de celui des paysans de Zianigo, mais elle reconnaît à leur ton rude les disputes ou les saluts, les voix des hommes qui se retrouvent."
                                            },
                                            {
                                                "example_id": "f3246c8d-38dc-4402-af06-eea5979733be",
                                                "sense_id": "e8d40d8e-81ed-384f-b02c-350b9ea87d38",
                                                "text": "Parlez-vous vénitien ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
