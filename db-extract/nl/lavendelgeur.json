                    {
                        "sense_id": "40d169b2-61af-3b5f-baa7-d14ddf11c992",
                        "entry_id": "275a5c46-ff71-3f8f-a388-500b53969d72",
                        "glosses": [
                            "de geur die bloeiende lavendel verspreidt of een geur die daarop lijkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd2ddbcd-1cf4-43e2-bb40-29d45c0a6225",
                                "sense_id": "40d169b2-61af-3b5f-baa7-d14ddf11c992",
                                "text": "Onderzoekers lieten proefpersonen een spel spelen waarbij zij geld konden verdienen door eerst geld aan anderen te geven. Proefpersonen die tijdens het spel werden blootgesteld aan een lavendelgeur bleken een stuk vrijgeviger dan proefpersonen uit een controlegroep zonder geur en een groep die pepermunt rook."
                            },
                            {
                                "example_id": "99db7615-4535-44b0-afe1-bd9ed6f2f0ba",
                                "sense_id": "40d169b2-61af-3b5f-baa7-d14ddf11c992",
                                "text": "Zo vermijd je snackaanvallen: Eet geregeld pompoenpitten, bananen, spinazie, havermout, zalm of amandelen. Pepermunt helpt bij darmklachten maar ook bij snackaanvallen. Doe wat water en een druppel pepermuntolie in een diffuser en verspreid de geur in je huis. Of drink verse muntthee. Doe een yogasessie, lees een boek of neem een bad met lavendelgeur."
                            }
                        ]
                    }
