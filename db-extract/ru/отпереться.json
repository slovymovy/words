                "senses": [
                    {
                        "sense_id": "aa9e0324-12b6-3ffc-b4a1-b56aa92dfe60",
                        "entry_id": "adefcb80-f94b-358f-8231-c774c68c21ed",
                        "glosses": [
                            "разг. находясь в закрытом помещении, отпереть его"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eeee4301-115d-447c-b6f2-c93c7c8b4da8",
                                "sense_id": "aa9e0324-12b6-3ffc-b4a1-b56aa92dfe60",
                                "text": "Сейчас отопрись, или я велю выломать дверь!"
                            }
                        ]
                    },
                    {
                        "sense_id": "1a7edd6f-761f-3688-bba3-c70302ccc74f",
                        "entry_id": "adefcb80-f94b-358f-8231-c774c68c21ed",
