                        ],
                        "form": "die Kommilitonen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a73a86b3-68a5-3810-84d2-071570f121cc",
                        "entry_id": "872d0fa3-f9fc-3571-aa99-8e0fa62ea0f2",
                        "glosses": [
                            "Person, mit der man gemeinsam an einer Hochschule studiert (hat)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf2de264-5f70-433b-8c39-d6d32bf4c665",
                                "sense_id": "a73a86b3-68a5-3810-84d2-071570f121cc",
                                "text": "„Es war normal, dass ich mich ihnen anschloss, da wir keinen Zugang zu den reichen Studenten hatten, der Mehrzahl unserer Kommilitonen.“"
                            },
                            {
                                "example_id": "010dab62-ddd3-4215-a1eb-21817095890e",
                                "sense_id": "a73a86b3-68a5-3810-84d2-071570f121cc",
                                "text": "„All dies, erklärte mir der Kommilitone geduldig, sei en detail im Mietvertrag festgelegt, sogar der Wochentag der Ausführung: und zwar der Samstag.“"
                            },
                            {
                                "example_id": "4aaede38-e7b3-41dd-911c-d275b3715c5c",
                                "sense_id": "a73a86b3-68a5-3810-84d2-071570f121cc",
                                "text": "„Nur Csoma hielt das Versprechen - er war schließlich zwanzig Jahre älter als die beiden Kommilitonen, mit denen er es abgelegt hatte.“"
                            },
                            {
                                "example_id": "5f088cdc-77e1-4010-b38a-da56724a91c5",
                                "sense_id": "a73a86b3-68a5-3810-84d2-071570f121cc",
                                "text": "„Sein Mobiltelefon klingelte, und ein Kommilitone, mit dem Tom gemeinsam promoviert hatte, war am anderen Ende.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
