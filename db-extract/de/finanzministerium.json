                "senses": [
                    {
                        "sense_id": "f1368a80-be61-3ecf-8ad9-f287ba5bfb6a",
                        "entry_id": "649aaad3-4709-3d38-ad59-6d8aefda0ab8",
                        "glosses": [
                            "Ministerium, das für die Finanzen eines Staates zuständig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17d0fcee-ae92-4c0f-9f6e-b226ba7fb657",
                                "sense_id": "f1368a80-be61-3ecf-8ad9-f287ba5bfb6a",
                                "text": "Die Goldreserven eines Landes befinden sich meist im Verantwortungsbereich einer Zentralbank oder eines Finanzministeriums."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "642b5650-6002-47cf-a1c5-3cb8fea39ecc",
                        "source_entry_id": "649aaad3-4709-3d38-ad59-6d8aefda0ab8",
                        "source_sense_id": "f1368a80-be61-3ecf-8ad9-f287ba5bfb6a",
                        "source_sense_description": "Politik: Ministerium, das für die Finanzen eines Staates zuständig ist",
                        "target_lang_word": "Ministry of Finance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b4991419-33ad-4c6a-b8d7-c3e23a229246",
                        "source_entry_id": "649aaad3-4709-3d38-ad59-6d8aefda0ab8",
                        "source_sense_id": "f1368a80-be61-3ecf-8ad9-f287ba5bfb6a",
                        "source_sense_description": "Politik: Ministerium, das für die Finanzen eines Staates zuständig ist",
                        "target_lang_word": "Treasury",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Treasury",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95e13160-367e-3791-bde7-fed90b609022",
                                        "entry_id": "df49db86-9b72-3d12-bf33-50ee9edcde3b",
                                        "glosses": [
                                            "Any specific instance of a government department responsible for the collection, management, and expenditure of public revenue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b9bdb56-38b5-43c6-b7e7-d51428221035",
                                                "sense_id": "95e13160-367e-3791-bde7-fed90b609022",
                                                "text": "as reported to the Treasury and to Parliament"
                                            },
                                            {
                                                "example_id": "74cd0877-2665-4397-91f1-a01525fe6ca7",
                                                "sense_id": "95e13160-367e-3791-bde7-fed90b609022",
                                                "text": "aspects of customs work that were formerly under Treasury and are nowadays under Homeland Security"
                                            },
                                            {
                                                "example_id": "9a57bc26-92d4-40d8-9c46-9cb3f9495b4d",
                                                "sense_id": "95e13160-367e-3791-bde7-fed90b609022",
                                                "text": "The December 11 Telegraph story, which accused the Treasury of blocking plans for £30 billion worth of electrification across the rail network [...], has rung alarm bells over who is the real source of power concerning rail's development - the Department of Transport or the Treasury?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Treasury",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25b4fd8e-b08c-373e-8bc5-840cd726eaca",
                                        "entry_id": "24ff5bd0-f333-3dc6-b8a7-8933e49446cf",
                                        "glosses": [
                                            "A bond (security) issued by such a department, in particular the United States Department of the Treasury."
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbb12578-8c2f-4a99-aecc-6cee32405e5f",
                                                "sense_id": "25b4fd8e-b08c-373e-8bc5-840cd726eaca",
                                                "text": "As the Fed moves to adjust for faster growth, shorter-maturity Treasurys will be more vulnerable to further price declines while the risk of a sudden spike in inflation will diminish."
                                            },
                                            {
                                                "example_id": "cc7c11e8-690e-4d70-afb9-ce958931c3f5",
                                                "sense_id": "25b4fd8e-b08c-373e-8bc5-840cd726eaca",
                                                "text": "“The prospects for long-term Treasuries are looking very good right now,” said Michael Contopoulos, director of fixed-income strategy at Richard Bernstein Advisors."
                                            },
                                            {
                                                "example_id": "3a700fdd-561b-4dbd-b59a-3c6317f77890",
                                                "sense_id": "25b4fd8e-b08c-373e-8bc5-840cd726eaca",
                                                "text": "The yield on the 10-year Treasury, which underpins corporate and consumer borrowing and is arguably the most important interest rate in the world, rose roughly 0.1 percentage points on Friday."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
