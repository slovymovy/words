                                    },
                                    {
                                        "sense_id": "e428a7e0-aeac-3948-aa2e-8f4e908cbcb2",
                                        "entry_id": "397a911b-50d9-3f7f-ad36-451f398a1baa",
                                        "glosses": [
                                            "Qualifie toute substance chimique et spécialement d’un stéréo-isomère faisant tourner vers la gauche le plan de polarisation de la lumière."
                                        ],
                                        "tags": [
                                            "Stéréochimie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c9ed509-253f-46ce-8dac-3b86e48da0e1",
                                                "sense_id": "e428a7e0-aeac-3948-aa2e-8f4e908cbcb2",
                                                "text": "Il a trouvé aussi qu’il existe deux espèces différentes de quartz, dont l’une dévie le plan de polarisation à droite et l’autre le tourne dans le sens opposé, et il nomme la première espèce quartz dextrogyre et la seconde quartz lévogyre."
                                            },
                                            {
                                                "example_id": "4e15e7f9-f5eb-4ce3-8a6d-0328722e33ae",
                                                "sense_id": "e428a7e0-aeac-3948-aa2e-8f4e908cbcb2",
                                                "text": "Isolée pour la première fois en 1833, l’atropine est un mélange racémique, optiquement inactif (mélange d’isomères lévogyre et dextrogyre), alors que l’isomère lévogyre est l’hyosciamine."
                                            }
                                        ]
                                    }
                                ]
                            }
