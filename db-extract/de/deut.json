                                        "glosses": [
                                            "A small amount; a bit, a jot."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffebfe51-2cc9-48af-bc20-8f267382e5d5",
                                                "sense_id": "95a00b7b-8459-3e00-ba51-f88e6f94cf47",
                                                "text": "[…] when they will not giue a doit to relieue a lame Begger, they will lay out ten to ſee a dead Indian: […]"
                                            },
                                            {
                                                "example_id": "3ac2e419-40ba-4a6e-ac38-1f2fa0f131fd",
                                                "sense_id": "95a00b7b-8459-3e00-ba51-f88e6f94cf47",
                                                "text": "“Speak out, ye Saxon dogs — what bid ye for your worthless lives? — How say you, you of Rotherwood?” “Not a doit I,” answered poor Wamba."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cb629c7-b32d-3967-ba79-9b9490d6d774",
