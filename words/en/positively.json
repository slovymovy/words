                                "ru": "Публика отреагировала на новую песню группы <w>положительно</w>.",
                                "zh": "观众对乐队的新歌反响<w>积极</w>。",
                                "es": "El público respondió <w>positivamente</w> a la nueva canción del grupo.",
                                "tr": "Dinleyiciler grubun yeni şarkısına <w>olumlu</w> tepki verdi.",
                                "de": "Das Publikum reagierte <w>positiv</w> auf das neue Lied der Band.",
                                "nl": "Het publiek reageerde <w>positief</w> op het nieuwe nummer van de band.",
                                "pl": "Publiczność zareagowała <w>pozytywnie</w> na nową piosenkę zespołu.",
                                "fr": "Le public a réagi <w>favorablement</w> à la nouvelle chanson du groupe.",
                                "it": "Il pubblico ha reagito <w>positivamente</w> alla nuova canzone della band.",
                                "cs": "Publikum na novou píseň kapely reagovalo <w>kladně</w>."
                            }
                        }
