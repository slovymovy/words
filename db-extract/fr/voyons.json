        "fr-extract.jsonl": [
            {
                "entry_id": "f2e28c74-8822-3b2a-bab8-b63210c17ff1",
                "word": "voyons",
                "pos": "intj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ec15bba3-0eb1-3fd6-bb9e-a7ac890e7a27",
                        "entry_id": "f2e28c74-8822-3b2a-bab8-b63210c17ff1",
                        "glosses": [
                            "Interjection exprimant l'impatience, l'indignation ou l'encouragement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee8b4616-6a85-4470-ae9a-683f31efaa84",
                                "sense_id": "ec15bba3-0eb1-3fd6-bb9e-a7ac890e7a27",
                                "text": "Voyons ! Je n'arrive pas à enfiler mon soulier !"
                            },
                            {
                                "example_id": "b9bae98d-5690-4fc3-970f-0714228995c6",
                                "sense_id": "ec15bba3-0eb1-3fd6-bb9e-a7ac890e7a27",
                                "text": "Voyons ! entre nous, quand on voit un Minard, une cruche dorée, aller complimenter le roi, se pavaner aux Tuileries ; un Popinot en train de devenir ministre… ; et vous, un homme rompu au travail administratif, qui a vu dix gouvernements, repiquant ses balsamines…"
                            },
                            {
                                "example_id": "1a844d2c-a290-4d65-af7d-0af7f5a4b3c7",
                                "sense_id": "ec15bba3-0eb1-3fd6-bb9e-a7ac890e7a27",
                                "text": "Un gloria, une rincette, ça ne se refuse jamais, voyons !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "433112d7-0d3d-4787-899a-217f71e36862",
                        "source_entry_id": "f2e28c74-8822-3b2a-bab8-b63210c17ff1",
                        "source_sense_id": "ec15bba3-0eb1-3fd6-bb9e-a7ac890e7a27",
                        "target_lang_word": "come on",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "come on",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3749443b-2fb3-3a38-9aea-cdbcc0cd3649",
                                        "entry_id": "722a0a37-0a2b-302e-9243-e5941c026d78",
                                        "glosses": [
                                            "To encounter, discover; to come upon."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0822be8a-b7d0-49bc-b358-de75e7697322",
                                                "sense_id": "3749443b-2fb3-3a38-9aea-cdbcc0cd3649",
                                                "text": "Turning the corner, I came on Julia sitting by the riverbank."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc8a997c-f7b6-3102-920e-1e7b770c282b",
                                        "entry_id": "722a0a37-0a2b-302e-9243-e5941c026d78",
                                        "glosses": [
                                            "To appear on a stage or in a performance."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "415fab55-fce2-4b4d-962d-5dfdbba704cb",
                                                "sense_id": "dc8a997c-f7b6-3102-920e-1e7b770c282b",
                                                "text": "I think he's coming on too late after my line."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1342d2ca-e935-39fa-99f9-96c2819a8029",
                                        "entry_id": "722a0a37-0a2b-302e-9243-e5941c026d78",
                                        "glosses": [
                                            "To be broadcast (through a device), or (of a broadcast) to begin playing."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2eb75ff1-8927-44ad-85f5-da6d18fd9f88",
                                                "sense_id": "1342d2ca-e935-39fa-99f9-96c2819a8029",
                                                "text": "I was going to turn off the TV, but my favorite show came on."
                                            },
                                            {
                                                "example_id": "442d0706-db01-41de-9f08-41c0b9a5c20c",
                                                "sense_id": "1342d2ca-e935-39fa-99f9-96c2819a8029",
                                                "text": "A salsa song came on the radio."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21d5a3c7-9a64-3c47-87f3-02ea4dc0f264",
                                        "entry_id": "722a0a37-0a2b-302e-9243-e5941c026d78",
                                        "glosses": [
                                            "To progress, to develop; to come along."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e97008f1-7d1b-47f8-a96d-2cad721f3b45",
                                                "sense_id": "21d5a3c7-9a64-3c47-87f3-02ea4dc0f264",
                                                "text": "The new garden is coming on nicely."
                                            },
                                            {
                                                "example_id": "fb3a8607-2933-4a57-8069-4a8a8bdf3233",
                                                "sense_id": "21d5a3c7-9a64-3c47-87f3-02ea4dc0f264",
                                                "text": "But she looked a lady, Paul declared, as much as Mrs. Major Moreton, and far, far nicer. The family was coming on. Only Morel remained unchanged, or rather, lapsed slowly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e571b514-3212-3224-9772-87db4f72a85d",
                                        "entry_id": "722a0a37-0a2b-302e-9243-e5941c026d78",
                                        "glosses": [
                                            "To activate; to turn on."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b187f04-4a97-4211-bbdc-f9af7a01349a",
                                                "sense_id": "e571b514-3212-3224-9772-87db4f72a85d",
                                                "text": "The light came on as soon as I flicked the switch."
                                            },
                                            {
                                                "example_id": "f9e49dba-17a9-4c8b-8009-b36fb97cc699",
                                                "sense_id": "e571b514-3212-3224-9772-87db4f72a85d",
                                                "text": "She pressed the power button and waited for the screen to come on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b33900b-e741-37ca-8b38-883d7eba4577",
                                        "entry_id": "722a0a37-0a2b-302e-9243-e5941c026d78",
                                        "glosses": [
                                            "To show sexual or relational interest through words or sometimes actions."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43b49308-391f-4129-a207-0768b4e5f54a",
                                                "sense_id": "4b33900b-e741-37ca-8b38-883d7eba4577",
                                                "text": "She started coming on to me as soon as my wife left the room."
                                            },
                                            {
                                                "example_id": "8ea7acc3-a90a-4cfc-a097-27354e718b13",
                                                "sense_id": "4b33900b-e741-37ca-8b38-883d7eba4577",
                                                "text": "Wait a minute. Are you like coming on to me? Is this a pass? Because, I mean, if it is, sex is like totally out of the question."
                                            },
                                            {
                                                "example_id": "52fca293-aef6-4f20-b8d3-5bba21cc890d",
                                                "sense_id": "4b33900b-e741-37ca-8b38-883d7eba4577",
                                                "text": "And so you went with Neve / Oh yeah, and Neve was coming on"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cfc2c73-055d-3006-8f85-80eb8e9291e7",
                                        "entry_id": "722a0a37-0a2b-302e-9243-e5941c026d78",
                                        "glosses": [
                                            "To get one's period, start menstruating."
                                        ],
                                        "tags": [
                                            "UK",
                                            "colloquial",
                                            "idiomatic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0f7963b-1d9e-4889-a613-2aeada0d5e9c",
                                                "sense_id": "7cfc2c73-055d-3006-8f85-80eb8e9291e7",
                                                "text": "Overall, menstrual modernity in the form of a more efficient throwaway technology was seized on and celebrated, as was the opportunity to send your man off to the shop to get it if you came on suddenly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1960566-9d4d-3ca5-b9d7-3a4c0382a05c",
                                        "entry_id": "722a0a37-0a2b-302e-9243-e5941c026d78",
                                        "glosses": [
                                            "To enter the playing field."
                                        ],
                                        "tags": [
                                            "of a substitute"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe2f01b7-71b2-4812-853a-642277c52879",
                                                "sense_id": "f1960566-9d4d-3ca5-b9d7-3a4c0382a05c",
                                                "text": "Blackburn made their third and final substitution with 25 minutes remaining, with Brett Emerton coming on for Dunn as they looked for ways to stem the Newcastle tide."
                                            },
                                            {
                                                "example_id": "60ebae08-3431-448b-8bce-cee9923fb413",
                                                "sense_id": "f1960566-9d4d-3ca5-b9d7-3a4c0382a05c",
                                                "text": "One of few positives from a Burnley perspective was a first appearance of the season for forward Michael Obafemi, who came on with five minutes remaining after recovering from a long-term hamstring injury"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76ceaefd-9dc3-3d43-9675-cf27976cb6c9",
                                        "entry_id": "722a0a37-0a2b-302e-9243-e5941c026d78",
                                        "glosses": [
                                            "Elaboration of come (in the sense of move towards the speaker or other focus), emphasising motion or progress, or conveying a nuance of familiarity or encouragement."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14fcb1de-a512-48eb-ae10-296495ea8269",
                                                "sense_id": "76ceaefd-9dc3-3d43-9675-cf27976cb6c9",
                                                "text": "Don't just stand there on the doorstep. Come on in!"
                                            },
                                            {
                                                "example_id": "1bed16d3-47c1-455b-a2df-a7268341386a",
                                                "sense_id": "76ceaefd-9dc3-3d43-9675-cf27976cb6c9",
                                                "text": "Don't leave without coming on round to see the baby."
                                            },
                                            {
                                                "example_id": "9b93217b-a688-42a7-9308-0b97def53b30",
                                                "sense_id": "76ceaefd-9dc3-3d43-9675-cf27976cb6c9",
                                                "text": "You told me to come on over whenever I get the chance, and here I am!"
                                            },
                                            {
                                                "example_id": "d036c1f8-b9cb-4cad-b8f2-ca6402a84b80",
                                                "sense_id": "76ceaefd-9dc3-3d43-9675-cf27976cb6c9",
                                                "text": "Come on up to my place on the third floor."
                                            },
                                            {
                                                "example_id": "c96bc1ca-c325-49eb-848a-368bb319d185",
                                                "sense_id": "76ceaefd-9dc3-3d43-9675-cf27976cb6c9",
                                                "text": "Please come on home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dee46e3-8c87-3a57-a18b-069500401a0b",
                                        "entry_id": "722a0a37-0a2b-302e-9243-e5941c026d78",
                                        "glosses": [
                                            "To appear or seem to be a particular."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40973df9-509b-44e7-88f1-5cdc152a7943",
                                                "sense_id": "6dee46e3-8c87-3a57-a18b-069500401a0b",
                                                "text": "They came a trick on me."
                                            },
                                            {
                                                "example_id": "ea77e6ca-9958-46cd-a394-9a79498593e9",
                                                "sense_id": "6dee46e3-8c87-3a57-a18b-069500401a0b",
                                                "text": "He's coming on strong."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6286d59-2eca-3620-82be-0dca3d0f7981",
                                        "entry_id": "722a0a37-0a2b-302e-9243-e5941c026d78",
                                        "glosses": [
                                            "To begin to feel the effects of a drug; to start causing effects."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5555b180-2bd5-4265-8eb6-b3c13243eae7",
                                                "sense_id": "a6286d59-2eca-3620-82be-0dca3d0f7981",
                                                "text": "The coke came on me quickly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4540fa05-ff69-38b8-a76f-82e2060758bc",
                                        "entry_id": "722a0a37-0a2b-302e-9243-e5941c026d78",
                                        "glosses": [
                                            "To join a job, hobby or other practice."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c7cc7f6-5691-4a14-8ea4-13c6239e6365",
                                                "sense_id": "4540fa05-ff69-38b8-a76f-82e2060758bc",
                                                "text": "He came on at the same time as me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d1b4951-e9a2-39b3-9d3b-1d2e9560b1c2",
                                        "entry_id": "722a0a37-0a2b-302e-9243-e5941c026d78",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see come, on."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "come on",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b9abeec-1ec8-360d-bb38-5c0bfa898e17",
                                        "entry_id": "d4b74afb-04ff-3bc8-b0d4-08c121c0fee1",
                                        "glosses": [
                                            "Come along with me; join me in going."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1ae9a01-0b9e-4948-9a81-aa1f1da06d2e",
                                                "sense_id": "4b9abeec-1ec8-360d-bb38-5c0bfa898e17",
                                                "text": "I'll show you where the auditorium is. Come on!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "292e9b5d-64a5-38f9-a5ca-17427792b03a",
                                        "entry_id": "d4b74afb-04ff-3bc8-b0d4-08c121c0fee1",
                                        "glosses": [
                                            "Synonym of let's go, a cheer or expression of support, encouragement, &c."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccb29316-837a-4528-bcaa-2a7a4c6a2785",
                                                "sense_id": "292e9b5d-64a5-38f9-a5ca-17427792b03a",
                                                "text": "Come on, George! You can win!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00c2c587-119f-30e2-8392-e06c4328f441",
                                        "entry_id": "d4b74afb-04ff-3bc8-b0d4-08c121c0fee1",
                                        "glosses": [
                                            "An expression of disbelief."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eda86756-7804-476a-8530-576072ff7881",
                                                "sense_id": "00c2c587-119f-30e2-8392-e06c4328f441",
                                                "text": "Come on! You can't possibly expect me to believe that."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa5e8134-dfbe-3ca6-91dc-99a4814f6ec3",
                                        "entry_id": "d4b74afb-04ff-3bc8-b0d4-08c121c0fee1",
                                        "glosses": [
                                            "An expression of frustration, exasperation, or impatience; hurry up."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94eab12d-6552-4159-9791-f84cf603a5a8",
                                                "sense_id": "aa5e8134-dfbe-3ca6-91dc-99a4814f6ec3",
                                                "text": "Aw, come on! Get on with it!"
                                            },
                                            {
                                                "example_id": "e8d5e901-2953-416d-8161-6f472bcd8dd0",
                                                "sense_id": "aa5e8134-dfbe-3ca6-91dc-99a4814f6ec3",
                                                "text": "Come on, we don't want to miss the train!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76f91cca-1288-3377-8160-0442200ff182",
                                        "entry_id": "d4b74afb-04ff-3bc8-b0d4-08c121c0fee1",
                                        "glosses": [
                                            "An expression of defiance or as a challenge; approach; come at me."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e24516dc-8a29-4d9b-b602-ec955d016748",
                                                "sense_id": "76f91cca-1288-3377-8160-0442200ff182",
                                                "text": "BOX: […] Hark ye, sir—can you fight?\nCOX: No, sir.\nBOX: No? Then come on—"
                                            },
                                            {
                                                "example_id": "848e5c8e-cf6f-48f3-8fdf-d37cedcf8193",
                                                "sense_id": "76f91cca-1288-3377-8160-0442200ff182",
                                                "text": "Come on! I'm not afraid of you."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "b80193ff-e5cf-3c29-8425-c392ff9d8d7a",
                "word": "voyons",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "10b60420-095d-4249-b9bd-39c9762f8bd5",
                        "entry_id": "b80193ff-e5cf-3c29-8425-c392ff9d8d7a",
                        "tags": [
                            "indicative",
                            "present"
                        ],
                        "form": "nous voyons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "535330bf-c7a0-34fe-927b-092099d17f28",
                        "entry_id": "b80193ff-e5cf-3c29-8425-c392ff9d8d7a",
                        "glosses": [
                            "Première personne du pluriel de l’indicatif présent de voir."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "c786a06c-15cb-4854-90a5-a2a26e628a97",
                                "sense_id": "535330bf-c7a0-34fe-927b-092099d17f28",
                                "text": "Lorsqu’en 1836 on a démoli sous le faubourg Saint-Honoré, pour le reconstruire, le vieil égout en pierre où nous voyons en ce moment Jean Valjean engagé, le sable mouvant, qui est le sous-sol des Champs-Élysées jusqu’à la Seine, fit obstacle au point que l’opération dura près de six mois, au grand récri des riverains, surtout des riverains à hôtels et à carrosses."
                            }
                        ]
                    },
                    {
                        "sense_id": "c0efc68f-7eac-3d65-ad84-18d88dcc1b9a",
                        "entry_id": "b80193ff-e5cf-3c29-8425-c392ff9d8d7a",
                        "glosses": [
                            "Première personne du pluriel de l’impératif présent de voir."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "a8d126f3-2082-4595-8e55-5f232ce4fa9c",
                                "sense_id": "c0efc68f-7eac-3d65-ad84-18d88dcc1b9a",
                                "text": "Voilà pourtant les conséquences des innovations, ou des rénovations (car déjà à la fin du siècle dernier on voyait fréquemment les vers se mettre aux opéras-comiques), c’est l’exemple de M. Sauvage qui m’a mis la rime au corps. Voyons donc si je ne parviendrai pas à me désenrimer."
                            }
                        ]
                    }
                ],
