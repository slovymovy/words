                            {
                                "target_word": "eau de source",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "29bd5c1d-6eac-3c87-8c21-d4560cf55652",
                                        "entry_id": "3358d391-8b69-38b8-ab04-b02d5ffadc1f",
                                        "glosses": [
                                            "Eau tirée d’une source, par opposition (autrefois) à l’eau du puits, souvent fétide ou (aujourd’hui) à l’eau du robinet ou à l’eau minérale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a32d09cc-9582-48e5-a57a-bd74165ee678",
                                                "sense_id": "29bd5c1d-6eac-3c87-8c21-d4560cf55652",
                                                "text": "Il faut noter que, lors de la dernière décennie, la consommation de l’eau de source ou de l’eau minérale en bouteille a beaucoup progressé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8f4149e-7831-3b22-855b-559b40950b77",
                                        "entry_id": "3358d391-8b69-38b8-ab04-b02d5ffadc1f",
                                        "glosses": [
                                            "Liquide clair qui brille comme une eau de source."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46647689-6576-46ea-a3bb-e0685b87c150",
                                                "sense_id": "f8f4149e-7831-3b22-855b-559b40950b77",
                                                "text": "L’ancêtre, l’oubliée, grande, noueuse, effrayante, restait immobile, avec ses yeux qui vivaient seuls, ses clairs yeux d’eau de source, dans son mince visage desséché."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3feb71e4-d917-4dfd-8f57-2702e9413433",
                        "source_entry_id": "52f1fe07-e52c-35a1-9042-7557b278daed",
                        "source_sense_description": "water originating from a spring",
                        "target_lang_word": "Quellwasser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Quellwasser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ec486460-8ac0-3a8e-ae78-d72d2a1add07",
                                        "entry_id": "6750692f-7b50-324e-9bae-d41a4c4ff66c",
                                        "glosses": [
                                            "Wasser, das aus einer Quelle austritt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d92f6731-baf7-42a1-87c4-acccdfcb839c",
                                                "sense_id": "ec486460-8ac0-3a8e-ae78-d72d2a1add07",
                                                "text": "Quellwasser ist oft besonders rein."
                                            },
                                            {
                                                "example_id": "5d6d87f2-601e-4052-a5b5-1ef51e14aca6",
                                                "sense_id": "ec486460-8ac0-3a8e-ae78-d72d2a1add07",
                                                "text": "„Ich vermisse das frische Quellwasser, das direkt aus dem Wasserhahn kommt, und dass es in Island keine nervige Bürokratie gibt.“"
                                            },
                                            {
                                                "example_id": "a9e6fbb5-4292-4722-9faf-641b780bb53a",
                                                "sense_id": "ec486460-8ac0-3a8e-ae78-d72d2a1add07",
                                                "text": "„Von den Bergen läuft klares Quellwasser über die Fahrbahn, auf der Schlaglöcher den Asphalt teilweise fast vollständig verdrängt haben.“"
                                            },
                                            {
                                                "example_id": "0c99592c-b53a-4f48-b721-a8f00999be52",
                                                "sense_id": "ec486460-8ac0-3a8e-ae78-d72d2a1add07",
                                                "text": "„Ein sympathisch wirkender Mann begrüßte sie in verständlichem Deutsch und reichte ihnen einen Krug mit Quellwasser.“"
                                            },
                                            {
                                                "example_id": "968cb94c-a939-409d-a420-91d28d19047b",
                                                "sense_id": "ec486460-8ac0-3a8e-ae78-d72d2a1add07",
                                                "text": "„Sie belohnte die Willigen mit einer Kalebasse des deliziösen Feuerwassers, während sie sie dem Mürrischen oder Widerspenstigen mit demselben schlauen Lächeln mit reinem Quellwasser füllte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
