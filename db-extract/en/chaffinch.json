                                "target_senses": [
                                    {
                                        "sense_id": "12e0d8a0-0406-31c8-bcbd-0efe0b885537",
                                        "entry_id": "3166a416-5c48-3fc6-895a-019e8954535e",
                                        "glosses": [
                                            "Espèce de petit oiseau passereau granivore, au bec massif conique, et chanteur dont le chant est agréable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33061742-7423-43cb-b4bc-925face2a7eb",
                                                "sense_id": "12e0d8a0-0406-31c8-bcbd-0efe0b885537",
                                                "text": "Cambrinus acheta alors un pinson aveugle, qu’à la mode des gens du pays wallon, il emporta partout avec lui."
                                            },
                                            {
                                                "example_id": "6e87d85a-53ce-4b52-ad92-a1f5aae5ed24",
                                                "sense_id": "12e0d8a0-0406-31c8-bcbd-0efe0b885537",
                                                "text": "Moment délicieux ! Les arbres s’éveillent au chant des pinsons, les prés s’étirent plus verdissants ; […]."
                                            },
                                            {
                                                "example_id": "60e2e478-7344-4743-b034-0decb0a048f4",
                                                "sense_id": "12e0d8a0-0406-31c8-bcbd-0efe0b885537",
                                                "text": "Il me rappelle les pinsons que je prenais, étant gosse, les jours de neige, pour les boucler dans une cage en fil de fer… Un de ces matins, ils le trouveront raide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52f4284a-4eec-4017-a617-328a1a681ef3",
                        "source_entry_id": "b6eb0bae-2601-3cfc-b343-b96fed5ec230",
                        "source_sense_id": "03c64450-8f4b-3cac-8b4e-f54d1b10c0ec",
                        "source_sense_description": "bird",
                        "target_lang_word": "pinson des arbres",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pinson des arbres",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "054042f9-ea68-3c83-8474-25b9db555126",
                                        "entry_id": "d6247d8a-0741-3af6-b44e-8a5fb1e96c57",
                                        "glosses": [
                                            "Espèce de petit oiseau passereau chanteur d’Eurasie et d’Afrique du Nord, pinson qui a deux barres blanches sur les ailes, et dont le mâle a la calotte et la nuque bleu gris et les côtés de la tête rougeâtres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48317b5f-8624-48c2-84ea-1fa2d261ae43",
                                                "sense_id": "054042f9-ea68-3c83-8474-25b9db555126",
                                                "text": "Le pinson des arbres (Fringilla coelebs), par exemple, installe son nid dans des habitats très divers et varie ses habitudes alimentaires selon le saison."
                                            },
                                            {
                                                "example_id": "323177dc-c9a2-4d12-8290-05c4845626b0",
                                                "sense_id": "054042f9-ea68-3c83-8474-25b9db555126",
                                                "text": "Faune : serin cini, pic vert, pigeon ramier, moineau domestique, rouge-gorge, fauvette à tête noire, martinet noir, pinson des arbres, tourterelle turque, merle noir, rougequeue noir, rougequeue à front blanc, abeille domestique"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41a1c823-b008-4f4d-8d32-981bec7bdad5",
                        "source_entry_id": "b6eb0bae-2601-3cfc-b343-b96fed5ec230",
