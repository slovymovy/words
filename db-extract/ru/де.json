                "senses": [
                    {
                        "sense_id": "f66660ef-db06-3c61-a92f-ffbe51741ce6",
                        "entry_id": "1435556a-95d8-3224-a69d-03afb30c2188",
                        "glosses": [
                            "says (used informally to mark reported speech)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "eeba71c3-b44e-486a-8715-88a0b1c941a2",
                                "sense_id": "f66660ef-db06-3c61-a92f-ffbe51741ce6",
                                "text": "Я-де сам винова́т",
                                "translation": "I say it's my own fault.",
                                "english": "I say it's my own fault."
                            },
                            {
                                "example_id": "741cf520-7298-4e97-b64b-7e0103196e30",
                                "sense_id": "f66660ef-db06-3c61-a92f-ffbe51741ce6",
                                "text": "Она́-де не зна́ла.",
                                "translation": "She says she didn’t know.",
                                "english": "She says she didn’t know."
                            },
                            {
                                "example_id": "13cfaebf-8c1c-45ac-9e57-860977e3a837",
                                "sense_id": "f66660ef-db06-3c61-a92f-ffbe51741ce6",
                                "text": "И да не смущаетъ себя́ дворяни́нъ-помѣщикъ мыслiю, что е́сли онъ оди́нъ себѣ скажетъ все э́ти здравыя мы́сли – толку не будетъ, а что-де надо надо многимъ собра́ться и э́ти мы́сли вы́сказать общимъ собранiемъ.",
                                "translation": "The noble landlord shouldn't confuse himself by the thought that would he tell all those sensible thoughts by himself it won't make any sense but many should gather and tell all those thoughts by full gathering.",
                                "english": "The noble landlord shouldn't confuse himself by the thought that would he tell all those sensible thoughts by himself it won't make any sense but many should gather and tell all those thoughts by full gathering."
                            }
                        ]
                    }
                ],
