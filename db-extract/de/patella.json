                "senses": [
                    {
                        "sense_id": "0b5e9a8d-1e65-31a7-90eb-f192bb157ad9",
                        "entry_id": "f74cf3f7-5c55-3d5c-b89f-345b904e90a8",
                        "glosses": [
                            "Knochenscheibe, welche die Gelenkhöcker des Kniegelenks abdeckt und schützt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "278a814b-da7a-484c-8dc0-4fe0e2eb1fbc",
                                "sense_id": "0b5e9a8d-1e65-31a7-90eb-f192bb157ad9",
                                "text": "Bei der Standardaufnahme des Kniegelenks im sagittalen Strahlengang projiziert sich die Patella auf das distale Femur."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84883f3a-f416-4664-a97e-123a19d07a28",
                        "source_entry_id": "f74cf3f7-5c55-3d5c-b89f-345b904e90a8",
                        "source_sense_id": "0b5e9a8d-1e65-31a7-90eb-f192bb157ad9",
                        "source_sense_description": "Anatomie: Knochenscheibe, welche die Gelenkhöcker des Kniegelenks abdeckt und schützt",
                        "target_lang_word": "patella",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "patella",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d8b8e0c-ea27-386d-b515-dc36783d0d30",
                                        "entry_id": "5d026a5d-6962-3bb1-915d-98f266f5ac5f",
                                        "glosses": [
                                            "Alternative form of putelee (“type of boat”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "patella",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2fd3aff-81d5-3746-81bf-907d17df0815",
                                        "entry_id": "b1b54e10-5bd9-3f90-ad5c-b10d16238c1f",
                                        "glosses": [
                                            "The sesamoid bone of the knee; the kneecap."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "180a8dc4-85b5-486f-b14e-fffbf364b693",
                                                "sense_id": "c2fd3aff-81d5-3746-81bf-907d17df0815",
                                                "text": "Subluxed patellas, more commonly referred to as slipped stifles, like all inherited factors will continue to cripple a breed as long as breeders continue to mate affected animals."
                                            },
                                            {
                                                "example_id": "1f8ca6c0-cf1b-4322-be27-cbd4ef1c3285",
                                                "sense_id": "c2fd3aff-81d5-3746-81bf-907d17df0815",
                                                "text": "2005, Roger E. Stevenson, 20: Limbs, Roger E. Stevenson, Judith G. Hall, Human Malformations and Related Anomalies, page 920,\nSince patella diameter is a feature of continuous variation, the majority of small patellas represent simply the lower extreme of normal anatomic variation."
                                            },
                                            {
                                                "example_id": "079676e3-5860-44a3-9903-97cfc6b3b106",
                                                "sense_id": "c2fd3aff-81d5-3746-81bf-907d17df0815",
                                                "text": "Both patellae are well preserved for Dolni Věstonice 3 and 13-15, and the left patella remains for Dolni Věstonice 16 (Figures 18.22 to 18.26)."
                                            },
                                            {
                                                "example_id": "42c421d8-ddf1-44a9-9c94-ca0391e61adc",
                                                "sense_id": "c2fd3aff-81d5-3746-81bf-907d17df0815",
                                                "text": "The patellae may be up to 30° externally rotated at birth. In young children it is considered normal for the patellae to be externally rotated, but by 5 years of age the patellae should face forwards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b254b7c7-a669-3062-b9eb-bb8d0fa22532",
                                        "entry_id": "b1b54e10-5bd9-3f90-ad5c-b10d16238c1f",
                                        "glosses": [
                                            "A little dish or vase."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3851ebd4-4a9f-329d-b307-930589352cd1",
                                        "entry_id": "b1b54e10-5bd9-3f90-ad5c-b10d16238c1f",
                                        "glosses": [
                                            "An orbicular sessile apothecium, with a marginal rim distinct from the thallus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
