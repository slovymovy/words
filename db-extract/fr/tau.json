                    }
                ],
                "translations": [
                    {
                        "translation_id": "392effc2-4a65-4629-b815-ea1824e1e9d0",
                        "source_entry_id": "d0499205-ac54-35fc-9a8d-00676ca4dbc6",
                        "source_sense_id": "3b167ffb-0d2c-356f-8cc9-25319e97ab48",
                        "target_lang_word": "Tau",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "70bb34c0-086f-3e5a-9400-25cc0c1e197a",
                                        "entry_id": "962ce48e-1bad-3e41-b491-7cbcb0bf487a",
                                        "glosses": [
                                            "Niederschlag, durch Abkühlung (in Bodennähe) kondensierter Wasserdampf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2645d49b-cbe4-4be6-aef7-ead19f08914a",
                                                "sense_id": "70bb34c0-086f-3e5a-9400-25cc0c1e197a",
                                                "text": "Die Wiesen sind morgens feucht vom Tau."
                                            },
                                            {
                                                "example_id": "8423b0d7-c0b2-4ce0-96e8-e0d9612958ca",
                                                "sense_id": "70bb34c0-086f-3e5a-9400-25cc0c1e197a",
                                                "text": "„In dem sandigen Staube der viele Zoll tief aufgefurchten Strasse versickerte der Tau ohne jede Wirkung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Tau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "44f2efe5-0e97-3d3c-a640-ec2c3f039129",
                                        "entry_id": "f0f60c3c-f463-3db4-adbd-f85105d2286b",
                                        "glosses": [
                                            "starkes Schiffsseil aus Hanf oder Stahldraht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4c5355c-1ff3-4094-ad56-6a40470916e5",
                                                "sense_id": "44f2efe5-0e97-3d3c-a640-ec2c3f039129",
                                                "text": "Das Schiff war mit einem Tau am Bollwerk befestigt."
                                            },
                                            {
                                                "example_id": "545e05e9-3420-4a8b-8cc1-8112a608a6da",
                                                "sense_id": "44f2efe5-0e97-3d3c-a640-ec2c3f039129",
                                                "text": "„Er trat mit dem Tau aufs Dock und warf es über einen Poller.“"
                                            },
                                            {
                                                "example_id": "b6110d7a-7826-498b-9096-aa7f615e6be2",
                                                "sense_id": "44f2efe5-0e97-3d3c-a640-ec2c3f039129",
                                                "text": "„Auf diesem lief er bis ans Ufer und befestigte dort das Tau in einem der zu diesem Zweck angebrachten eisernen Ringe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ae6cd3dc-4f00-3e22-bd3e-e9b3ca6b5d0b",
                                        "entry_id": "f0f60c3c-f463-3db4-adbd-f85105d2286b",
                                        "glosses": [
                                            "Seil, insbesondere zum Klettern"
                                        ],
                                        "tags": [
                                            "Geräteturnen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abc09be0-2d12-48af-aa18-181b426e70e6",
                                                "sense_id": "ae6cd3dc-4f00-3e22-bd3e-e9b3ca6b5d0b",
                                                "text": "Versuch dich mit Unterstützung der Beine langsam und gleichmäßig am Tau hochzuziehen!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Tau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "147cf756-c7bd-3e10-8bd3-fcf17053f05d",
                                        "entry_id": "57a2e0fd-5032-33b7-a7c9-23c277062a4d",
                                        "glosses": [
                                            "Name des neunzehnten Buchstabens im griechischen Alphabet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e9c463a-00fe-497b-bfd4-6b63f3f6eb98",
                                                "sense_id": "147cf756-c7bd-3e10-8bd3-fcf17053f05d",
                                                "text": "Das Aussehen der Taus am Computermonitor ist weitgehend vom verwendeten Font abhängig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08ecb962-3c1c-4d97-b970-1e919930cf6a",
                        "source_entry_id": "d0499205-ac54-35fc-9a8d-00676ca4dbc6",
                        "source_sense_id": "3b167ffb-0d2c-356f-8cc9-25319e97ab48",
                        "target_lang_word": "tau",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tau",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9d80ddd-99bd-38f4-ab45-670f61288150",
                                        "entry_id": "87b88b4c-cbf7-3efe-8829-71fbb5a59cc9",
                                        "glosses": [
                                            "The letter Τ /τ in the Greek alphabet; being the nineteenth letter of the Classical and Modern Greek, and the twenty-first letter of the Old and Ancient Greek alphabets."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "66e1da53-af31-34a3-8824-52e7dcb5486a",
                                        "entry_id": "87b88b4c-cbf7-3efe-8829-71fbb5a59cc9",
                                        "glosses": [
                                            "Alternative form of taw; the 22nd and last letter of many Semitic alphabets/abjads, including Phoenician, Aramaic, Hebrew, Syriac, and Arabic."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd6a85f6-2da4-46b8-b8f9-c1c6f0137749",
                                                "sense_id": "66e1da53-af31-34a3-8824-52e7dcb5486a",
                                                "text": "Hence it appears that the spits, or skewers, on which and to which the lamb was fixed and fastened in order to be roasted, assumed the form of a cross, not such a tau-cross as is engraved in Dr. Oliver’s Historical Landmarks of Freemasonry, vol. i. p. 80. having three arms only like the Greek letter tau; but a cross like the ancient Hebrew tau, with four arms, though not necessarily all of equal length."
                                            },
                                            {
                                                "example_id": "0f05f807-6f8e-4d48-a7b3-b3412ad87c64",
                                                "sense_id": "66e1da53-af31-34a3-8824-52e7dcb5486a",
                                                "text": "In the Spanish translation of Sallust, by the Infant Don Gabriel in 1772, called the Infant Sallust, there is a curious dissertation by Father Perez Bayer on the resemblance between the ancient Hebrew and Phœnician alphabets, in which it is observed that the Hebrew Tau was written in pure Phœnician, […]"
                                            },
                                            {
                                                "example_id": "6a8d17b2-2ee4-4aca-9179-32ce52ca46fc",
                                                "sense_id": "66e1da53-af31-34a3-8824-52e7dcb5486a",
                                                "text": "The tau is both the 19ᵗʰ letter of the Greek alphabet, and also the 22ⁿᵈ letter of the Hebrew alphabet. In this context, the Hebrew tau or tav is more pertinent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a84211c4-3909-3b72-898a-e081014fb519",
                                        "entry_id": "87b88b4c-cbf7-3efe-8829-71fbb5a59cc9",
                                        "glosses": [
                                            "A Τ-shaped object or sign; a Saint Anthony's cross, sometimes regarded as a sacred symbol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a3240be-a80e-4f4c-835b-b0acfb95ed82",
                                                "sense_id": "a84211c4-3909-3b72-898a-e081014fb519",
                                                "text": "Nor ſhall we take in the myſticall Tau, or the Croſſe of our bleſſed Saviour, which having in ſome deſcriptions an Empedon or croſſing foot-ſtay, made not one ſingle tranſverſion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c21d41e2-2091-3f27-967e-8e9f878fe689",
                                        "entry_id": "87b88b4c-cbf7-3efe-8829-71fbb5a59cc9",
                                        "glosses": [
                                            "A Τ-shaped object or sign; a Saint Anthony's cross, sometimes regarded as a sacred symbol.",
                                            "A crosier with a Τ-shaped head."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1336a0ed-ff10-352f-b33c-c5a351cb58d1",
                                        "entry_id": "87b88b4c-cbf7-3efe-8829-71fbb5a59cc9",
                                        "glosses": [
                                            "The ankh symbol (☥)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "57b066a3-d115-312f-95c2-9a2dfb714dc3",
                                        "entry_id": "87b88b4c-cbf7-3efe-8829-71fbb5a59cc9",
                                        "glosses": [
                                            "Chiefly written τ: used to designate the nineteenth star (usually according to brightness) in a constellation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ab2481a2-1e47-3d3e-acb9-e553b30a36e5",
                                        "entry_id": "87b88b4c-cbf7-3efe-8829-71fbb5a59cc9",
                                        "glosses": [
                                            "A measurement of the sensitivity of the value of an option to changes in the implied volatility of the price of the underlying asset."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47402299-e5d1-4346-a55b-dc602044add5",
                                                "sense_id": "ab2481a2-1e47-3d3e-acb9-e553b30a36e5",
                                                "text": "(includes a list of coordinate terms)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "586d94d4-299f-3018-a14b-5c0e021f673c",
                                        "entry_id": "87b88b4c-cbf7-3efe-8829-71fbb5a59cc9",
                                        "glosses": [
                                            "Chiefly written τ: an irrational and transcendental constant representing the ratio of the circumference of a Euclidean circle to its radius, equal to twice the value of pi (2π; approximately 6.2831853071)."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c69a2bd6-1fe2-3f68-836c-988eebcc3270",
                                        "entry_id": "87b88b4c-cbf7-3efe-8829-71fbb5a59cc9",
                                        "glosses": [
                                            "Ellipsis of tau protein (“a protein abundant especially in the neurons of the human central nervous system that stabilizes microtubules, and when misfolded is associated with forms of dementia such as Alzheimer's and Parkinson's diseases”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79f1f54b-7e30-4507-840c-8c593d29fd3d",
                                                "sense_id": "c69a2bd6-1fe2-3f68-836c-988eebcc3270",
                                                "text": "Quite what that job is remains obscure, but one theory is that it is to stabilise another protein called tau, which is supposed in turn to keep in shape the tubular ‘skeleton’ of a neuron."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43dbb765-dec0-3701-bcd5-8db9ff4608c7",
                                        "entry_id": "87b88b4c-cbf7-3efe-8829-71fbb5a59cc9",
                                        "glosses": [
                                            "Chiefly written τ.",
                                            "Ellipsis of tau lepton or tau particle (“an unstable elementary particle which is a type of lepton, having a mass almost twice that of a proton, a negative charge, and a spin of ½; it decays into hadrons (usually pions) or other leptons, and neutrinos; a tauon”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis",
                                            "particle"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "33917731-be1d-3ef9-9b76-f5544cac59e0",
                                        "entry_id": "87b88b4c-cbf7-3efe-8829-71fbb5a59cc9",
                                        "glosses": [
                                            "Chiefly written τ.",
                                            "Ellipsis of tau meson, now known as a kaon."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis",
                                            "historical",
                                            "particle"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
