        "nl-extract.jsonl": [
            {
                "entry_id": "449658d6-9f50-32a2-83d7-473ea3ee49a4",
                "word": "opsodemieteren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "05b42ab9-f42f-39ae-90a8-e8029c7a66ba",
                        "entry_id": "449658d6-9f50-32a2-83d7-473ea3ee49a4",
                        "glosses": [
                            "weggaan"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "84dbe61a-c219-40fd-8b40-f1b61fe324d3",
                                "sense_id": "05b42ab9-f42f-39ae-90a8-e8029c7a66ba",
                                "text": "Drank is verwoestend voor je omgang met anderen. Al kon me dat kort na de dood van Hans niets schelen. Ze konden allemaal opsodemieteren. Een gevaarlijke kant van rouw is de enorme onverschilligheid ten overstaan van wat mensen van je denken en of ze nog bij je blijven of niet. Pure razernij."
                            },
                            {
                                "example_id": "eac6654d-25f2-4c1b-9e3d-2811ce3e39ec",
                                "sense_id": "05b42ab9-f42f-39ae-90a8-e8029c7a66ba",
                                "text": "Vorige maand werd hij zelf opgepakt toen hij in Utrecht te dicht bij een tegendemonstratie interviews aan het geven was terwijl hem was verboden daar te komen. In mei moet Wagensveld voor de rechter verschijnen. In zijn toespraken verwijst hij naar het onrecht dat Pegida volgens hem wordt aangedaan. „De elite moet opsodemieteren.”"
                            }
                        ]
                    }
                ],
