                "senses": [
                    {
                        "sense_id": "c79a42bc-08de-3616-a061-0519b352f5d0",
                        "entry_id": "295194d1-d8b4-33cc-9082-1c870a2768b6",
                        "glosses": [
                            "ein linksrheinischer, im Norden gelegener Stadtteil von Koblenz am Rhein"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "45e233c4-1009-42bf-9637-daadbae03172",
                                "sense_id": "c79a42bc-08de-3616-a061-0519b352f5d0",
                                "text": "„Der steigende Elektrizitätsbedarf machte den weiteren Ausbau der Umspannwerke in Horchheim und Wallersheim, hier für die Versorgung des neuen Industriegebietes und des Rheinhafens, erforderlich."
                            },
                            {
                                "example_id": "2b52bd22-7c56-415a-86c4-59008718e69f",
                                "sense_id": "c79a42bc-08de-3616-a061-0519b352f5d0",
                                "text": "„Im Jahr 1923 trennte man das Dorf „Wallersheim“ vom Landkreis und gliederte es als Stadtteil nach Koblenz ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c252832c-7022-3107-91aa-d4de3b99b0c0",
                        "entry_id": "295194d1-d8b4-33cc-9082-1c870a2768b6",
                        "glosses": [
                            "ein Ort in der Eifel in der Verbandsgemeinde Prüm"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "c4a7e72b-f7fd-4a17-aec1-2bb8225f833a",
                                "sense_id": "c252832c-7022-3107-91aa-d4de3b99b0c0",
                                "text": "Die Ortsgemeinde Wallersheim gehört zur Verbandsgemeinde Prüm."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
