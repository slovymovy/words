    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a1fdd51d-8bc9-3502-9227-f9cefe4dbf93",
                    "sense_definition": "Renommée éclatante et durable acquise par des mérites, des exploits ou des œuvres remarquables.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "renommee",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jeune athlète a connu son heure de <w>gloire</w> en remportant la médaille d'or olympique."
                        },
                        {
                            "text": "L'écrivain a cherché toute sa vie la <w>gloire</w> littéraire sans jamais renoncer à ses idéaux."
                        }
                    ],
                    "synonyms": [
                        "renommée",
                        "célébrité",
                        "prestige"
                    ],
                    "antonyms": [
                        "déshonneur",
                        "honte",
                        "infamie"
                    ],
                    "common_phrases": [
                        "heure de gloire",
                        "moment de gloire",
                        "soif de gloire"
                    ]
                },
                {
                    "sense_id": "8a75af82-a208-3a3f-87db-e1fb222c8879",
                    "sense_definition": "Louange solennelle, culte et hommage rendus à la divinité.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les fidèles rassemblés chantaient des hymnes pour rendre <w>gloire</w> au Seigneur."
                        },
                        {
                            "text": "Cette immense cathédrale a été construite pour la plus grande <w>gloire</w> de Dieu."
                        }
                    ],
                    "synonyms": [
                        "louange",
                        "hommage",
                        "adoration"
                    ],
                    "common_phrases": [
                        "rendre gloire",
                        "gloire à Dieu"
                    ]
                },
                {
                    "sense_id": "8b7f09d6-e805-3131-8d50-774c3bcf92b4",
                    "sense_definition": "Personne illustre qui s'est distinguée par ses mérites ou ses talents exceptionnels.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette ancienne <w>gloire</w> du football a été invitée pour remettre le trophée aux vainqueurs."
                        },
                        {
                            "text": "La ville est fière de célébrer les grandes <w>gloires</w> locales qui ont marqué son histoire."
                        }
                    ],
                    "synonyms": [
                        "sommité",
                        "célébrité"
                    ],
                    "common_phrases": [
                        "ancienne gloire"
                    ]
                },
                {
                    "sense_id": "50c4a6dc-f7f1-3ea8-99aa-4ea9f98d7ebf",
                    "sense_definition": "Éclat majestueux et resplendissant d'une chose remarquable.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "splendeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au lever du soleil, le château apparaissait dans toute sa <w>gloire</w> dorée."
                        },
                        {
                            "text": "Le parc restauré a enfin retrouvé sa <w>gloire</w> d'autrefois auprès des visiteurs."
                        }
                    ],
                    "synonyms": [
                        "splendeur",
                        "magnificence",
                        "éclat"
                    ],
                    "common_phrases": [
                        "toute sa gloire"
                    ]
                },
                {
                    "sense_id": "db9aaf81-54aa-3785-8d5f-15159b03c021",
                    "sense_definition": "Dans l'art religieux, cercle lumineux ou faisceau de rayons entourant la tête ou le corps d'un saint ou d'un personnage divin.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "art_religieux",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le peintre a disposé une <w>gloire</w> lumineuse autour du visage de la sainte."
                        },
                        {
                            "text": "Au-dessus de l'autel, une grande <w>gloire</w> en bois doré attire immédiatement le regard."
                        }
                    ],
                    "synonyms": [
                        "auréole",
                        "nimbe"
                    ]
                },
                {
                    "sense_id": "31c21a9b-e2fb-3b4d-9a10-3b44b1c6950e",
                    "sense_definition": "Au théâtre ancien, machine suspendue ornée de faux nuages servant à faire descendre des divinités sur la scène.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "theatre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La mise en scène de cette tragédie classique nécessitait l'utilisation d'une <w>gloire</w> pour faire descendre les dieux."
                        },
                        {
                            "text": "Les machinistes manœuvraient la <w>gloire</w> à l'aide de lourds contrepoids dissimulés."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Histoire du théâtre"
                        }
                    ]
                },
                {
                    "sense_id": "e54c571b-c8a0-3f8d-a528-8039ac39fc36",
                    "sense_definition": "Phénomène optique consistant en un halo lumineux irisé visible autour de l'ombre d'un observateur projetée sur un brouillard ou un nuage.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "optique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis le sommet de la montagne, l'alpiniste a pu observer une <w>gloire</w> spectaculaire."
                        },
                        {
                            "text": "Les passagers de l'avion ont aperçu une <w>gloire</w> entourant l'ombre de l'appareil sur la brume."
                        }
                    ]
                }
            ]
        }
    ]
