                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fcfa3fa-4a0b-4210-8874-5e6cf8d5c15e",
                                "sense_id": "7a8dc642-5a6f-3b2b-a399-c9163c4df547",
                                "text": "Rodzony brat matki jest wujem, żona jego wujenką czyli wujną, syn bratem, córka siostrą rodzono-wujeczną"
                            },
                            {
                                "example_id": "df5f91d9-cf57-4ef5-930f-1af7c5fb2098",
                                "sense_id": "7a8dc642-5a6f-3b2b-a399-c9163c4df547",
                                "text": "Dziwny człek jest pan Zagłoba, bo on mu wcale wujem ni krewnym nie był, a przecie inny by po synu tak nie desperował…"
                            }
                        ],
