                                            {
                                                "example_id": "ae095caf-8a42-4f83-afd4-d28f46b6fc17",
                                                "sense_id": "ff2a3125-07f6-336f-b5e3-89fffd947666",
                                                "text": "De figuren in de artikelen waren niet meteen herkenbaar omdat Khan de logaritmische schaal had omgezet in een analoge."
                                            }
                                        ]
