                ],
                "senses": [
                    {
                        "sense_id": "a3b95ab6-5d54-38af-b497-d3417594545b",
                        "entry_id": "597aa610-ea2e-3cce-93dd-95e7272b314a",
                        "glosses": [
                            "synonym of како́й (kakój) in the main determiner and pronoun senses."
                        ],
                        "tags": [
                            "archaic",
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "0fabba91-5277-4343-9abf-c97dc1710398",
                                "sense_id": "a3b95ab6-5d54-38af-b497-d3417594545b",
                                "text": "Мо́жно ожида́ть, что риск о́чень высо́к, каковы́м он и явля́ется.",
                                "translation": "You can expect the risk to be very high, which it is.",
                                "english": "You can expect the risk to be very high, which it is."
                            },
                            {
                                "example_id": "8230a180-722a-4d0d-8720-244c5c3de7f9",
                                "sense_id": "a3b95ab6-5d54-38af-b497-d3417594545b",
                                "text": "каковы́ми бы они́ ни бы́ли",
                                "translation": "whatever they are / may be",
                                "english": "whatever they are / may be"
                            },
                            {
                                "example_id": "091fd072-0608-4adf-a2d7-9c72baaf96fe",
                                "sense_id": "a3b95ab6-5d54-38af-b497-d3417594545b",
                                "text": "Какова́я пози́ция прави́тельства?",
                                "translation": "What is the government's position?",
                                "english": "What is the government's position?"
                            }
                        ]
                    },
                    {
                        "sense_id": "dbdeaaf8-caae-3fd4-9924-059803e50cc4",
                        "entry_id": "597aa610-ea2e-3cce-93dd-95e7272b314a",
                        "glosses": [
                            "synonym of кото́рый (kotóryj) in the interrogative and relative pronoun senses."
                        ],
                        "tags": [
                            "archaic",
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "bff7b415-2f96-497c-a936-43aa269a9041",
                                "sense_id": "dbdeaaf8-caae-3fd4-9924-059803e50cc4",
                                "text": "тала́нтливые лю́ди, каковы́х мно́го",
                                "translation": "talented people, of which there are many",
                                "english": "talented people, of which there are many"
                            },
                            {
                                "example_id": "a118a227-edf4-452b-b3cc-886940ab3b6f",
                                "sense_id": "dbdeaaf8-caae-3fd4-9924-059803e50cc4",
                                "text": "Разрабо́тали мето́дику, какову́ю Коми́ссия мо́жет испо́льзовать в ка́честве образца́.",
                                "translation": "A methodology was developed which the Commission can use as a model.",
                                "english": "A methodology was developed which the Commission can use as a model."
                            }
                        ]
                    }
