            {
                "entry_id": "f4e87f6a-35b8-32b8-ad08-ebeaca2f1c94",
                "word": "sixties",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "adf3ac30-1c9f-3af2-8a57-dc453b0aca98",
                        "entry_id": "f4e87f6a-35b8-32b8-ad08-ebeaca2f1c94",
                        "glosses": [
                            "Décennie des années 1960."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "dd8f347a-a26e-466f-b22b-f0a14caf868b",
                                "sense_id": "adf3ac30-1c9f-3af2-8a57-dc453b0aca98",
                                "text": "Les sixties battaient leur plein. Les gens, euphoriques dans leurs petits appartements, commençaient à peine à vivre et à voir le monde d’une autre manière dans l’ère du baby boom et du plein emploi."
                            },
                            {
                                "example_id": "156cc687-0f0a-430c-ad00-35bcb39ae536",
                                "sense_id": "adf3ac30-1c9f-3af2-8a57-dc453b0aca98",
                                "text": "Gagner du fric, par n’importe quel moyen, et très vite, était l’horizon d’une génération qui voulait tirer un trait sur les sixties."
                            },
                            {
                                "example_id": "3c61a999-c9ce-48a5-bb81-34f93706de6f",
                                "sense_id": "adf3ac30-1c9f-3af2-8a57-dc453b0aca98",
                                "text": "Il saisit rageusement sa perruque, qui lui redonnait pour un soir la chevelure bananoïde de ses chères sixties, et la jette dans le lavabo où elle se met à sombrer comme un transatlantique."
                            },
                            {
                                "example_id": "99ddb9f0-5bce-4553-bdaf-f610e482e455",
                                "sense_id": "adf3ac30-1c9f-3af2-8a57-dc453b0aca98",
                                "text": "À Isola, on skia en masse dans les couleurs acidulées des sixties."
                            }
                        ]
                    }
