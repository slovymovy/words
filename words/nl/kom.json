                    "target_lang_definitions": {
                        "en": "second-person singular present tense of 'to come' in inversion",
                        "ru": "второе лицо единственного числа настоящего времени глагола 'komen' при инверсии"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "come",
                                "target_lang_sense_clarification": "second-person singular in questions"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "приходишь",
                                "target_lang_sense_clarification": "2-е лицо ед. ч. в вопросах"
                            },
                            {
                                "target_lang_word": "идешь",
                                "target_lang_sense_clarification": "в вопросительных предложениях"
                            }
                        ]
                    }
