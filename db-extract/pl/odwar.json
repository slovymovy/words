                "senses": [
                    {
                        "sense_id": "37534c43-f86d-3c8f-8d1e-85b092de9a3c",
                        "entry_id": "82d0d6b1-de3f-3cab-9fb7-e9a4ec10cda0",
                        "glosses": [
                            "wyciąg wodny z kłączy, korzeni, kory lub ziela, wymagających dłuższego gotowania"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b596943-fcd4-4794-b1e8-5a1e231767aa",
                                "sense_id": "37534c43-f86d-3c8f-8d1e-85b092de9a3c",
                                "text": "Pijał odwar z zebranych przez szeptuchę ziół."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "773d8ad0-18bd-4a8d-a570-b4f73bdfaeb4",
                        "source_entry_id": "82d0d6b1-de3f-3cab-9fb7-e9a4ec10cda0",
                        "source_sense_id": "37534c43-f86d-3c8f-8d1e-85b092de9a3c",
                        "target_lang_word": "decoction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "decoction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "056f2ac6-ca1a-3acd-8db3-cc25e4a1973d",
                                        "entry_id": "9f06d297-7c74-33b3-be41-5f6c2293ea37",
                                        "glosses": [
                                            "An extraction or essence of something, obtained by boiling it down."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03ee588f-bf36-4809-81a0-1ed7a44093dc",
                                                "sense_id": "056f2ac6-ca1a-3acd-8db3-cc25e4a1973d",
                                                "text": "[I]nſtead of Honey, Rob of Elder, Conſerve of Roſes, or Syrup of Violets; Glyſters, Pedilavia of emollient Decoctions with Nitre; or Elder, Vinegar, or Focus's of the ſame, applied with Sponges behind the Ears, to the Armpits, Groins, Hams, &c. or with Barley-water and a little Roſe-vinegar."
                                            },
                                            {
                                                "example_id": "682790e9-d0f3-4942-86ce-502762c669dc",
                                                "sense_id": "056f2ac6-ca1a-3acd-8db3-cc25e4a1973d",
                                                "text": "The transition is a keen one, I assure you, from a schoolmaster to a sailor, and requires a strong decoction of Seneca and the Stoics to enable you to grin and bear it."
                                            },
                                            {
                                                "example_id": "8e6e968e-b067-4192-8249-23e9d004a2ba",
                                                "sense_id": "056f2ac6-ca1a-3acd-8db3-cc25e4a1973d",
                                                "text": "Poley offered a hot decoction of blackberries, saying: Peace?"
                                            },
                                            {
                                                "example_id": "d736efcb-36e0-4458-9102-b7e16dad44a0",
                                                "sense_id": "056f2ac6-ca1a-3acd-8db3-cc25e4a1973d",
                                                "text": "Witches and devils no longer threaten you and me. We don’t mind living next door to the harmless lady with her herb garden and decoction still, her black cat and red hair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f14f395-4f81-3f9e-a020-e0e9590c0927",
                                        "entry_id": "9f06d297-7c74-33b3-be41-5f6c2293ea37",
                                        "glosses": [
                                            "The process of boiling something down in this way."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "faccb30c-82dc-41e6-85e9-c1287d0adea1",
                                                "sense_id": "9f14f395-4f81-3f9e-a020-e0e9590c0927",
                                                "text": "Even the fixed principles of vegetables, at least some of them, are injured by long decoction. The extractive matter, for instance, gradually absorbs oxygen from the atmosphere, and is converted into a substance nearly insipid and inert."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b675e05-07e6-4417-98bb-6dd63e198d7b",
                        "source_entry_id": "82d0d6b1-de3f-3cab-9fb7-e9a4ec10cda0",
                        "source_sense_id": "37534c43-f86d-3c8f-8d1e-85b092de9a3c",
                        "target_lang_word": "décoction",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décoction",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f00ff28-f811-31aa-ba24-e939ac3bdae0",
                                        "entry_id": "6cbc92e3-e69e-36cf-9c5a-a038e8dba13d",
                                        "glosses": [
                                            "Composition médicinale qu’on obtient en faisant bouillir, dans l’eau ou dans quelque liquide, des substances végétales, voire animales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b49afb1-1a8a-4d67-815d-cd0a0311d9c0",
                                                "sense_id": "8f00ff28-f811-31aa-ba24-e939ac3bdae0",
                                                "text": "Pour mon compte, dit un ancien chirurgien de marine, le docteur Neboux , j'ai appliqué à plusieurs reprises à des yeux héméralopes la vapeur d’eau simple ou émolliente sans en retirer d'autres effets qu'un peu d'amélioration chez un petit nombre d'individus, et je n'ai jamais employé la décoction de foie de bœuf sans obtenir la disparition de l’héméralopie."
                                            },
                                            {
                                                "example_id": "7ba7d446-1f4f-419e-ba63-d7e75df3bed3",
                                                "sense_id": "8f00ff28-f811-31aa-ba24-e939ac3bdae0",
                                                "text": "Le guérisseur prépare une décoction d’écorce et en badigeonne la partie du corps atteinte par cette éruption."
                                            },
                                            {
                                                "example_id": "a4fdd5d0-979c-4804-a721-600640329b13",
                                                "sense_id": "8f00ff28-f811-31aa-ba24-e939ac3bdae0",
                                                "text": "Et comme c’est la guerre, s’éloigner des solidarités villageoises veut dire le froid – je vois encore, sur le papier blanc des copies, les mains gourdes, enflées et craquelées, qu’on soignait tant bien que mal avec des décoctions de racines de guimauve."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36beeff0-71d4-3541-90a6-bb0dd034bf4a",
                                        "entry_id": "6cbc92e3-e69e-36cf-9c5a-a038e8dba13d",
                                        "glosses": [
                                            "Étape de la préparation de la bière."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "82008bb3-efec-3b47-b331-1e53a6150bef",
                                        "entry_id": "6cbc92e3-e69e-36cf-9c5a-a038e8dba13d",
                                        "glosses": [
                                            "Mélange d’ingrédients, généralement liquide et peu attirant."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5eb58885-78e1-45dd-8590-9d5306244a50",
                                                "sense_id": "82008bb3-efec-3b47-b331-1e53a6150bef",
                                                "text": "Pouah, mais qu’est-ce que c’est que cette décoction que tu nous as préparée ?"
                                            },
                                            {
                                                "example_id": "8fe79d98-0a0c-4c57-a9cd-b9855c533751",
                                                "sense_id": "82008bb3-efec-3b47-b331-1e53a6150bef",
                                                "text": "Les rues étroites, mal pavées, remplies d’angles et de recoins, n’avaient rien de remarquable qu’une malpropreté abominable ; au milieu coulait un ruisseau d’eau boueuse, qui lui parut une décoction d’ardoise."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f9d0252-9650-4133-a37f-f2722584dae0",
                        "source_entry_id": "82d0d6b1-de3f-3cab-9fb7-e9a4ec10cda0",
                        "source_sense_id": "37534c43-f86d-3c8f-8d1e-85b092de9a3c",
                        "target_lang_word": "Dekokt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dekokt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "983b5189-b8be-3e8a-bdf4-863ae51b4141",
                                        "entry_id": "9656f968-1519-3fae-a85d-e9f01a138311",
                                        "glosses": [
                                            "wässriger Extrakt von tierischen oder pflanzlichen Stoffen mit heilender Wirkung, der durch Kochen gewonnen wird"
                                        ],
                                        "tags": [
                                            "Phytotherapie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ab517bb-e5c1-4d06-85c8-6e69813186b2",
                                                "sense_id": "983b5189-b8be-3e8a-bdf4-863ae51b4141",
                                                "text": "Das ›Dekokt‹ gegen die Gicht, dieser bittere Holztrunk, dessen Rezept ihm zwei oder drei Jahre zuvor ein Jesuit in Wien genannt hatte, zeitigte diesmal nicht den gewünschten Erfolg."
                                            },
                                            {
                                                "example_id": "851b3959-15f1-4fec-9bbb-a88136971064",
                                                "sense_id": "983b5189-b8be-3e8a-bdf4-863ae51b4141",
                                                "text": "Fichtennadelbäder, diese modernste Terpentinölung oder Menschenfirnissung, sind im Dekokt und Destillat leicht zu beschaffen."
                                            },
                                            {
                                                "example_id": "67b7f734-28a6-4ca5-bfaa-7eb05641d102",
                                                "sense_id": "983b5189-b8be-3e8a-bdf4-863ae51b4141",
                                                "text": "»Erlauben Sie gütigst, lieber Herr Vikarius«, unterbrach der Gutsherr ihn und nahm die Kanne aus seiner Hand; dann öffnete er das Fenster und goß den ganzen Dekokt in den Baumhof hinunter."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
