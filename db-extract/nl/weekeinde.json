                "translations": [
                    {
                        "translation_id": "d51dfd1b-24ca-4d6c-a93a-fed5fb6303c3",
                        "source_entry_id": "3b76864e-2ef4-334f-868a-ef4974a315b1",
                        "source_sense_id": "b9c9bed9-efcf-30c9-800c-6920b4dfb23c",
                        "source_sense_description": "periode van vrijdagavond tot en met zondagnacht",
                        "target_lang_word": "Wochenende",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wochenende",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "102c6c05-9547-30d8-b164-de3ad5420e17",
                                        "entry_id": "bd3fd366-cd27-38af-a30a-1353855e99d0",
                                        "glosses": [
                                            "meist arbeits- und schulfreies Ende der Woche beziehungsweise die Tage Sonnabend und Sonntag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f4973ec-608b-45c0-a180-c5bc6e7be2e7",
                                                "sense_id": "102c6c05-9547-30d8-b164-de3ad5420e17",
                                                "text": "Kommst du am Wochenende mit ins Kino?"
                                            },
                                            {
                                                "example_id": "9f283dda-b342-4dae-b2ee-e097133ba666",
                                                "sense_id": "102c6c05-9547-30d8-b164-de3ad5420e17",
                                                "text": "„Trotzdem ist es kein Wunder, dass dieses »Downgrading« am Wochenende rund um die Welt hohe Wellen geschlagen hat.“"
                                            },
                                            {
                                                "example_id": "c8186e91-122c-4d89-baba-7d563a24195f",
                                                "sense_id": "102c6c05-9547-30d8-b164-de3ad5420e17",
                                                "text": "„Während das Wochenende mit der Zeit und der schnellsten Verbindung vornehmlich rechnen muß, hat der Sommerfrischler mehr Zeit und Muße zur Auswahl und Fahrt zur Sommerfrische.“"
                                            },
                                            {
                                                "example_id": "1db29ddd-9320-4fe0-a0ab-b0cbb9cdb324",
                                                "sense_id": "102c6c05-9547-30d8-b164-de3ad5420e17",
                                                "text": "„Papa war nach Meppen versetzt worden, hatte sich da zwei Zimmer mit Bad gemietet und kam nur noch am Wochenende nachhause.“"
                                            },
                                            {
                                                "example_id": "3a8613e6-accc-4c01-8ac1-c542e2966cf4",
                                                "sense_id": "102c6c05-9547-30d8-b164-de3ad5420e17",
                                                "text": "„Am Wochenende rief meine Mutter an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8568526-94ff-42e9-a481-0245a6e2248a",
                        "source_entry_id": "3b76864e-2ef4-334f-868a-ef4974a315b1",
                        "source_sense_id": "b9c9bed9-efcf-30c9-800c-6920b4dfb23c",
                        "source_sense_description": "periode van vrijdagavond tot en met zondagnacht",
                        "target_lang_word": "weekend",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "weekend",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea0d5034-20b9-307c-9ed7-68d09244954c",
                                        "entry_id": "641edb09-c58f-309e-8fa7-a32a60223f1b",
                                        "glosses": [
                                            "The break in the working week, usually two days including the traditional holy or sabbath day. Thus in Western countries, Saturday and Sunday."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c288d60-6465-43f8-9eae-de38c8f15990",
                                                "sense_id": "ea0d5034-20b9-307c-9ed7-68d09244954c",
                                                "text": "“They can live upon barley-meal without a morsel of meat from week-end to week-end, can these miserable Sawnies,” quoth another."
                                            },
                                            {
                                                "example_id": "5aefa9f4-adee-4911-b0a7-f580dfca7edb",
                                                "sense_id": "ea0d5034-20b9-307c-9ed7-68d09244954c",
                                                "text": "[…] often took a few boys down there for what we North Country folk call the week-end — Saturday and Sunday; it was also used as a sanatorium if required."
                                            },
                                            {
                                                "example_id": "0074a7a9-ebaf-4390-a026-a0f1f9d93d27",
                                                "sense_id": "ea0d5034-20b9-307c-9ed7-68d09244954c",
                                                "text": "I love a phrase of Dizzy's in one of his later letters to Lady Bradford, whom he reproaches for her addiction to what we now call week-end visits to country houses: “the monotony of organized platitude.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "weekend",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77042ec1-2e09-3e19-aabd-dab9e7c90f83",
                                        "entry_id": "14afbe06-c634-3ef4-bcb6-1494a973cf5f",
                                        "glosses": [
                                            "To spend the weekend."
                                        ],
                                        "tags": [],
