                        "source_sense_id": "71b1564e-767e-3cd4-9b4a-efde0c876481",
                        "source_sense_description": "im Ofen bei starker Oberhitze überbackenes, überkrustetes Gericht (salzig oder süß)",
                        "target_lang_word": "gratin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gratin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "caa6a906-af91-3553-8713-0600f8286c7b",
                                        "entry_id": "f94ccc05-b858-3acd-9c00-5877f92a389d",
                                        "glosses": [
                                            "Manière d’apprêter certains mets avec de la chapelure de pain, du fromage ou de la crème."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "850f9ea1-4c5f-4872-add0-046cadf05a79",
                                                "sense_id": "caa6a906-af91-3553-8713-0600f8286c7b",
                                                "text": "Mouin, j’avais préparé un ripage de concombres, un colombo, un gratin de christophines ; j’avais acheté du rosé et du mousseux…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f20606d4-f7fd-3ebe-8ca3-4fed83fe773c",
                                        "entry_id": "f94ccc05-b858-3acd-9c00-5877f92a389d",
                                        "glosses": [
                                            "Élite mondaine."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2839630-44d1-46a5-a9e3-bff011d5a1f0",
                                                "sense_id": "f20606d4-f7fd-3ebe-8ca3-4fed83fe773c",
                                                "text": "Smokings et robes de soirée, tout le gratin montréalais se trouve sur place."
                                            },
                                            {
                                                "example_id": "8f480cc0-21d6-4a10-a3e3-6306c8799142",
                                                "sense_id": "f20606d4-f7fd-3ebe-8ca3-4fed83fe773c",
                                                "text": "Dans sa lettre au gouverneur, Colborne fait allusion à la fondation d'une association politique par le gratin patriote de Montréal."
                                            },
                                            {
                                                "example_id": "f3140590-a3cd-4180-a677-6fb1ff7760e6",
                                                "sense_id": "f20606d4-f7fd-3ebe-8ca3-4fed83fe773c",
                                                "text": "« Ce sera surtout l’occasion de rencontrer le gratin cairote.\n— Et non pas le gratin de pommes de terre. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "884c8592-8bca-372d-975e-03260dfd533c",
                                        "entry_id": "f94ccc05-b858-3acd-9c00-5877f92a389d",
                                        "glosses": [
                                            "La partie de certains mets liquides, farineux, etc., qui reste attachée au fond des récipients dans lesquels on les a fait cuire, et qui est souvent rousse et brûlée."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e333b5c-f182-490b-8b12-14fbbe11b98d",
                                                "sense_id": "884c8592-8bca-372d-975e-03260dfd533c",
                                                "text": "Le gratin d’une bouillie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d91a153-c278-388f-8a15-9ad878fdeafb",
                                        "entry_id": "f94ccc05-b858-3acd-9c00-5877f92a389d",
                                        "glosses": [
                                            "Partie des matières fécales adhérentes aux parois et au fond des fosses d’aisances."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
