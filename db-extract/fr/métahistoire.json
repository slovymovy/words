                        "examples": [
                            {
                                "example_id": "21ec09c6-4263-4663-92ab-ffc034e11530",
                                "sense_id": "3d84efd3-ca22-35f8-90cf-b2e92b419f53",
                                "text": "Le christianisme nous a laissé comme héritage un sens de l’histoire toujours en référence à une « métahistoire », à des valeurs éternelles qui transcendent notre histoire courante."
                            }
                        ]
                    }
