                                    {
                                        "sense_id": "d71b29ee-acc4-3b35-aab8-703fa4f9aeab",
                                        "entry_id": "fa016188-09fc-3d4d-b12c-38426b115a3c",
                                        "glosses": [
                                            "A male crossdresser who adopts feminine behaviours."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1db247cc-14ff-4a60-8e83-5888b02dd956",
                                                "sense_id": "d71b29ee-acc4-3b35-aab8-703fa4f9aeab",
                                                "text": "I realised I still held my normal male clothes and dropped them to the floor under the desk, out of the way. […] Would it hurt? Yes, I knew it would from watching videos of sissies being spanked by their dominant mistresses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1248c80b-437c-3b29-b1b2-b8b36863ef8a",
                                        "entry_id": "fa016188-09fc-3d4d-b12c-38426b115a3c",
                                        "glosses": [
                                            "Sister; often used as a term of address"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3ca1d3e-21c6-42bd-b01b-ef3782bd7c72",
                                                "sense_id": "1248c80b-437c-3b29-b1b2-b8b36863ef8a",
                                                "text": "\"I so glad - so glad the wicked thing not hurt my sissy!\" and in that moment of thankful joy the two children embraced each other with fond affection."
                                            },
                                            {
                                                "example_id": "edd949ca-4c26-4f3f-bda1-32d7b5452652",
                                                "sense_id": "1248c80b-437c-3b29-b1b2-b8b36863ef8a",
                                                "text": "Her seven-year-old brother Justin sat on my lap beside her casket. I explained to him why we were staying with his sissy. He wouldn't leave; he stayed, too. He kissed her, touched her hand, told her he would miss her."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sissy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
