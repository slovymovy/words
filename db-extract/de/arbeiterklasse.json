                    {
                        "sense_id": "3a42f9fb-de95-3b77-98cd-2db3a532dfc9",
                        "entry_id": "9d858361-e683-3ad7-b139-0ede210b9161",
                        "glosses": [
                            "Classe ouvrière, classe des travailleurs."
