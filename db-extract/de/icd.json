                                    {
                                        "sense_id": "572700c4-3618-320f-b529-86656495aab4",
                                        "entry_id": "206d28dc-05e3-316c-b547-f3fb7ed6d4c7",
                                        "glosses": [
                                            "Initialism of implantable cardioverter-defibrillator."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09e36a1a-9125-445a-b3f6-de6b7125356c",
                                                "sense_id": "572700c4-3618-320f-b529-86656495aab4",
                                                "text": "Both CRT-Ds and ICDs are implanted under the skin, in the patient’s upper chest area. The devices have wires called leads that attach to the heart and regulate the rhythm of the muscle. Defibrillators help patients with bradycardia – a slow heartbeat – by pacing the heartbeat and those with tachycardia – a fast heartbeat – by delivering shocks that reset heartbeats to normal."
                                            },
                                            {
                                                "example_id": "fcf926c5-9d00-4c03-8efb-912e321dda7e",
                                                "sense_id": "572700c4-3618-320f-b529-86656495aab4",
                                                "text": "Serie A club Inter Milan – whom Eriksen had been contracted to at the time of the incident – let the midfielder move abroad as he was unable to play in Italy unless the ICD device was removed."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ICD",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "528410ff-75f9-316d-a665-35e1d66d19e5",
                                        "entry_id": "93c92efa-11a5-39f5-8aa7-e8218b893db8",
                                        "glosses": [
                                            "Initialism of International Classification of Diseases."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba2f2241-1a3e-455a-8604-f02f692a9c2c",
                                                "sense_id": "528410ff-75f9-316d-a665-35e1d66d19e5",
                                                "text": "ICD-10, ICD-11"
                                            },
                                            {
                                                "example_id": "32b02a50-0ec1-4a6e-9c94-00b728a7bdb7",
                                                "sense_id": "528410ff-75f9-316d-a665-35e1d66d19e5",
                                                "text": "Because there is no HIPAA requirement that insurance companies also accept DSM-IV-TR codes, insurance companies are likely to only accept electronic claims that use ICD-9-CM diagnosis codes, and which will require psychologists who are only familiar with DSM-IV-TR to convert their DSM-IVTR diagnosis codes into ICD-9-CM diagnosis codes."
                                            }
                                        ]
                                    }
                                ]
                            }
