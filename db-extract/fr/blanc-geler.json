                "senses": [
                    {
                        "sense_id": "6bb6e0c1-4a0b-3041-a35f-83c2ee5cc985",
                        "entry_id": "925b1a09-84e0-350e-9ab4-934f496a1dc7",
                        "glosses": [
                            "Geler blanc (faire un temps froid, avec de la gelée blanche)."
                        ],
                        "tags": [
                            "Normandie"
                        ],
                        "examples": [
                            {
                                "example_id": "c0f1c3b3-5ee8-46c4-89be-70ca441263a3",
                                "sense_id": "6bb6e0c1-4a0b-3041-a35f-83c2ee5cc985",
                                "text": "Autrement, je n’aurais pas laissé tous mes gens croquer le marmot toute la nuit, alors qu’il blanc-gelait !"
                            },
                            {
                                "example_id": "9eeec4a4-dce9-4055-aded-f2f19c416561",
                                "sense_id": "6bb6e0c1-4a0b-3041-a35f-83c2ee5cc985",
                                "text": "Il blanc-gelait encore ce matin à 10 heures !!!"
                            },
                            {
                                "example_id": "f1b1e8fa-3e13-42e5-947e-b52ce74ee122",
                                "sense_id": "6bb6e0c1-4a0b-3041-a35f-83c2ee5cc985",
                                "text": "J'aime l'automne lorsqu'il \"blanc-gèle\" le matin et que le soleil brille l'après-midi."
                            }
                        ]
                    }
