                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48352b73-b2fb-4802-8080-57f9f995d89e",
                                "sense_id": "74e73703-4a6f-3767-8ee1-7d42c3601a5f",
                                "text": "He knows I should only laugh at his desertion; and he would not like to be the one who was left, which he knows I should do for the first thwarted whim."
                            },
                            {
                                "example_id": "04735876-cbb6-4207-9aca-c0510f99e64d",
                                "sense_id": "74e73703-4a6f-3767-8ee1-7d42c3601a5f",
                                "text": "There is no blockage in their instinctive life, and when the two men fight the physical closeness is not a substitute for a thwarted sexual life."
                            }
                        ]
                    }
