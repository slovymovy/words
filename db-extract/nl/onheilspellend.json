                ],
                "senses": [
                    {
                        "sense_id": "2ebe29d3-c53b-342b-aae2-852568e2fc7c",
                        "entry_id": "000f5603-4651-3a22-af07-a5f73c9a6ee4",
                        "glosses": [
                            "wat gevaarlijke, onplezierige dingen voorspelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49db5e82-985e-4b07-9a37-2034a0bf286a",
                                "sense_id": "2ebe29d3-c53b-342b-aae2-852568e2fc7c",
                                "text": "De tengere gestalte van een meisje van een jaar of twaalf staat op de omslag, met achter haar een donkere lucht vol onheilspellende wolken. Lange zwarte haren wapperen voor een bleek en betraand gezicht."
                            },
                            {
                                "example_id": "4f61f7c8-7bba-4c8a-b2f6-58d595ddb2bc",
                                "sense_id": "2ebe29d3-c53b-342b-aae2-852568e2fc7c",
                                "text": "De onheilspellende onweerswolken trokken samen boven Pinkpop."
                            },
                            {
                                "example_id": "ec0f5299-c9d4-4ee0-a5e3-91a1facdb8e8",
                                "sense_id": "2ebe29d3-c53b-342b-aae2-852568e2fc7c",
                                "text": "Door een gat in het dak kon Kleine Woord de hemel zien die nu donker en onheilspellend geworden was."
                            }
                        ]
                    }
                ],
