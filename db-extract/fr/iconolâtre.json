                    {
                        "sense_id": "f4e08a85-166c-34b1-a3be-9254ee4f0d42",
                        "entry_id": "28dfe54f-f54c-3738-aab8-199223e279bb",
                        "glosses": [
                            "Qui pratique l’iconolâtrie ou relève de cette pratique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f44028a-7b19-46a2-95c6-330ad49e6505",
                                "sense_id": "f4e08a85-166c-34b1-a3be-9254ee4f0d42",
                                "text": "Mais les choses avaient bien changé, et l’Église était devenue Iconolâtre, c’est-à-dire adoratrice d’images ; donc, les briseurs d’images, bien que tous les anciens Pères fussent de leur avis, étaient et sont restés hérétiques."
                            }
                        ]
                    }
                ],
