                ],
                "senses": [
                    {
                        "sense_id": "381dfe89-f58a-384d-8e11-1caf31e56a6f",
                        "entry_id": "bdaefdb3-dec0-3866-8820-2c38073c1ab9",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d64b787-f8f1-4f21-8ae1-052a94dfd366",
                                "sense_id": "381dfe89-f58a-384d-8e11-1caf31e56a6f",
                                "text": "Frau Kneisle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "2ae01648-152b-4996-b090-3f439adcdeee",
                                "sense_id": "381dfe89-f58a-384d-8e11-1caf31e56a6f",
                                "text": "Herr Kneisle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a32f32d7-58b4-45ca-b31d-be6c24ce27fd",
                                "sense_id": "381dfe89-f58a-384d-8e11-1caf31e56a6f",
                                "text": "Die Kneisles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "17e733f1-363b-4ebd-8f74-4b0be0d6aa41",
                                "sense_id": "381dfe89-f58a-384d-8e11-1caf31e56a6f",
                                "text": "Der Kneisle trägt nie die Schals, die die Kneisle ihm strickt."
                            },
                            {
                                "example_id": "d5923c35-62bb-4426-8a28-cf56211efd1e",
                                "sense_id": "381dfe89-f58a-384d-8e11-1caf31e56a6f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kneisle kommt, geht der Herr Kneisle.“"
                            },
                            {
                                "example_id": "daf5137f-271b-446a-b1e5-52697c237ecc",
                                "sense_id": "381dfe89-f58a-384d-8e11-1caf31e56a6f",
                                "text": "Kneisle kommt und geht."
                            },
                            {
                                "example_id": "c048a0c9-7a32-4e39-8b13-b81adf0558cd",
                                "sense_id": "381dfe89-f58a-384d-8e11-1caf31e56a6f",
                                "text": "Kneisles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
