                                "target_senses": [
                                    {
                                        "sense_id": "9d7e6f36-e069-3287-97c8-9bc4c24906b4",
                                        "entry_id": "106d1e76-ba2f-3d33-9ea9-9dec261666e8",
                                        "glosses": [
                                            "iemand die tot een bepaalde (rooms-katholieke) kerkelijke parochie behoort"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba714024-6eb1-421b-93d9-ba15dbaa282a",
                                                "sense_id": "9d7e6f36-e069-3287-97c8-9bc4c24906b4",
                                                "text": "‘Momenteel wordt de beiaard goed onderhouden. De beiaard kwam er in 1959 door een schenking van een parochiaan. In 1999 werd de beiaard gerestaureerd en nog steeds komt een beiaardier die geregeld bespelen. Maar de beiaard speelt ook zijn wijsje automatisch. Dat wijsje varieert per seizoen. De Wasteelsbeiaard kan je horen tijdens de wekelijkse marktdag op woensdag, op zondag en op feestdagen. Het is zalig om in mijn tuin te genieten van die mooie klanken van onze beiaard’, besluit pastoor Babylon."
                                            },
                                            {
                                                "example_id": "37447657-6199-4ff6-9ecf-fc2ac542c541",
                                                "sense_id": "9d7e6f36-e069-3287-97c8-9bc4c24906b4",
                                                "text": "Menig parochiaan heeft de datum al genoteerd: zondag 9 oktober om 16.00 uur in de Oldenzaalse Plechelmusparochie. Op die datum vindt in de basiliek de hoogmis Missa in Mysterium plaats met Herman Finkers als regisseur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2eb7521a-97ba-4bff-af3b-d12f8effd024",
                        "source_entry_id": "faeeebc9-feac-3db7-9249-f97cddd1ccab",
                        "source_sense_id": "b34ebf30-19c1-363b-a3b8-c70b53845b3f",
                        "source_sense_description": "member of a parish",
                        "target_lang_word": "paroissien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
