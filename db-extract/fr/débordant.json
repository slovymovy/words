                                "target_senses": [
                                    {
                                        "sense_id": "a8059103-0aae-31c0-ad6a-ecf23ffd97d7",
                                        "entry_id": "617912b8-8e6f-3905-ba15-f3a69d997186",
                                        "glosses": [
                                            "Not fitted with a bridle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baa19308-ea35-4f60-a566-d98d340be95b",
                                                "sense_id": "a8059103-0aae-31c0-ad6a-ecf23ffd97d7",
                                                "text": "an unbridled horse"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8c3bf44-3262-3b0e-bc84-d300f12d5215",
                                        "entry_id": "617912b8-8e6f-3905-ba15-f3a69d997186",
                                        "glosses": [
                                            "Without restraint or limit."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd333979-d52b-49ac-a4d1-aeebf9881188",
                                                "sense_id": "b8c3bf44-3262-3b0e-bc84-d300f12d5215",
                                                "text": "unbridled capitalism"
                                            },
                                            {
                                                "example_id": "ee55dfe2-eac8-453a-a269-c107fbae005a",
                                                "sense_id": "b8c3bf44-3262-3b0e-bc84-d300f12d5215",
                                                "text": "She jumped into the project with unbridled enthusiasm."
                                            },
                                            {
                                                "example_id": "96352ca2-262f-4088-bbdf-cb09f16e2f2f",
                                                "sense_id": "b8c3bf44-3262-3b0e-bc84-d300f12d5215",
                                                "text": "The doctor now interposed, and prevented the effects of a wrath which was kindling between Jones and Thwackum; after which the former gave a loose to mirth, sang two or three amorous songs, and fell into every frantic disorder which unbridled joy is apt to inspire […]"
                                            },
                                            {
                                                "example_id": "1d282b45-ac03-46e0-98ac-6f2ba2a0e1fc",
                                                "sense_id": "b8c3bf44-3262-3b0e-bc84-d300f12d5215",
                                                "text": "In a very precise voice, Miss Marley said to Jasper, \"No, Jasper, I would never submit myself to the unbridled transports of passion.\""
                                            },
                                            {
                                                "example_id": "ec6b07a4-f0d9-478b-8d0d-49fd1f58c111",
                                                "sense_id": "b8c3bf44-3262-3b0e-bc84-d300f12d5215",
                                                "text": "Unbridled competition between the different means of transport is eliminated by a licensing system, to which all transport concerns, whether by land or water, are subjected for both regular and occasional transport."
                                            },
                                            {
                                                "example_id": "b7ce91e0-0f39-4a52-bcbe-35ac02a83345",
                                                "sense_id": "b8c3bf44-3262-3b0e-bc84-d300f12d5215",
                                                "text": "His contempt was totally unbridled, as though my goal was a personal affront to him and all humanity."
                                            },
                                            {
                                                "example_id": "fa2aa003-14ba-4ca1-af13-489046cb2998",
                                                "sense_id": "b8c3bf44-3262-3b0e-bc84-d300f12d5215",
                                                "text": "Postecoglou, who said he would \"never be a clown\" in his pre-match address, brought smiles and unbridled joy to the faces of the 15,000 official, and many unofficial, Tottenham fans in Bilbao's San Mames Stadium."
                                            }
                                        ]
                                    }
                                ]
                            },
