{
    "word_family": [
        "dreunen",
        "gedreun",
        "dreuning"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "765fb8f7-1b01-343e-b9e0-b826052eb211",
                    "sense_definition": "een luid, laag en vaak trillend geluid",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er klonk een harde <w>dreun</w> toen het zware gevaarte plotseling op de grond omviel.",
                            "target_lang_translations": {
                                "en": "There was a loud <w>thud</w> when the heavy object suddenly fell to the ground."
                            }
                        },
                        {
                            "text": "De lage <w>dreun</w> van de bas was tot ver in de straat duidelijk te horen.",
                            "target_lang_translations": {
                                "en": "The low <w>thump</w> of the bass could be clearly heard far down the street."
                            }
                        }
                    ],
                    "synonyms": [
                        "knal",
                        "slag"
                    ],
                    "common_phrases": [
                        "lage dreun",
                        "doffe dreun"
                    ],
                    "target_lang_definitions": {
                        "en": "a loud, low, and often vibrating sound"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "thud",
                                "target_lang_sense_clarification": "a dull, heavy sound"
                            },
                            {
                                "target_lang_word": "boom",
                                "target_lang_sense_clarification": "a deep, resonant sound"
                            },
                            {
                                "target_lang_word": "thump",
                                "target_lang_sense_clarification": "a heavy, dull sound of impact"
                            },
                            {
                                "target_lang_word": "rumble",
                                "target_lang_sense_clarification": "a continuous deep sound"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10b08f80-3462-3b81-86c5-4a1e0d16efd3",
                    "sense_definition": "een krachtige fysieke slag of een emotionele schok",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij verkocht de gemene dief een harde <w>dreun</w> om zichzelf te kunnen verdedigen.",
                            "target_lang_translations": {
                                "en": "He gave the mean thief a hard <w>blow</w> to defend himself."
                            }
                        },
                        {
                            "text": "Het onverwachte nieuws van het faillissement was een flinke <w>dreun</w> voor het hele personeel.",
                            "target_lang_translations": {
                                "en": "The unexpected news of the bankruptcy was a major <w>blow</w> to the entire staff."
                            }
                        }
                    ],
                    "synonyms": [
                        "klap",
                        "mep",
                        "stomp",
                        "slag",
                        "opstopper"
                    ],
                    "common_phrases": [
                        "harde dreun",
                        "flinke dreun"
                    ],
                    "target_lang_definitions": {
                        "en": "a powerful physical blow or an emotional shock"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blow",
                                "target_lang_sense_clarification": "a hard hit or a sudden shock"
                            },
                            {
                                "target_lang_word": "bash",
                                "target_lang_sense_clarification": "a forceful impact or strike"
                            },
                            {
                                "target_lang_word": "thump",
                                "target_lang_sense_clarification": "a heavy blow with something blunt"
                            },
                            {
                                "target_lang_word": "shock",
                                "target_lang_sense_clarification": "a sudden emotional impact"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e0f218dc-2868-30d7-8ff3-e779d40b6243",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>dreunen</w>",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>dreun</w> de hele dag met mijn voeten op de houten vloer van de kamer.",
                            "target_lang_translations": {
                                "en": "I <w>stomp</w> my feet on the wooden floor of the room all day long."
                            }
                        },
                        {
                            "text": "Als ik de trap afloop, <w>dreun</w> ik altijd een beetje door het hele huis.",
                            "target_lang_translations": {
                                "en": "When I walk down the stairs, I always <w>thud</w> a bit through the whole house."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "first-person singular present of 'to thud' or 'to boom'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "thud",
                                "target_lang_sense_clarification": "making a heavy sound while moving"
                            },
                            {
                                "target_lang_word": "stomp",
                                "target_lang_sense_clarification": "walking with heavy steps"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c370e7ce-7877-3a4a-83b5-065ed93056e9",
                    "sense_definition": "gebiedende wijs van <w>dreunen</w>",
                    "learner_level": "B1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Dreun</w> niet zo hard op de deur als je midden in de nacht thuiskomt.",
                            "target_lang_translations": {
                                "en": "Don't <w>thump</w> so hard on the door when you come home in the middle of the night."
                            }
                        },
                        {
                            "text": "Loop rustig en <w>dreun</w> niet zo met je zware laarzen op de trap.",
                            "target_lang_translations": {
                                "en": "Walk quietly and don't <w>stomp</w> so much with your heavy boots on the stairs."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "imperative of 'to thud' or 'to boom'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "thud",
                                "target_lang_sense_clarification": "command to make a heavy sound"
                            },
                            {
                                "target_lang_word": "stomp",
                                "target_lang_sense_clarification": "command to walk heavily"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "629fa362-e1f9-3308-b6b7-0dab9c0cf669",
                    "sense_definition": "tweede persoon enkelvoud tegenwoordige tijd van <w>dreunen</w>",
                    "learner_level": "B1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>dreun</w> je zo hard met die hamer tegen de dunne muur?",
                            "target_lang_translations": {
                                "en": "Why are you <w>banging</w> so hard with that hammer against the thin wall?"
                            }
                        },
                        {
                            "text": "Als je zo hard loopt, <w>dreun</w> je door het hele kantoor heen.",
                            "target_lang_translations": {
                                "en": "If you walk that hard, you <w>thud</w> through the entire office."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "second-person singular present (inverted)"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "second-person singular present of 'to thud' or 'to boom' (inverted)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "thud",
                                "target_lang_sense_clarification": "making a heavy sound while moving"
                            },
                            {
                                "target_lang_word": "stomp",
                                "target_lang_sense_clarification": "walking with heavy steps"
                            }
                        ]
                    }
                }
            ]
        }
