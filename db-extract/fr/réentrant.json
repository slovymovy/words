                        "form_id": "9ffa6b75-bae2-47fc-a9a8-7ea2a7845823",
                        "entry_id": "d5d7d592-edf8-33f9-b076-5cd9b518f8e0",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "réentrantes"
                    },
                    {
                        "form_id": "fbc0792d-60e8-4de6-a759-9ea790f20d8f",
                        "entry_id": "d5d7d592-edf8-33f9-b076-5cd9b518f8e0",
                        "tags": [],
                        "form": "ré-entrant"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "aa5963ee-76ac-378d-8c80-be3ace320747",
                        "entry_id": "d5d7d592-edf8-33f9-b076-5cd9b518f8e0",
                        "glosses": [
                            "Se dit d’une séquence exécutable (programme, routine, méthode, etc.) qui peut être utilisée, simultanément ou de façon répétée, pour plusieurs tâches sans que le modèle original ne subisse aucune modification pendant leur exécution."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68b9e41e-c72d-4a60-9aa5-d65ab5132d7c",
                                "sense_id": "aa5963ee-76ac-378d-8c80-be3ace320747",
                                "text": "Code réentrant."
                            },
                            {
                                "example_id": "5bcce9cf-f796-4a3d-82a0-498efbd08b4b",
                                "sense_id": "aa5963ee-76ac-378d-8c80-be3ace320747",
                                "text": "Une fonction réentrante ne conserve pas de données statiques entre appels successifs, ne retourne pas de données statiques, et n’appelle pas de fonctions non-réentrantes ; par conséquent, elle peut être parcourue simultanément par plusieurs fils d’exécution sans que cela ne cause de problèmes."
                            }
                        ]
                    },
                    {
                        "sense_id": "a60f5761-4f80-3911-951d-002dc603ee29",
                        "entry_id": "d5d7d592-edf8-33f9-b076-5cd9b518f8e0",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7577a663-3d3b-47e4-a2a1-f8681c0d59fc",
                                "sense_id": "a60f5761-4f80-3911-951d-002dc603ee29",
                                "text": "La tachycardie sinusale réentrante est une tachycardie originaire du nœud sinusal d’où la même morphologie et la même séquence d’activation que l’onde P sinusale."
                            },
                            {
                                "example_id": "f8c3dc6f-6840-43d4-a2dd-2062659a996c",
                                "sense_id": "a60f5761-4f80-3911-951d-002dc603ee29",
                                "text": "La mesure historique (Phillipson 1952) de l’effluent d’une canule duodénale réentrante ouverte constitue la base des méthodes quantitatives de mesure du débit duodénal."
                            }
                        ]
                    },
                    {
                        "sense_id": "e3c3fef6-3d4b-3ad7-90ec-577f299edd36",
                        "entry_id": "d5d7d592-edf8-33f9-b076-5cd9b518f8e0",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "4b14c688-aee4-48a2-9639-cdc62f81693e",
                                "sense_id": "e3c3fef6-3d4b-3ad7-90ec-577f299edd36",
                                "text": "Les propriétés magnétiques de l’état réentrant (T ≲ 35 K) sont discutées dans le cadre d’un modèle introduit précédemment à propos des alliages cristallins AuFe et NiMn."
                            },
                            {
                                "example_id": "0c822cd4-9e0c-4ffb-bfb2-6f366c4a6e54",
                                "sense_id": "e3c3fef6-3d4b-3ad7-90ec-577f299edd36",
                                "text": "Les effets de temps et d’hystérésis de température sur l’aimantation ont été mesurés et présentent distinctement un comportement « verre de spin réentrant »."
                            }
                        ]
                    },
                    {
                        "sense_id": "54a2608c-08c7-3f7d-9a61-5746939a17ef",
                        "entry_id": "d5d7d592-edf8-33f9-b076-5cd9b518f8e0",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdd4de7d-ddd8-45e1-8e58-a6cb6ace8994",
                                "sense_id": "54a2608c-08c7-3f7d-9a61-5746939a17ef",
                                "text": "Moniteur de position à cavité radiofréquence réentrante."
                            },
                            {
                                "example_id": "9de5ba44-ad8f-46af-90c7-fa5f42a212ea",
                                "sense_id": "54a2608c-08c7-3f7d-9a61-5746939a17ef",
                                "text": "Une cavité résonante de type réentrant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e9e4a46a-5431-4056-9f60-fab52fb7b2e8",
                        "source_entry_id": "d5d7d592-edf8-33f9-b076-5cd9b518f8e0",
                        "source_sense_description": "Informatique",
                        "target_lang_word": "wiedereintrittsfähig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wiedereintrittsfähig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fecd03f3-d71f-3266-83cc-2344b0e6c380",
                                        "entry_id": "2e612299-60f2-383d-b166-723cfa9cffef",
                                        "glosses": [
                                            "von mehreren Prozessen oder Tasks ohne gegenseitige Beeinflussung gleichzeitig benutzbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "898d960c-04ee-4437-85c0-c7bc182284d1",
                                                "sense_id": "fecd03f3-d71f-3266-83cc-2344b0e6c380",
                                                "text": "„Vorteil dieser Methode ist, dass viele Systemfunktionen (z. B. die Ausgabe) nicht wiedereintrittsfähig sein müssen und daher nicht synchronisiert sein müssen, was eine erhebliche Vereinfachung für den Hersteller bedeutet.“"
                                            },
                                            {
                                                "example_id": "ca990db9-dc28-49a6-8d08-094475b911d8",
                                                "sense_id": "fecd03f3-d71f-3266-83cc-2344b0e6c380",
                                                "text": "„Der Code für Speicherallokation muss wiedereintrittsfähig sein.“"
                                            },
                                            {
                                                "example_id": "82bb038d-465b-4d12-bcb8-8f9e69957680",
                                                "sense_id": "fecd03f3-d71f-3266-83cc-2344b0e6c380",
                                                "text": "„Eine Zurückstellung des Taskwechsels kann dann erforderlich sein, wenn zum Zeitpunkt der Unterbrechung ein Systemdienst ausgeführt wurde, der nicht wiedereintrittsfähig implementiert wurde.“"
                                            },
                                            {
                                                "example_id": "f0d3bdcf-73b3-4234-a11c-b0fd6f63fb64",
                                                "sense_id": "fecd03f3-d71f-3266-83cc-2344b0e6c380",
                                                "text": "„Eine wiedereintrittsfähige Funktion kann auch rekursiv aufgerufen werden (die Funktion kann sich selbst aufrufen).“"
                                            },
                                            {
                                                "example_id": "aa0dae0e-d986-4a0b-bff6-3c23037a8300",
                                                "sense_id": "fecd03f3-d71f-3266-83cc-2344b0e6c380",
                                                "text": "„Eine Routine bzw. Methode wird als eintrittsinvariant (engl. reentrant) oder auch wiedereintrittsfähig bezeichnet, wenn sie so implementiert ist, dass sie von mehreren Prozessen gleichzeitig ausgeführt werden kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "99413e7e-bc9a-3985-afc2-42e2c89ef2bd",
                                        "entry_id": "2e612299-60f2-383d-b166-723cfa9cffef",
                                        "glosses": [
                                            "zum wiederholten Eintritt in die Atmosphäre geeignet"
                                        ],
                                        "tags": [
                                            "Raumfahrt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e6b878c-367d-4e5e-8921-afcd9e34a5e3",
                                                "sense_id": "99413e7e-bc9a-3985-afc2-42e2c89ef2bd",
                                                "text": "„Aufgrund seines Puls-Prinzips ist PulCheR ein zwar diskontinuierlich aber hochfrequent arbeitendes Antriebssystem, das das Potenzial hat, viele derzeit verwendete Antriebskonzepte sowohl im Bereich Orbital-Flüge und inter-planetare Missionen als auch bei wiedereintrittsfähigen Raumfahrzeugen zu ersetzen.“"
                                            },
                                            {
                                                "example_id": "4034a550-0e1a-453e-b97a-1a7521afbf18",
                                                "sense_id": "99413e7e-bc9a-3985-afc2-42e2c89ef2bd",
                                                "text": "„Den Forschern zufolge hat er das Potenzial, viele konventionelle Antriebskonzepte sowohl im Bereich Orbital-Flüge und interplanetare Missionen als auch bei wiedereintrittsfähigen Raumfahrzeugen zu ersetzen.“"
                                            },
                                            {
                                                "example_id": "0d20ca52-f276-49dd-9da5-095f636681c7",
                                                "sense_id": "99413e7e-bc9a-3985-afc2-42e2c89ef2bd",
                                                "text": "„Die am 22. April 2010 UTC, 23. April 2010, um 01:52 Uhr MESZ auf einer Atlas V gestartete X 37B, so Lt. Col. Troy Giese, X-37B-Programm-Manager, sei das neueste und fortschrittlichste wiedereintrittsfähige Raumfahrzeug.“"
                                            },
                                            {
                                                "example_id": "684025af-68e5-4082-980e-053a9fffb5a1",
                                                "sense_id": "99413e7e-bc9a-3985-afc2-42e2c89ef2bd",
                                                "text": "„Für den Lastentransport gibt es seit den 80er-Jahren die automatisch gesteuerten \"Progress\"-Module, die allerdings nicht wiedereintrittsfähig sind.“"
                                            },
                                            {
                                                "example_id": "df691558-d328-4c3b-8f4e-8c961a8cb48c",
                                                "sense_id": "99413e7e-bc9a-3985-afc2-42e2c89ef2bd",
                                                "text": "„Die Daten, die durch diese Analysen der zahlreichen Systeme des IXV gewonnen werden, sollen die Entwicklung von zukünftigen wiedereintrittsfähigen Raumfahrzeugen der ESA erleichtern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3da2923-af68-4148-8a8f-ab0ce3fe3a6c",
                        "source_entry_id": "d5d7d592-edf8-33f9-b076-5cd9b518f8e0",
