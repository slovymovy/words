                        ]
                    },
                    {
                        "translation_id": "f34cf35b-0dee-4fd0-bf46-beada5c78dc3",
                        "source_entry_id": "ed3f0ba9-fa9d-3430-813d-781521525f58",
                        "source_sense_id": "32f574c4-6796-31df-9100-6c652cf23cc9",
                        "target_lang_word": "Genitiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Genitiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b6be7ff3-fd2c-35eb-bbc2-4746e9072e68",
                                        "entry_id": "29b3f3b9-ca19-3299-b45a-8c765ff99ab6",
                                        "glosses": [
                                            "Wes-Fall, (im Deutschen und Lateinischen) 2. Fall (Kasus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "662e04aa-b13c-4293-910f-b7972447bf08",
                                                "sense_id": "b6be7ff3-fd2c-35eb-bbc2-4746e9072e68",
                                                "text": "Der besitzanzeigende Genitiv (Genitivus possessivus) drückt aus, wessen Eigentum eine Sache ist."
                                            },
                                            {
                                                "example_id": "f85bfb7b-54d1-436b-a663-cbf9dae12429",
                                                "sense_id": "b6be7ff3-fd2c-35eb-bbc2-4746e9072e68",
                                                "text": "„In letzter Zeit konnte man viele Klagen über den Verlust des Genitivs vernehmen […].“"
                                            },
                                            {
                                                "example_id": "212554bd-0ca1-4293-bd24-57439189ad86",
                                                "sense_id": "b6be7ff3-fd2c-35eb-bbc2-4746e9072e68",
                                                "text": "„Der Genitiv kann eine Reihe von unterschiedlichen sprachlichen Leistungen erfüllen…“"
                                            },
                                            {
                                                "example_id": "675a9b46-6393-43c7-ade2-5126f3c117e0",
                                                "sense_id": "b6be7ff3-fd2c-35eb-bbc2-4746e9072e68",
                                                "text": "„Unsere Eltern belegten einen Sprachkurs nach dem anderen, sie lernten unaufhörlich Vokabeln, sie waren irritiert, wenn sie merkten, dass die deutschen Nachbarn Dativ statt Genitiv benutzten, und schauten daheim in ihren Lehrbüchern nach.“"
                                            },
                                            {
                                                "example_id": "2ed64743-b427-45b0-8c74-5f452c6ec077",
                                                "sense_id": "b6be7ff3-fd2c-35eb-bbc2-4746e9072e68",
                                                "text": "„Der Genitiv ist auf vielen Feldern auf dem Rückzug und wird durch den Dativ ersetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c53c30be-66f9-4058-b9b6-0381867f27fc",
                        "source_entry_id": "ed3f0ba9-fa9d-3430-813d-781521525f58",
                        "source_sense_id": "32f574c4-6796-31df-9100-6c652cf23cc9",
                        "target_lang_word": "genitief",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "genitief",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a2dc4013-3b52-3479-85b0-166ddfaf37ff",
                                        "entry_id": "2e4d595f-3c01-3e96-8e29-73f7143fe1b2",
                                        "glosses": [
                                            "een van de acht naamvallen van de Indo-Europese talen die oorspronkelijk een oorzakelijk voorwerp aanduidde, later vooral een bezitsrelatie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a03a1c1-d0fd-481b-8255-b617fdfbeecc",
                                                "sense_id": "a2dc4013-3b52-3479-85b0-166ddfaf37ff",
                                                "text": "De genitief is de tweede naamval in de meeste Europese talen en wordt gebruikt om aan te geven van wie of wat iets is."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5647d07f-ced9-4b58-8374-c0b72bd96437",
                        "source_entry_id": "ed3f0ba9-fa9d-3430-813d-781521525f58",
                        "source_sense_id": "32f574c4-6796-31df-9100-6c652cf23cc9",
                        "target_lang_word": "génitif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "génitif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "46e82589-3daa-30c6-a724-36c551eba354",
                                        "entry_id": "ca69f2ca-e2bf-356e-a6a5-3e465db50078",
                                        "glosses": [
                                            "Relatif au génitif, cas de déclinaison."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "génitif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de843d0b-ba56-3a74-9dd1-700e391e575c",
                                        "entry_id": "2322af0c-bdf2-3c00-92c5-7963114eca57",
                                        "glosses": [
                                            "Cas grammatical servant principalement à marquer l’appartenance, la dépendance. Correspond souvent en français au complément du nom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef3f4ebe-9a99-4156-a8b0-cbf034c072f9",
                                                "sense_id": "de843d0b-ba56-3a74-9dd1-700e391e575c",
                                                "text": "Pour cela, on utilise la désinence du génitif singulier : elle permet d’une part de rattacher le nom à l’un des cinq modèles de déclinaison, et d’autre part d’identifier le radical du mot (qui sera ensuite indispensable à la manipulation morphologique)."
                                            },
                                            {
                                                "example_id": "97921224-8c62-4636-a441-35fc249ff177",
                                                "sense_id": "de843d0b-ba56-3a74-9dd1-700e391e575c",
                                                "text": "Il lut triomphalement la phrase : « Par une belle matinée de mai, une svelte amazone montée sur une somptueuse jument alezane parcourait les allées pleines de fleurs du Bois de Boulogne ». Mais lus à haute voix, les trois génitifs qui terminaient la phrase, résonnèrent fâcheusement, et Grand bégaya un peu. Il s’assit, l’air accablé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
