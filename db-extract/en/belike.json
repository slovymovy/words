        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c460ae8f-dec0-3f29-9420-3572315e8fa3",
                "word": "belike",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "47aabaa3-5f69-3221-b915-f3ef4e839bd1",
                        "entry_id": "c460ae8f-dec0-3f29-9420-3572315e8fa3",
                        "glosses": [
                            "Likely, probably, perhaps, haply."
                        ],
                        "tags": [
                            "Northern-England",
                            "archaic",
                            "dialectal",
                            "especially",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "eabbad22-88c3-4e01-8022-a9a7ca88b691",
                                "sense_id": "47aabaa3-5f69-3221-b915-f3ef4e839bd1",
                                "text": "It seems, you lov'd not her, to leave her token: / She's dead, belike."
                            },
                            {
                                "example_id": "265ff742-4f92-4286-b2f8-6ba2cf9b862b",
                                "sense_id": "47aabaa3-5f69-3221-b915-f3ef4e839bd1",
                                "text": "For that reason, belike, Homer feigns the three Graces to be linked and tied hand in hand, because the hearts of men are so firmly united with such graces."
                            },
                            {
                                "example_id": "e57d50ab-bb1d-46c9-97e5-4410599e9dc5",
                                "sense_id": "47aabaa3-5f69-3221-b915-f3ef4e839bd1",
                                "text": "Upon this he brought me a cotton bag and giving it to me, said, \"Take this bag and fill it with pebbles from the beach and go forth with a company of the townsfolk to whom I will give a charge respecting thee. Do as they do and belike thou shalt gain what may further thy return voyage to thy native land.\""
                            },
                            {
                                "example_id": "094d64b0-f3e3-41c6-b118-8512e3f3d5fb",
                                "sense_id": "47aabaa3-5f69-3221-b915-f3ef4e839bd1",
                                "text": "And when the pedants bade us mark / What cold mechanic happenings / Must come; our souls said in the dark, / \"Belike; but there are likelier things.\""
                            },
                            {
                                "example_id": "91921eed-8370-440b-a675-156d77fe23bd",
                                "sense_id": "47aabaa3-5f69-3221-b915-f3ef4e839bd1",
                                "text": "Some night-bird, belike, or a sea-gull squalling below the headland."
                            },
                            {
                                "example_id": "3bd6926e-84fb-4b39-9cb2-f9bd2f187b3e",
                                "sense_id": "47aabaa3-5f69-3221-b915-f3ef4e839bd1",
                                "text": "Princess Scarlet fanned herself with the Chinese fan that Supply had provided and, turning to Achmed Ali, said in formal tones, \"Belike, sir, I've not seen thy match for overall all-in dancing eftsoons."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
