        "fr-extract.jsonl": [
            {
                "entry_id": "0b7ea043-6f6d-36c6-b558-85cced53bee8",
                "word": "chronologiquement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "25a30882-6efe-36a9-b8ee-0d3a6015e031",
                        "entry_id": "0b7ea043-6f6d-36c6-b558-85cced53bee8",
                        "glosses": [
                            "D’une manière chronologique ; dans l’ordre des temps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9a9ad88-9069-4df9-86cf-93e8f91e37e2",
                                "sense_id": "25a30882-6efe-36a9-b8ee-0d3a6015e031",
                                "text": "Mis au point dans les années 1980, le montage virtuel est non linéaire et permet de placer n’importe quel plan dans n’importe quel ordre sans que le monteur soit obligé de revoir chronologiquement toutes les séquences montées."
                            },
                            {
                                "example_id": "4b345e6f-80c4-481b-9b6b-276cb1461a93",
                                "sense_id": "25a30882-6efe-36a9-b8ee-0d3a6015e031",
                                "text": "Or, en tant que telles, les études postcoloniales sont plus encore idéologiquement postnationalistes que chronologiquement postcoloniales."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7576ec17-edc1-4582-b1e3-f32ecf769219",
                        "source_entry_id": "0b7ea043-6f6d-36c6-b558-85cced53bee8",
                        "source_sense_id": "25a30882-6efe-36a9-b8ee-0d3a6015e031",
                        "target_lang_word": "chronologically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chronologically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99de1f50-5e17-334f-bd7d-45a738f8c45e",
                                        "entry_id": "3be31052-1c52-38c6-840f-450d4eb12b0a",
                                        "glosses": [
                                            "In a chronological manner; with reference to time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c3f5bcc-1572-4602-b751-b25d1d713752",
                                                "sense_id": "99de1f50-5e17-334f-bd7d-45a738f8c45e",
                                                "text": "He had aged but a year chronologically, but in appearance a decade."
                                            },
                                            {
                                                "example_id": "7c9c479e-48d4-4387-a1e1-3113eef048e0",
                                                "sense_id": "99de1f50-5e17-334f-bd7d-45a738f8c45e",
                                                "text": "Moreover, the term [...] is well recorded in British and Australian sources from the 1840s onwards, while the earliest Anglo-Indian evidence only extends as far back as 1865 and so does not hold precedence. Thus, deriving the term from Hindustani is not chronologically admissible on present evidence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd807ee3-86f4-3895-ad40-9469bfa13115",
                                        "entry_id": "3be31052-1c52-38c6-840f-450d4eb12b0a",
                                        "glosses": [
                                            "In sequence according to time."
                                        ],
                                        "tags": [
                                            "sequence"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa0116b8-e1c7-4a2e-be6c-0c0fba38be88",
                                                "sense_id": "fd807ee3-86f4-3895-ad40-9469bfa13115",
                                                "text": "His chapters are arranged thematically, not chronologically."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
