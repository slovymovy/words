            "senses": [
                {
                    "sense_id": "3f94412c-6eb1-3ceb-828c-6a99008863ce",
                    "sense_definition": "An alternative form of <w>wienie</w>, referring to a small sausage or hot dog.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We roasted a <w>weenie</w> over the campfire and ate it with mustard.",
                            "target_lang_translations": {
                                "ru": "Мы пожарили <w>сосиску</w> на костре и съели её с горчицей."
                            }
                        },
                        {
                            "text": "The kids love eating a grilled <w>weenie</w> in a bun during summer barbecues.",
                            "target_lang_translations": {
                                "ru": "Детям очень нравится есть поджаренную на гриле <w>сосисочку</w> в булочке во время летних барбекю."
                            }
                        }
                    ],
                    "common_phrases": [
                        "roast a weenie",
                        "grilled weenie"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in informal spoken English, especially by or to children."
                        }
