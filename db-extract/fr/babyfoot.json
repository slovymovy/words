                        "glosses": [
                            "Jeu de simulation de football (au sens européen), joué de part et d’autre d’une table creuse, où les joueurs tentent de marquer des buts avec une petite balle en actionnant des joueurs miniatures montés sur des barres mobiles."
                        ],
                        "tags": [
                            "Faux anglicisme"
                        ],
                        "examples": [
                            {
                                "example_id": "f85b9a8a-8cc9-45d2-adf2-afeec422f8bf",
                                "sense_id": "6d7676d0-d359-3c3e-b37d-e164e1670150",
                                "text": "On se fait une partie de babyfoot ?"
                            },
                            {
                                "example_id": "786a5651-a9ac-4d28-9d73-013226b044a6",
                                "sense_id": "6d7676d0-d359-3c3e-b37d-e164e1670150",
                                "text": "Le babyfoot, d’ordinaire collé contre le mur, semble en lévitation au milieu, saisi par quatre paires de mains."
                            }
                        ]
                    }
                ],
