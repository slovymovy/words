                        "source_sense_id": "fa5bc9a1-372f-3155-9f42-f0aa467b694c",
                        "target_lang_word": "юмореска",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "юмореска",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "db3252f6-35f7-3ae1-8617-6cda5fa86806",
                                        "entry_id": "2b5862d0-30b4-3bc1-b497-478c2c091a49",
                                        "glosses": [
                                            "филол., искусств. небольшое литературно-художественное или музыкальное произведение, проникнутое юмором, имеющее шутливый, юмористический характер"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca1c2be6-4891-45bb-ad11-b5626cbe707f",
                                                "sense_id": "db3252f6-35f7-3ae1-8617-6cda5fa86806",
                                                "text": "Это, так сказать, внешняя маска сервантесовского романа, и так как нигде, как в «Дон-Кихоте», Штраус постарался проявить себя мастером внешней изобразительности, то поэтому вся поэма являет собой скорей блестящий курьёз, полную виртуозности великолепную музыкальную юмореску, чем действительно поэму могущую быть отнесённой к героическому циклу."
                                            },
                                            {
                                                "example_id": "501dd565-a4b6-4b56-a3e6-0eaf5df6e245",
                                                "sense_id": "db3252f6-35f7-3ae1-8617-6cda5fa86806",
                                                "text": "Усвоил и написал за долгую творческую жизнь семнадцать рассказов про тёщу, двадцать три юморески про стоматолога и сорок семь фельетонов про алкаша-сантехника."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
