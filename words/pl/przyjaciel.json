                },
                {
                    "sense_id": "a6327349-b8fd-36ac-8ef4-ef5a6c4f5c05",
                    "sense_definition": "Zwrot do mężczyzny używany w bezpośredniej rozmowie, często z odcieniem poufałości, ironii lub ostrzeżenia",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Słuchaj, <w>przyjacielu</w>, nie możesz tutaj parkować samochodu.",
                            "target_lang_translations": {
                                "ru": "Послушай, <w>приятель</w>, ты не можешь парковать здесь машину.",
                                "de": "Hör mal, <w>Freund</w>, du darfst hier nicht parken."
                            }
                        },
                        {
                            "text": "Witaj, mój drogi <w>przyjacielu</w>, dawno cię nie widziałem!",
                            "target_lang_translations": {
                                "ru": "Здравствуй, мой дорогой <w>друг</w>, давно тебя не видел!",
                                "de": "Hallo, mein lieber <w>Freund</w>, ich habe dich schon lange nicht mehr gesehen!"
                            }
