                    }
                ],
                "senses": [
                    {
                        "sense_id": "2ce7314b-12e7-3196-89a6-40f2bb86fc47",
                        "entry_id": "8de4a28e-5a7b-35c2-87ef-7649b0bd85fe",
                        "glosses": [
                            "Erhöhung der Einwohnerzahl durch das Hinzukommen von Ortsfremden, Ausländern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1f47054-bba7-42a3-9581-020af5fb2b0c",
                                "sense_id": "2ce7314b-12e7-3196-89a6-40f2bb86fc47",
                                "text": "„Die Volksabstimmung vom Sonntag mit ihrer knappen Mehrheit von 50,3 Prozent der Wähler gegen »Masseneinwanderung« und für eine Begrenzung des Zuzugs von Ausländern hat weltweit Aufmerksamkeit erregt.“"
                            },
                            {
                                "example_id": "b73543ae-29f0-4326-a51f-fefdf199d760",
                                "sense_id": "2ce7314b-12e7-3196-89a6-40f2bb86fc47",
                                "text": "„Der Zuzug ins Königreich Jerusalem aus der Alten Welt war nicht alles - die jungen Kreuzfahrerstaaten strahlten auch auf die urchristlichen Orte und Gegenden der Umgebung aus, sie zogen orientalische Christen in ihre Burgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7d4fb6c8-d7ec-374e-9427-50b2c5edbf32",
                        "entry_id": "8de4a28e-5a7b-35c2-87ef-7649b0bd85fe",
                        "glosses": [
                            "personelle Verstärkung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "323738d9-32ca-451b-84d0-0391be943848",
                                "sense_id": "7d4fb6c8-d7ec-374e-9427-50b2c5edbf32",
                                "text": "„Nachdem sein Heer starken Zuzug bekommen hatte, gelang es ihm, die ‚Dreißig‘ zu schlagen und den Piräus und die Munichia zu besetzen, wobei Kritias den Tod fand.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
