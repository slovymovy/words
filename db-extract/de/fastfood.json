                "senses": [
                    {
                        "sense_id": "643b894d-f549-362d-8c45-64ec13d904c8",
                        "entry_id": "43bd2bf2-033c-3000-9244-5b0bb53b015f",
                        "glosses": [
                            "Gastronomie, Essen, das schnell zubereitet, serviert und verzehrt wird"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "5fa3b3d9-0a38-45fa-ba9f-2ee838a57411",
                                "sense_id": "643b894d-f549-362d-8c45-64ec13d904c8",
                                "text": "„Beinahe alles schmeckt dort so herausragend, dass ein mit Fastfood aufgewachsener Ausländer einen Kulturschock bekommt, wenn er mit der kaukasischen Küche in Berührung kommt.“"
                            },
                            {
                                "example_id": "540e5cf3-9fb5-40ae-a069-727ce293ba0a",
                                "sense_id": "643b894d-f549-362d-8c45-64ec13d904c8",
                                "text": "„Überhaupt ist Fastfood das wichtigste Essen der Isländer.“"
                            },
                            {
                                "example_id": "fe70d982-c204-4f3d-a95c-5eabcd36b6c2",
                                "sense_id": "643b894d-f549-362d-8c45-64ec13d904c8",
                                "text": "„Die Hanse hatte sogar beliebtes Fastfood à la McDonald's im Angebot: den Stockfisch.“"
                            }
                        ],
