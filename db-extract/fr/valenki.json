                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "be721cce-8615-3e5f-bd81-f8a8c63c1d1e",
                                        "entry_id": "9059ecf0-bd3d-33eb-a887-8255e2c330aa",
                                        "glosses": [
                                            "комп. жарг. пробка из ворса и пыли, образующаяся в системах вентиляции и воздушного охлаждения"
                                        ],
                                        "tags": [],
