                "senses": [
                    {
                        "sense_id": "03793151-f2fc-3850-adb5-1b2d47ea9a36",
                        "entry_id": "d9812a07-f780-3726-b6ce-117ae34e9e4f",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3e74d92-0429-4c10-a6be-2af5f03cd6d0",
                                "sense_id": "03793151-f2fc-3850-adb5-1b2d47ea9a36",
                                "text": "Der Glaß trägt nie die Schals, die die Glaß ihm strickt."
                            },
                            {
                                "example_id": "71ecacc1-f3ea-4e8b-89e2-f7ccab4da9e0",
                                "sense_id": "03793151-f2fc-3850-adb5-1b2d47ea9a36",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Glaß kommt, geht der Herr Glaß.“"
                            },
                            {
                                "example_id": "6ca489ea-b777-4e04-ac1c-309c2115eb09",
                                "sense_id": "03793151-f2fc-3850-adb5-1b2d47ea9a36",
                                "text": "Glaß kommt und geht."
                            },
                            {
                                "example_id": "ffc1cf28-3a0f-4c2c-ad14-104b609ee2a5",
                                "sense_id": "03793151-f2fc-3850-adb5-1b2d47ea9a36",
                                "text": "Glaßens kamen, sahen und siegten."
                            },
                            {
                                "example_id": "08c3392b-eb28-494e-9ebd-53c86cf77a5f",
                                "sense_id": "03793151-f2fc-3850-adb5-1b2d47ea9a36",
                                "text": "Frau Glaß ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c4d11b11-2550-4240-b1ad-ef67e679d31b",
                                "sense_id": "03793151-f2fc-3850-adb5-1b2d47ea9a36",
                                "text": "Herr Glaß wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "90dd6ca2-458e-49d2-8786-f6a267e1106b",
                                "sense_id": "03793151-f2fc-3850-adb5-1b2d47ea9a36",
                                "text": "Die Glaß fahren heute nach Jena."
                            }
                        ],
                        "sense_index_json": "\"1\""
