                },
                {
                    "sense_id": "d3872b4a-59e2-346b-bae5-f656d56c94ec",
                    "sense_definition": "in Bezug auf Materialien oder Stoffe: im natürlichen, noch nicht industriell oder handwerklich verarbeiteten Zustand befindlich",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ein <w>roher</w> Diamant entfaltet erst durch einen präzisen Schliff seine volle Schönheit."
