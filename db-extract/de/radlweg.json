                "senses": [
                    {
                        "sense_id": "ccf7c7f0-d6b8-33d9-9b81-bb92795dcabe",
                        "entry_id": "b4997460-e6bb-34ce-85af-1bb1fb50b16b",
                        "glosses": [
                            "speziell für Fahrradfahrer ausgebauter und reservierter Weg/Fahrstreifen"
                        ],
                        "tags": [
                            "Austrian German",
                            "Swiss Standard German",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "7c7295f0-15de-4b37-aa9e-eadcff324333",
                                "sense_id": "ccf7c7f0-d6b8-33d9-9b81-bb92795dcabe",
                                "text": "„Bürgermeister Ludwig Maurer hofft, dass noch heuer mit dem Bau eines Radlweges entlang der B 12 nach Maitenbeth […] begonnen werden kann.“"
                            },
                            {
                                "example_id": "1f3430cf-f7cc-4941-b122-a9a528bc7018",
                                "sense_id": "ccf7c7f0-d6b8-33d9-9b81-bb92795dcabe",
                                "text": "„Bayerns Innenminister […] setzt sich für mehr Radverkehrssicherheit ein: Konsequente Kontrollen, mehr Radlstreifen der Polizei, Ausbau der Radlwege - Appell für mehr Rücksichtnahme[.]“"
                            },
                            {
                                "example_id": "f6fc7a72-3303-45ba-a571-b0b4be0e067a",
                                "sense_id": "ccf7c7f0-d6b8-33d9-9b81-bb92795dcabe",
                                "text": "„\"Ungefähr 100 Meter vom Haus entfernt beginnt ein toller Radlweg, der gemütlich bergab nach Mattersburg führt\", […]“"
                            },
                            {
                                "example_id": "d76f5c3c-9ec5-4d86-90ee-9c40547ca94c",
                                "sense_id": "ccf7c7f0-d6b8-33d9-9b81-bb92795dcabe",
                                "text": "„Rückbau von Radwegen in Tempo-30 Zonen in München! Damit dürften sich die Referenten nicht nur Freunde gemacht haben, schließlich werden die Rufe für eine Fahrrad-freundliche Stadt mit mehr Radlwegen“"
                            },
                            {
                                "example_id": "e4326bee-03f1-4e8b-9670-5f0c476c98ca",
                                "sense_id": "ccf7c7f0-d6b8-33d9-9b81-bb92795dcabe",
                                "text": "„23 Kilometer flacher Radlweg entlang des Sees sind auch für Un-Sportis wie mich zu machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
