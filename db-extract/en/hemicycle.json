                ],
                "translations": [
                    {
                        "translation_id": "c58885b1-0dcf-46a0-ae1c-36d946e95d91",
                        "source_entry_id": "7cefcb97-93c2-3db2-bb32-5af38bf80d4c",
                        "source_sense_description": "semicircle — see also semicircle",
                        "target_lang_word": "hémicycle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hémicycle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "128f248e-31c4-32f0-82a9-42eecbc9e0c2",
                                        "entry_id": "73d8c315-8a0d-395a-a1e3-33a438051025",
                                        "glosses": [
                                            "Lieu en demi-cercle, amphithéâtre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "900a2e70-71c4-45a9-b474-1dec84684cce",
                                                "sense_id": "128f248e-31c4-32f0-82a9-42eecbc9e0c2",
                                                "text": "Nous nous pressions avec un battement de cœur dans l’hémicycle de l'École des Beaux-Arts, où M. Taine enseignait pendant les quatre mois d'hiver."
                                            },
                                            {
                                                "example_id": "a6c6728a-eeaa-4e0c-8bf1-fe8ecef9843e",
                                                "sense_id": "128f248e-31c4-32f0-82a9-42eecbc9e0c2",
                                                "text": "Je suis assise dans l’hémicycle désolé et j’y ai cueilli une grenade que l’insouciant été n’a pas mûrie."
                                            },
                                            {
                                                "example_id": "0c6d9ba8-3b72-47f3-9c49-4bc451a3bcf0",
                                                "sense_id": "128f248e-31c4-32f0-82a9-42eecbc9e0c2",
                                                "text": "Il entrait dans le flanc d’une avenue se terminant en une sorte d’hémicycle que meublait un maître-autel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18d402db-ba8a-389d-b6f1-f81e6a15a8f4",
                                        "entry_id": "73d8c315-8a0d-395a-a1e3-33a438051025",
                                        "glosses": [
                                            "Salle plénière de la chambre des députés de la République française."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b16b19e-9916-4db1-bbd9-f5000ee6e484",
                                                "sense_id": "18d402db-ba8a-389d-b6f1-f81e6a15a8f4",
                                                "text": "De la tribune, où je suis monté pour adresser à l'Assemblée le salut du gouvernement, je vois l’hémicycle rempli de compagnons délégués par tous les mouvements de la résistance nationale et appartenant à toutes les tendances de l'opinion."
                                            },
                                            {
                                                "example_id": "cd120324-b976-4156-bde7-7c92dee21b38",
                                                "sense_id": "18d402db-ba8a-389d-b6f1-f81e6a15a8f4",
                                                "text": "François Cormier-Bouligeon s’est adressé en anglais à l’avocate depuis l’hémicycle, lançant : « The french national Assembly supports you » (« L’Assemblée nationale française vous soutient »)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b669cc3e-9565-374b-abd2-b14ec6fc3811",
                                        "entry_id": "73d8c315-8a0d-395a-a1e3-33a438051025",
                                        "glosses": [
                                            "Dispositif en bois qui sert à soutenir les pierres d’une voûte en construction."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5388699-f517-4239-aede-cbce8d27ae54",
                        "source_entry_id": "7cefcb97-93c2-3db2-bb32-5af38bf80d4c",
                        "source_sense_description": "semicircle — see also semicircle",
                        "target_lang_word": "Halbkreis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Halbkreis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d8aa8c1f-4737-3fad-ab58-8239296ce4b1",
                                        "entry_id": "2b0dcb0a-01e9-3b6f-ba32-77bff9b47dc7",
                                        "glosses": [
                                            "durch den Durchmesser begrenzte Hälfte eines Kreises"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37e3259b-c6f2-4b91-97ae-0d6c569ad604",
                                                "sense_id": "d8aa8c1f-4737-3fad-ab58-8239296ce4b1",
                                                "text": "Bei praktischen Demonstrationen im Chemiekabinett stellen sich die Schüler alle im Halbkreis um den Lehrer auf, so dass jeder den gleichen Abstand zu diesem hat und gut sehen kann."
                                            },
                                            {
                                                "example_id": "1b55aab8-8d06-43c4-9597-26e40976ccf0",
                                                "sense_id": "d8aa8c1f-4737-3fad-ab58-8239296ce4b1",
                                                "text": "„Unten am Strand schützte Alf die Seinen vor der Flut durch hohe Wälle aus Sand, die in einem Halbkreis an die rote alte Ufermauer stießen.“"
                                            },
                                            {
                                                "example_id": "5c72278c-79f7-49cd-870f-53d9a08c63ce",
                                                "sense_id": "d8aa8c1f-4737-3fad-ab58-8239296ce4b1",
                                                "text": "„Vor dem Hotel Abdulla – auf dem Trottoir – saßen Männer im Halbkreis, rauchten Wasserpfeifen und tranken Türkischen aus kleinen, runden Tassen.“"
                                            },
                                            {
                                                "example_id": "00d7c675-d8ec-4d70-9fa1-eb986f9a33f7",
                                                "sense_id": "d8aa8c1f-4737-3fad-ab58-8239296ce4b1",
                                                "text": "„Er gab es auf, das Auf und Nieder seiner Promenade noch weiterfortzusetzen, und beschrieb lieber einen Halbkreis um den Fuß des Schloßhügels herum, bis er in Front des Schlosses selber war.“"
                                            },
                                            {
                                                "example_id": "5ed78533-48b4-42c5-9897-d71f788c734a",
                                                "sense_id": "d8aa8c1f-4737-3fad-ab58-8239296ce4b1",
                                                "text": "„Die Gruppe stand nun im Halbkreis um Roberts Tisch versammelt, der den Aufzug nicht ohne Verlegenheit betrachtet hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b39bca37-3d13-425d-ac3f-febd0ec21b0e",
                        "source_entry_id": "7cefcb97-93c2-3db2-bb32-5af38bf80d4c",
