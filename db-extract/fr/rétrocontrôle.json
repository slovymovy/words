                "senses": [
                    {
                        "sense_id": "badba426-4060-3746-833c-e1392bbf3644",
                        "entry_id": "d2ba974f-d3fc-37f4-bc9f-41bd0e966ef8",
                        "glosses": [
                            "Mécanisme de régulation par lequel le produit ou le résultat d’une voie biologique ou hormonale module l’activité de cette même voie."
                        ],
                        "tags": [
                            "Endocrinologie"
                        ],
                        "examples": [
                            {
                                "example_id": "e95d8ffd-3937-463b-bb46-1eab6dd51c60",
                                "sense_id": "badba426-4060-3746-833c-e1392bbf3644",
                                "text": "Le plus souvent l’inhibiteur est le propre produit de l’activité enzymatique ou un analogue chimique. On parle alors de rétrocontrôle."
                            },
                            {
                                "example_id": "da69acdb-3675-4bf8-a8cd-211379120e6e",
                                "sense_id": "badba426-4060-3746-833c-e1392bbf3644",
                                "text": "Chez la femelle, les hormones ovariennes, œstrogènes et progestérone, exercent un rétrocontrôle sur les cellules productrices de GnRH, FSH et LH …."
                            },
                            {
                                "example_id": "7c7f7701-650a-42f3-aa55-d25a7e3b6f0d",
                                "sense_id": "badba426-4060-3746-833c-e1392bbf3644",
                                "text": "Une boucle de rétrocontrôle négatif est un système régulateur qui agit pour maintenir le niveau d’une variable dans un intervalle donné, à la suite d’une perturbation."
                            }
                        ]
                    },
                    {
                        "sense_id": "e6cd21b4-9d45-355e-85d8-22af07af5728",
                        "entry_id": "d2ba974f-d3fc-37f4-bc9f-41bd0e966ef8",
                        "glosses": [
                            "Boucle de régulation du langage oral ou du chant, dans laquelle la voix entendue influence la production vocale."
                        ],
                        "tags": [
                            "Phonétique"
                        ],
                        "examples": [
                            {
                                "example_id": "0d47e14a-68cb-409c-a305-38f454d42a35",
                                "sense_id": "e6cd21b4-9d45-355e-85d8-22af07af5728",
                                "text": "La boucle audio-phonatoire est un processus de rétrocontrôle de la voix parlée et chantée."
                            }
                        ]
                    }
                ],
