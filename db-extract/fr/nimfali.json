                        "glosses": [
                            "Petit instrument du genre orgue qui s’attache au corps par des courroies, la main gauche faisant agir le soufflet, la main droite le clavier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccac97e5-45b7-4553-a091-252b770efbd6",
                                "sense_id": "8e449e97-287e-3e69-b94c-fecb4b88dde5",
                                "text": "Que les musiciens s’attachaient au corps par des courroies, pour les jouer d’une main, tandis qu’ils faisaient mouvoir le soufflet de l’autre les dimensions de leur clavier étaient beaucoup plus petites, et la main étendue pouvait embrasser l’espace d’une quinte. On donnait à cet instrument le nom de nimfali."
                            }
                        ]
                    }
