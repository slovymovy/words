                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kess",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "32dab7fa-60ac-3571-aa08-9ddab58c0e59",
                                        "entry_id": "003c4288-00f3-3842-83b2-4689891ea143",
                                        "glosses": [
                                            "jung, hübsch und dabei unbekümmert, lebenslustig"
                                        ],
                                        "tags": [
                                            "mittelostdeutsch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eaafa2a6-df97-4ae8-afb0-df6e629baad5",
                                                "sense_id": "32dab7fa-60ac-3571-aa08-9ddab58c0e59",
                                                "text": "„Mein Emil is ne kesse Nummer, / er hat schon manchen abgekehlt, / doch fürcht’ er sich vor jedem Brummer, / so jut is er, so zart beseelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f18dae53-ea5d-32f6-84f4-a46eec7abeba",
                                        "entry_id": "003c4288-00f3-3842-83b2-4689891ea143",
                                        "glosses": [
                                            "(auf nicht kränkende Weise) ein wenig vorlaut, unverschämt, respektlos"
                                        ],
                                        "tags": [
                                            "mittelostdeutsch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ec3df75-030c-4d59-81c4-ef67a55fb6c7",
                                                "sense_id": "f18dae53-ea5d-32f6-84f4-a46eec7abeba",
                                                "text": "Die Kleine ist ganz schön kess."
                                            },
                                            {
                                                "example_id": "b3894855-e03c-4347-aff8-cc0b82060775",
                                                "sense_id": "f18dae53-ea5d-32f6-84f4-a46eec7abeba",
                                                "text": "„»Du hast recht«, sagte Jopp, »Intelligenz ist verdächtig: Scharfsinn verblühter Reklamechefs. Der Asketenverein ›Zur häßlichen Schenkel‹ hat die platonische Idee erfunden. Das ›Ding an sich‹ ist heute ein Schuhputzmittel. Die Welt ist keß und voll Epilepsie.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0132ffc6-a5b8-39bf-8c86-700aa537a7df",
                                        "entry_id": "003c4288-00f3-3842-83b2-4689891ea143",
                                        "glosses": [
                                            "(auf dreiste Weise) der aktuellen Mode entsprechend, folgend"
                                        ],
                                        "tags": [
                                            "mittelostdeutsch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6202fb3e-a270-4a8a-aa34-068104ef6ba6",
                                                "sense_id": "0132ffc6-a5b8-39bf-8c86-700aa537a7df",
                                                "text": "„Eine Locke, die kess über die linke Schulter geworfen war, die französische cadenette oder englische lovelock, führte zu Widerstand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad0cd04c-1b4b-4c41-961c-4d0ed2953186",
                        "source_entry_id": "24ffe779-e05d-37c4-afb9-d5001fde5a6b",
                        "source_sense_id": "8df371e1-fdbd-34fd-bdc3-e2d47d5c3885",
                        "source_sense_description": "modieus",
                        "target_lang_word": "keck",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "keck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e48f2b8b-da4d-3ebe-82a4-c24b0f453247",
                                        "entry_id": "35c88420-ceb2-3541-acce-7bc262bfe431",
                                        "glosses": [
                                            "auf eine angenehme, ansprechende Art und Weise frech, respektlos oder vorlaut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a9371ee-beb7-456e-8881-49c98171e163",
                                                "sense_id": "e48f2b8b-da4d-3ebe-82a4-c24b0f453247",
                                                "text": "Sie hatte schon immer so einen kecken Blick."
                                            },
                                            {
                                                "example_id": "4226290a-e5ea-4366-80a3-77ea1d1c3d53",
                                                "sense_id": "e48f2b8b-da4d-3ebe-82a4-c24b0f453247",
                                                "text": "„Verzeiht, Majestät, wenn ich hier so keck in euer Gemach eindringe, doch mein Anliegen pressiert.“"
                                            },
                                            {
                                                "example_id": "b9850d6d-b0b1-40d4-8ff0-3e7c41a1cfc1",
                                                "sense_id": "e48f2b8b-da4d-3ebe-82a4-c24b0f453247",
                                                "text": "„Diese Apfelweide, das verbotene Paradies der naschhaften Jugend, hat Manchem, der die Hand zu keck in die fruchtbeladenen Zweige hinaufreichte, eine tüchtige Tracht Prügel eingetragen“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6eed7948-5c19-4cce-8f5a-8ad195de669f",
                        "source_entry_id": "24ffe779-e05d-37c4-afb9-d5001fde5a6b",
                        "source_sense_id": "8df371e1-fdbd-34fd-bdc3-e2d47d5c3885",
                        "source_sense_description": "modieus",
                        "target_lang_word": "flott",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flott",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a56803f8-3cf9-3217-a60a-4c7ce9823a84",
                                        "entry_id": "54a3f7bb-213c-3141-9c71-0664b82233ed",
                                        "glosses": [
                                            "mit hoher Geschwindigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf313fe7-b2bc-4dce-9c38-9a4014ea7eba",
                                                "sense_id": "a56803f8-3cf9-3217-a60a-4c7ce9823a84",
                                                "text": "Er fährt ein flottes Auto."
                                            },
                                            {
                                                "example_id": "b08ac54e-7aa1-4d55-bc7c-1660d7abbf69",
                                                "sense_id": "a56803f8-3cf9-3217-a60a-4c7ce9823a84",
                                                "text": "„Gerne hätte ich mich von Extrembergsteigern der Küstenwache retten lassen, aber dann musste ich mit ansehen, wie ein greises Pärchen an uns vorüber zu Tal schritt, rüstig und flott, mit Kraxelstöcken und völlig schwindelfrei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5933025d-dba1-3575-9a69-4e70bfc8971c",
                                        "entry_id": "54a3f7bb-213c-3141-9c71-0664b82233ed",
                                        "glosses": [
                                            "modisch schick und lässig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5c2c394-4d89-4e23-ad58-60824c4cada9",
                                                "sense_id": "5933025d-dba1-3575-9a69-4e70bfc8971c",
                                                "text": "Er hat sich einen flotten Mantel gekauft."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2b6c93d0-68d4-3685-b21a-6f80624e7400",
                                        "entry_id": "54a3f7bb-213c-3141-9c71-0664b82233ed",
                                        "glosses": [
                                            "von leichter, unbeschwerter, nicht ganz konventioneller Haltung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca277f10-411c-4484-aa46-ca07affbae3c",
                                                "sense_id": "2b6c93d0-68d4-3685-b21a-6f80624e7400",
                                                "text": "„Gerne hätte ich mich von Extrembergsteigern der Küstenwache retten lassen, aber dann musste ich mit ansehen, wie ein greises Pärchen an uns vorüber zu Tal schritt, rüstig und flott, mit Kraxelstöcken und völlig schwindelfrei.“"
                                            },
                                            {
                                                "example_id": "f759e715-bc96-413f-a796-2912c56ea325",
                                                "sense_id": "2b6c93d0-68d4-3685-b21a-6f80624e7400",
                                                "text": "„Er sei flott und gescheit, manisch, cholerisch und ein bisschen größenwahnsinnig, sagen die, die für ihn arbeiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "2498bd0c-a779-35a1-907f-61570a153e90",
                                        "entry_id": "54a3f7bb-213c-3141-9c71-0664b82233ed",
                                        "glosses": [
                                            "bewegungsfähig, nicht festliegend"
