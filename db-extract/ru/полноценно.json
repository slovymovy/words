                                        "sense_id": "8fd20b90-0ab6-36f7-9efb-2c39e7b3e9d6",
                                        "entry_id": "61fb79d6-909c-333a-b749-ce134014f478",
                                        "glosses": [
                                            "Barely satisfactory or sufficient."
                                        ],
