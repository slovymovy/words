                    "frequency": "High",
                    "semantic_group_id": "rétablir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette bonne nouvelle a réussi à lui <w>redonner</w> espoir après une période sombre."
                        },
                        {
                            "text": "Cette petite promenade matinale lui a enfin <w>redonné</w> le sourire."
