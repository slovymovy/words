                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad788af1-a613-4593-80f2-46c075b7a739",
                                                "sense_id": "9f70c7a7-dd04-30bf-b4eb-ae2820471a77",
                                                "text": "C’est la loi de la nature et de la sélection, diront les darwinistes."
                                            },
                                            {
                                                "example_id": "b4d7fce3-bf2b-46b0-87df-83978d4093a8",
                                                "sense_id": "9f70c7a7-dd04-30bf-b4eb-ae2820471a77",
                                                "text": "Quant aux purs darwinistes, […], pour eux, il n'y a pas d'espèces; il n'y a que des degrès plus ou moins séparés les uns des autres par des vides qui ont pu se produire; il n'existe pas de types originairement distincts; et les formes diverses des êtres ne sont que des manifestations inégales d'une évolution incessante."
                                            }
                                        ]
                                    }
                                ]
                            }
