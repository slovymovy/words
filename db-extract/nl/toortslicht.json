                        "examples": [
                            {
                                "example_id": "f3a71cb9-3ede-435e-b9de-b1ccbfc81fce",
                                "sense_id": "b71bad73-3afb-34c5-9550-3cc781bb8922",
                                "text": "Niniane gebaarde; een bediende, die een enkele toorts droeg, stak zijn hand uit naar een andere, en het licht ging snel van hand tot hand totdat de gehele kust werd verlicht door het toortslicht."
                            },
                            {
                                "example_id": "a1a90851-8b97-4859-9489-5785bac0570d",
                                "sense_id": "b71bad73-3afb-34c5-9550-3cc781bb8922",
                                "text": "Toen de avond viel, werd het toernooi nog voortgezet bij toortslicht, en na de avonddis kwamen dans, toneel en allerhande vermakelijkheden aan de beurt, wat tot middernacht duurde."
                            }
                        ]
                    }
