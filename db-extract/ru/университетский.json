                ],
                "senses": [
                    {
                        "sense_id": "c859d4b6-c78d-3a69-b345-9942d88e3ffa",
                        "entry_id": "0430cb37-8a2f-3ffc-8dce-df6a7536321f",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным университет"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c22b0df5-f44b-467d-80b7-378f21a3cfa3",
                                "sense_id": "c859d4b6-c78d-3a69-b345-9942d88e3ffa",
                                "text": "Я сразу вспомнил университетские лекции про текстуры: ориентация микрокристалликов вдоль линии проката, возникающая при некоторых условиях."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9d2db26-7eb9-4c0f-9d73-102167156875",
                        "source_entry_id": "0430cb37-8a2f-3ffc-8dce-df6a7536321f",
                        "source_sense_id": "c859d4b6-c78d-3a69-b345-9942d88e3ffa",
                        "target_lang_word": "university",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "university",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "394de7e6-2611-3a2c-9300-b728dad5eec6",
                                        "entry_id": "a19f2a32-801d-31f8-bbfc-17332688ba99",
                                        "glosses": [
                                            "Institution of higher education (typically accepting students from the age of about 17 or 18, depending on country, but in some exceptional cases able to take younger students) where subjects are studied and researched in depth and degrees are offered."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b10102f-8d0e-4914-9d81-a9803cf8486b",
                                                "sense_id": "394de7e6-2611-3a2c-9300-b728dad5eec6",
                                                "text": "She's studying mathematics at university."
                                            },
                                            {
                                                "example_id": "7e6a8454-46d7-4d0c-ae89-513798eecb61",
                                                "sense_id": "394de7e6-2611-3a2c-9300-b728dad5eec6",
                                                "text": "The only reason why I haven't gone to university is because I can't afford it."
                                            },
                                            {
                                                "example_id": "45471422-01af-43a1-b74c-d75e3c93c67e",
                                                "sense_id": "394de7e6-2611-3a2c-9300-b728dad5eec6",
                                                "text": "During the whole time of his abode in the university he generally spent thirteen hours of the day in study; by which assiduity besides an exact dispatch of the whole course of philosophy, he read over in a manner all classic authors that are extant[…]"
                                            },
                                            {
                                                "example_id": "be2a8fd4-4845-40fe-a5ac-fdd19fc4ff9b",
                                                "sense_id": "394de7e6-2611-3a2c-9300-b728dad5eec6",
                                                "text": "Since the launch early last year of […] two Silicon Valley start-ups offering free education through MOOCs, massive open online courses, the ivory towers of academia have been shaken to their foundations. University brands built in some cases over centuries have been forced to contemplate the possibility that information technology will rapidly make their existing business model obsolete."
                                            },
                                            {
                                                "example_id": "8e587950-b116-407f-aca7-8d785124560c",
                                                "sense_id": "394de7e6-2611-3a2c-9300-b728dad5eec6",
                                                "text": "The most compelling stories of whether university is worth it are examples where a university education lifts the economic standing of a poor or disadvantaged student to a higher socioeconomic position."
                                            },
                                            {
                                                "example_id": "13c3dbab-1922-47fe-ab81-f63692d0774e",
                                                "sense_id": "394de7e6-2611-3a2c-9300-b728dad5eec6",
                                                "text": "The NIAID supports projects at universities and research organizations around the United States as well as a network of 21 NIAID labs across the country."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31f7f3b7-8a34-3cab-8fcc-31c64f05ef5c",
                                        "entry_id": "a19f2a32-801d-31f8-bbfc-17332688ba99",
                                        "glosses": [
                                            "The entirety of a group; all members of a class."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fed5c1d2-5770-4d3c-a477-a91d81bfcd0c",
                                                "sense_id": "31f7f3b7-8a34-3cab-8fcc-31c64f05ef5c",
                                                "text": "[I]t appears a pity to banish the women and children. But to this can be opposed that holy act of your Majesty which expelled the Moriscos, and the children of the Moriscos, for the reason given in the royal edict. Whenever any detestable crime is committed by any university, it is well to punish all."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
