                                "target_senses": [
                                    {
                                        "sense_id": "1658454a-80bb-3e19-8ad8-1d8aba82b568",
                                        "entry_id": "acc4f8ba-857e-32cf-937a-4def4bb84d0c",
                                        "glosses": [
                                            "intensity or the act of becoming intense."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01f261a1-2f66-4a1d-9569-eaf899c5a314",
                                                "sense_id": "1658454a-80bb-3e19-8ad8-1d8aba82b568",
                                                "text": "Sounds […] likewise do rise and fall with the intension or remission of the wind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fd0e55e-20e3-3a75-8763-8198d998676e",
                                        "entry_id": "acc4f8ba-857e-32cf-937a-4def4bb84d0c",
                                        "glosses": [
                                            "Any property or quality connoted by a word, phrase or other symbol, contrasted with actual instances in the real world to which the term applies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74bc21f7-d999-4d6f-9999-8b8a62024d76",
                                                "sense_id": "2fd0e55e-20e3-3a75-8763-8198d998676e",
                                                "text": "'Is a plant', 'has a trunk', 'has leaves' are intensions of the concept tree. Its extension is the set of all trees existing in the real world."
                                            },
                                            {
                                                "example_id": "72713604-8d02-49e3-88df-373b6aa09baf",
                                                "sense_id": "2fd0e55e-20e3-3a75-8763-8198d998676e",
                                                "text": "This law is, that the intension of our knowledge is in the inverse ratio of its extension."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d14b5880-4123-3a22-8d4c-d4d084e17436",
                                        "entry_id": "acc4f8ba-857e-32cf-937a-4def4bb84d0c",
                                        "glosses": [
                                            "A straining, stretching, or bending; the state of being strained."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b70cf0f-5484-4eff-9144-7c925cd3590d",
                                                "sense_id": "d14b5880-4123-3a22-8d4c-d4d084e17436",
                                                "text": "the intension of a musical string"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25521844-da9b-4a18-bb37-ba2673d07967",
                        "source_entry_id": "dbb76192-0b61-3e1a-8a5f-3ae9399b3f17",
