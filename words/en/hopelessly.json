{
    "word_family": [
        "hope",
        "hopeful",
        "hopeless"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "89fe2876-50d7-3d02-85ad-ae8998a1ecd5",
                    "sense_definition": "In a way that shows no expectation of a positive outcome or success.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team was <w>hopelessly</w> behind in the score with only minutes left to play.",
                            "target_lang_translations": {
                                "zh": "比赛只剩下几分钟了，这支队伍的分数已经<w>彻底</w>落后了。"
                            }
                        },
                        {
                            "text": "He felt <w>hopelessly</w> lost while trying to navigate the unfamiliar city streets at night.",
                            "target_lang_translations": {
                                "zh": "他在夜里试图辨认陌生的城市街道时，感到<w>无可救药地</w>迷失了方向。"
                            }
                        }
                    ],
                    "synonyms": [
                        "despairingly",
                        "desperately"
                    ],
                    "antonyms": [
                        "hopefully",
                        "optimistically"
                    ],
                    "common_phrases": [
                        "hopelessly lost",
                        "hopelessly in love",
                        "hopelessly addicted"
                    ],
                    "target_lang_definitions": {
                        "zh": "形容毫无希望、无法挽回或彻底地陷入某种状态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "无可救药地",
                                "target_lang_sense_clarification": "用于形容陷入某种无法改变的负面状态或情感。"
                            },
                            {
                                "target_lang_word": "绝望地",
                                "target_lang_sense_clarification": "用于形容缺乏希望或感到无助的态度。"
                            },
                            {
                                "target_lang_word": "彻底地",
                                "target_lang_sense_clarification": "用于强调程度之深，常用于形容迷路或落后。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
