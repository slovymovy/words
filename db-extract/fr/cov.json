                    {
                        "sense_id": "ab4acbe5-fa26-3999-b3d5-7ba74717f843",
                        "entry_id": "d56626dd-17ce-3a39-b4e5-4c0eb5371047",
                        "glosses": [
                            "Covid-19 (maladie)."
                        ],
