{
    "word_family": [
        "divvy"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "632b7d7e-b910-3a98-b868-a3ccdce7429f",
                    "sense_definition": "To divide into portions",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "divide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We <w>divvied</w> the money into equal portions to split between us.",
                            "target_lang_translations": {
                                "fr": "Nous avons <w>partagé</w> l'argent en parts égales pour le répartir entre nous.",
                                "cs": "Peníze jsme <w>rozdělili</w> na stejné díly, abychom se o ně podělili."
                            }
                        },
                        {
                            "text": "It is a sordid business, this <w>divvying</w> us up by race.",
                            "target_lang_translations": {
                                "fr": "C'est une affaire sordide, ce fait de nous <w>diviser</w> selon la race.",
                                "cs": "Je to špinavá záležitost, tohle naše <w>rozdělování</w> podle rasy."
                            }
                        }
                    ],
                    "synonyms": [
                        "distribute",
                        "allocate",
                        "share"
                    ],
                    "common_phrases": [
                        "divvy up"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Diviser quelque chose en plusieurs portions ou parts.",
                        "cs": "Rozdělit něco na několik částí nebo podílů."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "partager",
                                "target_lang_sense_clarification": "Diviser une chose en plusieurs parties pour en faire la distribution."
                            },
                            {
                                "target_lang_word": "répartir",
                                "target_lang_sense_clarification": "Distribuer des éléments de manière organisée."
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "rozdělit",
                                "target_lang_sense_clarification": "Rozdělit celek na menší části."
                            },
                            {
                                "target_lang_word": "podělit se",
                                "target_lang_sense_clarification": "Rozdělit něco mezi více lidí."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "13fbaa26-5c1a-349a-9ac8-a2f405a0239b",
                    "sense_definition": "A dividend; a share or portion",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "divide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Everyone received their fair <w>divvy</w> of the profits.",
                            "target_lang_translations": {
                                "fr": "Chacun a reçu sa juste <w>part</w> des bénéfices.",
                                "cs": "Každý dostal svůj spravedlivý <w>podíl</w> ze zisku."
                            }
                        },
                        {
                            "text": "They argued about the <w>divvy</w> of the remaining supplies.",
                            "target_lang_translations": {
                                "fr": "Ils se sont disputés au sujet de la <w>répartition</w> des fournitures restantes.",
                                "cs": "Hádali se o <w>rozdělení</w> zbývajících zásob."
                            }
                        }
                    ],
                    "synonyms": [
                        "portion",
                        "share",
                        "allotment"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Une part ou une portion de quelque chose, souvent des profits ou des ressources.",
                        "cs": "Podíl nebo část něčeho, často zisků nebo zdrojů."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "part",
                                "target_lang_sense_clarification": "La portion qui revient à quelqu'un."
                            },
                            {
                                "target_lang_word": "portion",
                                "target_lang_sense_clarification": "Une quantité déterminée d'un tout."
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "podíl",
                                "target_lang_sense_clarification": "Část, která někomu náleží."
                            },
                            {
                                "target_lang_word": "díl",
                                "target_lang_sense_clarification": "Jedna z částí celku."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c00bb1b-9f3b-3cc7-a723-8a744a8de1c9",
                    "sense_definition": "A foolish person",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Put it down and stop being a <w>divvy</w>!",
                            "target_lang_translations": {
                                "fr": "Pose ça et arrête de faire l'<w>idiot</w> !",
                                "cs": "Polož to a přestaň být <w>hlupák</w>!"
                            }
                        },
                        {
                            "text": "Don't listen to that <w>divvy</w>.",
                            "target_lang_translations": {
                                "fr": "N'écoute pas cet <w>imbécile</w>.",
                                "cs": "Neposlouchej toho <w>blázna</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "fool",
                        "idiot",
                        "moron"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Une personne stupide ou idiote.",
                        "cs": "Hloupá nebo pošetilá osoba."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "idiot",
                                "target_lang_sense_clarification": "Personne manquant d'intelligence ou de bon sens."
                            },
                            {
                                "target_lang_word": "imbécile",
                                "target_lang_sense_clarification": "Personne qui agit de manière stupide."
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "hlupák",
                                "target_lang_sense_clarification": "Člověk, který jedná nerozumně."
                            },
                            {
                                "target_lang_word": "blázen",
                                "target_lang_sense_clarification": "Člověk chovající se pošetile."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "36715a5d-9615-34cd-8459-ce7448b01301",
                    "sense_definition": "Divine; very pleasant, wonderful",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weather today is absolutely <w>divvy</w>.",
                            "target_lang_translations": {
                                "fr": "Le temps aujourd'hui est absolument <w>merveilleux</w>.",
                                "cs": "Počasí je dnes naprosto <w>úžasné</w>."
                            }
                        },
                        {
                            "text": "We had a <w>divvy</w> time at the party last night.",
                            "target_lang_translations": {
                                "fr": "Nous avons passé un <w>divin</w> moment à la fête hier soir.",
                                "cs": "Včera večer na večírku jsme se měli <w>božsky</w>."
                            }
                        }
                    ],
                    "synonyms": [
