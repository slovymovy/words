                        "source_sense_id": "4d08503b-50db-3a18-97ab-e5cb77e8fe0e",
                        "source_sense_description": "Chemie: allgemeine Bezeichnung für ein Nebengruppen-Element zwischen der zweiten und dritten Hauptgruppe des Periodensystems",
                        "target_lang_word": "métal de transition",
                        "target_lang_code": "fr",
