                    },
                    {
                        "translation_id": "fe99ea08-a95a-4024-9ab4-59480476502e",
                        "source_entry_id": "4c6e77f3-ee11-38e9-9552-009237d1706d",
                        "source_sense_id": "e4436898-1226-3682-9984-0bab5297367f",
                        "source_sense_description": "zich tegen iets verzettend",
                        "target_lang_word": "opposed to",
                        "target_lang_code": "en",
