                    {
                        "sense_id": "41a68158-236c-3175-9c98-fecaec8c03c2",
                        "entry_id": "65cb2859-de92-341a-8a59-602751eff39a",
                        "glosses": [
                            "спорт. высшее спортивное звание в шахматах и шашках"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdf3214c-7a10-4585-a083-80135df9566e",
                                "sense_id": "41a68158-236c-3175-9c98-fecaec8c03c2",
                                "text": "Для участия в фестивале прибыли международные гроссмейстеры и международные мастера спорта по шахматам."
                            }
                        ]
                    }
                ],
                "translations": [
