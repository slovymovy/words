                                "target_senses": [
                                    {
                                        "sense_id": "5e557b07-2a83-3934-8a4c-6f809f6cdf21",
                                        "entry_id": "fd005c58-86dd-33ae-bd97-64537f7eff50",
                                        "glosses": [
                                            "посёлок городского типа в Кемеровской области, расположенный на реке Яе [2]; административный центр Яйского района"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f516de27-f24e-435d-94be-dc9e7c410838",
                                                "sense_id": "5e557b07-2a83-3934-8a4c-6f809f6cdf21",
                                                "text": "Постановлением № 1644 от 22.07.1934 г. из железнодорожной станции Яя, территории лесозавода и села Жарковского образован рабочий посёлок Яя."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de311b23-c43f-3114-b0c4-89634455b359",
                                        "entry_id": "fd005c58-86dd-33ae-bd97-64537f7eff50",
                                        "glosses": [
                                            "река в России; приток Чулыма"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ad11258-fb04-4d85-bfa1-acbf65a56cbc",
                                                "sense_id": "de311b23-c43f-3114-b0c4-89634455b359",
                                                "text": "На притоках Яи с начала 40-х годов XIX столетия производилась разработка золотоносных песков."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6f063b8-4a20-3391-8e09-933fc92760c9",
                                        "entry_id": "fd005c58-86dd-33ae-bd97-64537f7eff50",
                                        "glosses": [
                                            "остров в гряде Новосибирских островов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2b19645-bdbe-4631-b015-34fd32c867d2",
                                                "sense_id": "a6f063b8-4a20-3391-8e09-933fc92760c9",
                                                "text": "После обнаружения острова решили назвать его сначала Баунти, поскольку очертаниями он очень похож на тот, что в известной рекламе. Но когда начали решать, кто первый его обнаружил, все начали говорить: «Я, я, я!» Ну и было решено назвать остров Яя, — рассказал историк-географ Сергей Рыжий."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c218bd7-2665-37df-a240-3a52b72f7135",
                                        "entry_id": "fd005c58-86dd-33ae-bd97-64537f7eff50",
                                        "glosses": [
                                            "деревня в Браславском районе Витебской области Белоруссии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2bdd4bb-952d-4931-8e79-04140a78ed7c",
                                                "sense_id": "9c218bd7-2665-37df-a240-3a52b72f7135",
                                                "text": "Яя находится по дороге между Браславом и Друей."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
