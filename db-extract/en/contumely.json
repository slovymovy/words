                                                "example_id": "9a2ee549-b0bf-43a0-8595-c5c849afd804",
                                                "sense_id": "e7304a7c-eb07-3e69-b32d-678858091442",
                                                "text": "Iedereen kan alles als een belediging ervaren."
                                            },
                                            {
                                                "example_id": "23637e26-be2a-4ce6-98a2-1eea540dc6f8",
                                                "sense_id": "e7304a7c-eb07-3e69-b32d-678858091442",
                                                "text": "De poging van Steiner om hen voor zich te winnen, was een belediging aan hun intelligentie."
                                            },
                                            {
                                                "example_id": "41432ed2-873f-44f0-a02a-34c27fdc222d",
                                                "sense_id": "e7304a7c-eb07-3e69-b32d-678858091442",
                                                "text": "De graaf fronste en tuitte zijn lippen. Het is namelijk wel deftig om beledigingen te laten doorschemeren, maar niet om ze hardop uit te spreken."
                                            }
                                        ]
