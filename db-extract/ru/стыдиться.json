                ],
                "translations": [
                    {
                        "translation_id": "e306c8a1-d132-43cd-b2d7-9182e2e2ce91",
                        "source_entry_id": "e10584a2-7bea-336d-98a6-172e503eb81e",
                        "target_lang_word": "avoir honte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "avoir honte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "262ff8d8-ea0b-3ad7-bd0d-28267c41dda0",
                                        "entry_id": "71dbc148-24da-35a1-927d-d65767da9c49",
                                        "glosses": [
                                            "Éprouver un sentiment de honte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "798b453c-582b-455b-ba16-386e53178cd8",
                                                "sense_id": "262ff8d8-ea0b-3ad7-bd0d-28267c41dda0",
                                                "text": "De manquer à sa parole, tout homme devrait avoir honte."
                                            },
                                            {
                                                "example_id": "f6fd9b99-671c-41d0-82fa-3f3264e572fc",
                                                "sense_id": "262ff8d8-ea0b-3ad7-bd0d-28267c41dda0",
                                                "text": "Tu n’as pas honte ?"
                                            },
                                            {
                                                "example_id": "11db5393-a2b0-4c87-82de-efe08caa95ef",
                                                "sense_id": "262ff8d8-ea0b-3ad7-bd0d-28267c41dda0",
                                                "text": "n’avoir ni honte ni vergogne."
                                            },
                                            {
                                                "example_id": "dc6ccccc-8a7d-4b5c-b034-e62d38bbcb55",
                                                "sense_id": "262ff8d8-ea0b-3ad7-bd0d-28267c41dda0",
                                                "text": "Les adolescents disent toujours avoir honte de leurs parents."
                                            },
                                            {
                                                "example_id": "0c754a1a-2848-4a8f-91e5-242e7d6bca4c",
                                                "sense_id": "262ff8d8-ea0b-3ad7-bd0d-28267c41dda0",
                                                "text": "Sa règle morale essentielle est de ne jamais se mettre dans une situation telle qu’on puisse en avoir honte. « Gand ar vez », « avec la honte », est l’expression qui pour elle englobe tout ce qu’il est inconvenant de faire et même de penser."
                                            },
                                            {
                                                "example_id": "7e29a6ad-ad0f-4479-8c64-75f11f9b64d2",
                                                "sense_id": "262ff8d8-ea0b-3ad7-bd0d-28267c41dda0",
                                                "text": "Pendant des années, j’avais eu honte de ma mère devant les autres, et j’avais eu honte d’avoir honte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
