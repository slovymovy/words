                        "entry_id": "cb4feab6-108d-326d-9f1d-766ed7456053",
                        "glosses": [
                            "État de ce qui est infectieux ; capacité d’un agent infectieux de pénétrer dans l’organisme d’un hôte, d’y survivre et de s’y multiplier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85b498ef-fdd5-4e91-b97e-9cd2702f32d5",
                                "sense_id": "87616006-507f-32cc-9a68-83c4daae2c30",
                                "text": "Le risque dépend aussi de la survie de l’agent pathogène sur la surface atteinte, et de l’infectiosité de celui-ci, mais les mains se prêtent bien à la contagion."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ccd03e8-8c63-4aaa-9d63-6e507e5ee463",
                        "source_entry_id": "cb4feab6-108d-326d-9f1d-766ed7456053",
                        "source_sense_id": "87616006-507f-32cc-9a68-83c4daae2c30",
                        "target_lang_word": "Infektiosität",
