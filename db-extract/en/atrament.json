                            {
                                "example_id": "8a1cbe3f-b394-4a82-af70-6ab2b5821068",
                                "sense_id": "5e9acde5-922e-3105-be4e-65a30040c9b1",
                                "text": "The irises of those eyes, whose pupils were blacker than atrament, varied singularly in shades of shifting colour."
                            },
                            {
                                "example_id": "125872a2-8ba2-49c8-b287-a11422f71e13",
                                "sense_id": "5e9acde5-922e-3105-be4e-65a30040c9b1",
                                "text": "Everything was lost to sight in that ponderous atrament which precedes the dawn."
                            },
                            {
                                "example_id": "00ef4cd9-81d6-479a-bed4-1602fe5f0246",
                                "sense_id": "5e9acde5-922e-3105-be4e-65a30040c9b1",
                                "text": "Onyx flashed in her hair, and the delicate fabric that revealed, concealing, the outlines of her face and her body had the same silvery atrament of the stars."
                            }
                        ]
                    }
