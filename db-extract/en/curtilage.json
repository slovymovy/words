                        "entry_id": "14723f05-d153-3533-a3f8-774021f22233",
                        "glosses": [
                            "The area immediately surrounding a house, especially dooryard areas and sometimes including closely associated buildings and structures."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c4c117c-5be6-4b10-8a9f-2e530bcd60ed",
                                "sense_id": "d02bca33-dfc3-3fad-b3bd-0cc975de1115",
                                "text": "The scope of the curtilage is determined by considering the proximity to the home, whether it is fenced or otherwise enclosed, the nature of the use of the area, and the efforts the resident takes to screen the area from public view."
                            },
                            {
                                "example_id": "247f457c-56e6-4b84-a0bc-4675e57e5b85",
                                "sense_id": "d02bca33-dfc3-3fad-b3bd-0cc975de1115",
                                "text": "High winds are not in themselves a controllable risk. But fallen trees certainly are, given the control the railway has over its own curtilage."
                            }
                        ]
                    }
                ],
