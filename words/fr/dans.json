{
    "word_family": [
        "dedans"
    ],
    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "d4160d5b-e45e-3a2a-aeba-f2c047c753af",
                    "sense_definition": "Indique la localisation à l'intérieur d'un espace fermé, d'un lieu délimité ou d'un contenant.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a oublié ses clés <w>dans</w> la voiture avant de partir au bureau."
                        },
                        {
                            "text": "Les enfants adorent jouer <w>dans</w> le jardin quand il fait beau."
                        }
                    ],
                    "synonyms": [
                        "en"
                    ],
                    "antonyms": [
                        "hors",
                        "hors de"
                    ],
                    "common_phrases": [
                        "dans la maison",
                        "dans la rue",
                        "dans le monde"
                    ]
                },
                {
                    "sense_id": "f21bc84d-e4fd-3cd5-bc37-0cd06bde8159",
                    "sense_definition": "Indique le délai à l'expiration duquel un événement futur doit se réaliser.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le train pour Marseille va partir <w>dans</w> dix minutes de la voie numéro trois."
                        },
                        {
                            "text": "Nous serons prêts à partir en vacances <w>dans</w> quelques jours."
                        }
                    ],
                    "antonyms": [
                        "il y a"
                    ],
                    "common_phrases": [
                        "dans un instant",
                        "dans un moment",
                        "dans peu de temps"
                    ]
                },
                {
                    "sense_id": "5c125b87-4c2c-3191-85d3-56f861ee481c",
                    "sense_definition": "Exprime une époque ou une période temporelle au cours de laquelle une action se déroule.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon grand-père a beaucoup voyagé <w>dans</w> sa jeunesse à travers le monde."
                        },
                        {
                            "text": "Le musée a reçu de nombreuses œuvres <w>dans</w> les années quatre-vingt."
                        }
                    ],
                    "synonyms": [
                        "durant",
                        "pendant"
                    ],
                    "common_phrases": [
                        "dans ma jeunesse",
                        "dans le passé"
                    ]
                },
                {
                    "sense_id": "a1f8da0c-7b92-3d5d-aea7-3444d7609d8d",
                    "sense_definition": "Indique le récipient ou le lieu d'où l'on extrait, prend ou consomme quelque chose.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "provenance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque matin, elle boit son thé chaud <w>dans</w> un bol en céramique."
                        },
                        {
                            "text": "Tu peux prendre une tranche de gâteau directement <w>dans</w> la boîte."
                        }
                    ],
                    "common_phrases": [
                        "boire dans un verre",
                        "manger dans une assiette"
                    ]
                },
                {
                    "sense_id": "8b6ebfae-7e4f-303b-98a6-6f78267bf8ee",
                    "sense_definition": "Désigne la situation morale, sociale, financière ou l'état d'esprit dans lequel une personne se trouve.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "etat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette famille a vécu longtemps <w>dans</w> la misère avant de trouver de l'aide."
                        },
                        {
                            "text": "Il est resté silencieux <w>dans</w> l'attente d'une réponse de son avocat."
                        }
                    ],
                    "common_phrases": [
                        "dans le besoin",
                        "dans la misère",
                        "dans le doute"
                    ]
                },
                {
                    "sense_id": "6446dbd6-8b0e-3227-bf7a-139c4bbdddb1",
                    "sense_definition": "S'emploie pour indiquer une quantité ou une mesure approximative.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mesure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce beau vélo de course doit coûter <w>dans</w> les cinq cents euros."
                        },
                        {
                            "text": "Le colis pèse <w>dans</w> les dix kilos selon les estimations du facteur."
                        }
                    ],
                    "synonyms": [
                        "environ"
                    ],
                    "common_phrases": [
                        "dans les"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "usage courant pour l'approximation"
                        }
                    ]
                },
                {
                    "sense_id": "01d1169a-4908-3e68-946a-35a0ff7f9b02",
                    "sense_definition": "Indique la direction ou la destination vers certaines entités administratives ou régions géographiques.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils ont décidé de partir s'installer <w>dans</w> le Sud pour trouver du soleil."
                        },
                        {
                            "text": "Nous allons voyager <w>dans</w> l'État de Washington le mois prochain."
                        }
                    ],
                    "common_phrases": [
                        "dans le sud",
                        "dans le nord"
                    ]
                },
                {
                    "sense_id": "ce0f6acd-2b9e-31a7-acc0-6852bb3960d7",
                    "sense_definition": "Indique le sens, l'acception ou la façon d'interpréter une idée ou un propos.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sens",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut interpréter cette remarque <w>dans</w> un tout autre sens que celui supposé."
                        },
                        {
                            "text": "Ce mot rare est employé ici <w>dans</w> une acception tout à fait littéraire."
                        }
                    ],
                    "synonyms": [
                        "selon"
                    ],
                    "common_phrases": [
                        "dans ce sens",
                        "dans un sens"
                    ]
                },
                {
                    "sense_id": "b0665dc7-03dc-32b3-b5eb-5041c6b422fd",
                    "sense_definition": "Marque la présence d'une pensée, d'un thème ou d'une référence chez un auteur ou dans son œuvre.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "oeuvre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La notion de liberté individuelle est centrale <w>dans</w> Sartre et ses essais."
                        },
                        {
                            "text": "On retrouve cette critique sociale <w>dans</w> toute la littérature de cette époque."
                        }
                    ],
                    "synonyms": [
                        "chez"
                    ]
                },
                {
                    "sense_id": "ecdecb4a-a5b4-382a-b422-bb2fe59d7ad8",
                    "sense_definition": "Introduit le but, l'intention ou le projet qui motive une action.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "intention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a rédigé cet article <w>dans</w> l'intention d'informer les citoyens sur leurs droits."
                        },
                        {
                            "text": "Le ministre a pris la parole <w>dans</w> le dessein d'apaiser les tensions sociales."
                        }
                    ],
                    "common_phrases": [
                        "dans l'intention de",
                        "dans le but de",
                        "dans le dessein de"
                    ]
                }
            ]
        },
