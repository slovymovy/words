                "senses": [
                    {
                        "sense_id": "5f61ac18-d458-35a4-bfd0-5650f23b0f06",
                        "entry_id": "d3a983f2-896c-3bd3-b5d3-7bee745b18bd",
                        "glosses": [
                            "diminutive of тря́пка (trjápka): (small) rag (piece of cloth), duster"
                        ],
                        "tags": [
                            "diminutive",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "f9b6838f-c457-482e-b9aa-11c7886acb6a",
                                "sense_id": "5f61ac18-d458-35a4-bfd0-5650f23b0f06",
                                "text": "О́льга Ива́новна в гости́ной уве́шала все сте́ны сплошь свои́ми и чужи́ми этю́дами в ра́мах и без рам, а о́коло роя́ля и ме́бели устро́ила краси́вую тесноту́ из кита́йских зонто́в, мольбе́ртов, разноцве́тных тря́почек, кинжа́лов, бю́стиков, фотогра́фий...",
                                "translation": "Olga Ivanovna hung the drawing-room with drawings, her own and her friends', framed and unframed; and about the piano and furniture, arranged in pretty confusion Chinese parasols, easels, many-coloured draperies, poniards, busts, photographs.",
                                "english": "Olga Ivanovna hung the drawing-room with drawings, her own and her friends', framed and unframed; and about the piano and furniture, arranged in pretty confusion Chinese parasols, easels, many-coloured draperies, poniards, busts, photographs."
                            }
                        ]
                    }
                ],
