                                "target_senses": [
                                    {
                                        "sense_id": "37c70ddb-55fd-306c-93a7-51cd6962c684",
                                        "entry_id": "eacb845c-7af8-30a5-a925-44e1a3ab4784",
                                        "glosses": [
                                            "A person with whom one shares a bed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4ca71d2-4183-4870-96e6-b4fc3964d684",
                                                "sense_id": "37c70ddb-55fd-306c-93a7-51cd6962c684",
                                                "text": "Catherine of Aragon: wonderful woman, the Queen of England, the bedmate of Henry VIII - that much I knew already."
                                            },
                                            {
                                                "example_id": "4a728f57-bee8-45c6-89cd-f1220a91276a",
                                                "sense_id": "37c70ddb-55fd-306c-93a7-51cd6962c684",
                                                "text": "These [periodic leg movements] may awaken the sleeper, but often they do nor and are more disruptive to the bedmate. If you or your bedmate experience either of these disorders, talk with a sleep specialist about possible treatment"
                                            },
                                            {
                                                "example_id": "5a82a5cc-51ec-4e24-8807-a436f1e448e7",
                                                "sense_id": "37c70ddb-55fd-306c-93a7-51cd6962c684",
                                                "text": "She wondered where his thoughts were and whether she was anything more to him than a bedmate and housekeeper. She worried whether she'd done something to be the cause of his gloom..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4ca1233-6d1f-47e8-91dd-143c139ecdac",
                        "source_entry_id": "c6a5f94c-fbb4-36ac-9f26-206325f4a758",
                        "source_sense_id": "edec2b30-b11a-38e2-9df1-54f113b14c75",
                        "target_lang_word": "bedfellow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bedfellow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d04f072d-9f65-3116-8806-563eb693820e",
                                        "entry_id": "df4ee889-fefe-3857-83ef-4a756e51a1e2",
                                        "glosses": [
                                            "One with whom one shares a bed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86fa8d75-05d1-4928-9bb4-016fbb48b772",
                                                "sense_id": "d04f072d-9f65-3116-8806-563eb693820e",
                                                "text": "Yong budding Virgin, faire, and freſh,& ſweet, / Whether away, or whether is thy aboade? / Happy the Parents of ſo faire a childe; / Happier the man whom fauourable ſtars / A lots thee for his louely bedfellow."
                                            },
                                            {
                                                "example_id": "d3111d70-e910-4ff1-9d18-7a2f32a4e6d7",
                                                "sense_id": "d04f072d-9f65-3116-8806-563eb693820e",
                                                "text": "Car[azie]. / In the day I waite on my Lady when ſhe eates, / Carry her pantophles, beare vp her trayne / Sing her aſleepe at night, and when ſhe pleaſes / I am her bedfellow. / Gaz[et]. / How? her bedfellow, / And lye with her? / Car[azie]. / Yes, and lye with her."
                                            },
                                            {
                                                "example_id": "26d43586-4ff4-42ee-84aa-6e563548796b",
                                                "sense_id": "d04f072d-9f65-3116-8806-563eb693820e",
                                                "text": "Therefore, grave mistresses of fate, I pray / That I may never live to see the day / When Zeus takes me for his bedfellow;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d588fac-23dd-3359-b622-50359d46a8a3",
                                        "entry_id": "df4ee889-fefe-3857-83ef-4a756e51a1e2",
                                        "glosses": [
                                            "An associate, often an otherwise improbable one."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79b9143c-1ae7-4ebe-bede-eeba002189da",
                                                "sense_id": "3d588fac-23dd-3359-b622-50359d46a8a3",
                                                "text": "They say that \"misfortune makes men acquainted with strange bedfellows\". The old hereditary Whig Cabinet ministers must, no doubt, by this time have learned to feel themselves at home with strange neighbours at their elbows."
                                            },
                                            {
                                                "example_id": "8d8df3bd-e8d1-4036-bdf3-6c15d80accb2",
                                                "sense_id": "3d588fac-23dd-3359-b622-50359d46a8a3",
                                                "text": "Certain aspects of reprint publishing are more akin to university press publishing than to any other sector of the publishing industry, but the relationships between the two frequently create unwilling bedfellows."
                                            },
                                            {
                                                "example_id": "682519e0-d65e-47c4-846e-09039ebeb61c",
                                                "sense_id": "3d588fac-23dd-3359-b622-50359d46a8a3",
                                                "text": "Statistics and truth can be uneasy bedfellows when it comes to football, but one fact could not be ignored: neither side has a player with more than seven goals to his name."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
