                ],
                "senses": [
                    {
                        "sense_id": "1810fff9-1b1d-333d-bd0e-59e87a02e419",
                        "entry_id": "5f9b2b14-7095-3134-b819-fb0bee973468",
                        "glosses": [
                            "Se guillotiner mutuellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d572890-3cb3-486c-99e1-efb67ac889b8",
                                "sense_id": "1810fff9-1b1d-333d-bd0e-59e87a02e419",
                                "text": "Je ne sais pas comment on avait pu leur exposer — sans attirer leur attention — que ces anges laïques, après vingt mille assassinats suivis de vol, s’étaient entre-guillotinés eux-mêmes."
                            },
                            {
                                "example_id": "47a31355-d1ef-4647-9d30-760ec8286ab6",
                                "sense_id": "1810fff9-1b1d-333d-bd0e-59e87a02e419",
                                "text": "Regardez pendant la Révolution \"française\", même les pires révolutionnaires se sont entre-guillotinés!"
                            },
                            {
                                "example_id": "1edff76d-d1d7-483b-a89a-4c0c94acd926",
                                "sense_id": "1810fff9-1b1d-333d-bd0e-59e87a02e419",
                                "text": "Finalement tous ces révolutionnaires qui se sont entre-guillotinés, n'ont eu que ce qu'ils méritaient."
                            }
                        ]
                    }
                ],
