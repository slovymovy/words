                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72d506ad-1416-4cb1-9189-a47bdd9b55f7",
                                                "sense_id": "816d3452-c936-3da7-b7a0-f22c482a617c",
                                                "text": "Åland comme Gotland sont d'une grande importance stratégique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3502be9-f90c-326e-849d-346e8675564e",
                                        "entry_id": "2f9571d4-6ff1-3cad-b3f5-fe2b6df2cfbb",
                                        "glosses": [
                                            "État associé finlandais constitué de l’archipel du même nom comprenant environ 6,500 îles situées entre la Finlande et la Suède, à l’entrée du golfe de Botnie. Leur code de subdivision ISO_3166-2:FI#Anciennes_subdivisions était AL (FI-AL) jusqu’en 2011 ; il est désormais 01 (FI-01)."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82a38273-132b-4b26-bb1f-ca6a5998d76d",
                                                "sense_id": "c3502be9-f90c-326e-849d-346e8675564e",
                                                "text": "Le statut d’Åland, au regard du droit international, implique de fortes réserves quant aux préparatifs militaires tant que la guerre n’est pas un fait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
