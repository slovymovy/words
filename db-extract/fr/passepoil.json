                        "form": "passe-poil"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6c691420-9023-3bf3-a9a0-949d3fa235c0",
                        "entry_id": "effe6ae3-f745-3c0c-83df-2d51a8aafba2",
                        "glosses": [
                            "Bande étroite d’étoffe qu’on met entre les deux parties d’une couture, ou entre le dessus et la doublure, de manière qu’elle dépasse un peu l’un et l’autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50b36de0-9a8b-4128-bbec-17c88571e154",
                                "sense_id": "6c691420-9023-3bf3-a9a0-949d3fa235c0",
                                "text": "Un être insolite s’offrait à leurs regards : rouge, jaune, vert, bleu, couvert de passepoils, de franges, de rubans."
                            },
                            {
                                "example_id": "0ad96716-1c10-45ee-8a2a-2de2bfa7dada",
                                "sense_id": "6c691420-9023-3bf3-a9a0-949d3fa235c0",
                                "text": "Le garde-chiourme parlait à une voisine. Son képi à visière carrée, son ceinturon, son dolman noir et son pantalon bleu, à passepoil jonquille, provoquaient dans la rue une grandissante curiosité."
                            },
                            {
                                "example_id": "490804dc-ab88-4e8a-9ec6-7cc8cc7b4521",
                                "sense_id": "6c691420-9023-3bf3-a9a0-949d3fa235c0",
                                "text": "Pendant ce, le vieux aux cheveux gris, qui venait d’attacher les deux chevaux à une barrière, passait une veste écarlate de hussard, aux brandebourgs et au passepoil d’argent, et prenant un arrosoir, se dirigeait vers la ville."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "933e04af-3950-4c57-827b-8984e0a4df08",
                        "source_entry_id": "effe6ae3-f745-3c0c-83df-2d51a8aafba2",
                        "source_sense_id": "6c691420-9023-3bf3-a9a0-949d3fa235c0",
                        "target_lang_word": "Paspel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Paspel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "55eebd6b-c5e7-3498-a572-995813cd6878",
                                        "entry_id": "36c6d5a9-50a5-3bcc-9b5c-0c94bff49fe2",
                                        "glosses": [
                                            "Borte/Nahtbesatz/Zierstreifen an Nähten oder Rändern von Kleidungsstücken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "290f0d83-f9b4-4c82-90ba-fd79a675f79c",
                                                "sense_id": "55eebd6b-c5e7-3498-a572-995813cd6878",
                                                "text": "„An der rechten Seite war ein Stück an der Paspel aufgeschlitzt.“"
                                            },
                                            {
                                                "example_id": "471878ab-ae09-4c1f-8657-3f61970dbe21",
                                                "sense_id": "55eebd6b-c5e7-3498-a572-995813cd6878",
                                                "text": "„Ein in den Stoff geschnittener Tascheneingriff muss von einer Paspel oder einer Patte abgedeckt werden, um die beiden Schnittkanten zu versäubern.“"
                                            },
                                            {
                                                "example_id": "a14df531-022b-4d30-9272-54e896334207",
                                                "sense_id": "55eebd6b-c5e7-3498-a572-995813cd6878",
                                                "text": "„Während er sich bemüht, mich mit seinen Paspeln und Borten, seinen Litzen und Medaillen, seinen Achselschnüren und Goldknöpfen zu beeindrucken, denke ich gerührt an den Bundespolizisten am Eingang des Kanzleramts.“"
                                            },
                                            {
                                                "example_id": "3b1b6eed-c597-4860-8c47-d0b0ef7e71f9",
                                                "sense_id": "55eebd6b-c5e7-3498-a572-995813cd6878",
                                                "text": "„Sie lächelt tatsächlich, als sie das Handy in die Gesäßtasche ihrer Bluejeans mit schmaler silberner Paspel entlang der Beinnaht schiebt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
