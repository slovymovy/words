                        "translation_id": "3e3e566f-3253-479e-9483-34cf78c0796a",
                        "source_entry_id": "7c306301-170a-3c80-824d-9098bf24a58b",
                        "source_sense_id": "3effa534-ae81-344c-83d9-3371f0492736",
                        "target_lang_word": "employee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "employee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a9fa2bd-77ad-388a-beea-16ca7ca64cf3",
                                        "entry_id": "b463ade8-0224-30a8-a80e-753fe0036991",
                                        "glosses": [
                                            "A person who provides labor to a company or another person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "953aab94-605b-4798-9965-e6470b33a466",
                                                "sense_id": "2a9fa2bd-77ad-388a-beea-16ca7ca64cf3",
                                                "text": "One way to encourage your employees to work harder is by giving them incentives."
                                            },
                                            {
                                                "example_id": "8401a7de-df37-4940-876c-4fa3ecf70a42",
                                                "sense_id": "2a9fa2bd-77ad-388a-beea-16ca7ca64cf3",
                                                "text": "No one, however, would have anything to do with him, as Mr. Keeson's orders in those respects were very strict ; he had often threatened any one of his employés with instant dismissal if he found him in company with one of these touts."
                                            },
                                            {
                                                "example_id": "7ef149b2-b638-4ac6-ba2d-583911ba2b24",
                                                "sense_id": "2a9fa2bd-77ad-388a-beea-16ca7ca64cf3",
                                                "text": "The concepts of emotional intelligence (EI), self-worth, authenticity and employee meditation rooms might conjure up thoughts of new age healing centers. […] Now, Nielsen is sending all hotel employees through EI training to help them become more open and confident, understand their own limitations and fears, and to boost their self-worth and comfort in dealing with other people."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20ed844e-3fa2-4801-90d5-6c5692c3f021",
                        "source_entry_id": "7c306301-170a-3c80-824d-9098bf24a58b",
                        "source_sense_id": "3effa534-ae81-344c-83d9-3371f0492736",
                        "target_lang_word": "Arbeitnehmer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arbeitnehmer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3abbce36-ed6d-3f12-aba8-78e632bc98ab",
                                        "entry_id": "91c7e7e1-8eaf-38d3-83fc-f005890eaaba",
                                        "glosses": [
                                            "jemand, der bei einer Firma eingestellt ist und für seine Arbeit bezahlt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b0b70f4-33d0-4c92-afb7-972b911f85a1",
                                                "sense_id": "3abbce36-ed6d-3f12-aba8-78e632bc98ab",
                                                "text": "Der Aufschwung ist da – doch die Masse der Arbeitnehmer hat davon wenig."
                                            },
                                            {
                                                "example_id": "e7555bec-f3e7-48e2-bf49-83ac884879d7",
                                                "sense_id": "3abbce36-ed6d-3f12-aba8-78e632bc98ab",
                                                "text": "„Immer seltener fehlen Arbeitnehmer wegen Rückenschmerzen, Herzleiden oder Magenproblemen.“"
                                            },
                                            {
                                                "example_id": "9820c36a-9417-435f-b3c3-68e6364624de",
                                                "sense_id": "3abbce36-ed6d-3f12-aba8-78e632bc98ab",
                                                "text": "„Arbeitsrecht ist das Sonderrecht der abhängigen Arbeitnehmer. So sieht es die übliche Definition. … Arbeitsrecht gerade der abhängigen Arbeitnehmer weist auf unerledigte Emanzipationsprozesse (‚Abhängigkeit‘) und verrät in der terminologischen Rollenvertauschung (der ‚Arbeitnehmer‘ nimmt nicht, sondern gibt, der ‚Arbeitgeber‘ gibt nicht, sondern nimmt Arbeit im Sinne von Leistung) die gesellschaftlichen Machtverhältnisse solcher Abhängigkeit (der ‚Arbeitnehmer‘ nimmt, der ‚Arbeitgeber‘ gibt Arbeit im Sinne von Arbeitsgelegenheit).“"
                                            },
                                            {
                                                "example_id": "cce5fc04-64f6-4e05-9221-d3c28317aa54",
                                                "sense_id": "3abbce36-ed6d-3f12-aba8-78e632bc98ab",
                                                "text": "„Für alle Angestellten, Arbeiter und Beamten ist ein einheitliches Arbeitsrecht zu schaffen. Im Rahmen dieses Arbeitsrechts können Gesamtvereinbarungen nur zwischen den Gewerkschaften und den Unternehmungen oder ihren Vertretungen abgeschlossen werden. Sie schaffen verbindliches Recht, das grundsätzlich nur zugunsten der Arbeitnehmer abbedungen werden kann.“"
                                            },
                                            {
                                                "example_id": "1056a273-14ce-4f79-811b-699ab4b2619a",
                                                "sense_id": "3abbce36-ed6d-3f12-aba8-78e632bc98ab",
                                                "text": "„Jeder Arbeitnehmer, der in Deutschland in der Privatwirtschaft arbeitet, lebt vom Kapitalismus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
