                                        "entry_id": "614c54c2-4e6f-3c5f-8cdb-d9d6fdbddb2b",
                                        "glosses": [
                                            "A quality of an action such that repetitions of the action have no further effect on the outcome; the state of being idempotent."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d147cc0-94b5-443a-bf76-65247976e77d",
                                                "sense_id": "8befdd61-fe07-3452-ab60-70988f4eb5df",
                                                "text": "The proof (Tables 9 and 10) of idempotence for both OR and AND follows from examining the definition of each operation under the constraint that both inputs have the same value."
                                            }
                                        ]
                                    }
