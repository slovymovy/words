{
    "word_family": [
        "empower",
        "empowerment",
        "empowered"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "949da16f-af95-3f2a-85b8-87b446ea90bd",
                    "sense_definition": "Giving someone the confidence, authority, or power to do something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "empowerment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Learning to speak a new language is an <w>empowering</w> experience that opens many doors.",
                            "target_lang_translations": {
                                "zh": "学习一门新语言是一种<w>赋予力量的</w>经历，它能为你开启许多扇门。"
                            }
                        },
                        {
                            "text": "The manager gave an <w>empowering</w> speech that motivated the entire team to reach their goals.",
                            "target_lang_translations": {
                                "zh": "经理发表了一场<w>激励人心的</w>演讲，鼓舞了整个团队去实现他们的目标。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inspiring",
                        "motivating",
                        "enabling"
                    ],
                    "antonyms": [
                        "disempowering"
                    ],
                    "common_phrases": [
                        "empowering experience",
                        "empowering speech"
                    ],
                    "target_lang_definitions": {
                        "zh": "赋予某人信心、权力或能力去做某事，使人感到更有力量的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "赋予力量的",
                                "target_lang_sense_clarification": "形容事物或经历使人感到自信和有能力。"
                            },
                            {
                                "target_lang_word": "激励人心的",
                                "target_lang_sense_clarification": "形容言语或行为能够鼓舞士气。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f4dd78e8-c821-38f6-a7c1-874d78b1b5f8",
                    "sense_definition": "Present participle and gerund of <w>empower</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "empowerment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "By <w>empowering</w> employees to make decisions, the company improved its overall productivity.",
                            "target_lang_translations": {
                                "zh": "通过<w>授权</w>员工进行决策，公司提高了整体生产力。"
                            }
                        },
                        {
                            "text": "She believes that <w>empowering</w> local communities is the best way to create lasting change.",
                            "target_lang_translations": {
                                "zh": "她认为<w>赋予</w>当地社区<w>力量</w>是创造持久变革的最佳方式。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb empower."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "赋予权力、授权或使能够。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "授权",
                                "target_lang_sense_clarification": "给予某人做某事的权力。"
                            },
                            {
                                "target_lang_word": "使能够",
                                "target_lang_sense_clarification": "提供条件或能力，使某人可以完成某事。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
