                        "glosses": [
                            "Herod Antipas, tetrarch of the ancient Roman province of Judea, known for his roles in the executions of John the Baptist and Jesus of Nazareth."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dfba16f-ad07-4534-b6cd-455474d25e54",
                                "sense_id": "c17a02c6-7c0b-37d3-9b94-c70e76bcea98",
                                "text": "At the death of Herod the Great (4 b.c.), his sons — Archelaus, Herod Antipas, and Herod Philip — were given jurisdiction over his divided kingdom. Herod Antipas became the tetrarch of Galilee and Perea […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "09ff9c51-3f80-3d97-a51d-fd74ded2194c",
                        "entry_id": "ce62b5a3-61e6-3e27-862d-db89aa681472",
                        "glosses": [
                            "A martyr from the early Christian church at Pergamum."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c83ab9e-3c5f-4657-aa82-37805d6cbb01",
                                "sense_id": "09ff9c51-3f80-3d97-a51d-fd74ded2194c",
                                "text": "I know where you live—where Satan has his throne. Yet you remain true to my name. You did not renounce your faith in me, not even in the days of Antipas, my faithful witness, who was put to death in your city—where Satan lives."
                            }
                        ]
                    }
