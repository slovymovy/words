                                "sense_id": "85f310b0-aeab-39d0-8102-8318d3bed665",
                                "text": "Die taartpunt heeft de vorm van een gelijkbenige driehoek."
                            }
                        ]
                    },
                    {
                        "sense_id": "0853efae-4283-359c-b068-f3b35bfacf8d",
                        "entry_id": "29d13ad3-462f-37a6-9038-88465ee8d2c5",
                        "glosses": [
                            "waarvan de twee niet-evenwijdige zijden gelijk in lengte zijn"
                        ],
                        "tags": [
                            "gezegd van een trapezium"
                        ],
                        "examples": [
                            {
                                "example_id": "50e5cfd6-fb3c-4280-b44f-5ae411528c27",
                                "sense_id": "0853efae-4283-359c-b068-f3b35bfacf8d",
                                "text": "Alleen als het gelijkbenig is, kan een trapezium een koordenvierhoek zijn."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "897d240e-0e37-4dcd-93cb-4c2704b2b7a1",
                        "source_entry_id": "29d13ad3-462f-37a6-9038-88465ee8d2c5",
