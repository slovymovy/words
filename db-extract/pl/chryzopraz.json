                    },
                    {
                        "translation_id": "4b92b937-82de-47a5-8008-a9060451ccfc",
                        "source_entry_id": "7a7a6c0f-ab1a-3bde-a822-cc80352a08f7",
                        "source_sense_id": "cb5036d2-fe47-389f-8bf8-8492dde669f4",
                        "target_lang_word": "хризопраз",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "хризопраз",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "479f81c1-b2b4-3842-ac27-7490fe8fb6c6",
                                        "entry_id": "3b488636-0020-3ed7-8fe2-9e3ab53c011a",
                                        "glosses": [
                                            "минер. минерал, разновидность халцедона, содержащая небольшое количество никеля; полудрагоценный камень яблочно-зелёного цвета"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c21a8369-fc42-4f75-8b62-767712313a54",
                                                "sense_id": "479f81c1-b2b4-3842-ac27-7490fe8fb6c6",
                                                "text": "В Европе во второй половине XIX века яшма считалась драгоценным камнем второго порядка наряду с опалом, малахитом и хризопразом."
                                            },
                                            {
                                                "example_id": "820414fc-c56f-4f3c-a966-b4d2176c957c",
                                                "sense_id": "479f81c1-b2b4-3842-ac27-7490fe8fb6c6",
                                                "text": "Ванда тут же примерила диадему из малахита, бирюзы, гиацинта и хризопраза, малахитовые бусы, зелёное колечко."
                                            },
                                            {
                                                "example_id": "75c7ff33-18d0-4123-aa4b-14ce778d8dba",
                                                "sense_id": "479f81c1-b2b4-3842-ac27-7490fe8fb6c6",
                                                "text": "Она была близорука, носила лорнет на золотой цепочке с хризопразами, а затем, когда цепочка была продана, на бархатной ленточке."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
