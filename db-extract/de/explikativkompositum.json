                ],
                "senses": [
                    {
                        "sense_id": "facc4eef-8006-337b-9af3-83c154148e65",
                        "entry_id": "5938a616-6205-3d16-b441-5d68921c5e29",
                        "glosses": [
                            "Unterklasse der Determinativkomposita, bei denen der erste Teil (Determinans) die Bedeutung des zweiten Teils (Determinatum) mit einschließt"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "654060f7-bdae-4961-a3d3-bed39f26e076",
                                "sense_id": "facc4eef-8006-337b-9af3-83c154148e65",
                                "text": "„Zu den Determinativkomposita gehören des Weiteren die verdeutlichenden Komposita (auch: Explikativkomposita, Eichinger 2000: 77).“"
                            },
                            {
                                "example_id": "8ec243bb-d122-4925-95ee-17453e4e7572",
                                "sense_id": "facc4eef-8006-337b-9af3-83c154148e65",
                                "text": "„Spielverlauf“ ist ein Explikativkompositum, bei dem das Determinans „Spiel“ semantisch das Determinatum „Verlauf“ bereits enthält: Ein „Spiel“ ist an sich schon ein „Verlauf“. Ähnlich: „Eichbaum“."
                            },
                            {
                                "example_id": "cb26b7ae-473d-4ddb-a138-a2e159b18333",
                                "sense_id": "facc4eef-8006-337b-9af3-83c154148e65",
                                "text": "„ Determinativkomposita gliedern sich zudem in Possessivkomposita, Rektionskomposita und Explikativkomposita.“"
                            },
                            {
                                "example_id": "e99bb383-8cad-4f98-a784-3bbe8eb545a1",
                                "sense_id": "facc4eef-8006-337b-9af3-83c154148e65",
                                "text": "„Die Kompositionsarten unterscheiden sich von den Determinativkomposita durch ein anderes Bedeutungsverhältnis zwischen Erst- und Zweitglied → es wird über Kopulativ- und Explikativkomposita gesprochen, bzw. durch einen spezifischen Bezug zwischen Motivationsbedeutung und lexikalischer Bedeutung - Possesivkomposita.“"
                            },
                            {
                                "example_id": "d70e674f-566e-4bf3-a4fc-26bf6b2d0a55",
                                "sense_id": "facc4eef-8006-337b-9af3-83c154148e65",
                                "text": "„»Explikativkomposita« werden so beschrieben: Auswertungsverfahren „Auswertung ist ein Verfahren“;…“"
                            },
                            {
                                "example_id": "04630426-9889-4346-975a-97e3ee68b050",
                                "sense_id": "facc4eef-8006-337b-9af3-83c154148e65",
                                "text": "„Explikativkomposita (Eichinger): verdeutlichende Komposita, gehören zur Gruppe der Determinativkomposita…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
