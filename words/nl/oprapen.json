                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>raapte</w> de gevallen spijkers <w>op</w> van de vloer.",
                            "target_lang_translations": {
                                "en": "He <w>picked up</w> the fallen nails from the floor.",
