                ],
                "senses": [
                    {
                        "sense_id": "a65cda20-cced-34f9-a093-d02ad5aa4d8f",
                        "entry_id": "c5328f58-44c7-31d1-82f0-58760e8fdef7",
                        "glosses": [
                            "spirytusowy roztwór szelaku, używany głównie w meblarstwie, służący do wykańczania powierzchni drewna"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22d133d6-6b24-4e12-a1b9-d693c345cc6f",
                                "sense_id": "a65cda20-cced-34f9-a093-d02ad5aa4d8f",
                                "text": "Ojciec zwilżył szmatę paroma kroplami politury i tak wrzucił pod blachę"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "200a2c20-fc2d-3475-a0ff-20e629db16f1",
                        "entry_id": "c5328f58-44c7-31d1-82f0-58760e8fdef7",
                        "glosses": [
                            "powłoka z politury (1.1)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e38f29cc-53f4-4fd3-80b9-f0b5c11044ee",
                                "sense_id": "200a2c20-fc2d-3475-a0ff-20e629db16f1",
                                "text": "Były to stoły, krzesła, stoliki, zegary, które jeszcze niedawno przypominały stare rupiecie, teraz zaś, wyleczone przez pana Kleksa, lśniły, połyskiwały świeżutką politurą i wyglądały jak nowe"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "f73ffef4-3dcc-3f87-94b5-9a6c4cab4a06",
                        "entry_id": "c5328f58-44c7-31d1-82f0-58760e8fdef7",
                        "glosses": [
                            "coś, co jest przykrywką dla prawdziwego stanu rzeczy"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "cccb9b47-ba6b-4503-af66-10e0c267daae",
                                "sense_id": "f73ffef4-3dcc-3f87-94b5-9a6c4cab4a06",
                                "text": "A skrapla się ona w rewelacji na temat dzikości i niedostępności Czarnego Lądu, ale - o czym dzisiaj wiemy coraz lepiej - w wiedzy o esencjalnej dzikości i nieokiełznania w sercu Białego Człowieka. A więc tego wszystkiego, co skutecznie kryło się za cywilizacyjną politurą"
                            },
                            {
                                "example_id": "90f64ff2-a81e-4471-8d20-eef421620ee9",
                                "sense_id": "f73ffef4-3dcc-3f87-94b5-9a6c4cab4a06",
                                "text": "Brzmiał tak, jak gdyby odprysła z niego cała aktorska politura"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
