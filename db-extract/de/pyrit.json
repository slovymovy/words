                "translations": [
                    {
                        "translation_id": "da6c637b-fea8-4cfc-b2e6-a00f943dadd6",
                        "source_entry_id": "bf21beaa-6aba-3738-92b3-07af7fa4cf38",
                        "source_sense_id": "fc34dd13-d8d5-317c-92da-b5e6d641edc8",
                        "source_sense_description": "häufig vorkommendes, hartes Mineral, das aus Schwefel und Eisen besteht",
                        "target_lang_word": "pyrite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pyrite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d9c8a08-99e7-3aaf-9019-3f1a8aed4a17",
                                        "entry_id": "9321d760-7860-3880-aff6-2f1fee41aada",
                                        "glosses": [
                                            "The common mineral iron disulfide (FeS₂), of a pale brass-yellow color and brilliant metallic luster, crystallizing in the isometric system."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b42506f4-06c0-4ad4-b9ba-cef8a56da70c",
                                                "sense_id": "5d9c8a08-99e7-3aaf-9019-3f1a8aed4a17",
                                                "text": "The pyrite output in 1961 was 1.2 million tons, derived mainly from the Hsiang Shan mine in Anhwei and the Ying-te mine in Kwangtung."
                                            },
                                            {
                                                "example_id": "ebbae260-25a1-4c23-8114-d8d232237ffc",
                                                "sense_id": "5d9c8a08-99e7-3aaf-9019-3f1a8aed4a17",
                                                "text": "China's 13 large foreign fertilizer plants ordered a few years ago are all scheduled to be in operation in a year or two.[…]China's biggest pyrite mine (openpit), being built in Yunfu, Kwangtung Province, was near completion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09f97eb2-5835-32d4-b2bd-29eb70f94846",
                                        "entry_id": "9321d760-7860-3880-aff6-2f1fee41aada",
                                        "glosses": [
                                            "Any metallic-looking sulphide, such as the above, which is the most common."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7c683f4f-af33-3e0d-9b20-107c12330cc3",
                                        "entry_id": "9321d760-7860-3880-aff6-2f1fee41aada",
                                        "glosses": [
                                            "(usually as a plural: pyrites) Any metal dichalcogenide that is isostructural to the common mineral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "776f77f0-4f78-4972-95bb-7e0d434704e4",
                                                "sense_id": "7c683f4f-af33-3e0d-9b20-107c12330cc3",
                                                "text": "Copper diselenide can occur both as a marcasite and a pyrite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ffb8e5c1-17c0-4a08-9969-3c4f05e25857",
                        "source_entry_id": "bf21beaa-6aba-3738-92b3-07af7fa4cf38",
                        "source_sense_id": "fc34dd13-d8d5-317c-92da-b5e6d641edc8",
                        "source_sense_description": "häufig vorkommendes, hartes Mineral, das aus Schwefel und Eisen besteht",
                        "target_lang_word": "pyrite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pyrite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4670b018-347d-3f7f-86fd-d0a71549654e",
                                        "entry_id": "29f5f640-159c-39d5-b641-e5fcfb4fd510",
                                        "glosses": [
                                            "Minéral composé de sulfure de fer, de formule FeS₂."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "223a8b12-026a-4a23-b19d-124cc58dd784",
                                                "sense_id": "4670b018-347d-3f7f-86fd-d0a71549654e",
                                                "text": "La chalazias eſt de la couleur & de la figure d’un grain de grêle (29), & elle eſt dure comme un diamant. On dit même qu’étant miſe au feu, elle conſerve ſa froideur.\nLa pyrite (30) eſt noire ; mais quand on la frotte avec ſes doigts, elle les brûle.\nLa polyzone (31) eſt pareillement noire, mais environnée de pluſieurs lignes blanchâtres."
                                            },
                                            {
                                                "example_id": "d6dcdff0-fdd0-44ae-b414-c5c6e1ee7fbc",
                                                "sense_id": "4670b018-347d-3f7f-86fd-d0a71549654e",
                                                "text": "La houille est généralement assez impure et contient des pyrites et des matières argileuses qui agissent d’une manière fâcheuse dans plusieurs opérations industrielles. Le soufre des pyrites donne à la fonte de mauvaises qualités […]"
                                            },
                                            {
                                                "example_id": "48f15c9c-f050-4ae5-996e-845a3a8534a7",
                                                "sense_id": "4670b018-347d-3f7f-86fd-d0a71549654e",
                                                "text": "[…] ses voyages d’enquête et ses déplacements d’affaires étaient moins mystérieux. Il en parlait. On les connaît presque tous, entre autres ce fameux voyage en Sardaigne, d’où il rapporta ces pyrites, à propos desquelles il rêva une fortune de milliardaire."
                                            },
                                            {
                                                "example_id": "63ed7509-f765-4e59-8c3d-4d45c7fe4014",
                                                "sense_id": "4670b018-347d-3f7f-86fd-d0a71549654e",
                                                "text": "La fabrication de l’acide sulfurique se fait en deux étapes : d’abord la transformation des pyrites en couperose verte, puis la distillation de la couperose verte."
                                            },
                                            {
                                                "example_id": "a50cb289-44b8-4b12-b1cf-a0c61d6a8916",
                                                "sense_id": "4670b018-347d-3f7f-86fd-d0a71549654e",
                                                "text": "Le premier objectif sera de vérifier la présence de sulfures et plus spécifiquement de pyrite qui est le facteur déterminant dans l’apparition du phénomène d’acidification."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
