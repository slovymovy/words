                                        "glosses": [
                                            "Anweisungen oder Befehle eines Vorgesetzten oder der Eltern/eines Vormundes befolgend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b06d07ac-70b4-4126-aa45-7896f1abd0e4",
                                                "sense_id": "3107b2a3-288a-3745-9aba-0ec77a8ae1fa",
                                                "text": "Das ist ein sehr gehorsames Kind, es widerspricht nicht ständig."
                                            },
                                            {
                                                "example_id": "10e25905-c9fe-413b-95ba-ea3208a1e9eb",
                                                "sense_id": "3107b2a3-288a-3745-9aba-0ec77a8ae1fa",
                                                "text": "Wir müssen gehorsamer sein, dann erhalten wir mehr Rechte."
                                            },
                                            {
                                                "example_id": "cf94f7fe-5b8e-47f6-b249-7867ae9cdcf6",
                                                "sense_id": "3107b2a3-288a-3745-9aba-0ec77a8ae1fa",
                                                "text": "„Schon als Kind war Freddie von den drei Brüdern der körperlich stärkste gewesen. Er war aber auch der gehorsamste Sohn Don Corleones.“"
                                            },
                                            {
                                                "example_id": "dab384ec-e00a-4f01-b9ce-7464006d725a",
                                                "sense_id": "3107b2a3-288a-3745-9aba-0ec77a8ae1fa",
                                                "text": "„Er tat gehorsam, was man ihm gebot, holte Wasser, spaltete Holz, arbeitete mit auf dem Felde, räumte die Küche auf und erledigte verläßlich, wenn auch mit verärgernder Langsamkeit, jeden geforderten Dienst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
