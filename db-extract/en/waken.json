                        "entry_id": "e890dd54-bd49-301c-a3ef-5698c030b35b",
                        "glosses": [
                            "To wake or rouse from sleep."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6f14b46b-8543-3fbc-96a1-318c64e607b8",
                        "entry_id": "e890dd54-bd49-301c-a3ef-5698c030b35b",
                        "glosses": [
                            "To awaken; to cease to sleep; to be awakened; to stir."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "94d2e5c6-e1ea-4aad-a413-d67099ff5380",
                                "sense_id": "6f14b46b-8543-3fbc-96a1-318c64e607b8",
                                "text": "Early, Turnus wakening with the light."
                            },
                            {
                                "example_id": "0ea2fc1e-3557-4be6-ab11-6e35f92b81d9",
                                "sense_id": "6f14b46b-8543-3fbc-96a1-318c64e607b8",
                                "text": "She wakened in sharp panic, bewildered by the grotesquerie of some half-remembered dream in contrast with the harshness of inclement fact, drowsily realizing that since she had fallen asleep it had come on to rain smartly out of a shrouded sky."
                            }
                        ]
                    }
