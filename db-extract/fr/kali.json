                                    {
                                        "sense_id": "060d4295-bd93-349d-8582-5498b6937ad3",
                                        "entry_id": "d8a148e4-35ae-3c5c-9790-b7b79249cd32",
                                        "glosses": [
                                            "A type of British crystalline sweet or candy, similar in appearance to sherbet but made with larger sugar crystals."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3c5f9a1-c28e-48c6-83fd-224315e1a618",
                                                "sense_id": "060d4295-bd93-349d-8582-5498b6937ad3",
                                                "text": "[M]any women will be glad to know exactly how to start making sweets so that they will be saleable. [...] Lozenges, comfits, kali, bonbons, etc."
                                            },
                                            {
                                                "example_id": "095da932-394e-4cab-b8f0-655b23308966",
                                                "sense_id": "060d4295-bd93-349d-8582-5498b6937ad3",
                                                "text": "The stock is supplied by Sela Traditional Sweet Co., based in Thynne Street, West Bromwich, which has been making a vast range of boiled sweets—sarsaparilla tablets, kali, clove balls, lime juice bricks, rosy apples and the rest—since 1882."
                                            },
                                            {
                                                "example_id": "d52452b4-45a5-4beb-92be-6f4f48e881a7",
                                                "sense_id": "060d4295-bd93-349d-8582-5498b6937ad3",
                                                "text": "A positive shower of sherbets. Include fountains, lemons, dibdabs, flying saucers, even jars of Kali."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kali",
