                ],
                "senses": [
                    {
                        "sense_id": "9e4510ec-001c-3c73-b88d-0e23254b9740",
                        "entry_id": "9d3d7ad7-d43d-3618-a5e3-baa031cd837a",
                        "glosses": [
                            "Devenir adolescent."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c4f2ec31-4cf1-42bf-9383-ace9b96a716e",
                                "sense_id": "9e4510ec-001c-3c73-b88d-0e23254b9740",
                                "text": "J'aurais dû faire ça il y a dix-huit ou dix-neuf ans, j'aurais dû me laisser tenter par d'autres hommes, j'aurais dû mettre de côté mes idées romanesques sur l'amour éternel, j'aurais dû VIVRE, j'aurais dû le larguer, voyager, m'amuser, m'adolescenter au lieu de m'adulter à la première heure."
                            },
                            {
                                "example_id": "4bf68ffa-b779-4fe2-a9ee-be522501e97c",
                                "sense_id": "9e4510ec-001c-3c73-b88d-0e23254b9740",
                                "text": "Cet arbre d'eau de vingt mètres, vous le voyez naître, grandir, adolescenter avec vigueur et gaucherie, puis, avec des efforts d'être vivant, atteindre son zénith dans un (...)"
                            },
                            {
                                "example_id": "6b1809c9-fc6a-4ce9-8dec-055558d92f1f",
                                "sense_id": "9e4510ec-001c-3c73-b88d-0e23254b9740",
                                "text": "Adolescenterais-je déjà ?"
                            }
                        ]
                    }
