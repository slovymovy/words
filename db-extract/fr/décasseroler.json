                ],
                "senses": [
                    {
                        "sense_id": "ac5301e4-6869-393c-91d6-fa633d7370d6",
                        "entry_id": "f4527cba-ee25-39da-be23-cf1fd622972f",
                        "glosses": [
                            "Enlever d’une casserole."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be0e4a57-5f34-4f6c-ba92-eac7df14dcf8",
                                "sense_id": "ac5301e4-6869-393c-91d6-fa633d7370d6",
                                "text": "S'apercevoir que toute l'eau s'est évaporée, et que les pâtes à l'intérieur ont plus ou moins fusionné; Démouler, enfin décasseroler."
                            },
                            {
                                "example_id": "83c45931-f191-4a5a-a0f0-32315b2b2ad7",
                                "sense_id": "ac5301e4-6869-393c-91d6-fa633d7370d6",
                                "text": "La vipère \"décasserolée\""
                            },
                            {
                                "example_id": "10e03d69-7452-43d9-ac3f-1e21587bb02f",
                                "sense_id": "ac5301e4-6869-393c-91d6-fa633d7370d6",
                                "text": "Nous descendons « décasseroler » comme disent les italiens. L'un de nous s'y met ou nous cuisinons ensemble ; nous ne faisons pas une dînette mais un vrai repas : beau, bon, aux saveurs multiples, il faut se régaler."
                            }
                        ]
                    }
