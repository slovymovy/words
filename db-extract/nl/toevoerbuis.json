                        "examples": [
                            {
                                "example_id": "edaf1acd-1c7e-4a5c-ac6d-85d7b5c2da88",
                                "sense_id": "b3f7640a-6d01-351e-9bb4-0f10a626c577",
                                "text": "Mijn gehoor was altijd gespitst op de ventilator in de toevoerbuis."
                            },
                            {
                                "example_id": "85c5add9-1544-44cc-be36-62a0841d7810",
                                "sense_id": "b3f7640a-6d01-351e-9bb4-0f10a626c577",
                                "text": "De Veiligheidsregio Twente had het RIVM gevraagd om een inschatting van risico’s te maken. Het RIVM heeft daarop een literatuurstudie gedaan naar de ongevallen die zich sinds de jaren vijftig voordeden. Die historische gegevens blijken slechts zeer beperkt toepasbaar te zijn voor het inschatten van de risico’s bij de Marssteden. Dat heeft te maken met de specifieke preventieve maatregelen die daar genomen zijn, zoals een dubbelwandige toevoerbuis, en de moderne middelen die worden toegepast. ‘Daardoor is de kans op een incident onvoldoende betrouwbaar in te schatten’, stelt het RIVM in een notitie."
                            }
                        ]
