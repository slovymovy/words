                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "ab54ebaf-0514-4594-b0c2-aca775410aa6",
                                "sense_id": "0b4cf8d0-4545-3bc1-89fc-6f807681f763",
                                "text": "De zonsopgang boven de bergen was spectaculair.",
                                "translation": "The sunrise over the mountains was spectacular.",
                                "english": "The sunrise over the mountains was spectacular."
                            },
                            {
                                "example_id": "0e511fc7-78af-400b-98f3-56510f56d3d7",
                                "sense_id": "0b4cf8d0-4545-3bc1-89fc-6f807681f763",
                                "text": "Fotografen wachten vaak op zonsopgang om de perfecte foto te maken.",
                                "translation": "Photographers often wait for sunrise to capture the perfect shot.",
                                "english": "Photographers often wait for sunrise to capture the perfect shot."
                            },
                            {
                                "example_id": "3598658e-8f6f-4ee1-980c-96d6b8b238f9",
                                "sense_id": "0b4cf8d0-4545-3bc1-89fc-6f807681f763",
                                "text": "Ze mediteerde tijdens zonsopgang voor een vredig begin van de dag.",
                                "translation": "She meditated at sunrise for a peaceful start to the day.",
                                "english": "She meditated at sunrise for a peaceful start to the day."
                            }
                        ]
                    }
                ],
