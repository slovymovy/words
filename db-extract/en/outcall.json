                        "glosses": [
                            "To surpass in calling."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "7bf69906-a953-4f5f-b236-5ccf10a1cf12",
                                "sense_id": "5319b2d0-01aa-33e1-adff-03388ec2e39d",
                                "text": "I […] saw as usual great numbers of Cuckoos […] most of them calling vociferously, each apparently trying to outcall the other."
                            },
                            {
                                "example_id": "82a8c07f-a4c7-46f0-a627-525cbb4494e2",
                                "sense_id": "5319b2d0-01aa-33e1-adff-03388ec2e39d",
                                "text": "Trying to outcall the other hunter could work, but it creates a competitive and possibly dangerous situation."
                            }
                        ]
                    }
