                        "entry_id": "e8aeae50-9455-33d3-9c98-79821eaa4573",
                        "glosses": [
                            "рег. пастьба скота"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d86a11a-462a-40b0-9ea3-3f70fd7f9e3e",
                                "sense_id": "77a38034-f666-3ed4-97cd-a34a6ba5fde8",
                                "text": "Стреноженных лошадей пустили на попас, назначив в караул трех человек."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff01f90d-bfb7-3e09-87ed-83b06583a7b6",
                        "entry_id": "e8aeae50-9455-33d3-9c98-79821eaa4573",
                        "glosses": [
                            "рег. место, отведённое для временной пастьбы скота"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9e1cdeb-976b-4873-82ab-beb48205a254",
                                "sense_id": "ff01f90d-bfb7-3e09-87ed-83b06583a7b6",
                                "text": "Кус земли во многие тысячи десятин был отведен под попас станичных жеребцов, потому и назван — отводом."
                            }
                        ]
                    }
