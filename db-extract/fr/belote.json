                    },
                    {
                        "translation_id": "ee015b60-1ad2-40a8-ba6a-77edf9bfe07d",
                        "source_entry_id": "b734f8c5-ba8d-35e9-97c4-2d7c0ede7df7",
                        "source_sense_description": "Roi et dame d’atout",
                        "target_lang_word": "stuk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stuk",
