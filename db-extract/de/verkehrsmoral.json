                "senses": [
                    {
                        "sense_id": "0227a68e-abf1-3a09-bcde-dccf3a110eea",
                        "entry_id": "d0bf5083-8a4d-3865-a114-36941d17be20",
                        "glosses": [
                            "Bereitschaft, sein Handeln nach den allgemein anerkannten Regeln und Konventionen im Verkehrsleben auszurichten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcbe3627-1bd1-40cb-922f-4bdf171dddbd",
                                "sense_id": "0227a68e-abf1-3a09-bcde-dccf3a110eea",
                                "text": "„Zwar besteht offenbar überall auf der Welt die Neigung, alles, was als krumm empfunden wird, in den Schulen geradebiegen zu lassen, ob es sich nun um Verkehrsmoral handelt oder um die Überbrückung von Rassen-, Klassen- oder Religions-Trennungen.“"
                            },
                            {
                                "example_id": "3d6c1aee-f513-4b22-93e6-313deade3fbe",
                                "sense_id": "0227a68e-abf1-3a09-bcde-dccf3a110eea",
                                "text": "„Die Verkehrssünderkartei zu modifizieren, verbessere nicht die zunehmend verlotterte Verkehrsmoral vieler Verkehrsteilnehmer, sagte der GdP-Bundesvorsitzende Bernhard Witthaut.“"
                            },
                            {
                                "example_id": "f19916c5-6c7b-4cff-8d55-0aeca91e3eaa",
                                "sense_id": "0227a68e-abf1-3a09-bcde-dccf3a110eea",
                                "text": "„Dabei, so Ellinghaus, hängt die Verkehrsmoral nicht unbedingt allein von der Existenz amtlicher Vorschriften ab.“"
                            },
                            {
                                "example_id": "f3c24fd2-afce-4d69-9c32-4b0ef05ed66b",
                                "sense_id": "0227a68e-abf1-3a09-bcde-dccf3a110eea",
                                "text": "„Die Initiativen kritisieren, daß die Verkehrsmoral in der Hauptstadt In den vergangenen Jahren stark nachgelassen habe.“"
                            },
                            {
                                "example_id": "9e381551-7a76-4bb9-973a-a45131a31779",
                                "sense_id": "0227a68e-abf1-3a09-bcde-dccf3a110eea",
                                "text": "„Die zitierte Verkehrschronik beklagt sich auch über die mangelnde Verkehrsmoral der Radfahrer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
