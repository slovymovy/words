                "senses": [
                    {
                        "sense_id": "c59eabf6-b80c-30a2-bf8a-34347e37b70f",
                        "entry_id": "2d91f0ca-1d9c-3a12-95fc-c21002c2bb32",
                        "glosses": [
                            "Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31cc1875-46ae-458a-90d4-399fb839e8d4",
                                "sense_id": "c59eabf6-b80c-30a2-bf8a-34347e37b70f",
                                "text": "Der Giannoli trägt nie die Schals, die die Giannoli ihm strickt."
                            },
                            {
                                "example_id": "1ff654e6-4ea0-4e43-9140-18a2bc08e8d3",
                                "sense_id": "c59eabf6-b80c-30a2-bf8a-34347e37b70f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Giannoli kommt, geht der Herr Giannoli.“"
                            },
                            {
                                "example_id": "6ecab41b-1a6c-42bc-9697-1b863a433e00",
                                "sense_id": "c59eabf6-b80c-30a2-bf8a-34347e37b70f",
                                "text": "Giannoli kommt und geht."
                            },
                            {
                                "example_id": "67b720e7-7d4b-478a-8fe2-12e07bd50214",
                                "sense_id": "c59eabf6-b80c-30a2-bf8a-34347e37b70f",
                                "text": "Giannolis kamen, sahen und siegten."
                            },
                            {
                                "example_id": "5365833b-6d7b-4d9d-a2ae-46ef906e220b",
                                "sense_id": "c59eabf6-b80c-30a2-bf8a-34347e37b70f",
                                "text": "Frau Giannoli ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5f73e305-4897-41df-8abe-d005f9c3cc74",
                                "sense_id": "c59eabf6-b80c-30a2-bf8a-34347e37b70f",
                                "text": "Herr Giannoli wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7eac7e68-0e51-4ad4-b4c5-79d3dee161b3",
                                "sense_id": "c59eabf6-b80c-30a2-bf8a-34347e37b70f",
                                "text": "Die Giannolis fahren heute nach Köln."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
