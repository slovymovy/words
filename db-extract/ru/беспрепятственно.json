                                            {
                                                "example_id": "40926010-a1a1-4b2e-b1cd-e784d162b9a1",
                                                "sense_id": "f725432f-d65d-3803-8aae-36c1c5c48248",
                                                "text": "Wine was flowing freely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "088c57d3-9a72-3868-a378-4d0d6fdbff48",
                                        "entry_id": "dac66113-eff5-395d-9a13-195f68541f00",
                                        "glosses": [
                                            "Without interference or restriction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "299f734f-7013-486d-840e-5447bdcfccf2",
                                                "sense_id": "088c57d3-9a72-3868-a378-4d0d6fdbff48",
                                                "text": "talk freely"
                                            },
                                            {
                                                "example_id": "b123042b-3199-4f84-b91e-97910fcee21c",
                                                "sense_id": "088c57d3-9a72-3868-a378-4d0d6fdbff48",
                                                "text": "I found that the Chapelon steamed almost too freely, because on a strange locomotive and road one usually tends to overfire a little through a natural lack of confidence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b6b8144-43d2-3290-85bd-37184f411dde",
                                        "entry_id": "dac66113-eff5-395d-9a13-195f68541f00",
                                        "glosses": [
                                            "Of one's own free will."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b67a765-ec35-403f-a9f1-83e9f041bbbf",
                                                "sense_id": "9b6b8144-43d2-3290-85bd-37184f411dde",
                                                "text": "I will freely help you."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
