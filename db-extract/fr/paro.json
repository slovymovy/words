                        "examples": [
                            {
                                "example_id": "95b867bf-e1bb-402c-b9da-4cb77c6552da",
                                "sense_id": "d86b7897-5b79-33fe-9825-0b4d1b76ac6b",
                                "text": "Le coût d’un traitement paro étant relativement élevé pour le patient, le traitement clinique et le suivi administratif exigent une rigueur qui ne peut faire défaut à aucun niveau."
                            },
                            {
                                "example_id": "68ffd9ea-ef74-4ab9-84c0-45c9cdfd75bf",
                                "sense_id": "d86b7897-5b79-33fe-9825-0b4d1b76ac6b",
                                "text": "Un ortho me demande de faire une contention paro fibrée sur une patiente qui a eu un traitement ortho et paro. J'ai un gros soucis impossible de trouver la codification CCAM si c'est opposable ou ED ou en NPC."
                            }
                        ]
                    }
                ],
