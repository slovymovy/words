                "senses": [
                    {
                        "sense_id": "c52f4a0f-5e38-3ba9-bbe0-0802974b4809",
                        "entry_id": "b5dbc4b9-3650-353b-b91f-25adcdae8252",
                        "glosses": [
                            "extrem dünnes, sehr biegsames Produkt von Spinndrüsen, das der Fortbewegung bestimmter Spinnenarten durch die Luft (dem Spinnenflug) dient"
                        ],
                        "tags": [
                            "Arachnologie"
                        ],
                        "examples": [
                            {
                                "example_id": "089bae66-cd05-4b9e-8494-fb070590a7b0",
                                "sense_id": "c52f4a0f-5e38-3ba9-bbe0-0802974b4809",
                                "text": "„Ist der Faden lang und der Auftrieb groß genug, läßt die Spinne ihren Standort los und wird am Flugfaden vom Wind davongetragen.“"
                            },
                            {
                                "example_id": "0f73b62b-8598-44c2-bdd2-19bf96d89572",
                                "sense_id": "c52f4a0f-5e38-3ba9-bbe0-0802974b4809",
                                "text": "„[…] da hatte es noch ganz kurz etwas anderes gegeben, […] nur ganz zart streifend, wie die Flugfaden des Altweibersommers das das Gesicht berühren: […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
