                        "target_lang_word": "execution",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "execution",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23778308-a9e5-3687-a2ed-7e71bdaf5f70",
                                        "entry_id": "a8c3109b-5001-3af7-bbbf-c3d5419d96cd",
                                        "glosses": [
                                            "The act, manner or style of executing (actions, maneuvers, performances)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "631a014b-ce15-415a-b413-c72880f96955",
                                                "sense_id": "23778308-a9e5-3687-a2ed-7e71bdaf5f70",
                                                "text": "Already the poor man saw himself crowned by the might of his arm Emperor of Trebizond at least; and so, led away by the intense enjoyment he found in these pleasant fancies, he set himself forthwith to put his scheme into execution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1913ff7a-7438-3ec7-9f54-ed3066105d81",
                                        "entry_id": "a8c3109b-5001-3af7-bbbf-c3d5419d96cd",
                                        "glosses": [
                                            "The state of being accomplished."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4d83a88-de3e-4479-bdd6-ff24621b9a39",
                                                "sense_id": "1913ff7a-7438-3ec7-9f54-ed3066105d81",
                                                "text": "The mission's successful execution lifted the troops' morale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2125f500-1ce5-32a0-826a-c118478d9d0e",
                                        "entry_id": "a8c3109b-5001-3af7-bbbf-c3d5419d96cd",
                                        "glosses": [
                                            "The act of putting to death or being put to death as a penalty, or actions so associated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0defa1bb-eec0-32b3-b57f-7cb1fa28de3c",
                                        "entry_id": "a8c3109b-5001-3af7-bbbf-c3d5419d96cd",
                                        "glosses": [
                                            "The carrying into effect of a court judgment, or of a will."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c6c8b226-72aa-31b5-8a1e-6c27e192b795",
                                        "entry_id": "a8c3109b-5001-3af7-bbbf-c3d5419d96cd",
                                        "glosses": [
                                            "Specifically, the seizure of a debtor's goods or property in default of payment."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b59ed5e-a4fb-426a-b0e0-9dded0d1d0f2",
                                                "sense_id": "c6c8b226-72aa-31b5-8a1e-6c27e192b795",
                                                "text": "There are two executions in the house, one for sixteen hundred, the other for two thousand three hundred pounds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65ade720-d14a-3b85-967a-6f7cd9cc6e3e",
                                        "entry_id": "a8c3109b-5001-3af7-bbbf-c3d5419d96cd",
                                        "glosses": [
                                            "The formal process by which a contract is made valid and put into binding effect."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "313e510c-3654-37e5-909d-422dbfb8d5db",
                                        "entry_id": "a8c3109b-5001-3af7-bbbf-c3d5419d96cd",
                                        "glosses": [
                                            "The carrying out of an instruction, program or program segment by a computer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "800f4d0f-0287-4886-95ae-747350d8d92e",
                                                "sense_id": "313e510c-3654-37e5-909d-422dbfb8d5db",
                                                "text": "The entire machine slowed down during the execution of the virus checker."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6dbf08e8-9256-4e13-8a5f-9d67c452d159",
                        "source_entry_id": "d147b0ad-e943-35ef-90b5-41acb286f578",
                        "source_sense_id": "cdb3c35d-211b-3a8b-88c0-6038ff6b237e",
                        "source_sense_description": "Recht: Umsetzung, Vollzug eines Urteils",
                        "target_lang_word": "exécution",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exécution",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d9e413e6-8881-3a5b-9dd7-03ce3b5ef95d",
                                        "entry_id": "6285cb97-eaa1-3d15-adfc-4c11f126d57f",
                                        "glosses": [
                                            "Action d’exécuter quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ebef8b4-3ca7-4f8f-ac6c-69bcec5a6251",
                                                "sense_id": "d9e413e6-8881-3a5b-9dd7-03ce3b5ef95d",
                                                "text": "Au surplus , comme il était décidé que la citadelle serait rendue avant toute autre chose, la France et l’Angleterre passèrent outre à l’exécution complète de la convention du 22 octobre."
                                            },
                                            {
                                                "example_id": "b8ec8df9-4574-435a-9787-40e8392c1f1d",
                                                "sense_id": "d9e413e6-8881-3a5b-9dd7-03ce3b5ef95d",
                                                "text": "Il s’agissait de déclarer si le roi pourrait, oui ou non, s’opposer à l’exécution des décrets des législateurs. On accorda à Louis XVI le veto suspensif pendant quatre ans."
                                            },
                                            {
                                                "example_id": "865611aa-1e50-4f57-9227-5d44b528c3ff",
                                                "sense_id": "d9e413e6-8881-3a5b-9dd7-03ce3b5ef95d",
                                                "text": "En effet, en exécution de ces lettres patentes, l’emplacement pour bâtir le nouveau bourg fut tracé au delà de l’Aude, […]."
                                            },
                                            {
                                                "example_id": "395d3c66-2123-4c1e-bc2c-d96f896a08d5",
                                                "sense_id": "d9e413e6-8881-3a5b-9dd7-03ce3b5ef95d",
                                                "text": "La proposition rallia tout le monde et l’on se mit en devoir d’en réaliser l’exécution  ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a429388a-bc11-34fc-a0a7-14b38a0d4244",
                                        "entry_id": "6285cb97-eaa1-3d15-adfc-4c11f126d57f",
                                        "glosses": [
                                            "Action d’exécuter quelqu’un, de le mettre à mort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "297769fe-58e0-45ea-a797-903d7eb6d069",
                                                "sense_id": "a429388a-bc11-34fc-a0a7-14b38a0d4244",
                                                "text": "Au mois de janvier de cette année, me trouvant à Paris, […], je reçus de Maxime Du Camp l’invitation tout à fait inattendue d’assister à l’exécution de Troppmann."
                                            },
                                            {
                                                "example_id": "8fc1da8e-3ccc-430d-b50f-c39bc259e70c",
                                                "sense_id": "a429388a-bc11-34fc-a0a7-14b38a0d4244",
                                                "text": "Il faudrait représenter Rabourdin habillé en boucher, mais bien ressemblant, chercher des analogies entre un bureau et une cuisine, lui mettre à la main un tranche-lard, peindre les principaux employés des ministères en volailles, les encager dans une immense souricière sur laquelle on écrirait : Exécutions administratives, et il serait censé leur couper le cou un à un."
                                            },
                                            {
                                                "example_id": "97f0c859-1597-46d0-a1c3-dc275f918432",
                                                "sense_id": "a429388a-bc11-34fc-a0a7-14b38a0d4244",
                                                "text": "Staline s’était signalé par des proscriptions impitoyables: découvertes de complots, exécutions d’agents de l’ennemi, épurations à coup de révolver."
                                            },
                                            {
                                                "example_id": "97370bb2-f6c7-40cc-88e3-0288fc465aee",
                                                "sense_id": "a429388a-bc11-34fc-a0a7-14b38a0d4244",
                                                "text": "Le gouvernement ordonne une répression sanglante. Arrestations, pendaisons, exécutions sommaires plongent Tripoli dans un bain de sang."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03d7b9f8-d7f6-3fc8-80e1-b00c393f9eba",
                                        "entry_id": "6285cb97-eaa1-3d15-adfc-4c11f126d57f",
                                        "glosses": [
                                            "Critique décisive qui fait justice d’un homme ou d’une œuvre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "exécution",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f45381f9-8b05-3287-b061-6a19921f92de",
                                        "entry_id": "cd340f61-0247-30e1-a21e-c875478d084d",
                                        "glosses": [
                                            "Injonction donnée nécessitant d’agir aussitôt en conséquence."
                                        ],
                                        "tags": [],
                                        "examples": [
