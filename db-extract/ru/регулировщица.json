                ],
                "senses": [
                    {
                        "sense_id": "e352dbc7-080d-3a5c-875b-d865e6b9cb40",
                        "entry_id": "1d9f157c-e4a4-352c-904c-261388a6fb01",
                        "glosses": [
                            "женщина, работа которой заключается в том, чтобы жестами регулировать движение транспорта"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e860072-10b9-4d12-bf83-7c119a795010",
                                "sense_id": "e352dbc7-080d-3a5c-875b-d865e6b9cb40",
                                "text": "Любая регулировщица задержит — и всё."
                            },
                            {
                                "example_id": "97e335e4-3222-4ae6-bb54-6d4a3fc0722f",
                                "sense_id": "e352dbc7-080d-3a5c-875b-d865e6b9cb40",
                                "text": "Сержант-регулировщица с загорелым, ставшим от злости некрасивым лицом, размахивая флажком, бросилась к полуторке. … Меж тем регулировщица, став перед полуторкой, ругала Хижняка, несомненного виновника затора, к тому же не желавшего осаживать назад, за обочину, на арестную площадку, как она требовала."
                            }
                        ]
                    }
