                "senses": [
                    {
                        "sense_id": "a21ac670-829b-34fb-9d84-20c8eac2c7b6",
                        "entry_id": "1390e766-0d49-345d-b0b1-cdea273cf313",
                        "glosses": [
                            "Qui peut se retourner, qui peut se mettre en sens inverse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f00e8350-edba-4c95-8ac0-8c89d477b929",
                                "sense_id": "a21ac670-829b-34fb-9d84-20c8eac2c7b6",
                                "text": "Ce tissu est réversible."
                            }
                        ]
                    },
                    {
                        "sense_id": "4550bea5-7557-3ffa-8fe3-7f2b6d7321b0",
                        "entry_id": "1390e766-0d49-345d-b0b1-cdea273cf313",
                        "glosses": [
                            "Qui doivent en certains cas retourner au propriétaire qui en a disposé, en parlant des biens, des terres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e603ed5-cf80-4817-9b8e-a9e21cfc90cf",
                                "sense_id": "4550bea5-7557-3ffa-8fe3-7f2b6d7321b0",
                                "text": "Toutes les terres données à bail emphytéotique sont réversibles après la fin du bail."
                            }
                        ]
                    },
                    {
                        "sense_id": "78d897d7-6f67-396c-ba1b-1d1f89a980df",
                        "entry_id": "1390e766-0d49-345d-b0b1-cdea273cf313",
                        "glosses": [
                            "Constituées sur plusieurs têtes, ou des pensions assurées à d’autres personnes après la mort des titulaires, en parlant des rentes viagères."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "069a5c0e-b559-4357-83c2-5275d42b46e9",
                                "sense_id": "78d897d7-6f67-396c-ba1b-1d1f89a980df",
                                "text": "Ces quatre sœurs ont obtenu des pensions qui seront réversibles d’une tête sur l’autre, jusqu’à la dernière."
                            },
                            {
                                "example_id": "9f928650-f4cd-45a3-b6fc-ab9417502754",
                                "sense_id": "78d897d7-6f67-396c-ba1b-1d1f89a980df",
                                "text": "Sa pension est réversible sur sa veuve, sur ses enfants."
                            }
                        ]
                    },
                    {
                        "sense_id": "92e84c82-b121-3211-aee9-e665388a4db3",
                        "entry_id": "1390e766-0d49-345d-b0b1-cdea273cf313",
                        "glosses": [
                            "Susceptibles de se reproduire en sens inverse, en parlant de phénomènes."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "013d7cdc-f4d8-4387-88cc-de887fa70f3e",
                                "sense_id": "92e84c82-b121-3211-aee9-e665388a4db3",
                                "text": "Ces minuscules algues peuvent se décolorer par perte - réversible ou non - de leur chlorophylle."
                            },
                            {
                                "example_id": "286473e3-ccb2-4f1b-af33-467bd5892c8a",
                                "sense_id": "92e84c82-b121-3211-aee9-e665388a4db3",
                                "text": "L’électrochimiothérapie (ECT), validée au stade clinique en 1991, consiste en l’injection locale d’une molécule cytotoxique non-perméante, comme la bléomycine ou la cisplastine, autour d’une zone à traiter, puis en la perméabilisation réversible de cette zone par des chocs électriques."
                            }
                        ]
                    }
                ],
