                ],
                "senses": [
                    {
                        "sense_id": "d3d3ae47-72f9-3bd6-972d-972132f5e342",
                        "entry_id": "04b8c5c7-68bc-31e8-9949-be456f26c751",
                        "glosses": [
                            "eine Person oder ein Unternehmen, das Autos herstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b232e8d4-9ed1-477a-8985-cb98a333afa6",
                                "sense_id": "d3d3ae47-72f9-3bd6-972d-972132f5e342",
                                "text": "Der Volkswagenkonzern ist der größte Autobauer Europas."
                            },
                            {
                                "example_id": "7d6b9d18-f2e9-4f6e-8e91-4f2f55c5dea4",
                                "sense_id": "d3d3ae47-72f9-3bd6-972d-972132f5e342",
                                "text": "„Autobauer, die sich mit amerikanischen Behörden anlegen, bekommen nicht nur saftige Strafen, sondern auch sehr unangenehme Befragungen […].“"
                            },
                            {
                                "example_id": "c4e95007-2005-4431-a880-52911f2698b5",
                                "sense_id": "d3d3ae47-72f9-3bd6-972d-972132f5e342",
                                "text": "„Zur Steigerung der Stückzahlen und zur Senkung der Herstellungskosten greift der japanische Autobauer zu einem Mittel, das für viele Konkurrenten ein Tabu darstellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
