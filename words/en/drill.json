                            {
                                "target_lang_word": "eğitim",
                                "target_lang_sense_clarification": "düzenli tekrar çalışması"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc87c5d3-6003-36ef-a846-3c82b97583cb",
                    "sense_definition": "A specific sports training exercise designed to improve a particular skill.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "training_exercise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coach set up a passing <w>drill</w> for the soccer team.",
                            "target_lang_translations": {
                                "ru": "Тренер назначил <w>упражнение</w> на передачу мяча для футбольной команды.",
                                "tr": "Koç, futbol takımı için bir pas <w>çalışması</w> hazırladı."
                            }
                        },
                        {
                            "text": "We spent the first hour of practice doing a defensive <w>drill</w>.",
                            "target_lang_translations": {
                                "ru": "Мы потратили первый час тренировки, выполняя оборонительное <w>упражнение</w>.",
                                "tr": "Antrenmanın ilk saatini savunma <w>egzersizi</w> yaparak geçirdik."
                            }
                        }
