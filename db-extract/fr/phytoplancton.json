                                                "sense_id": "c21a7874-c2e4-3517-af75-3d4ac088d565",
                                                "text": "O excesso de nutrientes favoreceu o florescimento do fitoplâncton"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86bb575d-fdca-3e11-9e6d-e0379d4437e5",
