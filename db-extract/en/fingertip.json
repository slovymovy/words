                    {
                        "sense_id": "e2de0c77-c2bf-35e9-a670-6853167a2e03",
                        "entry_id": "30779328-7fab-33a8-bca4-3bafeb813969",
                        "glosses": [
                            "The tip of the human finger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cf53ae1-0376-47f2-9950-a8ed00afea33",
                                "sense_id": "e2de0c77-c2bf-35e9-a670-6853167a2e03",
                                "text": "The traditional Thai greeting, the wai, is generally offered first by the youngest of the two people meeting, with their hands pressed together, fingertips pointing upwards as the head is bowed to touch their face to the hands."
                            },
                            {
                                "example_id": "cdcac497-a4a2-44fa-9aa4-80ea94f9de2e",
                                "sense_id": "e2de0c77-c2bf-35e9-a670-6853167a2e03",
                                "text": "They were all professional to their fingertips, knew each other very well, and knew their disciplines backwards."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e467189a-a207-44da-a6d1-b8d0346d01bd",
                        "source_entry_id": "30779328-7fab-33a8-bca4-3bafeb813969",
                        "source_sense_id": "e2de0c77-c2bf-35e9-a670-6853167a2e03",
                        "source_sense_description": "the end of the finger",
                        "target_lang_word": "vingertop",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vingertop",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "178efc11-048e-3171-ae9f-729857852d9d",
                                        "entry_id": "64e64f34-58c5-3dd8-be44-fde61e65bccc",
                                        "glosses": [
                                            "topje van een vinger"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1fc9852-8f88-4a68-8309-2a8c99b652a0",
                                                "sense_id": "178efc11-048e-3171-ae9f-729857852d9d",
                                                "text": "De vingertop is zeer gevoelig."
                                            },
                                            {
                                                "example_id": "b28e2e08-7762-42b4-b8e0-3f41e57eae50",
                                                "sense_id": "178efc11-048e-3171-ae9f-729857852d9d",
                                                "text": "De ober balanceerde een zilveren dienblad op de vingertoppen van zijn gehandschoende hand."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "31e7f057-e37d-4646-8f42-3147d85b6d47",
                        "source_entry_id": "30779328-7fab-33a8-bca4-3bafeb813969",
                        "source_sense_id": "e2de0c77-c2bf-35e9-a670-6853167a2e03",
