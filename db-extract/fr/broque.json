                    {
                        "sense_id": "ea27b633-0401-329a-870f-9ade7f6c05d0",
                        "entry_id": "1a69660d-2322-3f75-8622-68c7d4df6969",
                        "glosses": [
                            "Liard, sou, centime, pièce de monnaie de peu de valeur."
