                            },
                            {
                                "target_lang_word": "实在",
                                "target_lang_sense_clarification": "用于强调某种特质的显著"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af5d81d9-34dc-35d8-b49c-058e04ba84bf",
                    "sense_definition": "In accordance with the facts; truthfully or accurately.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spoke <w>truly</w> when he described the events of that night.",
                            "target_lang_translations": {
                                "ru": "Он говорил <w>правдиво</w>, когда описывал события той ночи.",
                                "zh": "他在描述那天晚上的事件时讲得很<w>如实</w>。"
                            }
                        },
                        {
                            "text": "The painting <w>truly</w> represents the style of that era.",
                            "target_lang_translations": {
                                "ru": "Эта картина <w>верно</w> отражает стиль той эпохи.",
                                "zh": "这幅画<w>准确地</w>表现了那个时代的风格。"
                            }
                        }
                    ],
                    "synonyms": [
                        "honestly"
                    ],
                    "common_phrases": [
                        "speak truly"
                    ],
                    "target_lang_definitions": {
                        "ru": "В соответствии с фактами; правдиво или точно.",
                        "zh": "符合事实；真实地或准确地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "правди́во",
                                "target_lang_sense_clarification": "соответствуя правде"
                            },
                            {
                                "target_lang_word": "ве́рно",
                                "target_lang_sense_clarification": "точно, правильно"
                            },
                            {
                                "target_lang_word": "че́стно",
                                "target_lang_sense_clarification": "без обмана"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "真实地",
                                "target_lang_sense_clarification": "符合客观事实"
                            },
                            {
                                "target_lang_word": "准确地",
                                "target_lang_sense_clarification": "没有偏差地"
                            },
                            {
                                "target_lang_word": "如实",
                                "target_lang_sense_clarification": "按照事实情况"
                            }
                        ]
