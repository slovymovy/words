                        "examples": [
                            {
                                "example_id": "0e911ae2-17c0-463f-9595-9e805fab4bb4",
                                "sense_id": "c2329fd2-1c5c-3788-aba7-66e1c9aed517",
                                "text": "Ha, tweehonderd jaar rente — dat is nog eens een langetermijninvestering."
                            },
                            {
                                "example_id": "495beaa7-ffc0-4f6f-ab90-50c6efbbb28e",
                                "sense_id": "c2329fd2-1c5c-3788-aba7-66e1c9aed517",
                                "text": "Uiteindelijk was het aanleggen en beplanten van akkers duidelijk een langetermijninvestering."
                            },
                            {
                                "example_id": "1f47416c-4eab-4feb-8890-d554ade0530c",
                                "sense_id": "c2329fd2-1c5c-3788-aba7-66e1c9aed517",
                                "text": "De aanleg van warmtenetten is een kostbare langetermijninvestering. Het overleg tussen overheden en energiebedrijven loopt daardoor regelmatig vast. Het afgelopen jaar leidde de koppeling tussen de gasprijzen en de prijzen voor warmte tot onvrede bij bewoners en politici. Ook bij mensen die aangesloten waren op een warmtenetwerk ging de energierekening fors omhoog."
                            }
