                                        "entry_id": "ae02b7ac-c48a-389d-bd23-7651d9d87c6c",
                                        "glosses": [
                                            "The use and management of information in pursuit of an advantage over an opponent, such as propaganda, disinformation, and gathering assurances that one's own information is accurate."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34b2c529-1c6c-45da-b366-f9db06010df7",
                                                "sense_id": "eb7264b7-b12b-32a9-a242-b07f04fe5e2c",
                                                "text": "And in each case, they spoke about how the old tools of information warfare—radio channels, television shows, leaflets, letters—have now been joined by digital tools that make it more powerful."
                                            }
                                        ]
                                    }
