                        "source_entry_id": "4c04df08-96d0-3b5b-ae00-5b6836459e53",
                        "source_sense_id": "df8992b2-dd67-378e-9f4f-1d07de5b6a1f",
                        "target_lang_word": "calcédoine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calcédoine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c2ce0c20-3a71-3134-99ea-49b672065a7a",
                                        "entry_id": "cbbea67b-779b-3853-a1f2-fb989884743b",
                                        "glosses": [
                                            "Pierre précieuse de couleur bleue ou jaunâtre, mélange de quartz et de moganite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d294068-fc23-40c1-9fda-2fbb03dd9fec",
                                                "sense_id": "c2ce0c20-3a71-3134-99ea-49b672065a7a",
                                                "text": "Sous un voile bleuâtre lui cachant la poitrine et la tête, on distinguait les arcs de ses yeux, les calcédoines de ses oreilles, la blancheur de sa peau."
                                            },
                                            {
                                                "example_id": "8b80bf56-7a8b-439c-9234-437b1857c2be",
                                                "sense_id": "c2ce0c20-3a71-3134-99ea-49b672065a7a",
                                                "text": "Je devrais maintenant énumérer les marchandises qu’on y achète avec bénéfice : agate, onyx, chrysoprase, et d’autres variétés de calcédoine ; louer la chair du faisan doré qu’on y cuisine sur la flamme du bois de cerisier sec et qu’on saupoudre de beaucoup d’origan ; parler des femmes que j’ai vues prendre leur bain dans le bassin d’un jardin et qui parfois — dit-on — invitent le passant à se dévêtir avec elles, et les pourchasser dans l’eau."
                                            },
                                            {
                                                "example_id": "deedf03e-f739-4a5a-972d-b72137db73ed",
                                                "sense_id": "c2ce0c20-3a71-3134-99ea-49b672065a7a",
                                                "text": "La calcédoine est probablement l’une des premières matières minérales à avoir été considérée par l’homme autrement que pour ses qualités techniques, très proches de celles du silex."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
