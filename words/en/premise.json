{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a86142be-fca9-3864-8bda-33bf7ad77ba4",
                    "sense_definition": "A building and the area of land that it is on.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "real_estate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Smoking is strictly prohibited on these <w>premises</w>.",
                            "target_lang_translations": {
                                "ru": "Курение на этой <w>территории</w> строго запрещено.",
                                "zh": "在此<w>场所</w>内严禁吸烟。"
                            }
                        },
                        {
                            "text": "The company is moving to new business <w>premises</w> next month.",
                            "target_lang_translations": {
                                "ru": "В следующем месяце компания переезжает в новое офисное <w>помещение</w>.",
                                "zh": "公司下个月将搬迁至新的<w>办公地点</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "property",
                        "grounds",
                        "site",
                        "establishment"
                    ],
                    "common_phrases": [
                        "on the premises",
                        "off the premises",
                        "business premises",
                        "vacate the premises"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Здание вместе с прилегающим к нему участком земли.",
                        "zh": "建筑物及其所在的土地范围。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "помещение",
                                "target_lang_sense_clarification": "внутреннее пространство здания, офис"
                            },
                            {
                                "target_lang_word": "территория",
                                "target_lang_sense_clarification": "земельный участок, принадлежащий организации"
                            },
                            {
                                "target_lang_word": "недвижимость",
                                "target_lang_sense_clarification": "здание или участок как объект собственности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "场所",
                                "target_lang_sense_clarification": "指特定的地点或办公地点"
                            },
                            {
                                "target_lang_word": "办公地点",
                                "target_lang_sense_clarification": "指公司或机构的经营场所"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "535322e4-904b-3bba-8d82-80ec0b0be62b",
                    "sense_definition": "A statement or idea that is accepted as true and serves as a basis for an argument or conclusion.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "logic_basis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The entire theory relies on the <w>premise</w> that human behavior is rational.",
                            "target_lang_translations": {
                                "ru": "Вся теория опирается на <w>предпосылку</w>, что человеческое поведение рационально.",
                                "zh": "整个理论都建立在人类行为是理性的这一<w>前提</w>之上。"
                            }
                        },
                        {
                            "text": "If you accept the first <w>premise</w>, the conclusion follows logically.",
                            "target_lang_translations": {
                                "ru": "Если вы примете первую <w>посылку</w>, вывод последует логически.",
                                "zh": "如果你接受第一个<w>前提</w>，结论便合乎逻辑地成立了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "assumption",
                        "hypothesis",
                        "proposition",
                        "basis",
                        "supposition"
                    ],
                    "antonyms": [
                        "conclusion"
                    ],
                    "common_phrases": [
                        "false premise",
                        "basic premise",
                        "major premise",
                        "accept the premise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Утверждение или идея, которые принимаются за истину и служат основой для аргументации или вывода.",
                        "zh": "作为论证或结论基础的假设或前提。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предпосылка",
                                "target_lang_sense_clarification": "исходное условие, основание"
                            },
                            {
                                "target_lang_word": "допущение",
                                "target_lang_sense_clarification": "предположение, гипотеза"
                            },
                            {
                                "target_lang_word": "посылка",
                                "target_lang_sense_clarification": "логический термин; часть силлогизма"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "前提",
                                "target_lang_sense_clarification": "逻辑推理或论证的基础"
                            },
                            {
                                "target_lang_word": "假设",
                                "target_lang_sense_clarification": "作为推论依据的假定"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0f7a08a-c310-31a4-839b-b361c90e2e0c",
                    "sense_definition": "The fundamental concept or idea that drives the plot of a story or film.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "logic_basis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie has an interesting <w>premise</w>, but the ending was disappointing.",
                            "target_lang_translations": {
                                "ru": "У фильма интересный <w>замысел</w>, но концовка разочаровала.",
                                "zh": "这部电影的<w>构思</w>很有趣，但结局令人失望。"
                            }
                        },
                        {
                            "text": "The book is based on the simple <w>premise</w> of a world without electricity.",
                            "target_lang_translations": {
                                "ru": "Книга основана на простой <w>идее</w> мира без электричества.",
                                "zh": "这本书基于一个简单的<w>设定</w>：一个没有电的世界。"
                            }
                        }
                    ],
                    "synonyms": [
                        "concept",
                        "idea",
                        "plot"
                    ],
                    "common_phrases": [
                        "interesting premise",
                        "simple premise",
                        "original premise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Фундаментальная концепция или идея, лежащая в основе сюжета истории или фильма.",
                        "zh": "故事或电影情节所依据的基本构思或核心概念。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замысел",
                                "target_lang_sense_clarification": "основная идея произведения"
                            },
                            {
                                "target_lang_word": "концепция",
                                "target_lang_sense_clarification": "система взглядов, основная мысль"
                            },
                            {
                                "target_lang_word": "идея",
                                "target_lang_sense_clarification": "главная мысль сюжета"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "构思",
                                "target_lang_sense_clarification": "作品的创作意图或基本框架"
                            },
                            {
                                "target_lang_word": "设定",
                                "target_lang_sense_clarification": "故事背景或核心逻辑基础"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d0417a6e-5b23-3a36-9ffc-7114a82bbc65",
                    "sense_definition": "To state or assume something as a basis for further discussion or argument.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "logic_basis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I must <w>premise</w> my remarks by saying that I am not an expert in this field.",
                            "target_lang_translations": {
                                "ru": "Я должен <w>предварить</w> свои замечания словами о том, что я не эксперт в этой области.",
                                "zh": "我必须先说明我并非该领域的专家，以此作为我发言的<w>前提</w>。"
                            }
                        },
                        {
                            "text": "The author <w>premises</w> his argument on historical data.",
                            "target_lang_translations": {
                                "ru": "Автор <w>основывает</w> свои доводы на исторических данных.",
                                "zh": "作者的论点是<w>基于</w>历史数据提出的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "postulate",
                        "posit",
                        "presuppose",
                        "assume"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Утверждать или предполагать что-либо в качестве основы для дальнейшего обсуждения.",
                        "zh": "将某事作为进一步讨论或论证的基础。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предварять",
                                "target_lang_sense_clarification": "сказать что-то в качестве вступления"
                            },
                            {
                                "target_lang_word": "основывать",
                                "target_lang_sense_clarification": "базировать рассуждение на чем-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "以……为前提",
                                "target_lang_sense_clarification": "将某事作为论证的出发点"
                            },
                            {
                                "target_lang_word": "基于",
                                "target_lang_sense_clarification": "将某事作为论点的依据"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}