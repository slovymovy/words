                "senses": [
                    {
                        "sense_id": "a20383d7-0928-32f6-b95c-7a0318bd03c7",
                        "entry_id": "34e3b845-981d-3f5c-913a-b4780153c813",
                        "glosses": [
                            "Falschaussage zum eigenen Vorteil, meist ohne böse Absicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "779d9188-3498-4d31-9c2a-502b55228eeb",
                                "sense_id": "a20383d7-0928-32f6-b95c-7a0318bd03c7",
                                "text": "Eine kleine Notlüge ist manchmal besser als die brutale Wahrheit."
                            },
                            {
                                "example_id": "7a2b5018-c346-48af-8de9-3a2ebce22d1d",
                                "sense_id": "a20383d7-0928-32f6-b95c-7a0318bd03c7",
                                "text": "„Meine Lügen waren immer Notlügen gewesen.“"
                            },
                            {
                                "example_id": "c6e33dea-c672-40e2-b1e5-ee6abcf3ac71",
                                "sense_id": "a20383d7-0928-32f6-b95c-7a0318bd03c7",
                                "text": "„Letztendlich gebrauchte ich eine typische Notlüge: Ich würde meinen Mann in Tunesien zu einem gemeinsamen Urlaub treffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3cfd9941-f435-454d-a8d4-498c7e7c33f7",
                        "source_entry_id": "34e3b845-981d-3f5c-913a-b4780153c813",
                        "source_sense_id": "a20383d7-0928-32f6-b95c-7a0318bd03c7",
                        "source_sense_description": "Falschaussage zum eigenen Vorteil, meist ohne böse Absicht",
                        "target_lang_word": "white lie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "white lie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce52d65c-f0c5-306e-9867-b37a349766c2",
                                        "entry_id": "621db7cd-d7d5-3e82-9a25-dbadbc8f565d",
                                        "glosses": [
                                            "A deliberately untrue statement which is intended to produce a favorable result; especially, one which is judged to be better than an overhonest alternative, as for example to remain polite in a superficial social exchange, or to choose one's battles."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed7ffe1d-95ea-46af-8114-d4c447879287",
                                                "sense_id": "ce52d65c-f0c5-306e-9867-b37a349766c2",
                                                "text": "The prevarication and white lies which a mind that keeps itself ambitiously pure is as uneasy under as a great artist under the false touches that no eye detects but his own, are worn as lightly as mere trimmings when once the actions have become a lie."
                                            },
                                            {
                                                "example_id": "98e173df-3cd6-4ac2-b339-ae31e77a67c7",
                                                "sense_id": "ce52d65c-f0c5-306e-9867-b37a349766c2",
                                                "text": "An occasional little white lie such as Weston's probably won't cause any lasting damage. And at times, telling the truth—particularly the whole truth to a child who's not at an age to handle it—may do more harm than good, they say."
                                            },
                                            {
                                                "example_id": "9c434495-2110-427a-9d7f-e03113e625e4",
                                                "sense_id": "ce52d65c-f0c5-306e-9867-b37a349766c2",
                                                "text": "Too many joy rides in daddy's Jaguar / Too many white lies and white lines"
                                            },
                                            {
                                                "example_id": "135b7d17-eb8c-4fbe-8998-5c9a7cb71a8d",
                                                "sense_id": "ce52d65c-f0c5-306e-9867-b37a349766c2",
                                                "text": "What the next man knows, where the next man goes / Telling white lies ‘bout black folks"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4920f977-40de-489b-af7b-7b53885f6120",
                        "source_entry_id": "34e3b845-981d-3f5c-913a-b4780153c813",
                        "source_sense_id": "a20383d7-0928-32f6-b95c-7a0318bd03c7",
                        "source_sense_description": "Falschaussage zum eigenen Vorteil, meist ohne böse Absicht",
                        "target_lang_word": "pieux mensonge",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pieux mensonge",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1fb2fd73-21a7-38e0-a064-bdeabc4940c2",
                                        "entry_id": "a42c483e-858b-3588-9a99-6e798a935dd5",
                                        "glosses": [
                                            "Mensonge qui est fait dans l’intention d’être utile ou agréable à quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26435e02-fbdb-4f74-aedd-bc98456212e8",
                                                "sense_id": "1fb2fd73-21a7-38e0-a064-bdeabc4940c2",
                                                "text": "Autant reconnaître qu'il peut y avoir, comme on l’entend souvent, de « pieux mensonges » et, qu'en certaines circonstances, toute vérité n'est pas bonne à dire."
                                            },
                                            {
                                                "example_id": "b788721a-63ad-4c8c-a7fa-eafd0d613f35",
                                                "sense_id": "1fb2fd73-21a7-38e0-a064-bdeabc4940c2",
                                                "text": "La plupart des auteurs depuis Saint Augustin font une différence entre le mensonge officieux dont la finalité est l’utilité, le mensonge plaisant destiné à faire rire et le mensonge pernicieux toujours condamnable. Certains y ajoutent le mensonge de convenance ou de politesse, le mensonge pédagogique que maints éducateurs croient devoir utiliser dans l’intérêt de la jeunesse, le pieux mensonge etc. qui tous, d'une manière ou d'une autre, se rattachent aux premiers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
