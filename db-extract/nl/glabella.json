                        "entry_id": "e6c7ab0c-f337-3fc0-9ac2-8e4cd34abac1",
                        "glosses": [
                            "middelste deel van het kopschild bij trilobieten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c43fd6d-bb5e-4ee8-94f4-7c3e4e3e95dd",
                                "sense_id": "0075bb66-c60a-3ad6-848a-af334fa42992",
                                "text": "De glabella is een centrale uitstulping in het kopdeel van trilobieten. Deze huisvest het voornaamste deel van het spijsverteringsstelsel."
                            }
                        ]
