                },
                {
                    "sense_id": "3efab682-1932-34c0-a116-b93a4d89ee7e",
                    "sense_definition": "A piece of cloth used as a diaper or swaddling.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cloth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The infant was bundled tightly in a linen <w>clout</w> before being laid to sleep.",
                            "target_lang_translations": {
                                "zh": "婴儿在被放下睡觉前，用亚麻<w>襁褓布</w>紧紧裹好。"
                            }
                        },
                        {
                            "text": "She washed the baby's soiled <w>clout</w> in the wooden tub by the river.",
                            "target_lang_translations": {
                                "zh": "她在河边的木盆里清洗婴儿弄脏了的<w>尿布</w>。"
                            }
