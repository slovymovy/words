                        "form": "тушёнках"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4a5e1530-73b7-3a8a-90bf-53ffc2b7ca19",
                        "entry_id": "6864be28-9c9e-33fe-9513-f26f1c785e5b",
                        "glosses": [
                            "разг. консервированное тушёное мясо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46e21b70-e166-457c-9886-2b7efc1bf60b",
                                "sense_id": "4a5e1530-73b7-3a8a-90bf-53ffc2b7ca19",
                                "text": "Командир танка тут же велел открыть «второй фронт» — так называлась американская консервированная тушёнка."
                            },
                            {
                                "example_id": "948cc34b-1738-4a94-906e-f53803c09c0e",
                                "sense_id": "4a5e1530-73b7-3a8a-90bf-53ffc2b7ca19",
                                "text": "А в это время Ваня Солнцев, поджав под себя босые ноги, сидел на еловых ветках в палатке разведчиков и ел из котелка большой деревянной ложкой необыкновенно горячую и необыкновенно вкусную кротёнку из картошки, лука, свиной тушёнки, перца, чеснока и лаврового листа."
                            },
                            {
                                "example_id": "bf2de09c-8597-47d5-8d78-ddc9736e9953",
                                "sense_id": "4a5e1530-73b7-3a8a-90bf-53ffc2b7ca19",
                                "text": "Потом мы пьём крепкий до обалдения самогон и закусываем разогретой свиной тушенкой и холодными, как лёд, хрустящими солёными огурчиками."
                            },
                            {
                                "example_id": "e94d45a1-625c-4735-8a76-e3ef4e343aaf",
                                "sense_id": "4a5e1530-73b7-3a8a-90bf-53ffc2b7ca19",
                                "text": "— Вы кушайте, дядя Коля, — сказала она раненому, — супчик же хороший, не с тушёнкой сегодня, а со свежим мясом."
                            },
                            {
                                "example_id": "ab16ff5d-2de4-456b-b036-af30e64132d1",
                                "sense_id": "4a5e1530-73b7-3a8a-90bf-53ffc2b7ca19",
                                "text": "Всё это он небрежно сдвинул руками по столу к сторонке, толстыми ломтями наре́зал хлеб, одним круговым движением ножа вскрыл банку тушёнки и, вытащив из кармана, поставил на стол бутылку водки."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f3b436c-be48-479b-bbc4-95742bbc37dc",
                        "source_entry_id": "6864be28-9c9e-33fe-9513-f26f1c785e5b",
                        "source_sense_id": "4a5e1530-73b7-3a8a-90bf-53ffc2b7ca19",
                        "target_lang_word": "Büchsenfleisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Büchsenfleisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3ef020f5-7d04-3b6d-8d0d-552a50fd99bb",
                                        "entry_id": "68ae5dc8-d753-3414-a7a4-42bb5ab2fba0",
                                        "glosses": [
                                            "verzehrfertiges, haltbares, in Dosen abgepacktes Fleisch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "696d09dc-e133-419c-a1cd-f7587013fe9e",
                                                "sense_id": "3ef020f5-7d04-3b6d-8d0d-552a50fd99bb",
                                                "text": "„Dort, in einer Plattenbauwohnung im Süden St. Petersburgs, stehen Makkaroni mit Büchsenfleisch für die Heimkehrer bereit.“"
                                            },
                                            {
                                                "example_id": "21c3fb32-c260-4c61-8b37-f99564a530ce",
                                                "sense_id": "3ef020f5-7d04-3b6d-8d0d-552a50fd99bb",
                                                "text": "„Es war heißes Büchsenfleisch und schmeckte sehr gut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
