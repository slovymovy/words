                "senses": [
                    {
                        "sense_id": "1787163a-af0a-3b5f-abba-b45a4439378d",
                        "entry_id": "72a9902d-9c80-30b9-a529-725797de4653",
                        "glosses": [
                            "Of or pertaining to globalism."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "630e7b5f-13e1-4b49-b0d8-8bd20405136b",
                                "sense_id": "1787163a-af0a-3b5f-abba-b45a4439378d",
                                "text": "From a globalist point of view, talk of threats to a local culture or identity can look like bigotry and even racism: what reason could there be for excluding people when we are all part of a welcoming, global culture?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e9680072-e0af-464f-aeec-1c52d6716dd2",
                        "source_entry_id": "72a9902d-9c80-30b9-a529-725797de4653",
