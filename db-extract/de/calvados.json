                "senses": [
                    {
                        "sense_id": "4683782f-e15d-3a61-9669-e2bc0d6446b9",
                        "entry_id": "28cfb2b4-2d69-3698-86f2-0cd78f269d65",
                        "glosses": [
                            "französischer Apfelbranntwein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32040045-5491-4930-ad10-dda7c8671d1a",
                                "sense_id": "4683782f-e15d-3a61-9669-e2bc0d6446b9",
                                "text": "„Noch eine Champagnerflasche wird aufgemacht, und sogar der beste Calvados kommt auf den Tisch.“"
                            },
                            {
                                "example_id": "2861b0ed-d9f1-4a80-8865-85f1e4b1e310",
                                "sense_id": "4683782f-e15d-3a61-9669-e2bc0d6446b9",
                                "text": "„Er trank das Glas Calvados aus.“"
                            },
                            {
                                "example_id": "d6a7dbe7-b3f9-44bb-a64e-65c097634d8f",
                                "sense_id": "4683782f-e15d-3a61-9669-e2bc0d6446b9",
                                "text": "„Sie tranken Calvados und spielten Schallpatten, und Chantal war in einer fast unglaublichen Weise anschmiegsam, sentimental und weich.“"
                            },
                            {
                                "example_id": "ed3363fe-d7af-4310-8680-160655095907",
                                "sense_id": "4683782f-e15d-3a61-9669-e2bc0d6446b9",
                                "text": "„Dabei war er von einem halben Calvados so angeschickert, dass er bestimmt eher den Mond oder sich selbst getroffen hätte als den Laster.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a4ab2682-1728-4f39-b37f-7996a8902523",
                        "source_entry_id": "28cfb2b4-2d69-3698-86f2-0cd78f269d65",
                        "source_sense_id": "4683782f-e15d-3a61-9669-e2bc0d6446b9",
