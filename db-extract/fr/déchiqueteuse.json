                                                "sense_id": "14a80ab4-5aa9-3638-b4b9-d9eed39cfe3e",
                                                "text": "'Yes, and CCTV on the drink link and at Fabio's chipper.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47d70f2e-c483-3661-92f8-1ec57978a298",
                                        "entry_id": "fb3de615-29a1-31e3-93fd-16f4920d71ca",
                                        "glosses": [
                                            "A company that manufactures potato chips/potato crisps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "212332ff-c0f7-4f91-89c1-f3bdf1cc9283",
                                                "sense_id": "47d70f2e-c483-3661-92f8-1ec57978a298",
                                                "text": "Bichel asked chippers several thought-provoking questions about potato procurement, storage and handling."
                                            },
