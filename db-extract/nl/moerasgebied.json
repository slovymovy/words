                                "example_id": "a83d3dcd-2108-4aa7-bda0-7d30fc19f972",
                                "sense_id": "c36a2ea0-b659-3671-93cb-4af55aefe1f2",
                                "text": "In de Lowlands, het weidse, door kanaaltjes en kreekjes doorsneden en met plantages bedekte moerasgebied om de stad, liep dat percentage op tot negen zwarten op één blanke."
                            },
                            {
                                "example_id": "8920ad1a-568a-4122-853a-56e5b26105f4",
                                "sense_id": "c36a2ea0-b659-3671-93cb-4af55aefe1f2",
                                "text": "Alleen waar de bodemgesteldheid voor problemen zorgde, zoals in het moerasgebied Vijverbroek bij Ittervoort, maakte de weg een bocht."
                            }
                        ]
