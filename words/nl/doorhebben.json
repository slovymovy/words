    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "973750ca-3edb-3de6-9ba4-c7fc252c45e2",
                    "sense_definition": "begrijpen hoe iets in elkaar zit of een oplossing voor een probleem vinden",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "begrip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het dier <w>had</w> niet <w>door</w> hoe het uit de kooi ontsnappen kon.",
                            "target_lang_translations": {
                                "en": "The animal <w>didn't realize</w> how it could escape from the cage."
                            }
                        },
                        {
                            "text": "Ik <w>heb</w> eindelijk <w>door</w> hoe deze nieuwe machine werkt.",
                            "target_lang_translations": {
                                "en": "I've finally <w>figured out</w> how this new machine works."
                            }
                        }
                    ],
                    "synonyms": [
                        "begrijpen",
                        "snappen",
                        "vatten"
                    ],
                    "common_phrases": [
                        "het eindelijk doorhebben",
                        "niet doorhebben"
                    ],
                    "target_lang_definitions": {
                        "en": "To understand how something works or to find a solution to a problem."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to figure out",
                                "target_lang_sense_clarification": "to understand a mechanism or solution"
                            },
                            {
                                "target_lang_word": "to realize",
                                "target_lang_sense_clarification": "to become aware of a situation"
                            },
                            {
                                "target_lang_word": "to get it",
                                "target_lang_sense_clarification": "to understand something clearly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d4b199c-26a7-3e82-a8d9-51ed845820bf",
                    "sense_definition": "de verborgen bedoelingen of plannen van iemand anders begrijpen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "begrip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij probeerde hem om de tuin te leiden, maar hij <w>had</w> haar <w>door</w>.",
                            "target_lang_translations": {
                                "en": "She tried to lead him up the garden path, but he <w>was onto her</w>."
                            }
                        },
                        {
                            "text": "De politie <w>had</w> de dieven al snel <w>door</w> voordat ze konden ontsnappen.",
                            "target_lang_translations": {
                                "en": "The police <w>saw through</w> the thieves quickly before they could escape."
                            }
                        }
                    ],
                    "synonyms": [
                        "doorzien",
                        "doorgronden"
                    ],
                    "common_phrases": [
                        "iemand doorhebben",
                        "een plannetje doorhebben"
                    ],
                    "target_lang_definitions": {
                        "en": "To understand someone's hidden intentions or secret plans."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to be onto someone",
                                "target_lang_sense_clarification": "to discover someone's secret or trickery"
                            },
                            {
                                "target_lang_word": "to see through",
                                "target_lang_sense_clarification": "to see the true nature of a person or plan"
                            },
                            {
                                "target_lang_word": "to catch on",
                                "target_lang_sense_clarification": "to realize what is happening behind the scenes"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
