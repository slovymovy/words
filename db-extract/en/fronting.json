                        "entry_id": "e7fdcbc1-38e6-3f28-857f-194a17aa8efb",
                        "glosses": [
                            "A phonological relationship where a front vowel is found in place of a relative back vowel in an inflected form of a word."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
