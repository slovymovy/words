                    },
                    {
                        "translation_id": "b30225e8-ec47-41df-9984-3be0eb5389d6",
                        "source_entry_id": "9f05a622-f3aa-3b8a-86cf-ff910cfdf441",
                        "source_sense_id": "6b65f901-a7c3-3379-8f40-de19d2fa6419",
                        "source_sense_description": "primary income-earner in a household",
                        "target_lang_word": "broodwinner",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "broodwinner",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8f39ed96-3330-3d28-b31f-2d68ff6c29ab",
                                        "entry_id": "d9e04b1e-db61-31c6-a267-0544fff69cee",
                                        "glosses": [
                                            "lid van een huishouding met betaald werk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c7344a8-6a7e-4724-bb72-738f18136cf8",
                                                "sense_id": "8f39ed96-3330-3d28-b31f-2d68ff6c29ab",
                                                "text": "Onder jongeren, jonger dan 25 jaar, is het werkloosheidscijfer in Spanje opgelopen tot 52 procent. In ruim 1,7 huishoudens is er geen enkele broodwinner meer. Daar zijn alle gezinsleden werkloos."
                                            },
                                            {
                                                "example_id": "ea148904-b386-4ec1-b160-4c9f03ec6e9b",
                                                "sense_id": "8f39ed96-3330-3d28-b31f-2d68ff6c29ab",
                                                "text": "Nu broodwinner Aamina niet meer leeft, ligt de druk op zíjn schouders."
                                            },
                                            {
                                                "example_id": "6f8afbc8-03a6-43fa-857b-a6043a78ed1b",
                                                "sense_id": "8f39ed96-3330-3d28-b31f-2d68ff6c29ab",
                                                "text": "Mannen worden er relatief ongelukkig van om de broodwinner te zijn, terwijl vrouwen erbij floreren. Een recente Amerikaanse studie laat zien dat binnen heterohuwelijken de psychologische ervaring van het meeste geld verdienen sterk verschilt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38b6ec36-a016-35d1-b409-72eb666c63f1",
                                        "entry_id": "d9e04b1e-db61-31c6-a267-0544fff69cee",
                                        "glosses": [
                                            "klein driehoekig zeil aan de achterkant van een schip"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ba4530a-181b-4d43-8b64-bf98391b5a46",
                        "source_entry_id": "9f05a622-f3aa-3b8a-86cf-ff910cfdf441",
                        "source_sense_id": "6b65f901-a7c3-3379-8f40-de19d2fa6419",
                        "source_sense_description": "primary income-earner in a household",
                        "target_lang_word": "gagne-pain",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gagne-pain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "98506b71-14f6-3919-b50a-696bc47d1902",
                                        "entry_id": "0d5ee454-8614-3a3f-a748-e565fc2ce3ce",
                                        "glosses": [
                                            "Ce qui fait subsister quelqu’un, l’outil ou le métier qui lui sert à gagner sa vie, son pain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6998f4b0-e1a5-4984-82b7-3addd6689d13",
                                                "sense_id": "98506b71-14f6-3919-b50a-696bc47d1902",
                                                "text": "Je crus d’abord l’amputation inévitable ; mais mutiler la main droite à un ouvrier, c’est lui ôter son gagne-pain. Tout devait être tenté pour conserver l’intégrité de ce membre."
                                            },
                                            {
                                                "example_id": "f4a7f007-8bda-4d36-ad84-46cd07f49ea8",
                                                "sense_id": "98506b71-14f6-3919-b50a-696bc47d1902",
                                                "text": "[…] les docteurs du Talmud ne donnaient-ils pas eux-mêmes l’exemple en exerçant, pour assurer leur gagne-pain, les métiers les plus humbles, tels que forgerons, ou savetier, ou fabricant d’épingles, etc. …?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc63728d-11ac-360d-b5ad-d3fb78a181ac",
                                        "entry_id": "0d5ee454-8614-3a3f-a748-e565fc2ce3ce",
                                        "glosses": [
                                            "Personne qui fait subsister une ou plusieurs personnes par son métier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4d8754d-1a20-4aa3-9673-10e61a5c4c79",
                                                "sense_id": "bc63728d-11ac-360d-b5ad-d3fb78a181ac",
                                                "text": "Elle est le gagne-pain de sa famille."
                                            },
                                            {
                                                "example_id": "454d7dd2-bc8a-460c-b02b-246a8bd87a2f",
                                                "sense_id": "bc63728d-11ac-360d-b5ad-d3fb78a181ac",
                                                "text": "Toujours est-il que ma mère est le gagne-pain de la famille […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3fb1208-b5ce-471e-912a-225d175ea722",
                        "source_entry_id": "9f05a622-f3aa-3b8a-86cf-ff910cfdf441",
                        "source_sense_id": "6b65f901-a7c3-3379-8f40-de19d2fa6419",
                        "source_sense_description": "primary income-earner in a household",
                        "target_lang_word": "pain",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a2e1f2c4-ccb2-31e6-99b6-62a668d8cfc5",
                                        "entry_id": "1b8d0e48-9337-325f-9317-100ac8694023",
                                        "glosses": [
                                            "Pâte cuite au four, à base de farine, d’eau et de levure de boulanger ou de levain."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9be1ffd3-f41b-4ea0-bf9a-61eab3b2d963",
                                                "sense_id": "a2e1f2c4-ccb2-31e6-99b6-62a668d8cfc5",
                                                "text": "Sophie emportait dans un petit panier du pain, qu’elle émiettait aux poules."
                                            },
                                            {
                                                "example_id": "fc264034-a9b6-4c0b-8e2f-d0d320c50619",
                                                "sense_id": "a2e1f2c4-ccb2-31e6-99b6-62a668d8cfc5",
                                                "text": "[…], voilà vingt ans que ça durait ; tout en piochant ferme, et en ne vivant que de pain et de pommes de terre, il avaient pu, tout juste, payer les intérêts et les frais de renouvellement."
                                            },
                                            {
                                                "example_id": "0b2a4de5-b4bf-4c85-ae74-7e3364aeb0e3",
                                                "sense_id": "a2e1f2c4-ccb2-31e6-99b6-62a668d8cfc5",
                                                "text": "Il trempait son pain dans sa soupe et il en mordait d’énormes bouchées, […]."
                                            },
                                            {
                                                "example_id": "1c05bdd3-a4ac-403d-bfb1-0d6086290733",
                                                "sense_id": "a2e1f2c4-ccb2-31e6-99b6-62a668d8cfc5",
                                                "text": "Zaheira disparut vers la cuisine, revint avec des plats alléchants, disposa gentiment l’eau et le pain sur la table."
                                            },
                                            {
                                                "example_id": "c7f6a862-a460-4df1-8152-a6572ff58dd7",
                                                "sense_id": "a2e1f2c4-ccb2-31e6-99b6-62a668d8cfc5",
                                                "text": "Le pain joue tant de rôles ! Nous avons appris à reconnaître, dans le pain, un instrument de la communauté des hommes, à cause du pain à rompre ensemble. Nous avons appris à reconnaître, dans le pain, l’image de la grandeur du travail, à cause du pain à gagner à la sueur du front. Nous avons appris à reconnaître, dans le pain, le véhicule essentiel de la pitié, à cause du pain que l’on distribue aux heures de misère. La saveur du pain partagée n’a point d’égale. […] Il est du pain comme de l’huile des lampes à huile. Elle se change en lumière."
                                            },
                                            {
                                                "example_id": "5b3f8782-e7b6-4cfd-a9d5-86e082e8f443",
                                                "sense_id": "a2e1f2c4-ccb2-31e6-99b6-62a668d8cfc5",
                                                "text": "Le pain à mie compacte et bise, à la croûte épaisse couleur de couque, sent la farine honnête."
                                            },
                                            {
                                                "example_id": "df4c4bd5-e981-49d9-a3aa-0e78a58deafd",
                                                "sense_id": "a2e1f2c4-ccb2-31e6-99b6-62a668d8cfc5",
                                                "text": "— L’odeur de ce bon pain me remplit de bonheur\nDebout de bon matin, promesse d’un grand cœur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0a5d4df-5a24-30ca-8a6d-bdd4d64b4987",
                                        "entry_id": "1b8d0e48-9337-325f-9317-100ac8694023",
                                        "glosses": [
                                            "Morceau de pain considéré en tant qu’unité de cuisson ou de vente, en général sous une forme définie : une baguette de pain, un pain de campagne, un pain azyme, …"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38e56a5a-d139-456d-84f5-b8af4d794cb4",
                                                "sense_id": "c0a5d4df-5a24-30ca-8a6d-bdd4d64b4987",
                                                "text": "On en sort le plus souvent avec de gros pains d'un kilo ou des miches qu'on conserve. Pour nous, le luxe c'était la baguette ou la ficelle qu'on achetait exceptionnellement et qu'on ne trouvait pas d'ailleurs tout les jours, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "246d136c-93aa-3a1b-9eaf-0150e9a5f543",
                                        "entry_id": "1b8d0e48-9337-325f-9317-100ac8694023",
                                        "glosses": [
                                            "Baguette de 400 grammes (le terme baguette étant dans ce cas réservé à la baguette de 250 grammes)."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "089037f6-817c-4c8a-820e-fd204bcbd531",
                                                "sense_id": "246d136c-93aa-3a1b-9eaf-0150e9a5f543",
                                                "text": "Donnez-moi un pain s’il vous plaît."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77bd7858-76f6-3d97-b11f-0af50fd45a83",
                                        "entry_id": "1b8d0e48-9337-325f-9317-100ac8694023",
                                        "glosses": [
                                            "Tout objet qui prend la forme d’un pain."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99906a75-0a9e-4ed5-9e84-ccbea2e55a87",
                                                "sense_id": "77bd7858-76f6-3d97-b11f-0af50fd45a83",
                                                "text": "La préparation du pain de poisson, pour laquelle des brevets ont été pris en France en 1870, est malheureusement peu pratiquée jusqu’ici."
                                            },
                                            {
                                                "example_id": "4d11e32a-b66b-4876-a405-a7d73ec8366b",
                                                "sense_id": "77bd7858-76f6-3d97-b11f-0af50fd45a83",
                                                "text": "Muni même d’un pain de savon, il prit, sur le bord d’un cours d’eau, hors la ville, son premier bain depuis seize mois."
                                            },
                                            {
                                                "example_id": "4cbfb6b3-7569-48f8-891b-32629ec18045",
                                                "sense_id": "77bd7858-76f6-3d97-b11f-0af50fd45a83",
                                                "text": "Entre Yari et Sissy, dans une savane immense de gamba, nous avons croisé, ce matin, quatre Manga menant à Kano dix ânes chargés de pains de sel et de couffins de natron — une production de ce pays très particulier où abondent les mares salines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2c32601-ab3c-37d8-9116-94693cde1636",
                                        "entry_id": "1b8d0e48-9337-325f-9317-100ac8694023",
                                        "glosses": [
                                            "Nourriture, moyens de subsistance."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7650f16b-cb16-4b9c-840f-2d769d5c9965",
                                                "sense_id": "e2c32601-ab3c-37d8-9116-94693cde1636",
                                                "text": "M. Fabre représentait l’Honneur, la Loyauté, la Probité, la vie régulière et laborieuse, le livret de Caisse d’Épargne, le pain gagné à la sueur d’un front d’exploité, — bref tout ce que les bourgeois proclament des lèvres comme des vertus civiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1669b1c6-2504-3003-a9b9-0e221075e0f5",
                                        "entry_id": "1b8d0e48-9337-325f-9317-100ac8694023",
                                        "glosses": [
                                            "Coup de poing."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fcb9092-81bd-4430-899a-d4650911a25a",
                                                "sense_id": "1669b1c6-2504-3003-a9b9-0e221075e0f5",
                                                "text": "Tu sais que ça lui va bien, un pain dans la gueule à ce nœud coulant ? ."
                                            },
                                            {
                                                "example_id": "e519be0a-f10f-4867-82e2-edc0c7cac0ea",
                                                "sense_id": "1669b1c6-2504-3003-a9b9-0e221075e0f5",
                                                "text": "L'homme s'est débattu sous moi comme un démon, j'ai même encaissé dans la bagarre un bon pain sur la gueule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "096c6038-633f-3282-b043-9a9e66421bbc",
                                        "entry_id": "1b8d0e48-9337-325f-9317-100ac8694023",
                                        "glosses": [
                                            "Erreur grossière, fausse note, couac."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "13a00959-eb18-3f20-8e4b-edcb8286197a",
                                        "entry_id": "1b8d0e48-9337-325f-9317-100ac8694023",
                                        "glosses": [
                                            "Jour de prison."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "400c7b43-c994-32b4-b887-75497e86dec9",
                                        "entry_id": "1b8d0e48-9337-325f-9317-100ac8694023",
                                        "glosses": [
                                            "Crush, personne pour qui on a une attirance."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
