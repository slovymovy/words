                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "имя",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Мою новую коллегу по работе зовут <w>Роза</w>.",
                            "target_lang_translations": {
                                "en": "My new coworker's name is <w>Rosa</w>."
                            }
                        },
                        {
                            "text": "Вчера вечером <w>Роза</w> принесла на чаепитие очень вкусный домашний пирог.",
                            "target_lang_translations": {
                                "en": "Yesterday evening, <w>Rose</w> brought a very delicious homemade pie to the tea gathering."
                            }
                        }
                    ],
                    "synonyms": [
                        "Розалинда"
                    ],
                    "target_lang_definitions": {
                        "en": "a female given name"
                    },
                    "translations": {
