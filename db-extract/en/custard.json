                                                "sense_id": "f0a99723-47ad-3cde-8e25-f596f7bedd16",
                                                "text": "Le custard est dans le four à cent soixante-quinze degrés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "226ed5d9-0df8-3770-86c3-297c08f5835f",
                                        "entry_id": "866ba9e9-2950-3c03-ae82-aa63f931e3c6",
                                        "glosses": [
                                            "Poudre qui permet de préparer ce type de crème en la diluant dans du lait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "416656ce-ebdd-42d8-9cec-df3bee2cbd1c",
                                                "sense_id": "226ed5d9-0df8-3770-86c3-297c08f5835f",
                                                "text": "Délayer le custard avec un peu d’eau."
                                            },
                                            {
                                                "example_id": "1f164b3b-327b-41fa-8e1c-75e09c303ba1",
                                                "sense_id": "226ed5d9-0df8-3770-86c3-297c08f5835f",
                                                "text": "Le custard est une préparation en poudre qui, additionnée de lait, permet d'obtenir une crème délicieuse (avec du pudding, de la jelly ou un bon crumble…)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb8f335e-481e-4012-af38-05117350bdc8",
