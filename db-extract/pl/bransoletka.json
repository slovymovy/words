                    },
                    {
                        "translation_id": "c8e50ed6-dd7b-4ae1-912f-3f3a428b806d",
                        "source_entry_id": "e9672f75-7079-348b-97e0-950c71dcef05",
                        "source_sense_id": "40e6c35f-e7eb-3a96-afbf-9e6c6d34f36d",
                        "target_lang_word": "Armband",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Armband",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9872625f-53fc-36ac-bcaf-e6990854a53d",
                                        "entry_id": "876ab4fe-64cb-3341-a98f-8d1ece02f7f5",
                                        "glosses": [
                                            "ein meist als Schmuck am Handgelenk oder Arm getragenes Band"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f780d43-21c1-4b4b-8c01-d14eb58f3a06",
                                                "sense_id": "9872625f-53fc-36ac-bcaf-e6990854a53d",
                                                "text": "Trägst du aber ein schönes Armband!"
                                            },
                                            {
                                                "example_id": "1c16d753-7507-4ebd-941d-39d2d1f4736a",
                                                "sense_id": "9872625f-53fc-36ac-bcaf-e6990854a53d",
                                                "text": "Die ständige Kontrolle des Körpers per Armband oder App ist vor allem bei Sportlern sehr beliebt."
                                            },
                                            {
                                                "example_id": "4dd32ce5-4180-4de1-b47d-25ee07a8faa6",
                                                "sense_id": "9872625f-53fc-36ac-bcaf-e6990854a53d",
                                                "text": "Wer Bier oder Wein bestellt, bekommt als sichtbares Zeichen ein farbiges Armband aus Papier umgelegt."
                                            },
                                            {
                                                "example_id": "43e2ddce-37cd-47da-90c6-38b9a5e8e137",
                                                "sense_id": "9872625f-53fc-36ac-bcaf-e6990854a53d",
                                                "text": "„Ihre Armbänder klirrten.“"
                                            },
                                            {
                                                "example_id": "64960ba7-84c5-4108-938f-31f9c5d0e589",
                                                "sense_id": "9872625f-53fc-36ac-bcaf-e6990854a53d",
                                                "text": "„Sie hat Armbänder an beiden Handgelenken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2f23c65-8d0e-4d6b-b3ff-de3eabb40547",
                        "source_entry_id": "e9672f75-7079-348b-97e0-950c71dcef05",
                        "source_sense_id": "40e6c35f-e7eb-3a96-afbf-9e6c6d34f36d",
                        "target_lang_word": "браслет",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "браслет",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0a0c59da-157c-3f7b-b70c-26264eb10278",
                                        "entry_id": "1ec5dc44-ec7d-3431-b1d2-d9bf1e2a7459",
                                        "glosses": [
                                            "украшение в виде кольца из металла, кожи, кости и т. п., обычно носимое на запястье"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c97f2ba-ab3b-42cc-a138-33a3bac7412e",
                                                "sense_id": "0a0c59da-157c-3f7b-b70c-26264eb10278",
                                                "text": "/Поскольку Анна Станиславовна считала себя принадлежащей к лагерю романтиков, она ездила в ландо-стангопе, запряженном двумя разношерстными лошадками; и по этой же причине она любила облачаться в фиолетовые сюртучки, розовые или лиловые жилетики, пейзанские шляпки, цветные ленты, носила три браслета на одной руке и один браслет — на другой."
                                            },
                                            {
                                                "example_id": "92c7bdb7-08f2-4ff1-b829-7a15c78bcc78",
                                                "sense_id": "0a0c59da-157c-3f7b-b70c-26264eb10278",
                                                "text": "Евгений заметил у красавицы на лодыжке, чуть повыше щиколотки, небольшую татуировку, то ли бабочку, то ли птичку, более детально рассмотреть тату мешал красивый золотой браслет с колокольчиками, украшавший ее ногу."
                                            },
                                            {
                                                "example_id": "52c6b11c-da76-4b96-ada0-6b807f5dcedb",
                                                "sense_id": "0a0c59da-157c-3f7b-b70c-26264eb10278",
                                                "text": "Кроме этой повязки, на них были ожерелья из мелких белых, серых, зеленых и красноватых камней и такие же браслеты на предплечьях и запястьях."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c5e46b1-fdb6-3d50-a601-ffc8765d81c5",
                                        "entry_id": "1ec5dc44-ec7d-3431-b1d2-d9bf1e2a7459",
                                        "glosses": [
                                            "изделие из металла в виде такого украшения для ношения наручных часов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8f8b7b4-2751-48ea-ac1e-952dc67f3597",
                                                "sense_id": "2c5e46b1-fdb6-3d50-a601-ffc8765d81c5",
                                                "text": "Золотой браслет с часиками лежал перед Маргаритой Николаевной рядом с коробочкой, полученной от Азазелло, и Маргарита не сводила глаз с циферблата."
                                            },
                                            {
                                                "example_id": "baf47a08-c9ce-4c3f-b03f-01f68371fe70",
                                                "sense_id": "2c5e46b1-fdb6-3d50-a601-ffc8765d81c5",
                                                "text": "Мужчина расстёгивает браслет часов и кладёт их на тумбочку."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7bffce4-0170-3214-965e-cf6f542f8572",
                                        "entry_id": "1ec5dc44-ec7d-3431-b1d2-d9bf1e2a7459",
                                        "glosses": [
                                            "перен., жарг., мн. ч. кандалы, наручники"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9b849bb-ad92-484f-a4d4-0bc53609d5c0",
                                                "sense_id": "d7bffce4-0170-3214-965e-cf6f542f8572",
                                                "text": "Девица сражалась, как пантера, и вырвать у неё пистолет Мите удалось только с помощью Горного, после чего Сунков наконец-то нацепил на девицу браслеты."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
