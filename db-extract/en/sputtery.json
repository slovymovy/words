                        "examples": [
                            {
                                "example_id": "3f366dc7-6870-4cc7-a759-01f78534586c",
                                "sense_id": "82d9c15a-badb-3170-aba4-61d9b62685a0",
                                "text": "It is but a gesture; I expect no coherent words from your clogged and sputtery pen; but while I am sufficiently like yourself to deceive the public into thinking you have written what they read, I am not yet great enough scoundrel to do so without your visiting the scene of your presumed labors."
                            },
                            {
                                "example_id": "d523d5ee-bba0-4c7a-982b-645de9d8c710",
                                "sense_id": "82d9c15a-badb-3170-aba4-61d9b62685a0",
                                "text": "On _____ Is an Apparition (Rossbin), the new album by his trio Blue Collar, he uses puckered curlicues, vocalizations distorted by the horn's tubing, sputtery stammers, quiet half-valved passages that turn his sound into a fluid whisper, and even some clear, straightforward long tones."
                            }
                        ]
                    }
