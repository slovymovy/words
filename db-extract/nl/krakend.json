                "senses": [
                    {
                        "sense_id": "b119891d-62fc-370b-94f6-f973c9a2baa6",
                        "entry_id": "984df5c5-869a-343d-b623-e944693cd54d",
                        "glosses": [
                            "geluiden makend bij het breken of verschuiven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b13767aa-9bfe-4cb2-bc8f-9eedd107621d",
                                "sense_id": "b119891d-62fc-370b-94f6-f973c9a2baa6",
                                "text": "Acteur Leo Alkemade ging vandaag een potje ijshockeyen op krakend natuurijs. Leuk, maar hij raakte geen enkele keer de puck en het was het vooral keihard knokken."
                            }
                        ]
                    },
                    {
                        "sense_id": "700eb970-625b-38d2-b170-8b8212e96360",
                        "entry_id": "984df5c5-869a-343d-b623-e944693cd54d",
                        "glosses": [
                            "door ouderdom niet meer helemaal soepel functionerend"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "66f282a1-268e-4d21-9701-ffadff2c578f",
                                "sense_id": "700eb970-625b-38d2-b170-8b8212e96360",
                                "text": "Want ik was niet naar Grand Hotel Europa gekomen om de tijd weemoedig te laten verglijden te midden van afgebladderde luxe en krakende glorie in passieve afwachting van een of ander inzicht, dat mij op een gegeven moment zou toevallen als een bloemblad uit een vergeeld boeket. Dat inzicht wilde ik afdwingen en daarom moest ik aan het werk."
                            }
                        ]
                    }
                ],
