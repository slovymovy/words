                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0516eed-c180-4714-9788-f229fdbeb1d4",
                                "sense_id": "bc1a428d-28e9-3d45-8243-f5d39c7a4c74",
                                "text": "Ce dernier présente l’avantage d’éviter de soulever un lambeau périosté, l’abord osseux est transgingival."
                            },
                            {
                                "example_id": "95dcbde1-3639-40e5-848d-0e6c4d2681f9",
                                "sense_id": "bc1a428d-28e9-3d45-8243-f5d39c7a4c74",
                                "text": "Dans l’ostéoarthropathie hypertrophiante (OAH) pneumique de Pierre Marie, il est classique de trouver une apposition périostée, que l’on recherchera en priorité au niveau des os longs des avant-bras, des jambes et des mains."
                            },
                            {
                                "example_id": "34f8e981-2e98-4cb4-a4ac-d9bb6cd72c59",
                                "sense_id": "bc1a428d-28e9-3d45-8243-f5d39c7a4c74",
                                "text": "Un manchon périosté intact est crucial dans le remodelage osseux autour d’une greffe fibulaire non vascularisée utilisée pour combler les grands défets osseux."
                            }
                        ]
                    }
