                        "glosses": [
                            "Surveillance des différents contaminants présents dans l'environnement des organismes vivants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76b4dda0-c2d1-42c3-8e6a-9f5bd2bfb636",
                                "sense_id": "17261933-5e6e-3ecb-9782-ecef917ce962",
                                "text": "Dans le cadre de sa stratégie européenne en matière d'environnement et de santé, la Commission européenne a, en 2007, validé un projet pilote de biosurveillance chez l'homme pour donner aux décideurs européens un cadre juridique commun et des informations comparables sur les effets de certains polluants sur la santé humaine."
                            },
                            {
                                "example_id": "5fc60ab7-0960-4f5a-ae68-36e95a642083",
                                "sense_id": "17261933-5e6e-3ecb-9782-ecef917ce962",
                                "text": "Ce bio-essai sera utile aux gestionnaires de l’environnement ainsi qu’aux chercheurs intéressés par la biosurveillance du milieu marin."
                            }
                        ]
                    }
