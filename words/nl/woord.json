                {
                    "sense_id": "002fc141-aa1b-3475-8145-f30eb749b1ed",
                    "sense_definition": "De standaardhoeveelheid gegevens die een processor in één keer kan verwerken.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "informatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij deze oude computerarchitectuur bestaat een <w>woord</w> uit slechts zestien bits.",
                            "target_lang_translations": {
                                "en": "In this old computer architecture, a <w>word</w> consists of only sixteen bits.",
                                "ru": "В этой старой компьютерной архитектуре <w>слово</w> состоит всего из шестнадцати бит."
                            }
                        },
                        {
                            "text": "De snelheid van de processor hangt mede af van de lengte van het <w>woord</w>.",
                            "target_lang_translations": {
                                "en": "The speed of the processor partly depends on the length of the <w>word</w>.",
                                "ru": "Скорость процессора частично зависит от длины <w>слова</w>."
                            }
