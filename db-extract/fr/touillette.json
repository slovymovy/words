                "senses": [
                    {
                        "sense_id": "6bbe7c64-7852-35ca-a501-b28537440923",
                        "entry_id": "778b05ae-84f5-3754-9f5c-3bbb0c9fe1bb",
                        "glosses": [
                            "Bâtonnet destiné à touiller une boisson."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "6844085c-75ea-4593-b776-a65d24f07c02",
                                "sense_id": "6bbe7c64-7852-35ca-a501-b28537440923",
                                "text": "Après une demi-heure de résignation, j’ai sorti la touillette en plastique en forme de petite guitare que j’avais subtilisée au Hard Rock Café quelques jours plus tôt."
                            },
                            {
                                "example_id": "3d2e1e06-a0c8-4e75-a880-f3ec61e0baca",
                                "sense_id": "6bbe7c64-7852-35ca-a501-b28537440923",
                                "text": "Le liquide est noir, et il m’a apporté une petite tasse de lait à côté, ainsi qu’une touillette dans la tasse elle-même."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3430118-1b2d-490e-a133-d9524efe298f",
                        "source_entry_id": "778b05ae-84f5-3754-9f5c-3bbb0c9fe1bb",
                        "source_sense_id": "6bbe7c64-7852-35ca-a501-b28537440923",
