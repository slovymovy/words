                ],
                "senses": [
                    {
                        "sense_id": "f9e0f6cc-ca47-3455-af5f-591efbc78958",
                        "entry_id": "0adf5247-4b59-3954-8b7a-f054a599a5e8",
                        "glosses": [
                            "Einstellung, jemanden oder etwas als geringfügig/unbedeutsam einzustufen und zu missachten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77336ea9-a13f-4b56-9688-d3dde50e85b2",
                                "sense_id": "f9e0f6cc-ca47-3455-af5f-591efbc78958",
                                "text": "„Sexueller Missbrauch, Gewalt und Vernachlässigung hinterlassen in der kindlichen Seele tiefe Spuren.“"
                            },
                            {
                                "example_id": "8aa6fa7c-8c7e-454b-b3ca-980ae467b3c2",
                                "sense_id": "f9e0f6cc-ca47-3455-af5f-591efbc78958",
                                "text": "„Ein Forschungsprojekt zu tödlicher Mißhandlung und Vernachlässigung von Kindern kommt zu erschreckenden Ergebnissen: Es gibt immer mehr erziehungsunfähige Eltern.“"
                            },
                            {
                                "example_id": "8ed2fde1-64ec-425c-bb59-bc680ae52f96",
                                "sense_id": "f9e0f6cc-ca47-3455-af5f-591efbc78958",
                                "text": "„Die Bundesregierung wirft der Bahn die Vernachlässigung des Schienennetzes und der Brücken trotz milliardenschwerer Staatshilfen vor.“"
                            },
                            {
                                "example_id": "25213c5c-0e7b-4c6a-bf18-277106863c20",
                                "sense_id": "f9e0f6cc-ca47-3455-af5f-591efbc78958",
                                "text": "„Um der drohenden Vernachlässigung des Umweltgedankens entgegenzuwirken, haben am Montag 42 religiöse Institutionen verschiedener Konfessionen in 14 Ländern unter Federführung des ‚Global Catholic Climate Movement‘ (GCCM) in einer gemeinsamen Absichtserklärung beschlossen, nicht mehr in Unternehmen zu investieren, die fossile Brennstoffe fördern oder mit ihnen handeln.“"
                            },
                            {
                                "example_id": "dc646ae2-2216-4c4c-8df6-bdfedcf3de28",
                                "sense_id": "f9e0f6cc-ca47-3455-af5f-591efbc78958",
                                "text": "„Die Gefahr besteht darin, dass eine Vernachlässigung der wirtschaftlichen Konsequenzen der Klimapolitik die bürgerliche Gesellschaft zerreißt.“"
                            },
                            {
                                "example_id": "a212256e-7400-4d5e-87b2-39dc4e3d8756",
                                "sense_id": "f9e0f6cc-ca47-3455-af5f-591efbc78958",
                                "text": "„Wer nach den häufigeren Ursachen forscht, findet schwere Vernachlässigungen im Kindesalter sowie ein Klima von Gewalt und Streit in den Familien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
