                                "target_senses": [
                                    {
                                        "sense_id": "60c086cf-7701-3617-a156-ea21c32b7888",
                                        "entry_id": "20991d06-2eaf-3c31-bd26-79b6ee221968",
                                        "glosses": [
                                            "To lower or remove the value of something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20d901ac-e964-41e5-9f7f-3a21de73ceef",
                                                "sense_id": "60c086cf-7701-3617-a156-ea21c32b7888",
                                                "text": "Scotland is beaten only by properties in London, which increase in value by 64% on average when within half a mile of a station - although in some cases in the capital, being near to a station devalues the house."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6db34183-b895-34b6-9a9f-e8f3b1975158",
                                        "entry_id": "20991d06-2eaf-3c31-bd26-79b6ee221968",
                                        "glosses": [
                                            "To lose value; to depreciate."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6988c70f-6459-436e-8968-4bb73598896a",
                        "source_entry_id": "76a7db81-acdb-32d2-ba25-fe67bce5f170",
                        "source_sense_description": "лишить ценности, сделать малоценным",
                        "target_lang_word": "depreciate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "depreciate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9dcecfbb-0a68-313c-8bf8-4268b17cda23",
                                        "entry_id": "89648799-2951-3e87-891e-5a8a2b583224",
                                        "glosses": [
                                            "To lessen in price or estimated value; to lower the worth of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84386d49-a244-4009-853a-43ee7b200f65",
                                                "sense_id": "9dcecfbb-0a68-313c-8bf8-4268b17cda23",
                                                "text": "[…] which […] some over-severe philosophers may look upon fastidiously, or undervalue and depreciate."
                                            },
                                            {
                                                "example_id": "5cf980fc-e98d-4d5c-874c-76cea1703b27",
                                                "sense_id": "9dcecfbb-0a68-313c-8bf8-4268b17cda23",
                                                "text": "To prove that the Americans ought not to be free, we are obliged to depreciate the value of freedom itself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34be71d2-6a1a-345b-a7b8-4921b54f932b",
                                        "entry_id": "89648799-2951-3e87-891e-5a8a2b583224",
                                        "glosses": [
                                            "To decline in value over time."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "02366c74-9843-3afe-94a5-86b64622af30",
                                        "entry_id": "89648799-2951-3e87-891e-5a8a2b583224",
                                        "glosses": [
                                            "To belittle or disparage."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51154774-2d4e-4b27-a42d-895aae4dbef4",
                                                "sense_id": "02366c74-9843-3afe-94a5-86b64622af30",
                                                "text": "They depreciated him because he was the youngest on the team."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "359e0734-1703-411e-aae7-440701005fce",
                        "source_entry_id": "76a7db81-acdb-32d2-ba25-fe67bce5f170",
                        "source_sense_description": "лишить ценности, сделать малоценным",
                        "target_lang_word": "cheapen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cheapen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba8b6374-07f5-3455-ac4a-b6af607c1c2b",
                                        "entry_id": "cca4a199-0f3a-3196-9f78-3cee0629a99b",
                                        "glosses": [
                                            "To decrease the value or price of; to make cheaper."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abb4a905-9a40-4da9-b8c2-218799638d71",
                                                "sense_id": "ba8b6374-07f5-3455-ac4a-b6af607c1c2b",
                                                "text": "Now, covered concrete troughs to house the cables are laid parallel with the railway lines, cheapening maintenance because of improved accessibility for inspection and repair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fd83a10-fc8f-38ae-a194-b86c253ec7cd",
                                        "entry_id": "cca4a199-0f3a-3196-9f78-3cee0629a99b",
                                        "glosses": [
                                            "To make vulgar."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "994e24bc-7d0f-4ebe-9781-5c5b48e7871e",
                                                "sense_id": "5fd83a10-fc8f-38ae-a194-b86c253ec7cd",
                                                "text": "The pace of the season can't help but cheapen these scenes, but I can’t deny that it's a blast. I’ve been critical of both the relative depopulation of the cast in this final run and the speedy, schematic narrative that checks off high points and moves on without really building to them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7b356ae-0aec-30e6-96f5-df030edfad62",
                                        "entry_id": "cca4a199-0f3a-3196-9f78-3cee0629a99b",
                                        "glosses": [
                                            "To become cheaper."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e8b0588e-877b-3222-808d-23d3d672309e",
                                        "entry_id": "cca4a199-0f3a-3196-9f78-3cee0629a99b",
                                        "glosses": [
