                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "01c5a74c-128f-3f94-803b-2abf872daa9e",
                                        "entry_id": "cc11c274-7d04-3693-841d-0f026ad4bdf3",
                                        "glosses": [
                                            "odchod Řecka z eurozóny, případně z Evropské unie"
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0765074-2076-47d4-b819-ba837834cbef",
                                                "sense_id": "01c5a74c-128f-3f94-803b-2abf872daa9e",
                                                "text": "Grexit je používaný zkrácený výraz pro odchod Řecka z eurozóny - Greek exit."
                                            },
                                            {
                                                "example_id": "37969a03-0f5c-4e50-845c-149fde8285ff",
                                                "sense_id": "01c5a74c-128f-3f94-803b-2abf872daa9e",
                                                "text": "To, že Řecku Grexit hrozí, a to hlavně pokud bude u moci SYRIZA, si lidé samozřejmě uvědomují."
                                            },
                                            {
                                                "example_id": "c245967b-d19d-48b2-af0e-1e76e1e71c60",
                                                "sense_id": "01c5a74c-128f-3f94-803b-2abf872daa9e",
                                                "text": "[Jörg Asmussen] upozornil, že takzvaný „Grexit“, tedy odchod Řecka z eurozóny, by nebyl tak úplně hladký, jak si někteří představují."
                                            },
                                            {
                                                "example_id": "68cb7c2c-6d89-478f-8b3d-d35776f656bf",
                                                "sense_id": "01c5a74c-128f-3f94-803b-2abf872daa9e",
                                                "text": "Hospodářství Kypru, které se stále zotavuje z paralyzující bankovní krize, je úzce spojeno s tím řeckým a bylo by těžce postiženo jakýmkoliv 'Grexitem' (tzn. odchodem Řecka) z eurozóny či dokonce samotné Evropské unie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
