            {
                "entry_id": "c9dc665b-5757-397f-93e0-cd4bf7666507",
                "word": "zézette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3b13cc27-8524-4d4c-bd29-6bbba0c33f20",
                        "entry_id": "c9dc665b-5757-397f-93e0-cd4bf7666507",
                        "tags": [
                            "plural"
                        ],
                        "form": "zézettes"
