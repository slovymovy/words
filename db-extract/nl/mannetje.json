                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "636d2a47-c331-3e6d-a7da-b660b4e39470",
                        "entry_id": "02afd784-3840-355f-b471-5ae2aa23ef76",
                        "glosses": [
                            "dier van het mannelijk geslacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6efd8029-89a8-4abb-a409-d60132a5a5f5",
                                "sense_id": "636d2a47-c331-3e6d-a7da-b660b4e39470",
                                "text": "Het mannetje zoekt een vrouwtje."
                            },
                            {
                                "example_id": "a4e404c3-c253-467f-9553-605a2759a469",
                                "sense_id": "636d2a47-c331-3e6d-a7da-b660b4e39470",
                                "text": "Ze grapte dat ze een zwarte weduwe was die haar mannetje na het paren opat."
                            }
                        ]
                    },
                    {
                        "sense_id": "78c0968d-8fdc-36fb-b169-9493b434e9cd",
                        "entry_id": "02afd784-3840-355f-b471-5ae2aa23ef76",
                        "glosses": [
                            "iemand van het mannelijk geslacht die tegen betaling klusjes verricht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "447f0b1c-9420-4a2d-ab20-399c58d5075d",
                                "sense_id": "78c0968d-8fdc-36fb-b169-9493b434e9cd",
                                "text": "'Vroeger had ik een mannetje in dienst om het verkeer op de parkeerplaats te regelen."
                            }
                        ]
                    },
                    {
                        "sense_id": "00bb33a2-b211-33fa-841f-9ef11411c81d",
                        "entry_id": "02afd784-3840-355f-b471-5ae2aa23ef76",
