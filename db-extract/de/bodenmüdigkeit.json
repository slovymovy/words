                "senses": [
                    {
                        "sense_id": "c01ef46f-5196-30ac-a078-5f8c8bb48ccb",
                        "entry_id": "e28db572-1daf-3a17-bb64-2eda7e5010e3",
                        "glosses": [
                            "Rückgang der Fruchtbarkeit des Ackerbodens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82a44413-d1a3-44ed-919e-85a792adfd17",
                                "sense_id": "c01ef46f-5196-30ac-a078-5f8c8bb48ccb",
                                "text": "„Um Schädlingsbefall und Bodenmüdigkeit zu umgehen, werden die gelben Rüben nur auf Feldern gepflanzt, auf denen mindestens zwei Jahre davor etwas anderes gewachsen ist.“"
                            },
                            {
                                "example_id": "31c7f2dd-90f6-4463-9ec0-285cdf9c144a",
                                "sense_id": "c01ef46f-5196-30ac-a078-5f8c8bb48ccb",
                                "text": "„Grund dafür ist die sogenannte ‚Bodenmüdigkeit‘, die den stagnierenden Gehalt an Nährstoffen und Mikroorganismen meint, der im Laufe eines Obstbaumlebens entsteht.“"
                            },
                            {
                                "example_id": "be199cd2-8f16-41a3-9009-36d91cc0b0a9",
                                "sense_id": "c01ef46f-5196-30ac-a078-5f8c8bb48ccb",
                                "text": "„Durch den Fruchtwechsel wird die Ausbreitung von Krankheiten oder Schädlingen, die in Zusammenhang mit bestimmten kultivierten Pflanzen auftreten, begrenzt und eine Bodenmüdigkeit verhindert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
