                        "target_lang_word": "dedicated",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dedicated",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9bc65174-cfba-31f2-b2e9-cf48a654b05e",
                                        "entry_id": "e763b09e-fa58-3f41-bcc9-f3b855f6d64d",
                                        "glosses": [
                                            "Devoted; loyal; conscientious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d1ba967-8d39-4f54-bc12-fbe2f0f545d6",
                                                "sense_id": "9bc65174-cfba-31f2-b2e9-cf48a654b05e",
                                                "text": "Like most human activities, ballooning has sponsored heroes and hucksters and a good deal in between. For every dedicated scientist patiently recording atmospheric pressure and wind speed while shivering at high altitudes, there is a carnival barker with a bevy of pretty girls willing to dangle from a basket or parachute down to earth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43d9988d-69d5-3380-98b5-3d8ec29cb47f",
                                        "entry_id": "e763b09e-fa58-3f41-bcc9-f3b855f6d64d",
                                        "glosses": [
                                            "Used or intended for a particular purpose"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "dedicated",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ea06f29-0c31-3c42-a5a2-acf44f8700bb",
                                        "entry_id": "98b571fd-84eb-31b3-9ba3-e98fc3652394",
                                        "glosses": [
                                            "simple past and past participle of dedicate"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0a87377-c0dd-4ce1-83f4-416a3a964a4a",
                        "source_entry_id": "c3a9def6-32e5-3d29-84d2-3d231fab9bee",
                        "source_sense_id": "5f884e45-5c16-3f03-970f-6b276abc869f",
                        "target_lang_word": "separate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "separate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d0e66f08-210c-3f15-8823-6809ea706419",
                                        "entry_id": "fdf301f4-1232-345c-8209-958a0e406acd",
                                        "glosses": [
                                            "To divide (a thing) into separate parts."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23383bd6-a93d-496e-a066-6e4af48e99b9",
                                                "sense_id": "d0e66f08-210c-3f15-8823-6809ea706419",
                                                "text": "Separate the articles from the headings."
                                            },
                                            {
                                                "example_id": "e6171f9a-bf83-4594-b44d-bf8ca0d4b764",
                                                "sense_id": "d0e66f08-210c-3f15-8823-6809ea706419",
                                                "text": "Ant taxonomists have decided that anything that's worth separating should be separated at the species level, and have no truck with subspecies at all. Butterfly taxonomists, however, like the triple-barrelled name approach and dote on subspecies. As a result, the numbers of ant species and butterfly species are not directly comparable."
                                            },
                                            {
                                                "example_id": "29217e3c-966e-484e-97f0-5e746e67b744",
                                                "sense_id": "d0e66f08-210c-3f15-8823-6809ea706419",
                                                "text": "The mesosphere may be described as the earth's intermediate or middle atmosphere, which separates the thermosphere above from the ozonosphere (or stratosphere) below, both of which are responsible for absorption of most of the ultraviolet part of the solar radiation and preventing it from reaching the earth's surface."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "953de241-f4e8-39a3-bb2a-e0dadeb83f17",
                                        "entry_id": "fdf301f4-1232-345c-8209-958a0e406acd",
                                        "glosses": [
                                            "To disunite from a group or mass; to disconnect."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f48a4bc-3f28-472c-87f5-d05911004a65",
                                                "sense_id": "953de241-f4e8-39a3-bb2a-e0dadeb83f17",
                                                "text": "Who shall separate us from the love of Christ?"
                                            },
                                            {
                                                "example_id": "c8871b3a-2e98-4479-b064-d47db70be7b9",
                                                "sense_id": "953de241-f4e8-39a3-bb2a-e0dadeb83f17",
                                                "text": "From the fine gold I separate the allay [alloy]."
                                            },
                                            {
                                                "example_id": "6fa8f44e-1645-49e4-a4f5-9bdb67b73e4d",
                                                "sense_id": "953de241-f4e8-39a3-bb2a-e0dadeb83f17",
                                                "text": "There must be some deep-rooted anti-social principle in every man's nature, so dearly does he love aught that separates him from his kind; or is it but one of the many shapes taken by that mental kaleidoscope, vanity, the varying and the glittering, the desire of distinction, sinking into that of notice?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "396dec11-b569-31a4-bc7a-971af7d26fe2",
                                        "entry_id": "fdf301f4-1232-345c-8209-958a0e406acd",
                                        "glosses": [
                                            "To cause (things or people) to be separate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc76849b-6d58-4a8c-ad00-b43cd913411d",
                                                "sense_id": "396dec11-b569-31a4-bc7a-971af7d26fe2",
                                                "text": "If the kids get too noisy, separate them for a few minutes."
                                            },
                                            {
                                                "example_id": "7e37cb75-8fac-4105-9e12-993d66f58cf1",
                                                "sense_id": "396dec11-b569-31a4-bc7a-971af7d26fe2",
                                                "text": "It is tempting to speculate about the incentives or compulsions that might explain why anyone would take to the skies in [the] basket [of a balloon]: […]; […]; or perhaps to muse on the irrelevance of the borders that separate nation states and keep people from understanding their shared environment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "325d267e-9eba-3674-b7b1-8e204b9a45f8",
                                        "entry_id": "fdf301f4-1232-345c-8209-958a0e406acd",
                                        "glosses": [
                                            "To divide itself into separate pieces or substances."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e25a8daa-2e5d-4429-97dd-cf4f72ac26d9",
                                                "sense_id": "325d267e-9eba-3674-b7b1-8e204b9a45f8",
                                                "text": "The sauce will separate if you don't keep stirring."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0661abfb-2d9d-3f4f-b48f-18337b042f9d",
                                        "entry_id": "fdf301f4-1232-345c-8209-958a0e406acd",
                                        "glosses": [
                                            "To set apart; to select from among others, as for a special use or service."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52322ed2-a6b3-4421-8fb5-7963ad65db1f",
                                                "sense_id": "0661abfb-2d9d-3f4f-b48f-18337b042f9d",
                                                "text": "Separate me Barnabas and Saul for the work whereunto I have called them."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "separate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc25bfd7-dc15-3be6-87a2-b769fc2f021f",
                                        "entry_id": "9c0182c1-ca12-376b-81b2-7207233e2232",
                                        "glosses": [
                                            "Apart from (the rest); not connected to or attached to (anything else)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1c54795-af43-421d-a670-a5b65ccef804",
                                                "sense_id": "bc25bfd7-dc15-3be6-87a2-b769fc2f021f",
                                                "text": "This chair can be disassembled into five separate pieces."
                                            },
                                            {
                                                "example_id": "a517970a-049c-4276-804d-aaf6f86408e8",
                                                "sense_id": "bc25bfd7-dc15-3be6-87a2-b769fc2f021f",
                                                "text": "Syntactically, hendiadic constructions differ from synthetonic sequences in that the latter are separate clauses, and hence are separately negatable and may have different tenses and aspects and different subjects."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ee1fd29-21fb-32ab-b5dd-ef47e03a40ef",
                                        "entry_id": "9c0182c1-ca12-376b-81b2-7207233e2232",
                                        "glosses": [
                                            "Not together (with); not united (to)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea03a3bb-dfd2-4786-9ae5-335c7f5d0352",
                                                "sense_id": "2ee1fd29-21fb-32ab-b5dd-ef47e03a40ef",
                                                "text": "I try to keep my personal life separate from work."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "separate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e61e4cc-d925-3992-99c6-584477bb85f7",
                                        "entry_id": "ec1ef3d8-6703-35f6-8d78-ede44a31e5bd",
                                        "glosses": [
                                            "Anything that is sold by itself, especially articles of clothing such as blouses, skirts, jackets, and pants."
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "750a62f7-182d-4262-9b88-4c7af3badf64",
                                                "sense_id": "1e61e4cc-d925-3992-99c6-584477bb85f7",
                                                "text": "French taffeta evening separates – a puffball skirt, and a ruffled blouse – were pressed flat to drag them up to date."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc5e7969-46f0-3373-9764-c3720f017074",
                                        "entry_id": "ec1ef3d8-6703-35f6-8d78-ede44a31e5bd",
                                        "glosses": [
                                            "A printing of an article from a periodical as its own distinct publication and distributed independently, often with different page numbers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
