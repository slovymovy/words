                "senses": [
                    {
                        "sense_id": "2b33ba4b-d388-38b0-8553-6a2fbcdd1537",
                        "entry_id": "12af0293-e5a8-3ed5-ac43-95e3a8191bd0",
                        "glosses": [
                            "Betrag, um den die errechnete Steuer vermindert wird, vor allem in Österreich."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54bdeaca-9f40-4a49-8268-288d1781d632",
                                "sense_id": "2b33ba4b-d388-38b0-8553-6a2fbcdd1537",
                                "text": "„Dieser Absetzbetrag vermindert sich gleichmäßig einschleifend zwischen zu versteuernden laufenden Pensionseinkünften von 19.930 Euro und 25.000 Euro auf Null.“"
                            },
                            {
                                "example_id": "4ef9f4bc-0a15-42cc-a321-0ad0efccb8c0",
                                "sense_id": "2b33ba4b-d388-38b0-8553-6a2fbcdd1537",
                                "text": "„Während die Sonderausgaben und außergewöhnlichen Belastungen lediglich die Steuerbemessungsgrundlage vermindern, kürzen die Absetzbeträge immer die Steuer selbst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5a8ee78-e4f0-4db5-9edc-79f05d90e9ed",
                        "source_entry_id": "12af0293-e5a8-3ed5-ac43-95e3a8191bd0",
                        "source_sense_id": "2b33ba4b-d388-38b0-8553-6a2fbcdd1537",
