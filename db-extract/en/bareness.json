        "de-extract.jsonl": [
            {
                "entry_id": "22cb2f16-df04-3373-b3cd-8110e66c6f50",
                "word": "bareness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "caefb1f4-155f-3f3f-8625-1b32fe8dfb4a",
                        "entry_id": "22cb2f16-df04-3373-b3cd-8110e66c6f50",
                        "glosses": [
                            "Nacktheit, Blöße"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcc67391-e595-41aa-b42d-ce29581127ae",
                                "sense_id": "caefb1f4-155f-3f3f-8625-1b32fe8dfb4a",
                                "text": "\"Designers of evening clothes know how to give an illusion of bareness by using thin tulle or net to cover the midriff.\"",
                                "translation": "Designer von Abendkleidung wissen, wie man eine Illusion der Nacktheit erzeugen kann durch die Verwendung von dünnem Tüll oder netzartigen Geweben, um die Obertaille zu bedecken."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "00d7c7ee-af35-3dae-93d3-dfb068dbeda6",
                        "entry_id": "22cb2f16-df04-3373-b3cd-8110e66c6f50",
                        "glosses": [
                            "Magerkeit, Armut, Kargheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31e0a77f-c9b1-4559-8a57-d5b3e63d1da0",
                                "sense_id": "00d7c7ee-af35-3dae-93d3-dfb068dbeda6",
                                "text": "\"The winter bareness spread drearily over it now.\"",
                                "translation": "Die Kargheit des Winters breitete sich jetzt trübselig über ihn [den Rosengarten]."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30264c17-2b66-4061-bd1f-16c48adf812d",
                        "source_entry_id": "22cb2f16-df04-3373-b3cd-8110e66c6f50",
                        "source_sense_id": "caefb1f4-155f-3f3f-8625-1b32fe8dfb4a",
                        "source_sense_description": "Nacktheit, Blöße",
                        "target_lang_word": "Nacktheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nacktheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4a81edff-6dd4-358d-9e52-a010c78fff70",
                                        "entry_id": "96f870c8-95fe-30b2-a8c1-d313485aa099",
                                        "glosses": [
                                            "Zustand, in dem man unbekleidet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61356d86-9f05-4969-bda8-c92be784bd5a",
                                                "sense_id": "4a81edff-6dd4-358d-9e52-a010c78fff70",
                                                "text": "Sie schämt sich ihrer Nacktheit nicht, als sie die Tür öffnet."
                                            },
                                            {
                                                "example_id": "44a631af-1eda-4c70-a228-4ca838c6606e",
                                                "sense_id": "4a81edff-6dd4-358d-9e52-a010c78fff70",
                                                "text": "„Seine Nacktheit machte ihm nicht mehr so viel aus.“"
                                            },
                                            {
                                                "example_id": "2214092a-e4e9-4e46-a06a-e09eac287268",
                                                "sense_id": "4a81edff-6dd4-358d-9e52-a010c78fff70",
                                                "text": "„Dabei glaubte ich, in Deutschland würde die mitten in der Stadt ausgestellte Nacktheit als Erregung öffentlichen Ärgernisses gelten.“"
                                            },
                                            {
                                                "example_id": "21a50859-c8ab-454d-a71d-b7f65dc81ed7",
                                                "sense_id": "4a81edff-6dd4-358d-9e52-a010c78fff70",
                                                "text": "„Schon früher hatte ich bemerkt, dass die Nacktheit des Ostens besonders nackt war.“"
                                            },
                                            {
                                                "example_id": "3bb85eb8-f1da-4b4e-b4df-d5265e4b0c67",
                                                "sense_id": "4a81edff-6dd4-358d-9e52-a010c78fff70",
                                                "text": "„Ihre Nacktheit hypnotisiert ihn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6aea389f-19f5-33b3-84ed-4f809abe27e5",
                                        "entry_id": "96f870c8-95fe-30b2-a8c1-d313485aa099",
                                        "glosses": [
                                            "Kahlheit"
                                        ],
                                        "tags": [
                                            "bildlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d84a34e5-722c-44f8-a944-72f28baf47fa",
                                                "sense_id": "6aea389f-19f5-33b3-84ed-4f809abe27e5",
                                                "text": "Die Nacktheit der Räume in ihrem neuen Haus erschreckte Ruth."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2603478-e756-42db-aa60-c5631c2fbba6",
                        "source_entry_id": "22cb2f16-df04-3373-b3cd-8110e66c6f50",
                        "source_sense_id": "caefb1f4-155f-3f3f-8625-1b32fe8dfb4a",
                        "source_sense_description": "Nacktheit, Blöße",
                        "target_lang_word": "Blöße",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blöße",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "59881ab2-6b5f-3144-afbf-944a4b3d6b4c",
                                        "entry_id": "d20fbda5-f5ca-3353-88b7-a3119fec6abf",
                                        "glosses": [
                                            "Zustand, in dem man unbekleidet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8fa7031-9592-4ea9-93d3-d57656ac3aa1",
                                                "sense_id": "59881ab2-6b5f-3144-afbf-944a4b3d6b4c",
                                                "text": "Sie schämten sich ihrer Blöße."
                                            },
                                            {
                                                "example_id": "41b0e2d7-e7a7-4f59-b75b-edbd0f61be7f",
                                                "sense_id": "59881ab2-6b5f-3144-afbf-944a4b3d6b4c",
                                                "text": "„Als nun Ham, Kanaans Vater, seines Vaters Blöße sah, sagte er’s seinen beiden Brüdern draußen.“"
                                            },
                                            {
                                                "example_id": "64ffce9c-2ab0-40f9-adc5-e432b2a50de3",
                                                "sense_id": "59881ab2-6b5f-3144-afbf-944a4b3d6b4c",
                                                "text": "„Den seinigen teilte der Soldat Martin der Überlieferung nach im Jahre 334 mit dem Schwert, um damit die Blöße eines hungrigen und frierenden Bettlers zu bedecken.“"
                                            },
                                            {
                                                "example_id": "b5bfed85-7846-4f7e-92b6-460f171ebc5c",
                                                "sense_id": "59881ab2-6b5f-3144-afbf-944a4b3d6b4c",
                                                "text": "„Er verspinnt und verwebt sie und bedeckt seine menschliche Blöße mit ihr, und das Spinnen und Weben artet in der Niederlausitz zur Tradition aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "65990481-7d25-387e-abd5-2bdf8c01060b",
                                        "entry_id": "d20fbda5-f5ca-3353-88b7-a3119fec6abf",
                                        "glosses": [
                                            "zum Gerben vorbereitete, enthaarte Haut"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2b093af3-f860-396f-ba68-7d55981ba0c5",
                                        "entry_id": "d20fbda5-f5ca-3353-88b7-a3119fec6abf",
                                        "glosses": [
                                            "eine baumlose Stelle in einem Wald"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4136ad50-b2ca-480d-b198-bfe3e190dd96",
                                                "sense_id": "2b093af3-f860-396f-ba68-7d55981ba0c5",
                                                "text": "Bei Tagesanbruch kamen sie zu einer Blöße."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "bb8da8dd-d21b-335d-8ae3-8430130e2235",
                                        "entry_id": "d20fbda5-f5ca-3353-88b7-a3119fec6abf",
                                        "glosses": [
                                            "gültige Trefferfläche beim Fechten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d494191b-d268-49c6-9404-c78ac5ca463b",
                                                "sense_id": "bb8da8dd-d21b-335d-8ae3-8430130e2235",
                                                "text": "„So eignet sich eine Quart-Parade besonders, einen Angriff auf die obere innere Blöße abzuwehren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de522f14-1ee9-42d7-9214-1049eabca97e",
                        "source_entry_id": "22cb2f16-df04-3373-b3cd-8110e66c6f50",
                        "source_sense_id": "caefb1f4-155f-3f3f-8625-1b32fe8dfb4a",
                        "source_sense_description": "Nacktheit, Blöße",
                        "target_lang_word": "nudité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nudité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bb9e04ca-bab4-3997-81a9-e875cb6c1ebb",
                                        "entry_id": "864a902c-180c-3a6b-bbb3-3bc43afb8d6f",
                                        "glosses": [
                                            "État d’une personne qui est nue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5702bef2-ea11-4f0a-9732-1eb0351ce0db",
                                                "sense_id": "bb9e04ca-bab4-3997-81a9-e875cb6c1ebb",
                                                "text": "La nudité est un état naturel, le nu un genre artistique, le naturisme une philosophie…"
                                            },
                                            {
                                                "example_id": "afe933d5-9a90-4228-984a-ab3852c5755d",
                                                "sense_id": "bb9e04ca-bab4-3997-81a9-e875cb6c1ebb",
                                                "text": "Mais leur nudité ne choquait personne, car elles n’en eussent pas ainsi exposé tous les détails au soleil, si l’un d’eux se fût signalé par le moindre défaut qui prêtât aux railleries des femmes mariées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aba81afb-341a-3911-862b-d5c6fd79778f",
                                        "entry_id": "864a902c-180c-3a6b-bbb3-3bc43afb8d6f",
                                        "glosses": [
                                            "État de ce qui n’est pas recouvert, en parlant des choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4759312-da87-42d4-83bf-b3d15f51c5f4",
                                                "sense_id": "aba81afb-341a-3911-862b-d5c6fd79778f",
                                                "text": "[…] il ne demeura plus que la route, la britchka, les trois chevaux […], Sélifane, Tchitchikov, la vaste nudité des champs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "803fcdd4-87c6-3789-a41d-ce7b1c4ee185",
                                        "entry_id": "864a902c-180c-3a6b-bbb3-3bc43afb8d6f",
                                        "glosses": [
                                            "Figure nue."
                                        ],
                                        "tags": [
                                            "Peinture",
                                            "Surtout au pluriel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e817987d-3a70-4f22-bdf4-d6bcf4da71ff",
                                                "sense_id": "803fcdd4-87c6-3789-a41d-ce7b1c4ee185",
                                                "text": "Les bons moines de Châalis auraient voulu supprimer quelques nudités trop voyantes du \"style Médicis\"."
                                            },
                                            {
                                                "example_id": "1f0ddbb1-c998-4adf-9b4c-1a529bc30c17",
                                                "sense_id": "803fcdd4-87c6-3789-a41d-ce7b1c4ee185",
                                                "text": "[…] je lis avec effarement, à plusieurs encoignures, des affiches enluminées […]. « Engagez-vous dans l’armée coloniale! » s’écrie l’autre, toute enluminée de perroquets, toute rehaussée de nudités affriolantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9161a6db-3f95-38f5-af83-f22314af7e23",
                                        "entry_id": "864a902c-180c-3a6b-bbb3-3bc43afb8d6f",
                                        "glosses": [
                                            "Se dit en parlant d’un style sec, sans couleur, sans agrément."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7800d4ad-b052-42ce-938f-882a70aa836e",
                                                "sense_id": "9161a6db-3f95-38f5-af83-f22314af7e23",
                                                "text": "Formulé dans sa nudité, ce problème révèle son obscène banalité. Nous engendrons des vies précaires, nous créons des œuvres périssables."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
