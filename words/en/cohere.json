{
    "word_family": [
        "coherence",
        "coherency",
        "coherent",
        "incoherence",
        "incoherent"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b425d2d5-a8cc-3f82-b524-860aba15245e",
                    "sense_definition": "To stick together physically by adhesion",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_adhesion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Separate molecules will <w>cohere</w> because of electromagnetic force.",
                            "target_lang_translations": {
                                "ru": "Отдельные молекулы будут <w>сцепляться</w> из-за электромагнитной силы.",
                                "zh": "由于电磁力的作用，独立的分离分子会<w>凝聚</w>在一起。"
                            }
                        },
                        {
                            "text": "The wet clay began to <w>cohere</w> into a solid mass.",
                            "target_lang_translations": {
                                "ru": "Влажная глина начала <w>слипаться</w> в твердую массу.",
                                "zh": "湿黏土开始<w>粘合</w>成一个坚实的整体。"
                            }
                        }
                    ],
                    "synonyms": [
                        "adhere",
                        "stick",
                        "bond"
                    ],
                    "antonyms": [
                        "separate",
                        "detach"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физически сцепляться или прилипать друг к другу",
                        "zh": "（物质、颗粒等）通过附着力紧密结合、粘在一起"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сцепляться",
                                "target_lang_sense_clarification": "о физическом соединении частиц или предметов"
                            },
                            {
                                "target_lang_word": "слипаться",
                                "target_lang_sense_clarification": "о соединении мягких или влажных материалов"
                            },
                            {
                                "target_lang_word": "держаться вместе",
                                "target_lang_sense_clarification": "об образовании единого целого за счет сил притяжения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "凝聚",
                                "target_lang_sense_clarification": "指颗粒、分子等聚集并结合在一起"
                            },
                            {
                                "target_lang_word": "粘合",
                                "target_lang_sense_clarification": "指物体或物质粘连在一起"
                            },
                            {
                                "target_lang_word": "结合",
                                "target_lang_sense_clarification": "指物质或部分紧密结合成一体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e1f5b24-70a4-37e2-a7c3-04de861f5f62",
                    "sense_definition": "To be consistent or form a unified whole",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "logical_consistency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chapters of the novel never quite <w>cohere</w> into a single story.",
                            "target_lang_translations": {
                                "ru": "Главы романа так и не <w>складываются</w> в единую историю.",
                                "zh": "这部小说的各章节始终未能很好地<w>连贯</w>成一个完整的故事。"
                            }
                        },
                        {
                            "text": "A system that degrades but continues to <w>cohere</w> is better than one that collapses.",
                            "target_lang_translations": {
                                "ru": "Система, которая деградирует, но продолжает <w>оставаться целостной</w>, лучше, чем та, которая рушится.",
                                "zh": "一个虽然退化但仍能保持<w>凝聚</w>的系统，好过一个直接崩溃的系统。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unite",
                        "harmonize",
                        "integrate"
                    ],
                    "antonyms": [
                        "fragment",
                        "disintegrate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть логически последовательным или составлять единое целое",
                        "zh": "（思想、论点、系统等）前后连贯、协调一致，形成统一整体"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быть согласованным",
                                "target_lang_sense_clarification": "о логической непротиворечивости идей или действий"
                            },
                            {
                                "target_lang_word": "объединяться",
                                "target_lang_sense_clarification": "о формировании целостной структуры или группы"
                            },
                            {
                                "target_lang_word": "сочетаться",
                                "target_lang_sense_clarification": "о гармоничном взаимодействии элементов системы"
                            },
                            {
                                "target_lang_word": "складываться",
                                "target_lang_sense_clarification": "в единое целое: главы складываются в историю"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "连贯",
                                "target_lang_sense_clarification": "指章节、思想等逻辑上前后一致"
                            },
                            {
                                "target_lang_word": "凝聚",
                                "target_lang_sense_clarification": "指系统或团体形成统一的整体"
                            },
                            {
                                "target_lang_word": "结合",
                                "target_lang_sense_clarification": "指各部分形成协调的整体"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}