                "senses": [
                    {
                        "sense_id": "5de12a99-5868-383c-abab-5cbefde67169",
                        "entry_id": "e91cec9c-30ed-37ac-8bbc-502d57e4ac0f",
                        "glosses": [
                            "To make feeble."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b2c13695-2b2b-4768-a8e1-80c6d3146386",
                                "sense_id": "5de12a99-5868-383c-abab-5cbefde67169",
                                "text": "1774, Dr Samuel Johnson, Preface to the Works of the English Poets, J. Nichols, Volume II, Page 130,\n\"...the gout, with which he had long been tormented, prevailed over the enfeebled powers of nature.\""
                            },
                            {
                                "example_id": "37af13dc-237d-4af3-b86e-c522a5e2243e",
                                "sense_id": "5de12a99-5868-383c-abab-5cbefde67169",
                                "text": "In the face of enfeebled, self-harming opposition on both sides of the border (and a miserable economic recession on both sides too) he has performed brilliantly."
                            },
                            {
                                "example_id": "cc2f9e51-449f-4124-be6e-ebb6ac405b13",
                                "sense_id": "5de12a99-5868-383c-abab-5cbefde67169",
                                "text": "The Republican-appointed justices may yet enfeeble the executive branch’s ability to implement federal law."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1949b416-6706-47b0-bd09-dce612c358ac",
                        "source_entry_id": "e91cec9c-30ed-37ac-8bbc-502d57e4ac0f",
                        "source_sense_id": "5de12a99-5868-383c-abab-5cbefde67169",
                        "source_sense_description": "make feeble",
                        "target_lang_word": "affaiblir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "affaiblir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1370797c-87d9-3763-ab0a-8b15474983cf",
                                        "entry_id": "af70c5dd-16f3-3a3a-991a-8595459412e0",
                                        "glosses": [
                                            "Rendre faible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7530c776-79e4-494c-8cef-e310f9a81fb7",
                                                "sense_id": "1370797c-87d9-3763-ab0a-8b15474983cf",
                                                "text": "les réformes de Henry II, en affaiblissant les nobles, les avaient rapprochés de leurs tenants. Entre le manoir et le village, les conflits devenaient plus rares."
                                            },
                                            {
                                                "example_id": "f118ed32-0667-4491-aaaa-3498423e6c6d",
                                                "sense_id": "1370797c-87d9-3763-ab0a-8b15474983cf",
                                                "text": "Et semblablement ce sera affaiblir les monnaies, si leur cours demeure invariable, que de diminuer leur poids ou d’abaisser leur titre."
                                            },
                                            {
                                                "example_id": "1a067e3d-3d1a-4165-999b-fad66c9b49c9",
                                                "sense_id": "1370797c-87d9-3763-ab0a-8b15474983cf",
                                                "text": "L'essentiel pour les jésuites, c'était d’affaiblir, d'amoindrir, de rendre les âmes faibles et fausses, de faire des petits très-petits, et les simples idiots ; une âme nourrie de minuties, amusées de brimborions, devait être facile à conduire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "655e3dc7-cb8f-37d5-9e18-74ab208c9dc3",
                                        "entry_id": "af70c5dd-16f3-3a3a-991a-8595459412e0",
                                        "glosses": [
                                            "Devenir plus faible."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d9de5e0-3567-477d-89c8-0c99ee6657dd",
                                                "sense_id": "655e3dc7-cb8f-37d5-9e18-74ab208c9dc3",
                                                "text": "Il s’affaiblit."
                                            },
                                            {
                                                "example_id": "021728b9-abf9-4a75-85de-918b75b501e2",
                                                "sense_id": "655e3dc7-cb8f-37d5-9e18-74ab208c9dc3",
                                                "text": "Son esprit, sa tête s’affaiblit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5cd15481-38e7-48af-a8ae-2cf6b13a47b5",
                        "source_entry_id": "e91cec9c-30ed-37ac-8bbc-502d57e4ac0f",
                        "source_sense_id": "5de12a99-5868-383c-abab-5cbefde67169",
