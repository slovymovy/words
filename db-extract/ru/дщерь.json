                    },
                    {
                        "form_id": "e7d342de-f840-41f2-a598-7026cdea7e6b",
                        "entry_id": "676a101f-32be-3587-8b6c-baed029709a6",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "дще́рях"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "55399278-194d-3cb6-8cb2-3fea923975c8",
                        "entry_id": "676a101f-32be-3587-8b6c-baed029709a6",
                        "glosses": [
                            "церк.-слав., устар., высок. ирон. дочь"
                        ],
                        "tags": [
                            "или"
                        ],
                        "examples": [
                            {
                                "example_id": "558d42d5-31e0-42e8-aa6c-4568b3ff3073",
                                "sense_id": "55399278-194d-3cb6-8cb2-3fea923975c8",
                                "text": "Наша старшая дщерь в детсаде сделалась говорливой, прыгучей, выучила стишки…"
                            },
                            {
                                "example_id": "9c1b08d8-e55f-4261-9503-6aa866f0ef6e",
                                "sense_id": "55399278-194d-3cb6-8cb2-3fea923975c8",
                                "text": "Мать, матери; дочь, дочери происходят от матерь и дщерь и ради того по старинному окончанию в косвенных падежах обоих чисел склоняются."
                            },
                            {
                                "example_id": "1046109f-cf3e-4601-a247-429b15f0d0c2",
                                "sense_id": "55399278-194d-3cb6-8cb2-3fea923975c8",
                                "text": "Бирона нет, а у нас ныне царствует дщерь Петрова, кроткая Елисавет."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "73dcda21-fcdc-4f0d-b4e8-845b3e722001",
                        "source_entry_id": "676a101f-32be-3587-8b6c-baed029709a6",
                        "source_sense_id": "55399278-194d-3cb6-8cb2-3fea923975c8",
                        "target_lang_word": "fille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "78a3fd06-fa3f-3533-9264-8b8900ba556e",
                                        "entry_id": "42d7c08d-1312-3aea-b196-8bc9e2e8a8d8",
                                        "glosses": [
                                            "Enfant de genre féminin, par opposition à garçon ; aussi appelée fillette ou petite fille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fa51b12-b48b-4923-a0d4-c60cf1d65688",
                                                "sense_id": "78a3fd06-fa3f-3533-9264-8b8900ba556e",
                                                "text": "La violence à l’égard des femmes et des filles est l’une des atteintes aux droits de la personne les plus fréquentes dans le monde, se produisant et se répétant au quotidien dans tous les pays. Elle entraîne pour celles qui en sont victimes de graves conséquences physiques, économiques et psychologiques, à court et à long terme, entravant leur participation pleine et égalitaire à la vie en société. L’ampleur de son impact, tant sur les survivantes que sur leurs familles et même sur l’ensemble de la société, est incommensurable."
                                            },
                                            {
                                                "example_id": "ef1a1836-58d7-4e4c-b591-536eb070f572",
                                                "sense_id": "78a3fd06-fa3f-3533-9264-8b8900ba556e",
                                                "text": "Lancée il y a 10 ans par les Nations unies, la journée internationale de la fille vise à mettre en lumière les défis et les discriminations auxquels les filles, les adolescentes et les jeunes femmes font face pour préparer leur avenir sur un pied d’égalité avec les garçons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4e7604e-c8f9-3934-8ed6-9d0ef1ddbd68",
                                        "entry_id": "42d7c08d-1312-3aea-b196-8bc9e2e8a8d8",
                                        "glosses": [
                                            "Tout être humain de genre féminin, enfant ou adulte, considéré par rapport à ses parents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2557403-5f88-40fb-9e20-847cbd32b97d",
                                                "sense_id": "c4e7604e-c8f9-3934-8ed6-9d0ef1ddbd68",
                                                "text": "[…] il vint des Vieux Marais habiter à Manise comme brigadier, avec sa fille, une belle bachelle de dix-sept ans tout au plus."
                                            },
                                            {
                                                "example_id": "cbf1c6ab-2c3d-487c-b2cc-1a72fc03760f",
                                                "sense_id": "c4e7604e-c8f9-3934-8ed6-9d0ef1ddbd68",
                                                "text": "Il traita d’abord Joséphine de putain, chose affirma-t-il qui ne l’étonnait guère attendu qu’elle était la fille de sa mère, […]."
                                            },
                                            {
                                                "example_id": "a845dd57-16d0-4760-b10b-0dc904bf5103",
                                                "sense_id": "c4e7604e-c8f9-3934-8ed6-9d0ef1ddbd68",
                                                "text": "Quand il a des filles, un père de famille ne doit pas plus laisser introduire un jeune homme chez lui sans le connaître, que laisser traîner des livres ou des journaux sans les avoir lus."
                                            },
                                            {
                                                "example_id": "6828cd4e-5998-433e-b642-280a62bcb5b6",
                                                "sense_id": "c4e7604e-c8f9-3934-8ed6-9d0ef1ddbd68",
                                                "text": "Dans chaque dechra on trouve une à deux familles maraboutiques. Les mrabtin font remonter leur généalogie au prophète Mohamed par l'intermédiaire de sa fille Fatima et de son gendre Ali."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6912866e-989e-3c46-a7fa-44d00a8f90ae",
                                        "entry_id": "42d7c08d-1312-3aea-b196-8bc9e2e8a8d8",
                                        "glosses": [
                                            "Descendante issue de telle ou telle lignée, ou native de tel ou tel pays."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "formal",
                                            "literary",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3a239db-7b78-4ea8-b753-2ebf7f6d9735",
                                                "sense_id": "6912866e-989e-3c46-a7fa-44d00a8f90ae",
                                                "text": "La fille des Césars. — Une fille du peuple."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "359ed9b3-97f4-367c-8117-2a5e66e9097f",
                                        "entry_id": "42d7c08d-1312-3aea-b196-8bc9e2e8a8d8",
                                        "glosses": [
                                            "Fille, adolescente ou femme depuis sa naissance jusqu’à son mariage."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f69cb6f5-5dce-4dbb-aec1-c9d04b9f9899",
                                                "sense_id": "359ed9b3-97f4-367c-8117-2a5e66e9097f",
                                                "text": "Nous autres jeunes filles françaises, nous sommes livrées par nos familles comme des marchandises, à trois mois, quelquefois fin courant."
                                            },
                                            {
                                                "example_id": "a1e1cebb-691e-4792-8a8a-6f7761b74b09",
                                                "sense_id": "359ed9b3-97f4-367c-8117-2a5e66e9097f",
                                                "text": "Dès minuit, le père Canquoëlle pouvait ourdir toutes les trames, recevoir des espions et des ministres, des femmes et des filles, sans que qui que ce soit au monde s’en aperçût."
                                            },
                                            {
                                                "example_id": "6145f23d-fe3e-4c4a-8198-a2ebe03be784",
                                                "sense_id": "359ed9b3-97f4-367c-8117-2a5e66e9097f",
                                                "text": "Cette gentillesse qui abrégeait les formes et supprimait les fadaises ridicules que tout garçon se croit tenu de débiter à la belle fille dont il essaie de faire sa maîtresse, m’avait séduit."
                                            },
                                            {
                                                "example_id": "a38df29f-f162-47cf-94d7-50e902218817",
                                                "sense_id": "359ed9b3-97f4-367c-8117-2a5e66e9097f",
                                                "text": "François Cadet, un bel homme, un beau garçon dont les filles s’éprennent d’abord, pour qui elles se jalousent et se déchirent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "151edd2d-9864-35cd-ae91-31ffd8dea72c",
                                        "entry_id": "42d7c08d-1312-3aea-b196-8bc9e2e8a8d8",
                                        "glosses": [
                                            "Jeune fille encore vierge."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0c55754-ae26-493b-ad6b-68055b742c21",
                                                "sense_id": "151edd2d-9864-35cd-ae91-31ffd8dea72c",
                                                "text": "Que cherche Colombe ? Depuis qu’elle n’est plus fille, tient-elle à devenir la femme de tout le monde ? J'ai honte de mon amie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c92ffff2-4cef-3483-8089-948091e6d2de",
                                        "entry_id": "42d7c08d-1312-3aea-b196-8bc9e2e8a8d8",
                                        "glosses": [
                                            "Femme célibataire."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4254ea35-3736-44e9-b15b-144c85e27662",
                                                "sense_id": "c92ffff2-4cef-3483-8089-948091e6d2de",
                                                "text": "Ce qui tourmentait et désolait et retournait le curé de Melotte, c’était le dévergondage des filles et des garçons du pays."
                                            },
                                            {
                                                "example_id": "c02f177f-900a-48f7-ac5c-e22d9c66fcc0",
                                                "sense_id": "c92ffff2-4cef-3483-8089-948091e6d2de",
                                                "text": "Maman s’imaginait que toute la ville connaissait mon aventure. Personne ne voudrait plus m’épouser. Elle avait cette idée fixe que je resterais fille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d00f1eb-6ab0-3580-9a84-c7d81c5e7879",
                                        "entry_id": "42d7c08d-1312-3aea-b196-8bc9e2e8a8d8",
                                        "glosses": [
                                            "Fille d’honneur ; demoiselle d’honneur."
                                        ],
                                        "tags": [
                                            "dated",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffab7956-6648-410c-bd6e-cd94cd8840ff",
                                                "sense_id": "9d00f1eb-6ab0-3580-9a84-c7d81c5e7879",
                                                "text": "elle [Louise de Savoie] mena toutes ſes ﬁlles"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1af3d973-4022-310b-befb-5efb75877170",
                                        "entry_id": "42d7c08d-1312-3aea-b196-8bc9e2e8a8d8",
                                        "glosses": [
                                            "Nom que l’on donne aux religieuses de certaines communautés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1cb382f-e848-4729-9099-23b957d40690",
                                                "sense_id": "1af3d973-4022-310b-befb-5efb75877170",
                                                "text": "Les filles de saint Vincent de Paul. — Les filles du Carmel, de la Charité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe1022a9-7fe0-31af-b6ab-29201dc11023",
                                        "entry_id": "42d7c08d-1312-3aea-b196-8bc9e2e8a8d8",
                                        "glosses": [
                                            "Servante ; employée."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e50326d5-207d-4d68-9a2d-28cdd7d13a4a",
                                                "sense_id": "fe1022a9-7fe0-31af-b6ab-29201dc11023",
                                                "text": "En sabots, les manches relevées sur leurs bras blancs, les filles balayaient le devant des boutiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "896ec8a0-a687-3575-beb3-f3430f012d54",
                                        "entry_id": "42d7c08d-1312-3aea-b196-8bc9e2e8a8d8",
                                        "glosses": [
                                            "Fille de joie ou fille de trottoir ; prostituée."
                                        ],
                                        "tags": [
                                            "dated",
                                            "ellipsis",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbd54a90-a46c-4ef1-92e4-5163cbfe2dc0",
                                                "sense_id": "896ec8a0-a687-3575-beb3-f3430f012d54",
                                                "text": "Alors, une fille, n’est-ce pas ? dites tout de suite que je suis une fille, qu’on chasse des maisons qui se respectent !"
                                            },
                                            {
                                                "example_id": "baaeb2bf-41a7-4bdc-982d-6bfb09235b62",
                                                "sense_id": "896ec8a0-a687-3575-beb3-f3430f012d54",
                                                "text": "La place Pigalle, passé deux heures du matin, est le refuge des noctambules professionnels. Des musiciens, des nègres, des filles, des invertis se donnent rendez-vous dans les bars et voient souvent l’aube se lever sans que la chance leur ait souri."
                                            },
                                            {
                                                "example_id": "2f85115f-ea95-4720-a531-ad08dd047264",
                                                "sense_id": "896ec8a0-a687-3575-beb3-f3430f012d54",
                                                "text": "Le long des boutiques éclairées, des ombres se succédaient sans hâte. Il y avait des nègres, quelques Chinois, des blancs. Tous reluquaient les filles."
                                            },
                                            {
                                                "example_id": "0052666d-9ea8-4799-98cf-f58b487687b1",
                                                "sense_id": "896ec8a0-a687-3575-beb3-f3430f012d54",
                                                "text": "Il arrive aussi, mais cet usage tend à disparaitre au début de la IIIᵉ République, que les filles racolent en arpentant à tour de rôle le trottoir situé devant la maison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9675a79e-f053-3ac7-9790-b18c8e25bad7",
                                        "entry_id": "42d7c08d-1312-3aea-b196-8bc9e2e8a8d8",
                                        "glosses": [
                                            "Établissement qui est de la fondation et de la dépendance d’un autre."
                                        ],
                                        "tags": [
                                            "dated",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8998d1e-f6f4-421c-9387-7cac8dc8d456",
                                                "sense_id": "9675a79e-f053-3ac7-9790-b18c8e25bad7",
                                                "text": "C’est une fille, une des filles de Cluny."
                                            },
                                            {
                                                "example_id": "cf5b7db9-cea5-453a-b3f7-b80652c5e637",
                                                "sense_id": "9675a79e-f053-3ac7-9790-b18c8e25bad7",
                                                "text": "Ces abbayes sont filles de Cîteaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17ff4897-4a60-3d46-9625-0b447fd50182",
                                        "entry_id": "42d7c08d-1312-3aea-b196-8bc9e2e8a8d8",
                                        "glosses": [
                                            "Par extension, Jeune femme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f34e289c-ec3c-4d9d-8639-0fec194f9b8b",
                                                "sense_id": "17ff4897-4a60-3d46-9625-0b447fd50182",
                                                "text": "Pour décrire le rapport des filles à la route, David Le Breton évoque \"L'Ethique du care\" de Carol Gilligan : un ouvrage sociologique décrivant, entre autres, l'idée que les femmes ont une autre manière de penser la morale que les hommes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
