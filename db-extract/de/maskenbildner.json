                "senses": [
                    {
                        "sense_id": "7fb9aa60-c163-3f3e-98b1-0250cd0f6daa",
                        "entry_id": "c4640096-163d-3701-91fd-65225bd6b4d4",
                        "glosses": [
                            "Beruf, Berufsbezeichnung: Person, die Darsteller auf Bühnen und in Filmen schminkt und frisiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0d2593c-ec99-432d-8452-bd74019edf11",
                                "sense_id": "7fb9aa60-c163-3f3e-98b1-0250cd0f6daa",
                                "text": "„Das Omikron-Maßnahmenpaket hat auch zur Folge, dass Moderatorinnen und Moderatoren sowie Studiogäste ab Dienstag wegen des erhöhten Ansteckungsrisikos ohne hauseigene Maskenbildnerinnen und Maskenbildner auskommen müssen.“"
                            },
                            {
                                "example_id": "41666d62-f60d-435c-9b90-9a829045b4cb",
                                "sense_id": "7fb9aa60-c163-3f3e-98b1-0250cd0f6daa",
                                "text": "„Wer den Berufswunsch Maskenbildner hat, musste bislang entweder zur Ausbildung ins Ausland oder lernte zuerst Friseur und versuchte auf eigene Kosten mit passenden Weiterbildungen das Know-how für Maskenbildner zu erwerben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
