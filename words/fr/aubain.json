                            "comment": ""
                        }
                    ]
                },
                {
                    "sense_id": "73afba69-130c-3f43-a5d7-9eda4eab0599",
                    "sense_definition": "Personne étrangère à une communauté, une région ou un pays.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "étranger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce village reculé, chaque nouvel arrivant était immédiatement considéré comme un <w>aubain</w>."
                        },
                        {
                            "text": "Les coutumes de la province refusaient à tout <w>aubain</w> le droit de siéger à l'assemblée locale."
                        }
                    ],
                    "synonyms": [
