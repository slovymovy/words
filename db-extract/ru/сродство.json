                        "target_lang_word": "affinité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "affinité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b01fcfdf-c320-33b4-a523-e6ea865d9176",
                                        "entry_id": "282e46fe-a1f9-304f-b424-ae66d793c28f",
                                        "glosses": [
                                            "Degré de proximité que le mariage fait acquérir à un homme avec les parents de sa femme, et à une femme avec ceux de son mari."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc7e426a-54c9-4675-8be9-305ef849e1d9",
                                                "sense_id": "b01fcfdf-c320-33b4-a523-e6ea865d9176",
                                                "text": "Il a épousé ma sœur, il y a affinité entre lui et moi."
                                            },
                                            {
                                                "example_id": "024505ed-67bd-4042-a3f9-07f07a2e8736",
                                                "sense_id": "b01fcfdf-c320-33b4-a523-e6ea865d9176",
                                                "text": "Les divers degrés de l’affinité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d7943a6-8ed2-3bd4-8c7b-5fa658756449",
                                        "entry_id": "282e46fe-a1f9-304f-b424-ae66d793c28f",
                                        "glosses": [
                                            "Conformité qui existe entre diverses choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddbedbd2-fadf-4bc6-9da7-f105005418d5",
                                                "sense_id": "0d7943a6-8ed2-3bd4-8c7b-5fa658756449",
                                                "text": "L’affinité floristique des Hêtraies à Buis des Cévennes et des Corbières est néanmoins très grande."
                                            },
                                            {
                                                "example_id": "146e5e71-bdd1-4fd8-990a-66189615a6f1",
                                                "sense_id": "0d7943a6-8ed2-3bd4-8c7b-5fa658756449",
                                                "text": "Ces deux mots ont beaucoup d’affinité. — La géométrie et la physique ont une grande affinité."
                                            },
                                            {
                                                "example_id": "f5621ef4-3d8b-4204-b7f8-09366a5925e6",
                                                "sense_id": "0d7943a6-8ed2-3bd4-8c7b-5fa658756449",
                                                "text": "Il y a de l’affinité entre la poésie et la peinture. — Affinité entre les caractères. L’affinité des caractères."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e694ecf-cf1c-338c-a88e-333e39f46215",
                                        "entry_id": "282e46fe-a1f9-304f-b424-ae66d793c28f",
                                        "glosses": [
                                            "Liaison que des personnes ont ensemble, à raison de quelques rapports entre leurs caractères, leurs goûts, leurs opinions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12f6227a-b306-49f4-b5e9-6f34815ccc59",
                                                "sense_id": "8e694ecf-cf1c-338c-a88e-333e39f46215",
                                                "text": "Il y avait une grande affinité entre eux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ad2ea64-4399-3685-8c9c-8647faff70cf",
                                        "entry_id": "282e46fe-a1f9-304f-b424-ae66d793c28f",
                                        "glosses": [
                                            "Tendance des substances de nature différente à s’unir ensemble."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0935fdae-18a2-3182-95dc-288d7a514177",
                                        "entry_id": "282e46fe-a1f9-304f-b424-ae66d793c28f",
                                        "glosses": [
                                            "Transformation d'un objet géométrique qui l’étire ou le contracte uniformément dans une direction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe1f74f4-04e4-4331-a3ba-9cf191200015",
                                                "sense_id": "0935fdae-18a2-3182-95dc-288d7a514177",
                                                "text": "Une ellipse est la transformée par affinité d’un cercle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
