                "senses": [
                    {
                        "sense_id": "4e9ea343-fd0f-3276-bf76-463fd900bc5b",
                        "entry_id": "0c2e87c9-4d64-3bed-bc6e-ad9992f706c5",
                        "glosses": [
                            "erhöhte Konzentration an Calcium im Blut"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "eb884b91-804d-4c6a-bdd5-9ebd83c2f4b0",
                                "sense_id": "4e9ea343-fd0f-3276-bf76-463fd900bc5b",
                                "text": "„Andere Faktoren wie etwa eine Hypothyreose, eine Hypokaliämie oder eine Hypercalciämie können die Toxizität verstärken.“"
                            },
                            {
                                "example_id": "3afd2231-3858-4998-8df9-898bc06c8165",
                                "sense_id": "4e9ea343-fd0f-3276-bf76-463fd900bc5b",
                                "text": "„Vitamin D kann wie alle fettlöslichen Vitamin überdosiert werden, dies würde zu einer massiven Hypercalciämie, Verkalkungen von Nieren und Epipyhsenfuge führen.“"
                            },
                            {
                                "example_id": "1b261123-4fd7-4501-8167-576230dd291a",
                                "sense_id": "4e9ea343-fd0f-3276-bf76-463fd900bc5b",
                                "text": "„Durch einen hohen Calcium-Anteil sollte es nicht bei Hypercalciämie oder Nephrolithiasis gegeben werden.“"
                            },
                            {
                                "example_id": "2f78e5c2-cc11-4de4-b95b-19cfac1a7af0",
                                "sense_id": "4e9ea343-fd0f-3276-bf76-463fd900bc5b",
                                "text": "„Die dadurch vermehrt stattfindende Osteolyse des Knochens führt zur Hypercalciämie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
