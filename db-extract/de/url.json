                        "source_sense_id": "587aeb62-ff64-38f0-8c09-a5b29b95dd7b",
                        "source_sense_description": "Internet, Computer: Uniform Resource Locator (englisch für „einheitlicher Ressourcenanzeiger“)",
                        "target_lang_word": "URL",
                        "target_lang_code": "en",
