                ],
                "senses": [
                    {
                        "sense_id": "db11d676-8e0c-3e86-bfa6-5d818f363e65",
                        "entry_id": "4d82b955-384e-37bc-af6e-34eef43b8e60",
                        "glosses": [
                            "jemand, der Essays verfasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17cda406-fa0a-4226-961a-caa12082e4d1",
                                "sense_id": "db11d676-8e0c-3e86-bfa6-5d818f363e65",
                                "text": "„Über andere, sich aber auch gleichende Erstkontakte berichten drei Essayisten, hier ist die kaufmännische Lehre der entscheidende Rahmen.“"
                            },
                            {
                                "example_id": "420100ce-bebb-4b51-b5ce-b19c2522a615",
                                "sense_id": "db11d676-8e0c-3e86-bfa6-5d818f363e65",
                                "text": "„Denn die offizielle Literaturkritik, junge, berühmte Literaten, die als Essayisten weitgehend darüber entschieden, was und über wen geschrieben wird, fanden Flake deshalb uninteressant, weil sie seine Bücher zugegebenermaßen nicht einmal aufgeschlagen hatten – eine Art Selbstschutz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66f73d36-583d-4dd1-8439-5d3f6887d819",
                        "source_entry_id": "4d82b955-384e-37bc-af6e-34eef43b8e60",
                        "source_sense_id": "db11d676-8e0c-3e86-bfa6-5d818f363e65",
                        "source_sense_description": "jemand, der Essays verfasst",
                        "target_lang_word": "essayist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "essayist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55667421-9d72-330b-b7c7-eeb7c092b3c0",
                                        "entry_id": "246ffe10-c6b4-33b6-8d9b-82b971eebd4f",
                                        "glosses": [
                                            "One who composes essays; a writer of short compositions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1ec4dd0-45a6-4c61-90b8-fe434c9d83b3",
                                                "sense_id": "55667421-9d72-330b-b7c7-eeb7c092b3c0",
                                                "text": "She was an essayist whose frequent contributions to the editorial pages of major newspapers had a loyal following."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1df4790a-54fc-40ee-aba2-55d7aee5b3f2",
                        "source_entry_id": "4d82b955-384e-37bc-af6e-34eef43b8e60",
                        "source_sense_id": "db11d676-8e0c-3e86-bfa6-5d818f363e65",
                        "source_sense_description": "jemand, der Essays verfasst",
                        "target_lang_word": "essayiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "essayiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e259987-f625-3af2-b9de-55a7be028440",
                                        "entry_id": "11d80967-409a-3650-a6dc-2b200a32af24",
                                        "glosses": [
                                            "Auteur, autrice d’essais."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b57d0538-2c7d-4d8a-b76f-3b9fd52399c4",
                                                "sense_id": "6e259987-f625-3af2-b9de-55a7be028440",
                                                "text": "En littérature, le pamphlet a cédé la place à l’essai. L’essayiste sème sa pensée dans les sillons qu’a creusés la mode. Le pamphlétaire laboure à côté. C’est mal vu."
                                            },
                                            {
                                                "example_id": "3e85da47-6716-44fe-ac47-7a97a45f6ae1",
                                                "sense_id": "6e259987-f625-3af2-b9de-55a7be028440",
                                                "text": "Solid semble de ce point de vue reposer en partie sur le « solutionnisme technologique » dénoncé par l’essayiste Evgueny Morozov, qui pousse à croire qu’un Deus Ex Machina pourrait encore nous sauver sans prendre en compte les sur-déterminations économiques de la tendance à la centralisation."
                                            },
                                            {
                                                "example_id": "fa270f95-227a-4813-9043-d8e100bf3e5d",
                                                "sense_id": "6e259987-f625-3af2-b9de-55a7be028440",
                                                "text": "Ce n’est point pour contrebalancer le penchant de notre société à s’ultra-mécaniser qu’elle doit « comprendre » des philosophes, des essayistes, des poètes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
