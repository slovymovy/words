                        "cross_references": [
                            {
                                "target_word": "interviewer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c4268526-5877-35b4-920d-17c70d213f15",
                                        "entry_id": "e54506eb-25c7-3c25-87f8-6fd0d2a6d3a2",
                                        "glosses": [
                                            "Variante orthographique de intervieweur.."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "306a3fec-5e67-4abd-90dc-d17f58180125",
                                                "sense_id": "c4268526-5877-35b4-920d-17c70d213f15",
                                                "text": "Il accueillait volontiers les interviewers, répondait à leurs questions sur tous les sujets autres que l’aéronautique, prodiguait les opinions, les critiques, les détails biographiques, distribuait les portraits et documents iconographiques concernant son individu, et usait de tous les moyens pour projeter sa personnalité sur l’horizon terrestre."
                                            },
                                            {
                                                "example_id": "fed5fde1-3521-4b07-a855-5ee8bab6dc21",
                                                "sense_id": "c4268526-5877-35b4-920d-17c70d213f15",
                                                "text": "M. Filleul qui, décidément, acceptait, avec une bonne foi méritoire, son rôle de subalterne, avait confié aux interviewers les exploits de son jeune conseiller pendant les trois jours mémorables, de sorte que l’on pouvait se livrer aux suppositions les plus téméraires."
                                            },
                                            {
                                                "example_id": "01bdf20f-d050-4ce8-ba7d-85487abc7b61",
                                                "sense_id": "c4268526-5877-35b4-920d-17c70d213f15",
                                                "text": "Soulignons, en conclusion, les conséquences massives de l’induction des attitudes de l’interviewé et donc des obstacles involontairement placés par l’interviewer sur la voie de l’expression et de la compréhension du client."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "interviewer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3b6d2c26-1f3f-3e53-96ff-7dedfee717c0",
                                        "entry_id": "70426c67-e5f5-31f0-932b-873b5bee27b3",
                                        "glosses": [
                                            "Interroger sous la forme de l’interview."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "148d8826-3fe5-4915-8b1c-6588e497d585",
                                                "sense_id": "3b6d2c26-1f3f-3e53-96ff-7dedfee717c0",
                                                "text": "— Tiens, voici l'académisard.\nHenri réprima un mouvement de surprise. Il le connaissait bien celui-là pour l’avoir jadis interviewé sur les conséquences de la guerre."
                                            },
                                            {
                                                "example_id": "48bc74f5-a3b4-4117-9894-5b0f2532ed49",
                                                "sense_id": "3b6d2c26-1f3f-3e53-96ff-7dedfee717c0",
                                                "text": "Un correspondant du Daily Herald voulut interviewer Guimauve sur son système de socialisation des femmes, mais Guimauve se refusa à tout entretien. Il avait avalé sa langue."
                                            },
                                            {
                                                "example_id": "862b364a-f1c8-442a-97ab-79e20226e9f0",
                                                "sense_id": "3b6d2c26-1f3f-3e53-96ff-7dedfee717c0",
                                                "text": "Jérôme Fandor se répétait machinalement les derniers mots des recommandations de son patron : interviewer le baron de Naarboveck, lier connaissance avec une jeune personne du nom de Bobinette, savoir quels étaient les hôtes de l’hôtel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
