                        "glosses": [
                            "Rendre incapable (quelqu’un qui était capable)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f5ab1b7-5e78-4f3c-ba87-33be47da4ea4",
                                "sense_id": "525182c2-d9d8-39c6-816d-919d75a6ee2c",
                                "text": "L’environnement « capabilise », en reprenant les termes de Sen (2004), mais aussi « décapabilise » les personnes selon les cas."
                            },
                            {
                                "example_id": "e037c353-ae0f-4f23-937b-271d7eb8acdd",
                                "sense_id": "525182c2-d9d8-39c6-816d-919d75a6ee2c",
                                "text": "Pour supprimer l’homme qui réussit, obstacle à l’égalité suprême, il faut le décapabiliser."
                            }
                        ]
