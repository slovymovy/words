                ],
                "senses": [
                    {
                        "sense_id": "c3b7a629-5d20-3d4d-a0b3-5b95aaf35820",
                        "entry_id": "0941bfbf-7351-3b85-9208-363ba9183e29",
                        "glosses": [
                            "Bastler, jemand, der gerne Schwieriges herauszufinden versucht durch Herumbasteln, Ausprobieren und Nachdenken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d33b9988-e46b-46fc-9c97-2a5b8b6d15ea",
                                "sense_id": "c3b7a629-5d20-3d4d-a0b3-5b95aaf35820",
                                "text": "„Der flugfähige Modellhubschrauber aus Leichtmetall, maßstabgerecht gebastelt von einem Tüftler, der plötzlich in Kalamitäten geraten ist, zählt zu den ungewöhnlichsten Pfändern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0906861d-14b6-472c-8821-057c0e41c31e",
                        "source_entry_id": "0941bfbf-7351-3b85-9208-363ba9183e29",
                        "source_sense_id": "c3b7a629-5d20-3d4d-a0b3-5b95aaf35820",
                        "source_sense_description": "Bastler, jemand, der gerne Schwieriges herauszufinden versucht durch Herumbasteln, Ausprobieren und Nachdenken",
                        "target_lang_word": "handyman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "handyman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cce9f378-207f-3e57-9ae0-dc1dc2073889",
                                        "entry_id": "823af978-d327-38a9-ae09-a19e873edac5",
                                        "glosses": [
                                            "A person who does small tasks and odd jobs, especially building repairs and the like."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a74268b-384d-465b-a9ca-da0d5165ccf8",
                                                "sense_id": "cce9f378-207f-3e57-9ae0-dc1dc2073889",
                                                "text": "I complained that the heat was not working, and the landlord sent the handyman to fix it."
                                            },
                                            {
                                                "example_id": "62bb315a-0852-4fe8-a61f-b4c79827a8f5",
                                                "sense_id": "cce9f378-207f-3e57-9ae0-dc1dc2073889",
                                                "text": "There was one thing she wanted; she said to hubby dear, / \"The time would pass more quickly if I had a rocking chair.\" / [...] As Strings is such a handyman, by night the job was done / He took that thing upstairs and said, \"Now try this out for fun.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "handyman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eaa3ed77-bf5a-321e-80f8-7008601cba6a",
                                        "entry_id": "f79d5fe6-8e62-39c1-9b62-154543a62267",
                                        "glosses": [
                                            "To work as a handyman; to do odd jobs."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62bd5c7a-341f-4af6-9177-781f77f47b79",
                                                "sense_id": "eaa3ed77-bf5a-321e-80f8-7008601cba6a",
                                                "text": "Instead I walk, uncertainly across the concrete backyard my father and his friends handymanned into existence so proudly, so that none of us would ever have to play in dirt, in muck, in mud again."
                                            },
                                            {
                                                "example_id": "e93b38c7-7273-4d37-9448-0b4a9c3ce33d",
                                                "sense_id": "eaa3ed77-bf5a-321e-80f8-7008601cba6a",
                                                "text": "My daddy worked too hard at Buck's Sporting Goods by day plus handymanning in the evenings, and my mother spent too many hours fixing trays at the meat-and-three for me to act like we had neither pot nor window. Let the record show that we had both."
                                            },
                                            {
                                                "example_id": "cbb43741-319c-474d-9a7d-0bf3b447b634",
                                                "sense_id": "eaa3ed77-bf5a-321e-80f8-7008601cba6a",
                                                "text": "They handymanned all week. And every night Grandad would come in with rosy cheeks and a huge appetite and compliment my mom on what a great cook she was."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6262338b-9fb1-4a9b-b546-0a689ee94437",
                        "source_entry_id": "0941bfbf-7351-3b85-9208-363ba9183e29",
                        "source_sense_id": "c3b7a629-5d20-3d4d-a0b3-5b95aaf35820",
                        "source_sense_description": "Bastler, jemand, der gerne Schwieriges herauszufinden versucht durch Herumbasteln, Ausprobieren und Nachdenken",
                        "target_lang_word": "tinkerer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tinkerer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff1b3f49-0114-3d6d-8b1d-682efe4247e2",
                                        "entry_id": "d6289778-c5e1-31b5-bf54-c977a9f5eb9a",
                                        "glosses": [
                                            "Agent noun of tinker; one who tinkers with things."
                                        ],
                                        "tags": [
                                            "agent",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcfe417f-c004-45a9-bd98-9a488f0bb9c7",
                                                "sense_id": "ff1b3f49-0114-3d6d-8b1d-682efe4247e2",
                                                "text": "Part of why both books dragged on so long is that Mr. Talese, who once worked for The New York Times, is a perfectionist, an obsessive tinkerer and rewriter, and also a famously meticulous reporter and researcher who spurns devices like composite characters and faked identities."
                                            },
                                            {
                                                "example_id": "72533f70-1a41-4b1c-bae1-32bec9ee5316",
                                                "sense_id": "ff1b3f49-0114-3d6d-8b1d-682efe4247e2",
                                                "text": "Make magazine, which celebrates “your right to tweak, hack and bend any technology to your own will,” has joined with the New York Hall of Science to gather more than 500 of the craftiest inventors, artists, technology enthusiasts, tinkerers and hobbyists to share their expertise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b9900cb-862d-3ddd-8e33-7ef5c6e9397b",
                                        "entry_id": "d6289778-c5e1-31b5-bf54-c977a9f5eb9a",
                                        "glosses": [
                                            "A meddler."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c27fd70b-9341-4d70-be8b-80ad541e58ff",
                        "source_entry_id": "0941bfbf-7351-3b85-9208-363ba9183e29",
                        "source_sense_id": "c3b7a629-5d20-3d4d-a0b3-5b95aaf35820",
