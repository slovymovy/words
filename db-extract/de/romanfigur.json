                "senses": [
                    {
                        "sense_id": "49914821-faed-3892-a70e-ae18c8e2cd30",
                        "entry_id": "af3d50ed-2b25-35ea-844d-db05b329e9cf",
                        "glosses": [
                            "(meist fiktive) Person, die ein Schriftsteller in einem seiner Romane auftreten lässt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7de6685a-e1de-45ca-a873-bdc8666eb6ab",
                                "sense_id": "49914821-faed-3892-a70e-ae18c8e2cd30",
                                "text": "„Sie wollte ihm nicht vorwerfen, dass ihm seine Romanfiguren immer nähergestanden hatten als die Menschen, die um ihn waren.“"
                            },
                            {
                                "example_id": "8736c9d4-09d8-48e0-a292-5a1c41a0617b",
                                "sense_id": "49914821-faed-3892-a70e-ae18c8e2cd30",
                                "text": "„Die Standpunkte von Romanfiguren müssen unvereinbar sein, sonst gibt es keine Geschichte.“"
                            },
                            {
                                "example_id": "9d4f1c5f-339f-4d76-900e-f5e9f0b50007",
                                "sense_id": "49914821-faed-3892-a70e-ae18c8e2cd30",
                                "text": "„Für den norwegischen Ingenieur Chrstie war die Romanfigur Signe die schamlose Darstellung einer triebhaften Frau.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
