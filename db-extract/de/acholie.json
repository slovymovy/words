                        "glosses": [
                            "stark verminderte oder ganz aufgehobene Gallensekretion"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16890cf2-ef0a-4865-849b-6bf561dc1507",
                                "sense_id": "da48738d-0c83-35ec-bda7-b45c4860f788",
