                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0688f0cb-f6aa-3778-bf7d-1453b61d4ad3",
                        "entry_id": "dcfe70b3-e06d-3357-beeb-d36e568de288",
                        "glosses": [
                            "Langue parlée dans la ville et dans la région de Tlemcen, dans le nord-ouest de l'Algérie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a17d0893-dda5-496c-b12d-94ff17fe3c1c",
                                "sense_id": "0688f0cb-f6aa-3778-bf7d-1453b61d4ad3",
                                "text": "Le tlemcénien est au reste, avec le nédroméen, le seul dialecte oranais, qui offre les particularités des dialectes citadins. Dans les toutes les autres villes de l'Oranie, si bizarre que puisse paraître la chose, on parle des dialectes bédouins."
                            },
                            {
                                "example_id": "b373a522-948a-4aea-9588-07e70bf6dbd2",
                                "sense_id": "0688f0cb-f6aa-3778-bf7d-1453b61d4ad3",
                                "text": "Tlemcénien et nédromi présentent beaucoup de caractéristiques communes, qui permettent aux autres Algériens de les identifier immédiatement."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
