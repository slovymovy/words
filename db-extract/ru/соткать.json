                        "target_lang_word": "tisser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tisser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e588ef87-212b-3296-a246-538916fb3cd4",
                                        "entry_id": "d5bc1779-7822-34e1-bfb1-629319ae8032",
                                        "glosses": [
                                            "Faire de la toile ou d’autres étoffes en croisant ou entrelaçant sur un métier les fils dont elles doivent être composées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22559904-517a-44f0-b765-6bd12e13d896",
                                                "sense_id": "e588ef87-212b-3296-a246-538916fb3cd4",
                                                "text": "Les femmes, qui sont de taille moyenne et plutôt trapues, portent une robe en vadmel, sorte de flanelle tissée avec la laine qu'elles-mêmes ont cardée et filée."
                                            },
                                            {
                                                "example_id": "224cb6cd-361d-452d-8cfc-27daf07467f5",
                                                "sense_id": "e588ef87-212b-3296-a246-538916fb3cd4",
                                                "text": "Cette industrie du drap est en effet l'une des plus complexes, et le nombre des opérations nécessaires pour transformer la laine brute en produit fini est très élevé. Il fallait trier la laine, la teindre, la mélanger, la carder, la filer, la tisser, dégraisser le tissu, le fouler, le lainer, le tondre, l'épinceter, et enfin lui donner de l'éclat en le pressant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de169d0d-4d8b-34e3-863d-d1b1c011c228",
                                        "entry_id": "d5bc1779-7822-34e1-bfb1-629319ae8032",
                                        "glosses": [
                                            "Former un réseau, un voile dans un espace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7825088d-0e54-46cb-a0ec-37414a57f305",
                                                "sense_id": "de169d0d-4d8b-34e3-863d-d1b1c011c228",
                                                "text": "Pourtant cette blancheur qui se tissait dans le crépuscule lui causa un grand malaise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0b2af32-a71f-34a9-8829-155f208fe930",
                                        "entry_id": "d5bc1779-7822-34e1-bfb1-629319ae8032",
                                        "glosses": [
                                            "Établir, créer des liens, des relations entre des personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d90a8608-3250-4cae-9511-28870cfb178e",
                                                "sense_id": "f0b2af32-a71f-34a9-8829-155f208fe930",
                                                "text": "Tisser des liens amicaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4ebf351-dd23-3aad-9254-0391794c6390",
                                        "entry_id": "d5bc1779-7822-34e1-bfb1-629319ae8032",
                                        "glosses": [
                                            "Fabriquer, élaborer comme un tissu."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61bd5c88-3cc3-44c9-bb52-52fe649aa3b0",
                                                "sense_id": "a4ebf351-dd23-3aad-9254-0391794c6390",
                                                "text": "Il y aurait vraiment un livre à tisser avec la vie de cette admirable femme, ruminait Durtal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
