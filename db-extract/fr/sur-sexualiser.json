                "senses": [
                    {
                        "sense_id": "7c2848f0-bfae-31da-8480-abfb31c4655d",
                        "entry_id": "a3983cad-6d10-3afa-9960-026539aec34d",
                        "glosses": [
                            "Sexualiser de façon excessive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea9df432-1ec1-473f-8896-9256e54933a9",
                                "sense_id": "7c2848f0-bfae-31da-8480-abfb31c4655d",
                                "text": "L’auteur remarque ainsi que les enfants peuvent percevoir le conflit parental comme un conflit sexuel et sur-sexualiser les représentations graphiques de la famille."
                            },
                            {
                                "example_id": "772edce5-1bcf-434c-848d-cd965287cc86",
                                "sense_id": "7c2848f0-bfae-31da-8480-abfb31c4655d",
                                "text": "Et, inversement, les connaissances issues de la clinique sont organisées - viennent se grossir et se sur-sexualiser pour ainsi dire - par les réalités prototypiques et trans-historiques de la « horde primitive »."
                            }
                        ]
                    }
