{
    "word_family": [
        "scowl"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e0b71a22-27ca-3fe0-9028-d90ec2c5515f",
                    "sense_definition": "Present participle and gerund of <w>scowl</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "facial_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>scowling</w> at the screen because the computer kept crashing.",
                            "target_lang_translations": {
                                "zh": "他正对着屏幕<w>皱着眉</w>，因为电脑一直在死机。"
                            }
                        },
                        {
                            "text": "The <w>scowling</w> man looked very angry as he walked past the shop.",
                            "target_lang_translations": {
                                "zh": "那个<w>板着脸</w>的男人走过商店时看起来非常生气。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "scowling at someone",
                        "scowling face"
                    ],
                    "target_lang_definitions": {
                        "zh": "指因愤怒或不满而皱眉、板着脸。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "皱眉",
                                "target_lang_sense_clarification": "指眉头紧锁，通常表示不悦或担忧。"
                            },
                            {
                                "target_lang_word": "板着脸",
                                "target_lang_sense_clarification": "指面部表情严肃、冷漠或愤怒。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "91d3b0fe-104f-3114-8d0d-34494dc616ea",
                    "sense_definition": "The act of making a facial expression of anger or disapproval.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "facial_expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her constant <w>scowling</w> made everyone in the room feel uncomfortable.",
                            "target_lang_translations": {
                                "zh": "她总是<w>板着脸</w>，让房间里的每个人都感到不自在。"
                            }
                        },
                        {
                            "text": "He ignored the <w>scowling</w> from his boss and continued his work.",
                            "target_lang_translations": {
                                "zh": "他无视了老板的<w>怒容</w>，继续做他的工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "frown"
                    ],
                    "antonyms": [
                        "smile"
                    ],
                    "common_phrases": [
                        "dark scowling"
                    ],
                    "target_lang_definitions": {
                        "zh": "指表现出愤怒或不满的皱眉表情。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "怒容",
                                "target_lang_sense_clarification": "指愤怒的表情。"
                            },
                            {
                                "target_lang_word": "皱眉",
                                "target_lang_sense_clarification": "指皱眉的动作或表情。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}