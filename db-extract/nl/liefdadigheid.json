                        "target_lang_word": "Wohltätigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wohltätigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "567700ab-8f19-333c-b888-99824f030878",
                                        "entry_id": "da97ac13-4885-3726-aff6-e021aead38f3",
                                        "glosses": [
                                            "Wille, Bereitschaft, bedürftige Menschen zu unterstützen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19acc0d3-d7f7-43c9-bd5a-b9b452998c04",
                                                "sense_id": "567700ab-8f19-333c-b888-99824f030878",
                                                "text": "„Obendrein zeigt sich die Wohltätigkeit des Bayernherzogs am Vortag von Mariä Himmelfahrt, als er zweihundert Gulden unter den Armen der Stadt Linz und unter bedürftige Soldaten verteilen lässt.“"
                                            },
                                            {
                                                "example_id": "b6b3498a-fdd4-404a-a476-b123590f1bab",
                                                "sense_id": "567700ab-8f19-333c-b888-99824f030878",
                                                "text": "„Zeitgenössische Quellen erwähnen lobend die Wohltätigkeit der Kartäuser gegenüber Armen und Kranken sowie die harte Arbeit der Mönche beim Terrassieren des Kartausengeländes und der Weinberge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "beb78155-0238-394f-b0af-666d18794151",
                                        "entry_id": "da97ac13-4885-3726-aff6-e021aead38f3",
                                        "glosses": [
                                            "Handlung, bei der [1] zum Ausdruck kommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27342496-3257-4120-ab3d-e2db167b77ff",
                                                "sense_id": "beb78155-0238-394f-b0af-666d18794151",
                                                "text": "„Für seine Wohltätigkeiten wird Louis Peter 1902 von der Gemeinde Alleringhausen zum Ehrenbürger ernannt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6dd71f89-6736-4b9e-8853-ecdbcf100389",
                        "source_entry_id": "34e25ad8-386f-351b-8b74-3fe0ef54d7d0",
                        "source_sense_id": "8e69ca3f-e3d6-3ed0-ac95-21d5725c1496",
                        "source_sense_description": "het geven van hulp",
                        "target_lang_word": "charity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "charity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "998ea387-131a-3870-8c5a-11bc7151238d",
                                        "entry_id": "044438d7-24a7-378c-8933-4291155949de",
                                        "glosses": [
                                            "An organization, the objective of which is to carry out a charitable purpose."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c5ccefa-a475-470c-b7b5-8dd67ca42b9d",
                                                "sense_id": "998ea387-131a-3870-8c5a-11bc7151238d",
                                                "text": "‘[…] I remember a lady coming to inspect St. Mary's Home where I was brought up and seeing us all in our lovely Elizabethan uniforms we were so proud of, and bursting into tears all over us because “it was wicked to dress us like charity children”.[…]’."
                                            },
                                            {
                                                "example_id": "aeda157c-09b7-4541-9cea-77597fc9f0d7",
                                                "sense_id": "998ea387-131a-3870-8c5a-11bc7151238d",
                                                "text": "The event raised money for local charities."
                                            },
                                            {
                                                "example_id": "50803e8c-aaf0-4468-8310-8a4d2930a2d0",
                                                "sense_id": "998ea387-131a-3870-8c5a-11bc7151238d",
                                                "text": "He donated half his earnings to charity."
                                            },
                                            {
                                                "example_id": "c8d9f69c-b9df-4e85-904d-5976c7a225aa",
                                                "sense_id": "998ea387-131a-3870-8c5a-11bc7151238d",
                                                "text": "give to charity"
                                            },
                                            {
                                                "example_id": "bf1fa6d2-8964-4bc7-b6ea-83b430aeab71",
                                                "sense_id": "998ea387-131a-3870-8c5a-11bc7151238d",
                                                "text": "registered charity"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8709b991-44cd-32c3-b8a5-d3a7ea856996",
                                        "entry_id": "044438d7-24a7-378c-8933-4291155949de",
                                        "glosses": [
                                            "The goods or money given to those in need."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f9829f82-a540-3bb9-b183-134ba78bc40d",
                                        "entry_id": "044438d7-24a7-378c-8933-4291155949de",
                                        "glosses": [
                                            "Benevolence to others less fortunate than ourselves; the providing of goods or money to those in need."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bf5942e-6beb-4ed5-b760-cf7396d67b1b",
                                                "sense_id": "f9829f82-a540-3bb9-b183-134ba78bc40d",
                                                "text": "act of charity"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9dc036e7-69d7-35f7-9497-9f376a1828c1",
                                        "entry_id": "044438d7-24a7-378c-8933-4291155949de",
                                        "glosses": [
                                            "In general, an attitude of kindness and understanding towards others, now especially suggesting generosity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f8816b4-70e7-43a8-9beb-0b75b2e187e1",
                                                "sense_id": "9dc036e7-69d7-35f7-9497-9f376a1828c1",
                                                "text": "July 20, 1677, John Mitchell Mason, letter to a friend\nJudge thyself with the judgment of sincerity, and thou witl judge others with the judgment of charity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e07ab4b-3777-3e48-af6f-a56f4ca6a231",
                                        "entry_id": "044438d7-24a7-378c-8933-4291155949de",
                                        "glosses": [
                                            "Christian love; representing God's love of man, man's love of God, or man's love of his fellow-men."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "144e0bd8-87d7-4c72-bc89-02b4fe30b991",
                                                "sense_id": "2e07ab4b-3777-3e48-af6f-a56f4ca6a231",
                                                "text": "Charity suffereth long, and is kind; charity envieth not; charity vaunteth not itself, is not puffed up, Doth not behave itself unseemly, seeketh not her own, is not easily provoked, thinketh no evil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d762dd50-7fbf-3d32-ae2c-4072936cbac8",
                                        "entry_id": "044438d7-24a7-378c-8933-4291155949de",
                                        "glosses": [
                                            "A free throw."
                                        ],
                                        "tags": [
                                            "Philippines",
                                            "US",
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4696a19b-8854-496c-ba7a-941598fc9266",
                        "source_entry_id": "34e25ad8-386f-351b-8b74-3fe0ef54d7d0",
                        "source_sense_id": "8e69ca3f-e3d6-3ed0-ac95-21d5725c1496",
                        "source_sense_description": "het geven van hulp",
                        "target_lang_word": "charité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "charité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "22a7a54f-f774-3edc-a9f2-68f5025e5e4a",
                                        "entry_id": "05efa30f-ff37-320b-9ed8-23d78c8cc640",
                                        "glosses": [
                                            "Vertu théologale, amour que l’on ressent pour Dieu, pour le bien et pour son prochain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d61bcb3-bd9e-4a42-a235-abf91b53f847",
                                                "sense_id": "22a7a54f-f774-3edc-a9f2-68f5025e5e4a",
                                                "text": "Pour une fille des champs qui dans sa jeunesse n’avait récolté que de mauvais traitements, pour une pauvresse recueillie par charité, le rire équivoque du père Grandet était un vrai rayon de soleil."
                                            },
                                            {
                                                "example_id": "4b6c489b-8fde-4543-9515-0ccbdde6c022",
                                                "sense_id": "22a7a54f-f774-3edc-a9f2-68f5025e5e4a",
                                                "text": "Tout cela n’empêche pas, mon ami, qu’il n’y ait sur cette terre de fort braves gens, des gens foncièrement honnêtes, organiquement bons, faisant le bien pour la satisfaction intime qu’ils en retirent: ne volant pas et n’assassinant pas, lors même qu’ils seraient sûrs de l’impunité, parce qu’ils ont une conscience qui est un contrôle perpétuel des actes auxquels leurs passions pourraient les pousser; des gens capables d’aimer, de se dévouer corps et âme, des prêtres croyant en Dieu et pratiquant la charité chrétienne, des médecins bravant les épidémies pour sauver quelques pauvres malades, des sœurs de charité allant au milieu des armées soigner de pauvres blessés."
                                            },
                                            {
                                                "example_id": "2e512ae0-6f9d-4ea1-80c9-dd73586b42af",
                                                "sense_id": "22a7a54f-f774-3edc-a9f2-68f5025e5e4a",
                                                "text": "— La charité ! la charité ! c’est la certitude de son néant et de son inévitable banqueroute qui a fini de tuer le prêtre en moi…"
                                            },
                                            {
                                                "example_id": "c2401885-97b8-447d-b0ee-b9f1d126b987",
                                                "sense_id": "22a7a54f-f774-3edc-a9f2-68f5025e5e4a",
                                                "text": "La charité est une vertu que les éloges mortuaires prêtent sans exception à tous les défunts, ce qui est déjà suspect."
                                            },
                                            {
                                                "example_id": "81d88cb2-18a8-4a0a-9a48-036e07ef89e0",
                                                "sense_id": "22a7a54f-f774-3edc-a9f2-68f5025e5e4a",
                                                "text": "Darlan a été descendu et Pucheu exécuté, c'est bien fait pour leur poire ! s’écria Micheline, toute charité chrétienne envolée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba7cb67b-5b36-3347-a8de-43a8c6ae91c4",
                                        "entry_id": "05efa30f-ff37-320b-9ed8-23d78c8cc640",
                                        "glosses": [
                                            "Bienveillance habituelle ; indulgence ; commisération."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c30b485-9486-4509-84c2-0af15c0db28b",
                                                "sense_id": "ba7cb67b-5b36-3347-a8de-43a8c6ae91c4",
                                                "text": "Cette sollicitude ne la surprenait guère : Alice avait toujours eu cette espèce de charité très chrétienne, qui attendait que l’on fût au fond du trou pour vous tendre la main."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14bbe532-3074-3135-825e-815d769f8a1f",
                                        "entry_id": "05efa30f-ff37-320b-9ed8-23d78c8cc640",
                                        "glosses": [
                                            "Bienfaisance ; aumône aux pauvres."
                                        ],
                                        "tags": [],
                                        "note": "Dans ce sens, pouvait autrefois s’employer au pluriel",
                                        "examples": [
                                            {
                                                "example_id": "7ac8951a-587f-48ec-8ff0-3f1d30fbbd5e",
                                                "sense_id": "14bbe532-3074-3135-825e-815d769f8a1f",
                                                "text": "Les catholiques sociaux […] veulent améliorer le sort des pauvres, non seulement par la charité, mais par une foule d’institutions propres à atténuer les douleurs causées par l’économie capitaliste."
                                            },
                                            {
                                                "example_id": "7d86dbc4-e375-4b2d-b578-9c464a937222",
                                                "sense_id": "14bbe532-3074-3135-825e-815d769f8a1f",
                                                "text": "Je prétends que la vraie charité doit être couillue, pas pleurnicharde, ni dégoulinante de bonté. Quand les gens éclatent en sanglots c’est souvent parce qu’ils ne peuvent pas te dire que tu les fais chier."
                                            },
                                            {
                                                "example_id": "23985b03-48d7-4897-910d-38c60405c487",
                                                "sense_id": "14bbe532-3074-3135-825e-815d769f8a1f",
                                                "text": "Il se recommande aux charités des personnes généreuses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08d79e6d-c45f-34f0-84e5-53d1d4f6ed68",
                                        "entry_id": "05efa30f-ff37-320b-9ed8-23d78c8cc640",
                                        "glosses": [
                                            "Groupe de personnes pieuses se dévouant pour secourir les pauvres."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "945139df-dad4-38d7-87d0-d45ce204a57c",
                                        "entry_id": "05efa30f-ff37-320b-9ed8-23d78c8cc640",
                                        "glosses": [
                                            "Hospice où étaient accueillis les pauvres."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88df4249-f15a-4d44-8714-064624722b53",
                                                "sense_id": "945139df-dad4-38d7-87d0-d45ce204a57c",
                                                "text": "C’est l’hôpital qui se moque de la charité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84530fe6-1873-4ef3-bd9b-a6b0d6626040",
                        "source_entry_id": "34e25ad8-386f-351b-8b74-3fe0ef54d7d0",
                        "source_sense_id": "8e69ca3f-e3d6-3ed0-ac95-21d5725c1496",
                        "source_sense_description": "het geven van hulp",
                        "target_lang_word": "bienfaisance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bienfaisance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "83e86c79-8d7e-316f-85de-1c26bfb8744c",
                                        "entry_id": "d38fca61-252a-3a8d-8fcc-69d9df19038e",
                                        "glosses": [
                                            "Inclination à faire du bien aux autres, pratique des bienfaits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1541b8a7-5cc9-46dc-a26b-93577d1dd8fe",
                                                "sense_id": "83e86c79-8d7e-316f-85de-1c26bfb8744c",
                                                "text": "La bienfaisance fut sa plus belle vertu. Acte de bienfaisance. Une bienfaisance éclairée, active. Il n’eut point à se repentir de sa bienfaisance envers eux."
                                            },
                                            {
                                                "example_id": "76d7bdaf-275a-4470-b8bd-176ec3e9adb6",
                                                "sense_id": "83e86c79-8d7e-316f-85de-1c26bfb8744c",
                                                "text": "Le riche, quand il s'associe à une œuvre de bienfaisance, ne donne souvent que son superflu. Le pauvre donne ce dont il a lui-même besoin, et ne craint pas de souffrir pour apaiser une souffrance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4db7d6fd-e9d5-3ed3-a6aa-5f3dd847db93",
                                        "entry_id": "d38fca61-252a-3a8d-8fcc-69d9df19038e",
                                        "glosses": [
                                            "Bien que l’on fait dans un intérêt social."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1931077-c06e-4e95-ba3f-4232c4a76f9b",
                                                "sense_id": "4db7d6fd-e9d5-3ed3-a6aa-5f3dd847db93",
                                                "text": "Bureau de bienfaisance."
                                            },
                                            {
                                                "example_id": "9ab054f4-2379-4116-a240-0b5ae8f496a2",
                                                "sense_id": "4db7d6fd-e9d5-3ed3-a6aa-5f3dd847db93",
                                                "text": "Président de la Société de Bienfaisance, il prend sa tâche très à cœur, mais l’absence complète de charité et de solidarité l’effare."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
