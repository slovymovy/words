                "senses": [
                    {
                        "sense_id": "ce4d0cf5-5050-3cd3-961c-d8a9102ee7a6",
                        "entry_id": "9f9afe80-e24b-3244-afc9-a48a98ef3ee3",
                        "glosses": [
                            "Gotteshaus zu Ehren von Christophorus, das für Gottesdienste genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58549e80-c795-4245-b03f-e426877e3e8f",
                                "sense_id": "ce4d0cf5-5050-3cd3-961c-d8a9102ee7a6",
                                "text": "„Die Christophoruskirche ist eine römisch-katholische Kirche in der Schweizer Stadt Basel.“"
                            },
                            {
                                "example_id": "3fec8b5e-5743-45db-bd6f-252a9eb2c219",
                                "sense_id": "ce4d0cf5-5050-3cd3-961c-d8a9102ee7a6",
                                "text": "„Bis 1955 war sie im Besitz der Schwesternschaft, dann ging sie in den Besitz der evangelischen Kirche über und wurde in Christophoruskirche umbenannt.“"
                            },
                            {
                                "example_id": "07c36a70-49d2-4b35-a374-1bc0b02afab6",
                                "sense_id": "ce4d0cf5-5050-3cd3-961c-d8a9102ee7a6",
                                "text": "„Welche Bedeutung das Patronat des Verkehrs, besonders an Flußübergängen, in der Neuzeit hat, zeigen die Christophoruskirchen in Kleinhüningen am Rheinhafen (BS 21) und Wangen a.d. A. (BE35), dem alten Aare-Übergang.“"
                            },
                            {
                                "example_id": "03aaddb7-d527-4611-bb42-823712dd16a9",
                                "sense_id": "ce4d0cf5-5050-3cd3-961c-d8a9102ee7a6",
                                "text": "„Am Talschluß erwarten den Besucher 2 Christophoruskirchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
