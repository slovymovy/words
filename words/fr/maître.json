                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "enseignement et expertise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pasteur gardait une grande admiration pour son <w>maître</w> du collège."
                        },
                        {
                            "text": "Un bon <w>maître</w> aide chaque élève à découvrir ses talents."
