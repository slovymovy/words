                "senses": [
                    {
                        "sense_id": "b96da1f6-c27f-38b2-961f-792138f71d8b",
                        "entry_id": "3b3cdf3b-4ba9-3ba7-8d75-e600a85b6216",
                        "glosses": [
                            "etwas, das hinterherkommt; eine Zeit der Bearbeitung und Auswertung"
                        ],
                        "tags": [
                            "auch"
                        ],
                        "examples": [
                            {
                                "example_id": "81cceaca-415a-4623-93c1-8a4cd666b187",
                                "sense_id": "b96da1f6-c27f-38b2-961f-792138f71d8b",
                                "text": "„Der Nachklapp gibt dem Vorherigen insgesamt eine letzte, knappe dramaturgische Drehung. Diese Drehung kann die vorherigen filmischen Aussagen leichter werden lassen oder bitterer und schärfer.“"
                            },
                            {
                                "example_id": "137f4820-aef6-4f42-8014-52c62318074e",
                                "sense_id": "b96da1f6-c27f-38b2-961f-792138f71d8b",
                                "text": "»Das Wunder« lautet der Titel des soeben erschienenen Nachklapps zur Trilogie."
                            },
                            {
                                "example_id": "09a708bc-277e-48c8-bfea-097570c5a89d",
                                "sense_id": "b96da1f6-c27f-38b2-961f-792138f71d8b",
                                "text": "Es gab im Nachklapp noch einige Leserbriefstimmen, die fehlende Objektivität monierten."
                            },
                            {
                                "example_id": "a51a217d-4a55-47f2-972a-c9060d649021",
                                "sense_id": "b96da1f6-c27f-38b2-961f-792138f71d8b",
                                "text": "Das alles sind Fragen, die nicht allein im Nachklapp interessant sind, sondern gerade auch im Vorfeld eine besondere Rolle spielen sollten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
