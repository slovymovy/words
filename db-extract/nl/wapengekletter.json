                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9792c9f4-f87f-4ac1-b7ba-ab32a49dfb57",
                                "sense_id": "96597b5c-ba78-3f34-ab0c-c4c7219bde51",
                                "text": "Wapengekletter, briesende paarden, schreeuwende soldaten. Vestingstadje Groenlo staat aan de vooravond van een historische veldslag: de verovering op de Spanjaarden in 1627 wordt vanaf vandaag nog eens overgedaan."
                            }
                        ]
                    },
                    {
                        "sense_id": "3fa2e8c0-7b00-3f6f-abb3-fff4b2209249",
                        "entry_id": "e0d47378-ffbe-3d2d-a131-51c0f43325cb",
                        "glosses": [
                            "heel duidelijk maken dat je goed voorbereid bent om de strijd aan te gaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02669ca1-dd01-4208-a21c-716debd3eebc",
                                "sense_id": "3fa2e8c0-7b00-3f6f-abb3-fff4b2209249",
                                "text": "Amerika-specialist Philip Marey van de Rabobank constateerde dat de stemming op de beurzen nog steeds positief beïnvloed wordt door de afzwakking van orkaan Irma en het uitblijven van nieuw wapengekletter in Noord-Korea."
                            }
                        ]
                    }
