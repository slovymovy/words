                        "cross_references": [
                            {
                                "target_word": "hibou grand-duc",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6720710c-2bd0-3b93-967b-ecad40a2263b",
                                        "entry_id": "6e412480-5b4f-37ed-b939-c516c84901e2",
                                        "glosses": [
                                            "Espèce d'oiseau rapace nocturne d'Eurasie et Afrique du Nord, grand hibou aux deux gros yeux rouge-orangé et aux grandes aigrettes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ace01848-60c0-4e0c-8b7e-b5d8230cf4fd",
                                                "sense_id": "6720710c-2bd0-3b93-967b-ecad40a2263b",
                                                "text": "Avec sa taille imposante, le hibou grand-duc ou grand-duc d'Europe (Bubo bubo) ne peut être confondu avec aucun autre."
                                            },
                                            {
                                                "example_id": "5489a8c7-d125-4693-9575-71dc0e57684d",
                                                "sense_id": "6720710c-2bd0-3b93-967b-ecad40a2263b",
                                                "text": "Ce jeudi matin à Valence, un hibou grand-duc s'est écrasé contre le bâtiment de la radio France Bleu Drôme Ardèche, poursuivi par une nuée de corvidés en pleine ville."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7db54ef-7a9d-45fe-8c49-2065b376c4be",
                        "source_entry_id": "0b046ea1-3e15-3c81-9c68-265f3294366a",
                        "source_sense_id": "b7f1a91a-2812-388a-afce-1eff6aad2935",
                        "target_lang_word": "hibou d'Europe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6e90252b-c544-477c-afd0-bb7f57bc46da",
                        "source_entry_id": "0b046ea1-3e15-3c81-9c68-265f3294366a",
                        "source_sense_id": "b7f1a91a-2812-388a-afce-1eff6aad2935",
                        "target_lang_word": "grand-duc",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grand-duc",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d4e8aca-33ee-3b6e-8702-46285c51e38c",
                                        "entry_id": "a7d29918-64b9-39f7-ae36-f4505682804b",
                                        "glosses": [
                                            "Titre de noblesse qui se situe entre le duc et le roi, porté par le souverain d’un grand-duché."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34b3f1c3-b169-4a78-a382-5914af513b31",
                                                "sense_id": "9d4e8aca-33ee-3b6e-8702-46285c51e38c",
                                                "text": "Tom et Sarah avaient été particulièrement recommandés au grand-duc régnant de Gerolstein par le vieux marquis d’Harville."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2690d905-3c8f-381a-b159-316ed45f9f23",
                                        "entry_id": "a7d29918-64b9-39f7-ae36-f4505682804b",
                                        "glosses": [
                                            "Titre de noblesse russe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee4792fa-fa61-4750-bc10-44c395a33052",
                                                "sense_id": "2690d905-3c8f-381a-b159-316ed45f9f23",
                                                "text": "Mais fidèle à ses promesses, le césaréwitch assura, d'abord à son frère cadet, le grand-duc Michel, qui était à Varsovie, puis à tout son entourage que ce n'était pas lui, mais bien à son frère Nicolas à monter sur le trône de Russie et montra à tous les documents se rapportant à sa résignation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f21a02e8-f7d5-3509-8d5b-193325e27b56",
                                        "entry_id": "a7d29918-64b9-39f7-ae36-f4505682804b",
                                        "glosses": [
                                            "Genre de rapace nocturne (Bubo) de la famille des strigidés comprenant entre 18 et 26 espèces existantes (selon l'inclusion ou non d'autres genres) caractérisées par leur grande taille, leur plumage cryptique et, dans la majorité des cas, la présence de deux aigrettes allongées en formes d'\\\"oreilles\\\", de distribution quasi cosmopolite (à l'exception du continent antarctique)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3ddafb1b-c5ad-3aee-b570-7c5e9576eda6",
                                        "entry_id": "a7d29918-64b9-39f7-ae36-f4505682804b",
                                        "glosses": [
                                            "Lorsqu'employé seul, sans complément spécifique, nom qui réfère habituellement soit au grand-duc d'Europe (Bubo bubo) ou au grand-duc d'Amérique (B. virginianus), selon le contexte."
                                        ],
                                        "tags": [
                                            "generically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34be9005-b799-49c5-805b-b4692ec5a246",
                                                "sense_id": "3ddafb1b-c5ad-3aee-b570-7c5e9576eda6",
                                                "text": "Il était presque blanc, gigantesque : le plus grand nocturne que j’aie vu, un grand-duc plus haut qu’un chien de chasse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
