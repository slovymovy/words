                ],
                "senses": [
                    {
                        "sense_id": "a6d17459-2123-3ff6-96d5-cfea8e450a97",
                        "entry_id": "64b4d4c0-02e8-37d9-81bd-752f802c4bfa",
                        "glosses": [
                            "wissenschaftliche Disziplin, die sich um die Verbesserung des Muttersprachunterrichts bemüht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82067c99-95b4-47f9-a147-2552c3a5918f",
                                "sense_id": "a6d17459-2123-3ff6-96d5-cfea8e450a97",
                                "text": "„Die Sprachdidaktik, insbesondere die Muttersprachdidaktik, muss diesen Paradigmenwechsel der Linguistik erst noch nachvollziehen.“"
                            },
                            {
                                "example_id": "98b5d73b-a590-4d21-9db1-bc1e5f57862c",
                                "sense_id": "a6d17459-2123-3ff6-96d5-cfea8e450a97",
                                "text": "„Das Handbuch behandelt nur die Muttersprachdidaktik sowie spezifische didaktische Probleme beim Zweitsprachlernen; insbesondere ist die Didaktik des Deutschen als Fremdsprache nicht Gegenstand des Handbuchs.“"
                            },
                            {
                                "example_id": "362f1069-8218-45aa-8b79-4672d379997b",
                                "sense_id": "a6d17459-2123-3ff6-96d5-cfea8e450a97",
                                "text": "„Der Beitrag beleuchtet die verschiedenen Etappen im Aufbau der Muttersprachdidaktik und erinnert an die gesellschaftlichen Anforderungen, die am Anfang erfüllt werden mussten.“"
                            },
                            {
                                "example_id": "af7fb78b-022b-420a-a063-1ef5725cb6f7",
                                "sense_id": "a6d17459-2123-3ff6-96d5-cfea8e450a97",
                                "text": "„Die Einführung stellt zentrale Grundeinheiten und Arbeitsbegriffe der Muttersprachdidaktik - Lehre vom Lehren und Lernen im Deutschunterricht und in Deutschkursen der Erwachsenenbildung - vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
