                        "source_entry_id": "bac3d91c-d405-3b0f-9d44-7e7fd1f43a11",
                        "source_sense_id": "6bd41583-9114-3c6c-b0ee-27cdd37caa9b",
                        "target_lang_word": "grippeähnlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grippeähnlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8c4bd1ea-dd57-37f9-94ca-363a9674040c",
                                        "entry_id": "5e87f545-276a-347f-a3d6-290281a97b81",
                                        "glosses": [
                                            "in seinen Symptomen so oder so ähnlich, wie bei einer Erkrankung an der Infektionskrankheit Grippe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11adde59-e028-4a67-960d-ca8b464fdbad",
                                                "sense_id": "8c4bd1ea-dd57-37f9-94ca-363a9674040c",
                                                "text": "„Man kann den Virus, wenn er vorhanden ist, im Blut nachweisen. Aber man würde jetzt nicht unbedingt bei jeder Infektwelle den Hantavirus suchen, weil die Symptome sehr grippeähnlich sind: Fieber, Kopfschmerzen, Unwohlsein und Abgeschlagenheit.“"
                                            },
                                            {
                                                "example_id": "10dc115a-076e-4eca-9cb4-9cfd8f427391",
                                                "sense_id": "8c4bd1ea-dd57-37f9-94ca-363a9674040c",
                                                "text": "Sie soll Symptome gezeigt haben, die grippeähnlich waren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
