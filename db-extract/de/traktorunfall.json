                            {
                                "example_id": "49700814-00bf-4489-b5cb-b3d12e407e62",
                                "sense_id": "24415a3c-440a-3742-9f83-e6e59d1b5d90",
                                "text": "„Bei einem schweren Traktorunfall im Allgäu in Bayern sind am Samstagabend zwei Kinder aus Vorarlberg ums Leben gekommen.“"
                            },
                            {
                                "example_id": "de2edede-5b79-4569-b9ff-b51384fdc997",
                                "sense_id": "24415a3c-440a-3742-9f83-e6e59d1b5d90",
                                "text": "„Das Unglück hat das Oberallgäu im vergangenen Juli erschüttert, als ein zehnjähriger Bub und ein 13-jähriges Mädchen bei einem Traktorunfall starben.“"
                            }
                        ],
