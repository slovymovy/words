                        "glosses": [
                            "In a doubtful manner, in context of doubt or ambiguity, questionably."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb24fa1c-d161-4205-95e9-922f9a6a5a4b",
                                "sense_id": "1fbe4048-d20e-32ef-ab7d-ed5a94b62c64",
                                "text": "He looked at the mauve envelope doubtfully, and examined the postmark. \"Where is Pudlington, James? and one might almost ask—why is Pudlington? No town has any right to such an offensive name.\""
                            }
                        ]
                    }
                ],
                "translations": [
