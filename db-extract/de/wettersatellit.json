                "senses": [
                    {
                        "sense_id": "222c1d51-465e-39af-b362-d524bd6b09f2",
                        "entry_id": "d8bda579-1ae0-3c4e-8439-55a23554bf14",
                        "glosses": [
                            "Satellit, der für die Beobachtung meteorologischer Vorgänge verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f608c9fa-f22e-4937-a5e7-8a4af76bd06b",
                                "sense_id": "222c1d51-465e-39af-b362-d524bd6b09f2",
                                "text": "„Heute hat das abbildende Radiometer SEVIRI (Spinning Enhanced Visible and Infrared Imager) an Bord von Europas neuem geostationären Wettersatelliten MSG-3 das erste Bild der Erde eingefangen.“"
                            },
                            {
                                "example_id": "8ecec446-4816-4729-93ec-b9f25d5f023a",
                                "sense_id": "222c1d51-465e-39af-b362-d524bd6b09f2",
                                "text": "„In Ergänzung zu erdgebundenen Beobachtungssystemen und Wetterballonen werden zur Erforschung der mittelfristigen Wetterentwicklung und langfristigen Klimaveränderung seit den späten 1970er Jahren bereits Wettersatelliten der Meteosat-Familie eingesetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
