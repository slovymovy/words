                "senses": [
                    {
                        "sense_id": "8488c2c7-1202-380f-a922-31bec793ebaf",
                        "entry_id": "3f65b59b-6d26-348f-86ad-232bb8fad947",
                        "glosses": [
                            "signed declaration of allegiance to communist authorities"
                        ],
                        "tags": [
                            "feminine",
                            "historical",
                            "informal"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f60256f2-48c3-3d01-8fe7-21e752e3afba",
                        "entry_id": "3f65b59b-6d26-348f-86ad-232bb8fad947",
                        "glosses": [
                            "non-disclosure agreement (non-compete or other agreement that promises not interfering with the interests of the employer)"
                        ],
                        "tags": [
                            "colloquial",
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "15373fe7-fd0f-45c6-94bd-195b49d22413",
                                "sense_id": "f60256f2-48c3-3d01-8fe7-21e752e3afba",
                                "text": "Gdyby nie lojalki, niektórzy stażyści prosto z USA mogliby wpaść w objęcia konkurencji.",
                                "translation": "If it weren't for the NDAs, some interns straight from the US could fall into the arms of the competition.",
                                "english": "If it weren't for the NDAs, some interns straight from the US could fall into the arms of the competition."
                            },
                            {
                                "example_id": "06753af9-2ab5-45ff-848f-cd65ef4a2633",
                                "sense_id": "f60256f2-48c3-3d01-8fe7-21e752e3afba",
                                "text": "Lojalka zobowiązywała go do zachowywania ścisłej tajemnicy przekazanych mu informacji poufnych, tajnych, ściśle tajnych, ściśle tajnych specjalnego znaczenia.",
                                "translation": "The NDA obligated him to keeping the information of confidential, secret, strictly secret, strictly secret special meaning top secret.",
                                "english": "The NDA obligated him to keeping the information of confidential, secret, strictly secret, strictly secret special meaning top secret."
                            },
                            {
                                "example_id": "5ce3248d-a15a-4f0c-8d92-c4c1fac9f33a",
                                "sense_id": "f60256f2-48c3-3d01-8fe7-21e752e3afba",
                                "text": "Jeśli pracownik podnosi kwalifikacje zawodowe z inicjatywy pracodawcy lub za jego zgodą, można wprowadzić i zobowiązać pracownika do podpisania tzw. lojalki.",
                                "translation": "If an employee improves professional qualifications at the employer's initiative or with their approval, you can implement it and force the worker to sign a so-called loyalty oath.",
                                "english": "If an employee improves professional qualifications at the employer's initiative or with their approval, you can implement it and force the worker to sign a so-called loyalty oath."
                            },
                            {
                                "example_id": "d5a14e14-139f-4ed7-a2c6-a2c8b84dc9c1",
                                "sense_id": "f60256f2-48c3-3d01-8fe7-21e752e3afba",
                                "text": "– Wasze pieprzenie to wasza sprawa – wrzeszczał – dopóki nie odbija się na firmie! Wie pan, ile ona wie?! Do czego miała dostęp?! I, do jasnej cholery, nie podpisała mi żadnej lojalki!",
                                "translation": "“Your bullcrap is your business,” he screamed, “until it impinges on the company! Do you know how much she knows?! What she had access to?! And, for the love of Chirst, why she didnt' sign any non-compete!”",
                                "english": "“Your bullcrap is your business,” he screamed, “until it impinges on the company! Do you know how much she knows?! What she had access to?! And, for the love of Chirst, why she didnt' sign any non-compete!”"
                            },
                            {
                                "example_id": "1079bc9c-8ce4-4eca-806a-c13d36a7d02f",
                                "sense_id": "f60256f2-48c3-3d01-8fe7-21e752e3afba",
                                "text": "[…] w medium należącym do koncernu RASp, jakim jest na przykład niemiecki „Bild”, trzeba podpisać lojalkę, że będzie się pisało proamerykańskie teksty, bo jak nie, to można wylecieć z pracy.",
                                "translation": "In a publication owned by RASp, for example the German ‘Bild’, you have to sign a loyalty oath that you will be writing pro-American pieces, because otherwise you can get sacked.",
                                "english": "In a publication owned by RASp, for example the German ‘Bild’, you have to sign a loyalty oath that you will be writing pro-American pieces, because otherwise you can get sacked."
                            }
                        ]
                    }
