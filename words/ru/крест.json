                },
                {
                    "sense_id": "8a817bdb-1375-35ec-b6ee-b761b0278d22",
                    "sense_definition": "Немодный, отсталый человек (молодёжный сленг).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slang_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не будь <крестом>, оденься прилично на вечеринку.",
                            "target_lang_translations": {
                                "en": "Don't be a <dork>, dress decently for the party.",
                                "de": "Sei kein <w>Hinterwäldler</w>, zieh dich ordentlich für die Party an."
                            }
                        },
