                    {
                        "translation_id": "c564fe47-0022-4297-85ba-ec795c87fbe9",
                        "source_entry_id": "5a22653e-2f4c-3fa3-9916-770c7c9fd44b",
                        "source_sense_id": "f293e8af-ef58-31de-9c68-5c5520469ef8",
                        "source_sense_description": "addition of a prefix",
                        "target_lang_word": "Präfigierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Präfigierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "24a4721d-f46d-3493-b9b2-90d79a788beb",
                                        "entry_id": "60a46fc7-77aa-3498-bbc4-3c7bffdf12c6",
                                        "glosses": [
                                            "Anhängung eines Morphems vor ein anderes"
                                        ],
                                        "tags": [
                                            "Sprachwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c45f62c-4190-4f86-bb0f-ceff0963802b",
                                                "sense_id": "24a4721d-f46d-3493-b9b2-90d79a788beb",
                                                "text": "Durch die Präfigierung von ‚un-‘ erzeugt man das Gegenteil eines Wortes."
                                            },
                                            {
                                                "example_id": "9a449d14-01e7-4f9f-ade5-3d81217cb30f",
                                                "sense_id": "24a4721d-f46d-3493-b9b2-90d79a788beb",
                                                "text": "„Anders entscheidet z. B. Schmidt, der davon ausgeht, daß sowohl bei der Präfigierung als auch bei der Suffigierung auf der ersten Analyseebene nur eine unmittelbare Konstituente ein Wort, die zweite ein Affix ist.“"
                                            },
                                            {
                                                "example_id": "105ae52b-a084-46ee-8a4e-2cff2df77c6e",
                                                "sense_id": "24a4721d-f46d-3493-b9b2-90d79a788beb",
                                                "text": "„Neben den gerade vorgestellten Suffigierungen zählt im Deutschen auch die Präfigierung zu den Derivationsprozessen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
