                        "glosses": [
                            "zespół pomieszczeń, warsztatów oraz torów przystosowanych do obsługi technicznej i napraw parowozów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97131fb0-0f0d-4484-98dc-dc38ca5cfd8f",
                                "sense_id": "f1dfa7d6-e95e-3b63-bbcd-0269633d85ae",
