    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "86616385-9ce3-381e-ab22-fb8872d65553",
                    "sense_definition": "A person's essential nature, character, or personality, especially as perceived by others or at a particular time.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "identity_personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a good night's sleep, she finally felt like her usual <w>self</w> again.",
                            "target_lang_translations": {
                                "ru": "После хорошего сна она наконец снова почувствовала себя <w>прежней</w>.",
                                "zh": "好好睡了一晚后，她终于又觉得自己恢复了平常的<w>样子</w>。"
                            }
                        },
                        {
                            "text": "He revealed his true <w>self</w> only after we had known him for many years.",
                            "target_lang_translations": {
                                "ru": "Он раскрыл свою истинную <w>сущность</w> только после того, как мы знали его много лет.",
                                "zh": "我们认识他很多年后，他才显露出自己真实的<w>本性</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "true self",
                        "usual self",
                        "former self",
                        "shadow self"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сущность, характер или личность человека, особенно в восприятии других или в определенный момент времени.",
                        "zh": "人的本质、性格或个性，尤指他人所感知到的，或某一时期所呈现出的自己。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сущность",
                                "target_lang_sense_clarification": "внутренняя природа"
                            },
                            {
                                "target_lang_word": "«я»",
                                "target_lang_sense_clarification": "личность"
                            },
                            {
                                "target_lang_word": "собой",
                                "target_lang_sense_clarification": "творительный падеж от «себя»"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "本性",
                                "target_lang_sense_clarification": "人的真实品性、性格本质"
                            },
                            {
                                "target_lang_word": "样子",
                                "target_lang_sense_clarification": "某个时期表现出来的状态或样子"
                            },
                            {
                                "target_lang_word": "真我",
                                "target_lang_sense_clarification": "强调真实的内在自我时"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "070744c7-edba-3e5e-ba75-ade355e4f4a1",
                    "sense_definition": "The individual person viewed as a distinct entity or the subject of their own consciousness and experience.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "identity_personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Meditation is often used as a tool to connect with one's inner <w>self</w>.",
                            "target_lang_translations": {
                                "ru": "Медитация часто используется как инструмент для связи со своим внутренним <w>«я»</w>.",
                                "zh": "冥想常被用作与自己内在<w>自我</w>建立联系的工具。"
                            }
                        },
                        {
                            "text": "Developing a strong sense of <w>self</w> is crucial for emotional stability.",
                            "target_lang_translations": {
                                "ru": "Развитие сильного чувства собственного <w>«я»</w> имеет решающее значение для эмоциональной стабильности.",
                                "zh": "培养强烈的<w>自我</w>认同感对情绪稳定至关重要。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sense of self",
                        "inner self",
                        "loss of self"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельная личность, рассматриваемая как самостоятельная сущность или субъект собственного сознания.",
                        "zh": "作为独立个体、并作为自身意识与经验主体的人。"
