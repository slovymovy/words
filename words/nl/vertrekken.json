                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn gezicht <w>vertrok</w> van woede toen hij het nieuws hoorde.",
                            "target_lang_translations": {
                                "en": "His face <w>contorted</w> with anger when he heard the news.",
                                "ru": "Его лицо <w>исказилось</w> от гнева, когда он услышал новости.",
                                "pl": "Jego twarz <w>wykrzywiła się</w> ze złości, gdy usłyszał te wieści.",
                                "de": "Sein Gesicht <w>verzog</w> sich vor Wut, als er die Neuigkeit hörte.",
                                "fr": "Son visage <w>se crispa</w> de colère lorsqu'il apprit la nouvelle.",
                                "it": "Il suo viso si <w>contrasse</w> dalla rabbia quando sentì la notizia.",
                                "cs": "Když tu zprávu uslyšel, tvář se mu <w>zkřivila</w> hněvem.",
                                "tr": "Haberleri duyduğunda öfkeden yüzü <w>kasıldı</w>.",
                                "es": "Su rostro se <w>desfiguró</w> de ira cuando escuchó la noticia."
                            }
                        },
                        {
                            "text": "Zij luisterde naar het vonnis zonder een spier te <w>vertrekken</w>.",
                            "target_lang_translations": {
                                "en": "She listened to the verdict without <w>moving</w> a muscle.",
                                "ru": "Она слушала приговор, и ни один мускул на её лице не <w>дрогнул</w>.",
                                "pl": "Wysłuchała wyroku, nie <w>drgnąwszy</w> nawet okiem.",
                                "de": "Sie hörte sich das Urteil an, ohne eine Miene zu <w>verziehen</w>.",
                                "fr": "Elle écouta le verdict sans <w>bouger</w> un cil.",
                                "it": "Ascoltò il verdetto senza <w>muovere</w> un muscolo.",
                                "cs": "Poslouchala rozsudek, aniž by <w>pohnula</w> jediným svalem.",
                                "tr": "Kararı, yüzündeki tek bir kası bile <w>oynatmadan</w> dinledi.",
                                "es": "Ella escuchó la sentencia sin <w>mover</w> un solo músculo."
                            }
