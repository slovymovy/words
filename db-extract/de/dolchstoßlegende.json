                ],
                "senses": [
                    {
                        "sense_id": "8948b145-06a2-315a-92dd-402d81b44ea7",
                        "entry_id": "e0702149-4867-341e-8510-f7e740dad1fe",
                        "glosses": [
                            "geschichtsverfälschende Behauptung"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "7893ca20-8191-40f0-b614-66b417d77a43",
                                "sense_id": "8948b145-06a2-315a-92dd-402d81b44ea7",
                                "text": "„Trotzdem strickt die militante Rechte an einer Dolchstoßlegende und konstruiert dabei eine völlig andere Verschwörung.“"
                            },
                            {
                                "example_id": "1a99cc58-3736-4b48-a0c4-dbd126691a6a",
                                "sense_id": "8948b145-06a2-315a-92dd-402d81b44ea7",
                                "text": "„Das Schicksal hatte die Dolchstoßlegende einem Mann zugeworfen, dessen Habitus und Horizont sich nicht wesentlich von dem eines Mister Jedermann unterscheiden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a7d63560-2e02-3230-8940-fa88b742e239",
                        "entry_id": "e0702149-4867-341e-8510-f7e740dad1fe",
                        "glosses": [
                            "Verschwörungstheorie, bei der die Schuld für die deutsche Niederlage im Ersten Weltkrieg den Sozialdemokraten zugeschrieben wird"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "5afdd941-1dcd-4ad9-a640-5d5335330e63",
                                "sense_id": "a7d63560-2e02-3230-8940-fa88b742e239",
                                "text": "„Nicht von ungefähr fand denn etwa in diesen Kreisen die republikfeindliche Dolchstoßlegende zahlreiche Anhänger.“"
                            },
                            {
                                "example_id": "968bfe62-7a17-4322-a2ea-804e88d12bac",
                                "sense_id": "a7d63560-2e02-3230-8940-fa88b742e239",
                                "text": "„Viertens erinnerte der Gehalt der Dolchstoßlegende an einen im damaligen Deutschland allgemein bekannten literarischen Mythos: die Ermordung Siegfrieds durch Hagen im Nibelungenlied.“"
                            },
                            {
                                "example_id": "79b707d1-7a50-44bb-a8ba-37b9d0634343",
                                "sense_id": "a7d63560-2e02-3230-8940-fa88b742e239",
                                "text": "„Die erhebliche politische Brisanz der Kriegsbücher in der Weimarer Republik rührt daher, dass die von Jünger unentwegt erwähnte Tapferkeit der Soldaten die sogenannte Dolchstoßlegende ausdrücklich bestätigt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
