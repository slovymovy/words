                "senses": [
                    {
                        "sense_id": "5f804028-57cb-3b31-ae3f-1879fced19fa",
                        "entry_id": "0d37d217-a8c7-389a-ae10-e5863f31bcc7",
                        "glosses": [
                            "das Kollar"
                        ],
                        "tags": [
                            "vor allem römisch-katholisch; umgangssprachlich bis abwertend"
                        ],
                        "examples": [
                            {
                                "example_id": "6cb6a9f6-c9ab-41ed-ae5c-55c43cef40c3",
                                "sense_id": "5f804028-57cb-3b31-ae3f-1879fced19fa",
                                "text": "„Schon lange gilt vielen in der Kirche das Äußerliche mehr als die Glaubenssubstanz. Der Richtungsstreit reduziert sich oft auf Moden und Stile. Wer Soutane und Römerkragen trägt, ist für die einen genauso unten durch wie für die anderen der jeanstragende Priester.“"
                            },
                            {
                                "example_id": "d98c568b-9294-4472-987b-a77c8c8ac54f",
                                "sense_id": "5f804028-57cb-3b31-ae3f-1879fced19fa",
                                "text": "„An seinem schwarzen Kleid mit Römerkragen ist er leicht zu erkennen.“"
                            },
                            {
                                "example_id": "49e241af-bad9-46fe-b587-293401200fc5",
                                "sense_id": "5f804028-57cb-3b31-ae3f-1879fced19fa",
                                "text": "„Schon sein Römerkragen auf schwarzem Hemd verweist auf das christliche Profil der Lehre.“"
                            },
                            {
                                "example_id": "d835b496-1a9c-4379-b837-df8d04f09bc7",
                                "sense_id": "5f804028-57cb-3b31-ae3f-1879fced19fa",
                                "text": "„Kurz nach seiner Diakonsweihe im November 2013 trug der Steingadener auch das zugehörige Kollar: ein weißer, ringförmiger Stehkragen. Den Römerkragen nahm er erst ab, als der Elternbeirat insistierte.“"
                            },
                            {
                                "example_id": "114bfce1-5788-41a7-b900-c4292bf65710",
                                "sense_id": "5f804028-57cb-3b31-ae3f-1879fced19fa",
                                "text": "„Als Tage später die Lifttür aufgeht, steht er zu meiner Überraschung schon vor mir. Gestützt auf seinen Rollator, aber ohne jede Begleitung. Bequemer schwarzer Pulli statt Römerkragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
