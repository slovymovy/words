                        ],
                        "examples": [
                            {
                                "example_id": "a3610437-c289-4428-8e1e-aa8c1d22a60f",
                                "sense_id": "30ef2691-663d-3ab9-a533-dda9db5903c8",
                                "text": "Les CL psaumes qui composent le psautier sont partagés en XX cathismes, qui toutes sont lues une fois dans le courant de chaque semaine, et deux fois pendant les semaines du grand carême."
                            },
                            {
                                "example_id": "2ba11b20-3527-4f3b-9b66-d211b88a403a",
                                "sense_id": "30ef2691-663d-3ab9-a533-dda9db5903c8",
                                "text": "Pendant l’hiver, le cathisme des vêpres passe au nocturne, et le soir on récite chaque jour le 18ᵉ (pss 119-133), sauf le samedi où, comme d’habitude, on commence le psautier par le cathisme 1ᵉʳ."
                            }
                        ]
                    },
