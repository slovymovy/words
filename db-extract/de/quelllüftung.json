                "senses": [
                    {
                        "sense_id": "c06001ec-577d-33dc-9795-6144c5f5b14d",
                        "entry_id": "a0674128-4cb0-34bb-8c7c-bd79015b433a",
                        "glosses": [
                            "zugeführte, impulsarme Luftströmung, durch thermischen Auftrieb von unten nach oben aufsteigend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9eaad4a7-d6d9-4fa0-9b4b-3f62c435d91c",
                                "sense_id": "c06001ec-577d-33dc-9795-6144c5f5b14d",
                                "text": "„Bei der Quelllüftung strömt die Frischluft von den Luftauslässen in Bodennähe in den Raum, wandert dann langsam nach oben und wird über Überströmöffnungen in Deckennähe in den Gang geführt.“"
                            },
                            {
                                "example_id": "d86fbbb1-93aa-4448-9917-b4614c118d5f",
                                "sense_id": "c06001ec-577d-33dc-9795-6144c5f5b14d",
                                "text": "„Die Quelllüftung ist eine relativ neuartige Form eines Luftführungssystems und sie wird erst seit den achtziger Jahren mit steigender Tendenz zur Belüftung und Klimatisierung von Gebäuden verwendet.“"
                            },
                            {
                                "example_id": "f8416836-bbc9-409c-a9a9-46f0b77c6513",
                                "sense_id": "c06001ec-577d-33dc-9795-6144c5f5b14d",
                                "text": "„Bei der Quelllüftung „quillt“ von unten kältere Luft in den Raum ein und ein Raumluftsee entsteht.“"
                            },
                            {
                                "example_id": "57fc43c2-be27-4810-9641-86ed33d07bf6",
                                "sense_id": "c06001ec-577d-33dc-9795-6144c5f5b14d",
                                "text": "„Ein in die Laboreinrichtung integrierte Quelllüftung bietet eine wirtschaftliche Alternative zu herkömmlichen Lüftungseinrichtungen bei wesentlich verbesserter Luftqualität.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
