                "word": "bijboeken",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d8c5eae3-452f-32b6-b5c7-6ee7224ad667",
                        "entry_id": "37493f0d-722d-3817-b469-fbe9e48daf0c",
                        "glosses": [
                            "een bedrag toevoegen aan een (bank)rekening"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9b566471-5494-3099-af01-d99236948f47",
                        "entry_id": "37493f0d-722d-3817-b469-fbe9e48daf0c",
                        "glosses": [
                            "een extra item toevoegen aan een order of bestelling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48742b2e-b013-43e3-a45d-295dcc9fc337",
                                "sense_id": "9b566471-5494-3099-af01-d99236948f47",
                                "text": "EasyJet vervoerde wel een recordaantal van ruim 80 miljoen passagiers, 10 procent meer dan een jaar eerder. Ook harkte het meer geld binnen met behulp van extraatjes die passagiers kunnen bijboeken of aan boord kunnen kopen. Maar dat was onvoldoende om de stevige daling van de prijzen van vliegtickets te compenseren. Ook het relatief zwakke Britse pond zat het bedrijf flink dwars."
                            },
                            {
                                "example_id": "e8dc1b23-8fa2-4e1f-99dc-570e8bfd31c5",
                                "sense_id": "9b566471-5494-3099-af01-d99236948f47",
                                "text": "In onderstaande infographic is te zien dat sommige vliegmaatschappijen de prijzen zowat hebben verdubbeld in de afgelopen twee jaar. De grootste stijger is KLM. Hier betaal je momenteel 25 euro voor het bijboeken van een koffer op een vlucht binnen Europa. Voor hetzelfde traject in 2015 kon een FlyingBlue member (gratis lidmaatschap) nog voor een tientje een koffer bijboeken. Gratis ruimbagage op Europese bestemmingen bestaat nog bij Turkish Airlines, Aeroflot en Iceland Air."
                            },
                            {
                                "example_id": "953084e8-1bb4-487e-b289-c670458e91ba",
                                "sense_id": "9b566471-5494-3099-af01-d99236948f47",
                                "text": "Eerder deze zondag zijn we er in geslaagd Londen te verlaten. Per trein. Eurostar blijkt het weekend 50 extra treinen in te zetten. Onmiddellijk nadat we dit horen wordt in ons hotel in Kensington, een redelijk chique wijk in Londen, via internet contact gelegd met Eurostar. En het lukt! We bemachtigen zeven plaatsbewijzen naar Brussel, ook nog gezellig bij elkaar. Kost wel 169 pond per persoon, maar dat terzijde. Een nachtje extra bijboeken is geen probleem. You are welcome! De extra ponden zijn mooi meegenomen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23e17622-e503-4fc3-ad44-2e78c01e2a10",
                        "source_entry_id": "37493f0d-722d-3817-b469-fbe9e48daf0c",
                        "source_sense_id": "d8c5eae3-452f-32b6-b5c7-6ee7224ad667",
                        "target_lang_word": "enter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1c0d57b-c48e-3f8e-be38-d601cd9d23d7",
                                        "entry_id": "a2461044-a26f-3ca7-a1b3-fb7410ef3381",
                                        "glosses": [
                                            "To go or come into an enclosed or partially enclosed space."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d33ec8c-0498-4868-a495-625f306fbfa3",
                                                "sense_id": "c1c0d57b-c48e-3f8e-be38-d601cd9d23d7",
                                                "text": "You should knock before you enter, unless you want to see me naked."
                                            },
                                            {
                                                "example_id": "b9966714-c708-40ac-91bc-7d50899bccbd",
                                                "sense_id": "c1c0d57b-c48e-3f8e-be38-d601cd9d23d7",
                                                "text": "[…]you can fynde in youre heartes to assaulte her with rebellion, or in any wise [ways] suffer any one eyvil motion to enter into your thoughtes against her?"
                                            },
                                            {
                                                "example_id": "01b4881c-28da-4fce-9f82-cc41bd78fc67",
                                                "sense_id": "c1c0d57b-c48e-3f8e-be38-d601cd9d23d7",
                                                "text": "Except a man be born of water and of the Spirit, he cannot enter into the kingdom of God."
                                            },
                                            {
                                                "example_id": "8ec24981-a1a3-4139-9f82-55211341d1a0",
                                                "sense_id": "c1c0d57b-c48e-3f8e-be38-d601cd9d23d7",
                                                "text": "In former days every tavern of repute kept such a room for its own select circle, a club, or society, of habitués, who met every evening, for a pipe and a cheerful glass.[…]Strangers might enter the room, but they were made to feel that they were there on sufferance: they were received with distance and suspicion."
                                            },
                                            {
                                                "example_id": "d72c9dfd-ce9f-4406-a7a6-4bb7f4a75192",
                                                "sense_id": "c1c0d57b-c48e-3f8e-be38-d601cd9d23d7",
                                                "text": "We determined that the car driver’s transportation of multiple teen passengers, limited driving experience, and likely impairment from effects of cannabis at the time of the crash adversely affected her judgment of the danger of entering the intersection in front of the approaching combination vehicle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "347ad7b5-d3d6-3321-abe7-0b9216ec6c26",
                                        "entry_id": "a2461044-a26f-3ca7-a1b3-fb7410ef3381",
                                        "glosses": [
                                            "To cause to go (into), or to be received (into); to put in; to insert; to cause to be admitted."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2613b085-a930-445e-b0ff-556635d48391",
                                                "sense_id": "347ad7b5-d3d6-3321-abe7-0b9216ec6c26",
                                                "text": "to enter a knife into a piece of wood"
                                            },
                                            {
                                                "example_id": "9f793873-8b76-4fcb-9367-be090cfe9fb7",
                                                "sense_id": "347ad7b5-d3d6-3321-abe7-0b9216ec6c26",
                                                "text": "to enter a boy at college, a horse for a race, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b54c7185-17c7-361a-a3e2-ecf4e2027925",
                                        "entry_id": "a2461044-a26f-3ca7-a1b3-fb7410ef3381",
                                        "glosses": [
                                            "To go or come into (a state or profession)."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17d66d5e-e76b-4c2b-b216-472c1ee057a2",
                                                "sense_id": "b54c7185-17c7-361a-a3e2-ecf4e2027925",
                                                "text": "My twelve-year-old son will be entering his teens next year."
                                            },
                                            {
                                                "example_id": "fd862213-7f27-4e8c-9a96-783d0310afa1",
                                                "sense_id": "b54c7185-17c7-361a-a3e2-ecf4e2027925",
                                                "text": "She had planned to enter the legal profession."
                                            },
                                            {
                                                "example_id": "967c6291-f46b-4b78-ba0a-f4ad8a97cfc3",
                                                "sense_id": "b54c7185-17c7-361a-a3e2-ecf4e2027925",
                                                "text": "Until 2008 there was denial over what finance had become. … But the scandals kept coming, and so we entered stage three – what therapists call \"bargaining\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "916a063b-5e68-3199-be02-c5ba7bfb098e",
                                        "entry_id": "a2461044-a26f-3ca7-a1b3-fb7410ef3381",
                                        "glosses": [
                                            "To type (something) into a computer; to input."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b15e0f96-972b-4d57-8273-2adef6add036",
                                                "sense_id": "916a063b-5e68-3199-be02-c5ba7bfb098e",
                                                "text": "Enter your user name and password."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1628eea5-4164-3eeb-924c-72127e57ba45",
                                        "entry_id": "a2461044-a26f-3ca7-a1b3-fb7410ef3381",
                                        "glosses": [
                                            "To record (something) in an account, ledger, etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ad31538-b3dd-476b-8c8a-084f048321df",
                                                "sense_id": "1628eea5-4164-3eeb-924c-72127e57ba45",
                                                "text": "Each amount entered in the debit column of the journal is posted by entering it on the credit side/column of an account in the ledger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fae6b38-193f-39b1-847b-d79d1bb5871e",
                                        "entry_id": "a2461044-a26f-3ca7-a1b3-fb7410ef3381",
                                        "glosses": [
                                            "To become a party to an agreement, treaty, etc."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29d0de3d-bec6-4a5b-8509-9d3fb8add7f1",
                                                "sense_id": "8fae6b38-193f-39b1-847b-d79d1bb5871e",
                                                "text": "I am pleased to notify the Congress of my intent to enter into a Free Trade Agreement (FTA) with the Government of Singapore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f892b4d-fdf7-37e5-b0e6-c4af6298031c",
                                        "entry_id": "a2461044-a26f-3ca7-a1b3-fb7410ef3381",
                                        "glosses": [
                                            "To become effective; to come into effect."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92fe394a-bc92-4552-8382-468e4f8ef965",
                                                "sense_id": "4f892b4d-fdf7-37e5-b0e6-c4af6298031c",
                                                "text": "This Act shall enter into force on 01 March 1998."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "898b58d3-1789-32f4-9bd8-01173c327797",
