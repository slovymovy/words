                "senses": [
                    {
                        "sense_id": "f65e79f0-5033-3371-a476-3902bcff7a64",
                        "entry_id": "4bdfad03-134c-368f-a1f2-bdb6e528345d",
                        "glosses": [
                            "человек, обладающий обширными знаниями в определённой области"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dbe733e-b522-4255-b755-fe60a6a60d24",
                                "sense_id": "f65e79f0-5033-3371-a476-3902bcff7a64",
                                "text": "Ещё тут был инженер Хоробров, большой знаток радио."
                            },
                            {
                                "example_id": "43dd4747-50de-4653-adb1-513e0909a052",
                                "sense_id": "f65e79f0-5033-3371-a476-3902bcff7a64",
                                "text": "Вы кажется, юрист, или во всяком случае хороший знаток существующих порядков, прежних и нынешних."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fff29f6e-40b2-48ff-9353-51a1225f32e1",
                        "source_entry_id": "4bdfad03-134c-368f-a1f2-bdb6e528345d",
                        "source_sense_id": "f65e79f0-5033-3371-a476-3902bcff7a64",
                        "target_lang_word": "expert",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "expert",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dcec3f37-f09d-3432-86d0-e9451a22717b",
                                        "entry_id": "ef244dce-0d2b-38e8-aa4f-d6f2fa0b630e",
                                        "glosses": [
                                            "Extraordinary capable or knowledgeable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dbe4a80-66d4-4097-a3ad-45546766c13e",
                                                "sense_id": "dcec3f37-f09d-3432-86d0-e9451a22717b",
                                                "text": "I am expert at making a simple situation complex."
                                            },
                                            {
                                                "example_id": "eee8d8f3-3bee-42d3-8827-3ff4f8a3767f",
                                                "sense_id": "dcec3f37-f09d-3432-86d0-e9451a22717b",
                                                "text": "My cousin is an expert pianist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46922c74-8a61-312c-9a63-5189ea922291",
                                        "entry_id": "ef244dce-0d2b-38e8-aa4f-d6f2fa0b630e",
                                        "glosses": [
                                            "Characteristic of an expert."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4400dc18-9d2f-4229-8859-303d3ebe0aeb",
                                                "sense_id": "46922c74-8a61-312c-9a63-5189ea922291",
                                                "text": "This problem requires expert knowledge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d9aa305-7602-3c0a-82df-44e4726b49c1",
                                        "entry_id": "ef244dce-0d2b-38e8-aa4f-d6f2fa0b630e",
                                        "glosses": [
                                            "Proven, experienced, veteran."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "expert",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "693af04b-096b-3642-ba7d-ef5234d7b83d",
                                        "entry_id": "a1d093ea-8743-35d2-89d4-1c001eaaf287",
                                        "glosses": [
                                            "A person with extensive knowledge or ability in a given subject."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "885b1c9c-fd0a-432d-a905-72485e899517",
                                                "sense_id": "693af04b-096b-3642-ba7d-ef5234d7b83d",
                                                "text": "If an expert says it can't be done, get another expert. - David Ben-Gurion"
                                            },
                                            {
                                                "example_id": "837256c2-464e-4ceb-9acd-28049ca7978d",
                                                "sense_id": "693af04b-096b-3642-ba7d-ef5234d7b83d",
                                                "text": "We called in several experts on the subject, but they couldn't reach an agreement."
                                            },
                                            {
                                                "example_id": "7df3c666-9ca6-4377-b295-f5f5a23d16c3",
                                                "sense_id": "693af04b-096b-3642-ba7d-ef5234d7b83d",
                                                "text": "Plastics are energy-rich substances, which is why many of them burn so readily. Any organism that could unlock and use that energy would do well in the Anthropocene. Terrestrial bacteria and fungi which can manage this trick are already familiar to experts in the field."
                                            },
                                            {
                                                "example_id": "10fa2d69-4d43-4bc4-8c13-6a74b71efb35",
                                                "sense_id": "693af04b-096b-3642-ba7d-ef5234d7b83d",
                                                "text": "I'm an expert in my field\nUfology, yes, it's all real\nAncient aliens, it's all true\nI'm an expert just like you"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f712187-def4-3f07-87f9-c24dcf1000d4",
                                        "entry_id": "a1d093ea-8743-35d2-89d4-1c001eaaf287",
                                        "glosses": [
                                            "A player ranking just below master."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "expert",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76b7736c-b927-3b72-a651-d74bcf7aa0c2",
                                        "entry_id": "9fa13cad-21c2-3a50-8034-e5883a66b45e",
                                        "glosses": [
                                            "To have (something) reviewed or checked by an expert."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36f6348c-29de-4106-a49c-490d8ca46ccb",
                                                "sense_id": "76b7736c-b927-3b72-a651-d74bcf7aa0c2",
                                                "text": "Estimated cost of editorial work on Advanced History […] Estimated cost of experting the Advanced History […]"
                                            },
                                            {
                                                "example_id": "d6009af6-14c9-4c0c-b241-cfa0fd00642d",
                                                "sense_id": "76b7736c-b927-3b72-a651-d74bcf7aa0c2",
                                                "text": "The bill in question was one proposing to appropriate from the public moneys of this State $30,000 to pay an accountant for experting the books of the Southern Pacific Company, in furtherance of litigation then pending."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "246473d4-fa20-4e4f-8af7-23d4acc6dc53",
                        "source_entry_id": "4bdfad03-134c-368f-a1f2-bdb6e528345d",
                        "source_sense_id": "f65e79f0-5033-3371-a476-3902bcff7a64",
                        "target_lang_word": "Fachmann",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fachmann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05852883-1309-3ba3-a81b-efc9918ba360",
                                        "entry_id": "9d788063-43a5-3a05-9a0d-254a0a23c96f",
                                        "glosses": [
                                            "(männliche^☆) Person, die in einem bestimmten Fach ausgebildet ist und entsprechende Kenntnisse hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8af10565-c72b-4745-984f-aef47575dc6b",
                                                "sense_id": "05852883-1309-3ba3-a81b-efc9918ba360",
                                                "text": "Das kann ich nicht selbst reparieren, da muss ein Fachmann her."
                                            },
                                            {
                                                "example_id": "81909ead-14c9-4d19-861f-3bbf6fc8f283",
                                                "sense_id": "05852883-1309-3ba3-a81b-efc9918ba360",
                                                "text": "„Die Entdeckung 2003 elektrisierte nicht nur Fachleute.“"
                                            },
                                            {
                                                "example_id": "f4a4f31d-0e57-4fe3-ad97-546310489286",
                                                "sense_id": "05852883-1309-3ba3-a81b-efc9918ba360",
                                                "text": "„Die Gesellschaft braucht weder Sprachgesetze noch eine Sprachpolizei, aber sie hat Anspruch auf Rat von Fachleuten.“"
                                            },
                                            {
                                                "example_id": "fff7e5b1-81e9-4a9f-993a-ea014a04a7b0",
                                                "sense_id": "05852883-1309-3ba3-a81b-efc9918ba360",
                                                "text": "„Doch was bei den beiden wichtigsten Erzählern der frühen nachrömischen Geschichte Britanniens übereinstimmend nach Völkermord klingt, sehen heutige Fachleute weniger eindeutig.“"
                                            },
                                            {
                                                "example_id": "33c3ed77-3a24-45be-95bd-e072ad3040a4",
                                                "sense_id": "05852883-1309-3ba3-a81b-efc9918ba360",
                                                "text": "„Die Israelis trafen notgedrungen mit den angereisten deutschen Fachleuten zusammen, die sie mit KFZ-Teilen, Lokomotiven und Schiffen vertraut machen sollten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
