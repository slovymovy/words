                    {
                        "sense_id": "074f8d85-06cc-395f-b85f-97c5f96b8de4",
                        "entry_id": "4280b095-ec80-352e-8b12-8343087d5212",
                        "glosses": [
                            "Durst habend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc2b2efc-1734-46d0-b826-35d959629f96",
                                "sense_id": "074f8d85-06cc-395f-b85f-97c5f96b8de4",
                                "text": "Zij zijn dorstig naar het leven.",
                                "translation": "Sie haben Durst nach dem Leben."
