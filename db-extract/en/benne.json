                "forms": [],
                "senses": [
                    {
                        "sense_id": "d51a99f5-ff42-3edd-a973-12671027602f",
                        "entry_id": "4eb6ded9-ff0c-33f1-a3bf-c77761d81d3c",
                        "glosses": [
                            "Sesame."
                        ],
                        "tags": [
                            "attributive",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "680329f1-23af-4da5-9149-1a7841e22c49",
                                "sense_id": "d51a99f5-ff42-3edd-a973-12671027602f",
                                "text": "benne oil; benne seed"
                            },
                            {
                                "example_id": "7057569f-0718-41d2-9477-ffe3bad67b09",
                                "sense_id": "d51a99f5-ff42-3edd-a973-12671027602f",
                                "text": "Benne (sesame) seeds were secretly brought to America on the slave ships by black women who had used them in their native cooking. Benne seed cookies and candy were made by black cooks in Charleston and other lowcountry South Carolina locations."
                            },
                            {
                                "example_id": "6d5b844f-0d99-4287-a2f9-2d81ac78e3b3",
                                "sense_id": "d51a99f5-ff42-3edd-a973-12671027602f",
                                "text": "For example, Rosanna Williams recounted that her African-born father would \"plant mostly benne and rice.\" Emma Hunter also remembered that her grandmother planted benne."
                            },
                            {
                                "example_id": "654d2c90-9080-4788-97ab-b660db11c3b8",
                                "sense_id": "d51a99f5-ff42-3edd-a973-12671027602f",
                                "text": "A window on the small-scale world of sesame oil production and benne cake livestock feeding is found in the pages of Thomas Walter Peyre's plantation journal (1834–59) at the South Carolina Historical Society.[…]African Anerican farming of benne can be imputed only by anecdotal reports, yet numerous records attest to benne’s importance in the slave diet. Indeed, a complex benne cookery adapted from African practices was recorded."
                            }
                        ]
                    }
