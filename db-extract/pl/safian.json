                    }
                ],
                "senses": [
                    {
                        "sense_id": "5e713e98-753f-3036-822f-4f7dda257fd9",
                        "entry_id": "51d7ea6e-1135-3300-9baf-0871e405e6ae",
                        "glosses": [
                            "cienka, wyprawiona, kolorowo barwiona skóra kozia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e292feb-34ed-4106-8086-75e12e5279e0",
                                "sense_id": "5e713e98-753f-3036-822f-4f7dda257fd9",
                                "text": "Rozłożyliśmy się na skórach jelenich; rozesłano przed nami zamiast obrusa bawolą skórę, wyprawioną jak najdoskonalszy safian"
                            },
                            {
                                "example_id": "49ff87c6-fa29-4cfd-bfae-d268ef0c127d",
                                "sense_id": "5e713e98-753f-3036-822f-4f7dda257fd9",
                                "text": "Jedna tylko, panna Wanda, nie mogła usnąć. Była to śliczna dziewczyna o zielonych oczach. Wiedziała o swojej urodzie i obnosiła ją jak paw, ptak nadobny i nadobnie głupi. Uporczywie przynosiła Basi swój pamiętnik w safian oprawny i równie natarczywie prosiła o „protekcję”"
                            },
                            {
                                "example_id": "68735a1b-d60a-4342-9c4a-5c43fec8d3ba",
                                "sense_id": "5e713e98-753f-3036-822f-4f7dda257fd9",
                                "text": "Panowie Potoccy chcieli swego czasu, żebym z nim za granicę dla jego edukacyi jechał, żeby to pięknych manier przy mnie nabrał. Ale ja powiedziałem: „Nie pojadę właśnie dla jego niedbałości, bo on u żadnego buta dwóch uszu niema i w moichby się po dworach prezentował, a safian drogi”"
                            },
                            {
                                "example_id": "49ffa3e2-01a4-4c14-89e4-b6f77bcda20a",
                                "sense_id": "5e713e98-753f-3036-822f-4f7dda257fd9",
                                "text": "Teraz nieznajoma przypomniała się bardziej w porę. Niebawem Balzac otrzymał nową przesyłkę ze stepów: książkę oprawną w zielony safian, „Naśladowanie Chrystusa”. Przyszło w chwili, gdy Balzac męczył się nad swoją powieścią „Lekarz wiejski”, wielokrotnie i mozolnie przerabianą, natchnioną duchem ewangelicznym"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1261b717-c7f7-4304-94e3-949e19156487",
                        "source_entry_id": "51d7ea6e-1135-3300-9baf-0871e405e6ae",
                        "source_sense_id": "5e713e98-753f-3036-822f-4f7dda257fd9",
                        "target_lang_word": "morocco",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "morocco",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ac23140d-e86d-399f-a56a-4e549ef5d949",
                                        "entry_id": "05260cf3-7dae-3b49-94f3-89e141af0485",
                                        "glosses": [
                                            "A soft leather, made from goatskin, used especially in bookbinding."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bb56aeb-23df-430a-987e-d68dc140bde9",
                                                "sense_id": "ac23140d-e86d-399f-a56a-4e549ef5d949",
                                                "text": "The purple morocco cases accompanying the latter contained a handsome set of gold ornaments. Louisa was deeply gratified, even more on Charles's account than on her own; it was such injustice on the part of her family to treat him with such insolence as Lady Anne and Lady Rotheles displayed."
                                            },
                                            {
                                                "example_id": "ab16dccd-b809-42ae-a28d-a6f8b7e26a89",
                                                "sense_id": "ac23140d-e86d-399f-a56a-4e549ef5d949",
                                                "text": "Piers put the letter in an envelope and slipped it into a green morocco-covered volume on the window seat – his sister's diary."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f831004b-2689-3155-a021-a6d50bb34a81",
                                        "entry_id": "05260cf3-7dae-3b49-94f3-89e141af0485",
                                        "glosses": [
                                            "A sheepskin leather in imitation of this."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "081178b8-433b-3fe0-8cc8-4ba4426b4e95",
                                        "entry_id": "05260cf3-7dae-3b49-94f3-89e141af0485",
                                        "glosses": [
                                            "A very strong ale, anciently brewed in Cumberland."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b624f33-e54c-4c64-8293-513d5f840ec7",
                        "source_entry_id": "51d7ea6e-1135-3300-9baf-0871e405e6ae",
