            "senses": [
                {
                    "sense_id": "95969067-ef0d-379c-b8c1-131543f0d843",
                    "sense_definition": "simple past and past participle of <w>expend</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rescue team <w>expended</w> a great deal of energy searching the mountains.",
                            "target_lang_translations": {
                                "tr": "Kurtarma ekibi dağları ararken büyük miktarda enerji <w>sarf etti</w>."
                            }
                        },
                        {
                            "text": "Most of the allocated funds were <w>expended</w> on medical supplies.",
                            "target_lang_translations": {
                                "tr": "Ayrılan fonların çoğu tıbbi malzemelere <w>harcandı</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "expended energy",
                        "expended resources"
                    ],
                    "target_lang_definitions": {
                        "tr": "'expend' (harcamak, sarf etmek, tüketmek) fiilinin geçmiş zaman ve geçmiş zaman sıfat-fiil biçimi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "harcadı",
                                "target_lang_sense_clarification": "enerji, para veya zaman için"
                            },
                            {
                                "target_lang_word": "sarf etti",
                                "target_lang_sense_clarification": "çaba veya güç için"
                            },
                            {
                                "target_lang_word": "tüketildi",
                                "target_lang_sense_clarification": "kaynak veya fonlar için edilgen kullanım"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "49250f5f-a06f-3976-a3cc-2ae00ed7dea4",
                    "sense_definition": "Completely spent, consumed, or used up.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ground was littered with <w>expended</w> bullet casings after the battle.",
                            "target_lang_translations": {
                                "tr": "Çatışmanın ardından yerler <w>boş</w> mermi kovanlarıyla doluydu."
                            }
                        },
                        {
                            "text": "After running the marathon, his <w>expended</w> energy left him unable to stand.",
                            "target_lang_translations": {
                                "tr": "Maratonu koştuktan sonra, <w>tükenen</w> enerjisi onu ayakta duramaz hâle getirdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "consumed",
                        "depleted",
                        "exhausted",
                        "spent",
                        "used up"
                    ],
                    "antonyms": [
