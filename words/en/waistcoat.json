            "pos": "noun",
            "senses": [
                {
                    "sense_id": "781c5177-52eb-3733-90bb-ac712fd6e267",
                    "sense_definition": "A sleeveless, collarless garment worn over a shirt and under a suit jacket.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to wear a silk <w>waistcoat</w> to the wedding to look more formal.",
                            "target_lang_translations": {
                                "ru": "Он решил надеть на свадьбу шелковый <w>жилет</w>, чтобы выглядеть более официально."
                            }
                        },
                        {
                            "text": "The gentleman adjusted his <w>three-piece</w> <w>suit</w> and smoothed down his wool <w>waistcoat</w>.",
                            "target_lang_translations": {
                                "ru": "Джентльмен поправил свой костюм-тройку и разгладил шерстяной <w>жилет</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "vest"
                    ],
                    "common_phrases": [
                        "three-piece suit",
                        "wool waistcoat",
                        "silk waistcoat",
                        "buttoned waistcoat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет одежды без рукавов и воротника, который надевается поверх рубашки и под пиджак."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жилет",
                                "target_lang_sense_clarification": "основной термин для классического жилета"
                            },
                            {
                                "target_lang_word": "жилетка",
                                "target_lang_sense_clarification": "разговорный вариант"
                            },
                            {
                                "target_lang_word": "безрукавка",
                                "target_lang_sense_clarification": "любая одежда без рукавов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "688179c8-15c7-38d7-ad21-06badc47b5ad",
                    "sense_definition": "An ornamental garment worn under a doublet in historical fashion.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historical clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum display featured an intricately embroidered <w>waistcoat</w> from the sixteenth century.",
                            "target_lang_translations": {
                                "ru": "В музейной экспозиции был представлен искусно расшитый <w>жилет</w> шестнадцатого века."
                            }
                        },
                        {
                            "text": "In the Elizabethan era, a man might wear an ornamental <w>waistcoat</w> beneath his doublet.",
                            "target_lang_translations": {
                                "ru": "В елизаветинскую эпоху мужчина мог носить декоративный <w>жилет</w> под дублетом."
                            }
