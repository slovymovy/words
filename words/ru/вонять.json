{
    "word_family": [
        "вонь",
        "вонючка",
        "вонючий"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "45b2245d-ba2f-31ed-b6e3-69d7f4d88744",
                    "sense_definition": "Издавать неприятный, резкий запах.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "smell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эти старые кроссовки ужасно <w>воняют</w>, их пора выбросить.",
                            "target_lang_translations": {
                                "en": "These old sneakers really <w>stink</w>; it's time to throw them out."
                            }
                        },
                        {
                            "text": "Пакет с мусором висел на ручке холодильника и <w>вонял</w> невыносимо.",
                            "target_lang_translations": {
                                "en": "The bag of trash was hanging on the refrigerator handle and <w>stinking</w> unbearably."
                            }
                        }
                    ],
                    "synonyms": [
                        "смердеть"
                    ],
                    "antonyms": [
                        "благоухать"
                    ],
                    "common_phrases": [
                        "сильно вонять",
                        "вонять гарью"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To emit a strong, unpleasant, or offensive smell."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stink",
                                "target_lang_sense_clarification": "To have a strong, bad smell."
                            },
                            {
                                "target_lang_word": "reek",
                                "target_lang_sense_clarification": "To have or give off a strong, unpleasant smell."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ceb3297b-8244-3f98-9f82-31dc2710144a",
                    "sense_definition": "Выражать недовольство, жаловаться или раздражать окружающих своим поведением.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "complaining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Хватит уже <w>вонять</w> по любому поводу, лучше предложи решение проблемы.",
                            "target_lang_translations": {
                                "en": "Stop <w>making a stink</w> about every little thing; you'd better suggest a solution to the problem."
                            }
                        },
                        {
                            "text": "Он постоянно <w>воняет</w> на начальника, хотя сам ничего не делает.",
                            "target_lang_translations": {
                                "en": "He is constantly <w>complaining</w> about his boss, even though he doesn't do anything himself."
                            }
                        }
                    ],
                    "synonyms": [
                        "вякать",
                        "выступать"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "сленг"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To express dissatisfaction, complain, or annoy others with one's behavior."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "make a stink",
                                "target_lang_sense_clarification": "To make a loud complaint or objection about something."
                            },
                            {
                                "target_lang_word": "complain",
                                "target_lang_sense_clarification": "To express annoyance or dissatisfaction."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}