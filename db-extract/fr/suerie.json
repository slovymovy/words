                        "entry_id": "24702591-2adb-332c-a3a5-7cbc774a2c53",
                        "glosses": [
                            "Action de suer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dad908d-7ff1-40dd-919b-a9740c719be9",
                                "sense_id": "a5760d0d-34bd-3d9e-bb8e-e4ec073c2e56",
                                "text": "J'ai achevé aujourd'hui ma douche et ma suerie… je me crois à couvert des rhumatismes pour le reste de ma vie."
                            },
                            {
                                "example_id": "76c07b54-69da-49be-9ad1-8be4afd47e4d",
                                "sense_id": "a5760d0d-34bd-3d9e-bb8e-e4ec073c2e56",
                                "text": "Ils [les sauvages] pratiquent la suerie de la même manière que les anciens, allant se plonger dans l'eau froide au sortir de leurs thermes artificiels."
                            }
                        ]
                    },
                    {
                        "sense_id": "c197c72c-0948-3ddb-bf55-fc5beff5e258",
                        "entry_id": "24702591-2adb-332c-a3a5-7cbc774a2c53",
                        "glosses": [
                            "Sauna."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "babcb56b-6642-43db-a29e-a9b4b670b6a4",
                                "sense_id": "c197c72c-0948-3ddb-bf55-fc5beff5e258",
                                "text": "Un élément de base de l'hygiène préventive des Amérindiens est la suerie. Elle s'apparente fortement au bain sauna des Nordiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "aaef8721-8654-3475-909e-6a2b90ed73fd",
                        "entry_id": "24702591-2adb-332c-a3a5-7cbc774a2c53",
                        "glosses": [
                            "Bâtiment où l'on fait ressuer et fermenter le tabac."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2af4b3c4-0c07-4782-98ac-a170ac9f21d1",
                                "sense_id": "aaef8721-8654-3475-909e-6a2b90ed73fd",
                                "text": "C'est alors qu'on les attache et qu'on les suspend [les feuilles de tabac] pour les faire sécher sous des hangars qu'on appelle sueries."
                            }
                        ]
                    }
