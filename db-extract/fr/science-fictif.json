                        "examples": [
                            {
                                "example_id": "81814e77-166c-4d30-847c-8515dbeb97bb",
                                "sense_id": "3b2b6992-ad04-3313-b5bc-01cdcc616208",
                                "text": "Vision déjà science-fictive d’une capitale française vouée au règne de l’électricité, à l’omniprésence de la lumière et au quadrillage des transports en commun."
                            },
                            {
