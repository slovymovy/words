                        "cabane de jardin"
                    ]
                },
                {
                    "sense_id": "1e04f137-dc3e-3867-a85a-ce75ab82df0b",
                    "sense_definition": "Petit abri ou enclos sommaire destiné au logement de petits animaux domestiques.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "animaux",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le fermier a nettoyé la <w>cabane</w> des lapins avant l'arrivée de l'hiver glacial."
