        "fr-extract.jsonl": [
            {
                "entry_id": "0195b632-0745-3a95-825a-1d08509aa307",
                "word": "Mésopotamie",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f1666259-7a71-37b5-9711-d13764c3d011",
                        "entry_id": "0195b632-0745-3a95-825a-1d08509aa307",
                        "glosses": [
                            "Région du Moyen-Orient située entre le Tigre et l’Euphrate."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6dc39e8-4640-4c44-a7bf-4888e7062025",
                                "sense_id": "f1666259-7a71-37b5-9711-d13764c3d011",
                                "text": "Le hochet est un des plus anciens instruments de musique du monde. On en a retrouvé dans l’Égypte Ancienne notamment (en roseau, en papyrus et en terre-cuite) et en Mésopotamie (en terre-cuite), qui datent de 2000 AJC, ainsi que dans la plupart des sociétés préhistoriques des cinq continents."
                            },
                            {
                                "example_id": "ea7b5f82-9fd4-45ea-b1b0-553fbff34d22",
                                "sense_id": "f1666259-7a71-37b5-9711-d13764c3d011",
                                "text": "C’est ainsi que, dans l’Antiquité, les riches vallées du Nil et de l’Euphrate (Mésopotamie) furent toujours convoitées par des hordes conquérantes."
                            },
                            {
                                "example_id": "214c1128-42bc-417f-be36-57dba431820c",
                                "sense_id": "f1666259-7a71-37b5-9711-d13764c3d011",
                                "text": "Liz avait profité de ses escales à San-Francisco et Atlanta pour glaner quelques informations sur Internet à propos des katoïs d’Asie du Sud-Est et des salzikrums de Mésopotamie."
                            },
                            {
                                "example_id": "d52392c4-43a7-4db5-baa3-b9d5e1017290",
                                "sense_id": "f1666259-7a71-37b5-9711-d13764c3d011",
                                "text": "Barack Obama avait du reste retiré les troupes de Mésopotamie en décembre 2011, sanctionnant l'échec de la stratégie des néoconservateurs de l'ère de George W. Bush …."
                            },
                            {
                                "example_id": "d198eeee-a49a-493a-b3b6-96c32243ad07",
                                "sense_id": "f1666259-7a71-37b5-9711-d13764c3d011",
                                "text": "les pratiques de calcul en usage dans certains milieux marchands, notamment les Assyriens qui assuraient un commerce sur de longues distances entre la Mésopotamie et l'Anatolie, ont un caractère utilitaire manifeste."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f090cc15-091e-45a0-b487-527554e1fe91",
                        "source_entry_id": "0195b632-0745-3a95-825a-1d08509aa307",
                        "source_sense_id": "f1666259-7a71-37b5-9711-d13764c3d011",
                        "target_lang_word": "Mesopotamien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mesopotamien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "925207a3-b2fe-3047-86d6-78caeb4e4d23",
                                        "entry_id": "aebb91ed-03ff-305c-84b3-e17fe7ee0803",
                                        "glosses": [
                                            "im engeren Sinn: das Land, das zwischen den beiden Flüssen Euphrat und Tigris in Nordost-Syrien und im Irak liegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6ca2e12-e345-4fa3-a749-c6cc514a89e7",
                                                "sense_id": "925207a3-b2fe-3047-86d6-78caeb4e4d23",
                                                "text": "Die Sumerer lebten in Mesopotamien."
                                            },
                                            {
                                                "example_id": "74514e17-7998-436a-a426-308ade8e6692",
                                                "sense_id": "925207a3-b2fe-3047-86d6-78caeb4e4d23",
                                                "text": "„So nahm der Knecht zehn Kamele von den Kamelen seines Herrn und zog hin und hatte mit sich allerlei Güter seines Herrn und machte sich auf und zog nach Mesopotamien, zu der Stadt Nahors.“"
                                            },
                                            {
                                                "example_id": "bf7eb711-4cad-4659-a7b8-422c0740b8e8",
                                                "sense_id": "925207a3-b2fe-3047-86d6-78caeb4e4d23",
                                                "text": "das Mesopotamien der Antike"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ca05c237-2572-34f1-a1ff-fb18a32abaf9",
                                        "entry_id": "aebb91ed-03ff-305c-84b3-e17fe7ee0803",
                                        "glosses": [
                                            "im weiteren Sinn: das gesamte flache Steppenland zwischen der arabischen Wüste und den östliche Randlagen des Zagros- und Taurusgebirges"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0542e739-fd22-49df-b779-213158638cdb",
                                                "sense_id": "ca05c237-2572-34f1-a1ff-fb18a32abaf9",
                                                "text": "Wenn man heute von Mesopotamien spricht, meint man den heutigen Irak."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d140fc5-e3d7-452f-94aa-1a7d4a1072ed",
                        "source_entry_id": "0195b632-0745-3a95-825a-1d08509aa307",
                        "source_sense_id": "f1666259-7a71-37b5-9711-d13764c3d011",
