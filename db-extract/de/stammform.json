                "senses": [
                    {
                        "sense_id": "780a79e1-ced2-320e-ab19-777b20d75f1c",
                        "entry_id": "de96836d-38c6-3132-bb08-97ecd7fd0152",
                        "glosses": [
                            "Urform domestizierter Lebewesen"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e0a75db1-baaf-3d33-b623-f79c0916aff5",
                        "entry_id": "de96836d-38c6-3132-bb08-97ecd7fd0152",
                        "glosses": [
                            "eine der Grundformen der Flexion der Verben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd8e13f9-3da8-45fd-bdaf-9e78daaf59d2",
                                "sense_id": "e0a75db1-baaf-3d33-b623-f79c0916aff5",
                                "text": "In der Grammatik des Deutschen werden als Stammformen aufgeführt: Indikativ Präsens, 1./ 3. Person Indikativ Präteritum, Partizip Präteritum; also z.B: „laufen, lief, gelaufen“."
                            },
                            {
                                "example_id": "e1138db8-95f8-4e01-9727-3777f4e12b84",
                                "sense_id": "e0a75db1-baaf-3d33-b623-f79c0916aff5",
                                "text": "Stammformen sind solche Flexionsformen, von denen die anderen Formen des gleichen Paradigmas hergeleitet werden können."
                            },
                            {
                                "example_id": "f8e10e87-3613-4cea-a368-7c57a0c9604d",
                                "sense_id": "e0a75db1-baaf-3d33-b623-f79c0916aff5",
                                "text": "„Regelmäßige Verben ändern im Präteritum und im Partizip II ihren Stammvokal nicht, unregelmäßige Verben ändern ihn in gesetzmäßiger Weise in den drei Stammformen (Infinitiv - Präteritum - Partizip II) (Ablaut):…“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "6f71e9c8-394c-3385-9bf7-e4995e0cba30",
                        "entry_id": "de96836d-38c6-3132-bb08-97ecd7fd0152",
                        "glosses": [
                            "Grundbestandteil einer Wortgruppe mit gleichem Wortstamm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d40a7d60-8e2a-4399-8f83-4818de80f246",
                                "sense_id": "6f71e9c8-394c-3385-9bf7-e4995e0cba30",
                                "text": "Die Wörter „grün, Grünanlage, grünlich, hellgrün“ haben die gleiche Stammform: „grün“ und bilden eine Wortfamilie."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
