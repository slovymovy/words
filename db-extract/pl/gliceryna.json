                        "source_sense_id": "9001dcb9-6545-3bff-91db-108f9727812d",
                        "target_lang_word": "glycérol",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glycérol",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1fadab8c-2e6e-3b35-8f9c-3e631b7d9540",
                                        "entry_id": "b3ac143b-8692-3e76-a952-913d5bed8d69",
                                        "glosses": [
                                            "Liquide incolore, transparent, facilement soluble dans l’alcool, d’une saveur sucrée et d’une consistance sirupeuse, qui est le produit de la saponification des graisses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03506342-9b86-4cc7-a894-18859dacdc17",
                                                "sense_id": "1fadab8c-2e6e-3b35-8f9c-3e631b7d9540",
                                                "text": "Lors de la production de biodiesel, ou éther de méthyl, du glycérol est obtenu lors du raffinage de l’huile de colza après saponification et méthylation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f52bbb9-2790-40dc-a75a-f82e7396eb49",
                        "source_entry_id": "d3d816e7-cd6d-3a6b-ad17-502669c47fbd",
                        "source_sense_id": "9001dcb9-6545-3bff-91db-108f9727812d",
                        "target_lang_word": "glycérine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glycérine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0534fa63-2de3-3f93-a6f4-bec36a854eba",
                                        "entry_id": "d78da78a-9c0c-31eb-991f-4afea918e891",
                                        "glosses": [
                                            "Liquide incolore, transparent, facilement soluble dans l’alcool, d’une saveur sucrée et d’une consistance sirupeuse, qui est le produit de la saponification des graisses."
                                        ],
                                        "tags": [
                                            "Cosmétologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "469df97e-9c30-4e7e-bd4d-169ca8d62036",
                                                "sense_id": "0534fa63-2de3-3f93-a6f4-bec36a854eba",
                                                "text": "Le fil est coagulé par l’alcool, l’éther, l’acide acétique, l’ammoniaque et la glycérine."
                                            },
                                            {
                                                "example_id": "cee52ab7-61e7-4800-ab3e-5a1d8430fec8",
                                                "sense_id": "0534fa63-2de3-3f93-a6f4-bec36a854eba",
                                                "text": "À la fin du mois, je pouvais apporter à ma femme, une centaine de francs, qu’elle dépensait aussitôt en pommades, en glycérine, en menus objets avec lesquels elle se parait, se maquillait, se pomponnait."
                                            },
                                            {
                                                "example_id": "42f9365f-865e-4b68-890f-0d51ecefbdc7",
                                                "sense_id": "0534fa63-2de3-3f93-a6f4-bec36a854eba",
                                                "text": "Les corps gras sont des éthers composés ou glycérides tertiaires formés par la glycérine et divers acides gras à teneur élevée en carbone. Les glycérides les plus répandus sont ceux des acides stéarique, palmitique et oléique."
                                            },
                                            {
                                                "example_id": "440378fb-31b9-47c6-9f51-e70d9a3f813f",
                                                "sense_id": "0534fa63-2de3-3f93-a6f4-bec36a854eba",
                                                "text": "L’acide glycérophosphorique C₃H₅(OH)₂PO₄H₂, préparé dans l’action de PO₄H₃ à chaud sur la glycérine, est la base des glycérophosphates de chaux, de soude, maintenant très employés."
                                            },
                                            {
                                                "example_id": "a9e5d923-0458-4f8c-b419-ebcaff1e3923",
                                                "sense_id": "0534fa63-2de3-3f93-a6f4-bec36a854eba",
                                                "text": "Et elle tourna vers l’homme des yeux pleins de larmes : c’étaient de splendides larmes qui remplissaient les yeux jusqu’aux bords, sans tomber, comme de jolies larmes de glycérine, au cinéma…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "glycérine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0f58c7f7-0653-36b1-8188-c51dd0e4ea11",
                                        "entry_id": "55a0fde6-4cfa-3a66-869d-96c3fc9bcfbe",
                                        "glosses": [
