                            {
                                "example_id": "b670a13e-a4e7-4407-ab1b-d736544a3af6",
                                "sense_id": "a8c3e81d-3979-3a2d-a256-5e9982c244a9",
                                "text": "Alle urinoirs in Amsterdam kunt u op Google-maps terugvinden"
                            },
                            {
                                "example_id": "ce3c93b8-7318-4d78-9a39-e45da4ce9928",
                                "sense_id": "a8c3e81d-3979-3a2d-a256-5e9982c244a9",
                                "text": "In een urinoir kan het ook soms moeilijk zijn om met iemand naast je te plassen."
                            }
                        ]
                    },
                    {
                        "sense_id": "4a8792c6-8112-3286-bd2e-c9e6df7d7cd8",
                        "entry_id": "93e3f5c9-a4d4-35fb-8511-f498eb34fbb2",
                        "glosses": [
                            "soort van bak in de onder [1] genoemde waterplaats, die aan de muur is bevestigd en bedoeld voor een individuele persoon (over het algemeen een man) om in te urineren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57db9670-5530-4f55-846e-a236ede6bf01",
                                "sense_id": "4a8792c6-8112-3286-bd2e-c9e6df7d7cd8",
                                "text": "De urinoirs aan de muur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01fd00da-2e07-4c2b-be1b-b0a59e4adf39",
                        "source_entry_id": "93e3f5c9-a4d4-35fb-8511-f498eb34fbb2",
                        "target_lang_word": "Urinal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Urinal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d250f701-c4fa-3808-a462-f3d2cd2a49c9",
                                        "entry_id": "81342b0e-ec55-3b4f-8bb8-7d859334f347",
                                        "glosses": [
                                            "meist in öffentlichen Toiletten an der Wand befestigte(s) Becken zum Urinieren (meist für Männer)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b34d8c2a-d409-44bd-9f2d-fc13703b5634",
                                                "sense_id": "d250f701-c4fa-3808-a462-f3d2cd2a49c9",
                                                "text": "„Duchamp kaufte ein Urinal im Sanitärfachhandel, setzte seine Unterschrift darauf und wollte es als Kunstwerk ausstellen.“"
                                            },
                                            {
                                                "example_id": "79e71534-6cc3-4ac7-bd14-0a84095172b3",
                                                "sense_id": "d250f701-c4fa-3808-a462-f3d2cd2a49c9",
                                                "text": "„Seit kurzem hängen zwei Urinale in Blütenform an der Wand. Und die keramischen Objekte stellen ihre botanischen Vorbilder fast in den Schatten.“"
                                            },
                                            {
                                                "example_id": "4a1b8719-da82-4d80-a559-1627e150c699",
                                                "sense_id": "d250f701-c4fa-3808-a462-f3d2cd2a49c9",
                                                "text": "„Er sah ihn im weißen Anzug auf dem Boden vor den Urinalen kriechen, seinen Schädel umklammernd, um Hilfe flehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "621904d2-2060-3807-979a-3e4d24b220cb",
                                        "entry_id": "81342b0e-ec55-3b4f-8bb8-7d859334f347",
                                        "glosses": [
                                            "ein mit einem weitem Hals versehenes Gefäß für Männer, welches in der Krankenpflege zum Auffangen des Urins dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4112bad1-9ee8-4d98-abd7-eb25007efe83",
                                                "sense_id": "621904d2-2060-3807-979a-3e4d24b220cb",
                                                "text": "Jetzt gibt es die Not-Urinalflasche. Ein tragbares Urinal mit Schraubverschluss und völlig geruchs- und flüssigkeitsdicht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0517a134-75fb-4b42-b9e5-c2745a021182",
                        "source_entry_id": "93e3f5c9-a4d4-35fb-8511-f498eb34fbb2",
