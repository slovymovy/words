                "translations": [
                    {
                        "translation_id": "e2c6a1f5-ddbe-4c77-8512-b488735299e1",
                        "source_entry_id": "17406ab6-42c5-3107-bbb4-308d06fc4c71",
                        "source_sense_id": "41f99e03-30fd-31a7-8521-9495124d296d",
                        "source_sense_description": "uitgetrokken bundeltje",
                        "target_lang_word": "Büschel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Büschel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cddbfa9e-68d4-34fd-ba61-7910aa13d074",
                                        "entry_id": "3d6ad474-59d0-323f-bffe-8ddc31f63eaa",
                                        "glosses": [
                                            "gebündelte oder miteinander verwachsene, relativ kleine Menge von (dünnen) länglichen Gegenständen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c21fb68-e57a-45ee-8fc0-b42837a34159",
                                                "sense_id": "cddbfa9e-68d4-34fd-ba61-7910aa13d074",
                                                "text": "Der Friseur schnitt ein Büschel Haare."
                                            },
                                            {
                                                "example_id": "b0239f83-19e3-43cd-9f02-14f91be9f186",
                                                "sense_id": "cddbfa9e-68d4-34fd-ba61-7910aa13d074",
                                                "text": "„Nur die Brise vom Dorf und Fluß her wuchs, und die Kornfelder neigten sich und mit ihnen der rote Mohn, der in ganzen Büscheln zwischen den Halmen stand.“"
                                            },
                                            {
                                                "example_id": "5afa86e9-6973-4969-9002-323288976e51",
                                                "sense_id": "cddbfa9e-68d4-34fd-ba61-7910aa13d074",
                                                "text": "„Moos bedeckte den Boden um den Baum herum und einige trockene Büschel Wildgras, die sich der Aufmerksamkeit des Gärtners entzogen hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Büschel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b2976440-06ec-3f3c-a26e-0578ea4f5f11",
                                        "entry_id": "29e1c2be-c8ec-3904-b9ff-cc7cd519d1ed",
                                        "glosses": [
                                            "deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77328aa3-6859-4066-ac07-840f6cd92553",
                                                "sense_id": "b2976440-06ec-3f3c-a26e-0578ea4f5f11",
                                                "text": "Herr Büschel ist als Kaninchenzüchter erfolgreich."
                                            },
                                            {
                                                "example_id": "5f525c01-b4a4-4044-99d9-d236ca5084ad",
                                                "sense_id": "b2976440-06ec-3f3c-a26e-0578ea4f5f11",
                                                "text": "Herr Büschel heiratet im September auf Hawaii."
                                            },
                                            {
                                                "example_id": "580bc2d3-ed58-4f4d-aace-36102f41d219",
                                                "sense_id": "b2976440-06ec-3f3c-a26e-0578ea4f5f11",
                                                "text": "Frau Büschel liebt es, an Weihnachten Plätzchen zu backen."
                                            },
                                            {
                                                "example_id": "cf82a608-7c57-464a-bcae-049333ae6c86",
                                                "sense_id": "b2976440-06ec-3f3c-a26e-0578ea4f5f11",
                                                "text": "Die Büschels lieben die Natur und die Tiere."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
