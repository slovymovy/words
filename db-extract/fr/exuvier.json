                ],
                "senses": [
                    {
                        "sense_id": "24e9247d-7112-3ee8-b5a2-8aedaa1f5013",
                        "entry_id": "da1bf489-e496-3b09-b7d9-73250278659c",
                        "glosses": [
                            "Muer, changer de peau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04bad598-e70b-4b3a-b54c-7a085bce63fa",
                                "sense_id": "24e9247d-7112-3ee8-b5a2-8aedaa1f5013",
                                "text": "Le système nerveux commanderait donc les modifications que doit subir le tégument avant de s'exuvier et qui consisteraient, selon certains auteurs, en une disparition de sa partie interne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "393c9acf-2a93-4321-b619-ccd015a63baa",
                        "source_entry_id": "da1bf489-e496-3b09-b7d9-73250278659c",
                        "source_sense_id": "24e9247d-7112-3ee8-b5a2-8aedaa1f5013",
                        "target_lang_word": "exuviate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exuviate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "918b397d-e832-32ca-b52b-9812918f8307",
                                        "entry_id": "aeef6dbf-0e36-3d26-a992-180d6b6fd9c2",
                                        "glosses": [
                                            "To shed or cast off a covering, especially a skin; to slough; to molt (moult)."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6925b3f2-878f-41c3-8d80-33784f01eb38",
                                                "sense_id": "918b397d-e832-32ca-b52b-9812918f8307",
                                                "text": "Like any arthropod encased in a rigid exoskeleton, a trilobite must periodically moult, or exuviate, in order to grow."
                                            },
                                            {
                                                "example_id": "ae1096f1-701f-44f5-8b6f-de6dd2bfcd8f",
                                                "sense_id": "918b397d-e832-32ca-b52b-9812918f8307",
                                                "text": "Although multicultural societies are difficult to manage, they need not become a political nightmare and might even become exciting if we exuviate our long traditional preoccupation with a culturally homogeneous and tightly structured polity and allow them instead to intimate their own appropriate institutional forms, modes of governance, and moral and political virtues."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
