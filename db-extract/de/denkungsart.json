                "senses": [
                    {
                        "sense_id": "c02f8310-c1f0-3d36-913d-702508f81539",
                        "entry_id": "1d51c3e2-57de-3ce5-8c5b-2bd3983fa10b",
                        "glosses": [
                            "way of thinking"
                        ],
                        "tags": [
                            "dated",
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "2e994eb8-1fef-4afe-9266-1ef3c9e7ed3f",
                                "sense_id": "c02f8310-c1f0-3d36-913d-702508f81539",
                                "text": "Hiezu kam noch die natürliche Verwandtschaft, welche unter Leuten von Witz und feiner Lebens-Art obwaltet, die übereinstimmung ihrer Denkungs-Art, und Neigungen; vielleicht auch die besondere Vorrechte, die er, der gemeinen Meinung nach, eine Zeit lang bei ihr genossen."
                            },
                            {
                                "example_id": "b89ad3ef-b731-4aa0-b7de-dd9f13f938a2",
                                "sense_id": "c02f8310-c1f0-3d36-913d-702508f81539",
                                "text": "Droste reimt auch. Kleine Kostprobe gefällig? \"In des Daseins stillen Glanz / Platzt der Mensch mit Ententanz\". Das ist Zivilisationskritik reinster Denkungsart."
                            }
                        ]
                    }
                ],
