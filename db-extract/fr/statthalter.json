                        "entry_id": "9866052d-365d-35b8-b0f6-cd9d309c1462",
                        "glosses": [
                            "Haut-représentant de l'Empire allemand en Alsace-Lorraine, entre 1879 et 1918."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e802f9da-ab2d-47b8-9c20-5591bd3d2b76",
                                "sense_id": "d9634b01-5aa5-3753-ba82-f481f75424d1",
                                "text": "Bismarck le [Edwin von Manteuffel] fit nommer Statthalter d’Alsace-Lorraine où il combina les pouvoirs civils et militaires. (Wikipédia, « Edwin von Manteuffel »)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e3565fb-c2b9-47da-9669-5ab9d50e59cc",
                        "source_entry_id": "9866052d-365d-35b8-b0f6-cd9d309c1462",
                        "source_sense_id": "d9634b01-5aa5-3753-ba82-f481f75424d1",
                        "target_lang_word": "Statthalter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Statthalter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d2f1d730-f3a2-3483-ac5c-abc91a0d57e6",
                                        "entry_id": "ef1e56b1-099d-3c06-be50-a1f0d03aec25",
                                        "glosses": [
                                            "Verwalter einer Provinz"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5da32397-94b5-422c-899c-518fb915b091",
                                                "sense_id": "d2f1d730-f3a2-3483-ac5c-abc91a0d57e6",
                                                "text": "„Um auch in den Provinzen gefährliche Machtkonzentrationen einzelner Statthalter zu vermeiden, wurden ferner die Heeresverbände auf alle Promagistrate verteilt.“"
                                            },
                                            {
                                                "example_id": "8136c81e-599b-4916-98e8-110a301908e8",
                                                "sense_id": "d2f1d730-f3a2-3483-ac5c-abc91a0d57e6",
                                                "text": "„Die Vorgänge auf dem Kontinent wurden von den römischen Statthaltern und Militärbefehlshabern in Britannien aufmerksam registriert.“"
                                            },
                                            {
                                                "example_id": "f5b46dfa-a3c3-4854-8c51-3814a82c934f",
                                                "sense_id": "d2f1d730-f3a2-3483-ac5c-abc91a0d57e6",
                                                "text": "„Der Statthalter sagte mir mit der leutseligsten Miene, ich möge ihm doch die Freude machen, seine Gemahlin, die mit ihm reisen werde, aufzusuchen.“"
                                            },
                                            {
                                                "example_id": "2fae9aca-bbe1-49bc-b583-77f5be41bfba",
                                                "sense_id": "d2f1d730-f3a2-3483-ac5c-abc91a0d57e6",
                                                "text": "[Pontius Pilatus:] „Jesus aber wurde vor den Statthalter gebracht; und der Statthalter fragte ihn und sprach: Bist du der König der Juden? Jesus aber sprach: Du sagst es.“"
                                            },
                                            {
                                                "example_id": "1c2ab5de-f33d-41c2-b4d5-4c1653860854",
                                                "sense_id": "d2f1d730-f3a2-3483-ac5c-abc91a0d57e6",
                                                "text": "„Churchill konnte mit seinem treuen Statthalter Linlithgow zufrieden sein, doch er musste ihn endlich ablösen, weil er die übliche Amtszeit von fünf Jahren schon um zwei Jahre überschritten hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
