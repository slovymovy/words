                                        "sense_id": "23e89caf-0ed7-38f1-a885-6ce793311d90",
                                        "entry_id": "6275b53b-b966-35ee-a4bb-09a7207ddc05",
                                        "glosses": [
                                            "An online social networking and microblogging service; officially known as X since 2023."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95744ae8-0a50-4c76-bd39-eaeee98bcae8",
                                                "sense_id": "23e89caf-0ed7-38f1-a885-6ce793311d90",
                                                "text": "There were, of course, many Twitters existing in parallel: Politics Twitter, Sports Twitter, Black Twitter, Weird Twitter. But Twitter and TV went together like extreme weather and marine predators."
                                            }
                                        ]
                                    }
                                ]
