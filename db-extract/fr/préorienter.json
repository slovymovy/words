                        "entry_id": "f25043ef-7597-3638-8686-8a682bed1b85",
                        "glosses": [
                            "Donner une première orientation à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51b1c821-7099-4b38-8cf5-d9ede03fc8f1",
                                "sense_id": "6d7c89b1-2ff9-3dea-b189-f3eab545a598",
                                "text": "Si, par exemple, dans un scrutin, on ne donnait aucune indication aux électeurs, afin de ne pas préorienter leur choix et de les laisser entièrement libres, ils ne sauraient pas pour qui voter."
                            },
                            {
                                "example_id": "7aaff5f5-125e-4fb1-9373-0478c167946a",
                                "sense_id": "6d7c89b1-2ff9-3dea-b189-f3eab545a598",
                                "text": "Le volume unique permet, dès leur arrivée, de préorienter les voyageurs en fonction des transporteurs, des directions et des postes de trafic."
                            }
                        ]
                    }
