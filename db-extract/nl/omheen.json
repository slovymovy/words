                                            {
                                                "example_id": "ea50a936-49dc-4c5c-804b-e3d52dcfd5dd",
                                                "sense_id": "313aa28a-4c14-3c7f-8751-f14db84cdcc0",
                                                "text": "Der Weg verläuft um den Teich herum und dann über die Brücke dort."
                                            },
