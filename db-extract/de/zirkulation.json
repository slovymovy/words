                "senses": [
                    {
                        "sense_id": "788d1a8d-d8d3-3c28-bee0-fc81001bc582",
                        "entry_id": "fcc723d1-0923-3eab-9290-9359596c2d9e",
                        "glosses": [
                            "Umlauf, dynamische Bewegung oder Kreislauf von Etwas in einem System"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97030fd7-2c70-4110-9d9d-ca346c601c5f",
                                "sense_id": "788d1a8d-d8d3-3c28-bee0-fc81001bc582",
                                "text": "Die Zirkulation des Blutes ist wichtig für die Organismen von Säugetieren"
                            },
                            {
                                "example_id": "668e4f3b-dd7a-441a-acae-d536060c48a8",
                                "sense_id": "788d1a8d-d8d3-3c28-bee0-fc81001bc582",
                                "text": "Die Zirkulation des Wassers in der Atmosphäre hat globale Auswirkungen."
                            },
                            {
                                "example_id": "d86dbd07-f0e1-4b6d-b416-eb6531becd24",
                                "sense_id": "788d1a8d-d8d3-3c28-bee0-fc81001bc582",
                                "text": "Die Zirkulation des Wassers in einer Heizungsanlage ist wichtig, damit es in der Wohnung warm wird."
                            },
                            {
                                "example_id": "13b91e25-72fe-4b59-b889-90e2ecdf5d69",
                                "sense_id": "788d1a8d-d8d3-3c28-bee0-fc81001bc582",
                                "text": "Die Zirkulation des Geldes ist essenziell für die Wirtschaft."
                            },
                            {
                                "example_id": "86e102c8-43fd-4367-a06e-44f6ef0c48bf",
                                "sense_id": "788d1a8d-d8d3-3c28-bee0-fc81001bc582",
                                "text": "Die Zirkulation der Luft verursacht unter anderem Winde."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "45496b6f-5ee5-3812-b611-cf42d0ef6bbb",
                        "entry_id": "fcc723d1-0923-3eab-9290-9359596c2d9e",
