                    },
                    {
                        "sense_id": "4d0104ca-4203-3365-8e04-30c8daa274f4",
                        "entry_id": "0ad92cdc-f44c-32c7-9b74-9e817b5283fd",
                        "glosses": [
                            "A picket fence."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "1065b25f-f8ed-4196-b9ef-2cac3b6a2292",
                                "sense_id": "4d0104ca-4203-3365-8e04-30c8daa274f4",
                                "text": "The city is surrounded by picketings, and guarded by forts on the outside, and has since been very strongly fortified."
                            },
                            {
                                "example_id": "4877c98a-9fdf-4411-8db9-e3e99d146121",
                                "sense_id": "4d0104ca-4203-3365-8e04-30c8daa274f4",
                                "text": "The enemy, posted among the houses of the French inhabitants and the picketings of their gardens, were advanced upon gallantly by Majors Graves and Madison, and dislodged in the face of a heavy fire."
                            },
                            {
                                "example_id": "e7b5b33b-b393-47aa-a488-e416e67c30eb",
                                "sense_id": "4d0104ca-4203-3365-8e04-30c8daa274f4",
                                "text": "He therefore strengthened that place as much as possible, with bags of flour and sand, which was so effectual that the picketings in that place sustained no material injury."
                            }
                        ]
                    }
