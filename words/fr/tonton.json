                        }
                    ]
                },
                {
                    "sense_id": "48a88306-e086-3346-a0f0-67ac1169272c",
                    "sense_definition": "Ami proche de la famille envers lequel un enfant ou un plus jeune ressent une affection quasi filiale.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "famille",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce vieil ami de mes parents est devenu comme un véritable <w>tonton</w> pour moi."
                        },
                        {
                            "text": "Il considère son voisin comme un <w>tonton</w> et va souvent lui demander des conseils."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "b7abc215-8e2a-3b1a-af8b-238ee67b0b84",
                    "sense_definition": "Informateur de la police ou des douanes dans le milieu du grand banditisme ; indicateur.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'inspecteur a discrètement rencontré son <w>tonton</w> dans un bar pour obtenir des renseignements."
                        },
                        {
                            "text": "Les enquêteurs de la brigade financière s'appuient souvent sur des <w>tontons</w> bien introduits."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "argot policier"
                        }
                    ]
                },
                {
                    "sense_id": "0b9e5882-2a16-3402-9440-f41e2b5c8fb4",
                    "sense_definition": "Trésorier d'une association ou d'un club.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>tonton</w> du club de football a présenté un bilan financier parfaitement équilibré."
                        },
                        {
                            "text": "Après cinq ans à gérer les comptes, notre <w>tonton</w> quitte finalement le bureau associatif."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "argot associatif"
                        }
                    ]
                }
