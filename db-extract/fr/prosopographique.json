                    {
                        "sense_id": "349c1c8f-199d-387c-8781-860bbba46203",
                        "entry_id": "880ff2c2-d9a2-39a7-8b46-fe4fe3243da1",
                        "glosses": [
                            "Qui a rapport à la prosopographie, la description physique d’une personne, un portrait."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa3da02d-00af-41bf-8958-3bce19634d06",
                                "sense_id": "349c1c8f-199d-387c-8781-860bbba46203",
                                "text": "C'est par l'enquête prosopographique que le tenant de la « nouvelle histoire » a retrouvé le métier du biographe, tenu avec une inentamable bonne conscience pour un sous-genre quasi déshonorant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2176cb3-5427-404b-a852-1197ff96484e",
                        "source_entry_id": "880ff2c2-d9a2-39a7-8b46-fe4fe3243da1",
                        "source_sense_id": "349c1c8f-199d-387c-8781-860bbba46203",
