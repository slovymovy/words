                    },
                    {
                        "form_id": "fbdfa3d9-64e7-49ae-982c-3baae8741821",
                        "entry_id": "7b33aece-e370-3d95-af43-c60a22234950",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most harmoniously"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "39d26375-61b2-32bb-9f75-21811ce1a0c1",
                        "entry_id": "7b33aece-e370-3d95-af43-c60a22234950",
                        "glosses": [
                            "In a harmonious manner; coordinately."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27bc641e-8445-4424-bdcc-e959af16fbb9",
                                "sense_id": "39d26375-61b2-32bb-9f75-21811ce1a0c1",
                                "text": "Close beside a tranquil pool, for the moonbeams melted harmoniously into its quiet depths, was an old tree."
                            },
                            {
                                "example_id": "09466ca4-411a-4de6-995a-724b3c70051a",
                                "sense_id": "39d26375-61b2-32bb-9f75-21811ce1a0c1",
                                "text": "They, therefore, began to work more harmoniously, and finally were amalgamated on August 13, 1859, […]."
                            },
                            {
                                "example_id": "1c95ef31-7c69-40df-bf7b-173f387b8652",
                                "sense_id": "39d26375-61b2-32bb-9f75-21811ce1a0c1",
                                "text": "Danziger’s new Green Dragon, a delicate and airy Lepidium, is a unique green filler for flower arrangements that blends harmoniously in any centerpiece or bouquet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "63832797-1de6-4e72-8d07-a75bbf915af1",
                        "source_entry_id": "7b33aece-e370-3d95-af43-c60a22234950",
                        "source_sense_id": "39d26375-61b2-32bb-9f75-21811ce1a0c1",
                        "source_sense_description": "in a harmonious manner",
                        "target_lang_word": "harmonieusement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "harmonieusement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ecbf0974-1683-3c96-9331-24c9be0ae328",
                                        "entry_id": "e6fcfd58-7802-3027-848b-84d6874bf88e",
                                        "glosses": [
                                            "Avec harmonie, d’une manière harmonieuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f699a6f-3bea-4f61-9550-6892b9cac912",
                                                "sense_id": "ecbf0974-1683-3c96-9331-24c9be0ae328",
                                                "text": "Il lui semblait que, dans ce pays, les jours et les mois s'écoulaient plus doucement, plus harmonieusement qu'ailleurs.."
                                            },
                                            {
                                                "example_id": "15ebed19-c458-4f89-b75e-8957b1e713ec",
                                                "sense_id": "ecbf0974-1683-3c96-9331-24c9be0ae328",
                                                "text": "Les Mangaréviens, qui chantaient harmonieusement, se servaient fort mal de la mandoline et de l'accordéon, et jadis leurs instruments préférés pour les danses étaient les tambours en bois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e34d4c2b-3925-3ee1-b26a-7779e104daef",
                                        "entry_id": "e6fcfd58-7802-3027-848b-84d6874bf88e",
                                        "glosses": [
                                            "Dans un arrangement harmonieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0af57764-66a5-4f69-adc4-c13409c9243d",
                                                "sense_id": "e34d4c2b-3925-3ee1-b26a-7779e104daef",
                                                "text": "Répartissez harmonieusement les fruits sur 4 feuilles de papier sulfurisé grassement beurrées."
                                            },
                                            {
                                                "example_id": "bece2bd6-a923-4986-828f-5e5f84392095",
                                                "sense_id": "e34d4c2b-3925-3ee1-b26a-7779e104daef",
                                                "text": "Ainsi Ondriane s’ennuyait. Présentement, les activités et les distractions du palais et de ses environs ne parvenaient plus à remplir harmonieusement ses journées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
