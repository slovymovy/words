                "senses": [
                    {
                        "sense_id": "841e26a6-892d-3fc6-8ae0-04c237dcc620",
                        "entry_id": "232059cf-9a4b-3256-870b-493dbb619caa",
                        "glosses": [
                            "Schreibschrift nach L. Sütterlin, ab 1915 an preußischen Schulen und ab 1934 in allen deutschen Ländern gelehrt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89698f95-93a8-447e-bea4-226547184290",
                                "sense_id": "841e26a6-892d-3fc6-8ae0-04c237dcc620",
                                "text": "Auch noch nach dem Zweiten Weltkrieg lernten Schulkinder die Sütterlinschrift zu schreiben."
                            },
                            {
                                "example_id": "95c32c09-f039-4fd5-9c7e-fd8f688c0740",
                                "sense_id": "841e26a6-892d-3fc6-8ae0-04c237dcc620",
                                "text": "„Während viele ältere Leute die einmal erlernte Deutsche beziehungsweise Sütterlinschrift beibehielten, wurde die Fraktur-Druckschrift bis in die 50er Jahre verwendet und taucht auch heute als Zierschrift wieder auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
