                                                "example_id": "7134cb00-8765-4972-b3ef-dd36a5901ed4",
                                                "sense_id": "9872c188-493c-3efc-9ec8-20897170df34",
                                                "text": "Het horlogebandje was van metaal en het was niet waarschijnlijk dat het kapot was gegaan."
                                            },
