                                        "glosses": [
                                            "Any fly of the genus Glossina, native to Africa, that feeds on human and animal blood; known primarily as a carrier of parasitic trypanosomes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae02b534-3d50-4fda-a53b-69ecd927a5fa",
                                                "sense_id": "57ae55b1-4940-36c3-be8d-3c952facfb60",
                                                "text": "Species of Trypanosoma transmitted by tsetse cause diseases of economic importance in humans and domestic animals in sub-Saharan Africa."
                                            }
                                        ]
                                    }
                                ]
