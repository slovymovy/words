        "fr-extract.jsonl": [
            {
                "entry_id": "1fff440d-a476-39f8-b47d-6f2f8f4d89f7",
                "word": "animosité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d49764db-171a-4fc4-b2aa-706e71d08456",
                        "entry_id": "1fff440d-a476-39f8-b47d-6f2f8f4d89f7",
                        "tags": [
                            "plural"
                        ],
                        "form": "animosités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5ad36a7f-df8f-3fa0-a877-71ca2f42a42c",
                        "entry_id": "1fff440d-a476-39f8-b47d-6f2f8f4d89f7",
                        "glosses": [
                            "Disposition persistante de malveillance qui porte à nuire à quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5238c04-50cc-407b-a200-0042b6a4680d",
                                "sense_id": "5ad36a7f-df8f-3fa0-a877-71ca2f42a42c",
                                "text": "Ils se cherchèrent plus d’une fois, stimulés par une animosité mutuelle, sachant bien que la chute de l’un ou de l’autre déterminerait la victoire."
                            },
                            {
                                "example_id": "622926b7-4553-49e3-8b98-03d9cf6a07ea",
                                "sense_id": "5ad36a7f-df8f-3fa0-a877-71ca2f42a42c",
                                "text": "— C'est bon, tu as fini de faire des cochonneries avec ton crush numéro 1 ? rigola Lila au téléphone, sans un soupçon d’animosité, de jalousie ou de malveillance."
                            },
                            {
                                "example_id": "2300c09d-d2b8-477c-a126-39ba07b74566",
                                "sense_id": "5ad36a7f-df8f-3fa0-a877-71ca2f42a42c",
                                "text": "Je déteste le comportement actuel des supporters plus \"anti ceci cela\" que pro-mon club. C'était du temps ou les supporters des deux clubs wallons se côtoyaient dans les tribunes sans aucune animosité. Qu'est-ce que je regrette ce temps !"
                            }
                        ]
                    },
                    {
                        "sense_id": "02eb7bd7-2d22-3e58-b16f-81ef898f84ea",
                        "entry_id": "1fff440d-a476-39f8-b47d-6f2f8f4d89f7",
                        "glosses": [
                            "Chaleur excessive, d’une certaine violence dans un débat, dans une discussion verbale, dans une querelle de plume."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cd085b4-0298-4fb2-a3bd-9aea1ca431c7",
                                "sense_id": "02eb7bd7-2d22-3e58-b16f-81ef898f84ea",
                                "text": "Clemenceau par ces procédés […] suscite de vives animosités qui vont en se multipliant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "27d3e2da-6d42-4a3e-9238-dd3bc74495f3",
                        "source_entry_id": "1fff440d-a476-39f8-b47d-6f2f8f4d89f7",
                        "target_lang_word": "Animosität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Animosität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1fd19253-a13d-3ab4-bcde-4e8ca096abc6",
                                        "entry_id": "148a6e82-c024-395d-aa68-c7c171e0b64e",
                                        "glosses": [
                                            "feindselige Einstellung gegen jemanden oder etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78c20d49-b9d9-44d5-805a-3ab1d1ddf981",
                                                "sense_id": "1fd19253-a13d-3ab4-bcde-4e8ca096abc6",
                                                "text": "Innerhalb der Mannschaft sind leichte Animositäten spürbar."
                                            },
                                            {
                                                "example_id": "7b58c255-f89f-49b6-874b-a298c1a9cba0",
                                                "sense_id": "1fd19253-a13d-3ab4-bcde-4e8ca096abc6",
                                                "text": "„Doch lassen sich die Titanenkämpfe der Epoche nicht trennen von literarischem Futterneid, persönlichen Animositäten und der schieren Lust an der Invektive.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6c6df6d-c6e4-4ed4-925d-b92daec6c426",
                        "source_entry_id": "1fff440d-a476-39f8-b47d-6f2f8f4d89f7",
                        "target_lang_word": "animosity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "animosity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4aa5601c-6868-3295-a9cb-e08f0be1be0f",
                                        "entry_id": "e47a4cb0-fb51-343a-85c1-47216a892c44",
                                        "glosses": [
                                            "Violent hatred leading to active opposition; active enmity; energetic dislike."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eeb79906-8d9b-402b-89d2-5b9912373791",
                                                "sense_id": "4aa5601c-6868-3295-a9cb-e08f0be1be0f",
                                                "text": "There was open animosity between the two rival teams."
                                            },
                                            {
                                                "example_id": "0db2148f-7c2b-4474-ba57-18c1ba35439c",
                                                "sense_id": "4aa5601c-6868-3295-a9cb-e08f0be1be0f",
                                                "text": "Despite years of conflict, she felt no animosity toward him."
                                            },
                                            {
                                                "example_id": "5c4a7c69-fd24-4ca7-a439-a97ceff0d877",
                                                "sense_id": "4aa5601c-6868-3295-a9cb-e08f0be1be0f",
                                                "text": "Political debates often stir up animosity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
