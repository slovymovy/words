                            {
                                "example_id": "eb5e2700-a476-4a70-a5ae-04db9732e352",
                                "sense_id": "2d05437b-c583-38c6-9ea4-b8eb2aa4bc6a",
                                "text": "„Einige Stadtleute mit ihren Frauen reiten aufs Land hinaus, um Verwandte zu besuchen.“"
                            },
                            {
                                "example_id": "a0a30e26-2f7e-4369-ae5d-6a9bbd78312d",
                                "sense_id": "2d05437b-c583-38c6-9ea4-b8eb2aa4bc6a",
                                "text": "„Im Birkenwald steht Hütte an Hütte; rot angestrichen, mit grünem Torfdach, vorn Fahnenftangen; sie sind von Stadtleuten gebaut, die sich hier im Sommer aufhalten und die Gebirgsluft genießen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
