                        "tags": [],
                        "examples": [
                            {
                                "example_id": "762cf64c-e69b-437b-85de-c686a704ba5b",
                                "sense_id": "078e925f-abd8-35ac-ab08-c256922a654e",
                                "text": "„Es riecht sauber, das heißt, man riecht nur Chemikalien, also Putzmittel oder Parfüm. Kiefernduft soll irgendwo Scheiße überdecken. Zitrone bedeutet, dass jemand gekotzt hat. Rosen übertünchen Urin.“"
                            },
                            {
                                "example_id": "5dc2d878-1588-4bbb-8d9b-76db0133ab78",
                                "sense_id": "078e925f-abd8-35ac-ab08-c256922a654e",
                                "text": "„Auf der Veranda stieg ihm abermals der feuchte Kiefernduft in die Nase, der ihn stets zuverlässig an seine Jugend erinnerte.“"
                            },
                            {
                                "example_id": "7b1f65ca-2c6a-48a7-b2cf-63f1cbde424d",
                                "sense_id": "078e925f-abd8-35ac-ab08-c256922a654e",
                                "text": "„Kugeln schwirrten durch den dichten Hain, Metall schlug klatschend in Holz ein, frischer Kiefernduft stieg in der kühlen Nachtluft empor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
