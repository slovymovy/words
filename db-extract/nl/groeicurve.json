                    {
                        "sense_id": "78bda32a-b13f-3c5e-94c1-b7909ce05317",
                        "entry_id": "269e28b3-2b61-3734-bdf6-8cb0b2094e36",
                        "glosses": [
                            "kromme die het gewicht, de lengte of de hoofdomtrek als functie van de leeftijd aangeeft en wordt bijgehouden door consultatiebureaus en jeugdartsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21bc04a8-cc9d-44de-b6c7-a4300a0a5dd1",
                                "sense_id": "78bda32a-b13f-3c5e-94c1-b7909ce05317",
                                "text": "Baby’s in Nederland huilen meer dan elders, blijkt uit onderzoek in zeven landen. Professor Dieter Wolke wil dat ouders niet alleen afgaan op een groeicurve, maar dat zij ook de ‘huilcurve’ bestuderen."
                            },
                            {
                                "example_id": "3a12226f-de62-40d3-9c13-06632ae13474",
                                "sense_id": "78bda32a-b13f-3c5e-94c1-b7909ce05317",
                                "text": "Groeihormonen worden al aangeraden als de kleine laag scoort op de groeicurve."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b8359ee-1513-39bf-a7cc-f9172fb3ac2c",
                        "entry_id": "269e28b3-2b61-3734-bdf6-8cb0b2094e36",
                        "glosses": [
                            "grafiek die aangeeft hoe iets zich ontwikkelt over de tijd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c06cf99-c172-4a95-8852-8ec3fbed61f1",
                                "sense_id": "8b8359ee-1513-39bf-a7cc-f9172fb3ac2c",
                                "text": "Nepfans. Vaker en vaker valt het woord onder Formule 1-volgers, nu de groeicurve van Max Verstappen qua resultaten even niet pijlsnel naar boven klimt. De die-hard Formule 1-fans gruwelen van die nieuwe aanwas supporters, die na wat slechte races al gaan lopen mokken."
                            },
                            {
                                "example_id": "d6efb68c-576e-4234-9160-2e589d6808ca",
                                "sense_id": "8b8359ee-1513-39bf-a7cc-f9172fb3ac2c",
                                "text": "Economische groei mag geen doel op zich meer zijn. Sterker nog, eeuwige groei is onmogelijk, aldus de Britse, want de natuur kent zoiets ook niet. Ter illustratie toont ze de groeicurve van een boom en een olifant. En inderdaad, die worden niet eeuwig groter."
                            }
                        ]
                    }
