{
    "word_family": [
        "kubek",
        "kubkowy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aba93182-ad9f-3f42-9004-344efc830465",
                    "sense_definition": "zdrobnienie od słowa <w>kubek</w>; małe naczynie do picia",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "naczynie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dziecko nalało sobie trochę ciepłego mleka do małego <w>kubeczka</w>.",
                            "target_lang_translations": {
                                "ru": "Ребёнок налил себе немного тёплого молока в маленький <w>стаканчик</w>."
                            }
                        },
                        {
                            "text": "Kupiłem w prezencie piękny ceramiczny <w>kubeczek</w> na espresso.",
                            "target_lang_translations": {
                                "ru": "Я купил в подарок красивую керамическую <w>чашечку</w> для эспрессо."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mały kubeczek",
                        "plastikowy kubeczek"
                    ],
                    "target_lang_definitions": {
                        "ru": "уменьшительное к «kubek»; небольшой сосуд для питья"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стаканчик",
                                "target_lang_sense_clarification": "небольшой стакан, обычно для напитков"
                            },
                            {
                                "target_lang_word": "кружечка",
                                "target_lang_sense_clarification": "маленькая кружка"
                            },
                            {
                                "target_lang_word": "чашечка",
                                "target_lang_sense_clarification": "маленькая чашка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11c6c3f1-62fd-368b-9a71-871c18068959",
                    "sense_definition": "niewielkie jednorazowe opakowanie z tworzywa sztucznego lub papieru na produkty spożywcze, na przykład jogurt lub śmietanę",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "opakowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do przygotowania tego ciasta potrzebny będzie jeden <w>kubeczek</w> gęstej śmietany.",
                            "target_lang_translations": {
                                "ru": "Для приготовления этого пирога понадобится один <w>стаканчик</w> густой сметаны."
                            }
                        },
                        {
                            "text": "Na drugie śniadanie zjadłem kanapkę oraz cały <w>kubeczek</w> owocowego jogurtu.",
                            "target_lang_translations": {
                                "ru": "На второй завтрак я съел бутерброд и целый <w>стаканчик</w> фруктового йогурта."
                            }
                        }
                    ],
                    "common_phrases": [
                        "kubeczek jogurtu",
                        "kubeczek śmietany"
                    ],
                    "target_lang_definitions": {
                        "ru": "небольшая пластиковая или бумажная упаковка для пищевых продуктов (например, йогурта или сметаны)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стаканчик",
                                "target_lang_sense_clarification": "упаковка для йогурта, сметаны и т. п."
                            },
                            {
                                "target_lang_word": "баночка",
                                "target_lang_sense_clarification": "небольшая пластиковая ёмкость"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}