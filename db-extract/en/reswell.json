                        "glosses": [
                            "To add liquid so as to cause a dried substance, such as a gel, to expand."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2946b2cb-051f-4056-b39d-9f60be8f3dc0",
                                "sense_id": "cb5850dd-775f-3461-8614-bff5387df38a",
                                "text": "Then gel pieces were reswelled in 50 µL of 50 mM NH4HCO3 buffer containing 12.5 ng/µL trypsin (modified porcine trypsin sequence grade, Promega, Madison, WI, USA), and incubated for 1 h at 4 °C."
                            },
                            {
                                "example_id": "7e39a513-29c1-4734-a6f2-4f4d43bfbc1f",
                                "sense_id": "cb5850dd-775f-3461-8614-bff5387df38a",
                                "text": "For membranes which have been dried out and reswollen, conditioning to the solvent is accomplished in a much shorter time than for the highly swollen cellulose."
