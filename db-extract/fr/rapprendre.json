                "senses": [
                    {
                        "sense_id": "c5117133-6ff0-32fe-8f22-2bc8bae75933",
                        "entry_id": "132ead1e-32ec-381e-997d-2c9a081d9fe2",
                        "glosses": [
                            "Apprendre de nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ee0fdf2-8260-47c0-9cbe-a63892c086f4",
                                "sense_id": "c5117133-6ff0-32fe-8f22-2bc8bae75933",
                                "text": "Cette leçon est mal sue, vous la rapprendrez."
                            },
                            {
                                "example_id": "fe916088-a09f-4946-bc09-dc8408c0ea17",
                                "sense_id": "c5117133-6ff0-32fe-8f22-2bc8bae75933",
                                "text": "Après sa maladie, il dut rapprendre à marcher."
                            },
                            {
                                "example_id": "33ae52cd-4aac-42f5-be9d-802d041aaa89",
                                "sense_id": "c5117133-6ff0-32fe-8f22-2bc8bae75933",
                                "text": "17 juin 44 – Je n’ai jamais encore rêvé de Blaise. Heureusement. Je n’ai pas à rapprendre au matin qu’il est mort."
                            },
                            {
                                "example_id": "e97cbc28-8e26-4bac-98a9-1344e64dd080",
                                "sense_id": "c5117133-6ff0-32fe-8f22-2bc8bae75933",
                                "text": "On croit bien savoir certaines choses, mais il faut les rapprendre."
                            }
                        ]
                    }
                ],
