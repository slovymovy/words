                        {
                            "text": "Ik heb <w>eventjes</w> het raam opengezet voor wat frisse lucht.",
                            "target_lang_translations": {
                                "en": "I <w>quickly</w> opened the window for some fresh air.",
                                "ru": "Я <w>быстренько</w> открыл окно, чтобы впустить свежий воздух.",
                                "pl": "Otworzyłem <w>na szybko</w> okno, żeby wpuścić trochę świeżego powietrza.",
                                "de": "Ich habe <w>schnell</w> das Fenster für etwas frische Luft geöffnet.",
                                "fr": "J'ai <w>rapidement</w> ouvert la fenêtre pour un peu d'air frais.",
                                "it": "Ho aperto <w>velocemente</w> la finestra per un po' d'aria fresca.",
                                "cs": "Jen jsem <w>rychle</w> otevřel okno, aby se vyvětralo.",
                                "tr": "Biraz temiz hava için pencereyi <w>hızlıca</w> açtım.",
                                "es": "Abrí <w>rápidamente</w> la ventana para que entrara un poco de aire fresco.",
                                "zh": "我<w>顺便</w>把窗户打开透透气。"
                            }
                        },
                        {
                            "text": "Nederlands leren doe je niet zomaar er <w>eventjes</w> tussendoor.",
                            "target_lang_translations": {
                                "en": "You don't just learn Dutch <w>quickly</w> on the side.",
                                "ru": "Голландский язык не выучишь просто так, <w>по-быстрому</w>, между делом.",
                                "pl": "Nauka niderlandzkiego to nie coś, co robi się <w>na szybko</w> przy okazji.",
                                "de": "Niederländisch lernt man nicht einfach <w>mal eben</w> nebenbei.",
                                "fr": "On n'apprend pas le néerlandais <w>vite fait</w> en passant.",
                                "it": "Non si impara l'olandese <w>al volo</w> tra una cosa e l'altra.",
                                "cs": "Nizozemštinu se nenaučíš jen tak <w>rychle</w> mezi řečí.",
                                "tr": "Hollandaca öğrenmek öyle <w>çabucak</w> aradan çıkarılacak bir şey değildir.",
                                "es": "No se aprende holandés <w>de pasada</w> y sin esfuerzo.",
                                "zh": "学习荷兰语可不是随随便便<w>顺手</w>就能学会的。"
                            }
                        }
