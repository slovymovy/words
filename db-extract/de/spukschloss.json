                "senses": [
                    {
                        "sense_id": "a005c93f-bb06-3e38-a497-b1a1d6becf42",
                        "entry_id": "ba468b93-55f0-3148-b161-90d1d7375f3c",
                        "glosses": [
                            "Schloss, in dem unerklärbare, erschreckende Dinge passieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df0b385f-a57e-45ef-947d-98fc04cad4e7",
                                "sense_id": "a005c93f-bb06-3e38-a497-b1a1d6becf42",
                                "text": "„Weder Kettengerassel im bitterkalten Spukschloss noch das Kegelschieben mit Totenköpfen lehrt den Abgebrühten das Unheimliche.“"
                            },
                            {
                                "example_id": "317c853e-e6a4-47d2-940f-5d317d9c28a9",
                                "sense_id": "a005c93f-bb06-3e38-a497-b1a1d6becf42",
                                "text": "„Das aus Edgar Wallace und auch allen anderen Spukschloss-Filmen berühmte \"Uh-Huuu\" ist nämlich nichts anderes als ein Paarungsruf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
