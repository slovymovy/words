                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "71a8d4fe-29b1-44c0-b4d1-cc7664006757",
                        "entry_id": "b443b932-6049-31fd-8b1a-fbb31ca1d6c3",
                        "tags": [
                            "plural"
                        ],
                        "form": "Ents"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3bbef30a-3cd5-35fb-b020-d495abd31ea5",
                        "entry_id": "b443b932-6049-31fd-8b1a-fbb31ca1d6c3",
                        "glosses": [
                            "Arbre antropomorphes, inventé par l’écrivain britannique J. R. R. Tolkien pour son roman Le Seigneur des anneaux."
                        ],
                        "tags": [
                            "Fantastique"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "efab07d5-1678-4a01-902d-97bc9464653d",
                        "source_entry_id": "b443b932-6049-31fd-8b1a-fbb31ca1d6c3",
                        "source_sense_id": "3bbef30a-3cd5-35fb-b020-d495abd31ea5",
                        "target_lang_word": "Ent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc9ae04b-580d-30bf-91a5-3d07571b7b46",
                                        "entry_id": "32153f42-2783-3b8a-932d-841bea854d56",
                                        "glosses": [
                                            "Alternative letter-case form of ent."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7f5e4f5-6d3d-46e3-8718-d0a15fa8f366",
                                                "sense_id": "cc9ae04b-580d-30bf-91a5-3d07571b7b46",
                                                "text": "The strange words and names that the Hobbits record as used by Treebeard and other Ents are thus Elvish, or fragments of Elf-speech strung together in Ent-fashion."
                                            },
                                            {
                                                "example_id": "21a7d634-40f7-46f7-a3e4-a2f79e1df06f",
                                                "sense_id": "cc9ae04b-580d-30bf-91a5-3d07571b7b46",
                                                "text": "Ents and Entwives, Jack thought crazily. BAD Ents and Entwives."
                                            },
                                            {
                                                "example_id": "5e8953a6-1289-4599-9203-1347935290c2",
                                                "sense_id": "cc9ae04b-580d-30bf-91a5-3d07571b7b46",
                                                "text": "Tolkien's Treebeard, his Ent creation, was inspired by Lewis, especially his sometimes emphatic deep voice"
                                            },
                                            {
                                                "example_id": "9e5470b3-375b-4d80-a9ee-3ae66bef2b42",
                                                "sense_id": "cc9ae04b-580d-30bf-91a5-3d07571b7b46",
                                                "text": "Tolkien perhaps speaks for himself when he has Treebeard confess that \"nobody cares for the woods as I care for them,\" and when this same Ent also warns that \"the withering of all woods may be drawing near\""
                                            },
                                            {
                                                "example_id": "80ccc42a-0ece-43a9-82f6-ca66e35159a8",
                                                "sense_id": "cc9ae04b-580d-30bf-91a5-3d07571b7b46",
                                                "text": "The Ents are a race of giant, tree-like people. Their purpose is to protect the electrons, though some align themselves with holes. However, as the great arrays have grown, the number of Ents has dwindled. Now they are said only to be found in the darkest and most mysterious of laboratories."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9fd462a0-77fd-4937-a072-37ed0dd78545",
                        "source_entry_id": "b443b932-6049-31fd-8b1a-fbb31ca1d6c3",
                        "source_sense_id": "3bbef30a-3cd5-35fb-b020-d495abd31ea5",
                        "target_lang_word": "ent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24b6cf9d-805b-3bc4-b84b-6978d26591f0",
                                        "entry_id": "0a25b399-a571-3932-8b77-28a42a1cddbc",
                                        "glosses": [
                                            "A large, fictional, humanoid, walking tree in works by J. R. R. Tolkien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "062cf138-5593-4a1a-8b68-13a1cb46a6b2",
                                                "sense_id": "24b6cf9d-805b-3bc4-b84b-6978d26591f0",
                                                "text": "[…]and that fine young ent Quickbeam is merely a minor crux in an Old English glossary (the name Quickbeam means 'living tree' in Old English)."
                                            },
                                            {
                                                "example_id": "15c6164c-9d76-4704-a179-d8fde284d178",
                                                "sense_id": "24b6cf9d-805b-3bc4-b84b-6978d26591f0",
                                                "text": "But this should not lead to complete avoidance, as if it is like some dire incursion of triffids or ents."
                                            },
                                            {
                                                "example_id": "c6b4f4fc-32ab-4ef7-8d31-cdfe7ecc0f25",
                                                "sense_id": "24b6cf9d-805b-3bc4-b84b-6978d26591f0",
                                                "text": "Somewhere, ents and manitous laugh grimly For, despite all this, the trees lasted much longer Than most of the presents, and all of the holiday spirit."
                                            },
                                            {
                                                "example_id": "c012daee-48bc-4b0a-b1fe-3b29eeb7f011",
                                                "sense_id": "24b6cf9d-805b-3bc4-b84b-6978d26591f0",
                                                "text": "Hello, my good friend, myself I present. Not human, nor tree, for I am an ent."
                                            },
                                            {
                                                "example_id": "932701d2-4ffc-4387-9813-62dacba11738",
                                                "sense_id": "24b6cf9d-805b-3bc4-b84b-6978d26591f0",
                                                "text": "In The Lords of the Rings there are dark forces in the forest—the Huorn. Huorn are ents who have become more treeish, gone rogue. They can still move and speak, but only with the ents."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77480200-a683-38de-b7ba-103a8e812bd5",
                                        "entry_id": "06bd3d03-e1da-3358-b545-dbaae813cd5b",
                                        "glosses": [
                                            "To pour, especially of rain."
                                        ],
                                        "tags": [
                                            "Cornwall"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a7a1738-6f31-4889-9c5a-7ab284d4083c",
                                                "sense_id": "77480200-a683-38de-b7ba-103a8e812bd5",
                                                "text": "\"[…] ent me out some beer, / Fill up my glass to quinch my thust, Weth bitter like thee'st gove me fust.\""
                                            },
                                            {
                                                "example_id": "7ceef116-ac0c-495f-a3c4-19201727bf2f",
                                                "sense_id": "77480200-a683-38de-b7ba-103a8e812bd5",
                                                "text": "A Truro correspondent remembers being sent to buy a teapot with the admonition 'and see he got a good ent to un'; that is, of course, a good 'pour'.\n\"Enting down with rain\" is still occasionally heard."
                                            },
                                            {
                                                "example_id": "a5922e02-a6d3-47c4-bd50-874c3180f33d",
                                                "sense_id": "77480200-a683-38de-b7ba-103a8e812bd5",
                                                "text": "\"And look at it enting down. I'm glad I'm not out in it.\""
                                            },
                                            {
                                                "example_id": "b0349334-02f9-4c52-bb1c-309a8e3b7ea6",
                                                "sense_id": "77480200-a683-38de-b7ba-103a8e812bd5",
                                                "text": "'Stay a space longer,' urged Music. 'Look at'n. 'Tis enting down.' 'Put yer clothes on, then,' said Katie. You'll catch yer death.' He dragged off into the scullery and presently emerged in his Sunday best."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
