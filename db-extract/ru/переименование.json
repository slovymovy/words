                                        "glosses": [
                                            "verbal noun of rename: An act in which something is renamed."
                                        ],
                                        "tags": [
                                            "form-of",
                                            "noun-from-verb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a78ca714-cf6e-493a-a179-b6953d58c074",
                                                "sense_id": "ba8c3eb3-33a2-33a5-8404-ae9a169cb414",
                                                "text": "Community Board 4 also generally opposes requests for street renamings, according to Robert J. Benfatto Jr., the district manager."
                                            },
                                            {
                                                "example_id": "57cdc03b-6db7-4330-b1ee-0f9b8c67f76b",
                                                "sense_id": "ba8c3eb3-33a2-33a5-8404-ae9a169cb414",
                                                "text": "The executive order calls for all federal government maps and documents to “reflect its renaming.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "004e7bc2-6cf7-419c-baef-e96f45998104",
                        "source_entry_id": "8f5b5c1f-1626-3883-8e02-4eeb1cae1690",
