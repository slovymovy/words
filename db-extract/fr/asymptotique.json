                "senses": [
                    {
                        "sense_id": "35c0a548-65f0-3859-9c6c-75b8104d8d07",
                        "entry_id": "74d297d7-b463-3899-8076-e77e3ca64a2d",
                        "glosses": [
                            "Qui a rapport à l’asymptote. Il signifie couramment qu'une tendance tend vers une droite (un maximal théorique) en s'en rapprochant de plus en plus sans jamais l'atteindre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0a0a7f0-a072-40a1-8332-cd991afe16c6",
                                "sense_id": "35c0a548-65f0-3859-9c6c-75b8104d8d07",
                                "text": "Point asymptotique."
                            },
                            {
                                "example_id": "105a3193-1d08-4136-a885-f3968d5f6415",
                                "sense_id": "35c0a548-65f0-3859-9c6c-75b8104d8d07",
                                "text": "Courbe asymptotique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7f85a18-36bd-46f4-a61c-57fffd508d04",
                        "source_entry_id": "74d297d7-b463-3899-8076-e77e3ca64a2d",
                        "source_sense_id": "35c0a548-65f0-3859-9c6c-75b8104d8d07",
                        "target_lang_word": "asymptotisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
