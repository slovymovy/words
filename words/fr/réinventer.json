{
    "word_family": [
        "inventer",
        "inventeur",
        "inventif",
        "invention",
        "inventivité",
        "réinvention"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "392a3a95-03b8-3fa1-817e-d5b33798fefe",
                    "sense_definition": "Renouveler entièrement, repenser les principes ou les méthodes de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "renouvellement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle équipe tente de <w>réinventer</w> les méthodes de travail afin d'augmenter la productivité."
                        },
                        {
                            "text": "L'architecte souhaite <w>réinventer</w> l'espace urbain pour favoriser les déplacements à pied."
                        }
                    ],
                    "common_phrases": [
                        "réinventer les règles",
                        "réinventer le modèle"
                    ]
                },
                {
                    "sense_id": "72f531c9-5bee-39c4-a23f-80dc0807b1c7",
                    "sense_definition": "Changer en profondeur son style, son image ou son mode de vie afin d'évoluer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "renouvellement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après cet échec commercial, le musicien a su se <w>réinventer</w> avec un album acoustique remarquable."
                        },
                        {
                            "text": "Pour survivre sur un marché très concurrentiel, cette entreprise doit constamment se <w>réinventer</w>."
                        }
                    ],
                    "synonyms": [
                        "se renouveler"
                    ],
                    "common_phrases": [
                        "se réinventer sans cesse"
                    ]
                },
                {
                    "sense_id": "63e77d2f-551a-3dd4-b535-2f8ae0b10462",
                    "sense_definition": "Inventer de nouveau une chose qui existait déjà ou qui avait été oubliée.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Des ingénieurs ont fini par <w>réinventer</w> un procédé déjà décrit dans d'anciens manuels techniques."
                        },
                        {
                            "text": "Il ne sert à rien de vouloir <w>réinventer</w> la roue quand une solution efficace existe déjà."
                        }
                    ],
                    "common_phrases": [
                        "réinventer la roue"
                    ]
                }
            ]
        }
    ]
}