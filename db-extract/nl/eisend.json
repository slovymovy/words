                    {
                        "sense_id": "fbeb4d81-baeb-320c-ad52-69c47e5e2f7a",
                        "entry_id": "c5de2024-8390-34e3-9fd1-d11baef48d1e",
                        "glosses": [
                            "onvoltooid deelwoord van eisen"
                        ],
