                        "glosses": [
                            "Pneumopathie nosocomiale acquise sous ventilation mécanique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39a61af8-5eb3-41da-8755-55070fd2380c",
                                "sense_id": "d21860be-4a2c-3071-a847-a87f9c28dd5e",
                                "text": "L’ancien modèle physiopathologique de la PNAVM reposait sur le passage de sécrétions oropharyngées, colonisées par une flore « pathogène » autour du ballonnet de la sonde d’intubation et sur la présence précoce d’un biofilm dans et autour de cette sonde."
                            },
                            {
                                "example_id": "1753f463-e439-473b-bd8d-26dd5dd4c8d1",
                                "sense_id": "d21860be-4a2c-3071-a847-a87f9c28dd5e",
                                "text": "Conclusion : Les PNAVM sont responsables d'une mortalité importante et d'un coût élevé des soins."
                            },
                            {
                                "example_id": "11812b21-075f-4b6b-8e87-d4729a6e1d31",
                                "sense_id": "d21860be-4a2c-3071-a847-a87f9c28dd5e",
                                "text": "Récemment, plusieurs équipes on rapporté l’absence de sur-incidence de P.N.A.V.M. lors de l’utilisation d’anti-H² (49, 51, 62, 71) ou d’antiacides (8)."
                            }
                        ]
                    }
