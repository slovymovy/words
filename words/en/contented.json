    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0650a2ff-51da-3d2b-9500-e70280851297",
                    "sense_definition": "Feeling or showing satisfaction with one's possessions, status, or situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "satisfaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt <w>contented</w> with her simple life in the countryside.",
                            "target_lang_translations": {
                                "tr": "Kırsaldaki sade hayatından <w>memnun</w> hissediyordu."
                            }
                        },
                        {
                            "text": "The <w>contented</w> cat purred softly while sleeping on the warm rug.",
                            "target_lang_translations": {
                                "tr": "<w>Halinden memnun</w> kedi, sıcak halının üzerinde uyurken hafifçe mırıldanıyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "satisfied",
                        "happy",
                        "pleased"
                    ],
                    "antonyms": [
                        "discontented",
                        "dissatisfied"
                    ],
                    "common_phrases": [
                        "look contented",
                        "feel contented"
                    ],
                    "target_lang_definitions": {
                        "tr": "Sahip olduklarından, durumundan veya konumundan memnun olma hali."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "memnun",
                                "target_lang_sense_clarification": "Bir durumdan veya sonuçtan duyulan genel memnuniyet."
                            },
                            {
                                "target_lang_word": "halinden memnun",
                                "target_lang_sense_clarification": "Kendi durumundan şikayetçi olmayan, huzurlu kişi."
                            },
                            {
                                "target_lang_word": "huzurlu",
                                "target_lang_sense_clarification": "İçsel bir tatmin ve sükunet duygusu taşıyan."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aa51ca62-318d-3322-8d37-bebc325fe3cf",
                    "sense_definition": "Simple past and past participle of <w>content</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "satisfaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>contented</w> himself with a small snack before dinner.",
                            "target_lang_translations": {
                                "tr": "Akşam yemeğinden önce küçük bir atıştırmalıkla <w>yetindi</w>."
                            }
                        },
                        {
                            "text": "She has <w>contented</w> herself with the results of the exam.",
                            "target_lang_translations": {
                                "tr": "Sınav sonuçlarıyla <w>yetindi</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Yetinmek veya razı olmak anlamındaki 'content' fiilinin geçmiş zaman veya ortaç hali."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yetindi",
                                "target_lang_sense_clarification": "Daha fazlasını istemeyip elindekini yeterli bulma eylemi."
                            },
                            {
                                "target_lang_word": "razı oldu",
                                "target_lang_sense_clarification": "Bir duruma veya sonuca itiraz etmeden kabul etme."
                            }
                        ]
                    }
                }
            ]
        }
    ]
