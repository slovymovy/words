                ],
                "senses": [
                    {
                        "sense_id": "24be03b3-e9a4-3eda-a90e-c88533213ed9",
                        "entry_id": "d3f6dfc4-ef3d-39e4-917e-2467fc0ce2b7",
                        "glosses": [
                            "monarchisch regiertes Gebiet Österreich-Ungarn zwischen 1867 und 1918"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42647f33-3039-4cff-ab73-aef9d9bff743",
                                "sense_id": "24be03b3-e9a4-3eda-a90e-c88533213ed9",
                                "text": "„Die Donaumonarchie aber hatte ihrerseits mit einem säularen Problem u ringen, der Nationalitätenbewegung der Slawen, namentlich der Südslawen und Tschechen.“"
                            },
                            {
                                "example_id": "c6acb5e3-0e6d-4e8a-af7c-4177304bafbb",
                                "sense_id": "24be03b3-e9a4-3eda-a90e-c88533213ed9",
                                "text": "„Allfälliger Kontrahent und eventueller Partner der Donaumonarchie in ihrer Balkanpolitik war in erster Linie das Zarenreich.“"
                            },
                            {
                                "example_id": "bb6271eb-d558-4fab-bf4a-0d6275780d0e",
                                "sense_id": "24be03b3-e9a4-3eda-a90e-c88533213ed9",
                                "text": "„Landmann ist noch im Galizien der Donaumonarchie zur Welt gekommen, lebte seit ihrer Kindheit aber in der Schweiz und machte dort eine erstaunliche Karriere.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
