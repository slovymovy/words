                "senses": [
                    {
                        "sense_id": "83225d9a-c073-3fd3-ae28-6fb3a613b0ed",
                        "entry_id": "fa5ac155-e539-3e09-b2f4-3e42d995964d",
                        "glosses": [
                            "Personne atteinte de daltonisme, c’est-à-dire ne différenciant pas certaines couleurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a7cb0ab-1a49-4c95-9789-665caa44d3da",
                                "sense_id": "83225d9a-c073-3fd3-ae28-6fb3a613b0ed",
                                "text": "La première question que l’on pose toujours concernant le daltonisme est : « Comment le daltonien voit-il le monde qui l’entoure? »"
                            },
                            {
                                "example_id": "900acc0a-acb7-46e9-91f0-ff406ffb1ba9",
                                "sense_id": "83225d9a-c073-3fd3-ae28-6fb3a613b0ed",
                                "text": "Georges déclara à Liane qu’elle était une ravissante petite fée bleue ; elle portait une robe verte. Georges n’était pas daltonien, il savait surprendre les femmes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c927e2a-8d5e-4f99-afef-9eb23b6419a6",
                        "source_entry_id": "fa5ac155-e539-3e09-b2f4-3e42d995964d",
                        "source_sense_id": "83225d9a-c073-3fd3-ae28-6fb3a613b0ed",
                        "target_lang_word": "дальтоник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "дальтоник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "dc1a652a-27f1-3682-886a-6969cfdc0948",
                                        "entry_id": "d0880581-c789-3cd3-ad9f-605862dbe95f",
                                        "glosses": [
                                            "тот, кто страдает дальтонизмом, кто в силу врождённого недостатка зрения неспособен различать некоторые цвета (обычно красный и зелёный)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c3ae2da-feac-4ed4-ad55-849a78a668f2",
                                                "sense_id": "dc1a652a-27f1-3682-886a-6969cfdc0948",
                                                "text": "Так я узнал, что я дальтоник, что доставило мне впоследствии немало неприятностей при получении водительских прав."
                                            }
