                "senses": [
                    {
                        "sense_id": "d8255e9f-fdc8-31b2-ae92-9da92ee7e27e",
                        "entry_id": "e5967e3f-471a-3efb-9b36-99254edfd5d7",
                        "glosses": [
                            "van niet al te beste kwaliteit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a848e6c-0014-4054-bdd5-9a4efa6947bf",
                                "sense_id": "d8255e9f-fdc8-31b2-ae92-9da92ee7e27e",
                                "text": "Schoonpapa klaagde al na één dag over zijn rug (´Dat lorrige bed!´), over het eten (`ze gooien hier overal olijfolie in!´) en over de bedtijd van de kinderen (`Tien uur is véél te laat´). Het kwam nooit meer helemaal goed."
                            },
                            {
                                "example_id": "5ee675ec-2517-4ac0-b2a2-a4eff13be4ae",
                                "sense_id": "d8255e9f-fdc8-31b2-ae92-9da92ee7e27e",
                                "text": "Het woord ‘lorrig’ gaf in jouw vocabulaire een scala van situaties aan die varieerden van ‘niet zo bijzonder’, ook als het jezelf betrof, tot ‘niet in de haak’ of ‘slordig’ in tal van situaties."
                            }
                        ]
                    }
