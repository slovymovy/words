                    {
                        "sense_id": "d91f37b7-9ef6-3904-bfb9-f4c8433fb846",
                        "entry_id": "aa00aca2-825d-3d46-811f-11d4e8a33b14",
                        "glosses": [
                            "sensationelle, exklusiv veröffentlichte Meldung"
