                    },
                    {
                        "translation_id": "88a521ae-63f4-4c9b-9098-b935a9a84371",
                        "source_entry_id": "f9242b2a-1f8f-3ef4-8383-dc8520fb368c",
                        "source_sense_id": "75ca9935-79c7-37fa-94f9-8da3af1fc361",
                        "source_sense_description": "vorurteilsbeladenes Konzept eines erklärten Gegners von einer Gruppe von Menschen gleicher Gesinnung oder Ausrichtung",
                        "target_lang_word": "spectre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spectre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c5f5626-6103-3740-8144-0ec8ca6ec634",
                                        "entry_id": "995c9e4c-b68f-3b55-a13f-24ffaaf193bc",
                                        "glosses": [
                                            "Fantôme, apparition d’un mort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b73c28b0-5123-4603-8260-5553064d0694",
                                                "sense_id": "8c5f5626-6103-3740-8144-0ec8ca6ec634",
                                                "text": "Comment expliquerez-vous, docteur, que des coups donnés par des spectres ont pu faire naître des places noires sur le corps de celui qui les a reçus ?"
                                            },
                                            {
                                                "example_id": "f1b05e3c-d8bd-491e-b355-9b861abce288",
                                                "sense_id": "8c5f5626-6103-3740-8144-0ec8ca6ec634",
                                                "text": "Une petite pluie mince et tenace dégoulinait sans arrêt depuis la veille et les passants, recroquevillés sous leurs riflards, les yeux rivés sur le pavé en larmes, glissant peureusement parmi les files des voitures serrées, lui fournissaient l’impression vague de spectres titubants."
                                            },
                                            {
                                                "example_id": "171dcb6c-81f6-41d9-95c4-e6ca2fa28781",
                                                "sense_id": "8c5f5626-6103-3740-8144-0ec8ca6ec634",
                                                "text": "[…] le spectre de Marguerite, spectre que chaque fois que j’assistai à Faust je fus navré de ne pas même apercevoir, quels que fussent mes efforts et si éperdument que je me penchasse par-dessus le rebord pelucheux de la loge, car il ne se manifestait que très fuligineux et sur le côté droit de la scène."
                                            },
                                            {
                                                "example_id": "6626d8e2-604b-4b11-97fc-3ceaeb51025f",
                                                "sense_id": "8c5f5626-6103-3740-8144-0ec8ca6ec634",
                                                "text": "— Où SOS Fantômes passe, les spectres trépassent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c73929c3-1ce3-3e62-8729-e89f48150ac5",
                                        "entry_id": "995c9e4c-b68f-3b55-a13f-24ffaaf193bc",
                                        "glosses": [
                                            "Souvenir de personnes disparues."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "955b6553-fbc3-492e-ab5b-cd5eb6925caa",
                                                "sense_id": "c73929c3-1ce3-3e62-8729-e89f48150ac5",
                                                "text": "Jamais les spectres des morts du 6 Février ne quitteront plus ces hommes, malgré leurs fanfaronnades, leurs plastronnades, leurs mensonges, leurs ricanements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5a2b165-9ff0-3bb8-a4b1-dcc415f158b7",
                                        "entry_id": "995c9e4c-b68f-3b55-a13f-24ffaaf193bc",
                                        "glosses": [
                                            "Évocation ou apparition effrayante."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e04ab3f4-7ff9-4d6d-92d0-6016e34cb866",
                                                "sense_id": "f5a2b165-9ff0-3bb8-a4b1-dcc415f158b7",
                                                "text": "Le spectre de la guerre n’étendait pas alors son ombre sur le monde."
                                            },
                                            {
                                                "example_id": "9f96a2bd-0b63-4e72-8763-40a4cfce7b97",
                                                "sense_id": "f5a2b165-9ff0-3bb8-a4b1-dcc415f158b7",
                                                "text": "Au regard d’Eugène quand parfois il l’accompagne, je vois la fierté du père, la fierté qui se dit Germain est déjà un petit Eugène et c’est bien ainsi, de plus en plus fort l’enfant qui s’éloigne du spectre de la mort prématurée même si rien n’est jamais gagné."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c69011fc-9a00-35ae-8197-c78499dac416",
                                        "entry_id": "995c9e4c-b68f-3b55-a13f-24ffaaf193bc",
                                        "glosses": [
                                            "Personne hâve et maigre à faire peur."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2afe5bfa-908c-4fea-a3bf-a9a390293f14",
                                                "sense_id": "c69011fc-9a00-35ae-8197-c78499dac416",
                                                "text": "C’est un spectre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1e28d63-2652-3bfd-8bf9-2b12cbc1488c",
                                        "entry_id": "995c9e4c-b68f-3b55-a13f-24ffaaf193bc",
                                        "glosses": [
                                            "Chimère qu’on se forme dans l’esprit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bd820a5-7aaf-4fbb-babe-4050601e532f",
                                                "sense_id": "f1e28d63-2652-3bfd-8bf9-2b12cbc1488c",
                                                "text": "Un seul mot fera tiquer Yvan et les siens : « souchiens ». Un néologisme pour remplacer « Français de souche ». Le mot donne soudain vie à des spectres, les Français de souche. Des fantômes en qui l’on peut bien croire, mais dont l’existence n’a encore jamais été démontrée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c811720-ea73-3eae-832f-d36e9341544c",
                                        "entry_id": "995c9e4c-b68f-3b55-a13f-24ffaaf193bc",
                                        "glosses": [
                                            "Ensemble des rayonnements de différentes longueurs d’onde, qui résultent de la décomposition de la lumière par un prisme, d’un élément chimique à l’état excité, etc."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71d4fac8-d4a5-4ff3-ba69-db7fd346c901",
                                                "sense_id": "0c811720-ea73-3eae-832f-d36e9341544c",
                                                "text": "Soumis à l’action de plusieurs sources lumineuses différemment colorées, il se dirige, en général, vers celle dont la couleur avoisine le plus l’extrémité violette du spectre […]."
                                            },
                                            {
                                                "example_id": "0a7bcea5-2049-4123-ac5c-75730a7ba218",
                                                "sense_id": "0c811720-ea73-3eae-832f-d36e9341544c",
                                                "text": "Le fer, en particulier, a un spectre total (visible et photographiable) ne renfermant pas moins de 5000 raies; […]."
                                            },
                                            {
                                                "example_id": "a6eb21e7-90f8-4e04-8086-e467bf98f421",
                                                "sense_id": "0c811720-ea73-3eae-832f-d36e9341544c",
                                                "text": "[…]; la netteté décroit rapidement et les objets brillamment éclairés sont entourés d'une frange colorée où l’on retrouve toutes les couleurs du spectre."
                                            },
                                            {
                                                "example_id": "f155a038-a2c7-43fb-91d8-5ebab0c30afd",
                                                "sense_id": "0c811720-ea73-3eae-832f-d36e9341544c",
                                                "text": "Le salpêtre est aisément reconnaissable par la couleur violette de sa flamme, due au spectre du potassium."
                                            },
                                            {
                                                "example_id": "389567f7-c55b-4395-865e-c8d080a3a35f",
                                                "sense_id": "0c811720-ea73-3eae-832f-d36e9341544c",
                                                "text": "La photographie ultraviolette, qui sert souvent à des fins scientifiques, médicales ou artistiques, utilise uniquement la lumière du spectre ultraviolet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7e132c9-9f4e-367b-b9e5-67fcfe3df794",
                                        "entry_id": "995c9e4c-b68f-3b55-a13f-24ffaaf193bc",
                                        "glosses": [
                                            "Ensemble des valeurs propres d'un opérateur ou d'une matrice."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bec31e04-c638-30a3-b972-0efd44cae5df",
                                        "entry_id": "995c9e4c-b68f-3b55-a13f-24ffaaf193bc",
                                        "glosses": [
                                            "Ensemble de choses assez semblables dont les variations sont déterminées."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f82fe760-417c-4ecb-8cc7-5dc86f38911d",
                                                "sense_id": "bec31e04-c638-30a3-b972-0efd44cae5df",
                                                "text": "Le spectre biologique de notre Arrhénathéraie sous-vosgienne s’établit ainsi : […].\nÀ titre documentaire, nous reproduisons conjointement les spectres qu’ont publiés différents auteurs pour les prairies mésophiles de diverses régions françaises : […]."
                                            },
                                            {
                                                "example_id": "301b64d4-f1b2-4c01-bc86-5c5a809b986b",
                                                "sense_id": "bec31e04-c638-30a3-b972-0efd44cae5df",
                                                "text": "Comme on peut le voir le spectre ADSL contient trois canaux : la voix humaine, la voie montante et la voie descendante."
                                            },
                                            {
                                                "example_id": "6aea92d3-a5bf-47fc-b8b3-e82b40551226",
                                                "sense_id": "bec31e04-c638-30a3-b972-0efd44cae5df",
                                                "text": "Autant dire qu’avec un spectre d’opinions aussi réduit, la contradiction aurait été surprenante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82569bc2-1bb5-388f-bc8c-3432656d2e67",
                                        "entry_id": "995c9e4c-b68f-3b55-a13f-24ffaaf193bc",
                                        "glosses": [
                                            "Ensemble des agents infectieux, contaminants ou pathogènes qui sont atteints par une substance curative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b65fd38-6c41-44d6-8cd3-2a599947bd93",
                                                "sense_id": "82569bc2-1bb5-388f-bc8c-3432656d2e67",
                                                "text": "En prescrivant des antibiotiques sophistiqués ou à large spectre, il cherche à « écraser une mouche avec un marteau », enrichit les laboratoires et contribue au pillage de la Sécurité sociale."
                                            },
                                            {
                                                "example_id": "3056ce16-12f2-4549-a05e-65ac30fa5968",
                                                "sense_id": "82569bc2-1bb5-388f-bc8c-3432656d2e67",
                                                "text": "L’azoxystrobine possède un large spectre sur les champignons pathogènes de la vigne : le mildiou, l’oïdium, le black-rot, le rougeot parasitaire, l’excoriose. Une efficacité secondaire sur la pourriture grise (Botrytis cinerea) a été observée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
