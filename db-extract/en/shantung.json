                ],
                "senses": [
                    {
                        "sense_id": "70d1f044-78d2-3614-b5e5-766c06c86363",
                        "entry_id": "ccf08d81-cb90-364c-aea1-6d47f83dba33",
                        "glosses": [
                            "A type of Chinese silk, originally undyed."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3b2c89d6-1f3c-41c4-8ba3-43d8866690e7",
                                "sense_id": "70d1f044-78d2-3614-b5e5-766c06c86363",
                                "text": "As she walked, the soft silk of her dress – she wore a blue shantung, full-skirted – blew away from the sea and flapped and clung to her legs."
                            },
                            {
                                "example_id": "b8d48982-0647-4fc8-94ed-6cb45c26abc1",
                                "sense_id": "70d1f044-78d2-3614-b5e5-766c06c86363",
                                "text": "The yellow beer, the light shantung suit and the gleaming white teeth were all alight with the trembling silver reflections that sprang from the sunlight on the water."
                            }
                        ]
                    },
                    {
                        "sense_id": "0bb48359-4ebc-3bb1-92c3-fd3868cbc0c0",
                        "entry_id": "ccf08d81-cb90-364c-aea1-6d47f83dba33",
                        "glosses": [
                            "A fabric of some other material having the same characteristics."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "73704f5d-2a52-481d-a21b-5a3e915d8bd0",
                        "source_entry_id": "ccf08d81-cb90-364c-aea1-6d47f83dba33",
                        "source_sense_description": "fabric",
                        "target_lang_word": "чесуча́",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "чесуча́",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "18ee0278-d75a-31f2-b4b4-043ca517ce47",
                                        "entry_id": "5985ef15-0cd2-3b97-af9f-d9823f4993c1",
                                        "glosses": [
                                            "текст. плотная шёлковая ткань полотняного переплетения обычно желтовато-песочного цвета"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73a791ad-04c2-4e8a-8c11-028bab88d55d",
                                                "sense_id": "18ee0278-d75a-31f2-b4b4-043ca517ce47",
                                                "text": "На московской бирже в последние дни появилось много китайцев, которые производят здесь операции с чаем и чесучой."
                                            },
                                            {
                                                "example_id": "268dc54a-9720-4d63-bafc-791c809e8e5f",
                                                "sense_id": "18ee0278-d75a-31f2-b4b4-043ca517ce47",
                                                "text": "Подрясник из чесучи ловко охватывал его стройную фигуру, и невольно приходило в голову, почему на нём подрясник, а не военный китель."
                                            },
                                            {
                                                "example_id": "600b90d6-e286-493b-a198-4e8ac147140e",
                                                "sense_id": "18ee0278-d75a-31f2-b4b4-043ca517ce47",
                                                "text": "Она была в розовом платье, он же в безукоризненном сюртуке из китайской чесучи, и широкая улыбка не покидала лица бывшего кавалергарда."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd435783-a08d-316c-b6a7-69d61b07eceb",
                                        "entry_id": "5985ef15-0cd2-3b97-af9f-d9823f4993c1",
                                        "glosses": [
                                            "разг., ед. ч. одежда из такой ткани"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "620da1db-7ac3-4c4e-851a-f490fb5888b1",
                                                "sense_id": "bd435783-a08d-316c-b6a7-69d61b07eceb",
                                                "text": "Пожилой счастливый человек в чесуче пьёт двухсуточный кефир за столиком приморского кафе."
                                            },
                                            {
                                                "example_id": "dd122b14-4651-4340-b3b2-64e916f5b305",
                                                "sense_id": "bd435783-a08d-316c-b6a7-69d61b07eceb",
                                                "text": "Поехали с нами, мы тебя министром, понимаешь, сделаем, в чесуче ходить будешь, на «Победе» раскатывать!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
