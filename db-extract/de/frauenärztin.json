                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9878b1b-077d-4b96-b98b-cfe987b3e1a7",
                                "sense_id": "99cecc75-70e6-3774-8073-2cdd814b3b7c",
                                "text": "Carola hat einen Termin bei ihrer Frauenärztin."
                            },
                            {
                                "example_id": "10d3846f-093e-4599-9ad8-78cabeb549e8",
                                "sense_id": "99cecc75-70e6-3774-8073-2cdd814b3b7c",
                                "text": "„Ausgerechnet eine deutsche Frauenärztin namens Anna Fischer-Dückelmann, ausgestattet mit drei Kindern und einer scharfen Zunge, wagte es 1901, das Tabu zu brechen und den Gebrauch des Bidets zu empfehlen.“"
                            }
                        ],
