                    "sense_id": "665e2830-327d-319e-ba3d-e7024785c236",
                    "sense_definition": "Краткая форма среднего рода прилагательного <w>шумный</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "adjective_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Море сегодня <w>шумно</w> и неспокойно, волны бьются о берег.",
                            "target_lang_translations": {
                                "en": "The sea is <w>noisy</w> and rough today, waves are beating against the shore.",
                                "de": "Das Meer ist heute <w>laut</w> und unruhig, die Wellen schlagen gegen das Ufer."
                            }
                        },
                        {
                            "text": "Это торжество было <w>шумно</w>, многолюдно и весело.",
                            "target_lang_translations": {
                                "en": "This celebration was <w>noisy</w>, crowded, and fun.",
                                "de": "Diese Feier war <w>laut</w>, überfüllt und fröhlich."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short neuter singular"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Characterized by making or being full of noise (short form adjective).",
                        "de": "Gekennzeichnet durch das Verursachen von Lärm oder das Erfülltsein von Lärm (Kurzform des Adjektivs)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "noisy",
                                "target_lang_sense_clarification": "adjective describing a subject"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "laut",
