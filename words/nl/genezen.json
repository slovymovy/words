                    "sense_id": "6ac8c279-4fa0-3ea1-8009-f25fb7ee4bbf",
                    "sense_definition": "gezond worden of herstellen van een ziekte of verwonding",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "herstel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was een wonder dat zij zo snel van deze dodelijke ziekte <w>genazen</w>.",
                            "target_lang_translations": {
                                "en": "It was a miracle that they <w>recovered</w> so quickly from this deadly disease.",
                                "ru": "Это было чудом, что они так быстро <w>выздоровели</w> от этой смертельной болезни."
                            }
                        },
                        {
                            "text": "De diepe wond heeft tijd nodig om volledig te <w>genezen</w>.",
                            "target_lang_translations": {
                                "en": "The deep wound needs time to <w>heal</w> completely.",
                                "ru": "Глубокой ране нужно время, чтобы полностью <w>зажить</w>."
                            }
