                        "glosses": [
                            "złośliwy nowotwór tkanki łącznej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b14d980e-1a98-4632-ade3-9feaef3ddbb4",
                                "sense_id": "598168b4-befe-3fe2-ad25-f41b4ee00cf9",
                                "text": "Wskazaniami do stosowania cyklofosfamidu są m.in. ostre białaczki i mięsaki."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24df9ebd-c640-4f4c-875d-d8a0588c535d",
                        "source_entry_id": "ff370b68-37fb-3e1f-9f58-77140f86a9ff",
                        "source_sense_id": "598168b4-befe-3fe2-ad25-f41b4ee00cf9",
                        "target_lang_word": "sarcoma",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sarcoma",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "538725db-1726-3427-9ebf-321525f30c5a",
                                        "entry_id": "9c1c105c-d40d-34e2-bb28-bf0fc026fac8",
                                        "glosses": [
                                            "A type of malignant tumor of the bone, cartilage, fat, muscle, blood vessels, or other connective or supportive tissue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdaa5d50-7732-45ba-8234-7c709164bd88",
                                                "sense_id": "538725db-1726-3427-9ebf-321525f30c5a",
                                                "text": "Only about 1 per cent of cancers are found in connective tissue; these are known as sarcomas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07d6cfbb-6cba-4940-be95-37f28743ddb9",
                        "source_entry_id": "ff370b68-37fb-3e1f-9f58-77140f86a9ff",
                        "source_sense_id": "598168b4-befe-3fe2-ad25-f41b4ee00cf9",
                        "target_lang_word": "sarcome",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sarcome",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8145b205-53c8-37b0-9dc0-fbfc636e24bb",
                                        "entry_id": "21225240-425a-3fc5-88f0-a62ffab30dad",
                                        "glosses": [
                                            "Tumeur qui a la consistance de la chair qui se forme aux dépens du tissu conjonctif ou des tissus qui en dérivent comme le tissu musculaire, l'os."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b414c95-e281-4f7f-8595-1af42933c96c",
                                                "sense_id": "8145b205-53c8-37b0-9dc0-fbfc636e24bb",
                                                "text": "D’après les analyses, la tumeur était un sarcome d’une extrême virulence, qui avait commencé d’essaimer dans tout l’organisme."
                                            },
                                            {
                                                "example_id": "627cea76-e355-49ab-a172-48553f88816b",
                                                "sense_id": "8145b205-53c8-37b0-9dc0-fbfc636e24bb",
                                                "text": "La coupe de la tumeur montra le sarcome et le gigantome très voisins l'un de l'autre … offrant des fibroblastes normaux et sans réaction inflammatoire"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72fec999-75e4-47ae-9d05-af82697acf4d",
                        "source_entry_id": "ff370b68-37fb-3e1f-9f58-77140f86a9ff",
                        "source_sense_id": "598168b4-befe-3fe2-ad25-f41b4ee00cf9",
                        "target_lang_word": "sarcoma",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c49dc591-0d8a-4abe-a048-12a7adaa52fe",
                        "source_entry_id": "ff370b68-37fb-3e1f-9f58-77140f86a9ff",
                        "source_sense_id": "598168b4-befe-3fe2-ad25-f41b4ee00cf9",
                        "target_lang_word": "саркома",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "саркома",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3da3fad0-6c31-3c01-a341-d49fc785796a",
                                        "entry_id": "e744549f-7f35-34e9-b968-beed0d5937bd",
                                        "glosses": [
                                            "мед. злокачественная опухоль из различных типов соединительной ткани: эмбриональной, костной, мышечной и др."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8614834c-df42-4cb7-9f1f-d7fe27e4fd99",
                                                "sense_id": "3da3fad0-6c31-3c01-a341-d49fc785796a",
                                                "text": "И, в самом деле, ― тут неизвестный повернулся к Берлиозу, ― вообразите, что вы, например, начнёте управлять, распоряжаться и другими и собою, вообще, так сказать, входить во вкус, и вдруг у вас… кхе… кхе… саркома лёгкого…― тут иностранец сладко усмехнулся, как будто мысль о саркоме лёгкого доставила ему удовольствие, ― да, саркома, ― жмурясь, как кот, повторил он звучное слово, ― и вот ваше управление закончилось!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
