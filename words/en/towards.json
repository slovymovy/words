                                "tr": "Solda Jungfrau yükseliyor ve tren doğrudan <w>ona doğru</w> ilerliyor.",
                                "es": "A la izquierda se alza el Jungfrau, con el tren dirigiéndose directamente <w>hacia</w> él."
                            }
                        },
                        {
                            "text": "She started walking <w>towards</w> the city center.",
                            "target_lang_translations": {
                                "ru": "Она пошла <w>в сторону</w> центра города.",
                                "zh": "她开始<w>向</w>市中心走去。",
                                "nl": "Ze begon te lopen <w>in de richting van</w> het stadscentrum.",
                                "pl": "Zaczęła iść <w>w kierunku</w> centrum miasta.",
                                "de": "Sie begann, <w>in Richtung</w> Stadtzentrum zu gehen.",
                                "fr": "Elle a commencé à marcher <w>vers</w> le centre-ville.",
                                "it": "Ha iniziato a camminare <w>verso</w> il centro città.",
                                "cs": "Začala jít <w>směrem k</w> centru města.",
                                "tr": "Şehir merkezine <w>doğru</w> yürümeye başladı.",
                                "es": "Ella comenzó a caminar <w>hacia</w> el centro de la ciudad."
                            }
