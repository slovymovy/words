                        "glosses": [
                            "Qui peut être détenu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29531604-4c68-4497-9991-e2f4335e6f6d",
                                "sense_id": "261239fe-15da-3723-9578-ce3f89bfb9f6",
                                "text": "Les autorités sud-coréennes reconnaissent que la réglementation limite encore les possibilités d’investissement, fixant notamment à 15 % le plafond d’actions détenables dans les grands conglomérats coréens par des entreprises étrangères."
                            },
                            {
                                "example_id": "9e4b0b4a-74af-4aca-834a-b640b363c7db",
                                "sense_id": "261239fe-15da-3723-9578-ce3f89bfb9f6",
                                "text": "La capacité juridique ne s’acquiert pas, elle est détenue par toute personne, ou « détenable » pour les mineurs qui deviendront capables par le seul passage à l’âge de la majorité."
                            },
                            {
                                "example_id": "cc0ae2b2-2477-472d-81b0-a2c287a6797d",
                                "sense_id": "261239fe-15da-3723-9578-ce3f89bfb9f6",
                                "text": "Le castor n’est donc pas capturable, ni détenable, ni à vendre, qu’il soit mort ou vivant."
                            }
                        ]
                    }
