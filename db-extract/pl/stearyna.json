                        "glosses": [
                            "biała lub żółtawa substancja, będąca mieszaniną kwasu palmitynowego, kwasu stearynowego oraz nieznacznej ilości kwasów nienasyconych, stosowana m.in. do produkcji świec, mydeł, past, a także w farmacji i przemyśle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7d55ef8-73c9-40bb-afb3-5eee2fbf836f",
                                "sense_id": "4780979e-bc06-36ec-a724-b12ba4a8c1a9",
                                "text": "Stearyna może mieć różny stopień uwodornienia."
                            }
                        ],
