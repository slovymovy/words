                                                "sense_id": "2dc1f818-3a42-3a28-949b-85280ffa4728",
                                                "text": "Die in Nordamerika lebenden Wapitis sind direkte Nachfahren der Rothirsche (Cervus elaphus) Europas und Asiens."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
