                "senses": [
                    {
                        "sense_id": "79ce77ef-1d65-3e85-b9fa-beba65d757ec",
                        "entry_id": "aff875fd-fc5b-33db-b017-a73ffbfe9167",
                        "glosses": [
                            "Convertir aux smartphones."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a30302a-eca8-43d3-8297-b953537e3b44",
                                "sense_id": "79ce77ef-1d65-3e85-b9fa-beba65d757ec",
                                "text": "On ne sait jamais avec leurs délire merdique de smartphoniser le cycle des consoles..."
                            },
                            {
                                "example_id": "49002812-9254-4af3-b8fc-35e0c0226c51",
                                "sense_id": "79ce77ef-1d65-3e85-b9fa-beba65d757ec",
                                "text": "La Scorpio comme la PS4 Pro est une tentative de smartphoniser le marché parce qu'ils flippent (a juste titre à mon sens) de voir le marché se contracter, et pas qu'un peu."
                            }
                        ]
                    },
                    {
                        "sense_id": "43d81d2b-7f32-39dd-8daa-c744771848b9",
                        "entry_id": "aff875fd-fc5b-33db-b017-a73ffbfe9167",
                        "glosses": [
                            "S’équiper en smartphone."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "7cca1023-171d-40f0-9aa9-2d9b34273e84",
                                "sense_id": "43d81d2b-7f32-39dd-8daa-c744771848b9",
                                "text": "Si ce concept arrive un jour, il faudra que je pense à me smartphoniser !!"
                            },
                            {
                                "example_id": "fd6e5d7d-25b4-459a-b381-7a04524c7b54",
                                "sense_id": "43d81d2b-7f32-39dd-8daa-c744771848b9",
                                "text": "Avec #Vodacom, tout le monde peut se smartphoniser à son goût."
                            },
                            {
                                "example_id": "ed01d772-2978-43b6-90c3-d04541f8c62c",
                                "sense_id": "43d81d2b-7f32-39dd-8daa-c744771848b9",
                                "text": "Pour le coup, tout dépendra de l’état d'esprit en y jouant et du niveau d'abstraction face à cette envie de « smartphoniser » tout et n'importe quoi..."
                            },
                            {
                                "example_id": "84c90289-a0b9-4b96-87ee-175d35928fb2",
                                "sense_id": "43d81d2b-7f32-39dd-8daa-c744771848b9",
                                "text": "L’observation n’est plus nouvelle : l’humanité « smartphonisée » ou « i-phonisée » d’aujourd’hui adore faire d’elle-même des images, nommées selfies."
                            }
                        ]
                    }
