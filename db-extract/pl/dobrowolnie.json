                                                "example_id": "a544b304-e68c-42b7-952f-9c9ecf893a9f",
                                                "sense_id": "311782f1-18a8-3a72-be6c-72d4d12e6a49",
                                                "text": "„Der Faschismus läßt vom Staats- und Gesellschaftsvertrag, den er im Verkehr der Mächte durch geheime Abmachungen ersetzt, im Inneren nur noch den Zwang des Allgemeinen gelten, den seine Diener aus freien Stücken am Rest der Menschheit vollstrecken.“"
                                            },
                                            {
                                                "example_id": "a6d9f87b-cae9-4963-a489-023f0196f152",
                                                "sense_id": "311782f1-18a8-3a72-be6c-72d4d12e6a49",
                                                "text": "„Ich habe aus freien Stücken darauf verzichtet.“"
                                            },
                                            {
                                                "example_id": "ef09f883-471c-450c-8092-f162b138647b",
                                                "sense_id": "311782f1-18a8-3a72-be6c-72d4d12e6a49",
                                                "text": "„Sie wollen wissen, ob sein Rücktritt aus freien Stücken oder auf Drängen Pekings erfolgt.“"
                                            },
                                            {
                                                "example_id": "fddb3978-fb87-4243-b46a-c568c4a84a06",
                                                "sense_id": "311782f1-18a8-3a72-be6c-72d4d12e6a49",
                                                "text": "„Indem dieser ihn zum Arbeitseinsatz in die Berge schickte, hatte er seine Absicht eindeutig erkennen lassen, denn dies war eine Arbeit, die kein Angestellter in der ganzen Stadt aus freien Stücken übernommen hätte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
