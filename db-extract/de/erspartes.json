                    {
                        "translation_id": "788a0ae6-75b3-47a2-9cb2-85ef418c0f6d",
                        "source_entry_id": "a9ef40d7-58d7-333f-9689-fd10f82a9190",
                        "source_sense_id": "43c46210-03cd-3ffe-824c-74ab1341e95c",
