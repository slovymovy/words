                                "target_lang_sense_clarification": "durch Stützen stabilisiert"
                            },
                            {
                                "target_lang_word": "versteift",
                                "target_lang_sense_clarification": "strukturell verstärkt"
                            }
                        ]
                    }
                },
                {
