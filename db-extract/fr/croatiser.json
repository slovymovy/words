                ],
                "senses": [
                    {
                        "sense_id": "bc81b7a8-471a-3bc9-a162-853662fda3e1",
                        "entry_id": "0637c815-1715-33e7-9f30-4936a0c92dbc",
                        "glosses": [
                            "Donner un caractère croate, ou plus purement croate, à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6355ae98-d376-47c1-aaa7-344c3dac1b57",
                                "sense_id": "bc81b7a8-471a-3bc9-a162-853662fda3e1",
                                "text": "Les Bosniaques prirent l’alarme, les uns s’imaginant qu'on voulait croatiser la Bosnie, les autres se plaignant qu’on favorisât les catholiques au détriment des orthodoxes."
                            },
                            {
                                "example_id": "65a980b1-07c1-42f1-97de-3bca9abe584a",
                                "sense_id": "bc81b7a8-471a-3bc9-a162-853662fda3e1",
                                "text": "Fallait-il les croatiser, eux, les orthodoxes, en les convertissant, de bon gré, au catholicisme, et les exterminer s’ils refusaient la conversion ?"
                            }
                        ]
                    }
                ],
