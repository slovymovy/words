                "senses": [
                    {
                        "sense_id": "28368a40-f24a-3e0a-adcb-8ec2e3275459",
                        "entry_id": "55f19dd2-a5c3-3e5c-a951-ab1b4cad2219",
                        "glosses": [
                            "długa listwa wygięta z przodu do góry, ze specjalnym wiązaniem służącym do przymocowania do buta (zwykle też specjalnego), przeznaczona do jeżdżenia po śniegu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ab7cc07-941c-4524-beae-bccd27f947f1",
                                "sense_id": "28368a40-f24a-3e0a-adcb-8ec2e3275459",
                                "text": "Na wyprzedaży kupiłam nowe narty i buty narciarskie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "224451ee-51bc-4605-af58-304059acc75e",
                        "source_entry_id": "55f19dd2-a5c3-3e5c-a951-ab1b4cad2219",
                        "source_sense_id": "28368a40-f24a-3e0a-adcb-8ec2e3275459",
                        "target_lang_word": "ski",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ski",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16b6e0c4-603d-39ba-b33d-ddd9f7c66233",
                                        "entry_id": "f5aac9e2-144c-32fb-aa47-b5053f973ad7",
                                        "glosses": [
                                            "One of a pair of long flat runners designed for gliding over snow or water."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39199f6c-8dd5-4fb0-9182-3dbf5322bbf7",
                                                "sense_id": "16b6e0c4-603d-39ba-b33d-ddd9f7c66233",
                                                "text": "Disaster at the newly opened ski resort where hard-driving tycoon Hudson is determined to double his not insubstantial investment while his ex-wife Mia is making whoopee with one of the locals championing ecology."
                                            },
                                            {
                                                "example_id": "b8115326-b043-49bd-908f-f0a85b9261a6",
                                                "sense_id": "16b6e0c4-603d-39ba-b33d-ddd9f7c66233",
                                                "text": "We skied back the way we had come for about thirty minutes when I saw her. Mary was hanging upside down by the tips of her skies from a tree well."
                                            },
                                            {
                                                "example_id": "a6a71344-1628-4828-a09b-8019e494e594",
                                                "sense_id": "16b6e0c4-603d-39ba-b33d-ddd9f7c66233",
                                                "text": "Yilamujiang grew up in Altay, a prefecture bordering Mongolia in far northwest Xinjiang. Chinese officials consider the region the cradle of Alpine sport, after cave paintings of hunters on skis were dated at 10,000 years old. Locals still use hand-carved wooden skis covered in a horsehide, although mostly now for the benefit of tourists."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8aae2b46-aaa1-3d35-b2a7-9146f6e92362",
                                        "entry_id": "f5aac9e2-144c-32fb-aa47-b5053f973ad7",
                                        "glosses": [
                                            "One of a pair of long flat runners under some flying machines, used for landing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "81d86d03-fb33-3d37-9a77-fccd22498a8e",
                                        "entry_id": "f5aac9e2-144c-32fb-aa47-b5053f973ad7",
                                        "glosses": [
                                            "A trip made by skiing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9451cc20-a5fd-47b5-8f86-d146afe9ee02",
                                                "sense_id": "81d86d03-fb33-3d37-9a77-fccd22498a8e",
                                                "text": "to go for a ski"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ski",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "82e54ebf-d851-3dbb-9034-bb284f2c8135",
                                        "entry_id": "9fc18ca5-b8f7-3add-b22c-3fa4d7cce760",
                                        "glosses": [
                                            "To move on skis."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6c0f3d1-b047-40fe-b2d5-dc5a76f763b2",
                                                "sense_id": "82e54ebf-d851-3dbb-9034-bb284f2c8135",
                                                "text": "Townsend hare inhabit this area, particularly above the cabin, and a skier is likely to have one explode from a tree well and disappear into the whiteness as he skis by. Life is a constant bivouac for them -- they spend days huddled in tree wells during storms -- but I suspect they are as content and warm in their luxurious coats as we are in a cabin."
                                            },
                                            {
                                                "example_id": "2c9bdbd4-cc48-4670-b443-86b7148349a8",
                                                "sense_id": "82e54ebf-d851-3dbb-9034-bb284f2c8135",
                                                "text": "We skied back the way we had come for about thirty minutes when I saw her. Mary was hanging upside down by the tips of her skies from a tree well."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44b3aec4-060d-3cd7-b73b-e49bf89d85ed",
                                        "entry_id": "9fc18ca5-b8f7-3add-b22c-3fa4d7cce760",
                                        "glosses": [
                                            "To travel over (a slope, etc.) on skis; to travel on skis at (a place), (especially as a sport)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3b1c337-302f-45a5-a133-1f215a5964b9",
                                                "sense_id": "44b3aec4-060d-3cd7-b73b-e49bf89d85ed",
                                                "text": "We spent the winter holidays skiing the Alps"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
