                    "sense_definition": "een projectiel afvuren met een wapen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "wapengebruik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De soldaat begon te <w>schieten</w> toen hij de vijand zag.",
