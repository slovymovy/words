                        "glosses": [
                            "To receive; accept or withstand; to bear, tolerate, or endure, usually with little to no ill-effect; (often reflexive) To take along; take with."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3010e77d-7a09-431e-9f24-d77f1bf77d30",
                                "sense_id": "0d9415a2-f5e8-328a-b22e-0bab77d40322",
                                "text": "[…] and if the people of the said cities and towns will not or are not able to maintain them they shall withtake themselves to other towns and cities within the hundred, or to the town where they were born, and shall there continually abide during their life."
                            },
                            {
                                "example_id": "f3872118-b2ab-4e10-a4dc-0d1055ddc5a0",
                                "sense_id": "0d9415a2-f5e8-328a-b22e-0bab77d40322",
                                "text": "Not desiring to be discovered, we found a fair road close by a wood, withtook ourselves out of it with all haste, and went towards a village."
                            },
                            {
                                "example_id": "8d5bdd3d-94e1-4b57-81ba-cb0d8ce17845",
                                "sense_id": "0d9415a2-f5e8-328a-b22e-0bab77d40322",
                                "text": "Luckily the general structure withtook the shock and only the ceiling collapsed."
                            },
                            {
                                "example_id": "c061ec61-fa6c-48d2-a4a9-d1c87c8b5520",
                                "sense_id": "0d9415a2-f5e8-328a-b22e-0bab77d40322",
                                "text": "\"[…] Luckily the general structure withtook the shock and only the ceiling collapsed.\""
