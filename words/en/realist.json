            "senses": [
                {
                    "sense_id": "14328f52-f3c8-369b-9d6a-8d6c54e0b633",
                    "sense_definition": "One who believes in seeing things the way they really are, as opposed to how they would like them to be.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pragmatic_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a <w>realist</w>, she knew the project would take much longer than the manager expected."
                        },
                        {
                            "text": "He is a <w>realist</w> who prefers to focus on practical solutions rather than empty promises."
                        }
                    ],
                    "synonyms": [
                        "real-worlder"
                    ],
                    "antonyms": [
                        "idealist",
                        "fantasist",
                        "Cloudcuckoolander"
                    ],
