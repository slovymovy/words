                        "examples": [
                            {
                                "example_id": "84630dce-ed5a-4948-b29e-2c616d15bd4d",
                                "sense_id": "178a0ea5-20d6-3178-a6e9-396a61aefe01",
                                "text": "Als de prijswinnaars ervoor kiezen de lekkernij met de auto op te halen, lijkt de Nationale Postcode Loterij, met goede en vooral groene doelen als Natuurmonumenten, Greenpeace en het Wereld Natuur Fonds, toch iets uit te moeten leggen. Van filevorming zal evenwel geen sprake zijn, want de Needse prijswinnaars krijgen twee weken de tijd hun Eibergse ijsbeker in ontvangst te nemen. Van zaterdag tot en met 17 april."
                            },
                            {
                                "example_id": "b2ac7137-a96c-4cff-96bc-86775c090960",
                                "sense_id": "178a0ea5-20d6-3178-a6e9-396a61aefe01",
                                "text": "Van iedere verkochte beker SOS-ijs gaat een deel naar de milieubeweging. De Hellendoornse fabriek doneert minimaal 100.000 euro, maar als de verkoop van het SOS-ijs goed loopt kan dat oplopen. Verder worden consumenten op iedere ijsbeker opgeroepen een petitie te tekenen voor een betere klimaatpolitiek."
                            }
                        ]
                    }
