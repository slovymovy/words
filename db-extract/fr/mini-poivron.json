                        "glosses": [
                            "Poivron (légume) de taille nettement plus petite que les poivrons ordinaires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37a205a5-fbef-4dfb-a82a-2c301d92cc84",
                                "sense_id": "0c79c433-a316-381f-8b2c-c080d356d569",
                                "text": "La gamme de la coopérative compte une soixantaine de référence, du mini-romanesco en passant par le mini-poivron et le mini-pâtisson."
                            },
                            {
                                "example_id": "67bdbaa3-ae5a-4d7f-a1a0-d9686286a2dc",
                                "sense_id": "0c79c433-a316-381f-8b2c-c080d356d569",
                                "text": "Pour vos salades composées, faites de jolis bocaux de petits légumes mélangés, choux-fleurs, mini-poivrons, tomates cerises, bâtonnets de carottes, oignons blancs etc."
                            },
                            {
                                "example_id": "ba546fa9-f3f4-4d6a-a748-2f6e3ea2b16d",
                                "sense_id": "0c79c433-a316-381f-8b2c-c080d356d569",
                                "text": "Faites aussi griller les mini-poivrons et les oignons nouveaux 15 min environ à feu moyen."
