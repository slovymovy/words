                "senses": [
                    {
                        "sense_id": "416f7050-7512-3bea-a1f9-38f883ca8285",
                        "entry_id": "78fafec8-d458-38f3-ab23-350e957a4fdc",
                        "glosses": [
                            "Unternehmerin, die meist mit einer innovativen Idee seine Firma begründet hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0c722ca-daa7-4ae5-854b-05c71cf5bf42",
                                "sense_id": "416f7050-7512-3bea-a1f9-38f883ca8285",
                                "text": "„Caro Daur, die sich selbst nicht mehr als Influencerin, sondern als Entrepreneurin bezeichnet, erholt sich.“"
                            },
                            {
                                "example_id": "a32bd6aa-32bc-45b0-b95b-8135d4daa182",
                                "sense_id": "416f7050-7512-3bea-a1f9-38f883ca8285",
                                "text": "„In heutiger Business-Sprache würde man Eriksson als erfolgreiche Entrepreneurin bezeichnen, und angesichts der damaligen gesellschaftlichen Umstände ist es ziemlich wahrscheinlich, dass gerade sie Schwedens historisch allererste Startup-Gründerin ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
