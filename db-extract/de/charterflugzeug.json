                "senses": [
                    {
                        "sense_id": "1b853c9f-591f-387c-836b-d3f3cc7956d9",
                        "entry_id": "93fb008e-958f-3abb-868c-bc57b5537d8a",
                        "glosses": [
                            "gemietetes Flugzeug"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01af8dba-fa42-48fa-a82e-ed4a71619064",
                                "sense_id": "1b853c9f-591f-387c-836b-d3f3cc7956d9",
                                "text": "„Ein Charterflugzeug mit 148 Menschen an Bord ist am Samstag kurz nach dem Start im ägyptischen Badeort Scharm el Scheich ins Rote Meer gestürzt.“"
                            },
                            {
                                "example_id": "9c2aa3db-1c7f-4273-a43d-8fb5879c9d7f",
                                "sense_id": "1b853c9f-591f-387c-836b-d3f3cc7956d9",
                                "text": "„Die Reichen fliegen in Charterflugzeugen mit eigenem Gourmet-Koch und Fremdenführern zu abgelegenen Landepisten in Afrika.\""
                            },
                            {
                                "example_id": "f8be8f0a-c9ea-44fd-b6e7-0b69d861a9b1",
                                "sense_id": "1b853c9f-591f-387c-836b-d3f3cc7956d9",
                                "text": "„Das Charterflugzeug stürzt in Afrika ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
