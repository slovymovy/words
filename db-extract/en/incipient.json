    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "0d863528-ebc0-3451-91b2-34bb17b75329",
                "word": "incipient",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "83bc6903-d5e4-3da2-acdc-b77eb05f6eb5",
                        "entry_id": "0d863528-ebc0-3451-91b2-34bb17b75329",
                        "glosses": [
                            "In an initial stage; beginning, starting, coming into existence."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "016a7c63-ffe0-47d5-91ef-ccf9865fb149",
                                "sense_id": "83bc6903-d5e4-3da2-acdc-b77eb05f6eb5",
                                "text": "After 500 years, incipient towns appeared."
                            },
                            {
                                "example_id": "67c1c676-cdd0-4050-8fae-5a7c8de1ea32",
                                "sense_id": "83bc6903-d5e4-3da2-acdc-b77eb05f6eb5",
                                "text": "Employees shall be familiarized with the use of a fire extinguisher in incipient stage fire fighting."
                            },
                            {
                                "example_id": "78a85dfa-5732-4a7a-b2ce-405b6356df8f",
                                "sense_id": "83bc6903-d5e4-3da2-acdc-b77eb05f6eb5",
                                "text": "How many more places might have been distributed by her incipient majesty it is impossible to say, for the thread of her meditation was broken by the sudden termination of the path."
                            },
                            {
                                "example_id": "ddd79680-3113-46a3-9d4c-d97dae2599af",
                                "sense_id": "83bc6903-d5e4-3da2-acdc-b77eb05f6eb5",
                                "text": "It need not be supposed that all varieties or incipient species necessarily attain the rank of species."
                            },
                            {
                                "example_id": "594d726c-7c92-46d0-b7ce-db742380da60",
                                "sense_id": "83bc6903-d5e4-3da2-acdc-b77eb05f6eb5",
                                "text": "It may even be that because of incipient satiation, the shares of the marginal dollar display consumption propensities that are the reverse of the ones exhibited by the average dollar."
                            },
                            {
                                "example_id": "00481448-c8aa-43b2-96d6-2995a83b0537",
                                "sense_id": "83bc6903-d5e4-3da2-acdc-b77eb05f6eb5",
                                "text": "Aislyn presses back against her house’s front door, panting a little with an incipient panic attack."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00a1b6ce-66a1-4346-bb43-abb1c879281e",
