                                            {
                                                "example_id": "dabf0e6d-f44f-4e82-b246-cdb54662d78c",
                                                "sense_id": "36a4aa3e-1695-3c07-8dd3-87e3abfc5845",
                                                "text": "Eine Dezillion sind eintausend Nonilliarden."
                                            }
