                        "glosses": [
                            "wet die bepaalt hoe men moet omgaan met een bedrijf dat zijn financiële verplichtingen niet meer kan nakomen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3f30ce3-97f2-4e18-bc9f-ebf9c9182231",
                                "sense_id": "69ad1b8b-0cda-3101-bc0e-b7156e0678b0",
                                "text": "Death Row Records hield het nog tien jaar vol, onder meer door oude nummers opnieuw uit te brengen op compilatiealbums. In 2006 werd het label failliet verklaard, maar door een nieuwe faillissementswet in Amerika kreeg Suge Knight het bedrijf terug. Een jaar later verkocht hij het label."
                            },
                            {
                                "example_id": "f5e319cb-fa77-4352-a6f7-dddeb3192cc4",
                                "sense_id": "69ad1b8b-0cda-3101-bc0e-b7156e0678b0",
                                "text": "Volgens de rechter mag de rechtbank een faillissement alleen toetsen aan de Faillissementswet. Daardoor kan de rechter volgens de uitspraak het maatschappelijk belang in dit geval niet laten meewegen in de beslissing, maar alleen kijken naar de financiële situatie."
                            }
                        ]
