                        "examples": [
                            {
                                "example_id": "c949a25e-408f-4676-a136-e4f8fc189612",
                                "sense_id": "4b96b28c-a760-3185-bc4a-27a98038ae2e",
                                "text": "On dit\nPartout et l’on répète\nQue j’lâche pas mes pépettes\nC’est vrai\nMais si elle faisait comme moi pour sa galette\nMarianne n’aurait pas un budget aussi bas\nEt si l’on mettait à la tête\nDes finances Mistinguett\nOn n’en serait pas là !"
                            },
                            {
                                "example_id": "a1125dfc-b590-4b76-b158-d502db1575b1",
                                "sense_id": "4b96b28c-a760-3185-bc4a-27a98038ae2e",
                                "text": "« Les personnes flatteuses savent se faire bien venir et ramasser les pépettes ; mais patience, le bon Dieu les punit toutes par un beau jour »"
                            },
                            {
                                "example_id": "7ee13b24-801f-4b40-aebf-94698b4aeee9",
                                "sense_id": "4b96b28c-a760-3185-bc4a-27a98038ae2e",
                                "text": "J’ai gagné mon premier salaire. Mes premières pépettes."
                            }
                        ]
                    }
