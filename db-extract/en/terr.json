                        "glosses": [
                            "An insurgent in the Rhodesian Bush War."
                        ],
                        "tags": [
                            "Rhodesia",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "4f8cb832-927b-4dee-8ddb-fe109f693d61",
                                "sense_id": "6b76f706-9e25-35f1-b148-b3743501f67f",
                                "text": "As he entered the trees, he called, \"Terrs left about one minute ago – in a hurry. There is abandoned equipment – no time to collect – moving east on tracks.\""
                            },
                            {
                                "example_id": "cdb67572-0e35-460b-bd73-5a877db00831",
                                "sense_id": "6b76f706-9e25-35f1-b148-b3743501f67f",
                                "text": "If a terr's on the run or if he goes to ground,\nIt doesn't really matter 'cause they'll hunt him down.\nAnd if that terr's the first that shoots,\nHe got no chance against the Black Boots."
                            }
                        ]
                    }
