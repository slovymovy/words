                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b3a9f0c-18ed-4175-abeb-1d17646713b9",
                                                "sense_id": "545840e7-64de-372d-9008-3f348babb59c",
                                                "text": "The Bangkok government indicated real concern over the developments in Communist China’s Yunnan province. Thai officials were afraid that Sibsongpanna would be a center where pro-Communist Thai in Southeast Asia would go and where subversive agitation could be directed against outside legitimate governments."
                                            },
                                            {
                                                "example_id": "b40726f8-9a48-4cdd-bbbc-ac5b759b6cb0",
                                                "sense_id": "545840e7-64de-372d-9008-3f348babb59c",
                                                "text": "Temperatures in Bangkok fell as low as 59.3 degrees Fahrenheit (15.2 degrees Celsius) on Monday, the lowest the capital has seen in years, as the country’s weather agency warned cool conditions could persist through mid-February."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cddfdc83-cd4f-376a-adaa-efd59b7d0950",
                                        "entry_id": "ec493850-8aa8-3d62-8793-4dc8b5eafa4f",
                                        "glosses": [
                                            "The government of Thailand."
                                        ],
