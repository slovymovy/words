{
    "word_family": [
        "decking",
        "double-decker"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "24bfe0dd-4873-3654-97b7-ffc43572509d",
                    "sense_definition": "The floor of a ship, boat, or bus.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "platform_or_floor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The passengers stood on the upper <w>deck</w> to watch the sunset.",
                            "target_lang_translations": {
                                "ru": "Пассажиры стояли на верхней <w>палубе</w>, наблюдая за закатом.",
                                "zh": "乘客们站在上层<w>甲板</w>上看日落。"
                            }
                        },
                        {
                            "text": "The captain ordered the crew to scrub the <w>deck</w>.",
                            "target_lang_translations": {
                                "ru": "Капитан приказал команде драить <w>палубу</w>.",
                                "zh": "船长命令船员刷洗<w>甲板</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "on deck",
                        "below deck",
                        "upper deck",
                        "flight deck",
                        "hit the deck"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пол на корабле, лодке или автобусе",
                        "zh": "船只、船艇或巴士的底板或层面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "палуба",
                                "target_lang_sense_clarification": "на судне"
                            },
                            {
                                "target_lang_word": "этаж",
                                "target_lang_sense_clarification": "в автобусе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "甲板",
                                "target_lang_sense_clarification": "船只的层面"
                            },
                            {
                                "target_lang_word": "车厢",
                                "target_lang_sense_clarification": "巴士的层面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0481e595-5699-371e-ba30-27d1f16d8d1f",
                    "sense_definition": "A flat, open structure, usually made of wood, attached to a house and used for outdoor relaxation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "platform_or_floor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We sat on the <w>deck</w> drinking lemonade on a hot summer day.",
                            "target_lang_translations": {
                                "ru": "В жаркий летний день мы сидели на <w>террасе</w> и пили лимонад.",
                                "zh": "炎热的夏日，我们坐在<w>露台</w>上喝着柠檬水。"
                            }
                        },
                        {
                            "text": "They are planning to build a new wooden <w>deck</w> in the backyard.",
                            "target_lang_translations": {
                                "ru": "Они планируют построить новый деревянный <w>настил</w> на заднем дворе.",
                                "zh": "他们计划在后院建一个新的木<w>平台</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "patio",
                        "terrace"
                    ],
                    "common_phrases": [
                        "wooden deck",
                        "back deck"
                    ],
                    "target_lang_definitions": {
                        "ru": "Открытая площадка (обычно деревянная), пристроенная к дому",
                        "zh": "通常由木材制成，附在房屋外用于户外休闲的平坦开放式结构。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "терраса",
                                "target_lang_sense_clarification": "пристройка к дому"
                            },
                            {
                                "target_lang_word": "настил",
                                "target_lang_sense_clarification": "деревянное покрытие"
                            },
                            {
                                "target_lang_word": "веранда",
                                "target_lang_sense_clarification": "крытая терраса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "露台",
                                "target_lang_sense_clarification": "户外休闲平台"
                            },
                            {
                                "target_lang_word": "木平台",
                                "target_lang_sense_clarification": "木质户外结构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f811ff1b-0e95-35ed-b97d-48087d27f3e5",
                    "sense_definition": "A complete set of playing cards.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He shuffled the <w>deck</w> thoroughly before dealing the cards.",
                            "target_lang_translations": {
                                "ru": "Он тщательно перетасовал <w>колоду</w> перед раздачей карт.",
                                "zh": "他在发牌前彻底洗了<w>一副</w>牌。"
                            }
                        },
                        {
                            "text": "You need a standard 52-card <w>deck</w> to play this game.",
                            "target_lang_translations": {
                                "ru": "Для этой игры нужна стандартная <w>колода</w> из 52 карт.",
                                "zh": "玩这个游戏需要一副标准的52张<w>牌</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "deck of cards",
                        "shuffle the deck"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полный набор игральных карт",
                        "zh": "一副完整的扑克牌。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колода",
                                "target_lang_sense_clarification": "карт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一副",
                                "target_lang_sense_clarification": "扑克牌的量词"
                            },
                            {
                                "target_lang_word": "牌",
                                "target_lang_sense_clarification": "指代整套牌"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "773f27d3-a7db-3e7e-b8f1-648c9af14069",
                    "sense_definition": "A set of digital slides created for a presentation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "business_presentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The marketing team prepared a slide <w>deck</w> for the investor meeting.",
                            "target_lang_translations": {
                                "ru": "Маркетинговая команда подготовила <w>презентацию</w> для встречи с инвесторами.",
                                "zh": "营销团队为投资者会议准备了一份<w>演示文稿</w>。"
                            }
                        },
                        {
                            "text": "Please email me the pitch <w>deck</w> so I can review the data.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, пришли мне <w>презентацию</w> (питч-дек), чтобы я мог просмотреть данные.",
                                "zh": "请把融资<w>演示文稿</w>发邮件给我，以便我查看数据。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "slide deck",
                        "pitch deck"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "business context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор цифровых слайдов для презентации",
                        "zh": "为演示文稿创建的一组数字幻灯片。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "презентация",
                                "target_lang_sense_clarification": "набор слайдов"
                            },
                            {
                                "target_lang_word": "слайды",
                                "target_lang_sense_clarification": "материалы выступления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "演示文稿",
                                "target_lang_sense_clarification": "整套幻灯片"
                            },
                            {
                                "target_lang_word": "幻灯片",
                                "target_lang_sense_clarification": "演示材料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d66de65-08ab-37be-83dd-818de4d27992",
                    "sense_definition": "A device for playing or recording audio or video media.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "audio_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I found an old cassette <w>deck</w> in the attic and tried to play some tapes.",
                            "target_lang_translations": {
                                "ru": "Я нашел на чердаке старую кассетную <w>деку</w> и попытался послушать кассеты.",
                                "zh": "我在阁楼里发现了一台旧磁带<w>卡座</w>，试着放了几盘磁带。"
                            }
                        },
                        {
                            "text": "The DJ set up his mixing <w>decks</w> before the party started.",
                            "target_lang_translations": {
                                "ru": "Диджей настроил свои <w>вертушки</w> перед началом вечеринки.",
                                "zh": "派对开始前，DJ架好了他的混音<w>播放器</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tape deck",
                        "mixing deck"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устройство для воспроизведения или записи аудио",
                        "zh": "用于播放或录制音频或视频媒体的设备。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дека",
                                "target_lang_sense_clarification": "часть аудиосистемы"
                            },
                            {
                                "target_lang_word": "проигрыватель",
                                "target_lang_sense_clarification": "устройство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "卡座",
                                "target_lang_sense_clarification": "磁带播放设备"
                            },
                            {
                                "target_lang_word": "播放器",
                                "target_lang_sense_clarification": "音频播放设备"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ef92232a-5862-33fb-b66d-8ce1b6c3da8f",
                    "sense_definition": "To decorate or dress someone or something, often for a special occasion.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "decoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>decked</w> the halls with holly and lights for the Christmas party.",
                            "target_lang_translations": {
                                "ru": "Они <w>украсили</w> залы остролистом и огнями к рождественской вечеринке.",
                                "zh": "为了圣诞派对，他们用冬青和彩灯<w>装饰</w>了大厅。"
                            }
                        },
                        {
                            "text": "She was <w>decked</w> out in her finest jewelry for the gala.",
                            "target_lang_translations": {
                                "ru": "Она <w>вырядилась</w> в свои лучшие украшения для гала-концерта.",
                                "zh": "为了参加晚宴，她<w>打扮</w>得珠光宝气。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "deck out",
                        "deck with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Украшать или наряжать кого-то или что-то",
                        "zh": "装饰或打扮某人或某物，通常是为了特殊场合。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "украшать",
                                "target_lang_sense_clarification": "декорировать"
                            },
                            {
                                "target_lang_word": "наряжать",
                                "target_lang_sense_clarification": "одевать празднично"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "装饰",
                                "target_lang_sense_clarification": "布置环境"
                            },
                            {
                                "target_lang_word": "打扮",
                                "target_lang_sense_clarification": "盛装"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1138287a-22ee-3f0d-a48b-ca1f1cc56909",
                    "sense_definition": "To hit someone hard enough to knock them down.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He got so angry that he threatened to <w>deck</w> the other guy.",
                            "target_lang_translations": {
                                "ru": "Он так разозлился, что пригрозил <w>вырубить</w> другого парня.",
                                "zh": "他气得威胁说要<w>击倒</w>那个人。"
                            }
                        },
                        {
                            "text": "I saw him <w>deck</w> the thief with a single punch.",
                            "target_lang_translations": {
                                "ru": "Я видел, как он <w>уложил</w> вора одним ударом.",
                                "zh": "我看见他一拳就把小偷<w>击倒</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "deck someone"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно ударить кого-то, сбив с ног",
                        "zh": "用力击打某人，将其击倒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вырубить",
                                "target_lang_sense_clarification": "ударить (слэнг)"
                            },
                            {
                                "target_lang_word": "уложить",
                                "target_lang_sense_clarification": "свалить ударом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "击倒",
                                "target_lang_sense_clarification": "用拳头打倒"
                            },
                            {
                                "target_lang_word": "揍",
                                "target_lang_sense_clarification": "猛击"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}