                "forms": [
                    {
                        "form_id": "4d20e47e-4f99-4b58-8265-c77ca04efc28",
                        "entry_id": "bf377576-802e-3a40-acb3-37c07f6d3c04",
                        "tags": [
                            "plural"
                        ],
                        "form": "connaisseuses"
                    },
                    {
                        "form_id": "314cab24-7fb5-42aa-8291-ad7047972452",
                        "entry_id": "bf377576-802e-3a40-acb3-37c07f6d3c04",
                        "tags": [
                            "masculine"
                        ],
                        "form": "connaisseur"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dcb5b2a0-f6e1-3233-b14e-c60db78887b1",
                        "entry_id": "bf377576-802e-3a40-acb3-37c07f6d3c04",
                        "glosses": [
                            "Celle qui se connaît à diverses choses dans un domaine donné, notamment les beaux-arts ou la gastronomie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "716ddf2b-e6ff-464b-8f97-1b96458f9769",
                                "sense_id": "dcb5b2a0-f6e1-3233-b14e-c60db78887b1",
                                "text": "Les bonnes de la maison étaient, en cette occurrence, de fines connaisseuses, car M. Surgeon (conservons-lui cette appellation) constituait, à lui seul, un des plus jolis hommes de cette fin de siècle."
                            },
                            {
                                "example_id": "84ed6e16-b575-4847-acc2-a794296298a6",
                                "sense_id": "dcb5b2a0-f6e1-3233-b14e-c60db78887b1",
                                "text": "Il parlait d’une voix si bien timbrée qu’elle donnait l’envie de ne pas l’interrompre, et Alice l’écoutait en connaisseuse."
                            },
                            {
                                "example_id": "6457f595-dbc9-4778-a95d-e128bd9a2a2d",
                                "sense_id": "dcb5b2a0-f6e1-3233-b14e-c60db78887b1",
                                "text": "Elle l’observa en connaisseuse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e0cc9d3-039c-4aad-9a78-aef97e8ec387",
                        "source_entry_id": "bf377576-802e-3a40-acb3-37c07f6d3c04",
                        "source_sense_id": "dcb5b2a0-f6e1-3233-b14e-c60db78887b1",
                        "target_lang_word": "connoisseur",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "connoisseur",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bcb0a1a3-e884-3279-b64b-239dc1b69760",
                                        "entry_id": "a5ba02aa-8b3b-3a61-b8ed-f44e609f0f62",
                                        "glosses": [
                                            "A specialist in a given field whose opinion is highly valued, especially in one of the fine arts or in matters of taste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bc76876-3979-4c0b-96dd-71a7c5e3180d",
                                                "sense_id": "bcb0a1a3-e884-3279-b64b-239dc1b69760",
                                                "text": "beer connoisseur"
                                            },
                                            {
                                                "example_id": "13c4d7f6-2a8e-4d51-8b2b-87ed48b37608",
                                                "sense_id": "bcb0a1a3-e884-3279-b64b-239dc1b69760",
                                                "text": "chocolate connoisseur"
                                            },
                                            {
                                                "example_id": "d93e4dba-e388-485f-99da-8f17022654a3",
                                                "sense_id": "bcb0a1a3-e884-3279-b64b-239dc1b69760",
                                                "text": "wine connoisseur"
                                            },
                                            {
                                                "example_id": "aaa6daf9-b782-4b4f-8636-0eb0d6971377",
                                                "sense_id": "bcb0a1a3-e884-3279-b64b-239dc1b69760",
                                                "text": "It is evident, in spite of his frequent attention to her while she draws, that in fact he knows nothing of the matter. He admires as a lover, not as a connoisseur."
                                            },
                                            {
                                                "example_id": "db6c3e12-575f-4b3c-9beb-9e81e1223ef8",
                                                "sense_id": "bcb0a1a3-e884-3279-b64b-239dc1b69760",
                                                "text": "No; nonsense, Naumann! English ladies are not at everybody’s service as models. And you want to express too much with your painting. You would only have made a better or worse portrait with a background which every connoisseur would give a different reason for or against."
                                            },
                                            {
                                                "example_id": "f9a07937-93dc-4096-ada3-1e9e71d47be9",
                                                "sense_id": "bcb0a1a3-e884-3279-b64b-239dc1b69760",
                                                "text": "This, when it was brought to him, he drank slowly, like a connoisseur, lingering on the taste and still looking about him at the cliffs and up at our signboard."
                                            },
                                            {
                                                "example_id": "a9f78890-bae5-4744-ab39-d1ab74061cea",
                                                "sense_id": "bcb0a1a3-e884-3279-b64b-239dc1b69760",
                                                "text": "Real connoisseurs know that to nose and taste properly you have to add still water to your tulip-shaped glass so that the alcohol doesn't overwhelm you."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fc19eb38-7f06-4d45-8a62-dfc4ee164800",
                        "source_entry_id": "bf377576-802e-3a40-acb3-37c07f6d3c04",
