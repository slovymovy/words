                "senses": [
                    {
                        "sense_id": "414fa41b-0283-3a0f-b32a-ec92390d58dd",
                        "entry_id": "a61cce50-1ce8-3281-9376-ed2edcf250d1",
                        "glosses": [
                            "eine Skala, an der die Füllhöhe in einem Wassergefäß oder die Wassertiefe von natürlichen und künstlichen Gewässern oder bei Überflutungen in freiem Gelände abgelesen werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d44c152-be28-4836-8f55-27cf751db55d",
                                "sense_id": "414fa41b-0283-3a0f-b32a-ec92390d58dd",
                                "text": "Lothar kann an der Wasserstandsanzeige seines Hydrotopfes erkennen, wann seine Pflanze Wasser benötigt."
                            },
                            {
                                "example_id": "f5ea0a35-94ad-4bf4-bd3d-631e9cc6b29b",
                                "sense_id": "414fa41b-0283-3a0f-b32a-ec92390d58dd",
                                "text": "„Außen am Turm befindet sich eine Wasserstandsanzeige, welche über eine Kette gesteuert wird, die mit dem Schwimmer im Tank verbunden ist.“"
                            },
                            {
                                "example_id": "7188b2fb-f42c-499f-af07-b93e49224747",
                                "sense_id": "414fa41b-0283-3a0f-b32a-ec92390d58dd",
                                "text": "„Nach der Besteigung des Führerstandes begann der Lokführer mit den wichtigsten Kontrollen: Reglerprüfung, Dichtigkeit der Ventile, Wasserstandsanzeigen und Bremstest.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
