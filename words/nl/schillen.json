            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9de46db9-c677-3ba0-9b3e-d123461d89e2",
                    "sense_definition": "de buitenste laag of schil van een vrucht of groente verwijderen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "voedselbereiding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zou jij de aardappels willen <w>schillen</w> voor het avondeten?",
                            "target_lang_translations": {
                                "en": "Would you like to <w>peel</w> the potatoes for dinner?"
                            }
                        },
                        {
                            "text": "Het is gezonder om een appel niet te <w>schillen</w> omdat de meeste vitamines vlak onder de schil zitten.",
                            "target_lang_translations": {
                                "en": "It is healthier not to <w>peel</w> an apple because most vitamins are right under the skin."
                            }
                        }
                    ],
                    "synonyms": [
                        "pellen"
                    ],
                    "common_phrases": [
                        "aardappels schillen",
                        "een appel schillen"
                    ],
                    "target_lang_definitions": {
                        "en": "to remove the outer layer or skin of a fruit or vegetable"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "peel",
                                "target_lang_sense_clarification": "to remove the skin of fruit or vegetables"
                            },
                            {
                                "target_lang_word": "pare",
                                "target_lang_sense_clarification": "to trim off the outer layer with a knife"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c257b070-afdb-35a4-81f3-6d750103ad86",
                    "sense_definition": "meervoud van <w>schil</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "plantendelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gooi de <w>schillen</w> van de bananen maar in de gft-bak.",
                            "target_lang_translations": {
                                "en": "Just throw the banana <w>peels</w> in the organic waste bin."
                            }
                        },
                        {
                            "text": "De vloer lag vol met de <w>schillen</w> van de pinda's die ze hadden gegeten.",
                            "target_lang_translations": {
                                "en": "The floor was covered with the <w>shells</w> of the peanuts they had eaten."
                            }
                        }
                    ],
