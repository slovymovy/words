                {
                    "sense_id": "d29fc989-bba7-31f3-ab75-01a0751fb5e5",
                    "sense_definition": "Élément graphique affiché sur une page web à des fins publicitaires ou informatives.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette page web affiche une grande <w>bannière</w> en haut de l'écran."
                        },
                        {
                            "text": "L'entreprise a créé une nouvelle <w>bannière</w> pour promouvoir son application."
                        }
                    ],
                    "common_phrases": [
                        "bannière publicitaire",
                        "bannière web"
                    ]
                },
                {
                    "sense_id": "f134a479-7b62-3ab8-9817-6e2204a1aacb",
                    "sense_definition": "Grande pièce d'étoffe suspendue à une hampe, servant d'emblème, d'insigne ou de signe de ralliement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "embleme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les manifestants défilaient dans la rue en tenant une immense <w>bannière</w> colorée."
                        },
                        {
                            "text": "Une magnifique <w>bannière</w> flottait au-dessus de l'entrée principale du château."
                        }
                    ],
                    "synonyms": [
                        "drapeau",
                        "enseigne",
                        "étendard"
                    ],
                    "common_phrases": [
                        "déployer une bannière",
                        "porter la bannière"
                    ]
                },
                {
                    "sense_id": "21334a99-54df-35ef-835f-ff90e80dfd7d",
                    "sense_definition": "Cause, parti ou doctrine sous lequel des personnes se rassemblent.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plusieurs associations se sont réunies sous la même <w>bannière</w> pour défendre les droits civiques."
                        },
                        {
                            "text": "Les militants poursuivent leur combat sous la <w>bannière</w> de la liberté."
                        }
                    ],
                    "common_phrases": [
                        "sous la bannière de",
                        "se rassembler sous la bannière"
                    ]
                },
                {
                    "sense_id": "3aef946a-52bb-380e-8627-2ca028cbb195",
                    "sense_definition": "Enseigne militaire qu'un seigneur féodal arborait pour guider ses vassaux au combat.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "embleme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tous les chevaliers du domaine se rassemblaient sous la <w>bannière</w> de leur seigneur."
                        },
                        {
                            "text": "Le comte marchait à la tête de ses troupes précédé de sa propre <w>bannière</w> armoriée."
                        }
                    ],
                    "synonyms": [
                        "enseigne",
                        "étendard"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "contexte féodal"
                        }
                    ]
                },
                {
                    "sense_id": "56863e5a-8918-371e-8bfe-412dfb3e0bf3",
                    "sense_definition": "Étendard orné de figures pieuses, porté lors de processions pour identifier une paroisse ou une confrérie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "embleme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En tête du cortège, les fidèles portaient une lourde <w>bannière</w> brodée d'or et d'argent."
                        },
                        {
                            "text": "La confrérie conserve précieusement sa <w>bannière</w> historique dans la chapelle du village."
                        }
                    ],
                    "synonyms": [
                        "étendard"
                    ],
                    "common_phrases": [
                        "bannière de procession"
                    ]
                }
            ]
        }
    ]
