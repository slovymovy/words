                    {
                        "form_id": "006fd58b-5a48-4903-90a7-f780932c1ed3",
                        "entry_id": "a12f5805-6cc4-3f8f-b250-77da7d19ad2e",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "loopgraafjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b85a2668-6ddf-34a3-91cd-ef7dd7dc87c5",
                        "entry_id": "a12f5805-6cc4-3f8f-b250-77da7d19ad2e",
                        "glosses": [
                            "een uitgegraven geul, diep en breed genoeg dat men er in kan lopen zonder bloot te staan aan vijandelijk vuur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5db03016-667b-46af-bb12-42f97556154e",
                                "sense_id": "b85a2668-6ddf-34a3-91cd-ef7dd7dc87c5",
                                "text": "In de Eerste Wereldoorlog waren de loopgraven bij de IJzer berucht omdat er erg veel slachtoffers vielen."
                            },
                            {
                                "example_id": "2be4469c-fb1a-4a49-bda6-26854e00d28e",
                                "sense_id": "b85a2668-6ddf-34a3-91cd-ef7dd7dc87c5",
                                "text": "Als hij zelfverzekerd door de loopgraven beende en zich tot de mannen richtte, kon hij net zo veel enthousiasme als hij wilde in zijn woorden leggen als hij refereerde aan de verpletterende nederlaag van de vijand die met een laatste salvo de genadeslag zou krijgen, maar de mannen gaven hem alleen wat vaag gemopper ten antwoord en stemden voorzichtigheidshalve zwijgend toe door naar hun kistjes te kijken."
                            },
                            {
                                "example_id": "c3e5107f-6d3d-4a5b-8b39-df8492435504",
                                "sense_id": "b85a2668-6ddf-34a3-91cd-ef7dd7dc87c5",
                                "text": "Het slagveld dat van schoonheid werd vervuld, het boomloze landschap dat baadde in de ochtendzon, wilde bloemen die de loopgraven vulden met hun warme geurflarden, de schoonheid van de natuur die alleen ervaren kon worden in aanwezigheid van de dood en met mannelijke deugden die alleen tot uitdrukking kwamen door het doden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a377a00-0418-483e-abff-15f056fc09c5",
                        "source_entry_id": "a12f5805-6cc4-3f8f-b250-77da7d19ad2e",
                        "source_sense_id": "b85a2668-6ddf-34a3-91cd-ef7dd7dc87c5",
                        "source_sense_description": "een uitgegraven geul, diep en breed genoeg dat men er in kan lopen...",
                        "target_lang_word": "trench",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trench",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0dfb1bd-07d6-34c1-aa40-6fcdf4204982",
                                        "entry_id": "1f2e96c2-4d6f-3baa-95b5-e73ed62d710d",
                                        "glosses": [
                                            "A long, narrow ditch or hole dug in the ground."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbeebce7-c4b7-47ab-a05a-4b1de74922f9",
                                                "sense_id": "a0dfb1bd-07d6-34c1-aa40-6fcdf4204982",
                                                "text": "The trenches for installing the underground cables were dug with a trencher."
                                            },
                                            {
                                                "example_id": "d228f71c-aebb-40f9-bb2a-65914674e664",
                                                "sense_id": "a0dfb1bd-07d6-34c1-aa40-6fcdf4204982",
                                                "text": "The milling action of the bucket line enables the trencher to cut through difficult materials, such as stone rubble and brick filling, and to leave a good trench with clean side walls."
                                            },
                                            {
                                                "example_id": "bf2ae672-0848-4176-a709-a599ebe22c4d",
                                                "sense_id": "a0dfb1bd-07d6-34c1-aa40-6fcdf4204982",
                                                "text": "Figure 114 shows how pegs driven into the bottom of a foundation trench to establish a horizontal level for the concreter to work to, can be levelled with a boning rod held upright on the pages at either end of the trench."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32982bc4-452d-3fe4-b836-eff867812ab9",
                                        "entry_id": "1f2e96c2-4d6f-3baa-95b5-e73ed62d710d",
                                        "glosses": [
                                            "A narrow excavation as used in warfare, as a cover for besieging or emplaced forces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47072239-5295-4637-b0ef-7632dbdc7f94",
                                                "sense_id": "32982bc4-452d-3fe4-b836-eff867812ab9",
                                                "text": "The soldiers in the trenches rely on logistical support."
                                            },
                                            {
                                                "example_id": "b67c43b8-b51f-4526-bc73-6d9f4c0f8a33",
                                                "sense_id": "32982bc4-452d-3fe4-b836-eff867812ab9",
                                                "text": "Following in the tank's wake, the cameliers reached the first line of Turkish trenches, where they confronted a handful of Ottoman soldiers too wounded to retreat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b26c60ff-fab4-3eb5-90bb-9fd789b7c03e",
                                        "entry_id": "1f2e96c2-4d6f-3baa-95b5-e73ed62d710d",
                                        "glosses": [
                                            "A pit, usually rectangular with smooth walls and floor, excavated during an archaeological investigation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "605ec219-ce99-3374-b8f7-6cce51afb9a5",
                                        "entry_id": "1f2e96c2-4d6f-3baa-95b5-e73ed62d710d",
                                        "glosses": [
                                            "A trench coat."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2c2c6af-26bd-4f8f-bedf-fad8fbfe72c8",
                                                "sense_id": "605ec219-ce99-3374-b8f7-6cce51afb9a5",
                                                "text": "I was the first person in my high school to wear a trench and fedora constantly, and Ben was one of the first to wear a black trench."
                                            },
                                            {
                                                "example_id": "35c9d454-ecb4-4e4f-b1ac-91eb2bf3eb19",
                                                "sense_id": "605ec219-ce99-3374-b8f7-6cce51afb9a5",
                                                "text": "A classic trench can work in any kind of weather and goes well with almost anything."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "trench",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53769724-212e-39ec-8d14-5c5a361b1877",
                                        "entry_id": "3af0c058-cc8e-3f92-aa00-60ad33662b77",
                                        "glosses": [
                                            "To invade, especially with regard to the rights or the exclusive authority of another; to encroach."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc38983c-6c71-490f-96ac-6019dfcf8d9b",
                                                "sense_id": "53769724-212e-39ec-8d14-5c5a361b1877",
                                                "text": "Shee is the Judge, Thou Executioner, Or if thou needs would'st trench upon her power, Thou mightst have yet enjoy'd thy crueltie, With some more thrift, and more varietie."
                                            },
                                            {
                                                "example_id": "924fe363-b936-4eeb-a1c0-253d971b71c8",
                                                "sense_id": "53769724-212e-39ec-8d14-5c5a361b1877",
                                                "text": "Does it not seem as if for a creature to challenge to itself a boundless attribute, were to trench upon the prerogative of the divine nature?"
                                            },
                                            {
                                                "example_id": "d6565494-1535-4d05-9fcc-103b2e440226",
                                                "sense_id": "53769724-212e-39ec-8d14-5c5a361b1877",
                                                "text": "He could make what laws he pleased, as long as those laws did not trench upon property rights."
                                            },
                                            {
                                                "example_id": "2c76da02-c760-4081-88c2-cf1f7044ea66",
                                                "sense_id": "53769724-212e-39ec-8d14-5c5a361b1877",
                                                "text": "[O]ur ideas, therefore, must trench upon the province of tactics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a428937b-d092-355d-ae57-1fa34f767e87",
                                        "entry_id": "3af0c058-cc8e-3f92-aa00-60ad33662b77",
                                        "glosses": [
                                            "To excavate an elongated pit for protection of soldiers and or equipment, usually perpendicular to the line of sight toward the enemy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d116a75-a0e3-452b-a4bd-b3c360d933db",
                                                "sense_id": "a428937b-d092-355d-ae57-1fa34f767e87",
                                                "text": "No more shall trenching war channel her fields."
                                            },
                                            {
                                                "example_id": "eb5c16d4-ae54-4f0d-b298-93e6afdc78df",
                                                "sense_id": "a428937b-d092-355d-ae57-1fa34f767e87",
                                                "text": "Advanc'd upon the field there stood a mound\nOf earth congested, wall'd , and trench'd around"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a63d762e-3275-39b1-b9d9-8cc16a1bd510",
                                        "entry_id": "3af0c058-cc8e-3f92-aa00-60ad33662b77",
                                        "glosses": [
                                            "To excavate an elongated and often narrow pit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c2142512-def1-3d56-8bd1-5026291549f8",
                                        "entry_id": "3af0c058-cc8e-3f92-aa00-60ad33662b77",
                                        "glosses": [
                                            "To have direction; to aim or tend."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5b97ce6-fb6c-4d48-b9cf-f2131f58c7c5",
                                                "sense_id": "c2142512-def1-3d56-8bd1-5026291549f8",
                                                "text": "the reason and consequence thereof may trench to point of estate"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fc35386-48fe-3c27-ba37-ca39a780a0df",
                                        "entry_id": "3af0c058-cc8e-3f92-aa00-60ad33662b77",
                                        "glosses": [
                                            "To cut; to form or shape by cutting; to make by incision, hewing, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4c1d8cf-c904-4d70-80a4-4c040d852d2b",
                                                "sense_id": "6fc35386-48fe-3c27-ba37-ca39a780a0df",
                                                "text": "The wide wound that the boar had trenched / In his soft flank."
                                            },
                                            {
                                                "example_id": "6d8f5676-5392-4332-b9d4-e28f63c4c149",
                                                "sense_id": "6fc35386-48fe-3c27-ba37-ca39a780a0df",
                                                "text": "This weak impress of love is as a figure / Trenched in ice, which with an hour's heat\nDissolves to water, and doth lose its form."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85aeab73-6774-36ca-a18c-31e568c4499e",
                                        "entry_id": "3af0c058-cc8e-3f92-aa00-60ad33662b77",
                                        "glosses": [
                                            "To cut furrows or ditches in."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "717890f0-284e-4bf4-94db-f9899b829e48",
                                                "sense_id": "85aeab73-6774-36ca-a18c-31e568c4499e",
                                                "text": "to trench land for the purpose of draining it"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82508416-d0b9-364b-8dcc-07d7b34120fe",
                                        "entry_id": "3af0c058-cc8e-3f92-aa00-60ad33662b77",
                                        "glosses": [
                                            "To dig or cultivate very deeply, usually by digging parallel contiguous trenches in succession, filling each from the next."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72fdf456-ff7d-46cf-836d-29a2a2d3a400",
                                                "sense_id": "82508416-d0b9-364b-8dcc-07d7b34120fe",
                                                "text": "to trench a garden for certain crops"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7eba2118-298f-4221-bd9a-f75bea1585b9",
                        "source_entry_id": "a12f5805-6cc4-3f8f-b250-77da7d19ad2e",
                        "source_sense_id": "b85a2668-6ddf-34a3-91cd-ef7dd7dc87c5",
                        "source_sense_description": "een uitgegraven geul, diep en breed genoeg dat men er in kan lopen...",
                        "target_lang_word": "tranchée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tranchée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3871df4-4245-33aa-9951-867827d7f162",
                                        "entry_id": "6a9aadb1-cd19-3fbf-95cd-2f50840d9eed",
                                        "glosses": [
                                            "Ouverture, excavation longue et plus ou moins profonde pratiquée dans la terre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8277b018-8254-417b-b7cd-4cc00bfbbf03",
                                                "sense_id": "e3871df4-4245-33aa-9951-867827d7f162",
                                                "text": "On n’a pas encore bâti, mais la tranchée pour les fondations est faite."
                                            },
                                            {
                                                "example_id": "3b9fc106-55c3-4c6f-be7c-bfd68e8d1c87",
                                                "sense_id": "e3871df4-4245-33aa-9951-867827d7f162",
                                                "text": "Si plus tard, quand la ville aura pris un plus grand développement, 40 litres par seconde deviennent insuffisants, il sera facile de rouvrir la même tranchée et de placer un second tuyau à côté ou au-dessus du premier. […]. Le supplément de dépense qu'il occasionnera ne consistera que dans le coût des tuyaux et l'ouverture facile d'une tranchée déjà faite ; […]."
                                            },
                                            {
                                                "example_id": "5c0e1725-089f-4ad6-a4c4-a35f8bcc7153",
                                                "sense_id": "e3871df4-4245-33aa-9951-867827d7f162",
                                                "text": "— J’ai justement deux tranchées à mettre à l’alignement."
                                            },
                                            {
                                                "example_id": "c186f3e2-3b14-4859-b059-21f84fa772ab",
                                                "sense_id": "e3871df4-4245-33aa-9951-867827d7f162",
                                                "text": "Dumouriez le félicita et lui renouvela l'ordre de rendre la trouée de Noirval impraticable. Les paysans y vinrent avec des haches, des bêches et des pioches, creusèrent des tranchées et coupèrent les ponts de la Fournelle."
                                            },
                                            {
                                                "example_id": "c4a18f2b-6e4a-4511-a15c-9887a7e1e8ef",
                                                "sense_id": "e3871df4-4245-33aa-9951-867827d7f162",
                                                "text": "Au nord de Port-d’Attelle, la tranchée de Grolay, portion enterrée & point stratégique de la ligne Paris-Bâle permettant la traversée de ce village, fut définitivement obstruée par un sabotage à rebondissements opéré entre le 29 juillet & le 8 août."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f4dd34a-c376-3e66-8905-775ba4a21496",
                                        "entry_id": "6a9aadb1-cd19-3fbf-95cd-2f50840d9eed",
                                        "glosses": [
                                            "Entaille en longueur faite dans un mur pour y recevoir une solive ou pour retenir les tuyaux des cheminées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd4a40f3-6ab4-4c3c-b853-c3bbc36b55ca",
                                                "sense_id": "1f4dd34a-c376-3e66-8905-775ba4a21496",
                                                "text": "Tranchée de mur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34a8959a-9d69-3d0b-b83d-1b3ea7cd6ff9",
                                        "entry_id": "6a9aadb1-cd19-3fbf-95cd-2f50840d9eed",
                                        "glosses": [
                                            "Fossé qu’on creuse pour se mettre à couvert du feu, à proximité d’une place qu’on assiège ou d’une ligne de bataille, et dont les terres, jetées du côté de l’ennemi, forment un parapet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35b82cac-33c5-472c-b38c-3d643b92ced4",
                                                "sense_id": "34a8959a-9d69-3d0b-b83d-1b3ea7cd6ff9",
                                                "text": "Si elle n'a pas complètement réussi, cette attaque n'a pas été sans quelque résultat, car nos soldats ont pris deux tranchées et se sont avancées de deux cents mètres. C'est peu en soi, mais c'est déjà beaucoup dans la guerre défensive adoptée par les Allemands."
                                            },
                                            {
                                                "example_id": "0be90991-1a56-4f8c-adcf-cbbcba586982",
                                                "sense_id": "34a8959a-9d69-3d0b-b83d-1b3ea7cd6ff9",
                                                "text": "Là nous eûmes un guide, et c'était bien nécessaire, car les tranchées tournaient et revenaient de façon qu'on ne savait plus où était l'ennemi. Enfin, une tranchée sinueuse et caillouteuse, peu profonde, protégée d'un petit talus ; […]."
                                            },
                                            {
                                                "example_id": "9f437434-1c2c-4511-8bbc-2f948fae0e4d",
                                                "sense_id": "34a8959a-9d69-3d0b-b83d-1b3ea7cd6ff9",
                                                "text": "Il avait un couteau de tranchée et lacérait son Xénophon."
                                            },
                                            {
                                                "example_id": "71dc15fa-d9b4-499e-a267-350eda433726",
                                                "sense_id": "34a8959a-9d69-3d0b-b83d-1b3ea7cd6ff9",
                                                "text": "Il tomba le 16 février 1915 en menant l'assaut de sa compagnie contre une tranchée ennemie, dans les redoutables combats du Mesnil-lès-Hurlus dans la Marne. Il reçut la croix de guerre et la Légion d'honneur."
                                            },
                                            {
                                                "example_id": "0ce000c5-8134-42dd-97a1-b6d4e51e3950",
                                                "sense_id": "34a8959a-9d69-3d0b-b83d-1b3ea7cd6ff9",
                                                "text": "Le recto nous montre le Donjon du Château de Sillery dans la Marne après le bombardement. C'est là que combat Jules, dans les tranchées, comme artilleur, dans la bataille de la Marne."
                                            },
                                            {
                                                "example_id": "cb2c77aa-5174-49f0-8875-27ccb516a600",
                                                "sense_id": "34a8959a-9d69-3d0b-b83d-1b3ea7cd6ff9",
                                                "text": "Ô tranchées, sœurs profondes des murailles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cda8ce0-d4e6-31fb-a1d3-661c213f1047",
                                        "entry_id": "6a9aadb1-cd19-3fbf-95cd-2f50840d9eed",
                                        "glosses": [
                                            "Ensemble des personnes, des soldats, présents dans ce retranchement."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "953fd61c-caf6-439b-8477-5bd0fd540fd7",
                                                "sense_id": "8cda8ce0-d4e6-31fb-a1d3-661c213f1047",
                                                "text": "Les Boches préparaient un « sale » coup, et Luc, de quart au périscope, avait donné l’alerte à sa tranchée. Presque aussitôt le bacchanal se déchaîne : les obus pleuvent, les parapets sautent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27fff7a8-d20a-39d8-ab72-1875e15ec70c",
                                        "entry_id": "6a9aadb1-cd19-3fbf-95cd-2f50840d9eed",
                                        "glosses": [
                                            "Douleurs très aiguës qu’on ressent dans le ventre, dans les entrailles."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0515c723-39b4-4218-be93-5dfc57430e62",
                                                "sense_id": "27fff7a8-d20a-39d8-ab72-1875e15ec70c",
                                                "text": "Ce médicament lui a causé de violentes tranchées."
                                            },
                                            {
                                                "example_id": "d6be5dec-7a35-459f-b952-d6bf3332f0a9",
                                                "sense_id": "27fff7a8-d20a-39d8-ab72-1875e15ec70c",
                                                "text": "Quand les tranchées de l’accouchement prirent à cette femme."
                                            },
                                            {
                                                "example_id": "cd426e58-0c7c-498f-8d56-6f1217bb973a",
                                                "sense_id": "27fff7a8-d20a-39d8-ab72-1875e15ec70c",
                                                "text": "Mais, déjà la lumière était moins violente et, malgré les tranchées qui fouettaient de temps en temps son ventre, et une irritation qui enflammait ses reins et sa ceinture, Angelo s’attarda un instant pour être bien assuré du soir."
                                            },
                                            {
                                                "example_id": "4d68960f-2fed-464c-9bb2-aa641b8dae20",
                                                "sense_id": "27fff7a8-d20a-39d8-ab72-1875e15ec70c",
                                                "text": "Et il faut donner à tes paroles la mélodie la plus pitoyable que tu aies jamais entendue. Allons, autant ! Oui, c’est mieux. Mais il faut soupirer, soupirer comme un cheval qui a des tranchées. Comme ça !"
                                            },
                                            {
                                                "example_id": "5e564d5a-5cdd-4cae-b3b3-9236bcd14847",
                                                "sense_id": "27fff7a8-d20a-39d8-ab72-1875e15ec70c",
                                                "text": "Tranchées rouges : Tranchées fort violentes, en parlant des chevaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5d11d89-86ca-3122-a669-f27529beafd1",
                                        "entry_id": "6a9aadb1-cd19-3fbf-95cd-2f50840d9eed",
                                        "glosses": [
                                            "Dans une forêt, espace dégagé (non planté d’arbres), en ligne droite, pouvant servir pour les déplacements et servant en même temps de pare-feu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c953cf57-a683-40f5-a79f-3b0d2951ea80",
                                                "sense_id": "e5d11d89-86ca-3122-a669-f27529beafd1",
                                                "text": "La commune de Flin (Meurthe) est autorisée à continuer, sous la direction des agents forestiers locaux, l'ouverture de la tranchée commencée en 1833 dans la forêt qui lui appartient, et, à cet effet, à exploiter les bois qui se trouvent compris sur l'emplacement de ladite tranchée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tranchée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b9c5095d-21f5-3610-ac41-d62eab53dc34",
                                        "entry_id": "76713f97-6ac4-3a99-9196-26c4376f4d01",
                                        "glosses": [
                                            "Féminin singulier de tranché."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "635787f7-d1ab-40d3-aefe-019d4a54261f",
                                                "sense_id": "b9c5095d-21f5-3610-ac41-d62eab53dc34",
                                                "text": "L’opinion tranchée de Yannick Jaouen a aussi provoqué la colère de Bruno Berréhar."
                                            }
                                        ]
                                    }
                                ]
                            },
