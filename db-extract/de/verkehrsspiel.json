                "senses": [
                    {
                        "sense_id": "90d42a73-bafb-307b-af43-0b95b11ba1d3",
                        "entry_id": "555e8917-ee3e-3261-8e33-edafbd1cf64e",
                        "glosses": [
                            "Lernspiel, bei dem Bewegungsabläufe und Begegnungen des realen Verkehrs mit Spielfahrzeugen in Schonräumen simuliert werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa5d1911-92bf-4970-bf3d-e16656aa6e9f",
                                "sense_id": "90d42a73-bafb-307b-af43-0b95b11ba1d3",
                                "text": "„Um das Wissen zum Thema Verkehrserziehung spielerisch zu festigen, besteht die Möglichkeit, die Schüler ein eigenes Verkehrsspiel herstellen zu lassen.“"
                            },
                            {
                                "example_id": "a5d36e78-84bd-4647-93de-bd7cfca2fe20",
                                "sense_id": "90d42a73-bafb-307b-af43-0b95b11ba1d3",
                                "text": "„Wer die meisten Verkehrszeichen richtig deutet, die meisten Verkehrsfragen richtig beantwortet, bei den meisten Verkehrsproblemen eine passende Lösung weiß und außerdem im praktischen Verkehrsspiel erfolgreich war, wird zum ‚Verkehrskönig’ ausgerufen.“"
                            },
                            {
                                "example_id": "a02927ec-97b3-4539-ab6d-da494d098592",
                                "sense_id": "90d42a73-bafb-307b-af43-0b95b11ba1d3",
                                "text": "„Noch bis zum Freitag finden an vielen Berliner Schulen Fahrradparcours, Übungen, Wettbewerbe und Verkehrsspiele statt.“"
                            },
                            {
                                "example_id": "1a24ec45-8102-41c4-9df2-af6bb48d4e59",
                                "sense_id": "90d42a73-bafb-307b-af43-0b95b11ba1d3",
                                "text": "„Eine andere Methode, dem Verkehrsproblem mit mathematischen Mitteln beizukommen, ist das Verkehrsspiel im Sandkasten des elektronischen Zeitalters, am Computer.“"
                            },
                            {
                                "example_id": "3dc2604a-1dfc-4296-9601-eadd85c73647",
                                "sense_id": "90d42a73-bafb-307b-af43-0b95b11ba1d3",
                                "text": "„Trotzdem – ‚Taxifahrer unterwegs’ ist das beste zur Zeit auffindbare Verkehrsspiel, vielleicht, weil es nicht um das Lob von Polizei, Automobilklubs, Kultusministerien oder Treibstoffindustrie buhlt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
