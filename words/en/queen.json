                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "chess_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If he can reach the last row, he will <w>queen</w> his pawn.",
                            "target_lang_translations": {
                                "ru": "Если он сможет дойти до последнего ряда, он <w>проведет</w> пешку в ферзи.",
                                "zh": "如果他能到达最后一行，他就能让兵<w>升变</w>。"
                            }
                        },
                        {
