                    {
                        "sense_id": "6e377db5-b484-37fa-851a-b2ac21250c9d",
                        "entry_id": "a1b5a98c-24e5-3c8d-bc99-ea5e275e0374",
                        "glosses": [
                            "iets wat mensen zo bang maakt zodat ze bepaalde (ongewenste) handelingen niet uitvoeren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2296fd21-8a8b-430d-85eb-7c98637b03d7",
                                "sense_id": "6e377db5-b484-37fa-851a-b2ac21250c9d",
                                "text": "De jarenlange bezuinigingen hebben de Europese krijgsmachten zo uitgehold, dat atoomwapens voor de NAVO weer belangrijker worden als afschrikmiddel."
                            },
                            {
                                "example_id": "49875e81-5cbe-4f3a-9832-13c92203331d",
                                "sense_id": "6e377db5-b484-37fa-851a-b2ac21250c9d",
                                "text": "In loop van de 20e eeuw ontwikkelde Piet zich van een tamelijk onintelligent hulpje dat spreekt in kromme zinnen meer en meer tot een volwaardige assistent van de verstrooide Sint. Ook werd Zwarte Piet met de jaren steeds minder gebruikt als afschrikmiddel voor stoute kinderen. De roe om te slaan en de zak om kinderen naar Spanje te verschepen verdwenen naar de achtergrond."
                            }
                        ]
                    }
