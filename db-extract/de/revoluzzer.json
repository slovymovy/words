                "senses": [
                    {
                        "sense_id": "6795d7b2-a344-3878-8d58-af63c210ba60",
                        "entry_id": "d45403f6-8565-33dd-9cfa-fe3173d41261",
                        "glosses": [
                            "Person, die sich als Revolutionär aufspielt, aber tatsächlich keine revolutionären Ideale vertritt oder erfolglos bleibt"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "5e4496cb-ca40-4081-afd2-fc6a590390c4",
                                "sense_id": "6795d7b2-a344-3878-8d58-af63c210ba60",
                                "text": "„Der Maiaufstand scheiterte, der Revoluzzer Wagner verlor seinen Posten, wurde steckbrieflich verfolgt und floh in die Schweiz.“"
                            },
                            {
                                "example_id": "c5f4164a-d18b-4958-95f0-980aad90a8c8",
                                "sense_id": "6795d7b2-a344-3878-8d58-af63c210ba60",
                                "text": "„War einmal ein Revoluzzer,",
                                "translation": "Mit den Revoluzzern mit.“"
                            },
                            {
                                "example_id": "eeaf1ba1-ff35-4c3d-ba64-9bc92d9b72bd",
                                "sense_id": "6795d7b2-a344-3878-8d58-af63c210ba60",
                                "text": "„In Frankreich und der Sowjetunion, aber auch in Kuba, im Iran und in den arabischen Diktaturen, stellten die Revoluzzer die neue Oberschicht, die dann bald genauso viel Angst vor der Unterschicht hatte wie ihre Vorgänger.“"
                            },
                            {
                                "example_id": "823db87c-6f88-4e5a-b06b-6656bb56c35d",
                                "sense_id": "6795d7b2-a344-3878-8d58-af63c210ba60",
                                "text": "„Also nahmen viele Fürsten den Revoluzzern den Wind aus den Segeln, indem sie freundlich auf sie zugingen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
