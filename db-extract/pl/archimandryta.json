                    {
                        "translation_id": "ee573b99-8111-4085-ac6d-bcda3c2065d7",
                        "source_entry_id": "820ca58f-86a3-3604-a477-f3af4dcd933c",
                        "source_sense_id": "634f03f1-7729-34e0-8d15-3fb7a3cb67d2",
                        "target_lang_word": "archimandrite",
