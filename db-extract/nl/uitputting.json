                "senses": [
                    {
                        "sense_id": "49dbeec8-5180-3e62-b71b-3f5b5125a9be",
                        "entry_id": "085453fd-f9dd-3da0-bffc-6130d27e3b9f",
                        "glosses": [
                            "de toestand waarin iets of iemand aan het eind van zijn of haar krachten is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f5e5d32-649c-48e8-919c-4052f0c65064",
                                "sense_id": "49dbeec8-5180-3e62-b71b-3f5b5125a9be",
                                "text": "42 kilometer hardlopen veroorzaakt bij veel mensen enorme uitputting."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11668eab-85c0-4067-9a91-67c46802a6d0",
                        "source_entry_id": "085453fd-f9dd-3da0-bffc-6130d27e3b9f",
                        "source_sense_id": "49dbeec8-5180-3e62-b71b-3f5b5125a9be",
                        "source_sense_description": "de toestand waarin iets of iemand aan het eind van zijn of haar krachten is",
                        "target_lang_word": "Erschöpfung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erschöpfung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ed1be0f2-7579-32dd-9453-e4effafc99e3",
                                        "entry_id": "0fd17766-591c-3669-9743-211d4f99ba9f",
                                        "glosses": [
                                            "Zustand aufgebrauchter Reserven"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9c0146c-747b-4b41-baed-86e0815ba621",
                                                "sense_id": "ed1be0f2-7579-32dd-9453-e4effafc99e3",
                                                "text": "Die Erschöpfung der Mine brachte über 1000 Bergleute um ihren Arbeitsplatz."
                                            },
                                            {
                                                "example_id": "19390d89-8f36-4048-9083-1616fa197a2e",
                                                "sense_id": "ed1be0f2-7579-32dd-9453-e4effafc99e3",
                                                "text": "„In St. Joachimsthal begannen nach der Erschöpfung der reichsten Lagerstättenpartien die Ausbeuten aus den Silbergruben von der Mitte des 16. Jahrhunderts an bedenklich zu sinken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fcc24bb0-ddea-38c3-8052-b8d79b494c57",
                                        "entry_id": "0fd17766-591c-3669-9743-211d4f99ba9f",
                                        "glosses": [
                                            "Schwäche, Kraftlosigkeit und sehr starke Ermüdung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b101c5ff-1983-4017-99bf-7b7214d5b17c",
                                                "sense_id": "fcc24bb0-ddea-38c3-8052-b8d79b494c57",
                                                "text": "Er rannte bis zur völligen Erschöpfung."
                                            },
                                            {
                                                "example_id": "ef931d32-e67c-4fcb-9e56-d2cc03f22ecd",
                                                "sense_id": "fcc24bb0-ddea-38c3-8052-b8d79b494c57",
                                                "text": "„Doch auch wenn es zu allen Zeiten vom Leben ermattete Menschen gab - die Erschöpfung als Massenleiden ist wohl wirklich ein Phänomen unserer Zeit.“"
                                            },
                                            {
                                                "example_id": "58660a59-3839-4c01-bb03-5c42d0e08017",
                                                "sense_id": "fcc24bb0-ddea-38c3-8052-b8d79b494c57",
                                                "text": "„Trotz ihrer Erschöpfung gingen sie noch hundert Yards weiter.“"
                                            },
                                            {
                                                "example_id": "3d594bcc-580f-4a5d-ae19-a17636324195",
                                                "sense_id": "fcc24bb0-ddea-38c3-8052-b8d79b494c57",
                                                "text": "„Melanie sah ihm die Erschöpfung an.“"
                                            },
                                            {
                                                "example_id": "4d02e06a-10fc-4372-acf4-9249fd2f6dfa",
                                                "sense_id": "fcc24bb0-ddea-38c3-8052-b8d79b494c57",
                                                "text": "„Blutverlust und frühere Erschöpfung hatten die Kräfte des jungen Menschen so ganz aufgerieben, daß sie ihn kaum mit Anstrengung aller ihrer Kräfte aufrecht erhalten konnten.“"
                                            },
                                            {
                                                "example_id": "2105a317-323b-4cf7-891f-71401f1b8bc3",
                                                "sense_id": "fcc24bb0-ddea-38c3-8052-b8d79b494c57",
                                                "text": "„Überflüssige Anstrengung bedeutete Erschöpfung, und Erschöpfung bedeutete unweigerllich den Tod.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e056628-8d51-4e84-9606-a6008ce3090b",
                        "source_entry_id": "085453fd-f9dd-3da0-bffc-6130d27e3b9f",
                        "source_sense_id": "49dbeec8-5180-3e62-b71b-3f5b5125a9be",
                        "source_sense_description": "de toestand waarin iets of iemand aan het eind van zijn of haar krachten is",
                        "target_lang_word": "exhaustion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exhaustion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1988f4f5-feba-3421-94e1-9498e001d91d",
                                        "entry_id": "d6d8ba82-35bf-372c-bc5d-5f3a733e43c7",
                                        "glosses": [
                                            "The point of complete depletion, of the state of being used up."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "768b21e8-36e2-46ab-b010-cc7a95c40aa5",
                                                "sense_id": "1988f4f5-feba-3421-94e1-9498e001d91d",
                                                "text": "We worked the mine to exhaustion, there's nothing left to extract."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "663e6e66-c490-3b8a-9676-9c7264729437",
                                        "entry_id": "d6d8ba82-35bf-372c-bc5d-5f3a733e43c7",
                                        "glosses": [
                                            "Supreme tiredness; having exhausted energy."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a6fa4f0-c62c-4a02-8ad3-1a5a261e094a",
                                                "sense_id": "663e6e66-c490-3b8a-9676-9c7264729437",
                                                "text": "I ran in the marathon to exhaustion, then I collapsed and had to be carried away."
                                            },
                                            {
                                                "example_id": "99900432-3d94-419a-8db7-cb3871848968",
                                                "sense_id": "663e6e66-c490-3b8a-9676-9c7264729437",
                                                "text": "As soon as Julia returned with a constable, Timothy, who was on the point of exhaustion, prepared to give over to him gratefully. The newcomer turned out to be a powerful youngster, fully trained and eager to help, and he stripped off his tunic at once."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bfcc54a-22b5-3a62-afa7-44028aa37c60",
                                        "entry_id": "d6d8ba82-35bf-372c-bc5d-5f3a733e43c7",
                                        "glosses": [
                                            "The removal (by percolation etc) of an active medicinal constituent from plant material."
                                        ],
                                        "tags": [
                                            "dated",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1acd3017-1c85-371e-8501-31544a8c3141",
                                        "entry_id": "d6d8ba82-35bf-372c-bc5d-5f3a733e43c7",
                                        "glosses": [
                                            "The removal of all air from a vessel (the creation of a vacuum)."
                                        ],
                                        "tags": [
