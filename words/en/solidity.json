{
    "word_family": [
        "solid",
        "solidify"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2c9e26d6-38b7-331a-8f75-b922b28977ae",
                    "sense_definition": "The state or quality of being solid and firm.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>solidity</w> of the ice allowed us to walk across the frozen lake safely.",
                            "target_lang_translations": {
                                "de": "Die <w>Festigkeit</w> des Eises erlaubte es uns, sicher über den zugefrorenen See zu gehen."
                            }
                        },
                        {
                            "text": "Engineers tested the <w>solidity</w> of the foundation before building the skyscraper.",
                            "target_lang_translations": {
                                "de": "Die Ingenieure prüften die <w>Stabilität</w> des Fundaments, bevor sie den Wolkenkratzer bauten."
                            }
                        }
                    ],
                    "synonyms": [
                        "hardness",
                        "solidness",
                        "strength"
                    ],
                    "antonyms": [
                        "fluidity",
                        "instability"
                    ],
                    "common_phrases": [
                        "structural solidity",
                        "test the solidity"
                    ],
                    "target_lang_definitions": {
                        "de": "Der Zustand oder die Eigenschaft, fest, stabil und widerstandsfähig zu sein."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Festigkeit",
                                "target_lang_sense_clarification": "Eigenschaft, fest und widerstandsfähig zu sein"
                            },
                            {
                                "target_lang_word": "Stabilität",
                                "target_lang_sense_clarification": "Tragfähigkeit oder bauliche Festigkeit"
                            },
                            {
                                "target_lang_word": "Solidität",
                                "target_lang_sense_clarification": "Gediegenheit und Festigkeit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a0917d6-897d-323c-ba49-97610e05f0f5",
                    "sense_definition": "The volume or amount of space occupied by a solid object.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mathematician calculated the <w>solidity</w> of the complex geometric shape.",
                            "target_lang_translations": {
                                "de": "Der Mathematiker berechnete den <w>Rauminhalt</w> der komplexen geometrischen Form."
                            }
                        },
                        {
                            "text": "We measured the <w>solidity</w> of the container to see how much material it could hold.",
                            "target_lang_translations": {
                                "de": "Wir maßen das <w>Volumen</w> des Behälters, um zu sehen, wie viel Material er fassen konnte."
                            }
                        }
                    ],
                    "synonyms": [
                        "density",
                        "massiveness"
                    ],
                    "antonyms": [
                        "hollowness"
                    ],
                    "common_phrases": [
                        "calculate the solidity"
                    ],
                    "target_lang_definitions": {
                        "de": "Das Volumen oder der Rauminhalt, den ein fester Körper einnimmt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Rauminhalt",
                                "target_lang_sense_clarification": "Volumen eines geometrischen Körpers"
                            },
                            {
                                "target_lang_word": "Volumen",
                                "target_lang_sense_clarification": "fassbares Ausmaß eines Körpers"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "838dca97-c757-3835-bc41-c06e9ceb6c82",
                    "sense_definition": "The quality of being reliable, valid, or morally firm.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>solidity</w> of his argument convinced the jury of his innocence.",
                            "target_lang_translations": {
                                "de": "Die <w>Stichhaltigkeit</w> seiner Argumentation überzeugte die Geschworenen von seiner Unschuld."
                            }
                        },
                        {
                            "text": "She questioned the <w>solidity</w> of the evidence presented in the report.",
                            "target_lang_translations": {
                                "de": "Sie zweifelte an der <w>Fundiertheit</w> der im Bericht vorgelegten Beweise."
                            }
                        }
                    ],
                    "synonyms": [
                        "consistency",
                        "soundness"
                    ],
                    "antonyms": [
                        "weakness"
                    ],
                    "common_phrases": [
                        "solidity of argument"
                    ],
                    "target_lang_definitions": {
                        "de": "Die Eigenschaft, fundiert, verlässlich, stichhaltig oder moralisch standhaft zu sein."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Stichhaltigkeit",
                                "target_lang_sense_clarification": "von Argumenten oder Beweisen"
                            },
                            {
                                "target_lang_word": "Fundiertheit",
                                "target_lang_sense_clarification": "Zuverlässigkeit und gute Begründung"
                            },
                            {
                                "target_lang_word": "Solidität",
                                "target_lang_sense_clarification": "Verlässlichkeit oder moralische Beständigkeit"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}