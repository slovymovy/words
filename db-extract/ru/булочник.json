                ],
                "translations": [
                    {
                        "translation_id": "0662740a-ea60-4b37-a648-0acff2f25407",
                        "source_entry_id": "995af501-213a-3073-b126-bf3a83ebb957",
                        "target_lang_word": "baker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31029b3c-91c5-3db3-8a21-4792e5ebe232",
                                        "entry_id": "3209ec2f-b74e-38bb-823d-a7505dd55238",
                                        "glosses": [
                                            "A person who bakes and sells bread, cakes and similar items."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "225968da-68c7-4859-aab1-6fab2eff8757",
                                                "sense_id": "31029b3c-91c5-3db3-8a21-4792e5ebe232",
                                                "text": "But through the oligopoly, charcoal fuel proliferated throughout London's trades and industries. By the 1200s, brewers and bakers, tilemakers, glassblowers, pottery producers, and a range of other craftsmen all became hour-to-hour consumers of charcoal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b2c1041-ed1b-3d1e-b1d8-23022e2617c7",
                                        "entry_id": "3209ec2f-b74e-38bb-823d-a7505dd55238",
                                        "glosses": [
                                            "A portable oven for baking."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "87b9da0d-a0c0-3e49-9b13-6f6b4bf1bffb",
                                        "entry_id": "3209ec2f-b74e-38bb-823d-a7505dd55238",
                                        "glosses": [
                                            "An apple suitable for baking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbf469ba-7941-4bb5-b309-9524189349d5",
                                                "sense_id": "87b9da0d-a0c0-3e49-9b13-6f6b4bf1bffb",
                                                "text": "Wealthys and McIntoshes are not good bakers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99c182f2-e3ba-40d4-ae18-27fb0525d0c4",
                        "source_entry_id": "995af501-213a-3073-b126-bf3a83ebb957",
                        "target_lang_word": "boulanger",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boulanger",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "795bfda9-bbf4-3147-9f16-0f079314a399",
                                        "entry_id": "c809dd8b-d4ca-3a7c-8a19-1c5c53d9fc6a",
                                        "glosses": [
                                            "Relatif à la boulangerie, à la fabrication du pain."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69064db2-eca2-4473-9e2e-e97feb611e3c",
                                                "sense_id": "795bfda9-bbf4-3147-9f16-0f079314a399",
                                                "text": "Nous revenons maintenant sur ce sujet, mais à un autre point de vue : au lieu d’étudier la composition chimique de la farine en général, il s’agit cette fois d’appliquer l'examen chimique à la détermination de la valeur boulangère relative d’une farine donnée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "boulanger",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "54204823-57bc-3c3d-af31-f8e7ca5bbe2c",
                                        "entry_id": "34769880-69bf-355e-84f5-60b79222ba52",
                                        "glosses": [
                                            "Artisan dont le métier est de fabriquer ou de vendre le pain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "605f3928-06dc-4bf1-91d4-f432a896f355",
                                                "sense_id": "54204823-57bc-3c3d-af31-f8e7ca5bbe2c",
                                                "text": "Gabelle des boulangers. — Ladite gabelle consiste en ce que tous les boulangers qui vendent pains cuits en la ville doivent 2 deniers par resal de farine ; les déforains, 1 gr. 8 den. par chacune charrette, et 4 den. de chacune charpagnée ou hottée."
                                            },
                                            {
                                                "example_id": "f7964729-bb52-4c4e-843d-4f8727c2ea99",
                                                "sense_id": "54204823-57bc-3c3d-af31-f8e7ca5bbe2c",
                                                "text": "Pour pallier cette fermeture privant les Taulésiens de pain frais chaque matin pendant quelques semaines, le couple a décidé de proposer un dépôt de pain au sein de son établissement, en collaboration avec un artisan-boulanger du Léon, à partir de ce lundi, « et ce jusqu’à l’arrivée des nouveaux boulangers et la réouverture du commerce, courant septembre », précise Patrick Le Carré."
                                            },
                                            {
                                                "example_id": "acd49140-68ee-405d-b507-c9746dc152d8",
                                                "sense_id": "54204823-57bc-3c3d-af31-f8e7ca5bbe2c",
                                                "text": "Cambronne Mâcheclair plaisanta avec l’une, admira le ti moune de l’autre, et, de palabre en palabre, il apprit que Chimène-Surprise avait regagné son domicile la veille au soir et qu’elle en était repartie presque aussitôt pour une destination inconnue de tous — sauf, probablement, de son bon ami : un boulanger établi dans les beaux quartiers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ceb3769f-3732-3cb9-abfd-d9cbfb547435",
                                        "entry_id": "34769880-69bf-355e-84f5-60b79222ba52",
                                        "glosses": [
                                            "Tenant d’une boulangerie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5ca9f6f-e7c6-425a-a622-d04e6e87431d",
                                                "sense_id": "ceb3769f-3732-3cb9-abfd-d9cbfb547435",
                                                "text": "La boutique, le fonds d’un boulanger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f13fee2a-e39d-30c3-a66a-47909aa304f3",
                                        "entry_id": "34769880-69bf-355e-84f5-60b79222ba52",
                                        "glosses": [
                                            "Diable."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0e532a9-d58d-4aca-a03f-edebc4578b1f",
                                                "sense_id": "f13fee2a-e39d-30c3-a66a-47909aa304f3",
                                                "text": "S’il y arrive, dit le Biffon, je ne le crois pas tout à fait Meg (Dieu) ; mais il aura, comme on le prétend, bouffardé avec le boulanger (fumé une pipe avec le diable)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "boulanger",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b560dbdf-e064-39d1-a992-88e5775fde2a",
                                        "entry_id": "7525158f-c70c-35ad-8cb0-b2855905b79f",
                                        "glosses": [
                                            "Préparer et faire cuire le pain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5169554-2b83-44ce-aa47-896c8d40c48a",
                                                "sense_id": "b560dbdf-e064-39d1-a992-88e5775fde2a",
                                                "text": "La grande Nanon, son unique servante, quoiqu’elle ne fût plus jeune, boulangeait elle-même tous les samedis le pain de la maison."
                                            },
                                            {
                                                "example_id": "2161031e-9374-4280-9b22-ad1953683b6e",
                                                "sense_id": "b560dbdf-e064-39d1-a992-88e5775fde2a",
                                                "text": "La fille de basse-cour boulangeait."
                                            },
                                            {
                                                "example_id": "9d1782ed-fddd-4508-a6e2-76d3066d1a70",
                                                "sense_id": "b560dbdf-e064-39d1-a992-88e5775fde2a",
                                                "text": "Elle chauffa son four, et fit, aidée par sa mère, un pâté de lièvre et de canard, un gâteau de riz, rôtit deux poulets, prit trois bouteilles de vin, et boulangea elle-même deux pains ronds."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
