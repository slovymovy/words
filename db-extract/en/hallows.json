                    {
                        "translation_id": "a34cc697-e3b6-469b-8a3b-86054f7646c4",
                        "source_entry_id": "72a48c0f-8462-37d3-9bdf-947dcaaf62ed",
                        "source_sense_id": "09a2335a-31d6-333d-851e-00a543063b6d",
