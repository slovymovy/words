                "senses": [
                    {
                        "sense_id": "e0bd7825-3c44-3380-a65a-d4942c880dda",
                        "entry_id": "ff1c44c2-68e3-3d96-a66a-8088d3026531",
                        "glosses": [
                            "Ball, der vom Schiedsrichter nach Spielunterbrechungen, denen kein Regelverstoß vorangegangen war, neutral ins Spiel gebracht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60613179-26c3-4484-8c2a-6214d304400d",
                                "sense_id": "e0bd7825-3c44-3380-a65a-d4942c880dda",
                                "text": "„Wenn der Ball während des Spiels platzt oder aus anderen Gründen unspielbar wird, wird er auf Anweisung des Schiedsrichters ausgetauscht. Das Spiel wird dann mit einem Schiedsrichterball von der Stelle, an der der Ball beschädigt wurde, fortgesetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
