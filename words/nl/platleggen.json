{
    "word_family": [
        "plat",
        "leggen",
        "platliggen",
        "platlegging"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "829e3e49-6077-3f43-9b48-249de101b82d",
                    "sense_definition": "iets in een horizontale of vlakke positie neerleggen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysieke handeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De hond was bang en besloot zijn oren <w>plat</w> te <w>leggen</w> tegen zijn kop.",
                            "target_lang_translations": {
                                "en": "The dog was scared and decided to <w>flatten</w> its ears against its head."
                            }
                        },
                        {
                            "text": "Je moet de stoelen eerst <w>platleggen</w> voordat we de grote tafel in de auto kunnen schuiven.",
                            "target_lang_translations": {
                                "en": "You must <w>fold down</w> the seats first before we can slide the large table into the car."
                            }
                        }
                    ],
                    "antonyms": [
                        "rechtop zetten"
                    ],
                    "common_phrases": [
                        "oren platleggen",
                        "stoelen platleggen"
                    ],
                    "target_lang_definitions": {
                        "en": "to place something in a horizontal or flat position"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lay flat",
                                "target_lang_sense_clarification": "to place something horizontally"
                            },
                            {
                                "target_lang_word": "flatten",
                                "target_lang_sense_clarification": "to make something flat, like ears or seats"
                            },
                            {
                                "target_lang_word": "fold down",
                                "target_lang_sense_clarification": "specifically for seats or furniture"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f82c81bc-8e77-3586-9db4-372472ae336d",
                    "sense_definition": "ervoor zorgen dat een systeem, netwerk of proces stopt met functioneren",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "buiten werking stellen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hackers probeerden gisteren het hele computernetwerk van de bank <w>plat</w> te <w>leggen</w>.",
                            "target_lang_translations": {
                                "en": "Hackers tried to <w>shut down</w> the bank's entire computer network yesterday."
                            }
                        },
                        {
                            "text": "Een grote stroomstoring kan het treinverkeer in het hele land volledig <w>platleggen</w>.",
                            "target_lang_translations": {
                                "en": "A major power outage can completely <w>paralyze</w> train traffic across the entire country."
                            }
                        }
                    ],
                    "synonyms": [
                        "stilleggen",
                        "lamleggen"
                    ],
                    "antonyms": [
                        "activeren",
                        "opstarten"
                    ],
                    "common_phrases": [
                        "het verkeer platleggen",
                        "een systeem platleggen"
                    ],
                    "target_lang_definitions": {
                        "en": "to cause a system, network, or process to stop functioning"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "paralyze",
                                "target_lang_sense_clarification": "to bring a system or traffic to a standstill"
                            },
                            {
                                "target_lang_word": "shut down",
                                "target_lang_sense_clarification": "to stop a network or operation"
                            },
                            {
                                "target_lang_word": "cripple",
                                "target_lang_sense_clarification": "to severely disable a system or infrastructure"
                            },
                            {
                                "target_lang_word": "bring to a halt",
                                "target_lang_sense_clarification": "to cause all movement or activity to stop"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6541eee3-3a25-3f89-b238-9500e89a962c",
                    "sense_definition": "de activiteiten in een bedrijf of sector stoppen, vaak door middel van een staking",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "buiten werking stellen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vakbonden dreigen de fabriek <w>plat</w> te <w>leggen</w> als de lonen niet omhoog gaan.",
                            "target_lang_translations": {
                                "en": "The unions are threatening to <w>shut down</w> the factory if wages are not increased."
                            }
                        },
                        {
                            "text": "Door de massale staking besloten de arbeiders het werk volledig <w>plat</w> te <w>leggen</w>.",
                            "target_lang_translations": {
                                "en": "Due to the massive strike, the workers decided to <w>bring</w> the work to a complete <w>standstill</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "stilleggen"
                    ],
                    "common_phrases": [
                        "het werk platleggen",
                        "een fabriek platleggen"
                    ],
                    "target_lang_definitions": {
                        "en": "to stop activities in a company or sector, often through a strike"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shut down",
                                "target_lang_sense_clarification": "to stop production or operations in a factory"
                            },
                            {
                                "target_lang_word": "bring to a standstill",
                                "target_lang_sense_clarification": "to stop all work activity"
                            },
                            {
                                "target_lang_word": "paralyze",
                                "target_lang_sense_clarification": "to stop an entire industry from working"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cbf447d7-cae6-34ac-9fa6-cd3f786c9f7b",
                    "sense_definition": "iets definitief sluiten, afbreken of onbruikbaar maken",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "buiten werking stellen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De overheid heeft besloten om de verouderde mijnen in deze regio definitief <w>plat</w> te <w>leggen</w>.",
                            "target_lang_translations": {
                                "en": "The government has decided to <w>close down</w> the outdated mines in this region for good."
                            }
                        },
                        {
                            "text": "Het plan is om de illegale handel volledig <w>plat</w> te <w>leggen</w> door strengere controles.",
                            "target_lang_translations": {
                                "en": "The plan is to completely <w>dismantle</w> the illegal trade through stricter controls."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een industrie platleggen"
                    ],
                    "target_lang_definitions": {
                        "en": "to permanently close, dismantle, or make something unusable"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "close down",
                                "target_lang_sense_clarification": "to permanently end operations of a facility"
                            },
                            {
                                "target_lang_word": "dismantle",
                                "target_lang_sense_clarification": "to break down a structure or trade network"
                            },
                            {
                                "target_lang_word": "shut down",
                                "target_lang_sense_clarification": "to permanently stop an industry or trade"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}