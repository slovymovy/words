                    {
                        "sense_id": "c7a96702-51a0-33eb-9171-771bf014fdd5",
                        "entry_id": "f13f78ad-55b4-33a2-b819-0cf39cbc0f63",
                        "glosses": [
                            "Soldat im Range eines Panzerschützen"
