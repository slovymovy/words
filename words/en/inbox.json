{
    "word_family": [
        "outbox"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3d4cc920-d918-3917-8c24-2524f4919230",
                    "sense_definition": "An electronic folder where incoming emails or messages are received and stored.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "communication_storage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have over fifty unread messages in my <w>inbox</w> this morning.",
                            "target_lang_translations": {
                                "ru": "Этим утром у меня во <w>входящих</w> более пятидесяти непрочитанных сообщений."
                            }
                        },
                        {
                            "text": "Your goal with the remaining emails is to remove them from your <w>inbox</w> as soon as possible.",
                            "target_lang_translations": {
                                "ru": "Ваша цель в отношении оставшихся писем — как можно скорее убрать их из <w>почтового ящика</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "outbox"
                    ],
                    "common_phrases": [
                        "check your inbox",
                        "full inbox",
                        "email inbox"
                    ],
                    "target_lang_definitions": {
                        "ru": "Электронная папка, в которой принимаются и хранятся входящие электронные письма или сообщения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "входящие",
                                "target_lang_sense_clarification": "папка с письмами"
                            },
                            {
                                "target_lang_word": "почтовый ящик",
                                "target_lang_sense_clarification": "электронная почта"
                            },
                            {
                                "target_lang_word": "инбокс",
                                "target_lang_sense_clarification": "сленг, папка входящих сообщений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94f30c7d-d931-3d58-be0b-f2a7ba81d46e",
                    "sense_definition": "A physical tray or container on a desk for incoming documents and papers to be processed.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "communication_storage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please leave the signed contract in my <w>inbox</w> before you leave the office.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, оставьте подписанный контракт в моем <w>лотке для входящих</w>, прежде чем уйдете из офиса."
                            }
                        },
                        {
                            "text": "The wooden <w>inbox</w> on his desk was overflowing with mail and reports.",
                            "target_lang_translations": {
                                "ru": "Деревянный <w>лоток для бумаг</w> на его столе был переполнен почтой и отчетами."
                            }
                        }
                    ],
                    "synonyms": [
                        "in-basket",
                        "in-tray"
                    ],
                    "antonyms": [
                        "outbox"
                    ],
                    "common_phrases": [
                        "office inbox",
                        "wooden inbox"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физический лоток или контейнер на рабочем столе для входящих документов и бумаг, подлежащих обработке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лоток для входящих бумаг",
                                "target_lang_sense_clarification": "канцелярский предмет"
                            },
                            {
                                "target_lang_word": "корзина для входящих",
                                "target_lang_sense_clarification": "настольный органайзер"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f3edb42-8b39-3b82-baab-b0b87a791a5c",
                    "sense_definition": "The total collection of tasks, problems, or items that require a person's immediate attention.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mental_workload",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With the new project starting, my mental <w>inbox</w> is completely overwhelmed.",
                            "target_lang_translations": {
                                "ru": "С началом нового проекта мой «ментальный <w>список дел</w>» полностью перегружен."
                            }
                        },
                        {
                            "text": "The kids, my ex, my parents, the job, bills — my <w>inbox</w> is full.",
                            "target_lang_translations": {
                                "ru": "Дети, бывший, родители, работа, счета — моя <w>голова</w> забита до отказа."
                            }
                        }
                    ],
                    "common_phrases": [
                        "inbox is full"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used metaphorically to describe personal workload"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Общая совокупность задач, проблем или вопросов, требующих немедленного внимания человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "список дел",
                                "target_lang_sense_clarification": "метафорически о нагрузке"
                            },
                            {
                                "target_lang_word": "голова",
                                "target_lang_sense_clarification": "в контексте перегруженности задачами"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "58f99945-dafd-3dec-bd34-5d5f2b4b020a",
                    "sense_definition": "To send a private electronic message to someone, typically on social media.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "digital_communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you are interested in the sofa, please <w>inbox</w> me for the price.",
                            "target_lang_translations": {
                                "ru": "Если вас заинтересовал диван, пожалуйста, <w>напишите мне в личку</w>, чтобы узнать цену."
                            }
                        },
                        {
                            "text": "Recently a sister <w>inboxed</w> me on Facebook and told me that she knew I wanted her.",
                            "target_lang_translations": {
                                "ru": "Недавно одна сестра <w>написала мне в личку</w> на Facebook и сказала, что знает о моих чувствах."
                            }
                        }
                    ],
                    "synonyms": [
                        "message"
                    ],
                    "common_phrases": [
                        "inbox me"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "common in social media contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отправить личное электронное сообщение кому-либо, обычно в социальных сетях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "написать в личку",
                                "target_lang_sense_clarification": "социальные сети"
                            },
                            {
                                "target_lang_word": "написать в директ",
                                "target_lang_sense_clarification": "Instagram или подобные платформы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2fe92226-1335-3e37-9d6d-1dedfffa32a4",
                    "sense_definition": "To place a specific document or file into someone's electronic or physical inbox.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "digital_communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I just <w>inboxed</w> you the presentation so you can review it before the meeting.",
                            "target_lang_translations": {
                                "ru": "Я только что <w>скинул</w> тебе презентацию <w>во входящие</w>, чтобы ты мог просмотреть ее перед встречей."
                            }
                        },
                        {
                            "text": "The assistant <w>inboxed</w> the files as soon as they were printed.",
                            "target_lang_translations": {
                                "ru": "Ассистент <w>положил</w> файлы <w>в лоток для входящих</w>, как только они были распечатаны."
                            }
                        }
                    ],
                    "common_phrases": [
                        "inbox the file"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поместить определенный документ или файл в чей-либо электронный или физический ящик для входящих сообщений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скинуть во входящие",
                                "target_lang_sense_clarification": "отправить файл или документ"
                            },
                            {
                                "target_lang_word": "положить в лоток",
                                "target_lang_sense_clarification": "физический документ"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}