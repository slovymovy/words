                                "target_lang_word": "verbal",
                                "target_lang_sense_clarification": "que pertenece o concierne a la palabra"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3fc644bf-470f-3a2d-8064-7c5d6a417e5a",
                    "sense_definition": "Capable of using speech.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ability_to_speak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The therapist worked hard to help the non-verbal child become <w>verbal</w>.",
                            "target_lang_translations": {
                                "ru": "Терапевт усердно работал, чтобы помочь невербальному ребенку стать <w>говорящим</w>.",
                                "zh": "治疗师努力帮助那个无法说话的孩子变得<w>会说话</w>。",
                                "es": "El terapeuta trabajó duro para ayudar al niño no verbal a <w>desarrollar el habla</w>."
                            }
                        },
                        {
                            "text": "Although he is <w>verbal</w>, he struggles to communicate his emotions effectively.",
                            "target_lang_translations": {
                                "ru": "Хотя он <w>владеет речью</w>, ему трудно эффективно выражать свои эмоции.",
                                "zh": "虽然他<w>有语言能力</w>，但他难以有效地表达自己的情绪。",
                                "es": "Aunque <w>puede hablar</w>, le cuesta comunicar sus emociones de manera efectiva."
                            }
                        }
                    ],
                    "antonyms": [
                        "non-verbal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способный говорить, владеющий речью.",
                        "zh": "具备说话能力的。",
                        "es": "Capaz de usar el habla."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "владе́ющий ре́чью",
                                "target_lang_sense_clarification": "able to speak"
