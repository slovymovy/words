                ],
                "senses": [
                    {
                        "sense_id": "d899833d-a322-3c45-ad9c-669370bead5f",
                        "entry_id": "f430c720-fdaa-32fd-a5b7-66b052daf26b",
                        "glosses": [
                            "Wissenschaftszweig, der die auf die Erde wirkenden und im Erdinneren erzeugten Kräfte behandelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "909a246f-234c-4018-947b-088b39769586",
                                "sense_id": "d899833d-a322-3c45-ad9c-669370bead5f",
                                "text": "Die Arbeitsgruppe Endogene Geodynamik untersucht die Bildungs- und Entwicklungsprozesse der Lithosphärenplatten, d.h. der Erdkruste und des darunter liegenden Lithosphärenmantels unter Verwendung geochemischer und petrologischer Methoden."
                            },
                            {
                                "example_id": "60c33661-2f75-45b2-a796-5d7155e62ea9",
                                "sense_id": "d899833d-a322-3c45-ad9c-669370bead5f",
                                "text": "Die Arbeitsgruppe Geodynamik (Structural Processes Group) beschäftigt sich mit der kinematischen und mechanischen Quantifizierung strukturgeologischer/tektonischer Prozesse in der duktilen und spröden Erdkruste."
                            },
                            {
                                "example_id": "cf0a8d02-0f56-49e8-bd8d-176022fcd801",
                                "sense_id": "d899833d-a322-3c45-ad9c-669370bead5f",
                                "text": "Neu gegenüber den Modellen von E. KRAUS (1956) und A. THURNER (1971) ist die Art der Geodynamik bzw. des Bewegungsmechanismus auf den Grundlagen der Plattentektonik zu werten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
