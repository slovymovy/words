{
    "word_family": [
        "fire",
        "storm"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d7141f8e-889e-3dcb-bae3-45a638e65fef",
                    "sense_definition": "A large, intense fire that creates its own wind system, causing it to spread rapidly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city was destroyed by a massive <w>firestorm</w> after the bombing.",
                            "target_lang_translations": {
                                "pl": "Miasto zostało zniszczone przez potężną <w>burzę ogniową</w> po bombardowaniu."
                            }
                        },
                        {
                            "text": "Strong winds turned the small blaze into a deadly <w>firestorm</w>.",
                            "target_lang_translations": {
                                "pl": "Silne wiatry zamieniły mały pożar w zabójczą <w>burzę ogniową</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "conflagration"
                    ],
                    "common_phrases": [
                        "massive firestorm"
                    ],
                    "target_lang_definitions": {
                        "pl": "Ogromny, intensywny pożar, który wytwarza własny system wiatrów, powodując jego gwałtowne rozprzestrzenianie się."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "burza ogniowa",
                                "target_lang_sense_clarification": "dosłowne określenie zjawiska fizycznego"
                            },
                            {
                                "target_lang_word": "pożar burzowy",
                                "target_lang_sense_clarification": "rzadsze określenie techniczne"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ce4e757-87c8-3720-abe6-614c0bf28e40",
                    "sense_definition": "A sudden, intense, and widespread public controversy or angry reaction.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "controversy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician's controversial remarks set off a <w>firestorm</w> of criticism.",
                            "target_lang_translations": {
                                "pl": "Kontrowersyjne uwagi polityka wywołały <w>burzę</w> krytyki."
                            }
                        },
                        {
                            "text": "The company faced a <w>firestorm</w> of public outrage after the scandal was revealed.",
                            "target_lang_translations": {
                                "pl": "Firma musiała zmierzyć się z <w>burzą</w> społecznego oburzenia po ujawnieniu skandalu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "set off a firestorm"
                    ],
                    "target_lang_definitions": {
                        "pl": "Nagła, intensywna i szeroko zakrojona kontrowersja publiczna lub gwałtowna reakcja."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "burza",
                                "target_lang_sense_clarification": "w kontekście medialnym lub społecznym"
                            },
                            {
                                "target_lang_word": "nawałnica",
                                "target_lang_sense_clarification": "metaforyczne określenie fali krytyki"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}