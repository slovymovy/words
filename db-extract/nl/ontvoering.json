                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49adadd8-a103-40f0-befd-4aff9e80cb75",
                                                "sense_id": "b94e5fb9-dd19-3d3e-8f66-958ad098af4d",
                                                "text": "But fear of abduction never stopped a good ufologist."
