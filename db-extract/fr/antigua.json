                "senses": [
                    {
                        "sense_id": "5304673e-2086-37be-8925-6157a6246dec",
                        "entry_id": "c1e16772-b49d-3da2-81c7-b91528226eb6",
                        "glosses": [
                            "Île faisant partie de l’État d’Antigua-et-Barbuda dans les Caraïbes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d541880d-b26c-41db-9de6-3362318607f9",
                                "sense_id": "5304673e-2086-37be-8925-6157a6246dec",
                                "text": "Saint-John’s (30000 habitants) est la capitale de l’île d’Antigua."
                            },
                            {
                                "example_id": "f9f3370f-49df-4b83-9022-93910c7c328f",
                                "sense_id": "5304673e-2086-37be-8925-6157a6246dec",
                                "text": "Territoire associé à la couronne britannique en 1967, Antigua obtient son indépendance en 1981 et a aujourd'hui un statut d’État indépendant membre du Commonwealth."
                            },
                            {
                                "example_id": "e0bef862-5849-4d53-973c-1d2625eb2c1f",
                                "sense_id": "5304673e-2086-37be-8925-6157a6246dec",
                                "text": "La dépendance de Barbuda vis-à-vis d’Antigua est, à cet égard, très démonstrative : sa desserte aérienne passe nécessairement par Antigua."
                            }
                        ]
                    }
