                "senses": [
                    {
                        "sense_id": "8b63dd35-130b-33ad-bef5-af0d447f5389",
                        "entry_id": "5ac4bde3-34bc-3dec-a7c6-05f5202951f2",
                        "glosses": [
                            "Wettspiel, das mit hoher physischer und/oder geistiger Anstrengung und Einsatzbereitschaft verbunden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "324192e8-1907-45f3-b21e-55f34d2aa115",
                                "sense_id": "8b63dd35-130b-33ad-bef5-af0d447f5389",
                                "text": "„Auch wenn das Leistungsspiel vom Prinzip her positiv beurteilt wird, messen die Experten diesem dennoch eine untergeordnete Bedeutung bei, wofür Experte K folgende Erklärung vorbringt: […].“"
                            },
                            {
                                "example_id": "7bb67eba-7bda-48fc-b9a2-8cd41f93f527",
                                "sense_id": "8b63dd35-130b-33ad-bef5-af0d447f5389",
                                "text": "„Generell können alle erwähnten Materialien für unterschiedliche Typen von Spiel eingesetzt werden. Genannt sei hier erstens das reine Leistungsspiel, bei dem die einzelnen Spielzüge und der Spielausgang vom erreichten Leistungsstand der beteiligten Kinder abhängen: […].“"
                            },
                            {
                                "example_id": "85b19eb5-5f95-4164-bdfd-94d737a7642b",
                                "sense_id": "8b63dd35-130b-33ad-bef5-af0d447f5389",
                                "text": "„Zwar ist das Pech in einem Zufallsspiel von den Kindern leichter hinnehmbar als die Niederlage in einem Leistungsspiel. Dennoch wird ihnen auch hier die Erfahrung des Verlierens nicht erspart.“"
                            },
                            {
                                "example_id": "988d51e4-b9b5-40f8-b7bd-729d474d2f0b",
                                "sense_id": "8b63dd35-130b-33ad-bef5-af0d447f5389",
                                "text": "„Aus dem Bewegungsspiel ist ein Leistungsspiel geworden, zugleich eine Selbstdarstellung.“"
                            },
                            {
                                "example_id": "cabb9c3c-c665-45ae-887e-ad732a245863",
                                "sense_id": "8b63dd35-130b-33ad-bef5-af0d447f5389",
                                "text": "„Als eine erste Kategorie nennt er das Bewegungsspiel, das als Tautologie gewertet wird, in Abgrenzung zum Leistungsspiel, das dann ein berechtigter Terminus ist, wenn man unter Bewegung das freie, selbstgesteuerte, aber nicht zweckgerichtete Handeln versteht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
