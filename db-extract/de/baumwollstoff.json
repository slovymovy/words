                                "target_senses": [
                                    {
                                        "sense_id": "6f266cb3-9c23-3fcb-b31f-13e5c5f19526",
                                        "entry_id": "fa8b1f27-48e1-30df-b465-6f4ec395a3b2",
                                        "glosses": [
                                            "A practice match between one or more organized teams usually in preparation for a more competitive format, such as a tournament."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae86d112-3f8d-4972-9eb1-bb0bdeb3c587",
                                                "sense_id": "6f266cb3-9c23-3fcb-b31f-13e5c5f19526",
                                                "text": "As a team, the players decided to focus less on streaming (a major source of income) and more on in-house scrims, VOD review and practice, hoping to become a better team."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scrim",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5ae72a2-54b6-30d4-9707-ace1a90bb0c6",
                                        "entry_id": "9588ea99-b444-3153-bbc5-d9ec2d07771a",
                                        "glosses": [
                                            "To participate in a scrim."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89b61150-4e4f-47a8-8a54-38b66de7c663",
                                                "sense_id": "f5ae72a2-54b6-30d4-9707-ace1a90bb0c6",
                                                "text": "Accusations of him drinking instead of scrimming with the team, not attending practices at all and playing guitar instead of scrimming surfaced."
                                            }
                                        ]
