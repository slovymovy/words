                "senses": [
                    {
                        "sense_id": "be98aa5f-797d-3a09-963c-851e3e9098d8",
                        "entry_id": "601a572a-588d-3dd4-a677-a67e694e0c49",
                        "glosses": [
                            "Kunststoffkarte mit einem magnetisierbaren Streifen zur Aufnahme bestimmter Kenndaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e56b3d7-e524-4da7-8caf-242fae90d501",
                                "sense_id": "be98aa5f-797d-3a09-963c-851e3e9098d8",
                                "text": "„Als Ferris sechsunddreißig Stunden später vor dem Eingang der CIA-Zentrale stand, stellte er als Erstes fest, dass seine Magnetkarte nicht mehr funktionierte.“"
                            },
                            {
                                "example_id": "a0cf4be3-bb32-4219-a921-8cfd293b61cc",
                                "sense_id": "be98aa5f-797d-3a09-963c-851e3e9098d8",
                                "text": "„In ein Polizeirevier reinzukommen ist leicht, wenn man dort arbeitet und eine Magnetkarte hat, mit der man eine Seitentür öffnen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
