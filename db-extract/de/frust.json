                                    {
                                        "sense_id": "1b004715-194c-3ecf-85d5-25fff34a853a",
                                        "entry_id": "429a4d28-4b29-314d-b53f-47d0899cf83e",
                                        "glosses": [
                                            "Anger not directed at anything or anyone in particular."
                                        ],
                                        "tags": [
