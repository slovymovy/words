                                        "entry_id": "f381f959-7998-387e-a108-9aaebd35b704",
                                        "glosses": [
                                            "A frivolous, playful, or wanton young woman; a giglet or giglot."
                                        ],
                                        "tags": [
                                            "informal",
                                            "obsolete"
                                        ],
