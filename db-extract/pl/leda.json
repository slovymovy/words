                    },
                    {
                        "translation_id": "e5bbe1ae-e889-4bff-a09c-9ec50597bbfc",
                        "source_entry_id": "f7f4611d-bb0c-3aac-bc5e-52ee068120af",
                        "source_sense_id": "c4a6b893-744d-3186-8951-fabfdd5d7302",
                        "target_lang_word": "Leda",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leda",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7dc53c55-1e6e-328c-a888-25f6b98b1c18",
                                        "entry_id": "a38d69ca-0a79-3bf8-a21d-d1cef7e2ca42",
                                        "glosses": [
                                            "Königin von Sparta und Geliebte des Gottes Zeus"
                                        ],
                                        "tags": [
                                            "griechische Mythologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32de6ff2-96a6-4e48-bb7a-f064e9f692af",
                                                "sense_id": "7dc53c55-1e6e-328c-a888-25f6b98b1c18",
                                                "text": "Leda, eine Königstochter von Aitolien, war mit dem aus Sparta vertriebenen König Tyndareos verheiratet."
                                            },
                                            {
                                                "example_id": "72220eaa-afe2-4114-b020-81d9a6959773",
                                                "sense_id": "7dc53c55-1e6e-328c-a888-25f6b98b1c18",
                                                "text": "Leda, die Mutter der schönen Helena, hatte zwei Söhne, Kastor und Polydeukes."
                                            },
                                            {
                                                "example_id": "dd918113-fb13-4ae1-82f0-0708ee3553ab",
                                                "sense_id": "7dc53c55-1e6e-328c-a888-25f6b98b1c18",
                                                "text": "Ein wunderschönes Beispiel brüderlicher Liebe gaben die Dioskuren Kastor und Polydeukes. Sie waren die Söhne der Leda, zu der Zeus in Gestalt eines Schwanes Einlaß fand, und die Brüder der Helena."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5d2b04cb-8b76-3908-ae10-7ea68b62539f",
                                        "entry_id": "a38d69ca-0a79-3bf8-a21d-d1cef7e2ca42",
                                        "glosses": [
                                            "ein Mond des Planeten Jupiter mit einem mittleren Durchmesser von 20 Kilometern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01545ce1-940a-426d-9e91-ec3d2a754e97",
                                                "sense_id": "5d2b04cb-8b76-3908-ae10-7ea68b62539f",
                                                "text": "Leda wurde am 14. September 1974 von dem Astronomen Charles Kowal auf fotografischen Platten entdeckt, die drei Tage zuvor am Observatorium auf dem Mount Palomar belichtet wurden."
                                            },
                                            {
                                                "example_id": "7ca5e53a-55e9-4032-b3ea-12b4d147b984",
                                                "sense_id": "5d2b04cb-8b76-3908-ae10-7ea68b62539f",
                                                "text": "Zwischen etwa 155 bis 165 Jupiterradien stoßen wir auf weitere Zwergmonde, so die Leda, die Himalia, die Lysithea und die Elara. Ihre Bahnen liegen erheblich außerhalb der Äquatorebene und weisen deutliche Exzentrizitäten auf."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
