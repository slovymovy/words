                "senses": [
                    {
                        "sense_id": "d40c8ea0-06fa-3b50-8523-ad4b6176a759",
                        "entry_id": "da13ff9c-2df7-37e8-89e9-1e45350ac401",
                        "glosses": [
                            "Faire perdre son style journalistique à."
                        ],
                        "tags": [
                            "Hapax"
                        ],
                        "examples": [
                            {
                                "example_id": "4eb9ea86-2da3-46c7-aff3-04d4fa9f4603",
                                "sense_id": "d40c8ea0-06fa-3b50-8523-ad4b6176a759",
                                "text": "Certes il faut rééditer « Mort à crédit » avec la préface d’Hindus (le salaud a tourné casaque, raison de plus !) et décanarder le texte."
                            }
                        ]
                    },
                    {
                        "sense_id": "cd948a8d-084b-3146-a64b-b8196f0fb803",
                        "entry_id": "da13ff9c-2df7-37e8-89e9-1e45350ac401",
                        "glosses": [
                            "Variante de déconner, utilisée pour éviter les gros mots."
                        ],
                        "tags": [
                            "Sens propre à la famille mentionnée ?"
                        ],
                        "examples": [
                            {
                                "example_id": "02b0a216-2837-4277-8cdb-b805deee5e18",
                                "sense_id": "cd948a8d-084b-3146-a64b-b8196f0fb803",
                                "text": "Faut pas déconner - pardon décanarder - à cet âge là, les bébés ça commence à parler. En dehors des gros mots, je veux dire."
                            }
                        ]
                    }
