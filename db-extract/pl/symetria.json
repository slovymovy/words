                        "source_entry_id": "fb5ec4d4-cb69-3e0b-9cd5-e6ccc210c698",
                        "source_sense_id": "de0f02ad-ac91-3e28-a489-eb07a71041c7",
                        "target_lang_word": "Symmetrie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Symmetrie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50f33db6-bd12-30d8-b212-82bbd0a1217a",
                                        "entry_id": "29a1c871-a21f-3d1a-b694-e172bafa1ea9",
                                        "glosses": [
                                            "spiegelbildliche Gleichheit"
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22adca20-a199-4ff0-af73-a0ae82336a5c",
                                                "sense_id": "50f33db6-bd12-30d8-b212-82bbd0a1217a",
                                                "text": "„Das Gottesteilchen, das Higgs-Boson beweist damit nur eines: Leben ist eine Störung der Symmetrie.“"
                                            },
                                            {
                                                "example_id": "e40986b6-8cba-46fe-88f0-2f7932ce6454",
                                                "sense_id": "50f33db6-bd12-30d8-b212-82bbd0a1217a",
                                                "text": "Die Symmetrie von Funktiongraphen verständlich erklärt und viele Aufgaben mit Lösungen in unserem kostenlosen Online-Mathebuch."
                                            },
                                            {
                                                "example_id": "38fd26c4-e8c9-4fd2-b07d-fab1c7bc084e",
                                                "sense_id": "50f33db6-bd12-30d8-b212-82bbd0a1217a",
                                                "text": "Die Nieren sind als Organe in Symmetrie angelegt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b511e661-27cb-3684-bd27-dad245e1927d",
                                        "entry_id": "29a1c871-a21f-3d1a-b694-e172bafa1ea9",
                                        "glosses": [
                                            "Entsprechung, wo eine Sache der anderen (und beide sich) entsprechen und wie ein Spiegelbild zueinander stehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5b05ee2-e036-45ac-aa66-78856acb22df",
                                                "sense_id": "b511e661-27cb-3684-bd27-dad245e1927d",
                                                "text": "„Das Gottesteilchen, das Higgs-Boson beweist damit nur eines: Leben ist eine Störung der Symmetrie.“"
                                            },
                                            {
                                                "example_id": "fed5fe1f-f507-470c-a5f8-b534b0c64450",
                                                "sense_id": "b511e661-27cb-3684-bd27-dad245e1927d",
                                                "text": "„Symmetrie und Harmonie waren bei den Pythagoreern zentrale Leitbegriffe für die Deutung und Interpretation alles Seienden.“"
                                            },
                                            {
                                                "example_id": "b6d1987e-19b0-4436-939c-86abe9fdc4a3",
                                                "sense_id": "b511e661-27cb-3684-bd27-dad245e1927d",
                                                "text": "„Die Untersuchung von Bartóks Musikanschauung wird allerdings zeigen, daß dies keine bewußte Einschränkung des Vertrauens in Symmetrie als ein organisierendes Strukturmittel bedeuten muß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
