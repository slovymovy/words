                "senses": [
                    {
                        "sense_id": "5695acf8-a99e-3cc1-9d26-576b9195b06b",
                        "entry_id": "a1e705a0-5919-365a-a604-055f6234da44",
                        "glosses": [
                            "Spielwürfel, mit dem in der Fastenzeit die Art des Fastens durch das gewürfelte Symbol bestimmt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be8f5726-da12-4b6c-9308-c376f35443e3",
                                "sense_id": "5695acf8-a99e-3cc1-9d26-576b9195b06b",
                                "text": "Eine Entdeckungsreise von Aschermittwoch bis Karsamstag können Familien mit dem Fastenwürfel machen: täglich rund 15 Minuten abwechslungsreiches Spiel, das alle Sinne anspricht."
                            },
                            {
                                "example_id": "41077f60-00c6-44f9-93e3-784bbfcf5a71",
                                "sense_id": "5695acf8-a99e-3cc1-9d26-576b9195b06b",
                                "text": "Mit dem Fastenwürfel kannst du täglich würfeln und fastest je nach dem gewürfelten Symbol."
                            },
                            {
                                "example_id": "59489743-db8b-4b09-9f33-a35c430ed003",
                                "sense_id": "5695acf8-a99e-3cc1-9d26-576b9195b06b",
                                "text": "Es werden in den nächsten Tagen 175.000 aus Karton gefertigte Fastenwürfel an Haushalte verteilt, die dazu ermuntern sollen, in den Wochen vor Ostern den Konsum einzuschränken und das Ersparte Notleidenden zu spenden, hieß es in einer Aussendung der Diözese am Donnerstag."
                            },
                            {
                                "example_id": "b15e08dd-bee9-40c4-b48f-1a79cfb83db1",
                                "sense_id": "5695acf8-a99e-3cc1-9d26-576b9195b06b",
                                "text": "Die Schüler und Schülerinnen der 1A, 2A und 2B haben nachgedacht, worauf sie in der Fastenzeit verzichten könnten. Dabei hilft ihnen in diesem Jahr ein Fastenwürfel, den sie selbst gebastelt haben."
                            },
                            {
                                "example_id": "226e9435-ad96-4494-99b4-41efa3aeb8e0",
                                "sense_id": "5695acf8-a99e-3cc1-9d26-576b9195b06b",
                                "text": "In den nächsten Tagen werden unsere Gemeindebürgerinnen und Gemeindebürger diesen Fastenwürfel, gemeinsam mit einem Informationsfolder, erhalten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
