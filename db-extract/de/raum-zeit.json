                    {
                        "sense_id": "87b32840-0d5e-3dbb-97a3-9cc6ef5c91a9",
                        "entry_id": "bb37ec51-a2ec-32f5-8dcb-4abc85108b5d",
                        "glosses": [
                            "das Universum als vierdimensionale Struktur aus Raum und Zeit"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "23fd5f21-8dbd-4b88-ba92-e273319f26db",
                                "sense_id": "87b32840-0d5e-3dbb-97a3-9cc6ef5c91a9",
                                "text": "Wie sich in der Praxis unseres täglichen Lebens der mechanischen Beherrschung der Naturkräfte und die Überwindung von Raum-Zeit zeigt, weiß jeder, der sich der Telegraphie, des Telephons, Schnellzugs, Autos, Flugzeugs usw. bedient."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75642365-6a64-475f-857f-8805b7b92cf3",
                        "source_entry_id": "bb37ec51-a2ec-32f5-8dcb-4abc85108b5d",
                        "source_sense_id": "87b32840-0d5e-3dbb-97a3-9cc6ef5c91a9",
                        "source_sense_description": "Physik: das Universum als vierdimensionale Struktur aus Raum und Zeit",
                        "target_lang_word": "space-time",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "space-time",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cee089b4-b1ce-3895-ba28-2df9d3d91b15",
                                        "entry_id": "b23b4838-612f-3a53-b42c-c74761d0b749",
                                        "glosses": [
                                            "Alternative form of spacetime."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3726fd3-a88c-4161-8ea9-c9a8de0b5bfc",
                                                "sense_id": "cee089b4-b1ce-3895-ba28-2df9d3d91b15",
                                                "text": "A mass effect drive core decreases the mass of a bubble of space-time around a ship. This gives the ship the potential to move quickly, but does not apply any motive power."
                                            },
                                            {
                                                "example_id": "9716e5b7-0e6f-4c6b-a6bb-edcb4d10d136",
                                                "sense_id": "cee089b4-b1ce-3895-ba28-2df9d3d91b15",
                                                "text": "Scientists have detected ripples in space-time from the violent collision of two massive black holes that spiralled into one another far beyond the distant edge of the Milky Way."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aef207e5-066e-43ff-a6c7-3e32a4bc9b4c",
                        "source_entry_id": "bb37ec51-a2ec-32f5-8dcb-4abc85108b5d",
                        "source_sense_id": "87b32840-0d5e-3dbb-97a3-9cc6ef5c91a9",
                        "source_sense_description": "Physik: das Universum als vierdimensionale Struktur aus Raum und Zeit",
                        "target_lang_word": "spacetime",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spacetime",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16e69b8b-56e5-3e3b-af6c-6d41d8a16a83",
                                        "entry_id": "78db9c86-f4a2-3bfb-946b-29691be826c5",
                                        "glosses": [
                                            "The four-dimensional continuum of the three spatial dimensions plus time."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7efebab4-cbec-449e-b404-1922421a8c42",
                                                "sense_id": "16e69b8b-56e5-3e3b-af6c-6d41d8a16a83",
                                                "text": "An event is a point in spacetime, specified by the coordinates x, y, z, and t."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efa421e4-a776-3251-a3cd-c8bb81b1d013",
                                        "entry_id": "78db9c86-f4a2-3bfb-946b-29691be826c5",
                                        "glosses": [
                                            "An n-dimensional continuum consisting of dimensions of both space and time. Normally spacetime is considered as having 4 dimensions (x, y, z, t), but higher-dimensional spacetimes are often encountered in theoretical physics, e.g. the 5-dimensional spacetime of Kaluza-Klein theory or the 11 dimensions of spacetime in M-theory."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "449834e5-d90b-4dec-9dd6-f49bbd03ff84",
                                                "sense_id": "efa421e4-a776-3251-a3cd-c8bb81b1d013",
                                                "text": "a Minkowski spacetime"
                                            },
                                            {
                                                "example_id": "19c21672-6a07-494e-9bc9-46f5323605ce",
                                                "sense_id": "efa421e4-a776-3251-a3cd-c8bb81b1d013",
                                                "text": "a 5-dimensional spacetime"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3e1a226-deda-30cf-af7c-be6646b5986e",
                                        "entry_id": "78db9c86-f4a2-3bfb-946b-29691be826c5",
                                        "glosses": [
                                            "A specific region of the universe with mathematically different properties than the surrounding spacetime. Synonymous with \\\"metric\\\" within the context of general relativity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ddca0af-1816-4592-b5a0-c9f59a4baa9c",
                                                "sense_id": "f3e1a226-deda-30cf-af7c-be6646b5986e",
                                                "text": "a Schwarzschild spacetime"
                                            },
                                            {
                                                "example_id": "23689b37-c434-4c81-8e00-92b84bbf842f",
                                                "sense_id": "f3e1a226-deda-30cf-af7c-be6646b5986e",
                                                "text": "a Reissner-Nordström spacetime"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c128937-40d8-46ee-b8b8-a784cc22452a",
                        "source_entry_id": "bb37ec51-a2ec-32f5-8dcb-4abc85108b5d",
                        "source_sense_id": "87b32840-0d5e-3dbb-97a3-9cc6ef5c91a9",
                        "source_sense_description": "Physik: das Universum als vierdimensionale Struktur aus Raum und Zeit",
                        "target_lang_word": "espace-temps",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "espace-temps",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5740c5ce-c627-3681-85b4-4daeef76f8a2",
                                        "entry_id": "56a61278-523d-3eec-85c6-23e5d43a5fb9",
                                        "glosses": [
                                            "Continuum physique qui combine les trois dimensions de l’espace et le temps dans un même modèle topologique."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecc7b59e-ac15-4979-992a-1d548313fb6f",
                                                "sense_id": "5740c5ce-c627-3681-85b4-4daeef76f8a2",
                                                "text": "De même les infortunés chrononautes de Temps mort (G. Langelaan) vieillissent en quelques minutes de plusieurs dizaines d'années : tel est le risque d’accident temporel qui attend les pionniers de l’espace-temps."
                                            },
                                            {
                                                "example_id": "c328b142-cc7c-480e-b6c1-0a4c07d6c6a9",
                                                "sense_id": "5740c5ce-c627-3681-85b4-4daeef76f8a2",
                                                "text": "L’espace-temps de la théorie de la relativité générale est un espace à quatre dimensions."
                                            },
                                            {
                                                "example_id": "cbddbcc5-cb45-4928-81b1-ac2a8dda793d",
                                                "sense_id": "5740c5ce-c627-3681-85b4-4daeef76f8a2",
                                                "text": "Ses pieds nus martelèrent le tapis de feu qui rougissait là, sautaient, revenaient chercher la brûlure au rythme des tambours et des chœurs déchirant l’espace-temps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
