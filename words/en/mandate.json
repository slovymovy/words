{
    "word_family": [
        "mandatory",
        "mandator",
        "mandatary",
        "mandatorily"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "01cd09c9-1a0c-3060-a2a4-f00d302bd5a9",
                    "sense_definition": "To make something required by law or rule.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "requirement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new law <w>mandates</w> that all citizens must wear masks in public spaces.",
                            "target_lang_translations": {
                                "ru": "Новый закон <w>обязывает</w> всех граждан носить маски в общественных местах.",
                                "zh": "新法律<w>规定</w>所有公民在公共场所都必须佩戴口罩。"
                            }
                        },
                        {
                            "text": "The government decided to <w>mandate</w> insurance coverage for all full-time employees.",
                            "target_lang_translations": {
                                "ru": "Правительство решило <w>сделать обязательным</w> страховое покрытие для всех штатных сотрудников.",
                                "zh": "政府决定<w>规定</w>所有全职员工都必须享有保险保障。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mandate insurance coverage",
                        "legally mandate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать что-либо обязательным по закону или правилу.",
                        "zh": "依法或按规定使某事成为必须。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обязывать",
                                "target_lang_sense_clarification": "делать обязательным"
                            },
                            {
                                "target_lang_word": "предписывать",
                                "target_lang_sense_clarification": "устанавливать правило"
                            },
                            {
                                "target_lang_word": "вводить в обязательство",
                                "target_lang_sense_clarification": "законодательно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "规定",
                                "target_lang_sense_clarification": "依法或按规定使某事成为必须"
                            },
                            {
                                "target_lang_word": "强制规定",
                                "target_lang_sense_clarification": "以法规方式强制要求"
                            },
                            {
                                "target_lang_word": "明令要求",
                                "target_lang_sense_clarification": "正式明确地要求"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ed2364e-05f5-3564-b06b-e824775e296b",
                    "sense_definition": "To officially require or command someone to act in a specific way.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "requirement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee <w>mandated</w> the representative to vote against the proposed changes.",
                            "target_lang_translations": {
                                "ru": "Комитет <w>поручил</w> представителю проголосовать против предлагаемых изменений.",
                                "zh": "委员会<w>要求</w>该代表投票反对拟议中的修改。"
                            }
                        },
                        {
                            "text": "The court <w>mandated</w> the department to preserve the confidentiality of all reports.",
                            "target_lang_translations": {
                                "ru": "Суд <w>предписал</w> ведомству сохранять конфиденциальность всех отчетов.",
                                "zh": "法院<w>责令</w>该部门对所有报告保密。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mandate representatives"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально требовать или приказывать кому-либо действовать определенным образом.",
                        "zh": "正式要求或命令某人以特定方式行事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уполномочивать",
                                "target_lang_sense_clarification": "давать право на действия"
                            },
                            {
                                "target_lang_word": "поручать",
                                "target_lang_sense_clarification": "давать официальное задание"
                            },
                            {
                                "target_lang_word": "предписывать",
                                "target_lang_sense_clarification": "официально приказывать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "要求",
                                "target_lang_sense_clarification": "正式要求某人采取某种行动"
                            },
                            {
                                "target_lang_word": "命令",
                                "target_lang_sense_clarification": "以官方身份下令"
                            },
                            {
                                "target_lang_word": "责令",
                                "target_lang_sense_clarification": "多用于法院、政府等正式机构下令"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8ad3b95-6550-3380-8e9a-c8e6e238184a",
                    "sense_definition": "To rehearse or repeat a speech or sermon aloud from memory.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rehearsal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young preacher spent the entire evening <w>mandating</w> his opening sentences for the Sunday service.",
                            "target_lang_translations": {
                                "ru": "Молодой проповедник провел весь вечер, <w>заучивая</w> вступительные фразы для воскресной службы.",
                                "zh": "那位年轻的传教士整个晚上都在<w>背诵</w>主日礼拜开场的几句话。"
                            }
                        },
                        {
                            "text": "He walked around his study while <w>mandating</w> his discourse with appropriate gestures.",
                            "target_lang_translations": {
                                "ru": "Он ходил по кабинету, <w>репетируя</w> свою речь и сопровождая её соответствующими жестами.",
                                "zh": "他一边在书房里踱步，一边<w>背诵</w>自己的讲稿，还配上了恰当的手势。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mandating of sermons"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "primarily used in historical religious contexts"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "historically associated with the Church of Scotland"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Репетировать или повторять речь или проповедь вслух по памяти.",
                        "zh": "凭记忆把演讲或布道词大声反复练习、背诵。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заучивать",
                                "target_lang_sense_clarification": "повторять вслух для запоминания"
                            },
                            {
                                "target_lang_word": "репетировать",
                                "target_lang_sense_clarification": "проповедь или речь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "背诵",
                                "target_lang_sense_clarification": "凭记忆大声反复念"
                            },
                            {
                                "target_lang_word": "练习背诵",
                                "target_lang_sense_clarification": "为演讲或布道反复练习"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b4547cb8-d168-333c-aaf5-84da8815ea7b",
                    "sense_definition": "The authority to carry out a policy or course of action, regarded as given by the electorate to a candidate or party that is victorious in an election.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "authority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The president claimed a clear <w>mandate</w> from the people to implement his economic reforms.",
                            "target_lang_translations": {
                                "ru": "Президент заявил о получении четкого <w>мандата</w> от народа на проведение экономических реформ.",
                                "zh": "总统声称，人民已明确授予他推行经济改革的<w>授权</w>。"
                            }
                        },
                        {
                            "text": "Winning by such a large margin gave the party a strong <w>mandate</w> for change.",
                            "target_lang_translations": {
                                "ru": "Победа с таким большим отрывом дала партии широкие <w>полномочия</w> для проведения перемен.",
                                "zh": "如此巨大的胜选优势给了该党推动变革的强大<w>授权</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "clear mandate",
                        "electoral mandate",
                        "strong mandate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полномочия на проведение политики или курса действий, полученные от избирателей победившим кандидатом или партией.",
                        "zh": "当选的候选人或政党被视为从选民那里获得的施政权力或正当性。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мандат",
                                "target_lang_sense_clarification": "доверие избирателей"
                            },
                            {
                                "target_lang_word": "полномочия",
                                "target_lang_sense_clarification": "право на действия от лица народа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "授权",
                                "target_lang_sense_clarification": "选民授予当选者或政党的施政权力"
                            },
                            {
                                "target_lang_word": "民意授权",
                                "target_lang_sense_clarification": "强调来自选民支持的执政正当性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89c3989f-66cc-370d-82f2-556038f4b733",
                    "sense_definition": "An official order or commission to do something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "authority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The agency has a <w>mandate</w> to protect the environment through strict regulations.",
                            "target_lang_translations": {
                                "ru": "Агентство имеет <w>полномочия</w> по защите окружающей среды посредством строгих правил.",
                                "zh": "该机构肩负着通过严格法规保护环境的<w>职责</w>。"
                            }
                        },
                        {
                            "text": "The court issued a <w>mandate</w> requiring the company to stop its unfair practices.",
                            "target_lang_translations": {
                                "ru": "Суд вынес <w>предписание</w>, требующее от компании прекратить недобросовестную практику.",
                                "zh": "法院发布了一项<w>指令</w>，要求该公司停止不公平做法。"
                            }
                        }
                    ],
                    "synonyms": [
                        "compulsion",
                        "obligation"
                    ],
                    "common_phrases": [
                        "official mandate",
                        "judicial mandate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальный приказ или поручение сделать что-либо.",
                        "zh": "要求某人做某事的正式命令、授权或委派。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распоряжение",
                                "target_lang_sense_clarification": "официальный указ"
                            },
                            {
                                "target_lang_word": "предписание",
                                "target_lang_sense_clarification": "обязательное указание"
                            },
                            {
                                "target_lang_word": "поручение",
                                "target_lang_sense_clarification": "официальное задание"
                            },
                            {
                                "target_lang_word": "мандат",
                                "target_lang_sense_clarification": "документ о полномочиях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "指令",
                                "target_lang_sense_clarification": "正式下达的命令或要求"
                            },
                            {
                                "target_lang_word": "授权",
                                "target_lang_sense_clarification": "正式赋予去做某事的权限或任务"
                            },
                            {
                                "target_lang_word": "职责",
                                "target_lang_sense_clarification": "机构或个人被正式赋予的任务"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e30a44ca-2ed1-3975-8595-36ec3903b6d3",
                    "sense_definition": "The period of time during which a government or official is in power.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During his last <w>mandate</w> as Prime Minister, he focused on constitutional reform.",
                            "target_lang_translations": {
                                "ru": "Во время своего последнего <w>срока полномочий</w> на посту премьер-министра он сосредоточился на конституционной реформе.",
                                "zh": "在他担任首相的上一个<w>任期</w>内，他主要致力于宪法改革。"
                            }
                        },
                        {
                            "text": "The leader's four-year <w>mandate</w> was marked by significant economic growth.",
                            "target_lang_translations": {
                                "ru": "Четырехлетний <w>мандат</w> лидера ознаменовался значительным экономическим ростом.",
                                "zh": "这位领导人四年的<w>任期</w>以显著的经济增长为标志。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "four-year mandate",
                        "last mandate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период времени, в течение которого правительство или должностное лицо находится у власти.",
                        "zh": "政府或官员在位、执政的那段时间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "срок полномочий",
                                "target_lang_sense_clarification": "период пребывания у власти"
                            },
                            {
                                "target_lang_word": "мандат",
                                "target_lang_sense_clarification": "срок действия полномочий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "任期",
                                "target_lang_sense_clarification": "担任公职或执政的时期"
                            },
                            {
                                "target_lang_word": "任职期",
                                "target_lang_sense_clarification": "正式职务持续有效的期间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd75717f-9c17-3293-a83b-973d72c242e2",
                    "sense_definition": "A territory assigned to a nation to be governed on behalf of an international organization, such as the League of Nations.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "territory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the war, several former colonies became a <w>mandate</w> under British administration.",
                            "target_lang_translations": {
                                "ru": "После войны несколько бывших колоний перешли под британский <w>мандат</w>.",
                                "zh": "战后，几个前殖民地成为英国管辖下的<w>委任统治地</w>。"
                            }
                        },
                        {
                            "text": "The League of Nations established a <w>mandate</w> system for the conquered territories.",
                            "target_lang_translations": {
                                "ru": "Лига Наций установила <w>мандатную</w> систему для завоеванных территорий.",
                                "zh": "国际联盟为被征服地区建立了<w>委任统治</w>制度。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "league of nations mandate"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "refers to historical geopolitical arrangements"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Территория, переданная государству для управления от имени международной организации (например, Лиги Наций).",
                        "zh": "由某国代表国际组织进行治理的地区，例如国际联盟委任统治下的地区。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мандат",
                                "target_lang_sense_clarification": "право на управление территорией"
                            },
                            {
                                "target_lang_word": "подмандатная территория",
                                "target_lang_sense_clarification": "исторический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "委任统治地",
                                "target_lang_sense_clarification": "由国际组织委托某国治理的地区"
                            },
                            {
                                "target_lang_word": "托管地",
                                "target_lang_sense_clarification": "历史语境下指受委托管理的地区"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f326cabf-97a3-3862-9476-a4f5fe40b7fa",
                    "sense_definition": "A social meeting or date between two men.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They went out for a drink, but he insisted it was just a <w>mandate</w> between friends.",
                            "target_lang_translations": {
                                "ru": "Они пошли выпить, но он настаивал, что это просто <w>дружеская встреча</w> двух приятелей.",
                                "zh": "他们一起出去喝酒，但他坚持说那只是朋友之间的一次<w>哥们聚会</w>。"
                            }
                        },
                        {
                            "text": "The sitcom character was embarrassed when his friends teased him about his <w>mandate</w>.",
                            "target_lang_translations": {
                                "ru": "Персонаж ситкома смутился, когда друзья начали подшучивать над его <w>мужским свиданием</w>.",
                                "zh": "当朋友拿他的<w>哥们约会</w>开玩笑时，那个情景喜剧角色很尴尬。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "pun on 'man' and 'date'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дружеская встреча или свидание между двумя мужчинами.",
                        "zh": "两个男人之间的社交约会或单独聚会，通常带有戏谑意味。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мужское свидание",
                                "target_lang_sense_clarification": "шутливое, дружеское"
                            },
                            {
                                "target_lang_word": "встреча друзей",
                                "target_lang_sense_clarification": "между мужчинами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "哥们约会",
                                "target_lang_sense_clarification": "戏谑说法，指两个男人之间的约会或单独聚会"
                            },
                            {
                                "target_lang_word": "哥们聚会",
                                "target_lang_sense_clarification": "较口语、较自然的说法"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}