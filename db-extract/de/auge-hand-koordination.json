                "senses": [
                    {
                        "sense_id": "852b2ab7-ff84-3517-94e5-25a433b48795",
                        "entry_id": "341bb528-116b-3463-b6c6-92709f973082",
                        "glosses": [
                            "das Koordinieren/das Abstimmen der Bewegungen der Hand mittels der optischen Wahrnehmung durch das Auge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4d4058f-d0e0-497a-871f-f625bd9407c3",
                                "sense_id": "852b2ab7-ff84-3517-94e5-25a433b48795",
                                "text": "„Bei jedem Spiel, wo es um das Fangen und Werfen eines Gegenstandes geht, wird die Auge-Hand-Koordination geschult.“"
                            },
                            {
                                "example_id": "ab33fdf3-743a-4280-809b-97c380ac076b",
                                "sense_id": "852b2ab7-ff84-3517-94e5-25a433b48795",
                                "text": "„Jeglicher Tätigkeit unseres Alltags liegt diese Auge-Hand-Koordination zugrunde, auch den Vorstufen für mathematisches Tun, wie z.B. beim Ordnen , beim Zuordnen und beim Zählen.“"
                            }
                        ],
