                                    },
                                    {
                                        "sense_id": "a9d02917-6cbe-365e-99e7-a47eba0d741a",
                                        "entry_id": "0e7c587c-a930-3dfd-9ca3-519bcf157fc2",
                                        "glosses": [
                                            "The action of stretching a wing and the same side leg out to one side of the body."
                                        ],
