                        "entry_id": "d14d3fbf-4a22-39ee-b693-be5d0eb9ee5a",
                        "glosses": [
                            "Said, written, or done with the intent to mock, or ridicule; with mocking effect."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ee631a8-5319-4006-b8e3-221fa32c7693",
                                "sense_id": "f8633f58-7a0f-3d3b-acb3-f50f104889ab",
                                "text": "I remember how mockingly bright the day seemed as I went back on my melancholy pilgrimage to the little house at Woking, how busy the streets and vivid the moving life about me."
                            },
                            {
                                "example_id": "44fd91a3-2ce7-4e5c-be37-29652eaa80e2",
                                "sense_id": "f8633f58-7a0f-3d3b-acb3-f50f104889ab",
                                "text": "It then mockingly says they connect “like-minded Tesla owners with one another, facilitating a vibrant community through shared contact information.”"
                            }
                        ]
                    }
                ],
