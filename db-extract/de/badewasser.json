                                    },
                                    {
                                        "sense_id": "ea2d0a8b-7bd3-3378-be82-53fb1067dc84",
                                        "entry_id": "50f875fe-e0da-3fa8-a433-0da1d212bfc3",
                                        "glosses": [
                                            "water dat gebruikt wordt om een bad te vullen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba03bda1-ba72-484e-85bc-71edd2a3db72",
                                                "sense_id": "ea2d0a8b-7bd3-3378-be82-53fb1067dc84",
                                                "text": "Eerst liet de vrouw het bad vollopen en daarna ging ze zelf in het heerlijk warme badwater liggen."
                                            },
                                            {
                                                "example_id": "84a40321-2161-44db-9ea7-b30e535a523a",
                                                "sense_id": "ea2d0a8b-7bd3-3378-be82-53fb1067dc84",
                                                "text": "In bad was je je, maar niet alleen om er gunstig geurend uit te komen. We vonden drie baden waarin een oude schuld of zonde met het badwater weggespoeld kan worden."
                                            },
                                            {
                                                "example_id": "39fd50d1-6af8-4762-89e1-bbd2d23f0fd5",
                                                "sense_id": "ea2d0a8b-7bd3-3378-be82-53fb1067dc84",
                                                "text": "Per ongeluk had ik het bad laten overlopen toen ik even weg was gedommeld op het kingsize motelbed. Het badwater bedekte het tapijt en stroomde onder de deur door de kamer uit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
