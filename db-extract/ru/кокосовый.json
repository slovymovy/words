                                "example_id": "f2f3c015-e15a-4e5d-a842-eb4aa7d8b4e7",
                                "sense_id": "c93fddde-29a9-3f2e-9b97-c359b65f5388",
                                "text": "Кокосовый рай."
                            },
                            {
                                "example_id": "0f3145bc-fd70-4c8f-a2f2-a0c3e42432ad",
                                "sense_id": "c93fddde-29a9-3f2e-9b97-c359b65f5388",
                                "text": "Кокосовая стружка."
                            },
                            {
                                "example_id": "5573d564-7c3a-47eb-9481-7c6a2bd79539",
                                "sense_id": "c93fddde-29a9-3f2e-9b97-c359b65f5388",
                                "text": "Пирожное с кокосовым кремом."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b85df85-01f5-4316-a00d-37c80787881a",
                        "source_entry_id": "400d9d8f-8ed4-3dcf-a275-27ea1a42f072",
                        "source_sense_id": "c93fddde-29a9-3f2e-9b97-c359b65f5388",
                        "target_lang_word": "coconut",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coconut",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "17bf8fb6-1a4a-3e32-9ad7-b55019b06b5f",
                                        "entry_id": "723307b9-1537-3bbe-8387-717b31221176",
                                        "glosses": [
                                            "A fruit of the coconut palm (not a true nut), Cocos nucifera, having a fibrous husk surrounding a large seed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c98f9f38-a02b-4d96-b946-67dc0e211d96",
                                                "sense_id": "17bf8fb6-1a4a-3e32-9ad7-b55019b06b5f",
                                                "text": "The Coco-nut Trees grow by the Sea, on the Weſtern ſide in great Groves, 3 or 4 Miles in length, and a Mile or two broad. This tree is in ſhape like the Cabbage-tree, and at a diſtance they are not to be known each from other, only the Coco-nut Tree is fuller of Branches ; but the Cabbage-tree generally is much higher, tho' the Coco-nut Trees in ſome places are very high."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62309fe7-e3b0-3af5-9b44-1d5f2d39843b",
                                        "entry_id": "723307b9-1537-3bbe-8387-717b31221176",
                                        "glosses": [
                                            "A hard-shelled seed of this fruit, having white flesh and a fluid-filled central cavity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a4994460-f521-3d39-a320-67e8df02afc1",
                                        "entry_id": "723307b9-1537-3bbe-8387-717b31221176",
                                        "glosses": [
                                            "The edible white flesh of this fruit."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9c74aa05-b554-3b41-a4fe-c869944d63ed",
                                        "entry_id": "723307b9-1537-3bbe-8387-717b31221176",
                                        "glosses": [
                                            "The coconut palm."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f93ad5d8-acd8-3e97-9ef2-540fbaf499a2",
                                        "entry_id": "723307b9-1537-3bbe-8387-717b31221176",
                                        "glosses": [
                                            "A member of any of various dark-skinned ethnic groups (e.g. Hispanic, South Asian, or black) who is considered to have overly assimilated to white culture:",
                                            "A Hispanic or other dark-skinned person considered to have overly assimilated to white culture."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "derogatory",
                                            "ethnic",
                                            "slur",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22e7d705-098a-4080-8842-3b649e2ca50e",
                                                "sense_id": "f93ad5d8-acd8-3e97-9ef2-540fbaf499a2",
                                                "text": "After that I was regarded as comic. I became a ‘coconut’—someone brown on the outside, white on the inside. I was the bleached academic—more white than the anglo professors. In my classes several students glared at me, clearly seeing in me the person they feared ever becoming. Who was I, after all, but some comic Queequeg, holding close to my breast a reliquary containing the white powder of a dead European civilization?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "570eb743-b1c5-36e8-91ab-260c12133854",
                                        "entry_id": "723307b9-1537-3bbe-8387-717b31221176",
                                        "glosses": [
                                            "A member of any of various dark-skinned ethnic groups (e.g. Hispanic, South Asian, or black) who is considered to have overly assimilated to white culture:",
                                            "A black person considered to have overly assimilated to white culture, a black race traitor."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Kenya",
                                            "South-Africa",
                                            "countable",
                                            "derogatory",
                                            "ethnic",
                                            "slur",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6df7cd05-df62-41a7-bd6b-cfe5074af8fc",
                                                "sense_id": "570eb743-b1c5-36e8-91ab-260c12133854",
                                                "text": "Their convictions challenged those critics who dismissed John Githongo’s anti-corruption efforts as the naïve projection of inappropriate ‘mzungu’ values onto an African nation where they were doomed to fail. If John was a ‘coconut’, he certainly wasn’t the only coconut in Kenya."
                                            },
                                            {
                                                "example_id": "dd496e2c-80b6-4425-aa79-ddcbea010bdb",
                                                "sense_id": "570eb743-b1c5-36e8-91ab-260c12133854",
                                                "text": "Your mum is a white whore, you coconut."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86c0ebdf-e303-3df6-87dd-ac73ac6028bf",
                                        "entry_id": "723307b9-1537-3bbe-8387-717b31221176",
                                        "glosses": [
                                            "A member of any of various dark-skinned ethnic groups (e.g. Hispanic, South Asian, or black) who is considered to have overly assimilated to white culture:",
                                            "A Malay person who cannot speak Malay."
                                        ],
                                        "tags": [
                                            "Singapore",
                                            "countable",
                                            "derogatory",
                                            "ethnic",
                                            "slur",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
