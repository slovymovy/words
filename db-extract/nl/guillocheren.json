                "senses": [
                    {
                        "sense_id": "ff8b2915-9dda-3585-93e7-4401f181b4b8",
                        "entry_id": "2a5b51f8-45f5-39f2-a36f-c4b40ac26ab6",
                        "glosses": [
                            "ter versiering van een netwerk van krommen voorzien"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "119e2361-f180-4782-9f35-b49df3a9c011",
                                "sense_id": "ff8b2915-9dda-3585-93e7-4401f181b4b8",
                                "text": "Het uurwerk werd prachtig geguillocheerd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "80176158-1627-4cfe-be40-f3a6d8aa1767",
                        "source_entry_id": "2a5b51f8-45f5-39f2-a36f-c4b40ac26ab6",
                        "source_sense_id": "ff8b2915-9dda-3585-93e7-4401f181b4b8",
                        "target_lang_word": "guillocher",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guillocher",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0dbe3b50-a9d9-33e7-9f7e-1464db68e60f",
                                        "entry_id": "9894dd38-b2e9-3a41-93d8-86a1a1083c07",
                                        "glosses": [
                                            "Orner d’un guillochis, d’un ensemble de lignes, de traits ondés qui s’entrelacent ou se croisent avec symétrie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "add8745d-f2e5-4aee-ae53-39fd477b8615",
                                                "sense_id": "0dbe3b50-a9d9-33e7-9f7e-1464db68e60f",
                                                "text": "Pour cet effet les ouvriers qui forment la boîte, la guillochent sur le tour quand elle est bien sèche, comme on fait aux boites d'écaille ; […]."
                                            },
                                            {
                                                "example_id": "3f963932-d87b-4986-9d7d-2c9b09fb1e02",
                                                "sense_id": "0dbe3b50-a9d9-33e7-9f7e-1464db68e60f",
                                                "text": "En ce moment-là, il guillochait l'ivoire qui devait orner le siège d'un char destiné aux dieux et Aedone terminait une toile pleine de merveilleux dessins."
                                            },
                                            {
                                                "example_id": "0991601e-8763-4d92-8500-5fc1283be141",
                                                "sense_id": "0dbe3b50-a9d9-33e7-9f7e-1464db68e60f",
                                                "text": "Sa main droite actionne l’outil à guillocher : le pouce repose sur une partie fixe servant de support à l'index, qui pousse ou retient l’outil à guillocher. Le porte-outil, véritable poste de contrôle du tour à guillocher, est mobile selon plusieurs axes."
                                            },
                                            {
                                                "example_id": "9704790c-5c65-420e-9444-975805f7734d",
                                                "sense_id": "0dbe3b50-a9d9-33e7-9f7e-1464db68e60f",
                                                "text": "Derrière les carreaux que guillochait le froid, le paysage se fragmentait en morceaux irréguliers, comme la surface d'un puzzle."
                                            },
                                            {
                                                "example_id": "c9476ca4-8dd2-476e-91e2-aeedb1ea1292",
                                                "sense_id": "0dbe3b50-a9d9-33e7-9f7e-1464db68e60f",
                                                "text": "Vers le col de Laghetto, les rafales guillochaient la neige."
                                            },
                                            {
                                                "example_id": "febe87c4-acbe-4018-ad6b-d61adbf93930",
                                                "sense_id": "0dbe3b50-a9d9-33e7-9f7e-1464db68e60f",
                                                "text": "— Animaux inconnus, contenus dans des cellules poriformes, excessivement petites, rondes, serrées, éparses dans les sinuosités, très-fines et tortueuses, qui guillochent la circonférence d'un polypier calcaire, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
