                "senses": [
                    {
                        "sense_id": "73fe0e42-92e4-3707-88e9-e8f80cd727ae",
                        "entry_id": "5d0f6a1e-aba3-3e93-a675-9e6205f9261f",
                        "glosses": [
                            "zusammengestellt Müllbehälter auf Eisenbahnwagen, die einen Zug ergeben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfe94392-ff71-4f84-8a56-bdf4c21a625d",
                                "sense_id": "73fe0e42-92e4-3707-88e9-e8f80cd727ae",
                                "text": "„Am 12. August 1982, es war ein Donnerstag, also vor 30 Jahren, wurde vom damaligen bayerischen Umweltminister Alfred Dick der erste Müllzug beim Müllkraftwerk Schwandorf in Empfang genommen.“ Vor"
                            },
                            {
                                "example_id": "d0f2a16c-d4d3-4240-a593-a508da2511be",
                                "sense_id": "73fe0e42-92e4-3707-88e9-e8f80cd727ae",
                                "text": "„Seit 01.02.2007 bespannte die OHE fünf Mal pro Woche einen Müllzug von Braunschweig nach Bremerhaven-Wulsdorf im Auftrag der TIM Transport Intermodal GmbH.“"
                            },
                            {
                                "example_id": "cac5bca0-a30d-4d30-92df-de31c9497b8c",
                                "sense_id": "73fe0e42-92e4-3707-88e9-e8f80cd727ae",
                                "text": "„Ein Müllzug mit zig Waggons stinkenden Mülls aus Südtitalien rollte durch Bozen in Richtung Deutschland.“"
                            },
                            {
                                "example_id": "56945546-2b94-4d30-8c23-04d04fe95105",
                                "sense_id": "73fe0e42-92e4-3707-88e9-e8f80cd727ae",
                                "text": "„DE92 der HGK mit dem Müllzug der AWB in Köln West am 05.03.2011“"
                            },
                            {
                                "example_id": "88dbdc9f-ee6b-4519-8310-fdaeed459c4f",
                                "sense_id": "73fe0e42-92e4-3707-88e9-e8f80cd727ae",
                                "text": "„Müllzug auf dem Weg nach Tavannes“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
