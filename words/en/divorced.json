{
    "word_family": [
        "divorce",
        "divorcee"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f82d3b8f-363c-3377-a0bc-5276935e5496",
                    "sense_definition": "Having had one's marriage legally dissolved.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "legal_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mark's parents are <w>divorced</w>.",
                            "target_lang_translations": {
                                "ru": "Родители Марка <w>в разводе</w>.",
                                "zh": "马克的父母<w>离异</w>了。"
                            }
                        },
                        {
                            "text": "She is <w>divorced</w> and lives alone in the city.",
                            "target_lang_translations": {
                                "ru": "Она <w>разведена</w> и живет одна в городе.",
                                "zh": "她已经<w>离婚</w>，独自在城里生活。"
                            }
                        }
                    ],
                    "antonyms": [
                        "married",
                        "engaged"
                    ],
                    "common_phrases": [
                        "get divorced",
                        "recently divorced",
                        "happily divorced"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состоящий в разводе; тот, чей брак был официально расторгнут.",
                        "zh": "指婚姻关系已在法律上解除。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разведённый",
                                "target_lang_sense_clarification": "о человеке"
                            },
                            {
                                "target_lang_word": "в разводе",
                                "target_lang_sense_clarification": "текущий статус"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "离异",
                                "target_lang_sense_clarification": "指婚姻状态"
                            },
                            {
                                "target_lang_word": "离婚",
                                "target_lang_sense_clarification": "指已办理离婚手续"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b7ba2c8-c8bd-310c-bb2e-acd680c7e1b2",
                    "sense_definition": "Cut off, or separated.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician's speech was completely <w>divorced</w> from reality.",
                            "target_lang_translations": {
                                "ru": "Речь политика была совершенно <w>оторвана</w> от реальности.",
                                "zh": "那位政客的演讲完全与现实<w>脱节</w>。"
                            }
                        },
                        {
                            "text": "Theoretical knowledge should not be <w>divorced</w> from practical application.",
                            "target_lang_translations": {
                                "ru": "Теоретические знания не должны быть <w>оторваны</w> от практического применения.",
                                "zh": "理论知识不应与实际应用<w>脱离</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "split"
                    ],
                    "antonyms": [
                        "connected"
                    ],
                    "common_phrases": [
                        "divorced from reality",
                        "divorced from the truth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оторванный, изолированный или отделённый от чего-либо (обычно в переносном смысле).",
                        "zh": "指与某事物脱节、分离或毫无关联。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оторванный",
                                "target_lang_sense_clarification": "перен. значение"
                            },
                            {
                                "target_lang_word": "далёкий",
                                "target_lang_sense_clarification": "не имеющий связи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "脱节",
                                "target_lang_sense_clarification": "指与现实或实际情况不符"
                            },
                            {
                                "target_lang_word": "脱离",
                                "target_lang_sense_clarification": "指与某事物失去联系"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f45f67df-7eb2-323d-af7a-f1a35c3ca943",
                    "sense_definition": "Legally dissolved.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "legal_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is a sad fact that many marriages are now <w>divorced</w>.",
                            "target_lang_translations": {
                                "ru": "Печальный факт, что многие браки сейчас <w>расторгаются</w>.",
                                "zh": "一个令人悲伤的事实是，现在许多婚姻都已<w>解除</w>。"
                            }
                        },
                        {
                            "text": "Once the union is <w>divorced</w>, the assets must be divided.",
                            "target_lang_translations": {
                                "ru": "Как только союз <w>расторгнут</w>, активы должны быть разделены.",
                                "zh": "一旦婚姻关系<w>解除</w>，资产就必须进行分割。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Юридически расторгнутый (о браке или союзе).",
                        "zh": "指婚姻或契约在法律上被解除。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расторгнутый",
                                "target_lang_sense_clarification": "о браке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "解除",
                                "target_lang_sense_clarification": "指法律关系的终止"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "273929b7-ba71-3bd6-b102-533b80880117",
                    "sense_definition": "Simple past and past participle of <w>divorce</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>divorced</w> after ten years of marriage.",
                            "target_lang_translations": {
                                "ru": "Они <w>развелись</w> после десяти лет брака.",
                                "zh": "他们结婚十年后<w>离婚</w>了。"
                            }
                        },
                        {
                            "text": "He <w>divorced</w> his wife to marry someone else.",
                            "target_lang_translations": {
                                "ru": "Он <w>развёлся</w> с женой, чтобы жениться на другой.",
                                "zh": "他与妻子<w>离婚</w>，以便和别人结婚。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время глагола 'разводиться' (расторгать брак).",
                        "zh": "动词“离婚”的过去式，指解除婚姻关系。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развёлся",
                                "target_lang_sense_clarification": "мужской род"
                            },
                            {
                                "target_lang_word": "развелись",
                                "target_lang_sense_clarification": "множественное число"
                            },
                            {
                                "target_lang_word": "развелась",
                                "target_lang_sense_clarification": "женский род"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "离婚",
                                "target_lang_sense_clarification": "指解除婚姻的行为"
                            }
                        ]
                    }
                }
            ]
        }
    ]
