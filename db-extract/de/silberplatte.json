                ],
                "senses": [
                    {
                        "sense_id": "0b71acb7-158c-3ac7-a2ff-5ff1f5bf8292",
                        "entry_id": "76a7e197-b685-3465-9fd8-c97bb801fe74",
                        "glosses": [
                            "Platte aus Silber"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8253f83a-22a2-421d-94b6-b76cb45ea2fa",
                                "sense_id": "0b71acb7-158c-3ac7-a2ff-5ff1f5bf8292",
                                "text": "„Kaum war der Pfalzgraf bei Rhein (später der Herzog von Bayern) als Erztruchsess zu dem stattlichen Tier geritten, um eine Ochsenscheibe auf Silberplatte zur kaiserlichen Tafel im Römersaal zu bringen, durfte sich das Volk auf den mit Würsten und Geflügel gefüllten Braten stürzen.“"
                            },
                            {
                                "example_id": "4154c64d-2859-4ba1-81a7-c8d461266457",
                                "sense_id": "0b71acb7-158c-3ac7-a2ff-5ff1f5bf8292",
                                "text": "„Wegen eines Säbelhiebes trug er über dem Bauch eine Silberplatte, um einen Bruch zu halten.“"
                            },
                            {
                                "example_id": "587cb256-32c3-4fdf-b144-e4f34869323b",
                                "sense_id": "0b71acb7-158c-3ac7-a2ff-5ff1f5bf8292",
                                "text": "„Auf dem Tisch stand eine Silberplatte mit zwei halben Langusten und eine Flasche Champagne nature in einem Kühler.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
