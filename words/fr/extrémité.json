    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f64e6e0f-d146-337b-b141-f0e81ab1641b",
                    "sense_definition": "Partie la plus avancée qui termine un objet dans l'espace ou dans le temps ; bout.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous nous sommes assis à l'<w>extrémité</w> de la longue table."
                        },
                        {
                            "text": "La maison se trouve à l'<w>extrémité</w> du village, tout près de la forêt."
                        }
                    ],
                    "synonyms": [
                        "terminaison"
                    ],
                    "common_phrases": [
                        "extrémité de la table",
                        "d'une extrémité à l'autre"
                    ]
                },
                {
                    "sense_id": "c7f49c6e-fe2f-3391-a524-ac94c9df6f16",
                    "sense_definition": "Parties du corps les plus éloignées du tronc, particulièrement les mains et les pieds.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En hiver, il faut bien protéger ses <w>extrémités</w> pour ne pas attraper froid."
                        },
                        {
                            "text": "Le médecin a remarqué que le malade avait les <w>extrémités</w> complètement glacées."
                        }
                    ],
                    "synonyms": [
                        "membre"
                    ],
                    "common_phrases": [
                        "extrémités du corps",
                        "extrémités froides"
                    ]
                },
                {
                    "sense_id": "b1376250-1060-3e85-9b69-9442f7bd2136",
                    "sense_definition": "Degré le plus haut ou opposé dans les sentiments, les opinions ou les manières d'agir.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exces",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a tendance à passer d'une <w>extrémité</w> à l'autre sans jamais trouver de juste milieu."
                        },
                        {
                            "text": "La modération est toujours préférable à toute <w>extrémité</w> dans un débat sérieux."
                        }
                    ],
                    "synonyms": [
                        "excès"
                    ],
                    "common_phrases": [
                        "passer d'une extrémité à l'autre"
                    ]
                },
                {
                    "sense_id": "467f1683-c91e-3e7b-9030-fec992c7201d",
                    "sense_definition": "État critique, dénuement ou situation désespérée où l'on se trouve réduit.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "situation_critique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après la perte de son emploi, il s'est retrouvé réduit à la dernière <w>extrémité</w>."
                        },
                        {
                            "text": "Elle refusait d'emprunter de l'argent sauf en cas de toute dernière <w>extrémité</w>."
                        }
                    ],
                    "common_phrases": [
                        "dernière extrémité",
                        "réduit à l'extrémité"
                    ]
                },
                {
                    "sense_id": "7e9dcec9-c217-31e9-bd01-0639228aa37f",
                    "sense_definition": "Acte d'emportement ou de violence auquel on se laisse aller par colère ou désespoir.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La querelle s'est envenimée et ils en sont venus aux pires <w>extrémités</w>."
                        },
                        {
                            "text": "Le médiateur a évité que les manifestants ne se portent à de fâcheuses <w>extrémités</w>."
                        }
                    ],
                    "common_phrases": [
                        "en venir aux extrémités"
                    ]
                },
                {
                    "sense_id": "e9fe7c2a-6e99-3f70-a323-f7f2fd9f1c77",
                    "sense_definition": "Derniers moments d'une vie humaine ; agonie.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le prêtre a été appelé au chevet du malade réduit à toute <w>extrémité</w>."
                        },
                        {
                            "text": "La famille s'est rassemblée autour du vieillard qui touchait à sa dernière <w>extrémité</w>."
                        }
                    ],
                    "common_phrases": [
                        "à toute extrémité"
                    ]
                }
            ]
        }
    ]
}