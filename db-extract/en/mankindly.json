                "senses": [
                    {
                        "sense_id": "668c4753-8a5a-399a-96e9-c44bbc70fd19",
                        "entry_id": "d8c2deeb-7369-3481-98a5-9c2aac40411e",
                        "glosses": [
                            "Pertaining to or characteristic of mankind; humanly, humane."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e9277dc-ba10-4faf-a94f-d009ef1a165a",
                                "sense_id": "668c4753-8a5a-399a-96e9-c44bbc70fd19",
                                "text": "They are the great midland expanses that have remained young in realisation of just what our common share and responsibility in sea-power mean to all the mankindly world."
                            },
                            {
                                "example_id": "3c545f5f-2524-45c8-9db8-da424a66362f",
                                "sense_id": "668c4753-8a5a-399a-96e9-c44bbc70fd19",
                                "text": "Let friendly music-making be the rule everywhere during wartime, and in it musicians must just now try to be particularly mankindly."
                            },
                            {
                                "example_id": "82d76548-fb01-4c10-9b79-06f141ecee95",
                                "sense_id": "668c4753-8a5a-399a-96e9-c44bbc70fd19",
                                "text": "Without taking the long leap to a world legislature that the World Federalists seek, or even making the drastic revision of the U. N. Charter that Clark and Sohn have so skillfully and deliberately devised, I think we could take some shorter steps to infuse it with mankindly spirit."
                            },
                            {
                                "example_id": "81da384b-3e93-4e47-bc9c-261dc14d71c9",
                                "sense_id": "668c4753-8a5a-399a-96e9-c44bbc70fd19",
                                "text": "For one moment here the face might seem mankindly and evolved: but that, we know, is just an old illusion."
                            },
                            {
                                "example_id": "1075bf58-8cba-4979-8d83-1566a22beb08",
                                "sense_id": "668c4753-8a5a-399a-96e9-c44bbc70fd19",
                                "text": "With the acceleration of a historical, irreversible alteration of the earth's surface and atmosphere, which is taking place within the span of an individual human's lifetime; with the realization that our mankindly, science-guided actions result, on a scale of natural history, in the mass extinction of species, in a global climatic change, and in gene technology that has the potential to change our genetic constitution, […]"
                            },
                            {
                                "example_id": "d7050fc3-33a3-4460-ba84-e6d1ec2cd05d",
                                "sense_id": "668c4753-8a5a-399a-96e9-c44bbc70fd19",
                                "text": "Born as an animal\nWe can shed our shells\nThat have become our jails,\nAnd outgrow our carapace\nOf hard human conceits\nAnd sail with the wind\nWith mankindly grace,\nUnbowed by booing,\nUncowed by crowding."
                            }
                        ]
                    }
