                                "example_id": "f0e549c7-774a-41a7-8421-0a29a039632a",
                                "sense_id": "2dd776c2-578c-3840-9a2a-882a23acfa81",
                                "text": "„Nur sieben Spieler konnte Coach Calles einsetzen. Insbesondere die Führungsspieler T.J. Bray und Austin Hollins erhielten kaum Pausen.“"
                            }
