                                "target_senses": [
                                    {
                                        "sense_id": "7c2071d5-0bae-30e6-b93c-20a9028fa647",
                                        "entry_id": "04083689-68d3-3b36-b5fc-db15aaf667a1",
                                        "glosses": [
                                            "lesbisch, schwul und/oder bisexuell"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11e7f658-523b-4fe6-8cd2-8ba07b4468dc",
                                                "sense_id": "7c2071d5-0bae-30e6-b93c-20a9028fa647",
                                                "text": "„Der liberale Wert formal gleicher Rechte erwies sich somit als Hemmschuh für eine Entwicklung kritischer sexualpolitischer Strategien, die lesbischwuler Beziehungsvielfalt wirklich Rechnung tragen würde.“"
                                            },
                                            {
                                                "example_id": "fefae570-cccf-4106-9d04-8612192b5e9a",
                                                "sense_id": "7c2071d5-0bae-30e6-b93c-20a9028fa647",
                                                "text": "„Mitte Februar hat der neu gewählte Bürgermeister von San Francisco, Gavin Newsom, lesbischwule Trauungen erlaubt.“"
                                            },
                                            {
                                                "example_id": "e5780877-1b68-48dd-b57c-f70e05b3d87d",
                                                "sense_id": "7c2071d5-0bae-30e6-b93c-20a9028fa647",
                                                "text": "„Lesbischwule Kulturgeschichte wird hier jedoch nicht als historischer Bilderbogen von Prinz Eugen, Franz Schubert und Sisi bis zu lesbischen und schwulen Ikonen von heute zelebriert.“"
                                            },
                                            {
                                                "example_id": "8bd0d90f-9ba4-4f70-9d91-925ec7d77240",
                                                "sense_id": "7c2071d5-0bae-30e6-b93c-20a9028fa647",
                                                "text": "„Auch wenn die sogenannte Sexuelle Revolution zunächst vor allem eine heterosexuelle gewesen sein dürfte, so war die Idee der sexuellen Befreiung durchaus anschlussfähig für homosexuelle bzw. schwule und lesbischwule Emanzipationsbemühungen.“"
                                            },
                                            {
                                                "example_id": "1ffbee18-d8b4-4a3f-a6bf-e4f3bbb137c4",
                                                "sense_id": "7c2071d5-0bae-30e6-b93c-20a9028fa647",
                                                "text": "„Während sich die Bewertung lesbisch/queerer Sexualität an der Norm schwuler Sexualität ausrichtet, werden Transgender zugunsten lesbischwuler Politiken unsichtbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
