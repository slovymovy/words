                ],
                "senses": [
                    {
                        "sense_id": "b469bb93-da89-3b7d-ba74-0e612d2f87fd",
                        "entry_id": "2e409815-9a85-31ef-9b8a-9a2e458b8306",
                        "glosses": [
                            "in Bezug auf das gemeinsame Spiel in einer Mannschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3396f22-da3a-4e6e-9c08-11fed1b99132",
                                "sense_id": "b469bb93-da89-3b7d-ba74-0e612d2f87fd",
                                "text": "„Spielerische, individuelle und mannschaftliche Fortschritte sollte der Trainer zur weiteren Motivation positiv ansprechen.“"
                            },
                            {
                                "example_id": "310e3b6e-c832-468e-8de7-158c93355d8d",
                                "sense_id": "b469bb93-da89-3b7d-ba74-0e612d2f87fd",
                                "text": "„Die Mannschaften aus Afrika spielen attraktiv auf Grund vieler guter Einzelspieler, aber ihrem Spiel mangelt es oft an der mannschaftlichen Geschlossenheit.“"
                            },
                            {
                                "example_id": "b2c37b0c-4e1b-4265-9ca2-24d1a193754c",
                                "sense_id": "b469bb93-da89-3b7d-ba74-0e612d2f87fd",
                                "text": "„Je nach individueller und mannschaftlicher Spielstärke des Gegners und der eigenen physischen Kondition und Laufbereitschaft wird der Mannschaftsverband in verschiedenen Zonen des gegnerischen Ballbesitzers kompakt gehalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
