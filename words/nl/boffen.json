    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "36e88e18-edb3-34d4-9e06-f9fed645f7df",
                    "sense_definition": "geluk hebben of een meevaller ervaren",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geluk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat heb jij <w>geboft</w> met dat prachtige weer tijdens je vakantie!",
                            "target_lang_translations": {
                                "en": "How <w>lucky</w> you were with that beautiful weather during your holiday!"
                            }
                        },
                        {
                            "text": "We <w>boffen</w> enorm dat er nog net een tafeltje vrij was in het restaurant.",
                            "target_lang_translations": {
                                "en": "We are extremely <w>lucky</w> that there was just one table left in the restaurant."
                            }
                        }
                    ],
                    "synonyms": [
                        "geluk hebben",
                        "mazzelen"
                    ],
                    "antonyms": [
                        "pech hebben"
                    ],
                    "common_phrases": [
                        "enorm boffen",
                        "echt boffen"
                    ],
                    "target_lang_definitions": {
                        "en": "to be lucky or to experience a stroke of good fortune"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be lucky",
                                "target_lang_sense_clarification": "to have good fortune"
                            },
                            {
                                "target_lang_word": "be in luck",
                                "target_lang_sense_clarification": "to experience a specific instance of good luck"
                            },
                            {
                                "target_lang_word": "strike it lucky",
                                "target_lang_sense_clarification": "to have a sudden piece of good luck"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "62c4bbd1-c348-3d96-ab68-584fecc1cade",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>bof</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na al die kleine <w>boffen</w> dacht hij dat het geluk nooit op zou raken.",
                            "target_lang_translations": {
                                "en": "After all those little <w>strokes of luck</w>, he thought the good fortune would never end."
                            }
                        },
                        {
                            "text": "De patiënten op de afdeling hadden allemaal last van de <w>boffen</w>.",
                            "target_lang_translations": {
                                "en": "The patients in the ward were all suffering from the <w>mumps</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural of the noun 'bof' (stroke of luck) or referring to the disease mumps"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "strokes of luck",
                                "target_lang_sense_clarification": "plural of a fortunate event"
                            },
                            {
                                "target_lang_word": "mumps",
                                "target_lang_sense_clarification": "the viral disease (used with 'the')"
                            }
                        ]
                    }
                }
            ]
        }
