                                "target_senses": [
                                    {
                                        "sense_id": "bba94d20-0edf-318f-b254-50acfebc221a",
                                        "entry_id": "2c72da3a-9ae8-31a5-955b-0d1ef44f333d",
                                        "glosses": [
                                            "Staat mit theokratischer Staatsform"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18e57439-c6ae-4ea4-a2cb-1d96a579b085",
                                                "sense_id": "bba94d20-0edf-318f-b254-50acfebc221a",
                                                "text": "„Die LRA kämpft seit 1987 für einen Gottesstaat, der auf den zehn Geboten basieren soll.“"
                                            },
                                            {
                                                "example_id": "0690520d-b622-4f9f-b57d-4d59e8e6904a",
                                                "sense_id": "bba94d20-0edf-318f-b254-50acfebc221a",
                                                "text": "„Auch Gottesstaaten auf Erden sind Diktaturen, die den Witz mit Feuer und Schwert bekämpfen, der deshalb geradezu zwangsläufig in rigorosen religiösen Systemen entsteht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "465371ef-b00c-33ca-b77a-097b606a4c99",
                                        "entry_id": "2c72da3a-9ae8-31a5-955b-0d1ef44f333d",
                                        "glosses": [
                                            "der Staat Gottes mit der Gesamtheit der Menschheit im Himmel und auf Erden"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2e96635-7127-4ecf-b20d-1085cdcab7e5",
                        "source_entry_id": "021dd8ec-d4b4-3d17-bc71-00b3124ac386",
                        "source_sense_description": "government under the control of a Church",
                        "target_lang_word": "Kirchenstaat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kirchenstaat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "03af43c3-68c1-3d10-9695-3d4df46dac55",
                                        "entry_id": "36cb41f7-c98a-39d8-a2b7-70c9eb2a0990",
                                        "glosses": [
                                            "andere Bezeichnung für den Vatikanstaat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48e35b42-1895-46bf-9f50-d15b52e13b95",
                                                "sense_id": "03af43c3-68c1-3d10-9695-3d4df46dac55",
                                                "text": "„Während sich die Abenddämmerung über den Kirchenstaat senkt, heben der Sekretär und der Fahrer drei Blautannen aus dem Bayerischen Wald vom Wagendach und schleppen sie zu einem kleinen Aufzug…“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e7f055b7-326f-331f-8e54-367fa904e23a",
                                        "entry_id": "36cb41f7-c98a-39d8-a2b7-70c9eb2a0990",
                                        "glosses": [
                                            "bis 1870 vom Papst regierter Staat in Mittelitalien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "020f5b2f-05a1-452b-bcb8-0377a8b687a5",
                                                "sense_id": "e7f055b7-326f-331f-8e54-367fa904e23a",
                                                "text": "„Im Norden erstreckte sich das Land bis an den Kirchenstaat, womit es für damalige europäische Verhältnisse ziemlich groß war.“"
                                            },
                                            {
                                                "example_id": "db78c053-52f6-4da8-8a3d-1362abd21c2e",
                                                "sense_id": "e7f055b7-326f-331f-8e54-367fa904e23a",
                                                "text": "„Daraufhin sagte er, ich sei bei dem ehrenwertesten Sbirren des ganzen Kirchenstaates.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
