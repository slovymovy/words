                        "es": [
                            {
                                "target_lang_word": "irritar",
                                "target_lang_sense_clarification": "piel y mucosas, uso médico"
                            },
                            {
                                "target_lang_word": "inflamar",
                                "target_lang_sense_clarification": "tejidos y heridas, uso médico"
                            }
                        ],
                        "zh": [
                            {
