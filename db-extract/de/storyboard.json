                "senses": [
                    {
                        "sense_id": "60ca7131-fe53-3af0-a593-b58751e2a509",
                        "entry_id": "25c98a8b-d464-3d78-bd30-4a5e3057275d",
                        "glosses": [
                            "aus Einzelbildern bestehende stilisierte Abfolge eines Filmes zur Erläuterung des Drehbuches"
                        ],
                        "tags": [
                            "Filmindustrie"
                        ],
                        "examples": [
                            {
                                "example_id": "4b8e4552-941f-418e-a881-2c9867472794",
                                "sense_id": "60ca7131-fe53-3af0-a593-b58751e2a509",
                                "text": "„Der Begriff „Storyboard“ (deutsch: Drehbuch) entstammt der Filmproduktion und meint dort die zeichnerische Umsetzung des Drehbuches. Ein Storyboard dient somit als Vorlage für den Aufbau und die Gestaltung der einzelnen Einstellungen und Szenen. Übertragen auf die Multimediaproduktion übernimmt ein Storyboard eine ähnliche Funktion: Es bildet die zeichnerische Vorlage für die Gestaltung der einzelnen Screens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fd8362e1-92c5-3fa1-9bf5-5045a52e279f",
                        "entry_id": "25c98a8b-d464-3d78-bd30-4a5e3057275d",
                        "glosses": [
                            "zeichnerische Vorlage für die Gestaltung und den Ablauf von einzelnen Screens in elektronischen oder virtuellen Lernumgebungen"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "9259fa07-feb0-46d0-be90-c5e4eb01231c",
                                "sense_id": "fd8362e1-92c5-3fa1-9bf5-5045a52e279f",
                                "text": "„Der Begriff „Storyboard“ (deutsch: Drehbuch) entstammt der Filmproduktion und meint dort die zeichnerische Umsetzung des Drehbuches. Ein Storyboard dient somit als Vorlage für den Aufbau und die Gestaltung der einzelnen Einstellungen und Szenen. Übertragen auf die Multimediaproduktion übernimmt ein Storyboard eine ähnliche Funktion: Es bildet die zeichnerische Vorlage für die Gestaltung der einzelnen Screens.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0934687e-36ce-41eb-aa0c-2717fdee9b6a",
                        "source_entry_id": "25c98a8b-d464-3d78-bd30-4a5e3057275d",
                        "source_sense_id": "60ca7131-fe53-3af0-a593-b58751e2a509",
                        "target_lang_word": "storyboard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "storyboard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3feb2225-da66-3146-a143-8dadbe7ea5c2",
                                        "entry_id": "410d1a24-bd03-3165-91ab-bc875cd8ed80",
                                        "glosses": [
                                            "A series of drawings that lay out the sequence of scenes in a film or series, especially an animated one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0460fcf3-c835-4f85-9cec-4142ece82744",
                                                "sense_id": "3feb2225-da66-3146-a143-8dadbe7ea5c2",
                                                "text": "The storyboard process helps promote brainstorming, highlights missing tasks, and allows the team to incorporate changes prior to traveling too far down a particular path. — By Cheryl A. Malloy & William Cooley, NASA & SAIC here"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95bd985e-9096-3d45-a920-cf5aad8e684f",
                                        "entry_id": "410d1a24-bd03-3165-91ab-bc875cd8ed80",
                                        "glosses": [
                                            "Any sequence of drawings or diagrams which illustrate a sequence of events, e.g. in an accident or as a flowsheet for computer programming."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "storyboard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb6112d8-ceff-3cce-8663-774e9ccc8a03",
                                        "entry_id": "8e34c51b-132e-3d75-8434-4fad036d4562",
                                        "glosses": [
                                            "To create and arrange storyboard drawings."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7adb6ec-64ee-4ffa-819c-ea6f2957bc7e",
                                                "sense_id": "bb6112d8-ceff-3cce-8663-774e9ccc8a03",
                                                "text": "Storyboarding allows students to work together as they generate ideas and eliminates the territorial defensiveness that often occurs when new ideas are suggested. — \"Using Storyboarding to Determine components of Dellness for University Students\" J Am Coll Health. 1996 Jan;44(4):180-3 Abstract"
