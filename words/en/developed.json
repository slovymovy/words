                },
                {
                    "sense_id": "8cca675a-97c9-3dcc-abc2-be2f3d16ab60",
                    "sense_definition": "Of photographic film, chemically processed to make the image visible.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "photography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He carefully hung the <w>developed</w> film strips to dry in the darkroom.",
                            "target_lang_translations": {
                                "ru": "Он осторожно повесил <w>проявленные</w> полоски пленки сушиться в темной комнате.",
                                "nl": "Hij hing de <w>ontwikkelde</w> filmstroken voorzichtig op om te drogen in de donkere kamer."
                            }
                        },
                        {
                            "text": "The colors in the <w>developed</w> photograph were incredibly vivid.",
                            "target_lang_translations": {
                                "ru": "Цвета на <w>проявленной</w> фотографии были невероятно яркими.",
                                "nl": "De kleuren op de <w>ontwikkelde</w> foto waren ongelooflijk levendig."
                            }
