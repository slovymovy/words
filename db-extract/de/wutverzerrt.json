                    }
                ],
                "senses": [
                    {
                        "sense_id": "ac3b6c9d-45fe-3a26-ab9d-7abee06dee23",
                        "entry_id": "ddb89fa0-f638-3ff7-a266-a67516cc2303",
                        "glosses": [
                            "vor Wut verzerrt/angespannt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0b8ab3f-8eed-4ce7-bc33-43698ce83c81",
                                "sense_id": "ac3b6c9d-45fe-3a26-ab9d-7abee06dee23",
                                "text": "„Ich dachte, ich könnte Obaid vielleicht mit den Bildern von Arafat ablenken, aber als ich sein wutverzerrtes Gesicht sah, gab ich die Idee auf.“"
                            },
                            {
                                "example_id": "d67a685f-245d-4b29-99c4-8236f53e2b72",
                                "sense_id": "ac3b6c9d-45fe-3a26-ab9d-7abee06dee23",
                                "text": "„Aspinwalls rotes Gesicht war wutverzerrt und mit der freien Hand griff er erneut nach dem buschigen Bart seines Widersachers.“"
                            },
                            {
                                "example_id": "9f8983f2-5693-4c48-8b10-5565c3985072",
                                "sense_id": "ac3b6c9d-45fe-3a26-ab9d-7abee06dee23",
                                "text": "„Mit wutverzerrten Zügen stapft die Vettel auf eine Tür rechts zu.“"
                            },
                            {
                                "example_id": "f2e7c726-3403-4e02-89cf-18e39d813185",
                                "sense_id": "ac3b6c9d-45fe-3a26-ab9d-7abee06dee23",
                                "text": "„Mit wutverzerrtem Gesicht riss und brach und hebelte er seine Einrichtung auseinander, stocherte und bohrte und warf seine zerstörten Habseligkeiten zur Seite.“"
                            },
                            {
