                                        "entry_id": "6ee8022c-aeb0-3a7c-9a36-a5d8eebd2ecb",
                                        "glosses": [
                                            "mit dessen Hilfe der Maurer Mörtel an einem Stein anbringt, um diesen in eine Mauer einzufügen"
                                        ],
