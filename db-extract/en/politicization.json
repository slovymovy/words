                ],
                "senses": [
                    {
                        "sense_id": "0a3d931c-9891-397b-8621-9647dbbe60a2",
                        "entry_id": "02299f2b-fef6-3744-88c1-38c9dc3723fa",
                        "glosses": [
                            "The state of being (or process of becoming) politicized"
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "8b912b66-cde0-4ebd-8a68-297ab4727fac",
                                "sense_id": "0a3d931c-9891-397b-8621-9647dbbe60a2",
                                "text": "This potential politicization of the military comes with opportunity costs to U.S. national security, says Joseph Nunn, counsel in the Liberty and National Security program at the Brennan Center for Justice, an independent law and policy think tank."
                            },
                            {
                                "example_id": "25b51168-df66-4890-81dd-683952235a8e",
                                "sense_id": "0a3d931c-9891-397b-8621-9647dbbe60a2",
                                "text": "Across the country, Democratic voters who have been reeling from Mr. Trump’s sweeping and possibly illegal cuts to government, his head-spinning policy moves, and his politicization of federal law enforcement are growing more and more incensed at their own party’s seemingly feckless response."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6e9c598-b21f-4f1a-96c0-4decab4a907e",
                        "source_entry_id": "02299f2b-fef6-3744-88c1-38c9dc3723fa",
                        "source_sense_id": "0a3d931c-9891-397b-8621-9647dbbe60a2",
                        "source_sense_description": "the state of being or process of becoming politicized",
                        "target_lang_word": "politizace",
                        "target_lang_code": "cs",
