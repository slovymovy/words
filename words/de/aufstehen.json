                {
                    "sense_id": "afb8d7f9-b6be-34bb-b8a9-928ecb0a8e2f",
                    "sense_definition": "Nach dem Schlafen das Bett verlassen.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "erwachen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich muss jeden Wochentag sehr früh <w>aufstehen</w>, um pünktlich im Büro zu sein."
                        },
                        {
                            "text": "Am Sonntag ist er erst gegen zehn Uhr morgens <w>aufgestanden</w>."
                        }
                    ],
                    "antonyms": [
                        "sich hinlegen"
                    ],
                    "common_phrases": [
                        "früh aufstehen",
                        "spät aufstehen"
                    ]
                },
                {
                    "sense_id": "340f64c4-3777-31d4-9ab1-3ac4f8e811e0",
                    "sense_definition": "Aus einer sitzenden oder liegenden Position in eine aufrechte Haltung auf die Beine kommen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "körperhaltung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als die Gäste den Raum betraten, <w>stand</w> er sofort von seinem Stuhl <w>auf</w>."
                        },
                        {
                            "text": "Nach der langen Konferenz taten ihr die Beine weh, als sie endlich <w>aufstand</w>."
                        }
                    ],
                    "synonyms": [
                        "sich aufrichten",
                        "sich erheben"
                    ],
                    "common_phrases": [
                        "vom Stuhl aufstehen",
                        "vom Boden aufstehen"
                    ]
                },
                {
                    "sense_id": "85c934e8-c7e7-3d18-bf1a-0cc3ac6472f3",
                    "sense_definition": "Nicht geschlossen sein; geöffnet dasitzen oder offen bleiben (besonders von Türen, Fenstern oder Toren).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zustand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Es zieht furchtbar im Flur, weil das Fenster im Badezimmer noch weit <w>aufsteht</w>."
                        },
                        {
                            "text": "Die alte Holztür <w>stand</w> die ganze Nacht sperrangelweit <w>auf</w>."
                        }
                    ],
                    "synonyms": [
                        "offenstehen"
                    ],
                    "antonyms": [
                        "geschlossen sein",
                        "zu sein"
                    ],
                    "common_phrases": [
                        "sperrangelweit aufstehen",
                        "einen Spalt aufstehen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vor allem im alltäglichen Sprachgebrauch für offene Türen oder Fenster verwendet"
                        }
                    ]
                },
                {
                    "sense_id": "506739a9-58f0-3998-b60f-4b87aa20aecd",
                    "sense_definition": "Sich empören, Widerstand leisten oder rebellieren.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "widerstand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Menschen <w>standen</w> mutig gegen die Tyrannei und für ihre demokratischen Rechte <w>auf</w>."
                        },
                        {
                            "text": "Im Laufe der Geschichte sind viele Völker gegen grausame Herrscher gemeinsam <w>aufgestanden</w>."
                        }
                    ],
                    "synonyms": [
                        "sich erheben"
                    ],
                    "common_phrases": [
                        "gegen Unterdrückung aufstehen",
                        "gegen Unrecht aufstehen"
                    ]
                }
            ]
