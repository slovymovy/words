                        "cross_references": [
                            {
                                "target_word": "zittrig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b0935a2-e83d-389d-9304-75db079ab948",
                                        "entry_id": "e6f53c62-70cb-3c54-be59-7701698a304e",
                                        "glosses": [
                                            "häufig zitternd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47248d4a-2f5e-4d33-b1e6-4817a167a12b",
                                                "sense_id": "4b0935a2-e83d-389d-9304-75db079ab948",
                                                "text": "Das führte dazu, dass schon der erste Pass aus der Abwehr heraus, der wichtigste für den Spielaufbau, zittrig war und voller Zweifel."
                                            },
                                            {
                                                "example_id": "c3e0f358-34e3-4450-b2e0-44fc0268c74d",
                                                "sense_id": "4b0935a2-e83d-389d-9304-75db079ab948",
                                                "text": "Immer dann, wenn sich Ihr Kind schwach und zittrig fühlt und es vor Müdigkeit kaum die Augen aufhalten kann, sollten Sie an die homöopathische Gabe von Wildem Jasmin (Gelsemium) denken."
                                            },
                                            {
                                                "example_id": "05e83124-f0de-4646-9ff6-ed0459a59853",
                                                "sense_id": "4b0935a2-e83d-389d-9304-75db079ab948",
                                                "text": "Das vorerst aktivierende Lampenfieber, entwickelt dann das Gefühl steigender Angst: Die Hände werden zittrig, die Stimme verliert an Ausdruck und die Kehle verengt sich."
                                            },
                                            {
                                                "example_id": "38d5ce68-ab4b-4990-aa41-7e909b7bda7e",
                                                "sense_id": "4b0935a2-e83d-389d-9304-75db079ab948",
                                                "text": "Nicht nur Kälte, Stress oder Nervosität lösen bei Ihnen zittrige Hände aus, auch Krankheiten können sich dahinter verbergen."
                                            },
                                            {
                                                "example_id": "4f4ce420-b9e8-417c-8cac-6e4919d666bb",
                                                "sense_id": "4b0935a2-e83d-389d-9304-75db079ab948",
                                                "text": "Eine schwerere Ursache ist die Krankheit Parkinson, die ebenfalls zittrige Hände verursacht."
                                            },
                                            {
                                                "example_id": "145353dd-1d54-4a0f-b467-48bc208dd95c",
                                                "sense_id": "4b0935a2-e83d-389d-9304-75db079ab948",
                                                "text": "Nicht selten sind Fälle, bei denen die Stimme von Älteren zittrig, also, wie es in der medizinischen Fachsprache heißt, tremolierend klingt."
                                            },
                                            {
                                                "example_id": "12b04d56-f6e4-44e8-a0b1-2f07f7a18b55",
                                                "sense_id": "4b0935a2-e83d-389d-9304-75db079ab948",
                                                "text": "Indizien sprachen für ihn und: Clenbuterol kann zittrige Hände verursachen, für Tischtennisspieler wenig optimal."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
