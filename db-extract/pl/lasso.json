                "senses": [
                    {
                        "sense_id": "545e7a49-eac3-3ec8-b2ce-69da9d03563a",
                        "entry_id": "e4946b77-405c-374a-9d74-94fe864c8508",
                        "glosses": [
                            "sznur lub rzemień zakończony samozaciskową pętlą, służący do chwytania zwierząt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b58799b-438b-4ac9-962a-25a2240777b9",
                                "sense_id": "545e7a49-eac3-3ec8-b2ce-69da9d03563a",
                                "text": "Gdy zwierzę wykonuje gwałtowny ruch, pętla lassa zaciska się na jego szyi, utrudniając oddychanie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cb29aa46-e610-4a03-aa18-646347cdb8e4",
                        "source_entry_id": "e4946b77-405c-374a-9d74-94fe864c8508",
                        "source_sense_id": "545e7a49-eac3-3ec8-b2ce-69da9d03563a",
                        "target_lang_word": "lasso",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lasso",
