                        "examples": [
                            {
                                "example_id": "e28dd80d-4d8b-4f46-bd07-2cf2186028f2",
                                "sense_id": "47283dea-1490-3b05-a22d-73fdb6268af2",
                                "text": "After a dogged silence of long months, in which there have been scores of anxious inquiries on the part of our readers, as to his whereabout, whatabout, and whenabout,—and when-to-be-about,—the Indifferent Man has at length, in the cool indifference of his own good time, 'forked over' the stanzas below, composed on the daguerreotype shadow of a sweetheart whom he had never seen."
                            },
                            {
                                "example_id": "9aa5187b-678e-48be-8e5a-b83d56b332ff",
                                "sense_id": "47283dea-1490-3b05-a22d-73fdb6268af2",
                                "text": "Moreover, two events which are simultaneous to one observer, are not necessarily simultaneous to another observer. The whereabout depends upon the whenabout and the whenabout depends upon the whereabout, not only that, but each depends also on the velocity of an observer."
                            }
                        ]
                    }
