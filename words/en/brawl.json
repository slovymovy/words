{
    "word_family": [
        "brawler"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7f723d93-0eca-3f26-bbd1-004bcc002d96",
                    "sense_definition": "A noisy, disorderly fight or quarrel, often involving multiple people in a public place.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "altercation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Several police officers were called to stop a violent street <w>brawl</w> outside the stadium.",
                            "target_lang_translations": {
                                "nl": "Verschillende politieagenten werden opgeroepen om een gewelddadige <w>straatvechtpartij</w> buiten het stadion te stoppen."
                            }
                        },
                        {
                            "text": "A drunken <w>brawl</w> broke out in the pub just before closing time.",
                            "target_lang_translations": {
                                "nl": "Vlak voor sluitingstijd brak er een dronken <w>knokpartij</w> uit in het café."
                            }
                        }
                    ],
                    "synonyms": [
                        "fight",
                        "fracas",
                        "scuffle"
                    ],
                    "common_phrases": [
                        "bar brawl",
                        "drunken brawl",
                        "street brawl"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een luidruchtig, wanordelijk gevecht of een rel, vaak tussen meerdere mensen op een openbare plek."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "vechtpartij",
                                "target_lang_sense_clarification": "algemeen wanordelijk gevecht"
                            },
                            {
                                "target_lang_word": "knokpartij",
                                "target_lang_sense_clarification": "informeel, gevecht met vuisten"
                            },
                            {
                                "target_lang_word": "handgemeen",
                                "target_lang_sense_clarification": "formeel, kortstondig fysiek conflict"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef3a2729-9f55-3ff3-bb38-267bafb4b915",
                    "sense_definition": "Alternative form of <w>branle</w>, an old French circle or line dance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The musicians performed a traditional French <w>brawl</w> at the historical court festival.",
                            "target_lang_translations": {
                                "nl": "De muzikanten speelden een traditionele Franse <w>branle</w> op het historische hoffestival."
                            }
                        },
                        {
                            "text": "Dancers formed a wide circle to rehearse the lively <w>brawl</w>.",
                            "target_lang_translations": {
                                "nl": "Dansers vormden een grote kring om de levendige <w>branle</w> te oefenen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used historically to describe the Renaissance dance"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Historische Franse kring- of reidans uit de renaissance (ook bekend als branle)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "branle",
                                "target_lang_sense_clarification": "renaissancedans"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3db50858-8f46-3d78-9776-9906ed324041",
                    "sense_definition": "To engage in a rough, noisy fight or quarrel, especially in public.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "altercation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rival fans <w>brawled</w> on the sidewalk after their team lost the championship.",
                            "target_lang_translations": {
                                "nl": "Rivaliserende fans <w>vochten</w> op de stoep nadat hun team het kampioenschap had verloren."
                            }
                        },
                        {
                            "text": "The two men began to <w>brawl</w> loudly over a minor parking dispute.",
                            "target_lang_translations": {
                                "nl": "De twee mannen begonnen luidruchtig <w>te knokken</w> over een klein parkeergeschil."
                            }
                        }
                    ],
                    "synonyms": [
                        "scuffle",
                        "squabble",
                        "wrangle"
                    ],
                    "target_lang_definitions": {
                        "nl": "Deelnemen aan een luidruchtig, ruw gevecht of ruzie, vooral in het openbaar."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "vechten",
                                "target_lang_sense_clarification": "fysiek slaags raken"
                            },
                            {
                                "target_lang_word": "knokken",
                                "target_lang_sense_clarification": "informeel, met de vuisten vechten"
                            },
                            {
                                "target_lang_word": "op de vuist gaan",
                                "target_lang_sense_clarification": "slaags raken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "efe1e517-078f-325d-ba9b-d479fb9a3515",
                    "sense_definition": "To create a noisy disturbance or complain in a loud and angry manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "altercation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He entered the town hall and began to <w>brawl</w> about the new local taxes.",
                            "target_lang_translations": {
                                "nl": "Hij liep het gemeentehuis binnen en begon luidkeels <w>tekeer te gaan</w> over de nieuwe lokale belastingen."
                            }
                        },
                        {
                            "text": "Neighbors complained when the upset tenant continued to <w>brawl</w> in the hallway.",
                            "target_lang_translations": {
                                "nl": "Buren klaagden toen de overstuurde huurder op de gang <w>kabaal bleef maken</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "clamor"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "chiefly older usage for loud complaining"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Kabaal maken, herrie schoppen of luidkeels en boos tekeergaan."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "kabaal maken",
                                "target_lang_sense_clarification": "luidruchtig protesteren of ruzie maken"
                            },
                            {
                                "target_lang_word": "tekeergaan",
                                "target_lang_sense_clarification": "woedend en luid tekeergaan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98af87a2-dbbf-3adf-b101-8df68f5027a8",
                    "sense_definition": "To flow with a loud, bubbling, or rushing noise over stones or obstacles, typically said of a stream or brook.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A shallow mountain stream <w>brawls</w> through the rocky canyon below.",
                            "target_lang_translations": {
                                "nl": "Een ondiepe bergstroom <w>ruist</w> door de rotsachtige kloof beneden."
                            }
                        },
                        {
                            "text": "They sat on the bank listening to the water <w>brawl</w> over the smooth pebbles.",
                            "target_lang_translations": {
                                "nl": "Ze zaten op de oever en luisterden naar het water dat over de gladde kiezels <w>kabbelde</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "babble",
                        "gurgle"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "chiefly literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Met een luid, borrelend of ruisend geluid over stenen of hindernissen stromen (van water)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "ruisen",
                                "target_lang_sense_clarification": "van stromend water"
                            },
                            {
                                "target_lang_word": "kabbelen",
                                "target_lang_sense_clarification": "hoorbaar stromen over stenen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3130582-440c-343c-addd-b88abcb4b75a",
                    "sense_definition": "To scold harshly or heap verbal abuse upon someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "altercation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry supervisor would constantly <w>brawl</w> his workers over tiny mistakes.",
                            "target_lang_translations": {
                                "nl": "De boze leidinggevende placht zijn arbeiders voortdurend <w>uit te foeteren</w> over minieme foutjes."
                            }
                        },
                        {
                            "text": "She refused to stay and let him <w>brawl</w> her in front of their guests.",
                            "target_lang_translations": {
                                "nl": "Ze weigerde te blijven en zich door hem ten overstaan van hun gasten <w>te laten uitschelden</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "berate",
                        "scold"
                    ],
                    "antonyms": [
                        "praise"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "obsolete or dated transitive usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand hevig uitfoeteren, berispen of met scheldwoorden overladen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "uitfoeteren",
                                "target_lang_sense_clarification": "scherp berispen"
                            },
                            {
                                "target_lang_word": "uitschelden",
                                "target_lang_sense_clarification": "verbaal aanvallen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f874bf18-4b7e-36ca-a10b-86b4cb1db999",
                    "sense_definition": "To quiver, shake, or move rapidly to and fro.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The delicate leaves began to <w>brawl</w> in the strong autumn wind.",
                            "target_lang_translations": {
                                "nl": "De tere bladeren begonnen <w>te trillen</w> in de harde herfstwind."
                            }
                        },
                        {
                            "text": "The thin needle seemed to <w>brawl</w> as the earth shuddered beneath them.",
                            "target_lang_translations": {
                                "nl": "De dunne naald leek <w>te beven</w> toen de aarde onder hen schudde."
                            }
                        }
                    ],
                    "synonyms": [
                        "quiver",
                        "shake",
                        "vibrate",
                        "waver"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "no longer in contemporary use"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Trillen, beven of snel heen en weer bewegen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "trillen",
                                "target_lang_sense_clarification": "heen en weer bewegen"
                            },
                            {
                                "target_lang_word": "beven",
                                "target_lang_sense_clarification": "vibreren of schudden"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}