                        "source_sense_id": "d57024e7-c7d8-3dc1-beb5-1a196a230b17",
                        "source_sense_description": "mensen onder voor de buitenwereld onzichtbare bedreiging zaken tegen hun wil laten doen",
                        "target_lang_word": "Erpressung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erpressung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7930475c-2d5f-3949-aa61-93b3fec8ea15",
                                        "entry_id": "f1067bb8-0067-3af1-bf8d-9ceebfcfecef",
                                        "glosses": [
                                            "kriminelles, illegales Erzwingen eines Verhaltens oder einer Leistung durch Androhung negativer Konsequenzen bei Nichterfüllung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58e4d06b-32aa-4961-96f5-fdbfb8626b4f",
                                                "sense_id": "7930475c-2d5f-3949-aa61-93b3fec8ea15",
                                                "text": "Jeder Erpressung hat ihren Keim in krimineller Energie und persönlicher Vorteilnahme, und liegt im Glaube des Erpressten, diese anzunehmen oder gleichsam mit Nachdruck zu erwidern und gnadenlos zu ahnden."
                                            },
                                            {
                                                "example_id": "93fa96b9-4bb1-41cf-8c92-349d1f2cf532",
                                                "sense_id": "7930475c-2d5f-3949-aa61-93b3fec8ea15",
                                                "text": "Es gibt viele Formen der Erpressung, jedoch haben alle einen gemeinsamen Charakter: „Tu dieses nicht, dann tue ich jenes nicht … also gehorche mir und es wird Dir nichts geschehen!“"
                                            },
                                            {
                                                "example_id": "5bd4ebd9-1512-49d4-9973-75c070dfb201",
                                                "sense_id": "7930475c-2d5f-3949-aa61-93b3fec8ea15",
                                                "text": "Auch in einer freien Gesellschaft, ist die Erpressung ein probates Mittel, also die Fortführung einer Politik oder einer berechtigten/unberechtigten Forderung … nur mit anderen Mittel .. bis hin zum Totalverlust."
                                            },
                                            {
                                                "example_id": "20ba2dba-34e6-4446-82ac-92a74bbfff0f",
                                                "sense_id": "7930475c-2d5f-3949-aa61-93b3fec8ea15",
                                                "text": "„Ich helfe also dem indischen Staat, indem ich einen Akt von Erpressung und Korruption unterlaufe.“"
                                            },
                                            {
                                                "example_id": "48662c86-3342-42a0-b076-a81d24ad2371",
                                                "sense_id": "7930475c-2d5f-3949-aa61-93b3fec8ea15",
                                                "text": "„Er hatte sich schon an die Erpressungen gewöhnt, die alle halbe Stunde auf ihn niederprasselten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
