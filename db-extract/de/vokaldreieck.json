                "senses": [
                    {
                        "sense_id": "4c805c97-0ba9-38c0-9e7b-742ed3bca114",
                        "entry_id": "4705d6ab-cc89-3e2a-a04b-40aef7d81f8c",
                        "glosses": [
                            "Vokalsystem einer Sprache, das graphisch in Form eines Dreiecks dargestellt wird"
                        ],
                        "tags": [
                            "Phonetik"
                        ],
                        "examples": [
                            {
                                "example_id": "8a6d1768-3b83-4634-ba6e-300acb59a977",
                                "sense_id": "4c805c97-0ba9-38c0-9e7b-742ed3bca114",
                                "text": "„Da ich mit artikulatorisch bestimmten Merkmalen gearbeitet habe, ergibt sich schon allein deshalb eine gewisse Ähnlichkeit zu den Vokaldreiecken der phonetischen Beschreibung.“"
                            },
                            {
                                "example_id": "eaa4e0b3-232a-4d51-b06c-a2091f862172",
                                "sense_id": "4c805c97-0ba9-38c0-9e7b-742ed3bca114",
                                "text": "„Zu den ersten Darstellungen dieser Art gehört das Vokaldreieck des CHR. FR. HELLWAG.“"
                            },
                            {
                                "example_id": "f02c2832-b508-4278-97c2-3c824350c4ee",
                                "sense_id": "4c805c97-0ba9-38c0-9e7b-742ed3bca114",
                                "text": "„Aufgrund dieser Ergebnisse kommt STUMPF zur Anlage eines Vokaldreiecks, an dem sich die Grundeigenschaften der Vokale ablesen lassen (…).“"
                            },
                            {
                                "example_id": "0d70a9b9-0a00-4782-a7e4-ac6767c4f99c",
                                "sense_id": "4c805c97-0ba9-38c0-9e7b-742ed3bca114",
                                "text": "„Traditionell erfolgt die graphische Erfassung der russischen betonten Vokale im Vokaldreieck oder im Vokalviereck.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
