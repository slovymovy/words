                                        "glosses": [
                                            "The mother of one's grandparent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "174f0ce0-0f5e-43ef-aed4-58d192719fe0",
                                                "sense_id": "1ef422c9-5cf9-3021-b2c7-576bcf682196",
                                                "text": "She’s now a great-grandmother with three sons, a grandson and two great-grandchildren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14015810-d716-4076-964a-c12a86aa63dd",
                        "source_entry_id": "f034760e-98fd-307d-a454-93be7c5bb243",
                        "source_sense_id": "5beb4d23-a10f-33b4-becd-2c21d7e3c907",
                        "target_lang_word": "great-grandma",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "great-grandma",
