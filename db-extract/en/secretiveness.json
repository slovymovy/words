                    {
                        "translation_id": "45a750b1-356a-45bb-ad8b-fe1356061d25",
                        "source_entry_id": "dc17077f-5567-3848-8e4b-597a96cecf9b",
                        "source_sense_id": "e2af312b-1f71-367d-a218-3688e024825a",
                        "source_sense_description": "The state or characteristic of being secretive",
                        "target_lang_word": "Geheimniskrämerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geheimniskrämerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ded19d6f-567d-3785-9c86-7589b070fab5",
                                        "entry_id": "06bbef43-d5bc-3f60-8b22-41e9e9f334ef",
                                        "glosses": [
                                            "Verhalten, das vermuten lässt, dass jemand etwas heimlich tun (geheim halten, ein Geheimnis wahren) möchte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b872179-651b-451e-876b-423e0a72ebfd",
                                                "sense_id": "ded19d6f-567d-3785-9c86-7589b070fab5",
                                                "text": "„Was soll denn diese Geheimniskrämerei!“"
                                            },
                                            {
                                                "example_id": "271741e9-694c-4169-94ac-3fe7257fdf39",
                                                "sense_id": "ded19d6f-567d-3785-9c86-7589b070fab5",
                                                "text": "Ich sah, wie er mit Britton hastig ein paar Sätze austauschte. Sie flüsterten dabei. Mir erschien diese Geheimniskrämerei nicht ganz geheuer."
                                            },
                                            {
                                                "example_id": "58381e95-dcfe-449c-a663-db975be6e996",
                                                "sense_id": "ded19d6f-567d-3785-9c86-7589b070fab5",
                                                "text": "„Ein Beispiel par excellence für Apples hohe Schule der gekonnten Geheimniskrämerei war beispielsweise die Eröffnung des ersten AppleStores.“"
                                            },
                                            {
                                                "example_id": "93a914cb-15f3-4240-8b14-50610346c11f",
                                                "sense_id": "ded19d6f-567d-3785-9c86-7589b070fab5",
                                                "text": "Vor einem Jahr verschwanden in Mexiko 43 Studenten. Die Angehörigen werfen den Behörden immer wieder Geheimniskrämerei vor."
                                            },
                                            {
                                                "example_id": "2ebcb5f3-4f40-4173-8320-4b2f019b76ae",
                                                "sense_id": "ded19d6f-567d-3785-9c86-7589b070fab5",
                                                "text": "Bill Clinton, der ehemalige US-Präsident, hat […] einen Thriller geschrieben: […] weltweit ist der Thriller gleichzeitig am 4. Juni erschienen. Vorab gab es viel Geheimniskrämerei, nichts durfte vor der Veröffentlichung nach außen dringen."
                                            },
                                            {
                                                "example_id": "7cdb48de-5739-49fd-bc73-127476917c7c",
                                                "sense_id": "ded19d6f-567d-3785-9c86-7589b070fab5",
                                                "text": "Die Geheimniskrämerei der IHK Bremerhaven hat Tradition: Schon 1882 weigerte sie sich als einzige Kammer im damaligen Preußen, ihre Sitzungsprotokolle dem Staat vorzulegen."
                                            },
                                            {
                                                "example_id": "e18bccdc-ee3e-494d-8a79-315ad25c6cbc",
                                                "sense_id": "ded19d6f-567d-3785-9c86-7589b070fab5",
                                                "text": "„Es gibt kaum Probleme. Wir müssen nur darauf achten, dass kein Blackout passiert. Aber darüber möchte ich nicht reden. Das ist geheim.“ Die Geheimniskrämerei ist kein Zufall. Ende letzten Jahres stahlen Kriminelle rund 600 Computer eines Bitcoin-Konkurrenten […]"
                                            },
                                            {
                                                "example_id": "2cd6b156-1021-4296-a5f4-a48087f20e03",
                                                "sense_id": "ded19d6f-567d-3785-9c86-7589b070fab5",
                                                "text": "„Ein anderer Online-Musikhändler, der mir viel besser gefällt, ist Bandcamp. Da kann ich ganz genau einsehen, wie mit meiner Musik Geld gemacht wird. […] Ich denke, dass die Geheimniskrämerei, die Spotify […] betreibt, Teil seines Kapitals ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0793dc82-5072-4675-afa2-776aefd185fc",
                        "source_entry_id": "dc17077f-5567-3848-8e4b-597a96cecf9b",
                        "source_sense_id": "e2af312b-1f71-367d-a218-3688e024825a",
