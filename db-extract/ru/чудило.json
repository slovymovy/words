                ],
                "senses": [
                    {
                        "sense_id": "a0c91215-9ff0-3fb4-a14f-d936b0126ee9",
                        "entry_id": "45ecace0-fe3e-34c6-aa7c-c5acb290ba8b",
                        "glosses": [
                            "разг., неодобр. странный, чудаковатый человек, тот кто поступает непонятно и нелепо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aaef173e-fd09-405e-b299-63ab43a6fcb3",
                                "sense_id": "a0c91215-9ff0-3fb4-a14f-d936b0126ee9",
                                "text": "— Где же мельницы? Где? — Вот же они, прямо за вагонными мастерскими, чудило! Петя смолчал, боясь как-нибудь снова не очутиться в дураках."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2894f346-6daa-42be-91d2-df98ac0f1dbb",
                        "source_entry_id": "45ecace0-fe3e-34c6-aa7c-c5acb290ba8b",
                        "source_sense_id": "a0c91215-9ff0-3fb4-a14f-d936b0126ee9",
                        "target_lang_word": "Kauz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kauz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "76f20541-f8e8-3364-9c14-c26bd8d89185",
                                        "entry_id": "c31c9aa9-6b5d-311d-b99a-5d7f48e38e76",
                                        "glosses": [
                                            "Vertreter einiger Eulengattungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "310974ad-7840-404f-b105-27b5ddaa4aee",
                                                "sense_id": "76f20541-f8e8-3364-9c14-c26bd8d89185",
                                                "text": "Im Wald hört man nachts die Käuze rufen."
                                            },
                                            {
                                                "example_id": "04d54615-5934-4a61-8be0-371667f7540c",
                                                "sense_id": "76f20541-f8e8-3364-9c14-c26bd8d89185",
                                                "text": "„Hainstock hatte ihr die Lebensgewohnheiten der Käuze geschildert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1cc409de-c493-3328-b5ed-0edeea6254bb",
                                        "entry_id": "c31c9aa9-6b5d-311d-b99a-5d7f48e38e76",
                                        "glosses": [
                                            "eigenartiger (aber nicht unsympathischer) Mensch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "442fb121-2bb2-4b03-b8e6-121954d676eb",
                                                "sense_id": "1cc409de-c493-3328-b5ed-0edeea6254bb",
                                                "text": "Der ist ein komischer Kauz. Das sind zwei komische Kauze."
                                            },
                                            {
                                                "example_id": "c87abc3d-5652-48ec-810f-52c667dbbbd3",
                                                "sense_id": "1cc409de-c493-3328-b5ed-0edeea6254bb",
                                                "text": "„Der Kauz empfahl sich Teresa; sie meinte, ich hätte recht getan.“"
                                            },
                                            {
                                                "example_id": "a6e2ce62-2fa2-41ce-8917-33a1e2e7b5eb",
                                                "sense_id": "1cc409de-c493-3328-b5ed-0edeea6254bb",
                                                "text": "„Aber der dürre lange Tote war Morten Sise, der Kapitän selber, und da er zeit seines Lebens ein sonderbarer Kauz gewesen war, wollte er auch jetzt im Meere bleiben, wo es ihm immer am besten gefallen hatte, und wie sehr man auch mit Stangen und Widerhaken an ihm zerrte, er gab nicht nach.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
