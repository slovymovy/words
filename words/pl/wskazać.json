    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "167b4182-13ca-3841-9eb1-efd38ab604b8",
                    "sense_definition": "pokazać coś lub kogoś za pomocą gestu, na przykład palcem lub ręką",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "pokazywanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przewodnik wyciągnął rękę i <w>wskazał</w> na szczyt góry.",
                            "target_lang_translations": {
                                "ru": "Гид вытянул руку и <w>указал</w> на вершину горы."
                            }
                        },
                        {
                            "text": "Chłopiec <w>wskazał</w> palcem zabawkę, którą chciał dostać na urodziny.",
                            "target_lang_translations": {
                                "ru": "Мальчик <w>показал</w> пальцем на игрушку, которую хотел получить на день рождения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wskazać palcem",
                        "wskazać ręką",
                        "wskazać na kogoś",
                        "wskazać na coś"
                    ],
                    "target_lang_definitions": {
                        "ru": "показать на кого-либо или что-либо жестом, например, пальцем или рукой"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "указать",
                                "target_lang_sense_clarification": "жестом, пальцем или рукой"
                            },
                            {
                                "target_lang_word": "показать",
                                "target_lang_sense_clarification": "направить взгляд жестом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e67e380-0127-3b7a-89ff-0c747a7b1511",
                    "sense_definition": "określić lub pokazać drogę, położenie albo miejsce znajdowania się czegoś",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "pokazywanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mężczyzna uprzejmie <w>wskazał</w> drogę zagubionym turystom w centrum miasta.",
                            "target_lang_translations": {
                                "ru": "Мужчина вежливо <w>указал</w> дорогу заблудившимся туристам в центре города."
                            }
                        },
                        {
                            "text": "Czy możesz mi <w>wskazać</w>, gdzie znajduje się najbliższa apteka?",
                            "target_lang_translations": {
                                "ru": "Ты не мог бы мне <w>показать</w>, где находится ближайшая аптека?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wskazać drogę",
                        "wskazać kierunek"
                    ],
                    "target_lang_definitions": {
                        "ru": "объяснить или показать дорогу, направление либо местоположение чего-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "указать",
                                "target_lang_sense_clarification": "дорогу или направление"
                            },
                            {
                                "target_lang_word": "показать",
                                "target_lang_sense_clarification": "маршрут, дорогу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab66e2e1-cb22-3cb0-825b-e45472c466c6",
                    "sense_definition": "o przyrządach i urządzeniach pomiarowych: podać określoną wielkość, wartość lub poziom",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pomiary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Termometr za oknem <w>wskazał</w> dzisiaj rano piętnaście stopni poniżej zera.",
                            "target_lang_translations": {
                                "ru": "Термометр за окном сегодня утром <w>показал</w> пятнадцать градусов ниже нуля."
                            }
                        },
                        {
                            "text": "Waga w kuchni <w>wskazała</w> dokładną ilość mąki potrzebną do ciasta.",
                            "target_lang_translations": {
                                "ru": "Кухонные весы <w>показали</w> точное количество муки, необходимое для теста."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wskazać temperaturę",
                        "wskazać wynik",
                        "wskazać wartość"
                    ],
                    "target_lang_definitions": {
                        "ru": "о приборах и датчиках: показать определённое значение, величину или уровень"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "показать",
                                "target_lang_sense_clarification": "о приборе, измерении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4f7f319-4782-370b-9f52-73bb0393d939",
                    "sense_definition": "dokonać wyboru lub jednoznacznie określić jedną osobę albo rzecz spośród wielu",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "wybor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Świadek bez wahania <w>wskazał</w> podejrzanego podczas policyjnego okazania.",
                            "target_lang_translations": {
                                "ru": "Свидетель без колебаний <w>указал на</w> подозреваемого во время полицейского опознания."
                            }
                        },
                        {
                            "text": "Komisja <w>wskazała</w> kandydata, który najlepiej poradził sobie z zadaniem rekrutacyjnym.",
                            "target_lang_translations": {
                                "ru": "Комиссия <w>выбрала</w> кандидата, который лучше всех справился с заданием отбора."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wskazać kandydata",
                        "wskazać winnego"
                    ],
                    "target_lang_definitions": {
                        "ru": "выбрать или точно определить одного человека или предмет из ряда других"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "указать",
                                "target_lang_sense_clarification": "на кандидата, виновного"
                            },
                            {
                                "target_lang_word": "назвать",
                                "target_lang_sense_clarification": "выделить, обозначить кого-либо"
                            },
                            {
                                "target_lang_word": "определить",
                                "target_lang_sense_clarification": "сделать выбор в пользу кого-либо"
                            }
                        ]
