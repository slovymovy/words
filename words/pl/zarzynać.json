                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "wyczerpanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pracując po dwanaście godzin dziennie, <w>zarzynasz</w> się bez sensu.",
