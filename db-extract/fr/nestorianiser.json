                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f016ec4-04da-4620-b346-b1af54ab1078",
                                "sense_id": "1fce0631-d828-347e-ab60-e825d93520a5",
                                "text": "Leurs élèves ne tardèrent pas à occuper les sièges épiscopaux et travaillèrent à « nestorianiser » l’Eglise d’Orient."
                            },
                            {
                                "example_id": "938b011e-150e-4520-b11e-61cd3954d305",
                                "sense_id": "1fce0631-d828-347e-ab60-e825d93520a5",
                                "text": "C’étaient eux qui accusaient les iconodoules de nestorianiser en isolant dans une image la nature humaine du Christ."
                            }
                        ]
