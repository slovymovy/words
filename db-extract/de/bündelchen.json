                ],
                "senses": [
                    {
                        "sense_id": "7d4c6f99-9a8d-3e99-8b86-92e200252e7c",
                        "entry_id": "01f66bf8-2f73-327c-adfd-6c4495743077",
                        "glosses": [
                            "kleines Bündel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ca053c5-cfc5-4c13-a982-f0a22cfa6f47",
                                "sense_id": "7d4c6f99-9a8d-3e99-8b86-92e200252e7c",
                                "text": "„Dazu ist die Frau wie ein Bündelchen Stroh; man glaubt, der Wind könne sie wegwehen.“"
                            },
                            {
                                "example_id": "d5b03416-7625-478e-ad6b-213ce47046c0",
                                "sense_id": "7d4c6f99-9a8d-3e99-8b86-92e200252e7c",
                                "text": "„Ich dachte an das Bündelchen Papiere auf dem Boden des Handkoffers, an jenes vertrackte Märchen, das mich, wie lang war das alles her, an einem traurigen Abend benommen hatte.“"
                            },
                            {
                                "example_id": "aa3215d8-0557-4132-90dd-dcd94910238a",
                                "sense_id": "7d4c6f99-9a8d-3e99-8b86-92e200252e7c",
                                "text": "„Mutter packte zu einem Bündelchen, was bei der Hand war, und dann gingen wir die Treppe hinunter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
