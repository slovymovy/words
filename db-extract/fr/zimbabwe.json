                    {
                        "sense_id": "11cc9bb8-fb52-3518-b344-61aa9d99b8fc",
                        "entry_id": "b104c1d1-f5f0-325a-9f78-1a063562209f",
                        "glosses": [
                            "Pays situé dans le sud de l’Afrique, entouré par l’Afrique du Sud, le Botswana, la Zambie et le Mozambique. Sa capitale est Harare."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": [
                            {
                                "example_id": "909311da-970d-4e92-9ac6-5f2d8774a73a",
                                "sense_id": "11cc9bb8-fb52-3518-b344-61aa9d99b8fc",
                                "text": "... il leur expliquait comment on jouait de la mbira, un lamellophone à touches en métal monté sur une calebasse, typique de son pays, le Zimbabwe."
                            },
                            {
                                "example_id": "6cc8eda4-32af-49a3-8828-d7e2c97b7d5a",
                                "sense_id": "11cc9bb8-fb52-3518-b344-61aa9d99b8fc",
                                "text": "Ce mardi 21 mai, huit personnes, venant de France, mais aussi d’Australie, du Pakistan ou encore du Zimbabwe et se qualifiant de « survivants et victimes du changement climatique », ainsi que deux associations françaises (Bloom et Alliance Santé planétaire) et une mexicaine (Nuestro Futuro) ont annoncé avoir déposé une plainte contre X auprès du tribunal judiciaire de Paris."
                            }
                        ]
                    },
                    {
                        "sense_id": "a1ce7930-1655-3772-a6e1-6256546b1f0f",
                        "entry_id": "b104c1d1-f5f0-325a-9f78-1a063562209f",
                        "glosses": [
                            "Ancienne cité d’Afrique méridionale, située à une quinzaine de kilomètres au sud de la ville de Masvingo, dans le sud du Zimbabwe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6f180d4-7d02-4d0a-93b7-b9d5ba24430f",
                                "sense_id": "a1ce7930-1655-3772-a6e1-6256546b1f0f",
                                "text": "Les ruines de Zimbabwe sont réputées."
                            }
                        ]
                    }
                ],
                "translations": [
