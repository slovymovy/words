                                    {
                                        "sense_id": "bcbc9d64-f863-3389-ba3e-42c50951ead3",
                                        "entry_id": "b36241f6-1923-3394-9cac-71ab33ac74e5",
                                        "glosses": [
                                            "Surgically rendered sterile (e.g. spayed, neutered, or castrated)."
                                        ],
