        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b444b27e-5bc2-393f-9407-d0ca31a37dae",
                    "sense_definition": "Schneller Zwischenspeicher eines Computersystems, in dem Daten temporär abgelegt werden, um Zugriffszeiten zu verkürzen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "computer_storage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Internetbrowser speichert Bilder im <w>Cache</w>, um wiederholte Ladezeiten spürbar zu verringern."
                        },
                        {
                            "text": "Wenn eine Webseite veraltete Inhalte anzeigt, hilft es oft, den <w>Cache</w> vollständig zu leeren."
                        }
                    ],
                    "synonyms": [
                        "Zwischenspeicher",
                        "Pufferspeicher"
                    ],
                    "common_phrases": [
                        "den Cache leeren",
                        "im Cache speichern"
                    ]
                },
                {
                    "sense_id": "f79efa99-3529-3aba-8cc1-076ad9124866",
                    "sense_definition": "Versteckter, wasserdichter Behälter mit Logbuch und Tauschgegenständen, der beim Geocaching anhand von GPS-Koordinaten gesucht wird",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geocaching",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mithilfe der Koordinaten auf dem GPS-Gerät konnten wir den gut versteckten <w>Cache</w> im Wald aufspüren."
                        },
                        {
                            "text": "Nachdem wir das Logbuch signiert hatten, legten wir den kleinen <w>Cache</w> vorsichtig an seinen Platz zurück."
                        }
                    ],
                    "synonyms": [
                        "Geocache"
                    ],
                    "common_phrases": [
                        "einen Cache finden",
                        "einen Cache verstecken"
                    ]
                }
            ]
        },
