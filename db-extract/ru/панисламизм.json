                                            {
                                                "example_id": "e5b09c5e-199c-4ff8-a958-981e5b5faf42",
                                                "sense_id": "1baf02d3-6708-3911-9788-ccf3ea361070",
                                                "text": "„Obwohl er die Vorstellungen des damals populären Panislamismus nutzte, um sich die Unterstützung der religiösen Elite zu sichern, obsiegte während seiner Regierung letztlich die Realpolitik.“"
                                            }
