                    },
                    {
                        "translation_id": "e7189f96-7659-4e65-b86f-cef85fa0e06d",
                        "source_entry_id": "046f3113-a1d8-3b61-b9af-012dde80ea8e",
                        "source_sense_id": "dc3fcf4d-33ee-3103-92d6-2103f15d15ef",
                        "target_lang_word": "Lichtung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lichtung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "71615e3e-0e82-38bb-8083-5a9fa377644e",
                                        "entry_id": "63192385-c86c-32cd-9575-d7f03f4b55f3",
                                        "glosses": [
                                            "eine nicht mit Bäumen bewachsene Fläche in einem Wald"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa365447-0ee6-47e6-ab1a-b4372c5cc1cb",
                                                "sense_id": "71615e3e-0e82-38bb-8083-5a9fa377644e",
                                                "text": "Als sie die Lichtung betrat, wurde sie sofort von der Sonne geblendet."
                                            },
                                            {
                                                "example_id": "76dcad85-c71b-4f74-b413-a42e3fb848a7",
                                                "sense_id": "71615e3e-0e82-38bb-8083-5a9fa377644e",
                                                "text": "„Nachdem ich so die wertvollen Papiere sicher verwahrt hatte, rannte ich über die Lichtung weiter auf eine Stelle zu, wo ein Pfad abzugehen schien.“"
                                            },
                                            {
                                                "example_id": "1572cf64-3ef5-4120-92ac-a4fe58c7f338",
                                                "sense_id": "71615e3e-0e82-38bb-8083-5a9fa377644e",
                                                "text": "„Der Höhepunkt wurde von mehreren kleinen, separat stehenden Wäldern eingerahmt, die in ihrer Mitte eine Lichtung frei ließen, von der aus man die gesamte Umgebung überblicken konnte.“"
                                            },
                                            {
                                                "example_id": "fb0a90f8-7ba1-44a4-a108-4bd7f84597d3",
                                                "sense_id": "71615e3e-0e82-38bb-8083-5a9fa377644e",
                                                "text": "„Zwei Werst weit ritt man durch den Wald, dann gelangte man auf eine Lichtung.“"
                                            },
                                            {
                                                "example_id": "5ebe3b05-a5ef-44da-b874-87579f5e43bb",
                                                "sense_id": "71615e3e-0e82-38bb-8083-5a9fa377644e",
                                                "text": "„An manchen Tagen bekamst du das Land so gut hin, dass du zwischen den Holzstapeln hindurch auf die Lichtung und die Anhöhe gelangtest und die Hügel jenseits des Seitenarms des Sees sehen konntest.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cdef1d67-76e3-4805-92a2-eb7a1812ed5f",
                        "source_entry_id": "046f3113-a1d8-3b61-b9af-012dde80ea8e",
                        "source_sense_id": "dc3fcf4d-33ee-3103-92d6-2103f15d15ef",
                        "target_lang_word": "Waldwiese",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Waldwiese",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ff976801-a68d-3997-b4d6-1887a176457e",
                                        "entry_id": "cc900f7c-0bf8-323c-9626-90f045f449b8",
                                        "glosses": [
                                            "von Wald umgebene Wiese"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16934945-f5a0-4a9c-87fb-f91e6aedafe3",
                                                "sense_id": "ff976801-a68d-3997-b4d6-1887a176457e",
                                                "text": "„Er legte sich auf eine Waldwiese und genoss das Nichtstun.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
