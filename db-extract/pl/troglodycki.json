                        "translation_id": "f113275d-105b-4dd8-a948-c6cb38cc9599",
                        "source_entry_id": "9c026842-4b0d-3c8b-a0ac-d5591261deea",
                        "source_sense_id": "2ba211a8-ba3e-3a8e-b314-876e31fab3a1",
                        "target_lang_word": "troglodytic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "troglodytic",
