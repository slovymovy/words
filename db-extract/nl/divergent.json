                                            {
                                                "example_id": "d125fd95-8052-49e5-a4af-53c8843a00f4",
                                                "sense_id": "db21bd19-5b44-3b46-95a9-9b48a5986d22",
                                                "text": "„Bei divergenten Plattengrenzen driften die Platten auseinander und es formt sich neue Kruste.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1bfb068b-3e55-3211-96bb-cc5e9e7a71d2",
                                        "entry_id": "d6d39de1-05fc-3189-92dd-c436ce6d1389",
                                        "glosses": [
                                            "keinen Grenzwert aufweisend"
                                        ],
                                        "tags": [
                                            "Mathematik; keine Steigerung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a937b9e3-6c74-4356-b225-50bfe8c589f7",
                                                "sense_id": "1bfb068b-3e55-3211-96bb-cc5e9e7a71d2",
                                                "text": "„Wenn Folgen monoton sein müssen, um konvergent zu sein, dann sind alternierende Folgen (wie die oben) divergent.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
