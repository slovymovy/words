                "senses": [
                    {
                        "sense_id": "95fec8ff-54a5-3c52-9126-7738ffe91814",
                        "entry_id": "e0768528-f578-3559-b3c4-80e4f39aa7dd",
                        "glosses": [
                            "техн., фотогр. лампа из красноватого стекла, освещением которой пользуются при обработке фотографий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6020062b-f984-4b04-b287-ddfd470e73c7",
                                "sense_id": "95fec8ff-54a5-3c52-9126-7738ffe91814",
                                "text": "Сначала они ничего не заметили, поскольку надпись была красной. Красная фотолампа, служившая основным источником света, скрадывала очертания букв."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce602799-816e-4d45-8f10-52e2238cbcde",
                        "source_entry_id": "e0768528-f578-3559-b3c4-80e4f39aa7dd",
                        "source_sense_id": "95fec8ff-54a5-3c52-9126-7738ffe91814",
                        "target_lang_word": "photo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "photo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ea362c1-0094-3949-814e-6fb7f0948fc2",
                                        "entry_id": "e1aadd69-c413-3f5e-9706-e98b50a0522f",
                                        "glosses": [
                                            "A photograph."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c53d473-ca8e-41dc-a348-028ad947b9ac",
                                                "sense_id": "4ea362c1-0094-3949-814e-6fb7f0948fc2",
                                                "text": "Not long ago, it was difficult to produce photographs of tiny creatures with every part in focus. That’s because the lenses that are excellent at magnifying tiny subjects produce a narrow depth of field. A photo processing technique called focus stacking has changed that."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2f39434-84f3-34a1-820c-58781a653bcd",
                                        "entry_id": "e1aadd69-c413-3f5e-9706-e98b50a0522f",
                                        "glosses": [
                                            "A photo finish."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd00091c-efc3-4c5f-93a3-d9d2f7be3106",
                                                "sense_id": "b2f39434-84f3-34a1-820c-58781a653bcd",
                                                "text": "By this stage, Goof was clearly warming to his theme and, as they flashed past the post together, he reported that it was a photo. \"And I don't know or care who won the photo,\" he concluded."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c762c030-a3e4-3ee8-b249-736fb599a975",
                                        "entry_id": "e1aadd69-c413-3f5e-9706-e98b50a0522f",
                                        "glosses": [
                                            "A digital picture of any kind."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5df59987-cdc0-39d3-ae61-1a0ecf05437e",
                                        "entry_id": "e1aadd69-c413-3f5e-9706-e98b50a0522f",
                                        "glosses": [
                                            "Photography"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ebc4697-2990-43e1-b060-4ad91fd0f724",
                                                "sense_id": "5df59987-cdc0-39d3-ae61-1a0ecf05437e",
                                                "text": "Photo student in need of subjects."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "photo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04ef4d11-4775-3296-a2e3-975026ddcb16",
                                        "entry_id": "1b7d0747-72d5-346c-9822-74e57bbf82c6",
                                        "glosses": [
                                            "To take a photograph of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "532ea76e-73b7-47a0-8493-e9480a99229d",
                                                "sense_id": "04ef4d11-4775-3296-a2e3-975026ddcb16",
                                                "text": "[1956] 1992 ed., The Complete Lyrics of Cole Porter http://print.google.com/print?hl=en&id=5kjheskJwVAC&pg=PA465&lpg=PA465&sig=_CY8N5ZLStxnOIlf_CNHhhBEPjA\nWhat fun to be photoed together, / What luck for a break so opportune. / Oh, what a lark / To be posed in the park / Underneath the adolescent crescent of the moon."
                                            },
                                            {
                                                "example_id": "060b2a32-37cc-4602-895f-df34fbdded63",
                                                "sense_id": "04ef4d11-4775-3296-a2e3-975026ddcb16",
                                                "text": "1998, Hans Schmidt, Maverick Marine http://print.google.com/print?hl=en&id=vQ7DKhq0ZckC&pg=PA192&lpg=PA192&sig=hrMAoHDI9vAnq4RQwgFro_Lp24M\nHe even had himself photoed helping to hold one of the fire-hose."
                                            },
                                            {
                                                "example_id": "77a176b5-f098-4f17-9aa3-2f8681ae0adf",
                                                "sense_id": "04ef4d11-4775-3296-a2e3-975026ddcb16",
                                                "text": "Always photoing exits. What are all these ways out but rehearsals for his own?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
