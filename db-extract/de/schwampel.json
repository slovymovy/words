                        "sense_id": "c36d2850-f7b7-3d8f-8510-a3bea450a7dc",
                        "entry_id": "73b857ae-b588-3d1c-ac0b-72fc108c7128",
                        "glosses": [
                            "Schwarz-Gelb-Grüne Koalition"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "af4adcbc-9ce9-4618-a1f7-dadb993e9d55",
                                "sense_id": "c36d2850-f7b7-3d8f-8510-a3bea450a7dc",
                                "text": "„Wir gehen in keine Ampel, Schwampel und andere Hampeleien sind mit uns nicht zu machen.“ (Guido Westerwelle, FDP)"
                            },
                            {
                                "example_id": "a4e0e552-b1bb-4f0f-aade-d667efbc24a7",
                                "sense_id": "c36d2850-f7b7-3d8f-8510-a3bea450a7dc",
                                "text": "„[…] und die Grünen wiederum mit der Schwampel (schwarze Ampel oder JamaikaKoalition = CDU/CSU, FDP und Grüne) nichts anfangen konnten, lief alles auf eine Große Koalition von Union und SPD hinaus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
