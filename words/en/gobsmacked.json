                    "sense_id": "423ed349-fea2-3bdb-89dd-3794378b694b",
                    "sense_definition": "Extremely surprised, shocked, or astounded, often to the point of being speechless.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was utterly <w>gobsmacked</w> when they announced that I had won the grand prize.",
                            "target_lang_translations": {
                                "tr": "Büyük ödülü kazandığımı açıkladıklarında <w>ağzım açık kaldı</w>."
                            }
                        },
                        {
                            "text": "Everyone was left completely <w>gobsmacked</w> by the sudden news of his resignation.",
                            "target_lang_translations": {
                                "tr": "İstifasının ani haberi karşısında herkes tamamen <w>donakaldı</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "astonished",
                        "astounded",
                        "flabbergasted",
                        "speechless",
                        "stunned"
                    ],
                    "antonyms": [
                        "unimpressed",
                        "unmoved",
                        "unfazed"
                    ],
                    "common_phrases": [
                        "absolutely gobsmacked",
                        "utterly gobsmacked",
                        "completely gobsmacked"
                    ],
