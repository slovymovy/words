                        "examples": [
                            {
                                "example_id": "0fe7be16-d811-408b-b5f4-d1bc835cf43e",
                                "sense_id": "defafa3e-1c43-34d6-9c1a-427e860a383f",
                                "text": "Хорошее впечатление оставил польский гобоист, живущий в Германии, Казимеж Давидек, сыгравший яркую и самобытную программу из современных польских сочинений для гобоя соло, среди которых особенно выделилось сочинение Кристины Мошумански-Назар «Серпентин»."
                            }
                        ]
                    }
