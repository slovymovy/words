                    {
                        "sense_id": "fa468e9f-e108-340e-94c1-c3c86bf062a8",
                        "entry_id": "f4e56272-a6fd-3d7a-b709-99d0a73e4f65",
                        "glosses": [
                            "Absolvent einer Schule"
                        ],
                        "tags": [
                            "nur Plural 1"
                        ],
                        "examples": [
                            {
                                "example_id": "4ffa4c1a-f4ed-4330-ae31-b7e1e9645754",
                                "sense_id": "fa468e9f-e108-340e-94c1-c3c86bf062a8",
                                "text": "Der FU-Berlin Alumnus Karl Kasper war weniger erfolgreich als Einstein."
                            },
                            {
                                "example_id": "844d2a72-25ac-4f75-8059-aec3f8a8d26f",
                                "sense_id": "fa468e9f-e108-340e-94c1-c3c86bf062a8",
                                "text": "„Stolz verweist Frenkel darauf, dass sich mehr als 90 Prozent der Alumni an der Hochschule engagieren.“"
                            },
                            {
                                "example_id": "b7c00a0d-b7f8-4415-85ca-6d46eaa35986",
                                "sense_id": "fa468e9f-e108-340e-94c1-c3c86bf062a8",
                                "text": "„Zu den Alumni zählten Indigene aus allen Landesteilen wie die Ute-Angehörige Joan Noble und die Tuscarora Karen Rickard, der Navajo Herb Blatchford und der Ponca Clyde Warrior – allesamt wurden sie zu NIYC-Gründern.“"
                            }
                        ],
