                ],
                "senses": [
                    {
                        "sense_id": "a800aefa-da30-3777-93ce-6b2e559eb365",
                        "entry_id": "5e2d557b-6305-3833-a098-b313c58bd7bd",
                        "glosses": [
                            "Wiederbelebungsmaßnahme, bestehend aus wiederholten Thoraxkompressionen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2a1b12a-40c3-49d0-a55b-a0d3fd461ec9",
                                "sense_id": "a800aefa-da30-3777-93ce-6b2e559eb365",
                                "text": "„Als Tricia Gedding und die Schulschwester ihn auf seiner Liege fanden, dachten sie im ersten Moment, Griffin Wilson wäre die Reanimationspuppe, an der immer die Herzdruckmassage geübt wurde.“"
                            },
                            {
                                "example_id": "608db1c9-51a8-4776-a3b1-6c0083f504fb",
                                "sense_id": "a800aefa-da30-3777-93ce-6b2e559eb365",
                                "text": "„Digger begann mit einer Herzdruckmassage bei Slapshot.“"
                            },
                            {
                                "example_id": "331512e7-d3d5-4e80-9db0-11de21fdfe2d",
                                "sense_id": "a800aefa-da30-3777-93ce-6b2e559eb365",
                                "text": "„»Selbst wenn es bei der Herzdruckmassage knacken sollte, weil eine Rippe bricht: besser als bleibende Schäden davonzutragen oder zu sterben, ist das allemal.«“"
                            },
                            {
                                "example_id": "6253f8bd-7913-4c60-8b2d-6b37e76b848f",
                                "sense_id": "a800aefa-da30-3777-93ce-6b2e559eb365",
                                "text": "„»Legen Sie [die bewusstlose Person] auf einen harten Untergrund, machen Sie die Brust frei und beginnen Sie sofort mit der Herzdruckmassage.«“"
                            },
                            {
                                "example_id": "e4d33d3b-7fe7-4a8e-acae-1c8a86f2817d",
                                "sense_id": "a800aefa-da30-3777-93ce-6b2e559eb365",
                                "text": "„»[Es ist] immens wichtig, dass wirklich jeder in der Lage ist eine Herzdruckmassage durchzuführen – und so früh wie möglich lernt, wie das geht.«“"
                            },
                            {
                                "example_id": "c26e86b7-67e0-4e28-8182-fafbfef7a909",
                                "sense_id": "a800aefa-da30-3777-93ce-6b2e559eb365",
                                "text": "„»Kinder ab dem Grundschulalter sind körperlich in der Lage dazu, eine Herzdruckmassage durchzuführen.«“"
                            },
                            {
                                "example_id": "17e1bfbd-da1f-417f-9d88-815a89b6b024",
                                "sense_id": "a800aefa-da30-3777-93ce-6b2e559eb365",
                                "text": "„»Leider sterben noch zu viele Menschen in stabiler Seitenlage, weil die Herzdruckmassage vergessen wird. Die ist aber bei einem Herzstillstand das einzig Entscheidene. Alles andere ist zweitrangig.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
