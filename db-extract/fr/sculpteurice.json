                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "87bcdfe4-5cb2-4a20-bacd-f0278cca0dc3",
                                "sense_id": "36887063-b6ff-3261-83b7-3c2a8c7a5f95",
                                "text": "Bonjour à tous,J'avais vu il y a quelques temps une publication d'une personne à la recherche d'un/e sculpteurice de frigolite."
                            },
                            {
                                "example_id": "b3027700-dd67-4e13-913f-c668ee0dc648",
                                "sense_id": "36887063-b6ff-3261-83b7-3c2a8c7a5f95",
                                "text": "Après il y a des métiers : peintre, graphiste, photographe, sculpteurice, architecte, auteurice..."
                            }
                        ]
