                },
                {
                    "sense_id": "86df25f4-08b0-39bb-8d17-f153ef3c4042",
                    "sense_definition": "Manifestation spontanée et chaleureuse de ses sentiments intimes ; effusion affectueuse.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
