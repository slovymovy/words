                                "target_word": "Trompetervogel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "98313f26-dde1-322b-85c2-c7eb150611dd",
                                        "entry_id": "2a7e3685-85c6-3172-b588-a55619d378e1",
                                        "glosses": [
                                            "größerer Vogel mit schwarzem und grauem Gefieder, der in Südamerika heimisch ist und einen dumpfen Schrei von sich gibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ae8cae8-d51b-4ffa-b6d5-13404e17f876",
                                                "sense_id": "98313f26-dde1-322b-85c2-c7eb150611dd",
                                                "text": "Besonders bemerkenswert ist der Gesang der Trompetervögel. Er besteht aus einem tiefen melodischen Gebrumm oder Trommeln, das wie »uh uh uh« klingt, wobei das letzte »uh« lang und tief herabgezogen ist."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
