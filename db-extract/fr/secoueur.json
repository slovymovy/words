                            {
                                "example_id": "ec372914-0f16-4a48-8c3d-3194068b6821",
                                "sense_id": "70fbff54-1f0d-39f1-9d06-b750a1d58ce4",
                                "text": "Mécaniser la production des pêches à l’aide d’un secoueur d’arbres."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ab8938e-86e9-37ce-bcd6-d6a7b85316f1",
                        "entry_id": "d27022fc-31f5-3795-964c-46c9462d3b0c",
                        "glosses": [
                            "Lors du battage de la moisson, celui qui est affecté au démontage des paillers et à la préparation des gerbes."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "a561da02-5efa-4440-83bf-db50564959b1",
                                "sense_id": "3ab8938e-86e9-37ce-bcd6-d6a7b85316f1",
                                "text": "Pour monter la paille il y avait sept ou huit gaillards glorieux de leur force. Les secoueurs leur préparaient d’énormes fourchées ; quand ils avaient piqué là-dedans et redressé leur outil, ils disparaissaient complètement et la paille avait l’air de monter toute seule, lentement, le long des hautes échelles."
                            }
                        ]
