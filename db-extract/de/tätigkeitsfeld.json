                ],
                "senses": [
                    {
                        "sense_id": "418e0071-4833-3fc3-8776-2f9fff109e03",
                        "entry_id": "999d5670-4f23-35c9-aaf3-3a537d51b5d2",
                        "glosses": [
                            "fachliches Gebiet, auf dem jemand arbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3086af28-6624-4454-8f53-d16d1e22abd8",
                                "sense_id": "418e0071-4833-3fc3-8776-2f9fff109e03",
                                "text": "„Oberstaatsanwalt Rainer Schilling, vom 1. Oktober an Pressesprecher der Staatsanwaltschaft Frankfurt, ist kein Neuling in diesem Tätigkeitsfeld der Strafverfolgungs- und Anklagebehörde.“"
                            },
                            {
                                "example_id": "bac12967-5026-4bfc-9db3-741f8c5bcb96",
                                "sense_id": "418e0071-4833-3fc3-8776-2f9fff109e03",
                                "text": "„Finanzkommunikation ist längst ein etabliertes Tätigkeitsfeld in den Unternehmen.“"
                            },
                            {
                                "example_id": "71c82d86-c49e-4826-8190-2d42186ba47e",
                                "sense_id": "418e0071-4833-3fc3-8776-2f9fff109e03",
                                "text": "„Als Straub das Unternehmen in den neunziger Jahren übernommen hatte, suchte er das Tätigkeitsfeld der Werkstätten zu erweitern.“"
                            },
                            {
                                "example_id": "affdb91a-73f6-4cec-92f9-6c02558c7f15",
                                "sense_id": "418e0071-4833-3fc3-8776-2f9fff109e03",
                                "text": "„Nicht nur die Gesundheitswirtschaft boomt, auch in der Industrie entstehen ganz neue Tätigkeitsfelder für Biologen.“"
                            },
                            {
                                "example_id": "5dfef9e4-0e2c-44a8-a7de-942aa971b02c",
                                "sense_id": "418e0071-4833-3fc3-8776-2f9fff109e03",
                                "text": "„Die fortschreitende Digitalisierung verändert die Anforderungen an die Beschäftigten und schafft neben der klassischen Tätigkeit in der Bankfiliale eine Vielzahl neuer Tätigkeitsfelder für alle Vertriebswege im Bankgeschäft.“"
                            },
                            {
                                "example_id": "706673ce-8483-4acd-942f-e7e718b1a9aa",
                                "sense_id": "418e0071-4833-3fc3-8776-2f9fff109e03",
                                "text": "„Der Abschluß erst wendet sich dem besonderen Anlaß der Rede zu, der Verabschiedung des Gouverneurs, damit er hinausgehe, um mitzuwirken an der alle verpflichtenden, imperialen Aufgabe in seinem neuen Tätigkeitsfelde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
