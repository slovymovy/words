                                "sense_id": "da1079d2-2a74-347e-88bd-4ce60818d181",
                                "text": "Is the train station walkable from here?"
                            },
                            {
                                "example_id": "272dc0cd-56aa-475a-bc10-66a15cb4e7db",
                                "sense_id": "da1079d2-2a74-347e-88bd-4ce60818d181",
                                "text": "Just outside the city centre, briskly walkable and even more briskly busable from the main City site, Charlie Frears has his own medical library and teaching facilities[…]"
                            }
                        ]
                    }
