                            {
                                "example_id": "7f4b346a-d4db-4b76-b733-bbf01d0f9b55",
                                "sense_id": "0ffe8c2c-0976-3ee0-9dc2-b4ac8c6c0bc5",
                                "text": "Het perifeer zenuwstelsel is het zenuwstelsel dat buiten het centrale zenuwstelse ligt."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f0016fd-4f8a-30c0-ba7a-b661c7ea5876",
                        "entry_id": "20aee643-de29-36cc-a99c-e7bb67cce232",
                        "glosses": [
                            "aan de rand van iets (i.h.b. van een stad) gelegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e780e85f-8570-448b-bb90-734849a9d3fb",
                                "sense_id": "7f0016fd-4f8a-30c0-ba7a-b661c7ea5876",
                                "text": "Een perifere buurt."
                            }
                        ]
                    },
                    {
                        "sense_id": "a745412f-a725-3f44-80d8-c3d58cf636ca",
                        "entry_id": "20aee643-de29-36cc-a99c-e7bb67cce232",
                        "glosses": [
                            "niet tot de vaste kern behorend, slechts zijdelings ergens deel van uitmakend"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "7241d501-44a1-4659-9d08-6ce584cfdf9f",
                                "sense_id": "a745412f-a725-3f44-80d8-c3d58cf636ca",
                                "text": "Perifere woordenschat."
                            }
                        ]
                    },
                    {
                        "sense_id": "02a5956a-f6e4-32d7-938a-71b51ab92f7a",
                        "entry_id": "20aee643-de29-36cc-a99c-e7bb67cce232",
                        "glosses": [
                            "niet erg ter zake doend, marginaal"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b55c9d46-d3b4-46f0-ab97-90b01ab02db6",
                                "sense_id": "02a5956a-f6e4-32d7-938a-71b51ab92f7a",
                                "text": "De bijeenzameling acht het driftmatige niet te onrein, het zinnelijke niet te perifeer, het emotionele niet te vluchtig,..."
                            }
                        ]
