                                        "sense_id": "5a1087ed-62a0-3673-8d09-4231b5e370d3",
                                        "entry_id": "534b800c-3cec-3159-9219-e79caab91b26",
                                        "glosses": [
                                            "The condition of being vindictive; a malevolent desire for revenge."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "962658de-06f3-4b20-a493-bf34e76e2249",
                                                "sense_id": "5a1087ed-62a0-3673-8d09-4231b5e370d3",
                                                "text": "Lord Avonleigh was an angry rather than a vindictive man. Vindictiveness requires more energy of character than he possessed. Indeed, it may be questioned whether he would of himself have taken the violent measures of the preceding evening."
                                            }
                                        ]
                                    }
                                ]
