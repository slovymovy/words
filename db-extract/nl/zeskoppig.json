                            {
                                "example_id": "3f1e4b32-b535-4642-94d9-9207f19d3d2f",
                                "sense_id": "92bf1cb6-ceeb-3e64-842d-165b230a8fb2",
                                "text": "Na allerlei inspraakrondes, toelichtingen en toetsingen heeft een zeskoppig panel van deskundigen met daarin onder anderenoud-wethouder Willem Smink van Groningen, stadsbouwmeester Ton Schaap en gemeentelijk cultuurintendant Reyn van der Lugt, geadviseerd om te kiezen voor het ontwerp van de combinatie Van Wijnen/Ons Huis."
                            },
                            {
                                "example_id": "3f1df291-45cc-45ff-b6f7-4ea71b440648",
                                "sense_id": "92bf1cb6-ceeb-3e64-842d-165b230a8fb2",
                                "text": "De stichting heeft ook een compleet nieuw zeskoppig bestuur, onder voorzitterschap van Marcel Jansink."
                            }
                        ]
