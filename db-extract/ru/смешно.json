                "senses": [
                    {
                        "sense_id": "f72fffa7-2cf3-3f17-aee4-10c4a4a8e786",
                        "entry_id": "f02c5f8f-890f-3a92-9317-0565e49733f3",
                        "glosses": [
                            "in a funny manner/way, comically"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "69ff94e8-7b7d-3bab-9fe9-d8d65bc38e9c",
                        "entry_id": "f02c5f8f-890f-3a92-9317-0565e49733f3",
                        "glosses": [
                            "it is nice"
                        ],
                        "tags": [
                            "impersonal",
                            "predicative"
                        ],
                        "examples": [
                            {
                                "example_id": "148f1d79-38fb-46cc-b396-a5e8add9302c",
                                "sense_id": "69ff94e8-7b7d-3bab-9fe9-d8d65bc38e9c",
                                "text": "смешно́ смотре́ть на них",
                                "translation": "it makes one laugh to look at them",
                                "english": "it makes one laugh to look at them"
                            },
                            {
                                "example_id": "4c9da1d9-8e86-4051-a092-7a7edc2aaa03",
                                "sense_id": "69ff94e8-7b7d-3bab-9fe9-d8d65bc38e9c",
                                "text": "ему́ смешно́",
                                "translation": "it makes him laugh",
                                "english": "it makes him laugh"
                            },
                            {
                                "example_id": "86c7c184-b2f4-4fac-8cca-0c1e32325ca6",
                                "sense_id": "69ff94e8-7b7d-3bab-9fe9-d8d65bc38e9c",
                                "text": "вам смешно́?",
                                "translation": "do you find it funny?",
                                "english": "do you find it funny?"
                            },
                            {
                                "example_id": "74da8e60-1360-480f-8572-69e2137ef276",
                                "sense_id": "69ff94e8-7b7d-3bab-9fe9-d8d65bc38e9c",
                                "text": "как смешно́!",
                                "translation": "how funny!",
                                "english": "how funny!"
                            },
                            {
                                "example_id": "ba0be793-2de6-4a13-82d4-1f20f757f16e",
                                "sense_id": "69ff94e8-7b7d-3bab-9fe9-d8d65bc38e9c",
                                "text": "э́то про́сто смешно́!",
                                "translation": "it's simply ridiculous/absurd!",
                                "english": "it's simply ridiculous/absurd!"
                            },
                            {
                                "example_id": "c37453d9-fa75-4e9b-8578-0180e0684283",
                                "sense_id": "69ff94e8-7b7d-3bab-9fe9-d8d65bc38e9c",
                                "text": "э́то не смешно́",
                                "translation": "it isn't funny; there is nothing to laugh at",
                                "english": "it isn't funny; there is nothing to laugh at"
                            },
                            {
                                "example_id": "92216750-2a43-4fa9-9100-4d76f34ecf17",
                                "sense_id": "69ff94e8-7b7d-3bab-9fe9-d8d65bc38e9c",
                                "text": "смешно́ сказа́ть",
                                "translation": "ridiculously enough; ridiculous as it is",
                                "english": "ridiculously enough; ridiculous as it is"
                            }
                        ]
                    }
                ],
