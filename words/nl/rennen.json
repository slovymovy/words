            "senses": [
                {
                    "sense_id": "93ca0f04-feac-3db9-a056-be5b295a9d9e",
                    "sense_definition": "Zeer snel lopen; zich snel te voet verplaatsen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je hoeft niet te <w>rennen</w>, we hebben alle tijd.",
                            "target_lang_translations": {
                                "en": "You don't have to <w>run</w>, we have plenty of time.",
                                "ru": "Тебе не нужно <w>бежать</w>, у нас куча времени.",
                                "de": "Du brauchst nicht zu <w>rennen</w>, wir haben alle Zeit der Welt.",
                                "pl": "Nie musisz <w>biec</w>, mamy mnóstwo czasu.",
                                "fr": "Tu n'as pas besoin de <w>courir</w>, nous avons tout notre temps.",
                                "it": "Non c'è bisogno di <w>correre</w>, abbiamo tutto il tempo.",
                                "cs": "Nemusíš <w>utíkat</w>, máme spoustu času.",
                                "tr": "<w>Koşmana</w> gerek yok, bolca vaktimiz var.",
                                "es": "No hace falta que <w>corras</w>, tenemos todo el tiempo del mundo."
                            }
                        },
                        {
                            "text": "Ik ben heel snel naar huis <w>gerend</w> toen het begon te regenen.",
                            "target_lang_translations": {
                                "en": "I <w>ran</w> home very quickly when it started raining.",
                                "ru": "Я очень быстро <w>побежал</w> домой, когда начался дождь.",
                                "de": "Ich bin ganz schnell nach Hause <w>gerannt</w>, als es anfing zu regnen.",
                                "pl": "Bardzo szybko <w>pobiegłem</w> do domu, kiedy zaczęło padać.",
                                "fr": "J'ai <w>couru</w> très vite à la maison quand il a commencé à pleuvoir.",
                                "it": "Sono <w>corso</w> a casa molto velocemente quando ha iniziato a piovere.",
                                "cs": "Když začalo pršet, velmi rychle jsem <w>utíkal</w> domů.",
                                "tr": "Yağmur yağmaya başladığında eve çok hızlı <w>koştum</w>.",
                                "es": "<w>Corrí</w> a casa muy rápido cuando empezó a llover."
                            }
                        }
                    ],
                    "synonyms": [
                        "hardlopen",
                        "hollen"
                    ],
                    "antonyms": [
                        "wandelen",
                        "stilstaan"
                    ],
                    "common_phrases": [
                        "hard rennen",
                        "weg rennen",
                        "blijven rennen"
                    ],
                    "target_lang_definitions": {
                        "en": "To move very fast on foot; to run.",
                        "ru": "Очень быстро передвигаться пешком; бежать.",
                        "de": "Sich sehr schnell zu Fuß fortbewegen; rennen oder schnell laufen.",
                        "pl": "Poruszać się bardzo szybko na nogach; biec.",
                        "fr": "Se déplacer très rapidement à pied ; courir.",
                        "it": "Muoversi molto velocemente a piedi; correre.",
                        "cs": "Pohybovat se velmi rychle pěšky; běžet.",
                        "tr": "Yürüyerek çok hızlı hareket etmek; koşmak.",
                        "es": "Moverse muy rápido a pie; correr."
                    },
