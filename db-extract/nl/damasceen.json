                "translations": [
                    {
                        "translation_id": "b2f94ee1-e03f-4227-9a92-5b01635b854e",
                        "source_entry_id": "bb0eda9c-c788-3894-80dd-ab5c8d485e51",
                        "source_sense_id": "411ba378-f297-3131-b415-556d63b9bc49",
                        "source_sense_description": "een inwoner van Damascus",
                        "target_lang_word": "Damaszener",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Damaszener",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "617c065b-d7bd-31f1-980a-cd5d09255740",
                                        "entry_id": "59d9b572-05a3-374e-8be8-51b3e2e7f44c",
                                        "glosses": [
                                            "Damaskus und/oder dessen Einwohner betreffend, aus Damaskus und/oder von dessen Einwohnern stammend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed3ef924-7c72-4b3e-9e0a-453af938a6e5",
                                                "sense_id": "617c065b-d7bd-31f1-980a-cd5d09255740",
                                                "text": "„Die Damaszener Klingen der orientalischen Krieger lehrten schon die Kreuzritter das Fürchten - doch das Wissen um die Herstellung der enorm scharfen Waffen ging schon vor Jahrhunderten verloren.“"
                                            },
                                            {
                                                "example_id": "a622bc02-19f3-424d-9c42-343f48d3f6a2",
                                                "sense_id": "617c065b-d7bd-31f1-980a-cd5d09255740",
                                                "text": "„Ich bin in einer Gasse zur Welt gekommen, an deren Ende die Stelle der Damaszener Stadtmauer liegt, von der aus Apostel Paulus, alias Saulos, geflüchtet war.“"
                                            },
                                            {
                                                "example_id": "9548694f-da9a-4542-a01a-4f2d332fd440",
                                                "sense_id": "617c065b-d7bd-31f1-980a-cd5d09255740",
                                                "text": "„Busladungen von Schiiten aus Libanon und Iran fahren täglich in der Damaszener Altstadt vor, um den Schrein der Sayyda Ruqaya (einer Tochter Imam Husseins) aufzusuchen, in dessen kontinuierlichen Ausbau Iran seit Jahrzehnten investiert.“"
                                            },
                                            {
                                                "example_id": "6c6736dc-33eb-4b65-865a-dff8e4578b64",
                                                "sense_id": "617c065b-d7bd-31f1-980a-cd5d09255740",
                                                "text": "„Im Verlauf der Jahrhunderte versuchten hanbalitische Gelehrte wie Abd al-Wahhab mehrfach, ihre Religion durch den Rückgriff auf Koran und Sunna zu erneuern, und entwickelten dabei einen ausgeprägten Antischiismus, dessen wichtigste Quelle die Hanbaliya wurde. Bis heute ist die sogenannte Minhadsch as-Sunna des großen Damaszener Hanbaliten Taqi ad-Din ibn Taimiyya (1268-1328) unter Schiitenhassern weit verbreitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Damaszener",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "55cd5455-f110-3a5a-9460-ed4666b66dcc",
                                        "entry_id": "2690915c-0817-396c-a6d6-5d8975908f6e",
                                        "glosses": [
                                            "Einwohner der syrischen Hauptstadt Damaskus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bcc254d-5711-433a-a2fb-c95f57e65b71",
                                                "sense_id": "55cd5455-f110-3a5a-9460-ed4666b66dcc",
                                                "text": "„Für die so qualifizierten arabischen Brüder blieben die Damaszener, was bereits römische Legionäre erkannt und bei einer Rast vor den Schutzwällen von Damaskus in einen Gesteinsbrocken gehämmert hatten: ‚Eine verfaulte Bande.‘“"
                                            },
                                            {
                                                "example_id": "b7a5fb49-5e1c-4f82-8464-e8d0351a9971",
                                                "sense_id": "55cd5455-f110-3a5a-9460-ed4666b66dcc",
                                                "text": "„Die Damaszener vermuten außerdem den laut biblischer Überlieferung unbekannten Ort östlich des Jordans, an dem Moses gestorben sein soll, genauso wie die Geburtsstelle Abrahams direkt vor ihrer Haustür.“"
                                            },
                                            {
                                                "example_id": "1a685cc3-8c04-41ff-bac1-1c4853fa2f23",
                                                "sense_id": "55cd5455-f110-3a5a-9460-ed4666b66dcc",
                                                "text": "„Junge Beirutis und Damaszener feiern gemeinsam ihr erstes ausgelassenes Fest und trinken auf die Revolution.“"
                                            },
                                            {
                                                "example_id": "eedb3437-e80d-410b-b129-d5eb3b8c7df3",
                                                "sense_id": "55cd5455-f110-3a5a-9460-ed4666b66dcc",
                                                "text": "„Sami, ein junger Damaszener, der am Anfang mit den Revolutionären sympathisierte, ist inzwischen wütend auf alle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
