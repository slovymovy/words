                                                "text": "Le majordome du Pape."
                                            },
                                            {
                                                "example_id": "0b4e6388-f60e-4e99-9e46-baa68db2e957",
                                                "sense_id": "798a7524-f755-353a-844a-c248c9d6cdd4",
