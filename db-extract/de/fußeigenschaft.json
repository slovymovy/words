                "senses": [
                    {
                        "sense_id": "f674d761-2456-3c59-ad55-02b73aeb0af8",
                        "entry_id": "ba8659a9-3d88-3c84-b402-7a39267cecab",
                        "glosses": [
                            "spezifisches Merkmal eines Fußes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6aad5def-ed43-4cf1-b80a-65d0077aa668",
                                "sense_id": "f674d761-2456-3c59-ad55-02b73aeb0af8",
                                "text": "„Erst als Laufschuhe für vielfältige Fusseigenschaften auf den Markt kamen, war mein neuer Laufschuh ein Asics.“"
                            },
                            {
                                "example_id": "daabefeb-2f57-4604-95f6-e4f0cc9596fe",
                                "sense_id": "f674d761-2456-3c59-ad55-02b73aeb0af8",
                                "text": "„Hier liegt die Schuld aber nicht unbedingt allein bei den Materialien, sondern den eigenen Fußeigenschaften.“"
                            },
                            {
                                "example_id": "c0cea0ca-b521-4020-98f6-84599622e6fd",
                                "sense_id": "f674d761-2456-3c59-ad55-02b73aeb0af8",
                                "text": "„Was unter hohem Kosten- und Entwicklungspotential in naher Zukunft leistbar sein wird, sind spezielle Schuhkomponenten, die in Verbindung mit robotergesteuerte Technologie und menschlicher Arbeitskraft auf die individuellen Fußeigenschaften abgestimmt werden können.“"
                            },
                            {
                                "example_id": "a3bd2b25-2c91-4d13-bdd8-0affebde35e8",
                                "sense_id": "f674d761-2456-3c59-ad55-02b73aeb0af8",
                                "text": "„Viele Erkrankungen beziehungsweise Fußeigenschaften können das Tragen von orthopädischen Schuhen notwendig machen.“"
                            },
                            {
                                "example_id": "27cfd868-989b-427f-bbb8-558df2694f38",
                                "sense_id": "f674d761-2456-3c59-ad55-02b73aeb0af8",
                                "text": "„Dank der flexiblen Riemen passt sich die Sandale an die individuellen Fußeigenschaften und die Art der Bewegung ideal an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
