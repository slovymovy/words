                "senses": [
                    {
                        "sense_id": "2123b8f5-306c-3cfc-9432-93bee4864df7",
                        "entry_id": "0a9e757c-e069-3f08-89d6-1ebba3e03f95",
                        "glosses": [
                            "Wind, der nachts weht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c6e0bc7-ee3b-4bde-a379-fa4b130eb1d4",
                                "sense_id": "2123b8f5-306c-3cfc-9432-93bee4864df7",
                                "text": "„Der Nachtwind wirft eine Tür im Hause gegenüber zu.“"
                            },
                            {
                                "example_id": "68bd2717-06b4-4b53-9b99-f0f7f3a6d9e6",
                                "sense_id": "2123b8f5-306c-3cfc-9432-93bee4864df7",
                                "text": "„Im Sonnenschein des Morgens führten die proxenoi die Boten des Tyrannen den Abhang hinauf zur Wohnstatt des Bildhauers, doch der Nachtwind hatte Seltsames angerichtet.“"
                            },
                            {
                                "example_id": "d45f3e63-b57f-4e48-8831-1e2d90997453",
                                "sense_id": "2123b8f5-306c-3cfc-9432-93bee4864df7",
                                "text": "„Bouvard und Pécuchet verdauten und atmeten den leichten Nachtwind ein, der kühlend um ihre Wangen strich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
