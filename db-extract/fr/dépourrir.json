                ],
                "senses": [
                    {
                        "sense_id": "cc533579-6989-38f6-b25f-fc9d7f6d66f8",
                        "entry_id": "9abfcd88-e2c2-3e9d-80f2-de9c00ce0f00",
                        "glosses": [
                            "Faire revenir (quelque chose qui était pourri) à un état normal ou consommable, par exemple en enlevant les parties pourries."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "93125319-82f1-4630-b2e7-092a245ea400",
                                "sense_id": "cc533579-6989-38f6-b25f-fc9d7f6d66f8",
                                "text": "Comme je n'ai jamais vu d'eau gâtée de cette seconde espèce, je sens qu'il faudroit être dans un port de mer pour observer, analyser et concevoir l'espérance de pouvoir les dépourrir facilement."
                            },
                            {
                                "example_id": "bf087345-148e-447f-925c-27e4229d871b",
                                "sense_id": "cc533579-6989-38f6-b25f-fc9d7f6d66f8",
                                "text": "Il faudrait, en effet, à la fois vendanger les rouges et dépourrir les blancs : le personnel n'y suffit pas, les bras manquent."
                            },
                            {
                                "example_id": "a55f29ff-c9cd-471f-b584-d85931340d06",
                                "sense_id": "cc533579-6989-38f6-b25f-fc9d7f6d66f8",
                                "text": "Voyez-vous cette poire qui se dépourrit, qui redevient fruit mûr, qui se recolle à son arbre, puis redevient fruit vert, qui décroît,..."
                            }
                        ]
                    }
                ],
