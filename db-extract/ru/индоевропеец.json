                                    {
                                        "sense_id": "4de29825-49d0-3e6c-9c73-5d717cee1fa7",
                                        "entry_id": "8bd5937c-6175-3311-994c-a2c197b0ab8d",
                                        "glosses": [
                                            "Angehöriger der Kulturgruppe, die Indogermanisch als Ursprache hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aeacb24-dee2-423f-9cdf-381297757da7",
                                                "sense_id": "4de29825-49d0-3e6c-9c73-5d717cee1fa7",
                                                "text": "„Die Kultur der Indogermanen war vor allem geprägt vom Glauben an viele verschiedene Götter.“"
                                            },
                                            {
                                                "example_id": "0d6cf5f6-1c3e-4f07-857b-caef9e203ae0",
                                                "sense_id": "4de29825-49d0-3e6c-9c73-5d717cee1fa7",
                                                "text": "„Besonders das Wort für die Buche hat man bemüht, um die ursprüngliche Heimat der Indogermanen zu bestimmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
