                        "glosses": [
                            "Extrêmement sanglant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4e531e8-8220-47bb-9d84-9d55e2e0a5ca",
                                "sense_id": "572cc5cc-09eb-33c8-b4b1-31b24a3027a7",
                                "text": "Par contre, il y aurait eu un affrontement archi-sanglant entre les paysans de Chazot, d’une part, et les Suédois, d’autre part."
                            },
                            {
                                "example_id": "86265af5-5fbb-4976-ad2f-683bfb74ed0f",
                                "sense_id": "572cc5cc-09eb-33c8-b4b1-31b24a3027a7",
                                "text": "Si la Russie a versé dans une longue guerre civile archi-sanglante, l’Allemagne n’a connu qu’une « guerre civile limitée » avec pourtant de nombreux affrontements dans les rues."
                            },
                            {
                                "example_id": "7eff587e-0465-4c66-b8ed-d7a541a106ea",
                                "sense_id": "572cc5cc-09eb-33c8-b4b1-31b24a3027a7",
                                "text": "C’est pas archi-sanglant, mais il y a de quoi satisfaire l’amateur du genre sans non plus rebuter absolument ceux qui veulent s’amuser sans trop se faire peur avec une adaptation d’Orgueil et préjugés détournée."
                            }
                        ]
                    }
