                {
                    "sense_id": "41bcc13f-fbcd-379e-978f-b277d1e99ce1",
                    "sense_definition": "The yellow root of the plant Brassica napus.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vegetable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The yellow <w>turnip</w> has a slightly sweeter taste than the white variety.",
                            "target_lang_translations": {
                                "ru": "У желтой <w>брюквы</w> вкус немного слаще, чем у белого сорта.",
                                "pl": "Żółta <w>brukiew</w> ma nieco słodszy smak niż biała odmiana.",
                                "de": "Die gelbe <w>Steckrübe</w> hat einen etwas süßeren Geschmack als die weiße Sorte."
                            }
                        },
                        {
                            "text": "Many people confuse the yellow <w>turnip</w> with other root vegetables.",
                            "target_lang_translations": {
                                "ru": "Многие люди путают желтую <w>брюкву</w> с другими корнеплодами.",
                                "pl": "Wielu ludzi myli żółtą <w>brukiew</w> z innymi warzywami korzeniowymi.",
                                "de": "Viele Menschen verwechseln die gelbe <w>Kohlrübe</w> mit anderem Wurzelgemüse."
                            }
