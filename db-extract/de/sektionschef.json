                                "example_id": "eb1dd5e1-0428-4d9a-9149-b86e6c15d440",
                                "sense_id": "9a6e05b2-68d0-30c4-8138-939011e0ec5b",
                                "text": "„[Ferdinand Käs] leitete bis 1963 als Oberstleutnant die Gendarmerieschule und war 1963-1979 im Innenministerium tätig (ging als Sektionschef in Pension).“"
                            },
                            {
                                "example_id": "e495b3d3-044f-4211-ba11-fa69318c1d67",
                                "sense_id": "9a6e05b2-68d0-30c4-8138-939011e0ec5b",
                                "text": "„In den heimischen Ministerien sind Sektionschefs die ranghöchsten Beamten; sie unterstehen nur dem Bundesminister selbst - eigentlich.“"
                            }
