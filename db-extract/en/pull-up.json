                ],
                "senses": [
                    {
                        "sense_id": "0f160da4-35b9-3a06-841b-eea7a6f5097b",
                        "entry_id": "6582bc27-28c4-39ce-8a1e-d038978256f5",
                        "glosses": [
                            "引體向上"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2967921-f7be-4f47-b3da-d7603be461df",
                                "sense_id": "0f160da4-35b9-3a06-841b-eea7a6f5097b",
                                "text": "There might be handles that are parallel to each other, giving you a grip option that's halfway in between a pull-up and chin-up."
                            },
                            {
                                "example_id": "84cfeeb9-b9a5-4fe9-9fa5-92b213a4421a",
                                "sense_id": "0f160da4-35b9-3a06-841b-eea7a6f5097b",
                                "text": "In a pull-up, your hands are pronated (which means palms are facing away from the body) and your grip is wider. In a chin-up, your hands are supinated (palms are toward the body) and your grip is more narrow."
                            },
                            {
                                "example_id": "49a11e6d-866b-467d-8bee-6bce3f571918",
                                "sense_id": "0f160da4-35b9-3a06-841b-eea7a6f5097b",
                                "text": "I did lots of push-ups and pull-ups, and my only regret is that I stopped doing them as a young adult when I finally got to work out in health clubs instead of my basement or garage."
                            }
                        ]
                    },
                    {
                        "sense_id": "c878e764-05a3-3eb2-bbde-64f793ec6953",
                        "entry_id": "6582bc27-28c4-39ce-8a1e-d038978256f5",
