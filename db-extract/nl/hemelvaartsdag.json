                                "target_senses": [
                                    {
                                        "sense_id": "9976d1ee-17e9-3f1a-9c16-14ff13508f88",
                                        "entry_id": "c8975b1f-5d40-3b56-a579-6951bcae64a4",
                                        "glosses": [
                                            "Tag, an dem das Fest Christi Himmelfahrt oder das Fest Mariä Himmelfahrt gefeiert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb6361bc-05ac-44f2-a166-a08c035edaba",
                                                "sense_id": "9976d1ee-17e9-3f1a-9c16-14ff13508f88",
                                                "text": "„Am Himmelfahrtstag machten wir alle der Signora Bergalli, die bei allen italienischen Dichtern berühmt war, einen Besuch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89d2f597-00df-4202-9ade-adf97930c304",
                        "source_entry_id": "6772b4dd-e3cc-3874-8199-7d9d958a85f5",
                        "source_sense_id": "04d29ca2-d8aa-3437-8e39-9e2092223f50",
                        "source_sense_description": "christelijke feestdag waarin gevierd wordt dat Jezus na de opstanding naar de Hemel ging",
                        "target_lang_word": "Christi Himmelfahrt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Christi Himmelfahrt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d44f397d-e99b-395e-9fcc-37183bc173ba",
                                        "entry_id": "e7fffb34-743f-3a0b-86d5-3533f682c9e8",
                                        "glosses": [
                                            "christlicher Feiertag 40 Tage nach Ostern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b77f10c8-4e00-49d5-a641-b8e556518d4a",
                                                "sense_id": "d44f397d-e99b-395e-9fcc-37183bc173ba",
                                                "text": "Zu Christi Himmelfahrt fahren wir an die See."
                                            },
                                            {
                                                "example_id": "78d3f1d1-2e31-46c7-979a-4fc7718eb002",
                                                "sense_id": "d44f397d-e99b-395e-9fcc-37183bc173ba",
                                                "text": "„Am Tage vor Christi Himmelfahrt stellte mich der Gatte der Signora Manzoni einer jungen Kurtisane vor, die damals in Venedig großes Aufsehen erregte.“"
                                            },
                                            {
                                                "example_id": "cfe0358e-6071-4d86-b76a-0e4ec9481c54",
                                                "sense_id": "d44f397d-e99b-395e-9fcc-37183bc173ba",
                                                "text": "„Christi Himmelfahrt, das seit dem 4. Jahrhundert als eigenständiges Fest gefeiert wird, bezeichnet im christlichen Glauben die Rückkehr Jesu Christi als Sohn Gottes zu seinem Vater in den Himmel (40 Tage nach Ostern). “"
                                            },
                                            {
                                                "example_id": "e09fcc3f-0fc2-4579-b410-de7e556f42e9",
                                                "sense_id": "d44f397d-e99b-395e-9fcc-37183bc173ba",
                                                "text": "„Das ist das Geheimnis von Christi Himmelfahrt, das wir heute feierlich begehen.“"
                                            },
                                            {
                                                "example_id": "a2bdfd01-dbc8-4281-9b96-8ebc7a30060e",
                                                "sense_id": "d44f397d-e99b-395e-9fcc-37183bc173ba",
                                                "text": "„Christi Himmelfahrt, das wir heute feiern, stellt nicht nur einen Wendepunkt im Leben der Jünger dar, weil der Herr zu seinem Vater gegangen ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Christi Himmelfahrt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6f9456ab-ad69-3a56-bd8d-2828db19f7f3",
                                        "entry_id": "95009bf5-0210-344b-b5c5-f773df536477",
                                        "glosses": [
                                            "Geschehen um die Aufnahme des Jesus von Nazareth in den Himmel, von dem in der Bibel berichtet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29745cb4-e141-4d9d-b740-a4719a962597",
                                                "sense_id": "6f9456ab-ad69-3a56-bd8d-2828db19f7f3",
                                                "text": "Die Bibel berichtet von Christi Himmelfahrt, die die Jünger sehr beeindruckte."
                                            }
                                        ],
