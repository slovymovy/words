                                        "sense_id": "31e6c355-9a81-30bf-838c-5e480cc06255",
                                        "entry_id": "ae9c24bd-ac2b-3afd-b0f8-987b46d645bf",
                                        "glosses": [
                                            "Commune et ville dans la région d’Émilie-Romagne en Italie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5126d36c-a041-4f46-a64f-1c8528066af5",
                                                "sense_id": "31e6c355-9a81-30bf-838c-5e480cc06255",
                                                "text": "L’exarchat de Ravenne."
                                            },
                                            {
                                                "example_id": "b3db53ef-8f8a-4dfa-84d9-eab47a9c9489",
                                                "sense_id": "31e6c355-9a81-30bf-838c-5e480cc06255",
                                                "text": "Je veux revoir Ravenne endormie dans les pins noirs du rivage stérile. Êtes-vous allée à Ravenne, madame ? C’est une tombe enchantée, où paraissent des fantômes étincelants. La magie de la mort est là. Les mosaïques de Saint-Vitale, et des deux Saint-Apollinaire, avec leurs anges barbares et leurs impératrices nimbées, font sentir les délices monstrueuses de l’Orient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "969e32c8-f85c-3e42-8cd2-33db060b59cb",
                                        "entry_id": "ae9c24bd-ac2b-3afd-b0f8-987b46d645bf",
                                        "glosses": [
                                            "Province de la région d’Émilie-Romagne autour de cette ville."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
