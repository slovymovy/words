                ],
                "senses": [
                    {
                        "sense_id": "59510ab6-7e4a-3a75-a5e8-b14203076b32",
                        "entry_id": "4e017b86-b900-307b-b3ff-d3a3506b754e",
                        "glosses": [
                            "rasch rotierender, symmetrischer Kreisel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d667307d-ae4b-415a-8402-043ffedd0ef5",
                                "sense_id": "59510ab6-7e4a-3a75-a5e8-b14203076b32",
                                "text": "Mit dem Gyroskop lässt sich die Achsendrehung der Erde nachweisen."
                            },
                            {
                                "example_id": "4c959667-3db9-4a1b-9c97-bdd4fdad31cd",
                                "sense_id": "59510ab6-7e4a-3a75-a5e8-b14203076b32",
                                "text": "„Ein Gyroskop (auch Kreiselinstrument genannt) dient im Smartphone zur Lagebestimmung des Geräts.“"
                            },
                            {
                                "example_id": "d56df896-5087-4b4e-a1f2-90935be10cf1",
                                "sense_id": "59510ab6-7e4a-3a75-a5e8-b14203076b32",
                                "text": "„Der Begriff Gyroskop bezeichnet ein Kreiselinstrument, das aus einem Kreisel besteht, der sich in einem Lager dreht. Das Gyroskop ist dabei nicht nur ein interessanten physikalisches Spielzeug, sondern war als Kreiselinstrument eine überaus wichtige Erfindung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4543f8e-d2d6-43f4-91fa-0f1b18235fa2",
                        "source_entry_id": "4e017b86-b900-307b-b3ff-d3a3506b754e",
                        "source_sense_id": "59510ab6-7e4a-3a75-a5e8-b14203076b32",
                        "source_sense_description": "Technik: rasch rotierender, symmetrischer Kreisel",
                        "target_lang_word": "gyroscope",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gyroscope",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81e8d5a1-542f-3497-a840-640706b3598d",
                                        "entry_id": "35656c9f-1600-3ae3-ad6d-925382233a9e",
                                        "glosses": [
                                            "An apparatus composed of a wheel which spins inside of a frame (gimbal) and causes the balancing of the frame in any direction or position. In the form of a gyroscopic stabilizer, used to help keep aircraft and ships steady."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce59ec57-671a-4495-b4fa-e7b99ee432c5",
                                                "sense_id": "81e8d5a1-542f-3497-a840-640706b3598d",
                                                "text": "Working with NR, ScotRail and Porterbrook, Perpetuum has fitted sensors with gyroscopes and accelerometers to trains that are already in passenger service."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20abc92d-a993-4e13-96d8-e3797c730860",
                        "source_entry_id": "4e017b86-b900-307b-b3ff-d3a3506b754e",
                        "source_sense_id": "59510ab6-7e4a-3a75-a5e8-b14203076b32",
                        "source_sense_description": "Technik: rasch rotierender, symmetrischer Kreisel",
                        "target_lang_word": "gyroscope",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gyroscope",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "56421e9d-b761-3004-a2d0-0f6ebe04dc85",
                                        "entry_id": "aef44c07-f6bc-31aa-a844-5c758327b065",
                                        "glosses": [
                                            "Appareil qui exploite le principe de la conservation du moment angulaire en physique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "491612a8-188f-42cb-bfe5-e5b1a7d3adb2",
                                                "sense_id": "56421e9d-b761-3004-a2d0-0f6ebe04dc85",
                                                "text": "Un gyroscope peut servir à indiquer le Nord."
                                            },
                                            {
                                                "example_id": "4747f0a9-385c-4083-af72-c1ad6994fc42",
                                                "sense_id": "56421e9d-b761-3004-a2d0-0f6ebe04dc85",
                                                "text": "GASTON, fouillant aussi. – Il n’y a pas de polichinelles, d’arche de Noé ?\nMme RENAUD – Tout petit, tu n’as plus voulu que des jouets scientifiques. Voilà tes gyroscopes, tes éprouvettes, tes électroaimants, tes cornues, ta grue mécanique.\nGEORGES – Nous voulions faire de toi un brillant ingénieur."
                                            },
                                            {
                                                "example_id": "cc089f11-91b0-41e2-afdc-c4af0bfb54b3",
                                                "sense_id": "56421e9d-b761-3004-a2d0-0f6ebe04dc85",
                                                "text": "A ce moment Nestor prit la boîte et l’ouvrit en m’expliquant gravement : « C’est un gyroscope, c’est la clé de l’absolu. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8be37dc-281c-3ab9-a5ae-f366bc98c1c1",
                                        "entry_id": "aef44c07-f6bc-31aa-a844-5c758327b065",
                                        "glosses": [
                                            "Capteur de position angulaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51286cd1-ed05-48f7-ae0f-21f32f735729",
                                                "sense_id": "a8be37dc-281c-3ab9-a5ae-f366bc98c1c1",
                                                "text": "Le système est couplé avec des données de gyroscope et d’accéléromètre pour le haut, le bas et la ligne d’horizon, développe Thomas Dexmier, vice-président associé EMEA chargé des solutions entreprise chez HTC Vive."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5ddf100-798e-4710-91f3-c7c762f0a5a0",
                        "source_entry_id": "4e017b86-b900-307b-b3ff-d3a3506b754e",
                        "source_sense_id": "59510ab6-7e4a-3a75-a5e8-b14203076b32",
