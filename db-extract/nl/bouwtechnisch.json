                        "examples": [
                            {
                                "example_id": "2b41287f-f022-44e0-87f5-50b17c8494e8",
                                "sense_id": "09560f7c-f420-3943-8617-a63cfa0f1ac9",
                                "text": "De crisis heeft flink huisgehouden in architectenland. In 2008 waren er nog ruim 14.500, nu zijn er nog maar 6500 architecten, bouwtechnisch tekenaars, en bestekschrijvers. Ook de omzetten zijn dramatisch gedaald."
                            },
                            {
                                "example_id": "82b6c91c-379a-4720-8d17-e00ae5c93fc8",
                                "sense_id": "09560f7c-f420-3943-8617-a63cfa0f1ac9",
                                "text": "Bouwtechnisch onderzoek heeft uitgewezen dat de vooroorlogse huizen stabiel en veilig zijn. Morgen worden in de woningen trillingsmeters geplaatst."
                            },
                            {
                                "example_id": "d22083fa-c5f4-4c20-8d8b-c7fbc9d41dcc",
                                "sense_id": "09560f7c-f420-3943-8617-a63cfa0f1ac9",
                                "text": "De teamleden hebben bouwtechnisch inzicht en beschikken over speciale zoekapparatuur om slachtoffers op te sporen. Ook hebben ze gereedschap en materieel bij zich om de bouwconstructie te stabiliseren."
                            }
                        ]
                    }
