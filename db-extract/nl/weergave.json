                "senses": [
                    {
                        "sense_id": "338deaf5-aceb-3780-a0af-878588ec4a94",
                        "entry_id": "5b38a272-f8f5-3128-b346-cdab775381df",
                        "glosses": [
                            "het opnieuw afbeelden, weergeven van iets dat eerder is opgenomen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2be530e1-bd30-429b-9cc4-7b141a8e5dfc",
                                "sense_id": "338deaf5-aceb-3780-a0af-878588ec4a94",
                                "text": "Zijn weergave van de gebeurtenissen is volstrekt bezijden de waarheid."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e4dc40d-4a01-4304-87f6-1bf880ddd087",
                        "source_entry_id": "5b38a272-f8f5-3128-b346-cdab775381df",
                        "source_sense_id": "338deaf5-aceb-3780-a0af-878588ec4a94",
                        "source_sense_description": "het opnieuw afbeelden, weergeven van iets dat eerder is opgenomen",
                        "target_lang_word": "depiction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "depiction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8151fc8b-8065-3380-a5e3-8aae75d8f6b6",
                                        "entry_id": "a42d98fb-8d36-3577-8353-8aa53e0f1a82",
                                        "glosses": [
                                            "A lifelike image of something, either verbal or visual."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b2fb9bf-e320-4c34-b122-53c7dd6a3f42",
                                                "sense_id": "8151fc8b-8065-3380-a5e3-8aae75d8f6b6",
                                                "text": "If Demandt's essay served as a strident example of the German desire for normalcy, a more subtle example was provided by a brief allohistorical depiction of a Nazi victory in World War II written by German historian Michael Salewski in 1999."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1020f3a9-5231-3ff8-8e03-db989ad80bbb",
                                        "entry_id": "a42d98fb-8d36-3577-8353-8aa53e0f1a82",
                                        "glosses": [
                                            "A drawing or painting."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cefa492a-1f45-371f-b69c-1f74a66aec6a",
                                        "entry_id": "a42d98fb-8d36-3577-8353-8aa53e0f1a82",
                                        "glosses": [
                                            "A representation."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "488cbe1a-1552-3f1f-8975-4f833f27fd10",
                                        "entry_id": "a42d98fb-8d36-3577-8353-8aa53e0f1a82",
                                        "glosses": [
                                            "The act of depicting."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a84e025-6737-4e94-87f3-5a33e9deee1e",
                                                "sense_id": "488cbe1a-1552-3f1f-8975-4f833f27fd10",
                                                "text": "It is nevertheless true that, whereas the teaching of music and literature is established on a scientific basis, the art of depiction is still taught in a primitive and inefficient way."
                                            },
                                            {
                                                "example_id": "d1d3fb34-3b71-4a48-9cf3-f82cd53ec156",
                                                "sense_id": "488cbe1a-1552-3f1f-8975-4f833f27fd10",
                                                "text": "But since \"realism\" or representational depiction is itself a mode of art, it can never escape some degree of formal removal from the raw data of experience; […]"
                                            },
                                            {
                                                "example_id": "473694fa-2413-4ba2-a97a-ba0883543ee9",
                                                "sense_id": "488cbe1a-1552-3f1f-8975-4f833f27fd10",
                                                "text": "As previously described, depiction is a unique type of visual representation defined by both seeing the activities/marks that constitute the depiction whilst also seeing the object of the depiction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d8d2511-1931-4bb3-84bd-3898057e5f82",
                        "source_entry_id": "5b38a272-f8f5-3128-b346-cdab775381df",
                        "source_sense_id": "338deaf5-aceb-3780-a0af-878588ec4a94",
                        "source_sense_description": "het opnieuw afbeelden, weergeven van iets dat eerder is opgenomen",
                        "target_lang_word": "Darstellung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Darstellung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b3ae8db-88ef-3e46-99c6-d121afeefe49",
                                        "entry_id": "ff7eaaf7-e992-374a-97ce-61b9c6703609",
                                        "glosses": [
                                            "die Art und Weise der Gestaltung (oder Darbringung) von Informationen, Planungen, Waren, Gemälden oder Ähnlichem (gegenüber einem Publikum)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42148423-f28e-43f9-b931-47a762e2c3a1",
                                                "sense_id": "4b3ae8db-88ef-3e46-99c6-d121afeefe49",
                                                "text": "Die Darstellung des Todes auf diesem Bild ist sehr gelungen."
                                            },
                                            {
                                                "example_id": "6f11172a-3d32-4081-af12-1b3d67f4265d",
                                                "sense_id": "4b3ae8db-88ef-3e46-99c6-d121afeefe49",
                                                "text": "Auf dem Foto, das sie sich gerade anschauen, ist die Darstellung einer betagten Frau im Regenmantel zu sehen."
                                            },
                                            {
                                                "example_id": "47e783d5-c8b0-4bb3-b80d-f30060a5c28b",
                                                "sense_id": "4b3ae8db-88ef-3e46-99c6-d121afeefe49",
                                                "text": "Auf den meisten Landkarten sind die Städte in Form von Darstellungen roter Punkte zu sehen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "68a7b918-f157-3aaf-9d7a-dcd6fe424d90",
                                        "entry_id": "ff7eaaf7-e992-374a-97ce-61b9c6703609",
                                        "glosses": [
                                            "Gestaltung einer Rolle auf der Bühne, Verkörperung einer Bühnenfigur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e96de206-2dba-443f-9d9f-d71a76fcd838",
                                                "sense_id": "68a7b918-f157-3aaf-9d7a-dcd6fe424d90",
                                                "text": "Bruno Ganz überzeugte in seiner Darstellung des Faust auf eine sehr eindrückliche Art und Weise."
                                            },
                                            {
                                                "example_id": "d78f607c-886c-4d68-8016-b8e805c43fd0",
                                                "sense_id": "68a7b918-f157-3aaf-9d7a-dcd6fe424d90",
                                                "text": "Der Schauspieler lehnte den Vorschlag des Regisseurs ab, kurzzeitig die Darstellung des Massenmörders für seinen kranken Kollegen zu übernehmen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d05f3a0b-8130-3f33-b4d0-484fb4ea0536",
                                        "entry_id": "ff7eaaf7-e992-374a-97ce-61b9c6703609",
                                        "glosses": [
                                            "das Verdeutlichen von Aufschlüssen über Zusammenhänge und Sachverhalte in Worten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "363f2c26-5a4d-49dd-bf40-33e43641f4f1",
                                                "sense_id": "d05f3a0b-8130-3f33-b4d0-484fb4ea0536",
                                                "text": "Die Darstellung des Problems durch den Redner war nachvollziehbar."
                                            },
                                            {
                                                "example_id": "91637665-e120-49e1-b7d5-7c0fcf0cad66",
                                                "sense_id": "d05f3a0b-8130-3f33-b4d0-484fb4ea0536",
                                                "text": "Bei seiner Präsentation wurde ein Schwerpunkt auf die ausführliche Darstellung des Herganges des Geschehens gesetzt."
                                            },
                                            {
                                                "example_id": "790f7e2e-b883-4ffd-8151-5b266f03e84e",
                                                "sense_id": "d05f3a0b-8130-3f33-b4d0-484fb4ea0536",
                                                "text": "Versuche der Darstellung seiner Unschuld waren bei diesem Wortgefecht fehl am Platze."
                                            },
                                            {
                                                "example_id": "93494df2-7e23-46df-a9b7-e18310d4b8bd",
                                                "sense_id": "d05f3a0b-8130-3f33-b4d0-484fb4ea0536",
                                                "text": "„Ähnliche Darstellungen gibt es viele.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8e317976-1efa-30f9-9c29-57a957824a36",
                                        "entry_id": "ff7eaaf7-e992-374a-97ce-61b9c6703609",
                                        "glosses": [
                                            "die Herstellung oder Gewinnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "918a6bdd-cb80-414e-ba0b-9ccda7988404",
                                                "sense_id": "8e317976-1efa-30f9-9c29-57a957824a36",
                                                "text": "Die Darstellung von Wasserstoff kann durch Elektrolyse von Wasser erfolgen."
                                            },
                                            {
                                                "example_id": "4d2f9c18-b32b-40f8-85e5-616e412d6da2",
                                                "sense_id": "8e317976-1efa-30f9-9c29-57a957824a36",
                                                "text": "Dem Chemieprofessor war die Darstellung jenes Stoffes, welchen er lange erforscht hatte, nach langen Experimenten als Erstem gelungen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "0784aacf-6cba-3574-9010-ee587aeaad6d",
                                        "entry_id": "ff7eaaf7-e992-374a-97ce-61b9c6703609",
                                        "glosses": [
                                            "Bezug des Sprechers auf Gegenstände/Sachverhalte in der Welt, indem er spricht; eine der Sprachfunktionen neben Ausdruck und Appell (im Organon-Modell von Karl Bühler)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd057b16-1a21-4759-807e-48182de7c34a",
                                                "sense_id": "0784aacf-6cba-3574-9010-ee587aeaad6d",
                                                "text": "Mit der Sprachfunktion Darstellung ist gemeint, dass jemand, der spricht, eine Aussage über etwas macht."
                                            },
                                            {
                                                "example_id": "07ad33e9-bdb3-417f-be3c-0f45b33ea43e",
                                                "sense_id": "0784aacf-6cba-3574-9010-ee587aeaad6d",
                                                "text": "„Das Thema »sprachliche Darstellung« ist, soviel davon in einer Axiomatik enthalten sein muß, durch C unseres Essays erschöpft.“"
                                            },
                                            {
                                                "example_id": "23d4a64f-0798-44b2-b18c-c3534e6a87d6",
                                                "sense_id": "0784aacf-6cba-3574-9010-ee587aeaad6d",
                                                "text": "„Darstellung ist nach realistischem Verständnis mithin als über eine begriffliche Zwischenstufe verlaufende Abbildung außersprachlicher Sachverhalte auf der Ebene einzelsprachlicher Inhalte zu definieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
