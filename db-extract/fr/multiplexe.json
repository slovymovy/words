                "senses": [
                    {
                        "sense_id": "c9dcf1ba-d9e8-31ea-a765-f7e065ffbe5f",
                        "entry_id": "e039731d-3ab7-30ee-ae3c-12162ed04d8e",
                        "glosses": [
                            "Ensemble de salles de projection cinématographique et d’espaces commerciaux établis sous un même toit et exploités sous une même enseigne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f89bfffc-85bc-4869-931c-e5841ca6ce5f",
                                "sense_id": "c9dcf1ba-d9e8-31ea-a765-f7e065ffbe5f",
                                "text": "Ça se passait dans un multiplexe, une des salles était dévolue aux films en compétition, la deuxième à Rambo II, et la dernière à Suédoises en folie, un film classé triple X…"
                            },
                            {
                                "example_id": "2acc4db3-8175-4556-9a96-da53b3502460",
                                "sense_id": "c9dcf1ba-d9e8-31ea-a765-f7e065ffbe5f",
                                "text": "Car dans un multiplexe, la fête est à peine commencée qu’elle s’achève : le spectateur sait déjà qu’il paiera deux fois. La première pour regarder de la publicité – jusqu’à vingt minutes –, la seconde pour y voir un film."
                            }
                        ]
                    }
                ],
