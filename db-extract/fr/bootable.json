                "senses": [
                    {
                        "sense_id": "2180f5b0-b379-3b6a-a88a-615fb89cacbf",
                        "entry_id": "b1fe73a5-96e2-3266-ba97-3619365b0a4d",
                        "glosses": [
                            "Qui contient un programme permettant de démarrer un ordinateur arrêté."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "c91b16f3-def1-4ac5-9b8f-1fe831eb5cf6",
                                "sense_id": "2180f5b0-b379-3b6a-a88a-615fb89cacbf",
                                "text": "Suite à un plantage de l'ordinateur ou à l'infection du système par un virus, il se peut que votre disque dur principal ne soit plus bootable."
                            },
                            {
                                "example_id": "ae3c5f3e-2376-4e2a-a565-72a68d96779f",
                                "sense_id": "2180f5b0-b379-3b6a-a88a-615fb89cacbf",
                                "text": "Nous allons créer un disque USB bootable. Fort utile pour transporter votre système partout avec vous, avec votre configuration, vos fichiers, vos habitudes et surtout fort utile lorsque le système de la machine hôte n'est plus fonctionnel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90917fc7-108d-4795-aa84-3a0b038b29d3",
                        "source_entry_id": "b1fe73a5-96e2-3266-ba97-3619365b0a4d",
                        "source_sense_id": "2180f5b0-b379-3b6a-a88a-615fb89cacbf",
                        "target_lang_word": "bootfähig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bootfähig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5b998972-6061-3ce1-8a59-54fc6cdb8a4d",
                                        "entry_id": "f5465343-cf5f-3da6-b663-854353997674",
                                        "glosses": [
                                            "in der Lage einen Bootvorgang durchzuführen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f394fce6-8ff8-4c92-976f-868460c3bf97",
                                                "sense_id": "5b998972-6061-3ce1-8a59-54fc6cdb8a4d",
                                                "text": "„Greift das Windows-System und damit UltraISO auf den USB-Stick zu, lässt der sich mit diesem Werkzeug recht einfach bootfähig machen: Zuerst mit UltraISO das eben erstellte Speicherabbild der Windows-7-DVD öffnen, dann \"Schreibe Datenträger Abbild\" auswählen.“"
                                            },
                                            {
                                                "example_id": "039f0578-c68e-4637-baac-2ad034edcc6f",
                                                "sense_id": "5b998972-6061-3ce1-8a59-54fc6cdb8a4d",
                                                "text": "„Zu Beginn muss der USB-Stick soweit vorbereitet werden, dass der Computer nachher die Installationsdatei für das Betriebssystem darauf erkennt und ausführt – er muss bootfähig gemacht werden.“"
                                            },
                                            {
                                                "example_id": "0b95d15f-1bb9-4388-8209-21085ed9e777",
                                                "sense_id": "5b998972-6061-3ce1-8a59-54fc6cdb8a4d",
                                                "text": "„Der Standardweg um PC oder Notebook im Notfall, etwa nach einem Virenbefall oder bei einem Hardware-Defekt, zu starten ist es den USB-Stick bootfähig zu machen.“"
                                            },
                                            {
                                                "example_id": "bd2bd088-031d-4d03-8ce3-393f11e33795",
                                                "sense_id": "5b998972-6061-3ce1-8a59-54fc6cdb8a4d",
                                                "text": "„Wer USBs in Installationsdatenträger verwandeln oder zum Systemstart nutzen möchte, muss zuvor den USB Stick bootfähig machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
