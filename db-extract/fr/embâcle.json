                                        "sense_id": "2fbeaf05-5729-3dbe-8ca0-ea7b64fb7631",
                                        "entry_id": "3f540668-acba-31fe-aaab-4f3159ff06ac",
                                        "glosses": [
                                            "The state or condition of being blocked."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9257c385-9508-411b-85c5-ef15b7c0c689",
                                                "sense_id": "2fbeaf05-5729-3dbe-8ca0-ea7b64fb7631",
                                                "text": "Only when one has seen a Control Office at first-hand does one realise the vast amount of unsparing but largely unsung work that is behind the eventual publication, perhaps, of a paragraph in this journal's \"Motive Power Miscellany\" recording the appearance, within hours of the complete blockage of a main line, of many of its trains, passenger and freight, on routes quite foreign to them; and of effective emergency services either side of the disaster area."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "487e6806-3f91-3963-9816-69039359a68c",
                                        "entry_id": "3f540668-acba-31fe-aaab-4f3159ff06ac",
                                        "glosses": [
                                            "The thing that is the cause of such a state, blocking a passage."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edf63f8c-84ed-4c0b-9a6c-0605b86d1453",
                                                "sense_id": "487e6806-3f91-3963-9816-69039359a68c",
                                                "text": "There was a blockage in the sewer, so we called out the plumber."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d557e8fe-5467-3aab-8349-b7ed904204c1",
                                        "entry_id": "3f540668-acba-31fe-aaab-4f3159ff06ac",
                                        "glosses": [
                                            "Occlusion of a lumen (especially that of a blood vessel or intestine), or the thing that is causing it; as:",
                                            "Synonym of thrombosis, thromboembolism, or embolism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9dbd122-2e21-4910-9487-6f6399fd905e",
                                                "sense_id": "d557e8fe-5467-3aab-8349-b7ed904204c1",
                                                "text": "Blockage of circulation quickly leads to ischemia."
                                            },
                                            {
                                                "example_id": "693df153-ef38-425f-9a36-c68057a82097",
                                                "sense_id": "d557e8fe-5467-3aab-8349-b7ed904204c1",
                                                "text": "In selected cases, endovascular thrombectomy can quickly remove a blockage that pharmaceutical thrombolysis can't budge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab20a6ba-b9d8-3c1d-ad69-0c723db9e000",
