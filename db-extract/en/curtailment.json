                    }
                ],
                "senses": [
                    {
                        "sense_id": "c7c50e11-989b-38a2-86b6-45792f58bcc6",
                        "entry_id": "2dbdc07c-4ab9-3dcf-8b23-200f951d1c6f",
                        "glosses": [
                            "The act of curtailing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e4cb858-8366-44ef-9b7f-e5bea56a8c1d",
                                "sense_id": "c7c50e11-989b-38a2-86b6-45792f58bcc6",
                                "text": "Curtailment was said to be imminent of services on the ex-Caledonian Glasgow-Carlisle main line via Carstairs, also between Glasgow and Lanark and on other ex-C.R. lines in the Glasgow area."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5dda1e78-4e5a-468a-aae5-eca70dc36059",
                        "source_entry_id": "2dbdc07c-4ab9-3dcf-8b23-200f951d1c6f",
                        "source_sense_id": "c7c50e11-989b-38a2-86b6-45792f58bcc6",
                        "source_sense_description": "act of curtailing",
                        "target_lang_word": "Beschneidung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beschneidung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29d24713-0f9f-3861-a68c-07ce14dd3519",
                                        "entry_id": "5325f060-7d84-34e2-8319-aa16c672850d",
                                        "glosses": [
                                            "Operativer Eingriff, bei der die Vorhaut des Penis aus medizinischen, ästhetischen oder rituellen Gründen abgetrennt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b7c0f83-f7ab-41d7-8d48-6c33b011f753",
                                                "sense_id": "29d24713-0f9f-3861-a68c-07ce14dd3519",
                                                "text": "Bei einer Vorhautverengung ist manchmal eine Beschneidung nötig."
                                            },
                                            {
                                                "example_id": "28a31d8f-f01a-4704-9d8d-51aab5515db6",
                                                "sense_id": "29d24713-0f9f-3861-a68c-07ce14dd3519",
                                                "text": "Bei einer Beschneidung aus ästhetischen Gründen sollten die Komplikationen bedacht werden."
                                            },
                                            {
                                                "example_id": "a4f022f6-cd2b-4e50-bbab-be40d84fdbe4",
                                                "sense_id": "29d24713-0f9f-3861-a68c-07ce14dd3519",
                                                "text": "„Und diese eine Symbolverwandtschaft ist exemplarisch für viele weitere Überschneidungen wie zum Beispiel die Beschneidung in Judentum und Islam.“"
                                            },
                                            {
                                                "example_id": "5d7b84d5-1cae-42ca-a7c7-405b335819d3",
                                                "sense_id": "29d24713-0f9f-3861-a68c-07ce14dd3519",
                                                "text": "„Für eine Beschneidung in Kastel kommt der Mohel zunächst aus Mainz; erst1844 besteht mit Dr. Klober auch ein Beschneider aus Kastel die nach der »Großherzoglichen Verordnung« verpflichtende Examinierung beim Mainzer Stadtphysikus.“"
                                            },
                                            {
                                                "example_id": "75fbd8c1-1846-401e-a8ac-129c0cb2f464",
                                                "sense_id": "29d24713-0f9f-3861-a68c-07ce14dd3519",
                                                "text": "„Nach der vollzogenen Beschneidung des Itzig Finkelstein rannte meine Mutter aufgeregt nach Hause, alarmierte sofort meine fünf Väter, holte mich aus der Wiege und legte mich auf den Küchentisch, in der Absicht, mich meines Gliedes zu berauben, es sozusagen abzuschneiden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6b5e4603-aa0a-359c-b14c-5a906984dab8",
                                        "entry_id": "5325f060-7d84-34e2-8319-aa16c672850d",
                                        "glosses": [
                                            "Praktik, bei der die Geschlechtsteile von Frauen oder Mädchen ganz oder teilweise entfernt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95750080-adb3-4c11-bb07-db406b7ba5ac",
                                                "sense_id": "6b5e4603-aa0a-359c-b14c-5a906984dab8",
                                                "text": "Die Beschneidung von Frauen ist äußerst schmerzhaft und gefährlich."
                                            },
                                            {
                                                "example_id": "fcf3c492-ad30-4dd7-804e-67ca22430eaf",
                                                "sense_id": "6b5e4603-aa0a-359c-b14c-5a906984dab8",
                                                "text": "Etwa 130–150 Millionen Frauen mussten eine Beschneidung über sich ergehen lassen."
                                            },
                                            {
                                                "example_id": "24383ca3-6f36-4216-950c-66076512a399",
                                                "sense_id": "6b5e4603-aa0a-359c-b14c-5a906984dab8",
                                                "text": "„Als ich ihn fragte, warum er nicht ein Machtwort sprach, um seine Enkelin vor der Beschneidung zu retten, spielte er den Ahnungslosen.“"
                                            },
                                            {
                                                "example_id": "afa64272-5da9-4d32-a6a2-414243b3e341",
                                                "sense_id": "6b5e4603-aa0a-359c-b14c-5a906984dab8",
                                                "text": "„Alle jungen Männer werden nach der Beschneidung, etwa im Alter von sechzehn Jahren, in den Kriegerstand aufgenommen.“"
                                            },
                                            {
                                                "example_id": "6bc3bff7-4a1a-46c4-9304-3cd6fb8b4ce5",
                                                "sense_id": "6b5e4603-aa0a-359c-b14c-5a906984dab8",
                                                "text": "„Doch mit ihrer Beschneidung, deren Zeitpunkt die Familie festlegt, endet die Libertinage der Mädchen.“"
                                            },
                                            {
                                                "example_id": "cda78c9a-615c-435f-81aa-0904f452f4b4",
                                                "sense_id": "6b5e4603-aa0a-359c-b14c-5a906984dab8",
                                                "text": "„Ein wortwörtlich einschneidender Unterschied ist das Ritual der Beschneidung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9eb9978d-2605-3fdd-bf3c-d03804b24acf",
                                        "entry_id": "5325f060-7d84-34e2-8319-aa16c672850d",
                                        "glosses": [
                                            "durch Schneiden vorgenommene Kürzung (etwa von unerwünschten Trieben von Pflanzen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c82cb829-98ac-4f0e-8718-3cfefabbcaf6",
                                                "sense_id": "9eb9978d-2605-3fdd-bf3c-d03804b24acf",
                                                "text": "Die Beschneidung der Obstbäume erfolgt meist im Winter."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "d64cc0f2-589f-3229-a7bb-02e454cf8ab5",
                                        "entry_id": "5325f060-7d84-34e2-8319-aa16c672850d",
                                        "glosses": [
                                            "Einschränkung der Möglichkeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "708bd459-3afa-474c-8468-071ac31c8b56",
                                                "sense_id": "d64cc0f2-589f-3229-a7bb-02e454cf8ab5",
                                                "text": "Er wollte die Beschneidung seiner Handlungsmöglichkeiten nicht unwidersprochen hinnehmen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4953052a-b0cd-4c39-9951-db51e841e86b",
                        "source_entry_id": "2dbdc07c-4ab9-3dcf-8b23-200f951d1c6f",
                        "source_sense_id": "c7c50e11-989b-38a2-86b6-45792f58bcc6",
                        "source_sense_description": "act of curtailing",
                        "target_lang_word": "Verkürzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verkürzung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f0256243-c829-310b-99ca-36f2a7027db9",
                                        "entry_id": "16bb47b7-4de2-3d5d-bf04-d7671ee9a783",
                                        "glosses": [
                                            "Vorgang, die Länge eines Gegenstandes/einer Zeiteinheit durch geeignete Maßnahmen zu verringern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f859e0cf-8931-49ad-9349-d1b719c20385",
                                                "sense_id": "f0256243-c829-310b-99ca-36f2a7027db9",
                                                "text": "Die Verkürzung der Autobahn ruft eine längere Fahrtzeit hervor."
                                            },
                                            {
                                                "example_id": "4bdae516-a769-4f74-96bf-da91b93881b2",
                                                "sense_id": "f0256243-c829-310b-99ca-36f2a7027db9",
                                                "text": "Bei Ihrer Berufserfahrung kommt auch eine Verkürzung der Ausbildungszeit in Frage."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9522b29e-9be1-3408-90d5-e63b876a378a",
                                        "entry_id": "16bb47b7-4de2-3d5d-bf04-d7671ee9a783",
                                        "glosses": [
                                            "Benachteiligung, insbesondere in Zusammenhang mit Verträgen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "881d54b2-8527-4aa7-a8cf-43fa6b39d4fc",
                                                "sense_id": "9522b29e-9be1-3408-90d5-e63b876a378a",
                                                "text": "Eine Verkürzung oder Verletzung über die Hälfte liegt vor, wenn bei einem Rechtsgeschäft ein Vertragsteil weniger als die Hälfte von dem bekommt, was der andere Vertragsteil erhält."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1784f19-c300-473d-bc5e-1594d450ca8c",
                        "source_entry_id": "2dbdc07c-4ab9-3dcf-8b23-200f951d1c6f",
                        "source_sense_id": "c7c50e11-989b-38a2-86b6-45792f58bcc6",
                        "source_sense_description": "act of curtailing",
                        "target_lang_word": "Abkürzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abkürzung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7eda7228-f3a7-3409-b2cb-8027f46cbeb2",
                                        "entry_id": "c7b09fbd-b6e8-3a03-a7af-2673d8428b25",
                                        "glosses": [
                                            "kürzerer Weg"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bf09644-c76f-4ee1-9b1c-132f5eab7689",
                                                "sense_id": "7eda7228-f3a7-3409-b2cb-8027f46cbeb2",
                                                "text": "Weil er eine Abkürzung nahm, war er schneller am Ziel."
                                            },
                                            {
                                                "example_id": "171aeecb-fae5-4e63-a800-f9bf11e8a918",
                                                "sense_id": "7eda7228-f3a7-3409-b2cb-8027f46cbeb2",
                                                "text": "„Als Kind war ich den Hang zu Fuß hochgekraxelt, hatte manchmal die Abkürzung über das Feld genommen, den kleinen Trampelpfad, der bei Regen zu einer Schlammpiste wurde.“"
                                            },
                                            {
                                                "example_id": "82daa2ea-6e91-45d1-a58d-61cc57bf5af5",
                                                "sense_id": "7eda7228-f3a7-3409-b2cb-8027f46cbeb2",
                                                "text": "„Beide Güter grenzten an die Alle, aber in Götzlack war der Fluss zu einem See aufgestaut, und über diesen ließ sich eine Abkürzung nehmen, mit der die überfüllten Hauptstraßen umgangen werden konnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4c772163-bb9e-3861-9efe-99a9d54654da",
                                        "entry_id": "c7b09fbd-b6e8-3a03-a7af-2673d8428b25",
                                        "glosses": [
                                            "verkürzte Form eines Wortes oder eines Ausdrucks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4bbcc2c-3ac6-440b-a884-5d6a27d66681",
                                                "sense_id": "4c772163-bb9e-3861-9efe-99a9d54654da",
                                                "text": "In der englischen Sprache gibt es viele Abkürzungen."
                                            },
                                            {
                                                "example_id": "9ce06fc5-83a4-4843-86f7-0f128bd45483",
                                                "sense_id": "4c772163-bb9e-3861-9efe-99a9d54654da",
                                                "text": "„Bus“ ist eine Abkürzung für (seltener: von) „Autobus“."
                                            },
                                            {
                                                "example_id": "fdeb45ab-9fb4-4b7f-8feb-427e4d9dcdba",
                                                "sense_id": "4c772163-bb9e-3861-9efe-99a9d54654da",
                                                "text": "„Man hat in angelsächsischen Ländern einen besonderen Sinn für Wortspiele, sogenannte ‚puns‘, und macht sich seit jeher einen Spaß daraus, immer neue Abkürzungen zu erfinden…“"
                                            },
                                            {
                                                "example_id": "eb5a3c1c-9e3f-4f89-80ea-4b2fba548730",
                                                "sense_id": "4c772163-bb9e-3861-9efe-99a9d54654da",
                                                "text": "„Die Nachrichten, die wir gegenseitig verfassen, sind zumeist kurz, oft sehr kurz, und missverständlich, oft in falscher Interpunktion und mit kruden Abkürzungen, ohne Kommata und Bindestriche, ohne Frage- und Ausrufezeichen.“"
                                            },
                                            {
                                                "example_id": "be4928a6-a096-4c04-a704-1054981a7385",
                                                "sense_id": "4c772163-bb9e-3861-9efe-99a9d54654da",
                                                "text": "„Das nimmt die Abkürzungen der Kurzschrift, der Stenographie teilweise vorweg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c28c8ca1-a3c9-3690-a9e2-6562b445949a",
                                        "entry_id": "c7b09fbd-b6e8-3a03-a7af-2673d8428b25",
                                        "glosses": [
                                            "nur schriftsprachliche Verkürzung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9c1ca5b-d195-405d-82ba-b46d62cbfa91",
                                                "sense_id": "c28c8ca1-a3c9-3690-a9e2-6562b445949a",
                                                "text": "Rein schriftsprachliche Abkürzungen sind Formen wie „ca.“, „etc.“, „usw.“, die nicht auch als solche gesprochen werden."
                                            },
                                            {
                                                "example_id": "7402bf87-41ed-42bd-aa8d-aedb408fd142",
                                                "sense_id": "c28c8ca1-a3c9-3690-a9e2-6562b445949a",
                                                "text": "„Bis auf Feuilleton und Wochenendbeilage gibt es keinen Ressortteil, in dem nicht mit Abkürzungen gearbeitet wird.“"
                                            },
                                            {
                                                "example_id": "cb1aa4d0-f09a-4be9-9e80-ee444681b459",
                                                "sense_id": "c28c8ca1-a3c9-3690-a9e2-6562b445949a",
                                                "text": "„Aufgelistet sind hier auch die Abkürzungen, die wir im Wörterbuch verwenden, und die wichtigsten grammatischen Fachausdrücke mit einer kurzen Erklärung.“"
                                            },
                                            {
                                                "example_id": "59744a91-8698-4e8d-9488-24f3643a0c40",
                                                "sense_id": "c28c8ca1-a3c9-3690-a9e2-6562b445949a",
                                                "text": "„Er war auf bläuliches Papier geschrieben und zeigte die grossen, länglichen Buchstaben des alten Fürsten und die charakteristischen Abkürzungen, deren er sich zu bedienen pflegte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1826d64-75c5-4af6-8ae5-0237fe5a8a7d",
