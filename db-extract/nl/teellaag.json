                                    {
                                        "sense_id": "0c24250b-6477-3f0b-912b-88229d5fcc42",
                                        "entry_id": "bea2dd25-224d-342f-b956-e6c546038f63",
                                        "glosses": [
                                            "That which soils or pollutes; a stain."
