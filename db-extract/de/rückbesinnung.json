                    }
                ],
                "senses": [
                    {
                        "sense_id": "fb0e930d-4a99-323e-b178-a8457d8a6756",
                        "entry_id": "451fd8b5-8e27-3208-800c-a5a9a8b01c07",
                        "glosses": [
                            "Betrachtung vergangener Ereignisse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72d2706a-3289-4f14-9deb-039326a83bfc",
                                "sense_id": "fb0e930d-4a99-323e-b178-a8457d8a6756",
                                "text": "„Eine solche Rückbesinnung ist heute, da die Glaubensgrundlagen dramatisch im Schwinden sind, dringend nötig.“"
                            },
                            {
                                "example_id": "9c94c42f-921b-4c9f-afcf-2f0b9f43bdd7",
                                "sense_id": "fb0e930d-4a99-323e-b178-a8457d8a6756",
                                "text": "„Die Rückbesinnung auf die Antike im Humanismus brachte auch eine Rückbesinnung auf das Problem der Nachahmung mit sich.“"
                            },
                            {
                                "example_id": "7da445bb-3af7-4929-9fb5-133b7e375710",
                                "sense_id": "fb0e930d-4a99-323e-b178-a8457d8a6756",
                                "text": "„Vielleicht wäre eine Rückbesinnung auf den Auschwitz-Prozess für die Richter am BGH auch in anderer Hinsicht eine wichtige Hilfe bei der Rechtsfindung gewesen.“"
                            },
                            {
                                "example_id": "8d0ec309-2f44-43f2-81b6-ab3af0be0f29",
                                "sense_id": "fb0e930d-4a99-323e-b178-a8457d8a6756",
                                "text": "„Die Frage, ob eine Rückbesinnung auf die Ansätze der Moderne, eine Wiederaufnahme älterer Realismen, zu konstatieren sei oder etwas völlig Neues entstehe, ist derzeitig nicht abschließend zu beurteilen.“"
                            },
                            {
                                "example_id": "f3d795cb-6675-4dcb-9b37-75d91996865b",
                                "sense_id": "fb0e930d-4a99-323e-b178-a8457d8a6756",
                                "text": "„Seit einigen Jahren erleben wir eine Rückbesinnung auf frühere Zeiten, auf Unverfälschtes, Qualität und Nachhaltigkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
