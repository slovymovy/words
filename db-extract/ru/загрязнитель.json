                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pollueur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a7dc4f11-a0d3-3e37-bb1b-551326d37e30",
                                        "entry_id": "ebef27f1-0ba9-3241-88d5-5e15985cf1c2",
                                        "glosses": [
                                            "Qui par son action pollue, souille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97a84664-10da-43fc-8ddd-3d7834c18abd",
                                                "sense_id": "a7dc4f11-a0d3-3e37-bb1b-551326d37e30",
                                                "text": "Un système de récompenses pour les compagnies moins pollueuses qui vendent leurs crédits-carbone non-utilisés à la Bourse pour être achetés par d’autres compagnies qui ont dépassé les limites permises d’émission de gaz à effet de serre et peuvent continuer leurs activités polluantes en achetant ces crédits-carbone."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pollueur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cbfa9173-2acc-3c6b-8e87-bc41c620a5b1",
                                        "entry_id": "514cc121-cf75-3956-94a4-38d01f7386e0",
                                        "glosses": [
                                            "Celui qui pollue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11f7d3f4-8a94-4162-9575-cc9ce8263588",
                                                "sense_id": "cbfa9173-2acc-3c6b-8e87-bc41c620a5b1",
                                                "text": "Il ne suffit pas que le pollueur ait à établir qu’il n’est pas responsable des dégâts causés par ses installations ou son exploitation."
                                            },
                                            {
                                                "example_id": "a07b1d9d-c217-4d84-8aff-d2b6d7c236ab",
                                                "sense_id": "cbfa9173-2acc-3c6b-8e87-bc41c620a5b1",
                                                "text": "Au bout du compte, jeudi, après plusieurs semaines de rudes débats, l’Australie a adopté un plan ciblant les plus gros pollueurs de l’île-continent, dont les géants miniers Rio Tinto ou BHP."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
