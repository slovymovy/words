                "senses": [
                    {
                        "sense_id": "d5ac2f14-465c-3fef-8ecd-364b8b391116",
                        "entry_id": "a623434a-f2a5-384c-bac6-b99c2c8ae070",
                        "glosses": [
                            "Gespann aus Sattelzugmaschine und dem Auflieger (Sattelauflieger)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "666d2993-f472-47ec-b2e1-95fb92fe1de8",
                                "sense_id": "d5ac2f14-465c-3fef-8ecd-364b8b391116",
                                "text": "Ein Sattelzug fuhr an einem Stauende vermutlich ungebremst auf einen Reisebus auf, in dem eine Seniorengruppe aus der Gemeinde Hopsten im nordrhein-westfälischen Landkreis Steinfurt saß."
                            },
                            {
                                "example_id": "97fdf1b3-9819-40fb-969f-0d3884957072",
                                "sense_id": "d5ac2f14-465c-3fef-8ecd-364b8b391116",
                                "text": "Auslöser des Unfalls war ein sich gegen 12 Uhr bildender leichter Rückstau auf der Autobahn. An dessen Ende stand ein 40 Tonnen schwerer polnischer Sattelzug, auf den der Franzose dann auffuhr."
                            },
                            {
                                "example_id": "17405ccf-a409-4d48-8a89-ca2aabe65a06",
                                "sense_id": "d5ac2f14-465c-3fef-8ecd-364b8b391116",
                                "text": "Die Bahn wurde im Personenfernverkehr durch moderne Reisebusse und im Güterverkehr durch Sattelzüge abgelöst."
                            },
                            {
                                "example_id": "b236c1eb-d2d8-44d8-bdcc-b5b56bbe4d8a",
                                "sense_id": "d5ac2f14-465c-3fef-8ecd-364b8b391116",
                                "text": "Um die Verkehrssicherheit zu verbessern, wurden in Richtung Deggendorf ganzjährige Fahrverbote für Sattelzüge und LKW-Gespanne und für LKW ab 3,5 t eine Höchstgeschwindigkeit von 20 km/h eingeführt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
