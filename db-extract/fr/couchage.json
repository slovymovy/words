                    {
                        "sense_id": "ed63d646-2e04-38dd-bc4a-e15260db6ef9",
                        "entry_id": "873f366b-aed5-3f57-aeac-4d58c56667a6",
                        "glosses": [
                            "Procédé consistant à étendre sur une feuille de papier, de tissu ou d’autres matériaux tels que l’aluminium, une ou plusieurs couches d'une préparation à base minérale, cellulosique ou plastique, en vue d’en améliorer les qualités."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "7cdcfb7e-2b31-4e59-8106-b5f396c3c12d",
                                "sense_id": "ed63d646-2e04-38dd-bc4a-e15260db6ef9",
                                "text": "On réalise le papier couché par couchage."
                            }
                        ]
                    },
                    {
                        "sense_id": "237b01b0-cdc5-342c-9da5-26fed122d8bb",
                        "entry_id": "873f366b-aed5-3f57-aeac-4d58c56667a6",
                        "glosses": [
                            "Marcottage."
                        ],
                        "tags": [
                            "Jardinage"
                        ],
                        "examples": [
                            {
                                "example_id": "a356447c-4133-46c4-84de-6840e502c347",
                                "sense_id": "237b01b0-cdc5-342c-9da5-26fed122d8bb",
                                "text": "Malgré son excessive floribondité, elle donne rarement des graines, et on en est réduit à la multiplier de boutures et de couchages."
                            }
                        ]
                    },
                    {
                        "sense_id": "b91bcd26-64b7-35f1-ae2f-f2b578843c17",
                        "entry_id": "873f366b-aed5-3f57-aeac-4d58c56667a6",
                        "glosses": [
                            "Ce qui sert aux soldats ou aux campeurs, pour se coucher."
                        ],
                        "tags": [],
                        "examples": [
                            {
