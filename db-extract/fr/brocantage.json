                        "examples": [
                            {
                                "example_id": "c2a0971b-1061-48e1-a8d6-e19ff128a060",
                                "sense_id": "d1d5fd9f-ba0f-353f-87a0-10c4214df0fe",
                                "text": "La Légion d'honneur vendit la couverture, la charpente, le cuivre, le plomb, les ardoises, les planchers, les portes, les fenêtres, les cheminées, les rampes de fer, et généralement tout ce qui valait quelque chose. Elle tira, dit-on, 200.000 francs de ce brocantage."
                            },
                            {
                                "example_id": "de1464ae-d18b-4a86-af78-692cb85309e9",
                                "sense_id": "d1d5fd9f-ba0f-353f-87a0-10c4214df0fe",
                                "text": "Le brocantage littéraire, la duperie des prix, les compliments officiels et les épigrammes à huis clos n’étaient pas son ragoût."
                            }
                        ]
