                    }
                ],
                "translations": [
                    {
                        "translation_id": "d19991c4-2c76-4588-b1cc-8e330d051ad7",
                        "source_entry_id": "80a60658-e441-342b-8d4f-e2adfda50722",
                        "source_sense_id": "8f71ce5b-f4a1-3260-bebf-ded81c13e876",
                        "target_lang_word": "excess baggage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "excess baggage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "565f5f73-2ea2-3b9d-a540-55a004003cf2",
                                        "entry_id": "6f91cbef-878a-32e4-8fbe-38922804888b",
                                        "glosses": [
                                            "Luggage which exceeds the allowable size or weight (as for an airline flight or train trip), and for which an extra fee must therefore be paid."
                                        ],
                                        "tags": [
                                            "literally",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa308842-703b-4a2d-9489-7138cc962a83",
                                                "sense_id": "565f5f73-2ea2-3b9d-a540-55a004003cf2",
                                                "text": "Watch your weight: Excess baggage is damaging to the wallet. Airlines charge typically from $20 to $30 a kilogram."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a193d0ae-5b91-3ad1-8277-5ebb2c968356",
                                        "entry_id": "6f91cbef-878a-32e4-8fbe-38922804888b",
                                        "glosses": [
                                            "Something or someone not needed or not wanted; something or someone of little use or importance; something or someone considered burdensome."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9241bfc6-9830-4cc5-8a97-b430206533b5",
                                                "sense_id": "a193d0ae-5b91-3ad1-8277-5ebb2c968356",
                                                "text": "Come on, you dog-gone, bullnecked, beetlebrowed, hogjowled, peanutbrained, weaseleyed four flushers, false alarms and excess baggage!"
                                            },
                                            {
                                                "example_id": "afd4e7c9-28a2-45cc-abf3-05527c42aaa3",
                                                "sense_id": "a193d0ae-5b91-3ad1-8277-5ebb2c968356",
                                                "text": "Exiles and refugees . . . are likely to find the old ways and old language excess baggage, especially if their adopted homeland is the U.S., where the race is to the swift and the adaptable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1be5fcc-d1ae-308e-9eb4-71a2ac341805",
                                        "entry_id": "6f91cbef-878a-32e4-8fbe-38922804888b",
                                        "glosses": [
                                            "A dubious or unhelpful mental outlook, emotional disposition, or personal history."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5cb937f4-d47d-44b7-a01d-e3dddf5a167b",
                                                "sense_id": "b1be5fcc-d1ae-308e-9eb4-71a2ac341805",
                                                "text": "A chin-whiskered man in Walla-Walla, carrying a line of hope as excess baggage, had grubstaked us."
                                            },
                                            {
                                                "example_id": "18b5cfe5-234c-4216-b2c3-25cacf04ceb8",
                                                "sense_id": "b1be5fcc-d1ae-308e-9eb4-71a2ac341805",
                                                "text": "The Pirates entered the season lugging no one's expectations as excess baggage."
                                            },
                                            {
                                                "example_id": "edc913e7-4266-4fda-a7f6-02612512f24b",
                                                "sense_id": "b1be5fcc-d1ae-308e-9eb4-71a2ac341805",
                                                "text": "Every candidate for public office probably has some excess baggage to carry around that he'd rather not have. With Sen. John Kerry, it's undoubtedly his anti-Vietnam War activism."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25f1bd6a-b078-4929-aebf-5e45324c3d2a",
                        "source_entry_id": "80a60658-e441-342b-8d4f-e2adfda50722",
                        "source_sense_id": "8f71ce5b-f4a1-3260-bebf-ded81c13e876",
                        "target_lang_word": "Übergepäck",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Übergepäck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "916fb370-79e5-3bd6-b37c-8402006259ae",
                                        "entry_id": "2747ab17-32eb-39c5-b7f9-41e278f6d4e8",
                                        "glosses": [
                                            "Gepäck, das ein bestimmtes Gewicht überschreitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed08beeb-f9dd-4d49-95c1-edd836142058",
                                                "sense_id": "916fb370-79e5-3bd6-b37c-8402006259ae",
                                                "text": "„Die Preise für Übergepäck haben sich teilweise sogar verdoppelt, teilt Lufthansa mit.“"
                                            },
                                            {
                                                "example_id": "93c23c89-d99d-4931-bb45-acdad3587c2d",
                                                "sense_id": "916fb370-79e5-3bd6-b37c-8402006259ae",
                                                "text": "„Am Schalter nebenan versuchen zwei Männer abzuwenden, dass sie Aufpreis für ihr Übergepäck zahlen müssen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
