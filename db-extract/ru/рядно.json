                "senses": [
                    {
                        "sense_id": "e60a041c-3cf2-3773-9095-9d3e3f7d352c",
                        "entry_id": "bfed0f7c-6d86-3f3a-8651-0295a1fef32e",
                        "glosses": [
                            "толстый холст домашнего производства"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "793212a9-26f4-4f2f-a52b-e9a8d39eb10a",
                                "sense_id": "e60a041c-3cf2-3773-9095-9d3e3f7d352c",
                                "text": "Дьячиха шила из грубого рядна мешки."
                            },
                            {
                                "example_id": "8842e8a0-c7b7-4df3-a695-009841d3dda0",
                                "sense_id": "e60a041c-3cf2-3773-9095-9d3e3f7d352c",
                                "text": "Разналыгав быков, Дарья вошла в кухню, положила у порога вчетверо сложенное рядно, поздоровалась с домашними."
                            },
                            {
                                "example_id": "83549874-3554-4d87-b326-0feb34b1c0b1",
                                "sense_id": "e60a041c-3cf2-3773-9095-9d3e3f7d352c",
                                "text": "Деревянная кровать и домотканое рядно, на которых я лежал, уплывали из-под головы так, что ноги летели и летели вверх."
                            }
                        ]
                    }
