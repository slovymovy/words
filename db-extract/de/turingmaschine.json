                "senses": [
                    {
                        "sense_id": "ec1e22ff-3e14-382a-8258-0fb65f74fb19",
                        "entry_id": "153c7a8c-d046-3d88-9f7c-f49e37743611",
                        "glosses": [
                            "Rechnermodell der Theoretischen Informatik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43134b4e-e099-446a-8f56-61996b942023",
                                "sense_id": "ec1e22ff-3e14-382a-8258-0fb65f74fb19",
                                "text": "„Die Turingmaschine kann mit einem Schreib-/Lesekopf auf ein Arbeitsband zugreifen, sie kann dabei Zeichen auf dem Arbeitsband lesen und Zeichen auf das Arbeitsband schreiben.“"
                            },
                            {
                                "example_id": "bbef9f8b-cc96-4f05-9608-1f878c3f4930",
                                "sense_id": "ec1e22ff-3e14-382a-8258-0fb65f74fb19",
                                "text": "„Er sah die Parallele zur abstrakten Turingmaschine und schlussfolgerte, dass die DNA-Polymerase im Wesentlichen genauso vorgeht wie eine Turingmaschine.“"
                            },
                            {
                                "example_id": "2b464be0-1913-44ce-9725-160228b30277",
                                "sense_id": "ec1e22ff-3e14-382a-8258-0fb65f74fb19",
                                "text": "„Mit dem Konzept der „Universellen Maschine“ oder Turingmaschine zur Lösung mathematischer Probleme leistet er 1936, mit nur 24 Jahren, Grundlagenarbeit auf dem Gebiet der Informatik und Künstlichen Intelligenz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c399d366-6a96-4388-a5f2-641e686dfc86",
                        "source_entry_id": "153c7a8c-d046-3d88-9f7c-f49e37743611",
                        "source_sense_id": "ec1e22ff-3e14-382a-8258-0fb65f74fb19",
                        "source_sense_description": "Informatik: Rechnermodell der Theoretischen Informatik",
                        "target_lang_word": "Turing machine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Turing machine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd03b143-899d-305f-8d64-60d8d0b67331",
                                        "entry_id": "0de73a3b-edde-334e-8485-72f4edad27c4",
                                        "glosses": [
                                            "An abstract computing machine that has a finite number of possible internal states and operates on an infinite memory tape by first reading a symbol from a cell in the tape, and then, deterministically, based on that symbol and the machine’s state, writing a symbol in that cell, moving to a neighboring cell, and/or changing state."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85c50101-0c30-4d7f-9a36-b42dc2b814fe",
                                                "sense_id": "fd03b143-899d-305f-8d64-60d8d0b67331",
                                                "text": "Another class, P, is a subset of NP, and includes all decision problems that can be solved by a (deterministic) Turing machine in polynomial time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
