                                        "examples": [
                                            {
                                                "example_id": "610b8b46-61ec-45f0-b40a-18c718d41d5a",
                                                "sense_id": "8869c6d9-e6f4-3baa-929a-79b253460315",
                                                "text": "Bei der starken Hitze sind die Körper verkohlt, und eine Identifizierung wird schwieriger."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0868ac0d-5c42-3e17-9201-5d363607705d",
