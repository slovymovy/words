                                        "sense_id": "d5e6a097-81cd-3280-b182-892c65897ccb",
                                        "entry_id": "213afb0b-9bd5-3c9f-a7e6-2ed4a9296ffd",
                                        "glosses": [
                                            "A scattering."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
