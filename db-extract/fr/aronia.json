                "senses": [
                    {
                        "sense_id": "bb8aabd8-d23a-3526-b8b1-6948c2bcf0df",
                        "entry_id": "16f45ed6-3a74-3b5b-958d-20adc77c4b44",
                        "glosses": [
                            "Genre d'arbuste caducs de la famille des Rosacées, comprenant deux espèces originaires d’Amérique du Nord et à petits fruits globuleux très astringents (Aronia spp.)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ea0bf28-22d1-42ab-a038-96efe38b4729",
                                "sense_id": "bb8aabd8-d23a-3526-b8b1-6948c2bcf0df",
                                "text": "L’évaluation organoleptique de ces confitures a montré que l’addition de sirop de miel de baies d’aronia avait légèrement dégradé la couleur pour les framboises et les fraises."
                            },
                            {
                                "example_id": "89b09c41-fa8f-4359-80c1-015026016a9d",
                                "sense_id": "bb8aabd8-d23a-3526-b8b1-6948c2bcf0df",
                                "text": "Quand Juggie Blue faisait du vin de baies d’aronia, elle lui en donnait systématiquement un pichet pour le tenir à l’écart du bootlegger."
                            }
                        ]
                    },
                    {
                        "sense_id": "43a4839a-4301-33e1-bb39-cb097ec75634",
                        "entry_id": "16f45ed6-3a74-3b5b-958d-20adc77c4b44",
                        "glosses": [
                            "Fruit de cet arbuste."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ddf9283-9b58-4cde-bd71-c737d1251c88",
                        "source_entry_id": "16f45ed6-3a74-3b5b-958d-20adc77c4b44",
                        "target_lang_word": "Apfelbeere",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Apfelbeere",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3ef5fdab-4cec-340c-8352-16540468586f",
                                        "entry_id": "3fedceaa-48c2-36b3-aa30-a08a6145bb93",
                                        "glosses": [
                                            "Pflanze aus der Pflanzengattung (Aronia) der Rosengewächse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba8735d9-057b-4699-a0fe-4b8420f27d8d",
                                                "sense_id": "3ef5fdab-4cec-340c-8352-16540468586f",
                                                "text": "„Im Unterholz wachsen Apfelbeeren, kanadische Büffelbeeren und Weiße Zimthimbeeren.“"
                                            },
                                            {
                                                "example_id": "d0ca7f62-685c-4ccb-9507-e1245daa4a96",
                                                "sense_id": "3ef5fdab-4cec-340c-8352-16540468586f",
                                                "text": "„Die Apfelbeere (Aronia melanocarpa) hat vom Frühjahr bis in den Herbst etwas zu bieten.“"
                                            },
                                            {
                                                "example_id": "01a24765-c8d5-489c-aeff-1a713046f2ba",
                                                "sense_id": "3ef5fdab-4cec-340c-8352-16540468586f",
                                                "text": "„Die aus Nordamerika stammenden Aronia, auch Apfelbeeren genannt, sind kleine bis mittelgroße Sträucher.“"
                                            },
                                            {
                                                "example_id": "11fac071-e5f5-42bd-9a08-7998aa444fdf",
                                                "sense_id": "3ef5fdab-4cec-340c-8352-16540468586f",
                                                "text": "„Die Apfelbeeren wachsen in jedem Kübelsubstrat und vertragen Nässe oder Trockenheit schadlos.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e479356c-2257-39d5-86bd-802e08e8bf8e",
                                        "entry_id": "3fedceaa-48c2-36b3-aa30-a08a6145bb93",
                                        "glosses": [
                                            "Frucht von [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fa9fdbf-095a-4a52-87c0-37fa9f4b37bb",
                                                "sense_id": "e479356c-2257-39d5-86bd-802e08e8bf8e",
                                                "text": "„Er wird aus der Aroniabeere, auch als Apfelbeere bekannt, hergestellt.“"
                                            },
                                            {
                                                "example_id": "40710ae2-b062-4ad4-bb29-7231202756a0",
                                                "sense_id": "e479356c-2257-39d5-86bd-802e08e8bf8e",
                                                "text": "„Das Fruchtfleisch ist ziemlich herb, Apfelbeeren passen aber gut in gemischte Marmeladen oder Mischsäfte, getrocknet schmecken sie im Müsli.“"
                                            },
                                            {
                                                "example_id": "2938fd4f-9969-4472-99f9-591b8d22c61c",
                                                "sense_id": "e479356c-2257-39d5-86bd-802e08e8bf8e",
                                                "text": "„Die Apfelbeere wird vorwiegend nicht frisch, sondern – wie auch die Eberesche – eher verarbeitet gegessen.“"
                                            },
                                            {
                                                "example_id": "cfa6c4e1-e50e-40b6-bbdc-9240c1e4586f",
                                                "sense_id": "e479356c-2257-39d5-86bd-802e08e8bf8e",
                                                "text": "„Hierzulande ist die auch Apfelbeere genannte Frucht noch ziemlich wenig bekannt, wir möchten dazu beitragen, dass sich das ändert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
