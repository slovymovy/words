                                        "sense_id": "8ee19fcd-d414-3be5-9407-9fc4def2e00d",
                                        "entry_id": "c3f521fd-53e3-31bd-a7d9-867c6932ee8d",
                                        "glosses": [
                                            "Equally luminant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f140241e-c5fd-4a8c-a5dc-0cada5865361",
                                                "sense_id": "8ee19fcd-d414-3be5-9407-9fc4def2e00d",
                                                "text": "When visual fields are isoluminant, they look the same to our luminance processing pathway, while potentially looking quite different to the color processing path. This creates a perceptual tension exploited by skilled artists."
                                            },
                                            {
                                                "example_id": "7d9c7158-06c4-46ad-bcfa-8e3a6af9f8e7",
                                                "sense_id": "8ee19fcd-d414-3be5-9407-9fc4def2e00d",
                                                "text": "An isoluminant chromatic display is a color display in which the component colors have been so carefully equated in luminance that they stimulate only color-sensitive perceptual mechanisms and not luminance-sensitive mechanisms."
                                            }
                                        ]
                                    }
                                ]
                            }
