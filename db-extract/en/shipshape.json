                        "translation_id": "e6e02dc4-dffa-48c6-8c29-1d54e96c4fee",
                        "source_entry_id": "048ff5e1-3a27-3792-ad55-56ea71ce3eb3",
                        "source_sense_id": "a87c97bd-522f-3ffd-93b1-c3c514f92689",
                        "source_sense_description": "meticulously neat and tidy",
                        "target_lang_word": "picobello",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "picobello",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a0a63f1c-f5b8-33ac-8e74-083652baf15e",
                                        "entry_id": "37e668d3-b26b-33b9-bfaa-814e4e7a18db",
                                        "glosses": [
                                            "einwandfrei (in Ordnung), vorzüglich"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e570b407-a7e0-44d8-904a-396a24f8e04d",
                                                "sense_id": "a0a63f1c-f5b8-33ac-8e74-083652baf15e",
                                                "text": "„Schließlich will man das Rentnerdasein ja genießen, mit picobello geschorenem Rasen und frisch gestrichenem Lattenzaun ums üppige Anwesen.“"
                                            },
                                            {
                                                "example_id": "a618636e-f0f7-4a1a-875e-a62185bf6710",
                                                "sense_id": "a0a63f1c-f5b8-33ac-8e74-083652baf15e",
                                                "text": "„Polen, mit denen ich durch diese Dörfer fuhr, haben mich immer wieder, halb ehrfürchtig, halb spöttisch, auf die picobello geharkten Vorgärten hingewiesen.“"
                                            },
                                            {
                                                "example_id": "14cad05d-efed-4b0e-96e1-1e5085129890",
                                                "sense_id": "a0a63f1c-f5b8-33ac-8e74-083652baf15e",
                                                "text": "„Die mußten picobello aussehen und glänzen wie Speckschwarten.“"
                                            },
                                            {
                                                "example_id": "959a2049-48e3-49e1-8fd5-fcbc21ba00e6",
                                                "sense_id": "a0a63f1c-f5b8-33ac-8e74-083652baf15e",
                                                "text": "„Sie sollen alle das Haus putzen, es muss picobello sauber sein.“"
                                            },
                                            {
                                                "example_id": "c16264d9-a779-4056-98cd-88f24edc65ec",
                                                "sense_id": "a0a63f1c-f5b8-33ac-8e74-083652baf15e",
                                                "text": "„Es ist nicht immer alles picobello, aber am schönsten ist es, wenn alles picobello ist. Und manchmal, wenn alles geschafft ist, dann ist alles picobello und dann ist Irmi richtig zufrieden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
