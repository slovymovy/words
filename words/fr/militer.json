                    "frequency": "High",
                    "semantic_group_id": "engagement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette association <w>milite</w> pour la protection des espèces menacées depuis plus de dix ans."
                        },
                        {
                            "text": "Elle a décidé de <w>militer</w> activement au sein d'un parti dès son entrée à l'université."
                        }
                    ],
                    "synonyms": [
