                "senses": [
                    {
                        "sense_id": "2068d00c-c4b4-3fa0-9cd1-d94c01022111",
                        "entry_id": "a8411df0-a82c-3fee-b342-cde16b92a430",
                        "glosses": [
                            "weibliche Person, die sich auf übertriebene Weise als fromm präsentiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3aa47d4-a662-462c-b2f7-147a14d7cacd",
                                "sense_id": "2068d00c-c4b4-3fa0-9cd1-d94c01022111",
                                "text": "„Die Hoteliere und der Amtsgerichtsrat lächelten, dann meinte die Frömmlerin, auch eine halbe Stunde sei lang, auch in einer halben Stunde könne vieles geschehen…“"
                            },
                            {
                                "example_id": "e0a0d63b-d6fc-4d0a-b29b-2e91b07caae3",
                                "sense_id": "2068d00c-c4b4-3fa0-9cd1-d94c01022111",
                                "text": "„Da ich bei Tomatis eingeladen war, konnte ich nicht mit der Familie zu Mittag essen; doch in meiner Neugier auf die Frömmlerin sagte ich ihnen, ich würde bei ihnen soupieren und die zusätzlichen Kosten bezahlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e67b60f-fcf6-4583-98e3-202a194f9e55",
                        "source_entry_id": "a8411df0-a82c-3fee-b342-cde16b92a430",
                        "source_sense_id": "2068d00c-c4b4-3fa0-9cd1-d94c01022111",
                        "source_sense_description": "weibliche Person, die sich auf übertriebene Weise als fromm präsentiert",
                        "target_lang_word": "bigote",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bigote",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "601a29c1-75fb-3f4c-8a4d-ba64b7855a53",
                                        "entry_id": "b2218de7-6a91-355e-acb2-1c76507e96f0",
                                        "glosses": [
                                            "Femme ou fille qui affiche une religiosité affectée."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25438910-2a0d-4009-b735-dc437c14b95e",
                                                "sense_id": "601a29c1-75fb-3f4c-8a4d-ba64b7855a53",
                                                "text": "Ne dirait-on pas que je ferai une vieille bigote. J'aime M. le curé, comme je vous aime, vous, faute de mieux ; je ne peux pourtant pas vous épouser."
                                            },
                                            {
                                                "example_id": "f9b17085-b5e1-4976-8ef5-7a059d3c6207",
                                                "sense_id": "601a29c1-75fb-3f4c-8a4d-ba64b7855a53",
                                                "text": "Je ne regardais plus en effet ces demoiselles comme les augustes prêtresses du Savoir mais comme d’assez dérisoires bigotes."
                                            },
                                            {
                                                "example_id": "e57d3973-f0ca-4653-8a3f-37aac62afbff",
                                                "sense_id": "601a29c1-75fb-3f4c-8a4d-ba64b7855a53",
                                                "text": "La bigote habitait au premier étage d'une maison de pierre sur le mur de laquelle une vigne grimpait, porteuse de gros raisins, toujours verts."
                                            },
                                            {
                                                "example_id": "3e1b4200-6f17-4a0e-a6e3-be2d1b1e5ad4",
                                                "sense_id": "601a29c1-75fb-3f4c-8a4d-ba64b7855a53",
                                                "text": "Madame de Maintenon a été l’ultime «abbesse» de Saint-Cyr, parce qu’elle y a apporté l’esprit de dévotion, aisément confondu avec la bigoterie. Les uns l’ont accusée d’être une bigote incorrigible, tandis que d’autres ont essayé de rendre justice à sa dévotion irréprochable."
                                            }
                                        ]
                                    }
                                ]
                            },
