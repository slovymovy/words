{
    "word_family": [
        "expound",
        "expounder"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cf60e190-299c-317d-8aa1-b4a02bc0967a",
                    "sense_definition": "present participle and gerund of <w>expound</w>",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "expound_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor was <w>expounding</w> his new economic theory to a quiet lecture hall.",
                            "target_lang_translations": {
                                "nl": "De professor was zijn nieuwe economische theorie <w>aan het uiteenzetten</w> voor een stille collegezaal."
                            }
                        },
                        {
                            "text": "She spent the afternoon <w>expounding</w> on the subtle themes of the ancient poem.",
                            "target_lang_translations": {
                                "nl": "Ze bracht de middag door met <w>uitweiden over</w> de subtiele thema's van het oude gedicht."
                            }
                        }
                    ],
                    "synonyms": [
                        "explaining",
                        "elucidating",
                        "explicating"
                    ],
                    "common_phrases": [
                        "expounding on"
                    ],
                    "target_lang_definitions": {
                        "nl": "onvoltooid deelwoord en gerundium van 'expound': het gedetailleerd uitleggen of uiteenzetten van een theorie of idee"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "uiteenzetten",
                                "target_lang_sense_clarification": "systematisch uitleggen"
                            },
                            {
                                "target_lang_word": "uitweiden over",
                                "target_lang_sense_clarification": "uitgebreid bespreken"
                            },
                            {
                                "target_lang_word": "toelichten",
                                "target_lang_sense_clarification": "verhelderen of verduidelijken"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "88650705-ad1c-3907-8383-acb843a5682c",
                    "sense_definition": "The act of explaining, clarifying, or interpreting something in detail.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "expound_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His careful <w>expounding</w> of the law helped the jury understand the complex case.",
                            "target_lang_translations": {
                                "nl": "Zijn zorgvuldige <w>uiteenzetting</w> van de wet hielp de jury om de ingewikkelde zaak te begrijpen."
                            }
                        },
                        {
                            "text": "The book is mainly an <w>expounding</w> of traditional philosophical principles.",
                            "target_lang_translations": {
                                "nl": "Het boek is voornamelijk een <w>uiteenzetting</w> van traditionele filosofische principes."
                            }
                        }
                    ],
                    "synonyms": [
                        "explanation",
                        "exposition",
                        "elucidation"
                    ],
                    "target_lang_definitions": {
                        "nl": "De handeling van het gedetailleerd uitleggen, verhelderen of interpreteren van iets."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "uiteenzetting",
                                "target_lang_sense_clarification": "gedetailleerde verklaring of toelichting"
                            },
                            {
                                "target_lang_word": "toelichting",
                                "target_lang_sense_clarification": "verklarende uitleg"
                            },
                            {
                                "target_lang_word": "explicatie",
                                "target_lang_sense_clarification": "formele interpretatie of verklaring"
                            }
                        ]
                    }
