                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e4e82cd6-77d3-4c80-a50d-376afa29cf19",
                        "entry_id": "f8b34317-1744-3ab7-a367-9c6b608d01df",
                        "tags": [
                            "plural"
                        ],
