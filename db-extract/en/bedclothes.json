                                            {
                                                "example_id": "5681f66c-ac5f-467b-acf8-8a6eba626335",
                                                "sense_id": "114f5fee-5c44-3387-852e-b70fbf8061cf",
                                                "text": "Laken, sloop en deken zijn de belangrijkste onderdelen van beddengoed."
                                            },
                                            {
                                                "example_id": "e4936a19-277d-413c-93f8-04ab708bf74b",
                                                "sense_id": "114f5fee-5c44-3387-852e-b70fbf8061cf",
                                                "text": "Dagelijks werd het beddengoed verwisseld en maakten de interieurverzorgsters de kamers schoon."
                                            }
                                        ]
