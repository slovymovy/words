                "senses": [
                    {
                        "sense_id": "3aa39877-0434-35e0-9854-3eee3a1f6aea",
                        "entry_id": "85275a16-99f0-3c63-9cec-e52b44b39afb",
                        "glosses": [
                            "durch dichten Verkehr bedingt nur langsam vorankommende lange Fahrzeugkolonne"
                        ],
                        "tags": [
                            "colloquial",
                            "jocular"
                        ],
                        "examples": [
                            {
                                "example_id": "5afa67f3-d060-4b4c-9b0d-c179e6b50916",
                                "sense_id": "3aa39877-0434-35e0-9854-3eee3a1f6aea",
                                "text": "„Die Blechlawine rollt nicht, sie steht.“"
                            },
                            {
                                "example_id": "6f096278-be4c-4f4c-a582-e082e1380830",
                                "sense_id": "3aa39877-0434-35e0-9854-3eee3a1f6aea",
                                "text": "„Dazu gehörte es, sich, wie alle anderen auch, auf dem Fahrrad halsbrecherisch, alle Verkehrsregeln in den Wind schlagend, durch die Blechlawinen der Stadt zu schlängeln.“"
                            },
                            {
                                "example_id": "10052ff9-994e-4b6a-b1ae-0cd71dbf55da",
                                "sense_id": "3aa39877-0434-35e0-9854-3eee3a1f6aea",
                                "text": "„Eine endlose Blechlawine wälzt sich die Straße entlang.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
