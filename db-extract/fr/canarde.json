                                "example_id": "338be731-03f1-4ff3-95aa-17933ef96c26",
                                "sense_id": "bf562268-fc37-398b-abf3-51ecfbd31687",
                                "text": "Trois hérons et une canarde. 362."
                            },
                            {
                                "example_id": "81edff8c-531c-44f9-a72c-f12e4f960dad",
                                "sense_id": "bf562268-fc37-398b-abf3-51ecfbd31687",
                                "text": "Finalement, une canarde de barbarie passe sa vie impassiblement à hocher de la tête, protestant probablement contre le manque d’eau d’une mare hypothétique."
                            },
                            {
                                "example_id": "a5fef6bf-d395-4b21-8853-67898341aedf",
                                "sense_id": "bf562268-fc37-398b-abf3-51ecfbd31687",
                                "text": "Mais Anatole, un beau matin, rencontra sur l’eau en chemin une canarde à l’air mutin."
                            }
                        ]
                    }
                ],
