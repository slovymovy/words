                "senses": [
                    {
                        "sense_id": "67af9dc7-2c45-374f-8a50-b4e6cc802f4e",
                        "entry_id": "3dfc8dee-ee80-3c8a-9bc1-915ad59e0e21",
                        "glosses": [
                            "Action d’assainir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec102240-7f4d-4593-afb8-adc4c44bd941",
                                "sense_id": "67af9dc7-2c45-374f-8a50-b4e6cc802f4e",
                                "text": "Assainissement d’une ville, d’une écurie, d’une étable."
                            },
                            {
                                "example_id": "1160cd58-843e-499a-bc96-94c08209b9b5",
                                "sense_id": "67af9dc7-2c45-374f-8a50-b4e6cc802f4e",
                                "text": "Assainissement du régime financier."
                            },
                            {
                                "example_id": "fe4f8059-78b0-4290-8bd5-1ac29b158bf3",
                                "sense_id": "67af9dc7-2c45-374f-8a50-b4e6cc802f4e",
                                "text": "L’assainissement de la monnaie."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ebb5d9d-c29a-3ca3-883d-4968c8f3765a",
                        "entry_id": "3dfc8dee-ee80-3c8a-9bc1-915ad59e0e21",
                        "glosses": [
                            "Résultat de cette action."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "050221c7-b645-30ad-84e2-b2212dd6d5d2",
                        "entry_id": "3dfc8dee-ee80-3c8a-9bc1-915ad59e0e21",
                        "glosses": [
                            "Drainage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90fb6176-818d-4e5a-8fc8-dc97f17a1f9a",
                                "sense_id": "050221c7-b645-30ad-84e2-b2212dd6d5d2",
                                "text": "Ajoutons que la plupart de nos prairies humides pourraient être singulièrement améliorées par des travaux d’assainissement collectif que réaliseraient les associations syndicales agricoles […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "c3f145b4-eb55-3c7c-810d-1e4fc663d94b",
                        "entry_id": "3dfc8dee-ee80-3c8a-9bc1-915ad59e0e21",
                        "glosses": [
                            "Structure d'évacuation des eaux usées."
                        ],
                        "tags": [
                            "Urbanisme"
                        ],
                        "examples": [
                            {
                                "example_id": "cefc2b43-4515-4235-a3b5-9dfe1a261fe0",
                                "sense_id": "c3f145b4-eb55-3c7c-810d-1e4fc663d94b",
                                "text": "La redevance unique d’assainissement intégrant l'ensemble de l’assainissement installé serait de 1,24 €/m3."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "950acac8-1590-40d7-97b9-d553be166874",
                        "source_entry_id": "3dfc8dee-ee80-3c8a-9bc1-915ad59e0e21",
                        "source_sense_description": "Action d’assainir",
                        "target_lang_word": "Abwasserreinigung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abwasserreinigung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e93f269f-69e1-37a5-ab05-c862f1497be7",
                                        "entry_id": "d30e2a88-e9f1-3f99-8871-7d049bf92037",
                                        "glosses": [
                                            "Maßnahme, um verschmutztes Wasser aus Haushalten oder der Industrie oder verschmutztes Regenwasser zu klären, meist mit einer Kläranlage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "231b8cf8-7689-4db0-bc8c-5ec793960976",
                                                "sense_id": "e93f269f-69e1-37a5-ab05-c862f1497be7",
                                                "text": "„Feuchttücher sind zu einem Problem bei der Abwasserreinigung geworden. Eigentlich sollen sie sich auflösen. Kläranlagenwärter aber haben andere Erfahrungen gemacht.“"
                                            },
                                            {
                                                "example_id": "349a6fb8-0487-494f-8456-50976b10df7e",
                                                "sense_id": "e93f269f-69e1-37a5-ab05-c862f1497be7",
                                                "text": "„Der Ingenieur Niels Holm beschäftigt sich mit Konzepten für die Abwasserreinigung durch Algen […]“"
                                            },
                                            {
                                                "example_id": "91c0b2db-51d1-4e22-9884-9e9bfee75489",
                                                "sense_id": "e93f269f-69e1-37a5-ab05-c862f1497be7",
                                                "text": "„[…] In Pflanzenkläranlagen filtern Sumpfpflanzen das Abwasser und bieten mit ihren Wurzeln einen Lebensraum für die Bakterienkolonien, die sich auf die mikrobiologische Abwasserreinigung stürzen.“"
                                            },
                                            {
                                                "example_id": "19a801d0-eb16-4fbc-b8a0-dfe601482a1a",
                                                "sense_id": "e93f269f-69e1-37a5-ab05-c862f1497be7",
                                                "text": "„Man hat immer mehr in die Abwasserreinigung investiert, und diese Abwässer dann nicht nur mechanisch gereinigt, sondern auch biologisch-chemisch.“"
                                            },
                                            {
                                                "example_id": "35374ae4-a9ae-4787-9d12-5cd5671f5910",
                                                "sense_id": "e93f269f-69e1-37a5-ab05-c862f1497be7",
                                                "text": "[Jakarta:] „Die Umweltbehörde hinkt den Problemen bei Hochwasserschutz und Abwasserreinigung hinterher.“"
                                            },
                                            {
                                                "example_id": "edf1f945-107a-4d9e-af7f-f1d045a40c8b",
                                                "sense_id": "e93f269f-69e1-37a5-ab05-c862f1497be7",
                                                "text": "„Für die beiden Flüsse Thur und Glatt ist im Kanton St. Gallen ein Ausbau der Abwasserreinigung geplant. Mikroverunreinigungen sollen besser herausgefiltert werden.“"
                                            },
                                            {
                                                "example_id": "9608c21f-81b2-4ce6-8478-e1852cf1a49f",
                                                "sense_id": "e93f269f-69e1-37a5-ab05-c862f1497be7",
                                                "text": "„Eine Quelle, woher das Mikroplastik stammt, steht fest: Eine Waschmaschinenladung mit Kleidung aus Kunstfasern sondert bis zu 700.000 Fasern ab. Die meisten davon entgehen jeder Abwasserreinigung und gelangen in öffentliche Wasserwege.“"
                                            },
                                            {
                                                "example_id": "6bfb09ad-8939-42a8-a9bd-c089e1980415",
                                                "sense_id": "e93f269f-69e1-37a5-ab05-c862f1497be7",
                                                "text": "„\"Es wird sehr schwierig Mikroplastik komplett zu zerstören\", erklärt Bourke. […] solange man die festen Bestandteile der Abwasserreinigung nicht verbrennt, bleibt Mikroplastik wahrscheinlich in der Umwelt.“"
                                            },
                                            {
                                                "example_id": "a567f722-f75f-44d8-979a-0a8b8f99e006",
                                                "sense_id": "e93f269f-69e1-37a5-ab05-c862f1497be7",
                                                "text": "„Die weitere Reinigung kann in Anlehnung an die üblichen Methoden der industriellen Abwasserreinigungen vorgenommen werden.“"
                                            },
                                            {
                                                "example_id": "7ea54623-a632-4a77-ba95-b519a2b19c21",
                                                "sense_id": "e93f269f-69e1-37a5-ab05-c862f1497be7",
                                                "text": "„Allein in Deutschland werden pro Jahr rund 4.400 Gigawattstunden Strom für die Abwasserreinigung verwendet […]“"
                                            },
                                            {
                                                "example_id": "27af9e0e-9a5c-4eca-9665-90ca309cc592",
                                                "sense_id": "e93f269f-69e1-37a5-ab05-c862f1497be7",
                                                "text": "„Der neue Querverbund funktioniert gegenseitig: Energie aus der Kehrichtverbrennung wird für die Abwasserreinigung genutzt. Und im Gegenzug liefert die Abwasserreinigung Biogas, welches bei der Faulung und Trocknung des Klärschlamms anfällt, in das Erdgasnetz von Energie Wasser Bern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2cbf2abd-27d7-4b22-a3b9-73a4cb91a445",
                        "source_entry_id": "3dfc8dee-ee80-3c8a-9bc1-915ad59e0e21",
                        "source_sense_description": "Action d’assainir",
                        "target_lang_word": "Sanierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sanierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e41f85cd-5607-38d4-8f79-e615eabd5bd8",
                                        "entry_id": "4d3b798a-6529-3aff-8732-d64835d830a0",
                                        "glosses": [
                                            "das Wiederherstellen eines geordneten Zustandes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9181db99-55ce-49ff-8dbc-a0117b381863",
                                                "sense_id": "e41f85cd-5607-38d4-8f79-e615eabd5bd8",
                                                "text": "Der Erfolg der Sanierung [des Erdbodens] muss mit geeigneten Messverfahren nachgewiesen werden, evtl. mit wiederkehrenden Messungen (z. B. die dauerhafte Wirksamkeit der Sicherung)."
                                            },
                                            {
                                                "example_id": "1dc8a694-b2ff-490c-a176-78b27fd4ad80",
                                                "sense_id": "e41f85cd-5607-38d4-8f79-e615eabd5bd8",
                                                "text": "„Das mag auch besonders den Zorn Ludwigs XV. erregt haben, der zwar ein recht sündiger Herrscher, doch ein sehr gläubiger König war und zum Schutz des Glaubens jedenfalls während seiner Regierungszeit bedeutend mehr tat als für die Sanierung der französischen Finanzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d63f1ebe-655e-30ee-be11-1637df3f9822",
                                        "entry_id": "4d3b798a-6529-3aff-8732-d64835d830a0",
                                        "glosses": [
                                            "Erneuerung eines Gebäudes oder Bauwerks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0c19f68-99e9-487d-85a5-23321db017f3",
                                                "sense_id": "d63f1ebe-655e-30ee-be11-1637df3f9822",
                                                "text": "Geld braucht Tschechien für die Sanierung seines teils maroden Straßennetzes dringend."
                                            },
                                            {
                                                "example_id": "903e6bce-bb14-46d8-8ec8-f8efe345ed4e",
                                                "sense_id": "d63f1ebe-655e-30ee-be11-1637df3f9822",
                                                "text": "Deshalb ist eine Sanierung mit dem denkmalpflegerischen Erhaltungsanspruch schwer vereinbar."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "400edebb-dbd5-3fbe-99fb-72da2933f26b",
                                        "entry_id": "4d3b798a-6529-3aff-8732-d64835d830a0",
                                        "glosses": [
                                            "das Wiederherstellen der wirtschaftlichen Leistungsfähigkeit eines Betriebes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d20f4e7c-4455-4d85-82c5-f9edc9334b48",
                                                "sense_id": "400edebb-dbd5-3fbe-99fb-72da2933f26b",
                                                "text": "Es fehle aber ein Konzept für eine »nachhaltige Sanierung des Bankensystems«. Welche Folgen das haben kann, zeigt Japan."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
