{
    "word_family": [
        "schoftig",
        "schoftenstreek"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d81bdc7b-8cc8-3819-a191-97bb3f2d94d8",
                    "sense_definition": "Een gemeen of moreel verwerpelijk persoon, meestal een man.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "scheldwoord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Iedereen was opgelucht toen die gemene <w>schoft</w> eindelijk door de politie werd gearresteerd.",
                            "target_lang_translations": {
                                "en": "Everyone was relieved when that mean <w>bastard</w> was finally arrested by the police."
                            }
                        },
                        {
                            "text": "Hij gedroeg zich als een <w>schoft</w> door zijn beste vriend te bedriegen.",
                            "target_lang_translations": {
                                "en": "He behaved like a <w>scoundrel</w> by betraying his best friend."
                            }
                        }
                    ],
                    "synonyms": [
                        "ploert",
                        "rotzak"
                    ],
                    "common_phrases": [
                        "een vuile schoft"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used as an insult or pejorative term."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A mean, despicable, or morally objectionable person, usually a man."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bastard",
                                "target_lang_sense_clarification": "a contemptible, rude, or spiteful person"
                            },
                            {
                                "target_lang_word": "scoundrel",
                                "target_lang_sense_clarification": "a dishonest or unscrupulous person"
                            },
                            {
                                "target_lang_word": "blackguard",
                                "target_lang_sense_clarification": "an unprincipled, contemptible person (dated)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "031f90dc-2968-30b0-9d03-92598fe432b3",
                    "sense_definition": "Het hoogste deel van de rug van een viervoetig dier, gelegen tussen de schouderbladen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De hoogte van een paard wordt altijd gemeten vanaf de grond tot aan de <w>schoft</w>.",
                            "target_lang_translations": {
                                "en": "The height of a horse is always measured from the ground to the <w>withers</w>."
                            }
                        },
                        {
                            "text": "De hond heeft een stevige <w>schoft</w> die goed gespierd is.",
                            "target_lang_translations": {
                                "en": "The dog has a sturdy <w>withers</w> that is well-muscled."
                            }
                        }
                    ],
                    "synonyms": [
                        "schouder"
                    ],
                    "common_phrases": [
                        "hoogte van de schoft"
                    ],
                    "target_lang_definitions": {
                        "en": "The highest part of the back of a four-legged animal, located between the shoulder blades."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "withers",
                                "target_lang_sense_clarification": "the ridge between the shoulder blades of an animal, like a horse"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}