                "senses": [
                    {
                        "sense_id": "964f5146-ce40-3a9b-867b-4a913212a493",
                        "entry_id": "160e05e2-87ea-3354-b33b-462ce052475d",
                        "glosses": [
                            "Fernsehserie, die täglich oder wöchentlich ausgestrahlt wird und eine fortlaufende Handlung besitzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "394673f9-9d23-444d-a9d2-01e948d78287",
                                "sense_id": "964f5146-ce40-3a9b-867b-4a913212a493",
                                "text": "Während meine Freundin sich Soaps ansieht, lese ich die Tageszeitung."
                            },
                            {
                                "example_id": "46c1b40b-201d-415c-873a-6d9b3497a060",
                                "sense_id": "964f5146-ce40-3a9b-867b-4a913212a493",
                                "text": "„Sie habe genug von der Soap, erklärt sie, obwohl sie gar nicht hingesehen hat.“"
                            },
                            {
                                "example_id": "894c435d-dce2-4d15-9a47-d4d88c4989a2",
                                "sense_id": "964f5146-ce40-3a9b-867b-4a913212a493",
                                "text": "„Die durchschnittliche staatlich finanzierte TV-Serie, ob Soap, Heimatfilm, Arztserie oder Krimi, strahlt ein hohes Maß an Vertrauen in den Staat aus, stellt die Gesellschaft als grundsätzlich heil dar und fordert uns nicht zum Nachdenken auf: Alles ist gut, wie es ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "19028a56-67ac-4936-96ff-e7b20c79a4d6",
                        "source_entry_id": "160e05e2-87ea-3354-b33b-462ce052475d",
                        "source_sense_id": "964f5146-ce40-3a9b-867b-4a913212a493",
                        "source_sense_description": "Fernsehserie, die täglich oder wöchentlich ausgestrahlt wird und eine fortlaufende Handlung besitzt",
                        "target_lang_word": "мыло",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "мыло",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ba45b39b-6a94-32be-9106-f4e695bdfe58",
                                        "entry_id": "53672c0a-d7a9-333a-bc4d-07a9a7afdc03",
                                        "glosses": [
                                            "жидкое или пластичное твёрдое моющее средство, изготовленное на основе поверхностно-активных веществ"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f250ac5-d616-4780-96d5-e02997e584a9",
                                                "sense_id": "ba45b39b-6a94-32be-9106-f4e695bdfe58",
                                                "text": "Я намылил руки душистым мылом — мылил долго и тщательно, — затем мыло смыл."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77d5e723-ac1c-3a6f-b418-e5a77e0613bd",
                                        "entry_id": "53672c0a-d7a9-333a-bc4d-07a9a7afdc03",
                                        "glosses": [
                                            "мн. ч., хим. соли высших жирных (С₈–С₁₈), нафтеновых и смоляных кислот; одни из основных моющих средств"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b3dfcbfd-a577-3286-bf70-9b64fbbc23de",
                                        "entry_id": "53672c0a-d7a9-333a-bc4d-07a9a7afdc03",
                                        "glosses": [
                                            "перен. белая пена пота (у разгорячённой лошади)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb980d7d-e356-4f06-aded-956c00185183",
                                                "sense_id": "b3dfcbfd-a577-3286-bf70-9b64fbbc23de",
                                                "text": "Лошади, все в мыле, тёмно-бурой масти, отлично съезженные, широко раскинулись своим фронтом."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72e0fc86-f06f-3fc9-8c71-1d1f64ccf3ea",
                                        "entry_id": "53672c0a-d7a9-333a-bc4d-07a9a7afdc03",
                                        "glosses": [
                                            "жарг. то же, что мыльная опера (телевизионный сериал)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "490b9dfd-66c0-4f1a-ac34-0bb9060cdf66",
                                                "sense_id": "72e0fc86-f06f-3fc9-8c71-1d1f64ccf3ea",
                                                "text": "Не секрет, что на телеэкране мексиканское «мыло» по рейтингу опережает политические передачи."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d49c6e26-4944-33fd-abde-4a47965b53c3",
                                        "entry_id": "53672c0a-d7a9-333a-bc4d-07a9a7afdc03",
                                        "glosses": [
                                            "жарг. нечёткое изображение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a99e7b00-fad1-49e4-9d14-28966cbaf744",
                                                "sense_id": "d49c6e26-4944-33fd-abde-4a47965b53c3",
                                                "text": "Подключение аналоговым кабелем на больших разрешениях при высоком рефреше даёт заметное мыло."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34aa15f5-4183-3908-87b7-d25681a752fd",
                                        "entry_id": "53672c0a-d7a9-333a-bc4d-07a9a7afdc03",
                                        "glosses": [
                                            "фотогр. жарг. то же, что мыльница; компактный фотоаппарат с несъёмным объективом"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
