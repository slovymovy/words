                ],
                "senses": [
                    {
                        "sense_id": "7310d502-1b79-3dd6-8c4c-50a32617f7e3",
                        "entry_id": "f95ad824-8ee0-37e7-8b5e-036da9504041",
                        "glosses": [
                            "Mûrir plus que la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c742fe50-801f-4912-8e52-0427827ccaf6",
                                "sense_id": "7310d502-1b79-3dd6-8c4c-50a32617f7e3",
                                "text": "Au cours de la maturité, les sucres migrent du centre sur la partie médiane puis à la partie périphérique si on laisse surmûrir."
                            },
                            {
                                "example_id": "1234fb09-f628-4c9e-bd00-472aafc7ad4a",
                                "sense_id": "7310d502-1b79-3dd6-8c4c-50a32617f7e3",
                                "text": "Le Gamay n’est récolté que vers le 8 octobre et le Chenin vers le 25, à une époque où les pluies vont revenir et obliger les vignerons à ramasser une vendange qui n’aura pas eu le temps, dans bien des situations, de surmûrir."
                            }
                        ]
                    }
