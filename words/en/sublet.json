{
    "word_family": [
        "subletting",
        "sublessor",
        "sublessee"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2a131900-aad0-37e4-9951-b7ead06bfa27",
                    "sense_definition": "To rent out property that one is currently renting from a landlord to another person.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "renting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The contract does not allow tenants to <w>sublet</w> the apartment to anyone else.",
                            "target_lang_translations": {
                                "ru": "Договор не разрешает жильцам <w>сдавать квартиру в субаренду</w> кому-либо еще."
                            }
                        },
                        {
                            "text": "She decided to <w>sublet</w> her room for the summer while she was traveling abroad.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>пересдать</w> свою комнату на лето, пока будет путешествовать за границей."
                            }
                        }
                    ],
                    "synonyms": [
                        "sublease",
                        "underlet"
                    ],
                    "common_phrases": [
                        "sublet an apartment",
                        "sublet a room"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сдавать в субаренду недвижимость, которую сам снимаешь у арендодателя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сдавать в субаренду",
                                "target_lang_sense_clarification": "передавать арендованное жилье третьему лицу"
                            },
                            {
                                "target_lang_word": "пересдавать",
                                "target_lang_sense_clarification": "разговорное обозначение сдачи в субаренду"
                            },
                            {
                                "target_lang_word": "поднанимать",
                                "target_lang_sense_clarification": "юридический термин, реже в обиходе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "905941fa-fcab-350e-bf38-0b3dccde328e",
                    "sense_definition": "An arrangement where a tenant rents out their leased property to another person.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "renting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They signed a <w>sublet</w> for the remaining three months of the lease.",
                            "target_lang_translations": {
                                "ru": "Они подписали договор <w>субаренды</w> на оставшиеся три месяца аренды."
                            }
                        },
                        {
                            "text": "Finding a legal <w>sublet</w> in this city can be quite difficult.",
                            "target_lang_translations": {
                                "ru": "Найти легальную <w>субаренду</w> в этом городе бывает довольно сложно."
                            }
                        }
                    ],
                    "synonyms": [
                        "sublease",
                        "subtenancy"
                    ],
                    "common_phrases": [
                        "find a sublet",
                        "sign a sublet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соглашение о субаренде или жилье, сдаваемое арендатором другому лицу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "субаренда",
                                "target_lang_sense_clarification": "договор или процесс вторичной аренды"
                            },
                            {
                                "target_lang_word": "поднаем",
                                "target_lang_sense_clarification": "официальное наименование субаренды жилья"
                            },
                            {
                                "target_lang_word": "пересдача",
                                "target_lang_sense_clarification": "разговорное обозначение сделки"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}