                                                "example_id": "0bc69097-db28-426b-bf50-8521e8cd533c",
                                                "sense_id": "08d3369f-5550-3160-b56e-acf466de64ab",
                                                "text": "Diese Diskette hat ein Speichervolumen von 1 440 Kilobyte(s)."
                                            },
                                            {
                                                "example_id": "62c7e6d9-9051-4cd8-877c-a49fbac1191d",
                                                "sense_id": "08d3369f-5550-3160-b56e-acf466de64ab",
                                                "text": "„1 Kilobyte (KByte) müsste demnach 1000 Byte entsprechen, in der Praxis sind es jedoch 1024 Byte. Ein Megabyte (MByte) entspricht ebenfalls nicht 1.000.000 Bytes, sondern 1.048.576 Bytes.“"
                                            }
                                        ],
