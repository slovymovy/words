                    {
                        "sense_id": "3845d4e1-1814-3a95-b90a-554ff70931db",
                        "entry_id": "e1a5b7c8-04f4-3c49-9bc2-989f2ca7d5c7",
                        "glosses": [
                            "Préposé qui est chargé de régler un barrage sur une rivière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb3f03b7-7b3d-4f60-bf7d-05c27cda0587",
                                "sense_id": "3845d4e1-1814-3a95-b90a-554ff70931db",
                                "text": "Dans l’état actuel des choses, le barragiste ne peut être prévenu ni de la crue qui va se produire dans son bief, ni de l’importance de cette crue."
                            },
                            {
                                "example_id": "bccc91c1-0f82-4f33-960d-c96240b14186",
                                "sense_id": "3845d4e1-1814-3a95-b90a-554ff70931db",
                                "text": "Fr… barragiste, 227 fr. de pension."
                            },
                            {
                                "example_id": "522fe199-b258-4976-b288-1babcae6d755",
                                "sense_id": "3845d4e1-1814-3a95-b90a-554ff70931db",
                                "text": "Le père et le fils s’étaient accroupis à l’angle d’une petite maison de pierre, située à l’extrémité du déversoir, où le barragiste enfermait des gaffes, des outils, des engins de batellerie."
                            },
                            {
                                "example_id": "312cc5ff-2841-4411-b848-318a6acc9137",
                                "sense_id": "3845d4e1-1814-3a95-b90a-554ff70931db",
                                "text": "C’est ainsi que des barragistes ont été emportés par le courant pendant des manœuvres d’enlèvement des aiguilles (ce qu’on appelle « dégriller » le barrage), l’eau franchissant les aiguilles et la passerelle supportée par les fermettes."
                            }
                        ]
                    },
                    {
                        "sense_id": "51669f29-ab97-311a-a9e9-4a88c7772d39",
                        "entry_id": "e1a5b7c8-04f4-3c49-9bc2-989f2ca7d5c7",
                        "glosses": [
                            "Concurrent d’une compétition effectuant un match de barrage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6eb405e4-fa0a-48aa-8e2a-a7abe4c11abd",
                                "sense_id": "51669f29-ab97-311a-a9e9-4a88c7772d39",
                                "text": "En cas de victoire contre Colmar-Berg, il sera barragiste en raison d'un meilleur goal-average (+22) par rapport au Claravallis (+1). Le suspense est à son comble."
                            },
                            {
                                "example_id": "418bb88a-50ae-4955-a754-5b93d7030d62",
                                "sense_id": "51669f29-ab97-311a-a9e9-4a88c7772d39",
                                "text": "Les joueurs de Pierre Sage se donnent ainsi un peu d’air, avec trois points d’avance sur la place de barragiste."
                            }
                        ]
                    }
