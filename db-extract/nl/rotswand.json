                "senses": [
                    {
                        "sense_id": "f122d2db-8660-3ab1-a690-aed2cd20d9c3",
                        "entry_id": "31c03a99-d28a-34d4-ba42-9c840b1e3da9",
                        "glosses": [
                            "een zich min of meer loodrecht verheffend deel van een berg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b36269d2-eb1c-46f9-b0df-b7ea730a4aa8",
                                "sense_id": "f122d2db-8660-3ab1-a690-aed2cd20d9c3",
                                "text": "Deze rotswanden zijn een geliefd oefenterrein voor alpinisten."
                            },
                            {
                                "example_id": "64395787-8801-4a76-95ef-ae5f5c092a67",
                                "sense_id": "f122d2db-8660-3ab1-a690-aed2cd20d9c3",
                                "text": "Toen het vlakke plateau overging in een lange steile klim, volgden we ontelbare haarspeldbochten de rotswand op."
                            },
                            {
                                "example_id": "bcb8519c-90a3-4fde-bed3-7816184cea68",
                                "sense_id": "f122d2db-8660-3ab1-a690-aed2cd20d9c3",
                                "text": "De ondergaande zon kleurde de verticale rotswanden goud toen ik de camping van Tuolumne Meadows in Yosemite bereikte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bcbda439-c559-4e8b-90a2-f1ca9fdceed5",
                        "source_entry_id": "31c03a99-d28a-34d4-ba42-9c840b1e3da9",
                        "source_sense_id": "f122d2db-8660-3ab1-a690-aed2cd20d9c3",
                        "source_sense_description": "een zich min of meer loodrecht verheffend deel van een berg",
                        "target_lang_word": "Felswand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Felswand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c16838ef-c8a8-3cb7-bf8b-7817da649edd",
                                        "entry_id": "1b9656d1-d814-3130-94ff-947ce6d42e83",
                                        "glosses": [
                                            "steil aufragender, großflächiger Fels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc1ee647-1fb0-4209-bde5-13a696c52059",
                                                "sense_id": "c16838ef-c8a8-3cb7-bf8b-7817da649edd",
                                                "text": "Am Ende des Tals erhob sich eine unüberwindliche Felswand."
                                            },
                                            {
                                                "example_id": "099d4610-3d3d-469c-98c8-861657ade690",
                                                "sense_id": "c16838ef-c8a8-3cb7-bf8b-7817da649edd",
                                                "text": "„Sie standen aufrecht und wie erstarrt an der Felswand, ihre Finger klammerten sich in die Risse, und ihre Beine waren ohne Kraft.“"
                                            },
                                            {
                                                "example_id": "360a0a13-e34c-41ee-b02e-7a9afe382bd6",
                                                "sense_id": "c16838ef-c8a8-3cb7-bf8b-7817da649edd",
                                                "text": "„Freunde und Profis des Klettersports haben eine neue Möglichkeit, in Berlin an künstlichen Felswänden zu trainieren.“"
                                            },
                                            {
                                                "example_id": "add22e89-2f45-4ce8-9394-988bdf950b9d",
                                                "sense_id": "c16838ef-c8a8-3cb7-bf8b-7817da649edd",
                                                "text": "„Erst am Ende des Tertiärs und insbesondere im Quartär hat sich die Ahr tiefer in das Rumpfgebirge eingeschnitten und auf diese Weise Felswände wie die Engelsley freigelegt.“"
                                            },
                                            {
                                                "example_id": "39f9ddd5-7822-46df-a903-1b27952d53a3",
                                                "sense_id": "c16838ef-c8a8-3cb7-bf8b-7817da649edd",
                                                "text": "„In diesem Moment ging von oben aus der Felswand ein Geschoßhagel auf uns nieder.“"
                                            },
                                            {
                                                "example_id": "b168bd06-ac7a-45ab-b609-1958a8826e55",
                                                "sense_id": "c16838ef-c8a8-3cb7-bf8b-7817da649edd",
                                                "text": "„Aber das Geläut der Kuhglocken wurde überdröhnt vom Lärm der Musikboxen und der Motorräder ohne Auspufftöpfe, deren Geknatter wie Maschinengewehrgarben von den Felswänden widerhallte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
