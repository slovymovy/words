                                        "glosses": [
                                            "Stelle/Unternehmen/Umstand, der ausgenutzt wird, um Geld vom illegalen in den legalen Sektor zu transferieren (waschen)"
                                        ],
                                        "tags": [
                                            "Jargon"
                                        ],
                                        "examples": [
