                    "target_lang_definitions": {
                        "ru": "Тот, кто сбавил тон, отступил или стал покорным, притихшим.",
                        "en": "Having backed down, withdrawn, or become submissive and quiet.",
                        "de": "Eingeschüchtert, kleinlaut oder nachgiebig geworden."
