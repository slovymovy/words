                                                "example_id": "a9cc71fd-d0a5-419e-b5ce-be8af68eea15",
                                                "sense_id": "0e672f5b-9386-3d70-ac13-b31516943de2",
                                                "text": "Spielen wir eine Partie Dame?"
                                            },
                                            {
                                                "example_id": "98d91453-a6d1-49f4-897c-2bb8165c5e42",
                                                "sense_id": "0e672f5b-9386-3d70-ac13-b31516943de2",
