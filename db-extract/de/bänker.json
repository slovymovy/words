                                        "entry_id": "48604123-6dd5-352d-ba13-00f99be40824",
                                        "glosses": [
                                            "A railway locomotive that can be attached to the rear of a train to assist it in climbing an incline."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54cabd62-ceb5-47fb-b3ca-b73912885106",
                                                "sense_id": "4039f10b-e219-3e25-907b-d6121adb8a04",
                                                "text": "Between them these engines work passenger trains on the Keith line, and also act as bankers up to Dava when required."
                                            },
                                            {
                                                "example_id": "650126bb-2c58-4c26-ab0e-706a69213c91",
                                                "sense_id": "4039f10b-e219-3e25-907b-d6121adb8a04",
                                                "text": "Because of a shortage of W.R. pannier tanks, two \"E6\" 0-6-2 tanks, Nos. 32410/5, were engaged as bankers on the Folkestone Harbour branch at the beginning of March; [...]."
                                            }
