                ],
                "senses": [
                    {
                        "sense_id": "a5e24be6-27c9-3145-abc8-e06e6806863d",
                        "entry_id": "041acc8f-d1b2-3ce9-b08b-ac6bb9d66ade",
                        "glosses": [
                            "Kette für Reifen von Fahrzeugen, für das Fortbewegen auf schneebedeckten Straßen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ed05d8b-9527-45d6-b4cb-91922e407ef1",
                                "sense_id": "a5e24be6-27c9-3145-abc8-e06e6806863d",
                                "text": "Der Harz ist im Winter oft nur mit Schneeketten befahrbar."
                            },
                            {
                                "example_id": "9036f7a6-f256-4db7-94e7-977f5de71d96",
                                "sense_id": "a5e24be6-27c9-3145-abc8-e06e6806863d",
                                "text": "„Beim Kauf ist darauf zu achten, dass die Schneeketten zu den Rädern am Auto passen.“"
                            },
                            {
                                "example_id": "f4c75908-e47b-4882-98ea-d09be2981a56",
                                "sense_id": "a5e24be6-27c9-3145-abc8-e06e6806863d",
                                "text": "„Bergpässe waren unpassierbar, 51 Landstraßen waren nur mit Schneeketten zu befahren.“"
                            },
                            {
                                "example_id": "a64cafc4-ce59-4ecf-aa3d-9b1a25bf1f73",
                                "sense_id": "a5e24be6-27c9-3145-abc8-e06e6806863d",
                                "text": "„Kai hatte keine Schneeketten bei sich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c75b9fce-ba00-4027-a9c7-3885e315d622",
                        "source_entry_id": "041acc8f-d1b2-3ce9-b08b-ac6bb9d66ade",
