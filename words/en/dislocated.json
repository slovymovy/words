{
    "word_family": [
        "dislocate",
        "dislocation",
        "dislocator"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "914c7b9d-8bef-343e-9eaf-3ddccaad1026",
                    "sense_definition": "Out of its usual or proper place.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>dislocated</w> bone caused him a great deal of pain until the doctor fixed it.",
                            "target_lang_translations": {
                                "zh": "那块<w>脱臼</w>的骨头让他痛苦不堪，直到医生把它复位。"
                            }
                        },
                        {
                            "text": "The <w>dislocated</w> piece of equipment was found in the wrong storage room.",
                            "target_lang_translations": {
                                "zh": "那件<w>错位</w>的设备在错误的储藏室里被找到了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "misplaced",
                        "displaced"
                    ],
                    "antonyms": [
                        "positioned"
                    ],
                    "target_lang_definitions": {
                        "zh": "指物体或身体部位偏离了正常或应有的位置。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "脱臼的",
                                "target_lang_sense_clarification": "特指关节脱位"
                            },
                            {
                                "target_lang_word": "错位的",
                                "target_lang_sense_clarification": "指物体位置不当"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69e79c7c-489a-3433-adc9-bf47fe5ae4c4",
                    "sense_definition": "Not connected or related to reality or facts.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company's high stock price seems <w>dislocated</w> from its actual financial performance.",
                            "target_lang_translations": {
                                "zh": "这家公司的高股价似乎与其真实的财务表现严重<w>脱节</w>。"
                            }
                        },
                        {
                            "text": "His theories are completely <w>dislocated</w> from the evidence presented in the report.",
                            "target_lang_translations": {
                                "zh": "他的理论与报告中呈现的证据完全<w>脱离</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "disconnected",
                        "detached"
                    ],
                    "antonyms": [
                        "connected"
                    ],
                    "target_lang_definitions": {
                        "zh": "指与现实或事实脱节，缺乏联系。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "脱节的",
                                "target_lang_sense_clarification": "指与现实或逻辑不符"
                            },
                            {
                                "target_lang_word": "脱离的",
                                "target_lang_sense_clarification": "指与事实失去联系"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2d478a7c-c175-300f-a140-a7b5eeaaed37",
                    "sense_definition": "Simple past and past participle of <w>dislocate</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>dislocated</w> his shoulder while playing football yesterday.",
                            "target_lang_translations": {
                                "zh": "他昨天踢足球时把肩膀<w>弄脱臼</w>了。"
                            }
                        },
                        {
                            "text": "She has <w>dislocated</w> her finger twice this season.",
                            "target_lang_translations": {
                                "zh": "这个赛季她的手指已经<w>脱臼</w>过两次了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb dislocate."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使关节脱位，或使物体偏离原位。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "脱臼",
                                "target_lang_sense_clarification": "指关节脱位"
                            },
                            {
                                "target_lang_word": "使错位",
                                "target_lang_sense_clarification": "指导致物体位置偏移"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}