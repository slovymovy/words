                                                "sense_id": "b6b30aa6-f372-3627-a208-d64c68de298b",
                                                "text": "The hotel coffee machine gurgles out an acrid belch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25268fc3-38d1-3340-b54f-04e4d0f0c875",
                                        "entry_id": "68bfac01-288e-30fc-9313-94696edf69a7",
                                        "glosses": [
                                            "Malt liquor."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d31f0bb4-90d5-44d9-8fed-90dd8e6e3a9a",
                                                "sense_id": "25268fc3-38d1-3340-b54f-04e4d0f0c875",
                                                "text": "c. 1699, John Dennis, letter to Mr. Collier\nPorters would no longer be drunk with Belch"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e09d4669-f985-4168-b949-f0342f472fa2",
                        "source_entry_id": "3e9ca859-dc7d-3ef9-8036-614b37ddf783",
                        "source_sense_id": "9978ead5-fe11-3a81-951d-73dae7d9868c",
                        "source_sense_description": "Geräusch des Entweichens von Luft aus der Speiseröhre durch den Mund",
                        "target_lang_word": "rot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6a844fde-10a2-3cdc-a1f6-b7c830263409",
                                        "entry_id": "badac828-68ba-33d7-ae8e-0e9e5f116cae",
                                        "glosses": [
                                            "Émission par la bouche, et avec bruit, de gaz stomacaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "261b0e59-6d49-473c-bdcb-8a06d35ef82a",
                                                "sense_id": "6a844fde-10a2-3cdc-a1f6-b7c830263409",
                                                "text": "Et comme les fumées du vin se mêlaient aux nuages de la tristesse et les rots de l’ivresse aux hoquets des sanglots, penché du côté de Protos, il commença par rendre son déjeuner, puis raconta confusément la soirée avec Carola et le deuil de son pucelage."
                                            },
                                            {
                                                "example_id": "9ffddb9d-289d-4bf3-bcad-26263b8ffa45",
                                                "sense_id": "6a844fde-10a2-3cdc-a1f6-b7c830263409",
                                                "text": "Il [Fats Waller] avale le contenu du verre d’un seul coup et fait claquer sa langue. Puis il lâche un formidable rot dans le micro : « Attendez, dit-il, ce n’est pas encore ça… Patience, nous y voilà ! » Suivent deux ou trois rots encore plus profonds et accompagnés de yes amusés."
                                            },
                                            {
                                                "example_id": "c9d2f847-4ab7-44c9-bd6d-28ea70048bbe",
                                                "sense_id": "6a844fde-10a2-3cdc-a1f6-b7c830263409",
                                                "text": "L’Américain lâcha un rot sonore et tomba assis sur la chaise."
                                            },
                                            {
                                                "example_id": "16b5e3c9-3dc2-476f-93fb-20ff03b82e7b",
                                                "sense_id": "6a844fde-10a2-3cdc-a1f6-b7c830263409",
                                                "text": "Surtout tiens le biberon en hauteur pour que Christine n’avale pas d’air en buvant. Et, quand elle aura fini, n’oublie pas de la redresser pour qu’elle fasse son petit rot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "838516d6-cbbe-3e92-8aee-cd1387b4d63b",
                                        "entry_id": "badac828-68ba-33d7-ae8e-0e9e5f116cae",
                                        "glosses": [
                                            "Cri du chevreuil mâle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc903964-febf-4a8b-a2f7-8e1bdce0a8cf",
                                                "sense_id": "838516d6-cbbe-3e92-8aee-cd1387b4d63b",
                                                "text": "Il s’agit d’émettre le rot ou le grognement guttural d’un mâle qui lance un défi à un autre mâle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
