    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d6b3c395-d96c-36ad-bbcb-6b1337acf2f3",
                    "sense_definition": "een mondelinge of schriftelijke reactie op een vraag",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "communicatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wie weet het juiste <w>antwoord</w> op deze moeilijke vraag?",
                            "target_lang_translations": {
                                "en": "Who knows the correct <w>answer</w> to this difficult question?",
                                "ru": "Кто знает правильный <w>ответ</w> на этот трудный вопрос?"
                            }
                        },
                        {
                            "text": "Ik wacht al drie dagen op een <w>antwoord</w> op mijn e-mail.",
                            "target_lang_translations": {
                                "en": "I have been waiting for three days for a <w>reply</w> to my email.",
                                "ru": "Я жду <w>ответа</w> на свою электронную почту уже три дня."
                            }
                        }
                    ],
                    "synonyms": [
                        "repliek",
                        "reactie"
                    ],
                    "common_phrases": [
                        "het juiste antwoord",
                        "een duidelijk antwoord"
                    ],
                    "target_lang_definitions": {
                        "en": "a spoken or written response to a question",
                        "ru": "устный или письменный отклик на вопрос"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "answer",
                                "target_lang_sense_clarification": "a response to a question"
                            },
                            {
                                "target_lang_word": "reply",
                                "target_lang_sense_clarification": "a written or spoken response"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ответ",
                                "target_lang_sense_clarification": "реакция на вопрос"
                            },
                            {
                                "target_lang_word": "реплика",
                                "target_lang_sense_clarification": "краткий ответ или возражение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64d4a0e2-2feb-3edb-81a6-fc8a011b7108",
                    "sense_definition": "een oplossing voor een gesteld probleem of een moeilijke situatie",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "oplossing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De regering had nog geen goed <w>antwoord</w> op dit complexe probleem kunnen vinden.",
                            "target_lang_translations": {
                                "en": "The government had not yet been able to find a good <w>answer</w> to this complex problem.",
                                "ru": "Правительство еще не смогло найти хорошего <w>решения</w> этой сложной проблемы."
                            }
                        },
                        {
                            "text": "Dit nieuwe beleid is een <w>antwoord</w> op de groeiende ongelijkheid in de stad.",
                            "target_lang_translations": {
                                "en": "This new policy is a <w>response</w> to the growing inequality in the city.",
                                "ru": "Эта новая политика является <w>ответом</w> на растущее неравенство в городе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een goed antwoord",
                        "geen antwoord hebben"
                    ],
                    "target_lang_definitions": {
                        "en": "a solution to a stated problem or a difficult situation",
                        "ru": "решение поставленной проблемы или сложной ситуации"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "answer",
                                "target_lang_sense_clarification": "a solution to a problem"
                            },
                            {
                                "target_lang_word": "solution",
                                "target_lang_sense_clarification": "a way of solving a problem"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ответ",
                                "target_lang_sense_clarification": "решение задачи или проблемы"
                            },
                            {
                                "target_lang_word": "решение",
                                "target_lang_sense_clarification": "способ устранения проблемы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d95ad05-41b0-3934-8ad9-fca57fa4f7ed",
                    "sense_definition": "een reactie op een actie of een zet van iemand anders",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reactie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op die slimme zet van de tegenstander had ik helaas geen <w>antwoord</w>.",
                            "target_lang_translations": {
                                "en": "Unfortunately, I had no <w>answer</w> to that clever move by the opponent.",
                                "ru": "На тот умный ход противника у меня, к сожалению, не было <w>ответа</w>."
                            }
                        },
                        {
                            "text": "De aanval van het leger was een direct <w>antwoord</w> op de provocatie.",
                            "target_lang_translations": {
                                "en": "The army's attack was a direct <w>response</w> to the provocation.",
                                "ru": "Атака армии была прямым <w>ответом</w> на провокацию."
                            }
                        }
                    ],
                    "common_phrases": [
                        "geen antwoord hebben"
                    ],
                    "target_lang_definitions": {
                        "en": "a reaction to an action or a move by someone else",
                        "ru": "реакция на действие или ход другого человека"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "response",
                                "target_lang_sense_clarification": "a reaction to an action"
                            },
                            {
                                "target_lang_word": "answer",
                                "target_lang_sense_clarification": "something done in reaction to a move"
                            },
                            {
                                "target_lang_word": "counter",
                                "target_lang_sense_clarification": "a move made in opposition to another"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ответ",
                                "target_lang_sense_clarification": "встречное действие"
                            },
                            {
                                "target_lang_word": "реакция",
                                "target_lang_sense_clarification": "отклик на внешнее воздействие"
                            },
                            {
                                "target_lang_word": "контрмера",
                                "target_lang_sense_clarification": "действие в ответ на провокацию или атаку"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0ccf8c62-0d1c-38ac-9f31-aca032b09178",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>antwoorden</w>",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>antwoord</w> altijd direct als ik een berichtje van je krijg.",
                            "target_lang_translations": {
                                "en": "I always <w>answer</w> immediately when I get a message from you.",
                                "ru": "Я всегда сразу <w>отвечаю</w>, когда получаю от тебя сообщение."
                            }
                        },
                        {
                            "text": "Wanneer de leraar mij iets vraagt, <w>antwoord</w> ik beleefd.",
                            "target_lang_translations": {
                                "en": "When the teacher asks me something, I <w>reply</w> politely.",
                                "ru": "Когда учитель меня о чем-то спрашивает, я вежливо <w>отвечаю</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present indicative"
                        }
                    ],
                    "target_lang_definitions": {
