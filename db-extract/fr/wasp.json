            {
                "entry_id": "ec3e8bb6-332c-34ef-9b98-b12c270ccc99",
                "word": "WASP",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "81e1a145-e7a0-33fd-9487-eecbf2748efd",
                        "entry_id": "ec3e8bb6-332c-34ef-9b98-b12c270ccc99",
                        "glosses": [
                            "Blanc d’origine anglaise protestante émigré aux États-Unis ou au Canada."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "260cab0c-4414-41cb-ac68-27eb95e9dc0f",
                                "sense_id": "81e1a145-e7a0-33fd-9487-eecbf2748efd",
                                "text": "Bien entendu, Kenneth est froid comme un Anglais, blême comme un WASP et fier tel un plafond."
                            },
                            {
                                "example_id": "0e0a4f54-f1c5-433a-b17a-6309cbd54b62",
                                "sense_id": "81e1a145-e7a0-33fd-9487-eecbf2748efd",
                                "text": "Pandy n’avait rien d’une huguenote du Mayflower, d’une WASP."
                            },
                            {
                                "example_id": "d7ed813f-e1c5-477b-9cc8-168b22f8c7ee",
                                "sense_id": "81e1a145-e7a0-33fd-9487-eecbf2748efd",
                                "text": "Longtemps, l’Amérique fut exclusivement dominée par les WASP, les White Anglo-Saxon Protestants, dont le modèle était d’être scotchés au scotch."
                            },
                            {
                                "example_id": "5473e0f8-b0ff-4b0c-92f4-038e7813be9e",
                                "sense_id": "81e1a145-e7a0-33fd-9487-eecbf2748efd",
                                "text": "Les « falangistes » de Trump se voient comme une petite armée de guerriers luttant pour assurer la survie des États-Unis en tant qu’état WASP (blanc, anglo-saxon, protestant)."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
        "it-extract.jsonl": [],
        "de-extract.jsonl": [
