                    {
                        "form_id": "1f20ca44-48ca-4cf1-86de-8fa797ecd2b6",
                        "entry_id": "92dfb2ae-2c34-342c-a847-68a28d56699d",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Leiharbeit"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8630339b-9611-3dcd-a971-1d524b69ad2c",
                        "entry_id": "92dfb2ae-2c34-342c-a847-68a28d56699d",
                        "glosses": [
                            "entgeltliche Überlassung eines Arbeitnehmers für eine bestimmte Zeit an einen Dritten, der keine vertragliche Beziehung zum Arbeitnehmer hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f0d6178-f848-45c9-9d99-753e51e204e2",
                                "sense_id": "8630339b-9611-3dcd-a971-1d524b69ad2c",
                                "text": "„Wenn das so ist, sollen die Arbeitgeber ehrlich sagen, dass Leiharbeit ein Instrument ist, um die Lohnkosten zu senken. Bis jetzt hören wir ja immer nur, Leiharbeit sei ein Instrument zur Flexibilisierung.“"
                            },
                            {
                                "example_id": "ba838ff8-47e9-4c59-a665-f722483cdb47",
                                "sense_id": "8630339b-9611-3dcd-a971-1d524b69ad2c",
                                "text": "Misslich für die städtischen Kliniken ist auch, dass sie in hohem Maß auf Leiharbeit zurückgreifen müssen. Die Ausgaben für Ärzte, die auf Honorarbasis beschäftigt werden, sind nämlich in der Regel deutlich höher als bei angestellten Medizinern."
                            },
                            {
                                "example_id": "fb0b9c7c-b47f-4a72-9fa4-f4ddcd05b8e2",
                                "sense_id": "8630339b-9611-3dcd-a971-1d524b69ad2c",
                                "text": "Leiharbeit boomt in Deutschland, dank guter Konjunktur. Die Nachfrage der Wirtschaft nach Arbeitskräften, die für einen begrenzten Zeitraum von Zeitarbeitsfirmen an andere Unternehmen verliehen werden, stieg allein im vergangen Jahr um bis zu 20 Prozent."
                            },
                            {
                                "example_id": "d06b5ba5-3116-4109-9048-5e23a7512c78",
                                "sense_id": "8630339b-9611-3dcd-a971-1d524b69ad2c",
                                "text": "Zum 1. Mai ruft der Deutsche Gewerkschaftsbund unter anderem zum Kampf gegen Leiharbeit und Lohndumping auf."
                            },
                            {
                                "example_id": "e4a1c73c-3a55-4135-85f7-75098bfe8f88",
                                "sense_id": "8630339b-9611-3dcd-a971-1d524b69ad2c",
                                "text": "Hat die Leiharbeit als arbeitsmarktpolitisches Instrument versagt?"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
