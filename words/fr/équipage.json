            "senses": [
                {
                    "sense_id": "8b4f1272-76bf-3281-81db-8c5ba0d39ec3",
                    "sense_definition": "Ensemble du personnel qui assure le service et la manœuvre d'un navire.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "personnel_de_bord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le capitaine a félicité tout son <w>équipage</w> après cette longue et difficile traversée."
                        },
                        {
                            "text": "Les marins de l'<w>équipage</w> préparent soigneusement le navire avant de quitter le port."
                        }
                    ],
                    "synonyms": [
                        "personnel"
                    ],
                    "common_phrases": [
                        "équipage navigant"
                    ]
                },
                {
                    "sense_id": "d55bb952-9e6e-3581-bfc4-faa91c066bf7",
                    "sense_definition": "Personnel à bord d'un aéronef ou d'un engin spatial assurant son pilotage et la sécurité des passagers.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "personnel_de_bord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>équipage</w> de cabine a accueilli chaleureusement tous les passagers à bord de l'avion."
                        },
                        {
                            "text": "Le commandant et son <w>équipage</w> effectuent les dernières vérifications techniques avant le décollage."
                        }
                    ],
                    "synonyms": [
                        "personnel de bord"
                    ],
                    "common_phrases": [
                        "équipage de cabine",
                        "équipage de bord"
                    ]
                },
                {
                    "sense_id": "22e931af-7da3-3677-9f22-54fa936055e6",
                    "sense_definition": "Ensemble des personnes formant une équipe à bord d'un même véhicule lors d'une compétition sportive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet <w>équipage</w> français a remporté le rallye après une course particulièrement difficile."
                        },
                        {
                            "text": "Chaque <w>équipage</w> doit être composé d'un pilote et d'un copilote expérimentés."
