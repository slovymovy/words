                    }
                ],
                "senses": [
                    {
                        "sense_id": "4d8d2e0a-7e79-3ca5-86ac-5635ea75afc4",
                        "entry_id": "5b410761-42e8-3bc1-aa9f-00c8eea6b229",
                        "glosses": [
                            "een beschrijving van het eigen leven."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d8ad343-8e28-43a4-8879-a5228530ea2c",
                                "sense_id": "4d8d2e0a-7e79-3ca5-86ac-5635ea75afc4",
                                "text": "De beroemde acteur schreef een autobiografie."
                            },
                            {
                                "example_id": "65909221-dfbd-4fbb-a338-5e0dcec0256e",
                                "sense_id": "4d8d2e0a-7e79-3ca5-86ac-5635ea75afc4",
                                "text": "Een autobiografie kan zeer belangwekkende informatie bevatten maar is vaak weinig objectief."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "efee0381-9993-47fc-b467-57c32dd0c2d8",
                        "source_entry_id": "5b410761-42e8-3bc1-aa9f-00c8eea6b229",
                        "source_sense_id": "4d8d2e0a-7e79-3ca5-86ac-5635ea75afc4",
                        "target_lang_word": "Autobiografie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Autobiografie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ac93a68b-e0e5-3e6d-af07-5319559c140b",
                                        "entry_id": "a4d0508f-0156-3f4d-8aad-b6cc5e6cb6d2",
                                        "glosses": [
                                            "Lebensbeschreibung einer Person, die von dieser Person selbst verfasst wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af386768-824e-4970-81d9-eecd0aa305df",
                                                "sense_id": "ac93a68b-e0e5-3e6d-af07-5319559c140b",
                                                "text": "Viele prominente Personen schreiben Autobiografien, z. B. Dieter Bohlen, welchem jedoch ein Ghostwriter zur Seite stand, der ihn beim Schreiben unterstützte."
                                            },
                                            {
                                                "example_id": "1859bc46-33e6-41ae-b3de-01514121189c",
                                                "sense_id": "ac93a68b-e0e5-3e6d-af07-5319559c140b",
                                                "text": "„Nachdem ich die Kurzfassung meiner Autobiografie beendet hatte, war ich nicht mehr derselbe.“"
                                            },
                                            {
                                                "example_id": "bfa0ab95-4e87-42cd-b7d6-0e8310ab6628",
                                                "sense_id": "ac93a68b-e0e5-3e6d-af07-5319559c140b",
                                                "text": "„In seiner Autobiografie wird er später behaupten, er sei an diesem Tag auch Regent geworden – eine Interpretation, die er in den folgenden Jahren gegen die konservativen Kräfte im Land durchsetzt.“"
                                            },
                                            {
                                                "example_id": "a36fdf8e-ae7f-4205-adcc-d5c2b33273b3",
                                                "sense_id": "ac93a68b-e0e5-3e6d-af07-5319559c140b",
                                                "text": "„Ich schreibe Autobiografien für andere Menschen, ich bin das gewöhnt, und bislang war mir das ganz recht so.“"
                                            },
                                            {
                                                "example_id": "a6e1ed63-a982-4170-8191-660d6cf712df",
                                                "sense_id": "ac93a68b-e0e5-3e6d-af07-5319559c140b",
                                                "text": "„Auch seine Autobiografie gibt kaum detaillierte Auskunft über seine negativen Erlebnisse, seine Desillusionierung über Missionare in Deutschland zeigte er auch darin nicht deutlich.“"
                                            },
                                            {
                                                "example_id": "94800075-03a9-40bd-ae5d-ada0ed3ae8e4",
                                                "sense_id": "ac93a68b-e0e5-3e6d-af07-5319559c140b",
                                                "text": "„Baber berichtet darüber in seiner Autobiografie, die ein literarisches Meisterwerk ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aec056af-ab48-4fe4-9142-cf7d2875311c",
                        "source_entry_id": "5b410761-42e8-3bc1-aa9f-00c8eea6b229",
                        "source_sense_id": "4d8d2e0a-7e79-3ca5-86ac-5635ea75afc4",
                        "target_lang_word": "autobiography",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autobiography",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84011da9-e72e-361f-a511-a39ebae0d407",
                                        "entry_id": "9c65ebde-1093-3cb8-a997-1113e25187ef",
                                        "glosses": [
                                            "A self-written biography; the story of one's own life."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b6d5db2-e074-4e8a-8cf5-f1944fef92ad",
                                                "sense_id": "84011da9-e72e-361f-a511-a39ebae0d407",
                                                "text": "Autobiography […] inevitably consists mainly of extinctions of the truth, shirkings of the truth, partial revealments of the truth, with hardly an instance of plain straight truth […]"
                                            },
                                            {
                                                "example_id": "ff27b14d-75e1-4e4a-a6d8-085d51c38fbd",
                                                "sense_id": "84011da9-e72e-361f-a511-a39ebae0d407",
                                                "text": "Here I was interrupted, as I'm so often interrupted when giving my views on the Yeoman's Wedding Song, by her saying that she was dying to hear all about it but would rather wait till she could get it in my autobiography."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b8f1c8d-2762-3763-8c74-9cdd2903599e",
                                        "entry_id": "9c65ebde-1093-3cb8-a997-1113e25187ef",
                                        "glosses": [
                                            "Biographies of this kind regarded as a literary genre."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8586efa7-44fb-4602-970d-61b333fb2a48",
                        "source_entry_id": "5b410761-42e8-3bc1-aa9f-00c8eea6b229",
