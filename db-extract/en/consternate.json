                "translations": [
                    {
                        "translation_id": "24228062-3a51-402c-9d6a-8ec8c2601c98",
                        "source_entry_id": "b438fc5f-f970-31e9-8d51-01782f4a41b6",
                        "source_sense_id": "7e3d34b0-164f-3318-b4fd-da535f854547",
