                "senses": [
                    {
                        "sense_id": "8c53990a-a94f-38d9-ad60-1a8092e2f460",
                        "entry_id": "d0d6d2da-450d-3f5e-9967-1c16d26daf3d",
                        "glosses": [
                            "een boekje, veelal in gedrukte vorm, van geringe omvang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a96fd83a-f76d-47fb-99ab-de34c5442571",
                                "sense_id": "8c53990a-a94f-38d9-ad60-1a8092e2f460",
                                "text": "Er zijn zelfs speciale agentschappen om hondenzaken waar te nemen. Bij bureau Animal Actors scheppen ze op over viervoetige cliënten met rollen in True Grit en No Country for Old Men. Agentschap Hollywood Paws heeft een brochure: How to Make Your Pet a Star."
                            },
                            {
                                "example_id": "9171db23-3f4e-410e-b5f5-dd5f3af4ef4e",
                                "sense_id": "8c53990a-a94f-38d9-ad60-1a8092e2f460",
                                "text": "Chantal keek nu met meer dan met een half oog naar de brochure die op zijn schoot lag."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "316fa462-671f-4400-9f05-a62b9a1a9675",
                        "source_entry_id": "d0d6d2da-450d-3f5e-9967-1c16d26daf3d",
                        "source_sense_id": "8c53990a-a94f-38d9-ad60-1a8092e2f460",
                        "target_lang_word": "Broschüre",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Broschüre",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "72f2ef35-113c-3608-a5f2-cd2586ad2574",
                                        "entry_id": "97b22e35-f2ce-34ea-8fcc-ecf0b9fae3e7",
                                        "glosses": [
                                            "kleine, geheftete, nicht gebundene Schrift mit wenigen Seiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d4610d6-72b3-40be-9cb5-8b1666c61c73",
                                                "sense_id": "72f2ef35-113c-3608-a5f2-cd2586ad2574",
                                                "text": "Beim Verlassen der Werbeveranstaltung drückten sie mir noch eine Broschüre in die Hand."
                                            },
                                            {
                                                "example_id": "cc325087-558d-4c19-af33-52e5ee24fad6",
                                                "sense_id": "72f2ef35-113c-3608-a5f2-cd2586ad2574",
                                                "text": "„Da gab es eine Broschüre über Mesmerismus, die allem Anschein nach reichlich oft benutzt worden war.“"
                                            },
                                            {
                                                "example_id": "2594b7cc-1721-413e-abc4-c6064a1661ec",
                                                "sense_id": "72f2ef35-113c-3608-a5f2-cd2586ad2574",
                                                "text": "„Regelmäßig waren in konservativen Zeitungen, in Broschüren und auf ‚patriotischen‘ Abendversammlungen Tiraden zu hören.“"
                                            },
                                            {
                                                "example_id": "a00cba18-d853-41cf-8c77-db380aa67847",
                                                "sense_id": "72f2ef35-113c-3608-a5f2-cd2586ad2574",
                                                "text": "„Manchmal spielte im Eingang, wo sich die Büchertische mit Broschüren und Raubdrucken drängten, eine Flöte oder Gitarre, ihre melancholischen Melodien gingen alsbald im Stimmengewirr unter.“"
                                            },
                                            {
                                                "example_id": "cdc339ee-4cbe-4e8b-8f62-3dafbd0f84b6",
                                                "sense_id": "72f2ef35-113c-3608-a5f2-cd2586ad2574",
                                                "text": "„Bei den meisten handelte es sich um kleine Broschüren oder Einblattdrucke zu Unterhaltung und Zeitvertreib.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60fe59b8-69e8-4f77-96a8-9878cd5e9cc6",
                        "source_entry_id": "d0d6d2da-450d-3f5e-9967-1c16d26daf3d",
                        "source_sense_id": "8c53990a-a94f-38d9-ad60-1a8092e2f460",
