                                "example_id": "8637fde4-bedd-4355-b924-d95fabaeb74c",
                                "sense_id": "feae3258-b1cc-3b95-a84b-66ecaf843347",
                                "text": "A wise son heeds his father’s instruction, but a scoffer does not listen to rebuke",
                                "translation": "El hijo sabio recibe el consejo del padre, pero el insolente no escucha las reprensiones"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
