                    "frequency": "Low",
                    "semantic_group_id": "medycyna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lekarz zauważył, że zachowanie pacjenta przypominało reakcje typowe dla <w>maniaka</w>.",
