                        "overdragen"
                    ],
                    "common_phrases": [
                        "een boodschap meegeven",
                        "een advies meegeven"
                    ],
                    "target_lang_definitions": {
                        "en": "to pass on advice, a message, or a lesson for someone to think about"
                    },
                    "translations": {
