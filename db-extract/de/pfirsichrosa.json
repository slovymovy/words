                        "glosses": [
                            "in einem rosa Farbton, der an Pfirsiche erinnert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aed30f71-44b9-48fa-84ae-8779819d421f",
                                "sense_id": "5755b6fa-1a80-3db4-95e7-64e9886c2e47",
                                "text": "„Da springt der Hai aus dem Wasser, fliegt über unsere Köpfe hinweg, als wären seine Flossen Flügel. Wir kriegen alle ganz große Augen, als wir sehen, dass seine Unterseite pfirsichrosa ist und er menschliche Brüste hat.“"
                            }
