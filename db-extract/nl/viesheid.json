                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9aeef58f-1224-3797-9597-f0fe46bd55ec",
                                        "entry_id": "f6524f0b-e1a1-3622-8fa2-c949b9fbaff0",
                                        "glosses": [
                                            "Of food, indulgent in an unhealthy way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d280c1c-1fc8-4807-9447-db1bd28a8adb",
                                                "sense_id": "9aeef58f-1224-3797-9597-f0fe46bd55ec",
                                                "text": "You can call it quick-and-dirty if you like, but there are billions of dollars out there riding on the supposition that fast food is not necessarily dirty food."
                                            },
                                            {
                                                "example_id": "6fbb4055-7e45-4056-aded-d812c31249d3",
                                                "sense_id": "9aeef58f-1224-3797-9597-f0fe46bd55ec",
                                                "text": "Dirty keto refers to an approach that follows the typical keto macro ratios, but the components include “dirty” foods like fast food, packaged convenience foods, processed meats, artificially sweetened diet sodas and sports drinks, and unhealthy […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d21aec0c-4e77-344a-b5ad-ada1f4ab65c7",
                                        "entry_id": "f6524f0b-e1a1-3622-8fa2-c949b9fbaff0",
                                        "glosses": [
                                            "Of food, covered in an array of indulgent toppings."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db11af5c-d352-4af2-816a-219789baffea",
                                                "sense_id": "d21aec0c-4e77-344a-b5ad-ada1f4ab65c7",
                                                "text": "Lardo in Portland, Oregon, serves \"dirty fries\" topped with fried rosemary, peppers, lardons, and Parmesan."
                                            },
                                            {
                                                "example_id": "b270dbcd-1d68-40f9-8718-05c2a43a056f",
                                                "sense_id": "d21aec0c-4e77-344a-b5ad-ada1f4ab65c7",
                                                "text": "Piled high and oozing all the trimmings, the dirty burgers here are decidedly good – spice things up with jalapeños, brie or a seriously sticky BBQ sauce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6458a35-6703-3c31-a191-603a5658d5a4",
                                        "entry_id": "f6524f0b-e1a1-3622-8fa2-c949b9fbaff0",
                                        "glosses": [
                                            "Spreading harmful radiation over a wide area."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc3211e2-039c-4163-ad8b-8750d16002d1",
                                                "sense_id": "c6458a35-6703-3c31-a191-603a5658d5a4",
