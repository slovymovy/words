                ],
                "senses": [
                    {
                        "sense_id": "dc411e62-1335-3dc5-9bdb-e213e25e8fbe",
                        "entry_id": "6defab61-d1f2-3b56-b6f4-b758c6cbf509",
                        "glosses": [
                            "Masculin singulier de fou lorsque le substantif qui suit dans la phrase commence par une voyelle ou un h muet."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "8cd11e1e-070b-4c42-ae1d-2de32ebb1e8d",
                                "sense_id": "dc411e62-1335-3dc5-9bdb-e213e25e8fbe",
                                "text": "Un fol espoir, un fol orgueil."
                            },
                            {
                                "example_id": "80ef885b-bc3e-4cb4-ad2c-5c9517684ac8",
                                "sense_id": "dc411e62-1335-3dc5-9bdb-e213e25e8fbe",
                                "text": "Muserolle.– J’ai eu l’honneur d’être trompé par ma femme. Oh mais ! trompé ! comme vous ne le serez peut-être jamais vous-mêmes.\nLe Marquis.– Pas de fol orgueil !"
                            },
                            {
                                "example_id": "86d54b5e-8716-4ef7-a436-7315bcd389cf",
                                "sense_id": "dc411e62-1335-3dc5-9bdb-e213e25e8fbe",
                                "text": "— Tu n’as pas changé, dit-elle, tu es toujours le même fou.\n— Qui fol naquit jamais ne guérit."
                            },
                            {
                                "example_id": "f314b2d5-a3a7-405b-8687-e58f470b30ba",
                                "sense_id": "dc411e62-1335-3dc5-9bdb-e213e25e8fbe",
                                "text": "Le merle sifflait en fol puis on ne l'entendit plus."
                            },
                            {
                                "example_id": "feb6275c-da8a-4a6e-a035-0e3612c3c127",
                                "sense_id": "dc411e62-1335-3dc5-9bdb-e213e25e8fbe",
                                "text": "On retournait vers l’impasse, au point de départ de ce fol après-midi. — (Gaël Faye, Petit Pays, Grasset, 2016, page 160)"
                            }
                        ]
                    },
                    {
                        "sense_id": "532a6836-faa3-377f-b428-7db196a1bc62",
                        "entry_id": "6defab61-d1f2-3b56-b6f4-b758c6cbf509",
                        "glosses": [
                            "Neutre singulier de fou."
                        ],
                        "tags": [
                            "form-of",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "177dc0f6-3cc3-4496-98d9-1ddd7692198c",
                                "sense_id": "532a6836-faa3-377f-b428-7db196a1bc62",
                                "text": "Pourquoi se dire fol ? Que revendique-t-on en réclamant ce terme ? Être fier d’être fol est-ce aimer l’être ?"
                            }
                        ]
                    }
