                "senses": [
                    {
                        "sense_id": "463a04cb-16a2-3d4b-aee1-2e1d3b338662",
                        "entry_id": "8c322c28-c36a-34dd-bb9d-418fc96976fd",
                        "glosses": [
                            "Psalmodier en rythme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0c75632-e176-4f54-ac8b-beb675630652",
                                "sense_id": "463a04cb-16a2-3d4b-aee1-2e1d3b338662",
                                "text": "Il est balancé parce qu'il est fait pour être porté par l'organisme humain et il est rythmo-psalmodié..."
                            },
                            {
                                "example_id": "2fa5ceb7-dd41-4130-9845-a9589a829ce2",
                                "sense_id": "463a04cb-16a2-3d4b-aee1-2e1d3b338662",
                                "text": "De là, la nécessité de rythmo-catéchiser, de rythmo-psalmodier les formules."
                            },
                            {
                                "example_id": "08d1ef5c-e389-46d5-a501-a759c04378fd",
                                "sense_id": "463a04cb-16a2-3d4b-aee1-2e1d3b338662",
                                "text": "Sept lecteurs spécialisés (Miqraïstes) \"rythmo-psalmodient\" chacun un verset de la Torah de Moïse en hébreu, et un huitième ajoute trois versets des Prophètes."
                            }
                        ]
                    }
