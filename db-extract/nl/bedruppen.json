                        "examples": [
                            {
                                "example_id": "8b70f7c6-fd5e-47db-a207-2c46a363be8b",
                                "sense_id": "243df4e2-7824-3480-8300-f1c9a9857d72",
                                "text": "Die fijne heerlijke waanzinnig lekkere kropsla echter, bedruppel je eerst met olie en dan met deze dressing."
                            },
                            {
                                "example_id": "fcbb471b-1f0e-410e-b553-c5174d172d89",
                                "sense_id": "243df4e2-7824-3480-8300-f1c9a9857d72",
                                "text": "Snij de aardappels in plakjes, leg een laag plakjes op de bodem van de schaal, bedruppel met de dressing, weer laag aardappelplakjes en weer bedruppelen."
                            }
                        ]
                    }
