                        "sense_id": "9f5846f7-0161-3d42-88e7-2786f747a8e1",
                        "entry_id": "c1c091db-3170-3a21-9de5-492aaa3bbfd5",
                        "glosses": [
                            "Änderung eines Verbs mit dem Ergebnis, dass es nach der Änderung ein Akkusativobjekt fordert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6218c206-7275-4a29-bf99-2a0224bf4a6c",
                                "sense_id": "9f5846f7-0161-3d42-88e7-2786f747a8e1",
                                "text": "„Bedingung für diese Akkusativierung ist die zunehmende Umwandlung von Verbbeständen.“"
                            },
                            {
                                "example_id": "a3f51567-8828-4781-98df-0812410fd0fa",
                                "sense_id": "9f5846f7-0161-3d42-88e7-2786f747a8e1",
                                "text": "Akkusativierung wird unter anderem bei den Verben mit dem Präfix be- beobachtet: So wird zum Beispiel aus dem Verb arbeiten mit einem Präpositionalobjekt (Er arbeitet an seinem Gesellenstück) das Verb bearbeiten, das ein Akkusativobjekt fordert."
                            },
                            {
                                "example_id": "baf027ad-dea7-42f8-ba52-aabb342a2664",
                                "sense_id": "9f5846f7-0161-3d42-88e7-2786f747a8e1",
                                "text": "„Bei diesem Vorgang der Akkusativierung fällt die Person, die Ziel der Handlung ist, oft ganz weg, oder sie wird in den Akkusativ gesetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
