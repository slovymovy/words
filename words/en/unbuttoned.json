{
    "word_family": [
        "button",
        "unbutton"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "65e07e7c-de41-3d8a-b2f8-9148226fb486",
                    "sense_definition": "Having the buttons undone.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "state_of_clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He walked into the room with his <w>unbuttoned</w> jacket flapping in the wind.",
                            "target_lang_translations": {
                                "ru": "Он вошел в комнату, и его <w>расстегнутая</w> куртка развевалась на ветру."
                            }
                        },
                        {
                            "text": "The soldier stood at ease with his <w>unbuttoned</w> collar showing he was off duty.",
                            "target_lang_translations": {
                                "ru": "Солдат стоял в вольной позе с <w>расстегнутым</w> воротником, показывая, что он не при исполнении."
                            }
                        }
                    ],
                    "antonyms": [
                        "buttoned-up"
                    ],
                    "common_phrases": [
                        "unbuttoned shirt",
                        "unbuttoned jacket"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одежда или ее часть, с которой расстегнуты пуговицы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расстегнутый",
                                "target_lang_sense_clarification": "одежда, у которой расстегнуты пуговицы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97a616bb-4b7a-3921-aa3a-61f8a16318f7",
                    "sense_definition": "Informal and relaxed in manner or style.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personality_style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor had an <w>unbuttoned</w> approach to teaching that students really enjoyed.",
                            "target_lang_translations": {
                                "ru": "У профессора был <w>непринужденный</w> подход к преподаванию, который очень нравился студентам."
                            }
                        },
                        {
                            "text": "After the meeting, the atmosphere became much more <w>unbuttoned</w> and friendly.",
                            "target_lang_translations": {
                                "ru": "После собрания атмосфера стала гораздо более <w>расслабленной</w> и дружелюбной."
                            }
                        }
                    ],
                    "synonyms": [
                        "casual",
                        "relaxed",
                        "informal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неформальный, непринужденный или расслабленный в поведении или стиле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непринужденный",
                                "target_lang_sense_clarification": "свободный, естественный стиль общения"
                            },
                            {
                                "target_lang_word": "расслабленный",
                                "target_lang_sense_clarification": "неформальный, лишенный строгости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57982b9e-b49c-3065-921e-386d6047a307",
                    "sense_definition": "In a state of disarray or lack of order.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "state_of_order",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project was left in an <w>unbuttoned</w> state after the manager suddenly resigned.",
                            "target_lang_translations": {
                                "ru": "Проект остался в <w>беспорядочном</w> состоянии после того, как менеджер внезапно уволился."
                            }
                        },
                        {
                            "text": "His desk was completely <w>unbuttoned</w> with papers scattered everywhere.",
                            "target_lang_translations": {
                                "ru": "На его столе царил полный <w>беспорядок</w>, бумаги были разбросаны повсюду."
                            }
                        }
                    ],
                    "synonyms": [
                        "disorganized",
                        "messy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в состоянии беспорядка или отсутствия организации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспорядочный",
                                "target_lang_sense_clarification": "хаотичный, неорганизованный"
                            },
                            {
                                "target_lang_word": "неорганизованный",
                                "target_lang_sense_clarification": "лишенный порядка"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "897c0948-c401-3ff6-afb9-6fb2f7a50bd1",
                    "sense_definition": "Simple past and past participle of <w>unbutton</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action_clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>unbuttoned</w> her coat as soon as she entered the warm house.",
                            "target_lang_translations": {
                                "ru": "Она <w>расстегнула</w> пальто, как только вошла в теплый дом."
                            }
                        },
                        {
                            "text": "He <w>unbuttoned</w> his cuffs before rolling up his sleeves to work.",
                            "target_lang_translations": {
                                "ru": "Он <w>расстегнул</w> манжеты, прежде чем закатать рукава для работы."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие от глагола «расстегивать»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расстегнул",
                                "target_lang_sense_clarification": "действие в прошедшем времени"
                            },
                            {
                                "target_lang_word": "расстегнутый",
                                "target_lang_sense_clarification": "причастие, результат действия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}