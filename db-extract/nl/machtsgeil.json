                "senses": [
                    {
                        "sense_id": "02b188e2-e5bd-3e4c-a628-8854c13c4b9d",
                        "entry_id": "01fc2e82-2b8c-3bfb-a8a2-8cfd43ee4c3a",
                        "glosses": [
                            "te veel begeerte hebbend naar macht"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "8bad63d5-a82d-4524-99f4-40923273ad7d",
                                "sense_id": "02b188e2-e5bd-3e4c-a628-8854c13c4b9d",
                                "text": "‘De macht van incompetente, daadloze directies en de kracht van machtsgeile, vastgeroeste vakbonden is zo groot, dat gepassioneerde leerkrachten, enthousiaste directies en begripsvolle vakbondsleden gewoon weggedrukt worden,’ zegt Staes."
                            },
                            {
                                "example_id": "f293eac3-0491-4d15-a925-55d416a19595",
                                "sense_id": "02b188e2-e5bd-3e4c-a628-8854c13c4b9d",
                                "text": "‘Citizen Kane’ wordt algemeen beschouwd als één van de beste films uit de geschiedenis. Vooral visueel en verhalend is het portret van de opkomst en de ondergang van een machtsgeile miljonair baanbrekend te noemen."
                            }
                        ]
                    }
