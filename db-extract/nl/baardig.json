                        "form": "baardigers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6f1d43b7-cd4c-3b48-afa3-e6e0243d0dac",
                        "entry_id": "16e0f893-5435-378e-af2f-e237cb1b5cf9",
                        "glosses": [
                            "een (zware) baard dragend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e277e6f-c7b2-4082-a83a-1f55372c2c05",
                                "sense_id": "6f1d43b7-cd4c-3b48-afa3-e6e0243d0dac",
                                "text": "Nu 23 jaar, baardig, de spieren barsten uit z’n T-shirt. Zorgelijk gezicht. Hij pakt een glas water en komt erbij zitten. Vroeger had je Zo vader zo zoon. Een tv-panel moest raden: wie is het kind van de kandidaat? Stel dat Yann met z’n moeder had meegedaan, het panel had geen kans gemaakt."
                            },
                            {
                                "example_id": "b708cfc7-5eae-4a1a-9f4e-32d0d6bf6b31",
                                "sense_id": "6f1d43b7-cd4c-3b48-afa3-e6e0243d0dac",
                                "text": "„Terreur, dat is toch meer voor Moskou? Wat hebben wij nu gedaan?” zegt Olga, die het pandemonium voor station Sennaja Plosjad (Hooiplein) volledig negeert en haar lootjes blijft verkopen. „Het is de straf van God!” zegt een baardige man in een zwarte pij."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8f200ab-613a-4100-9653-58a51f81544e",
                        "source_entry_id": "16e0f893-5435-378e-af2f-e237cb1b5cf9",
                        "source_sense_id": "6f1d43b7-cd4c-3b48-afa3-e6e0243d0dac",
                        "source_sense_description": "een (zware) baard dragend",
                        "target_lang_word": "beardy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beardy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9615b289-6bef-3093-80d6-0788690a50ab",
                                        "entry_id": "aa167d22-5c61-3886-b986-0ee9e633e925",
                                        "glosses": [
                                            "Bearded."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cc468a1-0278-40dd-bf7f-f5e9dc4e8076",
                                                "sense_id": "9615b289-6bef-3093-80d6-0788690a50ab",
                                                "text": "His beard covered his face and rested upon his still more beardy bosom, but its darkness gave an excellent color to his deep-red face."
                                            },
                                            {
                                                "example_id": "06ae1f8c-e552-40c0-a928-076b90733a51",
                                                "sense_id": "9615b289-6bef-3093-80d6-0788690a50ab",
                                                "text": "The plump John Bull, the sallow Frenchman, the beardy Italian, and still more-beardy Jew, the high-boned Scotchman the merry-faced Irishman, the turbaned Turk — a specimen of the human animal from almost every clime under heaven — are passing and repassing before you in the course of every ten minutes."
                                            },
                                            {
                                                "example_id": "aa03f468-fed7-41ec-ba5e-384cdb4d46cf",
                                                "sense_id": "9615b289-6bef-3093-80d6-0788690a50ab",
                                                "text": "1967 May, The Siege of Witch-Hobble Island, Boys' Life, page 44,\nBut his left foot was caught in that blame noose in the end of the rope, so only his beardy head went underwater and he was dragged along like that for a few wet yards."
                                            },
                                            {
                                                "example_id": "ee2fc23f-112c-428a-8e36-6a5370e6f3fa",
                                                "sense_id": "9615b289-6bef-3093-80d6-0788690a50ab",
                                                "text": "\"Very hairy, beardy, toothy kinds of heads,\" said Ardan. \"I remember them, and they used to get hairier and beardier and toothier every second day."
                                            },
                                            {
                                                "example_id": "1c85ef76-4366-4012-87bc-013a41628378",
                                                "sense_id": "9615b289-6bef-3093-80d6-0788690a50ab",
                                                "text": "The biggest, oldest, beardiest, reddest-faced of them addressed Professor Bellbuckle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d27d503-485f-32fc-96db-10686c3dfb4d",
                                        "entry_id": "aa167d22-5c61-3886-b986-0ee9e633e925",
                                        "glosses": [
                                            "Manly, masculine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa5e6498-f433-437f-8181-47c4b4a6fd13",
                                                "sense_id": "0d27d503-485f-32fc-96db-10686c3dfb4d",
                                                "text": "The Doge is one of the popular barytone's most weighty performances, and we do not remember to have heard his voice more powerful, his acting more beardy and emphatic."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "beardy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7c10d52-f7ea-356c-bf6f-6b1c34675445",
                                        "entry_id": "90dd35a5-0d92-346d-b771-be01b517d410",
                                        "glosses": [
                                            "A bearded person or animal:",
                                            "A bearded person; used to identify members of a group or class who can be identified by the wearing of beards."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "272bb78b-1676-4b67-bd3e-a8b8f9492bec",
                                                "sense_id": "f7c10d52-f7ea-356c-bf6f-6b1c34675445",
                                                "text": "His followers were known in Australia as ‘beardies.’"
                                            },
                                            {
                                                "example_id": "382e6755-0d08-45a8-9eb5-8e9fa17567b5",
                                                "sense_id": "f7c10d52-f7ea-356c-bf6f-6b1c34675445",
                                                "text": "Seven such social groups were present at the two festivals: Beardies; Jammers; Irish Fiddlers; Poets; Dancers; Campers an Vanners.[…]The Beardies are men, mainly heavily bearded; described by David as ‘the traditionalists and fundamentalists of the folk scene’ who are often heads of folk club[s], the older generation and the highly respected (Figure 15.1)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e2b20cb-4766-3853-8f29-2adeb14f68bc",
                                        "entry_id": "90dd35a5-0d92-346d-b771-be01b517d410",
                                        "glosses": [
                                            "A bearded person or animal:",
                                            "A bearded reedling."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9ea8683-0a87-4eba-a442-149a58b056b9",
                                                "sense_id": "3e2b20cb-4766-3853-8f29-2adeb14f68bc",
                                                "text": "The fascinating \"beardie\" is not a tit at all, but belongs to an Asian family, the parrotbills."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5d2b630-b425-3a75-b759-339e16a6c71b",
                                        "entry_id": "90dd35a5-0d92-346d-b771-be01b517d410",
                                        "glosses": [
                                            "A bearded person or animal:",
                                            "A bearded dragon."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12834e85-6c05-4d26-84f1-ddf814ddabea",
                                                "sense_id": "c5d2b630-b425-3a75-b759-339e16a6c71b",
                                                "text": "But she always kept her distance whenever one of my beardies was out of its cage, as if Moose merely acted like a good-natured lap lizard to throw her off[…]."
                                            },
                                            {
                                                "example_id": "b3b07ac8-7eba-43a8-9ab8-b517307627b7",
                                                "sense_id": "c5d2b630-b425-3a75-b759-339e16a6c71b",
                                                "text": "It is impossible to determine the sex of beardies as babies or juveniles, so if you are thinking of breeding them, you may have to buy four or five and raise them in individual enclosures."
                                            },
                                            {
                                                "example_id": "e0452545-428c-41a6-ac26-4781d82a11ac",
                                                "sense_id": "c5d2b630-b425-3a75-b759-339e16a6c71b",
                                                "text": "The bearded dragon will reach its adult length by one year. Baby beardies quickly grow into long, strong lizards!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00b80ce9-e11e-3c2e-90ae-c910910f3729",
                                        "entry_id": "90dd35a5-0d92-346d-b771-be01b517d410",
                                        "glosses": [
                                            "A bearded person or animal:",
                                            "A bearded collie."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b09f1535-9fc1-45cb-9bcd-d00772509ec2",
                                                "sense_id": "00b80ce9-e11e-3c2e-90ae-c910910f3729",
                                                "text": "Beardies grow fast. They grow like a weed and can be as unsightly as one."
                                            },
                                            {
                                                "example_id": "aa516d85-c4c7-48fb-a941-478d9963ab4a",
                                                "sense_id": "00b80ce9-e11e-3c2e-90ae-c910910f3729",
                                                "text": "Beardies take two to three years to mature, so be prepared for typical puppy activity during this time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67a2a26a-798c-37c7-a291-a42b612290c1",
                                        "entry_id": "90dd35a5-0d92-346d-b771-be01b517d410",
                                        "glosses": [
                                            "A bearded person or animal:",
                                            "Any of several kinds of fish; a loach."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a56f8cfe-4c5b-4cb8-9501-072762630bdd",
                                                "sense_id": "67a2a26a-798c-37c7-a291-a42b612290c1",
                                                "text": "Loaches (or beardies) often also thinned our preserves, and in this they were occasionally helped by small eels. Whenever beardies got within an enclosure containing only creepers and caddis worms, in a very short space of time the beardies alone were left, so rapacious are these small fishes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80d002fd-059a-4157-b849-8c5262abda1e",
                        "source_entry_id": "16e0f893-5435-378e-af2f-e237cb1b5cf9",
                        "source_sense_id": "6f1d43b7-cd4c-3b48-afa3-e6e0243d0dac",
                        "source_sense_description": "een (zware) baard dragend",
                        "target_lang_word": "bearded",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bearded",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2c151b7-d7d6-3a92-88f4-ab593a321aad",
                                        "entry_id": "941e7712-378e-37d4-8ec9-b47b0038caf6",
                                        "glosses": [
                                            "Having a beard; involving a beard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e9e4c15-79e8-472c-b79d-dbc960a0da68",
                                                "sense_id": "f2c151b7-d7d6-3a92-88f4-ab593a321aad",
                                                "text": "Good sir, be a man: / Think every bearded fellow that's but yoked / May draw with you:"
                                            },
                                            {
                                                "example_id": "3d8c7237-d56b-44b2-bf97-8043b85c31a3",
                                                "sense_id": "f2c151b7-d7d6-3a92-88f4-ab593a321aad",
                                                "text": "1693, Juvenal, The Satyrs, translated by John Dryden and others, London: J. Tonson, 1735, 6th edition, Satyr VI, p. 80, https://archive.org/details/satyrsdecimusju00creegoog\nThere are who in soft Eunuchs place their Bliss; / To shun the Scrubbing of a bearded Kiss, / And 'scape Abortion; but their solid Joy / Is when the Page, already past a Boy, / Is Capon'd late; and to the Gelder shown, / With his two Pounders to Perfection grown. / When all the Navel string cou'd give, appears; / All but the Beard, and that's the Barber's loss, not theirs."
                                            },
                                            {
                                                "example_id": "db6e13c5-95b8-4a82-bfcc-6bcfe8e96d17",
                                                "sense_id": "f2c151b7-d7d6-3a92-88f4-ab593a321aad",
                                                "text": "He made us laugh till we cried, and, not altogether displeased at the effect, undersized and bearded to the waist like a gnome, he would tiptoe amongst us and say, 'It's all very well for you beggars to laugh, but my immortal soul was shrivelled down to the size of a parched pea after a week of that work.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d964d65f-5eab-3775-9fba-a6aa6cc821e0",
                                        "entry_id": "941e7712-378e-37d4-8ec9-b47b0038caf6",
                                        "glosses": [
                                            "Having a fringe or appendage resembling a beard in some way (often followed by with)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5d28db0-31c2-4a6d-9cd1-5dbf3d7b1b99",
                                                "sense_id": "d964d65f-5eab-3775-9fba-a6aa6cc821e0",
                                                "text": "This is the forest primeval. The murmuring pines and the hemlocks, / Bearded with moss, and in garments green, indistinct in the twilight, / Stand like Druids of eld [...]"
                                            },
                                            {
                                                "example_id": "1b9b83a4-6112-418e-918c-0ccee48ef581",
                                                "sense_id": "d964d65f-5eab-3775-9fba-a6aa6cc821e0",
                                                "text": "[...] but the joyous sea / Shall be our raiment, and the bearded star / Shoot arrows at our pleasure!"
                                            },
                                            {
                                                "example_id": "8637e8c1-2c34-4aed-9661-48c9c3234a5e",
                                                "sense_id": "d964d65f-5eab-3775-9fba-a6aa6cc821e0",
                                                "text": "Bearded with dewy grass the mountains thrust / Their blackness high into the still grey light,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb44b89c-b23b-33ad-b475-c7bc6acba8c8",
                                        "entry_id": "941e7712-378e-37d4-8ec9-b47b0038caf6",
                                        "glosses": [
                                            "having the lower portion of the axehead extending the cutting edge significantly below the width of the butt, thus providing a wide cutting surface while keeping overall weight low."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "39846ffe-adfe-3225-b036-e1280ed7ec6c",
                                        "entry_id": "941e7712-378e-37d4-8ec9-b47b0038caf6",
                                        "glosses": [
                                            "Having a beard (or similar appendage) of a specified type."
                                        ],
                                        "tags": [
                                            "in-compounds"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bde0c2ad-cf9e-4cb3-9649-675b2e44a278",
                                                "sense_id": "39846ffe-adfe-3225-b036-e1280ed7ec6c",
                                                "text": "[...] who knows / If the scarce-bearded Caesar have not sent / His powerful mandate to you, ‘Do this, or this; Take in that kingdom, and enfranchise that; / Perform 't, or else we damn thee.’"
                                            },
                                            {
                                                "example_id": "1f6e2773-6191-4fe3-a9df-988bf40843d3",
                                                "sense_id": "39846ffe-adfe-3225-b036-e1280ed7ec6c",
                                                "text": "… for with his hammer Thor / Smote 'mid the rocks the lichen-bearded pines / And burst their roots …"
                                            },
                                            {
                                                "example_id": "5a26a60a-0df4-49ca-8940-5100b17f2bb0",
                                                "sense_id": "39846ffe-adfe-3225-b036-e1280ed7ec6c",
                                                "text": "Down below that in the Great River, now at its coldest hour, the heads and shoulders of the nymphs, and the great weedy-bearded head of the river-god, rose from the water."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c600832-27d4-315a-b205-67b9f3834f48",
                                        "entry_id": "941e7712-378e-37d4-8ec9-b47b0038caf6",
                                        "glosses": [
                                            "Having barbs of a certain color."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bearded",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11e988dd-9672-35bd-b3ef-5403a6108c36",
                                        "entry_id": "a38ca031-f034-3147-89e0-18d4e89a0eb8",
                                        "glosses": [
                                            "simple past and past participle of beard"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bearded",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5787a65-efce-3f0d-8438-cdeca845de95",
                                        "entry_id": "4e2c7e48-d52a-36cb-86f9-fb6aaa49a8bb",
                                        "glosses": [
                                            "A bearded iris."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40fc28b0-b7bb-4e23-990b-4374909d4023",
                                                "sense_id": "d5787a65-efce-3f0d-8438-cdeca845de95",
                                                "text": "The herbaceous perennial irises benefit from at least one feeding a year in early spring as growth begins. Siberian and Japanese irises appreciate a second feeding just as the flowers fade. Beardeds do best with a second feeding in late summer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
