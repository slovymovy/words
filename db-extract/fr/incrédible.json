                    {
                        "translation_id": "9bdadbe4-0840-4258-a6ac-9f6db228521f",
                        "source_entry_id": "90a0f105-6006-36db-a002-f762dbd0a657",
                        "source_sense_id": "c145456e-99dd-3e46-9d66-51212bb5dc4a",
                        "source_sense_description": "Indigne de confiance, de considération, dénué de crédit",
                        "target_lang_word": "incrível",
                        "target_lang_code": "pt",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incrível",
                                "target_lang_code": "pt",
                                "target_senses": [
                                    {
                                        "sense_id": "304b3ab6-0886-3f0a-9687-85c90e6133d1",
                                        "entry_id": "1b7aac4c-4785-39f7-8167-3f7df5ed0219",
                                        "glosses": [
                                            "inacreditável"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77466f70-ee4f-4766-a5fd-a3d75da149c1",
                                                "sense_id": "304b3ab6-0886-3f0a-9687-85c90e6133d1",
                                                "text": "É incrível, mas, apesar das mudanças da últimas décadas, continuamos falando em termos de esquerda e direita."
                                            }
                                        ]
                                    },
