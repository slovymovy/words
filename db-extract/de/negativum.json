                        "examples": [
                            {
                                "example_id": "332012b0-ace3-4fcf-b29c-124ecfd2db8c",
                                "sense_id": "977ba323-4996-3c59-b78f-a687fd0b4b2d",
                                "text": "Die Negation des Positivums, ist ein Negativum; das Prinzip \"Hoffnungslosigkeit\" und \"Pessimismus\" gilt!"
                            },
                            {
                                "example_id": "e2cb9ce6-dbf4-4a1e-8cea-f14ff3258fc4",
                                "sense_id": "977ba323-4996-3c59-b78f-a687fd0b4b2d",
                                "text": "Die Einstellung: \"Das Glas ist nur halbvoll und niemals halbleer!\" ist ein persönliches Negativum."
                            },
                            {
                                "example_id": "53fe5a87-109e-465e-a4f4-a76b2efbc2f9",
                                "sense_id": "977ba323-4996-3c59-b78f-a687fd0b4b2d",
                                "text": "„Das größte Negativum ist unsere Sprache.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
