                "senses": [
                    {
                        "sense_id": "27e63ab3-6c3f-3caa-9ac2-52f4895237da",
                        "entry_id": "25966e3a-dc49-3347-a78a-c503408b39bf",
                        "glosses": [
                            "Tasche (in der Kleidung, bei einem Rucksack und so weiter), die mit einem Reißverschluss verschlossen werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b86748c-c6a5-4804-968c-4b9547db3292",
                                "sense_id": "27e63ab3-6c3f-3caa-9ac2-52f4895237da",
                                "text": "„In den zwei Reißverschlusstaschen auf der Vorderseite und einem versteckten Reißverschlussfach auf der Hinterseite können kleinere Sachen, wie Schlüssel, Handy, Stifte und Co. verstaut werden.“"
                            },
                            {
                                "example_id": "3663e84a-84ee-4582-8616-1a1a4121a852",
                                "sense_id": "27e63ab3-6c3f-3caa-9ac2-52f4895237da",
                                "text": "„Dieser umweltfreundliche, vielseitige und äußerst bequeme Pullover für Damen ist mit zwei Reißverschlusstaschen für die Hände und einer praktischen Reißverschlusstasche auf der Brust ausgestattet, die unterwegs viel Platz zum Verstauen von Kleinigkeiten bietet.“"
                            },
                            {
                                "example_id": "041660e6-5d52-410e-8c70-45af57e69a94",
                                "sense_id": "27e63ab3-6c3f-3caa-9ac2-52f4895237da",
                                "text": "„Zwei Fronttaschen, zwei Gesäßtaschen und zwei seitliche Reißverschlusstaschen bieten ausreichend Platz für all die kleinen Dinge, die du auf keinem Abenteuer missen möchtest.“"
                            },
                            {
                                "example_id": "165de961-cde9-4530-8013-f1d580f78c29",
                                "sense_id": "27e63ab3-6c3f-3caa-9ac2-52f4895237da",
                                "text": "„Weiterhin hat die Leggings Reißverschlusstaschen und auch an den Beinabschlüssen Reißverschlüsse.“"
                            },
                            {
                                "example_id": "2f428ce5-f3f0-4cea-8a9b-a31d04a393de",
                                "sense_id": "27e63ab3-6c3f-3caa-9ac2-52f4895237da",
                                "text": "„Das Futteral verfügt über zahlreiche Reißverschlusstaschen für Zubehör und ist mit sicherbaren Doppelzippern ausgestattet.“"
                            },
                            {
                                "example_id": "791b1570-b9bb-40ae-96c7-ecc18e50d381",
                                "sense_id": "27e63ab3-6c3f-3caa-9ac2-52f4895237da",
                                "text": "„Im Hauptfach befinden sich das gepolsterte Einschubfach für einen 15.4-Zoll-Laptop, außerdem eine flache Reißverschlusstasche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
