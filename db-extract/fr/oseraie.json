        "fr-extract.jsonl": [
            {
                "entry_id": "6c67f6dc-b8c2-33ef-a548-29bf2e85c7a5",
                "word": "oseraie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5aa0f7b9-dff2-4513-bd5a-cf2e2c0315a6",
                        "entry_id": "6c67f6dc-b8c2-33ef-a548-29bf2e85c7a5",
                        "tags": [
                            "plural"
                        ],
                        "form": "oseraies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b58cfd69-f908-3686-b974-e199a42077bd",
                        "entry_id": "6c67f6dc-b8c2-33ef-a548-29bf2e85c7a5",
                        "glosses": [
                            "Lieu planté d’osiers."
                        ],
                        "tags": [
                            "Ethnobiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "69d61312-e1ef-477b-a30c-7be0c1dbe7f8",
                                "sense_id": "b58cfd69-f908-3686-b974-e199a42077bd",
                                "text": "Enfin deux ombres chinoises glissèrent à fleur d’oseraie, entre les grimaçants tétards rasés de frais par les vaniers."
                            },
                            {
                                "example_id": "c4864fd0-d4fe-47ec-974c-d38856451c9c",
                                "sense_id": "b58cfd69-f908-3686-b974-e199a42077bd",
                                "text": "Comme elle lance les hirondelles bicolores\nDe son agreste corbeille qui sent encore l’oseraie !"
                            },
                            {
                                "example_id": "d4774ebe-0aa7-4781-9067-c4bfab78e58c",
                                "sense_id": "b58cfd69-f908-3686-b974-e199a42077bd",
                                "text": "Lorsqu’on veut qu’une oseraie profite, il faut nécessairement l’enfermer dans une clôture ; autrement les bestiaux y feront beaucoup de dégâts."
                            },
                            {
                                "example_id": "a29c5477-7a0d-459f-afa0-0b7f8e298a63",
                                "sense_id": "b58cfd69-f908-3686-b974-e199a42077bd",
                                "text": "De loin en loin, une barque, écartant des oseraies, s’enfonçait, par une saignée latérale, dans un champ qu’elle avait l’air de labourer."
                            },
                            {
                                "example_id": "d8046319-b3d6-4e6f-862d-f268721ebcee",
                                "sense_id": "b58cfd69-f908-3686-b974-e199a42077bd",
                                "text": "Mais le plus navrant de tout, c’était d’entendre, à la lisière du bois, au bord du pré, et là-bas dans l’oseraie de la rivière, des appels anxieux, tristes, disséminés, auxquels rien ne répondait."
                            },
                            {
                                "example_id": "933c66da-9896-4004-99b8-067a83a4728c",
                                "sense_id": "b58cfd69-f908-3686-b974-e199a42077bd",
                                "text": "Une oseraie commence à donner son produit important vers la quatrième année après la plantation. C’est à la cinquième année que ce produit devient complet."
                            }
                        ]
                    }
                ],
