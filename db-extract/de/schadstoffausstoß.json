                "senses": [
                    {
                        "sense_id": "d38b45e6-f4c0-3d02-a892-4c8cc95dd92b",
                        "entry_id": "5bf588a9-724f-3745-b877-62cf92da9927",
                        "glosses": [
                            "Abgabe/Emission von Schadstoffen in die Umwelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ff94ad9-f45f-476c-9b6f-0d4648066566",
                                "sense_id": "d38b45e6-f4c0-3d02-a892-4c8cc95dd92b",
                                "text": "An der Universität wurde ein neues Verfahren zur Reduzierung des Schadstoffausstoßes von Ottomotoren entwickelt."
                            },
                            {
                                "example_id": "02701ab8-644d-4a0d-8e16-bbfe49bdf1d1",
                                "sense_id": "d38b45e6-f4c0-3d02-a892-4c8cc95dd92b",
                                "text": "„Trotz spritsparender Flugzeuge nimmt der Schadstoffausstoß des europäischen Luftverkehrs zu.“"
                            },
                            {
                                "example_id": "c8c31406-aafd-4aad-adc4-5cdbf937b1ae",
                                "sense_id": "d38b45e6-f4c0-3d02-a892-4c8cc95dd92b",
                                "text": "„Je länger der Transportweg eines Produktes, desto größer ist der Schadstoffausstoß durch den Transport.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
