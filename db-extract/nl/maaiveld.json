                                "example_id": "61036a5f-2cc9-4ad2-9695-ef8b14b5062f",
                                "sense_id": "40f3d625-2c8c-3410-8e8b-05b4d24044e6",
                                "text": "We moeten het maaiveld meten voordat we beginnen met bouwen.",
                                "translation": "We need to measure the average height of the land before we start building.",
                                "english": "We need to measure the average height of the land before we start building."
                            },
                            {
                                "example_id": "60e1eda9-8d33-4ace-8da1-9078086efd4a",
                                "sense_id": "40f3d625-2c8c-3410-8e8b-05b4d24044e6",
                                "text": "Het maaiveld van het gebied is sterk veranderd door jaren van erosie.",
                                "translation": "The mean height of the area has greatly changed due to years of erosion.",
                                "english": "The mean height of the area has greatly changed due to years of erosion."
                            }
