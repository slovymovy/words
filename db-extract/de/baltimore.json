                                                "example_id": "fd671052-9dda-4cf9-8303-f112356d5823",
                                                "sense_id": "1a70775c-98d7-3a2f-8399-265b810693f4",
                                                "text": "– Je suis originaire de Baltimore, la grande cité américaine, qui, elle-même, tire son origine de Baltimore, un des plus misérables villages irlandais."
                                            },
                                            {
                                                "example_id": "94857183-45b2-4819-a7a2-71c2071ced5b",
                                                "sense_id": "1a70775c-98d7-3a2f-8399-265b810693f4",
                                                "text": "Je dois dire qu’à cette époque-là ma famille venait de quitter Annapolis pour s’installer à Baltimore où se concentrait désormais l’essentiel des activités de mon Père, où, avec deux de ses jeunes frères, il envisageait de fonder sa propre banque."
                                            }
                                        ]
                                    }
