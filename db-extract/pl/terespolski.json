                        "examples": [
                            {
                                "example_id": "0b6f64ba-22d2-4c3b-9965-0d6d746f6c1b",
                                "sense_id": "70b5e964-17d1-3d22-a839-01808cbfd35f",
                                "text": "Pamiętam, kiedy przyjechaliśmy na Pragę, na dworzec Terespolski, jechaliśmy potem przez most Kierbedzia"
                            },
                            {
                                "example_id": "e97e7c38-48da-471a-9013-002f1058268c",
                                "sense_id": "70b5e964-17d1-3d22-a839-01808cbfd35f",
                                "text": "Jej rozwój nastąpił na początku XX w., co było związane z budową linii kolei terespolskiej"
                            }
                        ],
