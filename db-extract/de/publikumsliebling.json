                                        "entry_id": "0f59964c-1622-3d53-9bdb-4466a06fcbf2",
                                        "glosses": [
                                            "Someone or something that is pleasing to the majority of a group."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e888ba3a-125c-4e50-8734-52238833bdd1",
                                                "sense_id": "b328dfcf-4a17-3466-aa82-b7ad92da6165",
                                                "text": "Moths and the Flame seems to be the crowdpleaser here, having matinee and evening performances."
                                            },
