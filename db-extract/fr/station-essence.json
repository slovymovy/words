                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d4e1ddc-e648-42e7-bb54-8e943cf1142f",
                                "sense_id": "f9f1e26b-5431-3e05-aa17-55015e14e404",
                                "text": "Après Jersey City, cité-dortoir encombrée de camions, de fast-foods et de stations-essence, ils enjambèrent le pont tentaculaire de Newark Bay."
                            },
                            {
                                "example_id": "e7888f57-ab82-40f2-8089-0a74acb91cfc",
                                "sense_id": "f9f1e26b-5431-3e05-aa17-55015e14e404",
                                "text": "Idéalement situé, au premier arrêt de bus près de la station-essence Eko, ce qui est très pratique, voici un loueur sérieux chez qui l'on peut également trouver trois belles villas à louer sur les hauteurs de la ville, au frais."
                            },
                            {
                                "example_id": "a1b6f379-c0b9-415a-9689-299844d5ce68",
                                "sense_id": "f9f1e26b-5431-3e05-aa17-55015e14e404",
                                "text": "Laissez-moi au moins arriver à la prochaine station-essence et je vous laisserai la voiture et la caisse."
                            }
                        ]
                    }
