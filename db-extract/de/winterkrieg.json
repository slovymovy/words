                ],
                "senses": [
                    {
                        "sense_id": "1c8c3759-3880-3a42-a73f-1c78071a0284",
                        "entry_id": "015cff08-f8f3-3458-869b-39278b24ddaf",
                        "glosses": [
                            "Kampfhandlungen zwischen der Sowjetunion und Finnland im Winter 1939/40"
                        ],
                        "tags": [
                            "no-plural",
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "e8c39ef3-f928-4c08-bd8a-6e194c2a336b",
                                "sense_id": "1c8c3759-3880-3a42-a73f-1c78071a0284",
                                "text": "„Beim abendlichen Festmahl im Reichsjägerhof erzählte Mannerheim von seinen Jagderlebnissen in Karelien, das die Finnen nach dem Winterkrieg 1939/40 an die Sowjetunion hatten abtreten müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "731fc39e-c529-3b9d-a5f1-5706becfaf8f",
                        "entry_id": "015cff08-f8f3-3458-869b-39278b24ddaf",
                        "glosses": [
                            "im Winter stattfindender Krieg"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "81a9a699-9b06-45af-926a-6ca4e7a5700d",
                                "sense_id": "731fc39e-c529-3b9d-a5f1-5706becfaf8f",
                                "text": "„Die Verheerungen, welche in diesem Winterkriege von beiden Seiten angerichtet worden waren, erfüllten das Gemüth der edlen und frommen Elisabeth, der Gemahlin des strengen Herzogs Albrecht mit Schmerz […].“"
                            },
                            {
                                "example_id": "b7e0a075-2f9a-4aff-a004-b56c9ee73a67",
                                "sense_id": "731fc39e-c529-3b9d-a5f1-5706becfaf8f",
                                "text": "„Bonaparte wurde in diesem Winterkriege durch die 3. Halbbrigade des Orients repräsentirt.“"
                            },
                            {
                                "example_id": "eda53021-a1cf-4c96-8058-f501f7f2cf58",
                                "sense_id": "731fc39e-c529-3b9d-a5f1-5706becfaf8f",
                                "text": "„Die Wintertruppe, deren man für einen Winterkrieg bedarf, sind vornehmlich geübte Schneeschuhläufer.“"
                            },
                            {
                                "example_id": "9f914e97-7c6f-4e0e-aab4-292d488e232a",
                                "sense_id": "731fc39e-c529-3b9d-a5f1-5706becfaf8f",
                                "text": "„Genauso schlimm – noch schlimmer eigentlich – war die Tatsache, daß das deutsche Oberkommando ganz einfache und leicht anzuwendende Grundregeln eines Winterkrieges in Rußland nicht erkannte und nicht berücksichtigte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
