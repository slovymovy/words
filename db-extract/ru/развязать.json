                        "glosses": [
                            "to untie, to unbind, to undo, to unleash"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dbc4afc-727a-4f26-be7e-f698e5ed3021",
                                "sense_id": "3367ae3d-d7ee-3dc1-84e7-d613f0ac33ad",
                                "text": "И проповедовал, говоря: идет за мною Сильнейший меня, у Которого я недостоин, наклонившись, развязать ремень обуви Его…",
                                "translation": "(please add an English translation of this quotation)",
                                "english": "(please add an English translation of this quotation)"
                            },
                            {
                                "example_id": "f34cd35b-38e1-43d1-8227-5dc33ce96349",
                                "sense_id": "3367ae3d-d7ee-3dc1-84e7-d613f0ac33ad",
                                "text": "развяза́ть ру́ки",
                                "translation": "to untie/free (someone's) hands",
                                "english": "to untie/free (someone's) hands"
                            },
                            {
                                "example_id": "428995e7-d487-4de6-81cc-6728ef91d93f",
                                "sense_id": "3367ae3d-d7ee-3dc1-84e7-d613f0ac33ad",
                                "text": "развяза́ть язы́к",
                                "translation": "loosen someone's tongue, get someone to talk",
                                "english": "loosen someone's tongue, get someone to talk"
                            }
                        ]
                    },
                    {
