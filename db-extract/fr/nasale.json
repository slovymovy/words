            {
                "entry_id": "d17e83ad-9a6a-3974-b502-2751171c1767",
                "word": "nasale",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6b3f8610-8745-4059-b9eb-29944c660083",
                        "entry_id": "d17e83ad-9a6a-3974-b502-2751171c1767",
