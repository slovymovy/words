{
    "word_family": [],
    "entries": [
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "cc4f18c4-7f35-32a9-b800-9999be77f579",
                    "sense_definition": "Употребляется для присоединения придаточного предложения, содержащего условие, при котором совершается или возможно действие главного предложения.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я пойду́ гуля́ть, <если> бу́дет хоро́шая пого́да.",
                            "target_lang_translations": {
                                "en": "I will go for a walk <if> the weather is good.",
                                "cs": "Půjdu se projít, <w>pokud</w> bude hezké počasí.",
                                "zh": "<w>如果</w>天气好，我就去散步。"
                            }
                        },
                        {
                            "text": "Позвони́ мне ве́чером, <если> у тебя́ бу́дет вре́мя.",
                            "target_lang_translations": {
                                "en": "Call me in the evening <if> you have time.",
                                "cs": "Zavolej mi večer, <w>pokud</w> budeš mít čas.",
                                "zh": "<w>要是</w>你有时间，晚上给我打电话。"
                            }
                        },
                        {
                            "text": "Мы бы пошли́ в кино́, <если> бы не опозда́ли на авто́бус.",
                            "target_lang_translations": {
                                "en": "We would have gone to the cinema <if> we hadn't missed the bus.",
                                "cs": "Šli bychom do kina, <w>kdybychom</w> nezmeškali autobus.",
                                "zh": "我们本可以去看电影的，<w>如果</w>没错过公交车的话。"
                            }
                        }
                    ],
                    "synonyms": [
                        "при условии",
                        "в случае",
                        "когда",
                        "раз",
                        "ежели",
                        "коли",
                        "кабы"
                    ],
                    "common_phrases": [
                        "если бы",
                        "если можно",
                        "если нужно",
                        "если нет",
                        "а если"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to introduce a subordinate clause containing a condition under which the action of the main clause is performed or possible.",
                        "cs": "Používá se k uvedení vedlejší věty obsahující podmínku, za které se uskutečňuje nebo je možný děj hlavní věty.",
                        "zh": "用于引导从句，表示主句动作发生或可能发生的条件。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "if",
                                "target_lang_sense_clarification": "introducing a condition"
                            },
                            {
                                "target_lang_word": "in case",
                                "target_lang_sense_clarification": "referring to a possibility"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "pokud",
                                "target_lang_sense_clarification": "vyjádření podmínky"
                            },
                            {
                                "target_lang_word": "jestli",
                                "target_lang_sense_clarification": "hovorové vyjádření podmínky"
                            },
                            {
                                "target_lang_word": "když",
                                "target_lang_sense_clarification": "vyjádření podmínky v určitém kontextu"
                            },
                            {
                                "target_lang_word": "-li",
                                "target_lang_sense_clarification": "knižní vyjádření podmínky"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "如果",
                                "target_lang_sense_clarification": "表示假设关系，最常用的条件连词"
                            },
                            {
                                "target_lang_word": "要是",
                                "target_lang_sense_clarification": "口语中常用的条件连词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79913d77-3d77-3de0-a176-480516955a71",
                    "sense_definition": "Употребляется для сопоставления или противопоставления двух фактов, ситуаций или обстоятельств (часто в конструкции с частицей «то»).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<Если> ра́ньше здесь был густо́й лес, то тепе́рь стоя́т высо́кие дома́.",
                            "target_lang_translations": {
                                "en": "<If> there was a dense forest here before, now there are tall buildings.",
                                "cs": "<w>Zatímco</w> dříve zde byl hustý les, nyní zde stojí vysoké domy.",
                                "zh": "<w>如果</w>说这里以前是茂密的森林，那么现在矗立着高楼大厦。"
                            }
                        },
                        {
                            "text": "<Если> брат лю́бит то́чные нау́ки, то сестра́ предпочита́ет литерату́ру.",
                            "target_lang_translations": {
                                "en": "<While> the brother loves exact sciences, the sister prefers literature.",
                                "cs": "<w>Zatímco</w> bratr miluje exaktní vědy, sestra dává přednost literatuře.",
                                "zh": "<w>如果</w>说哥哥喜欢理科，那么妹妹则更偏爱文学。"
                            }
                        }
                    ],
                    "synonyms": [
                        "когда"
                    ],
                    "common_phrases": [
                        "если не то"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to compare or contrast two facts, situations, or circumstances (often in a construction with the particle 'then').",
                        "cs": "Používá se ke srovnání nebo protikladu dvou faktů, situací nebo okolností (často v konstrukci s částicí „tak“).",
                        "zh": "用于对比两个事实、情况或环境（常与“那么”连用）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "while",
                                "target_lang_sense_clarification": "indicating contrast"
                            },
                            {
                                "target_lang_word": "whereas",
                                "target_lang_sense_clarification": "indicating contrast"
                            },
                            {
                                "target_lang_word": "if",
                                "target_lang_sense_clarification": "in contrastive structures"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "zatímco",
                                "target_lang_sense_clarification": "vyjádření kontrastu"
                            },
                            {
                                "target_lang_word": "když",
                                "target_lang_sense_clarification": "vyjádření kontrastu v porovnávací struktuře"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "如果",
                                "target_lang_sense_clarification": "在对比结构中表示假设性的对比"
                            },
                            {
                                "target_lang_word": "而",
                                "target_lang_sense_clarification": "表示转折或对比"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "97cd95f3-f632-3374-8592-5be0bacbdc6d",
                    "sense_definition": "Употребляется для выражения неуверенности, сомнения или ограничения; соответствует по значению словам «разве что», «разве только».",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я не зна́ю, чем тебе́ помо́чь, <если> то́лько да́ть до́брый сове́т.",
                            "target_lang_translations": {
                                "en": "I don't know how to help you, <unless> perhaps to give good advice.",
                                "cs": "Nevím, jak ti pomoci, <w>ledaže</w> bych ti dal dobrou radu.",
                                "zh": "我不知道怎么帮你，<w>除非</w>给你提个好建议。"
                            }
                        },
                        {
                            "text": "Мы пое́дем на да́чу, <если> то́лько ненадо́лго.",
                            "target_lang_translations": {
                                "en": "We will go to the dacha, <if> only for a short while.",
                                "cs": "Pojedeme na chatu, <w>pokud</w> jen na krátkou dobu.",
                                "zh": "我们会去乡间别墅，<w>只是</w>待的时间不会太长。"
                            }
                        }
                    ],
                    "synonyms": [
                        "разве что",
                        "разве только"
                    ],
                    "common_phrases": [
                        "если только"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used to express uncertainty, doubt, or limitation; corresponds in meaning to 'unless' or 'except perhaps'.",
                        "cs": "Používá se k vyjádření nejistoty, pochybnosti nebo omezení; odpovídá významu „ledaže“ nebo „pokud jen“.",
                        "zh": "用于表示不确定、怀疑或限制；相当于“除非”或“只是”。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unless",
                                "target_lang_sense_clarification": "expressing exception"
                            },
                            {
                                "target_lang_word": "if only",
                                "target_lang_sense_clarification": "expressing limitation"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "ledaže",
                                "target_lang_sense_clarification": "vyjádření výjimky"
                            },
                            {
                                "target_lang_word": "pokud jen",
                                "target_lang_sense_clarification": "vyjádření omezení"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "除非",
                                "target_lang_sense_clarification": "表示唯一的条件"
                            },
                            {
                                "target_lang_word": "只是",
                                "target_lang_sense_clarification": "表示限制或例外"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}