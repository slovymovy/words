                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0e042e36-361d-4833-be74-a443924f1e1f",
                        "entry_id": "2db9be0d-b3d1-3bc4-9c55-e0b117f9c145",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "droitistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4232794d-cfed-336b-9012-1ad70ff2e22c",
                        "entry_id": "2db9be0d-b3d1-3bc4-9c55-e0b117f9c145",
                        "glosses": [
                            "Relatif au droitisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d43a8fbc-02c7-4aff-8380-8744a1ed04f4",
                                "sense_id": "4232794d-cfed-336b-9012-1ad70ff2e22c",
                                "text": "Dictionnaire de la mouvance droitiste et nationale, de 1945 à nos jours."
                            },
                            {
                                "example_id": "31b01e88-5130-4043-af29-341b7165a808",
                                "sense_id": "4232794d-cfed-336b-9012-1ad70ff2e22c",
                                "text": "La réalisation de la dissolution [de l’Unef] se présente probablement mal. L’Unef bénéfice d’un capital sympathie, au moins à gauche, amenant à critiquer toute contestation comme droitiste."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d610e31-d6ed-36af-b9a6-c1bd75228771",
                        "entry_id": "2db9be0d-b3d1-3bc4-9c55-e0b117f9c145",
                        "glosses": [
                            "Relatif à une dérive droitière, par rapport à la ligne du Parti communiste."
                        ],
                        "tags": [
                            "Communisme"
                        ],
                        "examples": [
                            {
                                "example_id": "724c01dd-3daf-469e-9e62-104e45a37e79",
                                "sense_id": "6d610e31-d6ed-36af-b9a6-c1bd75228771",
                                "text": "Étiqueté « droitiste » lors du mouvement antidroitiste de 1957 – comme le père de l’auteur dont il était un ami –, il a été réhabilité par la suite."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "acf4164c-0a16-425e-b52e-14f3ffacc0c3",
                        "source_entry_id": "2db9be0d-b3d1-3bc4-9c55-e0b117f9c145",
                        "target_lang_word": "rightist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rightist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79a2d41f-fc92-36fb-b414-748486dfd240",
                                        "entry_id": "14c9c543-7256-398d-9a43-3f98ec7c3fa0",
                                        "glosses": [
                                            "One who believes in the politics or policies of the political right."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15b524b3-ee09-430c-a0a0-bbb374c1cf33",
                                                "sense_id": "79a2d41f-fc92-36fb-b414-748486dfd240",
                                                "text": "To summarize: on the average, rightists are made more anxious by ambiguity and have a stronger need for closure, dislike novelty, are more comforted by structure and hierarchy, more readily perceive circumstances as threatening, and are more parochial in their empathy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b31e640e-42dc-3665-9f8a-401c46bc831e",
                                        "entry_id": "14c9c543-7256-398d-9a43-3f98ec7c3fa0",
                                        "glosses": [
                                            "One who supports the rights of a specified group."
                                        ],
                                        "tags": [
                                            "in-compounds"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ebed41c-6b68-42de-99b9-19c656bcd96e",
                                                "sense_id": "b31e640e-42dc-3665-9f8a-401c46bc831e",
                                                "text": "an animal rightist"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rightist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47c0d73d-a50d-3a32-b59d-1bfbe763fae3",
                                        "entry_id": "0d62020e-2011-3d37-b9aa-2f06fba08be8",
                                        "glosses": [
                                            "Of or pertaining to the political right."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "439151b9-8eb7-45e9-ae50-73e1c2c3900f",
                                                "sense_id": "47c0d73d-a50d-3a32-b59d-1bfbe763fae3",
                                                "text": "Hearsay even got \"freeped.\" \"Freepers,\" followers of a rightist Web site called Free Republic, orchestrated a \"Freeper Call to Action.\""
                                            },
                                            {
                                                "example_id": "822c0b21-7211-45dc-83e7-af9201a77ad0",
                                                "sense_id": "47c0d73d-a50d-3a32-b59d-1bfbe763fae3",
                                                "text": "Whether a Hidalgo candidacy can galvanize the left and throw open an election in which Emmanuel Macron, the centrist president, and Marine Le Pen, the rightist candidate, remain favorites is unclear."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47c5981f-602b-44b6-ad44-8fbbad8e6538",
                        "source_entry_id": "2db9be0d-b3d1-3bc4-9c55-e0b117f9c145",
