                "senses": [
                    {
                        "sense_id": "e064a055-949a-39fd-875b-98c8de596d01",
                        "entry_id": "e181b8a0-b5eb-3a55-bd2c-282c342b4703",
                        "glosses": [
                            "Donner une nouvelle cuisson à la porcelaine pour qu'elle imite le japon."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "52a26e80-eb38-43b0-aa8b-6cfbd47f02e1",
                                "sense_id": "e064a055-949a-39fd-875b-98c8de596d01",
                                "text": "JAPONNER, v. act. (Poterie.) c'est donner une nouvelle cuisson aux porcelaines de la Chine, pour les faire passer pour porcelaines du Japon. Par cette manoeuvre pratiquée en Angleterre & en Hollande, on colore en rouge & l'on ajoûte des fleurs & des filets d'or aux pieces de la Chine, qui sont toutes bleues & blanches; mais ces ornemens ajoûtés, ayant trop d'éclat, on les affoiblit par le feu: avec toutes ces précautions, les connoisseurs ne sont pas trompés."
                            }
                        ]
                    }
