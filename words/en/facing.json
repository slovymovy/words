                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers applied a new brick <w>facing</w> to the front of the old concrete building.",
                            "target_lang_translations": {
                                "ru": "Рабочие нанесли новую кирпичную <w>облицовку</w> на фасад старого бетонного здания."
                            }
                        },
                        {
                            "text": "We chose a stone <w>facing</w> to give the house a more rustic appearance.",
                            "target_lang_translations": {
                                "ru": "Мы выбрали каменную <w>отделку</w>, чтобы придать дому более деревенский вид."
