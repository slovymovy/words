                                        "sense_id": "64708b30-d705-38cd-bd55-54b17bcc74f3",
                                        "entry_id": "7002a7f3-f48b-3bf8-96ea-c93945b2038f",
                                        "glosses": [
                                            "Troisième personne du pluriel du présent de l’indicatif de présider."
                                        ],
