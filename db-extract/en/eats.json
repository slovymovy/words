                    {
                        "sense_id": "0cc4bbb9-1242-34f1-b414-3634882a4a9a",
                        "entry_id": "a224094a-b023-3bfe-b9f7-1afa98d40f0b",
                        "glosses": [
                            "Food."
                        ],
                        "tags": [
                            "colloquial",
