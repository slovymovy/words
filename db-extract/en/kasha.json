                                            {
                                                "example_id": "37350a23-fba6-451b-9504-24d4649844e7",
                                                "sense_id": "26d4ec47-7b4e-3098-b0bb-1231873a708e",
                                                "text": "Za to w miejsce kaszy lub ryżu, nasypałem wyłuszczonych ziaren kukurydzy"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "21864c1f-9254-35bf-97b9-065e7c5fa4bf",
                                        "entry_id": "c071028e-824e-3ab0-9043-02e692d5e8a2",
                                        "glosses": [
                                            "potrawa z kaszy (1.1)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c842944c-c2e5-4a58-be9e-90d8fa6b65fd",
                                                "sense_id": "21864c1f-9254-35bf-97b9-065e7c5fa4bf",
                                                "text": "Bo jajka mi szkodzą. Zresztą, nie wiem, może to nie jajka, a kasza. W każdym razie na pewno coś mi szkodzi – indyczył się dziadek"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9fe12364-5298-4970-b64a-9e1f9757b28a",
                        "source_entry_id": "e7c1b35f-c53c-3b54-901b-5d472e795b57",
