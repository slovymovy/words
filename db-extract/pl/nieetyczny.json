                "senses": [
                    {
                        "sense_id": "352ace34-93e9-3583-a631-851fc32224c6",
                        "entry_id": "73dcde55-8f2f-3083-8a32-dd470e7e51f3",
                        "glosses": [
                            "niezgodny z etyką"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a026bb6-f1c4-40ec-aa90-fc068943383a",
                                "sense_id": "352ace34-93e9-3583-a631-851fc32224c6",
                                "text": "To dzięki świadomości potrafisz myśleć logicznie, dokonywać wyborów, oceniać, wyodrębniać to, co korzystne dla ciebie od tego, co niekorzystne i nieetyczne, a także podejmować decyzje"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e4417b1-63d6-4486-96b2-77d7b11ca370",
                        "source_entry_id": "73dcde55-8f2f-3083-8a32-dd470e7e51f3",
                        "source_sense_id": "352ace34-93e9-3583-a631-851fc32224c6",
                        "target_lang_word": "unethical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unethical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b90cf019-1231-385a-b9e4-effaacefba65",
                                        "entry_id": "58747afb-fde0-3170-9d73-8bdf3e40e14d",
                                        "glosses": [
                                            "Breaching the established standards of conduct or behavior within a particular organization or profession."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "314143c0-94d5-4818-8c66-6ce565c78363",
                                                "sense_id": "b90cf019-1231-385a-b9e4-effaacefba65",
                                                "text": "He was sacked for unethical conduct."
                                            },
                                            {
                                                "example_id": "45c8e467-821c-4ef2-9b04-5fca0b67d620",
                                                "sense_id": "b90cf019-1231-385a-b9e4-effaacefba65",
                                                "text": "The following potentially unethical coding practices are presented along with the standard from the AHIMA Standards of Ethical Coding that they may violate."
                                            },
                                            {
                                                "example_id": "05215613-50da-4a20-ba6e-3cab2ab9721f",
                                                "sense_id": "b90cf019-1231-385a-b9e4-effaacefba65",
                                                "text": "However, occasionally one encounters unethical but not immoral practice, because in China, market regulations are neither sufficient nor regularly updated."
                                            },
                                            {
                                                "example_id": "b5d37c72-d80f-47d1-88fd-497ad7c91e71",
                                                "sense_id": "b90cf019-1231-385a-b9e4-effaacefba65",
                                                "text": "For example, individuals accused of unethical conduct might challenge the decision rendered by an ethics review panel if they were displeased with the ethics review process or outcome."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1203cc4f-6ba7-351e-bdc9-c58b9d217df8",
                                        "entry_id": "58747afb-fde0-3170-9d73-8bdf3e40e14d",
                                        "glosses": [
                                            "Immoral, morally wrong."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a00e2afa-bbc4-41ed-bfda-2a9161d644db",
                                                "sense_id": "1203cc4f-6ba7-351e-bdc9-c58b9d217df8",
                                                "text": "The Southwest Foundation for Biomedical Research in San Antonio, Texas is one of only a handful of sites around the world that conduct medical research on great apes. Scientists say their research is conducted humanely, but many animal rights groups say testing on chimps is unneeded and unethical."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "afbc9320-2732-4f0a-8dda-931bd27e7aea",
                        "source_entry_id": "73dcde55-8f2f-3083-8a32-dd470e7e51f3",
                        "source_sense_id": "352ace34-93e9-3583-a631-851fc32224c6",
