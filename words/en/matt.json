    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b8724167-c356-3541-83ac-e32b796cd10e",
                    "sense_definition": "Having a dull, non-reflective surface; an alternative spelling of <w>matte</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "surface_finish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist chose a <w>matt</w> finish for the photograph to avoid glare.",
                            "target_lang_translations": {
                                "zh": "艺术家为照片选择了<w>哑光</w>效果，以避免反光。"
                            }
                        },
                        {
                            "text": "She painted the walls with a <w>matt</w> paint that hides imperfections well.",
                            "target_lang_translations": {
                                "zh": "她用一种<w>哑光</w>漆粉刷墙壁，这种漆能很好地掩盖瑕疵。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dull",
                        "flat",
                        "lustreless"
                    ],
                    "antonyms": [
                        "glossy",
                        "shiny"
                    ],
                    "common_phrases": [
                        "matt finish",
                        "matt paint"
                    ],
                    "target_lang_definitions": {
                        "zh": "指表面暗淡、不反光的；哑光的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "哑光",
                                "target_lang_sense_clarification": "形容表面没有光泽的。"
                            },
                            {
                                "target_lang_word": "无光",
                                "target_lang_sense_clarification": "指物体表面不反光。"
                            }
                        ]
                    }
                }
            ]
        },
