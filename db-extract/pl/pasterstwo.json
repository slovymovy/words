                "translations": [
                    {
                        "translation_id": "3d57a47d-2b90-4ec3-b704-d99ec9d52180",
                        "source_entry_id": "cb312a3c-1bce-3c52-97ab-64eb0fd06a82",
                        "source_sense_id": "e39ac2ca-1de0-353a-97ee-a85e66280b0b",
                        "target_lang_word": "herding",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "herding",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7dd66271-f4f7-371a-acd9-a43e170122cd",
                                        "entry_id": "09a8cb26-307c-3cba-9e76-2421a81619b4",
                                        "glosses": [
                                            "present participle and gerund of herd"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
