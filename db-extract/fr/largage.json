                                                "sense_id": "ae0269a2-d1c6-3843-816a-d9a12cb33dbc",
                                                "text": "Dass er sein Leben im Rollstuhl verbringen muss, ist allein auf den Abwurf vom Pferde zurückzuführen."
                                            },
                                            {
                                                "example_id": "4e7f29ea-9d6b-4226-ad09-a056e65e49a5",
                                                "sense_id": "ae0269a2-d1c6-3843-816a-d9a12cb33dbc",
                                                "text": "Grundsätzlich ist Reiten keine besonders verletzungsträchtige Sportart – allerdings sind die Verletzungen durch den Abwurf vom Pferd mitunter schwerwiegend."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "d74d1461-162f-3987-b28c-386bfa2237cf",
                                        "entry_id": "8922dd7f-c615-3aa0-8968-0cb26a22e050",
                                        "glosses": [
                                            "Fehler bei Sportbewerben (meist Sprungbewerben) durch das Berühren eines Hindernisses"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33ea847f-e4f8-4e2d-b8ab-0b42b4b384ff",
                                                "sense_id": "d74d1461-162f-3987-b28c-386bfa2237cf",
                                                "text": "Jeder Abwurf brachte 4 Strafpunkte ein."
                                            },
                                            {
                                                "example_id": "7f16aded-9e81-4ff3-a2b9-5a8f677ab6f3",
                                                "sense_id": "d74d1461-162f-3987-b28c-386bfa2237cf",
                                                "text": "Ein Abwurf und eine langsamere Zeit als de Miranda Neto brachten Schwizer und seiner Stute Carlina Rang Zwei und 100.000 € Preisgeld ein."
                                            },
                                            {
                                                "example_id": "666bac22-51c4-44e6-8f29-c3d080be1467",
                                                "sense_id": "d74d1461-162f-3987-b28c-386bfa2237cf",
                                                "text": "Ein Abwurf in der Teamwertung weniger und Deutschland hätte Mannschaftsgold im Springreiten geholt, so [ARD-Reitexperte Marc] Eschweiler."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
