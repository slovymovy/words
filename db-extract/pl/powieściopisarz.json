                    {
                        "translation_id": "b40fe930-68bd-49c5-b468-184d45de83b2",
                        "source_entry_id": "75cdab17-08a4-3a69-8091-8b7d86cb9758",
                        "source_sense_id": "3d5f56ca-12d5-31c3-aabf-c44fb70278dc",
                        "target_lang_word": "Romanschriftsteller",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Romanschriftsteller",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d204b208-651c-30bf-a1ee-755063a41f36",
                                        "entry_id": "89c4d75a-4bf5-3769-8307-cda481f1fc42",
                                        "glosses": [
                                            "jemand, der Romane verfasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0044c05-a255-458a-8230-6bfc49883ce9",
                                                "sense_id": "d204b208-651c-30bf-a1ee-755063a41f36",
                                                "text": "„Ein Romanschriftsteller muss die Welt neu erfinden, muss sich Gefühle, Antworten und Wirklichkeiten ausdenken, aber sie, die Weltreisenden, müssen nur hinschauen und hinhören.“"
                                            },
                                            {
                                                "example_id": "5b527d6b-2d22-4977-9074-f133e98381de",
                                                "sense_id": "d204b208-651c-30bf-a1ee-755063a41f36",
                                                "text": "„Der Romanschriftsteller Daniel Defoe hat als vorgeblicher Zeitzeuge die Londoner Schreckenstage später in einer Art Reportage beschrieben.“"
                                            },
                                            {
                                                "example_id": "aee69a5a-e9ac-484b-bc5e-d8775fc82cc2",
                                                "sense_id": "d204b208-651c-30bf-a1ee-755063a41f36",
                                                "text": "„Der Romanschriftsteller steht vor der Aufgabe, tief, mit allen Mitteln der realistischen Einfühlung, in das Labyrinth der menschlichen Natur zu dringen.“"
                                            },
                                            {
                                                "example_id": "f5a3d04e-3e88-4989-bbe7-6a6dc2987b1d",
                                                "sense_id": "d204b208-651c-30bf-a1ee-755063a41f36",
                                                "text": "„Scott, so sollte ich erfahren, glaubte daran, dass der Romanschriftsteller alles, was er brauchte, durch direktes Befragen seiner Freunde und Bekannten in Erfahrung bringen konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
