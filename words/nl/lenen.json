    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5e43a989-6e94-30b1-b11d-86123fb547ae",
                    "sense_definition": "iets wat eigendom is van een ander tijdelijk gebruiken, vaak met de bedoeling het terug te geven",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bruikleen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik wil graag een interessant boek <w>lenen</w> bij de plaatselijke bibliotheek.",
                            "target_lang_translations": {
                                "en": "I would like to <w>borrow</w> an interesting book from the local library."
                            }
                        },
                        {
                            "text": "Zou ik misschien jouw fiets mogen <w>lenen</w> om naar de stad te gaan?",
                            "target_lang_translations": {
                                "en": "Could I perhaps <w>borrow</w> your bike to go to the city?"
                            }
                        }
                    ],
                    "synonyms": [],
                    "antonyms": [
                        "uitlenen"
                    ],
                    "common_phrases": [
                        "geld lenen",
                        "een boek lenen",
                        "lenen van"
                    ],
                    "target_lang_definitions": {
                        "en": "To temporarily use something that belongs to someone else, usually with the intention of returning it."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "borrow",
                                "target_lang_sense_clarification": "to receive something temporarily"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d1d1779-2be5-39ff-a701-e9a3854c7bdd",
                    "sense_definition": "iets tijdelijk aan een ander geven voor gebruik",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bruikleen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kun je me alsjeblieft even een pen <w>lenen</w> voor deze toets?",
                            "target_lang_translations": {
                                "en": "Could you please <w>lend</w> me a pen for this test?"
                            }
                        },
                        {
                            "text": "Mijn broer wilde zijn auto niet aan mij <w>lenen</w> dit weekend.",
                            "target_lang_translations": {
                                "en": "My brother didn't want to <w>lend</w> his car to me this weekend."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitlenen"
                    ],
                    "antonyms": [
                        "lenen van"
                    ],
                    "common_phrases": [
                        "iemand iets lenen"
                    ],
                    "target_lang_definitions": {
                        "en": "To temporarily give something to someone else for their use."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lend",
                                "target_lang_sense_clarification": "to give something temporarily"
                            },
                            {
                                "target_lang_word": "loan",
                                "target_lang_sense_clarification": "to provide something for temporary use"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4dca4578-e9dd-33f8-8512-b3ac59243168",
                    "sense_definition": "zich ergens goed voor lenen; geschikt of passend zijn voor een bepaalde activiteit",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geschiktheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het zonnige weer <w>leent</w> zich uitstekend voor een lange wandeling in het bos.",
                            "target_lang_translations": {
                                "en": "The sunny weather <w>lends itself</w> perfectly to a long walk in the forest."
                            }
                        },
                        {
                            "text": "Deze oude fabriek <w>leent</w> zich goed voor het organiseren van moderne kunsttentoonstellingen.",
                            "target_lang_translations": {
                                "en": "This old factory <w>is well-suited</w> for organizing modern art exhibitions."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zich lenen voor",
                        "zich lenen tot"
                    ],
                    "target_lang_definitions": {
                        "en": "To be well-suited or appropriate for a specific activity or purpose."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lend itself to",
                                "target_lang_sense_clarification": "to be suitable for"
                            },
                            {
                                "target_lang_word": "be suitable for",
                                "target_lang_sense_clarification": "to be appropriate for"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
