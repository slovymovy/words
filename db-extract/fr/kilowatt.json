        "fr-extract.jsonl": [
            {
                "entry_id": "262fdfaf-2d72-3301-8882-bd66383374f9",
                "word": "kilowatt",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3040bf13-877e-482e-ae67-83c46155e006",
                        "entry_id": "262fdfaf-2d72-3301-8882-bd66383374f9",
                        "tags": [
                            "plural"
                        ],
                        "form": "kilowatts"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "341d9de0-0bdb-35fc-a039-57aa1df05021",
                        "entry_id": "262fdfaf-2d72-3301-8882-bd66383374f9",
                        "glosses": [
                            "Unité de mesure de puissance du Système international (SI), valant 10³ watts, et dont le symbole est kW."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "c016ad69-137e-449f-af6a-6171937046bb",
                                "sense_id": "341d9de0-0bdb-35fc-a039-57aa1df05021",
                                "text": "La chute de Saint-Martin-Vésubie dérive les eaux de la Haute-Vésubie par une galerie souterraine dans une centrale de 20.000 kilowatts située à 2 kilomètres à l'aval de Saint-Martin-Vésubie."
                            },
                            {
                                "example_id": "4c592686-ee03-4c4a-90fd-72bb781b785a",
                                "sense_id": "341d9de0-0bdb-35fc-a039-57aa1df05021",
                                "text": "Je viens de faire le compte de ce que nous ont coûté, en kilowatts et en heures chômées, les élucubrations électriques du sieur Lagaffe, le bien nommé…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "79d38ca5-5540-40cf-9bea-adbdee8269e7",
                        "source_entry_id": "262fdfaf-2d72-3301-8882-bd66383374f9",
                        "source_sense_id": "341d9de0-0bdb-35fc-a039-57aa1df05021",
                        "target_lang_word": "Kilowatt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kilowatt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a9f25329-a74f-336c-bb75-1ee728f4d626",
                                        "entry_id": "e9240964-c8d5-39f0-84bb-7ba8112ee9de",
                                        "glosses": [
                                            "eintausend Watt; Leistung, die erforderlich ist, um eine Masse von einer Tonne pro Sekunde um 1 m/s zu beschleunigen"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9595413-3375-489a-83cc-df4b5fad2485",
                                                "sense_id": "a9f25329-a74f-336c-bb75-1ee728f4d626",
                                                "text": "Unsere Heizung leistet maximal 15 Kilowatt."
                                            },
                                            {
                                                "example_id": "2cc63dc4-9c0d-4a0f-8266-996fb2eebd59",
                                                "sense_id": "a9f25329-a74f-336c-bb75-1ee728f4d626",
                                                "text": "„1000 Watt sind 1 Kilowatt (kW).“"
                                            },
                                            {
                                                "example_id": "f93f9c68-a2e1-4686-be7d-d43155553b53",
                                                "sense_id": "a9f25329-a74f-336c-bb75-1ee728f4d626",
                                                "text": "„Wenn mir ein Kilowatt elektrischer Leistung gegeben ist, wieviel Kilowatt Leistung habe ich dann zum Heizen verfügbar?“"
                                            },
                                            {
                                                "example_id": "b507cf45-7338-48ce-8783-b3afec0334bc",
                                                "sense_id": "a9f25329-a74f-336c-bb75-1ee728f4d626",
                                                "text": "„So waren viele der frühen Solaranlagen recht klein, im Schnitt haben sie bei Sonnenschein eine Leistung von knapp fünf Kilowatt.“"
                                            },
                                            {
                                                "example_id": "15f1f13b-e14f-48b7-bf2f-d61bbd0ae58c",
                                                "sense_id": "a9f25329-a74f-336c-bb75-1ee728f4d626",
                                                "text": "„Bei Autos über 89 Kilowatt legten die Neuzulassungen sogar um 21,5 Prozent auf 85.915 zu.“"
                                            },
                                            {
                                                "example_id": "4f9cdebf-76e3-4b93-8756-8b0e47438c8c",
                                                "sense_id": "a9f25329-a74f-336c-bb75-1ee728f4d626",
                                                "text": "„Heute erhalten die Kantone von den Kraftwerkbetreibern pro Kilowatt Bruttoleistung 110 Franken.“"
                                            },
                                            {
                                                "example_id": "8697c402-1fb7-40dd-b0bb-aa01ebc39d6e",
                                                "sense_id": "a9f25329-a74f-336c-bb75-1ee728f4d626",
                                                "text": "„Eine Kleinklimaanlage im Fenster hat normalerweise 1500 Watt, eine zentrale Anlage vielleicht 5 bis 20 Kilowatt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c8451dc2-8681-30e6-aeaf-1d9a4c75cc72",
                                        "entry_id": "e9240964-c8d5-39f0-84bb-7ba8112ee9de",
                                        "glosses": [
                                            "Kilowattstunde; Arbeit, die erforderlich ist, um eine Masse von einer Tonne eine Stunde lang pro Sekunde um 1 m/s zu beschleunigen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b7d19be-fb7d-4328-a49b-52c9052de881",
                                                "sense_id": "c8451dc2-8681-30e6-aeaf-1d9a4c75cc72",
                                                "text": "„Die Wasserkraft in Island reicht schätzungsweise zur Produktion von 30 Mrd. Kilowatt pro Jahr.“"
                                            },
                                            {
                                                "example_id": "a6e1f68c-db4c-4e45-9941-82ee8bc45e44",
                                                "sense_id": "c8451dc2-8681-30e6-aeaf-1d9a4c75cc72",
                                                "text": "„Der Leistungsbedarf eines Gasgrills wird in kW/h (Kilowatt pro Stunde) angegeben.“"
                                            },
                                            {
                                                "example_id": "e9478a88-9714-4cb5-9e1a-9a3743389938",
                                                "sense_id": "c8451dc2-8681-30e6-aeaf-1d9a4c75cc72",
                                                "text": "„Sie wird 500 Kilowatt pro Stunde elektrisch und 580 Kilowatt pro Stunde thermisch liefern.“"
                                            },
                                            {
                                                "example_id": "833a287d-25e5-47a3-ac1e-84c0e4d9d4f1",
                                                "sense_id": "c8451dc2-8681-30e6-aeaf-1d9a4c75cc72",
                                                "text": "„Im Unterschied dazu definiert die elektrische Arbeit die abgegebene Menge Strom in einer bestimmten Zeitperiode (Kilowatt pro Stunde).“"
                                            },
                                            {
                                                "example_id": "956caf73-27a2-4fa4-bd5a-9268ed6e4bda",
                                                "sense_id": "c8451dc2-8681-30e6-aeaf-1d9a4c75cc72",
                                                "text": "„Als letzter Schritt wurde im Internet ein Solarkataster aufgeschaltet, in dem jeder Immobilienbesitzer per Klick das Potenzial für die Gewinnung von Solarstrom auf seinem Dach in Kilowatt pro Jahr ablesen kann.“"
                                            },
                                            {
                                                "example_id": "1a2407d8-04dc-4979-b304-fc6897b978cd",
                                                "sense_id": "c8451dc2-8681-30e6-aeaf-1d9a4c75cc72",
                                                "text": "„Seit 2001 hat Peking 56 Windmühlen gebaut, die 200 Millionen Kilowatt pro Stunde erzeugen, dreimal so viel wie ursprünglich geplant.“"
                                            },
                                            {
                                                "example_id": "c78c23ef-c6af-4058-a809-3c5c7eecdd42",
                                                "sense_id": "c8451dc2-8681-30e6-aeaf-1d9a4c75cc72",
                                                "text": "„Auf seinem Papier existieren sogar schon Gebäude, die ein Energieplus von 200 Kilowatt pro Jahr und Quadratmeter schaffen.“"
                                            },
                                            {
                                                "example_id": "f0c3f79e-b999-4904-814b-07568839b404",
                                                "sense_id": "c8451dc2-8681-30e6-aeaf-1d9a4c75cc72",
                                                "text": "„Anfang der neunziger Jahre trotzte eine durchschnittliche Anlage dem Wind 170 Kilowatt pro Jahr ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5ecdbdd-9b6b-4a87-adea-371bfff7d452",
                        "source_entry_id": "262fdfaf-2d72-3301-8882-bd66383374f9",
                        "source_sense_id": "341d9de0-0bdb-35fc-a039-57aa1df05021",
                        "target_lang_word": "kilowatt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kilowatt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81297f9a-3722-37c5-a35d-125d285fb397",
                                        "entry_id": "b528b133-4a9d-3a45-9e61-57d9a5003d46",
                                        "glosses": [
                                            "One thousand (10³) watts, an amount of power large enough to power such things as a typical home appliance (e.g., a microwave oven, a toaster, or a hair dryer). (Consuming 1 kilowatt during a duration of 1 hour consumes 1 kilowatt-hour of energy.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eab3e2e7-cf34-4dec-a878-519b0b66dabc",
                                                "sense_id": "81297f9a-3722-37c5-a35d-125d285fb397",
                                                "text": "Holonyms: MW, megawatt < GW, gigawatt < TW, terawatt < PW, petawatt"
                                            },
                                            {
                                                "example_id": "a4d980d7-561c-4da0-82d7-344d595d68cd",
                                                "sense_id": "81297f9a-3722-37c5-a35d-125d285fb397",
                                                "text": "Meronyms: mW, milliwatt < W, watt"
                                            },
                                            {
                                                "example_id": "a6308c93-60fc-4c36-b619-109049f640bd",
                                                "sense_id": "81297f9a-3722-37c5-a35d-125d285fb397",
                                                "text": "And one California kilowatt equals 3 East Coast KWs. And—as everybody knows that—we, on the East Coast, are the only legal ones."
                                            },
                                            {
                                                "example_id": "61d4fc12-bbca-4b9e-8000-3f538df4beec",
                                                "sense_id": "81297f9a-3722-37c5-a35d-125d285fb397",
                                                "text": "Each turbogenerator consisted of a steam turbine, powered by 900 psi of superheated steam, that was coupled by a set of reduction gears to a General Electric marine alternating-current generator operating at 1,800 rpm. Each generator had a capacity of 2,000 kilowatts of three-phase power at 450 volts and 60 hertz. The main 450-volt switchboard was energized by the two turbogenerators. The emergency switchboard, in the emergency generator room, was fed from the main switchboard through an electrical tie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57156653-2bda-363f-880d-cb86dbe27228",
                                        "entry_id": "b528b133-4a9d-3a45-9e61-57d9a5003d46",
                                        "glosses": [
                                            "Catachresis for kilowatt-hour."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
