                ],
                "senses": [
                    {
                        "sense_id": "e92e31d1-775d-3116-967a-1f5cbe79d597",
                        "entry_id": "5cb046ac-b8e8-38ad-9e8c-5f6441b6aca9",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8cd2d10-9a95-46a9-a36c-110167f545ee",
                                "sense_id": "e92e31d1-775d-3116-967a-1f5cbe79d597",
                                "text": "Frau Rosengart ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7acab41c-1674-49b6-bd61-ab983b6758d5",
                                "sense_id": "e92e31d1-775d-3116-967a-1f5cbe79d597",
                                "text": "Herr Rosengart wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7175c2aa-1425-434e-adb0-bee6bcddd1de",
                                "sense_id": "e92e31d1-775d-3116-967a-1f5cbe79d597",
                                "text": "Die Rosengarts fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "1fe2d1dd-f18d-4c33-b3fb-197c764c1910",
                                "sense_id": "e92e31d1-775d-3116-967a-1f5cbe79d597",
                                "text": "Der Rosengart trägt nie die Pullover, die die Rosengart ihm strickt."
                            },
                            {
                                "example_id": "539d3af8-2a25-42dc-ab7a-29fe61df4887",
                                "sense_id": "e92e31d1-775d-3116-967a-1f5cbe79d597",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Rosengart kommt, geht der Herr Rosengart.“"
                            },
                            {
                                "example_id": "9642a919-5bf0-4168-adc8-3a5c474a3bf5",
                                "sense_id": "e92e31d1-775d-3116-967a-1f5cbe79d597",
                                "text": "Rosengart kommt und geht."
                            },
                            {
                                "example_id": "a6e477e4-ef2a-497f-a24d-e68ed6b32376",
                                "sense_id": "e92e31d1-775d-3116-967a-1f5cbe79d597",
                                "text": "Rosengarts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
