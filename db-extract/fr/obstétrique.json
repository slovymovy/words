                "senses": [
                    {
                        "sense_id": "2100e8c2-07e7-3c3e-84e4-42b2cd2e38d4",
                        "entry_id": "a8762d81-9357-3699-b8d3-c0a2d738bdaf",
                        "glosses": [
                            "Qui a rapport avec la discipline médicale de l’obstétrique ou plus largement avec l’accouchement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c42d81c1-9fcd-420c-a88e-845f23c99081",
                                "sense_id": "2100e8c2-07e7-3c3e-84e4-42b2cd2e38d4",
                                "text": "En relation directe avec ce symbolisme sexuel, il nous faudra rappeler les multiples images du ventre de la Terre, de la mine assimilée à l’utérus et des minerais aux embryons — autant d’images qui confèrent une signification gynécologique et obstétrique aux rituels accompagnant les travaux des mines et de la métallurgie."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "b9c0c3a6-3ad0-34d3-815c-7b2629bfa93e",
                "word": "obstétrique",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1898fd44-4b83-4a63-ab09-d55bb5cb66aa",
                        "entry_id": "b9c0c3a6-3ad0-34d3-815c-7b2629bfa93e",
                        "tags": [
                            "plural"
                        ],
                        "form": "obstétriques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3e9c9fb7-1e3e-3b1c-aee0-7a4dee938e61",
                        "entry_id": "b9c0c3a6-3ad0-34d3-815c-7b2629bfa93e",
                        "glosses": [
                            "Partie de la médecine relative aux accouchements."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28c8a6c7-c851-4032-a176-6dbc926d4446",
                                "sense_id": "3e9c9fb7-1e3e-3b1c-aee0-7a4dee938e61",
                                "text": "L’obstétrique traditionnelle consiste à surveiller un phénomène physiologique en se tenant prêt à intervenir à tous les instants. L’obstétrique moderne consiste à perturber ledit phénomène de telle sorte que l’intervention devienne indispensable à l’heure exacte où le personnel est disponible. C’est beaucoup plus difficile."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b468f757-923b-4863-8c09-4923de163d00",
                        "source_entry_id": "b9c0c3a6-3ad0-34d3-815c-7b2629bfa93e",
                        "source_sense_id": "3e9c9fb7-1e3e-3b1c-aee0-7a4dee938e61",
                        "target_lang_word": "Geburtshilfe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geburtshilfe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "280dda33-8ca3-394f-b934-368f3f69a3bd",
                                        "entry_id": "51d230f6-0bd7-3df2-a8e3-682838b4eff1",
                                        "glosses": [
                                            "Teilgebiet der Gynäkologie, das sich mit dem normalen Geburtsablauf, mit dessen Komplikationen sowie der Betreuung von Schwangeren beschäftigt"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "797836c3-5eee-4de6-a9e6-1b3d7c4cbb90",
                                                "sense_id": "280dda33-8ca3-394f-b934-368f3f69a3bd",
                                                "text": "Für die Geburtshilfe benötigt man speziell ausgebildetes Personal."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aff0ad91-66c3-3ee9-b6a0-c6306f304cad",
                                        "entry_id": "51d230f6-0bd7-3df2-a8e3-682838b4eff1",
                                        "glosses": [
                                            "professionelle Hilfsmaßnahme während der Geburt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b428b908-7aee-495a-9783-610b0c7bb102",
                                                "sense_id": "aff0ad91-66c3-3ee9-b6a0-c6306f304cad",
                                                "text": "„Des Weiteren gab es Geburtshilfen, Unterstützung bei Todesfällen und besonderen Anlässen, Jubiläumsgeschenke und Treueprämien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
