                    },
                    {
                        "translation_id": "71a5e877-14f9-418d-b5e4-476496f1f446",
                        "source_entry_id": "b283a3f7-6fcf-329c-bb3d-933d9092389c",
                        "source_sense_id": "f4125a19-39c2-3751-8b2a-eee290238200",
                        "target_lang_word": "Fernwärme",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fernwärme",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95e96c85-6275-3646-af23-3290a64390f0",
                                        "entry_id": "2ef5064e-899a-3456-b5ec-1f3bc2017c45",
                                        "glosses": [
                                            "Wärme, die - in vielen Fällen als Nebenprodukt bei der Energieerzeugung anfällt und - über Röhren zu Abnehmern transportiert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6092de43-a4a9-4745-9f8f-14d6a2e1b94b",
                                                "sense_id": "95e96c85-6275-3646-af23-3290a64390f0",
                                                "text": "Wärme, die bei industriellen Prozessen zusätzlich anfällt, kann als Fernwärme genutzt werden."
                                            },
                                            {
                                                "example_id": "11e7e245-e26c-44ba-b469-4e39ea3121df",
                                                "sense_id": "95e96c85-6275-3646-af23-3290a64390f0",
                                                "text": "[Basel:] „Als Vorbild in Sachen Fernwärme gilt schweizweit die Basel-Stadt.“"
                                            },
                                            {
                                                "example_id": "a3fb1bca-11b6-4c89-ad69-315c2ce62bf2",
                                                "sense_id": "95e96c85-6275-3646-af23-3290a64390f0",
                                                "text": "„In puncto Fernwärme gehört Basel zu den Pionieren.“"
                                            },
                                            {
                                                "example_id": "81f14c18-32ce-4725-8cfb-d9f19b712d98",
                                                "sense_id": "95e96c85-6275-3646-af23-3290a64390f0",
                                                "text": "[Greifswald:] „Die Fernwärme soll zunehmend aus erneuerbaren Energien produziert werden.“"
                                            },
                                            {
                                                "example_id": "8581f5ad-4684-4193-b20e-5c86ed1f8f52",
                                                "sense_id": "95e96c85-6275-3646-af23-3290a64390f0",
                                                "text": "„Ende des Jahres soll die gesamte Anlage startklar sein, und dann rund 27.000 Hamburger Haushalte mit Fernwärme versorgen.“"
                                            },
                                            {
                                                "example_id": "1546d893-68b2-443f-821c-1e5f96501642",
                                                "sense_id": "95e96c85-6275-3646-af23-3290a64390f0",
                                                "text": "„Nach der Abschaltung des Kehrichtheizkraftwerks Josefstrasse soll Zürich-West vom Werk Hagenholz mit Fernwärme versorgt werden.“"
                                            },
                                            {
                                                "example_id": "5a207fb6-59de-4cd9-9a89-637c855b12aa",
                                                "sense_id": "95e96c85-6275-3646-af23-3290a64390f0",
                                                "text": "„Heute jedoch reicht bei der Fernwärme schon eine Temperatur von 120 Grad, um Wohnungen zu beheizen und mit Warmwasser zu versorgen.“"
                                            },
                                            {
                                                "example_id": "6bc9689f-6383-4389-b6e7-c050af0c648a",
                                                "sense_id": "95e96c85-6275-3646-af23-3290a64390f0",
                                                "text": "„In Scheepers Haus werden die insgesamt 14 Wohnungen über die Fernwärme mit heißem Wasser versorgt - zum Duschen beispielsweise und zum Heizen.“"
                                            },
                                            {
                                                "example_id": "e689726c-9c5b-4718-b1e7-6bcf1ef84652",
                                                "sense_id": "95e96c85-6275-3646-af23-3290a64390f0",
                                                "text": "„In ganz Rheinland-Pfalz werden nur zwei Prozent der Haushalte mit Fernwärme versorgt.“"
                                            },
                                            {
                                                "example_id": "f3304203-476d-43a5-a690-0b10d8193819",
                                                "sense_id": "95e96c85-6275-3646-af23-3290a64390f0",
                                                "text": "„Auch mit Hilfe der Fernwärme ist es Kopenhagen gelungen, die CO2-Emissionen innerhalb eines Jahrzehnts um 65 Prozent zu senken.“"
                                            },
                                            {
                                                "example_id": "bfb2b6e3-aab2-4921-8da2-1323a6010195",
                                                "sense_id": "95e96c85-6275-3646-af23-3290a64390f0",
                                                "text": "„Im Unterschied zu Dänemark ist in Deutschland Fernwärme zu mehr als 70 Prozent Abwärme von fossilen Kohle- oder Gaskraftwerken.“"
                                            },
                                            {
                                                "example_id": "1fcf8320-3917-4772-9fcd-5771e5fc6fc9",
                                                "sense_id": "95e96c85-6275-3646-af23-3290a64390f0",
                                                "text": "„Die Fernwärme ist bei den Dänen auch deshalb beliebt, weil die Preise für die Haushalte staatlich kontrolliert werden - also nicht nur der Markt die Energiepreise bestimmt.“"
                                            },
                                            {
                                                "example_id": "a29a6edd-a48d-42f1-847d-9395626ddbb5",
                                                "sense_id": "95e96c85-6275-3646-af23-3290a64390f0",
                                                "text": "[Schlagzeile:] „Kopenhagens Klima-Trumpf heißt Fernwärme für alle“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
