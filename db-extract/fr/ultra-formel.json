                        "examples": [
                            {
                                "example_id": "ffe658cf-b13d-4488-af8b-2835548052f0",
                                "sense_id": "a63ddcd9-91c9-337b-8e71-90ad1ac3cdbf",
                                "text": "L’esprit de finesse pourrait ici remédier à une carence par trop aveuglante des méthodes ultra-formelles !"
                            },
                            {
                                "example_id": "8c8550e5-eb0e-4af8-879a-6fbec132372d",
                                "sense_id": "a63ddcd9-91c9-337b-8e71-90ad1ac3cdbf",
                                "text": "Ce colloque, mis sur pied par le chanoine Feys, professeur à Louvain, avait amené au Congrès une soixantaine de spécialistes de cette science ultra-formelle."
                            },
                            {
                                "example_id": "053c5aaa-3493-4f12-80c0-25958028572b",
                                "sense_id": "a63ddcd9-91c9-337b-8e71-90ad1ac3cdbf",
                                "text": "Le côté ultra-formel des relations, qui passent par des messages et des réunions, fait perdre de l’humain et donc du sens."
                            }
                        ]
                    }
