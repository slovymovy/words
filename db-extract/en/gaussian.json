                        "sense_id": "95d8d4c0-e871-3851-8f11-48bfdbb18a86",
                        "entry_id": "3ed82dde-35cc-396f-b4e5-dae398b061e0",
                        "glosses": [
                            "Of or pertaining to Carl Friedrich Gauss."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94dc0c27-4e00-44c6-9da4-bc011f250d81",
                                "sense_id": "95d8d4c0-e871-3851-8f11-48bfdbb18a86",
                                "text": "The problem of inversion of the mgf/chf of a sum of lognormals to obtain the CDF/pdf is considered with special reference to methods related to Post Widder technique, Gaussian quadrature and the Fourier series method."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e581bad-0482-3d4f-bf39-a063aa094567",
                        "entry_id": "3ed82dde-35cc-396f-b4e5-dae398b061e0",
                        "glosses": [
                            "Normal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78bdb008-5ba3-433c-bf53-a2bcdd685239",
                                "sense_id": "5e581bad-0482-3d4f-bf39-a063aa094567",
                                "text": "The criterion for positivity was determined for each antigen of each species applying a mixture model to the PP data which assumed two inherent Gaussian distributions: a narrow distribution or seronegatives, and a broader distribution of seropositives."
                            }
                        ]
                    }
                ],
