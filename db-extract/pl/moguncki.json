                                            {
                                                "example_id": "ca98a7a9-4a8f-477d-8a2e-d524aebdc1e7",
                                                "sense_id": "1a19af26-baaa-3564-af68-7085daa582ef",
                                                "text": "„Die Mainzer Volkssternwarte wird zum Jahresende 2011, kurz vor ihrem 50. Jubiläum, aufgrund von Baumängeln geschlossen.“"
                                            },
                                            {
                                                "example_id": "09602745-9983-402d-b79d-0be3924e60fa",
                                                "sense_id": "1a19af26-baaa-3564-af68-7085daa582ef",
                                                "text": "„Die Verkündung des Mainzer Landfriedens durch Kaiser Friedrich II. ist das erste auch in deutscher Sprache erlassene Reichsgesetz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
