                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b1beb92a-92fe-30f1-9446-56e488aefb8a",
                                        "entry_id": "27288d2c-f341-31a3-949b-a4379946eb84",
                                        "glosses": [
                                            "durchsichtiges Mineral, Varietät des Berylls, von hellblauer bis meergrüner Farbe, das als Schmuckstein getragen wird"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73ced69b-c320-45ba-953f-ba08cb46070b",
                                                "sense_id": "b1beb92a-92fe-30f1-9446-56e488aefb8a",
                                                "text": "„Gefärbte Abarten des Berylls sind die Edelsteine ‚Smaragd‘ (grün; chromhaltiger Beryll) und ‚Aquamarin‘ (hellblau; eisenhaltiger Beryll).“"
                                            },
                                            {
                                                "example_id": "f5199781-c4c4-41fc-bc1f-259edf6647d0",
                                                "sense_id": "b1beb92a-92fe-30f1-9446-56e488aefb8a",
                                                "text": "„Aquamarin ist bis 750 C wärmebeständig, kann aber bei höheren Temperaturen die Farbe ändern, deshalb muss er beim Löten geschützt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
