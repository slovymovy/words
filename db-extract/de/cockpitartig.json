                "senses": [
                    {
                        "sense_id": "2c984f2e-25fb-397b-ad85-de7a08f931f5",
                        "entry_id": "20ebdcf9-7f52-3959-acb8-f0cae86fc6a9",
                        "glosses": [
                            "einem Cockpit ähnelnd, an ein Cockpit erinnernd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e1ceae1-bb82-40a0-bf33-94405eaf40fb",
                                "sense_id": "2c984f2e-25fb-397b-ad85-de7a08f931f5",
                                "text": "„Jetzt, an den warmen Tagen, war das Verdeck offen, und wenn man sich an die hölzerne Türleiste lehnte, konnte man den Kopf über den Fahrersitz neigen und den berauschenden Duft von kostbarem Leder schlürfen, konnte die cockpitartige schwarze Instrumentenfülle am Armaturenbrett bewundern, die feinen roten, zu den Sitzbezügen passenden Bodenteppiche, das blanke Wanussfurnier und den silbernen, zähnefletschenden Jaguarkopf an der Lenkradnabe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
