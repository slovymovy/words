                ],
                "senses": [
                    {
                        "sense_id": "bbd0c5bd-a4a3-3396-ad5d-6bd0e8ff96b6",
                        "entry_id": "7feaa8d6-cc8d-3857-927e-b34a92ddc3ea",
                        "glosses": [
                            "Maßeinheit für die Lautheit, den psychoakustischen Wert eines Schallereignisses (Einheitenzeichen: sone)"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "5d7616c4-35e3-41b9-b2de-1ccc92fbb7b1",
                                "sense_id": "bbd0c5bd-a4a3-3396-ad5d-6bd0e8ff96b6",
                                "text": "„Für Lautheiten größer 1 sone, also für Lautstärkepegel über 40 phon, führt jede Zunahme des Lautstärkepegels um 10 phon zu einer Verdopplung des Lautheitswerts in Sone.“"
                            },
                            {
                                "example_id": "5e1e31cb-eadc-46a8-8331-f9f2d3138132",
                                "sense_id": "bbd0c5bd-a4a3-3396-ad5d-6bd0e8ff96b6",
                                "text": "„Das Sone ist festgelegt durch einen Schall oberhalb der Hörgrenze mit einem Lautstärkepegel von 40 Dezibel, wobei eine Verdopplung der Lautheit im Bereich 20–120 dB eine Zunahme des Lautstärkepegels um 10 dB (10 phon) ergibt: […]“"
                            },
                            {
                                "example_id": "6370a437-8a08-4b35-9127-f5037c0517e7",
                                "sense_id": "bbd0c5bd-a4a3-3396-ad5d-6bd0e8ff96b6",
                                "text": "„Diesen Zusammenhang beschreibt der Begriff Lautheit, die Einheit hierfür ist das Sone, 40 Phon sind als 1 Sone definiert […].“"
                            },
                            {
                                "example_id": "51a28ce4-7fc3-4b8d-8f83-ec2ed20e6356",
                                "sense_id": "bbd0c5bd-a4a3-3396-ad5d-6bd0e8ff96b6",
                                "text": "„Es wurde deshalb eine eigene Skala für die subjektive Lautheit eingeführt, das Sone.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
