                    {
                        "form_id": "23109383-5a12-4604-bada-d6f0ba734fac",
                        "entry_id": "8139b185-e90e-3703-a536-eca8eb661529",
                        "tags": [],
                        "form": "tabouret",
                        "note": "officiële spelling tot 1954 en als toegelaten vorm tot 1996"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "58d25851-4030-38cd-bebc-29a54ea1b53e",
                        "entry_id": "8139b185-e90e-3703-a536-eca8eb661529",
                        "glosses": [
                            "stoeltje zonder leuning voor rug of armen, laag krukje"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5692724e-be46-4b35-99bd-c28e85e875f4",
                                "sense_id": "58d25851-4030-38cd-bebc-29a54ea1b53e",
                                "text": "Het zogenaamde ‘krukrecht’ bepaalde namelijk nauwkeurig wie recht had op welke stoel. Hoe hoger je rang, hoe mooier en kostbaarder de zetel. Voor de hoogst aanwezige was er de canapé, gevolgd door onder meer armstoelen met en zonder leuningen, stoelen met en zonder bekleding, krukken (‘taboeretten’) met fluweel of van hout, en ten slotte zitkussens. De aanwezigen zonder krukrecht bleven staan."
                            },
                            {
                                "example_id": "202bec6b-5a60-4d2f-8d9c-1266df66dcbc",
                                "sense_id": "58d25851-4030-38cd-bebc-29a54ea1b53e",
                                "text": "Voor de overlevering dat kinderen aan tafel moesten staan in plaats van te zitten, heb ik geen aanwijzingen gevonden, en ook de legendarische stok-in-de-rug is meer iets waarmee ouders dreigden als iemand er onderuitgezakt bij zat, dan dat zij het hun kinderen aandeden. Mevrouw Aeijelts herinnert zich wel een opeenvolging van taboeretten, lager naarmate de kinderen groter werden; het gebrek aan een leuning zou het rechtop zitten bevorderen, en een rechte houding was wel de allereerste eis van de tafel-etiquette. auteur=Ileen Montijn"
                            },
                            {
                                "example_id": "7ef3c635-ef19-4b55-a36a-981025ef8be2",
                                "sense_id": "58d25851-4030-38cd-bebc-29a54ea1b53e",
                                "text": "Hij glimlachte vriendelijk en zette zich op een taboeret naast Mary. ‘Vindt u goed dat ik hier ga zitten?’ vroeg hij."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "53ca02f6-663a-47ef-87a4-3b0b5902397f",
                        "source_entry_id": "8139b185-e90e-3703-a536-eca8eb661529",
                        "source_sense_id": "58d25851-4030-38cd-bebc-29a54ea1b53e",
                        "source_sense_description": "stoeltje zonder leuning voor rug of armen",
                        "target_lang_word": "Hocker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hocker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c47b5853-b658-32c0-8707-ea21dfdf461d",
                                        "entry_id": "6cfb65e4-e89f-3748-a668-4961b834747d",
                                        "glosses": [
                                            "einfaches Sitzmöbel ohne Rücken- und Armlehne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6df0a771-40a8-40b0-8a52-1a1b9a9ee5a3",
                                                "sense_id": "c47b5853-b658-32c0-8707-ea21dfdf461d",
                                                "text": "Tante Gerda sitzt auf unserem Hocker."
                                            },
                                            {
                                                "example_id": "442066ba-74cb-4f1f-ba0d-b8764d6263bb",
                                                "sense_id": "c47b5853-b658-32c0-8707-ea21dfdf461d",
                                                "text": "Der Film reißt auch niemanden vom Hocker."
                                            },
                                            {
                                                "example_id": "ddfe5ad8-93a0-4583-9651-49650fce0d69",
                                                "sense_id": "c47b5853-b658-32c0-8707-ea21dfdf461d",
                                                "text": "Die Präsentation hat mich echt vom Hocker gehauen."
                                            },
                                            {
                                                "example_id": "09b2349b-fd0d-4012-95f9-c225774ceaec",
                                                "sense_id": "c47b5853-b658-32c0-8707-ea21dfdf461d",
                                                "text": "„Ein kleines Publikum hatte sich um ihn versammelt, wir saßen auf den drei ungleichen Hockern, die eben noch in die Kammer paßten, oder standen in der Tür.“"
                                            },
                                            {
                                                "example_id": "6ae3c718-abdb-476c-9cbc-2e290031ab3e",
                                                "sense_id": "c47b5853-b658-32c0-8707-ea21dfdf461d",
                                                "text": "„Sie legte das Essen auf den Hocker und stellte den Rest der Sachen auf den Boden.“"
                                            },
                                            {
                                                "example_id": "b6de4ade-aab1-425c-8edd-624de4aa44d3",
                                                "sense_id": "c47b5853-b658-32c0-8707-ea21dfdf461d",
                                                "text": "„Ich ging an die Bar und setzte mich auf einen Hocker.“"
                                            },
                                            {
                                                "example_id": "8ff00b7a-eb0c-42d7-b27f-2dd3e39f4083",
                                                "sense_id": "c47b5853-b658-32c0-8707-ea21dfdf461d",
                                                "text": "„Ich bitte um ein Glas Wasser und bringe es meiner Mutter, die im Wohnzimmer auf einem Hocker in der Ecke sitzt und dann das Glas in den Händen hält, als habe sie vergessen, was damit anzufangen sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "22b3f181-ebec-397f-8253-09fdaa1c1432",
                                        "entry_id": "6cfb65e4-e89f-3748-a668-4961b834747d",
                                        "glosses": [
                                            "auf der Seite liegender Toter mit angezogenen Beinen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba48216e-ead9-407b-81b9-b1052033cd33",
                                                "sense_id": "22b3f181-ebec-397f-8253-09fdaa1c1432",
                                                "text": "In der Ausstellung des Dorfmuseums ist auch ein Hocker zu sehen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1a994d9b-996c-3bbc-8c7d-c77aa0c138a2",
                                        "entry_id": "6cfb65e4-e89f-3748-a668-4961b834747d",
                                        "glosses": [
                                            "jemand, der lange an einem Ort verweilt"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a90a686-1b2c-4533-880d-a6bbdd112794",
                                                "sense_id": "1a994d9b-996c-3bbc-8c7d-c77aa0c138a2",
                                                "text": "Jürgen ist ein guter Hocker, er sitzt dort drüben schon seit drei Stunden."
                                            },
                                            {
                                                "example_id": "1e534503-21b1-4c51-a64a-96b946dbee71",
                                                "sense_id": "1a994d9b-996c-3bbc-8c7d-c77aa0c138a2",
                                                "text": "„Wir wissen, daß die unlustige Figur des Hockers, der keinen Abgang finden kann, den Nachfahren der Germanen viel von ihrer Kontaktlust genommen hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Hocker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c2111bd9-e220-305b-9a6c-5eadca37d6ad",
                                        "entry_id": "9a78be87-b019-35a7-99f8-ff87f4cb7696",
                                        "glosses": [
                                            "deutscher Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "357237bd-22e3-4e25-86af-c145fac0b6ec",
                                                "sense_id": "c2111bd9-e220-305b-9a6c-5eadca37d6ad",
                                                "text": "Darf ich vorstellen? Herr und Frau Hocker."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f394702-0283-4d9a-a588-50901b8e6b03",
                        "source_entry_id": "8139b185-e90e-3703-a536-eca8eb661529",
                        "source_sense_id": "58d25851-4030-38cd-bebc-29a54ea1b53e",
                        "source_sense_description": "stoeltje zonder leuning voor rug of armen",
                        "target_lang_word": "Schemel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schemel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "22836848-253b-357f-8e0d-3c1592c99deb",
                                        "entry_id": "357969a6-51ba-3be3-87cf-d9150c563621",
                                        "glosses": [
                                            "einfacher Stuhl ohne Rückenlehne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8af908d2-6ec5-45fb-bb13-2a96d53915b9",
                                                "sense_id": "22836848-253b-357f-8e0d-3c1592c99deb",
                                                "text": "„Er tritt hinter sie, in die Enge zwischen der Balkontür und dem Schemel und betrachtet sein Porträt.“"
                                            },
                                            {
                                                "example_id": "de5c13da-31da-436a-8e97-f49137ac7e92",
                                                "sense_id": "22836848-253b-357f-8e0d-3c1592c99deb",
                                                "text": "Der Schemel fiel laut klappernd zu Boden."
                                            },
                                            {
                                                "example_id": "9fc85311-fa98-4445-af63-78bff9396552",
                                                "sense_id": "22836848-253b-357f-8e0d-3c1592c99deb",
                                                "text": "„Auf niedrigen Schemeln hocken die Mägde neben ihnen, um sie zu melken.“"
                                            },
                                            {
                                                "example_id": "e0e8434d-05a5-484f-a5b1-9d8beb9b9f53",
                                                "sense_id": "22836848-253b-357f-8e0d-3c1592c99deb",
                                                "text": "„Die setzt sich auf den Schemel, sieht ihn an.“"
                                            },
                                            {
                                                "example_id": "5e9d5700-97e5-4b61-8d47-64a82a83750d",
                                                "sense_id": "22836848-253b-357f-8e0d-3c1592c99deb",
                                                "text": "„Schließlich unterbrach er diesen Bericht, indem er seinen Schemel herumschwang und beim Sprechen mit beiden Händen spielte.“"
                                            },
                                            {
                                                "example_id": "0d11844d-3cab-4d08-979c-0a08734b6ef1",
                                                "sense_id": "22836848-253b-357f-8e0d-3c1592c99deb",
                                                "text": "„Andere Bewohner hockten auf dem Steinboden, als wollten sie Stühle und Schemel schonen, um sich ihres Besitzes länger zu erfreuen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "51f999e8-7d35-3358-a929-a0dec7dd7fed",
                                        "entry_id": "357969a6-51ba-3be3-87cf-d9150c563621",
                                        "glosses": [
                                            "kleine, niedrige Bank als Fußstütze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44815cc8-a66c-497e-80c8-7d46bc2ff613",
                                                "sense_id": "51f999e8-7d35-3358-a929-a0dec7dd7fed",
                                                "text": "„Schließlich unterbrach er diesen Bericht, indem er seinen Schemel herumschwang und beim Sprechen mit beiden Händen spielte.“"
                                            },
                                            {
                                                "example_id": "9dbde96d-7af1-4bde-aa54-340d589b9bf1",
                                                "sense_id": "51f999e8-7d35-3358-a929-a0dec7dd7fed",
                                                "text": "„Andere Bewohner hockten auf dem Steinboden, als wollten sie Stühle und Schemel schonen, um sich ihres Besitzes länger zu erfreuen.“"
                                            },
                                            {
                                                "example_id": "e6659e4b-1da3-43bc-8fe9-ba468c452def",
                                                "sense_id": "51f999e8-7d35-3358-a929-a0dec7dd7fed",
                                                "text": "Um die Beine hochzulegen, benutze ich einen Schemel."
                                            },
                                            {
                                                "example_id": "083ca89e-fb18-4a46-9aad-9d63114646b7",
                                                "sense_id": "51f999e8-7d35-3358-a929-a0dec7dd7fed",
                                                "text": "„Meine ganze Kindheit hindurch hatte Frank bei sich und Rita im Sessel gesessen und geraucht, den Aschenbecher auf der Armlehne, die Füße auf einen Schemel gelegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
