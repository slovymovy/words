                "senses": [
                    {
                        "sense_id": "5b797f8f-5f9b-3a58-8f52-265abd895295",
                        "entry_id": "431a4b84-b017-3f23-85cb-7288265fb29a",
                        "glosses": [
                            "harte, runde Kugel, mit der man beim Bowling die Kegel trifft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4832beaf-72d3-4da0-9427-b2d1eeb9288a",
                                "sense_id": "5b797f8f-5f9b-3a58-8f52-265abd895295",
                                "text": "„Daraufhin stürzten alle Passagiere in der Kabine, ob tot oder lebendig, auf den stählernen Boden zurück, landeten krachend auf der Ladefläche und kullerten wie Bowlingkugeln auf die vordere Wand zu.“"
                            },
                            {
                                "example_id": "a8d7707c-dae6-4f34-95b5-f90fc46397a5",
                                "sense_id": "5b797f8f-5f9b-3a58-8f52-265abd895295",
                                "text": "„Sandy war nie schwerer als eine fünfzehnpfündige Bowlingkugel, nur dass sie jetzt herumtobt wie ein ausgewachsener Werwolf.“"
                            },
                            {
                                "example_id": "1c8b3e78-9e75-44fb-bbd5-1263b5940bfc",
                                "sense_id": "5b797f8f-5f9b-3a58-8f52-265abd895295",
                                "text": "„›Sobald ich zum Wurf angesetzt habe, verschwindet die Bowlinghalle, und statt einer Kugel halte ich einen Kopf in der Hand. Auch alle anderen Bowlingkugeln sind abgeschlagene Köpfe...‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
