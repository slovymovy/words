                    "common_phrases": [
                        "vite vite"
                    ],
                    "target_lang_definitions": {
                        "en": "An exclamation used to urge someone to hurry.",
                        "ru": "Восклицание, которым торопят кого-либо или призывают действовать незамедлительно.",
                        "nl": "Uitroep waarmee iemand wordt aangespoord om zich te haasten of meteen te handelen.",
                        "de": "Ausruf, mit dem man jemanden zur Eile antreibt oder zu sofortigem Handeln auffordert.",
                        "pl": "Okrzyk wyrażający pilność lub popędzający kogoś do pośpiechu.",
