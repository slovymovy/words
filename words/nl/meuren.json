    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1870d540-f5e5-3866-ba7e-13784f3273ea",
                    "sense_definition": "Een zeer onaangename geur verspreiden; sterk stinken.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vuilnisbak staat al drie dagen buiten en begint enorm te <w>meuren</w>.",
                            "target_lang_translations": {
                                "en": "The trash can has been outside for three days and is starting to <w>reek</w> horribly."
                            }
                        },
                        {
                            "text": "Hij wil nooit zijn schoenen uitdoen omdat zijn voeten zo <w>meuren</w>.",
                            "target_lang_translations": {
                                "en": "He never wants to take off his shoes because his feet <w>stink</w> so much."
                            }
                        }
                    ],
                    "synonyms": [
                        "stinken"
                    ],
                    "antonyms": [
                        "ruiken"
                    ],
                    "common_phrases": [
                        "uit de bek meuren",
                        "enorm meuren"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal, slightly vulgar tone"
                        },
                        {
                            "trait_type": "slang",
                            "comment": "informal/slang word for stinken"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To emit a very unpleasant odor; to stink strongly."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stink",
                                "target_lang_sense_clarification": "emit a strong foul smell"
                            },
                            {
                                "target_lang_word": "reek",
                                "target_lang_sense_clarification": "smell strongly and unpleasantly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0f6c011-7e29-3492-a5c1-ff9b507fc4f6",
                    "sense_definition": "(Lui) slapen of lang in bed blijven liggen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rust",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij ligt nog steeds in zijn bed te <w>meuren</w> hoewel het al middag is.",
                            "target_lang_translations": {
                                "en": "He is still <w>sleeping in</w> his bed even though it is already afternoon."
                            }
                        },
                        {
                            "text": "In het weekend wil ik lekker lang in bed <w>meuren</w>.",
                            "target_lang_translations": {
                                "en": "On the weekend I want to enjoy <w>staying in bed late</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "maffen",
                        "pitten",
                        "slapen"
                    ],
                    "common_phrases": [
                        "in bed meuren",
                        "lang meuren"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal slang for sleeping"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To sleep (lazily) or stay in bed late."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sleep in",
                                "target_lang_sense_clarification": "stay in bed late"
                            },
                            {
                                "target_lang_word": "sack out",
                                "target_lang_sense_clarification": "sleep lazily"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "027bf2d0-d2a0-32d8-aa85-30282d5341ea",
                    "sense_definition": "Darmgassen laten ontsnappen; winden laten.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "lichaamsfuncties",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wie heeft er in deze kleine ruimte zitten <w>meuren</w>?",
                            "target_lang_translations": {
                                "en": "Who has been sitting in this small room <w>farting</w>?"
                            }
                        },
                        {
                            "text": "De hond lag op het kleed en zat voortdurend te <w>meuren</w>.",
                            "target_lang_translations": {
                                "en": "The dog was lying on the rug constantly <w>passing gas</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "scheten",
                        "wassen"
                    ],
                    "common_phrases": [
                        "stiekem meuren"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "vulgar/slang term"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To release intestinal gas; to pass wind/fart."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fart",
                                "target_lang_sense_clarification": "pass gas"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}