                        "entry_id": "b8ec6626-ddf0-3da6-9780-ca76c572f670",
                        "glosses": [
                            "een groep mensen die samen diefstal plegen, meestal herhaaldelijk en georganiseerd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75a7ab47-0723-4976-a93c-273b063b619b",
                                "sense_id": "c1d8f259-95e6-3eb4-95bd-5d1d54e60818",
                                "text": "Al twee weken lang is er een dievenbende op pad in het Brugse, en gisteren sloegen ze voor het eerst hun slag in het Noorden."
                            },
                            {
                                "example_id": "af83ceab-f48c-4c36-a8fe-df264913694c",
                                "sense_id": "c1d8f259-95e6-3eb4-95bd-5d1d54e60818",
                                "text": "Zelfs de Amsterdamse Zuidas, het rovershol dat Nederland jarenlang in stand hield om mee te kunnen profiteren van de Russische dievenbende, komt in beweging."
                            }
                        ]
                    }
                ],
