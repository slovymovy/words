                                "target_senses": [
                                    {
                                        "sense_id": "687a7c9e-4958-35fd-ab54-15d0c8cba2e9",
                                        "entry_id": "d04cc9b9-f781-3ca7-b81e-6d6bb8f75725",
                                        "glosses": [
                                            "Richtungsänderung einer Welle auf Grund einer lokalen Änderung der Brechzahl"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1844eb6-b14d-4f8e-bac3-d1b357f6ed7e",
                                                "sense_id": "687a7c9e-4958-35fd-ab54-15d0c8cba2e9",
                                                "text": "Ein schräg ins Wasser eingetauchter Stab sieht durch die Brechung geknickt aus."
                                            },
                                            {
                                                "example_id": "29a8aedb-da96-408f-a747-a731364efd26",
                                                "sense_id": "687a7c9e-4958-35fd-ab54-15d0c8cba2e9",
                                                "text": "„Im Osten stiegen dünne Nebelschwaden auf und leuchteten durch die Brechung des Sonnenlichts in allen Spektralfarben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3ed8cbb4-06e4-3bc9-9ba1-8b3eb6398f01",
                                        "entry_id": "d04cc9b9-f781-3ca7-b81e-6d6bb8f75725",
                                        "glosses": [
                                            "Bezeichnung für verschiedene Arten von Vokaländerungen aufgrund von Assimilation"
                                        ],
                                        "tags": [
                                            "Sprachwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb08d670-627e-4ad4-bab5-842f31526d3d",
                                                "sense_id": "3ed8cbb4-06e4-3bc9-9ba1-8b3eb6398f01",
                                                "text": "„Bezeichnung von Jacob Grimm, die sich in der traditionellen Terminologie der Vergleichenden Sprachwissenschaft auf unterschiedliche assimilatorische Vokalveränderungen bezieht…“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
