                        "cross_references": [
                            {
                                "target_word": "URL",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9484a707-58ad-3887-b48f-54fa1fa720b5",
                                        "entry_id": "05ab3618-384e-3877-908f-2d0aace74209",
                                        "glosses": [
                                            "Initialism of Uniform Resource Locator: the address of a web page, FTP site, audio stream or other Internet resource."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41631e3d-50f5-45d1-b437-be3559130ec6",
                                                "sense_id": "9484a707-58ad-3887-b48f-54fa1fa720b5",
                                                "text": "https://en.wiktionary.org/ is the URL of English Wiktionary."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36078dec-7b00-3d1f-9dfb-812b41f028af",
                                        "entry_id": "05ab3618-384e-3877-908f-2d0aace74209",
                                        "glosses": [
                                            "Initialism of Uniform Resource Locator: the address of a web page, FTP site, audio stream or other Internet resource.",
                                            "a domain name"
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9917206d-742a-48d6-bb6a-06bc7c232af2",
                                                "sense_id": "36078dec-7b00-3d1f-9dfb-812b41f028af",
                                                "text": "Google itself has even been accused of profiting from the work of cybersquatters who buy URLs that are near to famous ones, but which often get mistyped–a practice known as typosquatting."
                                            },
                                            {
                                                "example_id": "59182f6f-eb9a-4860-a61d-939e69b73177",
                                                "sense_id": "36078dec-7b00-3d1f-9dfb-812b41f028af",
                                                "text": "This illegal activity involves buying a URL that’s a misspelling of a popular kids site, e.g. bobthebiulder.com, and then serving hardcore porn ads."
                                            },
                                            {
                                                "example_id": "43a21dea-a8c6-47b8-9552-f50e7acde7a5",
                                                "sense_id": "36078dec-7b00-3d1f-9dfb-812b41f028af",
                                                "text": "For a few days leading up to Christmas that year, Howe set up a kiosk in a mall that sold domain names to average shoppers. They sold about 50 of them to people who were persuaded to buy a url and a hosting package for a present instead of a traditional gift for families and friends."
                                            },
                                            {
                                                "example_id": "0a5faf90-c0f1-4850-b8b3-e4eca60cae10",
                                                "sense_id": "36078dec-7b00-3d1f-9dfb-812b41f028af",
                                                "text": "Some of them appear to be simple website squatting, buying URLs in hopes that someone else will pay a premium for the real estate later […]"
                                            },
                                            {
                                                "example_id": "9889d76c-6a99-4a06-9b1e-e3c10eeb9ac1",
                                                "sense_id": "36078dec-7b00-3d1f-9dfb-812b41f028af",
                                                "text": "She bought a URL from GoDaddy and Defense of Democracy was born."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d68c00b5-b68c-37de-8c89-bf8099b02a7a",
                                        "entry_id": "05ab3618-384e-3877-908f-2d0aace74209",
                                        "glosses": [
                                            "Initialism of Uniform Resource Locator: the address of a web page, FTP site, audio stream or other Internet resource.",
                                            "The username associated with a Tumblr blog and typically included in its URL."
                                        ],
