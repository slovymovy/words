                "entry_id": "5e735c36-5b01-3175-b7a3-44860d7b7321",
                "word": "pipol",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f5df6bcd-d419-4151-b8ad-8123cd1074f1",
                        "entry_id": "5e735c36-5b01-3175-b7a3-44860d7b7321",
                        "tags": [
                            "plural"
                        ],
                        "form": "pipols"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fd5cd85d-d1a8-34d1-9f6a-78619b57bb23",
                        "entry_id": "5e735c36-5b01-3175-b7a3-44860d7b7321",
                        "glosses": [
                            "Arbre originaire de l’Inde (Ficus religiosa), sacré pour les bouddhistes, le pipal."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "730f0b4b-5b93-4911-8d02-0217def6c19b",
                                "sense_id": "fd5cd85d-d1a8-34d1-9f6a-78619b57bb23",
                                "text": "L’éléphant royal, toujours au poste d’honneur, marchait en tête de la colonne. Il venait d’écarter les rameaux d’un pipol à larges feuilles."
                            },
                            {
                                "example_id": "68b54a95-dae0-4414-bc0e-76fa59c5b253",
                                "sense_id": "fd5cd85d-d1a8-34d1-9f6a-78619b57bb23",
                                "text": "Un figuier de l’Inde ou un pipol marque en général la place des puits."
                            },
                            {
                                "example_id": "a557fe79-2805-42b9-aa4c-fc8edb5e7e5f",
                                "sense_id": "fd5cd85d-d1a8-34d1-9f6a-78619b57bb23",
                                "text": "Les lignes et les points foncés que vous voyez sont des arbres : des tamarins, des banyans, des pipols sacrés pour l’Hindou."
                            },
                            {
                                "example_id": "3c622949-03c4-4aff-9536-dd8c3953f499",
                                "sense_id": "fd5cd85d-d1a8-34d1-9f6a-78619b57bb23",
                                "text": "Très peu de palmiers, mais de petits groupes de banans, de tamarins, de pipols, plus larges que hauts, qui, disséminés sur la plaine, étendent leurs branches et semblent vous inviter à venir vous reposer à l'ombre de leur feuillage."
                            }
                        ]
                    }
                ],
