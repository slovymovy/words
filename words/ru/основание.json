                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На уроке химии мы изучали, как кислота реагирует на <w>основание</w>.",
                            "target_lang_translations": {
                                "en": "In chemistry class, we studied how an acid reacts with a <w>base</w>.",
                                "tr": "Kimya dersinde asidin bir <w>bazla</w> nasıl reaksiyona girdiğini inceledik."
                            }
