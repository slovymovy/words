                                "target_senses": [
                                    {
                                        "sense_id": "1e6b217b-e59b-3ef6-a43c-f89e35dd1880",
                                        "entry_id": "d5acdb36-b6f5-3d87-82ec-2e22b2495121",
                                        "glosses": [
                                            "A citizen of Russia."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a6aa6e2-6f5d-4f6f-8fc3-2fdfd6b94cf6",
                                                "sense_id": "1e6b217b-e59b-3ef6-a43c-f89e35dd1880",
                                                "text": "A grim smile plays about Tarzan’s lips. At least Rokoff will be cheated. How mad he will be! And death will be more merciful than he could have hoped for at the hands of the Russian."
                                            },
                                            {
                                                "example_id": "3c3e80fb-e5db-4f7f-be88-28567ad9f206",
                                                "sense_id": "1e6b217b-e59b-3ef6-a43c-f89e35dd1880",
                                                "text": "But be that as it may: the Great Russian chauvinist Voznesenskii knew exactly how best to touch upon the asiaphobic nerve of his fellow-countrymen, how to stimulate the deep-rooted irrational fears of the Russians of peril looming from Asia, and how to turn those fears against China."
                                            },
                                            {
                                                "example_id": "48674d63-e8fe-4d78-b306-d6954125c8d3",
                                                "sense_id": "1e6b217b-e59b-3ef6-a43c-f89e35dd1880",
                                                "text": "“I believe the Russians – the inhumane behavior of Russia does not justify it to get the fruits of the international community,” Wyden told CNN."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b92934bc-b6e8-3d5d-a0e2-c38ae77691ff",
                                        "entry_id": "d5acdb36-b6f5-3d87-82ec-2e22b2495121",
                                        "glosses": [
                                            "An ethnic Russian; a member of the East Slavic ethnic group which is native to, and constitutes the majority of the population of, Russia."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba987c58-e3d6-3855-8efe-722264d1cc0a",
                                        "entry_id": "d5acdb36-b6f5-3d87-82ec-2e22b2495121",
                                        "glosses": [
                                            "A person from the Soviet Union."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
