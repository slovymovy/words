    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e37d98a4-10ae-3a35-b3e3-fe9059455aaf",
                    "sense_definition": "Effectuer l'opération arithmétique de la multiplication.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mathématiques",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si vous <w>multipliez</w> ce chiffre par deux, vous obtiendrez la valeur finale."
                        },
                        {
                            "text": "L'élève a appris à <w>multiplier</w> facilement les nombres entiers."
                        }
                    ],
                    "antonyms": [
                        "diviser"
                    ],
                    "common_phrases": [
                        "multiplier par deux",
                        "multiplier un nombre"
                    ]
                },
                {
                    "sense_id": "cc6aa95a-cb52-34a3-8a71-1e030b88c091",
                    "sense_definition": "Augmenter considérablement en quantité ou en nombre.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "quantité",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis quelques mois, les incidents de ce genre se <w>multiplient</w> dans la région."
                        },
                        {
                            "text": "Cette nouvelle stratégie a permis de <w>multiplier</w> les ventes de façon spectaculaire."
                        }
                    ],
                    "synonyms": [
                        "accroître",
                        "augmenter"
                    ],
                    "antonyms": [
                        "diminuer",
                        "réduire"
                    ],
                    "common_phrases": [
                        "se multiplier rapidement"
                    ]
                },
                {
                    "sense_id": "5a8deddb-4ae1-34a4-bd6e-26f1e76b3523",
                    "sense_definition": "Faire une action à de nombreuses reprises ; répéter fréquemment.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le candidat <w>multiplie</w> les démarches auprès des entreprises pour trouver un emploi stable."
                        },
                        {
                            "text": "Il faut <w>multiplier</w> les efforts afin de terminer ce projet à temps."
                        }
                    ],
                    "synonyms": [
                        "accumuler",
                        "enchaîner",
                        "répéter"
                    ],
                    "common_phrases": [
                        "multiplier les efforts",
                        "multiplier les démarches"
                    ]
                },
                {
                    "sense_id": "df43c466-067a-39fc-aa71-824af8db5b4d",
                    "sense_definition": "Se reproduire abondamment, en parlant d'êtres vivants ou d'organismes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À cette température idéale, les bactéries se <w>multiplient</w> à une vitesse fulgurante."
                        },
                        {
                            "text": "Cette plante aquatique a tendance à se <w>multiplier</w> sans contrôle dans les étangs."
                        }
                    ],
                    "synonyms": [
                        "croître",
                        "proliférer"
                    ],
                    "common_phrases": [
                        "se multiplier rapidement"
                    ]
                },
                {
                    "sense_id": "f0bb73bf-17a1-3f81-8067-23fa84f9bcf2",
                    "sense_definition": "Déployer une activité débordante en intervenant partout et simultanément.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur se <w>multiplie</w> pour régler chaque problème avant l'arrivée des inspecteurs."
                        },
                        {
                            "text": "Elle s'est <w>multipliée</w> tout l'après-midi afin d'accueillir convenablement chaque invité."
                        }
                    ],
                    "synonyms": [
                        "se démener"
                    ]
                }
            ]
        }
    ]
