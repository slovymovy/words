                ],
                "senses": [
                    {
                        "sense_id": "08ca2129-148a-3f6f-b56c-ad05639801fa",
                        "entry_id": "fe88e563-7cab-3032-9cee-a8c2aa3d8257",
                        "glosses": [
                            "A type of crescent-shaped biscuit or bread roll."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "306a0ea2-e2f0-4a69-9cbe-25821859fc8a",
                                "sense_id": "08ca2129-148a-3f6f-b56c-ad05639801fa",
                                "text": "Bake the kipfel on wafers, in a very moderate oven."
                            },
                            {
                                "example_id": "a8f959ec-3d88-4e80-90c3-cf39fa366121",
                                "sense_id": "08ca2129-148a-3f6f-b56c-ad05639801fa",
                                "text": "The son of a former houseowner in the Stumpergasse told me that the young Hitler would go every morning to a Jewish distiller (Branntweiner) near his flat to have a small breakfast there consisting always of ‘a tea and a kipfel’."
                            },
                            {
                                "example_id": "26b7a79b-a6d7-45d8-b861-3d67b560002c",
                                "sense_id": "08ca2129-148a-3f6f-b56c-ad05639801fa",
                                "text": "From this fine, sweet, almost cake-like yeast dough, rolled out fairly thin, can be made a variety of delicious desserts, coffee cakes, butter horns, turnovers, crescent rolls, schnecken, kipfel, or nut rolls."
                            }
                        ]
                    }
                ],
