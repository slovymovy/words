                    "frequency": "Low",
                    "semantic_group_id": "selbstbetrachtung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er stand eine Viertelstunde vor dem Spiegel und <w>bewunderte</w> seinen neuen Anzug."
