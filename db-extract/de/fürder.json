                "senses": [
                    {
                        "sense_id": "88336d8b-fd78-306f-9d91-6a4c606c222c",
                        "entry_id": "a8769d72-0f7f-37de-8608-ac0b73256b0c",
                        "glosses": [
                            "in Zukunft"
                        ],
                        "tags": [
                            "literary",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "5ed3822a-dbec-4149-bc53-41b5ea226fef",
                                "sense_id": "88336d8b-fd78-306f-9d91-6a4c606c222c",
                                "text": "Dieses Schicksal blieb uns fürder erspart."
                            },
                            {
                                "example_id": "5fb0ce8a-27c7-42f9-8741-482fcf3182c3",
                                "sense_id": "88336d8b-fd78-306f-9d91-6a4c606c222c",
                                "text": "„Am sechsten Juli dieses Jahres beschloß der Löwe Franz Wüstenkönig aus dem großen Raubtierhaus des Berliner Zoologischen Gartens, fürder nicht mehr mitzumachen. Er brach aus.“"
                            },
                            {
                                "example_id": "d131c494-0c30-471c-a9a2-8dfac07a97ba",
                                "sense_id": "88336d8b-fd78-306f-9d91-6a4c606c222c",
                                "text": "„Sie dachte vergangener Zeiten, da auch sie jung und frühlingsgrün gewesen und einen Liebsten gehabt – aber den hatte sein Schicksal weit hinausgetrieben aus dem heimischen Tannwald, raubende Nordmänner, die einst mit Sengen und Brennen den Rhein herauf fuhren, hatten ihn und viel andere Heerbannleute gefangen mitgeschleppt und er war bei ihnen geblieben über Jahresfrist und hatte den Seemannsdienst gelernt und war wild und trotzig geworden in der Strandluft des Meeres, und wie sie ihn wieder frei gaben, trug er die Nordseesehnsucht mit sich in schwäbischen Wald, – die Gesichter der Heimath gefielen ihm nimmer wieder, die der Mönche und Priester am wenigsten, und das Unglück fügte es, daß er in zornigem Aufbrausen einen wandernden Mönch erschlug, der ihn gescholten, da war seines Bleibens nicht fürder.“"
                            },
                            {
                                "example_id": "5694820f-053c-4e8b-8175-baa8461a6396",
                                "sense_id": "88336d8b-fd78-306f-9d91-6a4c606c222c",
                                "text": "„Dem Weibervolk, das täglich aus- und einging, um dem Liebesgott zu opfern, schenkte er fürder keine Beachtung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f3f97b06-e7e3-3854-b90b-c3b57bc50f8d",
                        "entry_id": "a8769d72-0f7f-37de-8608-ac0b73256b0c",
                        "glosses": [
                            "räumlich voraus"
                        ],
                        "tags": [
                            "literary",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "89c12d23-765a-48fe-8d5b-648af10feab0",
                                "sense_id": "f3f97b06-e7e3-3854-b90b-c3b57bc50f8d",
                                "text": "Das große Gewitter zog fürder über das Land."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b92dcd23-0293-47bb-b5b2-9cb59ad80ce7",
                        "source_entry_id": "a8769d72-0f7f-37de-8608-ac0b73256b0c",
                        "source_sense_id": "88336d8b-fd78-306f-9d91-6a4c606c222c",
                        "source_sense_description": "veraltend, gehoben: in Zukunft",
                        "target_lang_word": "hereafter",
