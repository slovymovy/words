                    {
                        "translation_id": "cf4f0586-8d68-4db9-b12c-5134706844aa",
                        "source_entry_id": "f0db5f8a-5b29-3996-8174-8db916d5ed53",
                        "source_sense_id": "c85d6d68-12e3-34e7-911f-c41a9671e81b",
                        "target_lang_word": "urée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "urée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "84f17181-bd32-3f78-9272-6e3707dd4fca",
                                        "entry_id": "239cc71d-79ba-346b-a08b-2797defe4068",
                                        "glosses": [
                                            "Substance cristallisable, incolore, de formule chimique COH₄N₂, dont la présence caractérise l’urine de la plupart des animaux dont l’homme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f52c43ce-e5d2-4940-bece-43c9c3303320",
                                                "sense_id": "84f17181-bd32-3f78-9272-6e3707dd4fca",
                                                "text": "Le rein est le principal organe excréteur de l’organisme et il élimine les déchets d'origine métabolique. Le plus important déchet du métabolisme des protéines est l’urée."
                                            },
                                            {
                                                "example_id": "443e0235-ba80-44f3-8672-296ef3526a7d",
                                                "sense_id": "84f17181-bd32-3f78-9272-6e3707dd4fca",
                                                "text": "Qui peut sans rire prétendre savoir comment finira le projet de « fertiliser les océans avec du fer ou de l’urée pour favoriser la croissance du phytoplancton, grand consommateur de dioxyde de carbone » ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9dc84ea7-503e-3dd5-8fcf-745332f86772",
                                        "entry_id": "239cc71d-79ba-346b-a08b-2797defe4068",
                                        "glosses": [
                                            "Solution de ce corps dans l’eau à usage alimentaire dans certaines techniques d’élevage des bovins."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "798b86a3-370d-4d0f-b4c5-5ff36544da21",
                                                "sense_id": "9dc84ea7-503e-3dd5-8fcf-745332f86772",
                                                "text": "La ration de base vulgarisée jusqu’en 1988 est la paille de riz traitée à l’urée et distribuée fraîche aux animaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58f1eadc-641c-3742-8f84-c27102a40eda",
                                        "entry_id": "239cc71d-79ba-346b-a08b-2797defe4068",
                                        "glosses": [
                                            "Poudre ou granulés de ce corps à usage d’engrais azoté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "124f052f-e947-41b4-b623-b6f78f76d0f4",
                                                "sense_id": "58f1eadc-641c-3742-8f84-c27102a40eda",
                                                "text": "Formule optimale de 75 kg de superphosphate +25 kg d’urée à l’hectare permet d’augmenter le rendement du fonio à 50% du rendement potentiel de la variété (1,5t/ha contre 0,6 t/ha)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
