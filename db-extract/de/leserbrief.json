                        ],
                        "form": "die Leserbriefe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7d92b710-85f8-3eb6-9041-30b7c2e2d0e0",
                        "entry_id": "641dbb62-230a-3191-a5cb-e941544d64eb",
                        "glosses": [
                            "schriftliche Meinungsäußerung zu einem bestimmten Thema; meist Reaktion auf Zeitungs- und Zeitschriftenartikel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12ae4b95-1f53-4a14-aac2-ff7b04cfaa41",
                                "sense_id": "7d92b710-85f8-3eb6-9041-30b7c2e2d0e0",
                                "text": "Morgens liest sie als erstes die Leserbriefe in der Zeitung."
                            },
                            {
                                "example_id": "e3428c2c-c396-4b10-b663-73b3f669880b",
                                "sense_id": "7d92b710-85f8-3eb6-9041-30b7c2e2d0e0",
                                "text": "„Ich wurde infolge meines Leserbriefs von der Polizeigewerkschaft zu einer Podiumsdiskussion im Rahmen des Landesdelegiertentags in Dortmund eingeladen.“"
                            },
                            {
                                "example_id": "6e6283b6-d57d-4315-8ca0-4117197488d8",
                                "sense_id": "7d92b710-85f8-3eb6-9041-30b7c2e2d0e0",
                                "text": "„Nur selten wurde allerdings mitgeteilt, wer diese Nekrologe schrieb, und auch unter den meisten Leserbriefen fand sich keine Unterschrift.“"
                            },
                            {
                                "example_id": "65508ccb-b8aa-4687-88bd-adec788ff9c3",
                                "sense_id": "7d92b710-85f8-3eb6-9041-30b7c2e2d0e0",
                                "text": "„Die Presse spiegelte, in Leitartikeln und Leserbriefen, zugleich die Stimmung der Menschen wider.“"
                            },
                            {
                                "example_id": "ba6d5852-05fe-4ff8-87be-6441d82811cf",
                                "sense_id": "7d92b710-85f8-3eb6-9041-30b7c2e2d0e0",
                                "text": "„In Leserbriefen wird darüber Klage geführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
