                                "example_id": "ae8eaeb2-6091-457f-82b3-e5006fb9888a",
                                "sense_id": "0ca40f37-17eb-3d1d-bf65-23084ab445d4",
                                "text": "Het moet haar even hebben teruggebracht naar haar glorietijd in het prerevolutionaire Sint-Petersburg."
                            }
                        ]
                    },
                    {
                        "sense_id": "de267e44-807d-3234-932c-3da024f67fee",
                        "entry_id": "26f5706f-2837-3251-8224-5802f1fbd4f6",
                        "glosses": [
                            "periode in de geschiedenis dat men overwinningen behaalde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5344eff-9c27-4747-96a3-f7dfa87c3da1",
                                "sense_id": "de267e44-807d-3234-932c-3da024f67fee",
                                "text": "Woods, die in november 2020 zijn laatste toernooi speelde en daarna lange tijd revalideerde na een auto-ongeluk, maakte donderdag nog indruk. Twee dagen later strompelde hij over de baan en weinig deed herinneren aan zijn glorietijd."
                            }
                        ]
                    }
                ],
