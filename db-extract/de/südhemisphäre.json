                "senses": [
                    {
                        "sense_id": "ee652f20-48f1-3c6d-a12a-8cbed4114a2f",
                        "entry_id": "5e9e1be6-d250-37e6-9a38-1e510517822e",
                        "glosses": [
                            "südlich des Äquators gelegener Erdteil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36ab57a8-f58c-467e-bdf9-ca8225c8efd8",
                                "sense_id": "ee652f20-48f1-3c6d-a12a-8cbed4114a2f",
                                "text": "„Nirgends und niemals ist dieses Phänomen kräftiger ausgebildet als in dieser Jahreszeit auf der Südhemisphäre.“"
                            },
                            {
                                "example_id": "09136524-4c24-48ad-94e5-15270f397231",
                                "sense_id": "ee652f20-48f1-3c6d-a12a-8cbed4114a2f",
                                "text": "„Auf der Nordhemisphäre weist die Strömung Winde aus SW bis WSW, auf der Südhemisphäre solche aus WNW bis NW auf.“"
                            },
                            {
                                "example_id": "6608745b-6da9-4a3f-baad-9308e06b0741",
                                "sense_id": "ee652f20-48f1-3c6d-a12a-8cbed4114a2f",
                                "text": "„Die Südhemisphäre ist seit 1979 kernwaffenfrei Südafrika hatte bis zum Ende des Apartheit-Regimes ein ambitioniertes Kernwaffenprogramm und besaß 1979 fünf (vermutlich mithilfe Israels) entwickelte Nuklearsprengköpfe.“"
                            },
                            {
                                "example_id": "cd1bea44-06c2-465c-9618-2fac3abe2517",
                                "sense_id": "ee652f20-48f1-3c6d-a12a-8cbed4114a2f",
                                "text": "„Die Sternbilder der Südhemisphäre waren deutlich zu erkennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
