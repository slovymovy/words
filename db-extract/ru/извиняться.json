                    {
                        "sense_id": "72918334-ebeb-38e7-8f19-e5fd1062d0fc",
                        "entry_id": "97f01f28-7ad8-30bd-9f56-f7f1fe6e2bec",
                        "glosses": [
                            "разг. просить прощения, извинения у кого-то за сравнительно небольшой проступок или прегрешение"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fe012c87-2c7f-34d0-ba0c-13255cc5a8a2",
                        "entry_id": "97f01f28-7ad8-30bd-9f56-f7f1fe6e2bec",
                        "glosses": [
                            "разг. оправдываться, приводя что-либо в качестве смягчающего обстоятельства"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f1678a8-f9cb-42e8-a15e-648499172820",
                                "sense_id": "fe012c87-2c7f-34d0-ba0c-13255cc5a8a2",
                                "text": "И начали все, как бы сговорившись, извиняться. Первый сказал ему: «я купил землю, и мне нужно пойти посмотреть ее; прошу тебя, извини меня»."
                            }
                        ]
                    },
                    {
                        "sense_id": "5b7a430e-9ab6-3503-9b8d-653b0e0ebdcc",
                        "entry_id": "97f01f28-7ad8-30bd-9f56-f7f1fe6e2bec",
                        "glosses": [
                            "страд. к извинять"
                        ],
                        "tags": [
                            "passive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2a14066-41a6-47eb-9050-46851123de5d",
                        "source_entry_id": "97f01f28-7ad8-30bd-9f56-f7f1fe6e2bec",
                        "target_lang_word": "make excuses",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3626a80c-0874-4c33-beee-f6fe5a16bd7a",
                        "source_entry_id": "97f01f28-7ad8-30bd-9f56-f7f1fe6e2bec",
                        "target_lang_word": "apologize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apologize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4aeaebb-fddf-328b-ac8f-9d6260b7f64e",
                                        "entry_id": "c25c2703-2b52-3325-81fe-1c9dee6b04cc",
                                        "glosses": [
                                            "To make an apology or excuse; to acknowledge some fault or offense, with expression of regret for it, by way of amends"
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "intransitive",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f74ebdc-d6c7-4048-b305-7dcd527578de",
                                                "sense_id": "a4aeaebb-fddf-328b-ac8f-9d6260b7f64e",
                                                "text": "My correspondent apologized for not answering my letter."
                                            },
                                            {
                                                "example_id": "5e808de4-1307-49df-b0d1-7047b17df96e",
                                                "sense_id": "a4aeaebb-fddf-328b-ac8f-9d6260b7f64e",
                                                "text": "Barnes was commanded, with Garrett and Jerome, to make a public acknowledgment of his errors; and to apologize especially for his insolent language to Gardiner"
                                            },
                                            {
                                                "example_id": "19ec5421-2f1b-47dc-b51a-bd2579f78aad",
                                                "sense_id": "a4aeaebb-fddf-328b-ac8f-9d6260b7f64e",
                                                "text": "Today I want to apologize to my co-workers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "566eb54c-981b-3c82-9bf1-150ab0b2a9f6",
                                        "entry_id": "c25c2703-2b52-3325-81fe-1c9dee6b04cc",
                                        "glosses": [
                                            "To express regret that a certain event has occurred."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "df58b731-fe42-359a-99ae-954e10ceacd4",
                                        "entry_id": "c25c2703-2b52-3325-81fe-1c9dee6b04cc",
                                        "glosses": [
                                            "To make an apologia or defense; to act as apologist."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "dated",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2ed9704-da00-4841-8516-8ce03dd1e313",
                                                "sense_id": "df58b731-fe42-359a-99ae-954e10ceacd4",
                                                "text": "To this purpose the most witty, cautious and subtile ſort of the Pagans apologize for themselves"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
