    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fea1ba5f-41b3-3056-9cc3-a1b46886a1f4",
                    "sense_definition": "Serving to restore confidence or reduce anxiety.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "comforting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor gave a <w>reassuring</w> smile after checking the test results.",
                            "target_lang_translations": {
                                "ru": "После проверки результатов анализов врач <w>успокаивающе</w> улыбнулся."
                            }
                        },
                        {
                            "text": "It was <w>reassuring</w> to hear that the project was still on schedule.",
                            "target_lang_translations": {
                                "ru": "Было <w>обнадёживающе</w> услышать, что проект всё ещё идёт по графику."
                            }
                        }
                    ],
                    "synonyms": [
                        "comforting",
                        "encouraging",
                        "soothing"
                    ],
                    "antonyms": [
                        "alarming",
                        "worrying"
                    ],
                    "common_phrases": [
                        "reassuring smile",
                        "reassuring words",
                        "reassuring news"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вселяющий уверенность, успокаивающий, помогающий избавиться от тревоги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "успокаивающий",
                                "target_lang_sense_clarification": "приносящий облегчение или спокойствие"
                            },
                            {
                                "target_lang_word": "обнадёживающий",
                                "target_lang_sense_clarification": "дающий надежду и уверенность в успехе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
