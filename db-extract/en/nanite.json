                        "glosses": [
                            "Synonym of nanorobot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54dc9310-3fdf-4faf-b0b3-3afb7d02a089",
                                "sense_id": "cec5d2da-5e75-3615-8f61-21beeb76111e",
                                "text": "I had the nanites install the brackets, then climbed up there with the panels, placed them on the brackets, and had the nanites secure them."
                            },
                            {
                                "example_id": "a99ce624-e7e1-4e4e-89f0-9bd89c2a4724",
                                "sense_id": "cec5d2da-5e75-3615-8f61-21beeb76111e",
                                "text": "Disperse into a cloud of nanites."
                            },
                            {
                                "example_id": "bf0d941e-8a0b-4c64-8b1d-5cf134421214",
                                "sense_id": "cec5d2da-5e75-3615-8f61-21beeb76111e",
                                "text": "\"Anyway,\" their guide continued, \"he didn't know the first thing about tech. Pushed the team hard. We couldn't get a chemical solution that worked right, but nanites showed real promise.\"\n\"You're joking.\" Quinn didn't even try to keep the horror from her voice.\n\"Memory-altering nanite clouds?\" Tonya growled. \"What did they call this, Project Grey Goo? That's wildly irresponsible.\""
                            },
                            {
                                "example_id": "017e9d6b-15e6-4603-a497-dd33d32055d3",
                                "sense_id": "cec5d2da-5e75-3615-8f61-21beeb76111e",
                                "text": "“A nanite cluster has infested the resort, consuming metal to self-replicate. Starfleet has ordered us to humanely capture and study the microscopic robots.”"
                            }
                        ]
                    }
