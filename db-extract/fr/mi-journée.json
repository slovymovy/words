                "senses": [
                    {
                        "sense_id": "826bd7db-6370-3ac6-a5dc-5b0c41d1bef7",
                        "entry_id": "cf761ad0-8cb8-3372-84f8-6d250ee599c9",
                        "glosses": [
                            "Environ la moitié d’une journée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8582d384-ade3-4d9b-ad6d-65d843ce4dc6",
                                "sense_id": "826bd7db-6370-3ac6-a5dc-5b0c41d1bef7",
                                "text": "Départ La Provence de cet été 1945 dispensait ses charmes habituels: fraîcheur des levers du jour embellis par l’immuable Ste-Victoire, écrasante chaleur des mi-journées génératrice d’incendies de broussailles et de fûtaïes, douceur des soirs au moins dans l’ombrede la Chaîne de l’Étoile (…)."
                            },
                            {
                                "example_id": "cd9a6759-b7bb-4797-b3a8-8c1e60a02eb1",
                                "sense_id": "826bd7db-6370-3ac6-a5dc-5b0c41d1bef7",
                                "text": "La circulation des trains a repris à la mi-journée, après une grosse heure d’interruption, selon lui."
                            }
                        ]
                    },
                    {
                        "sense_id": "19dc5416-70b3-3b97-b385-99e08ff2bce3",
                        "entry_id": "cf761ad0-8cb8-3372-84f8-6d250ee599c9",
                        "glosses": [
                            "La moitié d’une journée de travail."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45922de6-9af9-46c2-89f3-19f202967ae2",
                                "sense_id": "19dc5416-70b3-3b97-b385-99e08ff2bce3",
                                "text": "Autre motif possible pour une mesure plus précise du temps chez les marchands : une meilleure délimitation de la mi-journée, dans la mesure où cela autorisait une subdivision de la journée de travail rémunérée, à une époque où l’on avait coutume d’embaucher les manœuvres ou ouvriers occasionnels « à la journée »."
                            },
                            {
                                "example_id": "4ff3828a-90cb-4255-96fc-129bcc556f77",
                                "sense_id": "19dc5416-70b3-3b97-b385-99e08ff2bce3",
                                "text": "(…) la référence à une mesure du temps exprimé en nombre de journées ou de mi-journées travaillées est plus adaptée en ce qui les concerne que le calcul en heures."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd4fef9e-3463-430b-b937-d8f90f6625f6",
                        "source_entry_id": "cf761ad0-8cb8-3372-84f8-6d250ee599c9",
                        "target_lang_word": "Tagesmitte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tagesmitte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6b619585-91cb-39d6-8ed2-69c834e835be",
                                        "entry_id": "e62697d4-2a80-31c8-9053-9ed7612246bf",
                                        "glosses": [
                                            "Zeitraum, der die Hälfte eines Tages darstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2397bb5-5aed-4391-a5f7-e737ddfa8582",
                                                "sense_id": "6b619585-91cb-39d6-8ed2-69c834e835be",
                                                "text": "„Auch Unternehmen mit sommerlicher Frühschicht, die um 15 Uhr endet, lassen ihren Mitarbeitern Zeit für das Ausruhen in der Tagesmitte.“"
                                            },
                                            {
                                                "example_id": "fd697d13-a0fb-48c9-b1b3-8953b7d2100e",
                                                "sense_id": "6b619585-91cb-39d6-8ed2-69c834e835be",
                                                "text": "„Unklar bleibt vorerst, welchen Beitrag die nur zur Tagesmitte immer höher schießenden solaren Produktionsspitzen für die stabile, verlässliche Stromversorgung überhaupt haben, solange die Kilowattstunden nicht gespeichert werden können.“"
                                            },
                                            {
                                                "example_id": "0f0e660c-5bea-4080-9095-3e6c2d5ce633",
                                                "sense_id": "6b619585-91cb-39d6-8ed2-69c834e835be",
                                                "text": "„Die Natur habe offensichtlich beabsichtigt, daß zur Tagesmitte auch Erwachsene ein Schläfchen halten, ‚vielleicht, um sie aus der Sonne herauszukriegen‘, meint William Dement, Direktor am Schlafforschungszentrum der Stanford University.“"
                                            },
                                            {
                                                "example_id": "8eb39295-2301-4ecc-8231-3ee2887d9b88",
                                                "sense_id": "6b619585-91cb-39d6-8ed2-69c834e835be",
                                                "text": "„Wider Erwarten war sie aber selbst bis zur Tagesmitte noch nicht da.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
