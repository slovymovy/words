        "nl-extract.jsonl": [
            {
                "entry_id": "2571f01f-3c72-3bd1-9533-1221683f29c5",
                "word": "alsjeblieft",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a7aa8e4d-61c3-3f51-8f22-a2d9131c0205",
                        "entry_id": "2571f01f-3c72-3bd1-9533-1221683f29c5",
                        "glosses": [
                            "als beleefde aandrang bij een verzoek of versterking bij een bevel"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "9ddf094a-185a-44f0-85c9-b3c6f6f6bbc5",
                                "sense_id": "a7aa8e4d-61c3-3f51-8f22-a2d9131c0205",
                                "text": "Laten we samen door die gitzwarte tunnel gaan. Ergens moet licht gloren. Eens, zullen we het zien. Kom alsjeblieft bij me. Jij bent het enige wat ik nog heb."
                            },
                            {
                                "example_id": "3db22f06-148f-433b-aee9-4cd11bb1059f",
                                "sense_id": "a7aa8e4d-61c3-3f51-8f22-a2d9131c0205",
                                "text": "'Vertel het alsjeblieft niet aan je vader.'"
                            },
                            {
                                "example_id": "ab52b3a3-3723-4def-8e3f-d6888f3aade8",
                                "sense_id": "a7aa8e4d-61c3-3f51-8f22-a2d9131c0205",
                                "text": "En wanneer we 's avonds laat door de dunne wandjes hoorden dat Ome Theo tegen zijn vrouw Anja, een ietwat uitgeblust type met zwabberhaar, lispelde: 'Ome Theo gaat jou es effe lekker masseren', kreunde mama tegen papa: 'Kunnen we hier alsjeblieft weg?' Maar mama wilde eigenlijk de hele vakantie al weg."
                            }
                        ]
                    },
                    {
                        "sense_id": "8cc705f8-2225-3aa7-ad1e-6b5312920581",
                        "entry_id": "2571f01f-3c72-3bd1-9533-1221683f29c5",
                        "glosses": [
                            "gebruikt om vertwijfeling of irritatie te benadrukken"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "68cc1d8d-a5a0-44e4-8fda-27f46fa96f2b",
                                "sense_id": "8cc705f8-2225-3aa7-ad1e-6b5312920581",
                                "text": "Alsjeblieft zeg, wat een onzin!"
                            },
                            {
                                "example_id": "914e4ffc-c71e-49de-9c70-2f5746a2a96b",
                                "sense_id": "8cc705f8-2225-3aa7-ad1e-6b5312920581",
                                "text": "'Alsjeblieft, Isaac. Wie weet, misschien verkoopt hij Vrouwen in het graanveld niet eens. Dan blijft het toch nog in de familie. En zullen we dit allemaal vergeten en kun jij hem het jouwe geven.'"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a44f39d6-4aef-4cb1-a04a-93c9b4f88de6",
                        "source_entry_id": "2571f01f-3c72-3bd1-9533-1221683f29c5",
                        "source_sense_id": "a7aa8e4d-61c3-3f51-8f22-a2d9131c0205",
