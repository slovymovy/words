                "senses": [
                    {
                        "sense_id": "67e8a186-a4f9-3555-94db-e192f1189191",
                        "entry_id": "4c7d1208-8d60-3a4e-909e-c75898f8d35a",
                        "glosses": [
                            "Person, die eine Leichenschau vornimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2fb4709-2837-482c-8f14-9fed00168f8e",
                                "sense_id": "67e8a186-a4f9-3555-94db-e192f1189191",
                                "text": "„Er ist Bader, Meßner und Leichenbeschauer — eine Fülle der Gesichte!“"
                            },
                            {
                                "example_id": "4897b5bb-66df-4a8d-bc22-e70fac16b742",
                                "sense_id": "67e8a186-a4f9-3555-94db-e192f1189191",
                                "text": "„Im Büro des ärztlichen Leichenbeschauers jeder größeren Stadt ist man sich bewußt, daß viele mutmaßliche Fälle von Kindestötung nie vor Gericht kommen.“"
                            },
                            {
                                "example_id": "51bf9f3b-52c2-4341-8b5e-b33490eca2cf",
                                "sense_id": "67e8a186-a4f9-3555-94db-e192f1189191",
                                "text": "„Um sich erkenntlich zu zeigen, schickte dieser Hals über Kopf zwei Beamte und etliche Leichenbeschauer zur Besichtigung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
