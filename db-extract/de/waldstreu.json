                        "sense_id": "847e19e2-bdf5-347b-8cb4-9779fcb6fea6",
                        "entry_id": "bd46e56d-8bc9-3dab-afc2-8be4359b3f98",
                        "glosses": [
                            "Bodenbelag in einem Wald, aus Laub und anderem losem, grobem Zeug"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7521a757-bcb6-4d19-b3f2-391a10c3593b",
                                "sense_id": "847e19e2-bdf5-347b-8cb4-9779fcb6fea6",
                                "text": "„Ohne die Zufuhr von Waldstreu würde der Boden sehr bald humusarm und dann äußerst streng werden.“"
                            },
                            {
                                "example_id": "5dfdb0b1-98ca-4cd9-9fae-abf8858b646c",
                                "sense_id": "847e19e2-bdf5-347b-8cb4-9779fcb6fea6",
                                "text": "„Führt man Regenwürmer ein, können sie die Waldstreu in wenigen Monaten beseitigen, wobei sie die Nährstoffe in Form von Exkrementen im Boden ablagern.“"
                            }
                        ],
