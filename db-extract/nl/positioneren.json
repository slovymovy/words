                                                "example_id": "018d880e-5f1e-42e6-a6e4-41f7dcdee336",
                                                "sense_id": "d44071e7-dc2b-3f61-ab0a-1114f3f3724c",
                                                "text": "The cause therfore of divorce expres’t in the position cannot but agree with that describ’d in the best and equalest sense of Moses Law."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e858a6f-b516-3896-9af7-c26adb5dad1b",
                                        "entry_id": "3fd74e47-1ba3-3395-be64-9c6dd2fc1731",
