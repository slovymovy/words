                    },
                    {
                        "sense_id": "05269753-1a61-3eda-bac9-327a05d69602",
                        "entry_id": "74ce8a70-22b3-3f48-89e5-b77b7501d0cc",
                        "glosses": [
                            "hochrangige Priesterin in nichtchristlichen Kulten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99b22563-e116-4026-a49c-01eceed736d3",
                                "sense_id": "05269753-1a61-3eda-bac9-327a05d69602",
                                "text": "„Die Erzpriesterin Caracylea von Ancyra unter dem Antoninus Pius stammete von Königen, und wahrscheinlich vom Deiotarus oder Amyntas ab.“"
                            },
                            {
                                "example_id": "4501aa22-9f30-457b-882d-7422d0907521",
                                "sense_id": "05269753-1a61-3eda-bac9-327a05d69602",
                                "text": "„Ich war ja nicht irgendein alter Prinz, deshalb wartete natürlich eine Erzpriesterin auf mich.“"
                            },
                            {
                                "example_id": "118d57f2-85da-4cbf-bb90-990f847f0094",
                                "sense_id": "05269753-1a61-3eda-bac9-327a05d69602",
                                "text": "„Wie unsre Alkimilia ist auch die in Nr. 524 geehrte Athenapriesterin später Gattin eines zweifachen Erzpriesters und selbst Erzpriesterin geworden.“"
                            },
                            {
                                "example_id": "31dce173-1c39-4f43-b053-25d895757fad",
                                "sense_id": "05269753-1a61-3eda-bac9-327a05d69602",
                                "text": "„Im Frühjahr 193 wurde die Kronprinzessin zur Erzpriesterin (αρχιέρεια) des Reichskultes ihrer Mutter, der Königin Laodike, in der Satrapie Medien ernannt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
