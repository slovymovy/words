                "senses": [
                    {
                        "sense_id": "ff67ce84-c256-3d22-aa74-dd81609018d5",
                        "entry_id": "a0b1195d-b3fd-3c14-ad1b-0f52330cfab9",
                        "glosses": [
                            "Halle in einem Bahnhofsgebäude"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "159efa5c-f06e-45f6-9d05-8cd310f201a4",
                                "sense_id": "ff67ce84-c256-3d22-aa74-dd81609018d5",
                                "text": "„Ich ging also in die Bahnhofshalle und sah, dass der Service-Point nicht besetzt war.“"
                            },
                            {
                                "example_id": "0bb98cec-7067-4345-bef5-30e2b1d9ae00",
                                "sense_id": "ff67ce84-c256-3d22-aa74-dd81609018d5",
                                "text": "„Sie durchquerte die Bahnhofshalle und verließ sie durch den Ausgang, der zum Zoo führte.“"
                            },
                            {
                                "example_id": "87dfb0b6-ec30-4ad2-86f5-27d655ca3809",
                                "sense_id": "ff67ce84-c256-3d22-aa74-dd81609018d5",
                                "text": "„In der Bahnhofshalle traf sie wie vereinart Lothar, und sie nahmen umgehend den Zug nach Feldafing.“"
                            },
                            {
                                "example_id": "ccb2dcdb-5a17-4f48-8b22-4d5dd37fdb96",
                                "sense_id": "ff67ce84-c256-3d22-aa74-dd81609018d5",
                                "text": "„Eine alte Dampflok zieht etwa fünf Minuten vor Abfahrt die Waggons langsam in die Bahnhofshalle, speit Rauch und Wasserdampf in die Kuppel des Bahnhofs.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
