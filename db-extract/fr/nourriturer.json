                "senses": [
                    {
                        "sense_id": "f6518b53-e35f-34a8-8fac-127f166ecb9b",
                        "entry_id": "69c3858c-2392-36b7-943e-7eab1017a1f9",
                        "glosses": [
                            "Fournir de la nourriture à."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c05236f9-9c04-471d-be5b-2e670c2dad85",
                                "sense_id": "f6518b53-e35f-34a8-8fac-127f166ecb9b",
                                "text": "De même, une madame Olmert, que j'ai connue, s'attachait à nourriturer cacher chez elle, pour que tous puissent manger à sa table."
                            },
                            {
                                "example_id": "2e2a2dcc-827b-4b51-8952-75ab523cc5a1",
                                "sense_id": "f6518b53-e35f-34a8-8fac-127f166ecb9b",
                                "text": "En les nourriturant"
                            },
                            {
                                "example_id": "022c7a53-7dcb-4f13-aa30-f27a138c256b",
                                "sense_id": "f6518b53-e35f-34a8-8fac-127f166ecb9b",
                                "text": "nan jsuis pas partie, mais j'avais faim, donc je suis allée me nourriturer."
                            }
                        ]
