                    "sense_definition": "Very little or very few.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "insufficiency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prosecutor presented <w>scant</w> evidence to prove the defendant had been at the scene.",
