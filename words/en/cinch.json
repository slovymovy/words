    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "05915b85-ab5f-3f26-a18a-d06b71902c13",
                    "sense_definition": "Something that is very easy to do",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ease",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Passing the test was a <w>cinch</w> after studying all week.",
                            "target_lang_translations": {
                                "cs": "Udělal zkoušku byla <w>hračka</w> poté, co se celý týden učil."
                            }
                        },
                        {
                            "text": "Fixing the broken shelf was a <w>cinch</w> for him.",
                            "target_lang_translations": {
                                "cs": "Opravit tu rozbitou polici pro něj byla <w>brnkačka</w>."
                            }
