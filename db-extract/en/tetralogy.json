                                        "entry_id": "5f997177-a646-3e65-a28b-00bb0b2684fb",
                                        "glosses": [
                                            "Ensemble de quatre films, livres ou jeux formant une saga, une continuité."
                                        ],
                                        "tags": [
                                            "Jeux vidéo"
                                        ],
                                        "examples": [
                                            {
