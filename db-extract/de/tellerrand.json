                                "sense_id": "4c2254eb-5306-3af8-a803-164bd2047158",
                                "text": "Vielen Leuten gelingt es nicht, über ihren Tellerrand hinauszuschauen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
