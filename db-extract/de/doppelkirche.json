                "senses": [
                    {
                        "sense_id": "f0f15984-3603-3011-8261-06dea9b1bc3d",
                        "entry_id": "db9bc5bf-157e-3b15-8719-c56293e64f02",
                        "glosses": [
                            "zwei Kirchenräume, die in ein und demselben Gebäude übereinander untergebracht sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "694a130f-cf23-4d2b-92c5-8e9039cb8c40",
                                "sense_id": "f0f15984-3603-3011-8261-06dea9b1bc3d",
                                "text": "„Die romanische Doppelkirche des ehemaligen adeligen Frauenstifts in Schwarzrheindorf ist bei Kunstkennern als Bauwerk und wegen ihrer Malereien wohl bekannt.“"
                            },
                            {
                                "example_id": "c15924a8-15ce-4f86-8c35-20f30325b73d",
                                "sense_id": "f0f15984-3603-3011-8261-06dea9b1bc3d",
                                "text": "„Die Doppelkirche wurde um 1149 von Arnold von Wied erbaut und am 24. April 1151 eingeweiht. Der Begriff \"Doppelkirche\" vermag zwar das (für uns heute) Eigentümliche dieser Kirche zu kennzeichnen, führt aber doch insofern in die Irre, als er suggeriert, dass dies die einzige Kirche dieser Art - und deshalb Sehenswürdigkeit - sei, wie er auch in einer allzu simplen Erklärung (oben Herrschaften - unten Volk) Vorschub leistet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
