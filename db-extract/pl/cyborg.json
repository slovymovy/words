                                "target_senses": [
                                    {
                                        "sense_id": "f9ab10c2-d6a2-3c0c-b9c6-f79ef481f162",
                                        "entry_id": "b3541b91-b267-33b1-8349-ee5ffe34bbeb",
                                        "glosses": [
                                            "Mensch, dessen Körper mit künstlichen Bauteilen ausgestattet ist, vor allem um Organe zu ersetzen oder um sie leistungsfähiger zu machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc3d5330-0503-41fc-8092-9a8a1dacecb7",
                                                "sense_id": "f9ab10c2-d6a2-3c0c-b9c6-f79ef481f162",
                                                "text": "„Keine Science-Fiction, sondern Realität: Manche Menschen verändern mit Technik-Implantaten ihre Sinneswahrnehmung. Sie nennen sich Bodyhacker oder Cyborgs.“"
                                            },
                                            {
                                                "example_id": "4d310047-c1a1-4c94-883b-f95d70f8cd69",
                                                "sense_id": "f9ab10c2-d6a2-3c0c-b9c6-f79ef481f162",
                                                "text": "„Er dachte an Sunny und wie furchtbar er ihn vermisste und fragte sich, ob Cyborgs wohl auch dazu fähig waren, andere Menschen zu vermissen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "039be457-25db-4f80-875d-0f4da78f1840",
                        "source_entry_id": "6f466e90-898a-342d-acbb-0f9f06c074b3",
                        "source_sense_id": "fcc831fe-f17f-3953-9f81-77740d247a88",
