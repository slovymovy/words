    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d26da669-4e32-3562-ab57-9504fdb5a080",
                "word": "deckhouse",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e0d609de-78ee-412b-a968-1a11195de051",
                        "entry_id": "d26da669-4e32-3562-ab57-9504fdb5a080",
                        "tags": [
                            "plural"
                        ],
                        "form": "deckhouses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "88a127eb-e2f8-3a69-9a07-d91cb44f611e",
                        "entry_id": "d26da669-4e32-3562-ab57-9504fdb5a080",
                        "glosses": [
                            "A cabin that protrudes above a ship's deck."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ceac2e40-809b-4e4a-8769-e5b38c1ccba8",
                                "sense_id": "88a127eb-e2f8-3a69-9a07-d91cb44f611e",
                                "text": "Flinging himself on hands and knees he dragged the girl down with him. As he did so two of her companions came sliding down to their assistance, and the four glissaded back to the deckhouse as the following roll began."
                            },
                            {
                                "example_id": "d14535fd-f057-4223-a461-abe7448e6e26",
                                "sense_id": "88a127eb-e2f8-3a69-9a07-d91cb44f611e",
                                "text": "Then, through his web of contacts, he was told that the Nightingale’s original deckhouse was being used as a cottage on a private island outside of Kragero, Norway, a shipbuilding port."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38011e81-4b08-4df6-ab0d-c253cf5ace9e",
                        "source_entry_id": "d26da669-4e32-3562-ab57-9504fdb5a080",
                        "source_sense_id": "88a127eb-e2f8-3a69-9a07-d91cb44f611e",
                        "source_sense_description": "cabin on the deck of a boat",
                        "target_lang_word": "roef",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roef",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "15b6ed4d-7ed2-369a-bc17-9dc3d597741d",
                                        "entry_id": "cd93f0df-e48a-3380-83dd-7020ed42b263",
                                        "glosses": [
                                            "overdekt deel van een binnenvaartschip waar de schipper en zijn gezin kunnen wonen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37555eca-5f64-48c8-aad3-ef9257b52afa",
                                                "sense_id": "15b6ed4d-7ed2-369a-bc17-9dc3d597741d",
                                                "text": "Jan en Coby voelen zich niet van Zuid en niet van Noord, en ook niet van de wallers. „Die hebben toch nooit veel van het vrije schippersleven gesnapt”, zegt Jan, „Ik heb mensen aan de kade gehad die dachten dat wij ons op onze knieën door de roef moesten verplaatsen.”"
                                            },
                                            {
                                                "example_id": "d5b09c98-9d0b-4b2b-8556-3d1ca9b04a4e",
                                                "sense_id": "15b6ed4d-7ed2-369a-bc17-9dc3d597741d",
                                                "text": "De band is niet lek, het ventiel wel. Ik zoek in de roef naar een ander ventiel. Binnenkort komt er een extra raam in deze ruimte, zodat we door dat raam naar de kont van het schip kunnen klimmen. In één keer naar de mooiste plek van Amsterdam met uitzicht op het Amsterdam-Rijnkanaal. Ik heb zin om dat gat nu al te maken. Uitbreken. Weg uit deze donkere tobbe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "roef",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a2516a6f-4f4d-3c10-92ac-f870118627a0",
                                        "entry_id": "25d9ebb5-5453-3e23-90bf-37e2da08471f",
                                        "glosses": [
                                            "geeft aan dat iets in een snelle beweging wordt gedaan of opeens gebeurt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f6a9336-6f1d-4444-87a6-a8246a95883c",
                                                "sense_id": "a2516a6f-4f4d-3c10-92ac-f870118627a0",
                                                "text": "‘Willen jullie wel eens gauw maken dat je weg komt, apen van jongens, of moet de waterslang erbij te pas komen, dan gaan jullie wel,’ klonk Kruts stem. Roef, weg waren de jongens, doch op het hoekje bleven ze staan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1aa55a9-667a-4ce3-b6aa-84fcf15a7976",
                        "source_entry_id": "d26da669-4e32-3562-ab57-9504fdb5a080",
                        "source_sense_id": "88a127eb-e2f8-3a69-9a07-d91cb44f611e",
                        "source_sense_description": "cabin on the deck of a boat",
                        "target_lang_word": "rouf",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rouf",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6506702f-ef87-30c0-ab4a-92c92bac5637",
                                        "entry_id": "a94d6d50-fa75-3551-b147-3e091a46e26d",
                                        "glosses": [
                                            "Petit logement généralement situé à l'arrière du pont supérieur d'un bateau et ne s'étendant pas sur toute la largeur comme la dunette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af252333-9a29-4786-8e0d-19ffdb96fc5d",
                                                "sense_id": "6506702f-ef87-30c0-ab4a-92c92bac5637",
                                                "text": "L'énorme rouf construit sur l’embarcation et son gréement, démontraient l'inexpérience totale que son propriétaire avait des choses de la mer, […]."
                                            },
                                            {
                                                "example_id": "12a5e9d2-68ad-42c5-9017-df71895e50a5",
                                                "sense_id": "6506702f-ef87-30c0-ab4a-92c92bac5637",
                                                "text": "Sur le pont supérieur, le coq qui refermait les portes du rouf avait une altercation avec le jeune Charley au sujet d’une paire de chaussettes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "848df04b-6455-3fd1-bbc7-c2fa79445f61",
                                        "entry_id": "a94d6d50-fa75-3551-b147-3e091a46e26d",
                                        "glosses": [
                                            "Abri réservé à l'équipage sur le pont avant des navires marchands."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adcb3a38-18bd-4e87-beb0-a49084041b12",
                                                "sense_id": "848df04b-6455-3fd1-bbc7-c2fa79445f61",
                                                "text": "Il y avait deux femmes, qui causaient à voix basse, dans le rouf, et un douanier, près du treuil, qui roulait sa cigarette."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
