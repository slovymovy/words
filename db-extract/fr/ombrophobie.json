                        "glosses": [
                            "Peur irraisonnée de la pluie, de la grêle, des orages."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5f63f39-ea82-4ca7-a73a-338a521193d1",
                                "sense_id": "72acfd9d-1cf9-346a-ab5d-3ddf39a45ba9",
                                "text": "Si les causes des phobies sont souvent multifactorielles, dans le cas de l’ombrophobie, un événement traumatique comme une tempête, une tornade ou un orage particulièrement violent peut être à l’origine de son développement."
                            },
                            {
                                "example_id": "c70faca2-c309-490e-ad8f-b42ff7b4a40e",
                                "sense_id": "72acfd9d-1cf9-346a-ab5d-3ddf39a45ba9",
                                "text": "L’ombrophobie est donc une phobie qui impacte le quotidien car elle implique une surveillance irraisonnée et obsessionnelle de la météo."
                            }
                        ]
                    }
