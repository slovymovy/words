                "senses": [
                    {
                        "sense_id": "9ded014a-1cb7-319e-9c40-d03a67a8ec57",
                        "entry_id": "61e0e6e4-7ae9-31f7-8bdc-3fd76be72afb",
                        "glosses": [
                            "To read over, or peruse."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "72f49d12-f89d-4563-bd4e-dd2b1612b593",
                                "sense_id": "9ded014a-1cb7-319e-9c40-d03a67a8ec57",
                                "text": "Over the dore thus written she did spye, / Bee bold: she oft and oft it over-red, / Yet could not find what sence it figured […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "664e1f8b-208c-3494-8afa-42001d13fb45",
                        "entry_id": "61e0e6e4-7ae9-31f7-8bdc-3fd76be72afb",
                        "glosses": [
                            "To interpret something to a greater degree, or in a more positive way, than appropriate; read in too much depth; overinterpret; overanalyze."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "74957a6e-e29a-415b-91bf-b3f4d07d0907",
                                "sense_id": "664e1f8b-208c-3494-8afa-42001d13fb45",
                                "text": "To overread Plath's houses is to transform these biographical documents into spatial ones."
                            },
                            {
                                "example_id": "5b08acea-3d4a-4087-a649-6999d503fc5c",
                                "sense_id": "664e1f8b-208c-3494-8afa-42001d13fb45",
                                "text": "At the same time, we overread. That is, we find in narratives qualities, motives, moods, ideas, judgments, even events for which there is no direct evidence in the discourse."
                            },
                            {
                                "example_id": "8b36f3c9-dd07-4e9d-bbbc-740415919887",
                                "sense_id": "664e1f8b-208c-3494-8afa-42001d13fb45",
                                "text": "Did we just overread and overstate our place in the world?"
                            }
                        ]
                    },
                    {
                        "sense_id": "eb519195-90c0-3e0b-93ef-676cd547be84",
                        "entry_id": "61e0e6e4-7ae9-31f7-8bdc-3fd76be72afb",
                        "glosses": [
                            "To read too much or excessively."
                        ],
