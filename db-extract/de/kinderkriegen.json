                "senses": [
                    {
                        "sense_id": "912e5234-2423-3c9a-8516-dc4f8d0d177f",
                        "entry_id": "8d279ca1-cae5-3331-b0af-896a9b572ab0",
                        "glosses": [
                            "Aktion, ein Kind/Kinder zur Welt zu bringen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d37cbd6-29a4-435f-be5d-509455825fa9",
                                "sense_id": "912e5234-2423-3c9a-8516-dc4f8d0d177f",
                                "text": "„Nach der Kirchenlehre ist das auch der Sinn der Ehe und des Kinderkriegens.“"
                            },
                            {
                                "example_id": "11b4371f-fb4d-47de-8b00-0a14cf0f44fd",
                                "sense_id": "912e5234-2423-3c9a-8516-dc4f8d0d177f",
                                "text": "„Ich war mir nicht sicher, was das Kinderkriegen anbelangte, aber ich war mir sicher, dass Philip und ich unseren gemeinsamen Weg gehen würden.“"
                            },
                            {
                                "example_id": "ce2c0433-ddde-4712-b8ab-f1ffb65f69ae",
                                "sense_id": "912e5234-2423-3c9a-8516-dc4f8d0d177f",
                                "text": "„Aber es gab zu meiner Zeit sogar verheiratete Frauen, die den Zusammenhang zwischen den Possen ihrer Männer im ehelichen Bett und dem Kinderkriegen nicht begriffen hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
