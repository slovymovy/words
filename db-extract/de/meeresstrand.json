                "senses": [
                    {
                        "sense_id": "ab93b548-4739-3641-8a84-6bbfa80f3679",
                        "entry_id": "7540d666-b67d-3f2b-afb3-ad2287ac93e7",
                        "glosses": [
                            "Strand am Meer; Strand des/eines Meeres"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a20d9af0-4d35-4611-b187-732f0368c634",
                                "sense_id": "ab93b548-4739-3641-8a84-6bbfa80f3679",
                                "text": "„Von Wien aus fährt man zwar etliche Autostunden zum nächsten Meeresstrand. Für Wissenschaftler, die sich mit dem Thema Meer befassen, scheint Österreichs Hauptstadt trotzdem ein guter Boden zu sein […]“"
                            },
                            {
                                "example_id": "89229210-42bf-4ec4-b36c-e3ed19bc64b2",
                                "sense_id": "ab93b548-4739-3641-8a84-6bbfa80f3679",
                                "text": "„Privates Salzsieden, ja selbst das Auflesen von Salz am Meeresstrand war bei Strafe verboten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
