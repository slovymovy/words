                        "glosses": [
                            "Person, die sich ansiedelt oder ein Haus besetzt, ohne dazu berechtigt zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01ef3530-722d-4423-ad46-0742c1d0539e",
                                "sense_id": "becb31ae-d4ad-3fec-9eb3-99ab87ac4b86",
                                "text": "„Squatter hatten die Hütten einfach so auf sechzehn Hektar Sand gesetzt, daher gab es keine Anbindung an Kanalisation oder Stromversorgung, es stank und sah hässlich aus.\""
                            },
                            {
                                "example_id": "40f396fa-b733-438b-b1e1-7b1dba35722e",
                                "sense_id": "becb31ae-d4ad-3fec-9eb3-99ab87ac4b86",
                                "text": "„Bahrens war einer von den echten Pionieren oder Squattern des Westens.“"
                            }
                        ],
