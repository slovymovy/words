                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41c47e81-2320-460d-915a-727e6370a448",
                                "sense_id": "dae43eed-f684-312d-8ac7-a99a80eb940c",
                                "text": "Хутор Веселовский находится в Чертковском районе Ростовской области."
                            },
                            {
                                "example_id": "3c9870bc-4ac3-429e-818a-e7a778fd9814",
                                "sense_id": "dae43eed-f684-312d-8ac7-a99a80eb940c",
                                "text": "Веселовский поселковый совет Ясненского района Оренбургской области принял очередное постановление."
                            }
                        ]
                    }
