        "fr-extract.jsonl": [
            {
                "entry_id": "6c8a965b-dc81-39d9-aa62-89da43ad0052",
                "word": "essuie-tout",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0cbc0078-eae3-403e-a2c4-08d9627e62fb",
                        "entry_id": "6c8a965b-dc81-39d9-aa62-89da43ad0052",
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "form": "essuietout"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e157c8aa-6896-3a10-9098-493dfa14aad7",
                        "entry_id": "6c8a965b-dc81-39d9-aa62-89da43ad0052",
                        "glosses": [
                            "Papier absorbant, débité en rouleaux d’une largeur d’une vingtaine de centimètres, servant à éponger les débordements et à nettoyer en cuisine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63d4fe23-12d6-407a-bb0f-f5906f5328ed",
                                "sense_id": "e157c8aa-6896-3a10-9098-493dfa14aad7",
                                "text": "Si les mouchoirs sont en papier, si les essuie-tout se vendent si bien, c’est parce que, comme le papier-toilette, ils sont nettement plus hygiéniques."
                            },
                            {
                                "example_id": "70728ba2-8d27-47b0-a292-4668dd5b66ad",
                                "sense_id": "e157c8aa-6896-3a10-9098-493dfa14aad7",
                                "text": "Une femme, deux gamines, un adolescent et une femme plus âgée, peut-être la grand-mère, longent le papier toilette et l’essuie-tout à la queue leu leu d’un pas décidé, sans caddie. La plus vieille, à la traîne, proteste « C’est grand comme magasin ! »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f894a0da-7325-484b-b36a-17ebb1b62a4c",
                        "source_entry_id": "6c8a965b-dc81-39d9-aa62-89da43ad0052",
                        "source_sense_id": "e157c8aa-6896-3a10-9098-493dfa14aad7",
                        "source_sense_description": "Papier absorbant",
                        "target_lang_word": "Papiertuch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Papiertuch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b5097097-b87a-39e3-b008-6ba658ac121d",
                                        "entry_id": "68644236-3fbf-35bf-8908-a7cbf65279f9",
                                        "glosses": [
                                            "Feuchtigkeit absorbierendes Hygienepapier aus Zellstoff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9751b82-a801-4a30-8221-c1e7181f9edd",
                                                "sense_id": "b5097097-b87a-39e3-b008-6ba658ac121d",
                                                "text": "„›Mir ist kalt‹, sagt sie zu Edgerton. Er nickt, streichelt die Hand der jungen Frau, dann hält er einen Augenblick inne, um ihr mit einem Papiertuch das Blut von der linken Hand zu wischen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cdba8965-6266-4d4e-af33-5cb6b5512ca0",
                        "source_entry_id": "6c8a965b-dc81-39d9-aa62-89da43ad0052",
                        "source_sense_id": "e157c8aa-6896-3a10-9098-493dfa14aad7",
                        "source_sense_description": "Papier absorbant",
                        "target_lang_word": "Küchenpapier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Küchenpapier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7f67d9d4-4340-3eac-9174-927c408e6ce0",
                                        "entry_id": "8def2d40-3599-3897-aea4-d6938797efcf",
                                        "glosses": [
                                            "saugfähiges, weiches Papier für Küchenarbeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e6c8748-28f9-47ad-ac87-01f2a55df4fe",
                                                "sense_id": "7f67d9d4-4340-3eac-9174-927c408e6ce0",
                                                "text": "„Ich holte mir eine Rolle Küchenpapier und befreite den Diaprojektor vom ärgsten Staub.“"
                                            },
                                            {
                                                "example_id": "e5fef9a9-c127-4673-b893-a6c5e57ec1c8",
                                                "sense_id": "7f67d9d4-4340-3eac-9174-927c408e6ce0",
                                                "text": "„Berechnen sollte man beim Kochen auch, dass der Spargel nachgart, wenn man ihn mit einer Serviette oder Küchenpapier abdeckt.“"
                                            },
                                            {
                                                "example_id": "17c3ea06-7733-4d8c-ba33-f1c6a5b499b8",
                                                "sense_id": "7f67d9d4-4340-3eac-9174-927c408e6ce0",
                                                "text": "„Didier holte eine Rolle Küchenpapier und stellte sie vor mir auf den Tisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
