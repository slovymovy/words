                        ],
                        "examples": [
                            {
                                "example_id": "d5d0f670-ba63-4171-be98-5518e67ee4b4",
                                "sense_id": "823b4464-4974-3916-a9ef-059fd55ec7c2",
                                "text": "t'es le seul enseignant qui m'a ever \"phoné\" pour me badgeuler (m'engueuler)"
                            },
                            {
                                "example_id": "c4f7e592-35c0-4b09-b303-e1a7370d8f59",
                                "sense_id": "823b4464-4974-3916-a9ef-059fd55ec7c2",
                                "text": "Coumme qu'on dis, y f'ra pas beau dans la cahute une fois que Carméliste s'mettra à l'badgeuler..."
                            },
                            {
                                "example_id": "9f5a6124-66cc-45bc-94de-818057e16c00",
                                "sense_id": "823b4464-4974-3916-a9ef-059fd55ec7c2",
                                "text": "Quand qu'mon houmme Ozime a su coumment d'argent qu'j'avais blowé, y'a pas arrêté d'badgeuler depis..."
                            }
                        ]
                    },
                    {
                        "sense_id": "865f153b-6290-31a4-9da0-2113c20baffe",
