                        "form_id": "ed8a2ce4-8ea3-43c6-96da-39e2ab27064c",
                        "entry_id": "b5eaf1d2-de12-3d7d-af5d-400d2bb53bc9",
                        "tags": [
                            "plural",
                            "short-form"
                        ],
                        "form": "свѐтло-се́ры"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2e75dcdb-036c-35d1-bbf5-2a899f3f5b20",
                        "entry_id": "b5eaf1d2-de12-3d7d-af5d-400d2bb53bc9",
                        "glosses": [
                            "серый со светлым оттенком"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a5c959a-e3c7-415f-bf48-105cb7786b18",
                                "sense_id": "2e75dcdb-036c-35d1-bbf5-2a899f3f5b20",
                                "text": "Селезня должно бы назвать очень красивым: он весь пегий, зоб тёмно-багряный, на шее белая повязка, спина и крылья сизо-голубые, брюшко светло-серое."
                            },
                            {
                                "example_id": "9a3a8e5e-b4f4-4ad9-94a8-96614b624e2f",
                                "sense_id": "2e75dcdb-036c-35d1-bbf5-2a899f3f5b20",
                                "text": "В тени́ старой дуплистой вербы стояла светло-серая «Волга»."
                            },
                            {
                                "example_id": "6aed9d9e-c9a4-4bc4-8d5f-0c20f351e74a",
                                "sense_id": "2e75dcdb-036c-35d1-bbf5-2a899f3f5b20",
                                "text": "Вот я привычно и легко облекаюсь в кожаное пальто. На мне кепка из светло-серого материала… Представляете?"
                            }
                        ]
                    }
                ],
