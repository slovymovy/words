                ],
                "senses": [
                    {
                        "sense_id": "c1af42a9-6403-32cc-8a64-9c917e5f2cab",
                        "entry_id": "767c0698-4a01-3888-a962-1ec56688fac3",
                        "glosses": [
                            "To act in a submissive manner; to fawn, submit to a superior."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4d6fc747-553a-454a-8f86-ea62dd0341a8",
                                "sense_id": "c1af42a9-6403-32cc-8a64-9c917e5f2cab",
                                "text": "\"Why in the world should you spend your money, worry your family, and turn the house upside down for a parcel of girls who don't care a sixpence for you? I thought you had too much pride and sense to truckle to any mortal woman just because she wears French boots and rides in a coupe,\" said Jo, who, being called from the tragic climax of her novel, was not in the best mood for social enterprises. \"I don't truckle, and I hate being patronized as much as you do!\" returned Amy indignantly, for the two still jangled when such questions arose."
                            },
                            {
                                "example_id": "f1051e0f-628b-4001-abe3-a187cc4c00c2",
                                "sense_id": "c1af42a9-6403-32cc-8a64-9c917e5f2cab",
                                "text": "There is no doubt […] that truckling to popularity is the worst political vice."
                            },
                            {
                                "example_id": "eb5caa48-1e24-4802-8341-48f29f46d9c1",
                                "sense_id": "c1af42a9-6403-32cc-8a64-9c917e5f2cab",
                                "text": "Religion it self is forced to truckle to worldly policy."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b74a64f6-2324-4e96-a6eb-a569f8d56fa4",
                        "source_entry_id": "767c0698-4a01-3888-a962-1ec56688fac3",
                        "source_sense_id": "c1af42a9-6403-32cc-8a64-9c917e5f2cab",
                        "source_sense_description": "to act submissively",
                        "target_lang_word": "раболе́пствовать",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "раболе́пствовать",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "719da57f-000f-3fd3-ae6b-49f5ef4b9a4f",
                                        "entry_id": "bc1ed641-c17c-3e62-b37d-2fa17cb58671",
                                        "glosses": [
                                            "проявлять раболепие, вести себя раболепно; угодничать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "493b90d8-11b4-45e3-b37b-924c87b837c7",
                                                "sense_id": "719da57f-000f-3fd3-ae6b-49f5ef4b9a4f",
                                                "text": "Нет, вместо иконы для общего поклонения художник почтительнейше писал портреты со своих милостивцев, раболепствуя сам, приучая к лести и других…"
                                            },
                                            {
                                                "example_id": "7faef040-2cfa-48c7-ac0f-5f89424cd4d8",
                                                "sense_id": "719da57f-000f-3fd3-ae6b-49f5ef4b9a4f",
                                                "text": "Я ревновал, я сознавал своё ничтожество, я глупо дулся и глупо раболепствовал — и всё-таки непреодолимая сила влекла меня к ней, и я всякий раз с невольной дрожью счастья переступал порог её комнаты."
                                            },
                                            {
                                                "example_id": "b098c320-85c6-4717-b6d9-58cad4a9b7a9",
                                                "sense_id": "719da57f-000f-3fd3-ae6b-49f5ef4b9a4f",
                                                "text": "В гостиной он, заикаясь, раболепствовал перед матерью, исполнял все её желания, бранил людей, ежели они не делали того, что приказывала Анна Дмитриевна…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
