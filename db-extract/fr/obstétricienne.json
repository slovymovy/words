                        "entry_id": "4bc65428-f23c-3f7e-a254-8ea2688fd743",
                        "glosses": [
                            "Médecin femme pratiquant l’obstétrique, médecine relative aux accouchements."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "e980d8a2-e9c4-4971-81ca-1f23c35c4c1a",
                                "sense_id": "52102010-689a-348f-8ae1-e2b4b0f2e4e7",
                                "text": "La légende veut qu’Agnodice, obstétricienne grecque de l’Antiquité, se soit déguisée en homme pour pouvoir étudier et exercer la médecine."
                            },
                            {
                                "example_id": "fdd964fc-442f-424b-9f6d-b72c7ab640b9",
                                "sense_id": "52102010-689a-348f-8ae1-e2b4b0f2e4e7",
                                "text": "Malheureusement, votre souffrance n’est rien comparée au supplice que vous faites endurer à votre bébé, regretta l’obstétricienne."
                            }
                        ]
                    }
