                "senses": [
                    {
                        "sense_id": "f590e886-28ae-35fc-b62d-fe0505fac81a",
                        "entry_id": "9369b9e1-8588-3cb3-a739-8f2ce2a216a4",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d06e6580-45ee-45e7-9c0d-de75c87e8c53",
                                "sense_id": "f590e886-28ae-35fc-b62d-fe0505fac81a",
                                "text": "Frau Beese ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "df2b6075-ab0b-4446-af14-1514b75f0f02",
                                "sense_id": "f590e886-28ae-35fc-b62d-fe0505fac81a",
                                "text": "Herr Beese wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "fb7fc05e-85bb-4eb1-a454-b3abb72b6cad",
                                "sense_id": "f590e886-28ae-35fc-b62d-fe0505fac81a",
                                "text": "Die Beeses fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "1b839c35-aeb1-4e51-a62c-842bed243d47",
                                "sense_id": "f590e886-28ae-35fc-b62d-fe0505fac81a",
                                "text": "Der Beese trägt nie die Schals, die die Beese ihm strickt."
                            },
                            {
                                "example_id": "cd2629da-6663-4b61-b9f2-4a92296b73a6",
                                "sense_id": "f590e886-28ae-35fc-b62d-fe0505fac81a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Beese kommt, geht der Herr Beese.“"
                            },
                            {
                                "example_id": "a381338b-c009-488d-bfe3-d2f37a599849",
                                "sense_id": "f590e886-28ae-35fc-b62d-fe0505fac81a",
                                "text": "Beese kommt und geht."
                            },
                            {
                                "example_id": "cd54da09-475d-480a-b9c1-79d0baa53fce",
                                "sense_id": "f590e886-28ae-35fc-b62d-fe0505fac81a",
                                "text": "Beeses kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
