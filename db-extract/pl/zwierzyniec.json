                "translations": [
                    {
                        "translation_id": "153e91d0-0cc6-4649-936d-30eca5938615",
                        "source_entry_id": "f111edba-c3d2-3716-8f84-2c356ffa551c",
                        "source_sense_id": "08b2f821-334f-360d-aa01-14c85bed91ed",
                        "target_lang_word": "Tiergarten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tiergarten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66ee2e5b-622c-3052-9cf2-59c2ef8ddc33",
                                        "entry_id": "639f68f3-654d-3bbb-bbb1-cbe85633f5bc",
                                        "glosses": [
                                            "eine oftmals mit einer gärtnerischen ausgestaltete Anlage, die lebende Tiere verschiedener Arten für Publikum zur Schau stellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b067fd53-97a6-4fc4-bbc3-50616c01d678",
                                                "sense_id": "66ee2e5b-622c-3052-9cf2-59c2ef8ddc33",
                                                "text": "Die Großeltern machen heute mit ihren Enkeln einen Ausflug in den Tiergarten, um sich die Eisbären anzusehen."
                                            },
                                            {
                                                "example_id": "6a809f31-8bc6-4408-aebe-f00c2501838d",
                                                "sense_id": "66ee2e5b-622c-3052-9cf2-59c2ef8ddc33",
                                                "text": "Der Tiergarten befindet sich seit 1961 in den Spiegelsbergen und beherbergt mehr als 400 Tiere (90 verschiedene Arten)."
                                            },
                                            {
                                                "example_id": "8f53c369-454d-4f9b-b482-0d1996dd5a2b",
                                                "sense_id": "66ee2e5b-622c-3052-9cf2-59c2ef8ddc33",
                                                "text": "„Schon bald sah ich, was für ein großes Gebiet der Tiergarten eigentlich war.“"
                                            },
                                            {
                                                "example_id": "532fcb36-6b21-4f4c-958c-07a2c19685c1",
                                                "sense_id": "66ee2e5b-622c-3052-9cf2-59c2ef8ddc33",
                                                "text": "„Im Jardin du Luxembourg nimmt man den Tiergarten nicht ernst.“"
                                            },
                                            {
                                                "example_id": "0de8816c-64b0-4f98-bfa6-d53c8d7c897b",
                                                "sense_id": "66ee2e5b-622c-3052-9cf2-59c2ef8ddc33",
                                                "text": "„Im Oktober 1999 wurde im Nürnberger Tiergarten ein Panzernashorn geboren und auf den Namen Albrecht getauft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c04f6268-20d3-378e-9e01-d073ec44d0ef",
                                        "entry_id": "639f68f3-654d-3bbb-bbb1-cbe85633f5bc",
                                        "glosses": [
                                            "einen Park oder Teil der Landschaft, in dem zur Zeit frühen Neuzeit und während der Renaissance Jagdwild durch den Adel gehalten worden ist"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Tiergarten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1bd4aa55-eb91-37b3-a526-4c72c0851163",
                                        "entry_id": "c0f03802-f691-32b0-aecf-ab7a31e2fab8",
                                        "glosses": [
                                            "Großer Tiergarten, ein Park in Berlin (Mitte)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73524739-3144-4d6b-b85d-f34f902366ff",
                                                "sense_id": "1bd4aa55-eb91-37b3-a526-4c72c0851163",
                                                "text": "Der Große Berliner Tiergarten diente den brandenburgischen Kurfürsten einstmals als Jagdrevier und Barockpark."
                                            },
                                            {
                                                "example_id": "4c0883c4-0849-4836-9e97-9890c3cea968",
                                                "sense_id": "1bd4aa55-eb91-37b3-a526-4c72c0851163",
                                                "text": "„Unter solchem Selbstgespräche war er bis an die Bülowstraße gekommen und wollte sich eben unter Benutzung derselben in weitem Bogen wieder zurück nach dem Tiergarten schlängeln, als er in einiger Entfernung eines Begräbniszuges gewahr wurde, der nach dem Matthäikirchhofe hinaus wollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
