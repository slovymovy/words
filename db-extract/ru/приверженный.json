                                        "sense_id": "583f48f0-00c4-3dd7-a6d8-46b52712f576",
                                        "entry_id": "124cb5dd-38f8-3a50-95d5-181bdc0a03cf",
                                        "glosses": [
                                            "Être attaché à qqch. Aimer beaucoup qqch/qqn qui est important pour soi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62d50116-9d9c-4d26-9271-ab2436197e67",
                                                "sense_id": "583f48f0-00c4-3dd7-a6d8-46b52712f576",
                                                "text": "J'aime beaucoup la région dans laquelle je suis née, j'y suis très attaché."
                                            },
                                            {
                                                "example_id": "520fb0f3-bd32-4da8-bd0f-e63afbf596b3",
                                                "sense_id": "583f48f0-00c4-3dd7-a6d8-46b52712f576",
                                                "text": "C'est la maison de mon enfance, j'y suis très attaché."
                                            },
                                            {
                                                "example_id": "52bff6a6-0af1-4e3f-8fa3-f99395e9f8c9",
                                                "sense_id": "583f48f0-00c4-3dd7-a6d8-46b52712f576",
                                                "text": "J'habite très près de chez mes parents, je suis très attaché à eux."
                                            }
                                        ]
                                    }
                                ]
                            },
