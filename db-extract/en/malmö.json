                        "entry_id": "0879a9ad-35e5-39f7-9661-8435975f9269",
                        "glosses": [
                            "A city in Scania, Sweden; the third-largest city in the country, located on the south-west coast."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c03bb872-3ece-4269-a1a2-c539693b05e6",
                                "sense_id": "669c5560-6313-36ce-8682-22eb732945e5",
                                "text": "Perched almost on the southern tip of the Swedish peninsula, Malmö is a bland, gray-blue industrial town set amid a featureless, gray-blue landscape."
                            }
                        ]
                    }
                ],
                "translations": [
