                    {
                        "translation_id": "5c297131-7f49-4a17-8d9e-2655dd6b208d",
                        "source_entry_id": "cbf95e47-005b-33d7-85ab-30a82c1c4228",
                        "source_sense_description": "A penis",
                        "target_lang_word": "Penis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
