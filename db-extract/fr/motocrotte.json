                "senses": [
                    {
                        "sense_id": "27018467-edcf-3225-9c09-28b54a0451ab",
                        "entry_id": "801c615d-a84e-3f53-98c0-a474c6a68682",
                        "glosses": [
                            "Sorte d’engin motorisé à deux roues qui servait à ramasser les crottes de chiens sur les trottoirs de Paris."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "b214662f-c08e-404b-bc52-a91705f9206b",
                                "sense_id": "27018467-edcf-3225-9c09-28b54a0451ab",
                                "text": "Le fait qu’une merde de chien, dit-il, soit ramassée par une motocrotte légitime à leurs yeux le préjudice."
                            },
                            {
                                "example_id": "2a76704f-1ae3-4fdf-b139-7f0790d5b883",
                                "sense_id": "27018467-edcf-3225-9c09-28b54a0451ab",
                                "text": "AU PLACARD, les « chiraclettes » ! Mises en service par le président Jacques Chirac au début des années 1980 lorsqu’il était maire de la capitale, les fameuses motocrottes coûtent trop cher à la municipalité et ne sont pas assez efficaces : […]."
                            },
                            {
                                "example_id": "8cebe784-8d22-4166-95bc-2c10a9aab92b",
                                "sense_id": "27018467-edcf-3225-9c09-28b54a0451ab",
                                "text": "Un chien parisien coûte 75 € par an en motocrottes à la mairie de Paris. Ce montant correspond environ au prix de l’amende (sous forme d’écotaxe) pour une crotte de chien à New York."
                            }
                        ]
                    }
