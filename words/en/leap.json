{
    "word_family": [
        "leaper",
        "overleap",
        "outleap"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ae9ebc54-d9d9-3322-93ee-7707eeaf961e",
                    "sense_definition": "To jump high or a long way, often suddenly or with great force.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "movement_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat <w>leapt</w> from the tree onto the roof.",
                            "target_lang_translations": {
                                "ru": "Кот <w>прыгнул</w> с дерева на крышу.",
                                "zh": "猫从树上<w>跳</w>到了屋顶上。",
                                "it": "Il gatto <w>saltò</w> dall'albero sul tetto."
                            }
                        },
                        {
                            "text": "My heart <w>leapt</w> with joy when I heard the good news.",
                            "target_lang_translations": {
                                "ru": "Мое сердце <w>подпрыгнуло</w> от радости, когда я услышал хорошие новости.",
                                "zh": "听到这个好消息时，我高兴得心都<w>跳</w>起来了。",
                                "it": "Il mio cuore <w>balzò</w> di gioia quando sentii la buona notizia."
                            }
                        },
                        {
                            "text": "You should always look before you <w>leap</w>.",
                            "target_lang_translations": {
                                "ru": "Нужно всегда смотреть, куда <w>прыгаешь</w>.",
                                "zh": "你在<w>跳</w>之前一定要先看清楚。",
                                "it": "Dovresti sempre guardare prima di <w>saltare</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "jump",
                        "spring",
                        "bound",
                        "vault",
                        "hop"
                    ],
                    "common_phrases": [
                        "look before you leap",
                        "leap at the chance",
                        "leap for joy",
                        "leap to conclusions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прыгать высоко или на большое расстояние, часто внезапно или с большой силой.",
                        "zh": "高高地或远远地跳，常指突然地或很有力地跳。",
                        "it": "Saltare in alto o a una certa distanza, spesso all'improvviso o con grande forza."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прыгать",
                                "target_lang_sense_clarification": "совершать прыжки, отрываясь от земли"
                            },
                            {
                                "target_lang_word": "скакать",
                                "target_lang_sense_clarification": "передвигаться прыжками, подпрыгивать"
                            },
                            {
                                "target_lang_word": "прыгнуть",
                                "target_lang_sense_clarification": "совершить прыжок (однократное действие)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "跳",
                                "target_lang_sense_clarification": "突然或有力地跳起、跳开"
                            },
                            {
                                "target_lang_word": "跳跃",
                                "target_lang_sense_clarification": "较正式，指高高地或远远地跳"
                            },
                            {
                                "target_lang_word": "跃起",
                                "target_lang_sense_clarification": "强调突然向上跳起"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "saltare",
                                "target_lang_sense_clarification": "saltare in alto o in avanti con slancio; termine più comune e generale"
                            },
                            {
                                "target_lang_word": "balzare",
                                "target_lang_sense_clarification": "saltare improvvisamente o con energia; spesso più espressivo"
                            },
                            {
                                "target_lang_word": "spiccare un salto",
                                "target_lang_sense_clarification": "saltare con impeto o agilità; un po' più letterario"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f5b73783-22a2-36bd-9a0f-1c1375a9902e",
                    "sense_definition": "To jump over an obstacle or across a distance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The horse easily <w>leapt</w> the fence during the competition.",
                            "target_lang_translations": {
                                "ru": "Лошадь легко <w>перепрыгнула</w> через забор во время соревнований.",
                                "zh": "那匹马在比赛中轻松<w>跳过</w>了栅栏。",
                                "it": "Il cavallo <w>saltò</w> facilmente la recinzione durante la gara."
                            }
                        },
                        {
                            "text": "He tried to <w>leap</w> the puddle but landed in the water.",
                            "target_lang_translations": {
                                "ru": "Он попытался <w>перепрыгнуть</w> лужу, но приземлился в воду.",
                                "zh": "他试着<w>跳过</w>水坑，却落进了水里。",
                                "it": "Provò a <w>saltare</w> la pozzanghera, ma finì nell'acqua."
                            }
                        }
                    ],
                    "synonyms": [
                        "jump"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перепрыгивать через препятствие или преодолевать расстояние прыжком.",
                        "zh": "跳过障碍物，或通过跳跃越过一段距离。",
                        "it": "Saltare oltre un ostacolo o attraversare una distanza con un balzo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перепрыгивать",
                                "target_lang_sense_clarification": "преодолевать препятствие прыжком"
                            },
                            {
                                "target_lang_word": "прыгать",
                                "target_lang_sense_clarification": "совершать прыжок через что-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "跳过",
                                "target_lang_sense_clarification": "跳越障碍物或某段距离"
                            },
                            {
                                "target_lang_word": "越过",
                                "target_lang_sense_clarification": "强调越过某物"
                            },
                            {
                                "target_lang_word": "跨过",
                                "target_lang_sense_clarification": "强调跨越过去"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "saltare",
                                "target_lang_sense_clarification": "superare un ostacolo con un salto; il più naturale in italiano"
                            },
                            {
                                "target_lang_word": "scavalcare con un salto",
                                "target_lang_sense_clarification": "passare oltre con un balzo, con enfasi sullo slancio"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ec7845e0-5ccc-34a9-8877-1ee14c246dc0",
                    "sense_definition": "The act of jumping high or a long way.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "movement_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With a single <w>leap</w>, the athlete cleared the bar.",
                            "target_lang_translations": {
                                "ru": "Одним <w>прыжком</w> атлет преодолел планку.",
                                "zh": "运动员只用一次<w>跳跃</w>就越过了横杆。",
                                "it": "Con un solo <w>salto</w>, l'atleta superò l'asticella."
                            }
                        },
                        {
                            "text": "The dancer performed a graceful <w>leap</w> across the stage.",
                            "target_lang_translations": {
                                "ru": "Танцор совершил грациозный <w>прыжок</w> через сцену.",
                                "zh": "舞者在舞台上做了一个优美的<w>跳跃</w>。",
                                "it": "La ballerina fece un elegante <w>salto</w> sul palco."
                            }
                        }
                    ],
                    "synonyms": [
                        "jump",
                        "spring",
                        "bound",
                        "vault",
                        "hop"
                    ],
                    "common_phrases": [
                        "take a leap",
                        "in a single leap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт прыжка в высоту или длину.",
                        "zh": "高跳或远跳这一动作。",
                        "it": "L'atto di saltare in alto o lontano."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прыжок",
                                "target_lang_sense_clarification": "действие по глаголу прыгать"
                            },
                            {
                                "target_lang_word": "скачок",
                                "target_lang_sense_clarification": "резкое движение, прыжок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "跳跃",
                                "target_lang_sense_clarification": "跳这一动作本身"
                            },
                            {
                                "target_lang_word": "一跃",
                                "target_lang_sense_clarification": "一次跳的动作，常用于“一跃”这类表达"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "salto",
                                "target_lang_sense_clarification": "atto del saltare; traduzione più comune"
                            },
                            {
                                "target_lang_word": "balzo",
                                "target_lang_sense_clarification": "salto energico o improvviso; più espressivo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "775d1fb2-c941-3227-b729-6cfb9ae3378c",
                    "sense_definition": "A significant and sudden move forward, improvement, or advance.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "metaphorical_progress",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The invention of the internet was a giant <w>leap</w> for communication.",
                            "target_lang_translations": {
                                "ru": "Изобретение интернета стало гигантским <w>скачком</w> в развитии коммуникаций.",
                                "zh": "互联网的发明是通信领域的一次巨大<w>飞跃</w>。",
                                "it": "L'invenzione di Internet fu un enorme <w>balzo</w> per la comunicazione."
                            }
                        },
                        {
                            "text": "Her understanding of the subject has grown by <w>leaps</w> and bounds.",
                            "target_lang_translations": {
                                "ru": "Ее понимание предмета росло гигантскими <w>скачками</w>.",
                                "zh": "她对这门学科的理解有了很大的<w>飞跃</w>。",
                                "it": "La sua comprensione dell'argomento è cresciuta a <w>balzi</w> enormi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "giant leap",
                        "quantum leap",
                        "by leaps and bounds"
                    ],
                    "target_lang_definitions": {
                        "ru": "Значительное и внезапное продвижение вперед, улучшение или прогресс.",
                        "zh": "重大的、突然的前进、改进或进步。",
                        "it": "Un progresso, miglioramento o avanzamento notevole e improvviso."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скачок",
                                "target_lang_sense_clarification": "резкое изменение, быстрый прогресс"
                            },
                            {
                                "target_lang_word": "прорыв",
                                "target_lang_sense_clarification": "значительное достижение, успех"
                            },
                            {
                                "target_lang_word": "рывок",
                                "target_lang_sense_clarification": "резкое усилие, стремительное продвижение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "飞跃",
                                "target_lang_sense_clarification": "重大发展或明显进步"
                            },
                            {
                                "target_lang_word": "跃进",
                                "target_lang_sense_clarification": "突然的大幅前进或提升"
                            },
                            {
                                "target_lang_word": "突破",
                                "target_lang_sense_clarification": "重大进展，常指技术或成果方面"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "balzo",
                                "target_lang_sense_clarification": "grande avanzamento o miglioramento improvviso"
                            },
                            {
                                "target_lang_word": "salto",
                                "target_lang_sense_clarification": "forte progresso o avanzamento, spesso tecnico o figurato"
                            },
                            {
                                "target_lang_word": "progresso",
                                "target_lang_sense_clarification": "sviluppo molto rapido e importante"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32f793d7-0ae2-3db2-8175-3e77209d31aa",
                    "sense_definition": "A large step in reasoning or thinking, often made without sufficient evidence.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical_reasoning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Starting a business in a new country is often a <w>leap</w> of faith.",
                            "target_lang_translations": {
                                "ru": "Открытие бизнеса в новой стране — это часто <w>прыжок</w> в неизвестность.",
                                "zh": "在一个新国家创业往往需要一次<w>信念之跃</w>。",
                                "it": "Avviare un'attività in un nuovo paese è spesso un <w>atto</w> di fede."
                            }
                        },
                        {
                            "text": "It is quite a <w>leap</w> to assume he is guilty based on that one clue.",
                            "target_lang_translations": {
                                "ru": "Это слишком большой логический <w>скачок</w> — считать его виновным на основании одной лишь улики.",
                                "zh": "仅凭那一条线索就认定他有罪，这是很大的<w>逻辑跳跃</w>。",
                                "it": "È un notevole <w>salto</w> logico supporre che sia colpevole basandosi su quel solo indizio."
                            }
                        }
                    ],
                    "common_phrases": [
                        "leap of faith",
                        "leap of imagination",
                        "leap of logic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Резкий переход в рассуждениях или мышлении, часто без достаточных доказательств.",
                        "zh": "思考或推理中的大跨度转变，常常是在证据不足的情况下作出的。",
                        "it": "Un grande passaggio nel ragionamento o nel pensiero, spesso fatto senza prove sufficienti."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скачок",
                                "target_lang_sense_clarification": "резкий, нелогичный переход в мыслях"
                            },
                            {
                                "target_lang_word": "прыжок",
                                "target_lang_sense_clarification": "рискованный шаг (как в 'прыжок веры')"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "逻辑跳跃",
                                "target_lang_sense_clarification": "指推理中过大的跨越，证据不足"
                            },
                            {
                                "target_lang_word": "信念之跃",
                                "target_lang_sense_clarification": "指在缺乏把握时凭信念迈出的一步"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "salto logico",
                                "target_lang_sense_clarification": "passaggio troppo rapido nel ragionamento, senza prove sufficienti"
                            },
                            {
                                "target_lang_word": "atto di fede",
                                "target_lang_sense_clarification": "nel senso di 'leap of faith', decisione presa senza certezze"
                            },
                            {
                                "target_lang_word": "salto nel buio",
                                "target_lang_sense_clarification": "scelta rischiosa fatta fidandosi più dell'intuizione che delle prove"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff3ae8c0-a5cb-3173-b607-c6e4bcdfb544",
                    "sense_definition": "A group of leopards.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "collective_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We were lucky enough to see a <w>leap</w> of leopards on our safari.",
                            "target_lang_translations": {
                                "ru": "Нам посчастливилось увидеть <w>стаю</w> леопардов на сафари.",
                                "zh": "我们很幸运，在游猎时看到了一<w>群</w>花豹。",
                                "it": "Siamo stati abbastanza fortunati da vedere un <w>branco</w> di leopardi durante il safari."
                            }
                        },
                        {
                            "text": "A <w>leap</w> of leopards rested in the shade of the trees.",
                            "target_lang_translations": {
                                "ru": "<w>Стая</w> леопардов отдыхала в тени деревьев.",
                                "zh": "一<w>群</w>花豹在树荫下休息。",
                                "it": "Un <w>branco</w> di leopardi riposava all'ombra degli alberi."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "collective noun"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа леопардов.",
                        "zh": "一群花豹。",
                        "it": "Un gruppo di leopardi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стая",
                                "target_lang_sense_clarification": "группа животных"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "群",
                                "target_lang_sense_clarification": "用于花豹群体的集合说法"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "branco",
                                "target_lang_sense_clarification": "termine collettivo per un gruppo di leopardi; reso con un nome collettivo naturale in italiano"
                            },
                            {
                                "target_lang_word": "gruppo",
                                "target_lang_sense_clarification": "traduzione più generica quando non si usa un collettivo specifico"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "95053343-8b10-3c28-8355-5d8145f4adf0",
                    "sense_definition": "Relating to a year that has 366 days instead of 365, occurring every four years.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "February has twenty-nine days in a <w>leap</w> year.",
                            "target_lang_translations": {
                                "ru": "В <w>високосном</w> году в феврале двадцать девять дней.",
                                "zh": "二月在<w>闰</w>年有二十九天。",
                                "it": "Febbraio ha ventinove giorni in un anno <w>bisestile</w>."
                            }
                        },
                        {
                            "text": "People born on <w>leap</w> day only celebrate their actual birthday every four years.",
                            "target_lang_translations": {
                                "ru": "Люди, родившиеся в <w>високосный</w> день, отмечают свой настоящий день рождения только раз в четыре года.",
                                "zh": "在<w>闰</w>日出生的人每四年才过一次真正的生日。",
                                "it": "Le persone nate nel giorno <w>bisestile</w> festeggiano il loro vero compleanno solo ogni quattro anni."
                            }
                        }
                    ],
                    "common_phrases": [
                        "leap year",
                        "leap day",
                        "leap second"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к году, в котором 366 дней вместо 365.",
                        "zh": "与一年有366天而不是365天有关的；这种年份每四年出现一次。",
                        "it": "Relativo a un anno di 366 giorni invece di 365, che ricorre ogni quattro anni."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "високосный",
                                "target_lang_sense_clarification": "о годе, имеющем 366 дней"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闰",
                                "target_lang_sense_clarification": "用于合成词，如闰年、闰日、闰秒"
                            },
                            {
                                "target_lang_word": "闰年的",
                                "target_lang_sense_clarification": "作定语时表示与闰年有关"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "bisestile",
                                "target_lang_sense_clarification": "detto di un anno con 366 giorni"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b60076dc-1f5f-3f4d-99c8-cc249fca09c3",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Leaps</w> was known for his contributions to the local library.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Липс</w> был известен своим вкладом в местную библиотеку.",
                                "zh": "<w>利普斯</w>先生因对当地图书馆的贡献而闻名。",
                                "it": "Il signor <w>Leaps</w> era noto per il suo contributo alla biblioteca locale."
                            }
                        },
                        {
                            "text": "I met a woman named Sarah <w>Leaps</w> at the conference.",
                            "target_lang_translations": {
