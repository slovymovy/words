                                        "glosses": [
                                            "The state or quality of being strange, odd or weird."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3af42a08-5206-3137-99b6-c8317e8d5b11",
                                        "entry_id": "fb87242c-c3b1-30d6-bd56-e9b552a49af1",
                                        "glosses": [
                                            "The product or result of being strange."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "085a91b4-90cc-328f-809f-3457b53e784d",
                                        "entry_id": "fb87242c-c3b1-30d6-bd56-e9b552a49af1",
                                        "glosses": [
                                            "One of the quantum numbers of subatomic particles, depending upon the relative number of strange quarks and anti-strange quarks."
                                        ],
                                        "tags": [
                                            "particle",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6e8ce83-3d21-40a7-8fa2-8bf99264ee71",
                                                "sense_id": "085a91b4-90cc-328f-809f-3457b53e784d",
                                                "text": "Mesons which combine the charmed quark with the up or down antiquarks are denoted the D mesons. These mesons carry explicit charm (i.e. have a non-zero charm quantum number), just as the K mesons carry strangeness."
                                            }
                                        ]
                                    }
                                ]
