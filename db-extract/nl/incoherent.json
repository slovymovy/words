                                            {
                                                "example_id": "4c6ebb88-b7b9-4875-b6ce-57d392f4f499",
                                                "sense_id": "9cfa08a8-0a65-37b1-b0d0-9030c7346e01",
                                                "text": "Die Ausarbeitung ist ziemlich inkohärent."
                                            }
