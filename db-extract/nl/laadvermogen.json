                    {
                        "sense_id": "dff553b1-65fc-3b88-842f-de2ede0ae090",
                        "entry_id": "b3bab6a3-39b0-3c9e-aa31-102522867fe2",
                        "glosses": [
                            "de maximale hoeveelheid lading die een vervoermiddel kan of mag dragen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1f0c6a6-189d-43e3-9586-9e2bbd5c16c8",
                                "sense_id": "dff553b1-65fc-3b88-842f-de2ede0ae090",
                                "text": "De 119 meter lange Airlander 50 heeft een maximaal laadvermogen van 60.000 kilo. Het bedrijf hoopt in 2020 de eerste zeppelins te leveren voor de passagiers- en mogelijk ook vrachtluchtvaart. Onduidelijk is nog waar ze eventueel gaan vliegen."
                            },
                            {
                                "example_id": "d75b7c4a-55fa-401f-aaa1-9ce31d0d7dd9",
                                "sense_id": "dff553b1-65fc-3b88-842f-de2ede0ae090",
                                "text": "De wagon dateert waarschijnlijk uit 1871 of 1872. Dat is te zien aan het type. Het typenummer van het treinstel is SS CHA. SS staat voor Staatsspoorwegen, het spoorbedrijf dat in 1863 werd opgericht en in de beginjaren tientallen wagons liet bouwen. De letters CH zeggen dat het gaat om een gesloten goederenwagon, die de lading beschermt tegen regen en storm. De A geeft het laadvermogen aan."
                            }
                        ]
                    }
