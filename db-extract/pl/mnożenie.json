                                    {
                                        "sense_id": "7d3aa460-d3b3-3ee0-8d2c-fb703eee86a3",
                                        "entry_id": "d8daea50-9927-37c2-aae7-f316fed91e20",
                                        "glosses": [
                                            "jeden ze základních početních úkonů; opakované sčítání (v oboru přirozených čísel)"
                                        ],
