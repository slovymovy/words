                "translations": [
                    {
                        "translation_id": "ac328179-ec53-46de-955f-49017c035f4e",
                        "source_entry_id": "c61f09cf-9076-3140-882e-aa909a2451c4",
                        "source_sense_id": "a42bc78c-727a-3440-89cd-c8481e94bc12",
                        "source_sense_description": "zonder verzet ongemak verdragend",
                        "target_lang_word": "passiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "passiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1b02b0b5-4e20-3d26-b417-94a005da44e5",
                                        "entry_id": "b65145ef-1c0b-3d95-be87-8352da4b8071",
                                        "glosses": [
                                            "im Zustand, nichts zu tun"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fc265e3-7452-4893-af47-32b6e1b6ce26",
                                                "sense_id": "1b02b0b5-4e20-3d26-b417-94a005da44e5",
                                                "text": "Nach einem Verkehrsunfall ist es gut, nicht passiv auf dem Beifahrersitz zu verharren, sondern sich bald wieder selber ans Steuer zu setzen, damit erst gar keine Angst vor dem Fahren aufkommt."
                                            },
                                            {
                                                "example_id": "e2f68540-d2cf-4c90-9985-04ff76e3489b",
                                                "sense_id": "1b02b0b5-4e20-3d26-b417-94a005da44e5",
                                                "text": "Vor allem über soziale Netzwerke wie Facebook & Co. konsumieren die User nicht mehr nur passiv Informationen, sondern generieren aktiv Inhalte."
                                            },
                                            {
                                                "example_id": "c4c477f5-1e41-4882-985d-ad6b31a3443f",
                                                "sense_id": "1b02b0b5-4e20-3d26-b417-94a005da44e5",
                                                "text": "Der unorthodox boxende Fury ließ sich den Stil seines Gegners nicht aufzwingen und punktete dank seiner Aktivität auf den Punktzetteln der Wertungsrichter. Klitschko blieb zu passiv. Erst in der Schlussrunde landete er einige klare Treffer, mit denen er Fury einigermaßen beeindrucken konnte. Die aber kamen zu spät."
                                            },
                                            {
                                                "example_id": "14d86d37-ab59-4005-9a93-0fb26c1f80a5",
                                                "sense_id": "1b02b0b5-4e20-3d26-b417-94a005da44e5",
                                                "text": "„Denn der bleibt weitgehend passiv und überlässt Vor-, Zu- und Nachbereitung denen, die es wirklich können.“"
                                            },
                                            {
                                                "example_id": "c834502d-c8ee-4a45-8513-67af664db011",
                                                "sense_id": "1b02b0b5-4e20-3d26-b417-94a005da44e5",
                                                "text": "„Diese große Anfangsgeschwindigkeit ermöglicht dem Flugfisch ein Gleiten mit den großen Tragflächen der gespreizten Seitenflossen in Form eines passiven Drachenfluges.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "349780ac-64d7-3d8e-9791-3ca43ce9bcb8",
                                        "entry_id": "b65145ef-1c0b-3d95-be87-8352da4b8071",
                                        "glosses": [
                                            "erduldend, was einem passiert, ohne etwas dagegen zu tun"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3d6a6e2-a644-4389-b89d-f554366a0bce",
                                                "sense_id": "349780ac-64d7-3d8e-9791-3ca43ce9bcb8",
                                                "text": "„Zumindest passiv rauchende Kinder bekommen jedoch generell häufiger schwere Infektionen, die im Krankenhaus behandelt werden müssen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "19620553-bab2-3471-a635-e50811832c7b",
                                        "entry_id": "b65145ef-1c0b-3d95-be87-8352da4b8071",
                                        "glosses": [
                                            "im Passiv befindlich (= Konjugationsformen des Verbs)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a22b1e8-c426-4e92-a359-921e16c53509",
                                                "sense_id": "19620553-bab2-3471-a635-e50811832c7b",
                                                "text": "„Ein Deponens ist ein Verb mit passiven Formen aber aktiver oder reflexiver Bedeutung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "98176db3-7855-35ee-b432-ff554022949e",
                                        "entry_id": "b65145ef-1c0b-3d95-be87-8352da4b8071",
                                        "glosses": [
                                            "(auf der passiven Seite der Bestandskonten) ruhend, nicht aktiv (zum Beispiel Darlehen oder Eigenkapital)"
                                        ],
                                        "tags": [
                                            "Buchhaltung"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
