                        "examples": [
                            {
                                "example_id": "04661741-45d6-4615-8a5c-c4e723dc1012",
                                "sense_id": "b52c769e-71f4-3d6c-b588-b15bb2d369cc",
                                "text": "Dans ce concert de muets, la conclusion pagnolesque revient à l’ex-secrétaire général du CE, Georges Albano, récemment parti à la retraite."
                            },
                            {
                                "example_id": "9d144581-c356-43df-b0a0-83eb7d864037",
                                "sense_id": "b52c769e-71f4-3d6c-b588-b15bb2d369cc",
                                "text": "Sauf que cette fois, les numéros pagnolesques devant les caméras ne suffisent plus à conjurer la crise. Gaudin a choqué la population en s'enfermant d'abord dans le déni, allant jusqu'à accuser la pluie."
                            }
                        ]
                    }
