                "senses": [
                    {
                        "sense_id": "d5e3a9ca-9f4b-324f-afca-4ad36835bac8",
                        "entry_id": "c7443c70-29f2-3ccb-b3db-ab2ead698783",
                        "glosses": [
                            "лингв. образующийся при полном или неполном смыкании губ"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d7e5aac7-6625-3cda-b593-e626b22520fb",
                        "entry_id": "c7443c70-29f2-3ccb-b3db-ab2ead698783",
                        "glosses": [
                            "губной"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f348e6d8-38f5-4afb-9fea-d911e30c504d",
                                "sense_id": "d7e5aac7-6625-3cda-b593-e626b22520fb",
                                "text": "С лабиальной стороны от антерокона отходит назад гребень, который может соединяться с антеролофом и отшнуровывать небольшую эмалевую лунку."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58178d51-3826-44b0-ae5c-5e5ce4546e38",
                        "source_entry_id": "c7443c70-29f2-3ccb-b3db-ab2ead698783",
                        "target_lang_word": "labial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "labial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e96a9f05-f984-3f08-aff5-e6f66d6be9aa",
                                        "entry_id": "f12f306d-0870-317e-872b-24f28500b8cc",
                                        "glosses": [
                                            "Of or pertaining to the lips or labia."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f8d7179-5949-415e-95c3-5ca28c956a4f",
                                                "sense_id": "e96a9f05-f984-3f08-aff5-e6f66d6be9aa",
                                                "text": "The wound that does not kill Christ is the magical labial wound; it is the seal of the resurrection and an expression of the myth of eternal recurrence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ec07905-7ae3-3131-bde3-3a1c5651cb0a",
                                        "entry_id": "f12f306d-0870-317e-872b-24f28500b8cc",
                                        "glosses": [
                                            "Articulated by the lips, as the consonants b, m and w."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "942e90f6-f1b1-3172-bc2b-0435617e806b",
                                        "entry_id": "f12f306d-0870-317e-872b-24f28500b8cc",
                                        "glosses": [
                                            "On the side facing the lips. See mesial."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fe4a93d9-7c0b-37cb-b183-c386c424b3c4",
                                        "entry_id": "f12f306d-0870-317e-872b-24f28500b8cc",
                                        "glosses": [
                                            "Furnished with lips."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7383ccba-3964-4f03-b003-f437b109473d",
                                                "sense_id": "fe4a93d9-7c0b-37cb-b183-c386c424b3c4",
                                                "text": "a labial organ pipe"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "labial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "011f85da-da76-3219-b3c1-55e63ae19c88",
                                        "entry_id": "d9ff2e54-b675-3156-bc05-faf8639daeaf",
                                        "glosses": [
                                            "A consonant articulated by the lips."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8414ecf-43ff-44aa-a1af-86e4628a2f2b",
                                                "sense_id": "011f85da-da76-3219-b3c1-55e63ae19c88",
                                                "text": "The motions of the Tongue, Lips, Throat, Palate, & c. which go to the making of the ſeveral Alphabetical Letters are worthy inquiry, and pertinent to the preſent Inquiſition of Sounds: But becauſe they are ſubtil and long to deſcribe, we will refer them over, and place them amongſt the Experiments of Speech. The Hebrews have been diligent in it, and have aſſigned which Letters are Labial, which Dental, which Guttural, & c"
                                            },
                                            {
                                                "example_id": "9f1f95db-848e-4194-8e5b-a7f0c0b3df88",
                                                "sense_id": "011f85da-da76-3219-b3c1-55e63ae19c88",
                                                "text": "You have but the same four letters to describe the salute which you perform on your grandmother’s forehead, and that which you bestow on the sacred cheek of your mistress; but the same four letters, and not one of them a labial."
                                            },
                                            {
                                                "example_id": "6ec409e2-dd1a-4a42-9600-e8e90e9a0468",
                                                "sense_id": "011f85da-da76-3219-b3c1-55e63ae19c88",
                                                "text": "Those were his first words of the voyage, and they were spoken with unstuttered labials."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be833f97-ef6f-3add-b89c-2eabe9b3a9b5",
                                        "entry_id": "d9ff2e54-b675-3156-bc05-faf8639daeaf",
                                        "glosses": [
                                            "An organ pipe having a lip that influences its sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fa34610-6cd7-4c1d-867f-145d374a5ddb",
                                                "sense_id": "be833f97-ef6f-3add-b89c-2eabe9b3a9b5",
                                                "text": "All organ pipes are divided into two general classes, labial and lingual pipes. The main difference between the two classes is the manner by which the vibrations producing the sound are caused. In labial pipes the column of air entering the pipe under pressure is set in vibration by a fixed obstruction at the mount of the pipe. […] [T]he obstruction at the mouth […] causes the column of air to vibrate. In the lingual or reed pipe, the vibrations are caused by the air passing through a metal reed, which causes the tongue of the reed to vibrate, thereby setting up sympathetic vibrations in the column of air in the pipe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f0855dd-b4af-3ebc-a4fb-f44e595065e2",
                                        "entry_id": "d9ff2e54-b675-3156-bc05-faf8639daeaf",
                                        "glosses": [
                                            "Any of the scales bordering the mouth opening of a reptile."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b37fb5e-bf25-493d-a130-5f79df25ade5",
                        "source_entry_id": "c7443c70-29f2-3ccb-b3db-ab2ead698783",
                        "target_lang_word": "labial",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "labial",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "8d039eea-427a-3f2c-b998-fe55bfb4cfb5",
                                        "entry_id": "2a45cc22-bd97-3442-8f7c-411f31294d10",
                                        "glosses": [
                                            "Propio de o relativo a los labios."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74473201-db41-46c2-8a9d-1e05ad0cb987",
                                                "sense_id": "8d039eea-427a-3f2c-b998-fe55bfb4cfb5",
                                                "text": "A cada movimiento respiratorio se removían y resquebrajaban, cual terreno estremecido por terremoto, los pliegues labiales, las ventanas de la nariz y las imponentes garras del monstruo humano, esparciéndose en la atmósfera un vaho turbio, donde centelleaban al sol hilos gelatiniformes de mucina, leucocitos coarrugados, láminas epidérmicas e infinidad de bacterias."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a4f61eef-e32b-3a9d-9127-182ebf625f7e",
                                        "entry_id": "2a45cc22-bd97-3442-8f7c-411f31294d10",
                                        "glosses": [
                                            "Dicho de un sonido, que se articula usando los labios."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90183eec-21cc-4d8b-a8ce-1278ca85257a",
                                                "sense_id": "a4f61eef-e32b-3a9d-9127-182ebf625f7e",
                                                "text": "Cada consonante ó aspiración depende de una ó muchos órganos, de donde resulta que hay consonantes labiales ó de los labios como, b, p, m, f, &c.; dentales ó de los dientes, como ch, h, z, s; linguales ó de la lengua, como d, l, r, t; paladiales ó del paladar, como g, y, las c, g, unidas á las a, o, u; guturales g, (con la e, i,) j , x ; nasal, la ñ."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0a47c62f-d2a8-3cc2-9f4e-8b7f4ef15b46",
                                        "entry_id": "2a45cc22-bd97-3442-8f7c-411f31294d10",
                                        "glosses": [
                                            "Dicho de lo que está del lado de los labios y contrario a la lengua."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
