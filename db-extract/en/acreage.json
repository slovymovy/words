                "translations": [
                    {
                        "translation_id": "619b49ab-2b71-45b3-b4db-23b2d1f2c18a",
                        "source_entry_id": "3c7699cd-28e6-3030-8eda-c0429730816c",
                        "source_sense_description": "land measured in acres",
                        "target_lang_word": "acréage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acréage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e1311937-68ff-3bf9-80ad-af1c1b3c95e6",
                                        "entry_id": "e2e7f463-01af-3061-922b-e78f9ebbed57",
                                        "glosses": [
                                            "Aréage, aire d'un champ dans un contexte où la surface cultivée se compte en acres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88e9c316-9cfc-452c-9ea9-7568e6381d38",
                                                "sense_id": "e1311937-68ff-3bf9-80ad-af1c1b3c95e6",
                                                "text": "Les estimations du cours du blé à Chicago étaient basées sur l’acréage de grain à être récolté prévu, en fonction des intentions de semis antérieurement publiés."
                                            },
                                            {
                                                "example_id": "52a815fd-138b-407e-9ba8-a620bf015d15",
                                                "sense_id": "e1311937-68ff-3bf9-80ad-af1c1b3c95e6",
                                                "text": "Les hausses de prix de la nourriture, cependant, sont largement causés par l’offre ; il y a une réduction de l’offre due au changement d’acréage de récoltes de maïs pour les biocarburants. Cela signifie que davantage de maïs est cultivé, et moins de soja. Tandis que les prix du maïs et du soja augmentent, le consommateur passe au riz, ce qui cause l’augmentation du prix du riz."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76917c01-9887-4582-b387-11d5ff05ff7b",
                        "source_entry_id": "3c7699cd-28e6-3030-8eda-c0429730816c",
                        "source_sense_description": "land measured in acres",
                        "target_lang_word": "Anbaufläche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anbaufläche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db3e7935-af54-3d81-9512-a7aeb08b6e76",
                                        "entry_id": "d9725786-2032-3bc5-b7d1-c1fc3c817455",
                                        "glosses": [
                                            "für den Anbau von Pflanzen genutzte Fläche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1b4b701-8d04-4061-b72b-e406c8c32970",
                                                "sense_id": "db3e7935-af54-3d81-9512-a7aeb08b6e76",
                                                "text": "„Ab Mitte der 1980er Jahre gab es jedoch gezielte staatliche Anstrengungen, die Anzahl der Olivenbäume zu steigern und die Anbaufläche zu erweitern.“"
                                            },
                                            {
                                                "example_id": "97dbf608-e41c-4f34-8cb5-85958e97b14e",
                                                "sense_id": "db3e7935-af54-3d81-9512-a7aeb08b6e76",
                                                "text": "„Sie produzieren den größten Teil aller Lebensmittel und bewirtschaften etwa 60% der weltweiten Anbaufläche.“"
                                            },
                                            {
                                                "example_id": "10f0c84c-d3fc-4726-886f-444b1fb13434",
                                                "sense_id": "db3e7935-af54-3d81-9512-a7aeb08b6e76",
                                                "text": "„Bis Anfang der 1980er Jahre verläuft die Änderung der Anbaufläche von Mais, Reis, Soja und Weizen relativ synchron.“"
                                            },
                                            {
                                                "example_id": "f35ca0c2-e531-4aea-bfff-4138dd0e1f61",
                                                "sense_id": "db3e7935-af54-3d81-9512-a7aeb08b6e76",
                                                "text": "„Und diese Betriebe waren Kleinbetriebe mit einer durchschnittlichen Anbaufläche von nur 1,6 Hektar.“"
                                            },
                                            {
                                                "example_id": "f731690f-782b-4177-a1cc-154f13108f4b",
                                                "sense_id": "db3e7935-af54-3d81-9512-a7aeb08b6e76",
                                                "text": "„Ob Reisfelder, Mais oder Tomaten – viele Anbauflächen brauchen eine kontinuierliche Bewässerung.“"
                                            },
                                            {
                                                "example_id": "f05bf993-df1d-4f22-8868-d47704cbac30",
                                                "sense_id": "db3e7935-af54-3d81-9512-a7aeb08b6e76",
                                                "text": "„In Brasilien werden Regenwälder gerodet, um zusätzliche Anbauflächen für Zuckerrohr für die Bioethanolproduktion zu schaffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
