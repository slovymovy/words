                "senses": [
                    {
                        "sense_id": "848c66af-8855-3bd8-9cac-04727647453e",
                        "entry_id": "ca3ab853-09fe-37dd-a7c3-c507615ac7f8",
                        "glosses": [
                            "Professionnel du bâtiment qui pose des plaques de plâtre sur les murs ou les plafonds."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0f6459c-b8fb-4f25-b884-38aa0ff49036",
                                "sense_id": "848c66af-8855-3bd8-9cac-04727647453e",
                                "text": "Le plaquiste est un spécialiste des travaux de finition intérieure, d’isolation et d’aménagement. Il pose des cloisons préfabriquées en bois ou des plaques de plâtre, les assemble sur toute surface qui le nécessite : mur, plafond ou sol."
                            },
                            {
                                "example_id": "1a9296b1-4dad-4085-b364-c7da4dc28c40",
                                "sense_id": "848c66af-8855-3bd8-9cac-04727647453e",
                                "text": "En effet, les professionnels qui y contribuent apparaissent et disparaissent d’un moment à l’autre (charpentiers, plaquistes, électriciens, carreleurs, plombiers…) en fonction des besoins du projet."
                            }
                        ]
                    }
