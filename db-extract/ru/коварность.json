                "senses": [
                    {
                        "sense_id": "79497221-d778-33e4-876d-ebfdc053010a",
                        "entry_id": "a32bc553-7b03-380a-bab2-65b92edbf557",
                        "glosses": [
                            "свойство характера человека: способность и склонность скрывать за показанным дружелюбием злые намерения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a2c3e8c-6ff8-4e0f-b043-9ae5c25c7aaa",
                                "sense_id": "79497221-d778-33e4-876d-ebfdc053010a",
                                "text": "Женская коварность."
                            },
                            {
                                "example_id": "a61bcda9-46f4-409f-ac00-c381d48d2c69",
                                "sense_id": "79497221-d778-33e4-876d-ebfdc053010a",
                                "text": "Отличительная особенность истинного вампира — коварность и изощрённый ум."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b5e8292-d893-350c-96de-06242f6c9f83",
                        "entry_id": "a32bc553-7b03-380a-bab2-65b92edbf557",
                        "glosses": [
                            "свойство поступка, вытекающее из такого характера"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e93902e1-12df-45d2-9749-d7d0d9425239",
                                "sense_id": "8b5e8292-d893-350c-96de-06242f6c9f83",
                                "text": "Коварность поступка."
                            }
                        ]
                    },
                    {
                        "sense_id": "5df7b40e-619e-33b9-9651-b70be720a723",
                        "entry_id": "a32bc553-7b03-380a-bab2-65b92edbf557",
                        "glosses": [
                            "перен. скрытая опасность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0a7c066-ade1-4fc1-a36c-b592d2564cf9",
                                "sense_id": "5df7b40e-619e-33b9-9651-b70be720a723",
                                "text": "Коварность раковой опухоли — в том, что её очень трудно определить на ранней стадии, когда ткани ещё можно спасти, а процесс замедлить."
                            },
                            {
                                "example_id": "27829c44-05ea-4529-9520-bda7e4cb353a",
                                "sense_id": "5df7b40e-619e-33b9-9651-b70be720a723",
                                "text": "Коварность природы."
                            }
                        ]
                    }
                ],
