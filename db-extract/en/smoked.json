                    },
                    {
                        "sense_id": "f73dbdb4-ea2e-33bd-8093-59c61668d5da",
                        "entry_id": "1072cfc8-73d0-369c-af94-93c19ecd4284",
                        "glosses": [
                            "Of glass, tinted."
