    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9ed2d63c-22e8-3682-aa08-776c8781bb3f",
                    "sense_definition": "iets voorzien van een teken of kleur om het op te laten vallen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "aanduiden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je kunt de belangrijkste woorden in de tekst met een gele stift <w>markeren</w>.",
                            "target_lang_translations": {
                                "en": "You can <w>highlight</w> the most important words in the text with a yellow marker.",
                                "ru": "Вы можете <w>выделить</w> самые важные слова в тексте желтым маркером."
                            }
                        },
                        {
                            "text": "De leraar zal de fouten in je huiswerk duidelijk <w>markeren</w>.",
                            "target_lang_translations": {
                                "en": "The teacher will clearly <w>mark</w> the mistakes in your homework.",
                                "ru": "Учитель четко <w>пометит</w> ошибки в твоем домашнем задании."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanduiden",
                        "kenmerken"
                    ],
                    "common_phrases": [
                        "tekst markeren",
                        "belangrijke punten markeren"
                    ],
                    "target_lang_definitions": {
                        "en": "to provide something with a sign or color to make it stand out",
                        "ru": "снабжать что-либо знаком или цветом, чтобы выделить это"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "highlight",
                                "target_lang_sense_clarification": "using color to make text stand out"
                            },
                            {
                                "target_lang_word": "mark",
                                "target_lang_sense_clarification": "to put a visible sign on something"
                            },
                            {
                                "target_lang_word": "indicate",
                                "target_lang_sense_clarification": "to point out or show"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "выделять",
                                "target_lang_sense_clarification": "цветом или маркером в тексте"
                            },
                            {
                                "target_lang_word": "помечать",
                                "target_lang_sense_clarification": "ставить знак или метку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f8c6b09-1933-301a-99df-5362419f97ba",
                    "sense_definition": "het aangeven of vaststellen van een grens of territorium",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "afbakenen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij waren bezig de vluchtstrook met een ononderbroken witte lijn te <w>markeren</w>.",
                            "target_lang_translations": {
                                "en": "They were busy <w>marking</w> the hard shoulder with a solid white line.",
                                "ru": "Они были заняты тем, что <w>размечали</w> обочину сплошной белой линией."
                            }
                        },
                        {
                            "text": "Sommige dieren gebruiken geuren om hun territorium te <w>markeren</w> tegen indringers.",
                            "target_lang_translations": {
                                "en": "Some animals use scents to <w>mark</w> their territory against intruders.",
                                "ru": "Некоторые животные используют запахи, чтобы <w>метить</w> свою территорию от незваных гостей."
                            }
                        }
                    ],
                    "synonyms": [
                        "afbakenen",
                        "begrenzen"
                    ],
                    "common_phrases": [
                        "een grens markeren",
                        "territorium markeren"
                    ],
                    "target_lang_definitions": {
                        "en": "indicating or establishing a boundary or territory",
                        "ru": "указывать или устанавливать границу или территорию"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mark",
                                "target_lang_sense_clarification": "to create an indication of a location or boundary"
                            },
                            {
                                "target_lang_word": "demarcate",
                                "target_lang_sense_clarification": "to set the boundaries or limits of"
                            },
                            {
                                "target_lang_word": "define",
                                "target_lang_sense_clarification": "to state or describe the exact nature or scope of"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "обозначать",
                                "target_lang_sense_clarification": "границы или пределы"
                            },
                            {
                                "target_lang_word": "метить",
                                "target_lang_sense_clarification": "территорию (о животных)"
                            },
                            {
                                "target_lang_word": "размечать",
                                "target_lang_sense_clarification": "наносить разметку на дорогу или участок"
                            }
                        ]
                    }
                }
            ]
        }
    ]
