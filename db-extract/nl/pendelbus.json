                        "sense_id": "c0c51002-c49d-358c-ab64-d4f506df159c",
                        "entry_id": "483b70e6-b774-3b09-9388-754e945f8741",
                        "glosses": [
                            "een bus die voor een pendeldienst in gebruik is en dus steeds heen en weer rijdt tussen twee bestemmingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a767dba-b711-4d86-a475-e5214422e44a",
                                "sense_id": "c0c51002-c49d-358c-ab64-d4f506df159c",
                                "text": "Een pendelbus die op weg was naar het festival Dream Village in Bavel is zaterdagmiddag niet op het festivalterrein maar in een sloot beland."
                            },
                            {
                                "example_id": "44ce81e5-80ca-4a26-bbd2-6ce7a9e63ad7",
                                "sense_id": "c0c51002-c49d-358c-ab64-d4f506df159c",
                                "text": "Er treedt vanzelfsprekend een volledig verkeercirculatieplan in werking. Het verkeer wordt doorgeleid naar een grote parkeerplaats in Zandvoort-Zuid, waarvandaan non-stop pendelbussen rijden naar het circuit."
                            }
                        ]
                    }
