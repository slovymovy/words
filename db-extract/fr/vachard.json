                "senses": [
                    {
                        "sense_id": "4ecd8cab-f76e-348e-80e7-1c8f52c5f872",
                        "entry_id": "fed118ce-0520-37a3-85da-63e047a39f7b",
                        "glosses": [
                            "Méchant, volontairement blessant."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "9f1d0062-7fa8-4a20-87e9-cc91b297e01c",
                                "sense_id": "4ecd8cab-f76e-348e-80e7-1c8f52c5f872",
                                "text": "Toufik avait les dents du bonheur. Dix ans de la tête aux pieds. Zonard importé, deuxième génération. Vachard avec les cons. Rieur avec ses potes. Poli avec sa mère."
                            },
                            {
                                "example_id": "29e48020-0c4d-4baa-a5ab-73853f5d7d59",
                                "sense_id": "4ecd8cab-f76e-348e-80e7-1c8f52c5f872",
                                "text": "Je rêvais d’un « chouette beau journal » voué à l’humour tel que je le concevais : énorme, vachard, fin comme l’ambre et dur comme l’enclume, sans état d’âme comme sans concession…"
                            },
                            {
                                "example_id": "4e089116-bfbd-470b-a72c-43ccc759db6c",
                                "sense_id": "4ecd8cab-f76e-348e-80e7-1c8f52c5f872",
                                "text": "Dans ce quartier bobo de la capitale durement touché par les attentats du 13 novembre, il règne une humeur bistrotière à la fois parigote et vacharde."
                            },
                            {
                                "example_id": "48f2c2cd-dd60-42c0-848e-ec4a38d7ffd6",
                                "sense_id": "4ecd8cab-f76e-348e-80e7-1c8f52c5f872",
                                "text": "Il adore les remarques vachardes, c'est sa façon de s'affirmer, ne te laisse pas intimider !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c3ddf2f-5786-4335-84b3-82c8b4d8b13c",
                        "source_entry_id": "fed118ce-0520-37a3-85da-63e047a39f7b",
