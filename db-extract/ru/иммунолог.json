                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40537bc7-d53d-49db-b560-e1c81aa83667",
                                                "sense_id": "82251608-533f-38fd-afbb-e812ed7b93f1",
