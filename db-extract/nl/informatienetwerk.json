                        "glosses": [
                            "stelsel van zaken of personen die informatie verzamelen en met elkaar uitwisselen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4a08d2f-d328-46a3-bf51-7e14876a1e9b",
                                "sense_id": "fb8904d4-1d98-3dec-a96b-86e832799596",
                                "text": "Zelfs het wereldwijde informatienetwerk, actief sinds zijn geboorte drie eeuwen geleden, viel stil."
                            },
                            {
                                "example_id": "d19caad0-64d9-4abf-9a91-2f01febb1885",
                                "sense_id": "fb8904d4-1d98-3dec-a96b-86e832799596",
                                "text": "Vaak heb ik me de afgelopen jaren in mijn kleine schrijfhuisje aan het duin gevoeld als een spin in een internationaal informatienetwerk, dat als gezamenlijk doel had het verhaal van het geslacht Herckenrath-de Fremery op te graven."
                            },
                            {
                                "example_id": "7d8d5c26-4330-4f92-9164-680317a26fa2",
                                "sense_id": "fb8904d4-1d98-3dec-a96b-86e832799596",
                                "text": "John Sawers, tot 2014 hoofd van inlichtingendienst MI6, en Jonathan Evans, tot drie jaar geleden hoofd bij MI5, stellen dat een vertrek Groot-Brittannië zal afsnijden van het Europese informatienetwerk. \"Counterterrorisme is een teamspel, en de EU is daarvoor het beste raamwerk. Geen een land kan in zijn eentje slagen.\""
                            }
                        ]
                    }
