                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8eae0a6e-92ff-4b50-97c5-6d483e7474d1",
                                "sense_id": "08acf1fc-c5a9-361a-83c4-7bea8c461c62",
                                "text": "„Natürlich stimmen die Dialektgrenzen als alte Stammesgrenzen mit den politischen Grenzen von heute fast nie überein.“"
                            },
                            {
                                "example_id": "ef1479d4-314e-48d2-bdd6-55857c737e52",
                                "sense_id": "08acf1fc-c5a9-361a-83c4-7bea8c461c62",
                                "text": "„Bis zu einem gewissen Grade fielen die Dialektgrenzen mit den historisch-politischen Grenzen Osteuropas zusammen, was sich auch in den jiddischen Bezeichnungen ausdrückte.“"
                            }
                        ],
