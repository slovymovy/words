                        "glosses": [
                            "Caractère de ce qui est sombre."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "2f0121b2-df1e-4b5b-9e42-eecc80f6e8f2",
                                "sense_id": "aec9ab33-9d88-3ffb-b6be-2d96c6b57b6f",
                                "text": "La pythonisse se fiait sans doute aux secrets de sa science ; d’ailleurs la sombritude de la nuit et l’effroi de Saùl ne pouvaient qu’ajouter beaucoup à l’efficacité de ses prestiges."
                            },
                            {
                                "example_id": "2ddf7856-2b4f-4e46-a368-d8d082610218",
                                "sense_id": "aec9ab33-9d88-3ffb-b6be-2d96c6b57b6f",
                                "text": "Sombritude des forêts, moutonnements des vignobles, vents rageurs de l’Atlantique, lumière qui dessine les cyprès et les mas : entre genièvre et pastis, l’Hexagone fait ses synthèses au bord de la Seine après les avoir ébauchées au bord de la Loire."
                            },
                            {
                                "example_id": "378dd176-df8c-4d3c-a69b-9209b627a5e0",
                                "sense_id": "aec9ab33-9d88-3ffb-b6be-2d96c6b57b6f",
                                "text": "Comment pourrais-je être coincé dans les « sombritudes » des remords alors que les soleils illuminent ?"
                            }
                        ]
                    }
