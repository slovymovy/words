                    }
                ],
                "translations": [
                    {
                        "translation_id": "339bb744-647b-42c5-9551-6fd3e738062a",
                        "source_entry_id": "7000863a-903a-353e-ac0f-5fe771ede68c",
                        "source_sense_id": "b5799a46-160a-3db7-b929-764e07651eaf",
                        "target_lang_word": "kalt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kalt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "04d0fe4a-d3e1-39c4-95d1-4f94ee79bd6b",
                                        "entry_id": "94dd4f84-dcbf-3746-8faf-096a2f395e92",
                                        "glosses": [
                                            "eine niedrige Temperatur habend; von/mit niedriger Temperatur; nicht (mehr) heiß"
                                        ],
                                        "tags": [
                                            "von Speisen",
                                            "Küche"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3d2f3a9-f6cf-4fb1-a117-4f0cad8caa4c",
                                                "sense_id": "04d0fe4a-d3e1-39c4-95d1-4f94ee79bd6b",
                                                "text": "Ein kalter Wind wehte von Osten."
                                            },
                                            {
                                                "example_id": "f294a733-f8ac-44b1-b80a-083618fc9e2e",
                                                "sense_id": "04d0fe4a-d3e1-39c4-95d1-4f94ee79bd6b",
                                                "text": "„Die Winternacht war hell und kalt;; sie war so kalt, daß der Vollmond ganz blaß aussah und die Sterne vor Frost zitterten.“"
                                            },
                                            {
                                                "example_id": "7515a9e2-799d-42df-91e6-7d20e0646161",
                                                "sense_id": "04d0fe4a-d3e1-39c4-95d1-4f94ee79bd6b",
                                                "text": "Auch Chicago hat die Kälte fest im Griff. Selbst für Anana, die Eisbärdame des Lincoln-Park-Zoos, ist es zu kalt - sie darf ihr Innengehege nicht verlassen."
                                            },
                                            {
                                                "example_id": "cdb01ae8-e2b1-4cbb-bb34-038e0dc7a2f2",
                                                "sense_id": "04d0fe4a-d3e1-39c4-95d1-4f94ee79bd6b",
                                                "text": "„Bei akuten Verbrennungen ist das wichtigste Gegenmittel kaltes Leitungswasser.“"
                                            },
                                            {
                                                "example_id": "4dde0280-6461-4bb3-b1fe-39c4c4c27718",
                                                "sense_id": "04d0fe4a-d3e1-39c4-95d1-4f94ee79bd6b",
                                                "text": "„Die an die kältere Temperatur angepassten Leguane zeigen bei jeder der untersuchten Körpertemperaturen eine höhere Stoffwechselrate.“"
                                            },
                                            {
                                                "example_id": "29399cac-63fc-4c2e-b474-7f6b0abe6d37",
                                                "sense_id": "04d0fe4a-d3e1-39c4-95d1-4f94ee79bd6b",
                                                "text": "Kommt ins Haus, Essen wird kalt!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e93bccc0-b9ba-3bb2-995c-7abf658a2457",
                                        "entry_id": "94dd4f84-dcbf-3746-8faf-096a2f395e92",
                                        "glosses": [
                                            "kein Mitgefühl habend oder zeigend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84dfe2c3-bf3e-4a59-af84-3b2511c3af72",
                                                "sense_id": "e93bccc0-b9ba-3bb2-995c-7abf658a2457",
                                                "text": "Er lächelte kalt."
                                            },
                                            {
                                                "example_id": "738b91f7-eb67-4ace-8047-7b1ac1068383",
                                                "sense_id": "e93bccc0-b9ba-3bb2-995c-7abf658a2457",
                                                "text": "„Sie wurde launisch und unberechenbar. Manchmal tat sie ganz intim, dann plötzlich, irritiert durch seine Gleichmütigkeit, schien sie kalt und abweisend.“"
                                            },
                                            {
                                                "example_id": "cc34fbfc-ea24-4e0e-8569-3a73e731803a",
                                                "sense_id": "e93bccc0-b9ba-3bb2-995c-7abf658a2457",
                                                "text": "Die USA haben Geheimdokumente von 1956 veröffentlicht, die Pläne für einen möglichen Krieg mit der Sowjetunion offenbaren. Sie zeigen, wie kalt mit dem Tod vieler Zivilisten kalkuliert wurde."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "40c8648a-6463-3c93-a979-b6e4324159de",
                                        "entry_id": "94dd4f84-dcbf-3746-8faf-096a2f395e92",
                                        "glosses": [
                                            "ungemütlich"
                                        ],
                                        "tags": [],
                                        "examples": [
