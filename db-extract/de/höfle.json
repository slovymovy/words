                ],
                "senses": [
                    {
                        "sense_id": "8b2af5a5-6dd9-31c3-b122-a22b0ec71f7e",
                        "entry_id": "9ac352b4-1f45-3bc7-8682-6c1364ca1e8c",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91c3a29e-bf08-4cc8-8c02-1ac96ff0b3cb",
                                "sense_id": "8b2af5a5-6dd9-31c3-b122-a22b0ec71f7e",
                                "text": "Frau Höfle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "aff48692-5e32-4a33-87c8-3bb751a0e442",
                                "sense_id": "8b2af5a5-6dd9-31c3-b122-a22b0ec71f7e",
                                "text": "Herr Höfle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7fcef4a4-70fd-412f-a77f-f3593680658f",
                                "sense_id": "8b2af5a5-6dd9-31c3-b122-a22b0ec71f7e",
                                "text": "Die Höfles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "9264ba73-6e61-4c49-bd12-6a3bf40dba30",
                                "sense_id": "8b2af5a5-6dd9-31c3-b122-a22b0ec71f7e",
                                "text": "Der Höfle trägt nie die Schals, die die Höfle ihm strickt."
                            },
                            {
                                "example_id": "0e94699b-489a-48a6-9274-d72467930b2c",
                                "sense_id": "8b2af5a5-6dd9-31c3-b122-a22b0ec71f7e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Höfle kommt, geht der Herr Höfle.“"
                            },
                            {
                                "example_id": "40a5d010-f6bd-4c32-8eb6-0ce861c3dcfa",
                                "sense_id": "8b2af5a5-6dd9-31c3-b122-a22b0ec71f7e",
                                "text": "Höfle kommt und geht."
                            },
                            {
                                "example_id": "926b4ea7-bbb1-4eb5-a619-901c686e484c",
                                "sense_id": "8b2af5a5-6dd9-31c3-b122-a22b0ec71f7e",
                                "text": "Höfles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
