{
    "word_family": [
        "embargo"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cdc8e9a2-2686-3de1-b817-2ff5abee79b7",
                    "sense_definition": "A government-ordered ban on trade with another country.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "trade_restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government decided to <w>embargo</w> all luxury goods from the neighboring nation.",
                            "target_lang_translations": {
                                "zh": "政府决定对邻国的所有奢侈品实施<w>禁运</w>。"
                            }
                        },
                        {
                            "text": "The international community imposed a strict trade <w>embargo</w> to pressure the regime.",
                            "target_lang_translations": {
                                "zh": "国际社会实施了严格的贸易<w>禁运</w>以向该政权施压。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "trade embargo"
                    ],
                    "target_lang_definitions": {
                        "zh": "政府下令禁止与另一国进行贸易。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "禁运",
                                "target_lang_sense_clarification": "指禁止货物进出口的贸易限制。"
                            },
                            {
                                "target_lang_word": "贸易禁运",
                                "target_lang_sense_clarification": "特指针对贸易往来的禁令。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b64f1fc9-c3c5-3ee8-97b0-1c09a6f52a62",
                    "sense_definition": "An official order prohibiting ships from leaving or entering a port.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "trade_restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The port authority issued an <w>embargo</w> on all merchant vessels due to the storm.",
                            "target_lang_translations": {
                                "zh": "由于风暴，港务局对所有商船发布了<w>禁航令</w>。"
                            }
                        },
                        {
                            "text": "The navy enforced a naval <w>embargo</w> to prevent supplies from reaching the enemy.",
                            "target_lang_translations": {
                                "zh": "海军执行了海上<w>封锁</w>，以阻止物资运抵敌方。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blockade"
                    ],
                    "common_phrases": [
                        "naval embargo"
                    ],
                    "target_lang_definitions": {
                        "zh": "官方下令禁止船只进出港口的命令。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "封锁",
                                "target_lang_sense_clarification": "指对港口或航道的军事或行政封锁。"
                            },
                            {
                                "target_lang_word": "禁航令",
                                "target_lang_sense_clarification": "指禁止船只航行的官方命令。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7741957-ed1e-328b-83cd-dd4045c18bfb",
                    "sense_definition": "A temporary restriction on releasing specific information to the public.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "information_restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientific report is under <w>embargo</w> until the official press conference tomorrow.",
                            "target_lang_translations": {
                                "zh": "该科学报告在明天的官方新闻发布会之前处于<w>禁发期</w>。"
                            }
                        },
                        {
                            "text": "Journalists must respect the <w>embargo</w> on the new product details until the launch.",
                            "target_lang_translations": {
                                "zh": "记者必须遵守在产品发布前对新产品细节的<w>发布禁令</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "under embargo"
                    ],
                    "target_lang_definitions": {
                        "zh": "对特定信息向公众发布所设的临时限制。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "发布禁令",
                                "target_lang_sense_clarification": "指在特定时间前禁止公开信息的规定。"
                            },
                            {
                                "target_lang_word": "禁发期",
                                "target_lang_sense_clarification": "指信息被禁止发布的一段时间。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e82b0e0-f072-3692-826f-445a781b3868",
                    "sense_definition": "A severe constraint or heavy burden on actions or financial resources.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "constraint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The high cost of living placed a significant <w>embargo</w> on their ability to travel.",
                            "target_lang_translations": {
                                "zh": "高昂的生活成本对他们的旅行能力造成了严重的<w>限制</w>。"
                            }
                        },
                        {
                            "text": "The new regulations acted as an <w>embargo</w> on small business expansion.",
                            "target_lang_translations": {
                                "zh": "新法规对小企业的扩张起到了<w>束缚</w>作用。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in a figurative sense."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "对行动或财务资源施加的严重限制或沉重负担。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "限制",
                                "target_lang_sense_clarification": "指对某种行为或发展的约束。"
                            },
                            {
                                "target_lang_word": "束缚",
                                "target_lang_sense_clarification": "指对资源或行动的沉重制约。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6fdc0cf3-19f4-3c88-9d62-8df645b7bc6e",
                    "sense_definition": "To officially prohibit the trade of certain goods with another country.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "trade_restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The country decided to <w>embargo</w> oil exports to protest the political situation.",
                            "target_lang_translations": {
                                "zh": "该国决定对石油出口实施<w>禁运</w>，以抗议当前的政治局势。"
                            }
                        },
                        {
                            "text": "They will <w>embargo</w> all technology imports to protect local industries.",
                            "target_lang_translations": {
                                "zh": "他们将对所有技术进口实施<w>禁运</w>，以保护当地产业。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "官方禁止与另一国进行特定商品的贸易。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "禁运",
                                "target_lang_sense_clarification": "指实施禁止贸易的动作。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4eac972e-d69b-3eaf-bd17-d4afc13e8146",
                    "sense_definition": "To place a temporary restriction on the publication or release of a document.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "information_restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ministry decided to <w>embargo</w> the report until the investigation is complete.",
                            "target_lang_translations": {
                                "zh": "该部门决定在调查完成前<w>暂缓发布</w>该报告。"
                            }
                        },
                        {
                            "text": "The press office will <w>embargo</w> the findings until the official announcement.",
                            "target_lang_translations": {
                                "zh": "新闻办公室将在正式公告发布前<w>暂缓发布</w>调查结果。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "对文件或信息的发布设置临时限制。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "暂缓发布",
                                "target_lang_sense_clarification": "指推迟信息公开的行政行为。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "f6d88896-da2e-32db-a5e4-6874672be6be",
                    "sense_definition": "A barangay located in Ozamiz, Misamis Occidental, Philippines.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "place",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The local government office is situated in the barangay of <w>Embargo</w>.",
                            "target_lang_translations": {
                                "zh": "当地政府办公室位于<w>恩巴戈</w>描笼涯。"
                            }
                        },
                        {
                            "text": "Many residents of <w>Embargo</w> work in the nearby city center.",
                            "target_lang_translations": {
                                "zh": "许多<w>恩巴戈</w>的居民在附近的市中心工作。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Refers to a specific location in the Philippines."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "位于菲律宾米萨米斯奥克西登塔尔省奥扎米兹市的一个描笼涯。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "恩巴戈",
                                "target_lang_sense_clarification": "地名音译。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}