                    {
                        "sense_id": "6923f6f9-f604-3490-8c78-df7ece9509b4",
                        "entry_id": "c63593b1-7940-35e0-92a0-f460feacff00",
                        "glosses": [
                            "französische Weltraumfahrerin"
