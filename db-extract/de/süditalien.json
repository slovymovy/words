                ],
                "senses": [
                    {
                        "sense_id": "54ea4f83-1204-350f-90e3-449da8348865",
                        "entry_id": "95eebada-2dd0-398c-ae36-27e89f07174c",
                        "glosses": [
                            "Teil von Italien, der im Süden der Italienischen Halbinsel (Apenninen-Halbinsel/Apenninenhalbinsel) liegt"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "fcea7fa6-bb73-45bd-a991-ef0bafa7f83e",
                                "sense_id": "54ea4f83-1204-350f-90e3-449da8348865",
                                "text": "„In der versunkenen Stadt Pompeji in Süditalien haben Archäologen einen einzigartigen Triumphwagen aus der Antike ausgegraben.“"
                            },
                            {
                                "example_id": "35f97541-5c01-4a81-9491-6f7dd3f95110",
                                "sense_id": "54ea4f83-1204-350f-90e3-449da8348865",
                                "text": "„Mindestens 38 Menschen sind am Sonntagabend bei einem schweren Busunglück in Süditalien ums Leben gekommen.“"
                            },
                            {
                                "example_id": "0c8d4299-8f73-4b3a-a4da-bda6384a4332",
                                "sense_id": "54ea4f83-1204-350f-90e3-449da8348865",
                                "text": "„Der Westgotenkönig Alarich plünderte die Stadt 410 und zog dann nach Süditalien, wo er noch im selben Jahr an Malaria erkrankte und starb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
