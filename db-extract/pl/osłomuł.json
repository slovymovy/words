                                "target_senses": [
                                    {
                                        "sense_id": "361e3294-4e8e-38fc-81d7-2a57b7f6141e",
                                        "entry_id": "d01c14a8-2c52-3a88-b89c-4c1f3260be87",
                                        "glosses": [
                                            "The hybrid offspring of a stallion (male horse) and a she-ass (female donkey)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab5f4245-c82a-4ba6-90b6-2ebf15f8f3d9",
                                                "sense_id": "361e3294-4e8e-38fc-81d7-2a57b7f6141e",
                                                "text": "The curer said nothing to the cowboy but went straight to the mule, or hinny, rather, being out of San's big jenny by Alder's white horse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hinny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db519cc7-a69e-3ab8-872e-359fd081766f",
