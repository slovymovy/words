                ],
                "senses": [
                    {
                        "sense_id": "276b56d0-0895-3bce-91cf-cc0c2928330e",
                        "entry_id": "b4d1b970-b9e8-3811-89cd-6d07e1e1fed0",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42d80d85-77ec-4c2e-8830-ede9179f369f",
                                "sense_id": "276b56d0-0895-3bce-91cf-cc0c2928330e",
                                "text": "Frau Knaute ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "84ab034e-b893-49bb-ab7d-50a15a51240f",
                                "sense_id": "276b56d0-0895-3bce-91cf-cc0c2928330e",
                                "text": "Herr Knaute wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "3f92593d-0bb4-4db4-83ff-70b906a66f26",
                                "sense_id": "276b56d0-0895-3bce-91cf-cc0c2928330e",
                                "text": "Die Knautes fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "391d6458-367a-4925-b724-db3a48bfdb33",
                                "sense_id": "276b56d0-0895-3bce-91cf-cc0c2928330e",
                                "text": "Der Knaute trägt nie die Schals, die die Knaute ihm strickt."
                            },
                            {
                                "example_id": "57566a51-348e-47b4-8f0e-2188dc5e3ed1",
                                "sense_id": "276b56d0-0895-3bce-91cf-cc0c2928330e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Knaute kommt, geht der Herr Knaute.“"
                            },
                            {
                                "example_id": "47322359-32d3-4504-9187-45d251a2d34e",
                                "sense_id": "276b56d0-0895-3bce-91cf-cc0c2928330e",
                                "text": "Knaute kommt und geht."
                            },
                            {
                                "example_id": "5f6c1a67-677a-41d1-8e46-bd6469e9bb79",
                                "sense_id": "276b56d0-0895-3bce-91cf-cc0c2928330e",
                                "text": "Knautes kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
