                        "attentivement"
                    ]
                },
                {
                    "sense_id": "15de2630-2350-3527-b540-d75922257286",
                    "sense_definition": "D'un ton distrait ou indifférent, en feignant ou marquant un manque d'intérêt.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il demanda <w>négligemment</w> des nouvelles de son ami pour ne pas éveiller les soupçons."
                        },
                        {
                            "text": "Elle haussa les épaules et répondit <w>négligemment</w> que la décision ne la concernait pas."
