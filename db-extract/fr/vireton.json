                "senses": [
                    {
                        "sense_id": "ede53964-219c-3201-955e-bab811f536ce",
                        "entry_id": "c1349633-610a-3ea9-8389-dc941ffe7ef4",
                        "glosses": [
                            "Trait d’arbalète empenné en hélice avec des lamelles de bois, de corne ou de fer, qui le faisaient tourner en l’air sur lui-même."
                        ],
                        "tags": [
                            "Anciennement"
                        ],
                        "examples": [
                            {
                                "example_id": "511e7302-7161-438d-a70f-ab87bafeeed9",
                                "sense_id": "ede53964-219c-3201-955e-bab811f536ce",
                                "text": "J’ai des viretons pour les arbalètes, dit Gurth vivement."
                            },
                            {
                                "example_id": "ee6c979d-6aff-4dfd-a3c8-aa96ab3e0304",
                                "sense_id": "ede53964-219c-3201-955e-bab811f536ce",
                                "text": "Pourtant arcs et arbalètes lançaient une véritable pluie de flèches, de carreaux et de viretons sur les créneaux dans le dessein d’en éloigner les Maures de faction et de laisser aux assaillants de première ligne le loisir de s’employer à briser les portes à coups de hache et de marteau, pendant que d’autres, actionnant les lourds béliers, se ruent contre elles en cadence, mais les Maures ne lâchaient pas pied, protégés au début par les abris qu’ils avaient construits, puis, quand ceux-ci commencèrent à brûler, incendiés par les torches torches attachées aux plus grands viretons, ils les précipitèrent de haut des murs sur la tête des Portugais qui durent alors reculer, roussis comme cochons après l’égorgement."
                            }
                        ]
                    }
