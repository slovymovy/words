                "senses": [
                    {
                        "sense_id": "dcf93592-0ac2-3bfd-8327-1e5629089dd2",
                        "entry_id": "69394346-8784-3cf7-b491-5e1aeff09db1",
                        "glosses": [
                            "kort dutje waarin men nieuwe krachten opdoet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92d24202-2b1f-4959-90b8-c208f8417c71",
                                "sense_id": "dcf93592-0ac2-3bfd-8327-1e5629089dd2",
                                "text": "Volgens Smit is een powernap tussen de middag een manier om het slaaptekort iets in te dammen. “Het zou goed zijn als ze een vast ritueel hebben voordat zij naar bed gaan. Daardoor val je sneller in slaap”, vertelt Smit. “Dat kan de volgorde zijn waarin je dingen doet, bijvoorbeeld douchen en tandenpoetsen. Ook schijnt het nemen van een korte, warme douche het (langer) slapen te bevorderen.”"
                            },
                            {
                                "example_id": "5a60faa3-6bba-4719-87df-bb6009f12e82",
                                "sense_id": "dcf93592-0ac2-3bfd-8327-1e5629089dd2",
                                "text": "Na bijna zes dagen had hij het geflikt: de Pool Hubert Blejch heeft het wereldrecord gamen verbroken. Hij speelde 5 dagen, 21 uur en 41 minuten de game Sniper Elite 3, tijdens de Gaming Arena de Poznan in Polen. Wel kreeg hij elk uur 10 minuten pauze voor een snelle plaspauze, een check door artsen, een massage of een powernap. Eigenlijk wilde hij een week lang gamen, maar dat hield hij niet vol."
                            }
                        ]
                    }
