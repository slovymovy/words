                "senses": [
                    {
                        "sense_id": "ba162da4-f4aa-35cc-a15c-caae23a38420",
                        "entry_id": "a2859d7d-70a0-3b66-9be5-292a9ed27bd8",
                        "glosses": [
                            "A card containing a set of manufacturing specifications and requirements, used to regulate the supply of components."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "6fcb1967-de9c-4914-bcaa-d4129ee435d4",
                                "sense_id": "ba162da4-f4aa-35cc-a15c-caae23a38420",
                                "text": "The sub-assembly line assembles A. It goes to processing line 1 to withdraw part a, and for this purpose it must take the sub-assembly kanban (called withdrawal kanban). It goes to store a, withdraws boxes in the required quantity and removes those kanban (called in-process kanban or production-ordering kanban) that are attached to the boxes."
                            }
                        ]
                    },
                    {
                        "sense_id": "438f1f96-ea5f-34ef-92cf-78b5a30b9f87",
                        "entry_id": "a2859d7d-70a0-3b66-9be5-292a9ed27bd8",
                        "glosses": [
                            "A coordinated manufacturing system using such cards."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "fd1fab79-fae9-4906-b19f-c410ab73b837",
                                "sense_id": "438f1f96-ea5f-34ef-92cf-78b5a30b9f87",
                                "text": "However, since so many Japanese industries have adopted Kanban, this problem is diminishing."
                            }
                        ]
                    },
                    {
                        "sense_id": "351cc35a-27f2-3141-acd3-a7eac4bd7c9f",
                        "entry_id": "a2859d7d-70a0-3b66-9be5-292a9ed27bd8",
                        "glosses": [
                            "A system to manage, visualise, and improve work across teams, often as part of an agile methodology."
                        ],
                        "tags": [
                            "broadly",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2eb1613e-d9b6-4db2-adec-5cf421989fb7",
                                "sense_id": "351cc35a-27f2-3141-acd3-a7eac4bd7c9f",
                                "text": "kanban board"
                            },
                            {
                                "example_id": "a6c5ddac-a9ce-47ca-a901-11276a0ee8cf",
                                "sense_id": "351cc35a-27f2-3141-acd3-a7eac4bd7c9f",
                                "text": "The first thing that often differentiates a daily standup in a kanban team from other standup meetings is that a kanban team tends to focus on the work on the board rather than on the individual people in the team."
                            }
                        ]
                    }
