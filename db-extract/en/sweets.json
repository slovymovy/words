                                        "entry_id": "9b1c78d7-a81d-38be-a206-fc357562f4f2",
                                        "glosses": [
                                            "een meestal grotendeels van suiker vervaardigde lekkernij"
                                        ],
                                        "tags": [
                                            "snoepgoed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "763c7dba-23ae-49c9-b373-b83d9e6b15ae",
                                                "sense_id": "d498e16c-e1fe-39ed-907e-78cf9168cdf5",
                                                "text": "Jij eet toch geen snoep voor het avondeten?"
                                            },
                                            {
                                                "example_id": "b88b204d-1f94-4a49-8026-99659ca725b4",
                                                "sense_id": "d498e16c-e1fe-39ed-907e-78cf9168cdf5",
                                                "text": "Dat kinderen niet veel geld hebben, is volgens haar niet heel belangrijk voor adverteerders. \"Ook kinderen kopen producten, zoals speelgoed of snoep. Daarnaast vragen ze hun ouders om producten. Uit onderzoek blijkt bovendien dat kinderen invloed hebben op welke auto hun ouders kopen en welke vakanties worden geboekt.\""
                                            }
                                        ]
                                    }
                                ]
                            },
