                    {
                        "translation_id": "38fad464-7210-4cee-a4ab-dbcacb74d37e",
                        "source_entry_id": "50579497-acc2-34b6-8fc7-b2956e08df45",
                        "source_sense_id": "4f5b17c5-d503-3bce-885e-b523fc6c5b89",
                        "source_sense_description": "to live off the generosity of others",
                        "target_lang_word": "schmarotzen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schmarotzen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba2cb5b6-086b-3db2-80f4-cce0391f4450",
                                        "entry_id": "c41b0ae4-f77d-3136-8bf0-de1e7714695a",
                                        "glosses": [
                                            "aus Faulheit vom Geld, von der Arbeit anderer leben"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20d7e444-df40-43ad-8de5-3f520ace094a",
                                                "sense_id": "ba2cb5b6-086b-3db2-80f4-cce0391f4450",
                                                "text": "„Also müssen die Firmen, die auf Kosten der ausbildenden Betriebe schmarotzen, zur Kasse gebeten werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "769f1fb9-7f22-39ed-990c-036c008a7845",
                                        "entry_id": "c41b0ae4-f77d-3136-8bf0-de1e7714695a",
                                        "glosses": [
                                            "(als Organismus) auf oder in anderen Pflanzen oder Tieren leben und so seine Nahrung (zum einseitigen Nutzen) auf deren Kosten gewinnen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee44272b-bea9-40a9-907d-7361eb4c2d90",
                                                "sense_id": "769f1fb9-7f22-39ed-990c-036c008a7845",
                                                "text": "„Die Eier des Kleinen Fuchsbandwurms (Echinococcus multilocularis), der zwar im Darm von Füchsen schmarotzt, seinen Wirt aber nicht krank macht, können auch in seinem Balg stecken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3fe113c6-5a56-4f72-9196-589d2d45fb88",
                        "source_entry_id": "50579497-acc2-34b6-8fc7-b2956e08df45",
                        "source_sense_id": "4f5b17c5-d503-3bce-885e-b523fc6c5b89",
                        "source_sense_description": "to live off the generosity of others",
                        "target_lang_word": "schnorren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schnorren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85f96a3e-de7c-3fa3-b9d5-583871d7e225",
                                        "entry_id": "d5af18f9-969d-3b09-9347-98909c18d54e",
                                        "glosses": [
                                            "jemanden aus Gewohnheit immer wieder um Kleinigkeiten wie Kleingeld, Zigaretten oder Ähnlichem bitten, ohne selbst eine Gegenleistung erbringen zu wollen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18bae190-2e8f-434a-99fc-8c1cf8411f02",
                                                "sense_id": "85f96a3e-de7c-3fa3-b9d5-583871d7e225",
                                                "text": "Wenn Paula kein Geld mehr hat, schnorrt sie in den Straßen der Stadt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "45cddf0a-7132-3306-8e70-921962562b57",
                                        "entry_id": "d5af18f9-969d-3b09-9347-98909c18d54e",
                                        "glosses": [
                                            "höflich für sich selbst um Kleinigkeiten wie Kleingeld, Zigaretten oder Ähnlichem bitten, ohne selbst zu einer Gegenleistung bereit zu sein"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "387aad00-555f-4ef7-8fad-99ef053fb997",
                                                "sense_id": "45cddf0a-7132-3306-8e70-921962562b57",
                                                "text": "Kann ich mir ’ne Kippe von dir schnorren?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "37487c5a-94e4-3ab5-b468-3dc3ae353675",
                                        "entry_id": "d5af18f9-969d-3b09-9347-98909c18d54e",
                                        "glosses": [
                                            "daherreden, das große Wort führen"
                                        ],
                                        "tags": [
                                            "Swiss Standard German",
                                            "colloquial",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c20bdb4f-cc47-434d-8865-b7470f78441b",
                                                "sense_id": "37487c5a-94e4-3ab5-b468-3dc3ae353675",
                                                "text": "„Schnorr nicht so viel.“"
                                            },
                                            {
                                                "example_id": "02363abc-d9fe-46b5-b58f-78f0994423b7",
                                                "sense_id": "37487c5a-94e4-3ab5-b468-3dc3ae353675",
                                                "text": "„Leutnant Tobler … schätzte Füsilier Bär und hätte ihn gegen drei Stillere eingetauscht, er sah voraus, dass dieser wohlgelaunte Bursche zwar immer witzeln, schnorren und schimpfen, aber nicht versagen würde.“"
                                            },
                                            {
                                                "example_id": "7b68a1cb-32d4-4e16-994b-d6459572cfb5",
                                                "sense_id": "37487c5a-94e4-3ab5-b468-3dc3ae353675",
                                                "text": "„Ist ja auch huere viel: Rechnen, schnorren, schreiben – alles miteinander!“, während eines Jassturniers."
                                            },
                                            {
                                                "example_id": "c6bdde73-e1b7-4e14-9235-0ee61b9713b0",
                                                "sense_id": "37487c5a-94e4-3ab5-b468-3dc3ae353675",
                                                "text": "„Thema Plastik. Alle schnorren, niemand tut was. Dabei gäbe es längst Alternativen – Stichwort: Biopolymere.“"
                                            },
                                            {
                                                "example_id": "9445939a-cd65-4c5c-8671-5246f06632d0",
                                                "sense_id": "37487c5a-94e4-3ab5-b468-3dc3ae353675",
                                                "text": "„Majlinda Sulejmani: «Ich will mitgestalten, meinen Beitrag leisten – nicht nur schnorren, sondern handeln.»“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
