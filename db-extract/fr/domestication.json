                                "target_senses": [
                                    {
                                        "sense_id": "522cd918-0d50-3e4a-8630-84b02bbb1f3c",
                                        "entry_id": "d6bd608a-1451-3c52-b3c5-e602fd990ac4",
                                        "glosses": [
                                            "Maßnahme(n), aus wild lebenden Tieren mit der Zeit Haustiere zu machen und Ergebnis dieser Maßnahme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61e9c556-f2d0-4c36-a80a-ed09c5e7c543",
                                                "sense_id": "522cd918-0d50-3e4a-8630-84b02bbb1f3c",
                                                "text": "„Falls die Indigenen auch sie ausgerottet haben, hätten sie sich damit des einzigen großen Tiers beraubt, das sich zur Domestizierung geeignet hätte.“"
                                            }
                                        ],
