                "senses": [
                    {
                        "sense_id": "38d0752b-3270-3b2f-83a4-081030179aaa",
                        "entry_id": "cf9e1515-0639-3f91-87be-afd128a359ad",
                        "glosses": [
                            "Sonnerie de trompette, en usage dans l’armée, pour avertir les cavaliers de seller les chevaux et de les monter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37ae3579-56c4-4857-b127-81fdb52b58bc",
                                "sense_id": "38d0752b-3270-3b2f-83a4-081030179aaa",
                                "text": "J’ai ordonné à Louis Winkelbrand, le lieutenant de de Bracy, de faire sonner le boute-selle, de déployer sa bannière et de se rendre immédiatement au château de Front-de-Bœuf, …."
                            },
                            {
                                "example_id": "3af3e8b2-93dc-413a-bdd1-37e0b69141b6",
                                "sense_id": "38d0752b-3270-3b2f-83a4-081030179aaa",
                                "text": "Tout à coup les trompettes des Mousquetaires, des Chevau-légers et des Gens d’armes sonnèrent presque en même temps le boute-selle et à cheval."
                            },
                            {
                                "example_id": "1ef172c0-aadd-4fe8-a3bc-07aba2ca4321",
                                "sense_id": "38d0752b-3270-3b2f-83a4-081030179aaa",
                                "text": "…, et il aimerait mieux entendre, au point du jour, la trompette sonner le boute-selle pour monter à cheval, que la cloche tinter matines pour courir à l'église!"
                            },
                            {
                                "example_id": "47be77b4-6f97-4f7d-b17a-7b74ab004609",
                                "sense_id": "38d0752b-3270-3b2f-83a4-081030179aaa",
                                "text": "Le cavalier français, une fois le boute-selle sonné, ne recule pas et encore moins se laisse désarçonner."
                            },
                            {
                                "example_id": "a5556e1e-04c3-4986-9cba-364fbf8102f0",
                                "sense_id": "38d0752b-3270-3b2f-83a4-081030179aaa",
                                "text": "Il sauta sur une bicyclette, fila jusqu’au bourg d’Eguzon, réveilla la gendarmerie, mit tout le monde en branle, fit sonner le boute-selle et revint à Crozant à huit heures, suivi du brigadier et de six gendarmes."
                            }
                        ]
                    }
                ],
