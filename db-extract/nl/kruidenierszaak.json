                    {
                        "translation_id": "bda64490-0008-47b7-be61-d1b5b94b44cf",
                        "source_entry_id": "fb2a9a71-3d99-3782-9ce2-d6e4a8b58ff1",
                        "source_sense_id": "c8d91c85-1ca9-3731-b410-c898de405346",
                        "target_lang_word": "épicerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épicerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fa07e0c2-99b0-378f-b706-7eccee3faf2d",
                                        "entry_id": "e83b55d5-b682-3f13-b3bd-b9e1b1d92e8d",
                                        "glosses": [
                                            "Commerce des épices et d’un grand nombre de denrées de consommation courante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bbaf1b1-161e-402c-a896-451ea3a6240b",
                                                "sense_id": "fa07e0c2-99b0-378f-b706-7eccee3faf2d",
                                                "text": "Il se dirigea vers l’une des cahutes qu’il jugea devoir être une boutique d’épicerie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "058b3b7b-49fd-3da0-b269-152c76dccb20",
                                        "entry_id": "e83b55d5-b682-3f13-b3bd-b9e1b1d92e8d",
                                        "glosses": [
                                            "Magasin où se fait ce commerce."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bc232ff-7f6a-4355-819f-eea00fdbaff8",
                                                "sense_id": "058b3b7b-49fd-3da0-b269-152c76dccb20",
                                                "text": "Dans ma rue, il y a une boulangerie, une épicerie, une laverie, un traiteur chinois, un café-tabac, un hôtel de passe et une bouquinerie."
                                            },
                                            {
                                                "example_id": "ad26f1f5-fd62-4536-98a6-84fa5122d02f",
                                                "sense_id": "058b3b7b-49fd-3da0-b269-152c76dccb20",
                                                "text": "À la première épicerie venue nous achetâmes sur les conseils de Gaston une énorme boîte ovale de pilchards."
                                            },
                                            {
                                                "example_id": "d0b57ba7-9591-40cc-8406-f59dfef2b060",
                                                "sense_id": "058b3b7b-49fd-3da0-b269-152c76dccb20",
                                                "text": "À Loire-les-Marais, Frédéric Moinier fabrique des jonchées bio au lait thermisé et sur des joncs en synthétique, qu’il vend dans les épiceries et supérettes locales."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf438f0d-0029-3453-ae1a-8791abd31c50",
                                        "entry_id": "e83b55d5-b682-3f13-b3bd-b9e1b1d92e8d",
                                        "glosses": [
                                            "Toutes sortes d’épices, comme la cannelle, la muscade, le poivre, et aussi le sucre, le miel, le café et toutes les substances alimentaires qui venaient des pays éloignés."
                                        ],
                                        "tags": [
                                            "Autrefois"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bdefd15-02bd-4755-be41-66446c0745c5",
                                                "sense_id": "cf438f0d-0029-3453-ae1a-8791abd31c50",
                                                "text": "Il nous fallut encore une heure d’allées et venues avant de découvrir un abri. Néanmoins, nous finissons par trouver une petite échoppe d’épiceries qui renfermait deux jeunes filles à marier, et où l'on voulut bien nous permettre d'étendre nos hamacs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d09f490f-1b9b-39d0-839a-6a8bdd54b2d5",
                                        "entry_id": "e83b55d5-b682-3f13-b3bd-b9e1b1d92e8d",
                                        "glosses": [
                                            "Rayon d’une grande surface commerciale (supermarché, hypermarché) qui regroupe les produits alimentaires, condiments, conserves…"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3578e5aa-e5e1-49cb-9ae5-c764f0c82f9b",
                                                "sense_id": "d09f490f-1b9b-39d0-839a-6a8bdd54b2d5",
                                                "text": "Vous trouverez les conserves de poisson au rayon épicerie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31c144c8-6ed8-32df-9eda-5eec35618cd3",
                                        "entry_id": "e83b55d5-b682-3f13-b3bd-b9e1b1d92e8d",
                                        "glosses": [
                                            "Supermarché ou marché."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "caa7d8a9-2aac-4568-9cfe-a38d0dc25435",
                                                "sense_id": "31c144c8-6ed8-32df-9eda-5eec35618cd3",
                                                "text": "[…] à force de vouloir plaire à tout le monde, le projet d’entente de nos négociateurs a transformé en liste d’épicerie ce qui aurait dû être une proposition haute, faisant appel à la générosité et à l’audace au lieu de titiller la cupidité et la peur."
                                            },
                                            {
                                                "example_id": "e786d68a-3fd8-4115-86b8-8585264f6194",
                                                "sense_id": "31c144c8-6ed8-32df-9eda-5eec35618cd3",
                                                "text": "Un homme dans la soixantaine a été transporté d’urgence à l’hôpital après avoir été blessé au cours d’un vol qualifié survenu lundi soir dans une épicerie de quartier à Shawinigan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
