                        ],
                        "form": "die Umkehr"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c85aa3c1-9d9b-335b-ac08-9d4be88f06e6",
                        "entry_id": "bde80f50-7241-3c22-a913-4413a8bf2286",
                        "glosses": [
                            "Bewegung in diejenige Richtung, aus der man gekommen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f3a0a81-4252-443d-a913-d7d183ff7ac6",
                                "sense_id": "c85aa3c1-9d9b-335b-ac08-9d4be88f06e6",
                                "text": "Als es auf dem Weg zum Park auf einmal heftig zu regnen begann, entschlossen sie sich zur Umkehr."
                            },
                            {
                                "example_id": "cbc2343e-2e38-4656-ad6c-12e89d220e98",
                                "sense_id": "c85aa3c1-9d9b-335b-ac08-9d4be88f06e6",
                                "text": "Das Flugzeug war aufgrund eines defekten Triebwerkes zur Umkehr gezwungen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e947534b-db1b-3c54-bf63-1354d01e5bf8",
                        "entry_id": "bde80f50-7241-3c22-a913-4413a8bf2286",
                        "glosses": [
                            "Änderung der eigenen Einstellung/Meinung/Überzeugung zum Besseren hin"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "492dcd5b-c000-4d75-8a5b-aba00807d820",
                                "sense_id": "e947534b-db1b-3c54-bf63-1354d01e5bf8",
                                "text": "„Eine vorwiegend auf Abschreckung setzende Politik war nicht erfolgreich und wirtschaftlicher Druck und die Verschärfung von Sanktionen haben Russland nicht zur Umkehr bewegen können.“"
                            },
                            {
                                "example_id": "6f4ebd5b-b60c-4761-8a14-a0fa6ea976ab",
                                "sense_id": "e947534b-db1b-3c54-bf63-1354d01e5bf8",
                                "text": "„Ohne Umkehr ist die Partei auf einem verfassungsfeindlichen Kurs.“"
                            },
                            {
                                "example_id": "8982fa69-0a49-4a59-af17-f62923aee973",
                                "sense_id": "e947534b-db1b-3c54-bf63-1354d01e5bf8",
                                "text": "„Es ist erschreckend, dass selbst die Not, die über Afghanistan hereingebrochen ist, die Taliban nicht zur Umkehr veranlasst.“"
                            },
                            {
                                "example_id": "9068fc98-11f9-44b8-aae9-723bced3c00d",
                                "sense_id": "e947534b-db1b-3c54-bf63-1354d01e5bf8",
                                "text": "„Der Weg der Kirche sei jedoch ein anderer, nämlich der des Gebets, der Buße und der Umkehr, sei ihm gesagt worden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
