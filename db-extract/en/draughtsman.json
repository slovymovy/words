                ],
                "senses": [
                    {
                        "sense_id": "2eda32e2-13ac-3a0e-af08-58674f040ebe",
                        "entry_id": "481daf45-0de1-3c0b-9408-326967e3c726",
                        "glosses": [
                            "A person skilled at drawing engineering or architectural plans."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "547131bd-78ec-4f5b-b9b2-08d768740916",
                                "sense_id": "2eda32e2-13ac-3a0e-af08-58674f040ebe",
                                "text": "It was after the building and successful trials of the \"Lord Nelson\" engine on the Southern Railway that Sir Henry Fowler, then C.M.E. of the L.M.S.R., sent his chief draughtsman, Herbert Chambers, to Waterloo with the proposed weight diagram of a new 4-6-0 engine (to be known as a \"Royal Scot\" class), and to discuss the proposal with Mr. Clayton."
                            }
                        ]
                    },
                    {
                        "sense_id": "09db1aea-7d05-3373-994d-58c02fd6bb3e",
                        "entry_id": "481daf45-0de1-3c0b-9408-326967e3c726",
                        "glosses": [
                            "A book illustrator."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "dbd77010-672f-31bc-b734-70316fdf407c",
                        "entry_id": "481daf45-0de1-3c0b-9408-326967e3c726",
                        "glosses": [
                            "One who drinks drams; a tippler."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "68c63984-9763-4244-8d48-985c9a56c150",
                                "sense_id": "dbd77010-672f-31bc-b734-70316fdf407c",
                                "text": "I have used my interest in several wards of the city , that the wholesome restorative above - mentioned may be given in tavern - kitchens to all the morning's draughtsmen within"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cef368e1-325b-46be-b1de-18241e071fae",
                        "source_entry_id": "481daf45-0de1-3c0b-9408-326967e3c726",
                        "source_sense_description": "person skilled at drawing engineering or architectural plans",
                        "target_lang_word": "dessinateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dessinateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "95bf5081-e50f-3f53-b3d4-0983c1b1e2a3",
                                        "entry_id": "edfaa9b8-13f5-3b27-8368-3245aa5090aa",
                                        "glosses": [
                                            "Celui dont la profession est de dessiner toute sorte de dessins : plan, BD, …"
                                        ],
                                        "tags": [
                                            "Dessin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3afec506-38cf-4463-a0e1-1a9e85885358",
                                                "sense_id": "95bf5081-e50f-3f53-b3d4-0983c1b1e2a3",
                                                "text": "Les obsèques de Jean-Jacques Sempé, dessinateur d’humour pessacais décédé à 89 ans, ont eu lieu à l’église Saint-Germain-des-Prés à Paris, hier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a92035da-2bcd-3cb6-ade4-c8280750b3a5",
                                        "entry_id": "edfaa9b8-13f5-3b27-8368-3245aa5090aa",
                                        "glosses": [
                                            "Peintre qui sait rendre avec justesse les formes, le contour des figures."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e140752c-c11d-4a1f-8383-6ac8685a1c65",
                                                "sense_id": "a92035da-2bcd-3cb6-ade4-c8280750b3a5",
                                                "text": "Ce peintre est bon coloriste, mais il n’est pas dessinateur."
                                            },
                                            {
                                                "example_id": "7fb18443-4915-4929-87f7-7bb5afdf5dd3",
                                                "sense_id": "a92035da-2bcd-3cb6-ade4-c8280750b3a5",
                                                "text": "Ingres était un grand dessinateur."
                                            },
                                            {
                                                "example_id": "01cabc33-219a-4e88-8fc3-3740be8ec1ba",
                                                "sense_id": "a92035da-2bcd-3cb6-ade4-c8280750b3a5",
                                                "text": "A défaut de passion, on trouvait dans ses toiles un archéologue savant et un dessinateur consommé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
