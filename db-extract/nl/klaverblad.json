                                    },
                                    {
                                        "sense_id": "057171c4-bbb3-320a-a220-1548e4c39bcd",
                                        "entry_id": "2846dac5-0212-3fbf-88be-8fcd72b0e85e",
                                        "glosses": [
                                            "(with plural cloverleafs or cloverleaves) Ellipsis of cloverleaf interchange."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a71b2f6-14c5-438e-80be-ba6b9267ef64",
                                                "sense_id": "057171c4-bbb3-320a-a220-1548e4c39bcd",
                                                "text": "By the time we got into Tulsa Town\nWe had eighty-five trucks in all\nBut there's a roadblock up on the cloverleaf\nAnd them bears was wall-to-wall."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cloverleaf",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2ab6912-0646-3883-9188-942e78b86528",
                                        "entry_id": "5d6a88fa-ab9c-378d-8e64-48ffb98fcd80",
                                        "glosses": [
                                            "To turn by following a cloverleaf, or as if by following one."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b009a37-8f62-4a95-a306-02f4d8ecc237",
                                                "sense_id": "f2ab6912-0646-3883-9188-942e78b86528",
                                                "text": "Hay told a military historian that Allen precipitated “the debacle” by “allowing his lead company to pursue the VC down the trail” instead of forming a perimeter and cloverleafing at the first sign of the enemy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b85d4b5-232d-431a-ac59-baf7e32f6f13",
