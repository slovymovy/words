                                                "sense_id": "c87808b7-ba0e-372e-a83f-00d811f7d52f",
                                                "text": "Ostatnio pewien haker włamał mi się do komputera."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "b1427ff9-9d9f-321b-bab5-46f251580823",
                                        "entry_id": "50c54c14-176a-30fe-8339-b226c82a7315",
                                        "glosses": [
                                            "osoba o bardzo dużych, praktycznych umiejętnościach informatycznych (lub elektronicznych), która identyfikuje się ze społecznością hakerską"
                                        ],
                                        "tags": [
