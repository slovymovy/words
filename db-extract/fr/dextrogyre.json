        "fr-extract.jsonl": [
            {
                "entry_id": "877961fc-c2b1-32cc-83d6-19c5b21e3375",
                "word": "dextrogyre",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7e5a41fe-db4a-43f0-975d-79ce6a6b0ea6",
                        "entry_id": "877961fc-c2b1-32cc-83d6-19c5b21e3375",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "dextrogyres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1482ca1e-1ddf-30d9-9bd2-bf5e4af06345",
                        "entry_id": "877961fc-c2b1-32cc-83d6-19c5b21e3375",
                        "glosses": [
                            "Qui tourne, qui incline vers la droite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db4b175d-09d8-4cef-ad9b-3607c0ecb6d8",
                                "sense_id": "1482ca1e-1ddf-30d9-9bd2-bf5e4af06345",
                                "text": "Habiles métallurgistes, les Tlingits travaillaient le cuivre, et même parfois le fer qu’ils récupéraient, bien avant l’arrivée des navires européens, sur des épaves chinoises et japonaises portées par les courants dextrogyres du Pacifique Nord."
                            },
                            {
                                "example_id": "4fdffe13-690c-475b-bf29-165c016fbf48",
                                "sense_id": "1482ca1e-1ddf-30d9-9bd2-bf5e4af06345",
                                "text": "Deux équipes de recherche indépendantes ont élaboré et publié des modèles de l’ADN incompatibles avec le modèle de double hélice dextrogyre de Watson-Crick."
                            },
                            {
                                "example_id": "4fc2eaee-16e5-4abe-a3e6-1d539b8447e0",
                                "sense_id": "1482ca1e-1ddf-30d9-9bd2-bf5e4af06345",
                                "text": "On admire ses convictions politiques, fortement centripètes, surtout lorsque le centre apparaît dextrogyre."
                            },
                            {
                                "example_id": "ad922c83-6db0-42d3-8c13-a0b3afbdff2f",
                                "sense_id": "1482ca1e-1ddf-30d9-9bd2-bf5e4af06345",
                                "text": "Physiologiquement et cliniquement, il y a deux hémi-oculomoteurs rotateurs des deux yeux, l’un à droite (dextrogyre), l’autre à gauche (lævogyre)."
                            }
                        ]
                    },
                    {
                        "sense_id": "4cf1247b-336e-31b9-a10b-f012acd831c2",
                        "entry_id": "877961fc-c2b1-32cc-83d6-19c5b21e3375",
                        "glosses": [
                            "Qualifie une écriture dont les traits vont vers la droite."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "e04dce4a-dd17-4447-88a7-79857854fcf7",
                                "sense_id": "4cf1247b-336e-31b9-a10b-f012acd831c2",
                                "text": "Poursuivant une remarque rapide de M. Delamain [1950], il distingue entre des graphies sinistrogyres et dextrogyres, celles-ci pouvant être petites, moyennes ou grandes ; certains manuscrits sont d’une écriture intermédiaire, plus ou moins dextrogyre."
                            }
                        ]
                    },
                    {
                        "sense_id": "d897008d-2669-393b-b443-656d94d20f2a",
                        "entry_id": "877961fc-c2b1-32cc-83d6-19c5b21e3375",
                        "glosses": [
                            "Qualifie toute substance chimique et spécialement d’un stéréo-isomère faisant tourner vers la droite le plan de polarisation de la lumière."
                        ],
                        "tags": [
                            "Stéréochimie"
                        ],
                        "examples": [
                            {
                                "example_id": "11975601-e78c-40a8-a726-4db3157c5188",
                                "sense_id": "d897008d-2669-393b-b443-656d94d20f2a",
                                "text": "Il a trouvé aussi qu’il existe deux espèces différentes de quartz, dont l’une dévie le plan de polarisation à droite et l’autre le tourne dans le sens opposé, et il nomme la première espèce quartz dextrogyre et la seconde quartz lévogyre."
                            },
                            {
                                "example_id": "c6233bac-d4ca-453f-bbcc-a9ddf2f26902",
                                "sense_id": "d897008d-2669-393b-b443-656d94d20f2a",
                                "text": "Le sucre que fournit le tannin de la noix de galle par l’action de l’acide sulfurique moyennement concentré et d’une température convenable est un glucose dextrogyre, ayant exactement le même pouvoir rotatoire que le glucose d’amidon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3286f4fb-ca29-4910-96ed-518518975346",
                        "source_entry_id": "877961fc-c2b1-32cc-83d6-19c5b21e3375",
                        "source_sense_description": "(1)",
                        "target_lang_word": "clockwise",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clockwise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eea3c4ae-1ccc-3818-b12d-6c648bd92be5",
                                        "entry_id": "5b0d02ee-43a0-3caa-8160-a8387128a08c",
                                        "glosses": [
                                            "In a curve or twist corresponding to the movement of the hands of a clock."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "671bac64-3e84-4c03-b63e-a20c9bfce38a",
                                                "sense_id": "eea3c4ae-1ccc-3818-b12d-6c648bd92be5",
                                                "text": "Turn the handle clockwise to open it."
                                            },
                                            {
                                                "example_id": "9f76374f-4f90-413b-a1d6-07bd19c1434a",
                                                "sense_id": "eea3c4ae-1ccc-3818-b12d-6c648bd92be5",
                                                "text": "The main — or cooking — kitchen is an inhumanly immaculate expanse of burner rings and countertops where, according to tradition, the stations move clockwise from canapé to entremetier."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "clockwise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e6b2d0b0-4780-3e06-af64-e5d2e6e867ee",
                                        "entry_id": "4c7fae04-0ecb-39e2-900b-431025850236",
                                        "glosses": [
                                            "Moving clockwise; having rotary motion in the manner of a clock."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20d6dd7c-cabc-4779-962e-42483a178d52",
                                                "sense_id": "e6b2d0b0-4780-3e06-af64-e5d2e6e867ee",
                                                "text": "In the southern hemisphere the flow of air around a low-pressure system is clockwise."
                                            },
                                            {
                                                "example_id": "b0ccfaa1-29b0-40b0-8749-7e7d161b17e8",
                                                "sense_id": "e6b2d0b0-4780-3e06-af64-e5d2e6e867ee",
                                                "text": "The clockwise beating of cilia results in a net flow of extraembryonic fluid leftwards […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
