                "senses": [
                    {
                        "sense_id": "98e6377a-06f1-3b42-aeeb-73b7de39c4a1",
                        "entry_id": "e10d80c2-155e-3f81-9706-d6f4e3b214b2",
                        "glosses": [
                            "Donner un caractère kanak à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75575576-cdb3-41d9-ba62-fd122f8a1b86",
                                "sense_id": "98e6377a-06f1-3b42-aeeb-73b7de39c4a1",
                                "text": "Ne peut-on pas simplement dire que Jean-Marie Tjibaou ne fait d'une certaine façon que « kanakiser » les notions, c’est-à-dire adopter un point de vue endogène sur des notions trop souvent présentées uniquement d’un point de vue exogène et européo-centré ?"
                            },
                            {
                                "example_id": "b19f2de7-b805-4c03-8f46-8c4c4702d1ca",
                                "sense_id": "98e6377a-06f1-3b42-aeeb-73b7de39c4a1",
                                "text": "A quand le quartier Kanak dans le centre ville pour kanakiser un peu plus la ville."
                            },
                            {
                                "example_id": "89c09e69-d8bc-4177-a1f4-ec33163c6d78",
                                "sense_id": "98e6377a-06f1-3b42-aeeb-73b7de39c4a1",
                                "text": "Vouloir absolument la « kanakiser », c'est juste idiot."
                            }
                        ]
                    }
