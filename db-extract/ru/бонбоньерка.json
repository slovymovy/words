                                                "example_id": "24326e2d-b7f2-4eff-ae2e-d7d375502a5a",
                                                "sense_id": "a799b9aa-78b8-3dca-916c-40690e0f05fd",
                                                "text": "„Zorilla entdeckte meine Bonbonniere; sie nahm zwei Pralinen und reichte die Schachtel ihrer Schwester.“"
                                            }
