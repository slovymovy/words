                        "sense_id": "4b489df4-8a09-3325-a1c3-19d88477cb49",
                        "entry_id": "e3043e95-e881-3d6c-a4dc-c0aa036c1bcb",
                        "glosses": [
                            "een vriendelijke toenadering"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b62bbd7-775f-4986-b9ca-7c903a5a46c3",
                                "sense_id": "4b489df4-8a09-3325-a1c3-19d88477cb49",
                                "text": "Heracles liet na de vrijerij van New York City weten Pelupessy niet te willen laten gaan. De captain is een belangrijke speler op het veld en in de kleedkamer. Hij is een verbinder, een jongen die voorop gaat in de strijd en sociaal is."
                            },
                            {
                                "example_id": "f026fa24-8e42-4e86-96da-d6d8f046bed6",
                                "sense_id": "4b489df4-8a09-3325-a1c3-19d88477cb49",
                                "text": "Geruchten over een samenzwering tussen team-Trump en het Kremlin zwollen toch al aan sinds Trumps verbale vrijerij met Poetin in Helsinki."
                            }
                        ]
                    }
