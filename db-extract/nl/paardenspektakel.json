                            {
                                "example_id": "c3ca882f-821a-4e64-be6c-4cf3dd0e5566",
                                "sense_id": "1e43cefd-fbfe-3e89-b5b7-b6155f67dee5",
                                "text": "De Britse koningin Elizabeth heeft gisteravond de Royal Windsor Horse Show bijgewoond. Het jaarlijkse paardenspektakel stond geheel in het teken van het zeventigste regeringsjaar van de koningin en geldt als de officiële aftrap van haar Jubilee-vieringen."
                            },
                            {
                                "example_id": "8d3a5a86-cddd-4787-b65a-ca88ce6a6023",
                                "sense_id": "1e43cefd-fbfe-3e89-b5b7-b6155f67dee5",
                                "text": "Teleurstellend nieuws voor de liefhebbers van de ruitersport. De Almelose Ruiterdagen gaan dit jaar niet door. Zoals zoveel evenementen sneuvelt het paardenspektakel door de coronacrisis."
                            }
                        ]
