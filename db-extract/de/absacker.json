                                "target_senses": [
                                    {
                                        "sense_id": "56f472ec-d789-3a60-9f9b-1ab969b4e377",
                                        "entry_id": "32a8f1d9-056c-3396-932f-7c82dbc04b4b",
                                        "glosses": [
                                            "Abréviation de pousse-pousse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e545dd82-6520-441b-bed5-469048127c50",
                                                "sense_id": "56f472ec-d789-3a60-9f9b-1ab969b4e377",
                                                "text": "Des pousses attendaient sur le quai, mais l’anxiété de Kyo était trop grande pour qu’il pût rester immobile."
                                            },
                                            {
