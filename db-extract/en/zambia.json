                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb137651-3899-4f9f-9a93-dbacd050932a",
                                                "sense_id": "0708791e-abd7-3e07-bb4e-b37d0f295c78",
                                                "text": "Sambia liegt auf einem über tausend Meter hohen Plateau, das von tiefen Tälern und Senken umgeben ist."
                                            },
                                            {
                                                "example_id": "bcc4a24e-8233-4e2e-be13-e7f7eb918c40",
                                                "sense_id": "0708791e-abd7-3e07-bb4e-b37d0f295c78",
                                                "text": "Das Sambia von heute mag Theo einfach nicht mehr."
                                            },
                                            {
                                                "example_id": "7b4053c3-6d9c-4af4-993f-9362f758ced3",
                                                "sense_id": "0708791e-abd7-3e07-bb4e-b37d0f295c78",
                                                "text": "Lusaka ist die Hauptstadt von Sambia."
                                            },
                                            {
                                                "example_id": "12795d59-8d52-435b-b9a6-1d14dc858f98",
                                                "sense_id": "0708791e-abd7-3e07-bb4e-b37d0f295c78",
                                                "text": "„Als selbst Sambias Präsident Kaunda seinen Freund Nkomo aufforderte, nach Rhodesien zurückzukehren, blieb diesem nichts anderes übrig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
