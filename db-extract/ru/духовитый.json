                ],
                "senses": [
                    {
                        "sense_id": "8a5ec5b0-fed6-3089-b20b-508a08f4dffd",
                        "entry_id": "04d4fdba-04e3-3d4d-bdc6-55c5d07dab08",
                        "glosses": [
                            "разг. пахучий, душистый, ароматичный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75aeed10-7038-491c-b70a-23c002feecb8",
                                "sense_id": "8a5ec5b0-fed6-3089-b20b-508a08f4dffd",
                                "text": "Пахнет духовитым дымом от свежих дров, навозом."
                            },
                            {
                                "example_id": "129a8bfb-1336-4a75-986f-a5aaf062bf30",
                                "sense_id": "8a5ec5b0-fed6-3089-b20b-508a08f4dffd",
                                "text": "Тихо скрипели колеса. Пахло дёгтем и свежим духовитым сеном."
                            },
                            {
                                "example_id": "61d70cfa-10c4-47ab-998f-ce002600b976",
                                "sense_id": "8a5ec5b0-fed6-3089-b20b-508a08f4dffd",
                                "text": "Говорят со мной коровы // На кивливом языке. // Духовитые дубровы // Кличут ветками к реке."
                            }
                        ]
                    }
                ],
