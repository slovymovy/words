                "senses": [
                    {
                        "sense_id": "a719d271-3a3a-3b33-8095-cbaeb06bb330",
                        "entry_id": "d5b0043b-a669-3728-ba25-2922632838d4",
                        "glosses": [
                            "имя, которым какой-либо народ, народность, племя и т. п. называет сам себя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf897a49-c420-48f9-a054-64606d8921be",
                                "sense_id": "a719d271-3a3a-3b33-8095-cbaeb06bb330",
                                "text": "Эвенки — самоназвание тунгусов."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0bbabd71-d2ca-464f-b66c-fc949f09a0b5",
                        "source_entry_id": "d5b0043b-a669-3728-ba25-2922632838d4",
                        "source_sense_id": "a719d271-3a3a-3b33-8095-cbaeb06bb330",
                        "target_lang_word": "autonym",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autonym",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3ef30e2-445b-3d72-9c23-19e426ae416a",
                                        "entry_id": "746c3c63-d63a-3b09-a5c9-118902896a99",
                                        "glosses": [
                                            "An infraspecific name in which the specific epithet is repeated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93170248-ae91-4ebc-ac38-e8420177f5a3",
                                                "sense_id": "e3ef30e2-445b-3d72-9c23-19e426ae416a",
                                                "text": "Near-synonym: type variety"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b65f99a-9358-382e-8d86-df06c4f44183",
                                        "entry_id": "746c3c63-d63a-3b09-a5c9-118902896a99",
                                        "glosses": [
                                            "A name used by a group or category of people to refer to themselves or their language, as opposed to a name given to them by other groups."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b58ebfc-37d4-45ec-aae4-196c5f843e64",
                                                "sense_id": "5b65f99a-9358-382e-8d86-df06c4f44183",
                                                "text": "Deutsche is the autonym of the people known in English as Germans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ae229fd-fd04-3f99-9dff-cf0efc4b1bca",
                                        "entry_id": "746c3c63-d63a-3b09-a5c9-118902896a99",
                                        "glosses": [
                                            "The true name of a person or other entity, especially an author."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f34abb77-74a5-49ba-9a3b-b0bf74a81621",
                                                "sense_id": "2ae229fd-fd04-3f99-9dff-cf0efc4b1bca",
                                                "text": "As a general principle, the heading of the main entry of the book should be in the form in which the book itself is published; that is, if it is published under an autonym let the autonym be given, if under a pseudonym, then let the pseudonym be given, and if the book be anonymous, then let the fact be stated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "364203d8-f67a-37c6-8d3c-0519959f1ec0",
                                        "entry_id": "746c3c63-d63a-3b09-a5c9-118902896a99",
                                        "glosses": [
                                            "A work published under the author's true name."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "edf8b94b-d0be-4293-8ddb-eacb473f2af1",
                        "source_entry_id": "d5b0043b-a669-3728-ba25-2922632838d4",
                        "source_sense_id": "a719d271-3a3a-3b33-8095-cbaeb06bb330",
                        "target_lang_word": "endonym",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "endonym",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0f3ba29-16fb-3ac0-b269-02bd003f8f9e",
                                        "entry_id": "e8b9dd9d-0132-3b32-a75f-f40cb7d3f151",
                                        "glosses": [
                                            "A name used by a group or category of people (an ingroup) to refer to themselves or their language, as opposed to a name given to them by other groups (outgroups)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ced3cab6-bdb5-4ba2-bf74-59506d507587",
                                                "sense_id": "a0f3ba29-16fb-3ac0-b269-02bd003f8f9e",
                                                "text": "The endonym is the basic toponymic exemplar and as such it needs to be understood properly. To do so we need to appreciate the context of space and place that produces it. Most endonyms arise from the elemental human relationship with space and place, and possess an intrinsic and enduring value which cannot normally be either bestowed or removed by political arbitrariness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
