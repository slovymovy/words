                                "target_senses": [
                                    {
                                        "sense_id": "84c73e30-4b02-3112-8b18-dbc334030299",
                                        "entry_id": "c769d070-2021-3d6a-83b6-6c41497663b4",
                                        "glosses": [
                                            "Relatif à l’arminianisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1c74f3f-9829-40b9-a34e-8483678835f4",
                                                "sense_id": "84c73e30-4b02-3112-8b18-dbc334030299",
                                                "text": "Une alliance du dogme arminien avec le mysticisme anabaptiste et le sentiment calviniste."
                                            },
                                            {
                                                "example_id": "ad91f03d-59ab-47ff-99ad-69c67987ea9b",
                                                "sense_id": "84c73e30-4b02-3112-8b18-dbc334030299",
                                                "text": "Le contact avec la pensée arminienne, par l’intermédiaire de Jean Le Clerc, fut pour Toland un élément important dans son évolution intellectuelle vers un christianisme raisonnable, qui le conduisit dès 1696 à proposer sa définition d’un christianisme sans mystères."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "arminien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3a40db2b-7396-3f58-90b6-ce8c59bda285",
                                        "entry_id": "4db7ee6a-1ba6-3f8d-8c89-0982a2188dc5",
                                        "glosses": [
                                            "Celui qui suit la doctrine de l'arminianisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3282d2c-8f9d-49fe-a0eb-1c15c8021fca",
                                                "sense_id": "3a40db2b-7396-3f58-90b6-ce8c59bda285",
                                                "text": "L'arminianisme évangélique est fondé sur les cinq points des Remontrants. Un arminien évangélique est quelqu’un qui croit que Dieu, en Christ, étend son amour à tous les hommes et que chacun est responsable personnellement de son attitude par rapport à cet amour."
                                            },
                                            {
                                                "example_id": "faa4ca5e-3b05-480f-bb4f-f050d3460517",
                                                "sense_id": "3a40db2b-7396-3f58-90b6-ce8c59bda285",
                                                "text": "L’arminien qui a cherché à examiner les dogmes du christianisme a donc rapproché insensiblement ces dogmes des idées que la raison nous fournit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
