                        "entry_id": "7c746eae-bfba-39ce-a190-57a563bf7e3f",
                        "glosses": [
                            "Fundstelle des Rohstoffes Erdöl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72674e16-3483-4889-ac6c-0283fa0d32ce",
                                "sense_id": "b1ad7754-0b68-3f70-82f5-be5023a61d09",
                                "text": "„Unter den Ozeanböden werden große Öl- und Gasvorkommen vermutet, zudem sind die Gewässer sehr fischreich.“"
                            },
                            {
                                "example_id": "3e820d9d-9978-4d94-a29f-289c5a3d6854",
                                "sense_id": "b1ad7754-0b68-3f70-82f5-be5023a61d09",
                                "text": "„Nigeria wollte nicht akzeptieren, dass Biafra sich mit den reichen Ölvorkommen einfach so absetzte, weshalb es zu einem Bürgerkrieg kam, in dem die Lage für den neuen Staat immer prekärer wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
