                        "examples": [
                            {
                                "example_id": "9fdf50d6-761e-4efc-8828-f84d1abaa5c7",
                                "sense_id": "86786178-3f16-3224-b941-8562263ba9c1",
                                "text": "Ses grosses lunettes en écaille lui font des yeux de machote et, dès les premiers mots, on devine qu’il a du mal à empêcher son dentier de gansailler."
                            },
                            {
                                "example_id": "4cfda09f-9344-4773-b722-0c6cf4f8b29b",
                                "sense_id": "86786178-3f16-3224-b941-8562263ba9c1",
                                "text": "Mon Pierrot, décontracté, lui donne une réponse complètement farfelue en provençal… l’étranger ouvre des yeux comme une machote, dit thank-you et s’en va."
                            }
                        ]
                    }
