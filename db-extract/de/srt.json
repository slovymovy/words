                                            {
                                                "example_id": "8b45705d-5e70-43f3-b277-6666edf29fc8",
                                                "sense_id": "8966e4b6-e70e-3be9-b772-df48f69b56b7",
                                                "text": "These observations lead us to predict that structural genomic variants are as important as SNPs, short tandem repeats (STRs) and other small changes in their contribution to genome variation."
                                            },
                                            {
                                                "example_id": "ec48d6bf-20c0-4da8-90ab-31d6c3121094",
                                                "sense_id": "8966e4b6-e70e-3be9-b772-df48f69b56b7",
                                                "text": "We estimated that the following percentage of elements were correctly assembled: 95.4% of alpha satellites; 91.5% of human satellites 2 and 3; 97.7% of segmental duplications (SDs); 94.3% of variable number tandem repeats (VNTRs); 94.2% of short tandem repeats (STRs); and 98.8% of all human repeats²⁶."
                                            }
                                        ]
                                    },
