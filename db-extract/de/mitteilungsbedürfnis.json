                "senses": [
                    {
                        "sense_id": "6ca6d6d1-0cd0-3646-87c6-638b334ad5b0",
                        "entry_id": "e235863e-7428-30ff-bc34-dc836a074d36",
                        "glosses": [
                            "Wunsch/Verlangen, anderen sich oder etwas mitzuteilen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82fe3138-adff-409a-bbe4-ad25fb75f4b8",
                                "sense_id": "6ca6d6d1-0cd0-3646-87c6-638b334ad5b0",
                                "text": "„Sein Mitteilungsbedürfnis befeuchtete seine Kehle, aktivierte seine Speicheldrüsen.“"
                            },
                            {
                                "example_id": "c3c92d8a-424c-4702-b22b-f6f25428c27f",
                                "sense_id": "6ca6d6d1-0cd0-3646-87c6-638b334ad5b0",
                                "text": "„Wenn Nikolai später an diesen Ausbruch unbegründeten und unerklärlichen Mitteilungsbedürfnisses, der doch so wichtige Folgen für ihn haben sollte, zurückdachte, so kam es ihm vor, – wie es einem in solchen Fällen ja immer vorkommt, als hätte es sich da nur um eine törichte Augenblickslaune gehandelt; und dabei hatte doch dieser Ausbruch vertrauensseligen Mitteilungsbedürfnisses im Verein mit einigen anderen an sich unbedeutenden Geschehnissen für ihn und seine ganze Familie Folgen von ungeheurer Tragweite.“"
                            },
                            {
                                "example_id": "da1875d8-3ba9-4910-a498-b598102a5257",
                                "sense_id": "6ca6d6d1-0cd0-3646-87c6-638b334ad5b0",
                                "text": "„Lachmann zögerte einen Augenblick, dann siegte sein Mitteilungsbedürfnis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
