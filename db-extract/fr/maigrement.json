        "fr-extract.jsonl": [
            {
                "entry_id": "3b2313f6-0c2a-331e-b99f-59be7fb2e8c3",
                "word": "maigrement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7544efd4-b127-35a3-9c90-f94c55204ccf",
                        "entry_id": "3b2313f6-0c2a-331e-b99f-59be7fb2e8c3",
                        "glosses": [
                            "D’une manière maigre ; fort peu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c85d110-7ccb-4ddd-8ab6-1e9b619eb1a3",
                                "sense_id": "7544efd4-b127-35a3-9c90-f94c55204ccf",
                                "text": "On avait cueilli autour de l'église et dans le cimetière. Maigrement fruités les arbres donnèrent moins d'une demi-hottée chacun ; mais quelle graine ! Nourrie du suc des Trépassés, ronde comme une prunelle."
                            },
                            {
                                "example_id": "602e8c80-3ace-4118-babf-44b1adcfc9e8",
                                "sense_id": "7544efd4-b127-35a3-9c90-f94c55204ccf",
                                "text": "Et à son avis, si Catilina l’eût voulu loué, il ne l’eût pas loué plus maigrement."
                            },
                            {
                                "example_id": "f96bad34-9996-4c76-b7b9-17d229844deb",
                                "sense_id": "7544efd4-b127-35a3-9c90-f94c55204ccf",
                                "text": "Cet écrivain avait choisi un beau sujet, mais il l’a traité trop maigrement."
                            },
                            {
                                "example_id": "cc16a4d0-15f1-4fe6-b504-7170aa0b1a38",
                                "sense_id": "7544efd4-b127-35a3-9c90-f94c55204ccf",
                                "text": "Il nous a traités fort maigrement. - Il a de quoi vivre, mais maigrement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c821b4f-898e-4e61-b55f-4997933db40d",
                        "source_entry_id": "3b2313f6-0c2a-331e-b99f-59be7fb2e8c3",
