                        "entry_id": "b917e44e-8971-38ab-ba4c-49b0ff04e891",
                        "glosses": [
                            "A metal link with a gate that can open and close, generally used for clipping ropes to anchors or other objects."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d726f3c4-e70b-48ff-b8c4-1fdbb31b8165",
                                "sense_id": "4ad682c7-1268-3257-9458-9e94a6dd9cc2",
                                "text": "A carrabeener (metal clasp used in rock climbing) inside the pipes was devised as a release out, a tactic lent to them by Greenpeace."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00e99e5a-1d41-465c-b597-0612ed1ad757",
