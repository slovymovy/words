                "entry_id": "55492433-3ed4-3503-b157-433aea4b58e3",
                "word": "AfD",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f4accc21-b474-3723-90fd-069301ccde95",
                        "entry_id": "55492433-3ed4-3503-b157-433aea4b58e3",
                        "glosses": [
                            "Alternative for Germany (Alternative für Deutschland), a right-wing German political party."
                        ],
                        "tags": [
                            "German"
                        ],
                        "examples": [
                            {
                                "example_id": "abeb3300-1999-4245-a63b-cf7fcf3b7f74",
                                "sense_id": "f4accc21-b474-3723-90fd-069301ccde95",
                                "text": "The country’s mainstream conservatives, as polls predicted, won the largest share of votes in Sunday’s election according to official preliminary results and will be looking to form the next government, while the AfD came in second."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3193327f-8a47-4f27-bdd3-92fcec321c0a",
                        "source_entry_id": "55492433-3ed4-3503-b157-433aea4b58e3",
                        "source_sense_id": "f4accc21-b474-3723-90fd-069301ccde95",
                        "source_sense_description": "Alternative für Deutschland",
                        "target_lang_word": "AfD",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "AfD",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f80a5455-3d13-38e1-93f6-43c63f52c809",
                                        "entry_id": "4b05d2b9-59be-3deb-b7cf-13b67b80ab1a",
                                        "glosses": [
                                            "Abkürzung von Alternative für Deutschland, eine 2013 gegründete Partei rechts von der Mitte"
                                        ],
                                        "tags": [
                                            "Germany"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "855f7d78-3b3f-4962-876c-cc838f4a593c",
                                                "sense_id": "f80a5455-3d13-38e1-93f6-43c63f52c809",
                                                "text": "Die AfD wurde am 6. Februar 2013 gegründet."
                                            },
                                            {
                                                "example_id": "fdcd1cb1-8e82-4570-b62b-f563945c4104",
                                                "sense_id": "f80a5455-3d13-38e1-93f6-43c63f52c809",
                                                "text": "„Von diesem Widerspruch profitiert nun die AfD.“"
                                            },
                                            {
                                                "example_id": "f609081e-e84b-4f6e-815b-46007eeb9976",
                                                "sense_id": "f80a5455-3d13-38e1-93f6-43c63f52c809",
                                                "text": "„Nur weil ich keine Angst vor den Konsequenzen habe wie so viele, die lieber kuschen, als unbequeme Wahrheiten auszusprechen, lasse ich mich nicht von Bewegungen wie Pegida oder Parteien wie der AfD vereinnahmen.“"
                                            },
                                            {
                                                "example_id": "24f32d80-b232-42b5-9a4b-67ce2d2011b2",
                                                "sense_id": "f80a5455-3d13-38e1-93f6-43c63f52c809",
                                                "text": "„Die AfD ist unter Druck.“"
                                            },
                                            {
                                                "example_id": "6cb4dfef-a853-452a-a23f-1176cb2b8812",
                                                "sense_id": "f80a5455-3d13-38e1-93f6-43c63f52c809",
                                                "text": "„Die Frage nach dem Menschenbild der AfD steht im Zentrum der Untersuchung.“"
                                            },
                                            {
                                                "example_id": "d7ab43c6-8362-446b-a0a7-cb2a548132fe",
                                                "sense_id": "f80a5455-3d13-38e1-93f6-43c63f52c809",
                                                "text": "„[…] Wer AfD wählt, ist nicht unbedingt rassistisch, rechtsextrem oder fremdenfeindlich; wohl aber unterstützt er Rassisten, Rechtsextreme und Fremdenfeinde – oder AfD-Vertreter, die Rassisten, Rechtsextreme und Fremdenfeinde in ihren Reihen willkommen heißen.“"
                                            },
                                            {
                                                "example_id": "5f17ca62-61f7-42ca-a933-3aa952be8e26",
                                                "sense_id": "f80a5455-3d13-38e1-93f6-43c63f52c809",
                                                "text": "„Laut der mittlerweile zweiten Instanz liegen hinreichende tatsächlich Anhaltspunkte dafür vor, dass die AfD Bestrebungen gegen die Menschenwürde bestimmter Personengruppen sowie gegen das Demokratieprinzip verfolgt. Sachwidrige oder politische Motive gibt es laut Gericht nicht, das Bundesamt für Verfassungsschutz komme bei der Einstufung und Beobachtung der AfD seinem Auftrag nach.‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3501a8c4-6455-4ed2-b015-cbdd839484a1",
