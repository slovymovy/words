                                "sense_id": "77d7b69c-3fb0-365f-bb11-ae7925f507c8",
                                "text": "Die Egalisierung von Arbeitern und Angestellten im Gesundheitssystem wurde durch das Lohnfortzahlungsgesetz vom 27. Juli 1969 erreicht."
                            }
                        ],
                        "sense_index_json": "\"2\""
