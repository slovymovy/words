                ],
                "senses": [
                    {
                        "sense_id": "70f10b2e-d7aa-34ad-81be-6fdd4028b5bb",
                        "entry_id": "cb9ac9ac-72db-36d0-8ec8-925ac136ab30",
                        "glosses": [
                            "einer Steppe ähnelnd, an eine Steppe erinnernd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "231a1c71-8841-4dee-a124-eb362736313f",
                                "sense_id": "70f10b2e-d7aa-34ad-81be-6fdd4028b5bb",
                                "text": "„Phrygana überzieht einen Großteil der kretischen Weidegebiete und wächst auch in extremen Trockenregionen, sehr arme Böden können sogar steppenartig ausgebildet sein.“"
                            },
                            {
                                "example_id": "f780a360-c7bb-4134-9d9b-7638cbc0e5aa",
                                "sense_id": "70f10b2e-d7aa-34ad-81be-6fdd4028b5bb",
                                "text": "„Das südlichste Dorf der Insel liegt am Rande eines allseits von Hügeln umschlossenen Tals, das vom Frühsommer an geradezu steppenartig wirkt.“"
                            },
                            {
                                "example_id": "b85aaf57-a518-4f4d-bb22-be3431bb12b4",
                                "sense_id": "70f10b2e-d7aa-34ad-81be-6fdd4028b5bb",
                                "text": "„Östlich der Zentralebene ist die Landschaft aufgrund des geringen Niederschlags steppenartig geprägt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
