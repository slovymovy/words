                "senses": [
                    {
                        "sense_id": "8df07aae-b779-3e8e-b05b-50b0e2f220b7",
                        "entry_id": "978fa07b-04f1-3591-866f-91149a2ece76",
                        "glosses": [
                            "Faire perdre son type à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa8ab999-45a1-44cf-b5bc-8b1204115f57",
                                "sense_id": "8df07aae-b779-3e8e-b05b-50b0e2f220b7",
                                "text": "Ca revient à détyper une variable booléenne."
                            },
                            {
                                "example_id": "6daeb04e-98d8-4639-a873-3aaf2be89657",
                                "sense_id": "8df07aae-b779-3e8e-b05b-50b0e2f220b7",
                                "text": "Il faut complètement détyper les pointeurs mémorisés en paramétrant les opérations avec des pointeurs void *."
                            },
                            {
                                "example_id": "13e3077b-9c38-42de-867e-c28cca8c7ec3",
                                "sense_id": "8df07aae-b779-3e8e-b05b-50b0e2f220b7",
                                "text": "Il y a de très jolis persans, pas la peine de retourner en arrière et détyper la race."
                            },
                            {
                                "example_id": "f29951f6-fb26-4a06-bf5b-034d8db193ec",
                                "sense_id": "8df07aae-b779-3e8e-b05b-50b0e2f220b7",
                                "text": "Cela commence par une dépersonnalisation du bien immobilier : le «détyper» pour qu il plaise à un plus grand nombre d acheteurs possible."
                            }
                        ]
                    }
