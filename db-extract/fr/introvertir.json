                ],
                "senses": [
                    {
                        "sense_id": "8334743e-713d-361f-ada6-995e56b351e4",
                        "entry_id": "5dddf472-e6a9-351b-85d3-a6473b9e3793",
                        "glosses": [
                            "Intérioriser."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "2810a0e8-6a69-43f9-9d4a-7ca3337a0f40",
                                "sense_id": "8334743e-713d-361f-ada6-995e56b351e4",
                                "text": "Il accepte de s’introvertir pour mieux s’adapter à elles, au risque de se couper du monde."
                            },
                            {
                                "example_id": "746cde12-b279-412a-9ee2-c5bb604926ba",
                                "sense_id": "8334743e-713d-361f-ada6-995e56b351e4",
                                "text": "Comme après la distraction nous devons par foi nous introvertir."
                            },
                            {
                                "example_id": "07989294-a0c3-4bd0-b9d3-0bcfe949f588",
                                "sense_id": "8334743e-713d-361f-ada6-995e56b351e4",
                                "text": "Au lieu « d’introvertir » les valeurs de culture comme le réclame l’existentialisme, il s’agit bien ici « d’extravertir » les convictions pour mieux les mettre en question."
                            },
                            {
                                "example_id": "d77c465e-7aac-42b2-ac7e-420a2114ce81",
                                "sense_id": "8334743e-713d-361f-ada6-995e56b351e4",
                                "text": "La dialectique mystique, pour atteindre à la présence divine, consistant à transmuer le mal en bien, à introvertir la pulsion de mort qui s’exerce sur soi et sur le monde pour détruire le mal, afin qu’advienne le bien."
                            }
                        ]
                    }
                ],
