                    {
                        "translation_id": "02933853-25db-4254-b7bc-88607c81e59c",
                        "source_entry_id": "956d1859-dec8-3b1b-88c6-e1ed167b328b",
                        "source_sense_id": "cb3ebaf1-877a-35de-a14a-c496409b1b73",
                        "source_sense_description": "man from Ireland",
                        "target_lang_word": "Irlandais",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
