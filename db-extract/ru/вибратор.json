                                                "sense_id": "e6181c29-559f-3e5b-844d-2fd54f348d46",
                                                "text": "They recommend a vibrator because it's a safe alternative to sex."
                                            },
                                            {
                                                "example_id": "44f644fc-09ff-4b46-86b5-9401b0c7e9ec",
                                                "sense_id": "e6181c29-559f-3e5b-844d-2fd54f348d46",
                                                "text": "Mmm. I'm sick of my ‘Mighty Intruder’ vibrator with the flexible shaft and the textured head."
                                            },
                                            {
                                                "example_id": "014dcd2d-fee2-4904-87f7-ec83690589ce",
                                                "sense_id": "e6181c29-559f-3e5b-844d-2fd54f348d46",
                                                "text": "A vibrator does not call you on your birthday. A vibrator doesn't send you flowers the next day. You cannot take a vibrator home to meet your mother."
                                            }
                                        ]
                                    },
                                    {
