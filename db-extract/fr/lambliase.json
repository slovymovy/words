                        "glosses": [
                            "Maladie parasitaire fréquente, cosmopolite, causée par le Lamblia intestinalis, également connu sous le nom de Giardia duodenalis et de Giardia intestinalis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "073d7611-6384-4146-bee7-676261bd4665",
                                "sense_id": "b9427065-fb42-3196-8b9a-ea6713edcb0f",
                                "text": "La lambliase est asymptômatique dans la grande majorité des cas."
                            },
                            {
                                "example_id": "6a0b2424-63c0-4eab-847b-6649aaf17866",
                                "sense_id": "b9427065-fb42-3196-8b9a-ea6713edcb0f",
                                "text": "Parasitose intestinale la plus répandue dans le monde, la lambliase est due à un protozoaire appelé Giardia lamblia ou Giardia intestinalis."
                            }
                        ]
                    }
                ],
