                "senses": [
                    {
                        "sense_id": "70f8fdde-12fd-3cbb-a54d-99d5f2f25a6d",
                        "entry_id": "87804fbb-280d-3eb7-ac8b-4f8a970de10c",
                        "glosses": [
                            "Relatif à Varsovie ou à ses habitants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5daa05bc-3816-4122-8207-917ec05038ca",
                                "sense_id": "70f8fdde-12fd-3cbb-a54d-99d5f2f25a6d",
                                "text": "La foule varsovienne, qui arborait pour beaucoup des drapeaux aux couleurs rouge et blanc de la Pologne ceints de rubans noirs, s’est pressée sur l’immense place Pilsudski, dans le centre-ville."
                            },
                            {
                                "example_id": "82e6e7ae-4a8b-4bef-885b-7547f08e6625",
                                "sense_id": "70f8fdde-12fd-3cbb-a54d-99d5f2f25a6d",
                                "text": "Le parler varsovien, ce sont des expressions et des mots originaux, mais aussi une tonalité caractéristique de la voix, avec des déformations verbales, un humour spécifique et un côté fanfaron."
                            }
                        ]
                    }
