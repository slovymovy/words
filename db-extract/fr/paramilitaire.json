        "fr-extract.jsonl": [
            {
                "entry_id": "a3bf2c7e-0e84-3c74-8836-3b415b045d41",
                "word": "paramilitaire",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "143c2624-17a8-485a-9311-381154f4ef53",
                        "entry_id": "a3bf2c7e-0e84-3c74-8836-3b415b045d41",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "paramilitaires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "35e5efc3-dcee-38f3-81e3-cc7e75b1ff00",
                        "entry_id": "a3bf2c7e-0e84-3c74-8836-3b415b045d41",
                        "glosses": [
                            "Qui est entrainé à l’activité militaire mais ne fait pas partie de l’armée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09990c26-9e13-4ec9-b5df-c3ed31d26f1b",
                                "sense_id": "35e5efc3-dcee-38f3-81e3-cc7e75b1ff00",
                                "text": "Le 19 octobre, le patron du groupe paramilitaire Wagner, Evguéni Prigojine, a annoncé la construction de ce dispositif, hérissé de « dents de dragon » antichars, dans la région de Lougansk."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5302f784-fef6-43f7-90b4-1a7677a674e9",
                        "source_entry_id": "a3bf2c7e-0e84-3c74-8836-3b415b045d41",
                        "source_sense_id": "35e5efc3-dcee-38f3-81e3-cc7e75b1ff00",
                        "source_sense_description": "Qui est entrainé à l'activité militaire",
                        "target_lang_word": "paramilitärisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paramilitärisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5d0f5d8c-dec3-337a-8a38-7c2f8354c5b9",
                                        "entry_id": "c9ac2a26-5baa-3fbe-a35f-fbfd9fb64b2d",
                                        "glosses": [
                                            "militärisch ausgerüstet und organisiert, aber nicht Teil der regulären Armee"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "643d772d-48fe-4437-9eba-4472a32e11b7",
                                                "sense_id": "5d0f5d8c-dec3-337a-8a38-7c2f8354c5b9",
                                                "text": "Die SS war eine paramilitärische Organisation der NSDAP."
                                            },
                                            {
                                                "example_id": "ac642b22-f825-4af8-b92d-ef74931881d6",
                                                "sense_id": "5d0f5d8c-dec3-337a-8a38-7c2f8354c5b9",
                                                "text": "Die paramilitärischen Einheiten entzogen sich jeglicher Kontrolle durch die politischen Institutionen des Landes."
                                            },
                                            {
                                                "example_id": "35f4f48d-56ee-48ed-8d73-960d4a57abea",
                                                "sense_id": "5d0f5d8c-dec3-337a-8a38-7c2f8354c5b9",
                                                "text": "„Paramilitärische und reguläre Einheiten griffen daraufhin die Araber und Berber an, auch mit Bomben.“"
                                            },
                                            {
                                                "example_id": "45adb0fc-a9f2-407b-8878-579f7801c2cf",
                                                "sense_id": "5d0f5d8c-dec3-337a-8a38-7c2f8354c5b9",
                                                "text": "„Die gewaltsamen Auseinandersetzungen zwischen der oppositionellen Parteienallianz (PNA) und Bhuttos eigenen paramilitärischen Kräften eskalierten und forderten binnen zwei Wochen etwa zweihundert Todesopfer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a569c2b3-f45f-4440-925d-13644d9b7e3a",
                        "source_entry_id": "a3bf2c7e-0e84-3c74-8836-3b415b045d41",
                        "source_sense_id": "35e5efc3-dcee-38f3-81e3-cc7e75b1ff00",
                        "source_sense_description": "Qui est entrainé à l'activité militaire",
                        "target_lang_word": "paramilitary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paramilitary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71a084ef-d2be-3bd0-bc55-8d69f2b5aeeb",
                                        "entry_id": "decf4729-23b6-361b-9c7f-cf8c0171195d",
                                        "glosses": [
                                            "A group of civilians trained and organized in a military fashion, but which do not represent the formal forces of a sovereign power."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c120a27f-f89e-41c8-b17f-16c09419f580",
                                                "sense_id": "71a084ef-d2be-3bd0-bc55-8d69f2b5aeeb",
                                                "text": "From the start of its operations in Colombia, the company was on guard against the decadeslong civil strife in the country between left-wing guerrilla and right-wing paramilitary groups, witnesses have testified."
                                            },
                                            {
                                                "example_id": "f2ffd6ab-e5c3-48a6-be9a-ff6283d48fe8",
                                                "sense_id": "71a084ef-d2be-3bd0-bc55-8d69f2b5aeeb",
                                                "text": "Cossack paramilitaries operate in Ukraine and southern Russia. […] Before he entered eastern Ukraine, Girkin led paramilitary groups in Crimea and negotiated with Ukrainian military officers in attempts to induce them to defect to Russia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63856ec9-8ef0-34dc-b99c-16d58ef6c8f6",
                                        "entry_id": "decf4729-23b6-361b-9c7f-cf8c0171195d",
                                        "glosses": [
                                            "A member of a paramilitary group."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
