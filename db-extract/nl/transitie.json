                                        "glosses": [
                                            "Cambio de una posición, situación, estado, tema, concepto, tono, modificación, variación, etc. a otro."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aefce9e-a524-4989-a78d-5613d3ff1597",
                                                "sense_id": "f99d27cc-bea3-3ca0-b8cc-0cbd244103fd",
                                                "text": "Por fin pasamos por un período de transición."
                                            }
                                        ],
