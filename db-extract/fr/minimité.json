                        "sense_id": "5b979943-c027-3fe2-a631-dd0bfde05e17",
                        "entry_id": "241b035a-5449-34ea-9f14-4317011ac13b",
                        "glosses": [
                            "Qualité de ce qui est minime."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e5e1622-0076-4db3-a984-24fda9f132c4",
                                "sense_id": "5b979943-c027-3fe2-a631-dd0bfde05e17",
                                "text": "Je ne suis pas surpris qu'un homme qui voyait tant de monstruosités dans les détails ait combattu les fins, et leur ait substitué la loi de la minimité."
                            },
                            {
                                "example_id": "3995912e-3f7a-4c46-aaaf-1a0218a618b0",
                                "sense_id": "5b979943-c027-3fe2-a631-dd0bfde05e17",
                                "text": "L'influence peu considérable qu'exerçaient les circonstances sur son portefeuille [de la banque] et sur son encaisse, en raison de la minimité de ses affaires et de la minimité des services qu'elle rendait au public."
                            },
                            {
                                "example_id": "1b108e76-80b5-4758-9e6e-f72a4a413f98",
                                "sense_id": "5b979943-c027-3fe2-a631-dd0bfde05e17",
                                "text": "L’évocation mémorielle privilégie souvent même des motifs d’agitation, voire d’effervescence sensorielle : liés, pour la plupart d’entre eux, à une passion de la minimité."
                            }
                        ]
                    }
