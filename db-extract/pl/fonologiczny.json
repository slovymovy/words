                ],
                "translations": [
                    {
                        "translation_id": "802f5d27-74f8-4d47-8cea-abb35f137eb0",
                        "source_entry_id": "a9f548ef-8230-33bf-adb2-81ea90983e3f",
                        "source_sense_id": "da209e13-5d99-3978-80c7-056cdc88c88e",
                        "target_lang_word": "phonological",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phonological",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2602aab7-13ee-3521-8598-1608e0e16fe7",
                                        "entry_id": "85e175ac-35ee-334b-8894-dbb24e6c214c",
                                        "glosses": [
                                            "Of or relating to phonology."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "274f972f-2d94-485e-b1ad-fb0b60432054",
                                                "sense_id": "2602aab7-13ee-3521-8598-1608e0e16fe7",
                                                "text": "[...] Phonological competence is also reflected in intuitions about phonological structure: any English speaker intuitively feels, for example, that the sequence 'black bird' can either be a single phonological word (BLACKbird, with primary stress on black = a species of bird, like thrush, robin, etc.), or two independent phonological words (BLACK BIRD or black BIRD = bird which is black, as opposed to 'white bird', 'yellow bird', etc.)."
                                            },
                                            {
                                                "example_id": "611712ca-d766-47b4-bd08-52e1b5690ad7",
                                                "sense_id": "2602aab7-13ee-3521-8598-1608e0e16fe7",
                                                "text": "I am not pleased with one or two of the noun cases (they are too similar to others) and I want to change the way that the Focus category (see Section 3.5 of the grammar) is manifested (using word-order instead of an infix or other phonological marker). All in all, the language is structured almost exactly as I wanted."
                                            },
                                            {
                                                "example_id": "9a1a81ce-03fc-4c2d-b884-196d358e374e",
                                                "sense_id": "2602aab7-13ee-3521-8598-1608e0e16fe7",
                                                "text": "Each language has its own distinct phonological qualities which a counter can tap into with effect. It is not necessarily specific phonemes (though these can sometimes be diagnostic), but rather the frequency and phonotactic distribution of each disparate set of phonemes that go together in the speech stream in certain recognisable ways."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "498ef339-cf0c-36e4-80fa-63da22d32521",
                                        "entry_id": "85e175ac-35ee-334b-8894-dbb24e6c214c",
                                        "glosses": [
                                            "Pertaining to the way sounds function in languages, including phonemes, syllable structure, stress, and accent."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd327da6-51f4-4863-8652-c3433f9648a0",
                        "source_entry_id": "a9f548ef-8230-33bf-adb2-81ea90983e3f",
                        "source_sense_id": "da209e13-5d99-3978-80c7-056cdc88c88e",
                        "target_lang_word": "fonologický",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4094dc09-5b52-4406-bf5e-b1e4a6a939b7",
                        "source_entry_id": "a9f548ef-8230-33bf-adb2-81ea90983e3f",
                        "source_sense_id": "da209e13-5d99-3978-80c7-056cdc88c88e",
                        "target_lang_word": "phonologique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phonologique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "07fdbe64-65f7-316b-ad49-0d279f66e62d",
                                        "entry_id": "469e16bb-e46e-3e20-aa49-3a3daaf37ab3",
                                        "glosses": [
                                            "Relatif à la phonologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23951f64-0cd6-4f89-b40a-c2a2963b36a6",
                                                "sense_id": "07fdbe64-65f7-316b-ad49-0d279f66e62d",
                                                "text": "Le [h] du Cockney et celui du bourgeois anglais ou de l'Américain peuvent fort bien être phonétiquement identiques. Ils n'en représentent pas moins deux réalités linguistiques tout à fait distinctes. L’ascension sociale ne se réalise en Angleterre qu'au prix d'une rééducation phonologique fort difficile."
                                            },
                                            {
                                                "example_id": "932a7a8b-57f8-4b78-a132-1006599e86fc",
                                                "sense_id": "07fdbe64-65f7-316b-ad49-0d279f66e62d",
                                                "text": "Ainsi, en dépit du fait que le logogramme chinois est souvent peu informatif quant à sa prononciation, l’information phonologique contenue dans l’écriture est exploitée pour prononcer les caractères rares."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4aed7b80-7ba1-4d2b-b233-508a08dca9ba",
                        "source_entry_id": "a9f548ef-8230-33bf-adb2-81ea90983e3f",
                        "source_sense_id": "da209e13-5d99-3978-80c7-056cdc88c88e",
                        "target_lang_word": "phonologisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phonologisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84b6a3e8-79eb-3b59-86b7-8da8a89b1b49",
                                        "entry_id": "74399c7b-b1a0-3190-b915-b9c9db8e3894",
                                        "glosses": [
                                            "die Phonologie (Lehre von den Phonemen, den kleinsten, bedeutungsunterscheidenden Einheiten der Sprache) betreffend; den Regeln der Phonologie entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "421e866a-5aad-429d-8914-ebbb284f4802",
                                                "sense_id": "84b6a3e8-79eb-3b59-86b7-8da8a89b1b49",
                                                "text": "Die phonologische Analyse sprachlicher Einheiten ist Voraussetzung für die Entwicklung des Phonemsystems einer Sprache und der entsprechenden Regeln."
                                            },
                                            {
                                                "example_id": "2cce2fb9-4a34-46a2-99ab-43142f50499a",
                                                "sense_id": "84b6a3e8-79eb-3b59-86b7-8da8a89b1b49",
                                                "text": "„Das liegt daran, dass zum phonologischen noch weitere Prinzipien kommen, die in dieser Einführung allerdings nur andeutungsweise besprochen werden können.“"
                                            },
                                            {
                                                "example_id": "9d60d065-cae5-4a04-b00c-03520e418821",
                                                "sense_id": "84b6a3e8-79eb-3b59-86b7-8da8a89b1b49",
                                                "text": "„Im Rahmen der Standardlautung kann aus der Reihenfolge der Neutralisierung der phonologischen Distinktionen (Oppositionen) und aus dem phonetischen Ergebnis der Neutralisierung (gespannter/geschlossener Vokal) auf den primären Status der Vokalqualität im Verhältnis zur Quantität geschlossen werden.“"
                                            },
                                            {
                                                "example_id": "8b52cae3-89d3-463d-ad5f-575a660f4364",
                                                "sense_id": "84b6a3e8-79eb-3b59-86b7-8da8a89b1b49",
                                                "text": "„Die bisher genannten Eigenschaften machen ein Wort aufgrund von phonologischen, graphematischen oder morphologischen Merkmalen zum Anglizismus, aber Busses Begriff reicht weiter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
