            "senses": [
                {
                    "sense_id": "b28bacdd-6cb9-3a14-b103-5dbf87dadf1d",
                    "sense_definition": "A young female horse.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "horse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer watched the <w>filly</w> run across the green pasture.",
                            "target_lang_translations": {
                                "de": "Der Bauer beobachtete, wie das <w>Stutfohlen</w> über die grüne Weide rannte."
                            }
                        },
                        {
                            "text": "That young <w>filly</w> is already showing great speed in training.",
                            "target_lang_translations": {
                                "de": "Dieses junge <w>Stutfohlen</w> zeigt bereits im Training große Schnelligkeit."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein weibliches Fohlen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Stutfohlen",
                                "target_lang_sense_clarification": "Fachbegriff für ein weibliches Pferdejunges"
                            },
                            {
                                "target_lang_word": "weibliches Fohlen",
                                "target_lang_sense_clarification": "Allgemeine Bezeichnung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c0b8618-503f-3457-a523-8de46089f768",
                    "sense_definition": "A young, attractive woman.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He could not stop staring at the beautiful <w>filly</w> walking down the street.",
                            "target_lang_translations": {
                                "de": "Er konnte nicht aufhören, das hübsche <w>junge Ding</w> anzustarren, das die Straße entlangging."
                            }
                        },
                        {
                            "text": "She is a feisty <w>filly</w> who knows exactly what she wants in life.",
                            "target_lang_translations": {
                                "de": "Sie ist ein aufgewecktes <w>junges Ding</w>, das genau weiß, was es im Leben will."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Often considered objectifying or dated."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine junge, attraktive Frau (umgangssprachlich, oft abwertend)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "junges Ding",
                                "target_lang_sense_clarification": "Umgangssprachlich für eine junge Frau"
                            },
                            {
                                "target_lang_word": "feger",
                                "target_lang_sense_clarification": "Umgangssprachlich für eine attraktive, lebhafte junge Frau"
                            }
                        ]
                    }
                }
            ]
        }
    ]
