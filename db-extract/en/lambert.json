                "translations": [
                    {
                        "translation_id": "da9715ea-b241-4324-baa6-d8319e24108d",
                        "source_entry_id": "ab2d6851-0884-3888-ad82-d22ad9f240a6",
                        "source_sense_description": "male given name",
                        "target_lang_word": "Lambert",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lambert",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "60c864d4-e914-3eca-9e05-2cf0264d7d05",
                                        "entry_id": "00e43992-b18e-3552-a66f-66c8ecbd1392",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cfe4fc4-703c-440b-a606-2d45f8cb3b23",
                                                "sense_id": "60c864d4-e914-3eca-9e05-2cf0264d7d05",
                                                "text": "Saint Lambert, évêque de Maastricht, est fêté le 17 septembre."
                                            },
                                            {
                                                "example_id": "43b69b00-60ad-4da1-aad9-7b56f38ee9e6",
                                                "sense_id": "60c864d4-e914-3eca-9e05-2cf0264d7d05",
                                                "text": "En revanche je goûtais fort peu le jeu de scène de la délicieuse Sophie Marceau qui dans Pygmalion allait jusqu’à fourrailler dans son appendice nasal pendant que Lambert Wilson devait dire des choses de première importance."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Lambert",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3c925937-df80-3176-acc7-4f5b11c2601b",
                                        "entry_id": "0f77a60e-38b4-3d9c-9b87-2ec118674113",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48627a0b-3780-415f-931f-940c90b87da3",
                                                "sense_id": "3c925937-df80-3176-acc7-4f5b11c2601b",
                                                "text": "À son retour à Saint-Cloud après la Libération, René Crevel reprend son activité d’architecte, cette fois au service de propriétaires privés, dont il remet en état les villas : les propriétés du Docteur Debat, des familles Fonty et Lambert, dans le parc de Montretout, bénéficient de son intervention."
                                            },
                                            {
                                                "example_id": "dee48f9b-2233-4f4e-8b01-5754d1d79113",
                                                "sense_id": "3c925937-df80-3176-acc7-4f5b11c2601b",
                                                "text": "Arlette Geoffroy, responsable des guides Sprev a accueilli mardi matin, Pierre Rigollet et Pierre Lambert, guides de l’enclos paroissial pour le mois d’août."
                                            },
                                            {
                                                "example_id": "c636aec8-6d80-4e4f-aa56-b02963a89512",
                                                "sense_id": "3c925937-df80-3176-acc7-4f5b11c2601b",
                                                "text": "Rédaction • Alexia Fourcaud, Marine Godefroy, Marion Cortes, Cécile Lambert, Julie Hébert, Stéphanie Deschauwer"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
