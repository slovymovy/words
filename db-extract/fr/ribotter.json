                        "glosses": [
                            "Faire une débauche de table, et surtout boire avec excès."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afac2cec-6d7c-44b8-bd37-776b58b05265",
                                "sense_id": "7efa8fd5-0905-3db9-bcfd-e4057f234a6d",
                                "text": "[…], je me demande un peu s'ils sont contents de nourrir le père et la mère, quand ils ne gagnent seulement pas assez pour ribotter tout leur content."
                            },
                            {
                                "example_id": "d5a56912-9bf0-43b2-bb50-5b3b8aacd0f3",
                                "sense_id": "7efa8fd5-0905-3db9-bcfd-e4057f234a6d",
                                "text": "Nos épouses sont ravies de pouvoir ribotter avec nous."
                            }
                        ]
