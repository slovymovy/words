                    {
                        "sense_id": "3613ac53-73bf-389d-8344-a245eea70bd8",
                        "entry_id": "efe8217c-afb6-336d-bef2-9f16361ae216",
                        "glosses": [
                            "Parricide, patricide, celui qui tue son père."
                        ],
                        "tags": [
                            "Justice"
                        ],
                        "examples": [
                            {
                                "example_id": "396c6b93-ed3f-4f65-82a4-b8746f480fee",
                                "sense_id": "3613ac53-73bf-389d-8344-a245eea70bd8",
                                "text": "Ödipus wurde, ohne es zu wissen, zum Vatermörder.",
                                "translation": "Oedipe est devenu un parricide sans même le savoir."
                            }
                        ]
                    },
                    {
                        "sense_id": "04f7c305-e8ac-3ccd-8d21-ed9234b16425",
                        "entry_id": "efe8217c-afb6-336d-bef2-9f16361ae216",
                        "glosses": [
                            "Col montant, des chemises d'hommes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d34d093-3810-43b0-95fa-ae1cfdb5ebe3",
                                "sense_id": "04f7c305-e8ac-3ccd-8d21-ed9234b16425",
                                "text": "Der Vatermörder wurde vor allem von dem Modeschöpfer Karl Lagerfeld getragen.",
                                "translation": "Le col montant était particulièrement porté par le créateur de mode Karl Lagerfeld."
                            },
                            {
                                "example_id": "5ae7747a-2fbe-4d8d-893e-243eab8bf1e3",
                                "sense_id": "04f7c305-e8ac-3ccd-8d21-ed9234b16425",
                                "text": "Um die steifen Vatermörder, in die sich sein Kinn schmiegte, war die seidene Krawatte geschlungen, die dick und breit den ganzen Ausschnitt der buntfarbigen Weste ausfüllte …",
                                "translation": "Autour du rigide faux col, entre les pointes duquel s’insérait son menton, s’enroulait, épaisse et large, la cravate de soie, emplissant toute l’échancrure du gilet bigarré…"
                            }
                        ]
                    }
