                                "target_senses": [
                                    {
                                        "sense_id": "9463e728-f758-3ff4-95be-c7786f70deaf",
                                        "entry_id": "a7269a7c-f913-38bc-9b15-fdea16f653c7",
                                        "glosses": [
                                            "Pflaster mit Zugsalbe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
