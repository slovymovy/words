                    }
                ],
                "senses": [
                    {
                        "sense_id": "c7425b92-6c7a-34f7-8824-574c42ba76d7",
                        "entry_id": "384d2267-c066-32c3-a495-d9a6da57c02e",
                        "glosses": [
                            "Relatif à l’araignée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33d21c98-5f71-4b83-9fb3-a55413a32e4d",
                                "sense_id": "c7425b92-6c7a-34f7-8824-574c42ba76d7",
                                "text": "De fait, il y avait quelque chose de clairement arachnéen chez cet homme, grand comme il était avec ses membres maigres."
                            }
                        ]
                    },
                    {
                        "sense_id": "34f64723-d674-3a26-8b2c-3cfc9c29e050",
                        "entry_id": "384d2267-c066-32c3-a495-d9a6da57c02e",
                        "glosses": [
                            "Dont la légèreté, la finesse, fait penser à la toile d’araignée."
                        ],
                        "tags": [
                            "figuratively",
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "6b832b09-5c2d-4f92-b2ac-2478bc187a1e",
                                "sense_id": "34f64723-d674-3a26-8b2c-3cfc9c29e050",
                                "text": "J’ouvris ce sac-là et en retirai une arachnéenne culotte de nylon, noire et bordée de dentelle."
                            },
                            {
                                "example_id": "bd56b56f-4243-4587-a971-413633a47cb8",
                                "sense_id": "34f64723-d674-3a26-8b2c-3cfc9c29e050",
                                "text": "Mais dans les infinies nuances proposées par la lingerie, de l’honnête inusable à l’arachnéen lascif, elle faisait maintenant des concessions à la beauté qu’elle eût déclarées naguère indignes d’une femme intelligente."
                            },
                            {
                                "example_id": "7bd5cc7f-546e-407f-9aa9-1bfdd553adb5",
                                "sense_id": "34f64723-d674-3a26-8b2c-3cfc9c29e050",
                                "text": "Elle portait un voile arachnéen."
                            }
                        ]
                    },
                    {
                        "sense_id": "5cc0538b-a042-36f7-81d0-25adf38feffe",
                        "entry_id": "384d2267-c066-32c3-a495-d9a6da57c02e",
                        "glosses": [
                            "Qui dessine des réseaux comme dans une toile d’araignée."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "03a5eae9-63ff-4968-a303-5c9751fae032",
                                "sense_id": "5cc0538b-a042-36f7-81d0-25adf38feffe",
                                "text": "Des vidéos associées permettent d’appréhender dans l’espace le développement de cette architecture arachnéenne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2fb57ee7-8a45-4c20-9272-44f5c12b17d1",
                        "source_entry_id": "384d2267-c066-32c3-a495-d9a6da57c02e",
                        "source_sense_description": "Relatif à l’araignée",
                        "target_lang_word": "spinnenartig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spinnenartig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "34fec26c-0f18-33a2-b0b0-e3d5ef54879a",
                                        "entry_id": "b8d5c283-be20-336c-826f-27e01ae28455",
                                        "glosses": [
                                            "einer Spinne ähnelnd, wie eine Spinne aussehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf923e3d-c3b6-43fd-8eb4-c85f58371622",
                                                "sense_id": "34fec26c-0f18-33a2-b0b0-e3d5ef54879a",
                                                "text": "„Spinnenartige grüne Muster krochen über den Himmel und brachten ihn zum Stottern.“"
                                            },
                                            {
                                                "example_id": "a4e9c2f5-9cce-4d1f-8c58-69676dba8992",
                                                "sense_id": "34fec26c-0f18-33a2-b0b0-e3d5ef54879a",
                                                "text": "„Ich machte mich daran, einen Sinn aus der spinnenartigen Handschrift herauszulesen.“"
                                            },
                                            {
                                                "example_id": "6ce0ecd4-f005-4627-bded-9c42ccf44aff",
                                                "sense_id": "34fec26c-0f18-33a2-b0b0-e3d5ef54879a",
                                                "text": "„Sie hatte spinnenartige Wimpern, große Hände und einen Revolver an der Hüfte.“"
                                            },
                                            {
                                                "example_id": "764203c5-6bad-40a1-8bff-10d317ab0110",
                                                "sense_id": "34fec26c-0f18-33a2-b0b0-e3d5ef54879a",
                                                "text": "„Little Skag ließ den Hörer fallen, fuhr sich mit seinen spinnenartigen Fingern durchs fettige Haar und presste die Handballen gegen die Schläfen, als wollte er seine inneren Dämonen austreiben.“"
                                            },
                                            {
                                                "example_id": "971eda4a-6e99-469f-91a0-4eabb42e03da",
                                                "sense_id": "34fec26c-0f18-33a2-b0b0-e3d5ef54879a",
                                                "text": "„Sie fand einen Dokumentarfilm über Raumstationen, stellte den Ton leise und betrachtete die spinnenartigen weißen Gebilde vor dem Hintergrund der Sterne.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
