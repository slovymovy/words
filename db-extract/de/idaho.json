                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cbbc776-7163-4a98-bd62-69bd38011d87",
                                "sense_id": "5f616d97-718b-39d9-a886-f6af740ac696",
                                "text": "Die Hauptstadt von Idaho ist Boise."
                            },
                            {
                                "example_id": "e180828b-5add-4e66-b7fb-236b489530e8",
                                "sense_id": "5f616d97-718b-39d9-a886-f6af740ac696",
                                "text": "In der beschaulichen Hauptstadt des US-Bundesstaates Idaho, hoch oben in Amerikas Nordwesten, verläuft das Leben langsamer als anderswo."
                            },
                            {
                                "example_id": "c28e86f4-2f08-4bd5-ab0f-fc3a9929fe90",
                                "sense_id": "5f616d97-718b-39d9-a886-f6af740ac696",
                                "text": "Die Landschaft von Idaho ist größtenteils von Bergen geprägt."
                            },
                            {
                                "example_id": "5bc8b9f2-6452-418d-837c-11f0ad655202",
                                "sense_id": "5f616d97-718b-39d9-a886-f6af740ac696",
                                "text": "Wirtschaftlich gesehen lebt Idaho vor hauptsächlich vom Tourismus."
                            },
                            {
                                "example_id": "6e9f1725-749f-4229-8c61-84d4061def30",
                                "sense_id": "5f616d97-718b-39d9-a886-f6af740ac696",
                                "text": "Yellowstone wurde 1872 gegründet und ist Amerikas ältester Nationalpark. Er erstreckt sich über die Bundesstaaten Wyoming, Montana und Idaho."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
