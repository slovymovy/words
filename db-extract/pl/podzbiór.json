                "senses": [
                    {
                        "sense_id": "ffa01b4d-e47a-3ccf-ab8b-9f7293eac4d3",
                        "entry_id": "e0acd28c-03c2-3255-9b99-6be6431648dc",
                        "glosses": [
                            "zbiór zawarty w innym zbiorze; zbiór którego wszystkie elementy należą do innego zbioru"
                        ],
