                                        "examples": [
                                            {
                                                "example_id": "e58bf6b9-8424-4f06-8228-c9bf3618a915",
                                                "sense_id": "2b01a066-f5f8-3454-b8b5-88306bdc4fb9",
                                                "text": "Près du pont, je découvre l’hôpital psychiatrique où André Breton fut affecté en juillet 1916 dans le service du docteur Raoul Leroy, ancien assistant de Charcot, médecin-chef de l’hôpital de Ville-Évrard."
                                            },
                                            {
                                                "example_id": "5e4c8427-cc35-4f7e-a075-06343c6a6792",
                                                "sense_id": "2b01a066-f5f8-3454-b8b5-88306bdc4fb9",
                                                "text": "L’association Saint-Nicolas, sous la présidence d’Yves Douguet, épaulé par Yves Bozec, trésorier, et Jean-Claude Breton, secrétaire, a tenu samedi 30 juillet sa première assemblée générale dans la chapelle Saint-Nicolas."
                                            },
                                            {
                                                "example_id": "bf434253-be56-41bd-86a4-ac15cac3c090",
                                                "sense_id": "2b01a066-f5f8-3454-b8b5-88306bdc4fb9",
                                                "text": "Quel est le point commun entre Hannah Arendt, André Breton, Marc Chagall et Walter Benjamin ?"
                                            }
