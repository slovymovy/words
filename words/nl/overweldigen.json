{
    "word_family": [
        "overweldiging",
        "overweldigend",
        "geweld"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d94620ca-7865-348a-b070-882b02e9f2ca",
                    "sense_definition": "iemand emotioneel diep raken of op een zeer prettige manier verbazen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotionele impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik was volledig <w>overweldigd</w> door hun vrijgevigheid en oprechte vriendelijkheid.",
                            "target_lang_translations": {
                                "en": "I was completely <w>overwhelmed</w> by their generosity and sincere kindness."
                            }
                        },
                        {
                            "text": "De prachtige muziek wist het publiek in de zaal totaal te <w>overweldigen</w>.",
                            "target_lang_translations": {
                                "en": "The beautiful music managed to totally <w>overwhelm</w> the audience in the hall."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontroeren",
                        "overrompelen",
                        "verbazen"
                    ],
                    "common_phrases": [
                        "totaal overweldigen",
                        "overweldigd door emoties"
                    ],
                    "target_lang_definitions": {
                        "en": "To affect someone deeply emotionally or to surprise them in a very pleasant way."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "overwhelm",
                                "target_lang_sense_clarification": "to be overcome with emotion"
                            },
                            {
                                "target_lang_word": "overpower",
                                "target_lang_sense_clarification": "to affect strongly with feelings"
                            },
                            {
                                "target_lang_word": "stun",
                                "target_lang_sense_clarification": "to shock or amaze someone"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0aceb281-4e7f-3391-ba91-a8035d70562f",
                    "sense_definition": "iemand met fysiek geweld of grote overmacht onderwerpen of verslaan",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fysieke overmacht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bandieten <w>overweldigden</w> de nietsvermoedende man in het donkere steegje.",
                            "target_lang_translations": {
                                "en": "The bandits <w>overpowered</w> the unsuspecting man in the dark alley."
                            }
                        },
                        {
                            "text": "Het leger probeerde de vijand te <w>overweldigen</w> met een verrassingsaanval.",
                            "target_lang_translations": {
                                "en": "The army tried to <w>overwhelm</w> the enemy with a surprise attack."
                            }
                        }
                    ],
                    "synonyms": [
                        "onderwerpen",
                        "overmeesteren",
                        "verslaan"
                    ],
                    "common_phrases": [
                        "de vijand overweldigen"
                    ],
                    "target_lang_definitions": {
                        "en": "To subject or defeat someone using physical force or great superiority."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "overpower",
                                "target_lang_sense_clarification": "to defeat by greater strength"
                            },
                            {
                                "target_lang_word": "overwhelm",
                                "target_lang_sense_clarification": "to defeat with superior numbers or force"
                            },
                            {
                                "target_lang_word": "subdue",
                                "target_lang_sense_clarification": "to bring under control by force"
                            }
                        ]
                    }
                }
            ]
        }
    ]
