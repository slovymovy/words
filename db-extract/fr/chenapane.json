                        "entry_id": "53a5db72-95e4-3ddb-bb40-4a7d7fc1c0bd",
                        "glosses": [
                            "Coquine."
                        ],
                        "tags": [
                            "Colère ou ton amusé"
                        ],
                        "examples": [
                            {
                                "example_id": "acf42434-d529-41a3-96c0-3d98d910cb04",
                                "sense_id": "06d907e9-e8e7-3625-8e1d-877d0c06d2f2",
                                "text": "« J’ai l’impression maintenant que j’ai assemblé mes idées, de sortir d’une jungle épaisse où la lumière me venait obliquement et de très loin, alors qu’elle était toute proche», écrit de Kenora la jeune femme, qui signe « Ta chenapane », le 6 août 1947."
                            }
                        ]
                    }
