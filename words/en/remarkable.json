                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She showed <w>remarkable</w> talent for music at a very young age.",
                            "target_lang_translations": {
                                "ru": "Она проявила <w>выдающийся</w> музыкальный талант в очень юном возрасте.",
                                "tr": "Çok genç yaşta müziğe karşı <w>olağanüstü</w> bir yetenek gösterdi.",
                                "zh": "她年纪轻轻就展现出了<w>非凡的</w>音乐天赋。",
                                "de": "Sie zeigte schon in sehr jungen Jahren ein <w>bemerkenswertes</w> musikalisches Talent.",
                                "nl": "Ze toonde al op heel jonge leeftijd <w>opmerkelijk</w> muzikaal talent.",
                                "pl": "W bardzo młodym wieku wykazała się <w>wybitnym</w> talentem muzycznym.",
                                "fr": "Elle a fait preuve d'un talent <w>remarquable</w> pour la musique dès son plus jeune âge.",
                                "it": "Ha mostrato uno <w>straordinario</w> talento per la musica fin da giovanissima.",
                                "cs": "Již ve velmi mladém věku projevila <w>mimořádný</w> hudební talent.",
                                "es": "Ella mostró un talento <w>extraordinario</w> para la música a una edad muy temprana."
                            }
                        },
                        {
                            "text": "The scientist made a <w>remarkable</w> discovery that changed history.",
                            "target_lang_translations": {
                                "ru": "Учёный сделал <w>замечательное</w> открытие, которое изменило историю.",
                                "tr": "Bilim insanı tarihi değiştiren <w>kayda değer</w> bir keşif yaptı.",
                                "zh": "这位科学家做出了一个改变历史的<w>显著</w>发现。",
                                "de": "Der Wissenschaftler machte eine <w>bemerkenswerte</w> Entdeckung, die die Geschichte veränderte.",
                                "nl": "De wetenschapper deed een <w>opmerkelijke</w> ontdekking die de geschiedenis veranderde.",
                                "pl": "Naukowiec dokonał <w>niezwykłego</w> odkrycia, które zmieniło bieg historii.",
                                "fr": "Le scientifique a fait une découverte <w>remarquable</w> qui a changé le cours de l'histoire.",
                                "it": "Lo scienziato ha fatto una <w>notevole</w> scoperta che ha cambiato la storia.",
                                "cs": "Vědec učinil <w>pozoruhodný</w> objev, který změnil dějiny.",
                                "es": "El científico hizo un descubrimiento <w>notable</w> que cambió la historia."
                            }
                        }
