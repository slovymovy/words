                ],
                "senses": [
                    {
                        "sense_id": "497d1833-cf42-3f87-94a4-b23b738961c1",
                        "entry_id": "4967a99a-cbdc-3de3-9f5f-617934a113f8",
                        "glosses": [
                            "Faire perdre son caractère d’urbanisme anarchique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "159381b1-9caf-4c2e-a460-ccbb083575b0",
                                "sense_id": "497d1833-cf42-3f87-94a4-b23b738961c1",
                                "text": "Comment « débruxelliser » Bruxelles et éviter que d’autres villes connaissent un destin analogue ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "fe29d939-4d68-34d3-9944-8c8c7c9991c4",
                        "entry_id": "4967a99a-cbdc-3de3-9f5f-617934a113f8",
                        "glosses": [
                            "Faire perdre son caractère trop bruxellois à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "476ef909-1228-43e7-9571-51fa80115cd1",
                                "sense_id": "fe29d939-4d68-34d3-9944-8c8c7c9991c4",
                                "text": "Enfin, maintenant, on commence à débruxelliser, càd retirer certaines tours."
                            },
                            {
                                "example_id": "aa26ea45-5d2b-430b-9596-8597f7501fca",
                                "sense_id": "fe29d939-4d68-34d3-9944-8c8c7c9991c4",
                                "text": "Et « débruxelliser » ne signifie pas « pas d’Europe » mais, idéalement, une « Europe différente » (terme politiquement correct pour dire « Europe qui marche »)."
                            },
                            {
                                "example_id": "3ae09234-e818-4d4c-b339-297fdd5c3573",
                                "sense_id": "fe29d939-4d68-34d3-9944-8c8c7c9991c4",
                                "text": "En un mot il s’agit de « débruxelliser l’Europe », et et fédéraliser le national."
                            }
                        ]
                    }
                ],
