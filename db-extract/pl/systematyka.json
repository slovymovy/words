                    }
                ],
                "translations": [
                    {
                        "translation_id": "42d012ee-1fbd-4898-977e-10c911749e52",
                        "source_entry_id": "c9dd071b-5592-3d46-9027-54b63a3e287e",
                        "source_sense_id": "1385d194-2aff-380f-ae7a-03da7e0282a8",
                        "target_lang_word": "systematics",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "systematics",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e57990a5-3ddc-3c08-a9f2-302bbc025668",
                                        "entry_id": "91414181-1ca6-3620-8f15-83097f6fbfdd",
                                        "glosses": [
                                            "The study of classification systems and nomenclature."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9ea4db8-ac86-4e39-a532-1d3f00cd7a5a",
                                                "sense_id": "e57990a5-3ddc-3c08-a9f2-302bbc025668",
                                                "text": "Systematics is intended to be the study of \"qualitative\" and structural aspects of all things in the universe; and if feasible, is designed to absorb eventually the \"quantitative approach\" of mathematics toward human and physical worlds as well. It is hoped that systematics will be able to develop a quantitative field and thus to enable it to incorporate mathematics into its realm of studies some time in the future."
                                            },
                                            {
                                                "example_id": "9fd53baf-69a1-4169-9d01-bdc953c3b2dc",
                                                "sense_id": "e57990a5-3ddc-3c08-a9f2-302bbc025668",
                                                "text": "Trees are the central objects of systematic analysis. Taxa are ordered, characters explained, and hypotheses tested on trees. Since systematics informs and draws on other areas of science, there is a diversity of terminology for trees and their components."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b20679c3-1ba9-3b82-b032-6aad6fca5f2e",
                                        "entry_id": "91414181-1ca6-3620-8f15-83097f6fbfdd",
                                        "glosses": [
                                            "The classification system of a branch of science, especially the classification of organisms in biology."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "64fe7f12-3fd6-309a-9fe7-85bebdaa8045",
                                        "entry_id": "91414181-1ca6-3620-8f15-83097f6fbfdd",
                                        "glosses": [
                                            "A branch of Christian theology that formulates an orderly, rational, and coherent account of Christian beliefs. It comprises dogmatics, ethics and philosophy of religion."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65a9ccfb-a6f5-4b50-872d-0cfab31a94ec",
                                                "sense_id": "64fe7f12-3fd6-309a-9fe7-85bebdaa8045",
                                                "text": "Systematics is an effort to understand those specifically theological affirmations that the theologian holds to be true and so regards as doctrines."
                                            },
                                            {
                                                "example_id": "c640452d-266a-4562-8e25-6a7c8a5e2567",
                                                "sense_id": "64fe7f12-3fd6-309a-9fe7-85bebdaa8045",
                                                "text": "The seventh functional specialty, systematics, is concerned with promoting an understanding of the realitites affirmed in the previous specialty, doctrines."
                                            },
                                            {
                                                "example_id": "976dace5-2f25-4ed1-af2a-2083a8dc16ce",
                                                "sense_id": "64fe7f12-3fd6-309a-9fe7-85bebdaa8045",
                                                "text": "Not exegesis itself, then, but biblical theology, provides the material for systematics .... Bliblical theology is not, then, a rival of systematics; it is not even a parallel product of the same body of facts, provided by exegesis; it is the basis and source of systematics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99edb9e7-9341-3933-b56d-79f4a2f54cf0",
                                        "entry_id": "91414181-1ca6-3620-8f15-83097f6fbfdd",
                                        "glosses": [
                                            "The place where legal provisions stand as relevant for their interpretation."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c70043dd-77db-472e-bf04-57c941d90da7",
                                                "sense_id": "99edb9e7-9341-3933-b56d-79f4a2f54cf0",
                                                "text": "Different kinds of systematic interpretation of statutes affect each other. Construction of a statutory provision depends at the same time on interpretation of other provisions, systematics of the statute, conceptual analysis and theories formulated in legal dogmatics."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce031dd4-5a2f-4644-9e91-88e089ce3c48",
                        "source_entry_id": "c9dd071b-5592-3d46-9027-54b63a3e287e",
                        "source_sense_id": "1385d194-2aff-380f-ae7a-03da7e0282a8",
                        "target_lang_word": "systématique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "systématique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6154f649-3d33-32de-8051-155bb2faa6cc",
                                        "entry_id": "a0a6a551-abcc-3193-89eb-803366fceda8",
                                        "glosses": [
                                            "Qui appartient, qui se rapporte à un système."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "446826b6-f6cf-47e3-b48a-756724bb129d",
                                                "sense_id": "6154f649-3d33-32de-8051-155bb2faa6cc",
                                                "text": "Ordre systématique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b08f878-98b8-350e-ad6d-0e9f0992f495",
                                        "entry_id": "a0a6a551-abcc-3193-89eb-803366fceda8",
                                        "glosses": [
                                            "Qui se fait en toutes circonstances."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84f29687-cc1e-4095-b9a9-8737375e3d8d",
                                                "sense_id": "5b08f878-98b8-350e-ad6d-0e9f0992f495",
                                                "text": "Reconnaissons que l’infidélité plurielle, systématique, récurrente et assidue, est plus facilement revendiquée par les hommes, en particulier par ceux qui prônent le papillonnage érotico-relationnel, et qu'elle reste assez mal perçue chez les femmes, à qui l'on prête moins facilement le droit à de nombreuses aventures sans lendemain."
                                            },
                                            {
                                                "example_id": "775e088b-eb22-4ece-8803-2cb8d90432f8",
                                                "sense_id": "5b08f878-98b8-350e-ad6d-0e9f0992f495",
                                                "text": "Mais l’ancien Premier ministre britannique Tony Blair a mis les pieds dans le plat dimanche en estimant sur Sky News que seule une politique de ­dépistage systématique sur «pratiquement l’ensemble de la population» permettrait de contrôler l’épidémie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36dd534d-6053-3d94-be93-9ad220087ce9",
                                        "entry_id": "a0a6a551-abcc-3193-89eb-803366fceda8",
                                        "glosses": [
                                            "Qui tient à un système, qui repose sur ce système plutôt que sur les faits et sur l’expérience."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2c94df8-77f8-4606-9aa6-e89389afc836",
                                                "sense_id": "36dd534d-6053-3d94-be93-9ad220087ce9",
                                                "text": "Idées systématiques. — Opinion systématique. — Tout cela est purement systématique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5525d42-8b45-3e0a-a11d-087d37a93de2",
                                        "entry_id": "a0a6a551-abcc-3193-89eb-803366fceda8",
                                        "glosses": [
                                            "Qui construit des systèmes, qui procède par systèmes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cda0a30a-36d8-4de0-9780-499b636e025a",
                                                "sense_id": "d5525d42-8b45-3e0a-a11d-087d37a93de2",
                                                "text": "Nous avons voulu présenter une description aussi systématique et complète que possible de la grammaire japonaise."
                                            },
                                            {
                                                "example_id": "b245b561-e039-4367-b35c-e7142a213ebd",
                                                "sense_id": "d5525d42-8b45-3e0a-a11d-087d37a93de2",
                                                "text": "Écrivain systématique. — Esprit systématique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "faaa3973-1b1e-3e8d-831e-ef1be96c7443",
                                        "entry_id": "a0a6a551-abcc-3193-89eb-803366fceda8",
                                        "glosses": [
                                            "Délibéré et automatique."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac3a220c-f4c5-48da-8910-f5eeb30a85d3",
                                                "sense_id": "faaa3973-1b1e-3e8d-831e-ef1be96c7443",
                                                "text": "Une douzaine de jeune gens entouraient une sorte de croquant endimanché, coiffé d’un chapeau melon qui roulait des yeux ahuris et s’efforçait d’éviter la bousculade systématique dont il se voyait l’objet."
                                            },
                                            {
                                                "example_id": "6fb12f73-ec4e-4b3f-95ee-302c2921a59e",
                                                "sense_id": "faaa3973-1b1e-3e8d-831e-ef1be96c7443",
                                                "text": "La porte est ouverte à la « bête du Colorado » qui se propage rapidement en France, progressant en moyenne de 50 kilomètres par an, et ce, malgré des campagnes de ramassage systématique des insectes par les élèves des écoles communales."
                                            },
                                            {
                                                "example_id": "72847476-f7e9-46df-976b-aea8bab347a1",
                                                "sense_id": "faaa3973-1b1e-3e8d-831e-ef1be96c7443",
                                                "text": "Depuis 1980 la dérive des comptes publics fut systématique, quelle que soit la couleur politique des gouvernements."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "systématique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb7fa49f-2a5c-37bc-84cb-261754cc680f",
                                        "entry_id": "18864c7a-9d6f-320c-a10b-0766eaf2ec08",
                                        "glosses": [
                                            "Étude des systèmes et de leur nomenclature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "321d4a85-5b58-484a-a07c-4aff699af480",
                                                "sense_id": "cb7fa49f-2a5c-37bc-84cb-261754cc680f",
                                                "text": "[…] les études chimique et minéralogique assigneront une place définitive dans la systématique à cette roche qui était une des énigmes de la lithologie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "370bed07-e3d2-36ba-8539-445e535c4c4f",
                                        "entry_id": "18864c7a-9d6f-320c-a10b-0766eaf2ec08",
                                        "glosses": [
                                            "Science qui étudie la classification, les relations de parenté (phylogénie) et la nomenclature des êtres vivants."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc73067b-92f1-4c3a-8c08-14186d1db7eb",
                                                "sense_id": "370bed07-e3d2-36ba-8539-445e535c4c4f",
                                                "text": "Enfin, parmi les espèces connues, moins de 1 % ont bénéficié d’études dépassant le stade basique de leur seule description anatomique permettant de les classer dans la systématique linnéenne."
                                            },
                                            {
                                                "example_id": "8f628b8e-6288-46f1-abb7-4da44dee2972",
                                                "sense_id": "370bed07-e3d2-36ba-8539-445e535c4c4f",
                                                "text": "Les amateurs, […], ont été longtemps l’aile marchante de notre Société. Leur rôle considérable dans les progrès de la botanique en France a été surtout marqué en floristique et en systématique, ce qui s’explique par les possibilités mêmes de leur activité."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "systématique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6172bc2d-d481-326c-a294-4d5dfb18e8f1",
                                        "entry_id": "0470d2c0-0bc1-34d6-9b09-5f95a48b96d4",
                                        "glosses": [
                                            "Personne dominée par l’esprit de système, enfermée dans les théories a priori ; personne attachée à l’élaboration de systèmes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b20b3bbb-b4b1-4053-96e3-53c585c13c72",
                                                "sense_id": "6172bc2d-d481-326c-a294-4d5dfb18e8f1",
                                                "text": "Marat n’était qu’un systématique insensé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "162703ea-f2fc-4d85-ac00-c8a0dd1d1f93",
                        "source_entry_id": "c9dd071b-5592-3d46-9027-54b63a3e287e",
                        "source_sense_id": "1385d194-2aff-380f-ae7a-03da7e0282a8",
                        "target_lang_word": "Systematik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Systematik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "19e9bdf6-fa4b-35f5-aaed-2bf4f7f550b6",
                                        "entry_id": "da13ed3c-3436-32d5-860d-afa2d70f6286",
                                        "glosses": [
                                            "planmäßige, einheitliche Darstellung in Klassen, Kategorien oder anderen abstrakten Konzepten, die bestimmten Ordnungsprinzipien, einem System folgen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b25f64c-358a-474e-94b6-64d9392e880d",
                                                "sense_id": "19e9bdf6-fa4b-35f5-aaed-2bf4f7f550b6",
                                                "text": "„Innerhalb einer Systematik gibt es die Gruppen ‚Allgemeines’ und ‚Sonstiges’.“ (Internetbeleg)"
                                            },
                                            {
                                                "example_id": "ce0e5d78-9eb6-4706-bca6-101df6d7be48",
                                                "sense_id": "19e9bdf6-fa4b-35f5-aaed-2bf4f7f550b6",
                                                "text": "Machen Sie einen Kurs in Buchhaltung, und dann werden Sie die Systematik schnell durchschauen."
                                            },
                                            {
                                                "example_id": "ecf6df83-5d89-4049-a0f1-a8ea77a98b0c",
                                                "sense_id": "19e9bdf6-fa4b-35f5-aaed-2bf4f7f550b6",
                                                "text": "„Diese Systematik der Namensgebung sorgt natürlich für Unordnung.“"
                                            },
                                            {
                                                "example_id": "2434d2a2-e3f7-458c-8c2e-550b608e63dc",
                                                "sense_id": "19e9bdf6-fa4b-35f5-aaed-2bf4f7f550b6",
                                                "text": "„Die neuere Systematik teilt die Primaten in vier Unterordnungen: Lemuroidea oder Lemuren, Galagoidea oder Buschbabys und Loris, Tarsioidea oder Gespenstmakis und Simiae oder Affen.“"
                                            },
                                            {
                                                "example_id": "8a2e29a5-bb1b-4f32-b4ff-a51c86d0e82e",
                                                "sense_id": "19e9bdf6-fa4b-35f5-aaed-2bf4f7f550b6",
                                                "text": "„Nur Sade konnte diese Systematik der Psychopathia sexualis liefern.“"
                                            }
