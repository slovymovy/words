                        "entry_id": "06e240a5-d3c6-3946-8a60-d02a948221bd",
                        "glosses": [
                            "Expert indépendant chargé de contrôler les comptes annuels des entreprises."
                        ],
                        "tags": [
                            "Belgique",
                            "Luxembourg"
                        ],
                        "examples": []
                    }
