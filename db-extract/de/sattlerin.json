                                "example_id": "955cf9d6-9c3b-4547-bafa-42b1eae919c7",
                                "sense_id": "81332e15-553b-3417-b312-d4194fb7d0bd",
                                "text": "Als Sattlerin kann sie den Sattel für das Pony formgenau anpassen."
                            },
                            {
                                "example_id": "dabc237c-1f4b-40b3-a15f-e436f032bfea",
                                "sense_id": "81332e15-553b-3417-b312-d4194fb7d0bd",
                                "text": "„Die Entscheidung, Sattlerin zu werden, hat sich über Jahre hinweg gezogen.“"
                            }
