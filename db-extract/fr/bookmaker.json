                "senses": [
                    {
                        "sense_id": "d202eba9-deb1-384c-ac54-c9c339fee5f1",
                        "entry_id": "e96c2af8-1a10-3e2a-a723-1b83d57dfbda",
                        "glosses": [
                            "Celui qui fait métier d’accepter les paris à la cote dans les courses de chevaux et qui les inscrit sur un livre."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "b42b28a3-e8b2-4499-837f-f0823f76ca37",
                                "sense_id": "d202eba9-deb1-384c-ac54-c9c339fee5f1",
                                "text": "Les individus qui spéculent sur les courses sont appelés Bookmakers, et les paris sont inscrits sur un livre officiel que l’on appelle Betting-Book."
                            },
                            {
                                "example_id": "59a599c2-81fc-4808-bc2b-cd152a184a37",
                                "sense_id": "d202eba9-deb1-384c-ac54-c9c339fee5f1",
                                "text": "Il avait gâté son coup superbe par une plate bêtise, un vol idiot, en chargeant Maréchal, un bookmaker véreux, de donner pour son compte deux mille louis contre Lusignan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ffd9284-0ba7-48bc-953e-dcd4e628db75",
                        "source_entry_id": "e96c2af8-1a10-3e2a-a723-1b83d57dfbda",
                        "source_sense_id": "d202eba9-deb1-384c-ac54-c9c339fee5f1",
                        "target_lang_word": "Buchmacher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Buchmacher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c444983-b820-334f-8833-fa8fdeba5fa6",
                                        "entry_id": "b38bf072-8d3f-3008-8000-5fae32e68bdf",
                                        "glosses": [
                                            "ein Wettmann, der Wetten mit festen oder variablen Quoten auf Ausgänge von zukünftigen Ereignissen insbesondere von sportlichen Veranstaltungen offeriert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ff64255-facc-4bd9-9ad5-48ac8ca49d59",
                                                "sense_id": "3c444983-b820-334f-8833-fa8fdeba5fa6",
                                                "text": "„Ich griff zum Telefon und rief meinen Buchmacher an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6687b41-0a55-4613-828d-616b2875b7f5",
                        "source_entry_id": "e96c2af8-1a10-3e2a-a723-1b83d57dfbda",
                        "source_sense_id": "d202eba9-deb1-384c-ac54-c9c339fee5f1",
                        "target_lang_word": "Buchmacherin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Buchmacherin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d3f3486d-71df-3413-8d06-6f72beb37e08",
                                        "entry_id": "f12191f7-5357-3c37-893a-de44d7734792",
                                        "glosses": [
                                            "weibliche Person, der Wetten mit festen oder variablen Quoten auf Ausgänge von zukünftigen Ereignissen insbesondere von sportlichen Veranstaltungen offeriert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5665f86-daf7-4831-894e-0aea86ba0368",
                                                "sense_id": "d3f3486d-71df-3413-8d06-6f72beb37e08",
                                                "text": "„7. Angaben zu Veranstaltern, an die vermittelt werden soll",
                                                "translation": "Auflistung der Rennvereine, Totalisatoren und / oder Buchmacherinnen / Buchmacher, an die Wetten vermittelt werden. (Falls Platz nicht ausreicht, bitte Beiblatt verwenden. Bitte beachten Sie, dass ggf. die Vorlage der jeweiligen Erlaubnis nachgefordert wird!)“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1617d6ab-4503-4016-bd3a-8eca5a2e44b2",
                        "source_entry_id": "e96c2af8-1a10-3e2a-a723-1b83d57dfbda",
                        "source_sense_id": "d202eba9-deb1-384c-ac54-c9c339fee5f1",
                        "target_lang_word": "bookie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bookie",
