                    {
                        "translation_id": "c3019fb9-0528-4955-af55-7a0f19076d73",
                        "source_entry_id": "c848e270-c00f-3414-bd3f-ba500d3c489e",
                        "source_sense_description": "one who decorates",
                        "target_lang_word": "décorateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décorateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9a626352-95b4-3420-80fd-4bbf60e7d043",
                                        "entry_id": "566d549f-8281-3f85-ab00-3d4cfc74887b",
                                        "glosses": [
                                            "Personne qui fait des travaux de décoration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc5c27b6-620e-48fc-84bb-7c1518845bd1",
                                                "sense_id": "9a626352-95b4-3420-80fd-4bbf60e7d043",
                                                "text": "Pour Manuela, un décorateur est un être éthéré qui dispose des coussins sur des canapés dispendieux et recule de deux pas pour en admirer l’effet."
                                            },
                                            {
                                                "example_id": "9fccfb5c-3238-41b9-b112-bc47ee3b4357",
                                                "sense_id": "9a626352-95b4-3420-80fd-4bbf60e7d043",
                                                "text": "Seul un décorateur apte à appréhender correctement ces divers aspects pourra fournir une réalisation réellement innovante."
                                            },
                                            {
                                                "example_id": "3da82ccb-991d-40d5-b819-a455f060bdc8",
                                                "sense_id": "9a626352-95b4-3420-80fd-4bbf60e7d043",
                                                "text": "Je traçai mon chemin dans le couloir aux murs peints d'un rose pissouille que les décorateurs des taules à macchabées surutilisent."
                                            },
                                            {
                                                "example_id": "88e0d9bd-aa7a-46b9-9424-681bca444d0f",
                                                "sense_id": "9a626352-95b4-3420-80fd-4bbf60e7d043",
                                                "text": "Le visiteur découvre les multiples talents de Mathurin Méheut, à la fois peintre, décorateur, illustrateur, céramiste et sculpteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adac2a22-3107-37aa-bd7f-e19ea7beb492",
                                        "entry_id": "566d549f-8281-3f85-ab00-3d4cfc74887b",
                                        "glosses": [
                                            "Dans le langage de programmation Python, objet appelable qui est utilisé pour modifier la définition d’une fonction, d’une méthode ou d’une classe."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "12a5688b-95ab-4d36-8800-647d1733cfaa",
