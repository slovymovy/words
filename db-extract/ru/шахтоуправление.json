                                        "entry_id": "3c4a7584-654b-33e0-bc55-3bcdfe59fc0c",
                                        "glosses": [
                                            "To dig away, or otherwise remove, the substratum or foundation of; to lay a mine under; to sap; to undermine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de9d1ee9-9387-4654-ad4d-0962f5d2c143",
                                                "sense_id": "3e77559b-af62-39e2-aabe-f8eba987dfad",
                                                "text": "They mined the walls."
                                            },
