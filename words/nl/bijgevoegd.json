            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4abcca79-d28a-3f2a-a063-7e92508707e7",
                    "sense_definition": "als bijlage aan een brief, e-mail of ander document toegevoegd",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bijgevoegd_als_bijlage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de <w>bijgevoegde</w> offerte doen wij u een passend voorstel voor de meubels.",
                            "target_lang_translations": {
                                "en": "In the <w>attached</w> quotation, we make you a suitable proposal for the furniture."
                            }
                        },
                        {
                            "text": "U kunt alle details nalezen in het <w>bijgevoegde</w> document bij deze e-mail.",
                            "target_lang_translations": {
                                "en": "You can read all the details in the document <w>attached</w> to this email."
                            }
                        }
                    ],
                    "synonyms": [
                        "bijgesloten",
                        "ingesloten"
                    ],
                    "common_phrases": [
                        "het bijgevoegde document",
                        "de bijgevoegde brief"
                    ],
                    "target_lang_definitions": {
                        "en": "added as an attachment or enclosure to a letter, email, or other document"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "attached",
                                "target_lang_sense_clarification": "to an email or document"
                            },
                            {
                                "target_lang_word": "enclosed",
                                "target_lang_sense_clarification": "in a letter or package"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "69fa1657-c845-343e-b391-75339b75dfc7",
                    "sense_definition": "voltooid deelwoord van <w>bijvoegen</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bijgevoegd_vorm_van_bijvoegen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De notaris heeft een kopie van het testament aan het dossier <w>bijgevoegd</w>.",
                            "target_lang_translations": {
                                "en": "The civil-law notary has <w>added</w> a copy of the will to the file."
                            }
                        },
                        {
                            "text": "Hij heeft nog een aantal ontbrekende bonnetjes aan de declaratie <w>bijgevoegd</w>.",
                            "target_lang_translations": {
                                "en": "He <w>attached</w> several missing receipts to the expense claim."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "past participle of bijvoegen: added, attached, or enclosed"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "attached",
                                "target_lang_sense_clarification": "added to a file, email, or document"
                            },
                            {
                                "target_lang_word": "enclosed",
                                "target_lang_sense_clarification": "included with a document or letter"
                            },
                            {
                                "target_lang_word": "added",
                                "target_lang_sense_clarification": "appended to something"
                            }
                        ]
                    }
                }
            ]
        }
    ]
