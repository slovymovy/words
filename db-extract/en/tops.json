                                    {
                                        "sense_id": "396d6c3b-1308-33bf-a15a-b9f4b79254b2",
                                        "entry_id": "dfcab49d-b00f-346d-8ff0-5ea4c2481c76",
                                        "glosses": [
                                            "het grootst mogelijk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb722e9f-84c7-4f53-a484-3db4b584d6fe",
                                                "sense_id": "396d6c3b-1308-33bf-a15a-b9f4b79254b2",
                                                "text": "Lees tips over het bepalen van de hoogte van een hypotheek en hoe je de maximale hypotheek kunt berekenen."
                                            },
                                            {
                                                "example_id": "b6695d44-fbb4-4e9c-900b-784446f55608",
                                                "sense_id": "396d6c3b-1308-33bf-a15a-b9f4b79254b2",
                                                "text": "Het STAP-budget is bedoeld om werkenden en werkzoekenden te stimuleren zich te laten om- of bijscholen. Wie aan de voorwaarden voldoet, kan een tegemoetkoming in de studiekosten ontvangen van maximaal 1.000 euro per jaar. Voorwaarde is wel dat de opleiding is gericht op huidig of toekomstig werk."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "maximaal",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "46465997-e772-3c11-acc1-d91fa18db560",
                                        "entry_id": "0d5c10a0-c945-3fc3-b225-81e03769160f",
                                        "glosses": [
                                            "ten hoogste"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02c873f1-3495-4ffc-bcc5-8b787b1c2931",
                                                "sense_id": "46465997-e772-3c11-acc1-d91fa18db560",
                                                "text": "Er mogen maximaal twee huisdieren gehouden worden."
                                            },
                                            {
                                                "example_id": "71bc2220-397b-4e52-a7d9-c05ee5d9da7e",
                                                "sense_id": "46465997-e772-3c11-acc1-d91fa18db560",
                                                "text": "Een Australische jongen had me aan de bar in Tehachapi een vraag gesteld die me bleef achtervolgen: ’Wat is de langste tijd dat je ooit totaal alleen bent geweest?’ Zelfs op de trail kwam ik niet verder dan 36 uur, maximaal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87d104a8-fd35-49c9-b894-f47753391518",
                        "source_entry_id": "20700070-fe6f-31dc-900f-964bfd552f5a",
                        "source_sense_id": "542e5da4-a6a7-3b13-b452-9b29beb7b293",
