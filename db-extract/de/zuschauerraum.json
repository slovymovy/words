                        "target_lang_word": "hlediště",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hlediště",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "e31cb559-40e6-36a7-883c-74ec0107c30e",
                                        "entry_id": "da8587d0-b5f6-334b-8468-7c8929420fd6",
                                        "glosses": [
                                            "část divadelního sálu vyhrazená pro diváky představení"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1bb3f88-8544-4f10-a661-24579132eebf",
                                                "sense_id": "e31cb559-40e6-36a7-883c-74ec0107c30e",
                                                "text": "Hlediště bylo narváno k prasknutí."
                                            },
                                            {
                                                "example_id": "224f2f3e-3c63-44ab-941f-84e80af88e86",
                                                "sense_id": "e31cb559-40e6-36a7-883c-74ec0107c30e",
                                                "text": "V antickém Řecku se vyvinul klasický divadelní prostor se speciálně vybudovaným hledištěm i jevištěm, zprvu jenom dřevěným a příležitostně budovaným, posléze kamenným a tedy stálým."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f648245c-b629-3bb3-972e-4e3cbc4de63f",
                                        "entry_id": "da8587d0-b5f6-334b-8468-7c8929420fd6",
                                        "glosses": [
                                            "diváci resp. posluchači v hledišti (1)"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bedc1fb3-2430-43fb-9dbd-5118b1f54ba6",
                                                "sense_id": "f648245c-b629-3bb3-972e-4e3cbc4de63f",
                                                "text": "Hlediště se smálo a výskalo nadšením."
                                            },
                                            {
                                                "example_id": "c624fd9d-c728-4aa2-84f9-6d5c4b49e1e1",
                                                "sense_id": "f648245c-b629-3bb3-972e-4e3cbc4de63f",
                                                "text": "Nakonec se ukázalo, že pěkný hovno, ten kůň neuměl počítat ani trochu . Prostě jenom klepal kopytem, dokud necejtil, že napětí v hledišti povolilo. Jakmile vyklepal správný číslo, všem se ulevilo, on to vycejtil a přestal klepat ."
                                            },
                                            {
                                                "example_id": "a7e35c96-e86b-4457-a689-27e0ff4d440d",
                                                "sense_id": "f648245c-b629-3bb3-972e-4e3cbc4de63f",
                                                "text": "K nažhavení Simple Minds nepotřebovali předkapelu ani čas na rozjezd. Energetické toky mezi jevištěm a hledištěm fungovaly od prvního do posledního tónu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
