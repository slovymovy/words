                "senses": [
                    {
                        "sense_id": "899d57ea-b69b-3f2e-ad64-3b5a28d30499",
                        "entry_id": "279bd59f-8bea-3563-bcbb-b495d1029ee8",
                        "glosses": [
                            "das von Kunst geprägte Ambiente eines Ortes"
                        ],
                        "tags": [
                            "bildlich"
                        ],
                        "examples": [
                            {
                                "example_id": "828e2766-16d7-4ed2-a9a4-744a20efca5e",
                                "sense_id": "899d57ea-b69b-3f2e-ad64-3b5a28d30499",
                                "text": "„Zwangslos Kunstluft schnuppern und Kunst da erleben, wo sie entsteht: Die Künstler des Stroppelareals öffneten am Wochenende die Pforten ihrer Ateliers und gewährten Interessierten Einblicke in ihr Schaffen.“"
                            },
                            {
                                "example_id": "49ab3b7d-16d2-4adb-a93a-1a6a510effbf",
                                "sense_id": "899d57ea-b69b-3f2e-ad64-3b5a28d30499",
                                "text": "„Schüler schnuppern Kunstluft im Burgmuseum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "439275e4-b037-3670-8040-4cca3ed2c1f4",
                        "entry_id": "279bd59f-8bea-3563-bcbb-b495d1029ee8",
                        "glosses": [
                            "mit Hilfe einer Klimaanlage gekühlte Luft"
                        ],
                        "tags": [
                            "polemisch"
                        ],
                        "examples": [
                            {
                                "example_id": "c4d2636d-d38d-44ce-a1a1-4526aaf594da",
                                "sense_id": "439275e4-b037-3670-8040-4cca3ed2c1f4",
                                "text": "„Vor zwei Jahren brüstete sich das Palazzo Versace Hotel in Dubai mit dem ersten klimatisierten Strand der Welt, und in Singapur erlaubt die kalte Kunstluft das Tragen populärer westlicher Garderobe in Schwarz.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "31743cac-792f-4617-b29d-45beb58d442d",
                        "source_entry_id": "279bd59f-8bea-3563-bcbb-b495d1029ee8",
                        "source_sense_id": "899d57ea-b69b-3f2e-ad64-3b5a28d30499",
                        "source_sense_description": "bildlich: das von Kunst geprägte Ambiente eines Ortes",
                        "target_lang_word": "arty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arty",
