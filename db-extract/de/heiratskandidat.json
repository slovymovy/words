                "senses": [
                    {
                        "sense_id": "6529de1c-534b-3c8d-bc2e-c1b504916af0",
                        "entry_id": "baa21c2f-8eb1-3269-b3bf-40d478795d9d",
                        "glosses": [
                            "Person, die heiraten soll/wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6326186-63ea-4f08-b256-2635620bcfb9",
                                "sense_id": "6529de1c-534b-3c8d-bc2e-c1b504916af0",
                                "text": "„So kommt ein Heiratskandidat in das Elternhaus der jungen Dame, und während sie im Wohnzimmer auf den Eintritt der Familie warten, deutet der Vermittler auf eine Vitrine mit teuren Silbergeräten, um den Reichtum der Herrschaften herauszustreichen.“"
                            },
                            {
                                "example_id": "5622ad01-89b0-4f51-9b1a-b8767c219ab6",
                                "sense_id": "6529de1c-534b-3c8d-bc2e-c1b504916af0",
                                "text": "„Der weiteren Verwandtschaft galt er als ein hübscher Husarenoffizier, ein flotter Tänzer und einer der besten Heiratskandidaten von Moskau.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
