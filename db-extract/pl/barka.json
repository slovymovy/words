                                        "entry_id": "76e9de06-f90f-3505-95dd-ac6a61f8636b",
                                        "glosses": [
                                            "плоскодонное, обычно несамоходное судно для перевозки грузов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89ccafbd-f12e-4e3c-81dc-2da93fdb5760",
                                                "sense_id": "4b86821d-2983-3254-8658-253952a9c3c3",
                                                "text": "В речном порту разгружали баржи с ящиками снарядов, а на дровяном складе освобождали товарняки от дров."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
