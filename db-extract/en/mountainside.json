                                                "sense_id": "c7c2ef27-56da-32e3-b54c-d0b0f803fe51",
                                                "text": "„Da lag den Berghang hinauf ein Dorf.“"
                                            },
                                            {
                                                "example_id": "6dcf91e4-fe93-413e-9898-b86200f5e9cc",
                                                "sense_id": "c7c2ef27-56da-32e3-b54c-d0b0f803fe51",
                                                "text": "„Dann lege ich das Magazin weg, stehe auf, gehe ans Fenster und schaue hinaus auf den stillen Fjord und den Berghang auf der gegenüberliegenden Seite.“"
                                            }
