                        "cross_references": [
                            {
                                "target_word": "Redegewandtheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3ca83a4a-8efc-3a46-911d-e1e0fabc1ae4",
                                        "entry_id": "e9beac13-743d-3e20-a9b0-a20b96efac34",
                                        "glosses": [
                                            "Fähigkeit, angemessen und geschickt zu reden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad791df3-f6e0-4663-a94c-1f1f445a07af",
                                                "sense_id": "3ca83a4a-8efc-3a46-911d-e1e0fabc1ae4",
                                                "text": "„Es wurde eine Weile hin und her beraten und schließlich einer, der über besondere Redegewandtheit verfügte, zum Unterhändler gewählt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
