{
    "word_family": [
        "flauw",
        "flauwerik"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ae6a5a4a-866d-3698-8569-a8526da2493b",
                    "sense_definition": "Iets wat in geen enkel opzicht zinvol is of betekenis heeft; onzinnige praat of handelingen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "nonsense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik wil die <w>flauwekul</w> niet meer horen, vertel me nu de waarheid.",
                            "target_lang_translations": {
                                "en": "I don't want to hear that <w>nonsense</w> anymore, tell me the truth now."
                            }
                        },
                        {
                            "text": "Als ze nu eens zouden beginnen al die administratieve <w>flauwekul</w> af te schaffen, zou er minder stress zijn.",
                            "target_lang_translations": {
                                "en": "If they would just start by abolishing all that administrative <w>rubbish</w>, there would be less stress."
                            }
                        }
                    ],
                    "synonyms": [
                        "onzin",
                        "nonsens",
                        "lariekoek",
                        "kletspraat",
                        "kletskoek"
                    ],
                    "common_phrases": [
                        "administratieve flauwekul",
                        "wat een flauwekul"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used in informal spoken language"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Something that is in no way meaningful or significant; nonsensical talk or actions."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nonsense",
                                "target_lang_sense_clarification": "silly or illogical ideas or behavior"
                            },
                            {
                                "target_lang_word": "rubbish",
                                "target_lang_sense_clarification": "worthless talk or ideas"
                            },
                            {
                                "target_lang_word": "claptrap",
                                "target_lang_sense_clarification": "absurd or pretentious talk"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74b41d73-2a88-35e7-8c84-69cf760b5d83",
                    "sense_definition": "Betekenisloze woorden of onzinpraat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nonsense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Geloof hem niet, want hij praat alleen maar <w>flauwekul</w>.",
                            "target_lang_translations": {
                                "en": "Don't believe him, because he is only talking <w>nonsense</w>."
                            }
                        },
                        {
                            "text": "Het hele verhaal bleek achteraf pure <w>flauwekul</w> te zijn.",
                            "target_lang_translations": {
                                "en": "The whole story turned out to be pure <w>baloney</w> afterwards."
                            }
                        }
                    ],
                    "synonyms": [
                        "onzin",
                        "nonsens",
                        "lariekoek",
                        "kletspraat"
                    ],
                    "common_phrases": [
                        "pure flauwekul"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used in informal spoken language"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Meaningless words or foolish talk."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nonsense",
                                "target_lang_sense_clarification": "spoken or written words that make no sense"
                            },
                            {
                                "target_lang_word": "baloney",
                                "target_lang_sense_clarification": "foolish or deceptive talk"
                            },
                            {
                                "target_lang_word": "gibberish",
                                "target_lang_sense_clarification": "unintelligible or meaningless speech"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b46687e3-a6ee-363d-a91a-5aefcfdffdc0",
                    "sense_definition": "Leverworst in het zuur met een uitje, die als snack vooral in Amsterdam populair was.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vroeger kon je in Amsterdam op de markt een portie <w>flauwekul</w> bestellen.",
                            "target_lang_translations": {
                                "en": "In the past, you could order a portion of <w>pickled liverwurst</w> at the market in Amsterdam."
                            }
                        },
                        {
                            "text": "Mijn grootvader vertelde wel eens over de <w>flauwekul</w> die ze na de film aten.",
                            "target_lang_translations": {
                                "en": "My grandfather used to tell stories about the <w>pickled liverwurst snack</w> they ate after the movie."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Mainly used in Amsterdam"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "Popular before World War II"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A traditional Amsterdam snack consisting of pickled liverwurst with onions."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pickled liverwurst snack",
                                "target_lang_sense_clarification": "traditional Amsterdam dish of pickled liver sausage with onions"
                            }
                        ]
                    }
                }
            ]
        }
