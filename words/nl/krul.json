                                "target_lang_sense_clarification": "an ornamental curve or decoration"
                            },
                            {
                                "target_lang_word": "swirl",
                                "target_lang_sense_clarification": "a twisting or spiraling shape"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88afc3ad-2ec6-362b-ad5f-0d8d9bcc65df",
                    "sense_definition": "een geschreven symbool in de vorm van een lus dat door leraren wordt gebruikt om aan te geven dat een antwoord goed is",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "symbool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leraar zette een grote rode <w>krul</w> naast mijn goede antwoord.",
                            "target_lang_translations": {
                                "en": "The teacher put a large red <w>tick</w> next to my correct answer."
                            }
                        },
                        {
                            "text": "Ik was blij toen ik zag dat er een <w>krul</w> bij mijn huiswerk stond.",
                            "target_lang_translations": {
                                "en": "I was happy when I saw there was a <w>mark of approval</w> on my homework."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een krul zetten"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Voornamelijk gebruikt in Nederland"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a written symbol in the form of a loop used by teachers to indicate a correct answer"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flourish of approval",
                                "target_lang_sense_clarification": "a specific Dutch marking symbol (krul)"
                            },
                            {
                                "target_lang_word": "tick",
                                "target_lang_sense_clarification": "the English equivalent for marking something as correct"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4c59483-eebf-33f8-98ad-7ee5dab40b53",
                    "sense_definition": "het gekrulde uiteinde van de hals van een strijkinstrument zoals een viool",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "muziek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>krul</w> van de viool was prachtig uit hout gesneden.",
                            "target_lang_translations": {
                                "en": "The <w>scroll</w> of the violin was beautifully carved out of wood."
                            }
                        },
                        {
                            "text": "Bij het stemmen van de cello hield hij de <w>krul</w> stevig vast.",
                            "target_lang_translations": {
                                "en": "While tuning the cello, he held the <w>scroll</w> firmly."
                            }
                        }
                    ],
                    "common_phrases": [
                        "krul van de viool"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technische term in de instrumentbouw"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the curled end of the neck of a string instrument such as a violin"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scroll",
                                "target_lang_sense_clarification": "the decorative carved end of a violin's neck"
                            }
                        ]
                    }
                },
                {
