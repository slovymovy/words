                        "tags": [],
                        "examples": [
                            {
                                "example_id": "663c3d06-d00f-4331-b9ba-baae18376815",
                                "sense_id": "b8c90ded-20a0-3b5c-9100-581733745e8f",
                                "text": "Le pied de la pholiote écailleuse est muni d’un anneau ; il est lisse dans sa partie supérieure et couvert d’écailles sous celui-ci."
                            }
                        ]
                    },
                    {
