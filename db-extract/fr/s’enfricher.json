                ],
                "senses": [
                    {
                        "sense_id": "ce118324-b715-3360-9b55-03f8076e6e8a",
                        "entry_id": "81a61838-4313-3369-82fd-27405230d47b",
                        "glosses": [
                            "Passer progressivement à l'état de friche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87a6617b-eb23-495b-aecc-cf365ea4b689",
                                "sense_id": "ce118324-b715-3360-9b55-03f8076e6e8a",
                                "text": "Mais beaucoup de propriétaires les obligent à prendre en même temps des terrains de parcours qui resteront sous-utilisés et auront tendance à s’enfricher."
                            },
                            {
                                "example_id": "c948534d-01b8-484a-a090-d80d806da08d",
                                "sense_id": "ce118324-b715-3360-9b55-03f8076e6e8a",
                                "text": "Situées entre les zones des fonds de vallées et les pâturages d'estives qui ont fait l'objet de nombreuses améliorations pastorales, elles ont tendance à s’enfricher rapidement, par suite d’une sous-exploitation."
                            },
                            {
                                "example_id": "284f8cac-1e14-465e-958d-d189e79b7c38",
                                "sense_id": "ce118324-b715-3360-9b55-03f8076e6e8a",
                                "text": "De sorte que le petit vallon herbu, autrefois pâturé et fauché (il y avait même le regain en août à cause de la fraîcheur du lieu), s’était enfriché au point de devenir difficile de pénétration et par endroit, inextricable."
                            }
                        ]
                    }
                ],
