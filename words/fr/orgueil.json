    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c4f088f1-5016-3f15-acac-a9b4d6565229",
                    "sense_definition": "Opinion très avantageuse, le plus souvent exagérée, qu'une personne a de sa propre valeur aux dépens d'autrui.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "defaut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son <w>orgueil</w> démesuré l'empêche souvent d'admettre ses erreurs devant les autres."
                        },
                        {
                            "text": "Cette remarque désobligeante a profondément blessé son <w>orgueil</w> lors de la réunion."
                        }
                    ],
                    "synonyms": [
                        "arrogance",
                        "vanité",
                        "suffisance"
                    ],
                    "antonyms": [
                        "humilité",
                        "modestie"
                    ],
                    "common_phrases": [
                        "blesser son orgueil",
                        "péché d'orgueil"
                    ]
                },
                {
                    "sense_id": "ac12abc0-ff89-34ee-bea2-494815eb8e96",
                    "sense_definition": "Sentiment noble de dignité personnelle et de juste fierté qui préserve de la bassesse.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "qualite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il refuse toute charité car il a encore son <w>orgueil</w> et son indépendance."
                        },
                        {
                            "text": "Elle contemplait avec un légitime <w>orgueil</w> les résultats remarquables de son travail acharné."
                        }
                    ],
                    "synonyms": [
                        "fierté",
                        "amour-propre",
                        "dignité"
                    ],
                    "antonyms": [
                        "honte",
                        "bassesse"
                    ],
                    "common_phrases": [
                        "avoir son orgueil"
                    ]
                },
                {
                    "sense_id": "7878a58b-e3c0-3f6d-937a-af8af320242e",
                    "sense_definition": "Cale résistante placée sous un levier ou une pince pour lui servir de point d'appui.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "outil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le maçon a placé un solide <w>orgueil</w> sous son levier pour soulever la pierre."
                        },
                        {
                            "text": "Sans cet <w>orgueil</w> en bois dur, le levier risquerait de glisser sous la charge."
                        }
                    ],
                    "synonyms": [
                        "cale"
                    ]
                }
            ]
        },
