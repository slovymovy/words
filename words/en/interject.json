    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6275c58b-a7b7-3c21-ba6e-30a0eb746637",
                    "sense_definition": "To say something suddenly as an interruption during a conversation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "interruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>interjected</w> a quick comment while the speaker was pausing for breath."
                        },
                        {
                            "text": "He <w>interjected</w> a brief remark to clarify the situation during the meeting."
                        }
                    ],
                    "common_phrases": [
                        "interject a comment",
                        "interject a remark"
                    ]
                },
                {
                    "sense_id": "29fd2094-acdb-31d6-9684-9146a712b054",
                    "sense_definition": "To place or insert something between other things.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "insertion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor decided to <w>interject</w> a short explanation between the two main paragraphs."
                        },
                        {
                            "text": "It is helpful to <w>interject</w> relevant examples into the text to improve clarity."
                        }
                    ],
                    "synonyms": [
                        "insert"
                    ]
                },
                {
                    "sense_id": "0fbac152-50e7-3181-848f-f77c880df424",
                    "sense_definition": "To place oneself between others to intervene.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "intervention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mediator had to <w>interject</w> to prevent the argument from escalating further."
                        },
                        {
                            "text": "He felt compelled to <w>interject</w> when he saw the unfair treatment of his colleague."
                        }
                    ],
                    "synonyms": [
                        "interpose",
                        "intervene"
                    ]
                }
            ]
        }
    ]
