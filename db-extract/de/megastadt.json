                        "glosses": [
                            "Stadt, die zehn Millionen oder mehr Einwohner hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3030e5d5-927d-48f3-b7bd-3aa46d3cf645",
                                "sense_id": "2ec469dd-a050-32fd-81d6-3e8c69eed0dc",
                                "text": "„Obwohl es sich bei dem Schiff praktisch um eine hochseetaugliche Raumstation handelt - in gleißendem Polarweiß gestrichen und nur wenig kleiner als Long Island -, ist der zentrale Salon nach dem Vorbild einer typischen Bretterbude gestaltet, wie man sie in den Favelas der meisten Megastädte der Dritten Welt antrifft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
