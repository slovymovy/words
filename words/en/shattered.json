                    "frequency": "Middle",
                    "semantic_group_id": "broken_emotional",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was absolutely <w>shattered</w> by the news of the accident.",
                            "target_lang_translations": {
                                "ru": "Она была совершенно <w>потрясена</w> известием об аварии.",
                                "cs": "Zpráva o té nehodě ji naprosto <w>zdrtila</w>."
                            }
                        },
                        {
                            "text": "He felt <w>shattered</w> and alone after his best friend moved away.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя <w>раздавленным</w> и одиноким после того, как его лучший друг уехал.",
                                "cs": "Poté, co se jeho nejlepší přítel odstěhoval, se cítil <w>zdrcený</w> a osamělý."
                            }
                        }
