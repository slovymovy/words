                "senses": [
                    {
                        "sense_id": "9cd55237-7398-30d1-ae38-97a3988218d3",
                        "entry_id": "70e47705-a64d-3416-bb08-eb86e4701d51",
                        "glosses": [
                            "In a putative manner; according to belief."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65dd2961-2a38-4e68-a454-00cb551c4a18",
                                "sense_id": "9cd55237-7398-30d1-ae38-97a3988218d3",
                                "text": "Near-synonyms: reportedly, reputedly, purportedly, rumoredly, supposedly, allegedly, ostensibly, possibly, probably, likely, plausibly"
                            },
                            {
                                "example_id": "b04bb757-8bfb-481c-af4e-85cc298c7e43",
                                "sense_id": "9cd55237-7398-30d1-ae38-97a3988218d3",
                                "text": "Even the putatively innocuous whimsical shapes and designs of cakes and pastry, notably in Central Europe, retain to this day the phallic concept[.]"
                            },
                            {
                                "example_id": "67f27d68-10e1-49f2-b32e-1ed48ac3c0f2",
                                "sense_id": "9cd55237-7398-30d1-ae38-97a3988218d3",
                                "text": "The following are the focus of research: in the Pyraloidea (Subobjective 1.1) Ategumia, Desmia, Diaphania, Eulepte, Herpetogramma, Omiodes, Patania; in the Gelechioidea (Subobjective 1.2) genera within and putatively near the Recurvaria-group (Gelechiinae: Litini); in the Noctuoidea (Subobjective 1.3) fern-feeding Argyrosticta in relation to Callopistria, boundaries and composition of the Eriopinae, and erebid litter moths (Herminiinae)."
                            },
                            {
                                "example_id": "8c35c908-6422-4e1c-a032-7b2adcac8f40",
                                "sense_id": "9cd55237-7398-30d1-ae38-97a3988218d3",
                                "text": "To construct a phylogenetic tree, molecular biologists compare the differences in nucleotide sequences of many isolates of putatively related organisms."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "660bd6c8-b0d5-4e39-933d-89177bdffbb4",
                        "source_entry_id": "70e47705-a64d-3416-bb08-eb86e4701d51",
                        "source_sense_id": "9cd55237-7398-30d1-ae38-97a3988218d3",
                        "source_sense_description": "according to belief",
                        "target_lang_word": "vermeintlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vermeintlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f101fbcf-d493-31a9-8046-80ddf0d1597d",
                                        "entry_id": "33efa1ca-d594-3780-aa86-7f08cabd8105",
                                        "glosses": [
                                            "(irrtümlich, zu Unrecht) angenommen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f25da82-72e9-42e6-9dc3-8f776c5422f6",
                                                "sense_id": "f101fbcf-d493-31a9-8046-80ddf0d1597d",
                                                "text": "Der vermeintliche VW war in Wirklichkeit ein Audi."
                                            },
                                            {
                                                "example_id": "72064496-3333-488b-a26b-2838aa0de6e9",
                                                "sense_id": "f101fbcf-d493-31a9-8046-80ddf0d1597d",
                                                "text": "„Im Jahrzehnt vor Christi Geburt schickte Kaiser Augustus römische Legionen durch die vermeintlich neue Provinz Germania.“"
                                            },
                                            {
                                                "example_id": "d148ea70-c815-4819-9eca-9a5d5973d34f",
                                                "sense_id": "f101fbcf-d493-31a9-8046-80ddf0d1597d",
                                                "text": "„Sofort befahl der Feldherr der 17., 18. und 19. Legion und deren germanischen Hilfstruppen den Abmarsch in das vermeintliche Krisengebiet.“"
                                            },
                                            {
                                                "example_id": "b79cdff8-9a14-4bd3-95c1-3915d39d1f33",
                                                "sense_id": "f101fbcf-d493-31a9-8046-80ddf0d1597d",
                                                "text": "„Vorwiegend von Touristenführern und Journalisten wird die Kongresshalle aufgrund ihres muschelschalenähnlichen Aussehens auch mit ihrem vermeintlichen Berliner Spitznamen als Schwangere Auster bezeichnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37d87847-6da1-4d14-aeaf-650c364a9d60",
                        "source_entry_id": "70e47705-a64d-3416-bb08-eb86e4701d51",
                        "source_sense_id": "9cd55237-7398-30d1-ae38-97a3988218d3",
