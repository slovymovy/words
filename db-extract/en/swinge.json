                "senses": [
                    {
                        "sense_id": "e1245ab3-9937-34fe-9c56-d1cbadbcc2b5",
                        "entry_id": "b8ff0591-fea2-3910-be44-467d8d5f4628",
                        "glosses": [
                            "To singe."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "f471382c-70b2-433f-a9b1-db6bc496bd75",
                                "sense_id": "e1245ab3-9937-34fe-9c56-d1cbadbcc2b5",
                                "text": "The scorching flame fore swinged all his face"
                            }
                        ]
                    },
                    {
                        "sense_id": "a97dd203-30d4-3736-824c-9375c35bc04f",
                        "entry_id": "b8ff0591-fea2-3910-be44-467d8d5f4628",
                        "glosses": [
                            "To move like a lash; to lash."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "c9fc1a1d-3571-4312-975f-493a1df01e51",
                                "sense_id": "a97dd203-30d4-3736-824c-9375c35bc04f",
                                "text": "Th' old Dragon underground / In ſtraiter limits bound, / Not half ſo far caſts his uſurped ſvvay, / And vvrath to ſee his Kingdom fail, / Svvindges the ſcaly Horrour of his foulded tail."
                            }
                        ]
                    },
                    {
                        "sense_id": "cd6f74d5-d3bd-32ac-8b7d-7f5c595ae05c",
                        "entry_id": "b8ff0591-fea2-3910-be44-467d8d5f4628",
                        "glosses": [
                            "To strike hard."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "d50001cc-16bf-4757-9f7c-b98a14570fb3",
                                "sense_id": "cd6f74d5-d3bd-32ac-8b7d-7f5c595ae05c",
                                "text": "For certaine words he ſpake againſt your Grace / In your retirment, I had ſwing'd him ſoundly."
                            },
                            {
                                "example_id": "95426dca-afaf-4a5a-a456-9dbef7a7005f",
                                "sense_id": "cd6f74d5-d3bd-32ac-8b7d-7f5c595ae05c",
                                "text": "Sir Fee[ble]. 'Tis—Jealouſie, the old VVorm that bites— [Aſide] VVho is it you ſuſpect? / Sir Cau[tious]. Alas I knovv not vvhom to ſuſpect, I vvou'd I did; but if you cou'd diſcover him—I vvou'd ſo ſvvinge him.—"
                            },
                            {
                                "example_id": "4b68fee2-9179-441a-bb23-43350efa3d2d",
                                "sense_id": "cd6f74d5-d3bd-32ac-8b7d-7f5c595ae05c",
                                "text": "And ſwinges his own Vices in his Son."
                            }
                        ]
                    },
                    {
                        "sense_id": "c4d45647-ad65-3075-99fe-4cad5c287b32",
                        "entry_id": "b8ff0591-fea2-3910-be44-467d8d5f4628",
                        "glosses": [
                            "To chastise; to beat."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "87b9186f-63fb-4e6e-84cf-1a9a041d719a",
                                "sense_id": "c4d45647-ad65-3075-99fe-4cad5c287b32",
                                "text": "O, the passion of God, so I shall be swinged. / So, my bones shall be bangedǃ / The porridge pot is stolenː what, Lob, say, / Come away, and be hangedǃ"
                            }
                        ]
                    }
