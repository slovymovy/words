                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "docker",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c7df210a-3442-3555-9aa3-cd1fedce6d55",
                                        "entry_id": "90338416-41f1-3006-8f48-9de133e050e1",
                                        "glosses": [
                                            "Ouvrier qui, dans un dock, travaille au chargement et au déchargement des navires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "032ca327-26c8-448a-9508-53347d785936",
                                                "sense_id": "c7df210a-3442-3555-9aa3-cd1fedce6d55",
                                                "text": "Quel beau conte de fées, dit-il, que la plus humble des vies, celle d'un docker, d'une piqueuse de bottines !"
                                            },
                                            {
                                                "example_id": "ecda404f-20e9-4b68-9f8f-f8f583f1eb61",
                                                "sense_id": "c7df210a-3442-3555-9aa3-cd1fedce6d55",
                                                "text": "Le premier port de ferries de France est bloqué. Depuis minuit, près de 80 dockers et grutiers calaisiens bloquent leur lieu de travail. À l’origine de leur colère, le déchargement d’un bateau, le Britannica, par une société privée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4927d5c8-3aa7-4749-9a06-857b47ee0f50",
                        "source_entry_id": "fe988cc4-4ccd-3f44-af63-bae5781dd140",
                        "source_sense_id": "ffd6c384-54d5-3ef8-8b3f-a69641244fc2",
                        "source_sense_description": "worker at a dock",
                        "target_lang_word": "Hafenarbeiter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hafenarbeiter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "03870fa3-ff55-34cf-bbb2-97fd93ef46e1",
                                        "entry_id": "4b3af614-fe92-3764-96ad-23f86226170f",
                                        "glosses": [
                                            "Arbeiter, der seinen beruflichen Aufgaben in einem Binnen- oder Seehafen nachgeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92f9ccd2-cad1-4e75-a39f-d6a5c140be42",
                                                "sense_id": "03870fa3-ff55-34cf-bbb2-97fd93ef46e1",
                                                "text": "„Ein Streik der Hafenarbeiter legt den Ladeverkehr in den Häfen der Westküste der Vereinigten Staaten lahm.“"
                                            },
                                            {
                                                "example_id": "8c3bb82f-4488-460d-886e-6527a91a9719",
                                                "sense_id": "03870fa3-ff55-34cf-bbb2-97fd93ef46e1",
                                                "text": "„Zu unseren Leuten gehörten Soldaten, Matrosen und Hafenarbeiter.“"
                                            },
                                            {
                                                "example_id": "0f69a8a1-1df7-4960-907e-4fc5f15f4a78",
                                                "sense_id": "03870fa3-ff55-34cf-bbb2-97fd93ef46e1",
                                                "text": "„Die anderen Hafenarbeiter riefen immer dann nach Kostas, dem Mechaniker, wenn mal wieder eine Kurbel klemmte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
