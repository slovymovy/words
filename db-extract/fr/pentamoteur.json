                "senses": [
                    {
                        "sense_id": "911b10f2-9a8b-35c5-94b4-af79231fcd44",
                        "entry_id": "6909487d-5d04-32f6-9fab-d481aa108aa6",
                        "glosses": [
                            "Équipé de cinq moteurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43b6d499-1c5f-41fa-b498-698f9f93410b",
                                "sense_id": "911b10f2-9a8b-35c5-94b4-af79231fcd44",
                                "text": "1923 : Penhoët se lance dans la construction aéronautique avec un hydravion pentamoteur de 2 000 chevaux."
                            },
                            {
                                "example_id": "fe578ec2-a9c7-499c-89da-dbfdef1df576",
                                "sense_id": "911b10f2-9a8b-35c5-94b4-af79231fcd44",
                                "text": "Pour cela, la Société des ateliers et chantiers de Saint-Nazaire-Penhoët se lança, dès 1923, dans la réalisation d’un hydravion pentamoteur métallique, un véritable monstre pour l’époque, qui devait être capable de transporter quarante passagers répartis en deux ponts."
                            },
                            {
                                "example_id": "03a03965-9998-40f5-9e85-102986a617c3",
                                "sense_id": "911b10f2-9a8b-35c5-94b4-af79231fcd44",
                                "text": "[L’Allemagne] transforma des bombardiers comme le Heinkel 111 en avions de transport improvisés, ou les accoupla afin de créer un avion pentamoteur enfin capable de remorquer ses gros planeurs de combat."
                            }
                        ]
                    }
