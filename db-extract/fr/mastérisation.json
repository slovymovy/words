                ],
                "senses": [
                    {
                        "sense_id": "a700fedd-00b0-3f98-94aa-ed554adabb1e",
                        "entry_id": "7fd03313-976a-3300-9f95-67bca9c3a05b",
                        "glosses": [
                            "Fait de mastériser, de réunir sur une seule bande mère le montage de l’image et du son à la fin de la production d’un film ou d’une vidéo."
                        ],
                        "tags": [
                            "Audiovisuel"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6f13cb35-62e5-3dac-af06-a930dbb79efa",
                        "entry_id": "7fd03313-976a-3300-9f95-67bca9c3a05b",
                        "glosses": [
                            "Fait de réunir sur un seul média plusieurs bandes son ou autre type de données."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "99ec93bb-70b0-421c-b910-302db677a823",
                                "sense_id": "6f13cb35-62e5-3dac-af06-a930dbb79efa",
                                "text": "Car la mastérisation du catalogue des Beatles, pour éclatante qu’elle soit, ne vise pas uniquement l’objet Compact Disc."
                            },
                            {
                                "example_id": "4fe553ed-0e0b-43bd-9d63-e62bc3924968",
                                "sense_id": "6f13cb35-62e5-3dac-af06-a930dbb79efa",
                                "text": "Certains lecteurs et logiciels de mastérisation prennent en charge une option qui détermine automatiquement la meilleure vitesse à employer pour graver un CD-R."
                            }
                        ]
                    },
                    {
                        "sense_id": "241e3d50-df52-31ec-9f36-2ea650ebe98b",
                        "entry_id": "7fd03313-976a-3300-9f95-67bca9c3a05b",
                        "glosses": [
                            "Fait de mettre au niveau de master."
                        ],
                        "tags": [
                            "Belgique",
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "68169742-1dd6-42eb-925d-b4760731c5ec",
                                "sense_id": "241e3d50-df52-31ec-9f36-2ea650ebe98b",
                                "text": "Tout le monde, ou presque, en était déjà convaincu : la réforme de la formation des enseignants, appelée «mastérisation» parce qu’elle impose d’avoir un master pour devenir prof, a été bâclée, précipitée, en un mot ratée."
                            },
                            {
                                "example_id": "837c5715-0282-4d1a-8d57-3399f0e6822b",
                                "sense_id": "241e3d50-df52-31ec-9f36-2ea650ebe98b",
                                "text": "La faute à la « mastérisation », nouvelle modalité de recrutement et de formation pour le secondaire tracées par les décrets du 28 juillet 2009 et la circulaire du 20 août."
                            },
                            {
                                "example_id": "d7792fb0-cc3b-4855-badf-b318674f24dd",
                                "sense_id": "241e3d50-df52-31ec-9f36-2ea650ebe98b",
                                "text": "La mastérisation est l’un des principaux mots d’ordre de la grève du 21 janvier 2010 pour les syndicats enseignants."
                            }
                        ]
                    }
                ],
