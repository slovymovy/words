                "senses": [
                    {
                        "sense_id": "f8a25130-6152-3021-86c2-a2053fe74524",
                        "entry_id": "668d0fc8-a38b-3fcb-9fca-78193b43016e",
                        "glosses": [
                            "Dokument, das berechtigt, an einem bestimmten Flug teilzunehmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "479609b6-b8a5-4724-b0e6-e9fb8dd0acb8",
                                "sense_id": "f8a25130-6152-3021-86c2-a2053fe74524",
                                "text": "„Ich habe mir am selben Tag ein Flugticket nach Island gekauft und bin geflüchtet.“"
                            },
                            {
                                "example_id": "cf3c8e95-a425-4c7f-8526-7b8fc7c513ac",
                                "sense_id": "f8a25130-6152-3021-86c2-a2053fe74524",
                                "text": "„Da man ihm das Flugticket von London zahlen würde, er aber gleich von hier aus weiterfuhr, blieb ihm einschließlich der unbenutzten Rückfahrkarte von Schneedorf nach England ein Reingewinn von über fünfzig Pfund.“"
                            },
                            {
                                "example_id": "558021ce-c1e3-45cd-b2be-4337ed03762f",
                                "sense_id": "f8a25130-6152-3021-86c2-a2053fe74524",
                                "text": "„Sie sollen die Möglichkeit haben, es immer zu tun, ohne ein teures Flugticket kaufen oder eine lange Reise machen zu müssen.“"
                            },
                            {
                                "example_id": "c0a4aa7e-cdc9-4516-b87b-34019f2d572d",
                                "sense_id": "f8a25130-6152-3021-86c2-a2053fe74524",
                                "text": "„Immerhin hatte ich gegen einen geringen Aufpreis ein Flugticket erwerben können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
