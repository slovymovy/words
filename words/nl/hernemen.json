{
    "word_family": [
        "herneming",
        "opnemen",
        "innemen",
        "terugnemen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "415f098a-bcd4-349c-a85c-49131e691ad5",
                    "sense_definition": "een toneelstuk of voorstelling opnieuw opvoeren voor een publiek",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "theater",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het theatergezelschap besloot om de succesvolle voorstelling volgend seizoen te <w>hernemen</w>.",
                            "target_lang_translations": {
                                "en": "The theater company decided to <w>revive</w> the successful performance next season."
                            }
                        },
                        {
                            "text": "Ze <w>hernemen</w> de bekende opera in een geheel nieuwe bezetting.",
                            "target_lang_translations": {
                                "en": "They are <w>re-staging</w> the famous opera with a completely new cast."
                            }
                        }
                    ],
                    "synonyms": [
                        "heropvoeren"
                    ],
                    "common_phrases": [
                        "een voorstelling hernemen",
                        "een toneelstuk hernemen"
                    ],
                    "target_lang_definitions": {
                        "en": "to perform a play or show again for an audience; to revive"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "revive",
                                "target_lang_sense_clarification": "a play or performance"
                            },
                            {
                                "target_lang_word": "re-stage",
                                "target_lang_sense_clarification": "a theatrical production"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "686fdfaa-d505-32a6-ba6b-67c69a0e8b03",
                    "sense_definition": "verdergaan met spreken na een onderbreking; de draad van een gesprek weer oppakken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spreken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een korte stilte <w>hernam</w> de spreker zijn betoog voor de aandachtige zaal.",
                            "target_lang_translations": {
                                "en": "After a brief silence, the speaker <w>resumed</w> his argument before the attentive hall."
                            }
                        },
                        {
                            "text": "Even serieus, <w>hernam</w> hij rustig nadat het gelach was weggestorven.",
                            "target_lang_translations": {
                                "en": "\"All seriousness aside,\" he calmly <w>continued</w> after the laughter had died down."
                            }
                        }
                    ],
                    "synonyms": [
                        "hervatten"
                    ],
                    "common_phrases": [
                        "zijn betoog hernemen"
                    ],
                    "target_lang_definitions": {
                        "en": "to resume speaking after an interruption; to pick up the thread of conversation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "resume",
                                "target_lang_sense_clarification": "speaking or an argument"
                            },
                            {
                                "target_lang_word": "continue",
                                "target_lang_sense_clarification": "speaking after a pause"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42bbfb02-a52a-39b1-ba6a-ee57d87ad6d2",
                    "sense_definition": "weer in een eerdere toestand komen of iets weer terugkrijgen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "herkrijgen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de moeilijke periode <w>hernam</w> het dagelijkse leven langzaam zijn gewone gang.",
                            "target_lang_translations": {
                                "en": "After the difficult period, daily life slowly <w>resumed</w> its normal course."
                            }
                        },
                        {
                            "text": "De atleet wist na enige rust zijn krachten te <w>hernemen</w>.",
                            "target_lang_translations": {
                                "en": "After some rest, the athlete managed to <w>regain</w> his strength."
                            }
                        }
                    ],
                    "synonyms": [
                        "herkrijgen"
                    ],
                    "common_phrases": [
                        "zijn gewone loop hernemen",
                        "zijn krachten hernemen"
                    ],
                    "target_lang_definitions": {
                        "en": "to return to a previous state or to recover something lost"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "regain",
                                "target_lang_sense_clarification": "strength, normal course, or composure"
                            },
                            {
                                "target_lang_word": "recover",
                                "target_lang_sense_clarification": "energy or balance"
                            },
                            {
                                "target_lang_word": "resume",
                                "target_lang_sense_clarification": "a routine or normal flow"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1cb804b8-290f-3a12-8b23-dbf139c1fadc",
                    "sense_definition": "door strijd of actie opnieuw in bezit nemen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "veroveren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het leger deed een poging om het verloren fort te <w>hernemen</w>.",
                            "target_lang_translations": {
                                "en": "The army made an attempt to <w>retake</w> the lost fort."
                            }
                        },
                        {
                            "text": "Uiteindelijk werd de strategische stad na een lange strijd <w>hernomen</w>.",
                            "target_lang_translations": {
                                "en": "Ultimately, the strategic city was <w>recaptured</w> after a long struggle."
                            }
                        }
                    ],
                    "synonyms": [
                        "heroveren"
                    ],
                    "common_phrases": [
                        "een stad hernemen",
                        "een positie hernemen"
                    ],
                    "target_lang_definitions": {
                        "en": "to regain possession of something through fight or military action"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "retake",
                                "target_lang_sense_clarification": "a city, fort, or position"
                            },
                            {
                                "target_lang_word": "recapture",
                                "target_lang_sense_clarification": "territory or strategic points"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8df64ab4-1002-3626-87c2-3b8c1836e8af",
                    "sense_definition": "iets wat men eerder heeft gegeven of afgestaan, weer van een ander afnemen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "terugnemen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat met de ene hand wordt gegeven, wordt met de andere vaak weer <w>hernomen</w>.",
                            "target_lang_translations": {
                                "en": "What is given with one hand is often <w>taken back</w> with the other."
                            }
                        },
                        {
                            "text": "De overheid dreigt de verleende privileges in te trekken en daarmee te <w>hernemen</w>.",
                            "target_lang_translations": {
                                "en": "The government threatens to revoke the granted privileges and thereby <w>reclaim</w> them."
                            }
                        }
                    ],
                    "synonyms": [
                        "terugnemen"
                    ],
                    "target_lang_definitions": {
                        "en": "to reclaim or withdraw something that was previously given or granted"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "take back",
                                "target_lang_sense_clarification": "something given or conceded"
                            },
                            {
                                "target_lang_word": "reclaim",
                                "target_lang_sense_clarification": "privileges or rights"
                            },
                            {
                                "target_lang_word": "retract",
                                "target_lang_sense_clarification": "rights or concessions"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}