                "senses": [
                    {
                        "sense_id": "cf9f2814-0810-3b17-8cf3-cc66c0699ca7",
                        "entry_id": "ea2f0199-13fb-3ed4-91ab-f8dc6da506b1",
                        "glosses": [
                            "Capacité d’une substance incorporée à entraîner des effets nocifs pour l’organisme du fait de sa radioactivité."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "e2e329e9-32f6-4190-8f63-34706abf6e89",
                                "sense_id": "cf9f2814-0810-3b17-8cf3-cc66c0699ca7",
                                "text": "La radiotoxicité des nucléides artificiels comme le plutonium 238 est plus élevée que celle de leurs \"géniteurs\" naturels. La radioactivité baisse mais la radiotoxicité augmente !"
                            },
                            {
                                "example_id": "005511c7-7293-46d0-a60c-f66d608fe959",
                                "sense_id": "cf9f2814-0810-3b17-8cf3-cc66c0699ca7",
                                "text": "La radiotoxicité d’un radionucléide se définit actuellement en termes de dose efficace engagée que recevra un individu, suite à l’incorporation d’un radionucléide."
                            }
                        ]
                    }
                ],
