    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "6b18bc1d-a15d-3184-a5e3-b9e5cca42662",
                    "sense_definition": "Основываясь на методах науки, а также с точки зрения науки.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это утверждение было <научно> доказано в ходе эксперимента.",
                            "target_lang_translations": {
                                "en": "This statement was <w>scientifically</w> proven during the experiment.",
                                "zh": "这一论点已在实验中被<w>科学</w>地证明了。"
                            }
                        },
                        {
                            "text": "Мы должны подходить к решению этой сложной задачи <научно>.",
                            "target_lang_translations": {
                                "en": "We must approach the solution of this complex problem <w>scientifically</w>.",
                                "zh": "我们必须<w>科学</w>地处理这个复杂的问题。"
                            }
                        }
                    ],
                    "antonyms": [
                        "антинаучно",
                        "ненаучно"
                    ],
                    "common_phrases": [
                        "научно доказано",
                        "научно обосновано",
                        "научно подтвердить"
                    ],
                    "target_lang_definitions": {
                        "en": "Based on scientific methods, or from a scientific point of view.",
                        "zh": "基于科学方法，或从科学的角度来看。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scientifically",
                                "target_lang_sense_clarification": "in a scientific manner"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "科学地",
                                "target_lang_sense_clarification": "以科学的方式"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a89c4234-dc87-33b7-ac37-f762c930ae26",
                    "sense_definition": "Краткая форма среднего рода прилагательного <w>научный</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ваше объяснение звучит вполне <научно> и убедительно.",
                            "target_lang_translations": {
                                "en": "Your explanation sounds quite <w>scientific</w> and convincing.",
                                "zh": "你的解释听起来非常<w>科学</w>且令人信服。"
                            }
                        },
                        {
                            "text": "Всё это выглядит слишком <научно> для простой статьи.",
                            "target_lang_translations": {
                                "en": "All this looks too <w>scientific</w> for a simple article.",
                                "zh": "对于一篇简单的文章来说，这一切看起来太<w>科学</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "звучит научно",
                        "выглядит научно"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short form"
                        }
                    ],
                    "target_lang_definitions": {
