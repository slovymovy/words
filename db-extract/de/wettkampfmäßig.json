                ],
                "senses": [
                    {
                        "sense_id": "882a2c9e-8ee3-3e45-9bda-21a457efb745",
                        "entry_id": "537086f7-d569-396b-9fa2-1431537c37c2",
                        "glosses": [
                            "wie in einem Wettkampf; einen oder mehrere Wettkämpfe betreffend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6bb9b73-283e-42fd-a6e2-a2f58607c090",
                                "sense_id": "882a2c9e-8ee3-3e45-9bda-21a457efb745",
                                "text": "„Auch Senioren wollen wettkampfmäßig Sport treiben. Einer von ihnen ist der 74-jährige Senioren-Weltmeister der Leichtathletik, Guido Müller.“"
                            },
                            {
                                "example_id": "68f62bbd-ca2b-472b-abfe-9ad4dc527d6f",
                                "sense_id": "882a2c9e-8ee3-3e45-9bda-21a457efb745",
                                "text": "„Weltweit wird Badminton von über 14 Millionen Spielern in mehr als 160 Nationen wettkampfmäßig betrieben.“"
                            },
                            {
                                "example_id": "104d713f-6564-47d1-9b2f-4a2556007526",
                                "sense_id": "882a2c9e-8ee3-3e45-9bda-21a457efb745",
                                "text": "„Madeleine Arthur“ […] „betrieb zunächst wettkampfmäßig Turnen, bevor sie sich dem Schauspiel zuwandte.“"
                            },
                            {
                                "example_id": "479f918b-b4b9-4cda-b39d-9144f0ba6003",
                                "sense_id": "882a2c9e-8ee3-3e45-9bda-21a457efb745",
                                "text": "[Schach:] […] „der Denksport mit den weißen und schwarzen Figuren wird fast überall auf der Welt wettkampfmäßig betrieben.“"
                            },
                            {
                                "example_id": "8fba7ae5-a9ec-4e9e-af05-8bf682a27082",
                                "sense_id": "882a2c9e-8ee3-3e45-9bda-21a457efb745",
                                "text": "[Schach] „wird sowohl zum reinen Vergnügen als auch wettkampfmäßig gespielt,“ […]."
                            },
                            {
                                "example_id": "488f5604-a238-454d-a05a-6e5fad995f41",
                                "sense_id": "882a2c9e-8ee3-3e45-9bda-21a457efb745",
                                "text": "[Tennis:] „»Ich bin überglücklich, dass ich wieder wettkampfmäßig spielen kann, und ich kann mir kaum einen besseren Platz für eine Rückkehr vorstellen als Australien«, sagte Nadal.“"
                            },
                            {
                                "example_id": "b855d0c0-378e-42f6-9a62-f359ddbfce06",
                                "sense_id": "882a2c9e-8ee3-3e45-9bda-21a457efb745",
                                "text": "„»Ich habe wettkampfmäßig erst mit Fußball begonnen, habe zu Boris Beckers Zeiten mit zehn Jahren dann auf einmal hauptsächlich Tennis gespielt.«“"
                            },
                            {
                                "example_id": "c34d9995-7b86-4c6b-a5b6-822b9b6b0484",
                                "sense_id": "882a2c9e-8ee3-3e45-9bda-21a457efb745",
                                "text": "„Fabienne Reuteler ist 2004 vom wettkampfmässigen Snowboard-Sport zurückgetreten, um sich vollständig auf den Abschluss ihres Betriebswirtschaftsstudium zu konzentrieren.“"
                            },
                            {
                                "example_id": "0c0d6365-3aa7-4fac-89e6-8b1c0cc0891c",
                                "sense_id": "882a2c9e-8ee3-3e45-9bda-21a457efb745",
                                "text": "[Brustschwimmen/Delphin/Kraulen/Rücken:] „Die Schwimmtechnik ist wettkampfmäßig genau definiert und vorgegeben.“"
                            },
                            {
                                "example_id": "a3fe2948-f637-411b-b95e-8c513ebfaecf",
                                "sense_id": "882a2c9e-8ee3-3e45-9bda-21a457efb745",
                                "text": "„Bei Magdalena Lobnig droht die wettkampfmäßige Olympiavorbereitung ordentlich durcheinanderzukommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
