                "senses": [
                    {
                        "sense_id": "a70bcebe-ba4f-3740-b580-b3a99a9e9ada",
                        "entry_id": "fa3e22b8-49c0-321b-b910-ee060f9dfe61",
                        "glosses": [
                            "Hitzschlag hervorgerufen durch zu lange Sonneneinstrahlung; Sonnenstich"
                        ],
                        "tags": [],
