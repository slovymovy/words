                "senses": [
                    {
                        "sense_id": "116e1a5c-496c-3646-be14-65e2a62da3b4",
                        "entry_id": "4b327bbc-1d02-3a6f-8d45-89557f7815a0",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "517f797c-5e0d-4128-a2d5-ab819834d8a1",
                                "sense_id": "116e1a5c-496c-3646-be14-65e2a62da3b4",
                                "text": "Frau Oettle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "2e469bd5-1ac9-4ee0-aa55-93b13b9b646a",
                                "sense_id": "116e1a5c-496c-3646-be14-65e2a62da3b4",
                                "text": "Herr Oettle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e0899587-2609-451a-ac8e-21491f9aa75e",
                                "sense_id": "116e1a5c-496c-3646-be14-65e2a62da3b4",
                                "text": "Die Oettles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "f59d3773-b361-474e-aadd-8b74985a1ba3",
                                "sense_id": "116e1a5c-496c-3646-be14-65e2a62da3b4",
                                "text": "Der Oettle trägt nie die Schals, die die Oettle ihm strickt."
                            },
                            {
                                "example_id": "1dfc0d98-06ef-44e0-9226-cbe425e3cd3d",
                                "sense_id": "116e1a5c-496c-3646-be14-65e2a62da3b4",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Oettle kommt, geht der Herr Oettle.“"
                            },
                            {
                                "example_id": "be5b111e-d925-4200-9bc3-b02ab111d68c",
                                "sense_id": "116e1a5c-496c-3646-be14-65e2a62da3b4",
                                "text": "Oettle kommt und geht."
                            },
                            {
                                "example_id": "17814554-dedd-4d35-b918-0730dcb71dae",
                                "sense_id": "116e1a5c-496c-3646-be14-65e2a62da3b4",
                                "text": "Oettles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
