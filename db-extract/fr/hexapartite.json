                        "examples": [
                            {
                                "example_id": "8316a7d5-8986-4e04-be49-6d5e6a81b51e",
                                "sense_id": "01bf13d3-d72c-326d-8858-d6a4d02d1da3",
                                "text": "Trois des six partis qui ont négocié l’accord gouvernemental ont consulté leurs troupes ce samedi pour décider de leur participation au gouvernement hexapartite."
                            },
                            {
                                "example_id": "6103e271-6005-48c8-baf7-5cdd0dcd4d5b",
                                "sense_id": "01bf13d3-d72c-326d-8858-d6a4d02d1da3",
                                "text": "Une fois que le soleil fut complètement levé, je me mis à chercher l’un des membres de la commission hexapartite d’Al-Nabawi, mais il n’y avait personne, …."
                            },
                            {
                                "example_id": "2b98618f-9718-4127-abd4-60b10a710dab",
                                "sense_id": "01bf13d3-d72c-326d-8858-d6a4d02d1da3",
                                "text": "Le principal organe de conseil de la souveraine, le Conseil d’État hexapartite, imposa dès les années soixante l’idée que la Hongrie ne devait pas s’industrialiser, mais qu’elle avait pour vocation de fournir des produits agricoles aux parties occidentales de la Monarchie."
                            }
                        ]
