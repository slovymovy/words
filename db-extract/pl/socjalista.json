                    {
                        "translation_id": "dc0d69df-14b2-4f08-bcda-12e575a781ea",
                        "source_entry_id": "6d995918-6bb2-314a-99c4-96d71b8b7a15",
                        "source_sense_id": "183aa54a-c9b1-3ac7-bda3-c713b48b6632",
                        "target_lang_word": "Sozialist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sozialist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "368f6253-2b9a-3ca2-8d35-5691cecae397",
                                        "entry_id": "d7dbea1f-3700-3ee0-b407-4b5b1e305131",
                                        "glosses": [
                                            "Anhänger des Sozialismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "501be58b-b866-4ea3-859a-cbf46e747388",
                                                "sense_id": "368f6253-2b9a-3ca2-8d35-5691cecae397",
                                                "text": "Sozialisten setzen sich für soziale Gerechtigkeit ein."
                                            },
                                            {
                                                "example_id": "d1debe22-ac7f-4ff9-a8e2-db05c1b7a5db",
                                                "sense_id": "368f6253-2b9a-3ca2-8d35-5691cecae397",
                                                "text": "„Die Sozialisten erobern nicht die staatspolitische Macht, sondern die staatspolitische Macht hat die Sozialisten erobert.“"
                                            },
                                            {
                                                "example_id": "a00ea846-d7ac-4fb2-af49-deb02169780d",
                                                "sense_id": "368f6253-2b9a-3ca2-8d35-5691cecae397",
                                                "text": "„Seine Zulassung als Rechtsanwalt verlor Perez, weil er Sozialist war, und mit der warmen Semmel, die Bontsche sich am Ende wünscht, setzt er der Erzählung ihren satirischen Schlusspunkt.“"
                                            },
                                            {
                                                "example_id": "c3ca9982-08b5-465e-a046-282c630896b5",
                                                "sense_id": "368f6253-2b9a-3ca2-8d35-5691cecae397",
                                                "text": "„Als Sozialist ist er ein Einzelgänger zwischen den Fronten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
