                ],
                "translations": [
                    {
                        "translation_id": "ac9b54ca-a274-431a-8f36-dbd05199a70b",
                        "source_entry_id": "60cc41e6-8d68-3f86-8e6c-eb20afb71d20",
                        "source_sense_id": "d41fafe9-433b-31be-92d4-cd15ba321c64",
                        "source_sense_description": "een gerecht van gebakken eieren en losgeklopte melk",
                        "target_lang_word": "Rührei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rührei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d430b64d-6f20-3531-a5af-2a9206cbed63",
                                        "entry_id": "6e223391-fd30-31ac-9e6c-c330e4ead83a",
                                        "glosses": [
                                            "mit Flüssigkeit (etwa Kondensmilch oder Sahne), Salz, Pfeffer und anderen Gewürzen verschlagene Eier, die in der Pfanne gestockt werden"
                                        ],
                                        "tags": [
                                            "Lebensmittel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0b386a8-14d3-4eb6-ac3f-058a57632ed2",
                                                "sense_id": "d430b64d-6f20-3531-a5af-2a9206cbed63",
                                                "text": "Rühreier mit Aal - Richten Sie sich nach den allgemeinen Anweisungen für Rühreier. Den Aal häuten und entgräten, in Stücke schneiden und mit dem möglichst frischen, feingehackten Dill unter die Eimasse geben."
                                            },
                                            {
                                                "example_id": "393ac099-8237-4c2f-aee6-628e1261bbde",
                                                "sense_id": "d430b64d-6f20-3531-a5af-2a9206cbed63",
                                                "text": "Rühreier - Eines der einfachsten Gerichte der Welt, aber wie oft werden Rühreier lieblos zubereitet."
                                            },
                                            {
                                                "example_id": "69698e27-3bb2-4d86-a941-269f70c29d9d",
                                                "sense_id": "d430b64d-6f20-3531-a5af-2a9206cbed63",
                                                "text": "„Ihren Stetson behalten sie auf, behäbig hocken sie hinter Rührei und Kartoffeln.“"
                                            },
                                            {
                                                "example_id": "4ce71daf-a9e9-4010-b097-61469b14720e",
                                                "sense_id": "d430b64d-6f20-3531-a5af-2a9206cbed63",
                                                "text": "„Billy bringt eine Platte mit aufgehäuftem Rührei herein, das alarmierend stark riecht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
