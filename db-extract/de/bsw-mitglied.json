                "senses": [
                    {
                        "sense_id": "3cb3fc21-7f06-3f19-8f45-97f90cbda871",
                        "entry_id": "429794a6-9395-3f08-a89f-e88972a757fd",
                        "glosses": [
                            "Person, die in die Partei Bündnis Sahra Wagenknecht eingetreten ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7bfe91d-a240-4de9-82b7-fd4c8abba907",
                                "sense_id": "3cb3fc21-7f06-3f19-8f45-97f90cbda871",
                                "text": "„Auch die Landesliste zur Bürgerschaftswahl am 2. März haben die Hamburger BSW-Mitglieder aufgestellt.“"
                            },
                            {
                                "example_id": "5d7b5ec0-c85c-4dbc-8897-eff78df21e21",
                                "sense_id": "3cb3fc21-7f06-3f19-8f45-97f90cbda871",
                                "text": "„Die Frau, die der Partei ihren Namen gegeben hat, fehlte in Parchim: Sahra Wagenknecht hatte in Thüringen zu tun, sie lächelte dafür von vielen Plakaten in den Saal mit den rund 50 BSW-Mitgliedern.“"
                            },
                            {
                                "example_id": "f9f8ddd0-df37-49f0-9fec-e8af5eecd0a6",
                                "sense_id": "3cb3fc21-7f06-3f19-8f45-97f90cbda871",
                                "text": "„Gewählt wurde er dafür mit 22 Ja-Stimmen der mit 28 Hamburger BSW-Mitgliedern überschaubaren Versammlung.“"
                            },
                            {
                                "example_id": "108bcdd9-a1ec-4694-a0f4-fc1937f19429",
                                "sense_id": "3cb3fc21-7f06-3f19-8f45-97f90cbda871",
                                "text": "„In einem am 4. August 2024 veröffentlichten offenen Brief werfen 58 Mitglieder der Bürgerrechtsbewegung in der ehemaligen DDR wenige Wochen vor den Landtagswahlen in Sachsen, Thüringen und Brandenburg dem BSW die Verbreitung von Lügen und Desinformation vor: BSW-Mitglieder würden fälschlich behaupten, dass in Kiew Faschisten herrschten, während sie gleichzeitig die Abschaffung der Medienfreiheit in Russland nicht ansprächen.“"
                            },
                            {
                                "example_id": "101bd6a8-6659-4fa9-a7d1-443e69b3d9fb",
                                "sense_id": "3cb3fc21-7f06-3f19-8f45-97f90cbda871",
                                "text": "„Am Abend wird auch BSW-Mitglied Oskar Lafontaine sprechen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
