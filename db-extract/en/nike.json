            {
                "entry_id": "bcba276e-a5e0-33bf-9bfc-62415b48e8e4",
                "word": "Nike",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f75acec8-2d60-452e-9c14-9645ae62936d",
                        "entry_id": "bcba276e-a5e0-33bf-9bfc-62415b48e8e4",
                        "tags": [
                            "plural"
                        ],
                        "form": "Nikes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "77b4a5a4-dd88-328f-b6dd-68ca8ca06f5f",
                        "entry_id": "bcba276e-a5e0-33bf-9bfc-62415b48e8e4",
                        "glosses": [
                            "An athletic shoe or other piece of athletic gear produced or licensed by athletic brand Nike."
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "35b26fad-ff72-4471-93d5-82454235092c",
                                "sense_id": "77b4a5a4-dd88-328f-b6dd-68ca8ca06f5f",
                                "text": "One day Billy Madlock wore two different spikes, a Nike on his left foot for something like fifteen thousand dollars and an Adidas on his right foot for ten thousand."
                            },
                            {
                                "example_id": "0d240723-816e-41fa-b380-56f422ab21fe",
                                "sense_id": "77b4a5a4-dd88-328f-b6dd-68ca8ca06f5f",
                                "text": "In fact, a whole cottage industry seems to have developed around the world’s floating debris, so if you should find a Nike on the beach, check the serial number on the insole then contact the nearest oceanographic institute."
                            },
                            {
                                "example_id": "5013ce7e-0590-43f5-a569-491c068796d3",
                                "sense_id": "77b4a5a4-dd88-328f-b6dd-68ca8ca06f5f",
                                "text": "“Your shoes don’t match,” I say. “I know,” Mickey says, and as he answers he keeps jogging forward, but stops throwing punches. “The Nikes give me shin splints and the Asics hurt my knees, so I wear a Nike on my left foot where I have the bad knee and I wear the Asics on my right foot where the shin splints are worse.”"
                            },
                            {
                                "example_id": "fbebf508-f824-4132-9d2d-a6b405a86897",
                                "sense_id": "77b4a5a4-dd88-328f-b6dd-68ca8ca06f5f",
                                "text": "Next came the shoes. One at a time. I peered out from beneath the tree. A skinny woman in a hot pink satin bra leaned out the window, holding a Nike in optimum pitching position. A grubby, shirtless guy in sweatpants and bare feet rushed out of the building. “Jenna!” he screamed. “You bitch! Don’t you dare!” “Bite me!” Jenna threw the Nike."
                            }
                        ]
                    }
