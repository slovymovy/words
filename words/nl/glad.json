        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "e9f6b411-6b4d-3e83-89e8-760255cd1d3d",
                    "sense_definition": "Helemaal of volkomen; vaak gebruikt om een negatieve betekenis te versterken.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ben onze afspraak <w>glad</w> vergeten.",
                            "target_lang_translations": {
                                "en": "I <w>completely</w> forgot our appointment.",
                                "ru": "Я <w>напрочь</w> забыл о нашей встрече.",
                                "pl": "Zapomniałem o naszym spotkaniu <w>na śmierć</w>.",
                                "de": "Ich habe unsere Verabredung doch <w>glatt</w> vergessen.",
                                "fr": "J'ai <w>complètement</w> oublié notre rendez-vous.",
                                "it": "Ho <w>completamente</w> dimenticato il nostro appuntamento.",
                                "cs": "Na naši schůzku jsem <w>úplně</w> zapomněl.",
                                "tr": "Randevumuzu <w>tamamen</w> unutmuşum.",
                                "es": "Me he olvidado <w>por completo</w> de nuestra cita."
                            }
                        },
                        {
                            "text": "Je hebt het <w>glad</w> mis als je dat denkt.",
                            "target_lang_translations": {
                                "en": "You are <w>completely</w> wrong if you think that.",
                                "ru": "Ты <w>совершенно</w> неправ, если так думаешь.",
                                "pl": "Masz <w>zupełną</w> nieprawdę, jeśli tak myślisz.",
                                "de": "Du liegst <w>völlig</w> falsch, wenn du das denkst.",
                                "fr": "Tu te trompes <w>lourdement</w> si tu penses cela.",
                                "it": "Ti sbagli <w>di grosso</w> se pensi questo.",
                                "cs": "Pokud si to myslíš, tak se <w>naprosto</w> pleteš.",
                                "tr": "Eğer öyle düşünüyorsan <w>tamamen</w> yanılıyorsun.",
                                "es": "Estás <w>completamente</w> equivocado si piensas eso."
                            }
                        }
