                                        "entry_id": "bff5b32a-e690-3a93-8768-10b27d1efd1b",
                                        "glosses": [
                                            "Normal tissue (or an organ) present at an abnormal part of the body"
                                        ],
                                        "tags": [
                                            "countable",
