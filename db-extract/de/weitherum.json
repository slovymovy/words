                "translations": [
                    {
                        "translation_id": "458606b5-1cc1-4e24-aaf2-837acc0054c4",
                        "source_entry_id": "99495bb3-0d16-3f1f-9bc6-691f7a23c22d",
                        "source_sense_id": "81edd733-5785-35f4-9dff-35147898a6ff",
                        "source_sense_description": "in weitem Umkreis, bis in weite Ferne",
                        "target_lang_word": "de loin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "de loin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1d2136c5-e3b0-3300-a049-ed3341761513",
                                        "entry_id": "4d5c7082-35a1-3bb5-8526-94644a4beaad",
                                        "glosses": [
                                            "D’un endroit éloigné (relativement à un point déterminé)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "947bde2b-1f47-4838-a9dc-c0e792beffe5",
                                                "sense_id": "1d2136c5-e3b0-3300-a049-ed3341761513",
                                                "text": "Le chat gris, un peu sauvage, nous regardait de loin, à travers la balustrade de l’escalier au fond, sans oser descendre."
                                            },
                                            {
                                                "example_id": "b50de493-d46b-40bc-b9eb-5bc870ae1805",
                                                "sense_id": "1d2136c5-e3b0-3300-a049-ed3341761513",
                                                "text": "Ils avaient terminé leur repas et sirotaient un café-filtre, en regardant de loin le mouvement de la rue."
                                            },
                                            {
                                                "example_id": "9b77e761-9d04-4a2d-b3e3-d5a7c7fbfb2f",
                                                "sense_id": "1d2136c5-e3b0-3300-a049-ed3341761513",
                                                "text": "Des bataillons de VRP lancés dans tout le pays à l'assaut des bars-tabacs, des tabacs-presse, des civettes repérables de loin grâce à leur célèbre carotte rouge."
                                            },
                                            {
                                                "example_id": "bdbfc27b-b124-4d1c-aae5-99f80138514d",
                                                "sense_id": "1d2136c5-e3b0-3300-a049-ed3341761513",
                                                "text": "Il en venait à mieux connaître le campement adverse que le sien, passait plus de temps proche de ses cibles que de ceux qu’il protégeait et, par-dessus tout, il tirait de loin. En un mot comme en cent, il était pour la journée préservé du combat au corps à corps et de la violence pure."
                                            },
                                            {
                                                "example_id": "2853a1f4-89af-4237-a56c-5c311ec2a0c6",
                                                "sense_id": "1d2136c5-e3b0-3300-a049-ed3341761513",
                                                "text": "Il en venait à mieux connaître le campement adverse que le sien, passait plus de temps proche de ses cibles que de ceux qu’il protégeait et, par-dessus tout, il tirait de loin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f1e5f74-0151-30e1-a764-b49ac251e911",
                                        "entry_id": "4d5c7082-35a1-3bb5-8526-94644a4beaad",
                                        "glosses": [
                                            "D’une période éloignée du moment présent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6154821e-0a48-4167-8688-f9e0be575f4a",
                                                "sense_id": "9f1e5f74-0151-30e1-a764-b49ac251e911",
                                                "text": "C’est un souvenir qui me revient de loin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4faa933-f22f-3aa7-a510-b30bace36a78",
                                        "entry_id": "4d5c7082-35a1-3bb5-8526-94644a4beaad",
                                        "glosses": [
                                            "Largement, loin s’en faut."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a880633f-03dc-4a17-acd3-13249faa7e26",
                                                "sense_id": "a4faa933-f22f-3aa7-a510-b30bace36a78",
                                                "text": "J'ai vu, dans ma longue carrière d'ingénieur acousticien, bien des matières excellentes conductrices du son, mais jamais je n'en rencontrerai une seule comparable, même de loin, à celle dont sont pétris les murs de l'hôtel Terminus à Marseille."
                                            },
                                            {
                                                "example_id": "eb1827de-23aa-4d23-b96c-dd89079513fb",
                                                "sense_id": "a4faa933-f22f-3aa7-a510-b30bace36a78",
                                                "text": "Les adverbes « soudain » ou « brusquement » ne sont jamais utilisés par les Morvandiaux qui leur préfèrent, de loin, la locution « tout par un coup »."
                                            },
                                            {
                                                "example_id": "1a1fa2c0-70c4-4dec-80a1-f361cd3b0b7f",
                                                "sense_id": "a4faa933-f22f-3aa7-a510-b30bace36a78",
                                                "text": "Un lâcher de pigeons, c'est la cohérence parfaite anthropomorphe de l'air et du temps ! De fait, Marie était devenue une aficionado (enfin da !) des lâchers de pigeons. C'est un spectacle qui dépasse, et de loin, le Cirque du Soleil !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a678b7f-ed4d-42aa-8b56-eb697becfd36",
                        "source_entry_id": "99495bb3-0d16-3f1f-9bc6-691f7a23c22d",
                        "source_sense_id": "81edd733-5785-35f4-9dff-35147898a6ff",
                        "source_sense_description": "in weitem Umkreis, bis in weite Ferne",
                        "target_lang_word": "à la ronde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à la ronde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e5f7498a-453f-3ea5-b686-421180689e01",
                                        "entry_id": "7a719dca-f120-3200-ae78-1dea708f5bc9",
                                        "glosses": [
                                            "Tout autour ; aux alentours."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34799e5e-b375-4259-84f2-ab5a8ce9ee7b",
                                                "sense_id": "e5f7498a-453f-3ea5-b686-421180689e01",
                                                "text": "Sa jonchée est commercialisée en circuit ultra-court, dans les 30 kilomètres à la ronde."
                                            },
                                            {
                                                "example_id": "c80fa028-9a3d-4461-950f-00f24f32af2b",
                                                "sense_id": "e5f7498a-453f-3ea5-b686-421180689e01",
                                                "text": "…et il était connu à cinq lieues à la ronde pour sa bonté naturelle et aussi (chacun a ses petits défauts) pour son insolence rare et d'ailleurs sans malice, quand les libations trop prolongées l'avaient mis hors de ce qu'il est convenu d'appeler l'état normal."
                                            },
                                            {
                                                "example_id": "6555df21-0d42-4e62-95b8-d137f88cd533",
                                                "sense_id": "e5f7498a-453f-3ea5-b686-421180689e01",
                                                "text": "Gallifet était aussi éloigné du cléricalisme que du nationalisme. Des innombrables coups de boutoir qu’il distribuait à la ronde avec un esprit endiablé il réservait une bonne part aux cagots et aux patriotards."
                                            },
                                            {
                                                "example_id": "88050bd4-f95b-4482-a391-93e119e19efc",
                                                "sense_id": "e5f7498a-453f-3ea5-b686-421180689e01",
                                                "text": "« On la vend deux sous, paroles et musique ! » clamait la bonisseuse, tendant sa chanson à la ronde."
                                            },
                                            {
                                                "example_id": "c2a15945-9f41-42ae-8484-9d38d3a03fb6",
                                                "sense_id": "e5f7498a-453f-3ea5-b686-421180689e01",
                                                "text": "Un baryton, Monsieur Lavallée, avait apporté une bouteille de porto, et il en proposa à la ronde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f278d258-68c6-47d4-af03-929e9e7f62b7",
                        "source_entry_id": "99495bb3-0d16-3f1f-9bc6-691f7a23c22d",
                        "source_sense_id": "e2e3e350-a95f-3eef-896e-78a34f89e12e",
                        "source_sense_description": "sehr, in großem Maße",
                        "target_lang_word": "largement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "largement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b2c07cc6-50da-34a0-81f3-cfbf95c5fc3e",
                                        "entry_id": "d3f0c559-e4c1-3e40-b7c7-6d1a657a3b3d",
                                        "glosses": [
                                            "D’une manière large ; abondamment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03269489-c021-432f-b167-1e6c1b776327",
                                                "sense_id": "b2c07cc6-50da-34a0-81f3-cfbf95c5fc3e",
                                                "text": "Je lui eusse offert un de ces londrès de choix dont ma sacoche est largement approvisionnée."
                                            },
                                            {
                                                "example_id": "835c5755-9f44-4b3a-81fa-36c80fcc6146",
                                                "sense_id": "b2c07cc6-50da-34a0-81f3-cfbf95c5fc3e",
                                                "text": "Dans le champ du public largement il moissonne."
                                            },
                                            {
                                                "example_id": "ad92499c-d076-438f-bd26-18cdac37bedb",
                                                "sense_id": "b2c07cc6-50da-34a0-81f3-cfbf95c5fc3e",
                                                "text": "Mais pour quelque beau compliment, Il en donnait, et largement."
                                            },
                                            {
                                                "example_id": "ff8ee586-f634-4220-93e4-3441b72fa628",
                                                "sense_id": "b2c07cc6-50da-34a0-81f3-cfbf95c5fc3e",
                                                "text": "Lorsqu'on les nourrit trop largement [les chevaux], leurs jambes se gonflent, et bientôt ils ne font plus de service."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "817c1411-48ca-30fb-92fe-487d35d689b9",
                                        "entry_id": "d3f0c559-e4c1-3e40-b7c7-6d1a657a3b3d",
                                        "glosses": [
                                            "D’une manière étendue ou ample."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0aa134b-bb3a-4bb3-9a63-f4604adc8d8b",
                                                "sense_id": "817c1411-48ca-30fb-92fe-487d35d689b9",
                                                "text": "Des pennes de la queue les huit intermédiaires sont noires en entier ; les deux extérieures, de chaque côté, sont largement échancrées de blanc."
                                            },
                                            {
                                                "example_id": "0299c508-f31e-4524-9f99-7b10f1157f22",
                                                "sense_id": "817c1411-48ca-30fb-92fe-487d35d689b9",
                                                "text": "Cette panoplie de données objectives et quantifiées permet de dépasser largement l’approche intuitive, pifométrique et incertaine qui reste la plus souvent celle de la psychologie historique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "281a8c4a-9a87-37a4-a36c-b17d96133442",
                                        "entry_id": "d3f0c559-e4c1-3e40-b7c7-6d1a657a3b3d",
                                        "glosses": [
                                            "Sans subtilité ; sans minutie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a96cb3a-7d73-4d7a-b6c6-e189a2d81025",
                                                "sense_id": "281a8c4a-9a87-37a4-a36c-b17d96133442",
                                                "text": "Envisager largement une question. Discuter largement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05295ea2-7025-3b10-af04-05aad017284c",
                                        "entry_id": "d3f0c559-e4c1-3e40-b7c7-6d1a657a3b3d",
                                        "glosses": [
                                            "Plus ; au moins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65eac527-96be-4fce-af53-4c713bbb2f6e",
                                                "sense_id": "05295ea2-7025-3b10-af04-05aad017284c",
                                                "text": "Il a largement dix mille livres de rente."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
