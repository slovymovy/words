                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e00a59d-ac45-4bf0-ad18-146c0b8959b2",
                                                "sense_id": "adda27ef-8d70-3834-837f-e911a0d921f2",
                                                "text": "Le fronton du Panthéon porte l’épigraphe « Aux grands hommes, la patrie reconnaissante »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62209543-ca9a-3bd5-9a80-45188ddb9a4e",
                                        "entry_id": "4f1706e6-c012-3ef4-ac0d-b4ec5f445ad1",
                                        "glosses": [
                                            "Courte sentence, courte citation en tête d’un livre, d’un chapitre, etc., pour en indiquer l’objet ou l’esprit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6369c14-72c3-47ea-9147-c256e2fd1350",
                                                "sense_id": "62209543-ca9a-3bd5-9a80-45188ddb9a4e",
                                                "text": "Il a pris pour épigraphe tel vers d’Homère, de Virgile."
                                            },
                                            {
                                                "example_id": "8669074e-6311-4915-bebf-d4366a0ba49c",
                                                "sense_id": "62209543-ca9a-3bd5-9a80-45188ddb9a4e",
                                                "text": "Samuel a eu le front d’y établir pour épigraphe : Auri sacra fames !"
                                            },
                                            {
                                                "example_id": "74ceeab6-157d-4851-8506-ecdcc8357ea3",
                                                "sense_id": "62209543-ca9a-3bd5-9a80-45188ddb9a4e",
                                                "text": "L’épigraphe de ce chapitre rend l’impression qu’éprouvaient à la fin de l’empire ceux qui se jetaient dans la lutte pour la liberté."
                                            }
                                        ]
                                    }
                                ]
                            },
