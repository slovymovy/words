{
    "word_family": [
        "growth",
        "grower",
        "overgrow",
        "undergrow"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "985dc221-608d-391f-8bc6-43a4cd67f5a4",
                    "sense_definition": "To become too big or mature to continue using, needing, or believing in something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "maturation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Children often <w>outgrow</w> their clothes very quickly.",
                            "target_lang_translations": {
                                "ru": "Дети часто очень быстро <w>перерастают</w> свою одежду."
                            }
                        },
                        {
                            "text": "Many people eventually <w>outgrow</w> their childhood fears.",
                            "target_lang_translations": {
                                "ru": "Многие люди со временем <w>перерастают</w> свои детские страхи."
                            }
                        }
                    ],
                    "synonyms": [
                        "grow out of"
                    ],
                    "common_phrases": [
                        "outgrow clothes",
                        "outgrow habits"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стать слишком большим или взрослым для чего-либо, перерасти что-то (одежду, привычки, интересы)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перерастать",
                                "target_lang_sense_clarification": "одежду или возрастные интересы"
                            },
                            {
                                "target_lang_word": "вырастать из",
                                "target_lang_sense_clarification": "одежды или детских привычек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c407284-c5ca-30d7-9655-7e7ceddff8d8",
                    "sense_definition": "To grow at a faster rate or reach a larger size than another entity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "maturation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weeds in the garden began to <w>outgrow</w> the flowers.",
                            "target_lang_translations": {
                                "ru": "Сорняки в саду начали <w>перерастать</w> цветы."
                            }
                        },
                        {
                            "text": "Stronger seedlings will <w>outgrow</w> the weaker ones in the same soil.",
                            "target_lang_translations": {
                                "ru": "Более сильные саженцы <w>перерастут</w> слабые в той же почве."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Расти быстрее или достигать больших размеров, чем кто-либо или что-либо другое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перерастать",
                                "target_lang_sense_clarification": "в физическом росте или развитии"
                            },
                            {
                                "target_lang_word": "обгонять в росте",
                                "target_lang_sense_clarification": "о растениях или организмах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}