                ],
                "senses": [
                    {
                        "sense_id": "46d7fd83-c8ce-3a44-bc48-73161d4a0c4f",
                        "entry_id": "3e1fc41e-1f83-3e06-a61f-7a4c131ad41f",
                        "glosses": [
                            "Gesetz zur Bewältigung einer große Teile einer Gesellschaft betreffenden Notlage oder Gefahr (= Notstand)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "add099de-ac2f-4654-bb80-52c84ca1aa08",
                                "sense_id": "46d7fd83-c8ce-3a44-bc48-73161d4a0c4f",
                                "text": "„Das britische Parlament hat ein Notstandsgesetz zur Bewältigung der Coronavirus-Pandemie beschlossen.“"
                            },
                            {
                                "example_id": "8f53e073-3b9c-4096-8e08-9ef47246b132",
                                "sense_id": "46d7fd83-c8ce-3a44-bc48-73161d4a0c4f",
                                "text": "„Damals, als er im Konservatorium aufgehört hatte, war doch auch die Sache mit den Notstandsgesetzen gewesen, dachte er, als er im Dunkeln lag und dem immer noch regen Verkehr lauschte.“"
                            },
                            {
                                "example_id": "9c7b8022-859f-4236-af97-ebab6a31fd27",
                                "sense_id": "46d7fd83-c8ce-3a44-bc48-73161d4a0c4f",
                                "text": "„Doch in die Annalen der Kölner Uni ging dieses Datum nicht wegen der Verabschiedung der Notstandsgesetze ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
