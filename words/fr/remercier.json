    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7a93a37e-224b-3613-942a-757cb4b7d5fd",
                    "sense_definition": "Exprimer sa gratitude ou sa reconnaissance envers quelqu'un pour un bienfait, un service ou une attention.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "gratitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je tiens à vous <w>remercier</w> pour votre aide précieuse."
                        },
                        {
                            "text": "Il a chaleureusement <w>remercié</w> ses amis après la fête."
                        }
                    ],
                    "common_phrases": [
                        "remercier chaleureusement",
                        "remercier de tout cœur"
                    ]
                },
                {
                    "sense_id": "983ef787-f29d-396d-a02b-c24fa715211d",
                    "sense_definition": "Décliner ou refuser poliment une proposition, une invitation ou un service.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "refus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quand le serveur lui a proposé un dessert, elle a préféré <w>remercier</w> poliment."
                        },
                        {
                            "text": "Le voyageur a <w>remercié</w> sans hésiter lorsqu'on lui a offert une place assise."
                        }
                    ],
                    "synonyms": [
                        "décliner",
                        "refuser"
                    ],
                    "antonyms": [
                        "accepter"
                    ],
                    "common_phrases": [
                        "remercier poliment"
                    ]
                },
                {
                    "sense_id": "adc91599-8efd-3656-9a4e-c2552f8e7815",
                    "sense_definition": "Mettre fin au contrat de travail d'un employé, congédier.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "licenciement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La direction a décidé de <w>remercier</w> plusieurs cadres en raison de la crise."
                        },
                        {
                            "text": "Cet employé a été <w>remercié</w> après des années de bons et loyaux services."
                        }
                    ],
                    "synonyms": [
                        "congédier",
                        "licencier",
                        "renvoyer"
                    ],
                    "antonyms": [
                        "embaucher",
                        "engager",
                        "recruter"
                    ],
                    "common_phrases": [
                        "être remercié",
                        "remercier un employé"
                    ]
                }
            ]
        }
    ]
