                "senses": [
                    {
                        "sense_id": "b390cc62-f735-3881-bbe5-3aac645404c4",
                        "entry_id": "43fe1edd-1d19-340a-b5cf-bf62133b2419",
                        "glosses": [
                            "betrekking hebbend op het magnetisme van de aarde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "544bda89-048d-4619-b020-078b04c3db47",
                                "sense_id": "b390cc62-f735-3881-bbe5-3aac645404c4",
                                "text": "De International Sun/Earth Explorer 3 werd in 1978 gelanceerd om onderzoek te doen naar de invloed van de zonnewind op het aardmagnetisch veld."
                            },
                            {
                                "example_id": "dd349be6-1b43-42f1-90af-ec2c94906f98",
                                "sense_id": "b390cc62-f735-3881-bbe5-3aac645404c4",
                                "text": "Het was de bedoeling dat de Kounotori (\"ooievaar\") het ruimtepuin met een draad van 700 meter in een lagere baan om de aarde zou brengen. De geleidende draad had het aardmagnetisch veld moeten gebruiken om de brokstukken af te remmen. Daarop zouden ze in de atmosfeer verbranden."
                            }
                        ]
                    }
