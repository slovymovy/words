                "senses": [
                    {
                        "sense_id": "5e393a34-91ae-3efd-8224-a652093dcd51",
                        "entry_id": "f6881fc4-bb82-3889-8c05-c3d3ba6d02e6",
                        "glosses": [
                            "das Gesicht bedeckende Schutzmaske, die vor ABC-Kampfstoffen schützt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24b094e4-8859-41dc-9023-d7398a7e504e",
                                "sense_id": "5e393a34-91ae-3efd-8224-a652093dcd51",
                                "text": "„Zu Beginn einer Übung auf einem Truppenübungsplatz sollte die Einsatzbereitschaft der ABC-Schutzmaske geprüft werden.“"
                            },
                            {
                                "example_id": "df20d902-1830-4ccd-a048-e5e58c76cc20",
                                "sense_id": "5e393a34-91ae-3efd-8224-a652093dcd51",
                                "text": "„Wer es im Kreuz hat, müßte nach Breuers Vorstellungen dennoch zum Bund; ihm bliebe lediglich erspart, schweres Sturmgepäck zu schleppen; Rekruten mit allergischem Asthma bräuchten nicht die ABC-Schutzmaske anzulegen; wer trotz eines Meniskusschadens in die Kaserne könne, dürfte in der Schreibstube Bürodienst schieben, wenn seine Kameraden ins Manöver ziehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
