{
    "word_family": [
        "interpellation",
        "interpellateur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e683fc1d-9dfd-35fd-b9f7-9790d702e09e",
                    "sense_definition": "Adresser la parole à quelqu'un, souvent de manière vive, soudaine ou directe.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "parole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un inconnu m'<w>interpelle</w> dans la rue pour me demander l'heure."
                        },
                        {
                            "text": "Le commerçant <w>interpelle</w> les clients qui passent devant sa boutique."
                        }
                    ],
                    "common_phrases": [
                        "interpeller un passant"
                    ]
                },
                {
                    "sense_id": "32b3d50d-7c2d-3a40-8dd8-e2f34a4d2cc2",
                    "sense_definition": "Contrôler l'identité d'une personne ou l'arrêter dans le cadre d'une enquête policière.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "police",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les forces de l'ordre ont <w>interpellé</w> deux suspects après le vol."
                        },
                        {
                            "text": "Le voleur a été <w>interpellé</w> par la police à la gare."
                        }
                    ],
                    "synonyms": [
                        "appréhender"
                    ],
                    "common_phrases": [
                        "interpeller un suspect",
                        "être interpellé par la police"
                    ]
                },
                {
                    "sense_id": "079408b6-72cb-32b1-a5cd-1406fe0dae3c",
                    "sense_definition": "Susciter une réflexion, attirer fortement l'attention ou provoquer une réaction intellectuelle ou morale.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce documentaire sur le climat <w>interpelle</w> de nombreux spectateurs."
                        },
                        {
                            "text": "Son attitude étrange lors de la réunion m'a beaucoup <w>interpellé</w>."
                        }
                    ],
                    "common_phrases": [
                        "interpeller l'opinion publique"
                    ]
                },
                {
                    "sense_id": "c05c6f30-3887-33b3-b0c4-b5034968088c",
                    "sense_definition": "Demander solennellement des explications à un ministre ou au gouvernement sur sa politique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le député souhaite <w>interpeller</w> le ministre sur la crise du logement."
                        },
                        {
                            "text": "L'opposition a décidé d'<w>interpeller</w> le gouvernement à propos des réformes récentes."
                        }
                    ],
                    "common_phrases": [
                        "interpeller le gouvernement",
                        "interpeller un ministre"
                    ]
                }
            ]
        }
    ]
}