    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e3a51cd0-2fd0-39b9-85e9-6cf397834cf8",
                    "sense_definition": "Apparence trompeuse ou dérisoire d'une réalité ; imitation imparfaite ou grossière.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "illusion_imitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce vote truqué n'était qu'un <w>simulacre</w> de démocratie organisé par le régime en place."
                        },
                        {
                            "text": "Le tribunal a prononcé la sentence après un véritable <w>simulacre</w> de justice sans débat contradictoire."
                        }
                    ],
                    "synonyms": [
                        "caricature",
                        "ersatz",
                        "pâle copie"
                    ],
                    "common_phrases": [
                        "simulacre de démocratie",
                        "simulacre de justice"
                    ]
                },
                {
                    "sense_id": "a72755e1-b21a-399f-bd20-a6c0731a4789",
                    "sense_definition": "Action feinte ou simulée destinée à donner le change ou à faire illusion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action_feinte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux adversaires ont fait un <w>simulacre</w> de combat pour amuser la foule réunie."
                        },
                        {
                            "text": "Le comédien a fait le <w>simulacre</w> de frapper son partenaire sans jamais le toucher."
                        }
                    ],
                    "common_phrases": [
                        "simulacre de combat",
                        "faire le simulacre de"
                    ]
                },
                {
                    "sense_id": "d867dd67-cf12-369f-8541-729df652a3c6",
                    "sense_definition": "Représentation matérielle, statue ou image servant d'objet de culte dans l'Antiquité ; idole.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "statue_culte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les fidèles apportaient des offrandes devant le <w>simulacre</w> doré de la divinité païenne."
                        },
                        {
                            "text": "Dans ce temple antique, chaque <w>simulacre</w> sculpté représentait un héros mythologique légendaire."
                        }
                    ],
                    "common_phrases": [
                        "simulacres des dieux"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Employé principalement dans un contexte historique ou littéraire."
                        }
                    ]
                },
                {
                    "sense_id": "f06a5da0-303b-3b3c-aba7-9fe51451b5ea",
                    "sense_definition": "Apparence vaine, illusion ou vision immatérielle que l'on prend pour une réalité.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "illusion_imitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le philosophe affirme que le monde sensible n'est composé que de vains <w>simulacres</w>."
                        },
                        {
                            "text": "Perdu dans le brouillard nocturne, le voyageur croyait apercevoir d'étranges <w>simulacres</w> en mouvement."
                        }
                    ],
                    "synonyms": [
                        "apparence"
                    ],
                    "common_phrases": [
                        "vains simulacres"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Usage philosophique ou poétique."
                        }
                    ]
                }
            ]
        }
    ]
