                    {
                        "sense_id": "d3df87fe-de3c-3923-874a-a977d0c0b901",
                        "entry_id": "abb98ac9-849a-321d-84fa-b986291f6b86",
                        "glosses": [
                            "Rivière de Mongolie."
                        ],
                        "tags": [
                            "Cours d’eau"
                        ],
                        "examples": [
                            {
                                "example_id": "2b42c7d3-137a-4b0f-949e-5ac6bacbe1e2",
                                "sense_id": "d3df87fe-de3c-3923-874a-a977d0c0b901",
                                "text": "Siba, la, (Géog. mod.) riviere de la grande Tartarie, & qui s’appelloit autrefois Altui. Elle a sa source dans les montagnes d’une branche du Caucase, à 43d de latitude, au sud des sources de la Jéniséa, & elle se perd vers le nord de deserts du Goby. Ses bords sont habités par les Monugales de l’ouest, qui ont un petit kan pour chef."
                            }
                        ]
                    }
                ],
