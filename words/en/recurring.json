{
    "word_family": [
        "recur",
        "recurrence",
        "recurrent",
        "recurrently"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fce02963-f0d4-3e1e-b07e-51fe2d34433c",
                    "sense_definition": "Happening or occurring frequently, with repetition.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Revenge is a <w>recurring</w> theme in this novel.",
                            "target_lang_translations": {
                                "ru": "Месть — это <w>повторяющаяся</w> тема в этом романе.",
                                "nl": "Wraak is een <w>terugkerend</w> thema in deze roman."
                            }
                        },
                        {
                            "text": "He went to the doctor to treat his <w>recurring</w> back pain.",
                            "target_lang_translations": {
                                "ru": "Он пошел к врачу, чтобы вылечить свою <w>повторяющуюся</w> боль в спине.",
                                "nl": "Hij ging naar de dokter om zijn <w>terugkerende</w> rugpijn te behandelen."
                            }
                        }
                    ],
                    "synonyms": [
                        "recurrent",
                        "repetitive"
                    ],
                    "common_phrases": [
                        "recurring theme",
                        "recurring dream",
                        "recurring problem",
                        "recurring nightmare"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий часто или многократно; появляющийся снова.",
                        "nl": "Iets dat vaak gebeurt of telkens opnieuw optreedt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повторяющийся",
                                "target_lang_sense_clarification": "происходящий снова и снова"
                            },
                            {
                                "target_lang_word": "периодический",
                                "target_lang_sense_clarification": "происходящий через определенные промежутки времени"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "terugkerend",
                                "target_lang_sense_clarification": "iets dat telkens opnieuw optreedt"
                            },
                            {
                                "target_lang_word": "zich herhalend",
                                "target_lang_sense_clarification": "iets dat zich steeds weer voordoet"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4c0c467-3f12-3198-908b-7f32e4a433dc",
                    "sense_definition": "Of a decimal: having a set of digits that is repeated indefinitely.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every rational number can be written as either a terminating decimal or a <w>recurring</w> decimal.",
                            "target_lang_translations": {
                                "ru": "Любое рациональное число можно записать либо как конечную, либо как <w>периодическую</w> десятичную дробь.",
                                "nl": "Elk rationaal getal kan worden geschreven als een eindige decimaal of een <w>repeterende</w> decimaal."
                            }
                        },
                        {
                            "text": "The fraction one third results in a <w>recurring</w> decimal like 0.333.",
                            "target_lang_translations": {
                                "ru": "Дробь одна третья дает <w>периодическую</w> десятичную дробь, например 0,333.",
                                "nl": "De breuk één derde resulteert in een <w>repeterende</w> decimaal zoals 0,333."
                            }
                        }
                    ],
                    "common_phrases": [
                        "recurring decimal"
                    ],
                    "target_lang_definitions": {
                        "ru": "О десятичной дроби: имеющий бесконечно повторяющуюся группу цифр.",
                        "nl": "Bij een decimaal getal: met een reeks cijfers die zich oneindig herhaalt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "периодический",
                                "target_lang_sense_clarification": "математический термин"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "repeterend",
                                "target_lang_sense_clarification": "wiskundige term voor een herhalende reeks cijfers"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c8b9c751-ebe8-3cd8-b6cb-f26f384909bc",
                    "sense_definition": "Present participle and gerund of <w>recur</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to prevent this error from <w>recurring</w> in the future.",
                            "target_lang_translations": {
                                "ru": "Нам нужно предотвратить <w>повторение</w> этой ошибки в будущем.",
                                "nl": "We moeten voorkomen dat deze fout in de toekomst <w>terugkeert</w>."
                            }
                        },
                        {
                            "text": "The symptoms kept <w>recurring</w> despite the treatment.",
                            "target_lang_translations": {
                                "ru": "Симптомы продолжали <w>возвращаться</w> несмотря на лечение.",
                                "nl": "De symptomen bleven <w>terugkeren</w> ondanks de behandeling."
                            }
                        }
                    ],
                    "common_phrases": [
                        "keep recurring",
                        "prevent from recurring"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма причастия и герундия от глагола recur (повторяться, возвращаться).",
                        "nl": "De onvoltooid deelwoord- of gerundiumvorm van 'terugkeren' of 'zich herhalen'."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повторяться",
                                "target_lang_sense_clarification": "происходить снова"
                            },
                            {
                                "target_lang_word": "возвращаться",
                                "target_lang_sense_clarification": "появляться вновь (о мыслях, симптомах)"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "terugkerend",
                                "target_lang_sense_clarification": "opnieuw optredend"
                            },
                            {
                                "target_lang_word": "zich herhalend",
                                "target_lang_sense_clarification": "opnieuw plaatsvindend"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "36de43df-1826-3c8d-8183-e43f9c8cb57b",
                    "sense_definition": "A recurrence; a coming round again.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The endless <w>recurrings</w> of the seasons bring a sense of stability.",
                            "target_lang_translations": {
                                "ru": "Бесконечные <w>повторения</w> времен года приносят ощущение стабильности.",
                                "nl": "De eindeloze <w>herhaling</w> van de seizoenen brengt een gevoel van stabiliteit."
                            }
                        },
                        {
                            "text": "He wrote a poem about the <w>recurrings</w> of historical events.",
                            "target_lang_translations": {
                                "ru": "Он написал стихотворение о <w>повторениях</w> исторических событий.",
                                "nl": "Hij schreef een gedicht over de <w>herhalingen</w> van historische gebeurtenissen."
                            }
                        }
                    ],
                    "synonyms": [
                        "reiteration",
                        "reoccurrence",
                        "repeat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Повторение; возвращение чего-либо.",
                        "nl": "Een herhaling; het opnieuw voorkomen van iets."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повторение",
                                "target_lang_sense_clarification": "действие или событие"
                            },
                            {
                                "target_lang_word": "возвращение",
                                "target_lang_sense_clarification": "возобновление"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "herhaling",
                                "target_lang_sense_clarification": "het opnieuw plaatsvinden van een gebeurtenis"
                            },
                            {
                                "target_lang_word": "terugkeer",
                                "target_lang_sense_clarification": "het opnieuw verschijnen van iets"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}