                "senses": [
                    {
                        "sense_id": "bc9e3b40-407b-3be1-95ee-8057cdf8645c",
                        "entry_id": "1d408ee2-4769-3a32-a36e-cc1dc6555b1e",
                        "glosses": [
                            "Donner un caractère cistercien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c01fd4b4-1ca0-466d-beda-a6f69e724faa",
                                "sense_id": "bc9e3b40-407b-3be1-95ee-8057cdf8645c",
                                "text": "Ils marchèrent devant leur siècle, et leur siècle les suivit, s’identifia avec eux, et la société entière fut cistercianisée, selon les expressions des annalistes (omnia Cistercium erat)."
                            },
                            {
                                "example_id": "3039c0f5-5980-4463-877b-467539e48972",
                                "sense_id": "bc9e3b40-407b-3be1-95ee-8057cdf8645c",
                                "text": "La rédaction A « cistercianise » le texte en s’attaquant spécialement à l’enseignement de la versification, travail sans doute réalisé à Viktring (O. Cist.) sous l’impulsion de Baudouin de Viktring."
                            }
                        ]
                    }
