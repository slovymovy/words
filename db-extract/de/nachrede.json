                        ],
                        "form": "die Nachreden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6d599b80-dd34-3b9d-8b23-b447ff46d82b",
                        "entry_id": "bcabf207-4e6a-3d5d-b00a-dfe3a767681e",
                        "glosses": [
                            "(negative) Äußerung über eine nicht anwesende Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be27e3e4-88cd-45d4-9611-606a26982daa",
                                "sense_id": "6d599b80-dd34-3b9d-8b23-b447ff46d82b",
                                "text": "„Diese hinausgeschrienen Worte sind vor allem Öl in das Feuer der Trauernden, das immer wieder angefacht werden will, Öl in ein Feuer, in dem die bösen Geister der Nachrede brennen sollen.“"
                            },
                            {
                                "example_id": "2dac17a2-6af7-4431-8567-d4f96e189354",
                                "sense_id": "6d599b80-dd34-3b9d-8b23-b447ff46d82b",
                                "text": "„Eine üblere Nachrede hatte wohl kaum ein Kaiser. Unter all den schlechten Herrschern, die das Imperium Romanum während der Jahrhunderte seines Bestehens erdulden musste, gilt Elagabal (204–222) als einer der schlechtesten.“"
                            },
                            {
                                "example_id": "361bfce1-9615-4dcd-a29f-63ec7d8c9df4",
                                "sense_id": "6d599b80-dd34-3b9d-8b23-b447ff46d82b",
                                "text": "„Ehe er aber ging, wollte er wenigstens in den Augen der Welt seinen guten Namen hergestellt wissen, daß kein Makel auf ihm haftete, keine giftige Zunge mit verleumderischer Nachrede ihn beflecken konnte.“"
                            },
                            {
                                "example_id": "4ae2c6dd-9410-4655-8217-4f3d86b4c39c",
                                "sense_id": "6d599b80-dd34-3b9d-8b23-b447ff46d82b",
                                "text": "„Gegen Brechter werden allerlei Beschuldigungen erhoben, irgendwelches Hörensagen, Klatsch, üble Nachrede, Verleumdungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4d06a488-119e-342e-a501-ef4ba0ab9ff4",
                        "entry_id": "bcabf207-4e6a-3d5d-b00a-dfe3a767681e",
                        "glosses": [
                            "abschließende Ausführung/Bemerkung zum Ende von etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13b6a73d-1de4-44bf-9595-8c6e91fd5b03",
                                "sense_id": "4d06a488-119e-342e-a501-ef4ba0ab9ff4",
                                "text": "„Die Legenden sind alt, die Nachreden neu, die Tote wurde nicht mehr erwähnt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
