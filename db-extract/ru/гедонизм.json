                                "target_senses": [
                                    {
                                        "sense_id": "97ef3d55-8b6a-3bd4-ac85-23859c8326ec",
                                        "entry_id": "6e655e52-4c95-3353-94d7-5ba263b2f686",
                                        "glosses": [
                                            "doktryna etyczna głosząca, iż rozkosz (i unikanie przykrości/cierpienia) jest najwyższym lub jedynym dobrem i celem życia"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "153791a5-f8b4-49e5-a5e9-3ca3c9317e5d",
                                                "sense_id": "97ef3d55-8b6a-3bd4-ac85-23859c8326ec",
                                                "text": "Sokratejski hedonizm nie jest tedy hedonizmem w ścisłym tego słowa znaczeniu. Jest to bowiem bardzo oryginalna próba racjonalnego uzasadnienia moralności bez odwoływania się do metafizyki (…), możemy tu odnaleźć ciekawą teorię racjonalnego zachowania: wybór przyjemności, utożsamionej z dobrem, jest postrzegany jako naturalna skłonność ludzkiego umysłu"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
