                        "sense_id": "805d1300-9deb-324e-a0f2-43a800876670",
                        "entry_id": "d485d23b-961b-3969-b109-cf4074f30cd0",
                        "glosses": [
                            "Gloominess; sullenness; deep sadness."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "5e21e0c9-afbf-40df-aedf-234fffd017ed",
                                "sense_id": "805d1300-9deb-324e-a0f2-43a800876670",
                                "text": "He acquired a slouching gait and ignoble look; his naturally reserved disposition was exaggerated into an almost idiotic excess of unsociable moroseness; and he took a grim pleasure, apparently, in exciting the aversion rather than the esteem of his few acquaintance."
                            },
                            {
                                "example_id": "1f9aaa19-283e-49a3-889e-3d406ab1614a",
                                "sense_id": "805d1300-9deb-324e-a0f2-43a800876670",
                                "text": "With the typical moroseness of a dipping twitcher he turned to me, looking cynically at my spotlight, and said, `I don't like your chances, mate.'"
                            }
                        ]
                    }
                ],
