                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2100ce4-51a3-4fdf-9530-27bafaa55b77",
                                                "sense_id": "045d483c-1bd7-318d-882c-bbca8eb6b7d7",
                                                "text": "Günter Grass wurde 1927 als Sohn kaschubisch-deutscher Eltern in Danzig-Langfuhr geboren."
                                            },
                                            {
                                                "example_id": "f4c547ea-6e51-48c3-8fe5-d19ebb18b1ef",
                                                "sense_id": "045d483c-1bd7-318d-882c-bbca8eb6b7d7",
                                                "text": "Danzig (polnisch Gdańsk [ɡdaɲsk], kaschubisch Gduńsk) ist eine Metropole in der polnischen Woiwodschaft Pommern, deren Hauptstadt sie ist."
                                            },
                                            {
                                                "example_id": "550dd9e7-fbcd-4a1c-bb80-032b735ab170",
                                                "sense_id": "045d483c-1bd7-318d-882c-bbca8eb6b7d7",
                                                "text": "Aber der Staat ist nicht in seinem Recht, wenn er Präventivmaßregeln nicht nur gegen die Presse selbst, sondern auch gegen diejenigen Personen ergreift, die in irgend einer Beziehung zu derselben stehen; wenn er sie aus einer Stadt in die andere hetzt, bis endlich in das kaschubische Dorf, wo sie geboren sind."
                                            },
                                            {
                                                "example_id": "8c034526-982f-4ee0-b470-c54ca7e9884d",
                                                "sense_id": "045d483c-1bd7-318d-882c-bbca8eb6b7d7",
                                                "text": "Ein traditionelles Gericht ist die Kaszëbskô czarwina in Polnisch Czernina kaszubska, die kaschubische Art dieser Suppe."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
