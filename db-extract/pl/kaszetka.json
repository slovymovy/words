                                    },
                                    {
                                        "sense_id": "56859363-7709-3ab1-bb85-0178247fc620",
                                        "entry_id": "da4b44e6-b234-3720-8cdb-0f21447f5007",
                                        "glosses": [
                                            "A detachable part of a rocket or spacecraft (usually in the nose) containing the crew's living space."
                                        ],
                                        "tags": [],
