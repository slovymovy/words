                                        "entry_id": "ab0bfb38-d13f-38ec-bda4-36c4ea9b82c7",
                                        "glosses": [
                                            "Qui a fait l’objet d’une vente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ce9b94e-1494-4039-98a3-1fe62d97a569",
                                                "sense_id": "bcf1c1b0-035d-396e-82f8-de797411dc46",
                                                "text": "L'image de marque de l’agence immobilière en sortira grandie, parce que le bien visité sera plus beau, mais aussi parce que son panneau publicitaire comportera plus rapidement l’indication « vendu »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2441150-ae5c-304c-a9ad-8c1b6238b30c",
                                        "entry_id": "ab0bfb38-d13f-38ec-bda4-36c4ea9b82c7",
                                        "glosses": [
                                            "Se dit d’un homme livré à quelqu’un ou à un parti par intérêt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ef9a34e-a1fe-4ed7-ae3b-13b72c714014",
                                                "sense_id": "c2441150-ae5c-304c-a9ad-8c1b6238b30c",
                                                "text": "Cet homme est vendu au pouvoir."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vendu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e906902f-e2d5-385f-a3fe-922af6933f92",
                                        "entry_id": "9812dae1-2fef-3792-ae6f-b7212432d8af",
                                        "glosses": [
                                            "Personne qui se livre, à quelqu’un ou à un parti, par intérêt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29f1f04f-a09d-4a0a-8943-3f2bac3d9e28",
                                                "sense_id": "e906902f-e2d5-385f-a3fe-922af6933f92",
                                                "text": "Ainsi le comprenait l'orateur qui flétrissait, il y a trois ans, dans un premier discours, ceux qu'on appelle des vendus, et qui s'annonçait déjà comme l'exécuteur des épurations nécessaires."
                                            },
                                            {
                                                "example_id": "77ce53e8-3805-452e-8767-b1aa989904dd",
                                                "sense_id": "e906902f-e2d5-385f-a3fe-922af6933f92",
                                                "text": "Tous les quarts d'heure,\nUn paon siffleur\nNous traite de péquenots, de vendus, d'abrutis,\nDe vieux débris\nEt j'en oublie."
                                            }
                                        ]
                                    }
                                ]
                            },
