                "senses": [
                    {
                        "sense_id": "2739020f-3cde-31b9-9fab-f766912d828f",
                        "entry_id": "b970a093-fd83-3ccf-b377-de1e79fee9dc",
                        "glosses": [
                            "Naine, femme de très petite taille / atteinte de nanisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f2799be-3b35-48c7-a357-d596785f53bd",
                                "sense_id": "2739020f-3cde-31b9-9fab-f766912d828f",
                                "text": "Ihre Mutter ist eine Zwergin, was besonders auffällig ist: In der Tat sind andere Familienmitglieder sehr gross.",
                                "translation": "Sa mère est une naine, ce qui est particulièrement frappant : en effet, tous les autres membres de la famille sont très grands."
                            }
                        ]
                    },
                    {
                        "sense_id": "d53b6436-a8ea-3ddb-b2ad-34e2e88b7574",
                        "entry_id": "b970a093-fd83-3ccf-b377-de1e79fee9dc",
                        "glosses": [
                            "Naine."
                        ],
                        "tags": [
                            "Fantastique"
                        ],
                        "examples": [
                            {
                                "example_id": "012a6f63-d6a2-42aa-975c-fb04038286be",
                                "sense_id": "d53b6436-a8ea-3ddb-b2ad-34e2e88b7574",
                                "text": "Der Berg ist von Galerien durchgebohrt und drin arbeiten fleissig tausende Zwerginnen und Zwergen.",
                                "translation": "La montagne est traversée de galeries, et des milliers de naines et nains y travaillent assidûment."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
