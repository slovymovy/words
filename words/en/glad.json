                                "nl": "Ik ben <w>blij</w> te horen dat je veilig bent.",
                                "pl": "<w>Cieszę się</w>, że jesteś bezpieczny.",
                                "de": "Ich bin <w>froh</w> zu hören, dass du in Sicherheit bist.",
                                "fr": "Je suis <w>content</w> d'apprendre que tu es en sécurité.",
                                "it": "Sono <w>felice</w> di sapere che sei al sicuro.",
                                "cs": "Jsem <w>rád</w>, že jsi v bezpečí.",
                                "tr": "Güvende olduğunu duyduğuma <w>memnun oldum</w>.",
                                "es": "Me <w>alegra</w> saber que estás a salvo.",
                                "zh": "听说你平安无事，我真<w>高兴</w>。",
                                "ja": "あなたが無事だと聞けて、<w>嬉しい</w>です。",
                                "pt": "Fico <w>contente</w> por saber que estás a salvo."
                            }
                        },
                        {
                            "text": "We are <w>glad</w> about the results of the test.",
                            "target_lang_translations": {
                                "ru": "Мы <w>довольны</w> результатами теста.",
                                "nl": "We zijn <w>blij</w> met de resultaten van de test.",
                                "pl": "Jesteśmy <w>zadowoleni</w> z wyników testu.",
                                "de": "Wir sind <w>erfreut</w> über die Testergebnisse.",
                                "fr": "Nous sommes <w>heureux</w> des résultats du test.",
                                "it": "Siamo <w>contenti</w> dei risultati del test.",
                                "cs": "Máme <w>radost</w> z výsledků toho testu.",
                                "tr": "Testin sonuçlarından <w>memnunuz</w>.",
                                "es": "Estamos <w>contentos</w> con los resultados de la prueba.",
                                "zh": "我们对测试结果感到<w>满意</w>。",
                                "ja": "テストの結果に、私たちは<w>満足</w>しています。",
                                "pt": "Estamos <w>contentes</w> com os resultados do teste."
                            }
                        }
