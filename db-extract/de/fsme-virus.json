                ],
                "senses": [
                    {
                        "sense_id": "22004948-c614-393e-aff9-683f378f999b",
                        "entry_id": "63e0b6e9-a0f0-3a02-be54-0d70ad206a19",
                        "glosses": [
                            "der biologischen Familie der „Flaviviridae“ angehörender Erreger der Frühsommer-Meningoenzephalitis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61c8a27a-f2c8-4b48-ac08-3ec88fc79ad3",
                                "sense_id": "22004948-c614-393e-aff9-683f378f999b",
                                "text": "„1971 entwickelte der Österreicher Kunz mit dem britischen Forscher Keppie den ersten FSME-Impfstoff aus in Kükenembryozellen vermehrten FSME-Viren.“"
                            },
                            {
                                "example_id": "49b2c280-acd0-467c-8e77-16825e0ad621",
                                "sense_id": "22004948-c614-393e-aff9-683f378f999b",
                                "text": "„Das FSME-Virus wird überwiegend durch Zeckenstiche übertragen.“"
                            },
                            {
                                "example_id": "67bd6c3a-6ea9-4b59-a6ae-2a8900759219",
                                "sense_id": "22004948-c614-393e-aff9-683f378f999b",
                                "text": "„Das FSME-Virus kommt in Süddeutschland, Mitteleuropa (Österreich, Tschechien, Slowakei, Polen, Ungarn) und Südschweden vor.“"
                            },
                            {
                                "example_id": "db97a687-8be2-47ae-baf1-c9e58cf38097",
                                "sense_id": "22004948-c614-393e-aff9-683f378f999b",
                                "text": "„Die Durchseuchungsrate der Zecken mit dem FSME-Virus beträgt in der Regel selten mehr als 5 % aller Zecken eines endemischen Gebiets.“"
                            },
                            {
                                "example_id": "5b2c754b-771f-4e65-8fd6-faf938067898",
                                "sense_id": "22004948-c614-393e-aff9-683f378f999b",
                                "text": "„Untersuchungen haben gezeigt, dass in den Endemiegebieten Deutschlands nur etwa jede 50ste bis 100ste Zecke mit FSME-Viren infiziert ist.“"
                            },
                            {
                                "example_id": "83cb5e48-2606-400c-b47a-0b4288f88726",
                                "sense_id": "22004948-c614-393e-aff9-683f378f999b",
                                "text": "„Häufiger als FSME-Viren stecken in den Zecken sogenannte Borrelien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
