        "fr-extract.jsonl": [
            {
                "entry_id": "c2984e69-4858-3517-8640-f927f8151309",
                "word": "distinctement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6bc61cbe-00c1-3806-9d62-6f6d95416643",
                        "entry_id": "c2984e69-4858-3517-8640-f927f8151309",
                        "glosses": [
                            "D’une manière distincte ; qui fait discerner ou entendre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "633e7d20-254e-47df-a843-12a8905de361",
                                "sense_id": "6bc61cbe-00c1-3806-9d62-6f6d95416643",
                                "text": "Si la racine de disette étoit une betterave, les cultivateurs sémeroient-ils si distinctement l'une & l'autre ?"
                            },
                            {
                                "example_id": "0bd97e2c-9a2e-4bd7-b2b5-3ebb2e58841e",
                                "sense_id": "6bc61cbe-00c1-3806-9d62-6f6d95416643",
                                "text": "Hervé les avait vus distinctement tracasser la grille et un grincement de ferrailles lui apprit qu'ils l’avaient fermé à clé, derrière eux, après l’avoir ouverte en arrivant, et qu'ils étaient en train de la rouvrir pour s’en aller."
                            },
                            {
                                "example_id": "331fe66e-d577-461e-9722-61e439181ae4",
                                "sense_id": "6bc61cbe-00c1-3806-9d62-6f6d95416643",
                                "text": "J'ai oublié de vous dire que, pendant que j'étais sur le mont Pagnote à regarder l’attaque, le R. P. de la Chaise était dans la tranchée et même fort près de l’attaque, pour la voir plus distinctement."
                            },
                            {
                                "example_id": "39164d61-04b4-4cfa-9808-9a6bcf82a751",
                                "sense_id": "6bc61cbe-00c1-3806-9d62-6f6d95416643",
                                "text": "La lumière, dans cet air humide et épais, colorait les objets de teintes un peu pâles et en émoussait les angles, comme il arrive quand on s’endort et que rien ne se voit plus distinctement."
                            }
                        ]
                    },
                    {
                        "sense_id": "09dd743f-db27-31e5-8a27-1de2b22c4eef",
                        "entry_id": "c2984e69-4858-3517-8640-f927f8151309",
                        "glosses": [
                            "D’une manière distincte, qui fait comprendre, saisir nettement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f29684e1-e2c2-497b-9bac-ad6b72273085",
                                "sense_id": "09dd743f-db27-31e5-8a27-1de2b22c4eef",
                                "text": "Assez distinctement on me l’a fait entendre."
                            },
                            {
                                "example_id": "54420f59-e44a-43c0-9e7b-51befc119067",
                                "sense_id": "09dd743f-db27-31e5-8a27-1de2b22c4eef",
                                "text": "Mais les songes suivis Et qui distinctement marquent les aventures."
                            },
                            {
                                "example_id": "9482cd02-4601-4aa8-9ed4-604008baae51",
                                "sense_id": "09dd743f-db27-31e5-8a27-1de2b22c4eef",
                                "text": "Les hommes ont commencé par donner différents noms aux choses qui leur ont paru distinctement différentes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af6ba338-57b4-43cf-a36c-d5ca2139dd55",
                        "source_entry_id": "c2984e69-4858-3517-8640-f927f8151309",
                        "target_lang_word": "clearly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clearly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4253b384-f07d-3c18-adcd-ebafed18575a",
                                        "entry_id": "6b38cf32-5bed-3254-8e3e-855638a91e71",
                                        "glosses": [
                                            "In a clear manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "695f2aec-9e34-4b70-ad5a-60b7557941e6",
                                                "sense_id": "4253b384-f07d-3c18-adcd-ebafed18575a",
                                                "text": "He enunciated every syllable clearly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dafa2904-8780-34d6-92c4-ac9245674a8b",
                                        "entry_id": "6b38cf32-5bed-3254-8e3e-855638a91e71",
                                        "glosses": [
                                            "Without a doubt; obviously."
                                        ],
                                        "tags": [
                                            "modal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7744b0e0-d2f5-43ee-88ca-65eef287f79f",
                                                "sense_id": "dafa2904-8780-34d6-92c4-ac9245674a8b",
                                                "text": "Clearly, the judge erred in his opinion."
                                            },
                                            {
                                                "example_id": "ebcc9eea-220f-4d40-829a-f7630f78b950",
                                                "sense_id": "dafa2904-8780-34d6-92c4-ac9245674a8b",
                                                "text": "While Gunners boss Arsene Wenger had warned his players against letting the pre-match festivities distract them from the task at hand, they clearly struggled for fluency early on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce4011fe-dd32-370f-b6f7-c07ed377d1c6",
                                        "entry_id": "6b38cf32-5bed-3254-8e3e-855638a91e71",
                                        "glosses": [
                                            "To a degree clearly discernible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4633d05-925e-4e13-9124-451a88013cab",
                                                "sense_id": "ce4011fe-dd32-370f-b6f7-c07ed377d1c6",
                                                "text": "He was clearly wrong on all points but one."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "833f777a-1e47-4156-8ffc-00b295996ffe",
                        "source_entry_id": "c2984e69-4858-3517-8640-f927f8151309",
                        "target_lang_word": "distinctly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "distinctly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad519687-bfcb-338b-b869-fcd675514af1",
                                        "entry_id": "1f7f69ac-9ac5-3c15-9fe6-5b93d07b8175",
                                        "glosses": [
                                            "In a distinct manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18b7c8ad-6f9a-4d63-93e4-423615b8f2d5",
                                                "sense_id": "ad519687-bfcb-338b-b869-fcd675514af1",
                                                "text": "I distinctly remember the voice of my deceased grandmother."
                                            },
                                            {
                                                "example_id": "59ebcc5d-34fd-46d6-a259-95a81ece9046",
                                                "sense_id": "ad519687-bfcb-338b-b869-fcd675514af1",
                                                "text": "About ten months ago a report reached my ears that a Dutchman had constructed a telescope, by the aid of which visible objects, although at a great distance from the eye of the observer, were seen distinctly as if near; […]"
                                            },
                                            {
                                                "example_id": "6b4671bb-65bf-4869-955d-5f8f218c0e36",
                                                "sense_id": "ad519687-bfcb-338b-b869-fcd675514af1",
                                                "text": "Commander Birch was a trifle uneasy when he found there was more than a popple on the sea; it was, in fact, distinctly choppy."
                                            },
                                            {
                                                "example_id": "4e0abc77-efc2-4fce-8d94-fbe6beef251d",
                                                "sense_id": "ad519687-bfcb-338b-b869-fcd675514af1",
                                                "text": "\"Aloud,\" he said distinctly, \"the Seven Words are spoken thus. Melenkurion abatha. Duroc minas mill. Harad khabaal.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
