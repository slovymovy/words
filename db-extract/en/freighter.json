                "senses": [
                    {
                        "sense_id": "ab65fa17-880d-327d-b47c-fd13c2bf8cc4",
                        "entry_id": "265497e8-bbb5-3ced-b194-93840b551b18",
                        "glosses": [
                            "Frachter, Frachtschiff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cef927ef-9037-4ebc-b70f-ffcd439e3aba",
                                "sense_id": "ab65fa17-880d-327d-b47c-fd13c2bf8cc4",
                                "text": "The freighter transports bananas to Europe.",
                                "translation": "Der Frachter transportiert Bananen nach Europa."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c5354829-2fec-3fc4-abce-1fe349813da0",
                        "entry_id": "265497e8-bbb5-3ced-b194-93840b551b18",
                        "glosses": [
                            "Frachtflugzeug"
                        ],
                        "tags": [
                            "Luftfahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "e745a242-b0ad-48c8-93fe-57ab058975b8",
                                "sense_id": "c5354829-2fec-3fc4-abce-1fe349813da0",
                                "text": "The next freighter lands in two days.",
                                "translation": "Das nächste Frachtflugzeug landet in zwei Tagen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b483bb4c-7b43-4e9f-b5cc-3e0b28afb423",
                        "source_entry_id": "265497e8-bbb5-3ced-b194-93840b551b18",
                        "source_sense_id": "ab65fa17-880d-327d-b47c-fd13c2bf8cc4",
                        "source_sense_description": "Seefahrt: Frachter, Frachtschiff",
                        "target_lang_word": "Frachter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frachter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f27a9b82-0047-3393-9fd0-afac41b7308d",
                                        "entry_id": "5c516105-9d3f-39a9-8ace-c13795723d02",
                                        "glosses": [
                                            "auf den Gütertransport ausgelegtes Schiff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "688c0fe2-4f44-4e9e-aa6e-d11082e77490",
                                                "sense_id": "f27a9b82-0047-3393-9fd0-afac41b7308d",
                                                "text": "Auf dem Rhein verkehren viele Frachter."
                                            },
                                            {
                                                "example_id": "a0593854-464e-4062-880c-19ece8329c40",
                                                "sense_id": "f27a9b82-0047-3393-9fd0-afac41b7308d",
                                                "text": "„Auf dem Weg dorthin sahen sie Frachter und Ausflugsdampfer auf der linken Dammseite vorbeifahren und Züge und Autos auf der rechten.“"
                                            },
                                            {
                                                "example_id": "d970edf7-6fc9-490a-9f4e-d8d9914c0d57",
                                                "sense_id": "f27a9b82-0047-3393-9fd0-afac41b7308d",
                                                "text": "„Heute sind es riesige, hochmoderne Frachter.“"
                                            },
                                            {
                                                "example_id": "a53b8fa0-8f42-4fed-960b-2ce6182b03cc",
                                                "sense_id": "f27a9b82-0047-3393-9fd0-afac41b7308d",
                                                "text": "„Zwei Frachter kommen uns entgegen, in weitem Abstand voneinander.“"
                                            },
                                            {
                                                "example_id": "ba3b18ef-0a2c-4a5e-8b87-3fb334f8f8c7",
                                                "sense_id": "f27a9b82-0047-3393-9fd0-afac41b7308d",
                                                "text": "„Dort fand er einen Frachter, der ihn mitnahm nach New York, wo er 1941 eintraf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4af7c5bb-11df-4fb2-bb91-476a929ac50a",
                        "source_entry_id": "265497e8-bbb5-3ced-b194-93840b551b18",
                        "source_sense_id": "ab65fa17-880d-327d-b47c-fd13c2bf8cc4",
                        "source_sense_description": "Seefahrt: Frachter, Frachtschiff",
                        "target_lang_word": "Frachtschiff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frachtschiff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ae85ca6b-ce4d-3174-87ab-030686c14285",
                                        "entry_id": "0983c7d7-0ef0-36e2-a665-cfde615f6a4d",
                                        "glosses": [
                                            "ausschließlich Frachtgut transportierendes Schiff, sowohl in Binnengewässern als auch auf offener See verkehrend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2240dd36-ef70-4c9a-bcca-0c1b171db63b",
                                                "sense_id": "ae85ca6b-ce4d-3174-87ab-030686c14285",
                                                "text": "Das Frachtschiff wird erst morgen eintreffen."
                                            },
                                            {
                                                "example_id": "d4b2b256-8460-478a-a37a-93eb7d9910b7",
                                                "sense_id": "ae85ca6b-ce4d-3174-87ab-030686c14285",
                                                "text": "„An der Rolandsbrücke haben im 9. Jahrhundert die Frachtschiffe festgemacht, hier sitzt die Norddeutsche Vermögen, Kortüms Reederei.“"
                                            },
                                            {
                                                "example_id": "f075b629-5f5e-48cf-af69-97c6c5fd16b1",
                                                "sense_id": "ae85ca6b-ce4d-3174-87ab-030686c14285",
                                                "text": "„Wir sitzen länger hier und sinnieren über die Ladung der Frachtschiffe.“"
                                            },
                                            {
                                                "example_id": "a6f0154c-b9fe-479a-a3e1-0d289ce8974d",
                                                "sense_id": "ae85ca6b-ce4d-3174-87ab-030686c14285",
                                                "text": "„Frachtschiffe tuckerten zum Be- oder Entladen in Richtung Hafen, die ersten Ausflugsschiffe waren auch schon wieder unterwegs.“"
                                            },
                                            {
                                                "example_id": "092aaad2-8910-497d-9acc-e298f1bf1934",
                                                "sense_id": "ae85ca6b-ce4d-3174-87ab-030686c14285",
                                                "text": "„Zu jener Zeit traf Lai-bau mit dem Frachtschiff aus Nanking wieder ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d827e9e6-52c5-4ff9-ab58-27fc2d0b10a4",
                        "source_entry_id": "265497e8-bbb5-3ced-b194-93840b551b18",
                        "source_sense_id": "c5354829-2fec-3fc4-abce-1fe349813da0",
                        "source_sense_description": "Luftfahrt: Frachtflugzeug",
                        "target_lang_word": "Frachtflugzeug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frachtflugzeug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cc31662d-3520-3734-8a7b-66cf9fe77280",
                                        "entry_id": "586a3e07-13f3-38f2-889e-2dbf1042d38d",
                                        "glosses": [
                                            "Flugzeug, das für den Transport von kommerziellen Gütern eingesetzt wird und dafür konstruiert wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57bccd04-4d3f-44fa-a28e-de6804bcafd1",
                                                "sense_id": "cc31662d-3520-3734-8a7b-66cf9fe77280",
                                                "text": "Neben Passagierflugzeugen heben am Flughafen auch zahlreiche Frachtflugzeuge ab, um ihre Ladung in alle Winkel der Welt zu transportieren."
                                            },
                                            {
                                                "example_id": "a9700608-98e1-41e7-a1cc-90345fc18f36",
                                                "sense_id": "cc31662d-3520-3734-8a7b-66cf9fe77280",
                                                "text": "Dieses Frachtflugzeug ist eine umgebaute ehemalige Passagiermaschine."
                                            },
                                            {
                                                "example_id": "406e544d-10f5-4373-8f73-ae3ae2cbb91f",
                                                "sense_id": "cc31662d-3520-3734-8a7b-66cf9fe77280",
                                                "text": "„Das Riesen-Frachtflugzeug Beluga XL hat zum ersten Mal den Boden verlassen und seinen Jungfernflug erfolgreich absolviert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
