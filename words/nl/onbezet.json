                    "common_phrases": [
                        "onbezette functie",
                        "onbezette stoel"
                    ],
                    "target_lang_definitions": {
                        "en": "Said of a job or position: not yet filled by an appointed or hired person."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vacant",
                                "target_lang_sense_clarification": "of a job, position, or office"
