                "translations": [
                    {
                        "translation_id": "fa04249d-60de-4d35-beb7-cba59003c25e",
                        "source_entry_id": "3a0bdf42-2784-3096-8001-2feaa680ced8",
                        "target_lang_word": "harem",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "harem",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55363b57-7e0e-32ce-bf1d-da692a7d52df",
                                        "entry_id": "f1cf176c-4ad4-3b85-8465-cbbb5e9bb94a",
                                        "glosses": [
                                            "The private section of a Muslim household forbidden to male strangers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b7787fc-86b9-4681-aa05-21d953706777",
                                                "sense_id": "55363b57-7e0e-32ce-bf1d-da692a7d52df",
                                                "text": "\"In the room next to her own, lived the harem of a merchant who had just arrived from Constantinople with merchandise. It consisted of his wife, children, and two female slaves, who being well off in their circumstances, enjoyed the comforts and conveniences of life, and eat and drank unsparingly every day.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acda84ea-cb11-3086-861a-0f5ba8a16db2",
                                        "entry_id": "f1cf176c-4ad4-3b85-8465-cbbb5e9bb94a",
                                        "glosses": [
                                            "A group of someone's girlfriends, wives and/or concubines in a polygamous household."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3dddd2a9-4cf0-3a89-aa89-89548cb4911f",
                                        "entry_id": "f1cf176c-4ad4-3b85-8465-cbbb5e9bb94a",
                                        "glosses": [
                                            "A group of female animals (cows) herded and controlled by a male animal (bull) of that species for breeding purposes. Such behaviour is exhibited by bovids including cattle and buffalo as well as moose, elephants, seals (including elephant seals), sea lions, and baboons."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1432ae68-285c-4cbe-8e7c-4997f365a3a0",
                                                "sense_id": "3dddd2a9-4cf0-3a89-aa89-89548cb4911f",
                                                "text": "I nodded my head and proceeded to make a flank attack on the nearest harem. All went well until I aimed a blow at an outlying cow's head and fell short. She snorted and tried to scramble away. I ran in close and struck another blow, hitting the shoulder instead of the head."
                                            },
                                            {
                                                "example_id": "bff51e93-b812-4a8b-b357-e3b7939d4a86",
                                                "sense_id": "3dddd2a9-4cf0-3a89-aa89-89548cb4911f",
                                                "text": "2006 Maestripieri, Dario; Mayhew, Jessica; Carlson, Cindy L.; Hoffman, Christy L.; and Radtke, Jennifer M. \"One-Male Harems and Female Social Dynamics in Guinea Baboons\", published in Folia Primatol 2007; 78:56–68, doi 10.1159/000095686"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cb15928-58de-3215-aad4-4f8086d00ee8",
                                        "entry_id": "f1cf176c-4ad4-3b85-8465-cbbb5e9bb94a",
                                        "glosses": [
                                            "A group of female birds mated to or associated with a breeding male."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad1ddf0b-132f-439d-81a5-5c3a01334591",
                                                "sense_id": "2cb15928-58de-3215-aad4-4f8086d00ee8",
                                                "text": "In the meantime we were hidden in a close juniper thicket on the little knoll, and expected the capercailzie cock every moment; but our old friend tarried a long time in his harem."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08844c5e-e8e8-33b2-9e34-81c4947ec1bc",
                                        "entry_id": "f1cf176c-4ad4-3b85-8465-cbbb5e9bb94a",
                                        "glosses": [
                                            "Any significant number of women together as a group; a bevy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1e6437b6-ab4d-3f2b-b6a0-d6b3c9b00de9",
                                        "entry_id": "f1cf176c-4ad4-3b85-8465-cbbb5e9bb94a",
                                        "glosses": [
                                            "A genre of anime and manga in which a man is the love interest of three or more women."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b475e91d-bca3-4a1a-8d7a-23d6a8dedd84",
                        "source_entry_id": "3a0bdf42-2784-3096-8001-2feaa680ced8",
                        "target_lang_word": "harem",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "harem",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "794e7f41-6a60-32e9-b8f1-7efa4b8fadde",
                                        "entry_id": "fd845742-7d84-3507-9419-3d8b764aa6f4",
                                        "glosses": [
                                            "Gynécée chez les musulmans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e61e5c18-447d-4a17-aca3-203b4ff5ce92",
                                                "sense_id": "794e7f41-6a60-32e9-b8f1-7efa4b8fadde",
                                                "text": "Ce jardin même, tout rempli qu’il est de plantes précieuses et d’arbres curieux transplantés des climats de l’Orient, conviendrait mieux au harem d’un émir infidèle qu’à un couvent […]."
                                            },
                                            {
                                                "example_id": "a0fffe36-ccfc-43c0-921f-5c146165c6c5",
                                                "sense_id": "794e7f41-6a60-32e9-b8f1-7efa4b8fadde",
                                                "text": "Le Sultan n’a emmené en campagne qu’une trentaine de femmes de son harem."
                                            },
                                            {
                                                "example_id": "30fb9747-7f21-44dc-864c-630be35f7503",
                                                "sense_id": "794e7f41-6a60-32e9-b8f1-7efa4b8fadde",
                                                "text": "Mme Magdelaine Marx ajoute d’ailleurs que, si la polygamie est donc légalement consacrée, elle est en fait abolie pour des raisons économiques; et elle confirme ainsi l’éclat de rire qui accueillit la nomination par la Société des Nations, d’un inspecteur des harems de Constantinople, où il n’y a plus un seul harem[…]."
                                            },
                                            {
                                                "example_id": "4129310f-3b32-46ef-8956-52c897db9a8b",
                                                "sense_id": "794e7f41-6a60-32e9-b8f1-7efa4b8fadde",
                                                "text": "Un jour pourtant, il revint tout heureux. Il avait trouvé une entremetteuse qui l'introduirait auprès de sa bien-aimée. Il se déguiserait en femme, et pénétrerait ainsi dans le harem."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1296be21-3773-3c4d-8101-8c3cba281a39",
                                        "entry_id": "fd845742-7d84-3507-9419-3d8b764aa6f4",
                                        "glosses": [
                                            "Réunion des femmes qui habitent un harem."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d087226-0ca7-4c95-865d-5740564ef24f",
                                                "sense_id": "1296be21-3773-3c4d-8101-8c3cba281a39",
                                                "text": "[…] ; tantôt ces femmes jolies, ces toilettes éclatantes apparaissaient au milieu du nuage diaphane comme un harem des houris du prophète."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0154d4f-caeb-372b-b1ef-ba87df29fdf5",
                                        "entry_id": "fd845742-7d84-3507-9419-3d8b764aa6f4",
                                        "glosses": [
                                            "Ensemble des prostituées exploitées par un même proxénète."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53e256b3-ddcd-4a51-857f-e77f6cbf4a16",
                                                "sense_id": "a0154d4f-caeb-372b-b1ef-ba87df29fdf5",
                                                "text": "Or, il manquait, cette nuit, au harem de Binèche une quatrième « turfeuse ». Je sus qu’elle était de « couverte » et que les mœurs l’avaient emmenée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
