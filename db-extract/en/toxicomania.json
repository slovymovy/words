                    {
                        "translation_id": "c6d42b89-7308-44bb-8076-c2a968409d06",
                        "source_entry_id": "55961d24-3538-31b4-9ed5-a693dcaeee90",
                        "source_sense_id": "60eab06f-51ba-3f7f-981f-ec59630ebc1b",
                        "source_sense_description": "desire for intoxicants",
                        "target_lang_word": "toxicomanie",
