                        "examples": [
                            {
                                "example_id": "aa50773c-2985-447e-ad1e-89ab32aa47f4",
                                "sense_id": "00eea01c-e526-3598-aac0-b13a5dfc77ee",
                                "text": "Между прочими искателями счастливым был Арист, любезный молодой человек, обладающий искусством нравиться прекрасному полу."
                            },
                            {
                                "example_id": "a5cb2bde-74ce-4c3e-9ea2-cf8bde08be4f",
                                "sense_id": "00eea01c-e526-3598-aac0-b13a5dfc77ee",
                                "text": "После ужина, когда все разъехались, Юлия села на софу, взяла Ариста за руку и сказала ему с улыбкою: ― Ты видел, мой друг, с какою холодною учтивостию обходилась я с князем N*."
                            }
                        ]
                    }
