                    {
                        "sense_id": "e0ccd2d0-228b-32be-8380-91623d22956f",
                        "entry_id": "bb039daa-1f09-39d1-b57c-91d9895eb4c0",
                        "glosses": [
                            "Lettre, chiffre ou autre symbole imprimé sur un tableau optométrique (permettant le contrôle de l’acuité visuelle)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b73bb51-7c1e-496d-9e72-f264a45a3da9",
                                "sense_id": "e0ccd2d0-228b-32be-8380-91623d22956f",
                                "text": "Un optotype est un motif ou caractère de forme et de dimensions bien définies, destiné au contrôle de la qualité de la vue."
                            },
                            {
                                "example_id": "7d636772-f830-49ea-bf10-e41de728d40b",
                                "sense_id": "e0ccd2d0-228b-32be-8380-91623d22956f",
                                "text": "Comme on le constate habituellement dans l’échelle d’acuité visuelle de loin, les optotypes numériques peuvent être proposés à la place des optotypes alphanumériques pour des raisons socioculturelles (alphabet non romain, difficultés de prononciation, niveau de scolarisation)."
                            },
                            {
                                "example_id": "c5d6f4d2-6dda-4360-95f3-70a5122dda3c",
                                "sense_id": "e0ccd2d0-228b-32be-8380-91623d22956f",
                                "text": "Lors de l’examen de vue, la mesure de l’acuité visuelle subjective va se faire à l’aide d’optotypes : lettres le plus souvent, chiffres ou objets de forme parfaitement définie (trident de Snellen ou anneau brisé de Landolt) ou de dessins pour les enfants ou de résolution spatiale pour les nourrissons."
                            }
                        ]
                    }
                ],
