                },
                {
                    "sense_id": "2a92b0fd-7762-3bc0-a08e-3f895d996331",
                    "sense_definition": "Mettre une personne ou une chose au-dessus d'une autre ; privilégier l'une au détriment de l'autre.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "préférer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Beaucoup de jeunes <w>préfèrent</w> la vie en ville à la vie à la campagne."
                        },
                        {
                            "text": "Ce professeur ne <w>préfère</w> aucun élève et traite tout le monde de la même façon."
                        },
                        {
                            "text": "Il a toujours <w>préféré</w> la liberté à la sécurité."
                        }
                    ],
                    "synonyms": [
                        "avantager",
                        "favoriser"
                    ],
                    "common_phrases": [
