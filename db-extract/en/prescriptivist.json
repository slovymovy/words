                        "entry_id": "463e4c7f-0c76-3621-bacb-bd1fc5cadf5c",
                        "glosses": [
                            "Someone who lays down rules regarding language usage, or who believes that traditional norms of language usage should be upheld."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d5e6f9a-c747-45fb-9b48-242d6240d0c5",
                                "sense_id": "8b582743-4cd3-3b9f-8e57-98fee558f7c3",
                                "text": "The plutocratic tone and styptic wit of Safire and Newman and the best of the Prescriptivists is often modeled after the mandarin-Brit personas of Eric Partridge and H. W. Fowler, the same Twin Towers of scholarly Prescriptivism whom Garner talks about revering as a kid."
                            }
                        ]
                    }
                ],
