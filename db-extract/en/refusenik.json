                    {
                        "translation_id": "82fe9897-5e43-4e73-96b2-65211ddc9df6",
                        "source_entry_id": "9d55c190-45ba-3a35-a670-5e2eef9b4c4a",
                        "source_sense_description": "person who refuses to do something, usually as a protest",
                        "target_lang_word": "Verweigerer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verweigerer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ca567120-6db9-390a-95b3-bb7f0c76344c",
                                        "entry_id": "9058d3a9-43ff-3bc1-824e-290926b625fd",
                                        "glosses": [
                                            "Person, die etwas kategorisch ablehnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "313ad72b-f323-4859-b747-5193169a5536",
                                                "sense_id": "ca567120-6db9-390a-95b3-bb7f0c76344c",
                                                "text": "„Ab kommender Woche soll dort laut sächsischem Gesundheitsministerium ein Gewahrsam für Verweigerer von Coronaquarantänen eingerichtet werden.“"
                                            },
                                            {
                                                "example_id": "8a498e94-78a8-4a6a-b068-d2c0ada6f6b1",
                                                "sense_id": "ca567120-6db9-390a-95b3-bb7f0c76344c",
                                                "text": "„Weil Verweigerer des Corona-Impfstoffes von Astrazeneca in den Impfzentren für Leerlauf und Stockungen sorgen, denkt Niedersachsen als Möglichkeit auch an das Überbuchen von Impfterminen.“"
                                            },
                                            {
                                                "example_id": "ccdb3d0a-a836-4fd8-a089-b9cb3840548b",
                                                "sense_id": "ca567120-6db9-390a-95b3-bb7f0c76344c",
                                                "text": "„Hermann Eicher sprach sich dafür aus, auf die Verweigerer von Beitragszahlungen zuzugehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "20d8c132-057f-314f-b8a8-a99f665e167f",
                                        "entry_id": "9058d3a9-43ff-3bc1-824e-290926b625fd",
                                        "glosses": [
                                            "Person, die die Ableistung des Wehrdienstes ablehnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "223dce94-d08d-45da-be24-b441efbe68a6",
                                                "sense_id": "20d8c132-057f-314f-b8a8-a99f665e167f",
                                                "text": "„Die totalen Verweigerer jeden Wehrdienstes machten sich strafbar, wer wenigstens zum Bausoldatendienst bereit war, handelte sich dagegen ‚nur‘ erhebliche Nachteile ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26f2160d-9691-4f6e-8cfc-bd346a0f1ad2",
                        "source_entry_id": "9d55c190-45ba-3a35-a670-5e2eef9b4c4a",
                        "source_sense_description": "person who refuses to do something, usually as a protest",
                        "target_lang_word": "Verweigerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verweigerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "77880da0-bbee-3f46-9516-d19df63bd0dd",
                                        "entry_id": "f1991703-a590-35fa-8a3e-57b493596510",
                                        "glosses": [
                                            "weibliche Person, die etwas kategorisch ablehnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e9bf5b4-09a7-4b71-827b-9625cb2c2ca9",
                                                "sense_id": "77880da0-bbee-3f46-9516-d19df63bd0dd",
                                                "text": "„Und wer genau ist ›wir‹? […] Sprichst du von dir und dir? Dem unschlagbaren Duo der Selbstaufgabe? Der heillos unbelehrbaren Verweigerin jeglichen Rats? Du bist Konstantin doch erst dann losgeworden, als er dich geghostet hat!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c98d718f-fc06-3355-855b-01f57931d1ad",
                                        "entry_id": "f1991703-a590-35fa-8a3e-57b493596510",
                                        "glosses": [
                                            "weibliche Person, die die Ableistung des Wehrdienstes ablehnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6449362-f2ea-4faf-9b5d-b47d5942d3c3",
                                                "sense_id": "c98d718f-fc06-3355-855b-01f57931d1ad",
                                                "text": "„Mit ihren je persönlichen Sichtweisen schildern vier Verweigerer und eine Verweigerin eindringlich ihre Zerrissenheit im Konflikt, aus der sie sich nur durch eine klare Entscheidung befreien können: NEIN zu sagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
