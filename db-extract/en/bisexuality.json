                                    },
                                    {
                                        "sense_id": "8fd2f06d-7fa5-3643-b82b-edb046b3990d",
                                        "entry_id": "9bc868de-6331-3395-b4a5-76f863142b3c",
                                        "glosses": [
                                            "Caractère bisexué d’un psychisme."
