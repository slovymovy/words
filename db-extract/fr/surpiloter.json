                ],
                "senses": [
                    {
                        "sense_id": "c7c381f8-e109-3896-bb35-307d982c4814",
                        "entry_id": "25c58f30-496d-3963-8e84-763fa8ab01db",
                        "glosses": [
                            "Piloter en agissant sur les commandes plus qu’il n’est nécessaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91b78b9d-0f32-41c2-b021-c7f413425fa7",
                                "sense_id": "c7c381f8-e109-3896-bb35-307d982c4814",
                                "text": "De plus, les débutants pourront choisir au début le réglage 45 cm, pour éviter de surpiloter l'aile, et donc sécuriser leur apprentissage."
                            },
                            {
                                "example_id": "0da7bab8-3319-4fcd-b7c3-7d7703078207",
                                "sense_id": "c7c381f8-e109-3896-bb35-307d982c4814",
                                "text": "Je n'ai pas vraiment d'explication, mais en tout cas je n'avais pas l'impression de surpiloter."
                            },
                            {
                                "example_id": "90e51a09-14cf-4e25-be53-052a80677f28",
                                "sense_id": "c7c381f8-e109-3896-bb35-307d982c4814",
                                "text": "Un des principal défaut des élèves en treuillé est de vouloir surpiloter et surcorriger tous les mouvements du planeur au lieu de le laisser s'autoamortir jusqu'à sa position de stabilité."
                            }
                        ]
                    }
