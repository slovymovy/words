                "senses": [
                    {
                        "sense_id": "06ad075d-064e-33e0-bdfc-c342093bfc23",
                        "entry_id": "12e407f0-f6c9-346a-9196-2a551124c0ea",
                        "glosses": [
                            "The motion of something that skids."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "cad42861-56b5-4d9b-8308-032c4700b498",
                                "sense_id": "06ad075d-064e-33e0-bdfc-c342093bfc23",
                                "text": "When an automobile, for instance, traveled that road, it was with many skiddings in the sand on the turns, which it must take circumspectly if the driver did not care for the rocky, uneven floor of the desert itself."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc5b5cc9-9670-3ad1-9151-5ce53c3b7ddc",
                        "entry_id": "12e407f0-f6c9-346a-9196-2a551124c0ea",
                        "glosses": [
                            "The logging operation for pulling cut trees out of a forest."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "40c03a45-4aee-4d3a-a6bb-77721ba168b9",
                        "source_entry_id": "12e407f0-f6c9-346a-9196-2a551124c0ea",
                        "source_sense_description": "the motion of something that skids",
                        "target_lang_word": "dérapage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dérapage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f630a377-9110-3da8-8c86-b392ad39fa8e",
                                        "entry_id": "983695ad-6f80-37c5-a265-fac9099aa13b",
                                        "glosses": [
                                            "Action de déraper ; résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d7f0b34-a77f-4e76-81b2-f1183468c81d",
                                                "sense_id": "f630a377-9110-3da8-8c86-b392ad39fa8e",
                                                "text": "Le profil du fossé facilite la sortie de ces véhicules en tout point de la route et diminue les risques d’accidents à la suite d’un dérapage ou d’une embardée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22c58656-3388-39c8-9dad-429f6171af00",
                                        "entry_id": "983695ad-6f80-37c5-a265-fac9099aa13b",
                                        "glosses": [
                                            "Changement inattendu ; quelque chose d’imprévu, d’inhabituel."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5017030d-4c96-4829-bd8f-c9c1f48c9691",
                                                "sense_id": "22c58656-3388-39c8-9dad-429f6171af00",
                                                "text": "Mais le dérapage de l’Europe ne provient pas d'une dynamique propre à l’État, machine désincarnée. Les États ne deviennent fous que parce que les hommes qui les constitueent, les dominent ou les construisent sont largement psychotiques."
                                            },
                                            {
                                                "example_id": "b9e6215e-ba4f-46fd-832c-729f24a176b6",
                                                "sense_id": "22c58656-3388-39c8-9dad-429f6171af00",
                                                "text": "[…] il était très facile, même en France au milieu des années 70, de trouver des chercheurs mettant la communauté scientifique en garde contre la démonisation de cette discipline, démonisation déjà considérée comme un dérapage (Dorozynski ; Renaud)."
                                            },
                                            {
                                                "example_id": "88bb21eb-a3e9-4a08-b2ff-5cd408f267c6",
                                                "sense_id": "22c58656-3388-39c8-9dad-429f6171af00",
                                                "text": "Et lorsqu’il n’y a plus de repères, que le sentiment d’injustice domine, toutes sortes de dérapages peuvent se produire."
                                            },
                                            {
                                                "example_id": "c2e34bae-26ef-4483-b92e-488640310dd9",
                                                "sense_id": "22c58656-3388-39c8-9dad-429f6171af00",
                                                "text": "Une nouvelle trajectoire budgétaire « crédible » doit être présentée en septembre à la Commission européenne, qui a ouvert une procédure de déficit excessif visant la France, l’entêtement des gouvernements macronistes à ne pas augmenter les impôts ayant conduit à un dérapage des finances publiques."
                                            },
                                            {
                                                "example_id": "bab5ad40-64d8-4cb7-af60-fe3fd8d7975a",
                                                "sense_id": "22c58656-3388-39c8-9dad-429f6171af00",
                                                "text": "Les erreurs de prévision de Bercy, le violent dérapage du déficit public en 2023 et 2024, l’inexorable hausse de l’endettement trimestre après trimestre, l’attente angoissée du verdict des agences de notation, les messages à répétition de François Bayrou, tout cela a hissé la dette parmi les principales préoccupations des Français, selon les enquêtes d’opinion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e0278f7-e696-395b-adc6-ad95bcccf2d9",
                                        "entry_id": "983695ad-6f80-37c5-a265-fac9099aa13b",
                                        "glosses": [
                                            "Inflexion indésirée et/ou incontrôlée mais pouvant être habituelle."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b2f272c-8e0a-4843-b9bc-ae2307444a65",
                                                "sense_id": "6e0278f7-e696-395b-adc6-ad95bcccf2d9",
                                                "text": "Auditionnée ce jeudi 20 février par la commission des finances, qui enquête sur le dérapage du déficit public, Elisabeth Borne a jugé nécessaire de \"fiabiliser les évaluations de recettes\" faites par Bercy, appelant à fluidifier les remontées d'informations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b6c35d3-5494-48f5-8c18-e0690513934c",
                        "source_entry_id": "12e407f0-f6c9-346a-9196-2a551124c0ea",
                        "source_sense_description": "the logging operation for pulling cut trees",
                        "target_lang_word": "débardage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "débardage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c55d5a0f-fa53-381f-89fd-537956fb6ec7",
                                        "entry_id": "c16dfae2-ee90-3f97-a343-19883e7d6709",
                                        "glosses": [
                                            "Transport de bois ou de pierre depuis le lieu d’obtention, forêt ou carrière, jusqu’au lieu de chargement."
                                        ],
                                        "tags": [
                                            "Exploitation forestière"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "179a9164-0504-482c-8cd1-5dd41e7adcde",
                                                "sense_id": "c55d5a0f-fa53-381f-89fd-537956fb6ec7",
                                                "text": "Il vous faudra y louer un chantier, payer patente et des impositions, payer les droits de navigation, ceux d’octroi, faire les frais de débardage et de mise en pile, enfin avoir un agent comptable…"
                                            },
                                            {
                                                "example_id": "677442dd-4d47-4a9f-bbc5-7e25cbd2b532",
                                                "sense_id": "c55d5a0f-fa53-381f-89fd-537956fb6ec7",
                                                "text": "Dans ce mode de débardage, le bois transporté du parterre de coupe au bord de la route ne touche pas le sol."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1281a629-6a28-3c5d-9068-a50ffd229680",
                                        "entry_id": "c16dfae2-ee90-3f97-a343-19883e7d6709",
                                        "glosses": [
                                            "Transport par portage, sur un porteur."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00f4ccda-0c9c-4346-b836-2c5b30dde340",
                                                "sense_id": "1281a629-6a28-3c5d-9068-a50ffd229680",
                                                "text": "Les grumes doivent être soigneusement ébranchées (voire éfourchées) — nœuds parfaitement arasés — sur le lieu d’abattage et tronçonnées à une longueur adaptée, notamment si elles présentent une fourche ou une courbure accusée, ceci afin de préserver au mieux le peuplement et les infrastructures lors du débusquage et du débardage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f703adb3-0937-3a32-9e29-05e9a617a788",
                                        "entry_id": "c16dfae2-ee90-3f97-a343-19883e7d6709",
                                        "glosses": [
                                            "Déchargement des marchandises dans les ports."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
