                        "glosses": [
                            "Oiseau palmipède à la fois prédateur et cleptoparasite, il en existe sept espèces constituant le genre Stercorarius."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28752b23-5edb-4f4b-8621-4e9c5675403f",
                                "sense_id": "83ae0a35-01a4-3326-a375-9aec56b7f4e2",
                                "text": "Il plonge sous l’eau pour échapper aux attaques des labbes et des goélands."
                            },
                            {
                                "example_id": "a429a275-4bc2-4726-bfd9-7e42476276a7",
                                "sense_id": "83ae0a35-01a4-3326-a375-9aec56b7f4e2",
                                "text": "Le grand labbe est un habile pêcheur mais il sait aussi dévaliser les autres oiseaux marins !"
                            }
                        ]
                    }
