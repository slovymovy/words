                            {
                                "example_id": "29cb5826-2efc-4f19-9d14-6e000d660c8e",
                                "sense_id": "cb7c30cc-7813-3614-a06c-a88cee8f6f7d",
                                "text": "Met grote kundigheid wist de chirurg de operatie tot een goed einde te brengen."
                            },
                            {
                                "example_id": "1c1c37aa-bd18-4884-ac3b-b398e40d2a72",
                                "sense_id": "cb7c30cc-7813-3614-a06c-a88cee8f6f7d",
                                "text": "Het repareren van een horloge vereist een grote kundigheid van de horlogemaker."
                            }
                        ]
