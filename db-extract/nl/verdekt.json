                "senses": [
                    {
                        "sense_id": "6e7727b5-556e-38e0-b718-7c6f6054f9ff",
                        "entry_id": "bfefd0bd-20b6-3dba-8f13-f44c309694c4",
                        "glosses": [
                            "aan het oog onttrokken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6c98302-5fa5-43f7-84b2-c7194ccb8dac",
                                "sense_id": "6e7727b5-556e-38e0-b718-7c6f6054f9ff",
                                "text": ",,Normaal stellen we ons verdekt op en wachten we tot het feestje is afgelopen. We grijpen pas in als het echt nodig is."
                            },
                            {
                                "example_id": "d01a0b06-fb17-4552-93a2-cf4b72d2289c",
                                "sense_id": "6e7727b5-556e-38e0-b718-7c6f6054f9ff",
                                "text": "Vier minuten voor rust onderschepte hij een pass van AZ-verdediger Wuytens, dribbelde een stukje om daarna een verdekt schot los te laten dat te machtig was voor de matige AZ-keeper Bizot. Larsson trof tussendoor na een heerlijke run doel met een zwabberende pegel, Vilhena tikte na rust een pass van Berghuis binnen."
                            }
                        ]
                    },
                    {
                        "sense_id": "8277cd23-9305-3ba5-a84d-4093c12bf92d",
                        "entry_id": "bfefd0bd-20b6-3dba-8f13-f44c309694c4",
                        "glosses": [
                            "in het bezit van een dek"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7db0b857-ebf5-4cda-a3fa-13f44e1d5fd4",
                        "source_entry_id": "bfefd0bd-20b6-3dba-8f13-f44c309694c4",
                        "source_sense_id": "6e7727b5-556e-38e0-b718-7c6f6054f9ff",
                        "target_lang_word": "under cover",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "under cover",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6655bd42-6f47-3b62-bfb9-f09df8a961dc",
                                        "entry_id": "758c39ab-7c14-3084-9282-e9d24545f94d",
                                        "glosses": [
                                            "Protected by a covering or shelter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09543d78-5240-4fbb-b48a-b8c2f1d5c36e",
                                                "sense_id": "6655bd42-6f47-3b62-bfb9-f09df8a961dc",
                                                "text": "When it started to rain we got under cover."
                                            },
                                            {
                                                "example_id": "cb4e54d9-8677-4c48-b6cd-626a822c002f",
                                                "sense_id": "6655bd42-6f47-3b62-bfb9-f09df8a961dc",
                                                "text": "As these [diesel] trains have to be shedded under cover at night, four additional outdoor standage roads are being provided for stabling of electric rolling stock after inspection in the shed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33eb7cf0-e943-46f9-bb8d-e04d67289bf7",
                        "source_entry_id": "bfefd0bd-20b6-3dba-8f13-f44c309694c4",
                        "source_sense_id": "6e7727b5-556e-38e0-b718-7c6f6054f9ff",
