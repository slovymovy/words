                        "tags": [],
                        "examples": [
                            {
                                "example_id": "069003c1-d148-41f2-9a69-c4e2610d1957",
                                "sense_id": "0c5ff67d-630e-341c-9b50-361a123e5030",
                                "text": "Opvallend is dat bijna alle berekende schade voortkomt uit uitstoot naar de lucht, zeggen de onderzoekers, namelijk 98%. Daarbij gaat het vooral om broeikasgassen als CO2 en methaan, en luchtverontreinigende stoffen zoals stikstofoxiden, zwaveloxide en ammoniak, ook bekend als NEC-stoffen."
                            },
                            {
                                "example_id": "6093a31b-7249-499f-8914-3cbae270ac5f",
                                "sense_id": "0c5ff67d-630e-341c-9b50-361a123e5030",
                                "text": "De nieuwe Europese Richtlijn legt alle EU-landen doelstellingen op voor het verminderen van de uitstoot van zwaveloxide, stikstofoxiden (NOx), vluchtige organische stoffen, ammoniak en fijnstof."
                            }
                        ]
