                "senses": [
                    {
                        "sense_id": "0691db8e-fbb8-3eb7-b736-c478b10318f5",
                        "entry_id": "471e4d58-453e-399b-9f3f-275ca88814a3",
                        "glosses": [
                            "van het ene op het andere moment; op één bepaald ogenblik; betrekking hebbend op het nu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3566b21-1cb3-4a0e-8de8-e1b0bf70a55b",
                                "sense_id": "0691db8e-fbb8-3eb7-b736-c478b10318f5",
                                "text": "Hij heeft kritiek op Miskottes distantiëring van de belijdenis, het alleen en momentaan aangesproken worden door de Naam waarbij de continuïteit van de gereformeerde traditie in de knel komt."
                            },
                            {
                                "example_id": "b41e7cc8-78b7-4693-b978-8d2a2180f90a",
                                "sense_id": "0691db8e-fbb8-3eb7-b736-c478b10318f5",
                                "text": "In de praktijk kunnen de pieken in de geluidsoverlast hoger zijn dan berekend. Dat komt \"doordat de piekniveaus niet alleen afhangen van het moment waarop vliegtuigen doorklimmen naar kruishoogte, maar bijvoorbeeld ook van het vliegtuig-type en de feitelijke, momentane stuwkracht tijdens de verschillende vluchtfasen\"."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "56817f90-8077-4618-92f4-83b9adb8ccdf",
                        "source_entry_id": "471e4d58-453e-399b-9f3f-275ca88814a3",
                        "source_sense_id": "0691db8e-fbb8-3eb7-b736-c478b10318f5",
                        "source_sense_description": "van het ene op het andere moment; op één bepaald ogenblik; betrekking hebbend op het nu",
                        "target_lang_word": "instantaneous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "instantaneous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "658178c7-ebd7-3901-9f62-2a0adeca1839",
                                        "entry_id": "09b0cede-32fe-33d5-8c99-41aa1a218ac6",
                                        "glosses": [
                                            "Occurring, arising, or functioning without any delay; happening within an imperceptibly brief period of time."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cf88a4a-385f-4204-80dd-5daec1b890e2",
                                                "sense_id": "658178c7-ebd7-3901-9f62-2a0adeca1839",
                                                "text": "This instantaneous motion is supposed by you, to be infinitely swift."
                                            },
                                            {
                                                "example_id": "fd5b7612-df79-45ba-ac0f-d05b86a7009a",
                                                "sense_id": "658178c7-ebd7-3901-9f62-2a0adeca1839",
                                                "text": "However, no lovers in romance ever cemented a more inſtantaneous friendſhip."
                                            },
                                            {
                                                "example_id": "2f847a0a-2229-4516-9c9e-5f2a8c31274c",
                                                "sense_id": "658178c7-ebd7-3901-9f62-2a0adeca1839",
                                                "text": "The colour now rushed into Elizabeth's cheeks in the instantaneous conviction of its being a letter from the nephew, instead of the aunt; [...]"
                                            },
                                            {
                                                "example_id": "06240342-e5c1-459c-9a94-c2be3e4905d2",
                                                "sense_id": "658178c7-ebd7-3901-9f62-2a0adeca1839",
                                                "text": "I walk always with my right hand closed round the india-rubber ball which I have in my trouser pocket. The pressing of this ball actuates a detonator inside the flask I carry in my pocket. It's the principle of the pneumatic instantaneous shutter for a camera lens."
                                            },
                                            {
                                                "example_id": "44fc2988-365f-438a-b5ee-aff4bd3b3b9e",
                                                "sense_id": "658178c7-ebd7-3901-9f62-2a0adeca1839",
                                                "text": "The penis is the perfectly obvious and natural symbol of instantaneous time."
                                            },
                                            {
                                                "example_id": "de43edcf-781b-40a0-a916-6e41608a45b6",
                                                "sense_id": "658178c7-ebd7-3901-9f62-2a0adeca1839",
                                                "text": "He said that the bullet went through her head, severed her spine and death would have been almost instantaneous."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
