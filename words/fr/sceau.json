            "senses": [
                {
                    "sense_id": "1c4ff20d-4234-39e5-953e-f2f39dea996a",
                    "sense_definition": "Empreinte en cire, en plomb ou à l'encre apposée sur un document pour en attester l'authenticité ou en assurer la fermeture.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "empreinte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'historien a minutieusement examiné le <w>sceau</w> en cire rouge attaché au bas du parchemin."
                        },
                        {
                            "text": "Cette confession intime a été confiée sous le <w>sceau</w> du secret le plus strict."
                        }
                    ],
                    "synonyms": [
                        "cachet",
                        "empreinte"
                    ],
                    "common_phrases": [
                        "sceau royal",
                        "apposer un sceau",
                        "sous le sceau du secret"
                    ]
                },
                {
                    "sense_id": "13fef416-f934-3bb9-a3cb-e1fcc6856c9e",
                    "sense_definition": "Instrument ou matrice portant une gravure en creux qui sert à imprimer cette marque officielle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "instrument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ministre a soigneusement rangé le grand <w>sceau</w> en métal dans son coffre sécurisé."
                        },
                        {
                            "text": "L'artisan a gravé un <w>sceau</w> personnalisé portant les armes de la ville."
                        }
                    ],
                    "synonyms": [
                        "cachet",
                        "matrice"
                    ],
                    "common_phrases": [
