                "senses": [
                    {
                        "sense_id": "6c4170dd-dc50-3426-a2d8-203a4c413472",
                        "entry_id": "53663a23-e1a9-3dd3-9e89-d370d36c0ec4",
                        "glosses": [
                            "Méthode de séparation membranaire qui permet l’arrêt sélectif des molécules ou ions dont la taille varie entre 10⁰ et 10^(-0.5) nanomètre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bb81a29-36ef-46fc-afd3-eb2da7700d5a",
                                "sense_id": "6c4170dd-dc50-3426-a2d8-203a4c413472",
                                "text": "La filière membranaire permet une technique de « nanofiltration »."
                            },
                            {
                                "example_id": "eba384fd-8bd3-46aa-b67b-956b62bf005e",
                                "sense_id": "6c4170dd-dc50-3426-a2d8-203a4c413472",
                                "text": "La technique de nanofiltration est principalement utilisée pour enlever les ions tels que les métaux lourds."
                            },
                            {
                                "example_id": "2d152cc0-7a3a-47d5-b570-4db5330732af",
                                "sense_id": "6c4170dd-dc50-3426-a2d8-203a4c413472",
                                "text": "La nanofiltration est une technologie membranaire qui, dans son mode de fonctionnement et de construction, est très similaire à l’osmose inverse."
                            },
                            {
                                "example_id": "cc4969d4-ee42-4c66-ba17-097b8e3e3b78",
                                "sense_id": "6c4170dd-dc50-3426-a2d8-203a4c413472",
                                "text": "Résultats d’essais effectués sur des eaux naturelles contenant des ions perchlorates, avec et sans présence de nitrates, à l’aide de résines échangeuses d’ions et de nanofiltrations."
                            }
                        ]
                    }
