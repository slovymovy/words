                        "examples": [
                            {
                                "example_id": "e24ab4ee-271a-477e-8d56-6809d4f9d203",
                                "sense_id": "3356a5e3-f050-3232-8c91-b96ac496d24d",
                                "text": "He bent and disappeared out of the sheltering circle of the fir-fronds, returning in a moment with an armful of boughs. He went back, foraging, and she heard him snapping off others. Presently he was beside her again, and began to construct the break-wind, interweaving from the ground up to the fir-fronds a wall of boughs. Abruptly the wind ceased to blow upon Clair's back."
                            },
                            {
                                "example_id": "cfa561d6-8009-4c0d-a341-2baf8534431f",
                                "sense_id": "3356a5e3-f050-3232-8c91-b96ac496d24d",
                                "text": "The rows of breakwind trees should be planted at right angles to the prevailing wind, and there should be at least thirty feet between the first row of fruit trees and the breakwind trees."
                            }
                        ]
