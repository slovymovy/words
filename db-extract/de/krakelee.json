                "senses": [
                    {
                        "sense_id": "b9a107a7-319d-32da-8555-28cd8a51fdf3",
                        "entry_id": "4dc739db-3e91-30f5-9e24-9fea300c2432",
                        "glosses": [
                            "maschenartiges Netz von Rissen oder Sprüngen auf der Oberfläche von Ölgemälden, Schmucksteinen, Lackierungen, Glasflächen, Glasuren von Keramikgegenständen oder an Fassadenputzen und -anstrichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f78569a-b904-4df7-91b0-7f51e58d8442",
                                "sense_id": "b9a107a7-319d-32da-8555-28cd8a51fdf3",
                                "text": "„Craquelure (zu deutsch: Krakelee) ist ein französischer Begriff, der sich auf das Netzwerk kleiner, haarfeiner Risse bezieht, die auf der Oberfläche eines Bildes im Laufe der Alterung erscheinen.“"
                            },
                            {
                                "example_id": "5ccb76f4-f9e0-4998-a05a-ddf4fece2068",
                                "sense_id": "b9a107a7-319d-32da-8555-28cd8a51fdf3",
                                "text": "„Wie auf einer Leinwand kann sich darauf das ausdrucksvolle Krakelee der Raku Glasur entfalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1459488a-0225-481b-be69-156605200514",
                        "source_entry_id": "4dc739db-3e91-30f5-9e24-9fea300c2432",
                        "source_sense_id": "b9a107a7-319d-32da-8555-28cd8a51fdf3",
                        "target_lang_word": "craquelure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "craquelure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4583d90-e5c2-3171-8f18-708859afbd74",
                                        "entry_id": "6a955e79-dd4b-3bd2-acef-d40bc2f59a76",
                                        "glosses": [
                                            "The distinctive pattern of hairline cracks in the surface of an old painting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cbe1887-fd87-4138-9105-1284255e7754",
                                                "sense_id": "c4583d90-e5c2-3171-8f18-708859afbd74",
                                                "text": "Documentary evidence is what he prefers; but, failing that, he will put up with a cunning concoction of dates and watermarks, cabalistic signatures, craquelure, patina, chemical properties of paint and medium, paper and canvas, all sorts of collateral evidence, historical and biographical, and racy tricks of brush or pen."
                                            },
                                            {
                                                "example_id": "eb0da575-41ff-42ed-a659-5a31ef156268",
                                                "sense_id": "c4583d90-e5c2-3171-8f18-708859afbd74",
                                                "text": "Alan squinted. It was the robot, the one he’d given her, the pretty thing with the Dutch Master craquelure up its tuna-can skirts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9253c434-1b71-4f38-8454-f0df5f330ff0",
                        "source_entry_id": "4dc739db-3e91-30f5-9e24-9fea300c2432",
                        "source_sense_id": "b9a107a7-319d-32da-8555-28cd8a51fdf3",
                        "target_lang_word": "craquelé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "craquelé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a05fec53-b515-3fa1-88b2-296a5a2b5308",
                                        "entry_id": "45ccc3a2-5bcf-3510-b131-9a271ee9cdbd",
                                        "glosses": [
                                            "Porcelaine qui a reçu un émail fendillé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c77d851-befe-4574-b267-5aece6ff4469",
                                                "sense_id": "a05fec53-b515-3fa1-88b2-296a5a2b5308",
                                                "text": "Il y a le craquelé à grandes craquelures, le craquelé à petites craquelures, et enfin le truité, ainsi baptisé par l’abbé Raynal, comparant les infiniment petits segments du fendillement universel de la couverte aux écailles de la truite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8305be6-413e-3077-8850-d8ccc721c9c9",
                                        "entry_id": "45ccc3a2-5bcf-3510-b131-9a271ee9cdbd",
                                        "glosses": [
                                            "Procédé destiné à obtenir une porcelaine craquelée ou un verre craquelé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96b1f212-f2a2-409f-aeae-ab103113c22b",
                                                "sense_id": "f8305be6-413e-3077-8850-d8ccc721c9c9",
                                                "text": "Les verres et cristaux ornés de décors non prévus dans les catégories qui précèdent, tels que peintures, gravures à sujets, dessins en craquelé, dorures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88465c9b-19f3-34ac-9bb0-a819dc44ae83",
                                        "entry_id": "45ccc3a2-5bcf-3510-b131-9a271ee9cdbd",
                                        "glosses": [
                                            "Défaut de l'émail des poteries dû à une dilatation différente entre le support et le glaçage. On peut maîtriser ce défaut pour obtenir de la porcelaine craquelée."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "306d9c34-fccd-3a8b-a259-674a3cf8e04b",
                                        "entry_id": "45ccc3a2-5bcf-3510-b131-9a271ee9cdbd",
                                        "glosses": [
                                            "Pièce en porcelaine de Chine possédant des craquelures dans lesquelles on a introduit de l’encre de Chine pour en accentuer l’aspect."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "craquelé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "884d987c-adf4-31fa-9972-aff892569f4c",
                                        "entry_id": "ec2f9db1-e1f5-351f-9bd3-0f4393b3d3af",
                                        "glosses": [
                                            "Qui présente des craquelures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d4c6d9d-fe66-4671-9c9b-07bf20c54dec",
                                                "sense_id": "884d987c-adf4-31fa-9972-aff892569f4c",
                                                "text": "Je pense aux vieilles rues de Ménilmontant, dans le haut, à celles qui courent à flanc de colline, avec leurs petites maisons de 1830 à l’enduit craquelé."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "craquelé",
                                "target_lang_code": "fr",
                                "target_senses": [
