    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aed121cc-6212-39e4-a7b9-b7349977d807",
                    "sense_definition": "Conserver ou garder dans le même état ou la même condition.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "conservation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il fait du sport chaque matin pour se <w>maintenir</w> en bonne santé."
                        },
                        {
                            "text": "Le gouvernement s'efforce de <w>maintenir</w> la paix dans la région."
                        }
                    ],
                    "synonyms": [
                        "conserver",
                        "garder",
                        "préserver"
                    ],
                    "antonyms": [
                        "changer",
                        "rompre"
                    ],
                    "common_phrases": [
                        "maintenir en vie",
                        "maintenir la paix",
                        "maintenir le cap"
                    ]
                },
                {
                    "sense_id": "a0211a58-446b-34ce-992a-d4a591485045",
                    "sense_definition": "Tenir fermement quelque chose ou quelqu'un pour l'empêcher de bouger ou de tomber.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fixation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une large ceinture en cuir <w>maintenait</w> son pantalon de travail."
                        },
                        {
                            "text": "Le médecin a posé un bandage pour bien <w>maintenir</w> la cheville blessée."
                        }
                    ],
                    "synonyms": [
                        "fixer",
                        "immobiliser",
                        "tenir"
                    ],
                    "antonyms": [
                        "lâcher",
                        "relâcher"
                    ],
                    "common_phrases": [
                        "maintenir en place"
                    ]
                },
                {
                    "sense_id": "75f4ee48-a169-3caf-b42d-420ccee0a3a2",
                    "sense_definition": "Affirmer avec fermeté une opinion ou une déclaration, persister dans ce que l'on dit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "affirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré les critiques de ses collègues, il <w>maintient</w> que son calcul est exact."
                        },
                        {
                            "text": "Le témoin a choisi de <w>maintenir</w> sa version des faits devant le juge."
                        }
                    ],
                    "synonyms": [
                        "affirmer",
                        "persister",
                        "soutenir"
                    ],
                    "antonyms": [
                        "abandonner",
                        "démentir",
                        "rétracter"
                    ],
                    "common_phrases": [
                        "maintenir sa position",
                        "maintenir ses propos"
                    ]
                },
                {
                    "sense_id": "ccf41512-c6b0-30ab-8fdc-cee43e1effca",
                    "sense_definition": "Assurer l'entretien technique ou les mises à jour pour garantir le bon fonctionnement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Notre équipe d'ingénieurs doit <w>maintenir</w> ce logiciel tout au long de l'année."
                        },
                        {
                            "text": "Les techniciens <w>maintiennent</w> les serveurs informatiques en parfait état de marche."
                        }
                    ],
                    "synonyms": [
                        "entretenir"
                    ],
                    "common_phrases": [
                        "maintenir un logiciel"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical"
                        }
                    ]
                }
            ]
        }
