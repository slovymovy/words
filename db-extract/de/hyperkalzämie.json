                "senses": [
                    {
                        "sense_id": "4ec0f6b0-fe64-399e-a96e-1224dce8bcbb",
                        "entry_id": "d5295d86-1a7b-396a-babf-7077cd96c19d",
                        "glosses": [
                            "erhöhte Konzentration an Calcium im Blut"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "743890c3-d0a5-4693-8cdf-d7f6816d4591",
                                "sense_id": "4ec0f6b0-fe64-399e-a96e-1224dce8bcbb",
                                "text": "„Eine Erhöhung des Gesamtkalziums über 2,7 mmol/l wird als Hyperkalzämie bezeichnet.“"
                            },
                            {
                                "example_id": "379950f4-b14d-45c2-950b-737f6ac41163",
                                "sense_id": "4ec0f6b0-fe64-399e-a96e-1224dce8bcbb",
                                "text": "„Bei einer thyreotoxischen Krise tritt in bis zu 50 % der Fälle, bei einer manifesten Hyperthyreose in 15–20 % eine Hyperkalzämie auf.“"
                            },
                            {
                                "example_id": "3d379640-5e9e-47e0-a622-b6eeaadb5a3f",
                                "sense_id": "4ec0f6b0-fe64-399e-a96e-1224dce8bcbb",
                                "text": "„Eine Hyperkalzämie bezeichnet eine Erhöhung des biologisch aktiven, ionisierten freien Kalziums.“"
                            },
                            {
                                "example_id": "6097a2ab-7be2-46da-b60c-d7aea4987861",
                                "sense_id": "4ec0f6b0-fe64-399e-a96e-1224dce8bcbb",
                                "text": "„Eine bislang ungeklärte Hyperkalzämie ohne Hinweis auf eine Störung im PTH oder Vitamin-D-Metabolismus kann beim Williams-Beuren-Syndrom gefunden werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
