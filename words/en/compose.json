{
    "word_family": [
        "composition",
        "composer",
        "composite",
        "composure",
        "decompress",
        "recompose"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dbc01e27-da95-3b96-9187-62cabe4b0390",
                    "sense_definition": "To create or write a literary or musical work through mental effort.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young musician decided to <w>compose</w> a new song for the upcoming festival.",
                            "target_lang_translations": {
                                "ru": "Молодой музыкант решил <w>сочинить</w> новую песню для предстоящего фестиваля.",
                                "zh": "这位年轻的音乐家决定为即将到来的节日<w>创作</w>一首新歌。"
                            }
                        },
                        {
                            "text": "It is often difficult to <w>compose</w> music when there is too much noise in the room.",
                            "target_lang_translations": {
                                "ru": "Часто бывает трудно <w>писать</w> музыку, когда в комнате слишком много шума.",
                                "zh": "当房间里太吵时，往往很难<w>谱写</w>音乐。"
                            }
                        }
                    ],
                    "synonyms": [
                        "form"
                    ],
                    "common_phrases": [
                        "compose a song",
                        "compose a poem",
                        "compose music"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать или писать литературное или музыкальное произведение путем умственных усилий.",
                        "zh": "通过脑力劳动创作或撰写文学或音乐作品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сочиня́ть",
                                "target_lang_sense_clarification": "создавать музыку или текст"
                            },
                            {
                                "target_lang_word": "писа́ть",
                                "target_lang_sense_clarification": "создавать произведение"
                            },
                            {
                                "target_lang_word": "компонова́ть",
                                "target_lang_sense_clarification": "составлять музыкальное произведение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "创作",
                                "target_lang_sense_clarification": "指艺术或文学作品的创作"
                            },
                            {
                                "target_lang_word": "谱写",
                                "target_lang_sense_clarification": "特指音乐作品的创作"
                            },
                            {
                                "target_lang_word": "撰写",
                                "target_lang_sense_clarification": "指文章或文学作品的写作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e69592fa-ce76-33a1-ba01-888b572851ab",
                    "sense_definition": "To be the parts that make up a whole; to constitute.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many different ethnic groups <w>compose</w> the population of this diverse city.",
                            "target_lang_translations": {
                                "ru": "Множество различных этнических групп <w>составляют</w> население этого многообразного города.",
                                "zh": "许多不同的民族<w>构成</w>了这座多元化城市的人口。"
                            }
                        },
                        {
                            "text": "Water and various minerals <w>compose</w> the majority of the earth's crust.",
                            "target_lang_translations": {
                                "ru": "Вода и различные минералы <w>составляют</w> большую часть земной коры.",
                                "zh": "水和各种矿物质<w>组成</w>了地壳的大部分。"
                            }
                        }
                    ],
                    "synonyms": [
                        "constitute",
                        "form",
                        "comprise",
                        "make up"
                    ],
                    "common_phrases": [
                        "compose the whole",
                        "compose the majority"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть частями, составляющими целое; образовывать.",
                        "zh": "作为整体的组成部分；构成。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "составля́ть",
                                "target_lang_sense_clarification": "являться частью целого"
                            },
                            {
                                "target_lang_word": "состоя́ть из",
                                "target_lang_sense_clarification": "включать в себя"
                            },
                            {
                                "target_lang_word": "образо́вывать",
                                "target_lang_sense_clarification": "формировать целое"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "构成",
                                "target_lang_sense_clarification": "指部分组成整体"
                            },
                            {
                                "target_lang_word": "组成",
                                "target_lang_sense_clarification": "指由部分汇集成整体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39993093-e864-3740-a55b-ecd1154be2de",
                    "sense_definition": "To calm oneself or one's thoughts; to free from agitation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She took a deep breath to <w>compose</w> herself before walking onto the stage.",
                            "target_lang_translations": {
                                "ru": "Она глубоко вздохнула, чтобы <w>собраться</w> с духом перед выходом на сцену.",
                                "zh": "她在走上舞台前深吸了一口气，让自己<w>镇定</w>下来。"
                            }
                        },
                        {
                            "text": "You should try to <w>compose</w> your thoughts before making such a big decision.",
                            "target_lang_translations": {
                                "ru": "Вам следует попытаться <w>привести в порядок</w> свои мысли, прежде чем принимать такое важное решение.",
                                "zh": "在做出如此重大的决定之前，你应该试着<w>平复</w>一下思绪。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "compose yourself",
                        "compose your thoughts"
                    ],
                    "target_lang_definitions": {
                        "ru": "Успокоить себя или свои мысли; освободиться от волнения.",
                        "zh": "使自己或思绪平静下来；摆脱焦虑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собра́ться",
                                "target_lang_sense_clarification": "с мыслями или силами"
                            },
                            {
                                "target_lang_word": "успока́иваться",
                                "target_lang_sense_clarification": "приходить в спокойное состояние"
                            },
                            {
                                "target_lang_word": "овладе́ть собо́й",
                                "target_lang_sense_clarification": "вернуть самообладание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "镇定",
                                "target_lang_sense_clarification": "使情绪平稳"
                            },
                            {
                                "target_lang_word": "平复",
                                "target_lang_sense_clarification": "使心情或思绪恢复平静"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56189ff2-d5e5-3feb-9a83-4e38920ce4ae",
                    "sense_definition": "To make something by merging or combining different parts.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historian managed to <w>compose</w> a detailed narrative from several old letters.",
                            "target_lang_translations": {
                                "ru": "Историку удалось <w>составить</w> подробное повествование на основе нескольких старых писем.",
                                "zh": "历史学家设法从几封旧信件中<w>编排</w>出了一段详细的叙述。"
                            }
                        },
                        {
                            "text": "The artist will <w>compose</w> a collage using materials found on the beach.",
                            "target_lang_translations": {
                                "ru": "Художник <w>соберет</w> коллаж, используя материалы, найденные на пляже.",
                                "zh": "艺术家将使用在海滩上找到的材料来<w>拼凑</w>一幅拼贴画。"
                            }
                        }
                    ],
                    "synonyms": [
                        "compound"
                    ],
                    "common_phrases": [
                        "compose a narrative",
                        "compose a picture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать что-либо путем слияния или объединения различных частей.",
                        "zh": "通过合并或组合不同部分来制作某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "составля́ть",
                                "target_lang_sense_clarification": "объединять объекты в целое"
                            },
                            {
                                "target_lang_word": "собира́ть",
                                "target_lang_sense_clarification": "получать объект из частей"
                            },
                            {
                                "target_lang_word": "компонова́ть",
                                "target_lang_sense_clarification": "сочетать элементы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "编排",
                                "target_lang_sense_clarification": "指将元素组合成有序整体"
                            },
                            {
                                "target_lang_word": "拼凑",
                                "target_lang_sense_clarification": "指将不同部分组合在一起"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9665f39-54ce-33c9-a9c3-f9a0f5f13df7",
                    "sense_definition": "To arrange the elements of a photograph or other visual artwork.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The photographer took his time to <w>compose</w> the shot perfectly before clicking.",
                            "target_lang_translations": {
                                "ru": "Фотограф не торопился, чтобы идеально <w>выстроить</w> кадр перед тем, как нажать на кнопку.",
                                "zh": "摄影师在按下快门前，花时间完美地完成了<w>构图</w>。"
                            }
                        },
                        {
                            "text": "Learning how to <w>compose</w> a photograph is essential for any professional artist.",
                            "target_lang_translations": {
                                "ru": "Умение <w>компоновать</w> фотографию необходимо любому профессиональному художнику.",
                                "zh": "学习如何<w>构图</w>对任何专业艺术家来说都是必不可少的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "compose a shot",
                        "compose a photograph"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выстраивать элементы фотографии или другого визуального произведения искусства.",
                        "zh": "安排摄影或其他视觉艺术作品的元素。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выстра́ивать компози́цию",
                                "target_lang_sense_clarification": "в искусстве или фото"
                            },
                            {
                                "target_lang_word": "компонова́ть",
                                "target_lang_sense_clarification": "кадр или рисунок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "构图",
                                "target_lang_sense_clarification": "指视觉艺术中的布局安排"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a11f89e9-c191-3fab-818e-5db5b97db5c2",
                    "sense_definition": "To settle a dispute or argument; to reach a settlement.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "resolution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The diplomat worked tirelessly to <w>compose</w> the differences between the two nations.",
                            "target_lang_translations": {
                                "ru": "Дипломат неустанно работал над тем, чтобы <w>урегулировать</w> разногласия между двумя странами.",
                                "zh": "外交官为<w>调解</w>两国之间的分歧而不懈努力。"
                            }
                        },
                        {
                            "text": "They hoped to <w>compose</w> their legal matters without going to a full trial.",
                            "target_lang_translations": {
                                "ru": "Они надеялись <w>уладить</w> свои юридические вопросы без полноценного судебного разбирательства.",
                                "zh": "他们希望在不进行全面审判的情况下<w>平息</w>他们的法律纠纷。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "compose differences",
                        "compose matters"
                    ],
                    "target_lang_definitions": {
                        "ru": "Урегулировать спор или аргумент; достичь соглашения.",
                        "zh": "解决争端或分歧；达成和解。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "урегули́ровать",
                                "target_lang_sense_clarification": "разногласия или спор"
                            },
                            {
                                "target_lang_word": "ула́живать",
                                "target_lang_sense_clarification": "конфликт или дело"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "调解",
                                "target_lang_sense_clarification": "指解决双方分歧"
                            },
                            {
                                "target_lang_word": "平息",
                                "target_lang_sense_clarification": "指使冲突或争端停止"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5379aef9-ea52-3182-815d-7c275236007d",
                    "sense_definition": "To arrange types in a composing stick for printing; to typeset.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "printing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old days, workers had to <w>compose</w> each page of the newspaper by hand.",
                            "target_lang_translations": {
                                "ru": "В прежние времена рабочим приходилось <w>набирать</w> каждую страницу газеты вручную.",
                                "zh": "在过去，工人们必须手工<w>排版</w>报纸的每一页。"
                            }
                        },
                        {
                            "text": "The apprentice learned how to <w>compose</w> type quickly and accurately.",
                            "target_lang_translations": {
                                "ru": "Подмастерье учился быстро и точно <w>набирать</w> шрифт.",
                                "zh": "学徒学习了如何快速准确地进行<w>排版</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "compose type"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "refers to traditional manual typesetting"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Располагать литеры в верстатке для печати; набирать текст.",
                        "zh": "在排字架上排列铅字以进行印刷；排版。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "набира́ть",
                                "target_lang_sense_clarification": "типографский шрифт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "排版",
                                "target_lang_sense_clarification": "指印刷中的文字排列"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}