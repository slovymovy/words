                "senses": [
                    {
                        "sense_id": "d4af9aae-9ad9-33e4-8e08-5283d7676acf",
                        "entry_id": "3636a4ad-d23b-354a-9728-fa23ec09b5c0",
                        "glosses": [
                            "To take out of the grave or tomb."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4b1546ed-2ee3-3393-be92-9a4960b79b70",
                        "entry_id": "3636a4ad-d23b-354a-9728-fa23ec09b5c0",
                        "glosses": [
                            "To bring out, as from a grave or hiding place; to bring from obscurity into view."
                        ],
                        "tags": [
                            "figuratively",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "29d3b1bf-7309-4fec-9446-53f3eac9dc35",
                                "sense_id": "4b1546ed-2ee3-3393-be92-9a4960b79b70",
                                "text": "Why disinter dead faith from mouldering hidden?"
                            },
                            {
                                "example_id": "8a4f9a19-04c4-4fb9-8716-4fa5b64ad3c8",
                                "sense_id": "4b1546ed-2ee3-3393-be92-9a4960b79b70",
                                "text": "At this moment, however, the rooms bore every mark of having been recently and hurriedly ransacked; clothes lay about the floor, with their pockets inside out; lock-fast drawers stood open; and on the hearth there lay a pile of grey ashes, as though many papers had been burned. From these embers the inspector disinterred the butt end of a green cheque book, which had resisted the action of the fire."
                            },
                            {
                                "example_id": "847fab8e-61e3-4931-b03e-5765ea86e550",
                                "sense_id": "4b1546ed-2ee3-3393-be92-9a4960b79b70",
                                "text": "In his lectures he is equally wide-ranging and allusive, making strange links and analogies between apparently unrelated texts and ideas, and disinterring etymologies which writers cannot have been aware of."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "858544a7-e149-42b9-bade-ba26f1c65325",
                        "source_entry_id": "3636a4ad-d23b-354a-9728-fa23ec09b5c0",
                        "source_sense_description": "To take out of the grave or tomb; to unbury; to exhume; to dig up",
                        "target_lang_word": "déterrer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déterrer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d5e899a4-78f5-3bbe-a57a-32da2937c3ca",
                                        "entry_id": "01088813-b9e4-3179-b400-78cd10469f80",
                                        "glosses": [
                                            "Retirer de terre ce qui s’y trouvait caché, enfoui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f45497fd-fecd-4ae6-a342-2648f486bbfe",
                                                "sense_id": "d5e899a4-78f5-3bbe-a57a-32da2937c3ca",
                                                "text": "Déterrer un trésor. - Déterrer une statue antique."
                                            },
                                            {
                                                "example_id": "f8053269-1b74-42c3-8734-05256ab60388",
                                                "sense_id": "d5e899a4-78f5-3bbe-a57a-32da2937c3ca",
                                                "text": "[…], le chien s’était mis à rôder dans les environs, fouillant avidement les tas d’ordures, sans doute pour y déterrer un os ou quelque régal de ce genre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "946c79ff-6330-340a-bc89-5beecf66bd26",
                                        "entry_id": "01088813-b9e4-3179-b400-78cd10469f80",
                                        "glosses": [
                                            "Exhumer, retirer un corps de la sépulture."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25c30b60-61a2-4576-be46-51d7a76135a8",
                                                "sense_id": "946c79ff-6330-340a-bc89-5beecf66bd26",
                                                "text": "Le bruit s’étant répandu que cet homme avait été empoisonné, on l’a déterré pour l'autopsier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da234878-2b25-375d-8250-45f5ab8400aa",
                                        "entry_id": "01088813-b9e4-3179-b400-78cd10469f80",
                                        "glosses": [
                                            "Découvrir une chose qui était cachée, découvrir une personne qui se tenait cachée, qui ne voulait pas être connue ou qu'il était difficile de retrouver dans une foule."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcb47516-9b12-4447-99c8-da97512f93ff",
                                                "sense_id": "da234878-2b25-375d-8250-45f5ab8400aa",
                                                "text": "Déterrer un titre, une pièce authentique, un manuscrit oublié."
                                            },
                                            {
                                                "example_id": "3638cbb9-ad20-4d01-b30b-352dc583675a",
                                                "sense_id": "da234878-2b25-375d-8250-45f5ab8400aa",
                                                "text": "Je ne sais où il a déterré ce secret."
                                            },
                                            {
                                                "example_id": "3408eae7-67cd-4536-94bd-cc706fdc3621",
                                                "sense_id": "da234878-2b25-375d-8250-45f5ab8400aa",
                                                "text": "Il s’était retiré dans un endroit où il pensait être bien caché, mais on le déterra bientôt."
                                            },
                                            {
                                                "example_id": "38f34c7c-fd65-457b-9a6d-c38cfb005cfc",
                                                "sense_id": "da234878-2b25-375d-8250-45f5ab8400aa",
                                                "text": "Déterrer un sujet en postant une réponse sur un vieux fil de discussion de forum Internet, ce qui fait remonter le sujet parmi les sujets récents."
                                            },
                                            {
                                                "example_id": "3ae1930a-afce-47a2-9fcf-751909c73a06",
                                                "sense_id": "da234878-2b25-375d-8250-45f5ab8400aa",
                                                "text": "— Ne bougez pas, mon cher abbé. Je vais, si je puis, vous déterrer la princesse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f4724b8-10f2-34e8-b989-ec5c3a7d8743",
                                        "entry_id": "01088813-b9e4-3179-b400-78cd10469f80",
                                        "glosses": [
                                            "Débarrasser de la terre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4accaf69-136f-454d-a9a9-231985b31c7d",
                                                "sense_id": "4f4724b8-10f2-34e8-b989-ec5c3a7d8743",
                                                "text": "La récolte est étalée au minimum sur 15 jours car le chantier est réalisé par seulement 2 personnes qui arrachent et transportent au bâtiment de stockage pour déterrer et dégrenailler."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
