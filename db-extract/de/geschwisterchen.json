                    {
                        "translation_id": "a5122e9d-b85e-4fee-9e46-9a0d5c36873d",
                        "source_entry_id": "bc6eaf2a-094b-3d98-92f2-355195683cc0",
                        "source_sense_id": "33352c3d-eb66-302e-b4fa-28a788e674dd",
                        "source_sense_description": "kleines Geschwister",
                        "target_lang_word": "little sister",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "little sister",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cfedf5f1-561b-3d22-abd2-3fbadfd46218",
                                        "entry_id": "95cd7125-6b7c-3422-9abd-99bc21183cac",
                                        "glosses": [
