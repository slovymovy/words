        "fr-extract.jsonl": [
            {
                "entry_id": "04561a0f-b988-33bb-ba8d-01ae73c46428",
                "word": "stabulation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cef447f4-0f08-4aa0-8ddf-a0b0d82e8284",
                        "entry_id": "04561a0f-b988-33bb-ba8d-01ae73c46428",
                        "tags": [
                            "plural"
                        ],
                        "form": "stabulations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "01b26298-6cf7-33c8-ba94-fc95e94cd97a",
                        "entry_id": "04561a0f-b988-33bb-ba8d-01ae73c46428",
                        "glosses": [
                            "Séjour des bestiaux en étable, voire à l'écurie."
                        ],
                        "tags": [
                            "Élevage"
                        ],
                        "examples": [
                            {
                                "example_id": "8493d42d-2014-4c5b-940b-c04871afed34",
                                "sense_id": "01b26298-6cf7-33c8-ba94-fc95e94cd97a",
                                "text": "Pour les veaux d’élève, pour les vaches laitières, une stabulation mixte est préférable à une stabulation absolue."
                            },
                            {
                                "example_id": "ab9d228b-42ec-46af-ba99-ee0897565a26",
                                "sense_id": "01b26298-6cf7-33c8-ba94-fc95e94cd97a",
                                "text": "La stabulation et l’hygiène produisent des effets d’autant plus marqués sur les chevaux que ces animaux sont soumis pendant plus de temps à cette manière d’être."
                            },
                            {
                                "example_id": "425bfb7d-8990-4433-98f0-f21bfb0f6c32",
                                "sense_id": "01b26298-6cf7-33c8-ba94-fc95e94cd97a",
                                "text": "Dans les étables à stabulation libre ou entravée construites selon les spécifications courantes, il est difficile de visualiser l’espace requis pour que la vache effectue ce mouvement vers l’avant."
                            },
                            {
                                "example_id": "48888666-e42e-4995-8ea7-efc7004c055a",
                                "sense_id": "01b26298-6cf7-33c8-ba94-fc95e94cd97a",
                                "text": "En raison des longs hivers et des printemps tardifs au Québec, la stabulation des animaux nécessite l'entreposage de foin en quantité suffisante pour au moins cinq à six mois."
                            }
                        ]
                    },
                    {
                        "sense_id": "695af3c3-d3b9-3313-b8cd-b7f394eb37b9",
                        "entry_id": "04561a0f-b988-33bb-ba8d-01ae73c46428",
                        "glosses": [
                            "Cette étable elle-même, lorsque les animaux n'y sont pas entravés."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "9fd99612-5ab8-4853-9489-88f309e69f2b",
                                "sense_id": "695af3c3-d3b9-3313-b8cd-b7f394eb37b9",
                                "text": "L'objet du concours est la construction d'une stabulation pour 70 vaches laitières, d'une salle de traite 2 x 8 postes, du dispositif de traitement / stockage des effluents (fumière, fosse), des silos d'ensilage et des réseaux de fluide desservant l'installation."
                            }
                        ]
                    },
                    {
                        "sense_id": "d6cda8fa-d481-3927-9e73-3ffaa16c0a3c",
                        "entry_id": "04561a0f-b988-33bb-ba8d-01ae73c46428",
                        "glosses": [
                            "Type d'habitation des animaux à l'étable : stabulation libre ou stabulation entravée."
                        ],
                        "tags": [
                            "Élevage"
                        ],
                        "examples": [
                            {
                                "example_id": "4564c6d1-2957-4659-b01d-2fa965da3f3b",
                                "sense_id": "d6cda8fa-d481-3927-9e73-3ffaa16c0a3c",
                                "text": "Le logement des veaux, soit à l'attache, soit en boxes, sous appentis ouverts, le logement des élèves en stabulation libre sont donc à préconiser."
                            }
                        ]
                    },
                    {
                        "sense_id": "c5479a87-dea8-3b3d-8c65-bc1e2013a169",
                        "entry_id": "04561a0f-b988-33bb-ba8d-01ae73c46428",
                        "glosses": [
                            "Maintien d’animaux aquatiques vivants en bassins, en réservoirs ou en viviers."
                        ],
                        "tags": [
                            "Élevage"
                        ],
                        "examples": [
                            {
                                "example_id": "d6ae9af9-ebbe-45f5-bb19-28b5fd5c8856",
                                "sense_id": "c5479a87-dea8-3b3d-8c65-bc1e2013a169",
                                "text": "Le choix de l’espèce, Pocillopora meandrina, a permis le prélèvement et la mise en stabulation, en plaques multi-puits, de micro-bouture de 3 à 5 millimètres."
                            }
                        ]
                    }
                ],
