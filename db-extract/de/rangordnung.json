                    {
                        "form_id": "07042c31-3f3a-459c-9e45-f4cc32cf85e4",
                        "entry_id": "74c170a6-c5d1-3383-b787-a4e671ec7d89",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Rangordnungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c9c1ab64-8a46-33aa-a427-08dd05a4b74e",
                        "entry_id": "74c170a6-c5d1-3383-b787-a4e671ec7d89",
                        "glosses": [
                            "System, in dem jeder/jedes Einzelne seinen Platz gemäß seinem Rang findet, wobei der Rang sehr unterschiedlich definiert werden kann, zum Beispiel nach der Größe, der Schnelligkeit oder auch dem sozialen Status"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8db85cb7-c764-4b08-a525-a05cf1ea926c",
                                "sense_id": "c9c1ab64-8a46-33aa-a427-08dd05a4b74e",
                                "text": "„Die Oconees kamen nun nach ihrer Rangordnung, sich vor ihm als Häuptling zu neigen und die Comanchees als Brüder zu begrüßen, worauf die Versammlung sich unter lautem, anhaltendem Feuderufe zerstreute.“"
                            },
                            {
                                "example_id": "536ef0c2-67c6-437b-9002-2bdfc8a89d96",
                                "sense_id": "c9c1ab64-8a46-33aa-a427-08dd05a4b74e",
                                "text": "„Es lag in der Natur der Sache, dass sich in solchen Gruppen schnell eine gewisse Rangordnung etablierte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
