                ],
                "senses": [
                    {
                        "sense_id": "64c65de0-9352-3074-821e-8a50f110983f",
                        "entry_id": "fc82151f-f1ca-3f06-95a2-62bb0db500df",
                        "glosses": [
                            "Ort, an dem Wildtiere, beispielsweise Rehe, Wildschweine, Vögel, (meist regelmäßig) Nahrung zu sich nehmen; Ort, an dem Tiere von Menschen Futter angeboten bekommen"
                        ],
                        "tags": [
                            "auch"
                        ],
                        "examples": [
                            {
                                "example_id": "4b8358e5-b9ae-4908-8f54-be90e2934e4b",
                                "sense_id": "64c65de0-9352-3074-821e-8a50f110983f",
                                "text": "„Seit biblischer Zeit sind Heuschrecken berüchtigt: Sie fallen über ganze Landstriche her, fressen alles kahl und fliegen schnell weiter zum nächsten Futterplatz.“"
                            },
                            {
                                "example_id": "8f9b4df3-95e6-407d-abfc-3883b7c6f9e9",
                                "sense_id": "64c65de0-9352-3074-821e-8a50f110983f",
                                "text": "[Über Delphine] „Möglicherweise helfen Sprünge auch bei der Suche nach Futterplätzen, da sich Delfine damit an Möwenansammlungen orientieren können.“"
                            },
                            {
                                "example_id": "b2cdd325-ea2b-4cc7-b1a0-e9e9955f3526",
                                "sense_id": "64c65de0-9352-3074-821e-8a50f110983f",
                                "text": "[Über die Azoren] „Für über 20 Wal-Arten auf ihrem langen Weg von und in die arktischen Gewässer ist das Meer vor den Inseln ein üppiger Futterplatz: Mit dem Golfstrom gelangen aus den Tiefen des Ozeans tausende Tonnen Krill, Biomasse aus südlichen Gewässern, hierher.“"
                            },
                            {
                                "example_id": "24d89963-c63c-4684-85bf-e2b2215dda10",
                                "sense_id": "64c65de0-9352-3074-821e-8a50f110983f",
                                "text": "[Über Wombats] „Als Revier wird meist der bevorzugte Futterplatz durch Kot markiert und durch aggressives Verhalten verteidigt.“"
                            },
                            {
                                "example_id": "89844bfd-dc51-4cf9-b748-baf41f483fdd",
                                "sense_id": "64c65de0-9352-3074-821e-8a50f110983f",
                                "text": "[Über Kalongs] „An den Futterplätzen teilen sie sich in kleine Gruppen auf.“"
                            },
                            {
                                "example_id": "06c65c6d-676d-4465-b718-1bef95bc75a1",
                                "sense_id": "64c65de0-9352-3074-821e-8a50f110983f",
                                "text": "„Elefanten fliehen vor Dürreperioden und müssen auf der Suche nach Futterplätzen oft kilometerweite Distanzen zurücklegen.“"
                            },
                            {
                                "example_id": "289a4cfd-86bc-49a5-a037-301491744f70",
                                "sense_id": "64c65de0-9352-3074-821e-8a50f110983f",
                                "text": "„Auch an den asiatischen Grenzen des ehemaligen Ostblocks verschwanden tausende Kilometer Zäune. Fortan konnte zum Beispiel die Saiga-Antilope in Zentralasien ihre saisonalen Wanderungen zu den Futterplätzen wieder ausweiten.“"
                            },
                            {
                                "example_id": "5f3c83da-1a63-4d32-91fa-c68295ac7c36",
                                "sense_id": "64c65de0-9352-3074-821e-8a50f110983f",
                                "text": "„Das aus fünf Inseln bestehende Archipel ist Heimat seltener Fauna und Flora, Winterquartier für Wale aus dem Süden sowie Futterplatz für Schildkröten.“"
                            },
                            {
                                "example_id": "098125df-744c-437b-9146-50991b7140cc",
                                "sense_id": "64c65de0-9352-3074-821e-8a50f110983f",
                                "text": "„Ein eigener Verein kümmert sich um die Erhaltung der Weißstörche sowie um die Schaffung neuer Futterplätze.“"
                            },
                            {
                                "example_id": "e3b78d21-bc75-4128-8f29-0083d0b77d1a",
                                "sense_id": "64c65de0-9352-3074-821e-8a50f110983f",
                                "text": "[…] „in Gärten, in denen Menschen Körner, Nüsse oder Meisenknödel auslegen, wurden im Durchschnitt 26 Prozent mehr Vögel gesichtet als an Orten ohne Futterplatz.“"
                            },
                            {
                                "example_id": "df73532c-ad05-4882-b68b-10993744ab8e",
                                "sense_id": "64c65de0-9352-3074-821e-8a50f110983f",
                                "text": "„Das gründliche Reinigen des Futterplatzes sollte daher wie Auffüllen zur regelmäßigen täglichen Routine jedes Vogelfreundes gehören.“"
                            },
                            {
                                "example_id": "a069a5cc-9e19-48f4-9bd5-807628f78f04",
                                "sense_id": "64c65de0-9352-3074-821e-8a50f110983f",
                                "text": "„An der Scheune befindet sich der nicht zugängliche Futterplatz mit Krippen.“"
                            },
                            {
                                "example_id": "8be0e473-4c3e-4afc-b1c0-9906792b5409",
                                "sense_id": "64c65de0-9352-3074-821e-8a50f110983f",
                                "text": "„Das \"Projekt Grifone\" begann Ende der 80er Jahre und war das erste zum Schutz der Gänsegeier in den Alpen. Um dieses Ziel zu erreichen, wurde eine Kolonie eingerichtet mit einem Futterplatz, der den Tieren die Nahrung sicherte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
