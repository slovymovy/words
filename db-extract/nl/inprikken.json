                                                "sense_id": "07b0d4b8-6199-3aa9-ab79-3fa5bf8ff2db",
                                                "text": "Just put in the key for the ignition and turn it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6076f590-0ae3-3f7b-bf5f-9765003bb922",
                                        "entry_id": "68773aaf-c390-3fb3-b4ec-76d8d5e27805",
                                        "glosses": [
                                            "To place inside.",
                                            "To imprison or place in a prison cell."
