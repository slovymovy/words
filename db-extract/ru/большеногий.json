                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b74e9e64-5507-4264-9dc6-7482b45eb58a",
                                "sense_id": "c94a0b03-1688-3456-9dc4-a24abe36f051",
                                "text": "Он был большеногий и большеротый, с вислыми усами, опухшим носом — ничего необыкновенного, особенного, — но Доррен заметил, как шарили вдоль вагонов воровато, по-мышьи, узенькие глазки этого человека."
                            }
                        ]
