                "senses": [
                    {
                        "sense_id": "1bd5055d-7d50-38f5-b7f6-6a2deb5fb1b2",
                        "entry_id": "2c06abd3-186a-36e0-9bef-20313c807bb7",
                        "glosses": [
                            "tittle, the dot on the letter i."
                        ],
                        "tags": [
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "21dced54-7950-4a39-9590-e5d7c6caa22f",
                                "sense_id": "1bd5055d-7d50-38f5-b7f6-6a2deb5fb1b2",
                                "text": "Ein Weiser und Schriftgelehrter soll sogar behauptet haben: es müsse bei Notariatsurkunden dahin kommen, daß in denselben kein Tüpfelchen auf dem i fehle. Das wären theuere i-Tüpfelchen, wenn der Staatsanwalt auch die controliren sollte.",
                                "translation": "A sage and scribe has even claimed that it is a notary duty to ensure that no i lacks a dot. These would be expensive i dots if the state prosecutor also had to check them.",
                                "english": "A sage and scribe has even claimed that it is a notary duty to ensure that no i lacks a dot. These would be expensive i dots if the state prosecutor also had to check them."
                            }
                        ]
                    },
                    {
                        "sense_id": "0500d0e1-98de-3bc7-b328-5e69069afa18",
                        "entry_id": "2c06abd3-186a-36e0-9bef-20313c807bb7",
                        "glosses": [
                            "the finishing touch."
                        ],
                        "tags": [
                            "idiomatic",
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "28f27239-d454-45a0-90c6-190ff539badf",
                                "sense_id": "0500d0e1-98de-3bc7-b328-5e69069afa18",
                                "text": "Christian Gentner (31 minutes) und Vedad Ibisevic (35./Handelfmeter) mit seinem 18. Pflichtspieltreffer in dieser Saison sorgten vor 22 000 Zuschauern für das i-Tüpfelchen auf eine beachtliche Hinrunde [...]",
                                "translation": "Christian Gentner (31 min) and Vedad Ibisevic (35 min, penalty), on his eighteenth appearance this season, put the finishing touches on an impressive first half in front of 22,000 fans.",
                                "english": "Christian Gentner (31 min) and Vedad Ibisevic (35 min, penalty), on his eighteenth appearance this season, put the finishing touches on an impressive first half in front of 22,000 fans."
                            }
                        ]
                    }
