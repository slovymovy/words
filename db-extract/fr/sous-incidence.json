                        "entry_id": "c73929d6-df30-30cd-ba53-c27ca6ca2739",
                        "glosses": [
                            "Incidence inférieure à la moyenne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6aa1bf7-88fd-49ad-8eff-dd4630fce95f",
                                "sense_id": "6bfaafca-19e5-3757-ae4e-b226f55dc71c",
                                "text": "On observe une surincidence dépassant les 10 % par rapport à la moyenne nationale chez les hommes dans huit départements (Pas-de-Calais, Indre, Moselle, Nord, Landes, Vendée, Meuse et Deux-Sèvres) et une sous-incidence dépassant 10 % dans cinq départements (Corse, Paris, Haute-Savoie, Hautes-Alpes et Hauts-de-Seine)."
                            },
                            {
                                "example_id": "bc0f5609-f703-4bc6-904b-b1e31a400d62",
                                "sense_id": "6bfaafca-19e5-3757-ae4e-b226f55dc71c",
                                "text": "Les sous-incidences de cancers de la partie Ouest correspondent à de faibles incidences pour tous les cancers."
                            },
                            {
                                "example_id": "f0d1d5c9-1a62-4b0f-a559-11ab3139da61",
                                "sense_id": "6bfaafca-19e5-3757-ae4e-b226f55dc71c",
                                "text": "La Corse présente également une sous-incidence, estimée à 14 %, pour l’ensemble des cancers par rapport à l’ensemble de la France métropolitaine."
                            }
                        ]
                    }
