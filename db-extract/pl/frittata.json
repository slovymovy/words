                                "target_senses": [
                                    {
                                        "sense_id": "b987b0df-d2e4-3ac5-85ce-861ec20499dd",
                                        "entry_id": "ba01f016-3dd8-3ecf-b72a-9c7b1e888750",
                                        "glosses": [
                                            "A crustless quiche: a molded omelette in which vegetables, cheese, etc., are mixed into the eggs and cooked together."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fadabee1-3a83-4376-905e-2a631d9760da",
                                                "sense_id": "b987b0df-d2e4-3ac5-85ce-861ec20499dd",
                                                "text": "The classic Italian egg pie, the frittata is an attractive dish that requires no fancy rolling or split-second timing... Much of the preparation for most frittate can be done in advance[.]"
                                            },
                                            {
                                                "example_id": "ab8093bc-795d-4472-b9fd-56ff28d2d367",
                                                "sense_id": "b987b0df-d2e4-3ac5-85ce-861ec20499dd",
                                                "text": "It was in Giulia Vannoni’s grey Martello tower, on an island off the coast of France, sitting at a marble-topped table eating frittata and drinking Aperol, the honey-coloured aperitif of Florence, that Sydney Tremaine began to believe once more in happiness—as bizarre and unlikely a time and place as any, in which to believe in such a thing again."
                                            }
                                        ]
                                    }
                                ]
                            }
