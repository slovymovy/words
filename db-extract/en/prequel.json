                        "target_lang_word": "Vorläufer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorläufer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1dd6acfd-b388-3015-bd31-ff4321eb1ef4",
                                        "entry_id": "911a5789-9bbd-396a-9496-3ea380e12a5a",
                                        "glosses": [
                                            "Wegbereiter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc2290f7-4599-44fc-b687-e18600c2710b",
                                                "sense_id": "1dd6acfd-b388-3015-bd31-ff4321eb1ef4",
                                                "text": "Die Vorläufer dieser Kunstrichtung waren wenig bekannt."
                                            },
                                            {
                                                "example_id": "51ccbeea-3f2d-43c4-8aac-0c94a2dc5965",
                                                "sense_id": "1dd6acfd-b388-3015-bd31-ff4321eb1ef4",
                                                "text": "„Nein, es war nicht Grimm, sondern Arthur Schopenhauer, der Philosoph des Pessimismus und – als Vorläufer unserer Sprachkritik – natürlich auch ein abgrundtiefer Sprachpessimist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b38b3df1-2a4e-3d9e-b691-5b393547d858",
                                        "entry_id": "911a5789-9bbd-396a-9496-3ea380e12a5a",
                                        "glosses": [
                                            "jemand, der einen Bewerb vor den gewerteten Sportlern bestreitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d283ed2a-cb85-415c-998e-8b19b49c308f",
                                                "sense_id": "b38b3df1-2a4e-3d9e-b691-5b393547d858",
                                                "text": "Der Vorläufer startet meist als Testpilot."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5b268fba-226a-3c2b-858d-5f4c7a6ad1fd",
                                        "entry_id": "911a5789-9bbd-396a-9496-3ea380e12a5a",
                                        "glosses": [
                                            "Anfangs- oder Endstreifen eines Gewebebandes"
                                        ],
                                        "tags": [
                                            "Färberwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74930755-dcec-4b86-ba51-553c63755faa",
                                                "sense_id": "5b268fba-226a-3c2b-858d-5f4c7a6ad1fd",
                                                "text": "Die Vorläufer sind meist Ausschussware."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "e6ed129c-b710-3880-a1d0-d494db144e5b",
                                        "entry_id": "911a5789-9bbd-396a-9496-3ea380e12a5a",
                                        "glosses": [
                                            "etwas, das einen Teil der Eigenschaften einer später aufkommenden Sache bietet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fba1bd94-7246-4ceb-b0ba-90442fe99eeb",
                                                "sense_id": "e6ed129c-b710-3880-a1d0-d494db144e5b",
                                                "text": "Das Bakelit ist ein Vorläufer der heutigen Polymer-Kunststoffe."
                                            },
                                            {
                                                "example_id": "23cc932c-b491-4d7b-9b2f-14756da9399f",
                                                "sense_id": "e6ed129c-b710-3880-a1d0-d494db144e5b",
                                                "text": "„Die Endung und ihre Vorläufer lassen sich bis ins Althochdeutsche und sogar weiter zurückverfolgen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7648a47e-e9a4-4640-a0a3-b39de7497c00",
                        "source_entry_id": "65cb6880-3d14-3fb9-8938-14491df69128",
                        "source_sense_id": "033dbfbf-a384-32c1-ae34-c22fd66b0344",
                        "source_sense_description": "in a series of works, an installment that is set chronologically before its predecessor",
                        "target_lang_word": "Vorgeschichte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorgeschichte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "45243c92-2936-3632-96ac-e92e42de043c",
                                        "entry_id": "64f459a7-f2f4-3267-8b20-f1f3516061a4",
                                        "glosses": [
                                            "Gesamtheit der historischen Ereignisse vor Beginn der schriftlichen Überlieferung"
                                        ],
                                        "tags": [
                                            "Geschichtswissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "055d2b9a-af6c-47bd-8f39-031bcb5c4aab",
                                                "sense_id": "45243c92-2936-3632-96ac-e92e42de043c",
                                                "text": "Mit den Kulturen der Vorgeschichte befasst sich die Archäologie."
                                            },
                                            {
                                                "example_id": "b134b50f-5d4f-468b-ad3b-0a4da7d4638a",
                                                "sense_id": "45243c92-2936-3632-96ac-e92e42de043c",
                                                "text": "„Das ist vielleicht die bedeutendste Erkenntnis auf dem Gebiet der Humanevolution seit Lucys Entdeckung: dass in unserer Vorgeschichte mehrere menschliche Arten gleichzeitig auf der Erde umherstreiften.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "19891f0a-1526-39f6-96a6-1dcdfe2a4df9",
                                        "entry_id": "64f459a7-f2f4-3267-8b20-f1f3516061a4",
                                        "glosses": [
                                            "das, was vor einem bestimmten Ereignis/Zustand liegt und sich darauf auswirkt/zu seinem Verständnis beiträgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fcdd5a1-fe20-42e6-a273-f38a3929591e",
                                                "sense_id": "19891f0a-1526-39f6-96a6-1dcdfe2a4df9",
                                                "text": "„Seine Vorgeschichte reichte weit in die Kindheit hinein und in die Zeit, in welcher der innere Horizont durch die Künste des Lesens und Schreibens noch keine Einschnürung erfahren hat.“"
                                            },
                                            {
                                                "example_id": "a1d50b35-da28-456f-9938-86d5ac4883d4",
                                                "sense_id": "19891f0a-1526-39f6-96a6-1dcdfe2a4df9",
                                                "text": "„Der »Schach Lolo« hat eine Vorgeschichte, die der Grund war, dieses Gedicht in die dreibändige Edition von Wielands politischen Schriften aufzunehmen.“"
                                            },
                                            {
                                                "example_id": "5f80350c-f8ea-4717-8dcd-26211c4bb251",
                                                "sense_id": "19891f0a-1526-39f6-96a6-1dcdfe2a4df9",
                                                "text": "„Oft ging dabei der historische Kontext unter, also die Vorgeschichte deutscher Aggressionen und Verbrechen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cbf72a61-fc6f-4039-9e15-6a1b157af41e",
                        "source_entry_id": "65cb6880-3d14-3fb9-8938-14491df69128",
