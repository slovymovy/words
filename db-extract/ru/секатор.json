                                    {
                                        "sense_id": "f2cf17f0-6e47-3bb7-860d-75b0d8432182",
                                        "entry_id": "c6095d92-1e75-38de-acc5-f88786106a2a",
                                        "glosses": [
                                            "Outil de jardinage, se présentant comme de forts ciseaux à ressort dont une lame est tranchante et l’autre sert de point d’appui et qui sert à tailler les tiges, les petites branches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "661f3a9e-dc38-4ec8-9567-87ca1587c725",
                                                "sense_id": "f2cf17f0-6e47-3bb7-860d-75b0d8432182",
                                                "text": "La taille des haies au sécateur donne un aspect beaucoup plus naturel à la végétation qu’en utilisant un taille-haie."
                                            },
                                            {
                                                "example_id": "0f71114a-3498-4e4f-935c-59f0f07b73aa",
                                                "sense_id": "f2cf17f0-6e47-3bb7-860d-75b0d8432182",
                                                "text": "L’homme était assis sur la tête d’un saule et, muni d’un sécateur, il abattait les branches."
                                            },
                                            {
                                                "example_id": "fd834854-6884-4bf3-858c-8acd07386243",
                                                "sense_id": "f2cf17f0-6e47-3bb7-860d-75b0d8432182",
                                                "text": "Les sécateurs claquent du bec dans les jardins. Enfermez-moi dans une chambre obscure, ce bruit-là y porte quand même le soleil d’avril, piquant à la peau, traître comme un vin sans bouquet."
                                            }
                                        ]
                                    },
