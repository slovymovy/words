                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8744b95c-6c18-4e19-8cc8-035894c53c73",
                                "sense_id": "1ec90f99-8049-3731-8305-0a269be22c0a",
                                "text": "Zwei Jahre lang kämpfte Lucy Redler vergeblich um die Mitgliedschaft in der Linken, nun wurde die bekennende Trotzkistin aufgenommen."
