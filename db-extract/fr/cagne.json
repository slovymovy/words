            {
                "entry_id": "e456ea45-5b17-3da3-adae-5aef2e9410fc",
                "word": "cagne",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "116cd165-ba58-424e-b586-42b7d8f4e365",
                        "entry_id": "e456ea45-5b17-3da3-adae-5aef2e9410fc",
                        "tags": [
