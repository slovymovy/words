{
    "word_family": [
        "praten",
        "gepraat",
        "praatje",
        "napraten",
        "doorpraten"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "472c099e-7a66-3012-98fe-235c671d481a",
                    "sense_definition": "Elkaar op de hoogte brengen van de recente gebeurtenissen nadat men elkaar een tijd niet gesproken heeft.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "communicatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hebben elkaar maanden niet gezien, dus we moeten snel eens <w>bijpraten</w> over alles.",
                            "target_lang_translations": {
                                "en": "We haven't seen each other in months, so we really need to <w>catch up</w> about everything soon."
                            }
                        },
                        {
                            "text": "Onder het genot van een kop koffie <w>praatten</w> de oude vrienden gezellig <w>bij</w>.",
                            "target_lang_translations": {
                                "en": "Over a cup of coffee, the old friends had a pleasant time <w>catching up</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gezellig bijpraten",
                        "even bijpraten"
                    ],
                    "target_lang_definitions": {
                        "en": "To exchange news and updates after not having spoken to each other for some time."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "catch up",
                                "target_lang_sense_clarification": "informal, between friends or acquaintances"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf24112a-b1c8-33e9-b5c3-2ecdc720bea1",
                    "sense_definition": "Iemand informeren over de nieuwste stand van zaken of recente ontwikkelingen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "communicatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De manager vroeg om hem voor de vergadering over het lopende project <w>bij</w> te <w>praten</w>.",
                            "target_lang_translations": {
                                "en": "The manager asked to be <w>briefed</w> on the ongoing project before the meeting."
                            }
                        },
                        {
                            "text": "Mijn collega <w>praatte</w> me direct <w>bij</w> over de beslissingen van het bestuur.",
                            "target_lang_translations": {
                                "en": "My colleague immediately <w>brought</w> me <w>up to speed</w> on the board's decisions."
                            }
                        }
                    ],
                    "synonyms": [
                        "inlichten",
                        "informeren"
                    ],
                    "common_phrases": [
                        "iemand bijpraten over"
                    ],
                    "target_lang_definitions": {
                        "en": "To brief or update someone on the latest developments or current state of affairs."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "brief",
                                "target_lang_sense_clarification": "give essential information"
                            },
                            {
                                "target_lang_word": "update",
                                "target_lang_sense_clarification": "provide the latest information"
                            },
                            {
                                "target_lang_word": "bring up to speed",
                                "target_lang_sense_clarification": "idiomatic, familiarize with recent status"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}