                    }
                ],
                "translations": [
                    {
                        "translation_id": "c714acbe-cfda-490f-9672-1f8232583af9",
                        "source_entry_id": "74656f43-b040-3d4a-88ad-7ba47464e67e",
                        "source_sense_id": "c9726779-c334-3f42-a7dd-346145ce4a5d",
                        "source_sense_description": "gehoben, euphemistisch: Platz/Stelle der Bestattung",
                        "target_lang_word": "resting place",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "resting place",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7fae57b3-5b34-3393-8acc-3841cb32d521",
                                        "entry_id": "c068ad49-f3dc-3559-9aa2-aa1ab7451fce",
                                        "glosses": [
                                            "A place where one is buried or laid to rest; a tomb."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b2fcb07-a938-4e39-ac12-2b1a4224ff60",
                                                "sense_id": "7fae57b3-5b34-3393-8acc-3841cb32d521",
                                                "text": "From his beloved second home at Warm Springs, Georgia, the body of Franklin Delano Roosevelt moves on the first stages of his journey to his final resting place. Scores of sufferers from infantile paralysis sorrowfully bid farewell to their great friend and benefactor. The President's dog follows his beloved master. Aboard a special train beginning the twenty-four hour trip back to Washington, the thirty-first President of the United States leaves Warm Springs forever."
                                            },
                                            {
                                                "example_id": "5ccfb87b-53b5-42e0-b158-ee1908f50d4f",
                                                "sense_id": "7fae57b3-5b34-3393-8acc-3841cb32d521",
                                                "text": "The Western Region station [at Windsor] has seen many arrivals and departures of monarchs, some returning to their last resting place at Frogmore Mausoleum."
                                            },
                                            {
                                                "example_id": "4b3d5e8c-5bc0-48b1-a8f1-b67774dcdc5e",
                                                "sense_id": "7fae57b3-5b34-3393-8acc-3841cb32d521",
                                                "text": "That [Robert] Stephenson's final resting place is in Westminster Abbey, along civil engineering great Thomas Telford, signifies his importance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7339bfa2-2b32-3463-a0cd-bbffb527b7f6",
                                        "entry_id": "c068ad49-f3dc-3559-9aa2-aa1ab7451fce",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see resting, place. A place where one rests or may rest."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
