                "senses": [
                    {
                        "sense_id": "5994e9b7-029b-390b-982a-edddff840ab1",
                        "entry_id": "db13c5f3-5320-3f30-86e5-a68a1d578551",
                        "glosses": [
                            "bowl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3b546d4-389a-4eb9-8959-0cb4f969d68a",
                                "sense_id": "5994e9b7-029b-390b-982a-edddff840ab1",
                                "text": "В пло́шках под ска́тами крыш собрала́сь дождева́я вода́, кото́рую вскипяти́ли."
                            }
                        ]
                    },
                    {
                        "sense_id": "dfe6c2ec-c5fa-3952-93ee-2b99fcf78998",
                        "entry_id": "db13c5f3-5320-3f30-86e5-a68a1d578551",
                        "glosses": [
                            "oil lamp"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "019444d2-3f6d-4570-912c-a63def00daf5",
                                "sense_id": "dfe6c2ec-c5fa-3952-93ee-2b99fcf78998",
                                "text": "Он был так бе́ден, как нельзя́ уже́ быть бедне́е. Жил в како́м-то чула́нчике, ме́жду пе́чкой и дрова́ми, рабо́тал при све́те пло́шки, и е́сли б не симпа́тия това́рищей, он не знал бы, где взять книг, а иногда́ белья́ и пла́тья.",
                                "translation": "He was so poor that it was virtually impossible to be poorer. He lived in a tiny boxroom between the firewood and the stove, and worked by the light of an oil lamp, and if it had not been for the kindness of friends, he would have had no idea how to obtain books – or sometimes, even clothes.",
                                "english": "He was so poor that it was virtually impossible to be poorer. He lived in a tiny boxroom between the firewood and the stove, and worked by the light of an oil lamp, and if it had not been for the kindness of friends, he would have had no idea how to obtain books – or sometimes, even clothes."
                            }
                        ]
                    }
                ],
