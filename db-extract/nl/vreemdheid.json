                "senses": [
                    {
                        "sense_id": "65d89d11-12dc-35f9-8c30-006e631eaf4c",
                        "entry_id": "c283cba4-b619-3f0b-8bba-61b7b6bd3c60",
                        "glosses": [
                            "iets dat niet gewoon is; iets dat afwijkend is; iets dat onbekend is; iets dat raar is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a90cc45c-d89b-45f5-9ac2-e6319a303561",
                                "sense_id": "65d89d11-12dc-35f9-8c30-006e631eaf4c",
                                "text": "'Was het Bacon niet die zei dat is er geen schoonheid is, zonder wat vreemdheid in de proporties?'"
                            },
                            {
                                "example_id": "4d721187-744e-4602-870e-0e26a9dd91c5",
                                "sense_id": "65d89d11-12dc-35f9-8c30-006e631eaf4c",
                                "text": "‘Plotseling, uit het niets, voelde ik de koelte en vreemdheid van de handen van een vreemde die mijn blote borsten van achteren omsloten’, zo omschrijft ze het voorval."
                            }
                        ]
                    },
                    {
                        "sense_id": "132efe26-c774-3b50-a8c2-3f99da5a887c",
                        "entry_id": "c283cba4-b619-3f0b-8bba-61b7b6bd3c60",
                        "glosses": [
                            "grootheidin de kwantummechanica"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fac906da-154b-4d18-8e63-dbb637de7457",
                        "source_entry_id": "c283cba4-b619-3f0b-8bba-61b7b6bd3c60",
                        "source_sense_id": "65d89d11-12dc-35f9-8c30-006e631eaf4c",
                        "source_sense_description": "iets dat niet gewoon is; iets dat afwijkend is; iets dat onbekend is; iets dat raar is",
                        "target_lang_word": "peculiarity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peculiarity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e7bdcf4-8cd6-3148-89e4-f4eac3bd710c",
                                        "entry_id": "42653976-f717-3c06-bd96-97e391af58d4",
                                        "glosses": [
                                            "The quality or state of being peculiar; individuality; singularity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0bb12eb-65c6-4386-887a-646a360cd813",
                                                "sense_id": "1e7bdcf4-8cd6-3148-89e4-f4eac3bd710c",
                                                "text": "The peculiarity of meeting six people on a usually deserted trail only struck me later on."
                                            },
                                            {
                                                "example_id": "654b88a2-ccc5-44fd-ad41-917a73e521ac",
                                                "sense_id": "1e7bdcf4-8cd6-3148-89e4-f4eac3bd710c",
                                                "text": "“'There is always a moment when the familiar becomes the strange,'” Cora recited, as she stood looking around at the bustling open docking area of Tamayo Point. “'Look at your own hand and you will eventually notice the variation of textures, the growth of nails and the fade of scars, the peculiarity of having five fingers instead of three.'”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "286034df-532e-3e35-bfd1-6200f1ae10d7",
                                        "entry_id": "42653976-f717-3c06-bd96-97e391af58d4",
                                        "glosses": [
                                            "That which is peculiar; a special and distinctive characteristic or habit; particularity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c77b41d7-c494-4aad-a9a9-914e9a743099",
                                                "sense_id": "286034df-532e-3e35-bfd1-6200f1ae10d7",
                                                "text": "I had often heard of Miss Marchmont, and of her peculiarities (she had the character of being very eccentric), but till now had never seen her."
                                            },
                                            {
                                                "example_id": "226f8eef-e171-42ca-adf4-e30e0365b60e",
                                                "sense_id": "286034df-532e-3e35-bfd1-6200f1ae10d7",
                                                "text": "I thought Alice and H. J. P. would have fainted at the full spectacle; but we are fast getting used to the little peculiarities of foreigners and I trust they will forgive us many sins in return."
                                            },
                                            {
                                                "example_id": "f5520c2d-343d-4ad6-97f1-7aaf6a3ce5ec",
                                                "sense_id": "286034df-532e-3e35-bfd1-6200f1ae10d7",
                                                "text": "The peculiarity of this invention consists in a means for varying the angle at which the plaiting-blade is held in the plaiter without varying the position of the entire instrument upon the sewing-machine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "938863ca-cb92-3dad-a0c5-0bfdccbaa01d",
                                        "entry_id": "42653976-f717-3c06-bd96-97e391af58d4",
                                        "glosses": [
                                            "Exclusive possession or right."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
