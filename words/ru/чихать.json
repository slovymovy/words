{
    "word_family": [
        "чих",
        "чихание",
        "чиханье",
        "чихалка"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "43c50384-005b-306d-83e5-7f0d89d9d5bd",
                    "sense_definition": "непроизвольно выдыхать воздух через нос при раздражении носоглотки",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "физиология",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я начал <w>чихать</w> из-за пыли в комнате.",
                            "target_lang_translations": {
                                "it": "Ho iniziato a <w>starnutire</w> a causa della polvere nella stanza."
                            }
                        },
                        {
                            "text": "Если человек простужен, он может часто <w>чихать</w>.",
                            "target_lang_translations": {
                                "it": "Se una persona è raffreddata, può <w>starnutire</w> spesso."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Espellere aria dal naso in modo involontario a causa di un'irritazione delle vie nasali."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "starnutire",
                                "target_lang_sense_clarification": "Il verbo standard per l'atto fisico di starnutire."
                            },
                            {
                                "target_lang_word": "starnutare",
                                "target_lang_sense_clarification": "Variante meno comune di starnutire."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6250125f-aad6-37d3-a054-2dd6d6a95831",
                    "sense_definition": "болеть простудным заболеванием",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "физиология",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Всю неделю я буду <w>чихать</w> и кашлять из-за сильной простуды.",
                            "target_lang_translations": {
                                "it": "Per tutta la settimana <w>sarò raffreddato</w> e tossirò a causa di un forte raffreddore."
                            }
                        },
                        {
                            "text": "Не выходи на холод, иначе снова начнешь <w>чихать</w>.",
                            "target_lang_translations": {
                                "it": "Non uscire al freddo, altrimenti <w>ricomincerai ad avere il raffreddore</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Essere affetti da un raffreddore o un'influenza."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "essere raffreddato",
                                "target_lang_sense_clarification": "Espressione comune per indicare lo stato di salute influenzato dal raffreddore."
                            },
                            {
                                "target_lang_word": "avere il raffreddore",
                                "target_lang_sense_clarification": "Modo idiomatico per descrivere la condizione di malattia."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d07b312-f5d7-3966-8e9c-958732e64aa8",
                    "sense_definition": "издавать резкие прерывистые звуки при неравномерной работе механизма",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "механика",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Старый мотор начал <w>чихать</w> и вскоре совсем заглох.",
                            "target_lang_translations": {
                                "it": "Il vecchio motore ha iniziato a <w>singhiozzare</w> e poco dopo si è spento del tutto."
                            }
                        },
                        {
                            "text": "Двигатель машины стал <w>чихать</w> из-за плохого топлива.",
                            "target_lang_translations": {
                                "it": "Il motore dell'auto ha iniziato a <w>singhiozzare</w> a causa del carburante scadente."
                            }
                        }
                    ],
                    "synonyms": [
                        "пыхтеть"
                    ],
                    "target_lang_definitions": {
                        "it": "Emettere suoni secchi e irregolari a causa di un malfunzionamento meccanico."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "singhiozzare",
                                "target_lang_sense_clarification": "Usato metaforicamente per un motore che procede a scatti."
                            },
                            {
                                "target_lang_word": "andare a scatti",
                                "target_lang_sense_clarification": "Descrive il funzionamento irregolare di un meccanismo."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b1bb71b-31ce-39bc-bca4-d57fce5ed45e",
                    "sense_definition": "относиться с полным пренебрежением или безразличием",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "отношение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ему <w>чихать</w> на все наши правила и советы.",
                            "target_lang_translations": {
                                "it": "A lui <w>non importa nulla</w> di tutte le nostre regole e consigli."
                            }
                        },
                        {
                            "text": "Они <w>чихали</w> на мнение окружающих людей.",
                            "target_lang_translations": {
                                "it": "A loro <w>non importava nulla</w> dell'opinione delle persone intorno."
                            }
                        }
                    ],
                    "synonyms": [
                        "плевать"
                    ],
                    "common_phrases": [
                        "чихать на всё"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "просторечное"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Mostrare totale disinteresse o disprezzo verso qualcosa o qualcuno."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "infischiarsene",
                                "target_lang_sense_clarification": "Verbo colloquiale per indicare totale indifferenza."
                            },
                            {
                                "target_lang_word": "fregarsene",
                                "target_lang_sense_clarification": "Molto colloquiale, esprime disprezzo o noncuranza."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}