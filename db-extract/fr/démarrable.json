                        "glosses": [
                            "Qui peut être démarré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3748fed-be79-4820-8ad7-9643794d5726",
                                "sense_id": "7f2f4588-ee47-3359-833e-a355f0c74537",
                                "text": "La production est démarrable sans moyens mécaniques dès que les anacardiers seront mûrs, c’est-à-dire dans cinq années."
                            },
                            {
                                "example_id": "80430379-240d-447e-bbb4-82ef47fb24ce",
                                "sense_id": "7f2f4588-ee47-3359-833e-a355f0c74537",
                                "text": "La charge démarrable est la charge que l’engin peut démarrer dans une rampe avec une accélération minimale de 5 cm/s² en voyageur et 3 cm/s² en fret."
                            },
                            {
                                "example_id": "8c726997-7572-4828-a1bd-b2ff4c533711",
                                "sense_id": "7f2f4588-ee47-3359-833e-a355f0c74537",
                                "text": "Selon Kaspersky, les infections se sont sans doute produites en raison d’un accès physique à la machine de la victime. Très probablement au moyen d’une clé USB démarrable contenant un programme de mise à jour spécial."
                            },
                            {
                                "example_id": "83790447-4c03-4bc7-b538-16440744ebda",
                                "sense_id": "7f2f4588-ee47-3359-833e-a355f0c74537",
                                "text": "Disponible gratuitement, cet utilitaire open source permet de générer en quelques clics un support démarrable pour procéder à la réinstallation de vos systèmes d’exploitation."
                            }
                        ]
                    }
