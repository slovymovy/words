                "senses": [
                    {
                        "sense_id": "8e8ed36f-b175-3a56-b335-56a186627b04",
                        "entry_id": "8a1839e9-a92f-373b-9926-000670c6a8a9",
                        "glosses": [
                            "Action d’insérer ou état de ce qui est inséré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdaa9184-1b94-4dbe-ba6a-5fe383c11e6f",
                                "sense_id": "8e8ed36f-b175-3a56-b335-56a186627b04",
                                "text": "On ne s’improvise pas usurier, il faut parvenir d’abord à une méritoire insertion dans la mafia des gens bien placés pour exploiter leur prochain."
                            },
                            {
                                "example_id": "8e524547-6777-4685-be91-1692ffd0fd05",
                                "sense_id": "8e8ed36f-b175-3a56-b335-56a186627b04",
                                "text": "L’insertion d’un feuillet dans un livre."
                            },
                            {
                                "example_id": "6481b1d3-d19f-44cd-af5e-27cf583ddad4",
                                "sense_id": "8e8ed36f-b175-3a56-b335-56a186627b04",
                                "text": "L’insertion d’une note marginale dans le texte."
                            },
                            {
                                "example_id": "7405fa4c-2e80-4995-b5e1-d04de4588ea5",
                                "sense_id": "8e8ed36f-b175-3a56-b335-56a186627b04",
                                "text": "L’insertion d’une annonce, d’un article dans un journal."
                            },
                            {
                                "example_id": "6560cc24-4298-4271-aaa9-6a2d82deae41",
                                "sense_id": "8e8ed36f-b175-3a56-b335-56a186627b04",
                                "text": "On demande l’insertion au procès-verbal."
                            },
                            {
                                "example_id": "8fea8852-d150-44f0-9bf9-6163c726c9d2",
                                "sense_id": "8e8ed36f-b175-3a56-b335-56a186627b04",
                                "text": "L’insertion d’un article dans un traité."
                            },
                            {
                                "example_id": "5dc6f62b-5571-4a79-936d-2b004aeb87d2",
                                "sense_id": "8e8ed36f-b175-3a56-b335-56a186627b04",
                                "text": "Le prix des insertions dans un journal."
                            }
                        ]
                    },
                    {
                        "sense_id": "6bb8571f-a4fd-350f-983f-08df4511902c",
                        "entry_id": "8a1839e9-a92f-373b-9926-000670c6a8a9",
                        "glosses": [
                            "Zone de liaison entre deux tissus ou deux organes de nature différente."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2f99c8c-9a4f-4891-9916-85160ab16d1b",
                                "sense_id": "6bb8571f-a4fd-350f-983f-08df4511902c",
                                "text": "L’insertion des fibres musculaires sur un tendon."
                            },
                            {
                                "example_id": "d27fcf53-7506-4b3a-8dd5-f8280523e40a",
                                "sense_id": "6bb8571f-a4fd-350f-983f-08df4511902c",
                                "text": "L’insertion d’un tendon, d’un ligament sur un cartilage."
                            },
                            {
                                "example_id": "df537712-6362-4417-b122-82f8e87d09ee",
                                "sense_id": "6bb8571f-a4fd-350f-983f-08df4511902c",
                                "text": "Point d’insertion."
                            },
                            {
                                "example_id": "8c27873a-b5f3-4743-a8da-497fe761cba4",
                                "sense_id": "6bb8571f-a4fd-350f-983f-08df4511902c",
                                "text": "Mode d’insertion."
                            },
                            {
                                "example_id": "23f63988-8878-42ec-8184-6ec1f74d4f37",
                                "sense_id": "6bb8571f-a4fd-350f-983f-08df4511902c",
                                "text": "L’insertion des étamines, de la corolle, etc."
                            }
                        ]
