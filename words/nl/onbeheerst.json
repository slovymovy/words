                        "gecontroleerd"
                    ],
                    "common_phrases": [
                        "onbeheerste groei",
                        "het onbeheerste woord"
                    ],
                    "target_lang_definitions": {
                        "en": "Without limitation or restraint; unchecked or unregulated."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unchecked",
                                "target_lang_sense_clarification": "not stopped, slowed down, or controlled"
                            },
                            {
                                "target_lang_word": "unbridled",
                                "target_lang_sense_clarification": "not held back or controlled"
                            },
                            {
