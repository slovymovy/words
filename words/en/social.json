                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "administration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bank asked for my <w>social</w> to verify my identity.",
                            "target_lang_translations": {
                                "ru": "Банк запросил мой <w>но́мер социа́льного страхова́ния</w> для подтверждения личности.",
                                "zh": "银行要求我提供<w>社会安全号码</w>以核实身份。"
                            }
                        },
                        {
                            "text": "You should never give your <w>social</w> to strangers over the phone.",
                            "target_lang_translations": {
                                "ru": "Никогда не следует сообщать свой <w>но́мер социа́льного страхова́ния</w> незнакомцам по телефону.",
                                "zh": "你不应该在电话里把<w>社会安全号码</w>告诉陌生人。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "US"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "short for social security number"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Номер социального страхования.",
                        "zh": "社会安全号码（美国）。"
                    },
                    "translations": {
                        "ru": [
