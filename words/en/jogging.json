{
    "word_family": [
        "jog",
        "jogger"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "08e95f34-8d53-3d03-9f0d-2fd972b72838",
                    "sense_definition": "The activity or exercise of running at a slow, regular pace.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided that regular <w>jogging</w> in the park was the best way to stay fit.",
                            "target_lang_translations": {
                                "cs": "Rozhodla se, že pravidelné <w>běhání</w> v parku je nejlepší způsob, jak zůstat v kondici."
                            }
                        },
                        {
                            "text": "Every morning, he puts on his running shoes and goes <w>jogging</w> before breakfast.",
                            "target_lang_translations": {
                                "cs": "Každé ráno si obuje běžecké boty a jde si před snídaní <w>zaběhat</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "go jogging",
                        "morning jogging"
                    ],
                    "target_lang_definitions": {
                        "cs": "Aktivita nebo cvičení spočívající v pomalém, pravidelném běhu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "jogging",
                                "target_lang_sense_clarification": "kondiční běh"
                            },
                            {
                                "target_lang_word": "kondiční běh",
                                "target_lang_sense_clarification": "sportovní aktivita"
                            },
                            {
                                "target_lang_word": "běhání",
                                "target_lang_sense_clarification": "rekreační běh"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb704281-ecfb-30cb-9123-3b1caf1018fb",
                    "sense_definition": "The act of giving a slight push, shake, or nudge, often used figuratively to stimulate memory.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His gentle <w>jogging</w> of my memory helped me recall what happened that day.",
                            "target_lang_translations": {
                                "cs": "Jeho jemné <w>osvěžení</w> mé paměti mi pomohlo vzpomenout si, co se ten den stalo."
                            }
                        },
                        {
                            "text": "A slight <w>jogging</w> of the table caused the glass of water to spill.",
                            "target_lang_translations": {
                                "cs": "Mírné <w>drcnutí</w> do stolu způsobilo, že se vylila sklenice s vodou."
                            }
                        }
                    ],
                    "synonyms": [
                        "nudge",
                        "prompting"
                    ],
                    "common_phrases": [
                        "jogging of memory"
                    ],
                    "target_lang_definitions": {
                        "cs": "Lehké strčení, zatřesení nebo pošťouchnutí, často používané obrazně k osvěžení paměti."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "osvěžení",
                                "target_lang_sense_clarification": "např. paměti"
                            },
                            {
                                "target_lang_word": "pošťouchnutí",
                                "target_lang_sense_clarification": "lehké popohnání nebo postrčení"
                            },
                            {
                                "target_lang_word": "drrcnutí",
                                "target_lang_sense_clarification": "lehký náraz či zatřesení"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4bcac0a4-cf52-32c4-b474-5d58ad7867f5",
                    "sense_definition": "Present participle of <w>jog</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>jogging</w> down the street when he noticed an injured bird.",
                            "target_lang_translations": {
                                "cs": "Zrovna <w>klusal</w> po ulici, když si všiml zraněného ptáka."
                            }
                        },
                        {
                            "text": "I saw them <w>jogging</w> together along the river path yesterday afternoon.",
                            "target_lang_translations": {
                                "cs": "Včera odpoledne jsem je viděl společně <w>běhat</w> po stezce podél řeky."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Přítomné příčestí (tvar na -ing) slovesa jog; běhat kondičním tempem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "běžet",
                                "target_lang_sense_clarification": "pomalu, kondičně"
                            },
                            {
                                "target_lang_word": "klusat",
                                "target_lang_sense_clarification": "volně běžet"
                            },
                            {
                                "target_lang_word": "běhat",
                                "target_lang_sense_clarification": "věnovat se běhu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}