                                        "examples": [
                                            {
                                                "example_id": "0b3fbcdc-816f-46ee-aa8f-03ddd4e663c3",
                                                "sense_id": "a41e4635-2609-3fdf-8725-1238227c6a17",
                                                "text": "…cette lettre contient ainsi de simples dispositions précatives et ne constitue donc pas un testament."
