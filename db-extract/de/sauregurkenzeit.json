                        "target_lang_word": "morte-saison",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "morte-saison",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "75abc071-4ec2-39dc-b2ed-011a2d975600",
                                        "entry_id": "c3b0beba-4f76-3f90-84d1-7fa5c6b4db63",
                                        "glosses": [
                                            "Temps où la terre ne produit rien."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c302a2ca-8b97-3023-a234-bb9cb8dff01e",
                                        "entry_id": "c3b0beba-4f76-3f90-84d1-7fa5c6b4db63",
                                        "glosses": [
                                            "Époque de l’année où, dans certaines professions, on a moins de travail, moins de débit qu’à l’ordinaire."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "419905f3-37ac-47ff-9a92-b3fc8e4dda18",
                                                "sense_id": "c302a2ca-8b97-3023-a234-bb9cb8dff01e",
                                                "text": "Pendant la morte-saison, le père sculptait dans la corne des edelweiss et des chamois pour les marchands de souvenirs de Chamonix, simple appoint."
                                            },
                                            {
                                                "example_id": "a37cff8a-9a8e-4867-ad11-677ea9d0bac9",
                                                "sense_id": "c302a2ca-8b97-3023-a234-bb9cb8dff01e",
                                                "text": "L’été est la morte-saison des fourreurs."
                                            },
                                            {
                                                "example_id": "d32af434-8e14-4f57-a20c-0f2d86512a2b",
                                                "sense_id": "c302a2ca-8b97-3023-a234-bb9cb8dff01e",
                                                "text": "Nous tournâmes à Treblinka en toutes saisons, les quatre saisons de la mort (il y eut même à Treblinka, selon Richard Glazar, ce que les détenus appelèrent « la morte-saison », « die Flaute », quand les convois pour un temps n’arrivèrent pas), et je fis recommencer vingt fois ce zoom avant, tellement je voulais habiter le regard de ceux qui allaient mourir."
                                            },
                                            {
                                                "example_id": "0b2bf668-844a-40bd-b7d2-c9f5052e546b",
                                                "sense_id": "c302a2ca-8b97-3023-a234-bb9cb8dff01e",
                                                "text": "Comment imaginer que Rome, il y a un siècle et demi, a connu le genre de silence qui est encore celui des quartiers excentriques de Venise à la morte-saison ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
