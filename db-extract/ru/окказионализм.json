                    {
                        "translation_id": "f29475e8-a5a6-4cf7-b945-aaa0cecaa440",
                        "source_entry_id": "49c94981-afdc-366e-8970-04590722dadb",
                        "source_sense_description": "философское течение",
                        "target_lang_word": "Okkasionalismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Okkasionalismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4db251e3-47bc-3a53-b37e-6d5bf2fc65b1",
                                        "entry_id": "fd0f2321-295c-3a31-ba61-6787483f1e92",
                                        "glosses": [
                                            "neu gebildetes Wort, aus einer speziellen Situation heraus, das noch nicht zum Wortschatz der Sprache gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51c32b7c-9ff3-4f4e-b779-a15c1f7cb248",
                                                "sense_id": "4db251e3-47bc-3a53-b37e-6d5bf2fc65b1",
                                                "text": "„Doch bei Beachtung aller dieser Erscheinungen in der Breite des Spektrums ist im heutigen Annoncenstil eine Zunahme an Okkasionalismen festzustellen.“"
                                            },
                                            {
                                                "example_id": "7b2bcd74-4d89-42b2-a367-53566cb5f702",
                                                "sense_id": "4db251e3-47bc-3a53-b37e-6d5bf2fc65b1",
                                                "text": "„Zu Veränderungen im Wortschatz, in der Regel zu einer Erweiterung, kommt es, wenn der vorhandene Lexembestand nicht mehr ausreicht, um bestimmte kommunikative Bedürfnisse zu befriedigen, die durch gesellschaftliche Veränderungen im weitesten Sinne ausgelöst worden sind, das heißt das Aufkommen neuer Lexeme sowie neuer Bedeutungen etablierter Lexeme, auch von Okkasionalismen, also Gelegenheitsbildungen ist - ähnlich wie das vergleichsweise unauffällige Verschwinden von Lexemen - Ausdruck für die Anpassung des Wortschatzes an neue Gegebenheiten und Sachverhalte und unbedingt notwendig für eine funktionierende sprachliche Verständigung.“"
                                            },
                                            {
                                                "example_id": "3be7632d-2230-49cb-9732-ee1cbc286afd",
                                                "sense_id": "4db251e3-47bc-3a53-b37e-6d5bf2fc65b1",
                                                "text": "„Bei den Historismen (Bezeichnungen für eine Sache, die es nicht mehr gibt, vgl. »Ablasshandel«) und Archaismen (Bezeichnungen, die – jedenfalls mit ihren alten Bedeutungen – kaum noch verwendet werden, von anderen abgelöst worden sind) handelt es sich sehr oft, bei den Okkasionalismen und Neologismen nahezu immer um komplexe Wörter, also um mehrmorphemige Wortbildungsprodukte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
