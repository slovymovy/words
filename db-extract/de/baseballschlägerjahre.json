                "senses": [
                    {
                        "sense_id": "37983650-9837-38bc-b75d-da4baec1f44f",
                        "entry_id": "7ef2aa16-fde7-3358-a5b1-0207437797fa",
                        "glosses": [
                            "The post-German reunification period of the early 1990s, especially in former East Germany, marked by widespread violence and intimidation by neo-Nazis."
                        ],
                        "tags": [
                            "German",
                            "definite",
                            "informal",
                            "plural",
                            "plural-only",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "77e3a9f3-5528-4c7f-9281-e22610fea119",
                                "sense_id": "37983650-9837-38bc-b75d-da4baec1f44f",
                                "text": "Die Baseballschlägerjahre haben ihre Spuren auch in den Köpfen jener hinterlassen, die heute keiner rechten Gruppierung angehören.",
                                "translation": "The Baseball Bat Years have had a lasting influence in the minds of those who are not part of any right-wing group today.",
                                "english": "The Baseball Bat Years have had a lasting influence in the minds of those who are not part of any right-wing group today."
                            },
                            {
                                "example_id": "0dcde434-c9a0-4730-95a6-299113ad9c34",
                                "sense_id": "37983650-9837-38bc-b75d-da4baec1f44f",
                                "text": "Dabei stehen die Ortsnamen als Chiffren pars pro toto für die Gewalt, die sich dort ereignete: Hoyerswerda, Rostock-Lichtenhagen, Mölln und Solingen symbolisieren die ‚Baseballschlägerjahre‘, die eskalative Verdichtung rechtsmotivierter Gewalt in der ersten Hälfte der 1990er Jahre.",
                                "translation": "The names of towns serve as chiffres, standing in pars pro toto for the violence that occurred there: Hoyerswerda, Rostock-Lichtenhagen, Mölln and Solingen symbolize the 'Baseball Bat Years', the escalatory intensification of rightwing-motivated violence of the first half of the 1990s.",
                                "english": "The names of towns serve as chiffres, standing in pars pro toto for the violence that occurred there: Hoyerswerda, Rostock-Lichtenhagen, Mölln and Solingen symbolize the 'Baseball Bat Years', the escalatory intensification of rightwing-motivated violence of the first half of the 1990s."
                            }
                        ]
