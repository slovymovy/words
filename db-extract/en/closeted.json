                ],
                "senses": [
                    {
                        "sense_id": "a41908e8-4f19-3962-8bb4-d8a7dd0c2f77",
                        "entry_id": "148356cd-b2bd-37a0-bf1d-8d7f5126c32b",
                        "glosses": [
                            "Not open about one's sexual orientation, romantic orientation, or gender identity."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "5af1bc53-f8fd-4f85-980e-18fc33dcf6e1",
                                "sense_id": "a41908e8-4f19-3962-8bb4-d8a7dd0c2f77",
                                "text": "Sally Gearhart, an ex-christian from Illinois who in the early seventies abandoned closeted lesbianism on Midwestern church college faculties for radical feminism in San Francisco,"
                            },
                            {
                                "example_id": "daee8ec0-87c4-4101-9ec4-47df719f9ac9",
                                "sense_id": "a41908e8-4f19-3962-8bb4-d8a7dd0c2f77",
                                "text": "1992, Tony Kushner, Angels in America: A Gay Fantasia on National Themes, New York: Theatre Communications Group, 1995, Part Two: Perestroika, Act One, Scene 4, p. 156,\nBelize: Get out your oven mitts. Guess who just checked in with the troubles? The Killer Queen Herself. New York's number one closeted queer."
                            }
                        ]
                    },
                    {
                        "sense_id": "83c4d373-a7ff-3c6c-8778-2d7d1d193bc2",
                        "entry_id": "148356cd-b2bd-37a0-bf1d-8d7f5126c32b",
                        "glosses": [
                            "Not open about some aspect of one's identity, tendency, or fondness; secret."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "41c4c5fd-b2c5-40bf-a35d-55549836b0b7",
                                "sense_id": "83c4d373-a7ff-3c6c-8778-2d7d1d193bc2",
                                "text": "[…] the remaining quotations, chiefly from English poetry, interested me only slightly more. They were the elegiac favourites of a closeted Romantic."
                            },
                            {
                                "example_id": "1395883b-eab1-4cec-a21c-2b26f9f3d82d",
                                "sense_id": "83c4d373-a7ff-3c6c-8778-2d7d1d193bc2",
                                "text": "Now he feels a connection between his own closeted, esoteric sufferings and strivings and those of the poor urban working people all around him."
                            },
                            {
                                "example_id": "1728a1d3-9b2d-4231-b60d-9076183b8ea2",
                                "sense_id": "83c4d373-a7ff-3c6c-8778-2d7d1d193bc2",
                                "text": "Sokolsky asks if he realizes that this is a walk-in clinic for closeted reality benders, and he's a disaster-response coordinator, not a therapist."
                            }
                        ]
                    }
                ],
