                        "entry_id": "72c4248b-7c90-3e86-bab3-e45817f1ce9c",
                        "glosses": [
                            "Qui se rapporte à Valéry Giscard d’Estaing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85fb530b-6611-4ea6-87a3-6c8b19cd1c97",
                                "sense_id": "638212a6-bc7a-3524-860a-9ddcec159fc9",
                                "text": "Pouvoir giscardien."
                            },
                            {
                                "example_id": "70362c77-5fb7-432f-99ee-e9d4cda6b0df",
                                "sense_id": "638212a6-bc7a-3524-860a-9ddcec159fc9",
                                "text": "En 1974, dans la France giscardienne, elle posait largement dépoitraillée, un collier de perles pour toute parure, lovée dans un haut fauteuil de rotin d’inspiration tahitienne."
                            }
                        ]
                    },
                    {
                        "sense_id": "58c0db15-07ca-3404-9234-66049773a526",
                        "entry_id": "72c4248b-7c90-3e86-bab3-e45817f1ce9c",
                        "glosses": [
                            "Qui est un partisan de Valéry Giscard d’Estaing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "351500a0-3018-45f8-9ac0-b9cf301fe098",
                                "sense_id": "58c0db15-07ca-3404-9234-66049773a526",
                                "text": "Un député giscardien."
                            },
                            {
                                "example_id": "198b96d3-3704-46e2-8da3-c0defe28dc13",
                                "sense_id": "58c0db15-07ca-3404-9234-66049773a526",
                                "text": "Alain Duhamel incarne mieux que quiconque cette élite omniprésente. Giscardien, barriste, puis balladurien, jospinien demain s’il le faut, il préside le comité éditorial d'Europe 1."
                            }
                        ]
                    }
