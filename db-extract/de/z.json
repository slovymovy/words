                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90309fd9-0c05-4209-8532-f677ebe41432",
                                                "sense_id": "fed48ab2-eea7-3b8b-abfd-c2caf7071b39",
                                                "text": "I can sell bricks, I don't need to rap\nBuj so peng it makes the fiends collapse\nCook that coca into crack\nI was selling Zs while you was in your bed"
                                            }
                                        ]
                                    }
                                ]
