                        "entry_id": "e53bb3af-f151-3880-b4d9-fc91ea00009a",
                        "glosses": [
                            "Any of various medium-sized water birds of the genus Gallinula, of the rail family, that feed in open water margins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af679d01-63b1-4d0a-88e1-2778007c02c7",
                                "sense_id": "24b42ad9-8c0b-309a-beb0-2138b26bee88",
                                "text": "The pond was another favourite place to visit. Moorhens strutted from the neighbouring bushes, and a bevy of Muscovy ducks, a study in black, white and red, waddled from the farmyard hard by to enjoy a refreshing splash."
                            }
                        ]
