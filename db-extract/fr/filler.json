        "fr-extract.jsonl": [
            {
                "entry_id": "4a3887db-f01b-3bd9-b426-74eb35701163",
                "word": "filler",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "19eeaeb2-b73c-4b25-bbbd-d217efc9c69f",
                        "entry_id": "4a3887db-f01b-3bd9-b426-74eb35701163",
                        "tags": [
                            "plural"
                        ],
                        "form": "fillers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e44cb8a4-8c66-315c-affa-21b46b420a8f",
                        "entry_id": "4a3887db-f01b-3bd9-b426-74eb35701163",
                        "glosses": [
                            "Granulat composé d’éléments de très petites dimensions (≤ 0,08 mm) utilisé soit comme charge de remplissage pour augmenter la compacité notamment d’un béton, d’un sol, soit comme constituant de certains liants hydrauliques (ciments) pour en prolonger le temps ouvrable, soit comme agent de rigidification des mélanges bitumineux."
                        ],
                        "tags": [
                            "Matériaux de construction"
                        ],
                        "examples": [
                            {
                                "example_id": "1d872286-1e22-4a8c-b50b-feebb66f4bb6",
                                "sense_id": "e44cb8a4-8c66-315c-affa-21b46b420a8f",
                                "text": "En 1975, G.SUSS de la Technische Hochschule de Darmstadt, a repris l’étude de l’influence de la taille des particules de filler sur la rhéologie des mélanges filler-liant."
                            },
                            {
                                "example_id": "df449bcb-94b5-418b-9c1d-7d9868edcd4e",
                                "sense_id": "e44cb8a4-8c66-315c-affa-21b46b420a8f",
                                "text": "Les trois dernières statistiques représentent les publications qui se focalisent sur les propriétés des fillers et de leur influence sur le comportement d’une matrice cimentaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "fea83e9b-f5b7-3ee3-bf68-c3ee7391f5a0",
                        "entry_id": "4a3887db-f01b-3bd9-b426-74eb35701163",
                        "glosses": [
                            "Épisode d’anime n’appartenant pas à la trame du manga d’origine."
                        ],
                        "tags": [
                            "Animation"
                        ],
                        "examples": [
                            {
                                "example_id": "bb653ad9-a39f-4509-b410-70776ec866cb",
                                "sense_id": "fea83e9b-f5b7-3ee3-bf68-c3ee7391f5a0",
                                "text": "Les épisodes 136 à 220 de Naruto sont des fillers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23a501cf-a28b-4289-9e9c-4c8673c1ba3c",
                        "source_entry_id": "4a3887db-f01b-3bd9-b426-74eb35701163",
                        "source_sense_description": "Matériau",
                        "target_lang_word": "filler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "filler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e905748-7e0a-3747-b2fd-82dca82bf75f",
                                        "entry_id": "d4f1565d-714a-30ec-a9d9-0639bbb9c8fc",
                                        "glosses": [
                                            "One who fills."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29793cc7-a60e-4fb1-8440-0cec3d517820",
                                                "sense_id": "0e905748-7e0a-3747-b2fd-82dca82bf75f",
                                                "text": "They commonly have three, four, five, or six hewers or diggers, to four fillers, so as to keep the fillers always at work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68db5427-2fa3-358e-bd0a-a3acb21d2c66",
                                        "entry_id": "d4f1565d-714a-30ec-a9d9-0639bbb9c8fc",
                                        "glosses": [
                                            "Something added to fill a space or add weight or size."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e63783e3-c673-475f-96c2-d9a68ad869fb",
                                                "sense_id": "68db5427-2fa3-358e-bd0a-a3acb21d2c66",
                                                "text": "I recommend this album in the face of the fact that five of the eleven songs are the purest filler, dull instrumentals with a harmonica rifling over an indifferent rhythm section. The rest is magnificent[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21817389-dd38-3afa-bd4b-f004f3a050e3",
                                        "entry_id": "d4f1565d-714a-30ec-a9d9-0639bbb9c8fc",
                                        "glosses": [
                                            "Any semisolid substance used to fill gaps, cracks or pores."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eaf56c71-3c9a-373b-87e4-eb086bddff15",
                                        "entry_id": "d4f1565d-714a-30ec-a9d9-0639bbb9c8fc",
                                        "glosses": [
                                            "A dermal filler, a substance injected beneath the skin to restore lost volume."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2799c457-2cc5-4d37-819c-70ee47acf6a7",
                                                "sense_id": "eaf56c71-3c9a-373b-87e4-eb086bddff15",
                                                "text": "A 50-year-old patient will come in, and suddenly, she’s super-skinny and needs filler, which she never needed before."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2e6ae39-0ea6-3f0a-8924-fb3e79fb086d",
                                        "entry_id": "d4f1565d-714a-30ec-a9d9-0639bbb9c8fc",
                                        "glosses": [
                                            "A relatively inert ingredient added to modify physical characteristics; a bulking agent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38c2436b-543a-4703-b419-af072ac0b102",
                                                "sense_id": "a2e6ae39-0ea6-3f0a-8924-fb3e79fb086d",
                                                "text": "The word \"filler\" is taboo in the excipient world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9573be48-e1bf-3910-9e9e-3c2b4fd065e4",
                                        "entry_id": "d4f1565d-714a-30ec-a9d9-0639bbb9c8fc",
                                        "glosses": [
                                            "A short article in a newspaper or magazine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cdfb04d3-fbbc-3dd1-8311-83a235cf5dd5",
                                        "entry_id": "d4f1565d-714a-30ec-a9d9-0639bbb9c8fc",
                                        "glosses": [
                                            "A short piece of music or an announcement between radio or TV programmes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0103858e-453d-348a-b2c4-057a2063bb97",
                                        "entry_id": "d4f1565d-714a-30ec-a9d9-0639bbb9c8fc",
                                        "glosses": [
                                            "Any spoken sound or word used to fill gaps in speech; filled pause."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a20764f-3859-4725-b79a-ccf2c5c88916",
                                                "sense_id": "0103858e-453d-348a-b2c4-057a2063bb97",
                                                "text": "'Tis a meer filler; to ſtop a vacancy in the Hexameter, and connect the Preface to the Work of Virgil."
                                            },
                                            {
                                                "example_id": "7c75deff-6c28-4c3e-9a48-816c0ff3826f",
                                                "sense_id": "0103858e-453d-348a-b2c4-057a2063bb97",
                                                "text": "As the years go by, speech reverts to childhood levels of disfluency, with more pauses, more errors, more repeated words, but even the peak years are not great: up to 8 percent of the average person’s word output consists of meaningless fillers and placeholders like um, uh and er."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2c5c89d-a2cb-303f-bef4-52a11b3fe565",
                                        "entry_id": "d4f1565d-714a-30ec-a9d9-0639bbb9c8fc",
                                        "glosses": [
                                            "Cut tobacco used to make up the body of a cigar."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0a929418-52ff-300d-b164-07be4509ed70",
                                        "entry_id": "d4f1565d-714a-30ec-a9d9-0639bbb9c8fc",
                                        "glosses": [
                                            "In COBOL, the description of an unnamed part of a record that contains no data relevant to a given context (normally capitalised when in a data division)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e5c6954e-b626-315a-9908-d95e2c01d424",
                                        "entry_id": "d4f1565d-714a-30ec-a9d9-0639bbb9c8fc",
                                        "glosses": [
                                            "A plant that lacks a distinctive shape and can fill inconvenient spaces around other plants in pots or gardens."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8d4bbfc8-bfe5-3fd5-9dfe-443653dd9dd6",
                                        "entry_id": "d4f1565d-714a-30ec-a9d9-0639bbb9c8fc",
                                        "glosses": [
                                            "Any standing tree or standard higher than the surrounding coppice in the form of forest known as \\\"coppice under standards\\\"."
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "228ad964-560f-3f9d-a55d-5b3c6ae4704d",
                                        "entry_id": "d4f1565d-714a-30ec-a9d9-0639bbb9c8fc",
                                        "glosses": [
                                            "material of lower cost or quality that is used to fill a certain television time slot or physical medium, such as a music album"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
