                "translations": [
                    {
                        "translation_id": "5bb5f19f-aabd-4f8e-a20d-1ce15b83979a",
                        "source_entry_id": "5f9a5c78-4e95-3ca8-94a9-0e0b960d3c7b",
                        "target_lang_word": "enfler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enfler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4a65886b-c473-34fa-a0e7-424a6d5dc5a7",
                                        "entry_id": "5bff0884-f2f9-3d8a-8889-c7e468df7459",
                                        "glosses": [
                                            "Augmenter un corps de volume ; gonfler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "054ee5b6-ac0a-4941-a762-5a63c4e141e5",
                                                "sense_id": "4a65886b-c473-34fa-a0e7-424a6d5dc5a7",
                                                "text": "Et fermant la marche, quelques ecclésiastiques en retard se hâtaient, saisissant d’une main leurs robes qui s’enflaient comme des ballons, […]."
                                            },
                                            {
                                                "example_id": "44cd91c1-9682-4308-9adb-0016ecf86354",
                                                "sense_id": "4a65886b-c473-34fa-a0e7-424a6d5dc5a7",
                                                "text": "Enfler un ballon."
                                            },
                                            {
                                                "example_id": "25210867-f4c9-45a8-a5d7-9b0722bd01a7",
                                                "sense_id": "4a65886b-c473-34fa-a0e7-424a6d5dc5a7",
                                                "text": "Enfler une cornemuse."
                                            },
                                            {
                                                "example_id": "beee6b11-548d-44be-ad31-c15a38b2d4a7",
                                                "sense_id": "4a65886b-c473-34fa-a0e7-424a6d5dc5a7",
                                                "text": "Enfler ses joues."
                                            },
                                            {
                                                "example_id": "0d7c4d7b-4908-4dbe-a938-30eabc07c1f1",
                                                "sense_id": "4a65886b-c473-34fa-a0e7-424a6d5dc5a7",
                                                "text": "Les pluies ont enflé la rivière."
                                            },
                                            {
                                                "example_id": "cc726721-0815-421f-abed-7ad12567e1c5",
                                                "sense_id": "4a65886b-c473-34fa-a0e7-424a6d5dc5a7",
                                                "text": "La rivière s’enfle."
                                            },
                                            {
                                                "example_id": "1c406543-9f2e-4732-9c4c-282898ff2112",
                                                "sense_id": "4a65886b-c473-34fa-a0e7-424a6d5dc5a7",
                                                "text": "L’hydropisie enfle le corps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f162227-72c5-343d-b7c6-e6820e232087",
                                        "entry_id": "5bff0884-f2f9-3d8a-8889-c7e468df7459",
                                        "glosses": [
                                            "Augmenter d'intensité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efe3abd1-0950-4b9c-a227-1d2164417bd7",
                                                "sense_id": "4f162227-72c5-343d-b7c6-e6820e232087",
                                                "text": "Après avoir laissé derrière nous les Orcades, nous entrâmes en plein Atlantique, et la mer s’enfla prodigieusement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1c5c911-3ec1-3b40-b78d-b8be225ae22f",
                                        "entry_id": "5bff0884-f2f9-3d8a-8889-c7e468df7459",
                                        "glosses": [
                                            "Frapper et déployer en parlant du vent dans les voiles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee3c6fa1-33b3-4300-82f7-53f4c4b9adb2",
                                                "sense_id": "e1c5c911-3ec1-3b40-b78d-b8be225ae22f",
                                                "text": "Le vent enflait nos voiles."
                                            },
                                            {
                                                "example_id": "c318b0c7-c3f7-4797-a4a4-ad1dc9cfbd90",
                                                "sense_id": "e1c5c911-3ec1-3b40-b78d-b8be225ae22f",
                                                "text": "La voile s’enfle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46093277-bb5d-3710-9d07-4293b7d9a975",
                                        "entry_id": "5bff0884-f2f9-3d8a-8889-c7e468df7459",
                                        "glosses": [
                                            "Augmenter, exalter."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6be7336-ba94-4ed5-b18b-ffff0fb0424c",
                                                "sense_id": "46093277-bb5d-3710-9d07-4293b7d9a975",
                                                "text": "Cela lui a enflé le courage."
                                            },
                                            {
                                                "example_id": "7ccfbc17-c17b-4863-9094-d496bfe44bdd",
                                                "sense_id": "46093277-bb5d-3710-9d07-4293b7d9a975",
                                                "text": "Enfler les espérances de quelqu’un."
                                            },
                                            {
                                                "example_id": "84471f9f-9f40-46a3-989a-d1e6164a1030",
                                                "sense_id": "46093277-bb5d-3710-9d07-4293b7d9a975",
                                                "text": "La bande descendait avec un élan superbe, irrésistible. Rien de plus terriblement grandiose que l’irruption de ces quelques milliers d’hommes dans la paix morte et glacée de l’horizon. La route, devenue torrent, roulait des flots vivants qui semblaient ne pas devoir s’épuiser ; toujours, au coude du chemin, se montraient de nouvelles masses noires, dont les chants enflaient de plus en plus la grande voix de cette tempête humaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b0d2a86-73e0-33f4-9afb-0ffe9a24854b",
                                        "entry_id": "5bff0884-f2f9-3d8a-8889-c7e468df7459",
                                        "glosses": [
                                            "Rendre ampoulé, en parlant du style d’un écrivain, d’un orateur."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c16157e-20d7-4ae4-bb77-ec87f93e4c3b",
                                                "sense_id": "4b0d2a86-73e0-33f4-9afb-0ffe9a24854b",
                                                "text": "Et sa voix alors prenait une intonation dolente et uniforme, enflant les mots, appuyant indéfiniment sur les syllabes. Cela m’agaçait beaucoup."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d17b9bc-9fec-3abb-86e5-b849533ccc81",
                                        "entry_id": "5bff0884-f2f9-3d8a-8889-c7e468df7459",
                                        "glosses": [
                                            "Mettre des choses inutiles dans les rôles, dans les minutes, afin de les grossir."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b063aa2e-fbf6-4550-a16e-6823e9cb9f90",
                                                "sense_id": "4d17b9bc-9fec-3abb-86e5-b849533ccc81",
                                                "text": "Enfler le cahier, enfler les rôles, pour être rémunéré sur un plus grand nombre de pages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cf3949a-f58f-33ad-8e69-0c9e5afee29e",
                                        "entry_id": "5bff0884-f2f9-3d8a-8889-c7e468df7459",
                                        "glosses": [
                                            "Augmenter artificiellement un compte, des dépenses, un prix, pour contrefaire un bilan ou gruger un client."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3c68ecf-3638-4e94-93bc-457f8cdc7a12",
                                                "sense_id": "1cf3949a-f58f-33ad-8e69-0c9e5afee29e",
                                                "text": "Enfler la dépense."
                                            },
                                            {
                                                "example_id": "ca31ed50-d52d-41ac-bd85-6d1d266b1521",
                                                "sense_id": "1cf3949a-f58f-33ad-8e69-0c9e5afee29e",
                                                "text": "Enfler un mémoire, un compte*"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b3130d1-42ae-39e6-b0e3-fadf38244dd8",
                                        "entry_id": "5bff0884-f2f9-3d8a-8889-c7e468df7459",
                                        "glosses": [
                                            "Emplir de vanité, d’orgueil."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fec7da72-d572-4c4e-8960-6395e40101af",
                                                "sense_id": "2b3130d1-42ae-39e6-b0e3-fadf38244dd8",
                                                "text": "Il est enflé de son succès."
                                            },
                                            {
                                                "example_id": "e3a16523-b681-4299-8c70-6f8d70c3d3b5",
                                                "sense_id": "2b3130d1-42ae-39e6-b0e3-fadf38244dd8",
                                                "text": "Il s’enfle d’orgueil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "252ca4b9-5590-3ffa-a40a-5b83e0d5adcd",
                                        "entry_id": "5bff0884-f2f9-3d8a-8889-c7e468df7459",
                                        "glosses": [
                                            "Arnaquer, duper."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "024b9065-3303-4ad5-9ca7-c65d07c5cd82",
                                                "sense_id": "252ca4b9-5590-3ffa-a40a-5b83e0d5adcd",
                                                "text": "J’ai bien peur que tu te sois fait complètement enfler."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a38904e6-0faf-3351-b772-d2d518ea3534",
                                        "entry_id": "5bff0884-f2f9-3d8a-8889-c7e468df7459",
                                        "glosses": [
                                            "S’augmenter de volume."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad15f236-f699-4e96-ade2-fe51c7c6b90f",
                                                "sense_id": "a38904e6-0faf-3351-b772-d2d518ea3534",
                                                "text": "Ses doigts malhabiles, enflés par la goutte, lui obéissaient très mal."
                                            },
                                            {
                                                "example_id": "be38c32a-6005-46ee-b9c1-46503e2eeec5",
                                                "sense_id": "a38904e6-0faf-3351-b772-d2d518ea3534",
                                                "text": "La rivière enfle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec505c91-ce19-3831-8771-c042a5649f49",
                                        "entry_id": "5bff0884-f2f9-3d8a-8889-c7e468df7459",
                                        "glosses": [
                                            "Mettre une femme enceinte."
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38aefe5f-fbe5-4078-8672-d9a6a2317b79",
                        "source_entry_id": "5f9a5c78-4e95-3ca8-94a9-0e0b960d3c7b",
                        "target_lang_word": "gonfler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gonfler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ccdcc880-c247-3f54-9126-fab4d13ed508",
                                        "entry_id": "145331dd-4619-3048-ba60-ce4b830cd9e8",
                                        "glosses": [
                                            "Augmenter quelque chose de volume en la remplissant de gaz ou d’un fluide ; faire saillir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9eb25ee4-a292-40a4-a0d9-51e5256c8d82",
                                                "sense_id": "ccdcc880-c247-3f54-9126-fab4d13ed508",
                                                "text": "Cette chair bleue qui gonflait, cette sanie malodorante qui coulait…"
                                            },
                                            {
                                                "example_id": "62862ff4-3148-44b1-b2f6-2c8735766be1",
                                                "sense_id": "ccdcc880-c247-3f54-9126-fab4d13ed508",
                                                "text": "L'hiver dernier, ça a gelé dur, très dur, la terre a gonflé et les pavés sont remontés comme des dents qui se déchaussent."
                                            },
                                            {
                                                "example_id": "71cd2166-60fd-4512-8d27-e6cb9212f1cb",
                                                "sense_id": "ccdcc880-c247-3f54-9126-fab4d13ed508",
                                                "text": "Le vent gonfle les voiles. — La pluie gonfle les torrents. — La bière m’a gonflé l’estomac."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90aacf22-5f04-3bf0-93cc-978c4b56363d",
                                        "entry_id": "145331dd-4619-3048-ba60-ce4b830cd9e8",
                                        "glosses": [
                                            "Augmenter fortement et de manière anormale."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "317d4e4b-63b0-4277-84fd-85c936e1d8be",
                                                "sense_id": "90aacf22-5f04-3bf0-93cc-978c4b56363d",
                                                "text": "Ce tour de passe-passe mathématique n’a d’autre but que de gonfler les statistiques de fréquentation de son blogue."
                                            },
                                            {
                                                "example_id": "9cd4374c-05a2-4e38-9999-7f634dad6cbf",
                                                "sense_id": "90aacf22-5f04-3bf0-93cc-978c4b56363d",
                                                "text": "Cette mesure est accusée de gonfler encore davantage le taux de chômage."
                                            },
                                            {
                                                "example_id": "65810574-a777-4ac9-b72d-73ee64bbd876",
                                                "sense_id": "90aacf22-5f04-3bf0-93cc-978c4b56363d",
                                                "text": "Pour toute réponse, l'intrus ferma un œil, et gonfla sa joue avec le bout de sa langue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f93ff664-0c51-3198-82f3-d08ace3e5a5a",
                                        "entry_id": "145331dd-4619-3048-ba60-ce4b830cd9e8",
                                        "glosses": [
                                            "Remplir le cœur ou la poitrine d’un sentiment."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83c1e6eb-9c8a-4a4c-a87c-43fb745b974b",
                                                "sense_id": "f93ff664-0c51-3198-82f3-d08ace3e5a5a",
                                                "text": "Les Lettres à l’Étrangère, […] malgré cette jactance énorme, qui le fait se gonfler jusqu’à la bouffonnerie, sont le plus émouvant, le plus angoissant martyrologe qui se puisse imaginer d’une vie d’artiste, […]"
                                            },
                                            {
                                                "example_id": "c233c6a4-bfb3-4ea1-be0f-3b0721e86d81",
                                                "sense_id": "f93ff664-0c51-3198-82f3-d08ace3e5a5a",
                                                "text": "Et tous de le flatter, et de l’entourer d’une cour dont il ne peut être dupe, mais dont se gonfle sa vanité."
                                            },
                                            {
                                                "example_id": "7bded2d0-fd23-49c0-b733-488bf18487b2",
                                                "sense_id": "f93ff664-0c51-3198-82f3-d08ace3e5a5a",
                                                "text": "Le départ de son fils lui a gonflé le cœur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3874bdcb-d6b2-3d5a-a281-29d54afa5f14",
                                        "entry_id": "145331dd-4619-3048-ba60-ce4b830cd9e8",
                                        "glosses": [
                                            "Agacer ; exaspérer."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "338291cc-93e0-4a84-9383-4c57258b943e",
                                                "sense_id": "3874bdcb-d6b2-3d5a-a281-29d54afa5f14",
                                                "text": "Épuisée par une semaine harassée, j’entrai dans une rage terrible : « Mais tu me fais chier, je vais te dire, tu me gonfles, tu m’emmerdes, comme si j’avais que ça à foutre ! »"
                                            },
                                            {
                                                "example_id": "20ae480d-6ee0-47d5-8da1-caa1714ae782",
                                                "sense_id": "3874bdcb-d6b2-3d5a-a281-29d54afa5f14",
                                                "text": "Stan, qu'est-ce qu'il a pu me gonfler avec son tajine ! Et Vince, et sa fixette sur un gros poulet-frites. Moi, toutes ces années, je suis resté québlo sur le grec."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8a27bcd-5f8f-33dc-b97b-be16ddd26c99",
                                        "entry_id": "145331dd-4619-3048-ba60-ce4b830cd9e8",
                                        "glosses": [
                                            "Transformer une image, un film pour le mettre dans un format supérieur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b361b024-6ec6-456f-8bb6-630337e24ba9",
                                                "sense_id": "f8a27bcd-5f8f-33dc-b97b-be16ddd26c99",
                                                "text": "On gonfle pour permettre à des films réalisés avec des technologies moins onéreuses que le 35mm d’exister au final sur un support 35mm, afin de pouvoir suivre une exploitation commerciale normale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11d8980a-11bb-3263-979d-fc197ccd4db5",
                                        "entry_id": "145331dd-4619-3048-ba60-ce4b830cd9e8",
                                        "glosses": [
                                            "Augmenter de volume, enfler."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "caff2028-ded0-49b1-9df9-8dc4eb4abd30",
                                                "sense_id": "11d8980a-11bb-3263-979d-fc197ccd4db5",
                                                "text": "J’ai le ventre qui a gonflé, c’est la bière !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53322315-07f1-338c-adb1-ce8a90bdc0df",
                                        "entry_id": "145331dd-4619-3048-ba60-ce4b830cd9e8",
                                        "glosses": [
                                            "Augmenter de volume, enfler."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a99ec3ad-efa2-4567-8f28-5244e515a46e",
                                                "sense_id": "53322315-07f1-338c-adb1-ce8a90bdc0df",
                                                "text": "L’osséine chauffée à l’autoclave avec de l’eau donne un albumoïde de nature plus simple, la gélatine ; celle-ci se gonfle au contact de l’eau en donnant des gelées […]"
                                            },
                                            {
                                                "example_id": "4ebe5bd4-9dae-45b3-b62d-cf83d8af5f44",
                                                "sense_id": "53322315-07f1-338c-adb1-ce8a90bdc0df",
                                                "text": "J’ai vu le visage et le corps des malades s’œdématier, et le tissu cellulaire se bouffir et se gonfler par l’irritation herpétique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bc50de4-252a-311e-a8ab-ac08dd824f7a",
                                        "entry_id": "145331dd-4619-3048-ba60-ce4b830cd9e8",
                                        "glosses": [
                                            "Être envahi d’émotion."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5488c64-fa71-4d30-a56c-6c6257bcb8f4",
                                                "sense_id": "3bc50de4-252a-311e-a8ab-ac08dd824f7a",
                                                "text": "Son cœur se gonflait en pensant à elle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
