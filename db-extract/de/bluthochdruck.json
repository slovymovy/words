                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2425a848-bccd-4fb2-900a-237939e05193",
                                "sense_id": "070d6f14-41e5-36c7-bbdd-a9bebc5253c1",
                                "text": "Ich sollte meinen Bluthochdruck behandeln lassen."
                            },
                            {
                                "example_id": "6edb5508-c97c-4e94-a605-3c7ff74c4a12",
                                "sense_id": "070d6f14-41e5-36c7-bbdd-a9bebc5253c1",
                                "text": "„Er erzählt, welche Sorgen sie sich gemacht hätten, weil seine Frau schon fünfundvierzig sei und in den vergangenen Wochen an Bluthochdruck und Wasser in den Beinen gelitten habe, außerdem habe sich das Baby einfach nicht drehen wollen, es sei mit dem Füßen voran auf die Welt gekommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
