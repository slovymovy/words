                        "target_lang_word": "zoeklicht",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zoeklicht",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "981e0313-5ed7-3be6-837a-67f3e3043e6d",
                                        "entry_id": "6aa3537e-c599-3db4-8d50-811e0595ea74",
                                        "glosses": [
                                            "een sterke gerichte lichtbundel waarmee men in het donker iets op tracht te sporen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5fa77b3-6617-4cb6-806d-185a42de6c1f",
                                                "sense_id": "981e0313-5ed7-3be6-837a-67f3e3043e6d",
                                                "text": "De politiehelicopter richtte zijn zoeklicht op de vluchtende misdadiger."
                                            },
                                            {
                                                "example_id": "6569ef01-dab7-486d-9e61-e4b8c59063d0",
                                                "sense_id": "981e0313-5ed7-3be6-837a-67f3e3043e6d",
                                                "text": "Hij was op zijn best als hij de oorlog zelf beschreef, met zoeklichten die als vuurvliegjes door de nacht gleden, een vliegtuig dat danste als een mooie vlinder of een glinsterende libel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
