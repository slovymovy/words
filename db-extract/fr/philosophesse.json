                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e839cff7-a3a6-405a-8ae4-1d4aad0d538f",
                        "entry_id": "56100958-8723-34b4-8266-fcccee82a9c5",
