                                        "entry_id": "286c5716-8140-303b-a475-3f743a0f20d2",
                                        "glosses": [
                                            "A system of protective and pressurized clothing, together with environmental equipment, worn by astronauts when in space."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc7ad290-435e-30e3-b83a-d3b51718ccc4",
                                        "entry_id": "286c5716-8140-303b-a475-3f743a0f20d2",
                                        "glosses": [
                                            "A pressurized protective outfit worn by people working with extreme biohazards."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e4f494c-ec24-47bc-b1b0-2a6ddf946e6f",
                                                "sense_id": "bc7ad290-435e-30e3-b83a-d3b51718ccc4",
                                                "text": "Yale officials may have to consider treating Sabia virus as a so-called class 4 biohazard from now on, which means researchers will be able to handle it only inside a glove box or while wearing a space suit."
                                            },
                                            {
                                                "example_id": "22c09651-8294-4515-9394-3763a3bcdc5f",
                                                "sense_id": "bc7ad290-435e-30e3-b83a-d3b51718ccc4",
                                                "text": "It is really a pressurized, heavy-duty biological space suit."
                                            },
                                            {
                                                "example_id": "8792b7c7-edbf-4558-b1e4-b385690107d4",
                                                "sense_id": "bc7ad290-435e-30e3-b83a-d3b51718ccc4",
                                                "text": "Zone Two had its own protective gear—not quite so cumbersume as the space suit, but still requiring an elaborate rite of passage from the outside world."
                                            }
                                        ]
                                    }
