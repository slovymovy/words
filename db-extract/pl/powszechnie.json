                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b67b45d7-b199-45e7-b0cd-3a36512351be",
                                "sense_id": "b6e837ca-3445-3241-99b4-9adcc0ab8ba8",
                                "text": "[…] wdychany przez użytkowników e-papierosów aerozol nie jest, jak się powszechnie uważa, całkowicie neutralny dla zdrowia – może zawierać szkodliwe, rakotwórcze związki"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "047fc010-033e-4229-a072-1f0accb35f66",
                        "source_entry_id": "4c8a4684-8984-3911-adf4-b6fb7753b481",
                        "source_sense_id": "b6e837ca-3445-3241-99b4-9adcc0ab8ba8",
                        "target_lang_word": "popularly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "popularly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ad31256-882d-37c9-bdbe-425ae8643873",
                                        "entry_id": "f2e67c2e-7bb6-3ea0-87c6-98570529002d",
                                        "glosses": [
                                            "In a popular manner.",
                                            "So as to be generally favored or accepted by the people."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2c69aea8-ad8d-3233-b7c7-20b3e8c20790",
                                        "entry_id": "f2e67c2e-7bb6-3ea0-87c6-98570529002d",
                                        "glosses": [
                                            "In a popular manner.",
                                            "commonly"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6d858b2-9ad9-4139-b7cc-0484b4fc082b",
                                                "sense_id": "2c69aea8-ad8d-3233-b7c7-20b3e8c20790",
                                                "text": "They were popularly known as \"the Kings of California\""
                                            },
                                            {
                                                "example_id": "bf5347e0-9f93-465b-ac63-5529d7abfb60",
                                                "sense_id": "2c69aea8-ad8d-3233-b7c7-20b3e8c20790",
                                                "text": "Officially the Nordland Railway begins at Hell, but popularly the whole route north of Trondheim is so called."
                                            },
                                            {
                                                "example_id": "0324245b-d4b4-4ae7-b298-790c38384343",
                                                "sense_id": "2c69aea8-ad8d-3233-b7c7-20b3e8c20790",
                                                "text": "[T]he Oligocene's signature species were an unsavoury group of pigs and pig-like creatures, foremost among which were the entelodonts, more popularly known as hell pigs, or terminator pigs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d35b4b98-0e79-3d40-8a78-2a03467a32ae",
                                        "entry_id": "f2e67c2e-7bb6-3ea0-87c6-98570529002d",
                                        "glosses": [
                                            "In a popular manner.",
                                            "currently"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de5d718f-7408-4f7d-ac80-6044a9e3f964",
                        "source_entry_id": "4c8a4684-8984-3911-adf4-b6fb7753b481",
                        "source_sense_id": "b6e837ca-3445-3241-99b4-9adcc0ab8ba8",
                        "target_lang_word": "generally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "generally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d020baa0-30a6-3d42-9ef5-9f6b326125f4",
                                        "entry_id": "d88578e7-22b6-37a1-847b-843efd8947ab",
                                        "glosses": [
                                            "Popularly or widely."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "comparative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e16e6fcb-3d58-4e13-ad64-bb0386362e35",
                                                "sense_id": "d020baa0-30a6-3d42-9ef5-9f6b326125f4",
                                                "text": "It is generally known that the Earth is round."
                                            },
                                            {
                                                "example_id": "519f628c-74d0-4225-b66d-4b47fa3e750d",
                                                "sense_id": "d020baa0-30a6-3d42-9ef5-9f6b326125f4",
                                                "text": "The action he inaugurated culminated in the law for the suppression of trampage, that has accomplished such good in the Granite State, and that has been so generally copied in other states."
                                            },
                                            {
                                                "example_id": "749d48fa-2470-41f7-b10b-ed4e958a602c",
                                                "sense_id": "d020baa0-30a6-3d42-9ef5-9f6b326125f4",
                                                "text": "After defending our argument against several objections, we conclude by considering the implications our argument has for the rest of the instrumental convergence thesis and for AI safety more generally."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2666029-7b95-3d7c-b872-58875126d343",
                                        "entry_id": "d88578e7-22b6-37a1-847b-843efd8947ab",
                                        "glosses": [
                                            "As a rule; usually; typically; in most cases."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "comparative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f0de959-6370-4d44-8cd3-102dfc099fad",
                                                "sense_id": "b2666029-7b95-3d7c-b872-58875126d343",
                                                "text": "I generally have a walk in the afternoon."
                                            },
                                            {
                                                "example_id": "a1c0c42e-bd79-47f9-a4f3-3cd27f41a0da",
                                                "sense_id": "b2666029-7b95-3d7c-b872-58875126d343",
                                                "text": "During the whole time of his abode in the university he generally spent thirteen hours of the day in study; by which assiduity besides an exact dispatch of the whole course of philosophy, he read over in a manner all classic authors that are extant[…]"
                                            },
                                            {
                                                "example_id": "3fb82351-93d4-4dbb-9275-1b2d03ed8eea",
                                                "sense_id": "b2666029-7b95-3d7c-b872-58875126d343",
                                                "text": "He used to drop into my chambers once in a while to smoke, and was first-rate company. When I gave a dinner there was generally a cover laid for him. I liked the man for his own sake, and even had he promised to turn out a celebrity it would have had no weight with me."
                                            },
                                            {
                                                "example_id": "63885bff-b15c-4799-b985-8259d937ce51",
                                                "sense_id": "b2666029-7b95-3d7c-b872-58875126d343",
                                                "text": "Ivor had acquired more than a mile of fishing rights with the house ; he was not at all a good fisherman, but one must do something ; one generally, however, banged a ball with a squash-racket against a wall."
                                            },
                                            {
                                                "example_id": "bade9e44-193a-4e4f-a5a0-f1cf565f3a88",
                                                "sense_id": "b2666029-7b95-3d7c-b872-58875126d343",
                                                "text": "Musk’s Israel tour was transparently transactional and frankly insulting. The antisemitic sentiment Musk endorsed had nothing to do with Israel; “replacement theory” is generally an unsupported allegation that Jews and other immigrants in the US and Europe are destroying Western civilization."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99d7283d-bfbc-3619-a875-6dfb5856e80e",
                                        "entry_id": "d88578e7-22b6-37a1-847b-843efd8947ab",
                                        "glosses": [
                                            "Without reference to specific details."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "comparative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d290153-c3e6-4cd9-820b-36dce0dacf35",
                                                "sense_id": "99d7283d-bfbc-3619-a875-6dfb5856e80e",
                                                "text": "Generally speaking …"
                                            },
                                            {
                                                "example_id": "75748979-4423-405c-929b-cb704530d8a7",
                                                "sense_id": "99d7283d-bfbc-3619-a875-6dfb5856e80e",
                                                "text": "“There ain’t no drain of nothing short handy, is there?” said the Chicken, generally. “This here sluicing night is hard lines to a man as lives on his condition.”\nCaptain Cuttle proffered a glass of rum […]"
                                            },
                                            {
                                                "example_id": "01b904a1-a814-49d1-ad9f-ae0313a73180",
                                                "sense_id": "99d7283d-bfbc-3619-a875-6dfb5856e80e",
                                                "text": "Autopsy results revealed that Braydon was generally malnourished and thin. His cause of death was hyperthermia due to the extreme heat, which would have “caused extreme discomfort and difficulty breathing as he died.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c96bdc97-5f95-3cd3-ab03-7b594e9cd7ce",
                                        "entry_id": "d88578e7-22b6-37a1-847b-843efd8947ab",
                                        "glosses": [
                                            "In the general case, without exception; in all cases."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "comparative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b88d2433-f6f4-4a6b-846c-be0359b13345",
                                                "sense_id": "c96bdc97-5f95-3cd3-ab03-7b594e9cd7ce",
                                                "text": "It is generally true that the angles of a triangle sum to 180 degrees."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c06098d4-c2fa-3231-bf11-136d8f37b069",
                                        "entry_id": "d88578e7-22b6-37a1-847b-843efd8947ab",
                                        "glosses": [
                                            "Collectively; as a whole; without omissions."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "comparative",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce8ad0db-c031-4cb2-94f1-291a42f22085",
                                                "sense_id": "c06098d4-c2fa-3231-bf11-136d8f37b069",
                                                "text": "I counsel that all Israel be generally gathered unto thee."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1983956d-91ab-4b71-b88b-27a976318b85",
                        "source_entry_id": "4c8a4684-8984-3911-adf4-b6fb7753b481",
                        "source_sense_id": "b6e837ca-3445-3241-99b4-9adcc0ab8ba8",
                        "target_lang_word": "commonly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "commonly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12fdaeec-8c15-3724-bbff-91fb356be5da",
                                        "entry_id": "ec30230c-7d56-331a-ac5c-56cfb0dd20b9",
                                        "glosses": [
                                            "As a rule; frequently; usually."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6c41fdf-8ecc-4573-a9a8-a56295eefb80",
                                                "sense_id": "12fdaeec-8c15-3724-bbff-91fb356be5da",
                                                "text": "The class of antidepressants most commonly associated with sexual dysfunction is selective serotonin reuptake inhibitors, or SSRIs, which treat depression by ultimately increasing levels of the neurotransmitter serotonin in the brain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f9d6d52-0811-3b03-8ab4-f2ad18278546",
                                        "entry_id": "ec30230c-7d56-331a-ac5c-56cfb0dd20b9",
                                        "glosses": [
                                            "In common; familiarly."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d212467b-6861-4652-9b67-f99989fe7946",
                                                "sense_id": "9f9d6d52-0811-3b03-8ab4-f2ad18278546",
                                                "text": "As he thereon stood gazing, he might see / The blessed Angels to and fro descend / From highest heaven in gladsome companee, / And with great joy into that Citie wend, / As commonly as friend does with his frend."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63d5f6a5-2ff4-4e27-91c7-3b932a65ea72",
                        "source_entry_id": "4c8a4684-8984-3911-adf4-b6fb7753b481",
                        "source_sense_id": "b6e837ca-3445-3241-99b4-9adcc0ab8ba8",
                        "target_lang_word": "widely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "widely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fdf34e92-21be-3e3c-b566-c1f319647c3f",
                                        "entry_id": "6b39e60b-b1a1-3093-896c-9a39ad673ee6",
                                        "glosses": [
                                            "In a wide manner; across a wide area."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21340ed0-8685-4eb3-aa45-16fd817c3a3b",
                                                "sense_id": "fdf34e92-21be-3e3c-b566-c1f319647c3f",
                                                "text": "I'm widely travelled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79545a94-dfdd-31bd-b3ae-5d81ed8b49c0",
                                        "entry_id": "6b39e60b-b1a1-3093-896c-9a39ad673ee6",
                                        "glosses": [
                                            "Commonly; generally; to a great degree."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d3b4754-43bc-464b-8e8e-ef34a812474a",
                                                "sense_id": "79545a94-dfdd-31bd-b3ae-5d81ed8b49c0",
                                                "text": "In 1866 Colonel J. F. Meline noted that the rebozo had almost disappeared in Santa Fe and that hoop skirts, on sale in the stores, were being widely used."
                                            },
                                            {
                                                "example_id": "3d0c4c85-7c6b-449a-aa6b-21dd30ff7729",
                                                "sense_id": "79545a94-dfdd-31bd-b3ae-5d81ed8b49c0",
                                                "text": "Kim Jong-il, who has died aged 69, was the general secretary of the Workers party of Korea, and head of the military in the Democratic People's Republic of Korea (DPRK). He was one of the most reclusive and widely condemned national leaders of the late 20th and early 21st century, leaving his country diplomatically isolated, economically broken and divided from South Korea."
                                            },
                                            {
                                                "example_id": "89263b75-df81-4abf-a0b9-50c3afc489f9",
                                                "sense_id": "79545a94-dfdd-31bd-b3ae-5d81ed8b49c0",
                                                "text": "Demandt discusses a German example, Ferdinand Grautoff's 1906. Der Zusammenbuch der Alten Welt (1905) (cf. Es hätte auch... 195-196). Thus, a war widely predicted in fiction is only exiguously remembered in post factum allohistorical narratives."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "96ef643f-f6d4-45b0-96b3-188ed95ec8dd",
                        "source_entry_id": "4c8a4684-8984-3911-adf4-b6fb7753b481",
                        "source_sense_id": "b6e837ca-3445-3241-99b4-9adcc0ab8ba8",
                        "target_lang_word": "communément",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "communément",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb4ce31a-1b78-3035-a37e-36a0736e68d5",
                                        "entry_id": "b59bcb3b-faf6-3589-bc31-294d3d38f4e0",
                                        "glosses": [
                                            "Le plus ordinairement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "588199c8-721d-4e97-a52c-6b03f09e7cee",
                                                "sense_id": "cb4ce31a-1b78-3035-a37e-36a0736e68d5",
                                                "text": "On les trouve communément dans les rues."
                                            },
                                            {
                                                "example_id": "69c9d627-7f46-4a37-a1cf-ab07388d1df2",
                                                "sense_id": "cb4ce31a-1b78-3035-a37e-36a0736e68d5",
                                                "text": "L'oxalide petite oseille, oxalis acetosella, Lin., porte vulgairement les noms de surette, alléluia, etc. Elle croit assez communément dans les bois et les lieux couverts de presque toute la France."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "710cdd7e-8d3f-3a4d-9388-4a97cc8eb7e0",
                                        "entry_id": "b59bcb3b-faf6-3589-bc31-294d3d38f4e0",
                                        "glosses": [
                                            "D’après l’usage commun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ac5be6b-5804-4a93-879a-ed01e115de93",
                                                "sense_id": "710cdd7e-8d3f-3a4d-9388-4a97cc8eb7e0",
                                                "text": "La psychorigidité forme un couple bien assorti avec l’égocentrisme qui peut se définir comme un rapport privilégié, voire univoque à soi, à ses préoccupations, différent de ce que l'on entend communément par égoïsme."
                                            },
                                            {
                                                "example_id": "b1aaaa44-538f-452e-a028-835fd8418c15",
                                                "sense_id": "710cdd7e-8d3f-3a4d-9388-4a97cc8eb7e0",
                                                "text": "Ces dépenses injustifiées et excessives sont communément appelées, reprenant ainsi le terme de la jurisprudence des juridictions du contentieux de la tarification, abusives."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f4dd602-1962-40e6-ac86-567854477683",
                        "source_entry_id": "4c8a4684-8984-3911-adf4-b6fb7753b481",
