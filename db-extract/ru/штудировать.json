                ],
                "senses": [
                    {
                        "sense_id": "eff1ff5a-871f-3591-b8c2-3ec50dfe4d70",
                        "entry_id": "d3238b1b-fa56-398e-af05-b794c5eb84f6",
                        "glosses": [
                            "тщательно изучать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a05d1421-b439-4eb0-b0fe-31e7fcd52309",
                                "sense_id": "eff1ff5a-871f-3591-b8c2-3ec50dfe4d70",
                                "text": "Она была генеральская дочь, умна и с характером, кое-чему училась и читала, в молодости штудировала Гете, недурно играла на фортепиано, знала два языка, отличалась большим тактом и щеголяла манерами и комильфотностью."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60cad232-7f9b-4666-aa45-d843076ff3ae",
                        "source_entry_id": "d3238b1b-fa56-398e-af05-b794c5eb84f6",
                        "source_sense_id": "eff1ff5a-871f-3591-b8c2-3ec50dfe4d70",
                        "target_lang_word": "étudier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étudier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b7bfdb69-5c3e-35ff-8249-3c11c1cd091f",
                                        "entry_id": "55ba28dc-91be-3ed0-bea4-0fd29dc33a43",
                                        "glosses": [
                                            "S’appliquer à acquérir des connaissances ou des capacités dans un domaine déterminé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c49b0460-4457-43ce-9b4c-d650636b4942",
                                                "sense_id": "b7bfdb69-5c3e-35ff-8249-3c11c1cd091f",
                                                "text": "Il étudie nuit et jour."
                                            },
                                            {
                                                "example_id": "597f1bfd-ef8c-47d5-89ce-1aa66438bdeb",
                                                "sense_id": "b7bfdb69-5c3e-35ff-8249-3c11c1cd091f",
                                                "text": "On ne devient pas savant sans étudier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab3f951d-4b2d-3f99-a97a-c3cf1c96dcf9",
                                        "entry_id": "55ba28dc-91be-3ed0-bea4-0fd29dc33a43",
                                        "glosses": [
                                            "Faire ses études, suivre des cours."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db6eabf3-16de-4a50-bded-669838cfaa9c",
                                                "sense_id": "ab3f951d-4b2d-3f99-a97a-c3cf1c96dcf9",
                                                "text": "Mais depuis deux ans, l’Égypte s’est transformée. […] Beaucoup de jeunes filles étudient maintenant à l’Université, à côté des jeunes gens, habillées comme des Françaises."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c4c6705-3aa8-3d4f-9df8-e41870745f03",
                                        "entry_id": "55ba28dc-91be-3ed0-bea4-0fd29dc33a43",
                                        "glosses": [
                                            "S’exercer sur un instrument de musique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e4e38c8-9260-4b36-b791-2f1658cfa9f6",
                                                "sense_id": "1c4c6705-3aa8-3d4f-9df8-e41870745f03",
                                                "text": "Ce pianiste étudie plusieurs heures par jour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ffb66b7-3795-3d3c-8e27-fca40f8b80e4",
                                        "entry_id": "55ba28dc-91be-3ed0-bea4-0fd29dc33a43",
                                        "glosses": [
                                            "S’exercer, s’appliquer à apprendre une science, un art, à comprendre un auteur, à connaître toutes les circonstances d’une affaire, les causes d’un phénomène, etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f81c1ba-bafa-459d-9eea-712fb7c7ff43",
                                                "sense_id": "5ffb66b7-3795-3d3c-8e27-fca40f8b80e4",
                                                "text": "Étudier la physique, l’histoire, l’architecture, la médecine, le droit."
                                            },
                                            {
                                                "example_id": "1935a253-f769-4b5f-b157-2455d059f4de",
                                                "sense_id": "5ffb66b7-3795-3d3c-8e27-fca40f8b80e4",
                                                "text": "C’est un auteur que j’ai peu étudié."
                                            },
                                            {
                                                "example_id": "5117a034-2d8d-44da-bc72-2131d56c4cdc",
                                                "sense_id": "5ffb66b7-3795-3d3c-8e27-fca40f8b80e4",
                                                "text": "Il étudie l’écriture sainte."
                                            },
                                            {
                                                "example_id": "7b877b73-481b-42fa-84dc-7e9cea6808a0",
                                                "sense_id": "5ffb66b7-3795-3d3c-8e27-fca40f8b80e4",
                                                "text": "Il connaît bien cette affaire, il l’a beaucoup étudiée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44b0a744-5da8-30c6-b50f-5f25a3ca08c4",
                                        "entry_id": "55ba28dc-91be-3ed0-bea4-0fd29dc33a43",
                                        "glosses": [
                                            "S’assurer de l’effet d’un travail, avant l’exécution définitive."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa96fce4-ddfc-4b98-9a30-62c2cb4956f6",
                                                "sense_id": "44b0a744-5da8-30c6-b50f-5f25a3ca08c4",
                                                "text": "Étudier une draperie, une pose, l’agencement d’un groupe,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73ff7e50-654a-3cb6-88aa-fa80bad1eec3",
                                        "entry_id": "55ba28dc-91be-3ed0-bea4-0fd29dc33a43",
                                        "glosses": [
                                            "Vérifier si toutes les parties d'un projet sont combinées avec ordre et justesse, et s’il s’accorde bien avec les moyens d’exécution."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0740b36-4c4c-4e5f-915d-9628a4faf4e8",
                                                "sense_id": "73ff7e50-654a-3cb6-88aa-fa80bad1eec3",
                                                "text": "Étudier un projet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f97dd988-f0f8-3ffe-99e7-39ec22d20079",
                                        "entry_id": "55ba28dc-91be-3ed0-bea4-0fd29dc33a43",
                                        "glosses": [
                                            "Mettre au point ; peaufiner."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23d729fc-8764-46e4-ab73-55aacac0b4d0",
                                                "sense_id": "f97dd988-f0f8-3ffe-99e7-39ec22d20079",
                                                "text": "La formation du pétrole par le métamorphisme du sapropel est due à la chaleur et à la pression, et, peut-être, à la pression seule : mais ce phénomène géologique doit encore être étudié."
                                            },
                                            {
                                                "example_id": "a4f6653f-af53-4af3-ab10-177f3ab5ffce",
                                                "sense_id": "f97dd988-f0f8-3ffe-99e7-39ec22d20079",
                                                "text": "[…] Tarbouriech a même étudié des modèles de paperasses à recommander à la bureaucratie future."
                                            },
                                            {
                                                "example_id": "d653e1cd-67bc-4ab1-9105-4e8b987a346d",
                                                "sense_id": "f97dd988-f0f8-3ffe-99e7-39ec22d20079",
                                                "text": "La Réunion est le seul département de France où existent des circuits touristiques réguliers en hélicoptère, qui ont été étudiés pour vous en mettre plein la vue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30708477-baaa-307f-a5d6-34d256369206",
                                        "entry_id": "55ba28dc-91be-3ed0-bea4-0fd29dc33a43",
                                        "glosses": [
                                            "Faire l’objet de son étude, en parlant d’un domaine d’étude."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad368d67-3893-44dd-9a90-c383585a3491",
                                                "sense_id": "30708477-baaa-307f-a5d6-34d256369206",
                                                "text": "Les traités de phytogéographie étudient en général l’action du milieu sur la répartition des plantes."
                                            },
                                            {
                                                "example_id": "baf2b29a-4b72-4bf6-822d-566aeedb5e67",
                                                "sense_id": "30708477-baaa-307f-a5d6-34d256369206",
                                                "text": "Se pencher sur un limule est aussi une expérience un peu troublante... Souvent, l'invertébré se positionne pour mieux percevoir l'étranger. Dès lors, on ne sait plus très bien qui étudie qui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14091ba5-034f-37a0-8c59-00a959e401e3",
                                        "entry_id": "55ba28dc-91be-3ed0-bea4-0fd29dc33a43",
                                        "glosses": [
                                            "Observer avec soin l’humeur, les façons de faire, les inclinations d’une personne."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21cb11f8-6c6b-4662-8f22-4cb7e539de91",
                                                "sense_id": "14091ba5-034f-37a0-8c59-00a959e401e3",
                                                "text": "Il s’en alla ; puis il rouvrit la porte, et dit encore d’une voix impérieuse :\n— Surtout, défiez-vous d’Aristide, c’est un brouillon qui gâterait tout. Je l’ai assez étudié pour être certain qu’il retombera toujours sur ses pieds. Ne vous apitoyez pas ; car, si nous faisons fortune, il saura nous voler sa part."
                                            },
                                            {
                                                "example_id": "a7072339-a307-4979-8400-e37483ed1995",
                                                "sense_id": "14091ba5-034f-37a0-8c59-00a959e401e3",
                                                "text": "[…] je décidai de passer l’après midi avec eux, d’étudier leurs méthodes de plonge et de prendre plusieurs films."
                                            },
                                            {
                                                "example_id": "991b042f-78b5-4a20-9cdc-c3fd07ae1f44",
                                                "sense_id": "14091ba5-034f-37a0-8c59-00a959e401e3",
                                                "text": "J’essuyai mes larmes, repoudrai le bout de mon nez. En un mot, je ravalais ma façade lézardée. Je m'étudiai une dernière fois dans la glace. Personne n'aurait pu soupçonner mon tumulte intérieur."
                                            },
                                            {
                                                "example_id": "b0c98770-e6eb-4611-a555-6a9dc151a76c",
                                                "sense_id": "14091ba5-034f-37a0-8c59-00a959e401e3",
                                                "text": "J’ai longtemps étudié cet homme-là, et je ne le connais pas encore bien. — Un bon précepteur étudie les inclinations de son élève."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "857412c7-a312-39d4-ae58-5e5cf25fa81c",
                                        "entry_id": "55ba28dc-91be-3ed0-bea4-0fd29dc33a43",
                                        "glosses": [
                                            "S’appliquer, s’exercer à faire quelque chose, méditer de quelle manière on peut s’y prendre."
                                        ],
                                        "tags": [
                                            "dated",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62013dde-213f-411d-b635-68eaf5b24d04",
                                                "sense_id": "857412c7-a312-39d4-ae58-5e5cf25fa81c",
                                                "text": "[…] la déposition de Malvoisin fut faite avec beaucoup d’adresse ; mais, tout en s’étudiant à ménager les sentiments de Bois-Guilbert, il laissait échapper de temps en temps des insinuations […]"
                                            },
                                            {
                                                "example_id": "54a7e5a6-e202-4ed1-8a97-2bf57ad0bbaf",
                                                "sense_id": "857412c7-a312-39d4-ae58-5e5cf25fa81c",
                                                "text": "Mon Dieu, les gens les plus niais s’étudient à cacher ces choses-là, et tu crois qu’un ambassadeur ira te les dire !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
