                                    },
                                    {
                                        "sense_id": "ae436c6b-e170-3a72-be05-b22d87615772",
                                        "entry_id": "8eacc87c-4f88-3307-91ce-bb1d8725fcc0",
                                        "glosses": [
                                            "A woman’s breast."
                                        ],
                                        "tags": [
                                            "plural-normally",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4239534c-83f9-4230-9222-71197b2c15d0",
                                                "sense_id": "ae436c6b-e170-3a72-be05-b22d87615772",
                                                "text": "Unclasp your bra and set those puppies free."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "850b681d-c2fb-308f-83b9-9aab47c3d81f",
                                        "entry_id": "8eacc87c-4f88-3307-91ce-bb1d8725fcc0",
                                        "glosses": [
                                            "A (generic) thing; particularly something that is a nuisance; a sucker."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20d4fc2a-69db-4ddf-8cc1-cf62774f2306",
                                                "sense_id": "850b681d-c2fb-308f-83b9-9aab47c3d81f",
                                                "text": "I have another two dozen of these puppies to finish before I can go home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45a5d82f-4d89-3aa3-8f90-3e91092b57c8",
                                        "entry_id": "8eacc87c-4f88-3307-91ce-bb1d8725fcc0",
                                        "glosses": [
                                            "A conceited and impertinent person, especially a young man."
                                        ],
                                        "tags": [
                                            "dated",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c61f83b-6e01-4381-acd6-35dff5551824",
                                                "sense_id": "45a5d82f-4d89-3aa3-8f90-3e91092b57c8",
                                                "text": "I found my place taken by an ill-bred, awkward puppy with a money bag under each arm."
                                            },
                                            {
                                                "example_id": "4e28ec09-fb35-4a77-8705-5971e9b6d886",
                                                "sense_id": "45a5d82f-4d89-3aa3-8f90-3e91092b57c8",
                                                "text": "I ne'r vvith VVits and VVitlings paſt my days, / To ſpread about the Itch of Verſe and Praiſe, / Nor like a Puppy daggled thro' the Tovvn, / To fetch and carry Sing-ſong up and dovvn; […]"
                                            },
                                            {
                                                "example_id": "f339c70c-df8f-4605-bd5c-39a29692bd58",
                                                "sense_id": "45a5d82f-4d89-3aa3-8f90-3e91092b57c8",
                                                "text": "I think him a very handsome young man, and his manners are precisely what I like and approve—so truly the gentleman, without the least conceit or puppyism. You must know I have a vast dislike to puppies—quite a horror of them."
                                            }
                                        ]
                                    }
                                ]
                            },
