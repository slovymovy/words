    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "439cc7ec-0ccc-3d09-ac42-c3e0ef125e8f",
                    "sense_definition": "A viscous liquid derived from petroleum, or from animal or vegetable fats, that is typically used as fuel or for cooking.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should add a little bit of vegetable <w>oil</w> to the pan before frying the onions.",
                            "target_lang_translations": {
                                "ru": "Вам следует добавить немного растительного <w>масла</w> на сковороду перед тем, как жарить лук."
                            }
                        },
                        {
                            "text": "The mechanic checked the engine <w>oil</w> to make sure the car was running safely.",
                            "target_lang_translations": {
                                "ru": "Механик проверил моторное <w>масло</w>, чтобы убедиться в безопасности работы автомобиля."
                            }
                        }
                    ],
                    "synonyms": [
                        "grease",
                        "fat"
                    ],
                    "common_phrases": [
                        "cooking oil",
                        "vegetable oil",
                        "olive oil"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вязкая жидкость, получаемая из нефти, животных или растительных жиров, обычно используемая в качестве топлива или для приготовления пищи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "масло",
                                "target_lang_sense_clarification": "общее название для жиров"
                            },
                            {
                                "target_lang_word": "растительное масло",
                                "target_lang_sense_clarification": "для кулинарии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a10737af-9993-3044-be26-428cddd1a216",
                    "sense_definition": "Petroleum, especially when extracted from the ground as a natural resource.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The country's economy relies heavily on the export of crude <w>oil</w> to other nations.",
                            "target_lang_translations": {
                                "ru": "Экономика страны сильно зависит от экспорта сырой <w>нефти</w> в другие государства."
                            }
                        },
                        {
                            "text": "Many environmentalists are concerned about the impact of an <w>oil</w> spill on marine life.",
                            "target_lang_translations": {
                                "ru": "Многие экологи обеспокоены влиянием разлива <w>нефти</w> на морскую флору и фауну."
                            }
                        }
                    ],
                    "synonyms": [
                        "petroleum",
                        "crude"
                    ],
                    "common_phrases": [
                        "oil spill",
                        "crude oil",
                        "oil industry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нефть, особенно при добыче из земли как природный ресурс."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нефть",
                                "target_lang_sense_clarification": "природное ископаемое"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01c6f1a6-d649-368a-9641-0c23e4ae6502",
                    "sense_definition": "A type of paint made by mixing pigment with a drying oil, such as linseed oil.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist preferred to work in <w>oil</w> because it allowed for more blending of colors.",
                            "target_lang_translations": {
                                "ru": "Художник предпочитал писать <w>маслом</w>, так как это позволяло лучше смешивать цвета."
                            }
                        },
                        {
                            "text": "She bought a new set of <w>oils</w> to start her landscape painting project.",
                            "target_lang_translations": {
                                "ru": "Она купила новый набор масляных <w>красок</w>, чтобы начать работу над пейзажем."
                            }
                        }
                    ],
                    "synonyms": [
                        "oil paint"
                    ],
                    "common_phrases": [
                        "paint in oil",
                        "set of oils"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тип краски, изготовленной путем смешивания пигмента с высыхающим маслом, например, льняным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "масло",
                                "target_lang_sense_clarification": "масляная краска"
                            },
                            {
                                "target_lang_word": "масляные краски",
                                "target_lang_sense_clarification": "художественный материал"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37642c40-af6f-35a0-bd97-0e673a5e6864",
                    "sense_definition": "A painting produced using oil paints.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum has a vast collection of 19th-century <w>oils</w> on display in the main gallery.",
                            "target_lang_translations": {
                                "ru": "В главной галерее музея представлена обширная коллекция <w>картин</w>, написанных маслом в XIX веке."
                            }
                        },
                        {
                            "text": "He decided to hang a beautiful <w>oil</w> of the countryside in his living room.",
                            "target_lang_translations": {
                                "ru": "Он решил повесить в гостиной красивый сельский пейзаж <w>маслом</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "oil painting"
                    ],
                    "common_phrases": [
                        "original oil",
                        "canvas oil"
                    ],
                    "target_lang_definitions": {
                        "ru": "Картина, написанная масляными красками."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "масло",
                                "target_lang_sense_clarification": "живопись маслом"
                            },
                            {
                                "target_lang_word": "картина маслом",
                                "target_lang_sense_clarification": "произведение искусства"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a434743a-48af-3f50-bcb4-b56149c4401c",
                    "sense_definition": "To apply oil to something, typically to make it move smoothly or to protect it.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "application",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to <w>oil</w> the hinges of the door to stop them from squeaking.",
                            "target_lang_translations": {
                                "ru": "Вам нужно <w>смазать</w> дверные петли, чтобы они перестали скрипеть."
                            }
                        },
                        {
                            "text": "The woodman polished his tin and <w>oiled</w> his joints so he could walk again.",
                            "target_lang_translations": {
                                "ru": "Дровосек почистил свою жестянку и <w>смазал</w> суставы, чтобы снова иметь возможность ходить."
                            }
                        }
                    ],
                    "synonyms": [
                        "lubricate",
                        "grease"
                    ],
                    "common_phrases": [
                        "oil the hinges",
                        "oil the machine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наносить масло на что-либо, обычно для обеспечения плавного движения или защиты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смазывать",
                                "target_lang_sense_clarification": "механизмы"
                            },
                            {
                                "target_lang_word": "смазать",
                                "target_lang_sense_clarification": "однократное действие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a98ea9a9-8cfe-372b-b3ea-fb7b49c2b71f",
                    "sense_definition": "To coat a surface with oil or grease, especially in preparation for cooking.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "application",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Make sure to <w>oil</w> the pan thoroughly so the cake doesn't stick to the bottom.",
                            "target_lang_translations": {
                                "ru": "Обязательно тщательно <w>смажьте</w> форму, чтобы пирог не прилип ко дну."
                            }
                        },
                        {
                            "text": "She <w>oiled</w> the baking sheet before placing the cookies on it.",
                            "target_lang_translations": {
                                "ru": "Она <w>смазала</w> противень маслом, прежде чем выложить на него печенье."
                            }
                        }
                    ],
                    "synonyms": [
                        "grease"
                    ],
                    "common_phrases": [
                        "oil the pan",
                        "lightly oil"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать поверхность маслом или жиром, особенно при подготовке к приготовлению пищи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смазывать",
                                "target_lang_sense_clarification": "поверхность формы или сковороды"
                            },
                            {
                                "target_lang_word": "смазать",
                                "target_lang_sense_clarification": "кулинарная обработка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e451e4c-6883-3f95-b5d6-bc33d3a2f869",
                    "sense_definition": "To speak in a smooth, flattering, or unctuous manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He began to <w>oil</w> his words in an attempt to persuade the committee to agree.",
                            "target_lang_translations": {
                                "ru": "Он начал <w>умасливать</w> их речами, пытаясь убедить комитет согласиться."
                            }
                        },
                        {
                            "text": "The salesman <w>oiled</w> his way through the presentation with excessive compliments.",
                            "target_lang_translations": {
                                "ru": "Продавец <w>льстил</w> на протяжении всей презентации, рассыпаясь в чрезмерных комплиментах."
                            }
                        }
                    ],
                    "synonyms": [
                        "flatter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить вкрадчиво, льстиво или елейно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "льстить",
                                "target_lang_sense_clarification": "говорить приятные вещи с корыстью"
                            },
                            {
                                "target_lang_word": "умасливать",
                                "target_lang_sense_clarification": "забривать лестью"
                            }
                        ]
                    }
                }
            ]
        },
