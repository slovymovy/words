                "senses": [
                    {
                        "sense_id": "2f0f52eb-9c39-3987-880d-909c0b549d7e",
                        "entry_id": "dd223379-6294-33f2-9592-0d39ef5144dd",
                        "glosses": [
                            "Mannschaft, die zusammen Fußball spielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "560cd771-cb7f-442b-a88a-426980bc9db0",
                                "sense_id": "2f0f52eb-9c39-3987-880d-909c0b549d7e",
                                "text": "„Der Angreifer, den der streitbare Holländer Louis van Gaal 2009 als Bayern-Coach groß herausgebracht hatte, ist mit Mitte 20 zum Imageträger des Vereins geworden, zu der Identifikationsfigur der Fans. In Zeiten der globalisierten Fußballteams, in denen auch beim FC Bayern die deutschen Spieler weniger werden, verkörpert Müller die DNA des Clubs.“"
                            },
                            {
                                "example_id": "8841a95f-7354-4a81-89f9-0925613b5dde",
                                "sense_id": "2f0f52eb-9c39-3987-880d-909c0b549d7e",
                                "text": "„Die Stadien im ländlichen Pholokwane und Nelspruit hätten seines Erachtens nie gebaut werden dürfen; in Pholokwane gibt es nicht einmal ein Fußballteam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
