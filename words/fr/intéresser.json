                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils ont choisi d'<w>intéresser</w> la partie pour rendre le match plus excitant."
                        },
                        {
                            "text": "Nous pouvons <w>intéresser</w> un peu le jeu avec une petite mise amicale."
