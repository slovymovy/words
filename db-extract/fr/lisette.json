        "fr-extract.jsonl": [
            {
                "entry_id": "f5f15140-68aa-38a6-b198-211190f7d9f0",
                "word": "Lisette",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "305b9785-c844-3517-9d6d-9a2994ef2048",
                        "entry_id": "f5f15140-68aa-38a6-b198-211190f7d9f0",
                        "glosses": [
                            "Prénom féminin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e344db7-df0a-41fa-8e14-40d7da5fb709",
                                "sense_id": "305b9785-c844-3517-9d6d-9a2994ef2048",
                                "text": "Ma pauvre femme, qui perd la tête, vient de m’envoyer un homme à soutane, à moi, l’admirateur de Béranger, l’ami de Lisette, l’enfant de Voltaire et de Rousseau…"
                            },
                            {
                                "example_id": "6ddb7d07-cccf-4f0d-a32c-b63ccd58e521",
                                "sense_id": "305b9785-c844-3517-9d6d-9a2994ef2048",
                                "text": "Il avait retrouvé la Lisette, la Marton, la Sméraldine de son rêve !"
                            },
                            {
                                "example_id": "5f371327-3e9a-406b-8299-ae21a0ee18ad",
                                "sense_id": "305b9785-c844-3517-9d6d-9a2994ef2048",
                                "text": "Là-dessus, l’abbé nous dit quels illustrés pouvaient être lus avec profit par un enfant chrétien. C’étaient Pierrot, Guignol, ainsi que Lisette et La Semaine de Suzette pour les filles. Je connaissais. C’était le genre de trucs que lisaient les enfants des patronnes de maman. Fadasse et chiant."
                            },
                            {
                                "example_id": "b05858a5-5485-4a18-8929-03073935ab71",
                                "sense_id": "305b9785-c844-3517-9d6d-9a2994ef2048",
                                "text": "Enfin, le jury Théâtre a choisi Franck Desmedt pour sa mise en scène de La Promesse de l’aube au Lucernaire (et l’ensemble de son œuvre) ainsi que Suzanne de Baecque, la Lisette de La Surprise de l’amour."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
