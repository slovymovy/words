                ],
                "senses": [
                    {
                        "sense_id": "3c78f411-3f35-3b74-8816-b58a5e90c3ec",
                        "entry_id": "0772750c-8bca-36dc-a6cd-1c1dc60150ce",
                        "glosses": [
                            "nog niet gemalen, nog niet verwerkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53daa186-b373-4e38-8952-f6af6e697bcd",
                                "sense_id": "3c78f411-3f35-3b74-8816-b58a5e90c3ec",
                                "text": "Verder lijken veel eters te denken 'hoe onverteerbaarder, hoe beter'en kiezen ze voor loodzwaar brood met ongemalen korrels. Liefst moet het er ook donker uitzien, als roggebrood. Helaas, dat voegt niks toe. Een lichtgekleurd volkorenbrood doet evenveel als zo'n veekoekachtige variant."
                            },
                            {
                                "example_id": "3c478466-17e8-414d-bebf-89fe46c64cfb",
                                "sense_id": "3c78f411-3f35-3b74-8816-b58a5e90c3ec",
                                "text": "Op de verpakking van de oogschaduw met gemalen saffier is te lezen dat deze edelsteen ‘het derde oog’ versterkt, waardoor intuïtie en zelfinzicht toenemen. Goed verhaal, maar helaas zijn de Rituals-kleuren weinig spectaculair. En als ik op mijn eigen inzicht mag vertrouwen: doe mij maar een ongemalen saffier aan mijn vinger."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12b2bcba-ad53-4e31-92a5-a73d2ddc045b",
                        "source_entry_id": "0772750c-8bca-36dc-a6cd-1c1dc60150ce",
                        "source_sense_id": "3c78f411-3f35-3b74-8816-b58a5e90c3ec",
                        "target_lang_word": "whole",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "whole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5abcd10d-71fd-3c58-8751-8d622767a721",
                                        "entry_id": "e36826d8-f658-3fef-8757-b52b0b042ebe",
                                        "glosses": [
                                            "Entire, undivided."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86f85f90-e3c4-4bce-9179-a08f8ce6fa6d",
                                                "sense_id": "5abcd10d-71fd-3c58-8751-8d622767a721",
                                                "text": "I ate a whole fish."
                                            },
                                            {
                                                "example_id": "6bd22ffe-535d-4ec0-bd74-7e0afa07b177",
                                                "sense_id": "5abcd10d-71fd-3c58-8751-8d622767a721",
                                                "text": "During the whole time of his abode in the university he generally spent thirteen hours of the day in study; by which assiduity besides an exact dispatch of the whole course of philosophy, he read over in a manner all classic authors that are extant[…]"
                                            },
                                            {
                                                "example_id": "9fd9dc3d-760e-4e32-bb9b-b2cd0e4987dc",
                                                "sense_id": "5abcd10d-71fd-3c58-8751-8d622767a721",
                                                "text": "Athelstan Arundel walked home all the way, foaming and raging. […] He walked the whole way, walking through crowds, and under the noses of dray-horses, carriage-horses, and cart-horses, without taking the least notice of them."
                                            },
                                            {
                                                "example_id": "3a52945a-194b-415d-9904-3b3689a4e4cc",
                                                "sense_id": "5abcd10d-71fd-3c58-8751-8d622767a721",
                                                "text": "“[…] She takes the whole thing with desperate seriousness. But the others are all easy and jovial—thinking about the good fare that is soon to be eaten, about the hired fly, about anything.”"
                                            },
                                            {
                                                "example_id": "a4bcc6bc-668d-4c21-a926-ae8f899e1cac",
                                                "sense_id": "5abcd10d-71fd-3c58-8751-8d622767a721",
                                                "text": "Floods in northern India, mostly in the small state of Uttarakhand, have wrought disaster on an enormous scale. The early, intense onset of the monsoon on June 14th swelled rivers, washing away roads, bridges, hotels and even whole villages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5f634bb-1556-3346-a537-b0fc5ab29d7a",
                                        "entry_id": "e36826d8-f658-3fef-8757-b52b0b042ebe",
                                        "glosses": [
                                            "Entire, undivided.",
                                            "Used as an intensifier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92b2120c-763a-44d8-945e-896953c18a49",
                                                "sense_id": "b5f634bb-1556-3346-a537-b0fc5ab29d7a",
                                                "text": "I brought a whole lot of balloons for the party. She ate a whole bunch of french fries."
                                            },
                                            {
                                                "example_id": "3d26a0b7-027b-4023-a665-b4a8a74b76ba",
                                                "sense_id": "b5f634bb-1556-3346-a537-b0fc5ab29d7a",
                                                "text": "There, a huge blue heron stands sentry like a statue, eye on the surface, waiting for his next meal to wriggle by. A lone grassy hill overlooks it all, well above the flood line, big enough to pitch a whole mess of tents [on]."
                                            },
                                            {
                                                "example_id": "ca1ac541-3928-4d49-afd6-f6d78b99e5b5",
                                                "sense_id": "b5f634bb-1556-3346-a537-b0fc5ab29d7a",
                                                "text": "I'm thinking, thanks a whole fuck of a lot, Robert. You could have laid that on me weeks ago."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9285777-a1a7-3822-82ac-28ef44f2de9a",
                                        "entry_id": "e36826d8-f658-3fef-8757-b52b0b042ebe",
                                        "glosses": [
                                            "Sound, uninjured, healthy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d1ff257-5446-40bc-a749-7743b2429458",
                                                "sense_id": "c9285777-a1a7-3822-82ac-28ef44f2de9a",
                                                "text": "He is of whole mind, but the same cannot be said about his physical state."
                                            },
                                            {
                                                "example_id": "4ea805d7-690c-4d9a-a093-a12ced05c89f",
                                                "sense_id": "c9285777-a1a7-3822-82ac-28ef44f2de9a",
                                                "text": "Here, with one balm for many fevers found, / Whole of an ancient evil, I sleep sound."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e23c1e11-21d6-35ef-bb14-4add4da7abce",
                                        "entry_id": "e36826d8-f658-3fef-8757-b52b0b042ebe",
                                        "glosses": [
                                            "From which none of its constituents has been removed."
                                        ],
                                        "tags": [
                                            "of food"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64f74bdc-45b4-438a-8caf-a25d895ed324",
                                                "sense_id": "e23c1e11-21d6-35ef-bb14-4add4da7abce",
                                                "text": "whole wheat; whole milk"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4a9ab91-8a91-3a23-9729-43b48165fd2a",
                                        "entry_id": "e36826d8-f658-3fef-8757-b52b0b042ebe",
                                        "glosses": [
                                            "As yet unworked."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
