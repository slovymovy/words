                ],
                "senses": [
                    {
                        "sense_id": "73c2cd89-ebbe-3b8d-9b21-c256840ee518",
                        "entry_id": "5e725c3a-10df-300e-915d-ef0df7855767",
                        "glosses": [
                            "Großstadt, besonders als stellvertretender Gegensatz zu einem (romantisierten) Leben auf dem Lande"
                        ],
                        "tags": [
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "76de04d3-8321-45e4-b341-4e9d16fd8a12",
                                "sense_id": "73c2cd89-ebbe-3b8d-9b21-c256840ee518",
                                "text": "„Obwohl die Kälte der Wälder dem Dichter von Haus aus beigegeben und nicht erst in der Asphaltstadt erlebt wird, wie Marsch behauptet, ist er gegen Kälte doch nicht gefeit.“"
                            },
                            {
                                "example_id": "dd3c5085-c4b2-4753-9733-f4fdf23ad892",
                                "sense_id": "73c2cd89-ebbe-3b8d-9b21-c256840ee518",
                                "text": "„In der Asphaltstadt bin ich daheim.“"
                            },
                            {
                                "example_id": "422922f7-0dae-4a54-befa-8c69d895b452",
                                "sense_id": "73c2cd89-ebbe-3b8d-9b21-c256840ee518",
                                "text": "„Seither aber ist der Sprecher, der sich als Kenner der Städte bezeichnet, in der Asphaltstadt zu Hause – der heutige Leser weiß, daß es sich hier um eine Projektion Brechts handelt, dessen Heimat nichts von einer Asphaltstadt hatte.“"
                            },
                            {
                                "example_id": "9bcb8a46-3ef0-4ba8-a62f-5c08719630cc",
                                "sense_id": "73c2cd89-ebbe-3b8d-9b21-c256840ee518",
                                "text": "„Er stamme aus den »schwarzen Wäldern« und sei von seiner Mutter in die Asphaltstädte hineingetragen worden, so hat B. seine Herkunft selbst lyrisch stilisiert (»Vom armen B.B.«).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
