                "senses": [
                    {
                        "sense_id": "10a9cdd3-24bb-3960-97bf-ed128a6e5cf4",
                        "entry_id": "1e40cd1e-5820-36c8-93fe-c2390a3032ec",
                        "glosses": [
                            "Abbildung eines Menschen in Form einer Puppe, in die Nadeln gestochen werden, um der Person Schaden zuzufügen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab5ac0b3-cc64-4da5-8d84-9767edf6162a",
                                "sense_id": "10a9cdd3-24bb-3960-97bf-ed128a6e5cf4",
                                "text": "„Es hätte auch so etwas wie eine Voodoopuppe sein können.“"
                            },
                            {
                                "example_id": "877c3e01-bc76-4a30-9045-99e388ac0a00",
                                "sense_id": "10a9cdd3-24bb-3960-97bf-ed128a6e5cf4",
                                "text": "„Penny keuchte und erschauderte, als ihr eiskalt klar wurde: Es waren Voodoopuppen.“"
                            },
                            {
                                "example_id": "6a254083-ab2e-42e3-985c-f522379e956a",
                                "sense_id": "10a9cdd3-24bb-3960-97bf-ed128a6e5cf4",
                                "text": "„Toadvine lief lachend die Straße entlang und fuchtelte dabei wie ein Verrückter mit den Fäusten über dem Kopf herum. Er und der Junge wirkten wie zwei belebte Voodoopuppen.“"
                            },
                            {
                                "example_id": "d55ec5b4-0f6e-4b5b-a4fb-2c7a8b0c1d8a",
                                "sense_id": "10a9cdd3-24bb-3960-97bf-ed128a6e5cf4",
                                "text": "„Sie biegt und dreht daran herum, bis es die Gestalt eines Menschen annimmt, mit zwei Armen, zwei Beinen und einem Kopf. Eine Voodoopuppe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
