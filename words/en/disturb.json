{
    "word_family": [
        "disturbance",
        "disturbing",
        "disturbed",
        "disturbingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "32af62e4-9f1c-3c53-9dee-fd8e18d34be2",
                    "sense_definition": "To interrupt or break the peace, quiet, or regular state of something, such as a person's concentration or a calm surface.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "interrupt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please do not <w>disturb</w> the students while they are taking their final exam.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не <w>отвлекайте</w> студентов, пока они сдают выпускной экзамен."
                            }
                        },
                        {
                            "text": "The loud noise from the construction site will <w>disturb</w> the peace of the neighborhood.",
                            "target_lang_translations": {
                                "ru": "Громкий шум со стройки <w>нарушит</w> покой этого района."
                            }
                        }
                    ],
                    "synonyms": [
                        "bother",
                        "disconcert",
                        "trouble",
                        "interrupt",
                        "distract"
                    ],
                    "antonyms": [
                        "soothe",
                        "calm"
                    ],
                    "common_phrases": [
                        "disturb the peace",
                        "do not disturb"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прерывать или нарушать покой, тишину или обычное состояние чего-либо, например, чью-то концентрацию или спокойную поверхность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспокоить",
                                "target_lang_sense_clarification": "нарушать покой или отвлекать"
                            },
                            {
                                "target_lang_word": "мешать",
                                "target_lang_sense_clarification": "создавать помехи"
                            },
                            {
                                "target_lang_word": "нарушать",
                                "target_lang_sense_clarification": "тишину или порядок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe65aad4-9341-3e75-9cbd-378c5c1df669",
                    "sense_definition": "To cause someone to feel anxious, upset, or emotionally distressed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_distress",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The news about the accident began to <w>disturb</w> her deeply as she waited for updates.",
                            "target_lang_translations": {
                                "ru": "Новости об аварии начали сильно её <w>тревожить</w>, пока она ждала свежих данных."
                            }
                        },
                        {
                            "text": "It might <w>disturb</w> the balance of his mind to see such a tragic event.",
                            "target_lang_translations": {
                                "ru": "Вид такого трагического события может <w>пошатнуть</w> его душевное равновесие."
                            }
                        }
                    ],
                    "synonyms": [
                        "agitate",
                        "perturb",
                        "unsettle",
                        "upset"
                    ],
                    "antonyms": [
                        "comfort",
                        "reassure"
                    ],
                    "common_phrases": [
                        "disturb the mind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять кого-либо чувствовать тревогу, расстройство или эмоциональное потрясение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тревожить",
                                "target_lang_sense_clarification": "вызывать беспокойство или волнение"
                            },
                            {
                                "target_lang_word": "волновать",
                                "target_lang_sense_clarification": "вызывать сильные эмоции"
                            },
                            {
                                "target_lang_word": "расстраивать",
                                "target_lang_sense_clarification": "приводить в уныние или огорчать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e27e7897-abfb-3fb7-9571-397058b7134c",
                    "sense_definition": "To change the position, arrangement, or natural course of something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "alteration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful not to <w>disturb</w> the documents on the desk because they are in a specific order.",
                            "target_lang_translations": {
                                "ru": "Будьте осторожны, не <w>трогайте</w> документы на столе, потому что они лежат в определенном порядке."
                            }
                        },
                        {
                            "text": "A massive mudslide managed to <w>disturb</w> the course of the river over many years.",
                            "target_lang_translations": {
                                "ru": "Массивному оползню удалось <w>изменить</w> русло реки на многие годы."
                            }
                        }
                    ],
                    "synonyms": [
                        "muddle",
                        "roil",
                        "unsettle"
                    ],
                    "antonyms": [
                        "arrange",
                        "fix"
                    ],
                    "common_phrases": [
                        "disturb the course"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменять положение, расположение или естественный ход чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трогать",
                                "target_lang_sense_clarification": "сдвигать с места или нарушать порядок"
                            },
                            {
                                "target_lang_word": "нарушать",
                                "target_lang_sense_clarification": "естественный ход или структуру"
                            },
                            {
                                "target_lang_word": "переставлять",
                                "target_lang_sense_clarification": "менять расположение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b7980b0e-92e7-362c-b4ff-d1342aec3553",
                    "sense_definition": "An instance of <w>disturbance</w> or the act of being interrupted.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "interrupt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden alarm caused a great <w>disturb</w> among the birds in the forest.",
                            "target_lang_translations": {
                                "ru": "Внезапная тревога вызвала большое <w>беспокойство</w> среди лесных птиц."
                            }
                        },
                        {
                            "text": "Instant without <w>disturb</w> they took alarm and fled from the clearing.",
                            "target_lang_translations": {
                                "ru": "Мгновенно, без лишнего <w>шума</w>, они встревожились и скрылись с поляны."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used as a noun meaning disturbance"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Случай нарушения порядка или акт прерывания чего-либо (устаревшее использование в качестве существительного)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспокойство",
                                "target_lang_sense_clarification": "состояние тревоги или помеха"
                            },
                            {
                                "target_lang_word": "нарушение",
                                "target_lang_sense_clarification": "акта прерывания тишины или покоя"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
