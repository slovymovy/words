                    "frequency": "Low",
                    "semantic_group_id": "sommeil_engourdissement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce médicament puissant risque de vous <w>assommer</w> pendant plusieurs heures."
                        },
                        {
                            "text": "La chaleur étouffante de l'après-midi a fini par <w>assommer</w> les voyageurs dans le train."
