{
    "word_family": [
        "growth",
        "grower",
        "regrowth",
        "outgrowth",
        "overgrowth",
        "ingrowth"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7410c4f6-9cd3-396c-aee5-ab87173d19f2",
                    "sense_definition": "The past participle of <w>grow</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The population of the city has <w>grown</w> rapidly.",
                            "target_lang_translations": {
                                "ru": "Население города быстро <w>выросло</w>.",
                                "zh": "这座城市的人口已经迅速<w>增长</w>了。"
                            }
                        },
                        {
                            "text": "She has <w>grown</w> into a very confident leader.",
                            "target_lang_translations": {
                                "ru": "Она <w>выросла</w> в очень уверенного лидера.",
                                "zh": "她已经<w>成长</w>为一名非常自信的领导者。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие прошедшего времени от глагола grow (расти).",
                        "zh": "动词 grow 的过去分词形式，表示生长、发育或增加。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выросший",
                                "target_lang_sense_clarification": "причастие от 'расти'; ставший больше или взрослее"
                            },
                            {
                                "target_lang_word": "увеличившийся",
                                "target_lang_sense_clarification": "ставший больше по размеру или количеству"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "增长",
                                "target_lang_sense_clarification": "指数量、规模或程度的增加"
                            },
                            {
                                "target_lang_word": "成长",
                                "target_lang_sense_clarification": "指人或事物的发育、成熟过程"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7bf64cec-8563-356f-a794-39b38c9ba6e9",
                    "sense_definition": "Having reached full physical or mental maturity.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a <w>grown</w> man and can make his own decisions.",
                            "target_lang_translations": {
                                "ru": "Он <w>взрослый</w> мужчина и может сам принимать решения.",
                                "zh": "他是一个<w>成年</w>人，可以自己做决定。"
                            }
                        },
                        {
                            "text": "They have three <w>grown</w> children who live nearby.",
                            "target_lang_translations": {
                                "ru": "У них трое <w>взрослых</w> детей, которые живут неподалеку.",
                                "zh": "他们有三个<w>成年</w>的孩子住在附近。"
                            }
                        }
                    ],
                    "synonyms": [
                        "grown up",
                        "mature",
                        "full-grown",
                        "adult"
                    ],
                    "common_phrases": [
                        "grown man",
                        "grown woman",
                        "full grown"
                    ],
                    "target_lang_definitions": {
                        "ru": "Достигший полной физической или умственной зрелости.",
                        "zh": "指已达到完全成熟的身体或心理状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взрослый",
                                "target_lang_sense_clarification": "о человеке, достигшем зрелости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "成年",
                                "target_lang_sense_clarification": "指人已达到法定或生理上的成熟年龄"
                            },
                            {
                                "target_lang_word": "成熟",
                                "target_lang_sense_clarification": "指在心理或生理上发育完全"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90119f55-7615-3554-9cd2-6ddd89917c77",
                    "sense_definition": "Covered by vegetation or natural growth.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old farmhouse was <w>grown</w> with ivy and moss.",
                            "target_lang_translations": {
                                "ru": "Старый фермерский дом <w>порос</w> плющом и мхом.",
                                "zh": "那座老农舍<w>长满</w>了常春藤和苔藓。"
                            }
                        },
                        {
                            "text": "The path had been <w>grown</w> over by thick weeds.",
                            "target_lang_translations": {
                                "ru": "Тропинка <w>заросла</w> густыми сорняками.",
                                "zh": "这条小路已经被茂密的杂草<w>覆盖</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "grown over",
                        "grown with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрытый растительностью.",
                        "zh": "指被植被或自然生长的植物所覆盖。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поросший",
                                "target_lang_sense_clarification": "покрытый чем-то растущим (травой, мхом)"
                            },
                            {
                                "target_lang_word": "заросший",
                                "target_lang_sense_clarification": "полностью покрытый растительностью"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "长满",
                                "target_lang_sense_clarification": "指表面被植物覆盖"
                            },
                            {
                                "target_lang_word": "杂草丛生",
                                "target_lang_sense_clarification": "形容被杂草覆盖，通常指荒废的地方"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}