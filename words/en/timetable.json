{
    "word_family": [
        "timetabling"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aafb321e-4926-30cd-bc9b-2f30f071298a",
                    "sense_definition": "A list or chart showing the times at which events, such as classes or transport arrivals and departures, are planned to occur.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "schedule",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The train <w>timetable</w> has been changed several times since it was first announced.",
                            "target_lang_translations": {
                                "ru": "Железнодорожное <w>расписание</w> менялось несколько раз с момента его первого объявления."
                            }
                        },
                        {
                            "text": "I need to check the school <w>timetable</w> to see which classroom we are in today.",
                            "target_lang_translations": {
                                "ru": "Мне нужно проверить школьное <w>расписание</w>, чтобы узнать, в каком классе мы сегодня занимаемся."
                            }
                        }
                    ],
                    "synonyms": [
                        "schedule",
                        "timeline"
                    ],
                    "common_phrases": [
                        "train timetable",
                        "school timetable",
                        "bus timetable",
                        "official timetable"
                    ],
                    "target_lang_definitions": {
                        "ru": "Список или таблица, показывающая время запланированных событий, таких как занятия или прибытие и отправление транспорта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расписание",
                                "target_lang_sense_clarification": "основное слово для занятий и транспорта"
                            },
                            {
                                "target_lang_word": "график",
                                "target_lang_sense_clarification": "план выполнения работ или движения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47b4a4ee-06e5-320b-a425-73ccd9181219",
                    "sense_definition": "A printed book, booklet, or pamphlet containing schedules of arrivals and departures for travelers.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "schedule",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The station master handed me a free <w>timetable</w> that listed all the new services.",
                            "target_lang_translations": {
                                "ru": "Начальник станции вручил мне бесплатное <w>расписание</w>, в котором были указаны все новые рейсы."
                            }
                        },
                        {
                            "text": "He carried a small <w>timetable</w> in his pocket to keep track of the ferry times.",
                            "target_lang_translations": {
                                "ru": "Он носил в кармане маленькое <w>расписание</w>, чтобы следить за временем отправления паромов."
                            }
                        }
                    ],
                    "synonyms": [
                        "schedule"
                    ],
                    "common_phrases": [
                        "printed timetable",
                        "pocket timetable"
                    ],
                    "target_lang_definitions": {
                        "ru": "Печатная книга, буклет или брошюра, содержащая расписание прибытия и отправления для путешественников."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расписание",
                                "target_lang_sense_clarification": "печатное издание с графиком движения"
                            },
                            {
                                "target_lang_word": "справочник расписаний",
                                "target_lang_sense_clarification": "книжка с информацией о рейсах"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "04659b46-a471-33ac-a5c5-27a0a21ae248",
                    "sense_definition": "To arrange or set a specific time for an event, class, or activity to take place.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "scheduling_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have <w>timetabled</w> the meeting for Monday afternoon to ensure everyone can attend.",
                            "target_lang_translations": {
                                "ru": "Я <w>назначил</w> встречу на вторую половину понедельника, чтобы все смогли присутствовать."
                            }
                        },
                        {
                            "text": "The university needs to <w>timetable</w> the exams carefully to avoid any room conflicts.",
                            "target_lang_translations": {
                                "ru": "Университету необходимо тщательно <w>составить расписание</w> экзаменов, чтобы избежать накладок с аудиториями."
                            }
                        }
                    ],
                    "synonyms": [
                        "schedule"
                    ],
                    "common_phrases": [
                        "timetable a meeting",
                        "timetable a class"
                    ],
                    "target_lang_definitions": {
                        "ru": "Назначать или устанавливать определенное время для проведения мероприятия, занятия или деятельности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "составлять расписание",
                                "target_lang_sense_clarification": "планировать время мероприятий"
                            },
                            {
                                "target_lang_word": "включать в расписание",
                                "target_lang_sense_clarification": "назначать время для чего-либо"
                            },
                            {
                                "target_lang_word": "планировать",
                                "target_lang_sense_clarification": "устанавливать сроки"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}