                                "target_senses": [
                                    {
                                        "sense_id": "abdb48c2-b1a7-320e-aaa2-7b3756307dd5",
                                        "entry_id": "dc77ffa1-fcda-30b5-ac43-fce53fe9f526",
                                        "glosses": [
                                            "A descendant of European settlers who is born in a colonized country."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8ff48a7-e6d7-4af8-8c14-e6d754b88f3d",
                                                "sense_id": "abdb48c2-b1a7-320e-aaa2-7b3756307dd5",
                                                "text": "Within the Spanish society, a great difference evolved between the Insular Spaniards, sent over for different periods of time from Spain, to serve as officials, etc., and the \"native\" Spaniards, the Creoles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d390b718-8429-3be8-9d24-c5935b01b1b4",
                                        "entry_id": "dc77ffa1-fcda-30b5-ac43-fce53fe9f526",
                                        "glosses": [
                                            "Anyone with mixed ancestry born in a country colonized by Europeans, now especially one who speaks a creole language."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2dd66cbd-c5b8-3542-a3db-5b3a2889e5f7",
                                        "entry_id": "dc77ffa1-fcda-30b5-ac43-fce53fe9f526",
                                        "glosses": [
                                            "Someone of African descent who is born in the Caribbean or Americas (originally as opposed to an African immigrant)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ffb8e92d-6498-3ef8-a4ed-537efc7a3b53",
                                        "entry_id": "dc77ffa1-fcda-30b5-ac43-fce53fe9f526",
                                        "glosses": [
                                            "A native-born of Francophone descent in the Louisiana territory of any race, as opposed to Anglo-American settlers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
