                                "sense_id": "4e3e5d8c-a8a1-33e1-ac9b-2c56552f42f7",
                                "text": "De sterrenbeelden voor oktober zijn Weegschaal en Schorpioen."
                            },
                            {
                                "example_id": "d2187379-5cbc-483f-aba9-879db8fcb224",
                                "sense_id": "4e3e5d8c-a8a1-33e1-ac9b-2c56552f42f7",
                                "text": "De eerste versie van Zappas' Olympische Spelen werd verspreid over een aantal weekeinden, georganiseerd in oktober 1859."
                            },
                            {
                                "example_id": "b2ae4f47-589c-44e5-9902-8ccba19e9704",
                                "sense_id": "4e3e5d8c-a8a1-33e1-ac9b-2c56552f42f7",
                                "text": "De laatste crash, van de Europese lander Schiaparelli, vond ruim vier jaar geleden plaats, in oktober 2016."
                            }
                        ]
                    }
