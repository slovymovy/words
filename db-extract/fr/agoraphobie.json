                        "translation_id": "57fb760c-5890-46ed-ab87-2a318f3e0be3",
                        "source_entry_id": "7046afd3-47d4-3f22-94fe-1a1cb7bb48e6",
                        "source_sense_id": "3cfe8836-b671-3b8d-a79a-f636e9c1a76b",
                        "source_sense_description": "Platzangst, Agoraphobie",
                        "target_lang_word": "Platzangst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Platzangst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fde56b54-e67a-3c9d-bf5d-41c24eea43cd",
                                        "entry_id": "2cf43c22-9d34-3849-946a-2b53789de0a2",
                                        "glosses": [
                                            "krankhafte Angst vor weiten Plätzen, Menschenmengen oder Reisen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bafebe4-0d96-42cd-9a21-60270f7edb2e",
                                                "sense_id": "fde56b54-e67a-3c9d-bf5d-41c24eea43cd",
                                                "text": "Wegen seiner Platzangst geht Karl auf kein Festival."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ac33c854-cc6b-3ef1-9b4d-ffd1b774a7bd",
                                        "entry_id": "2cf43c22-9d34-3849-946a-2b53789de0a2",
                                        "glosses": [
                                            "krankhafte Angst bei wenig Platz (engen Räumen und Ähnlichem)"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "712a08c0-869d-426d-b664-000da3074e56",
                                                "sense_id": "ac33c854-cc6b-3ef1-9b4d-ffd1b774a7bd",
                                                "text": "Er leidet unter Platzangst, selbst Aufzüge bereiten ihm Angst."
                                            },
                                            {
                                                "example_id": "675b3ded-db5d-4d9a-9c6d-dc615119cfbe",
                                                "sense_id": "ac33c854-cc6b-3ef1-9b4d-ffd1b774a7bd",
                                                "text": "„Er kroch durch die niedrigsten Schächte, bis er sich an seine Platzangst gewöhnt hatte wie an einen nicht nachlassenden, allmählich jedoch erträglichen Schmerz.“"
                                            },
                                            {
                                                "example_id": "d57e8895-4aa1-46f2-9f99-040c34331157",
                                                "sense_id": "ac33c854-cc6b-3ef1-9b4d-ffd1b774a7bd",
                                                "text": "„Ich versuchte, durch gedankliche Ablenkungsmanöver der sich heranpirschenden Platzangst zu entgehen.“"
                                            },
                                            {
                                                "example_id": "7c8ceca1-060b-4882-9619-6a8d7dd8b72a",
                                                "sense_id": "ac33c854-cc6b-3ef1-9b4d-ffd1b774a7bd",
                                                "text": "„Er denkt an nichts, aber diesmal empfindet er die Leere als lastend, eine Platzangst in seinem Innern, die ihn verstört.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1462db4-5d20-4d07-a6e9-64325ae727c8",
                        "source_entry_id": "7046afd3-47d4-3f22-94fe-1a1cb7bb48e6",
                        "source_sense_id": "3cfe8836-b671-3b8d-a79a-f636e9c1a76b",
