                {
                    "sense_id": "27625268-fe8f-3b04-9ba6-2a650b1f32e5",
                    "sense_definition": "Délivrer ou se libérer d'une mauvaise habitude, d'une illusion ou d'un tourment moral.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette dure leçon va le <w>guérir</w> de sa trop grande naïveté.",
                            "target_lang_translations": {
                                "en": "This harsh lesson will <w>cure</w> him of his excessive naivety.",
                                "ru": "Этот суровый урок <w>отучит</w> его от чрезмерной наивности.",
                                "nl": "Deze harde les zal hem van zijn al te grote naïviteit <w>genezen</w>.",
                                "de": "Diese harte Lektion wird ihn von seiner allzu großen Naivität <w>kurieren</w>.",
                                "pl": "Ta surowa lekcja <w>wyleczy</w> go z jego zbyt wielkiej naiwności.",
                                "it": "Questa dura lezione lo <w>guarirà</w> dalla sua eccessiva ingenuità.",
                                "cs": "Tato tvrdá lekce ho <w>vyléčí</w> z jeho přehnané naivity.",
                                "tr": "Bu sert ders, onu aşırı safdilliğinden <w>kurtaracak</w>.",
                                "es": "Esta dura lección lo <w>curará</w> de su excesiva ingenuidad.",
                                "zh": "这次惨痛的教训会让他<w>摆脱</w>过分天真的毛病。"
                            }
                        },
                        {
                            "text": "Il tente de se <w>guérir</w> d'une vieille rancune qui le rongeait.",
                            "target_lang_translations": {
                                "en": "He is trying to <w>cure</w> himself of an old grudge that was eating away at him.",
                                "ru": "Он пытается <w>избавиться</w> от старой обиды, которая его грызла.",
                                "nl": "Hij probeert zich te <w>genezen</w> van een oude wrok die aan hem knaagde.",
                                "de": "Er versucht, <w>sich</w> von einem alten Groll zu <w>kurieren</w>, der an ihm nagte.",
                                "pl": "Próbuje <w>się wyleczyć</w> z dawnej urazy, która go zżerała.",
                                "it": "Cerca di <w>liberarsi</w> da un vecchio rancore che lo rodeva.",
                                "cs": "Snaží se, aby <w>se zbavil</w> staré zášti, která ho hlodala.",
                                "tr": "Onu kemiren eski bir kinden <w>kurtulmaya</w> çalışıyor.",
                                "es": "Intenta <w>curarse</w> de un viejo rencor que lo corroía.",
                                "zh": "他试图<w>摆脱</w>一段折磨他的陈年旧怨。"
                            }
                        }
