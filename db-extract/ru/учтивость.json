                "translations": [
                    {
                        "translation_id": "b2b4e02a-1327-485a-87a2-64c98de737ff",
                        "source_entry_id": "51a6d2e9-c393-37c1-a830-7c579754a5ae",
                        "source_sense_id": "3fa49461-3792-32ec-8c78-7d1b6700816d",
                        "target_lang_word": "civility",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "civility",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9a517cc-f666-35e8-9586-5997e0789206",
                                        "entry_id": "a80d3219-5c97-30ed-b9e5-8345b3059a1f",
                                        "glosses": [
                                            "Speech or behaviour that is fit for civil interactions; politeness, courtesy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63460dee-f4e3-47aa-be14-2027e6b7608b",
                                                "sense_id": "d9a517cc-f666-35e8-9586-5997e0789206",
                                                "text": "This is an exact Inventory of what we found about the Body of the Man-Mountain, who uſed us with great Civility, and due Reſpect to your Majefty's Commiſſion."
                                            },
                                            {
                                                "example_id": "03985b64-a150-4b9c-9917-a7e1e048a709",
                                                "sense_id": "d9a517cc-f666-35e8-9586-5997e0789206",
                                                "text": "December 1749 Philip Stanhope, 4th Earl of Chesterfield, letter to his son\nThe insolent civility of a proud man is, if possible, more shocking than his rudeness could be."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c90146ae-14d3-3a56-90e1-3cbebe551f86",
                                        "entry_id": "a80d3219-5c97-30ed-b9e5-8345b3059a1f",
                                        "glosses": [
                                            "An individual act or expression of polite behaviour; a courtesy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd585431-bc33-4816-96e9-1792f6da1777",
                                                "sense_id": "c90146ae-14d3-3a56-90e1-3cbebe551f86",
                                                "text": "Mr Lovelace received from every one those civilities which were due to his birth […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d490152-ddba-3acf-a0a7-89cea8a810fa",
                                        "entry_id": "a80d3219-5c97-30ed-b9e5-8345b3059a1f",
                                        "glosses": [
                                            "The state or fact of being civilized; civilization."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "586adb2d-d4fe-4968-a4aa-b339e3f3ea90",
                                                "sense_id": "0d490152-ddba-3acf-a0a7-89cea8a810fa",
                                                "text": "Monarchies have risen from barbarism to civility, and fallen again to ruin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f94f424b-84d1-322d-871f-ab161eb13317",
                                        "entry_id": "a80d3219-5c97-30ed-b9e5-8345b3059a1f",
                                        "glosses": [
                                            "A civil office; a civil capacity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f435eebd-2e0f-45cc-997d-cc5161cfb891",
                                                "sense_id": "f94f424b-84d1-322d-871f-ab161eb13317",
                                                "text": "For what an enormity is this in a chriſtian realme to ſerue in a ciuility, hauinge the profyt of a Prouoſtſhip and a Deanrye, and a Perſonage? But I wil tel you what is lyke to come of it. It wil bring the clergy ſhortly into a very ſlauery."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3df346a7-bfe0-4d18-902f-906b4f75b3d1",
                        "source_entry_id": "51a6d2e9-c393-37c1-a830-7c579754a5ae",
                        "source_sense_id": "3fa49461-3792-32ec-8c78-7d1b6700816d",
                        "target_lang_word": "courtesy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "courtesy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31b4b823-0ef3-34e2-8249-bccbc5947595",
                                        "entry_id": "5dfb85e2-38bd-38e0-add3-82cba3bb1e4a",
                                        "glosses": [
                                            "Polite behavior."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "543ef2e2-5e64-4e90-8bc5-722c57de5b8b",
                                                "sense_id": "31b4b823-0ef3-34e2-8249-bccbc5947595",
                                                "text": "Please extend them the courtesy of your presence."
                                            },
                                            {
                                                "example_id": "2b87370e-b0e3-4f90-9960-4b8ce2a86693",
                                                "sense_id": "31b4b823-0ef3-34e2-8249-bccbc5947595",
                                                "text": "He was always known for his grace, kindness, and courtesy to people of every rank."
                                            },
                                            {
                                                "example_id": "df7fd945-0b3c-40b5-904e-4da1f595b554",
                                                "sense_id": "31b4b823-0ef3-34e2-8249-bccbc5947595",
                                                "text": "Rabbit doesn't want to tell him anything. The more he tells, the more he loses. He's safe inside his own skin, he doesn't want to come out. This guy's whole game is to get him out into the open where he can be manipulated. But the fierce convention of courtesy pries open Rabbit's lips."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62e6a8c7-dd4e-3b57-a08f-b143e4ae36aa",
                                        "entry_id": "5dfb85e2-38bd-38e0-add3-82cba3bb1e4a",
                                        "glosses": [
                                            "A polite gesture or remark, especially as opposed to an obligation or standard practice."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "976bf96b-437e-4d8e-968d-3d13f879d6fd",
                                                "sense_id": "62e6a8c7-dd4e-3b57-a08f-b143e4ae36aa",
                                                "text": "I offered them a ride simply as a courtesy."
                                            },
                                            {
                                                "example_id": "37cb6746-3949-476d-8fb8-6e89e77c8608",
                                                "sense_id": "62e6a8c7-dd4e-3b57-a08f-b143e4ae36aa",
                                                "text": "My lord, for your many courtesies I thank you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "377c0e6e-2b00-3418-a6fe-2e82885439c6",
                                        "entry_id": "5dfb85e2-38bd-38e0-add3-82cba3bb1e4a",
                                        "glosses": [
                                            "Consent or agreement in spite of fact; indulgence."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa5c3842-1945-4383-b9fb-fec7517bd632",
                                                "sense_id": "377c0e6e-2b00-3418-a6fe-2e82885439c6",
                                                "text": "They call this pond a lake by courtesy only."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00242e77-3609-3cb3-9736-7991c7dff120",
                                        "entry_id": "5dfb85e2-38bd-38e0-add3-82cba3bb1e4a",
                                        "glosses": [
                                            "Willingness or generosity in providing something needed."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf86eb31-e180-42b4-be7f-ddcbc6566a95",
                                                "sense_id": "00242e77-3609-3cb3-9736-7991c7dff120",
                                                "text": "They received free advertising through the courtesy of the local newspaper."
                                            },
                                            {
                                                "example_id": "4905db6d-1465-4cbb-9dd2-98c41061cc05",
                                                "sense_id": "00242e77-3609-3cb3-9736-7991c7dff120",
                                                "text": "[on a label, caption, etc.] Courtesy the Smith Foundation: [e.g.] use of this image was allowed through the courtesy of the Smith Foundation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd5dd16c-e874-3c2e-9d4e-27b50d444207",
                                        "entry_id": "5dfb85e2-38bd-38e0-add3-82cba3bb1e4a",
                                        "glosses": [
                                            "A curtsey."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e478e550-cd1d-405b-a58d-767aeada387f",
                                                "sense_id": "fd5dd16c-e874-3c2e-9d4e-27b50d444207",
                                                "text": "The lady drops a courtesy in token of obedience, and the ceremony proceeds as usual."
                                            },
                                            {
                                                "example_id": "c052f638-94b4-4007-9952-0908991bd959",
                                                "sense_id": "fd5dd16c-e874-3c2e-9d4e-27b50d444207",
                                                "text": "[I]t was her favorite amusement to array herself in the faded brocades, and parade up and down before the long mirror, making stately courtesies, and sweeping her train about, with a rustle which delighted her ears."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cb48f82-c1e4-3127-9665-f90d217a76b6",
                                        "entry_id": "5dfb85e2-38bd-38e0-add3-82cba3bb1e4a",
                                        "glosses": [
                                            "The life interest that the surviving husband has in the real or heritable estate of his wife."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
