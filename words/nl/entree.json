                        {
                            "text": "De <w>entree</w> van het nieuwe kantoor is erg licht en ruim.",
                            "target_lang_translations": {
                                "ru": "<w>Вход</w> в новый офис очень светлый и просторный.",
                                "en": "The <w>entrance</w> of the new office is very light and spacious.",
                                "pl": "<w>Wejście</w> do nowego biura jest bardzo jasne i przestronne.",
                                "de": "Der <w>Eingang</w> des neuen Büros ist sehr hell und geräumig.",
                                "fr": "L'<w>entrée</w> du nouveau bureau est très lumineuse et spacieuse.",
                                "it": "L'<w>ingresso</w> del nuovo ufficio è molto luminoso e spazioso.",
                                "cs": "<w>Vstup</w> do nové kanceláře je velmi světlý a prostorný.",
                                "tr": "Yeni ofisin <w>girişi</w> çok aydınlık ve geniş.",
                                "es": "La <w>entrada</w> de la nueva oficina es muy luminosa y espaciosa.",
                                "zh": "新办公室的<w>入口</w>非常明亮宽敞。"
                            }
                        },
                        {
                            "text": "Wacht je op mij bij de <w>entree</w> van de bioscoop?",
                            "target_lang_translations": {
                                "ru": "Ты подождешь меня у <w>входа</w> в кинотеатр?",
                                "en": "Will you wait for me at the <w>entrance</w> of the cinema?",
                                "pl": "Poczekasz na mnie przy <w>wejściu</w> do kina?",
                                "de": "Wartest du am <w>Eingang</w> des Kinos auf mich?",
                                "fr": "Tu m'attends à l'<w>entrée</w> du cinéma ?",
                                "it": "Mi aspetti all'<w>ingresso</w> del cinema?",
                                "cs": "Počkáš na mě u <w>vchodu</w> do kina?",
                                "tr": "Sinemanın <w>girişinde</w> beni bekler misin?",
                                "es": "¿Me esperas en la <w>entrada</w> del cine?",
                                "zh": "你能在电影院<w>入口</w>等我吗？"
                            }
