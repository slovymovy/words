                        ],
                        "examples": [
                            {
                                "example_id": "4835f283-dbca-4a2a-8c6b-cbd1c5e6535b",
                                "sense_id": "f7337f14-d3ee-3ff0-af33-9fa34af1fd1b",
                                "text": "Nous irions, elle et moi, prendre l’apéritif à la terrasse du plus grand café de Paris. Pour nous faire un passage, le garçon remuerait les guéridons comme des tonneaux."
                            }
                        ]
                    }
