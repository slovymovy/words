                    },
                    {
                        "translation_id": "71f378d9-67fe-471e-8816-c0b1ca0cc137",
                        "source_entry_id": "b2145689-e1d2-3a99-b8ec-2138f0a632a0",
                        "source_sense_description": "language",
                        "target_lang_word": "Komi",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Komi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e7d50d3-18ee-38b0-b6b5-05c68ae7ece2",
                                        "entry_id": "036b5ea8-2ef4-34cf-819c-37ddb0036d64",
                                        "glosses": [
                                            "eine finno-ugrische Sprache mit zwei Schriftvarianten, die in Nordwestrussland gesprochen wird; wird auch als Gruppe zweier Sprachen betrachtet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9c3ae89-e154-40d5-b5ce-1f5bb74c7d35",
                                                "sense_id": "5e7d50d3-18ee-38b0-b6b5-05c68ae7ece2",
                                                "text": "„Das Sprachgebiet des Komi erstreckt sich zuvorderst auf die Republik Komi […] als Teil Russlands, die im äußersten Nordosten Europas liegt (im Osten durch den Ural von Sibirien getrennt);“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Komi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "45c2b20c-81ab-3a57-84a2-ab7cb6f991f4",
                                        "entry_id": "4af7208a-a8c0-381a-bd96-00fd9cee93f1",
                                        "glosses": [
                                            "Angehöriger einer mehrerer Ethnien, die in Nordwestrussland leben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f8a2a72-7250-47fd-93a2-5568b3fed975",
                                                "sense_id": "45c2b20c-81ab-3a57-84a2-ab7cb6f991f4",
                                                "text": "„Insgesamt gibt es heute etwa eine halbe Million Komi.“"
                                            },
                                            {
                                                "example_id": "a13bf641-24de-4a0d-b04f-57d42eac8ec6",
                                                "sense_id": "45c2b20c-81ab-3a57-84a2-ab7cb6f991f4",
                                                "text": "„Nach der Christianisierung im 14. Jahrhundert wurden die Komi im Zuge der russischen Staatswerdung zunehmend in das Gebiet zwischen den Flüssen Kama, Pečora und Vyčegda zurückgedrängt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ed10ef5-f937-416b-9a72-ee35902c833c",
                        "source_entry_id": "b2145689-e1d2-3a99-b8ec-2138f0a632a0",
