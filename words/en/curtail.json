                    "sense_definition": "To limit or restrict something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "limit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "New laws were introduced to <w>curtail</w> the power of large corporations."
                        },
                        {
                            "text": "The government must <w>curtail</w> spending to avoid a national debt crisis."
                        }
                    ],
                    "synonyms": [
