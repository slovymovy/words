                "senses": [
                    {
                        "sense_id": "ce0b830a-8b29-3868-bb85-40bf8426cf1d",
                        "entry_id": "00fadff0-ee69-39a9-8ecc-90320ecb6445",
                        "glosses": [
                            "Mann, der in künstlerischer oder humoristischer Praktizierung von Travestie durch Aussehen und Verhalten eine Frau darstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "854ea0d5-a7c5-4cf5-8d40-80d4934f4488",
                                "sense_id": "ce0b830a-8b29-3868-bb85-40bf8426cf1d",
                                "text": "Nachdem Dragqueen Marcel Kaupp als Frau verkleidet den Whitney-Houston-Hit „One Moment in Time“ gesungen hatte, gesteht Modedesigner Guido Maria Kretschmer dem 26-jährigen Kölner mit verklärtem Blick: „Jedesmal wenn ich Dich treffe, denke ich: Ach, der könnte mein Freund werden!“ Danach kann es eigentlich nicht mehr schief gehen, und tatsächlich wird Kaupp von den Zuschauern prompt zum „Supertalent 2014“ gewählt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e6f1f19-483b-4581-b3a5-d5145a01495c",
                        "source_entry_id": "00fadff0-ee69-39a9-8ecc-90320ecb6445",
                        "source_sense_id": "ce0b830a-8b29-3868-bb85-40bf8426cf1d",
                        "source_sense_description": "Mann, der durch Aussehen und Verhalten eine Frau darstellt",
                        "target_lang_word": "drag queen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drag queen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db7f6d95-6ae0-3fe2-941d-fa60579cf392",
                                        "entry_id": "63364495-324a-3f91-8e7f-7aee4db1031a",
                                        "glosses": [
                                            "A person, usually male, who dresses up in women's clothing and makeup, typically in an exaggerated fashion and for public performance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65aa993e-e423-47f8-ac4e-84c77d39b3f4",
                                                "sense_id": "db7f6d95-6ae0-3fe2-941d-fa60579cf392",
                                                "text": "Donald was donning a brand new pair of pantyhose. He hadn’t shaved in a while, and he could feel his stubble snag on the nylon. It’s not pretty when a drag queen gets careless, he thought, but it was too late to do anything about it tonight."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de9cb64c-4dd9-4038-9f03-5ffff9cfd464",
                        "source_entry_id": "00fadff0-ee69-39a9-8ecc-90320ecb6445",
                        "source_sense_id": "ce0b830a-8b29-3868-bb85-40bf8426cf1d",
                        "source_sense_description": "Mann, der durch Aussehen und Verhalten eine Frau darstellt",
                        "target_lang_word": "drag queen",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drag queen",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "97b51abd-bb7d-3486-a3b1-bda62c7dc9e5",
                                        "entry_id": "17ee4e4f-1d63-3429-823b-d40fa9eb72b9",
                                        "glosses": [
                                            "Personne (généralement un homme) qui habillée souvent de façon exagérément féminine, afin de donner une performance de la féminité ou en imitant des femmes célèbres, pour amuser ou à titre d’animation et de spectacle."
                                        ],
                                        "tags": [
                                            "LGBTQ"
                                        ],
                                        "note": "Souvent écrit en italique ou entre guillemets parce que encore ressenti comme un emprunt à l'anglais",
                                        "examples": [
                                            {
                                                "example_id": "6b8fe863-c133-4f1c-9241-9d387f15e211",
                                                "sense_id": "97b51abd-bb7d-3486-a3b1-bda62c7dc9e5",
                                                "text": "Il ne faut pas oublier qu’initialement la drag queen appartient au monde du spectacle. Une drag queen est une personne, généralement un homme, qui s’habille et se maquille dans le but de ressembler à une femme : parfois à une femme célèbre, mais pas nécessairement. La drag queen tend à sortir « en homme » dans la journée et à n’être en drag que la nuit."
                                            },
                                            {
                                                "example_id": "35c6234b-dceb-4f6d-a3a4-c4d8f503f10d",
                                                "sense_id": "97b51abd-bb7d-3486-a3b1-bda62c7dc9e5",
                                                "text": "Dix épisodes seront diffusés lors de la deuxième saison de ce concours télévisuel de drag queens, dont le prix est assorti d’un chèque de 100 000 $."
                                            },
                                            {
                                                "example_id": "5ba09e80-5e50-4404-9745-35dde6032ecb",
                                                "sense_id": "97b51abd-bb7d-3486-a3b1-bda62c7dc9e5",
                                                "text": "Comme pour tout divertissement, le fait de s’habiller en drag queen n’est pas une indication de l’orientation sexuelle de la personne, ni de son identité de genre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
