                ],
                "senses": [
                    {
                        "sense_id": "ae3c73ee-4c2b-374f-ada0-6e08646c3db8",
                        "entry_id": "9d31dc8d-fcc9-37c3-ba5a-4e48f12df82b",
                        "glosses": [
                            "deutsche Bezeichnung für Autosemantikum: Bezeichnung für Wörter, die eine eigenständige, lexikalische Bedeutung haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75d99755-8053-46f8-941b-3b1abb2bf28c",
                                "sense_id": "ae3c73ee-4c2b-374f-ada0-6e08646c3db8",
                                "text": "Wörter mit eigenständiger, lexikalischer Bedeutung wie \"Haus\", \"Tier\", Wolke\" sind Vollwörter."
                            },
                            {
                                "example_id": "9eea890b-a3e8-4f1c-becd-e075e69f74c9",
                                "sense_id": "ae3c73ee-4c2b-374f-ada0-6e08646c3db8",
                                "text": "Substantive, Verben, Adjektive und Adverbien sind Vollwörter."
                            },
                            {
                                "example_id": "abc5943d-f3ba-4050-a6f2-32d8bfe8e725",
                                "sense_id": "ae3c73ee-4c2b-374f-ada0-6e08646c3db8",
                                "text": "„Vollwörter sind Wörter, die sich unmittelbar auf eine Gegebenheit in der außersprachlichen Wirklichkeit beziehen.“"
                            },
                            {
                                "example_id": "e20fd17c-bd89-4c7b-99e4-ccbafb5aa5a0",
                                "sense_id": "ae3c73ee-4c2b-374f-ada0-6e08646c3db8",
                                "text": "„Als sogenannte Vollwörter können sie Satzglieder oder Gliedteile, im Grenzfall Sätze verkörpern (Verb, Substantiv, Adjektiv, Pronomen, Adverb)…“"
                            },
                            {
                                "example_id": "409dc836-ae1b-4007-8677-4a4dc8214816",
                                "sense_id": "ae3c73ee-4c2b-374f-ada0-6e08646c3db8",
                                "text": "„Mit dem Wortzeichen kann man verallgemeinernd benennen und im konkreten Redeakt auf etwas referieren. Wortzeichen, die diese Benennungsfunktion haben, Vollwörter sind, werden auch als Lexeme (…) bezeichnet.“"
                            },
                            {
                                "example_id": "edd81181-9cbe-4dbf-a7fc-240b7fd22a67",
                                "sense_id": "ae3c73ee-4c2b-374f-ada0-6e08646c3db8",
                                "text": "„Den Hilfswörtern stehen andere Wörter als Vollwörter gegenüber.“"
                            },
                            {
                                "example_id": "5f2cf55e-ec6d-4b4e-9a0f-32480acbe1d2",
                                "sense_id": "ae3c73ee-4c2b-374f-ada0-6e08646c3db8",
                                "text": "„Hier stehen Vollwörter, also kompakte Autosemantika, im Mittelpunkt, deren Sinn tradierte/konventionalisierte Texterwartungen verfremdet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
