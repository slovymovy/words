                                        "sense_id": "aa84c7e3-89fe-3084-a665-380e30cafa2a",
                                        "entry_id": "a169e37b-e8ad-37be-a1ad-ebe96371997b",
                                        "glosses": [
                                            "Groupe de pays formé par le Brésil, la Russie, l’Inde, la Chine et l’Afrique du Sud, considérés comme des superpuissances émergentes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "617f5991-8863-4ac2-8dc9-1d964dda2b7c",
                                                "sense_id": "aa84c7e3-89fe-3084-a665-380e30cafa2a",
                                                "text": "Au-delà de l’autosatisfaction qu'ils peuvent tirer d’une telle possibilité, les BRICS tiennent sans doute à éviter l’effondrement de leurs exportations."
                                            },
                                            {
                                                "example_id": "dc8548dc-07fb-4a83-8b3a-b5be4236074c",
                                                "sense_id": "aa84c7e3-89fe-3084-a665-380e30cafa2a",
                                                "text": "Les ministres des Finances des BRICS (Brésil, Russie, Inde, Chine et Afrique du Sud) doivent se réunir demain pour discuter de la question."
                                            },
                                            {
                                                "example_id": "a53796fc-bbcc-46d5-8d49-b9b2134bdbf3",
                                                "sense_id": "aa84c7e3-89fe-3084-a665-380e30cafa2a",
                                                "text": "Yevgeny Primakov … organisera un partenariat stratégique, le RIC (Russie, Inde, Chine), qui deviendra le BRICS (Brésil, Russie, Inde, Chine et Afrique du Sud), dont l'objectif économique se doublera d'objectifs politiques pour concurrencer les grandes institutions occidentales et notamment américaines."
                                            }
                                        ]
