                ],
                "senses": [
                    {
                        "sense_id": "d18a63d1-2504-32bd-9f54-9f17059fdd90",
                        "entry_id": "570ec537-7470-34ef-93db-8f5107a1d43c",
                        "glosses": [
                            "striktes Ablehnen, scharfe Verurteilung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29089fe3-4f0d-4503-9574-d0baf949e5fd",
                                "sense_id": "d18a63d1-2504-32bd-9f54-9f17059fdd90",
                                "text": "„Der Brugger Historiker Jan Hodel löst den Zwiespalt der klammheimlichen Verwendung und der öffentlichen Verdammung Wikipedias in eine patente Lösung auf: Wikipedia sei als Einstieg tauglich, nicht aber als zitierfähiger Beleg, zumal sich eine Seite schnell ändern könne.“"
                            },
                            {
                                "example_id": "a77cf843-d251-4ce0-b9c9-c32f7aa4c5ac",
                                "sense_id": "d18a63d1-2504-32bd-9f54-9f17059fdd90",
                                "text": "„Der britische Blick auf die Bombardierung Dresdens ist ein gebrochener - zwischen der Verehrung für ‚Bomber Harris‘ und der Verdammung eines Verbrechens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "97c473d8-9cfd-306f-9e13-b0818a4f74aa",
                        "entry_id": "570ec537-7470-34ef-93db-8f5107a1d43c",
                        "glosses": [
                            "Verurteilung der Sünder zu ihrer Bestrafung in der Hölle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9a9b8d0-b000-4caa-8bd6-d810ce670a01",
                                "sense_id": "97c473d8-9cfd-306f-9e13-b0818a4f74aa",
                                "text": "„Gott wolle weder den Tod des Menschen noch die Verdammung des Sünders, sondern dass sich dieser zu ihm bekehre und gerettet werde.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
