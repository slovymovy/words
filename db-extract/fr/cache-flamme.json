                "senses": [
                    {
                        "sense_id": "4d35063f-27ed-3abf-b025-3c11d677970a",
                        "entry_id": "ae662d73-1e6d-3aa5-add7-cc5bc4ae3821",
                        "glosses": [
                            "Dispositif fixé à l’extrémité du canon d’une arme à feu et destiné à atténuer l’éclair produit par le départ d’un coup de feu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb67593a-b376-40d7-87f1-fd80134c70aa",
                                "sense_id": "4d35063f-27ed-3abf-b025-3c11d677970a",
                                "text": "Malgré le cache-flamme conique emboîté à l’extrémité du canon, les aviateurs distinguent les étincelles qui l’animent à chaque salve. Bloeme entame une nouvelle passe de tir et s’applique à bien viser."
                            },
                            {
                                "example_id": "5302e402-8dfd-498b-8e5a-fb4bf23bf900",
                                "sense_id": "4d35063f-27ed-3abf-b025-3c11d677970a",
                                "text": "Sous le marteau-pilon des mortiers ennemis, les quatre blockhaus de maçonnerie étaient effondrés, et deux d’entre eux sur les défenseurs, mais le cache-flamme des fusils- mitrailleurs luisait encore au créneau des deux autres."
                            }
                        ]
                    }
                ],
