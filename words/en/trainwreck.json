    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3a17c7e3-716d-31e8-8102-efecf0473707",
                    "sense_definition": "A chaotic, disastrous, or completely ruined situation, event, or person.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disaster",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The entire marketing campaign turned out to be an absolute <w>trainwreck</w> from the start.",
                            "target_lang_translations": {
                                "pl": "Cała kampania marketingowa okazała się absolutną <w>katastrofą</w> od samego początku."
                            }
                        },
                        {
                            "text": "Nobody wanted to watch the presentation because it was clearly turning into a total <w>trainwreck</w>.",
                            "target_lang_translations": {
                                "pl": "Nikt nie chciał oglądać tej prezentacji, ponieważ wyraźnie zamieniała się w totalne <w>fiasko</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "disaster",
                        "fiasco",
                        "catastrophe"
                    ],
                    "antonyms": [
                        "success",
                        "triumph"
                    ],
                    "common_phrases": [
                        "complete trainwreck",
                        "total trainwreck"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally to describe disastrous situations or chaotic lives"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Chaotyczna sytuacja, katastrofalne wydarzenie lub osoba, której życie legło w gruzach; kompletna porażka."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "katastrofa",
                                "target_lang_sense_clarification": "całkowite niepowodzenie lub chaos"
                            },
                            {
                                "target_lang_word": "fiasko",
                                "target_lang_sense_clarification": "nieudane przedsięwzięcie"
                            },
                            {
                                "target_lang_word": "wrak człowieka",
                                "target_lang_sense_clarification": "w odniesieniu do osoby w fatalnym stanie fizycznym lub psychicznym"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "23671709-744f-3295-bd2c-dcabed4fd478",
                    "sense_definition": "To completely ruin, disrupt, or bring to disastrous failure.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disaster",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His careless remarks managed to <w>trainwreck</w> the entire negotiation process.",
                            "target_lang_translations": {
                                "pl": "Jego nieostrożne uwagi zdołały <w>zrujnować</w> cały proces negocjacji."
                            }
                        },
                        {
                            "text": "Unexpected technical issues threatened to <w>trainwreck</w> the live broadcast.",
                            "target_lang_translations": {
                                "pl": "Nieoczekiwane problemy techniczne groziły <w>położeniem</w> transmisji na żywo."
                            }
                        }
                    ],
                    "synonyms": [
                        "ruin",
                        "wreck",
                        "sabotage"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used informally as a transitive verb"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Całkowicie coś zrujnować, zniweczyć lub doprowadzić do katastrofalnej porażki."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zrujnować",
                                "target_lang_sense_clarification": "doprowadzić do ruiny lub porażki"
                            },
                            {
                                "target_lang_word": "położyć",
                                "target_lang_sense_clarification": "potocznie: zepsuć całe przedsięwzięcie"
                            },
                            {
                                "target_lang_word": "rozłożyć na łopatki",
                                "target_lang_sense_clarification": "potocznie: całkowicie zaprzepaścić"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}