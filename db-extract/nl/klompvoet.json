                "senses": [
                    {
                        "sense_id": "7ffaa09f-3a09-3447-9dd4-3e3308a9a0cf",
                        "entry_id": "0418714e-359c-341c-b335-f953df87606f",
                        "glosses": [
                            "verzamelnaam voor een aantal aangeboren en verworven misvormingen van de voet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37c433b4-3355-4da8-a943-0e918af43705",
                                "sense_id": "7ffaa09f-3a09-3447-9dd4-3e3308a9a0cf",
                                "text": "De Egyptische farao Toetanchamon werd niet vermoord maar stierf aan malaria. Dat blijkt uit een onderzoek van wetenschappers uit Egypte, Italië en Duitsland. Verder was de farao een zwakke jongen die aan vele aandoeningen leed, zoals een klompvoet."
                            },
                            {
                                "example_id": "022f0458-b3a1-46c9-a971-ec24515ed7d0",
                                "sense_id": "7ffaa09f-3a09-3447-9dd4-3e3308a9a0cf",
                                "text": "Wanneer de koolstofmonoxide de zuurstof uit het bloed verdringt, kunnen geboortedefecten ontstaan. Van der Houwen: ,,Er is een duidelijk verband met een open gehemelte en er bestaat een aannemelijk verband met een klompvoet. Als de moeder rookt, loopt haar kind 28 procent meer kans op deze aandoeningen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d347c4ed-1482-4c8d-b8d9-9f64cfdec22c",
                        "source_entry_id": "0418714e-359c-341c-b335-f953df87606f",
                        "source_sense_id": "7ffaa09f-3a09-3447-9dd4-3e3308a9a0cf",
                        "target_lang_word": "varus foot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "da582cde-f0a5-4bc4-b08c-398d842a11ad",
                        "source_entry_id": "0418714e-359c-341c-b335-f953df87606f",
                        "source_sense_id": "7ffaa09f-3a09-3447-9dd4-3e3308a9a0cf",
                        "target_lang_word": "clubfoot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clubfoot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df1d1a1a-50e0-397e-ba92-87e5ed433e69",
                                        "entry_id": "a41e37ba-f5d4-3efc-9e98-1a3b5b12bd4f",
                                        "glosses": [
                                            "A congenital deformity of the foot in which the ankle, heel and toes are twisted."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50955e3f-0a7c-4e5f-80f8-0b89ed22eb2e",
                                                "sense_id": "df1d1a1a-50e0-397e-ba92-87e5ed433e69",
                                                "text": "At his lower extremities, he exhibited the deformity which is popularly known as \"a club-foot.\" But he carried his lameness, as he carried his years, gayly."
                                            },
                                            {
                                                "example_id": "19de2211-363b-401b-b86d-b2a6c8dbdd06",
                                                "sense_id": "df1d1a1a-50e0-397e-ba92-87e5ed433e69",
                                                "text": "He stood still as much as he could, with his club-foot behind the other, so that it should not attract notice."
                                            },
                                            {
                                                "example_id": "ba012ca5-98c0-42e4-986f-1808645c5938",
                                                "sense_id": "df1d1a1a-50e0-397e-ba92-87e5ed433e69",
                                                "text": "The cure developed by Dr. Ponseti in the 1950s relies on physical manipulation. In each step of the treatment, a child’s clubfoot is stretched and turned slightly outward, and a hip-to-foot plaster cast, like the ones shown in the photograph, is then applied."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
