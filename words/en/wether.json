            "senses": [
                {
                    "sense_id": "0c8fb7d8-f311-3d3f-ba30-3fecc775e7fe",
                    "sense_definition": "A castrated male sheep (ram).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "castrated_animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer kept a docile <w>wether</w> among the sheep to help calm the flock.",
                            "target_lang_translations": {
                                "de": "Der Bauer hielt einen zahmen <w>Hammel</w> unter den Schafen, um die Herde zu beruhigen."
                            }
                        },
                        {
                            "text": "Wool harvested from a young <w>wether</w> is often of exceptionally high quality.",
                            "target_lang_translations": {
                                "de": "Wolle von einem jungen <w>Hammel</w> ist oft von außergewöhnlich hoher Qualität."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein kastriertes männliches Schaf (Widder)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Hammel",
                                "target_lang_sense_clarification": "kastriertes männliches Schaf"
                            },
                            {
                                "target_lang_word": "Schöps",
                                "target_lang_sense_clarification": "regional, bes. österreichisch"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4facf393-de76-3faa-bab6-cf1219c52587",
                    "sense_definition": "A castrated male goat.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "castrated_animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Unlike the aggressive bucks, the friendly <w>wether</w> made an ideal family pet.",
                            "target_lang_translations": {
                                "de": "Im Gegensatz zu den aggressiven Böcken war der freundliche <w>kastrierte Ziegenbock</w> ein ideales Haustier für die Familie."
                            }
                        },
                        {
                            "text": "They decided to raise a <w>wether</w> on the pasture alongside the horses.",
                            "target_lang_translations": {
                                "de": "Sie beschlossen, einen <w>kastrierten Ziegenbock</w> zusammen mit den Pferden auf der Weide zu halten."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein kastrierter Ziegenbock."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "kastrierter Ziegenbock",
                                "target_lang_sense_clarification": "männliche kastrierte Ziege"
                            },
                            {
                                "target_lang_word": "Mönch",
                                "target_lang_sense_clarification": "landschaftlich für kastrierter Bock"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25262829-1b0d-3083-ab6d-e8e077b6deb3",
                    "sense_definition": "Archaic spelling of <w>weather</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the ancient manuscript, the traveler described stormy <w>wether</w> along the coast.",
                            "target_lang_translations": {
                                "de": "In der alten Handschrift beschrieb der Reisende stürmisches <w>Wetter</w> entlang der Küste."
                            }
                        },
                        {
                            "text": "Early modern letters often used <w>wether</w> to refer to the conditions outside.",
                            "target_lang_translations": {
                                "de": "In frühneuzeitlichen Briefen wurde oft »<w>wether</w>« verwendet, um das Wetter draußen zu beschreiben."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
