                    {
                        "sense_id": "026d2bcb-4526-309d-8b2f-55bc4f1af6ed",
                        "entry_id": "a2243a82-6f6a-3aab-a79e-c58d3a3b0786",
                        "glosses": [
                            "Augmentation, à l’aide d’un logiciel ou en effectuant une manipulation matérielle, de la fréquence d’horloge d’un microprocesseur, d’un ordinateur ou d’une carte graphique, au delà de sa fréquence normale de fonctionnement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c7eb755-21bb-4a9b-bdb1-15c58e31a897",
                                "sense_id": "026d2bcb-4526-309d-8b2f-55bc4f1af6ed",
                                "text": "Le processeur six cœurs peut être également échangé contre un de ses grands frères, avec des cadences supérieures et des surcadençages effectués en usine."
                            },
                            {
                                "example_id": "5e3b54f6-c8e8-4da8-8d2e-741f7a82c706",
                                "sense_id": "026d2bcb-4526-309d-8b2f-55bc4f1af6ed",
                                "text": "Pour le moment, et tant que les composants du commerce ne seront pas plus rapides, il faut maîtriser les techniques de surcadençage, éventuellement une matrice de disques RAID et beaucoup de patience."
                            },
                            {
                                "example_id": "f6fc232a-ba0c-4010-9404-d1a3a1fcf6f6",
                                "sense_id": "026d2bcb-4526-309d-8b2f-55bc4f1af6ed",
                                "text": "De nombreux industriels spécialisés dans le refroidissement l’ont bien compris et proposent aux consommateurs de plus en plus d’outils pour atteindre le surcadençage qui leur convient."
                            }
                        ]
                    }
