                    "sense_id": "c29fc91b-2d24-34f2-99a6-6b75ccf70a77",
                    "sense_definition": "blij en tevreden over iets",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "blijdschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De directeur was zeer <w>verheugd</w> met de uitstekende resultaten van het team.",
                            "target_lang_translations": {
                                "en": "The director was very <w>pleased</w> with the team's excellent results.",
                                "fr": "Le directeur était très <w>ravi</w> des excellents résultats de l'équipe."
                            }
                        },
                        {
                            "text": "Wij zijn uiterst <w>verheugd</w> om u vandaag hier te mogen verwelkomen.",
                            "target_lang_translations": {
                                "en": "We are extremely <w>delighted</w> to welcome you here today.",
                                "fr": "Nous sommes extrêmement <w>heureux</w> de pouvoir vous accueillir ici aujourd'hui."
                            }
                        }
                    ],
                    "synonyms": [
                        "blij",
                        "verrukt",
                        "blijde"
                    ],
                    "antonyms": [
                        "bedroefd",
                        "teleurgesteld"
                    ],
                    "common_phrases": [
                        "zeer verheugd",
                        "verheugd over"
                    ],
                    "target_lang_definitions": {
