                        "entry_id": "df4f3095-b77f-3a06-bfbe-4a3ae0ee08d5",
                        "glosses": [
                            "Action de soufrer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ede6f5d8-c318-4d4a-82e2-190e71dc2a1f",
                                "sense_id": "f4b3c299-9ac0-3bc0-8f05-092e063e5e40",
                                "text": "Le soufrage des allumettes."
                            }
                        ]
                    },
                    {
                        "sense_id": "feb9740a-3ad1-3de7-9f41-ec06d2cc1217",
                        "entry_id": "df4f3095-b77f-3a06-bfbe-4a3ae0ee08d5",
                        "glosses": [
                            "Action de pulvériser une bouillie contenant du soufre sur une culture pour lutter contre l’oïdium."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "359f2827-389d-4904-878c-589ce4ef8a10",
                                "sense_id": "feb9740a-3ad1-3de7-9f41-ec06d2cc1217",
                                "text": "En 1910, huit traitements à la bouillie […] furent nécessaires pour sauver environ les 2/3 de la récolte dans nos Balzacs, Colombards, Montis, Balzacs blancs et Saint-Émilion renforcés de quatre à cinq soufrages au soufre-sulfaté."
                            },
                            {
                                "example_id": "92d3fcbb-7d83-4e1b-8816-3240b3c3e57d",
                                "sense_id": "feb9740a-3ad1-3de7-9f41-ec06d2cc1217",
                                "text": "Ce qui a lieu d’étonner, c’est que l’auteur consacre à peine quelques lignes au procédé du soufrage, qui est pourtant la cause unique de la richesse extraordinaire de l’Hérault et de tous les pays qui l’ont largement pratiqué ; on dirait qu’il ne peut pas se résigner à croire à la maladie de la vigne."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e1bfe30-cfa6-30f3-8f12-06c5cf516823",
                        "entry_id": "df4f3095-b77f-3a06-bfbe-4a3ae0ee08d5",
                        "glosses": [
                            "Action de faire brûler une mèche de soufre dans un tonneau pour le désinfecter."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "2b6583b3-7173-41ab-83e4-e295bce24957",
                                "sense_id": "0e1bfe30-cfa6-30f3-8f12-06c5cf516823",
                                "text": "Toutes les opérations qu’on exécute pour clarifier les vins sont fondées sur ce principe : le mucilage, le tartre et l’extractif qui étaient en dissolution dans le moût, ne sont plus qu’en suspension dans le vin bien fermenté, et se déposent peu-à-peu ; le soufrage facilite la formation du dépôt, et le soutirage sépare ces matières de la liqueur."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4b56a92-da02-310f-a56f-a62c2567b8dc",
                        "entry_id": "df4f3095-b77f-3a06-bfbe-4a3ae0ee08d5",
                        "glosses": [
                            "Action de soumettre la laine aux vapeurs de soufre pour la blanchir."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    }
