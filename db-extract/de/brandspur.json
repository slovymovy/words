                        "examples": [
                            {
                                "example_id": "2f834720-c799-4b82-8859-0acb64a60761",
                                "sense_id": "553992b3-ad43-3ca8-b9e0-0d8c9a1ebcab",
                                "text": "„Die Tür des windschiefen Schuppens, der nur an der Seite zum Haus Brandspuren aufweist, ansonsten aber verschont geblieben ist, ist unverschlossen.“"
                            },
                            {
                                "example_id": "297c50b4-d8b9-406b-91fb-e658e9d1f46b",
                                "sense_id": "553992b3-ad43-3ca8-b9e0-0d8c9a1ebcab",
                                "text": "„Brandspuren zeichen ihre sterblichen Überreste ebenso wie die Spuren von stumpfen Schädelverletzungen, Pfeilspitzen finden sich zudem unter den Knochen.“"
                            }
                        ],
