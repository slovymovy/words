                "senses": [
                    {
                        "sense_id": "01837191-cdae-31d9-9d06-e0c7e0a72b0b",
                        "entry_id": "1b6b3e18-95f0-32af-9f8d-86b9e5d9bf8a",
                        "glosses": [
                            "beim Skischwung derjenige der beiden Skier, der gerade kein oder nur wenig Gewicht trägt, weil er weiter oben am Hang ist"
                        ],
                        "tags": [
                            "Skisport"
                        ],
                        "examples": [
                            {
                                "example_id": "198f75df-bce4-4c87-a0a6-9b77783153ab",
                                "sense_id": "01837191-cdae-31d9-9d06-e0c7e0a72b0b",
                                "text": "„In den Kurven schiebt er den Talski nach vorne und den Bergski nach hinten, nur die Schuhspitzen kleben fest auf den schmalen Brettern, die Fersen schweben.“"
                            },
                            {
                                "example_id": "c7f4ae8e-1c9f-4c49-aeca-4c3051e232a3",
                                "sense_id": "01837191-cdae-31d9-9d06-e0c7e0a72b0b",
                                "text": "„Sie sollten dabei versuchen, die Bewegungsabläufe in kleine Teile zu zerlegen, die Ihr Kind einzeln lernen kann. Erklären Sie ihm Grundlagen wie Bergski und Talski. “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
