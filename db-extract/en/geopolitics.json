                    },
                    {
                        "translation_id": "6a1df0ca-f272-4818-935b-b864b8c0a0f6",
                        "source_entry_id": "2992f6fb-0bba-3f59-aed4-501e10b28b18",
                        "source_sense_id": "8ba5c5b7-bfc3-350d-a065-9f78343f2714",
                        "source_sense_description": "the study of the effects of geography on international politics",
                        "target_lang_word": "géopolitique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "géopolitique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f174902d-fefc-39b0-8313-86147054234b",
                                        "entry_id": "6f324075-4c96-3405-b53f-820368ef95b9",
                                        "glosses": [
                                            "Relatif à la géopolitique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee18195c-3b6e-4154-a6cb-b68d6374a47c",
                                                "sense_id": "f174902d-fefc-39b0-8313-86147054234b",
                                                "text": "\"The New Digital Age\" est, avant tout, une tentative de la part de Google de se positionner comme le visionnaire géopolitique de l'Amérique – la seule entreprise capable de répondre à la question : \"Où doit aller l'Amérique ?\" Il n'est donc guère surprenant qu'un certain nombre des plus grands fauteurs de guerre soient convoqués pour apporter leur caution à cette défense du soft power occidental."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "géopolitique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b75fed03-70b7-37e1-bc96-9c3c6fdab501",
                                        "entry_id": "ff9bbfb5-1db5-3aef-ae7b-f39904f8a226",
                                        "glosses": [
                                            "Science humaine qui étudie les implications politiques de la géographie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a76ac409-8123-45ac-b11f-f3eeea7e1765",
                                                "sense_id": "b75fed03-70b7-37e1-bc96-9c3c6fdab501",
                                                "text": "[Sait-il] qu’un carton rouge de trop peut menacer la paix mondiale ? C’est ce que nous ont expliqué, pendant cette longue semaine de délire médiatique, les spécialistes de la géopolitique."
                                            },
                                            {
                                                "example_id": "e4dd7103-1c9f-4dc9-ac19-3a9919c652ae",
                                                "sense_id": "b75fed03-70b7-37e1-bc96-9c3c6fdab501",
                                                "text": "En géopolitique, il n’y a rien de simple. Il est soulageant toutefois de s’entendre sur les faits, sur qui sont les bons (pour citer Joe Biden, « ... les dirigeants de nos alliés proches, dont le Canada, [avec qui] reconstruire le muscle de nos alliances démocratiques atrophié au cours des dernières années... ») et qui sont les méchants, ceux qui tyrannisent, empoisonnent, emprisonnent pour se maintenir au pouvoir."
                                            },
                                            {
                                                "example_id": "bda75d2c-6a3b-4f93-95db-99b970a5e396",
                                                "sense_id": "b75fed03-70b7-37e1-bc96-9c3c6fdab501",
                                                "text": "Chaque jour, Harold Hyman, chroniqueur à BFMTV, explique les nœuds de la géopolitique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98f816d2-9af6-4890-80c1-3ea29e5e8a7d",
                        "source_entry_id": "2992f6fb-0bba-3f59-aed4-501e10b28b18",
                        "source_sense_id": "8ba5c5b7-bfc3-350d-a065-9f78343f2714",
                        "source_sense_description": "the study of the effects of geography on international politics",
                        "target_lang_word": "Geopolitik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geopolitik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "27e22cfc-acdd-3042-b5bb-6bc0bfcf2949",
                                        "entry_id": "201959a5-16f8-31a7-883a-d6ab57d29759",
                                        "glosses": [
                                            "die geografische Faktoren mit politischen Zusammenhängen zu verknüpfen versucht"
                                        ],
                                        "tags": [
                                            "Wissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9cc6519-0e68-4fe2-8f82-7d5d3eb54c9f",
                                                "sense_id": "27e22cfc-acdd-3042-b5bb-6bc0bfcf2949",
                                                "text": "In der Geopolitik wird die Auffassung vertreten, dass Völker und Kulturen dynamische Gebilde sind."
                                            },
                                            {
                                                "example_id": "cf287995-a3ee-402a-9e75-04b2c492c298",
                                                "sense_id": "27e22cfc-acdd-3042-b5bb-6bc0bfcf2949",
                                                "text": "„Ich begriff, dass er ein vielseitiger Mann gewesen war, denn er hatte auch eine Menge Artikel über Mineralogie, Metallurgie, Umweltschutz und Geopolitik geschrieben, ehe er 1989 verstorben war, wie der Nachruf mitteilte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "65b3ee5d-3a82-3914-af3b-605f92aa0d67",
                                        "entry_id": "201959a5-16f8-31a7-883a-d6ab57d29759",
                                        "glosses": [
                                            "politische Realität, die sich besonders mit der Bedeutung von Standorten auseinandersetzt; politisches Agieren im Hinblick auf überstaatliche/internationale/weltweite Einflüsse und Vorkommnisse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca28ce01-f0ff-4e50-b840-866347b11ab5",
                                                "sense_id": "65b3ee5d-3a82-3914-af3b-605f92aa0d67",
                                                "text": "Die Türkei würde für die Europäische Union aufgrund ihrer Lage eine wichtige Rolle im Bereich der Geopolitik spielen."
                                            },
                                            {
                                                "example_id": "bc233dea-d1fa-4126-90ea-118f362bae51",
                                                "sense_id": "65b3ee5d-3a82-3914-af3b-605f92aa0d67",
                                                "text": "„Die neue Geopolitik erforderte große, flexibel einsetzbare Heere.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
