                        "glosses": [
                            "Lifting, suppression des rides par chirurgie esthétique."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "9f146347-acb7-436f-9e28-e653e54fdd36",
                                "sense_id": "4914ea6a-0032-3dba-9261-a950a29d9420",
                                "text": "Quant à moi, j’ai une petite préférence pour le déridage car on peut se dérider en s’amusant mais certainement pas s’amuser en se liftant."
                            },
                            {
                                "example_id": "c518e5e9-482a-4132-9e87-4a4fd9c0add7",
                                "sense_id": "4914ea6a-0032-3dba-9261-a950a29d9420",
                                "text": "Cette grimace sociale, analogue à celles qui servent à la communication des chimpanzés, apparaît autour de la trentaine et se renforce avec l’âge, surtout chez les femmes victimes d’un déridage, ou lifting."
                            },
                            {
                                "example_id": "47537515-71d9-42a5-b73d-2d3ef029998d",
                                "sense_id": "4914ea6a-0032-3dba-9261-a950a29d9420",
                                "text": "L’esthétique du visage permet d’atténuer les rides et ridules. Un déridage facial (lifting) sans chirurgie est aussi possible grâce à de nouvelles technologies."
                            }
                        ]
                    }
