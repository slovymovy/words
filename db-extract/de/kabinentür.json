                            {
                                "example_id": "582ff363-7e1f-48d4-860d-bc009081640c",
                                "sense_id": "a38f5b61-cb3e-3ef0-b2d0-18c291a40689",
                                "text": "„Inzwischen hatte er die Kabinentür geschlossen und eine Reihe einfacher Tasten gedrückt.“"
                            },
                            {
                                "example_id": "ce8dc6dc-7fbe-44e1-ae82-2a9ff87b1cd2",
                                "sense_id": "a38f5b61-cb3e-3ef0-b2d0-18c291a40689",
                                "text": "„Als Mr Darwins Nachfolgerin in Sachen Erforschung des Übernatürlichen rüste ich mich, Zeugnis abzulegen, während Mr K im Gang vor meiner verschlossenen Kabinentür auf und ab marschiert.“"
                            }
                        ],
