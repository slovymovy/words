                                "target_senses": [
                                    {
                                        "sense_id": "85c4e26b-239e-3aa1-b1e7-7ca489e6306d",
                                        "entry_id": "11261a3d-648e-3dba-b750-ccf670b60dc4",
                                        "glosses": [
                                            "D’une manière inséparable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5efb003-b710-4042-a9e3-5294c3f35407",
                                                "sense_id": "85c4e26b-239e-3aa1-b1e7-7ca489e6306d",
                                                "text": "Il me prend un enthousiasme pour vous, pour M. de Grignan, pour son fils, pour votre maison, pour ce nom qu’il doit soutenir et auquel je suis inséparablement attachée."
                                            },
                                            {
                                                "example_id": "7661287b-9e1b-483c-bc3f-f8c015dee78e",
                                                "sense_id": "85c4e26b-239e-3aa1-b1e7-7ca489e6306d",
                                                "text": "Tout mon être dépendant du temps…, il s’ensuit que ma substance n'est rien, étant inséparablement attachée à cette vapeur légère et volage qui ne se forme qu’en se dissipant."
                                            },
                                            {
                                                "example_id": "0a6917bb-b1ca-424d-a2ae-ac7c25a5d386",
                                                "sense_id": "85c4e26b-239e-3aa1-b1e7-7ca489e6306d",
                                                "text": "[…], — toujours est-il que l’idée, une fois acceptée, est inséparablement connexe d’une autre idée, celle de la condition de l’Univers sidéral, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
