                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ddb0ec17-d27b-4882-9dd6-1aa583d6d945",
                        "entry_id": "baee8848-de7c-30ac-a54c-459dfc499af1",
                        "tags": [
                            "plural"
                        ],
                        "form": "respectabilities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "74b9b583-2c0f-3443-938f-27b9bb246b34",
                        "entry_id": "baee8848-de7c-30ac-a54c-459dfc499af1",
                        "glosses": [
                            "The quality of being respectable."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "ecbb8e90-ce9b-4646-946e-4912799e11a8",
                                "sense_id": "74b9b583-2c0f-3443-938f-27b9bb246b34",
                                "text": "Such a scandal as the prosecution of a brother for forgery—with a verdict of guilty—is a most truly horrible, deplorable, fatal thing. It takes the respectability out of a family perhaps at a critical moment, when the family is just assuming the robes of respectability: […] it is a black spot which all the soaps ever advertised could never wash off."
                            },
                            {
                                "example_id": "59f16d70-5d03-4643-861e-79c070b1b44e",
                                "sense_id": "74b9b583-2c0f-3443-938f-27b9bb246b34",
                                "text": "But once again Hodgson's men found a way to get the result they required and there is a real air of respectability about their campaign even though they had to survive a first-half siege from a Ukraine side desperate for the win they needed to progress."
                            }
                        ]
                    },
                    {
                        "sense_id": "950908c6-af2d-3809-bfe1-ac471473ec19",
                        "entry_id": "baee8848-de7c-30ac-a54c-459dfc499af1",
                        "glosses": [
                            "The class of respectable people."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc72d256-5210-4705-8126-89caff527fad",
