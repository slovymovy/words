                                "target_senses": [
                                    {
                                        "sense_id": "4e472884-c8dc-3cf0-a588-ed3917422daa",
                                        "entry_id": "e8f411a0-083d-3e66-8a28-28b0a05473af",
                                        "glosses": [
                                            "de hoofdstad en grootste stad van Bosnië en Herzegovina"
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3ba701d-b98b-46dc-bff5-7b212ffc1f66",
                                                "sense_id": "4e472884-c8dc-3cf0-a588-ed3917422daa",
                                                "text": "We hadden een uur aan de telefoon gehangen; ik aan dat kale bureau van een ibis-hotel in Sarajevo en hij thuis op mijn gebloemde bank in de woonkamer."
                                            },
                                            {
                                                "example_id": "7baaee32-08b7-4482-8449-c61cc52d16ab",
                                                "sense_id": "4e472884-c8dc-3cf0-a588-ed3917422daa",
                                                "text": "Ik studeerde in Sarajevo en Milan had na zijn militaire dienst bijgetekend en zat in het leger op een basis enkele kilometers verderop, niet ver van de schuivende grens met het opstandige Kroatië."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fccf1304-a500-42f3-bd62-12caf1dc5a92",
                        "source_entry_id": "81e91681-86e5-35a0-8c97-75d8caa58f1e",
                        "source_sense_description": "city",
                        "target_lang_word": "Sarajevo",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sarajevo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cc237b86-1dba-3b83-8ce5-40fdacdb2f4e",
                                        "entry_id": "17f3289a-8c1d-3a91-845e-e2f47925880a",
                                        "glosses": [
                                            "Capitale de la Bosnie-Herzégovine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83f489be-df21-47ca-a050-ff0093226d9d",
                                                "sense_id": "cc237b86-1dba-3b83-8ce5-40fdacdb2f4e",
                                                "text": "Et la guerre fut là tout d’un coup, parce qu’un archiduc autrichien, dont personne ne sait plus le nom, avait été tué à Sarajevo."
                                            },
                                            {
                                                "example_id": "f4bac7c7-e883-4c0d-aa97-474362e855c0",
                                                "sense_id": "cc237b86-1dba-3b83-8ce5-40fdacdb2f4e",
                                                "text": "L’obstination portée à détruire l’Empire fédéral autrichien nous a valu la première guerre mondiale après l’attentat de Sarajevo, puis sa prolongation après le refus français d’une paix séparée avec l’Autriche […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b58f7a87-f7b1-3ba8-9229-d6b35d11f7ad",
                                        "entry_id": "17f3289a-8c1d-3a91-845e-e2f47925880a",
                                        "glosses": [
                                            "Attentat qui déclencha la Première Guerre mondiale."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4907abb-0e8e-45a9-be58-e9f50c1405a0",
                                                "sense_id": "b58f7a87-f7b1-3ba8-9229-d6b35d11f7ad",
                                                "text": "Ne voyons nous pas rallumée, à Dantzig, la fumante mèche de Sarajevo ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
