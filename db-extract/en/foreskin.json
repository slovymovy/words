                    {
                        "translation_id": "58b5dc64-2c19-4745-9c61-8db376a6f8a8",
                        "source_entry_id": "afdfe142-f977-3e19-9547-2e933e43acc7",
                        "source_sense_description": "fold of skin covering the head of the penis",
                        "target_lang_word": "Vorhaut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorhaut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "595774fe-589f-34a4-8d14-bd0f0f752f5f",
                                        "entry_id": "4a1fdb57-a0cf-3cd7-b4df-6e5edcf3cf73",
                                        "glosses": [
                                            "Falte des Hüllorgans am äußeren Teil des männlichen Geschlechtsorgans"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fdab86a-8145-459f-b61f-13644854b40b",
                                                "sense_id": "595774fe-589f-34a4-8d14-bd0f0f752f5f",
                                                "text": "Die Innenseite der Vorhaut ist bei kleinen Jungen meist noch fest mit der Eichel verklebt."
                                            },
                                            {
                                                "example_id": "70a42937-84c4-43ed-b766-65c3dc966d4d",
                                                "sense_id": "595774fe-589f-34a4-8d14-bd0f0f752f5f",
                                                "text": "„Danach begrub man meine Vorhaut hinter dem Haus und wickelte die Klitoris meiner Schwester in ein Stück Stoff und warf sie in den Nil: ein Brauch, der seit der Pharaonenzeit bekannt ist.“"
                                            },
                                            {
                                                "example_id": "eac689dd-f98f-45d6-a187-4c957d3b43ad",
                                                "sense_id": "595774fe-589f-34a4-8d14-bd0f0f752f5f",
                                                "text": "„Man wird mit einer Vorhaut geboren und stirbt mit ihr.“"
                                            },
                                            {
                                                "example_id": "374cb243-c684-4e93-a8e9-ceb8831062db",
                                                "sense_id": "595774fe-589f-34a4-8d14-bd0f0f752f5f",
                                                "text": "„Mit der Zunge kitzelte sie die Öffnung, ihre Zungenspitze stieß sie unter die Vorhaut, fest umschlossen ihre roten Lippen das Mittelstück und reizten es so auf alle möglichen Arten.“"
                                            },
                                            {
                                                "example_id": "b249f646-b4df-4616-845b-a497935506f6",
                                                "sense_id": "595774fe-589f-34a4-8d14-bd0f0f752f5f",
                                                "text": "„Höhepunkt war das hochprofessionelle Zurückschieben der Vorhaut und ein kreisendes Wienern der Eichel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0d859fe5-2be0-38bc-a730-06ed368564c7",
                                        "entry_id": "4a1fdb57-a0cf-3cd7-b4df-6e5edcf3cf73",
                                        "glosses": [
                                            "Falte des Hüllorgans am äußeren Teil des weiblichen Geschlechtsorgans"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fbcb6c8-19df-4fce-b321-d5cfc19dcfa7",
                                                "sense_id": "0d859fe5-2be0-38bc-a730-06ed368564c7",
                                                "text": "Auch die Klitoris umgibt eine Vorhaut, die in ihrer Funktion ähnlich ihrem männlichen Pendants ist."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
