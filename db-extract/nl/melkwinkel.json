                        "examples": [
                            {
                                "example_id": "45f31d7d-1e3b-417d-8672-931183d27e7b",
                                "sense_id": "22d4d897-6bef-34de-b452-f0de63043ae7",
                                "text": "Hij stapte de melkwinkel in en riep: 'Volk!' Misschien zag juffrouw Dubois hem, van achteren af, en kwam ze zelf naar voren; was hij van al die vragerij af."
                            },
                            {
                                "example_id": "9382183c-b944-4f4e-b4a8-9bb00888a59c",
                                "sense_id": "22d4d897-6bef-34de-b452-f0de63043ae7",
                                "text": "In 1939 startte de toen 15-jarige Van den Broek zijn eigen zaak en reed hij met een melkkar door Amsterdam. In 1942 volgde de opening van een melkwinkel, gevolgd door de eerste zelfbedieningszaak van Amsterdam in 1948."
                            }
                        ]
