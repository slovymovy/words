    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c47923df-f667-3393-80ff-bcb7d30b7152",
                    "sense_definition": "Apporter de légères modifications à une œuvre, une image ou un vêtement pour l'améliorer ou l'ajuster.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "modification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le photographe a passé une heure à <w>retoucher</w> les portraits pour le magazine."
                        },
                        {
                            "text": "La couturière doit <w>retoucher</w> cette veste qui est un peu trop large aux épaules."
                        }
                    ],
                    "synonyms": [
                        "corriger",
                        "modifier",
                        "remanier"
                    ],
                    "common_phrases": [
                        "retoucher une photo",
                        "retoucher un vêtement"
                    ]
                },
                {
                    "sense_id": "a0224d52-736c-3fdc-b2a8-194ae57d7788",
                    "sense_definition": "Poser la main ou entrer en contact physique de nouveau avec quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "contact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne <w>retouche</w> plus à ces fils électriques sans avoir d'abord coupé le courant."
                        },
                        {
                            "text": "L'enfant a promis de ne pas <w>retoucher</w> au gâteau avant l'arrivée des invités."
                        }
                    ]
                }
            ]
        }
    ]
}