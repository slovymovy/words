                        "entry_id": "c76106f8-2b99-345d-96b8-72390dc1136e",
                        "glosses": [
                            "A county of Harbin, Heilongjiang, China."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dc6837b-3df9-4f83-875b-dba3a7948952",
                                "sense_id": "6228d26a-7f36-3971-9cd5-058b8383d4fb",
                                "text": "Tens of thousands of peasants in Tulungshan of Ilan county started large-scale riots, and within ten days killed or injured three thousand Japanese soldiers together with their commanders."
                            },
                            {
                                "example_id": "b473f0ed-53fd-4d67-b174-7b855f10a165",
                                "sense_id": "6228d26a-7f36-3971-9cd5-058b8383d4fb",
                                "text": "Many impact craters have been found around the world, but most of them were formed long before the emergence of homo sapiens 300,000 years ago.\nBut the “impossibly deep” crater discovered in Yilan county near Harbin in Heilongjiang is thought to have been formed about 49,000 years ago by an asteroid about 100 metres wide."
                            }
                        ]
