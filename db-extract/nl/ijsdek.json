                                "target_senses": [
                                    {
                                        "sense_id": "fae1894a-4fcd-3c12-80f8-baecb7948e7b",
                                        "entry_id": "be3cc2c2-d9e4-3f7c-9b27-64526d721c39",
                                        "glosses": [
                                            "A permanent expanse of ice encompassing a large geographical area, as for example in Earth's polar zones (polar ice) or at high elevation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf6b8751-84b2-4b5e-b600-5da8460c8163",
                                                "sense_id": "fae1894a-4fcd-3c12-80f8-baecb7948e7b",
                                                "text": "The ocean beneath the arctic ice cap hosts many unique organisms adapted to the cold and shortage of light."
                                            },
                                            {
                                                "example_id": "ad50ef26-3bd8-42ae-a2a8-0583f7b0d4c5",
                                                "sense_id": "fae1894a-4fcd-3c12-80f8-baecb7948e7b",
                                                "text": "The ice cap of Kilimanjaro is shrinking, and some researchers believe it will disappear within the next one hundred years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "906825bb-efe5-3d6f-8586-8d380ac639d6",
                                        "entry_id": "be3cc2c2-d9e4-3f7c-9b27-64526d721c39",
                                        "glosses": [
                                            "An ice pack designed to be worn on the head."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19193a8e-675a-4f78-b579-ad83619126c5",
                                                "sense_id": "906825bb-efe5-3d6f-8586-8d380ac639d6",
                                                "text": "After the use of ice caps for some days it is well to provide cool bathing for the head, at least three times daily."
                                            }
                                        ]
                                    },
