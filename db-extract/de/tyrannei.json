                ],
                "senses": [
                    {
                        "sense_id": "ab55fa23-5a7a-36d4-ab1e-029fe34f2479",
                        "entry_id": "734fbc80-ef63-381c-873f-4285fac72506",
                        "glosses": [
                            "willkürliche und unterdrückerische Gewaltherrschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ef1f9f3-1ba9-42ae-b12a-9b9b9fdc2d98",
                                "sense_id": "ab55fa23-5a7a-36d4-ab1e-029fe34f2479",
                                "text": "Die Revolution sollte der Tyrannei des alten Regimes ein Ende bereiten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "65e3e136-66e8-3aea-8351-72dd10d22837",
                        "entry_id": "734fbc80-ef63-381c-873f-4285fac72506",
                        "glosses": [
                            "rücksichtslos herrschsüchtiges Verhalten eines Menschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd2f9fbd-c2cb-487a-bcc4-cd5b168e78da",
                                "sense_id": "65e3e136-66e8-3aea-8351-72dd10d22837",
                                "text": "Er versuchte der Tyrannei seines Vaters zu entkommen."
                            },
                            {
                                "example_id": "4f30d668-e468-44d8-a320-5d2e58609f24",
                                "sense_id": "65e3e136-66e8-3aea-8351-72dd10d22837",
                                "text": "„So übte der verwünschte alte Präfekt mit seiner verunstalteten Nase seine Tyrannei überall dort aus, wo die Liebhaber ihre Sinnenfreuden suchten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc873897-f582-4d31-9049-87f416eaf6c1",
                        "source_entry_id": "734fbc80-ef63-381c-873f-4285fac72506",
                        "source_sense_id": "ab55fa23-5a7a-36d4-ab1e-029fe34f2479",
                        "source_sense_description": "willkürliche und unterdrückerische Gewaltherrschaft",
                        "target_lang_word": "tyranny",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tyranny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7745f828-1267-3a2f-ab4d-037a58bc55fe",
                                        "entry_id": "7aad67aa-3389-35f7-a3e6-10834fd489b0",
                                        "glosses": [
                                            "A government in which a single ruler (a tyrant) has absolute power, or this system of government; especially, one that acts cruelly and unjustly."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0dc71ee5-1ad5-356e-889c-b607fc34c626",
                                        "entry_id": "7aad67aa-3389-35f7-a3e6-10834fd489b0",
                                        "glosses": [
                                            "The office or jurisdiction of an absolute ruler."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1fc60f56-f14e-3121-b67a-320fa0ea9222",
                                        "entry_id": "7aad67aa-3389-35f7-a3e6-10834fd489b0",
                                        "glosses": [
                                            "Absolute power, or its use."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6b4d8769-d3bb-3c96-8ad6-8c386a81ced6",
                                        "entry_id": "7aad67aa-3389-35f7-a3e6-10834fd489b0",
                                        "glosses": [
                                            "A system of government in which power is exercised on behalf of the ruler or ruling class, without regard to the wishes of the governed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "904a6c20-fc5b-43db-b407-0ce1323b84b5",
                                                "sense_id": "6b4d8769-d3bb-3c96-8ad6-8c386a81ced6",
                                                "text": "He that with ſhepheards and a litle ſpoyle,\nDurſt in diſdaine of wrong and tyrannie,\nDefend his freedome gainſt a Monarchie:\nWhat will he doe ſupported by a king?"
                                            },
                                            {
                                                "example_id": "e2c6caa1-564f-4d47-b995-12653a11b2fa",
                                                "sense_id": "6b4d8769-d3bb-3c96-8ad6-8c386a81ced6",
                                                "text": "Control, dispossession, violence, and tyranny are not “defensive”: they are part of an organized, ongoing aggression."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a8aabd7-aa2c-39d9-9183-bee2fbba591c",
                                        "entry_id": "7aad67aa-3389-35f7-a3e6-10834fd489b0",
                                        "glosses": [
                                            "Extreme severity or rigour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97d4f58d-9c98-45bc-80aa-6fd9f51560cb",
                        "source_entry_id": "734fbc80-ef63-381c-873f-4285fac72506",
                        "source_sense_id": "ab55fa23-5a7a-36d4-ab1e-029fe34f2479",
                        "source_sense_description": "willkürliche und unterdrückerische Gewaltherrschaft",
                        "target_lang_word": "tyrannie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tyrannie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ae252516-109a-33e1-9de7-84a513707db4",
                                        "entry_id": "e8237d62-e5cd-3bc0-8b67-d698fa1a546d",
                                        "glosses": [
                                            "Domination usurpée et illégale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81ea9ddd-b00c-4428-a22d-e53075f14371",
                                                "sense_id": "ae252516-109a-33e1-9de7-84a513707db4",
                                                "text": "Allons enfants de la Patrie\nLe jour de gloire est arrivé !\nContre nous de la tyrannie\nL'étendard sanglant est levé."
                                            },
                                            {
                                                "example_id": "84d3b7f6-5500-41df-ab29-7804ed5217d5",
                                                "sense_id": "ae252516-109a-33e1-9de7-84a513707db4",
                                                "text": "Cromwel n'étoit pas moins agité des terreurs de la tyrannie. Il étoit toujours couvert d'une cuirasse, chargé d'armes offensives, et environné de satellites."
                                            },
                                            {
                                                "example_id": "ac8b099b-b98f-4d7d-8b6e-cfdd8df86d62",
                                                "sense_id": "ae252516-109a-33e1-9de7-84a513707db4",
                                                "text": "À peine l’indépendance de l’Amérique du Nord fut-elle proclamée, la paix conclue avec l’ancienne métropole, que ces hommes qui criaient si haut à la tyrannie, à l’oppression, qui réclamaient contre la violation du droit des gens, dont, disaient-ils, ils étaient victimes, organisèrent avec cet implacable sang-froid qu’ils tiennent de leur origine une chasse aux Indiens."
                                            },
                                            {
                                                "example_id": "89ef03d6-020b-413a-a39b-2e79f4b35931",
                                                "sense_id": "ae252516-109a-33e1-9de7-84a513707db4",
                                                "text": "… la tyrannie n'est-elle pas la conséquence d'un itinéraire d'enfant gâté?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0ae7665-8634-3ee3-b65f-7587506a3b9f",
                                        "entry_id": "e8237d62-e5cd-3bc0-8b67-d698fa1a546d",
                                        "glosses": [
                                            "Gouvernement légitime, mais injuste et cruel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fad4c0d5-95aa-4e9a-8b19-82561546fde0",
                                                "sense_id": "a0ae7665-8634-3ee3-b65f-7587506a3b9f",
                                                "text": "Jamais aucune contrée de l’Europe ne supporterait maintenant la longue succession de tyrannies basses et féroces qui ont accablé les Romains."
                                            },
                                            {
                                                "example_id": "dfc3ce27-311e-4a9d-a283-d0ced8adb83b",
                                                "sense_id": "a0ae7665-8634-3ee3-b65f-7587506a3b9f",
                                                "text": "Être prudemment barbare et exercer la tyrannie conséquemment signifie, selon ce politique abominable, exécuter tout d'un coup toutes les violences et tous les crimes que l'on juge utiles à ses intérêts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c469861-e0a0-355b-88e1-c14c83a54178",
                                        "entry_id": "e8237d62-e5cd-3bc0-8b67-d698fa1a546d",
                                        "glosses": [
                                            "Toute sorte d’oppressions et de violences."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10dceb40-c3e7-4e78-8f7f-8b27c1cf4d9e",
                                                "sense_id": "5c469861-e0a0-355b-88e1-c14c83a54178",
                                                "text": "Une circonstance, qui tendait surtout à rehausser la tyrannie de la noblesse et à doubler les souffrances des classes inférieures, dérivait particulièrement de la conquête de Guillaume, duc de Normandie."
                                            },
                                            {
                                                "example_id": "1fadb9f3-b976-4b3f-96f0-adf98a45abe4",
                                                "sense_id": "5c469861-e0a0-355b-88e1-c14c83a54178",
                                                "text": "Mais ce n'est pas seulement par goût de la tyrannie que les policiers agissaient ainsi, c'est aussi par goût du lucre. Les tracasseries, le « chantage » qu'ils exerçaient sur les juifs apeurés avaient pour but de leur extorquer de fréquentes « étrennes »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c2d0a60-2e80-366c-83ab-d7574e47f7c6",
                                        "entry_id": "e8237d62-e5cd-3bc0-8b67-d698fa1a546d",
                                        "glosses": [
                                            "Comportement capricieux et égoïste."
                                        ],
                                        "tags": [
                                            "especially",
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d3579c2-6989-4ffd-9eec-faa754197f1f",
                                                "sense_id": "9c2d0a60-2e80-366c-83ab-d7574e47f7c6",
                                                "text": "D'Aiglemont a été gâté par ses parents, de même que tu l'as été par ta mère et par moi. Comment espérer que vous pourrez vous entendre tous deux avec des volontés différentes dont les tyrannies seront inconciliables ? Tu seras ou victime ou tyran."
                                            },
                                            {
                                                "example_id": "a6ebffa7-005a-4c46-a658-1559f31109b8",
                                                "sense_id": "9c2d0a60-2e80-366c-83ab-d7574e47f7c6",
                                                "text": "L'habile mais féroce tyrannie du cœur exercée par Sand montre insensiblement ses limites; pourtant la “quarante-huitarde” qui se voudrait martyrisée n'en démord pas, solidement ancrée dans son égocentrisme paranoïaque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4224d1d1-4cae-31e8-a92d-5bbbd6548f2a",
                                        "entry_id": "e8237d62-e5cd-3bc0-8b67-d698fa1a546d",
                                        "glosses": [
                                            "Pouvoir que certaines choses ont ordinairement sur les hommes."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe9974ac-9df2-4b81-9df9-9f5297529cf2",
                                                "sense_id": "4224d1d1-4cae-31e8-a92d-5bbbd6548f2a",
                                                "text": "Poser une fois pour tout le choix d’avoir un enfant nous épargne de la tyrannie du choix permanent de notre société où tout est jetable."
                                            },
                                            {
                                                "example_id": "ce026ab1-5dd1-42c4-80cc-32e2c3efb99b",
                                                "sense_id": "4224d1d1-4cae-31e8-a92d-5bbbd6548f2a",
                                                "text": "L’éloquence exerce une sorte de tyrannie sur les foules. - La tyrannie de la coutume, de l’usage, de la mode. - La tyrannie des passions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
