                                "target_senses": [
                                    {
                                        "sense_id": "51f496c5-333d-3c01-b219-b5a30d85d7b7",
                                        "entry_id": "22cce46a-ce66-3ab2-983f-4a9f14cc3c17",
                                        "glosses": [
                                            "A country in West Asia in the Middle East. Official name: Republic of Yemen. Capital: Sanaa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea9c3b3a-2f3a-4145-968d-eac16bfbb483",
                                                "sense_id": "51f496c5-333d-3c01-b219-b5a30d85d7b7",
                                                "text": "Unlike in Somalia, Iraq and Afghanistan, in Yemen they are trying to implement sharia by winning over the hearts and minds of the people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7573c30-1c89-35eb-b84d-39b1f049dac0",
                                        "entry_id": "22cce46a-ce66-3ab2-983f-4a9f14cc3c17",
                                        "glosses": [
                                            "A region in the southern Arabian Peninsula; the Arabia Felix."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea6aaa84-c174-4a75-a741-c9bb4e58ca48",
                        "source_entry_id": "e9a0dddc-6443-3904-a0cb-bb33d8d6d49b",
                        "source_sense_id": "cd5e1a66-5163-3f56-8e81-0b8f89d3edb1",
                        "target_lang_word": "Jemen",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jemen",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "054c2a09-d3ce-32a1-995c-043979fb5520",
                                        "entry_id": "b4d965bf-3560-3629-8c9b-61fdd9070bd0",
                                        "glosses": [
                                            "přímořský stát na jihu Arabského poloostrova v jihozápadní Asii"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9166cd84-20aa-4b14-9efa-554b3e68abe7",
                                                "sense_id": "054c2a09-d3ce-32a1-995c-043979fb5520",
                                                "text": "Hodeida, tur. opevněné město v Jemenu, na pobř. Rudého moře."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "332738de-3ed5-42c4-ab98-1a79ceb15c1d",
                        "source_entry_id": "e9a0dddc-6443-3904-a0cb-bb33d8d6d49b",
                        "source_sense_id": "cd5e1a66-5163-3f56-8e81-0b8f89d3edb1",
                        "target_lang_word": "Yémen",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Yémen",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d7f0f049-f58d-3195-aa40-1d06bcd250b1",
                                        "entry_id": "72db90af-32fc-3c1a-b024-d5c7c301b7d4",
                                        "glosses": [
                                            "Pays situé au sud-ouest de la péninsule arabique, bordé par le royaume d’Arabie saoudite au nord, Oman à l’est, le golfe d’Aden au sud et la mer Rouge à l’ouest, et dont la capitale est Sanaa."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00bf3761-65ad-4f21-b752-abbc19bc119a",
                                                "sense_id": "d7f0f049-f58d-3195-aa40-1d06bcd250b1",
                                                "text": "À voir cette fille étrange, un poète lui aurait donné le Yémen pour patrie, elle tenait de l’Afrite et du Génie des contes arabes."
                                            },
                                            {
                                                "example_id": "859faa61-069e-4bbf-897c-b7e16a34a8ed",
                                                "sense_id": "d7f0f049-f58d-3195-aa40-1d06bcd250b1",
                                                "text": "Inclure les Yémens, et il faudrait que ce soit les deux, unifiés préalablement ou pas, dans ce qui deviendrait alors le Conseil de coopération de la Péninsule arabe est une idée intéressante."
                                            },
                                            {
                                                "example_id": "502d3444-b0df-48c6-b5b5-0e897ab06b09",
                                                "sense_id": "d7f0f049-f58d-3195-aa40-1d06bcd250b1",
                                                "text": "Au Yémen, au-dessus de la mer d’Oman, on avait ouvert une voie de 500 mètres, débusquant des araignées-scorpions à la lampe torche."
                                            },
                                            {
                                                "example_id": "10083abf-6b68-4cba-a438-d8150ef8b331",
                                                "sense_id": "d7f0f049-f58d-3195-aa40-1d06bcd250b1",
                                                "text": "Le long de ses 2 500 kilomètres de côtes, dont 151 îles en mer Rouge, le Yémen présente des rivages rocheux et sablonneux couverts de vasières, mangroves, récifs coralliens et herbiers marins, de première importance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d9ad7e8-3763-3bf8-b42d-5bc896c648dc",
                                        "entry_id": "72db90af-32fc-3c1a-b024-d5c7c301b7d4",
                                        "glosses": [
                                            "Définition manquante ou à compléter. (Ajouter)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81c356cb-588f-4f4e-b524-0c4475c51623",
                                                "sense_id": "0d9ad7e8-3763-3bf8-b42d-5bc896c648dc",
                                                "text": "Il paraît, d’après des histoires manuscrites et le témoignage des vieillards, que les populations non-seulement du Liban, mais de toute la chaîne de montagnes qui s’étend depuis Laodicée jusqu’à Tyr, ainsi que celle de l’Anti-Liban, étaient divisées en deux grandes factions, appelées les Kais et les Yémens. Cette démarcation ne s’appuyait ni sur la race, ni sur la religion. Les Druses, les Ansariés, les Mutualis, les chrétiens étaient divisés entre eux en Kais et Yémens. […] Vers ce temps-là [début XVIIIᵉ siècle], les dénominations de Kais et de Yémens disparaissent dans le Liban et sont remplacées par celles de Djomblaties et Yezbékiés, qui subsistent encore aujourd’hui, mais qui n’ont conservé toute leur signification que parmi les Druzes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
