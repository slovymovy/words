                "senses": [
                    {
                        "sense_id": "821fb031-34d3-35e3-95bf-8d67e53a5c87",
                        "entry_id": "05a9b6a8-15f0-3826-beb9-7ecb26500e9a",
                        "glosses": [
                            "Éduquer du point de vue des questions relevant de la psychologie ou de la psychiatrie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4833e70f-8e9f-4a53-916b-03cf69256b00",
                                "sense_id": "821fb031-34d3-35e3-95bf-8d67e53a5c87",
                                "text": "Ainsi tout thérapeute bien informé sur le trouble bipolaire devrait pouvoir, à divers degrés, « psychoéduquer son patient »."
                            },
                            {
                                "example_id": "0a281ec7-2857-4658-8bd1-f7fe821cc8f0",
                                "sense_id": "821fb031-34d3-35e3-95bf-8d67e53a5c87",
                                "text": "Fièrement armé de son histoire carabine, il se chargera de psychodynamiser et de psychoéduquer son public déchaîné..."
                            },
                            {
                                "example_id": "2491aa20-78cb-4469-bed8-d9c663b8028f",
                                "sense_id": "821fb031-34d3-35e3-95bf-8d67e53a5c87",
                                "text": "Allez hop ! Psychoéduquez moi ça sinon ça va couler !"
                            }
                        ]
                    }
