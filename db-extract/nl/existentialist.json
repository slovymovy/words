                        "examples": [
                            {
                                "example_id": "fa192233-6083-4748-a93d-0140e8855644",
                                "sense_id": "dafa7363-3c29-3043-af9d-153ae916b44d",
                                "text": "In de jaren vijftig was het roken van Gauloises een stijlkenmerk van de intellectuelen. Met name existentialisten als Jean Paul Sartre hadden ze vrijwel permanent in een mondhoek bungelen."
                            },
                            {
                                "example_id": "3b7dc004-0516-492b-8f59-acde26370bcb",
                                "sense_id": "dafa7363-3c29-3043-af9d-153ae916b44d",
                                "text": "Hij verhaalt over haar biografie, vol sociale ellende, waarbij ze als meisje in een hok moet vechten voor iedere centimeter privacy. „De hel, dat zijn de anderen. In Frankrijk moet je een diepe denker en existentialist zijn om tot dit inzicht te komen”, sneert Brouwers naar Jean-Paul Sarte. „In Wit-Rusland en Rusland krijg je deze wijsheid er gratis bij.”"
                            }
                        ]
                    }
