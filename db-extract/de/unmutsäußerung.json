                "senses": [
                    {
                        "sense_id": "023c8ab7-593e-3e97-afae-35967012b22d",
                        "entry_id": "9ec788a6-8d7f-3912-b09a-c14e1822246d",
                        "glosses": [
                            "Ausdruck der negativen Einstellung zu etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ba8f1b5-f4e0-4842-a2ac-93ea557ae684",
                                "sense_id": "023c8ab7-593e-3e97-afae-35967012b22d",
                                "text": "„Leider macht sie das manchmal nur noch wütender, weil sie sich in ihrer Unmutsäußerung nicht ernst genommen fühlen.“"
                            },
                            {
                                "example_id": "9e349977-ffbd-4cc9-b329-d5d2680df32c",
                                "sense_id": "023c8ab7-593e-3e97-afae-35967012b22d",
                                "text": "„Jesus beklagt wie bei seiner Unmutsäußerung über seine Zeitgenossen den mangelnden Glauben oder – wie man auch sagen könnte - das mangelnde Vertrauen zu Gott.“"
                            },
                            {
                                "example_id": "7a85c37c-515f-40fb-935e-2762253b7e45",
                                "sense_id": "023c8ab7-593e-3e97-afae-35967012b22d",
                                "text": "„Die erste Art oder Form von Aggression ist die Unmutsäußerung, bei der jemand als Reaktion auf äußere Einwirkungen einen wenig zielgerichteten Affekt ausdrückt.“"
                            },
                            {
                                "example_id": "6c439d88-cece-442a-9fb4-9ed89bc09030",
                                "sense_id": "023c8ab7-593e-3e97-afae-35967012b22d",
                                "text": "„Wäre die AfD tatsächlich eine ‚reine‘ Protestpartei, so wäre deren Wahl nur ein möglicher Kanal der Unmutsäußerung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
