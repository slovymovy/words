                        "examples": [
                            {
                                "example_id": "8b1230e5-43a3-45fc-8751-c1f615c5a617",
                                "sense_id": "5cfd1d5f-380f-31c4-bb4c-9a4ccb411e0c",
                                "text": "„Das Mädchen, das sich schreiend auf dem Bett herumwirft, ist ungefähr in seinem Alter und erinnert ihn an gewisse Nächte in der Besserungsanstalt. Dort hatte es eine junge Belutschin gegeben, die, sooft ihre Menstruation einsetzte, zu schreien anfing und auch nicht aufhörte, wenn man sie in eine Einzelzelle sperrte.“"
                            }
                        ],
