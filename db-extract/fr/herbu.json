                                            {
                                                "example_id": "87484088-1347-41fe-817c-3548e3fb3504",
                                                "sense_id": "23232ceb-2ae8-3eec-ba15-4268396f0f32",
                                                "text": "We threw his grassy shorts straight into the washing machine."
                                            },
                                            {
                                                "example_id": "44cf2ffb-7e12-406a-946c-d9169a89a85a",
                                                "sense_id": "23232ceb-2ae8-3eec-ba15-4268396f0f32",
                                                "text": "However, spider enthusiasts sometimes flock to the grassy region in hopes of spotting a tarantula or capturing one to keep as a pet."
                                            },
                                            {
                                                "example_id": "f9485b5a-f2e4-4812-89c5-c9d133f07da0",
                                                "sense_id": "23232ceb-2ae8-3eec-ba15-4268396f0f32",
                                                "text": "The track was stony with a grassy camber up the middle."
                                            }
                                        ]
