                    {
                        "translation_id": "6f0ca74d-44f9-4e96-ba87-685c704c52cc",
                        "source_entry_id": "b0b4c5dc-0fb6-3380-8d8b-67c4793041f6",
                        "source_sense_id": "e6bdea8b-ecfd-3a18-b20b-a8559cb99ca6",
                        "source_sense_description": "tegenslag",
                        "target_lang_word": "déception",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déception",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1fa7694e-0fd9-3b28-b2f0-b965e4b89dfc",
                                        "entry_id": "a204fb52-d127-385c-904c-2be18ff8aeff",
                                        "glosses": [
                                            "Fait d’être déçu ou de subir une situation inférieure à ses attentes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdbcc6e9-3317-4d38-8a4b-f470d25c359c",
                                                "sense_id": "1fa7694e-0fd9-3b28-b2f0-b965e4b89dfc",
                                                "text": "Après une lutte qui eut ses déceptions et ses découragements, la nature fut vaincue, les animaux nuisibles détruits ; et l’on vit naître cette zône fertile du littoral qu’on nomme encore la ceinture dorée de la Bretagne."
                                            },
                                            {
                                                "example_id": "494c6b4b-518f-4653-89b5-c4da34122d89",
                                                "sense_id": "1fa7694e-0fd9-3b28-b2f0-b965e4b89dfc",
                                                "text": "De toute manière, attendre trop de l’immigration, pour remédier à notre faiblesse démographique, serait nous exposer à des déceptions."
                                            },
                                            {
                                                "example_id": "9cdd52c5-0bfa-4a6e-aba4-79bf58857168",
                                                "sense_id": "1fa7694e-0fd9-3b28-b2f0-b965e4b89dfc",
