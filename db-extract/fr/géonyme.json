                        "glosses": [
                            "Mot dérivé de noms de villages, villes, terroirs, châteaux, montagnes, rivières et pays, et désignant, par métonymie, la chose dont il provient."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad9883a5-4f7a-4bcb-80dd-e16275c5dc99",
                                "sense_id": "29f34973-f35f-31f6-a815-d812ba80449b",
                                "text": "Les géonymes sont des mots où l’on peut se rendre."
                            },
                            {
                                "example_id": "f2dfb842-050e-489f-b880-da14e5d610ac",
                                "sense_id": "29f34973-f35f-31f6-a815-d812ba80449b",
                                "text": "Armagnac, bikini, bordeaux, frise, gruyère sont des géonymes."
                            },
                            {
                                "example_id": "c088c741-6a50-4841-b3bb-fae73b8bb797",
                                "sense_id": "29f34973-f35f-31f6-a815-d812ba80449b",
                                "text": "Le géonyme Europe nous a été transmis par les Grecs."
                            }
                        ]
