                        ],
                        "examples": [
                            {
                                "example_id": "8dfc3a47-4686-46d7-894c-58ca22f796c9",
                                "sense_id": "2fda9211-8e49-3ec6-a6bc-fcb7ffddb251",
                                "text": "Le premier volume de ce théâtre contient dix petites comédies […] entre ces dix œuvrettes, « la Fleur de Tlemcen », « les Petits cadeaux » […] nous ont principalement amusés."
                            }
