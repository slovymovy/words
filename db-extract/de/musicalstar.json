                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6ac8e5f-05d7-4d15-8b32-4ad7ea6eba2c",
                                "sense_id": "4706b865-a49a-364f-96cd-38241ca6ffe5",
                                "text": "„Wenn der Musicalstar singt, wird Davids' konventionell-dauerüberdrehte Regiearbeit augenblicklich auf ein höheres Niveau gehoben.“"
                            },
                            {
                                "example_id": "8560d3ab-4aba-42b1-8c9c-599501124de0",
                                "sense_id": "4706b865-a49a-364f-96cd-38241ca6ffe5",
                                "text": "„In Deutschland wurde Musicalstar Ute Lemper erst gefeiert, dann verrissen.“"
                            },
                            {
                                "example_id": "db4124f6-d55a-4bf5-8bf3-c1cf67b48926",
                                "sense_id": "4706b865-a49a-364f-96cd-38241ca6ffe5",
                                "text": "„Schon seit 2010 steht die zweifache Mutter als Musicalstar auf der Bühne.“"
                            }
                        ],
