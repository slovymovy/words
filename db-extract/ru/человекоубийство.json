                "translations": [
                    {
                        "translation_id": "cce01043-3665-48bc-8226-4682f6bdc9e5",
                        "source_entry_id": "38881f48-5e96-3c8d-b4c8-5907d0fdfd29",
                        "source_sense_id": "8d1aa75c-f550-3d46-84b3-dc7553a73171",
                        "target_lang_word": "homicide",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homicide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dba5c31d-8221-388d-8637-56ddc83ce9cd",
                                        "entry_id": "b6fbc25a-ef81-396c-8831-8d224a9d6dc3",
                                        "glosses": [
                                            "The killing of one person by another, whether premeditated or unintentional."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1c905dfb-80e3-3355-bddc-be92693f5b37",
                                        "entry_id": "b6fbc25a-ef81-396c-8831-8d224a9d6dc3",
                                        "glosses": [
                                            "A person who kills another."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f19e11a5-a9d9-48f8-af74-00b812e1fda8",
                                                "sense_id": "1c905dfb-80e3-3355-bddc-be92693f5b37",
                                                "text": "Homicides in general and victorious warriors in particular are often obliged to perform a variety of ceremonies for the purpose of ridding them of the dangerous ghosts of their victims."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4757f6e3-3a9a-37f1-9552-e05f3e8d0f86",
                                        "entry_id": "b6fbc25a-ef81-396c-8831-8d224a9d6dc3",
                                        "glosses": [
                                            "A victim of homicide; a person who has been unlawfully killed by someone else."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5752aa1-125b-41a9-9c01-09c1465570e7",
                                                "sense_id": "4757f6e3-3a9a-37f1-9552-e05f3e8d0f86",
                                                "text": "“She was a hippie kid. How hard would you work a case like that?”\n“As hard as anyone else,” said Goddard. There was an irritated note in his voice. “She was a homicide. She got what every homicide investigation gets.”"
                                            },
                                            {
                                                "example_id": "4ab5b429-b5ac-4ba0-8980-352e9210063b",
                                                "sense_id": "4757f6e3-3a9a-37f1-9552-e05f3e8d0f86",
                                                "text": "We don't even know the woman was a homicide. Didn't they say it was possible they both jumped?"
                                            },
                                            {
                                                "example_id": "8f8d242c-d873-4eb6-8347-40b00588a86f",
                                                "sense_id": "4757f6e3-3a9a-37f1-9552-e05f3e8d0f86",
                                                "text": "The medical examiner was behind on autopsies and cranky, so we didn't even know if the old guy in the pool was a homicide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ec15ab1-d100-3f2e-bb02-8e9647d9d153",
                                        "entry_id": "b6fbc25a-ef81-396c-8831-8d224a9d6dc3",
                                        "glosses": [
                                            "The department within a police force that investigates cases of homicide."
                                        ],
                                        "tags": [
                                            "US",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f92b51a-d30f-4038-aa18-770004efeb0c",
                        "source_entry_id": "38881f48-5e96-3c8d-b4c8-5907d0fdfd29",
                        "source_sense_id": "8d1aa75c-f550-3d46-84b3-dc7553a73171",
                        "target_lang_word": "manslaughter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manslaughter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "321970a9-558d-36dc-ba01-c9214ec699a9",
                                        "entry_id": "38937784-cf40-33c5-b691-bad8bd8c1cde",
                                        "glosses": [
                                            "The slaying of a human being."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "244ad803-4c5d-4c6f-abae-603ddda892c2",
                                                "sense_id": "321970a9-558d-36dc-ba01-c9214ec699a9",
                                                "text": "For that cause We decreed for the Children of Israel that whosoever killeth a human being for other than manslaughter or corruption in the earth, it shall be as if he had killed all mankind, and whoso saveth the life of one, it shall be as if he had saved the life of all mankind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0c9be59-f1da-3c4b-90c7-880293d525dc",
                                        "entry_id": "38937784-cf40-33c5-b691-bad8bd8c1cde",
                                        "glosses": [
                                            "The unlawful killing of a human, either in negligence or incidentally to the commission of some unlawful act, but without specific malice, or upon a sudden excitement of anger; considered less culpable than murder, but more culpable than justifiable homicide."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "326ff89f-1e0f-4d09-bece-788903fbbacc",
                        "source_entry_id": "38881f48-5e96-3c8d-b4c8-5907d0fdfd29",
                        "source_sense_id": "8d1aa75c-f550-3d46-84b3-dc7553a73171",
                        "target_lang_word": "murder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "murder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f078082f-da06-364a-8230-c9bb06aa42fb",
                                        "entry_id": "1773308b-3510-3ec8-a05d-8ea8687a00ef",
                                        "glosses": [
                                            "The crime of killing a person unlawfully, especially with predetermination."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f171039-11ee-4fe8-81b6-dd4f06a0692d",
                                                "sense_id": "f078082f-da06-364a-8230-c9bb06aa42fb",
                                                "text": "The defendant was charged with murder."
                                            },
                                            {
                                                "example_id": "1e202f9c-dc09-46ba-b590-d9e27541483c",
                                                "sense_id": "f078082f-da06-364a-8230-c9bb06aa42fb",
                                                "text": "One of the most urgent tasks facing me after 1 assumed office was to assure the country that everything possible was being done to uncover the truth surrounding the assassination of President Kennedy. John Kennedy had been murdered, and a troubled, puzzled, and outraged nation wanted to know the facts."
                                            },
                                            {
                                                "example_id": "78544f74-50d4-45a8-8c19-eef6b2323c4a",
                                                "sense_id": "f078082f-da06-364a-8230-c9bb06aa42fb",
                                                "text": "Reggie Clemons has one last chance to save his life. After 19 years on death row in Missouri for the murder of two young women, he has been granted a final opportunity to persuade a judge that he should be spared execution by lethal injection."
                                            },
                                            {
                                                "example_id": "ad5556d1-c801-469f-9846-102108400c0b",
                                                "sense_id": "f078082f-da06-364a-8230-c9bb06aa42fb",
                                                "text": "Whether modern, industrial man is less or more warlike than his hunter-gatherer ancestors is impossible to determine.[…]One thing that is true, though, is that murder rates have fallen over the centuries, as policing has spread and the routine carrying of weapons has diminished. Modern society may not have done anything about war. But peace is a lot more peaceful."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1892dda5-3301-306a-a3d0-181c469fd0d1",
                                        "entry_id": "1773308b-3510-3ec8-a05d-8ea8687a00ef",
                                        "glosses": [
                                            "The crime of killing a person unlawfully, especially with predetermination.",
                                            "The act of committing or abetting a crime that results in the killing of a person, regardless of intent, and even if the committer or abettor is not the one who killed the person: felony murder."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d50c4092-0e01-3ef4-857d-fccf6c88294e",
                                        "entry_id": "1773308b-3510-3ec8-a05d-8ea8687a00ef",
                                        "glosses": [
                                            "The act of killing a person (or sometimes another being) unlawfully, especially with predetermination"
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b89b6cd-7319-4a43-a809-35fadc91470f",
                                                "sense_id": "d50c4092-0e01-3ef4-857d-fccf6c88294e",
                                                "text": "There have been ten unsolved murders this year alone."
                                            },
                                            {
                                                "example_id": "e77b18b5-a230-4b5f-847d-51ef2cef9165",
                                                "sense_id": "d50c4092-0e01-3ef4-857d-fccf6c88294e",
                                                "text": "The case was that of a murder. It had an element of mystery about it, however, which was puzzling the authorities. A turban and loincloth soaked in blood had been found; also a staff."
                                            },
                                            {
                                                "example_id": "d342d98c-c38d-4b1e-9ca1-3a81ef775471",
                                                "sense_id": "d50c4092-0e01-3ef4-857d-fccf6c88294e",
                                                "text": "It may be guessed, indeed, that this was the original form of the story, the fairy being the addition of those who considered Jack's thefts from (and murder of) the giant to be scarcely justified without her."
                                            },
                                            {
                                                "example_id": "2d5f84d9-aa72-4d83-8e00-548e493a7038",
                                                "sense_id": "d50c4092-0e01-3ef4-857d-fccf6c88294e",
                                                "text": "Life is cheap, never forget it. Corporations make marketing decisions by weighing the cost of being sued for your death against the cost of making the product safer. Your life is a factor in cost-effectiveness. So when you talk about murder, don't confine your discussion to individuals."
                                            },
                                            {
                                                "example_id": "fad0fa23-fa92-4665-ae04-ea9186f761c0",
                                                "sense_id": "d50c4092-0e01-3ef4-857d-fccf6c88294e",
                                                "text": "Captain Sulu, who served under the legendary James T. Kirk for many years, disobeys Starfleet orders in order to try and help Kirk and another old shipmate, Dr. McCoy, who have been imprisoned for the murder of the Klingon chancellor."
                                            },
                                            {
                                                "example_id": "c0cbcfb8-0b5d-46b9-b910-06bea36e0b37",
                                                "sense_id": "d50c4092-0e01-3ef4-857d-fccf6c88294e",
                                                "text": "Dr. Herrera also knew Hemingway had held Batista's army personally responsible for the brutal murders of his dogs, Blackie (Black Dog) and Machakos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2af6ff7c-dadf-3ecd-a9f6-799657257078",
                                        "entry_id": "1773308b-3510-3ec8-a05d-8ea8687a00ef",
                                        "glosses": [
                                            "Something terrible to endure."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d75cfb0-fd8a-4efa-acd6-cec1ed159a5e",
                                                "sense_id": "2af6ff7c-dadf-3ecd-a9f6-799657257078",
                                                "text": "This headache is murder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8427a65f-65f8-3dc8-8653-a2dc34d92346",
                                        "entry_id": "1773308b-3510-3ec8-a05d-8ea8687a00ef",
                                        "glosses": [
                                            "A group of crows; the collective noun for crows."
                                        ],
                                        "tags": [
                                            "collective",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa76dd6c-2b4b-433d-8917-66fd2ab4990e",
                                                "sense_id": "8427a65f-65f8-3dc8-8653-a2dc34d92346",
                                                "text": "For his part, Melchior was growing unhappy with the murder of crows. They had been patiently following Arthur for hours, trailing him from town to country."
                                            },
                                            {
                                                "example_id": "26aa1191-a81c-4852-b99a-bcc0b59f3120",
                                                "sense_id": "8427a65f-65f8-3dc8-8653-a2dc34d92346",
                                                "text": "Without the murder of crows roosting in its branches, Nevermore Tree looked as bare as a skeleton."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a8df108-2084-3565-84ba-8d3fb85a73dc",
                                        "entry_id": "1773308b-3510-3ec8-a05d-8ea8687a00ef",
                                        "glosses": [
                                            "Something remarkable or impressive."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe43126e-4fea-45af-8eae-2fd0b6bab3e7",
                                                "sense_id": "9a8df108-2084-3565-84ba-8d3fb85a73dc",
                                                "text": "Right quick another cat spoke up real loud, saying, “That’s murder man, really murder,” and his eyes were signifying too."
                                            },
                                            {
                                                "example_id": "f884c74a-9a19-45c9-9fd0-802974184e25",
                                                "sense_id": "9a8df108-2084-3565-84ba-8d3fb85a73dc",
                                                "text": "Altaira Morbius: [swimming in a pool] Come on in.\nCommander Adams: I didn't bring my bathing suit.\nAltaira Morbius: What's a bathing suit?\nCommander Adams: [quickly turning his back] Oh, murder!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02f0f39c-ef0b-3c57-86aa-0e54d1a9b508",
                                        "entry_id": "1773308b-3510-3ec8-a05d-8ea8687a00ef",
                                        "glosses": [
                                            "a murderer"
                                        ],
                                        "tags": [
                                            "countable",
                                            "nonstandard",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "murder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f03610ab-3d91-3831-8e42-8a5969ba5f65",
                                        "entry_id": "05a6a5ce-6298-3772-82bf-3fc402d9172a",
                                        "glosses": [
                                            "To illegally kill (a person or persons) with intent, especially with predetermination"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65e30596-be35-4f02-8853-aa98e228a265",
                                                "sense_id": "f03610ab-3d91-3831-8e42-8a5969ba5f65",
                                                "text": "The woman found dead in her kitchen was murdered by her husband."
                                            },
                                            {
                                                "example_id": "1d63c893-e877-4cf9-af95-93fd464adefc",
                                                "sense_id": "f03610ab-3d91-3831-8e42-8a5969ba5f65",
                                                "text": "In the meane time it chaunced, that Marcus Papyrius ſtroke one of the Galles on the heade with his ſtaffe, because he preſumed to ſtroke his bearde: with whiche iniurie the Gaulle beeing prouoked, ſlue Papyrius (as he ſate) with hys ſworde, and therewith the ſlaughter being begun with one, all the reſidue of thoſe auncient fatherly men as they ſat in theyr Chayres were ſlaine and cruelly murthered."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab34ea94-43a4-3e31-8f7e-dbbb5b318da8",
                                        "entry_id": "05a6a5ce-6298-3772-82bf-3fc402d9172a",
                                        "glosses": [
                                            "To defeat decisively."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "excessive",
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11b89738-bfff-40e2-8c15-5f4a395f2a88",
                                                "sense_id": "ab34ea94-43a4-3e31-8f7e-dbbb5b318da8",
                                                "text": "Our team is going to murder them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a1c5098-4ce7-3760-b8a7-125508ad414d",
                                        "entry_id": "05a6a5ce-6298-3772-82bf-3fc402d9172a",
                                        "glosses": [
                                            "To kick someone's ass or chew someone out (used to express one’s anger at somebody)."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "excessive",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb3da5ed-0452-4756-901a-ebe4e2c6dde6",
                                                "sense_id": "2a1c5098-4ce7-3760-b8a7-125508ad414d",
                                                "text": "He's torn my best shirt. When I see him, I'll murder him!"
                                            }
                                        ]
                                    },
