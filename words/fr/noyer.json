                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le peintre a <w>noyé</w> la petite silhouette du promeneur dans un immense paysage brumeux."
                        },
                        {
                            "text": "L'auteur choisit de <w>noyer</w> l'information cruciale parmi des détails inutiles."
