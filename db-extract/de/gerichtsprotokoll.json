                "senses": [
                    {
                        "sense_id": "1efad50c-057a-32c8-9777-0055079fe05e",
                        "entry_id": "cc2dbe3b-5dc5-33b8-9076-1f66614c1ef2",
                        "glosses": [
                            "schriftliche Aufzeichnung eines Gerichtsverfahrens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bd489e4-87d9-44f9-8778-fa2df2999df0",
                                "sense_id": "1efad50c-057a-32c8-9777-0055079fe05e",
                                "text": "„Das Gerichtsprotokoll, die Akten und die Erzählungen der Ermittler, mit denen sie sich drei Tage lang fast ohne Unterbrechung intensiv beschäftigt hatte, hatten ihren Verstand wohl überladen.“"
                            },
                            {
                                "example_id": "c0200227-4e26-42c9-b3cb-39712fa698f2",
                                "sense_id": "1efad50c-057a-32c8-9777-0055079fe05e",
                                "text": "„Es waren Aussagen und sonstige Unterlagen zu ungelösten Fällen, Gerichtsprotokolle und zahlreiche ausführliche Polizeiberichte.“"
                            },
                            {
                                "example_id": "be09733c-2526-41a3-8f9e-407caed8a20f",
                                "sense_id": "1efad50c-057a-32c8-9777-0055079fe05e",
                                "text": "„Ihm ist klar, dass die Cops mehr als nur eine Suchmaschine benutzen, und sie haben bestimmt das Vorstrafenregister und Gerichtsprotokolle zur Verfügung, aber all das ist nutzlos, wenn sie nicht wissen, wo sie mit der Suche anfangen sollen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
