            {
                "entry_id": "4b67c4a7-b5a0-3d78-822f-4d7305c2f16a",
                "word": "дорогая",
                "pos": "noun",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "475f86ae-9d7d-3596-86e5-d177a3dc7eb5",
                        "entry_id": "4b67c4a7-b5a0-3d78-822f-4d7305c2f16a",
                        "glosses": [
                            "субстантивир., разг., : женск. к дорогой; та, кто мила, любима, близка сердцу"
                        ],
                        "tags": [
                            "тж. в качестве обращения, в т. ч. ирон."
                        ],
                        "examples": [
                            {
                                "example_id": "57a1bcf7-66f8-4788-ad20-fd15cc0543fe",
                                "sense_id": "475f86ae-9d7d-3596-86e5-d177a3dc7eb5",
                                "text": "— Дорогой, куда пошёл? // — Дорогая, по́ воду! // — Дорогой, не простудись, // По такому холоду!"
                            },
                            {
                                "example_id": "136347fe-0bd2-40ec-97bb-d29dced8ad84",
                                "sense_id": "475f86ae-9d7d-3596-86e5-d177a3dc7eb5",
                                "text": "— Дорогой, далёко ль едешь? // — Дорогая, на Кавказ! // — Дорогой, возьми с собою! // — Дорогая, много вас!"
                            },
                            {
                                "example_id": "6da3bc45-62ce-4b81-96ae-21bd3dfba409",
                                "sense_id": "475f86ae-9d7d-3596-86e5-d177a3dc7eb5",
                                "text": "Дорогой, дорогая, — // Дорогие оба! // Дорогая дорогого // Довела до гроба!"
                            },
                            {
                                "example_id": "46fc7e72-ae78-4730-83a7-dab641d06b68",
                                "sense_id": "475f86ae-9d7d-3596-86e5-d177a3dc7eb5",
                                "text": "Наконец один врач сказал мне «по секрету»: «У тебя, дорогая, всё в порядке.»"
                            },
                            {
                                "example_id": "2ce46549-b60b-429a-b78f-7e311cce1f22",
                                "sense_id": "475f86ae-9d7d-3596-86e5-d177a3dc7eb5",
                                "text": "Я никогда не мечтал быть машинистом, не представлял себе, что буду прощаться с женой перед долгим рейсом и говорить: «Дорогая, не волнуйся!»"
                            }
                        ]
                    }
                ],
