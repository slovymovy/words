                    },
                    {
                        "form_id": "cdcc2078-33f8-46ec-afca-ef10fd0c6e74",
                        "entry_id": "d8bce0ea-79c3-3010-8040-cd255416af18",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most rebarbative"
