    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "80feb5ea-1c70-3da5-b001-47a0e280b259",
                "word": "masque",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d2677e87-58fe-4311-8a10-eee52fac2699",
                        "entry_id": "80feb5ea-1c70-3da5-b001-47a0e280b259",
                        "tags": [
                            "plural"
                        ],
                        "form": "masques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5e681962-7acf-37d8-b1d7-3f0db4a1c942",
                        "entry_id": "80feb5ea-1c70-3da5-b001-47a0e280b259",
                        "glosses": [
                            "A dramatic performance, often performed at court as a royal entertainment, consisting of dancing, dialogue, pantomime and song."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "2c211463-7e37-487a-b732-bc70b5f0cf56",
                                "sense_id": "5e681962-7acf-37d8-b1d7-3f0db4a1c942",
                                "text": "\"I think,\" said Anne to Madame de Mercœur, \"we must obtain your protégée's services for our intended masque; however, I shall leave that to you young people to settle,\" turning to Louis as she spoke."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e408fb5-93a2-3756-8a1a-b715593c5bb4",
                        "entry_id": "80feb5ea-1c70-3da5-b001-47a0e280b259",
                        "glosses": [
                            "Words and music written for a masque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8eea6e8-da96-4c90-9576-8df9e20f4d66",
                                "sense_id": "4e408fb5-93a2-3756-8a1a-b715593c5bb4",
                                "text": "Over six sections – a prologue, a life-story, a dream-quest, a dirge, a masque and an epilogue – they meditate on their lives, their hopes, their losses, and on the human condition."
                            }
                        ]
                    },
                    {
                        "sense_id": "be91056b-5b44-325d-822b-905e446f4122",
                        "entry_id": "80feb5ea-1c70-3da5-b001-47a0e280b259",
                        "glosses": [
                            "A masquerade."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b9a08d4-570a-48ca-beaa-9e5e7ee3a560",
                                "sense_id": "be91056b-5b44-325d-822b-905e446f4122",
                                "text": "The game of pretence is enhanced by dressing-up, and it is natural for a child to copy some grown-up hero. The game was also played by all those people who have attended masques and fancy-dress parties and by Marie-Antoinette when she played at being a milkmaid, it is only the fashion which had altered."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b718923-a7e7-3105-bb42-b54d9dad45f7",
                        "entry_id": "80feb5ea-1c70-3da5-b001-47a0e280b259",
                        "glosses": [
                            "Obsolete form of mask."
                        ],
                        "tags": [
                            "alt-of",
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c2c6633d-fe77-358f-b23f-5f163740bc82",
                        "entry_id": "80feb5ea-1c70-3da5-b001-47a0e280b259",
                        "glosses": [
                            "A facial mask."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66ee1708-b3fa-4063-8b68-4db9dc53831a",
                                "sense_id": "c2c6633d-fe77-358f-b23f-5f163740bc82",
                                "text": "mud masque; clay masque"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
