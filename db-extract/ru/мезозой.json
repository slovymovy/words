                                    {
                                        "sense_id": "7c4bd3d0-2f01-3812-963e-af84f049ee00",
                                        "entry_id": "956f1bb1-0bd6-3728-97f6-0a5e47bc748d",
                                        "glosses": [
                                            "Deuxième ère du Phanérozoïque, s’étendant de l’extinction massive du Permien (-245 millions d’années) à celle du Crétacé (-65 millions d’années)."
                                        ],
                                        "tags": [],
                                        "examples": [
