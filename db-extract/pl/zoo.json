                "translations": [
                    {
                        "translation_id": "d33f0800-3109-4319-a22c-3e62558d6fd0",
                        "source_entry_id": "0883b376-e0ef-39b6-a1ec-e335338cdd23",
                        "source_sense_id": "24006dec-10ce-343f-96a4-a486e372d00a",
                        "target_lang_word": "zoo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zoo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c8e6325-e293-3eea-be7d-02f2788e534e",
                                        "entry_id": "df3e2245-af29-33cc-abfa-7bb43ba08624",
                                        "glosses": [
                                            "A park where live animals are exhibited."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da7e558f-5c09-4722-9f5e-c5c28c804b63",
                                                "sense_id": "3c8e6325-e293-3eea-be7d-02f2788e534e",
                                                "text": "The London Zoo was built in 1828."
                                            },
                                            {
                                                "example_id": "2aca1e90-6f44-42cf-bd73-ab041fc527b3",
                                                "sense_id": "3c8e6325-e293-3eea-be7d-02f2788e534e",
                                                "text": "The San Juan market is Mexico City's most famous deli of exotic meats, where an adventurous shopper can hunt down hard-to-find critters such as ostrich, wild boar and crocodile. Only the city zoo offers greater species diversity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c595f8d1-306f-3051-99af-568cf1a2d198",
                                        "entry_id": "df3e2245-af29-33cc-abfa-7bb43ba08624",
                                        "glosses": [
                                            "Any place that is wild, crowded, or chaotic."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20863bc5-5e9f-46b0-ac4a-01ccf4e005d6",
                                                "sense_id": "c595f8d1-306f-3051-99af-568cf1a2d198",
                                                "text": "The shopping center was a zoo the week before Christmas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92cd80ac-54fe-375c-8170-f95f90f22667",
                                        "entry_id": "df3e2245-af29-33cc-abfa-7bb43ba08624",
                                        "glosses": [
                                            "A large and varied collection of something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10010c4a-2049-4fee-9d36-fcd01a884ceb",
                                                "sense_id": "92cd80ac-54fe-375c-8170-f95f90f22667",
                                                "text": "After his insightful book The Art of Alfred Hitchcock, Spoto published The Dark Side of Genius, a portrayal of the elderly director as a lonely man who was a veritable zoo of desires, suspicions, fears, and addictions (food, drink, romantic infatuation, and filmmaking)."
                                            },
                                            {
                                                "example_id": "792e7317-08d2-4ebd-ade7-36b8ae8f0228",
                                                "sense_id": "92cd80ac-54fe-375c-8170-f95f90f22667",
                                                "text": "From this point on, an entire zoo of possibilities arose: strange stars, different families of neutron stars, hybrid stars, etc."
                                            },
                                            {
                                                "example_id": "2c00a2ea-1039-4290-8d0d-525ff29c932d",
                                                "sense_id": "92cd80ac-54fe-375c-8170-f95f90f22667",
                                                "text": "But powerful as the quark model and the electroweak theory were in describing the zoo of subatomic particles, this still left a huge gap."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e737476a-6cfc-340d-8152-591ab828d4b4",
                                        "entry_id": "df3e2245-af29-33cc-abfa-7bb43ba08624",
                                        "glosses": [
                                            "The jungle."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87cd0921-0317-49c4-b8ef-410bb753ad25",
                                                "sense_id": "e737476a-6cfc-340d-8152-591ab828d4b4",
                                                "text": "I'm not all that unhappy about being out on an actual patrol, but there's a worried feeling wandering around the back of my mind, not exactly fear, more like a sort of lurking anxiety at being out in the dreaded jungle, the zoo, where the enemy hides."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6ea259d-0bb7-39f3-9484-2d1ac7843155",
                                        "entry_id": "df3e2245-af29-33cc-abfa-7bb43ba08624",
                                        "glosses": [
                                            "Clipping of zoophile."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "countable",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e434e4d-ff83-4f26-b1ff-2a29c69f8bb4",
                                                "sense_id": "f6ea259d-0bb7-39f3-9484-2d1ac7843155",
                                                "text": "Zoophiles, or 'zoos,' are sexually and emotionally attracted to animals, as in a sexual orientation."
                                            },
                                            {
                                                "example_id": "5c65b8aa-aaa4-48a7-88ed-a92e0eb1d453",
                                                "sense_id": "f6ea259d-0bb7-39f3-9484-2d1ac7843155",
                                                "text": "Bestiality or zoophilia—whatever we decide to call it—is one of the most pressing issues for all domesticated animals, […] From the scanty research available, the following picture emerges: the majority of zoos are male, though certainly not all; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31d4725f-70f6-3a37-b8a3-36b3d0e68d4d",
                                        "entry_id": "df3e2245-af29-33cc-abfa-7bb43ba08624",
                                        "glosses": [
                                            "Clipping of zoophile.",
                                            "Pornographic material depicting actual animals or bestiality."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
