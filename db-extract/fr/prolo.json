                        ],
                        "examples": [
                            {
                                "example_id": "4a5d3d3a-534a-477d-a1ad-1241f4f930e1",
                                "sense_id": "601ac0e5-4f72-3b15-8bb7-ede3fca476d5",
                                "text": "Le matin, à l’heure où je rentre de boîte, les prolos partent au taf.",
