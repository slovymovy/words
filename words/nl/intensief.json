                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "taalkunde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het woord piepklein is een <w>intensief</w> van het woord klein.",
                            "target_lang_translations": {
                                "en": "The word 'piepklein' is an <w>intensive</w> of the word 'klein'."
                            }
                        },
                        {
                            "text": "In de taalkunde noemt men een versterkt bijvoeglijk naamwoord soms een <w>intensief</w>.",
                            "target_lang_translations": {
                                "en": "In linguistics, a reinforced adjective is sometimes called an <w>intensive</w>."
