                        "translation_id": "96d3edb1-ed53-4c9d-945a-c9d6312d42a0",
                        "source_entry_id": "f3035140-1b93-3cdc-8c2b-cad4a451d320",
                        "source_sense_id": "d6f30f73-86e2-3ce8-b05c-25dc14f505df",
