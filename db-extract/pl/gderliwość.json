                        "translation_id": "0512566b-7619-4a74-9a3d-8fd9fbfb17e8",
                        "source_entry_id": "8a6467dd-3b11-3ba9-9692-0e126bc895d0",
                        "source_sense_id": "18c9f492-7918-3db7-b355-d8b6d7b29449",
