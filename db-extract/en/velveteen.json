                        "source_entry_id": "2e49dff4-c8d5-398e-ab4c-4fcef08f0e1c",
                        "source_sense_id": "f50d98a5-62ce-3846-9297-b65ab91de122",
                        "source_sense_description": "cotton fabric with a short pile",
                        "target_lang_word": "вельве́т",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "вельве́т",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6b64c912-58fd-30ac-93aa-5a926bc3261d",
                                        "entry_id": "68254e77-83f1-3fdf-a121-32c20c02fac0",
                                        "glosses": [
                                            "текст. хлопчатобумажная ткань с густым ворсом, напоминающая бархат и имеющая продольные рубчики на лицевой стороне"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63902b60-9160-4f5a-9cd4-0e3e9b6b39ba",
                                                "sense_id": "6b64c912-58fd-30ac-93aa-5a926bc3261d",
                                                "text": "На ногах участкового были огромные валенки, одет он был в куртку из коричневого вельвета и стеганые брюки."
                                            },
                                            {
                                                "example_id": "47929771-c2c0-4a4b-81a1-9cbed5891aa4",
                                                "sense_id": "6b64c912-58fd-30ac-93aa-5a926bc3261d",
                                                "text": "На груди его четырёхкарманной куртки из мягкого синего вельвета был приколот альпинистский значок: снежная вершина Эльбруса на фоне голубого неба, а на переднем плане ― ледоруб."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d27951f-7a97-392d-be29-352ce67aa9ea",
                                        "entry_id": "68254e77-83f1-3fdf-a121-32c20c02fac0",
                                        "glosses": [
                                            "перен., разг. изделия из такой ткани"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f2674f1-62b1-45cb-b01c-4d64d8693c02",
                                                "sense_id": "2d27951f-7a97-392d-be29-352ce67aa9ea",
                                                "text": "Пожилые кавказцы с бритыми щеками и пронзительными глазами, в огромных, плоских кепках; иностранные туристы в вельвете, замше и потертых джинсах, с европейским вежливо-отчужденным выражением лиц…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae3459bc-74e2-3e4a-ad7b-3b15047b06cf",
                                        "entry_id": "68254e77-83f1-3fdf-a121-32c20c02fac0",
                                        "glosses": [
                                            "перен. разг. спорт. мелковолнистый снежный рельеф на склоне для горнолыжного спуска, формируемый ратраками"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ea17963-b21f-40e8-87ba-4feef968914a",
                                                "sense_id": "ae3459bc-74e2-3e4a-ad7b-3b15047b06cf",
                                                "text": "Лыжи исключительно трассовые, для хорошо подготовленных трасс, поэтому придется встать пораньше, чтобы застать свежий вельвет…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
