                {
                    "sense_id": "f7ae49b6-be38-3f08-854c-38bbcb88c6b5",
                    "sense_definition": "Ulewny, gwałtowny deszcz dający w krótkim czasie duże ilości wody.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gdy wspięliśmy się na sam szczyt, dopadła nas ogromna <w>ulewa</w>.",
                            "target_lang_translations": {
                                "en": "When we reached the very top, a huge <w>downpour</w> caught us.",
                                "ru": "Когда мы поднялись на самую вершину, нас настиг сильнейший <w>ливень</w>.",
                                "nl": "Toen we de top bereikten, werden we overvallen door een enorme <w>stortbui</w>.",
                                "de": "Als wir ganz oben auf dem Gipfel ankamen, erwischte uns ein gewaltiger <w>Wolkenbruch</w>.",
                                "fr": "Lorsque nous avons atteint le sommet, une énorme <w>averse</w> nous a surpris.",
                                "it": "Quando siamo saliti in cima, ci ha sorpreso un enorme <w>acquazzone</w>.",
                                "cs": "Když jsme vystoupali na samotný vrchol, zastihl nás obrovský <w>liják</w>.",
                                "tr": "Tam zirveye tırmandığımızda büyük bir <w>sağanağa</w> yakalandık.",
                                "es": "Cuando llegamos a la cima, nos sorprendió un tremendo <w>aguacero</w>.",
                                "zh": "当我们爬到山顶时，突遭一场大<w>暴雨</w>。"
                            }
                        },
                        {
                            "text": "Nagła <w>ulewa</w> zaskoczyła kierowców na autostradzie.",
                            "target_lang_translations": {
                                "en": "A sudden <w>downpour</w> caught drivers on the highway by surprise.",
                                "ru": "Внезапный <w>ливень</w> застал врасплох водителей на автомагистрали.",
                                "nl": "Een plotselinge <w>stortbui</w> verraste de automobilisten op de snelweg.",
                                "de": "Ein plötzlicher <w>Platzregen</w> überraschte die Autofahrer auf der Autobahn.",
                                "fr": "Une <w>averse</w> soudaine a surpris les automobilistes sur l'autoroute.",
                                "it": "Un improvviso <w>nubifragio</w> ha colto di sorpresa gli automobilisti sull'autostrada.",
                                "cs": "Náhlá <w>průtrž mračen</w> překvapila řidiče na dálnici.",
                                "tr": "Ani <w>sağanak</w> otoyoldaki sürücüleri hazırlıksız yakaladı.",
                                "es": "Un repentino <w>chaparrón</w> sorprendió a los conductores en la autopista.",
                                "zh": "突如其来的<w>暴雨</w>让高速公路上的司机措手不及。"
                            }
                        }
                    ],
                    "synonyms": [
                        "oberwanie chmury",
                        "pompa"
                    ],
                    "antonyms": [
                        "mżawka"
                    ],
                    "common_phrases": [
                        "nagła ulewa"
                    ],
                    "target_lang_definitions": {
                        "en": "Heavy, violent rain that delivers a large amount of water in a short time.",
                        "ru": "Сильный, проливной дождь, дающий за короткое время большое количество воды.",
                        "nl": "Een zware, hevige regenbui waarbij in korte tijd veel water valt.",
                        "de": "Heftiger, starker Regen, der in kurzer Zeit große Wassermengen mit sich bringt.",
                        "fr": "Pluie violente et abondante qui apporte en peu de temps une grande quantité d'eau.",
                        "it": "Pioggia violenta e torrenziale che rilascia una grande quantità d'acqua in breve tempo.",
                        "cs": "Hustý, prudký déšť, při kterém v krátkém čase spadne velké množství vody.",
                        "tr": "Kısa sürede bol miktarda su bırakan, şiddetli ve yoğun yağmur.",
                        "es": "Lluvia repentina, fuerte y abundante que descarga gran cantidad de agua en poco tiempo.",
                        "zh": "短时间内降水量极大的狂风暴雨或强降雨。"
                    },
