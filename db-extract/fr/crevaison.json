        "fr-extract.jsonl": [
            {
                "entry_id": "9aa37b03-1edb-30be-a5ae-b7c6a8562428",
                "word": "crevaison",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4225d540-02aa-4ca1-ac11-961c85cd21ae",
                        "entry_id": "9aa37b03-1edb-30be-a5ae-b7c6a8562428",
                        "tags": [
                            "plural"
                        ],
                        "form": "crevaisons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b2270ce5-2ace-3f79-a9cc-c4037e56237e",
                        "entry_id": "9aa37b03-1edb-30be-a5ae-b7c6a8562428",
                        "glosses": [
                            "Éclatement d’un pneu, ou dégonflement du pneu parce qu’il est percé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "532fcd39-dbaf-4054-a736-ce4a9c748072",
                                "sense_id": "b2270ce5-2ace-3f79-a9cc-c4037e56237e",
                                "text": "Deux crevaisons de pneus : l'une au milieu de la Camargue; l'autre en plein mitan de la Crau."
                            },
                            {
                                "example_id": "479af32c-907f-4285-969b-7a5e35f34600",
                                "sense_id": "b2270ce5-2ace-3f79-a9cc-c4037e56237e",
                                "text": "Frédéric Moncassin, trois fois top 10 sur Paris-Roubaix, dresse un des scénarios possibles : « Une crevaison, si ça arrive dans un secteur pavé, le mec va se faire dépanner un peu loin, il va remonter dans les voitures. Il va devoir rouler sur les bords, et il risque de crever ou d’être ralenti. Une fois qu’on a pris la mauvaise crevaison, la course devient moins facile. »"
                            }
                        ]
                    },
                    {
                        "sense_id": "f4d90c1f-6e23-36db-95e3-a899d20d361d",
                        "entry_id": "9aa37b03-1edb-30be-a5ae-b7c6a8562428",
                        "glosses": [
                            "Mort, action de crever."
                        ],
                        "tags": [
                            "colloquial",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "75e70f0e-c388-4ac1-abc6-0907e5336f7e",
                                "sense_id": "f4d90c1f-6e23-36db-95e3-a899d20d361d",
                                "text": "Oh ! Maintenant, puisque rien ne pouvait le corriger, pas même la peur de sa crevaison prochaine, elle jurait de ne plus se gêner ; le ménage irait à la six-quatre-deux, elle s'en battait l'œil."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d1abbf73-b1e1-4b6c-95f3-e52c36d9d855",
                        "source_entry_id": "9aa37b03-1edb-30be-a5ae-b7c6a8562428",
                        "source_sense_description": "Mécanique",
                        "target_lang_word": "Reifenpanne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reifenpanne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "63b147b1-e182-3325-aea2-3c9187fb0043",
                                        "entry_id": "2af25a47-3104-3992-99a2-11b6f6f83da8",
                                        "glosses": [
                                            "Panne, ausgelöst durch einen schadhaften Reifen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdc2494a-0558-4eec-9e29-f38f45bd3c62",
                                                "sense_id": "63b147b1-e182-3325-aea2-3c9187fb0043",
                                                "text": "„Es reicht schon eine Reifenpanne oder ein leerer Benzinkanister - schon stellt sich das starke Gefühl von der gnadenlosen Weite ein, die einem hier, im wilden Nordwesten Australiens, auf Schritt und Tritt umfängt.“"
                                            },
                                            {
                                                "example_id": "e6e0f67a-6746-4151-bc5e-d113c46a1a38",
                                                "sense_id": "63b147b1-e182-3325-aea2-3c9187fb0043",
                                                "text": "„Mit 1,78 Promille hat sich ein 57-Jähriger in München ans Steuer gesetzt und ist schließlich im Landkreis Freising bei Gerlhausen mit einer Reifenpanne gelandet.“"
                                            },
                                            {
                                                "example_id": "c9f6e1dd-adb9-4e45-ab4d-a6c13a6a4504",
                                                "sense_id": "63b147b1-e182-3325-aea2-3c9187fb0043",
                                                "text": "„Als ich das erste Mal nach Heidelberg kam, war ich mit einem Auto der Militärregierung unterwegs, und wir hatten eine Reifenpanne auf der Autobahn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50f02d19-0abd-4239-ad74-86ebb819ae74",
                        "source_entry_id": "9aa37b03-1edb-30be-a5ae-b7c6a8562428",
                        "source_sense_description": "Mécanique",
                        "target_lang_word": "puncture",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "puncture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c3040b9-d806-3fc5-8c10-2dee99b9338f",
                                        "entry_id": "fc113d4c-509f-3ff4-ba44-0ba800c0623d",
                                        "glosses": [
                                            "The act or an instance of puncturing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b05a2fe8-3540-3825-a74d-09b6bf4f319a",
                                        "entry_id": "fc113d4c-509f-3ff4-ba44-0ba800c0623d",
                                        "glosses": [
                                            "A hole, cut, or tear created by a sharp object."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfb2da81-4614-4e08-9472-d3a62c90b070",
                                                "sense_id": "b05a2fe8-3540-3825-a74d-09b6bf4f319a",
                                                "text": "There were two small punctures in his arm where the snake's fangs had pierced the skin."
                                            },
                                            {
                                                "example_id": "e56aeeb2-4fd8-4bc4-ab47-d51dce8d330a",
                                                "sense_id": "b05a2fe8-3540-3825-a74d-09b6bf4f319a",
                                                "text": "The lion may perish by the puncture of an asp."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c527f29-4078-3d44-8414-0670ae41213e",
                                        "entry_id": "fc113d4c-509f-3ff4-ba44-0ba800c0623d",
                                        "glosses": [
                                            "A hole in a vehicle's tyre, causing the tyre to deflate."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbe29ac6-c02e-42d7-aaec-0754dc950bfe",
                                                "sense_id": "9c527f29-4078-3d44-8414-0670ae41213e",
                                                "text": "On the way back we got a puncture, and we were stuck at the roadside for three hours until help arrived."
                                            },
                                            {
                                                "example_id": "691edb6d-4a5f-4b76-a329-84ca1edd25ab",
                                                "sense_id": "9c527f29-4078-3d44-8414-0670ae41213e",
                                                "text": "Dieter's car had suffered a puncture on the RN3 road between Paris and Meaux. A bent nail was stuck in the tire."
                                            },
                                            {
                                                "example_id": "4cbe8636-127f-483b-853b-3e65667bdb91",
                                                "sense_id": "9c527f29-4078-3d44-8414-0670ae41213e",
                                                "text": "A tough test for even the strongest climber, it was new to the Tour de France this year, but its debut will be remembered for the wrong reasons after one of those spectators scattered carpet tacks on the road and induced around 30 punctures among the group of riders including Bradley Wiggins, the Tour's overall leader, and his chief rivals."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "puncture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c03cfc2-0466-3f76-b26b-8bda977eecec",
                                        "entry_id": "3b989f65-3915-33a1-b87b-0dd49982052f",
                                        "glosses": [
                                            "To pierce; to break through; to tear a hole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "095c732a-1770-43f6-ab16-40eeb204fa5f",
                                                "sense_id": "1c03cfc2-0466-3f76-b26b-8bda977eecec",
                                                "text": "The needle punctured the balloon instantly."
                                            },
                                            {
                                                "example_id": "cc24570d-6168-4cc9-9973-4a29be36acb4",
                                                "sense_id": "1c03cfc2-0466-3f76-b26b-8bda977eecec",
                                                "text": "The couple all bloody / Tongues punctured by each other's teeth / Died and didn't let go"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b476572-3245-347b-ae9f-f66724bf8616",
                                        "entry_id": "3b989f65-3915-33a1-b87b-0dd49982052f",
                                        "glosses": [
                                            "To destroy the vitality or strength of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5efc2fd-26f8-490e-bf39-a836b6954e7f",
                                                "sense_id": "6b476572-3245-347b-ae9f-f66724bf8616",
                                                "text": "The woebegone children have their aspirations slowly snuffed. Grace’s artistic dreams (of animation, of course) are punctured by her isolated existence; Gilbert’s pyrophilia is smothered by religious extremism."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
