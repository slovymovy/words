    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "63a64669-cd77-3db2-82d1-bc4a3f274fec",
                    "sense_definition": "Entretien avec un professionnel, particulièrement un médecin ou un avocat, pour obtenir un avis, un diagnostic ou des soins.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "medical_legal_meeting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai pris un rendez-vous pour une <w>consultation</w> chez le médecin demain matin."
                        },
                        {
                            "text": "Le prix de la <w>consultation</w> médicale a légèrement augmenté cette année."
                        }
                    ],
                    "synonyms": [
                        "visite",
                        "rendez-vous"
                    ],
                    "common_phrases": [
                        "consultation médicale",
                        "prendre une consultation",
                        "salle de consultation"
                    ]
                },
                {
                    "sense_id": "d1158eab-a06a-375b-82ab-be3e74a9e0d9",
                    "sense_definition": "Action de lire, de vérifier ou d'examiner un document ou un ouvrage pour y trouver des informations.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reading_examination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces documents d'archives sont réservés à la <w>consultation</w> sur place."
                        },
                        {
                            "text": "La <w>consultation</w> de vos comptes bancaires reste accessible gratuitement en ligne."
                        }
                    ],
                    "synonyms": [
                        "examen",
                        "lecture"
                    ],
                    "common_phrases": [
                        "consultation sur place",
                        "consultation en ligne",
                        "consultation libre"
                    ]
                },
                {
                    "sense_id": "c1360a53-3eb3-3886-b4ca-e7507a2bb3ff",
                    "sense_definition": "Action d'interroger formellement des citoyens ou un groupe de personnes par un vote, un sondage ou un référendum.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "public_vote",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement a organisé une vaste <w>consultation</w> citoyenne avant de réformer la loi."
                        },
                        {
                            "text": "Les résultats de cette <w>consultation</w> populaire ont surpris de nombreux observateurs politiques."
