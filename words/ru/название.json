    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3ed23632-c10e-3415-a2ee-acbbed5e8cdb",
                    "sense_definition": "Словесное обозначение предмета, географического объекта, произведения или явления.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "naming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я забыл <w>название</w> этого интересного фильма.",
                            "target_lang_translations": {
                                "en": "I forgot the <w>title</w> of this interesting movie.",
                                "zh": "我忘了这部有趣电影的<w>名字</w>。"
                            }
                        },
                        {
                            "text": "На карте города появилось новое <w>название</w> улицы.",
                            "target_lang_translations": {
                                "en": "A new street <w>name</w> appeared on the city map.",
                                "zh": "城市地图上出现了一个新的街道<w>名称</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "наименование"
                    ],
                    "common_phrases": [
                        "название книги",
                        "дать название",
                        "под названием",
                        "красивое название"
                    ],
                    "target_lang_definitions": {
                        "en": "The name given to an object, place, or creative work.",
                        "zh": "指代物体、地理位置、作品或现象的名称。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "name",
                                "target_lang_sense_clarification": "general designation (places, objects)"
                            },
                            {
                                "target_lang_word": "title",
                                "target_lang_sense_clarification": "of a book, movie, or work of art"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "名字",
                                "target_lang_sense_clarification": "通用的名称，用于人、物或地点"
                            },
                            {
                                "target_lang_word": "名称",
                                "target_lang_sense_clarification": "正式的称呼，常用于机构、地点或抽象事物"
                            },
                            {
                                "target_lang_word": "标题",
                                "target_lang_sense_clarification": "书籍、文章或艺术作品的名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3747334-3097-341b-8910-e3466ff0dc15",
                    "sense_definition": "Печатное произведение (книга, брошюра) как единица учёта в издательском или библиотечном деле.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "publishing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этом году издательство выпустило более ста новых <w>названий</w>.",
                            "target_lang_translations": {
                                "en": "This year the publishing house released over a hundred new <w>titles</w>.",
                                "zh": "今年出版社发行了一百多<w>种</w>新书。"
                            }
                        },
                        {
                            "text": "Библиотечный каталог содержит тысячи <w>названий</w> научной литературы.",
                            "target_lang_translations": {
                                "en": "The library catalog contains thousands of <w>titles</w> of scientific literature.",
                                "zh": "图书馆目录包含数千<w>种</w>科学文献。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "количество названий",
                        "список названий"
                    ],
                    "target_lang_definitions": {
                        "en": "A specific book or publication counted as a unit in publishing or libraries.",
                        "zh": "在出版或图书馆领域中，作为统计单位的出版物或书籍。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "title",
                                "target_lang_sense_clarification": "publishing unit"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "种",
                                "target_lang_sense_clarification": "用于统计出版物数量的量词"
                            },
                            {
                                "target_lang_word": "书目",
                                "target_lang_sense_clarification": "指代出版物条目或清单"
                            }
                        ]
                    }
                }
            ]
        }
    ]
