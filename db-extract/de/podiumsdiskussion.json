                "senses": [
                    {
                        "sense_id": "6de4986b-3e41-3d89-b99d-c76d672e0532",
                        "entry_id": "a9e00bde-0398-3186-b751-ba44f9e7c4a4",
                        "glosses": [
                            "Diskussion, bei der die Diskutanten getrennt vom Publikum erhöht auf einem Podium platziert sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98ae80ec-1a69-42da-a5ef-cddbea654bb7",
                                "sense_id": "6de4986b-3e41-3d89-b99d-c76d672e0532",
                                "text": "„Das Programm umfasste neben zwei Vorträgen über aktuelle Projekte zur sprachlichen Integration von Flüchtlingen eine anschließende Podiumsdiskussion.“"
                            },
                            {
                                "example_id": "415503a7-1929-4e85-a349-e415efd65f8a",
                                "sense_id": "6de4986b-3e41-3d89-b99d-c76d672e0532",
                                "text": "„Am 18. Juni 2000 fand in Montreal eine Lesung und Podiumsdiskussion statt, mit der das Klonen von Menschen beworben werden sollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
