                "senses": [
                    {
                        "sense_id": "2b013f7c-0af1-3c2b-a435-8ba32d097af5",
                        "entry_id": "c629c08c-0510-3e3f-9f30-4921c64b6c64",
                        "glosses": [
                            "Kragen, hergestellt aus Pelz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dba0239e-3133-489f-9b48-f9cec5c548ef",
                                "sense_id": "2b013f7c-0af1-3c2b-a435-8ba32d097af5",
                                "text": "„Außerdem gab es eine feine Dame mit Muff, riesigem Pelzkragen und langer Zigarettenspitze.“"
                            },
                            {
                                "example_id": "c03648a5-1bc6-45b1-bbb4-1bec458d76d6",
                                "sense_id": "2b013f7c-0af1-3c2b-a435-8ba32d097af5",
                                "text": "„Eine Frau in einer weißen Robe mit weißem Pelzkragen hatte die Bildfläche betreten.“"
                            },
                            {
                                "example_id": "2ba68c25-973d-456e-bfc9-26ce495238db",
                                "sense_id": "2b013f7c-0af1-3c2b-a435-8ba32d097af5",
                                "text": "„Nun schlug er den Pelzkragen hoch, schloss ihn und liess nur eine kleine Partie ihres Gesichts unbedeckt.“"
                            },
                            {
                                "example_id": "6e69de55-be6c-41f7-b19b-bd5af3b81439",
                                "sense_id": "2b013f7c-0af1-3c2b-a435-8ba32d097af5",
                                "text": "„Sie hatte einen kleinen Rucksack auf dem Rücken, einen hübschen dunkelblauen Hut auf und den dicken blauen Wintermantel mit dem Pelzkragen an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
