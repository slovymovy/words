                        "examples": [
                            {
                                "example_id": "fab34d2c-d669-4e0a-94ff-d3c991b2b68f",
                                "sense_id": "557c2b77-3201-371d-9fa5-dcfcca6cb392",
                                "text": "Dwarslaesiepatiënt Ruben de Sain (32) is de eerste in Nederland die thuis oefent met een zogenoemd exoskelet. ,,Dat ik met mijn looppak aan weer kan lopen, is verslavend."
                            },
                            {
                                "example_id": "ebad06fd-093d-4c2f-aeec-748c9f7a4db8",
                                "sense_id": "557c2b77-3201-371d-9fa5-dcfcca6cb392",
                                "text": "Een protestactie in de kantlijn die overigens geheel aan mijn gesprekspartner voorbijging, want inmiddels was hij aanbeland bij de belangwekkende stelling dat ongeveer elke menselijke handicap aan de hand van games kon worden opgeheven dan wel gecorrigeerd. Kortom: ik had te maken met een pathologische optimist annex wereldverbeteraar, die zelfs voor dwarslaesiepatiënten in games de wonderbaarlijke genezing zocht."
                            }
                        ]
                    }
