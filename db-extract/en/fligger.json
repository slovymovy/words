                    {
                        "sense_id": "0b16eb79-8da0-3ca0-b248-66de3f4294cd",
                        "entry_id": "b706a334-94c0-3342-a7b8-f45cb9292a91",
                        "glosses": [
                            "To sneer."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "42b7e38b-af9d-4439-a3e1-77633b6f99f8",
                                "sense_id": "0b16eb79-8da0-3ca0-b248-66de3f4294cd",
                                "text": "Then Nature has with beauty, more with scorne,\nThat they must fligger, scoffe, deride, and jeere,\nAppoynt their servants certaine houres t' appeare."
                            }
                        ]
                    },
                    {
                        "sense_id": "836f63f0-1de2-3f89-afd2-f621ec12c73b",
                        "entry_id": "b706a334-94c0-3342-a7b8-f45cb9292a91",
                        "glosses": [
                            "To grin."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "9307c88d-b36b-41c2-8115-bd43d6b340a1",
                                "sense_id": "836f63f0-1de2-3f89-afd2-f621ec12c73b",
                                "text": "I met with a Barber with Razor and Balls,\nHe fligger'd and told me for all my brave alls;\nHe would have a stroke, and his words they were blunt,\nI could not deny him the use of my—"
                            }
                        ]
                    }
