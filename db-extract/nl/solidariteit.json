        "nl-extract.jsonl": [
            {
                "entry_id": "c26682c5-5f4b-38a9-9eb7-bdb45aa08e88",
                "word": "solidariteit",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "7a3b0cdd-9f23-4fbf-b757-c12c29efd0ff",
                        "entry_id": "c26682c5-5f4b-38a9-9eb7-bdb45aa08e88",
                        "tags": [
                            "plural"
                        ],
                        "form": "solidariteiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "722e2193-2735-3d56-915a-222df9191c60",
                        "entry_id": "c26682c5-5f4b-38a9-9eb7-bdb45aa08e88",
                        "glosses": [
                            "bewustzijn van groepsbelang en de wil om dat te tonen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "610598ef-e0ef-45ce-b763-7b5351920730",
                                "sense_id": "722e2193-2735-3d56-915a-222df9191c60",
                                "text": "Die analyse had tot de praktische conclusie geleid dat echte solidariteit bestond uit bankovervallen en wapendiefstallen om de PFLP behulpzaam te zijn."
                            },
                            {
                                "example_id": "002034b2-2d7d-4132-beb6-6cf9e195ff4a",
                                "sense_id": "722e2193-2735-3d56-915a-222df9191c60",
                                "text": "“Dat komt in de Verenigde Staten door het geloof in meritocratie: dat je je plek in de samenleving hebt verdiend op basis van wat je hebt gedaan. 95 procent van de Amerikaanse samenleving gelooft daarin. Daarmee erodeert de solidariteit en zegeviert het individualisme. Maar meritocratie veronderstelt dat iedereen een gelijke startpositie heeft. Dat is allesbehalve zo.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "67dfd16f-6514-3fd5-a3e3-46d3ce56fbed",
                        "entry_id": "c26682c5-5f4b-38a9-9eb7-bdb45aa08e88",
                        "glosses": [
                            "hoofdelijkheid, zowel ten aanzien van schuldeisers als van schuldenaren"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e45b3b56-ff45-42d0-89b6-d4d5eb957ec1",
                        "source_entry_id": "c26682c5-5f4b-38a9-9eb7-bdb45aa08e88",
                        "target_lang_word": "Solidarität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Solidarität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6193088e-a92a-326d-9e6c-21dae0df0347",
                                        "entry_id": "fd237cc5-b190-3eb8-84a8-cb96d2f3d135",
                                        "glosses": [
                                            "Bewusstsein der Zusammengehörigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff1758a6-aca1-4125-a426-a221432f4c33",
                                                "sense_id": "6193088e-a92a-326d-9e6c-21dae0df0347",
                                                "text": "Solidarität ist ein Schlüsselbegriff der Gewerkschaften."
                                            },
                                            {
                                                "example_id": "9c4feaf4-23e9-4e9b-a6e0-ab1cc42ef295",
                                                "sense_id": "6193088e-a92a-326d-9e6c-21dae0df0347",
                                                "text": "„Sie fordert allerdings zu der gewaltigen Mühe auf, die alten, im Sozialstaat organisierten Solidaritäten aufzulösen und auf neue Grundlagen zu stellen.“"
                                            },
                                            {
                                                "example_id": "565f1a0c-5153-4ff3-a6b8-a857d2f86996",
                                                "sense_id": "6193088e-a92a-326d-9e6c-21dae0df0347",
                                                "text": "„Eine globale Solidarität unter der Weltbevölkerung schien sich schleichend zu etablieren.“"
                                            },
                                            {
                                                "example_id": "083b7011-1791-4484-9356-1123f1653598",
                                                "sense_id": "6193088e-a92a-326d-9e6c-21dae0df0347",
                                                "text": "„Witze erzeugen Solidarität unter Gleichgesinnten, ein Augenzwinkern, ein Einverständnis zwischen Unterdrückten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "484800b5-bed4-3e01-aa98-a0b555fcf209",
                                        "entry_id": "fd237cc5-b190-3eb8-84a8-cb96d2f3d135",
                                        "glosses": [
                                            "gegenseitige Hilfsbereitschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a72cfa38-29b3-4fd0-af78-0e4653a7f8a8",
                                                "sense_id": "484800b5-bed4-3e01-aa98-a0b555fcf209",
                                                "text": "Sie hatten es der Solidarität ihrer Nachbarn zu verdanken, dass sie die Schäden so schnell beheben konnten."
                                            },
                                            {
                                                "example_id": "0916d5ce-f2b1-48d4-b2dc-e9560c1d14aa",
                                                "sense_id": "484800b5-bed4-3e01-aa98-a0b555fcf209",
                                                "text": "„Entgegen vielen öffentlichen Beschwörungen hatte die gemeinsame Herausforderung eines unabsehbar langen Krieges kaum für Solidarität in der deutschen Bevölkerung gesorgt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ebe3ecd1-a6e1-4d8c-bc7a-add5376b218f",
                        "source_entry_id": "c26682c5-5f4b-38a9-9eb7-bdb45aa08e88",
                        "target_lang_word": "solidarity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "solidarity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5dce214-a44c-31a8-84a8-4d5de148f671",
                                        "entry_id": "82abda23-02fd-32f4-bccd-19792749efa2",
                                        "glosses": [
                                            "A bond of unity or agreement between individuals, united around a common goal or against a common enemy, such as the unifying principle that defines the labor movement; mutual support within a group."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "352623e6-e4bf-497d-b6be-2229dd996889",
                                                "sense_id": "b5dce214-a44c-31a8-84a8-4d5de148f671",
                                                "text": "A long time union member himself, Phil showed solidarity with the picketing grocery store workers by shopping at a competing, unionized store."
                                            },
                                            {
                                                "example_id": "4ad5645b-a111-40e6-bad7-e3226ee29979",
                                                "sense_id": "b5dce214-a44c-31a8-84a8-4d5de148f671",
                                                "text": "As a matter of fact the Enlightment culture was based on a philosophy inspired to an ethical laicism whose aim was to create a better society based on principles such as solidarity, equality of rights and duties, and full freedom."
                                            },
                                            {
                                                "example_id": "91e693f9-def0-44f5-bed9-e8c04fa73c4f",
                                                "sense_id": "b5dce214-a44c-31a8-84a8-4d5de148f671",
                                                "text": "And this year, some of the granite facades have a new addition - the blue and yellow of the flag of Ukraine. It's hardly surprising to see the Scots, a nation more attuned to independence than some, showing solidarity with a country brutally invaded by Russia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea3610a1-ad4f-3c90-82b5-c2912872511c",
                                        "entry_id": "82abda23-02fd-32f4-bccd-19792749efa2",
                                        "glosses": [
                                            "Willingness to support another person in a difficult position or needs affection."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f74d469-7cea-41b6-ab8e-e04a260269d7",
                                                "sense_id": "ea3610a1-ad4f-3c90-82b5-c2912872511c",
                                                "text": "Only the solidarity provided by her siblings allowed Margaret to cope with her mother's harrowing death."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "efc6b21b-3ad0-44f4-a17b-f42111653900",
                        "source_entry_id": "c26682c5-5f4b-38a9-9eb7-bdb45aa08e88",
                        "target_lang_word": "solidarité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "solidarité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c9e24b14-7bf9-3a26-9dbd-a587c0371ae1",
                                        "entry_id": "93ac5bd0-7644-3b5f-921f-5c5e180bec41",
                                        "glosses": [
                                            "Sentiment qui pousse des personnes à s’accorder une aide mutuelle, soit par devoir moral, soit parce qu’une communauté d’intérêts existe entre elles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f74cf34d-d26b-4f1c-a9fc-3408213f9e6d",
                                                "sense_id": "c9e24b14-7bf9-3a26-9dbd-a587c0371ae1",
                                                "text": "La solidarité se définit comme un devoir social, une obligation d'aide, d'assistance ou de collaboration gracieuse entre les individus d'un groupe ou d'une communauté. On la distingue de l'altruisme du fait que la personne dite altruiste peut souhaiter aider autrui, mais sans se sentir concernée par ce qui lui arrive. Dans la notion de solidarité, on trouve toujours la réciprocité ou une forme d'échange mutuel qui crée un lien entre les individus en les obligeant réciproquement à donner, recevoir et rendre."
                                            },
                                            {
                                                "example_id": "48494ada-2749-4df6-b78b-191f7209fdde",
                                                "sense_id": "c9e24b14-7bf9-3a26-9dbd-a587c0371ae1",
                                                "text": "s’il a l’âme haute, il s’éprendra en toute ferveur d’une passion de solidarité pour ceux dont il connaît intimement les besoins"
                                            },
                                            {
                                                "example_id": "4e68a3da-cc50-47e9-bdc9-9c0d4d02659d",
                                                "sense_id": "c9e24b14-7bf9-3a26-9dbd-a587c0371ae1",
                                                "text": "La solidarité entre collègues et la loi du silence font qu'il est difficile de révéler les déviances lorsqu'on fait partie du système : les policiers honnêtes apprennent à se taire et à ne pas intervenir lorsqu'ils observent des pratiques qu’ils désapprouvent."
                                            },
                                            {
                                                "example_id": "388be36e-fbc8-4961-a8ca-f4a5f49c2793",
                                                "sense_id": "c9e24b14-7bf9-3a26-9dbd-a587c0371ae1",
                                                "text": "Si dans le passé l’idéologie soviétique opposait l’U.R.S.S. aux nations capitalistes, Staline substitue désormais les solidarités anti-hitlériennes aux solidarités de classe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6fee0cd-6b28-3ca4-a267-46dd3ac73b9a",
                                        "entry_id": "93ac5bd0-7644-3b5f-921f-5c5e180bec41",
                                        "glosses": [
                                            "Système de redistribution de ressources nationales vers une partie de la population."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d299f7a-fe7e-400d-8979-16cba961bfaa",
                                                "sense_id": "f6fee0cd-6b28-3ca4-a267-46dd3ac73b9a",
                                                "text": "Toute personne handicapée a droit à la solidarité de l’ensemble de la collectivité nationale, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2722f6b-a131-3bd3-8259-5198feda036a",
                                        "entry_id": "93ac5bd0-7644-3b5f-921f-5c5e180bec41",
                                        "glosses": [
                                            "Engagement par lequel deux ou plusieurs personnes s’obligent les unes pour les autres, et chacune pour toutes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e8da20d-df27-43f4-95fe-2cd4dc21f06a",
                                                "sense_id": "d2722f6b-a131-3bd3-8259-5198feda036a",
                                                "text": "Dans le cas d’une solidarité entre plusieurs créanciers, le débiteur peut libérer la totalité de sa créance entre les mains d’un seul créancier."
                                            },
                                            {
                                                "example_id": "1cdc90fb-822e-4a69-943c-8c17a5980920",
                                                "sense_id": "d2722f6b-a131-3bd3-8259-5198feda036a",
                                                "text": "Dans le cas d’une solidarité entre plusieurs débiteurs, le créancier peut réclamer la totalité de la créance a un seul débiteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70510020-4f72-306a-a329-95b160688268",
                                        "entry_id": "93ac5bd0-7644-3b5f-921f-5c5e180bec41",
                                        "glosses": [
                                            "Dépendance réciproque des idées, des sciences, des choses ou des êtres tellement liés les uns aux autres que ce qui arrive à l’un a des répercussions sur les autres."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9bf7df9-1f6c-48ca-be67-c0a290d02714",
                                                "sense_id": "70510020-4f72-306a-a329-95b160688268",
                                                "text": "Il y a entre tous les arts une sorte de solidarité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb9fed3a-a962-42ad-bcc3-ce72f9971faf",
