    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "cf711bac-1d8b-3f64-bedf-08811ba47fad",
                "word": "brushed",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "95f2c0d7-4408-4eb9-b4b6-c4a8ec053eb2",
                        "entry_id": "cf711bac-1d8b-3f64-bedf-08811ba47fad",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more brushed"
                    },
                    {
                        "form_id": "3a344b4b-6162-4afa-ab6c-90c04740d220",
                        "entry_id": "cf711bac-1d8b-3f64-bedf-08811ba47fad",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most brushed"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b0fb4143-74eb-3c1f-abb6-8ec23a7694e8",
                        "entry_id": "cf711bac-1d8b-3f64-bedf-08811ba47fad",
                        "glosses": [
                            "Roughened by rubbing with an abrasive brushes, especially as a finish."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27f37fc0-2f87-447a-9b81-b1d182361bfa",
                                "sense_id": "b0fb4143-74eb-3c1f-abb6-8ec23a7694e8",
                                "text": "The brushed aluminum vase had a soft appearance."
                            },
                            {
                                "example_id": "2c9d0d67-d7b3-417a-a51f-250a42c27065",
                                "sense_id": "b0fb4143-74eb-3c1f-abb6-8ec23a7694e8",
                                "text": "One of the most pleasing finishes which is put upon art metal lamps, gas and electric portable reading lamps is the clouded finish of either brushed copper or brushed brass."
                            },
                            {
                                "example_id": "20f3dac1-8e81-4ed3-b024-5fc60b453384",
                                "sense_id": "b0fb4143-74eb-3c1f-abb6-8ec23a7694e8",
                                "text": "It was at this famous course that a well-known woman appeared not many seasons ago in one of the first very brushed wool golfing suits with a specially abbreviated skirt, and was instantly christened \"Man Friday\" by a distinguished golfer who was old enough to have known better."
                            },
                            {
                                "example_id": "45a525ef-4900-4f3a-abeb-cdc815acb192",
                                "sense_id": "b0fb4143-74eb-3c1f-abb6-8ec23a7694e8",
                                "text": "The outer back was also covered in a new layer of brushed cotton."
                            },
                            {
                                "example_id": "6af1f979-ccbc-41d6-bb2c-d097dd12f41c",
                                "sense_id": "b0fb4143-74eb-3c1f-abb6-8ec23a7694e8",
                                "text": "The brushed finish offers a more natural look and increases slip resistance."
                            }
                        ]
                    },
                    {
                        "sense_id": "16d6a369-2608-398e-9c60-1501565be668",
                        "entry_id": "cf711bac-1d8b-3f64-bedf-08811ba47fad",
                        "glosses": [
                            "Having been cleaned, tidied, or straightened with a brush."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c59bc3e-6593-4a5c-98bd-779d4cd5910d",
                                "sense_id": "16d6a369-2608-398e-9c60-1501565be668",
                                "text": "This boy is standing there with very brushed hair ."
                            },
                            {
                                "example_id": "7c2a89ea-5967-40ff-8cae-eee58afe061f",
                                "sense_id": "16d6a369-2608-398e-9c60-1501565be668",
                                "text": "His posture balletic, his white whiskers mad as a cat's, his formal coat very brushed and very blue , muttering infamies at me all the while ."
                            },
                            {
                                "example_id": "38976e6d-14e9-426f-8ca8-19ce1d838915",
                                "sense_id": "16d6a369-2608-398e-9c60-1501565be668",
                                "text": "They all looked very brushed and washed, and most of them wore evening dress."
                            },
                            {
                                "example_id": "2e25c5fe-b0fc-4aca-80b9-03dfdaa7c109",
                                "sense_id": "16d6a369-2608-398e-9c60-1501565be668",
                                "text": "Thus was born Osmany Gonzalez Rivero, alias \"Brush,\" he was nicknamed that way because of his love of toothbrushes and hairbrushes because his teeth are always very white and his hair very brushed."
                            }
                        ]
                    },
                    {
                        "sense_id": "6ae4165e-b251-3f76-8b43-daa1fd7813b9",
                        "entry_id": "cf711bac-1d8b-3f64-bedf-08811ba47fad",
                        "glosses": [
                            "Having been cleaned, tidied, or straightened with a brush.",
                            "Having been processed by rotating brushes that loosen and remove dirt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81e4461e-1a1d-40dc-a0b4-46a7fa89b9af",
                                "sense_id": "6ae4165e-b251-3f76-8b43-daa1fd7813b9",
                                "text": "The decay in sound unbrushed, brushed, and washed fruit, and in fruit all of which has been injured by the clippers in picking, by stems puncturing other oranges or by abrasions of other kinds."
                            },
                            {
                                "example_id": "27998965-0c87-4b14-be80-95a7a8449e01",
                                "sense_id": "6ae4165e-b251-3f76-8b43-daa1fd7813b9",
                                "text": "Most of the shipments have included duplicate lots of apparently sound brushed or unbrushed fruit, sound washed; the regular commercially packed fruit and oranges showing visible mechanical injury."
                            },
                            {
                                "example_id": "dda4679c-f6da-4e11-9fba-02b0b28104cb",
                                "sense_id": "6ae4165e-b251-3f76-8b43-daa1fd7813b9",
                                "text": "Of course, washed potatoes are more expensive than brushed potatoes."
                            }
                        ]
                    },
                    {
                        "sense_id": "c9c14691-09b4-3a56-91dc-197c37fc7739",
                        "entry_id": "cf711bac-1d8b-3f64-bedf-08811ba47fad",
                        "glosses": [
                            "Having been artificially formed into a swarm by being brushed off a honeycomb."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "930ea1c9-e182-479c-a2d5-ed12934f27d0",
                                "sense_id": "c9c14691-09b4-3a56-91dc-197c37fc7739",
                                "text": "I recommended the forming of brushed swarms about 15 years ago, in the American Apiculturist, and made them on the old stand as well as on a new stand in uncounted numbers, with the result that these swarms always worked with the same vigor as natural swarms, so I know what I say."
                            },
                            {
                                "example_id": "6c753d13-05b5-4676-ad39-beaf4989aa47",
                                "sense_id": "c9c14691-09b4-3a56-91dc-197c37fc7739",
                                "text": "When I make shaken or brushed swarms I usually wait till queen cells are found with eggs or larvae in them, although I do not think this is essential."
                            },
                            {
                                "example_id": "6f9f437c-6561-4eb3-900f-d30ad71c3fe3",
                                "sense_id": "c9c14691-09b4-3a56-91dc-197c37fc7739",
                                "text": "But when one practices this method of making artificial, shaken, or brushed swarms, he should remember that probably nothing will be accomplished in swarm prevention by shaking unless the bees are actually preparing to swarm."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e0ad472-aead-364a-93ff-fb4308640c97",
                        "entry_id": "cf711bac-1d8b-3f64-bedf-08811ba47fad",
                        "glosses": [
                            "Having been written or painted using a brush."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4eda81f8-ae40-45aa-8e9e-b38ebe7e80a2",
                                "sense_id": "9e0ad472-aead-364a-93ff-fb4308640c97",
                                "text": "The sparse drip patterns of his \"preliminary\" drip paintings were deposited over a foundation of brushed paint (see, for example, Water Birds, shown in color plate 13)."
                            },
                            {
                                "example_id": "7375053a-de13-466a-b1bc-31a90b325044",
                                "sense_id": "9e0ad472-aead-364a-93ff-fb4308640c97",
                                "text": "The fact that Blakeney's \"boy\" had been murdered as well as his master, that he was most likely a member of the Win Hu Tong, that Ligan—if it were really he—had been guildty of the double murder and caught by Win Hu men, the terrible torutre that could only have been inflicted by Chines pointed strongly enough to the affair being one of Chinese tong vengeance; and the \"brushed\" characters on the rice paper seemed to give additional weight to the evidence."
                            },
                            {
                                "example_id": "70828914-d1d1-45ae-b8ba-1794717d8204",
                                "sense_id": "9e0ad472-aead-364a-93ff-fb4308640c97",
                                "text": "This is natural, considering the place of the brushed word in both public and private space."
                            },
                            {
                                "example_id": "55b32546-0d58-4df7-9c5a-067e9f831611",
                                "sense_id": "9e0ad472-aead-364a-93ff-fb4308640c97",
                                "text": "The only worded text on the memorial is to be found on its rear surface, which features an inscription carved after the brushed calligraphy original of its author, Miyakawa Masa'omi, who was principal in 1948 of the coed high school Ichijo became after the postwar national education reforms."
                            }
                        ]
                    },
                    {
                        "sense_id": "f60db48a-3bd0-3c92-be23-7de508cac601",
                        "entry_id": "cf711bac-1d8b-3f64-bedf-08811ba47fad",
                        "glosses": [
                            "Covered in brush or scrub."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b22f7823-7f73-42a0-8de4-9787af552857",
                                "sense_id": "f60db48a-3bd0-3c92-be23-7de508cac601",
                                "text": "Other data obtained indicate that an average holding having 20 to 25 acres cleared and also 6 or 8 acres of brushed pasture can support 4 milk cows and 3 head of young cattle."
                            },
                            {
                                "example_id": "c7b8b5c6-75f6-42cc-a522-8b1a35d54588",
                                "sense_id": "f60db48a-3bd0-3c92-be23-7de508cac601",
                                "text": "The mounted detachments at hand had found the heavily brushed country to be difficult for cavalry operations."
                            },
                            {
                                "example_id": "19161f3f-0a73-4308-b7bc-2705c08c63c2",
                                "sense_id": "f60db48a-3bd0-3c92-be23-7de508cac601",
                                "text": "The very air was still and subdued and he felt alerted to stay concealed back within the river's thickly brushed margins."
                            }
                        ]
                    },
                    {
                        "sense_id": "a468f340-146a-362c-8540-04402642a6f9",
                        "entry_id": "cf711bac-1d8b-3f64-bedf-08811ba47fad",
                        "glosses": [
                            "Having had brush or scrub removed."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9da377ce-7d24-4b81-bc32-5f54950fb21a",
                                "sense_id": "a468f340-146a-362c-8540-04402642a6f9",
                                "text": "The following year, some of last year's brushed land is stumped, the clover turned under, manure from the stock used on it, and roots for the following winter planted, any surplus land being used for the Upper Wis consin cash crop, potatoes ."
                            },
                            {
                                "example_id": "8aef0c84-8079-4b8a-b337-862c1ccfc7ac",
                                "sense_id": "a468f340-146a-362c-8540-04402642a6f9",
                                "text": "Unless the brushed areas are quickly seeded they grow up to weeds and are useless for forage."
                            },
                            {
                                "example_id": "a7b91e58-3007-4228-b6d9-5381f6977cce",
                                "sense_id": "a468f340-146a-362c-8540-04402642a6f9",
                                "text": "In the partial brushed plot, 5m-wide strips with no aspen removed were left adjacent to 7m-wide strips in which all the aspen had been removed mechanically."
                            }
                        ]
                    }
                ],
