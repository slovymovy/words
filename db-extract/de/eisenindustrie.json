                "senses": [
                    {
                        "sense_id": "5a624313-954e-3c38-b016-bd1847e1db84",
                        "entry_id": "eb483e2f-d089-3310-af92-3fced17e3f46",
                        "glosses": [
                            "Gesamtheit der Unternehmen, die Eisen herstellen oder vertreiben sowie Dienstleistungen zur Herstellung von Eisen anbieten"
                        ],
                        "tags": [
                            "meist Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "40013d6d-e88d-4a72-bc46-4bb626dfc247",
                                "sense_id": "5a624313-954e-3c38-b016-bd1847e1db84",
                                "text": "Die Eisenindustrie ist ein wichtiger Wirtschaftszweig des Landes."
                            },
                            {
                                "example_id": "bb9b6984-d635-492b-9806-72df01bea3e1",
                                "sense_id": "5a624313-954e-3c38-b016-bd1847e1db84",
                                "text": "„Die Eisen- und Stahlindustrie war demgegenüber eine alte Branche, deren Innovationspotential nicht mit dem Automobilbau, aber auch nicht mit dem der Chemie- oder der Elektroindustrie vergleichbar war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
