                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b2356fa-038b-456e-b74c-be7a7681589e",
                                "sense_id": "e1cffd7e-037c-39ef-af6f-31514897b122",
                                "text": "Najcenniejszymi znaleziskami, jakie odkryliśmy z Bohdanem Chmielewskim z Krakowa pod kierownictwem Dariusza Rozmusa, są: stalowe szydło, drewniana łyżka, monety, zdobiona sprzączka i stilus z brązu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
