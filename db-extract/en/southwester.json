                    {
                        "translation_id": "f17478e0-6fec-40ad-82cc-ac745f7eab95",
                        "source_entry_id": "ac4ca11b-5252-3152-9922-aed9fb4168b1",
                        "source_sense_description": "waterproof hat",
                        "target_lang_word": "Südwester",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Südwester",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e77c20b-b769-3554-9fed-ff4c13d82085",
                                        "entry_id": "af5e23af-5bed-3460-aaca-6d9b634a7e8e",
                                        "glosses": [
                                            "eine haubenartige Kopfbedeckung zum Wetterschutz (überwiegend auf See)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db9b60c2-6e7a-4d66-ad56-1b8289b7b31e",
                                                "sense_id": "5e77c20b-b769-3554-9fed-ff4c13d82085",
                                                "text": "Besser ist du setzt deinen Südwester auf."
                                            },
                                            {
                                                "example_id": "453d33fc-788b-4904-a88f-db5599294555",
                                                "sense_id": "5e77c20b-b769-3554-9fed-ff4c13d82085",
                                                "text": "„Es half nichts, daß mir Gummistiefel, ein Südwester für den Kopf und ein Regenmantel, der bis zum Boden reichte, gekauft wurden.“"
                                            },
                                            {
                                                "example_id": "e3da40da-e612-4db6-b0b6-1ac5c1fea225",
                                                "sense_id": "5e77c20b-b769-3554-9fed-ff4c13d82085",
                                                "text": "„Auf dem Kopf der Südwester verbarg sein Gesicht.“"
                                            },
                                            {
                                                "example_id": "9f6784d6-10cc-4067-93a3-11130ec789ea",
                                                "sense_id": "5e77c20b-b769-3554-9fed-ff4c13d82085",
                                                "text": "„Kleine Kinder in gelben Gummimänteln und Südwestern drängten sich an die Beine ihrer Eltern.“"
                                            },
                                            {
                                                "example_id": "426987c3-b967-46d0-b624-ab0eae003cf2",
                                                "sense_id": "5e77c20b-b769-3554-9fed-ff4c13d82085",
                                                "text": "„Bevor Thomas widersprechen konnte, hatte sie bereits einen Wettermantel angezogen und einen dunklen Südwester übergestülpt; ihren Hiddensee-Look.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "48109391-29fc-3d33-a1d7-f9e1a255cbba",
                                        "entry_id": "af5e23af-5bed-3460-aaca-6d9b634a7e8e",
                                        "glosses": [
                                            "Eigenbezeichnung der deutschsprachigen Einwohner Namibias"
                                        ],
