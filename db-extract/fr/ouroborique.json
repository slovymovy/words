                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46528e46-8551-4bad-85fa-a60bd8e6c994",
                                                "sense_id": "275d002d-a1e7-3378-9bcd-0fc38a832bb9",
                                                "text": "What could be more ouroboric than members of the media who specialize in blaming the media."
                                            },
                                            {
                                                "example_id": "efe2a6fc-f2f1-4f60-b192-830e231eee49",
                                                "sense_id": "275d002d-a1e7-3378-9bcd-0fc38a832bb9",
                                                "text": "Going back in time and becoming one's own grandfather is a rather ouroboric endeavour"
                                            },
                                            {
                                                "example_id": "1bf7a97b-0494-42a1-9304-4ee190a80e99",
                                                "sense_id": "275d002d-a1e7-3378-9bcd-0fc38a832bb9",
                                                "text": "Like the ouroboric serpent which bites its own tail, the spinal column brings the mysteries of language and sexuality, mouth and genitals together."
                                            }
