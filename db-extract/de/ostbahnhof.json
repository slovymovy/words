                "senses": [
                    {
                        "sense_id": "6b51b485-3a0c-305f-98b1-2a66393e80b8",
                        "entry_id": "792857eb-db05-3759-8c0b-5d0b6bcce671",
                        "glosses": [
                            "Bahnhof, der im Osten von etwas (einer Stadt, Land oder dergleichen) liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2090b39-0eb9-4807-b832-3cb30fad7f58",
                                "sense_id": "6b51b485-3a0c-305f-98b1-2a66393e80b8",
                                "text": "„In dem Brief schrieb sie: ‚Ich habe in einem Hotel am Ostbahnhof in Berlin für eine Woche ein Zimmer bestellt und würde dich sehr gern wiedersehen.‘“"
                            },
                            {
                                "example_id": "5a32b716-693c-4b42-a9dd-9e5171d34130",
                                "sense_id": "6b51b485-3a0c-305f-98b1-2a66393e80b8",
                                "text": "„Sie haben noch eine halbe Stunde bis zur Ankunft am Ostbahnhof.“"
                            },
                            {
                                "example_id": "0756018c-5754-4e06-a143-2f2d93173bbe",
                                "sense_id": "6b51b485-3a0c-305f-98b1-2a66393e80b8",
                                "text": "„Der Ostbahnhof in Oslo ist der Scheideweg des Landes.“"
                            },
                            {
                                "example_id": "acf6928e-5219-4981-84bf-9e03c4ba17c0",
                                "sense_id": "6b51b485-3a0c-305f-98b1-2a66393e80b8",
                                "text": "„Es wurde vereinbart, daß wie festgelegt der nächste Treff in der Post am Ostbahnhof in Berlin stattfindet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
