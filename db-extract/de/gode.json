                ],
                "senses": [
                    {
                        "sense_id": "ad649db3-4951-3276-a7af-b3192a082e86",
                        "entry_id": "33f9f366-1289-3fa3-b100-9e2f9f4f2df1",
                        "glosses": [
                            "im alten Island „(heidnischer) Priester und Häuptling“, Eigentümer der Tempel und Leiter der Gemeinden mit geistlichen und weltlichen Aufgaben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05e38761-85e5-4bea-8cd0-d5ecc174c92d",
                                "sense_id": "ad649db3-4951-3276-a7af-b3192a082e86",
                                "text": "„Die Reichsten und Vornehmsten nannten sich Goden, wobei gođi »Tempelbesitzer« bedeutet. Die Aufgabe der Goden war es, die religiösen Bräuche zu zelebrieren, Tempel für die Götter zu bauen und Opfer darzubringen.“"
                            },
                            {
                                "example_id": "8f49a1f4-c6a3-455e-b20d-bc8ec6f002e4",
                                "sense_id": "ad649db3-4951-3276-a7af-b3192a082e86",
                                "text": "„Dies waren die schon oft genannten Goden, die auch den Dienst des Priesters versahen.“"
                            },
                            {
                                "example_id": "1ca337d4-e38c-40e8-b9be-976c8723f02c",
                                "sense_id": "ad649db3-4951-3276-a7af-b3192a082e86",
                                "text": "„Ein ehrgeiziger, skrupelloser Mann Sámr tritt auf den Plan, und ihm gelingt es, den mächtigen Goden zu demütigen, indem er ihn an den Beinen aufhängt und von seinem Hofe vertreibt.“"
                            },
                            {
                                "example_id": "60f4ef27-8744-49a0-8cf1-10e562cc6efe",
                                "sense_id": "ad649db3-4951-3276-a7af-b3192a082e86",
                                "text": "„Oft können in einer Region einzig die Goden eine größere Gruppe an Gefolgsleuten hinter sich versammeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
