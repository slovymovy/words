                "senses": [
                    {
                        "sense_id": "8b175076-a0fd-357c-83e0-79422992a531",
                        "entry_id": "3c1057eb-9d1a-32ef-8a1e-4e104eeb9dc2",
                        "glosses": [
                            "Stelle im Sofa, wo Rücken- und Armlehne zusammenkommen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83b41636-c5a5-4fd8-97f9-7b5db1885e3a",
                                "sense_id": "8b175076-a0fd-357c-83e0-79422992a531",
                                "text": "„Er warf sich in die Sofaecke, legte die Hand über Aug und Stirn und zählte die Schläge.“"
                            },
                            {
                                "example_id": "7ff5ec61-047b-46fb-9318-c7cad650ef3d",
                                "sense_id": "8b175076-a0fd-357c-83e0-79422992a531",
                                "text": "„In der Sofaecke lag ein Kissen, und in dem Samt, mit dem dieses bezogen war, war ein Loch.“"
                            },
                            {
                                "example_id": "10eec5d7-22fc-4949-9a09-138205ec0b89",
                                "sense_id": "8b175076-a0fd-357c-83e0-79422992a531",
                                "text": "„Wir saßen in den entgegengesetzten Sofaecken.“"
                            }
                        ],
