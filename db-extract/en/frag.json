                ],
                "senses": [
                    {
                        "sense_id": "fc225220-c7f3-3954-aed8-5d2c6f153bff",
                        "entry_id": "9fa81c9a-ca06-36d0-99fd-fe54ccaf9a76",
                        "glosses": [
                            "To deliberately kill (one's superior officer) with a fragmentation grenade."
                        ],
                        "tags": [
                            "US",
                            "slang",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "987422ed-2af8-42de-9bca-efbc5440c8fd",
                                "sense_id": "fc225220-c7f3-3954-aed8-5d2c6f153bff",
                                "text": "One guy? I fragged a couple of hundred in 'Nam."
                            },
                            {
                                "example_id": "093479ef-cd1c-45ee-889e-fd27c7aefde4",
                                "sense_id": "fc225220-c7f3-3954-aed8-5d2c6f153bff",
                                "text": "Cowboy says in a low voice: “Never turn your back on Mother. Never cut him any slack. He fragged Mr. Shortround.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "f76a8d99-5215-3f48-953b-9579891205c8",
                        "entry_id": "9fa81c9a-ca06-36d0-99fd-fe54ccaf9a76",
                        "glosses": [
                            "To hit with the explosion of a fragmentation grenade."
                        ],
                        "tags": [
                            "slang",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "45acf14b-cec6-408b-a592-a8841128eea1",
                                "sense_id": "f76a8d99-5215-3f48-953b-9579891205c8",
                                "text": "I fragged him once and then meleed him for the kill."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff5e2fa2-24a9-37f6-9f77-63ab4db888a1",
                        "entry_id": "9fa81c9a-ca06-36d0-99fd-fe54ccaf9a76",
                        "glosses": [
                            "To kill."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dff59db-1281-4252-b21c-5b391ec3d096",
                                "sense_id": "ff5e2fa2-24a9-37f6-9f77-63ab4db888a1",
                                "text": "I fragged him but he fell off the ledge afterwards."
                            },
                            {
                                "example_id": "d8d5849b-f114-43c4-938f-37246304a16e",
                                "sense_id": "ff5e2fa2-24a9-37f6-9f77-63ab4db888a1",
                                "text": "I have pistol-fragged far superior players coming at me with a shotgun with 100% health."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61b8b1f8-6d8e-49eb-a145-b5e631db9716",
                        "source_entry_id": "9fa81c9a-ca06-36d0-99fd-fe54ccaf9a76",
                        "source_sense_description": "to kill (another player) in a deathmatch computer game",
                        "target_lang_word": "tuer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tuer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1818fc02-8e62-3157-9482-e729c0ca2001",
                                        "entry_id": "564dddcd-b338-34ec-996b-c58c81ef4719",
                                        "glosses": [
                                            "Ôter la vie d’une manière violente ; ne se dit pas quand il s’agit d'une euthanasie, ni à la forme pronominale dans le cas d’une mort accidentelle par noyade, étouffement ou empoisonnement : on emploie alors se noyer, s’étouffer, s’empoisonner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8470644c-8ffa-4eaa-ae6b-d32968c4631b",
                                                "sense_id": "1818fc02-8e62-3157-9482-e729c0ca2001",
                                                "text": "Si les trois villages se soulevaient et qu’on tuât deux ou trois gendarmes, guillotinerait-on tout le monde ?"
                                            },
                                            {
                                                "example_id": "6e79729d-c2a1-45e6-984b-991814921716",
                                                "sense_id": "1818fc02-8e62-3157-9482-e729c0ca2001",
                                                "text": "Une centaine d’hommes gisent sur le pavé ; les uns sont tués roides, d’autres atteints mortellement."
                                            },
                                            {
                                                "example_id": "da222add-35de-4e08-b5b8-a4e11c253530",
                                                "sense_id": "1818fc02-8e62-3157-9482-e729c0ca2001",
                                                "text": "Trois hommes tombèrent. Un avait été tué raide d'une balle dans la tête. Les deux autres n'étaient que blessés."
                                            },
                                            {
                                                "example_id": "934fc7b8-97d0-4823-8725-f91f7535c8a8",
                                                "sense_id": "1818fc02-8e62-3157-9482-e729c0ca2001",
                                                "text": "Sous la première République, au moment même où toute l’Europe nous tombait sur le dos, c’est les curés qui ont excités la guerre civile en Vendée, fanatisant les paysans, les menant au combat, et leur promettant le paradis s’ils étaient tués."
                                            },
                                            {
                                                "example_id": "daa279c1-c2a4-4ccc-8720-191d0da5dd82",
                                                "sense_id": "1818fc02-8e62-3157-9482-e729c0ca2001",
                                                "text": "« Mon cher associé — le mot associé était souligné — vous m'avez cru mort depuis dix ans, mais les morts ressuscitent quand on ne les a pas bien tués. […]. »"
                                            },
                                            {
                                                "example_id": "2d3bb3f5-8cc8-4271-a39f-3282689900d9",
                                                "sense_id": "1818fc02-8e62-3157-9482-e729c0ca2001",
                                                "text": "Un autre eût quitté une pareille femme, il l’eût tuée peut-être : moi, je me remis à l’aimer."
                                            },
                                            {
                                                "example_id": "f13977f5-6bae-42c4-b3dd-b2ef95ee36bb",
                                                "sense_id": "1818fc02-8e62-3157-9482-e729c0ca2001",
                                                "text": "Ne revenez plus, monsieur, autrement vous tueriez aussi la mère, car la puissance de Dieu est infinie, mais la nature humaine a ses limites."
                                            },
                                            {
                                                "example_id": "7ea338a5-ace9-4ad6-a60e-8074e8e4e64a",
                                                "sense_id": "1818fc02-8e62-3157-9482-e729c0ca2001",
                                                "text": "Il était question dans la complainte d’un assassin qui expose aux juges les raisons qui l’ont poussé à tuer sa maîtresse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80b8bda1-3e48-3895-8472-30c93a5dcbab",
                                        "entry_id": "564dddcd-b338-34ec-996b-c58c81ef4719",
                                        "glosses": [
                                            "Provoquer une mort violente par accident, provoquer une mort naturelle en parlant des maladies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fbd7411-1c5b-458e-84a9-f6e87dee41c9",
                                                "sense_id": "80b8bda1-3e48-3895-8472-30c93a5dcbab",
                                                "text": "Une tuile lui tomba sur la tête et le tua. — Il a été tué par la foudre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6286e41-0684-3c6d-84be-e85e84f6df75",
                                        "entry_id": "564dddcd-b338-34ec-996b-c58c81ef4719",
                                        "glosses": [
                                            "Causer la mort."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32362c1c-448c-4772-882f-f3a6c5cf6f46",
                                                "sense_id": "d6286e41-0684-3c6d-84be-e85e84f6df75",
                                                "text": "C’est vrai qu’aujourd’hui, les inégalités tuent en Seine-Saint-Denis. Ces profondes injustices, que plus personne ne peut choisir d’ignorer, il faudra s’y attaquer de front, avec des actes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c24c2042-bf15-3da7-aff3-94e864579e98",
                                        "entry_id": "564dddcd-b338-34ec-996b-c58c81ef4719",
                                        "glosses": [
                                            "Fatiguer excessivement le corps, altérer la santé."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0d75e3e-58df-4c2f-957f-f77e578151a6",
                                                "sense_id": "c24c2042-bf15-3da7-aff3-94e864579e98",
                                                "text": "Le chagrin le tue."
                                            },
                                            {
                                                "example_id": "b726e6a5-e53f-4acb-a3f7-b0d60e3db7e6",
                                                "sense_id": "c24c2042-bf15-3da7-aff3-94e864579e98",
                                                "text": "Vous ne vous tuez pas à la tâche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1c5601c-80e0-3fd1-bc2c-8792c87da62e",
                                        "entry_id": "564dddcd-b338-34ec-996b-c58c81ef4719",
                                        "glosses": [
                                            "Incommoder, provoquer une forte émotion le plus souvent négative, comme la colère, et parfois positive, comme le rire."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6af4642-0587-4fe3-afb5-697d416aca5c",
                                                "sense_id": "b1c5601c-80e0-3fd1-bc2c-8792c87da62e",
                                                "text": "Ce récit est d’une longueur, d’un ennui qui tue."
                                            },
                                            {
                                                "example_id": "c2b75448-95d2-4218-94e0-9feff436d5c3",
                                                "sense_id": "b1c5601c-80e0-3fd1-bc2c-8792c87da62e",
                                                "text": "Le grand bruit me tue."
                                            },
                                            {
                                                "example_id": "802d526d-ba90-4805-ba8b-e67268ecda80",
                                                "sense_id": "b1c5601c-80e0-3fd1-bc2c-8792c87da62e",
                                                "text": "Mettre en vente un produit qui ne marche pas, ça me tue !"
                                            },
                                            {
                                                "example_id": "87243895-dfc2-40a8-8c0b-b141188305c9",
                                                "sense_id": "b1c5601c-80e0-3fd1-bc2c-8792c87da62e",
                                                "text": "Elle m'a tué avec sa réplique au policier !"
                                            },
                                            {
                                                "example_id": "74424488-e4d2-426a-bf5f-bc078302925f",
                                                "sense_id": "b1c5601c-80e0-3fd1-bc2c-8792c87da62e",
                                                "text": "Duchotel. — Oh ! figure-toi, un chevreuil à gauche qui filait comme ça et qui, en passant, fait lever un coq de bruyère… pan, pan, v’lan !… Ah !… j’ai tué Cassagne !\nLéontine, appuyant. — Tu as tué Cassagne ?\nDuchotel. — Hein !… Oui… enfin, je l’ai stupéfié !\nLéontine. — Ah, bon !… Et le gibier ? est-ce que tu l’as tué aussi ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88dc01b3-133e-32cf-8e55-2ec6d296eb63",
                                        "entry_id": "564dddcd-b338-34ec-996b-c58c81ef4719",
                                        "glosses": [
                                            "Faire disparaitre ; anéantir."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be80356b-1f13-46fe-b8da-febcf7a23dab",
                                                "sense_id": "88dc01b3-133e-32cf-8e55-2ec6d296eb63",
                                                "text": "Des usines s'élevèrent sur tous les points du territoire, tuant lentement mais sûrement l'artisanat des campagnes. Le premier coup lui fut porté par la création des bateaux à vapeur, qui anéantit l'industrie, si florissante des toiles à voiles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b9dd299-6232-3484-bf46-70a8de736148",
                                        "entry_id": "564dddcd-b338-34ec-996b-c58c81ef4719",
                                        "glosses": [
                                            "Détruire l’effet d’une chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dadfbd0-71e5-4101-a816-0522eacde0f6",
                                                "sense_id": "9b9dd299-6232-3484-bf46-70a8de736148",
                                                "text": "Cela tue l’effet du spectacle."
                                            },
                                            {
                                                "example_id": "55782cba-5e2e-4a93-aa9f-a73543416b2b",
                                                "sense_id": "9b9dd299-6232-3484-bf46-70a8de736148",
                                                "text": "Le voisinage de ce tableau-là tue celui-ci."
                                            },
                                            {
                                                "example_id": "abc5bad4-41f6-4aa4-ac15-4d14998e95c1",
                                                "sense_id": "9b9dd299-6232-3484-bf46-70a8de736148",
                                                "text": "On peut tuer un poème, comme on peut lui donner des ailes, rien qu'en le lisant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21a0dbee-9286-3f2a-93ef-eed6a4aefbcc",
                                        "entry_id": "564dddcd-b338-34ec-996b-c58c81ef4719",
                                        "glosses": [
                                            "Dissiper, occuper, en parlant du temps, de la durée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c4e7b91-700c-4240-bf50-a070e5c6372d",
                                                "sense_id": "21a0dbee-9286-3f2a-93ef-eed6a4aefbcc",
                                                "text": "Jamais Pierre ne serait entré, si le général ne l’avait pris avec lui, en homme aimable, heureux aussi d’avoir un compagnon pour causer, car il expliquait qu’il venait passer simplement là son après-midi, comme il l’aurait tué à tout autre spectacle, au concert ou dans une vente de charité."
                                            },
                                            {
                                                "example_id": "f39831e8-5ea2-4ce6-8fa5-cb7633e7839c",
                                                "sense_id": "21a0dbee-9286-3f2a-93ef-eed6a4aefbcc",
                                                "text": "Les gens se donnent beaucoup de mal pour tuer leur vie heure à heure. Encore n'en sont-ils pas capables tout seuls, il faut qu'on les dirige. Une revue a été créée dans ce but : signaler aux Parisiens, de façon méthodique, les occasions qui leur sont offertes de perdre leur temps."
                                            },
                                            {
                                                "example_id": "017107a9-80d2-4327-be03-72bc41e8b816",
                                                "sense_id": "21a0dbee-9286-3f2a-93ef-eed6a4aefbcc",
                                                "text": "Nous tuons les longues heures comme nous le pouvons, chacun y mettant du sien — toujours pour les autres."
                                            },
                                            {
                                                "example_id": "0e256ec2-9614-4161-a158-09726620d70b",
                                                "sense_id": "21a0dbee-9286-3f2a-93ef-eed6a4aefbcc",
                                                "text": "Et il y avait près de deux heures à tuer. Il hésita entre rester assis sur son banc ou reprendre le métro, mais où aller ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f83ce99-d03a-385e-9dad-333cae2ce50f",
                                        "entry_id": "564dddcd-b338-34ec-996b-c58c81ef4719",
                                        "glosses": [
                                            "Se suicider."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "717f01ea-8903-4fe2-b8a5-a054e98e7141",
                                                "sense_id": "6f83ce99-d03a-385e-9dad-333cae2ce50f",
                                                "text": "— Soyez convaincu que mourir et se tuer sont deux verbes qu’on emploie surtout au futur ; au moins pour moi je ne les ai jamais vu conjuguer qu’à ce temps. « Si vous me trompiez, si vous m’oubliiez, je me tuerais. »"
                                            },
                                            {
                                                "example_id": "41182e41-88db-4b10-bb22-788d75c3b82c",
                                                "sense_id": "6f83ce99-d03a-385e-9dad-333cae2ce50f",
                                                "text": "Un jeune homme que je connaissais à Evian s’est tué sous la fenêtre d’une de mes amies qui avait été coquette avec lui."
                                            },
                                            {
                                                "example_id": "e2357f51-d9f9-4e7c-9741-f9a8cc03394f",
                                                "sense_id": "6f83ce99-d03a-385e-9dad-333cae2ce50f",
                                                "text": "La motivation qui pousse à se tuer et donc à tuer ses propres divinités est plus grave, karmiquement, que la motivation qui conduit à tuer une autre personne […]."
                                            },
                                            {
                                                "example_id": "36ae3e91-86a7-4a8c-af7a-c63cc253eaa5",
                                                "sense_id": "6f83ce99-d03a-385e-9dad-333cae2ce50f",
                                                "text": "Marat vint à la Convention, monta à la tribune, et pistolet sur la tempe menaça de se tuer si la calomnie l’accusant de la « septembrisade » ne cessait pas. Danton écourta la tragi-comédie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dce76b9-470e-3dc1-8cde-e9eb71138c27",
                                        "entry_id": "564dddcd-b338-34ec-996b-c58c81ef4719",
                                        "glosses": [
                                            "(Suivi de la préposition à et d'un infinitif) Se donner beaucoup de peine."
                                        ],
                                        "tags": [
                                            "hyperbole",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9efee322-a817-4c3d-a38c-577839ab6f51",
                                                "sense_id": "3dce76b9-470e-3dc1-8cde-e9eb71138c27",
                                                "text": "Je me tue à vous répéter toujours la même chose."
                                            },
                                            {
                                                "example_id": "e44089f4-e337-44be-a004-389c05594bc2",
                                                "sense_id": "3dce76b9-470e-3dc1-8cde-e9eb71138c27",
                                                "text": "Il y a depuis toujours des lions qui se tuent le dos et la santé à tenter de les secourir, et toi t'es là, comme une insulte, à sucer tranquillement ton petit buisson pouilleux, et encore assez gonflée pour te sentir toute fière dans ton rôle minable d'éboueuse de la jungle !"
                                            },
                                            {
                                                "example_id": "82c2c056-76a3-4774-bd80-d12dbbf07d5c",
                                                "sense_id": "3dce76b9-470e-3dc1-8cde-e9eb71138c27",
                                                "text": "Et enfin les autres se tuent à remarquer toutes ces choses, non pas pour en devenir plus sages, mais seulement pour montrer qu'ils en connaissent la vanité …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed9854e9-c988-3ee1-b5cc-0658b953d051",
                                        "entry_id": "564dddcd-b338-34ec-996b-c58c81ef4719",
                                        "glosses": [
                                            "Éteindre en parlant d'une bougie, d'une chandelle. Note : ne s'emploie plus guère que dans tue la chandelle, qui s'utilise encore à la campagne pour signifier éteins la lumière"
                                        ],
                                        "tags": [
                                            "Centre-Ouest"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8423141a-b12c-4866-a39b-a463e79d40c6",
                                                "sense_id": "ed9854e9-c988-3ee1-b5cc-0658b953d051",
                                                "text": "… il regarde ce ravage, il croit que c'est le chat; il tue la chandelle et se met dans son lit,…."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
