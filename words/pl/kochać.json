{
    "word_family": [
        "kochanie",
        "kochany",
        "ukochany",
        "kochanek",
        "kochanka"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "831080f4-0e53-340d-a10e-dd07185d6878",
                    "sense_definition": "odczuwać silne uczucie miłości do kogoś",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "miłość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bardzo <w>kocham</w> moją rodzinę.",
                            "target_lang_translations": {
                                "ru": "Я очень <w>люблю</w> свою семью."
                            }
                        },
                        {
                            "text": "Dzieci <w>kochają</w> swoich rodziców.",
                            "target_lang_translations": {
                                "ru": "Дети <w>любят</w> своих родителей."
                            }
                        }
                    ],
                    "synonyms": [
                        "miłować"
                    ],
                    "antonyms": [
                        "nienawidzić"
                    ],
                    "common_phrases": [
                        "kochać nad życie"
                    ],
                    "target_lang_definitions": {
                        "ru": "испытывать глубокое чувство привязанности и любви к кому-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "любить",
                                "target_lang_sense_clarification": "чувствовать глубокую привязанность к человеку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29f8a6cd-7d16-3241-a07e-52317f51b3ad",
                    "sense_definition": "bardzo coś lubić, być czymś zachwyconym",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "miłość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ona <w>kocha</w> czytać książki w wolnym czasie.",
                            "target_lang_translations": {
                                "ru": "Она <w>любит</w> читать книги в свободное время."
                            }
                        },
                        {
                            "text": "Mój brat <w>kocha</w> grać w piłkę nożną.",
                            "target_lang_translations": {
                                "ru": "Мой брат <w>любит</w> играть в футбол."
                            }
                        }
                    ],
                    "synonyms": [
                        "uwielbiać"
                    ],
                    "target_lang_definitions": {
                        "ru": "получать большое удовольствие от чего-либо, очень сильно что-то нравиться"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "любить",
                                "target_lang_sense_clarification": "испытывать удовольствие от занятия чем-либо"
                            },
                            {
                                "target_lang_word": "обожать",
                                "target_lang_sense_clarification": "сильно увлекаться чем-то"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61bbef7c-d4f4-3cf5-9806-22705c42e85d",
                    "sense_definition": "potrzebować określonych warunków do dobrego rozwoju",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "miłość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ta roślina <w>kocha</w> słońce i dużo wody.",
                            "target_lang_translations": {
                                "ru": "Это растение <w>любит</w> солнце и много воды."
                            }
                        },
                        {
                            "text": "Storczyki <w>kochają</w> wilgotne powietrze w domu.",
                            "target_lang_translations": {
                                "ru": "Орхидеи <w>любят</w> влажный воздух в доме."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "нуждаться в определенных условиях для нормального роста или существования"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "любить",
                                "target_lang_sense_clarification": "нуждаться в благоприятных условиях (о растениях)"
                            }
                        ]
                    },
                    "synonyms": [
                        "lubić"
                    ]
                },
                {
                    "sense_id": "a30a27d1-bd15-331b-bfd2-6325f722c888",
                    "sense_definition": "odbywać stosunek seksualny",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "seks",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Para postanowiła <w>kochać</w> się przy świecach.",
                            "target_lang_translations": {
                                "ru": "Пара решила <w>заняться любовью</w> при свечах."
                            }
                        },
                        {
                            "text": "Młodzi ludzie <w>kochali</w> się w swoim nowym mieszkaniu.",
                            "target_lang_translations": {
                                "ru": "Молодые люди <w>занимались любовью</w> в своей новой квартире."
                            }
                        }
                    ],
                    "synonyms": [
                        "współżyć"
                    ],
                    "target_lang_definitions": {
                        "ru": "вступать в половую близость"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заниматься любовью",
                                "target_lang_sense_clarification": "эвфемизм для полового акта"
                            }
                        ]
                    },
                    "common_phrases": [
                        "kochać się z kimś"
                    ]
                },
                {
                    "sense_id": "cb6a045c-284c-3030-b8d2-e81ae4446fa9",
                    "sense_definition": "być w kimś zakochanym",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "miłość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Marek <w>kochał</w> się w niej od czasów liceum.",
                            "target_lang_translations": {
                                "ru": "Марек <w>был влюблен</w> в неё со времен лицея."
                            }
                        },
                        {
                            "text": "Wszyscy <w>kochają</w> się w tym nowym aktorze.",
                            "target_lang_translations": {
                                "ru": "Все <w>влюблены</w> в этого нового актера."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "испытывать романтическое влечение к кому-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быть влюбленным",
                                "target_lang_sense_clarification": "испытывать чувство влюбленности"
                            },
                            {
                                "target_lang_word": "влюбляться",
                                "target_lang_sense_clarification": "процесс возникновения чувства"
                            }
                        ]
                    },
                    "common_phrases": [
                        "kochać się w kimś"
                    ]
                }
            ]
        }
    ]
}