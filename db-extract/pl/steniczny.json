                        "sense_id": "42ac7635-75b1-33d3-9e95-00a903e0dec9",
                        "entry_id": "50eca2b0-fab7-3e77-a781-2dab84ac184e",
                        "glosses": [
                            "silny, mocny, aktywny"
                        ],
                        "tags": [
                            "psychology"
                        ],
                        "examples": [
                            {
                                "example_id": "2315fa19-e95f-4d4b-b1e6-0562d37cb3f7",
                                "sense_id": "42ac7635-75b1-33d3-9e95-00a903e0dec9",
                                "text": "Afekt, do którego doprowadziła człowieka np. rozpacz czy strach, może być steniczny albo asteniczny w zależności od tego, czy pobudził aktywność ruchową człowieka, czy też podziałał na nią hamująco"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
