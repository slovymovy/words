                "senses": [
                    {
                        "sense_id": "04fad4a3-1c44-3e45-8353-3ef522b216fb",
                        "entry_id": "3f8f8d63-7e72-32f4-a4df-5f43c08f2c1c",
                        "glosses": [
                            "Ancien nom d’Ankara, capitale de l’Anatolie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a486367-0f93-47d2-8a21-f8a7f3044774",
                                "sense_id": "04fad4a3-1c44-3e45-8353-3ef522b216fb",
                                "text": "ANGORA, (Géog. anc. & mod.) ville d’Asie dans la Natolie, appellée autrefois Ancyre. Long. 50. 25. lat. 39. 30. Ses chevres donnent un poil très-fin, dont on fait de beaux camelots. Ce poil passe à Smyrne, où les Anglois, les Hollandois & les François s’en pourvoient.\nCes chevres sont peu différentes des chevres ordinaires : mais leur poil est blanc, roussâtre, fin, lustré, & long de plus de dix pouces : le commerce en est très-considérable."
                            }
                        ]
                    },
                    {
                        "sense_id": "dcbe8f1b-66fc-3b3a-92db-4252b3fcdacd",
                        "entry_id": "3f8f8d63-7e72-32f4-a4df-5f43c08f2c1c",
                        "glosses": [
                            "Vilayet de l’empire ottoman qui avait cette ville pour capitale."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "587ecef3-0676-498b-ac2a-9f76dd851a0e",
                                "sense_id": "dcbe8f1b-66fc-3b3a-92db-4252b3fcdacd",
                                "text": "La chèvre angora habite l’Angora, villayet d’Anatolie en Asie Mineure."
                            }
                        ]
                    }
                ],
