                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "84060348-3e45-3b6a-84b2-65fdeab2879f",
                                        "entry_id": "9d7c913a-c498-3840-8f6b-bd54e19b18b0",
                                        "glosses": [
                                            "Spécialiste de la langue allemande, ou des langues germaniques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29fbebd3-82bc-47b4-8c73-3b19aded45e8",
                                                "sense_id": "84060348-3e45-3b6a-84b2-65fdeab2879f",
                                                "text": "Les germanistes distinguent entre formes gothiques, allemandes, anglaises, etc., qui sont attestées, et formes protogermaniques, qui sont pourvues d’astérisques, mais jamais un germaniste ne s’est permis de qualifier des formes protogermaniques de « gothiques » par exemple."
                                            },
                                            {
                                                "example_id": "a34bcb06-dfdb-42dd-8484-beaa7427ed12",
                                                "sense_id": "84060348-3e45-3b6a-84b2-65fdeab2879f",
                                                "text": "C’est un germaniste spécialisé dans le Haut Allemand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c35711c7-f714-3e5c-8842-f9d3738a71bb",
                                        "entry_id": "9d7c913a-c498-3840-8f6b-bd54e19b18b0",
                                        "glosses": [
                                            "Érudit ou érudite, férue de littérature ou de civilisation germanique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c66f3fd6-e3fb-4c48-bf39-9237593a5359",
                                                "sense_id": "c35711c7-f714-3e5c-8842-f9d3738a71bb",
                                                "text": "Ses lectures avaient fait d’elle une véritable germaniste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ec370c6-5efe-4f07-84cb-bcfbe31bfe3b",
                        "source_entry_id": "1360752a-e593-36b2-aa65-62ac1dd9926c",
                        "source_sense_description": "person who studies Germanic languages and cultures",
                        "target_lang_word": "Germanist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Germanist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b761f581-5656-3c43-8aaa-dabd2c9116fc",
                                        "entry_id": "7c806743-8df3-3f02-bdb7-4f7c922cfe07",
                                        "glosses": [
                                            "Lehrer oder Wissenschaftler im Fach Germanistik (Sprach- und/oder Literaturwissenschaftler) (im engen Sinne im Bereich der deutschen Sprache, im weiten Sinne im Bereich der germanischen Sprachen einschließlich des Deutschen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b823efa4-54cc-4106-a45c-750a93424a2b",
                                                "sense_id": "b761f581-5656-3c43-8aaa-dabd2c9116fc",
                                                "text": "Germanisten erforschen die Sprache, Kultur und Literatur der germanischen Sprachgemeinschaften; im engeren Sinn wird als Germanist auch jemand bezeichnet, der sich speziell mit Deutsch befasst."
                                            },
                                            {
                                                "example_id": "9c2b8a8c-9ee7-43e0-8a3a-280b63055451",
                                                "sense_id": "b761f581-5656-3c43-8aaa-dabd2c9116fc",
                                                "text": "„Für Germanisten, gewappnet mit historischem Sprachlexikon und Freude am archaisch Fremdartigen, ist dies so wenig ein Problem wie der altfränkisch gewundene Satzbau.“"
                                            },
                                            {
                                                "example_id": "cff236a0-cb23-48f0-a67c-db17843c3323",
                                                "sense_id": "b761f581-5656-3c43-8aaa-dabd2c9116fc",
                                                "text": "„Man kann Sanders heute als aufgeklärten Germanisten bezeichnen, der die Sehnsucht nach dem Nationalstaat mit der ‚Bildungsreligion‘ des 19. Jahrhunderts verband und das darauf antwortende Wörterbuch schrieb.“"
                                            },
                                            {
                                                "example_id": "e31f3cf3-a4a0-4a4f-b274-4db0016af591",
                                                "sense_id": "b761f581-5656-3c43-8aaa-dabd2c9116fc",
                                                "text": "„Wieder andere, vorab Germanisten vom Fach aus dem Raum der Donaumonarchie, Christen und Juden, standen durchaus nicht auf dem Standpunkt irgendeines sprachlichen Purismus.“"
                                            },
                                            {
                                                "example_id": "2ecb63e6-ff96-4717-b67e-87f9be4a5e23",
                                                "sense_id": "b761f581-5656-3c43-8aaa-dabd2c9116fc",
                                                "text": "„Diese liebesliteraturbesoffenen Germanisten wissen nicht, wie es der Natur folgend in der Liebe zugeht, zugehen muss; sie sind unfähig, Liebe, Eros und Sex als Einheit zu genießen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3826b714-5729-4e31-be5e-e4dd61afeabe",
