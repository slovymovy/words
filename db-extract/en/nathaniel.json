                "forms": [],
                "senses": [
                    {
                        "sense_id": "f3f61c86-d1f7-36b9-93fa-17144960e757",
                        "entry_id": "9041e785-0c2f-39be-8238-1122ef49fce9",
                        "glosses": [
                            "A male given name from Hebrew."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2387d132-5e17-4788-a934-d134d8e21f26",
                                "sense_id": "f3f61c86-d1f7-36b9-93fa-17144960e757",
                                "text": "Nathaniel's coat, sir, was not fully made,\nAnd Gabriel's pumps were all unpink'd i' the heel."
                            },
                            {
                                "example_id": "876a36fd-4933-45d5-b9df-75d102ded288",
                                "sense_id": "f3f61c86-d1f7-36b9-93fa-17144960e757",
                                "text": "‘What’s your Christian name, Sir?’ angrily inquired the little judge. ‘Nathaniel, Sir.’ ‘Daniel—any other name?’ ‘Nathaniel, sir—my Lord, I mean.’ ‘Nathaniel Daniel, or Daniel Nathaniel?’ ‘No, my Lord, only Nathaniel —not Daniel at all.’ ‘What did you tell me it was Daniel for, then, sir?’ inquired the judge."
                            },
                            {
                                "example_id": "f70f5012-17dd-4161-8174-eed19631da87",
                                "sense_id": "f3f61c86-d1f7-36b9-93fa-17144960e757",
                                "text": "Marcella and Nathaniel. Now I know their names. I haven't thought much about having children, but if I did, I wouldn't give them names like that. They're the sort of names you choose if you think you're someone to be reckoned with."
                            },
                            {
                                "example_id": "4743d0ec-07ff-4f9e-8e8a-936d13608170",
                                "sense_id": "f3f61c86-d1f7-36b9-93fa-17144960e757",
                                "text": "“Doctors have always approached medications in pregnancy by using it only when indicated, lowest dose, for the shortest duration,” said Dr. Nathaniel DeNicola, an adviser to the American College of Obstetricians and Gynecologists on environmental issues."
                            }
                        ]
                    }
                ],
