                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "give",
                                "target_lang_sense_clarification": "imperative, as a gift or present"
                            },
                            {
                                "target_lang_word": "pour",
                                "target_lang_sense_clarification": "imperative, especially with 'einschenken'"
                            }
                        ]
                    }
                }
