                "senses": [
                    {
                        "sense_id": "71022c12-bcf3-35bb-9d8c-498db1361733",
                        "entry_id": "249a3414-3af5-37cc-93e6-ac64d5571d3c",
                        "glosses": [
                            "sehr kleines, für den öffentlichen Straßenverkehr nicht zugelassenes Motorrad"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4baa991c-9249-4649-b180-5426123e37aa",
                                "sense_id": "71022c12-bcf3-35bb-9d8c-498db1361733",
                                "text": "„Seit Monaten, schimpft der Groner, rasen Jugendliche mit sogenannten Pocketbikes über den Verbindungsweg zwischen dem Zollstock und dem Siekweg.“"
                            },
                            {
                                "example_id": "f6421528-0ecb-424b-9448-d11d560e4fda",
                                "sense_id": "71022c12-bcf3-35bb-9d8c-498db1361733",
                                "text": "„Unter einem Pocketbike versteht man ein motorisiertes Zweirad, welches die Maße 110cm x 50cm x 50 cm nicht überschreitet.“"
                            },
                            {
                                "example_id": "90cd59ce-612d-489f-bc9e-2d25a40eb171",
                                "sense_id": "71022c12-bcf3-35bb-9d8c-498db1361733",
                                "text": "„Versehen mit einer Motorleistung bis 16 PS, 35 - 49 ccm Hubraum und über 100 Stundenkilometer schnell und dabei nur 15 bis 25 kg schwer, sind diese Pocketbikes vor allem bei Jugendlichen und sogar Kindern derzeit sehr beliebt “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
