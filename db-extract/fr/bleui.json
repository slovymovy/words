                ],
                "senses": [
                    {
                        "sense_id": "2dffc9fd-ebd9-35b4-b127-28f77e43f558",
                        "entry_id": "44b576e4-043a-32ea-a848-e9c6590eb124",
                        "glosses": [
                            "Qui est devenu bleu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebe4ebf7-4689-46aa-827e-6c47154606bf",
                                "sense_id": "2dffc9fd-ebd9-35b4-b127-28f77e43f558",
                                "text": "Tout le long de la côte descendent et tournoient les rayures des chemins rougeâtres ; on se retourne et l’on voit l’escarpement abrupt de la montagne fauve et brûlée, puis, tout au loin, les chaînes des Pyrénées qui nagent bleuies, dorées, enveloppées de violet pâle dans le jeune et immuable azur."
                            },
                            {
                                "example_id": "7534a828-8849-4ce3-961e-8887f22dbb8f",
                                "sense_id": "2dffc9fd-ebd9-35b4-b127-28f77e43f558",
                                "text": "Serre plus fort mes doigts tremblants ; comme un sceau protecteur, laisse tes lèvres sur mes paupières bleuies, où elles font descendre la nuit durant le jour."
                            },
                            {
                                "example_id": "4cddc92a-73db-4cc5-8168-ef761c569741",
                                "sense_id": "2dffc9fd-ebd9-35b4-b127-28f77e43f558",
                                "text": "Ouroz se mit à grelotter si violemment que ses lèvres bleuies ne parvenaient plus à proférer un mot."
                            }
                        ]
                    },
                    {
                        "sense_id": "204d68ec-4376-3311-8f6e-3a255384358c",
                        "entry_id": "44b576e4-043a-32ea-a848-e9c6590eb124",
                        "glosses": [
                            "Se dit en particulier d'un acier qui à subit un traitement thermique nommé revenu qui lui a donné une couleur légèrement bleutée."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "2f558344-0fb2-3ba0-8670-8cbd7a511bd0",
                "word": "bleui",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "415d0d05-c960-3983-8b95-bf4c3e8cef35",
                        "entry_id": "2f558344-0fb2-3ba0-8670-8cbd7a511bd0",
                        "glosses": [
                            "Participe passé masculin singulier du verbe bleuir."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "93d365bc-f5d4-442e-900f-d0c6eff5a436",
                                "sense_id": "415d0d05-c960-3983-8b95-bf4c3e8cef35",
                                "text": "Le vent soufflait dur, et j’ai vu tout à coup son cher vieux visage bleui par le froid."
                            },
                            {
                                "example_id": "f22e7ccd-1125-47fe-b8d0-0c712d9e94e5",
                                "sense_id": "415d0d05-c960-3983-8b95-bf4c3e8cef35",
                                "text": "Leurs gloussements alternés et démultipliés d’expirations brisées, reprises et continuées, lui donnent l’impression que la nuit, tout entière enrouée et castrée, se livre déployée à un lent gargarisme bleui lancinamment au suc du méthylène."
                            }
                        ]
                    }
                ],
