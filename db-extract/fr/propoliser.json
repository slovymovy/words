                        "examples": [
                            {
                                "example_id": "78b0b58f-c492-4d1b-ba22-c2dab572b61e",
                                "sense_id": "751b073d-9871-381c-bda4-b6d6b17f3c39",
                                "text": "J'ai quelques ruches à proximité de pins et de sapins et il me paraît que mes abeilles leur prennent de la résine pour propoliser."
                            },
                            {
                                "example_id": "8720a680-5c4d-4959-90a8-ab75d531b485",
                                "sense_id": "751b073d-9871-381c-bda4-b6d6b17f3c39",
                                "text": "Elle a l'inconvénient de propoliser à l'excès, rendant par là même plus difficile la manœuvre des cadres."
                            }
                        ]
