{
    "word_family": [
        "humiliate",
        "humiliation",
        "humiliatingly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8f53210a-5f79-34eb-9070-e43936c102da",
                    "sense_definition": "Causing someone to feel very ashamed, degraded, or deeply embarrassed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shameful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Losing the championship game by ten goals was a <w>humiliating</w> defeat for the team.",
                            "target_lang_translations": {
                                "ru": "Поражение в финальном матче с разницей в десять мячей стало для команды <w>унизительным</w> разгромом."
                            }
                        },
                        {
                            "text": "She suffered a <w>humiliating</w> experience when she forgot her lines during the live performance.",
                            "target_lang_translations": {
                                "ru": "Она пережила <w>унизительный</w> опыт, когда забыла свои слова во время выступления в прямом эфире."
                            }
                        }
                    ],
                    "synonyms": [
                        "degrading",
                        "mortifying",
                        "demeaning",
                        "embarrassing",
                        "shameful"
                    ],
                    "antonyms": [
                        "honorable",
                        "glorious",
                        "dignified"
                    ],
                    "common_phrases": [
                        "humiliating defeat",
                        "humiliating experience"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставляющий чувствовать стыд, сильное смущение или задевающий чувство собственного достоинства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "унизительный",
                                "target_lang_sense_clarification": "оскорбляющий достоинство, постыдный"
                            },
                            {
                                "target_lang_word": "оскорбительный",
                                "target_lang_sense_clarification": "задевающий честь и достоинство"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7d137fe5-7e0a-30c7-8285-32773f089ab1",
                    "sense_definition": "Present participle and gerund of <w>humiliate</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "act_of_humiliating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was accused of publicly <w>humiliating</w> his employees in front of the entire office.",
                            "target_lang_translations": {
                                "ru": "Его обвинили в том, что он публично <w>унижал</w> своих сотрудников на глазах у всего офиса."
                            }
                        },
                        {
                            "text": "She hated the idea of <w>humiliating</w> anyone, even those who had wronged her.",
                            "target_lang_translations": {
                                "ru": "Ей претила мысль об <w>унижении</w> кого бы то ни было, даже тех, кто поступил с ней несправедливо."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени или герундий от глагола humiliate; унижающий или процесс унижения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "унижающий",
                                "target_lang_sense_clarification": "причастие, совершающий унижение"
                            },
                            {
                                "target_lang_word": "унижение",
                                "target_lang_sense_clarification": "действие по значению глагола «унижать»"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cec61168-7c19-3b84-9115-ef9f053f1cf0",
                    "sense_definition": "An act or instance of subjecting someone to humiliation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "act_of_humiliating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The continuous <w>humiliatings</w> took a massive toll on the soldier's morale and well-being.",
                            "target_lang_translations": {
                                "ru": "Постоянные <w>унижения</w> нанесли серьезный удар по моральному духу и состоянию солдата."
                            }
                        },
                        {
                            "text": "Philosophers analyzed such public <w>humiliatings</w> as expressions of social dominance.",
                            "target_lang_translations": {
                                "ru": "Философы анализировали подобные публичные <w>унижения</w> как проявление социального доминирования."
                            }
                        }
                    ],
                    "synonyms": [
                        "humiliation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или единичный случай оскорбления, ущемления чьего-либо достоинства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "унижение",
                                "target_lang_sense_clarification": "акт причинения оскорбления или позора"
                            },
                            {
                                "target_lang_word": "оскорбление",
                                "target_lang_sense_clarification": "ущемление достоинства личности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}