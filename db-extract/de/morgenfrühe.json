                ],
                "senses": [
                    {
                        "sense_id": "eaba3700-0312-3594-9e5e-14d7354bd9b7",
                        "entry_id": "9481ffa3-5cfb-3f30-baff-1f7b162285d0",
                        "glosses": [
                            "Zeit(punkt) früh am Morgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfa08fa4-7d0e-4f21-a7cc-a6b82709f088",
                                "sense_id": "eaba3700-0312-3594-9e5e-14d7354bd9b7",
                                "text": "„Selbstverständlich geleitete sie am nächsten Tage den alten Schelm schon in aller Morgenfrühe durch das Hauptportal nach den inneren Gemächern.“"
                            },
                            {
                                "example_id": "90a0657d-12c7-4219-86ef-04944dc314ac",
                                "sense_id": "eaba3700-0312-3594-9e5e-14d7354bd9b7",
                                "text": "„In der Morgenfrühe des 12. Juni trat er aus seinem Zelt, das am Abend zuvor auf dem steilen linken Ufer des Njemen aufgeschlagen war, und beobachtete durch das Fernrohr das flutartige Hervorströmen seiner Truppen aus dem Wilkowisker Walde, die in drei Kolonnen auf die drei Njemenbrücken zumarschierten.“"
                            },
                            {
                                "example_id": "f304a85f-4f16-4983-a2a4-6e3e8a91fcc2",
                                "sense_id": "eaba3700-0312-3594-9e5e-14d7354bd9b7",
                                "text": "„Wie ich gehofft hatte, kam der Grieche in aller Morgenfrühe in mein Zimmer.“"
                            },
                            {
                                "example_id": "ecaec7cc-c142-4b28-a514-93b4e11234cc",
                                "sense_id": "eaba3700-0312-3594-9e5e-14d7354bd9b7",
                                "text": "„Robert ließ eine bejahende Vermutung durchblicken, ohne näher von der Begegnung in der Morgenfrühe zu sprechen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
