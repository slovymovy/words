                        "entry_id": "c1c0943e-7c15-3e4e-9587-cf03008de7e2",
                        "glosses": [
                            "Variante de pyracantha."
                        ],
                        "tags": [
                            "dated",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "2c09c848-5fc0-4c79-a9e9-1f9422a3e8be",
                                "sense_id": "0b706a50-d547-3fd6-81d9-1518bdd79492",
                                "text": "La Pyracanthe croît naturellement en Provence & en Italie ; ses feuilles sont toujours vertes & ses fruits ne quittent point durant tout l’hiver."
                            },
                            {
                                "example_id": "b9fbce25-3828-4865-8e4c-b177aa7a8323",
                                "sense_id": "0b706a50-d547-3fd6-81d9-1518bdd79492",
                                "text": "Cette inconstance, qu’on remarque de même dans le nombre des ovules, se retrouve de même dans les feuilles ; en mettant à part le Pyracanthe, où elles présentent une plus grande régularité, on trouve dans les autres espèces des passages continuels des feuilles simples aux divisées."
                            }
                        ]
                    }
