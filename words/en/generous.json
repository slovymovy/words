{
    "word_family": [
        "generosity",
        "generously"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b38e47f8-42e8-3986-8dc6-23d5099e3a26",
                    "sense_definition": "Willing to give money, help, kindness, or time freely; giving more than is expected or needed.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "character_giving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has always been <w>generous</w> with her time when helping students.",
                            "target_lang_translations": {
                                "ru": "Она всегда была <w>щедра</w> на своё время, помогая студентам.",
                                "tr": "Öğrencilere yardım ederken zamanı konusunda her zaman <w>cömert</w> olmuştur.",
                                "zh": "她在帮助学生时总是非常<w>慷慨</w>地付出时间。"
                            }
                        },
                        {
                            "text": "The company made a <w>generous</w> donation to the local hospital.",
                            "target_lang_translations": {
                                "ru": "Компания сделала <w>щедрое</w> пожертвование местной больнице.",
                                "tr": "Şirket, yerel hastaneye <w>cömert</w> bir bağışta bulundu.",
                                "zh": "公司向当地医院捐赠了一笔<w>慷慨</w>的善款。"
                            }
                        }
                    ],
                    "synonyms": [
                        "giving",
                        "charitable",
                        "open-handed",
                        "liberal",
                        "munificent",
                        "kind",
                        "unselfish"
                    ],
                    "antonyms": [
                        "stingy"
                    ],
                    "common_phrases": [
                        "generous donation",
                        "generous offer",
                        "generous support",
                        "generous with money"
                    ],
                    "target_lang_definitions": {
                        "ru": "Готовый охотно делиться деньгами, помощью или временем; дающий больше, чем ожидается.",
                        "tr": "Para, yardım, nezaket veya zamanını isteyerek ve bolca veren; beklenenden veya gerekenden fazlasını sunan.",
                        "zh": "乐于给予金钱、帮助、善意或时间；给予的超过预期或需要。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щедрый",
                                "target_lang_sense_clarification": "не скупой, охотно отдающий"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "cömert",
                                "target_lang_sense_clarification": "paylaşmayı seven, eli açık"
                            },
                            {
                                "target_lang_word": "eli açık",
                                "target_lang_sense_clarification": "parasını ve imkanlarını esirgemeyen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "慷慨",
                                "target_lang_sense_clarification": "大方，不吝啬"
                            },
                            {
                                "target_lang_word": "大方",
                                "target_lang_sense_clarification": "在金钱或财物上不计较"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30f82bb3-b3c8-3eb0-9d17-a10f06bdaddf",
                    "sense_definition": "Larger than usual, expected, or necessary; abundant or copious.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef served a <w>generous</w> portion of roast beef.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар подал <w>щедрую</w> порцию ростбифа.",
                                "tr": "Şef, <w>bol</w> bir porsiyon rozbif servis etti.",
                                "zh": "厨师端上了一份<w>丰盛</w>的烤牛肉。"
                            }
                        },
                        {
                            "text": "Add a <w>generous</w> amount of olive oil to the pan.",
                            "target_lang_translations": {
                                "ru": "Добавьте <w>изрядное</w> количество оливкового масла на сковороду.",
                                "tr": "Tavaya <w>bol</w> miktarda zeytinyağı ekleyin.",
                                "zh": "往锅里加入<w>充足</w>的橄榄油。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bountiful",
                        "handsome",
                        "liberal"
                    ],
                    "common_phrases": [
                        "generous amount",
                        "generous portion",
                        "generous helping"
                    ],
                    "target_lang_definitions": {
                        "ru": "Больший по размеру или количеству, чем обычно; обильный.",
                        "tr": "Normalden, beklenenden veya gerekenden daha büyük ya da çok olan; bol, doyurucu.",
                        "zh": "比通常、预期或需要的更大；充足或丰富。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щедрый",
                                "target_lang_sense_clarification": "обильный, большой (о порции, урожае)"
                            },
                            {
                                "target_lang_word": "изрядный",
                                "target_lang_sense_clarification": "значительный по количеству"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bol",
                                "target_lang_sense_clarification": "miktar veya porsiyon olarak çok"
                            },
                            {
                                "target_lang_word": "cömert",
                                "target_lang_sense_clarification": "porsiyon veya miktar için büyük/doyurucu anlamında"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "充足",
                                "target_lang_sense_clarification": "数量多，足够"
                            },
                            {
                                "target_lang_word": "丰盛",
                                "target_lang_sense_clarification": "指食物或分量多且好"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "676a7ea9-156f-3f92-8fd8-62cf8e1e509e",
                    "sense_definition": "Showing a kind, noble, and forgiving nature; not petty or resentful.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "character_noble",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was very <w>generous</w> of him to forgive the mistake so quickly.",
                            "target_lang_translations": {
                                "ru": "С его стороны было очень <w>великодушно</w> так быстро простить эту ошибку.",
                                "tr": "Hatayı bu kadar çabuk affetmesi onun açısından çok <w>yüce gönüllüce</w> bir davranıştı.",
                                "zh": "他能如此迅速地原谅这个错误，真是非常<w>宽宏大量</w>。"
                            }
                        },
                        {
                            "text": "Thank you for your <w>generous</w> words about my performance.",
                            "target_lang_translations": {
                                "ru": "Спасибо за ваши <w>добрые</w> слова о моем выступлении.",
                                "tr": "Performansım hakkındaki <w>güzel</w> sözleriniz için teşekkür ederim.",
                                "zh": "感谢您对我的表演给出如此<w>宽厚</w>的评价。"
                            }
                        }
                    ],
                    "synonyms": [
                        "charitable"
                    ],
                    "common_phrases": [
                        "generous spirit",
                        "generous heart",
                        "generous words"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявляющий благородство, доброту и умение прощать; не мелочный.",
                        "tr": "Nazik, yüce gönüllü ve bağışlayıcı bir karakter gösteren; kindar veya küçük hesaplar peşinde olmayan.",
                        "zh": "表现出善良、高尚和宽容的本性；不狭隘或记仇。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "великодушный",
                                "target_lang_sense_clarification": "проявляющий душевную широту, умеющий прощать"
                            },
                            {
                                "target_lang_word": "благородный",
                                "target_lang_sense_clarification": "высоконравственный"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yüce gönüllü",
                                "target_lang_sense_clarification": "bağışlayıcı ve hoşgörülü"
                            },
                            {
                                "target_lang_word": "alçakgönüllü",
                                "target_lang_sense_clarification": "incelik ve nezaket gösteren"
                            },
                            {
                                "target_lang_word": "cömert",
                                "target_lang_sense_clarification": "sevgi ve övgüde esirgemeyen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宽宏大量",
                                "target_lang_sense_clarification": "形容人度量大，能容人"
                            },
                            {
                                "target_lang_word": "高尚",
                                "target_lang_sense_clarification": "道德水平高，品格好"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b382f31c-3d2d-380c-9dd1-7d279b12531e",
                    "sense_definition": "Rich and full-bodied in flavor or nature, typically describing wine.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "wine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We enjoyed a glass of <w>generous</w> red wine with our steak.",
                            "target_lang_translations": {
                                "ru": "Мы насладились бокалом <w>богатого</w> красного вина со стейком.",
                                "tr": "Bifteğimizin yanında bir kadeh <w>zengin</w> aromalı kırmızı şarabın tadını çıkardık.",
                                "zh": "我们享用牛排时，配了一杯<w>浓郁</w>的红酒。"
                            }
                        },
                        {
                            "text": "The vintage is known for being particularly <w>generous</w> and warming.",
                            "target_lang_translations": {
                                "ru": "Этот винтаж известен тем, что он особенно <w>насыщенный</w> и согревающий.",
                                "tr": "Bu rekolte, özellikle <w>gövdeli</w> ve iç ısıtan yapısıyla bilinir.",
                                "zh": "这款年份酒以其特别<w>醇厚</w>和暖心的口感而闻名。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Богатый и насыщенный по вкусу (обычно о вине).",
                        "tr": "Lezzet veya nitelik olarak zengin ve gövdeli (genellikle şarap için).",
                        "zh": "口感丰富、浓郁，通常用于描述葡萄酒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "богатый",
                                "target_lang_sense_clarification": "о вкусе или аромате"
                            },
                            {
                                "target_lang_word": "насыщенный",
                                "target_lang_sense_clarification": "полный, густой"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "zengin",
                                "target_lang_sense_clarification": "aroma veya lezzet bakımından"
                            },
                            {
                                "target_lang_word": "gövdeli",
                                "target_lang_sense_clarification": "yoğun tatlı şaraplar için"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "浓郁",
                                "target_lang_sense_clarification": "指味道或香气深厚"
                            },
                            {
                                "target_lang_word": "醇厚",
                                "target_lang_sense_clarification": "指酒味纯正浓厚"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01771aa1-5c44-3f2f-a11a-3bf3e2cb8c01",
                    "sense_definition": "Of noble birth or lineage.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "lineage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight was a man of <w>generous</w> blood and high standing.",
                            "target_lang_translations": {
                                "ru": "Рыцарь был человеком <w>благородных</w> кровей и высокого положения.",
                                "tr": "Şövalye, <w>asil</w> bir kandan gelen ve yüksek konuma sahip bir adamdı.",
                                "zh": "这位骑士出身<w>高贵</w>，地位显赫。"
                            }
                        },
                        {
                            "text": "Old texts often refer to the king's <w>generous</w> ancestry.",
                            "target_lang_translations": {
                                "ru": "Старинные тексты часто упоминают <w>знатное</w> происхождение короля.",
                                "tr": "Eski metinler genellikle kralın <w>soylu</w> soyundan bahseder.",
                                "zh": "古籍中常提到国王的<w>名门</w>血统。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "original meaning referring to birth"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Знатного происхождения или рода (устаревшее значение).",
                        "tr": "Soylu bir aileden veya kökenden gelen (eski kullanım).",
                        "zh": "出身高贵或血统纯正。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "благородный",
                                "target_lang_sense_clarification": "о происхождении"
                            },
                            {
                                "target_lang_word": "родовитый",
                                "target_lang_sense_clarification": "принадлежащий к знатному роду"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "asil",
                                "target_lang_sense_clarification": "soylu, köklü aileden gelen"
                            },
                            {
                                "target_lang_word": "soylu",
                                "target_lang_sense_clarification": "noble soy ağacına sahip"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "高贵",
                                "target_lang_sense_clarification": "出身显赫"
                            },
                            {
                                "target_lang_word": "名门",
                                "target_lang_sense_clarification": "指出身于有地位的家族"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}