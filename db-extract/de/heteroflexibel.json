                ],
                "senses": [
                    {
                        "sense_id": "79c3aeb0-1d80-3672-8aa5-e0dceaaab6d2",
                        "entry_id": "ce7160c7-31bf-335e-893c-c683bdc36e8b",
                        "glosses": [
                            "grundsätzlich heterosexuell, aber auch offen für gleichgeschlechtliche sexuelle Kontakte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17822d40-92e1-4101-a021-0f95b46ae05c",
                                "sense_id": "79c3aeb0-1d80-3672-8aa5-e0dceaaab6d2",
                                "text": "„Wenn dann noch Leute antanzen, die sich als heteroflexibel oder homoflexibel einordnen, sieht das so aus, als wollten sie der Einordnung ›bi‹ ausweichen.“"
                            },
                            {
                                "example_id": "434099e3-8ca4-4a6c-9b22-f1e9dc8915f3",
                                "sense_id": "79c3aeb0-1d80-3672-8aa5-e0dceaaab6d2",
                                "text": "„Ab welchem Mengenverhältnis muss/darf/sollte ich mich mit den schönen Labeln heteroflexibel/homoflexibel schmücken?“"
                            },
                            {
                                "example_id": "a237e58c-eda9-40e9-8509-387fbf99f86c",
                                "sense_id": "79c3aeb0-1d80-3672-8aa5-e0dceaaab6d2",
                                "text": "„Mit Bi- oder Asexualität ist inzwischen kein Blumentopf mehr zu gewinnen, doch wer weiß schon so genau, was homoflexibel, heteroflexibel, pansexuell oder sapiosexuell bedeutet?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
