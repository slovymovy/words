    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "54487946-3555-3acf-b560-0efd1e7b615b",
                    "sense_definition": "Causing boredom or tiredness; making one feel tired and impatient because something is not interesting.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This movie is so <w>boring</w> that I want to leave the cinema.",
                            "target_lang_translations": {
                                "ru": "Этот фильм такой <w>скучный</w>, что я хочу уйти из кинотеатра.",
                                "pl": "Ten film jest tak <w>nudny</w>, że chcę wyjść z kina."
                            }
                        },
                        {
                            "text": "He has a very <w>boring</w> job and wants to find a new one.",
                            "target_lang_translations": {
                                "ru": "У него очень <w>скучная</w> работа, и он хочет найти новую.",
                                "pl": "Ma bardzo <w>nudną</w> pracę i chce znaleźć nową."
                            }
                        }
                    ],
                    "synonyms": [
                        "dull",
                        "uninteresting",
                        "tedious",
                        "monotonous"
                    ],
                    "antonyms": [
                        "interesting",
                        "exciting",
                        "entertaining",
                        "fascinating",
                        "engaging"
                    ],
                    "common_phrases": [
                        "boring job",
                        "boring life",
                        "boring movie",
                        "dead boring"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий скуку или утомление; заставляющий чувствовать усталость и нетерпение из-за отсутствия интереса.",
                        "pl": "Powodujący nudę lub znużenie; sprawiający, że ktoś czuje się zmęczony i zniecierpliwiony z powodu braku zainteresowania."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скучный",
                                "target_lang_sense_clarification": "вызывающий скуку"
                            },
                            {
                                "target_lang_word": "нудный",
                                "target_lang_sense_clarification": "утомительный, тягомотный"
                            },
                            {
                                "target_lang_word": "неинтересный",
                                "target_lang_sense_clarification": "лишенный интереса"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "nudny",
                                "target_lang_sense_clarification": "wywołujący nudę, niebudzący zainteresowania"
                            },
                            {
                                "target_lang_word": "nużący",
                                "target_lang_sense_clarification": "powodujący znużenie, monotonny"
                            },
                            {
                                "target_lang_word": "nieciekawy",
                                "target_lang_sense_clarification": "pozbawiony interesujących cech"
                            }
                        ]
                    }
