                ],
                "senses": [
                    {
                        "sense_id": "b10c5b6a-784d-37da-b6b5-6f2728bd9e40",
                        "entry_id": "9a834cee-f66f-391d-a6c4-19861f72591e",
                        "glosses": [
                            "эстрадная песенка игривого содержания, исполняемая в кафешантане"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "310190af-6ac8-40aa-9637-cd5899aca166",
                                "sense_id": "b10c5b6a-784d-37da-b6b5-6f2728bd9e40",
                                "text": "За лодкой, раскачивая хоботы, выступали слоны, на спинах которых сидели баядерки, гейши, распевая игривые шансонетки."
                            },
                            {
                                "example_id": "a4175c94-ff4f-4a69-8804-3a58793f2606",
                                "sense_id": "b10c5b6a-784d-37da-b6b5-6f2728bd9e40",
                                "text": "Так, пьяная Офелия на балу (ее играла самая красивая наша актриса Валентина Вагрина) пела веселую песенку с весьма фривольным текстом, в стиле немецких шансонеток начала нашего столетия, под острый и пряный аккомпанемент джаза."
                            },
                            {
                                "example_id": "eece9bb5-fa10-448a-85b2-e955a3e564d3",
                                "sense_id": "b10c5b6a-784d-37da-b6b5-6f2728bd9e40",
                                "text": "Прелестная, знаете ли, вдруг вспомнилась шансонетка начала века. Что-то вроде: «Поедемте кататься, я вас люблю, не смейте прикасаться, не потерплю»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a9ba83e-0713-46d5-aec2-14cd18f5ba54",
                        "source_entry_id": "9a834cee-f66f-391d-a6c4-19861f72591e",
                        "source_sense_id": "b10c5b6a-784d-37da-b6b5-6f2728bd9e40",
                        "target_lang_word": "chansonnette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chansonnette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6fc5d7fe-a502-3813-bef7-4c97a36b2f8c",
                                        "entry_id": "9d65fc99-7b02-3028-b086-3f7c6393afa7",
                                        "glosses": [
                                            "Petite chanson, souvent légère et gracieuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e3d9b79-fb7f-4d93-a7e6-c7abdf91a26f",
                                                "sense_id": "6fc5d7fe-a502-3813-bef7-4c97a36b2f8c",
                                                "text": "Bon vin, bons mots, gaillardes chansonnettes ;\nSont aiguillons aux amoureux désirs,\nEn toute porte entr’ouverte aux plaisirs\nL’adroit Amour aisément s’insinue."
                                            },
                                            {
                                                "example_id": "0af35a0c-81a8-467b-9d5e-796752bc0323",
                                                "sense_id": "6fc5d7fe-a502-3813-bef7-4c97a36b2f8c",
                                                "text": "Je bricole mes sculptures comme des chansonnettes, en plombard appliqué."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bc071f7-4813-349f-86eb-0efd3c9b499e",
                                        "entry_id": "9d65fc99-7b02-3028-b086-3f7c6393afa7",
                                        "glosses": [
                                            "Chanson tendre."
                                        ],
