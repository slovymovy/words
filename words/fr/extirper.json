{
    "word_family": [
        "extirpation",
        "extirpateur",
        "extirpable",
        "inextirpable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c1c96488-6089-311b-bd4a-835593930c9a",
                    "sense_definition": "Tirer ou faire sortir quelque chose ou quelqu'un d'un endroit avec beaucoup de peine ou d'effort.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "extraire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après de longues minutes de recherche, il a réussi à <w>extirper</w> ses clés du fond de son sac."
                        },
                        {
                            "text": "Les pompiers ont mis plus d'une heure pour <w>extirper</w> la victime hors du véhicule accidenté."
                        }
                    ],
                    "synonyms": [
                        "extraire",
                        "sortir",
                        "retirer"
                    ],
                    "antonyms": [
                        "enfoncer",
                        "introduire"
                    ],
                    "common_phrases": [
                        "extirper de sa poche"
                    ]
                },
                {
                    "sense_id": "255d4d0d-6df0-395c-81f3-63a76f090b2b",
                    "sense_definition": "Se dégager ou sortir péniblement d'un lieu étroit, encombré ou désagréable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "extraire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieil homme s'<w>extirpe</w> lourdement de son fauteuil pour aller ouvrir la porte d'entrée."
                        },
                        {
                            "text": "Elle s'<w>extirpa</w> péniblement de la foule compacte pour pouvoir respirer un peu d'air frais."
                        }
                    ],
                    "synonyms": [
                        "se dégager",
                        "s'échapper",
                        "sortir"
                    ],
                    "antonyms": [
                        "s'enfermer",
                        "s'engouffrer"
                    ],
                    "common_phrases": [
                        "s'extirper du lit",
                        "s'extirper de la foule"
                    ]
                },
                {
                    "sense_id": "78400638-081d-35c0-8725-dddbe874fe97",
                    "sense_definition": "Obtenir quelque chose de quelqu'un avec beaucoup de mal, par ruse ou sous la contrainte.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obtenir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les policiers ont interrogé le suspect pendant des heures sans parvenir à lui <w>extirper</w> le moindre aveu."
                        },
                        {
                            "text": "Le journaliste a réussi à <w>extirper</w> une information confidentielle au porte-parole du gouvernement."
                        }
                    ],
                    "synonyms": [
                        "arracher",
                        "soutirer"
                    ],
                    "common_phrases": [
                        "extirper un aveu",
                        "extirper une confession"
                    ]
                },
                {
                    "sense_id": "009da01c-8aea-3846-8383-004e86f82d9a",
                    "sense_definition": "Faire disparaître totalement et définitivement un mal, un vice ou une mauvaise habitude.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "detruire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement cherche à mettre en place des lois sévères pour <w>extirper</w> la corruption de l'administration."
                        },
                        {
                            "text": "Il faut beaucoup de volonté pour parvenir à <w>extirper</w> ces mauvaises habitudes de notre quotidien."
                        }
                    ],
                    "synonyms": [
                        "éradiquer",
                        "anéantir",
                        "éliminer"
                    ],
                    "antonyms": [
                        "enraciner",
                        "instaurer"
                    ],
                    "common_phrases": [
                        "extirper le mal",
                        "extirper la corruption"
                    ]
                },
                {
                    "sense_id": "150e7277-0a13-3aa3-ac26-1c5c37a5a286",
                    "sense_definition": "Arracher complètement une plante avec ses racines afin qu'elle ne puisse plus repousser.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "detruire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jardinier passe sa matinée à <w>extirper</w> les mauvaises herbes qui envahissent le potager."
                        },
                        {
                            "text": "Il est indispensable d'<w>extirper</w> chaque plante nuisible pour protéger les cultures environnantes."
                        }
                    ],
                    "synonyms": [
                        "déraciner",
                        "arracher"
                    ],
                    "antonyms": [
                        "planter",
                        "semer"
                    ],
                    "common_phrases": [
                        "extirper les mauvaises herbes"
                    ]
                },
                {
                    "sense_id": "07a659c0-a4a3-3c86-b0dd-22f0607ebe1d",
                    "sense_definition": "Enlever entièrement une tumeur, un kyste ou un organe malade par une opération chirurgicale.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "extraire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chirurgien a dû intervenir d'urgence pour <w>extirper</w> la tumeur maligne sans toucher aux tissus voisins."
                        },
                        {
                            "text": "L'opération consistait à <w>extirper</w> le kyste avant qu'il ne s'infecte et cause d'autres complications."
                        }
                    ],
                    "synonyms": [
                        "exciser",
                        "réséquer",
                        "enlever"
                    ],
                    "antonyms": [
                        "greffer",
                        "implanter"
                    ],
                    "common_phrases": [
                        "extirper une tumeur"
                    ]
                }
            ]
        }
    ]
}