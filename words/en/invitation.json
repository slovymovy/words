{
    "word_family": [
        "invite",
        "inviting",
        "invitational",
        "invitee"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c4e0d995-ddda-3539-932d-4997e72d78bb",
                    "sense_definition": "A document, card, or verbal message used to ask someone to go somewhere or do something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "request_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We received a wedding <w>invitation</w> in the mail yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера мы получили по почте свадебное <w>приглашение</w>.",
                                "zh": "我们昨天在邮件里收到了一份婚礼<w>请柬</w>。"
                            }
                        },
                        {
                            "text": "She sent an <w>invitation</w> to all her friends for the birthday party.",
                            "target_lang_translations": {
                                "ru": "Она разослала всем друзьям <w>приглашение</w> на вечеринку в честь дня рождения.",
                                "zh": "她给所有的朋友都发了生日派对的<w>邀请</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "send an invitation",
                        "receive an invitation",
                        "wedding invitation",
                        "party invitation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Документ, открытка или устное сообщение с просьбой прийти куда-либо или сделать что-либо.",
                        "zh": "用于请求某人前往某处或做某事的书面文件、卡片或口头信息。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приглашение",
                                "target_lang_sense_clarification": "документ или открытка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "邀请函",
                                "target_lang_sense_clarification": "书面邀请"
                            },
                            {
                                "target_lang_word": "请柬",
                                "target_lang_sense_clarification": "正式的邀请卡"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e8fbbfc-e542-324c-86e2-76d1affabcaf",
                    "sense_definition": "The act of politely asking someone to go somewhere or do something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "request_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He visited the museum at the <w>invitation</w> of the director.",
                            "target_lang_translations": {
                                "ru": "Он посетил музей по <w>приглашению</w> директора.",
                                "zh": "他应馆长的<w>邀请</w>参观了博物馆。"
                            }
                        },
                        {
                            "text": "I had to decline the <w>invitation</w> because I was busy.",
                            "target_lang_translations": {
                                "ru": "Мне пришлось отклонить <w>приглашение</w>, так как я был занят.",
                                "zh": "因为很忙，我不得不拒绝了这份<w>邀请</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "accept an invitation",
                        "decline an invitation",
                        "at the invitation of",
                        "extend an invitation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие, заключающееся в вежливой просьбе прийти куда-либо или сделать что-либо.",
                        "zh": "礼貌地请求某人前往某处或做某事的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приглашение",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "邀请",
                                "target_lang_sense_clarification": "行为或动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88e9b326-2c3f-3f1c-b88b-eec992e0b401",
                    "sense_definition": "Something that attracts, tempts, or encourages someone to do something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "enticement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The open door was an <w>invitation</w> for the curious cat to enter.",
                            "target_lang_translations": {
                                "ru": "Открытая дверь была для любопытной кошки <w>приглашением</w> войти.",
                                "zh": "敞开的门对那只好奇的猫来说简直是一种<w>诱惑</w>。"
                            }
                        },
                        {
                            "text": "His silence was an <w>invitation</w> for her to continue speaking.",
                            "target_lang_translations": {
                                "ru": "Его молчание было для неё <w>приглашением</w> продолжить разговор.",
                                "zh": "他的沉默是在<w>示意</w>她继续说下去。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lathing"
                    ],
                    "common_phrases": [
                        "open invitation"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что привлекает, искушает или побуждает кого-либо к действию.",
                        "zh": "吸引、诱惑或鼓励某人做某事的事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приглашение",
                                "target_lang_sense_clarification": "переносное значение; призыв"
                            },
                            {
                                "target_lang_word": "соблазн",
                                "target_lang_sense_clarification": "искушение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诱惑",
                                "target_lang_sense_clarification": "引诱某人做某事"
                            },
                            {
                                "target_lang_word": "引子",
                                "target_lang_sense_clarification": "引起后续行为的契机"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7a7c78d-36f3-3c74-b48a-160d2cd0e200",
                    "sense_definition": "A bid in card games that encourages a partner to bid higher if they have a strong hand.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical_game",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His bid was a clear <w>invitation</w> to slam, but she passed.",
                            "target_lang_translations": {
                                "ru": "Его ставка была явным <w>приглашением</w> к шлему, но она спасовала.",
                                "zh": "他的叫牌是明确的满贯<w>邀请</w>，但她选择了放弃。"
                            }
                        },
                        {
                            "text": "You should only accept the <w>invitation</w> if you have maximum points.",
                            "target_lang_translations": {
                                "ru": "Вам следует принимать <w>приглашение</w> только при наличии максимума очков.",
                                "zh": "只有在你点数足够高时，才应该接受这个<w>邀请</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "card games"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заявка в карточных играх, побуждающая партнера повысить ставки при наличии сильной карты.",
                        "zh": "纸牌游戏中的一种叫牌，鼓励搭档在手牌较强时加倍叫牌。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приглашение",
                                "target_lang_sense_clarification": "в карточных играх"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "邀请叫牌",
                                "target_lang_sense_clarification": "桥牌术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92d3e307-cd03-39eb-8bdb-3f0dc0777830",
                    "sense_definition": "A line intentionally left open by a fencer to encourage the opponent to attack.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical_sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fencer offered an <w>invitation</w> to lure his opponent into a trap.",
                            "target_lang_translations": {
                                "ru": "Фехтовальщик сделал <w>приглашение</w>, чтобы заманить противника в ловушку.",
                                "zh": "这位剑手故意露出<w>破绽</w>，以诱使对手落入陷阱。"
                            }
                        },
                        {
                            "text": "He recognized the <w>invitation</w> and did not attack the open line.",
                            "target_lang_translations": {
                                "ru": "Он распознал <w>приглашение</w> и не стал атаковать открытую линию.",
                                "zh": "他识破了对方的<w>诱敌</w>之计，没有攻击那个空档。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "fencing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Линия, намеренно оставленная открытой фехтовальщиком, чтобы спровоцировать атаку противника.",
                        "zh": "击剑运动员故意留出的空档，旨在诱使对手发起攻击。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приглашение",
                                "target_lang_sense_clarification": "в фехтовании"
                            },
                            {
                                "target_lang_word": "вызов",
                                "target_lang_sense_clarification": "провокация атаки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诱敌",
                                "target_lang_sense_clarification": "击剑战术"
                            },
                            {
                                "target_lang_word": "破绽",
                                "target_lang_sense_clarification": "故意暴露的空档"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a385a878-72ba-3c05-86ac-24126eb36f36",
                    "sense_definition": "A brief exhortation introducing the confession in the Anglican church service.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical_religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The priest read the <w>invitation</w> before the congregation knelt to pray.",
                            "target_lang_translations": {
                                "ru": "Священник зачитал <w>призыв</w>, прежде чем прихожане преклонили колени для молитвы.",
                                "zh": "牧师在会众跪下祈祷前宣读了<w>劝诫词</w>。"
                            }
                        },
                        {
                            "text": "The service proceeded from the <w>invitation</w> to the general confession.",
                            "target_lang_translations": {
                                "ru": "Служба перешла от <w>призыва</w> к общей исповеди.",
                                "zh": "礼拜仪式从<w>劝诫词</w>进行到了公开忏悔环节。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "ecclesiastical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Краткое воззвание, предваряющее исповедь в англиканском богослужении.",
                        "zh": "圣公会礼拜中在忏悔前宣读的简短劝诫。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "призыв",
                                "target_lang_sense_clarification": "церковный термин"
                            },
                            {
                                "target_lang_word": "приглашение",
                                "target_lang_sense_clarification": "к молитве"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "劝诫词",
                                "target_lang_sense_clarification": "宗教仪式用语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}