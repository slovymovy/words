                                            {
                                                "example_id": "ce2693e3-1273-4015-8abf-49bd570cace5",
                                                "sense_id": "3bf71bb5-9bf8-352a-b18c-4b43409e52e4",
                                                "text": "Nothing could be more business-like than the construction of the stout dams, and nothing more gently rural than the limpid lakes, with the grand old forest trees marshalled round their margins … ."
                                            },
                                            {
                                                "example_id": "6f7710eb-14bb-4f86-a0f4-24af9b9fb37e",
                                                "sense_id": "3bf71bb5-9bf8-352a-b18c-4b43409e52e4",
                                                "text": "The Australian teens, both from Melbourne, were enjoying a backpacking trip when they became ill after a night out in Vang Vieng.\nThe picturesque rural town in northern Laos has long been a popular backpacking spot."
                                            }
                                        ]
