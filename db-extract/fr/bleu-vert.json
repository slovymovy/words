                "senses": [
                    {
                        "sense_id": "e8e6b5ff-1fd4-31fb-bfdc-0f98c034c50e",
                        "entry_id": "8ce86f75-989f-3083-8d5d-82bef4ec6a17",
                        "glosses": [
                            "D’une couleur intermédiaire entre le bleu et le vert."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "179ab6d2-40d7-4d43-8c3e-233d8f9623f1",
                                "sense_id": "e8e6b5ff-1fd4-31fb-bfdc-0f98c034c50e",
                                "text": "Ils parvinrent à destination au point du jour, la plage était déserte, le soleil blanchissait le sable d’où la mer, semblable à une assiette bleu-vert au loin, s’était retirée."
                            },
                            {
                                "example_id": "bf9ae2ac-01a5-43af-9a5c-9a2022797149",
                                "sense_id": "e8e6b5ff-1fd4-31fb-bfdc-0f98c034c50e",
                                "text": "De la vue qu’encadrait la fenêtre de sa chambre, il retint le bleu lavande du ciel orageux et des collines et les tons rompus de bleu-vert du champ de blé en herbe."
                            },
                            {
                                "example_id": "5d0e5fdf-d98a-4290-abfb-4d9e41868c7e",
                                "sense_id": "e8e6b5ff-1fd4-31fb-bfdc-0f98c034c50e",
                                "text": "Ann et sa sœur Betty comparent leur image à celles des actrices. Elles ont le nez droit, des sourcils arqués, des iris bleu-vert au regard flou."
                            }
                        ]
                    }
