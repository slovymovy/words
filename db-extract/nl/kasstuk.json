                                "target_senses": [
                                    {
                                        "sense_id": "2aeb983a-0c4b-35cc-99f2-7f0b65036ff4",
                                        "entry_id": "bc4bd296-b09f-36f5-90cf-6f31c4b6f31d",
                                        "glosses": [
                                            "One who has won or often wins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "010799f3-1fba-4626-a555-4f29c2b686f4",
                                                "sense_id": "2aeb983a-0c4b-35cc-99f2-7f0b65036ff4",
                                                "text": "Of all the queer collections of humans outside of a crazy asylum, it seemed to me this sanitarium was the cup winner. […] When you're well enough off so's you don't have to fret about anything but your heft or your diseases you begin to get queer, I suppose."
                                            },
                                            {
                                                "example_id": "9c88eb86-7252-4e11-bf48-780c89618376",
                                                "sense_id": "2aeb983a-0c4b-35cc-99f2-7f0b65036ff4",
                                                "text": "Remember Rappin' Duke? Duh-ha, duh-ha\nYou never thought that hip-hop would take it this far\nNow I'm in the limelight 'cause I rhyme tight\nTime to get paid, blow up like the World Trade\nBorn sinner, the opposite of a winner\nRemember when I used to eat sardines for dinner"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fdf4118-7c24-339d-813b-af2374903664",
                                        "entry_id": "bc4bd296-b09f-36f5-90cf-6f31c4b6f31d",
                                        "glosses": [
                                            "A point or goal that wins a competition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25090263-76bf-4d3b-b2d8-4fd34c86d9f0",
                                                "sense_id": "4fdf4118-7c24-339d-813b-af2374903664",
                                                "text": "It was a fitting scoreline on the club's landmark anniversary, and appropriate that Van Persie should get the winner."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45a2543d-8346-4341-a6d9-38f19a2b12ec",
                        "source_entry_id": "df089703-ca73-37e6-a756-aa7f3537495a",
                        "source_sense_id": "ce1ecf77-1ead-3505-aee0-24346f8dfb2d",
                        "source_sense_description": "film of uitvoering die alle verwachtingen overtreft wat betreft de opkomst van publiek",
                        "target_lang_word": "smash",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "smash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90ce7c76-5a1c-33f1-9383-264dba1f007f",
                                        "entry_id": "2a05c5be-c66d-3932-881f-eaa3cbc9f3fd",
                                        "glosses": [
                                            "The sound of a violent impact; a violent striking together."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7526e697-4679-45b6-9b39-f94f6bb140b3",
                                                "sense_id": "90ce7c76-5a1c-33f1-9383-264dba1f007f",
                                                "text": "I could hear the screech of the brakes, then the horrible smash of cars colliding."
                                            },
                                            {
                                                "example_id": "806dfefa-a499-4cda-8872-75920b8ea1fd",
                                                "sense_id": "90ce7c76-5a1c-33f1-9383-264dba1f007f",
                                                "text": "The display cabinet hit the floor with a smash."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce38943d-6cd8-3bf7-ae4b-41622258cd69",
                                        "entry_id": "2a05c5be-c66d-3932-881f-eaa3cbc9f3fd",
                                        "glosses": [
                                            "A traffic collision."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK",
                                            "colloquial",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0034b92d-8b27-4040-8e44-0dd6dd442f07",
                                                "sense_id": "ce38943d-6cd8-3bf7-ae4b-41622258cd69",
                                                "text": "The driver and two passengers were badly injured in the smash."
                                            },
                                            {
                                                "example_id": "f8ceb181-6b97-4047-b7bb-f14cca2f1564",
                                                "sense_id": "ce38943d-6cd8-3bf7-ae4b-41622258cd69",
                                                "text": "The footage of this scene has been re-used in several later films where a good, convincing train smash was required, notably in \"Seven Sinners\" (1937)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62f1bafb-f44b-338a-8de6-36cd8f761954",
                                        "entry_id": "2a05c5be-c66d-3932-881f-eaa3cbc9f3fd",
                                        "glosses": [
                                            "Something very successful or popular (as music, food, fashion, etc)."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53a0b60a-07c0-4c57-ae92-cef7dc355fe0",
                                                "sense_id": "62f1bafb-f44b-338a-8de6-36cd8f761954",
                                                "text": "This new show is sure to be a smash."
                                            },
                                            {
                                                "example_id": "82c79a12-4d8a-47ec-b67c-0ad836b287b5",
                                                "sense_id": "62f1bafb-f44b-338a-8de6-36cd8f761954",
                                                "text": "The dress is a smash."
                                            },
                                            {
                                                "example_id": "dfd052bc-c26c-4c53-a98a-97834007d9d0",
                                                "sense_id": "62f1bafb-f44b-338a-8de6-36cd8f761954",
                                                "text": "[…]Mumford & Sons – prospering British folk band, in the middle of a long tour of Australia, the US and the UK, their newly released album Babel a smash on all fronts – wander to centre stage."
                                            },
                                            {
                                                "example_id": "e6c7dbc1-eef4-432c-84d5-6e6347f77439",
                                                "sense_id": "62f1bafb-f44b-338a-8de6-36cd8f761954",
                                                "text": "All together, this look is a smash in our books."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77767dff-d43f-3e13-80c6-5f42c1b0ed51",
                                        "entry_id": "2a05c5be-c66d-3932-881f-eaa3cbc9f3fd",
                                        "glosses": [
                                            "A very hard overhead shot hit sharply downward."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06390766-40e1-4ba6-b197-4af95c5ed560",
                                                "sense_id": "77767dff-d43f-3e13-80c6-5f42c1b0ed51",
                                                "text": "A smash may not be as pretty as a good half volley, but it can still win points."
                                            },
                                            {
                                                "example_id": "d01390c9-a7d4-4b64-bbe8-6b8e0c716650",
                                                "sense_id": "77767dff-d43f-3e13-80c6-5f42c1b0ed51",
                                                "text": "A Nadal forehand into the net gave Djokovic the set and the Spaniard appeared rattled, firing a smash over the baseline in a rare moment of promise at 30-30 at the start of the third."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64b55564-a5fa-3f97-9efa-3fdf283d313f",
                                        "entry_id": "2a05c5be-c66d-3932-881f-eaa3cbc9f3fd",
                                        "glosses": [
                                            "A bankruptcy."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "colloquial",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89748447-2ff0-4b01-abfa-2fb8ae9c51ad",
                                                "sense_id": "64b55564-a5fa-3f97-9efa-3fdf283d313f",
                                                "text": "Supposing a man has for the space of a month carried on trade in a showy shop in Cheapside, and then comes a smash, — is he not to be held a trader within the bankrupt law, because no one can swear that he has traded for four months?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cf971df-5775-36b9-a6d5-658d11b1e380",
                                        "entry_id": "2a05c5be-c66d-3932-881f-eaa3cbc9f3fd",
                                        "glosses": [
                                            "A disaster; a bad situation."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "colloquial",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b9f8276-41eb-4733-857b-b89dd01abb0f",
                                                "sense_id": "1cf971df-5775-36b9-a6d5-658d11b1e380",
                                                "text": "“There’s nowhere else to go to now, for the people at the Cripples are all in custody, and the bar of the ken—I went up there and see it with my own eyes—is filled with traps.”\n“This is a smash,” observed Toby, biting his lips. “There’s more than one will go with this.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c2e3461-e75d-37d0-8079-aacc3412c1c9",
                                        "entry_id": "2a05c5be-c66d-3932-881f-eaa3cbc9f3fd",
                                        "glosses": [
                                            "A mashed foodstuff."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cb01a91-d280-4d4b-a025-a4add7bc9872",
                                                "sense_id": "7c2e3461-e75d-37d0-8079-aacc3412c1c9",
                                                "text": "[…] the saltbush dukkah, avocado and feta smash."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1f54ae1-d049-39c8-ba24-5bbafc151b94",
                                        "entry_id": "2a05c5be-c66d-3932-881f-eaa3cbc9f3fd",
                                        "glosses": [
                                            "A kind of julep cocktail containing chunks of fresh fruit that can be eaten after finishing the drink."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "698b4e33-12be-3fcb-83d4-095e16bc295b",
                                        "entry_id": "2a05c5be-c66d-3932-881f-eaa3cbc9f3fd",
                                        "glosses": [
                                            "Airspeed; dynamic pressure."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d785ce8c-14fb-43ee-b85d-054920401fb3",
                                                "sense_id": "698b4e33-12be-3fcb-83d4-095e16bc295b",
                                                "text": "Then, for Horner's red team, it became just a matter of gaining sufficient smash (airspeed) to convert on them and film them with gun cameras."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b00f916b-ba62-32a1-a86e-689d7dedeaee",
                                        "entry_id": "2a05c5be-c66d-3932-881f-eaa3cbc9f3fd",
                                        "glosses": [
                                            "Destruction."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b53b3973-b4bb-45d7-bd03-0efb6dc11edc",
                                                "sense_id": "b00f916b-ba62-32a1-a86e-689d7dedeaee",
                                                "text": "I went back with him to the Admiral Benbow, and you cannot imagine a house in such a state of smash; the very clock had been thrown down by these fellows in their furious hunt after my mother and myself; […]"
                                            },
                                            {
                                                "example_id": "5a15326c-ea0d-4be9-acc8-29de91d067d6",
                                                "sense_id": "b00f916b-ba62-32a1-a86e-689d7dedeaee",
                                                "text": "The door panels were in a normal state of smash, but the frame of the door resisted all besiegers, and behind it the owner carried on his varied pursuits […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "smash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6ec443d-7c62-3a4c-83ec-60ca7ac44d71",
                                        "entry_id": "e09a36bd-8e6a-3b87-8be6-a918d71745bd",
                                        "glosses": [
                                            "To break (something brittle) violently."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edd77830-5afc-4c00-ae81-7b545521f315",
                                                "sense_id": "d6ec443d-7c62-3a4c-83ec-60ca7ac44d71",
                                                "text": "The demolition team smashed the buildings to rubble."
                                            },
                                            {
                                                "example_id": "a5b877c6-7fdb-4fb7-b875-049541cb2e93",
                                                "sense_id": "d6ec443d-7c62-3a4c-83ec-60ca7ac44d71",
                                                "text": "The flying rock smashed the window to pieces."
                                            },
                                            {
                                                "example_id": "334b479e-6db1-4767-abdb-85ff3b4c24e5",
                                                "sense_id": "d6ec443d-7c62-3a4c-83ec-60ca7ac44d71",
                                                "text": "Now, I still think that for this box of matches to have escaped the wear of time for immemorial years was a strange, and for me, a most fortunate thing. Yet oddly enough I found here a far more unlikely substance, and that was camphor. I found it in a sealed jar, that, by chance, I supposed had been really hermetically sealed. I fancied at first the stuff was paraffin wax, and smashed the jar accordingly. But the odor of camphor was unmistakable."
                                            },
                                            {
                                                "example_id": "17fa1df3-bcfd-4614-929e-da1efd49f1b0",
                                                "sense_id": "d6ec443d-7c62-3a4c-83ec-60ca7ac44d71",
                                                "text": "Floods in northern India, mostly in the small state of Uttarakhand, have wrought disaster on an enormous scale.[…]Rock-filled torrents smashed vehicles and homes, burying victims under rubble and sludge."
                                            },
                                            {
                                                "example_id": "c136c9a9-73a1-40fc-985f-1d0e7b33df92",
                                                "sense_id": "d6ec443d-7c62-3a4c-83ec-60ca7ac44d71",
                                                "text": "We also found that the only emergency egress from the tram was by smashing the front or rear windscreens, and that emergency lighting had failed when the tram overturned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27d90955-492a-3334-b53f-f103092318ab",
                                        "entry_id": "e09a36bd-8e6a-3b87-8be6-a918d71745bd",
                                        "glosses": [
                                            "To be destroyed by being smashed."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e084935-5e59-4cef-8cfd-947a96899743",
                                                "sense_id": "27d90955-492a-3334-b53f-f103092318ab",
                                                "text": "The crockery smashed as it hit the floor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "212152ec-9423-3332-a8a0-0c0fe8fbeaa8",
                                        "entry_id": "e09a36bd-8e6a-3b87-8be6-a918d71745bd",
                                        "glosses": [
                                            "To hit extremely hard."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e26e2a56-03e1-41ef-bc2a-c61c7b65b8dd",
                                                "sense_id": "212152ec-9423-3332-a8a0-0c0fe8fbeaa8",
                                                "text": "He smashed his head against the table."
                                            },
                                            {
                                                "example_id": "ee6f912c-c752-43d4-8207-b60d09446b2e",
                                                "sense_id": "212152ec-9423-3332-a8a0-0c0fe8fbeaa8",
                                                "text": "Bonds smashed the ball 467 feet, the second longest home run in the history of the park."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ccf68cc-0dbb-3702-b885-611988262941",
                                        "entry_id": "e09a36bd-8e6a-3b87-8be6-a918d71745bd",
                                        "glosses": [
                                            "To ruin completely and suddenly."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a895f05a-6b96-4c19-a9f1-c20b4320bb50",
                                                "sense_id": "2ccf68cc-0dbb-3702-b885-611988262941",
                                                "text": "The news smashed any hopes of a reunion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e93ccad-c24d-3c23-950e-1b151231d9fb",
                                        "entry_id": "e09a36bd-8e6a-3b87-8be6-a918d71745bd",
                                        "glosses": [
                                            "To defeat overwhelmingly; to gain a comprehensive success over."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d833a409-758a-4b9b-a9ad-8b74ef24ea90",
                                                "sense_id": "1e93ccad-c24d-3c23-950e-1b151231d9fb",
                                                "text": "The Indians smashed the Yankees 22-0."
                                            },
                                            {
                                                "example_id": "cabc2fdc-b5ee-4555-880b-ec205c30aa61",
                                                "sense_id": "1e93ccad-c24d-3c23-950e-1b151231d9fb",
                                                "text": "I really smashed that English exam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2c28afc-8a61-3a9e-ba24-dd9f8b312919",
                                        "entry_id": "e09a36bd-8e6a-3b87-8be6-a918d71745bd",
                                        "glosses": [
                                            "To deform through continuous pressure."
                                        ],
                                        "tags": [
                                            "US",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c693a5ca-d032-47c8-b1a4-fedc700ec957",
                                                "sense_id": "f2c28afc-8a61-3a9e-ba24-dd9f8b312919",
                                                "text": "I slowly smashed the modeling clay flat with the palm of my hand."
                                            },
                                            {
                                                "example_id": "e7694e74-fab7-42e6-9d08-3daa799d1ff1",
                                                "sense_id": "f2c28afc-8a61-3a9e-ba24-dd9f8b312919",
                                                "text": "Using a fork, smash the avocado with all the remaining ingredients."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f0967e5-6947-3832-b444-89fc8343dade",
                                        "entry_id": "e09a36bd-8e6a-3b87-8be6-a918d71745bd",
                                        "glosses": [
                                            "To have sex with."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bc74913-f9a8-4f90-a880-d33d60eed00f",
                                                "sense_id": "7f0967e5-6947-3832-b444-89fc8343dade",
                                                "text": "In a leaked video, Keys also asked pundit Jamie Redknapp of an ex girlfriend: “Did you smash it?”"
                                            },
                                            {
                                                "example_id": "b151a9af-a3b3-4e0d-8bf9-5ef2d67ba416",
                                                "sense_id": "7f0967e5-6947-3832-b444-89fc8343dade",
                                                "text": "Would you smash her?"
                                            },
                                            {
                                                "example_id": "6ab23469-d3b1-4e6d-bddf-84e491fe71ca",
                                                "sense_id": "7f0967e5-6947-3832-b444-89fc8343dade",
                                                "text": "Farmersonly.com. A website that begs the question, what kind of bitch only smashes with farmers?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce77dde1-9937-384d-a741-e9da49a8f43c",
                                        "entry_id": "e09a36bd-8e6a-3b87-8be6-a918d71745bd",
                                        "glosses": [
                                            "Synonym of go to smash (“to go to ruin; to fail disastrously”)."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c83b773d-e7d1-434a-aef5-b36587653dc4",
                                                "sense_id": "ce77dde1-9937-384d-a741-e9da49a8f43c",
                                                "text": "\"What would have become of the gems had the bank smashed?\" asked Marie in a timid and rather tearful voice, for it was a terrible thought to think that her dreams might dissolve into thin air."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87a59af9-0e89-3d72-b8dd-4412fb5cc568",
                                        "entry_id": "e09a36bd-8e6a-3b87-8be6-a918d71745bd",
                                        "glosses": [
                                            "To pass counterfeit money."
                                        ],
