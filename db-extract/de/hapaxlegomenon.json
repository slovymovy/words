                "senses": [
                    {
                        "sense_id": "be615809-a8fe-39fd-bbc0-02360089b4bf",
                        "entry_id": "e2d129c0-e8fc-393d-b291-8ad54407b73f",
                        "glosses": [
                            "Wort, das (in einem bestimmten Textkorpus) nur einmal vorkommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "410b5167-4654-43ae-858f-b461b8e8b27e",
                                "sense_id": "be615809-a8fe-39fd-bbc0-02360089b4bf",
                                "text": "„Dazu gehören die Wörter, die in der Überlieferung nur einmal belegt sind - ein solches Wort nennt man Hapax legomenon oder kurz Hapax (das heißt »einmal gesagt«).“"
                            },
                            {
                                "example_id": "d8230389-22ac-4a0f-be34-77b48ab04b3f",
                                "sense_id": "be615809-a8fe-39fd-bbc0-02360089b4bf",
                                "text": "„Solche sogenannten Hapaxlegomena sind etwa sonntägig statt sonntäglich, …“"
                            },
                            {
                                "example_id": "244599a1-0709-4f17-af60-4c818ad77660",
                                "sense_id": "be615809-a8fe-39fd-bbc0-02360089b4bf",
                                "text": "„Fast zwei Drittel der Lemmata haben den Status von Hapaxlegomena.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b29bcc2e-013a-4d8a-89df-895d46129dc9",
                        "source_entry_id": "e2d129c0-e8fc-393d-b291-8ad54407b73f",
                        "source_sense_id": "be615809-a8fe-39fd-bbc0-02360089b4bf",
                        "source_sense_description": "Linguistik: Wort, das (in einem bestimmten Textkorpus) nur einmal vorkommt",
                        "target_lang_word": "hapax legomenon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hapax legomenon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f1925780-20dc-3a5e-b1d4-805f777c0fb6",
                                        "entry_id": "c5c58666-d05d-3e28-a546-2334628c52bd",
                                        "glosses": [
                                            "A word occurring only once in a given corpus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "466b7e44-b1cf-41d3-b800-c47d1e4baf50",
                                                "sense_id": "f1925780-20dc-3a5e-b1d4-805f777c0fb6",
                                                "text": "άγνως is a New Testament hapax legomenon. άγνός occurs two other times in Paul, both occurrences are in 2 Cor."
                                            },
                                            {
                                                "example_id": "06fb3091-db1c-4146-af5f-6807703350f1",
                                                "sense_id": "f1925780-20dc-3a5e-b1d4-805f777c0fb6",
                                                "text": "There is a lovely technical term for a word that appears once in a body of text: a hapax legomenon (plural: hapax legomena), Greek for “once said.” The term comes from philology, the study of old texts."
                                            },
                                            {
                                                "example_id": "7f490a12-7dcc-4eea-8bec-bd4dc9f9cd27",
                                                "sense_id": "f1925780-20dc-3a5e-b1d4-805f777c0fb6",
                                                "text": "In our case this means that πρωτοβαθρέω is an absolute hapax legomenon, if one assumes that the occurrences of βάθρον in Isa and διαβάθρη in Sam II are the result of corruptions."
                                            },
                                            {
                                                "example_id": "ad661fef-c444-4853-96fe-e0ef93e3c96b",
                                                "sense_id": "f1925780-20dc-3a5e-b1d4-805f777c0fb6",
                                                "text": "The research discovered 510 different terms. Of these 164 (approximately 32%) were hapax legomena (i.e., there was only once instance in the data), while 107 (approximately 21%) were attested by 10 or more citations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
