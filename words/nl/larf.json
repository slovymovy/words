                    "semantic_group_id": "insecten_ontwikkeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In veel informele teksten gebruikt men de vorm <w>larf</w> in plaats van het officiële larve.",
                            "target_lang_translations": {
                                "en": "In many informal texts, the form <w>larf</w> is used instead of the official 'larve'."
