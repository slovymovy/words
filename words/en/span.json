                                "target_lang_word": "промежуток",
                                "target_lang_sense_clarification": "отрезок времени"
                            },
                            {
                                "target_lang_word": "период",
                                "target_lang_sense_clarification": "длительность"
                            },
                            {
                                "target_lang_word": "интервал",
                                "target_lang_sense_clarification": "временной"
                            }
                        ],
                        "zh": [
