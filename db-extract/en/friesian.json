                        "glosses": [
                            "Of or relating to the work of Swedish mycologist and botanist Elias Magnus Fries, who described and assigned botanical names to hundreds of fungus and lichen species."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91a430db-ce82-483a-bbc5-ce052eecd659",
                                "sense_id": "15451810-fe5f-3f8a-81ae-ed14c5873819",
                                "text": "For a hundred years, treatment of the basidiomycetes, which include so many of the larger fungi, has been dominated by the Friesian approach which had—and still has—the attraction of differentiating fungi into groups mainly on field characters."
                            }
                        ]
