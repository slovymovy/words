                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29ea9a80-b704-41f5-9447-fb3847e47eae",
                                "sense_id": "4fdc782e-1565-352f-8c0f-c46d79263aa2",
                                "text": "„Da fiel mir auch ein, dass Ike Naller letzten Herbst gestorben ist, als einer von seinen Pflugeseln ihm den Schädel eingetreten hatt’, und wie vor Kurzem die Rumtreiber bei Osborn erzählt haben, als ich hin bin, um ’n bisschen Waltran zu kaufen, dass Prudence Naher die schicke Scheune verkaufen wollt.“"
                            },
                            {
                                "example_id": "2952aee6-ecb6-494a-a1aa-82bfa2085e3f",
                                "sense_id": "4fdc782e-1565-352f-8c0f-c46d79263aa2",
                                "text": "„Zu Großvaters Zeit wurde Waltran hergebracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
