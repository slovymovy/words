                                "target_senses": [
                                    {
                                        "sense_id": "6efc315c-9155-35e6-98a3-e5b455cc7d29",
                                        "entry_id": "c16a1727-5788-3cbf-8caa-b73374a39fbc",
                                        "glosses": [
                                            "A term that denotes the whole of which another term's referent is a part."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4573fa0-490b-46e7-ab65-c99c4b97a2f0",
                                                "sense_id": "6efc315c-9155-35e6-98a3-e5b455cc7d29",
                                                "text": "The word \"face\" is a holonym of the word \"eye\", which is a holonym of the word \"retina\"."
                                            },
                                            {
                                                "example_id": "4ec39d69-f379-4faf-90b7-595ae5c3c656",
                                                "sense_id": "6efc315c-9155-35e6-98a3-e5b455cc7d29",
                                                "text": "Holonyms: semantic network, wordnet, thesaurus"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "422264e6-fdaf-4aa3-ae95-c2dc5ef9a195",
                        "source_entry_id": "92962991-d092-35df-b297-0f03518db01a",
                        "source_sense_id": "4194c497-94fd-3bd6-99c5-f43874caf617",
                        "source_sense_description": "Ausdruck, der zu einem anderen Ausdruck in der Relation „ist Ganzes von“ steht",
                        "target_lang_word": "holonyme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "holonyme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e694660f-94ff-3898-af9f-683c496c0d65",
                                        "entry_id": "c9cd3b84-ce9a-357c-b9ac-07d6062b4f9e",
                                        "glosses": [
                                            "Terme lié à un autre de la même langue par une relation d’holonymie, c’est-à-dire de tout à partie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4a0d4ff-614f-4549-a976-701057efdbe0",
                                                "sense_id": "e694660f-94ff-3898-af9f-683c496c0d65",
                                                "text": "Un holonyme A d’un mot B est un mot dont le signifié désigne un ensemble comprenant le signifié de B."
                                            },
                                            {
                                                "example_id": "4c9442fe-f90f-43fd-9a60-3f2da4cd5566",
                                                "sense_id": "e694660f-94ff-3898-af9f-683c496c0d65",
                                                "text": "Corps est un holonyme de bras, de même que maison est un holonyme de toit."
                                            },
                                            {
                                                "example_id": "e65c7289-7790-4679-942f-64c9f8b818a0",
                                                "sense_id": "e694660f-94ff-3898-af9f-683c496c0d65",
                                                "text": "Par exemple, doigt est le méronyme de main qui est son holonyme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
