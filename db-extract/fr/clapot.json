            {
                "entry_id": "bb74067a-340a-3e97-9729-a59cdc4faf8c",
                "word": "clapot",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "85176c24-09df-499a-867e-816d477ebd52",
                        "entry_id": "bb74067a-340a-3e97-9729-a59cdc4faf8c",
                        "tags": [
                            "plural"
                        ],
                        "form": "clapots"
                    },
                    {
                        "form_id": "c7a3a147-8811-47be-96f5-9126440df366",
                        "entry_id": "bb74067a-340a-3e97-9729-a59cdc4faf8c",
                        "tags": [
                            "sens 2 machine à laver"
                        ],
                        "form": "clapeau"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "181a8c15-50ed-395e-b13d-73fc975175fd",
                        "entry_id": "bb74067a-340a-3e97-9729-a59cdc4faf8c",
                        "glosses": [
                            "Système de vagues désordonnées et à courte longueur d'onde, résultant de la rencontre de courants marins (clapotis) et de l'action de vents locaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cee70d4b-3837-452f-9834-7793a52e0f07",
                                "sense_id": "181a8c15-50ed-395e-b13d-73fc975175fd",
                                "text": "Avec son étrave très élancée, ses lignes longues et étroites, il passe dans le clapot sans ralentir."
                            },
                            {
                                "example_id": "74575c5f-f4cc-4499-94c8-c28fc9ea5a6c",
                                "sense_id": "181a8c15-50ed-395e-b13d-73fc975175fd",
                                "text": "Une carène puissante qui passe bien dans le clapot et glisse facilement au portant, un cockpit agréable en solitaire comme en équipage, un gréement bien dimensionné."
                            },
                            {
                                "example_id": "acd02771-e8df-4e82-b43b-947a63b825a0",
                                "sense_id": "181a8c15-50ed-395e-b13d-73fc975175fd",
                                "text": "Il en résulte un meilleur contrôle de la planche par temps de rafales et dans les clapots."
                            },
                            {
                                "example_id": "29cbd710-ac90-463f-872d-04005b3f59e2",
                                "sense_id": "181a8c15-50ed-395e-b13d-73fc975175fd",
                                "text": "De très légers souffles montaient du clapot rare, je sentais ma jupe se soulever contre mes mollets, retomber sans élan."
                            },
                            {
                                "example_id": "b098bf90-76a9-4b70-8547-6788999a4bbf",
                                "sense_id": "181a8c15-50ed-395e-b13d-73fc975175fd",
                                "text": "Le temps était radieux, la mer ce jour-là presque dépourvue de clapot, alors que les plages de la Méditerranée orientale sont réputées être un paradis pour surfeurs."
                            },
                            {
                                "example_id": "38e663da-6e5f-4cba-97e0-f80e5cd3a9cf",
                                "sense_id": "181a8c15-50ed-395e-b13d-73fc975175fd",
                                "text": "Sur le clapot des eaux sombres de l'Yonne, le ciel plombé créait des ondes oscillant entre le gris et le noirâtre, […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c4365b5-ad57-3933-ac24-1c5cf33d2d14",
                        "entry_id": "bb74067a-340a-3e97-9729-a59cdc4faf8c",
                        "glosses": [
                            "Machine à laver les tissus destinés à la teinture, composée de deux cylindres entre lesquels passe le tissu."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
