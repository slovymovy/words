{
    "word_family": [],
    "entries": [
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "04a9ba61-3e13-3c71-b40b-b6806eef443a",
                    "sense_definition": "geeft een tegenstelling aan tussen twee zinnen of zinsdelen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tegenstelling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ofschoon</w> ik hard reed, haalde een snelle auto mij toch in.",
                            "target_lang_translations": {
                                "en": "<w>Although</w> I was driving fast, a quick car still overtook me."
                            }
                        },
                        {
                            "text": "Hij besloot te gaan wandelen <w>ofschoon</w> het hard regende.",
                            "target_lang_translations": {
                                "en": "He decided to go for a walk <w>even though</w> it was raining hard."
                            }
                        }
                    ],
                    "synonyms": [
                        "ook al",
                        "alhoewel",
                        "hoewel"
                    ],
                    "common_phrases": [
                        "ofschoon het regende"
                    ],
                    "target_lang_definitions": {
                        "en": "indicates a contrast between two sentences or clauses"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "although",
                                "target_lang_sense_clarification": "introducing a concessive clause"
                            },
                            {
                                "target_lang_word": "though",
                                "target_lang_sense_clarification": "despite the fact that"
                            },
                            {
                                "target_lang_word": "even though",
                                "target_lang_sense_clarification": "stronger contrast"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2ff2779-e3aa-3b3b-9408-aa4ee598051c",
                    "sense_definition": "drukt een reden uit ondanks dewelke iets beweerd wordt",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tegenstelling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ofschoon</w> een bescheiden budgetoverschrijding onvermijdelijk is geweest, bleven de investeringen binnen de kaders.",
                            "target_lang_translations": {
                                "en": "<w>Although</w> a modest budget overrun was unavoidable, the investments remained within the framework."
                            }
                        },
                        {
                            "text": "De resultaten waren positief <w>ofschoon</w> de omstandigheden verre van ideaal waren.",
                            "target_lang_translations": {
                                "en": "The results were positive <w>though</w> the circumstances were far from ideal."
                            }
                        }
                    ],
                    "synonyms": [
                        "hoewel",
                        "alhoewel"
                    ],
                    "common_phrases": [
                        "ofschoon onvermijdelijk"
                    ],
                    "target_lang_definitions": {
                        "en": "expresses a reason despite which something is stated or remains true"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "although",
                                "target_lang_sense_clarification": "in spite of the fact that"
                            },
                            {
                                "target_lang_word": "though",
                                "target_lang_sense_clarification": "concessive reason"
                            },
                            {
                                "target_lang_word": "albeit",
                                "target_lang_sense_clarification": "formal, even though"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}