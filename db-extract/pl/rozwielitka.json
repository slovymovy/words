                        "entry_id": "5fb3b749-4beb-339b-86c5-2a88fc2f1806",
                        "glosses": [
                            "organizm planktonowy z rzędu wioślarek (Cladocera), podgromady liścionogów (Phyllopoda)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c36a453-b258-420f-9934-68f4e5c6ff90",
                                "sense_id": "a73ae28c-4bbc-3a4d-9243-1fd7784a54c6",
                                "text": "Głównymi filtratorami w zooplanktonie są wioślarki – rozwielitki i słoniczki."
                            },
                            {
                                "example_id": "f07c8a7d-25b6-4837-b1e7-a2dc7c684ea7",
                                "sense_id": "a73ae28c-4bbc-3a4d-9243-1fd7784a54c6",
                                "text": "Suszonych rozwielitek używam jako karmy dla ryb akwariowych."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
