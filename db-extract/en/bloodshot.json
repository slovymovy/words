                        "sense_id": "6779c654-6510-3c11-8424-9081ed00765c",
                        "entry_id": "03830346-caf6-3b87-a044-fb5e60d359a9",
                        "glosses": [
                            "Reddened and inflamed because of congested blood vessels."
                        ],
                        "tags": [
                            "of the eyes"
                        ],
                        "examples": [
                            {
                                "example_id": "7d4f9586-ceac-4326-9f6c-de30bb04a5e8",
                                "sense_id": "6779c654-6510-3c11-8424-9081ed00765c",
                                "text": "She said she was perfectly fine but I could tell she was tired; her eyes were all bloodshot."
                            },
                            {
                                "example_id": "279fa9c1-0465-4a5a-853a-149d7231b1aa",
                                "sense_id": "6779c654-6510-3c11-8424-9081ed00765c",
                                "text": "Her back was toward the jungle, and so she did not see the grasses part, or the savage face that peered from between. Little, bloodshot, close-set eyes scanned her intently, roving from time to time about the open beach for indications of the presence of others than herself."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d988663e-92bf-4861-9b67-2ace50459e34",
                        "source_entry_id": "03830346-caf6-3b87-a044-fb5e60d359a9",
                        "source_sense_id": "6779c654-6510-3c11-8424-9081ed00765c",
