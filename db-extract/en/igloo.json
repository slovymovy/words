                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bd7481d-568c-4945-b312-2e4339b13b9a",
                                                "sense_id": "99d1e121-ae1a-3970-8ede-4e4dcf05f574",
                                                "text": "Das Iglu hat riesige Vorteile gegenüber der Zeltunterkunft."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6cd12304-caed-323d-9fdb-16f7e8e0ff75",
                                        "entry_id": "03e58047-e9b4-302d-88c6-6a002429dc06",
                                        "glosses": [
                                            "aus Schneeblöcken errichtetes halbkugelförmiges Haus der Eskimos"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07208709-4dc1-488a-b096-2a16c9975c6b",
                                                "sense_id": "6cd12304-caed-323d-9fdb-16f7e8e0ff75",
                                                "text": "Schon seit 4000 Jahren beherrschen die Eskimos die Kunst, einen Iglu zu bauen."
                                            },
                                            {
                                                "example_id": "22802df8-181e-49c5-85ad-d7b2a7c8fb7c",
                                                "sense_id": "6cd12304-caed-323d-9fdb-16f7e8e0ff75",
                                                "text": "„Auch die Schlafräume im Konvikt hatten grönländischen Iglus geglichen; dazu Sport in arktischer Kälte; das probate Mittel zur Dämpfung unzüchtiger Gedanken und Gefühle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "aef26528-1881-3d30-9cbe-6e7b40919b60",
                                        "entry_id": "03e58047-e9b4-302d-88c6-6a002429dc06",
                                        "glosses": [
                                            "in Nordkanada: Winterwohnung, Reiseunterkunft, Jagdunterkunft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1524312-61b0-4024-abc5-def20915e4e2",
                                                "sense_id": "aef26528-1881-3d30-9cbe-6e7b40919b60",
                                                "text": "Die in kleinen Gruppen zerstreut lebenden Indianer bewohnten entgegen der allgemeinen Meinung nur während der Jagd und auf Reisen Iglu genannte Schneehütten."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
