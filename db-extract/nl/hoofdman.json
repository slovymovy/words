                                "target_senses": [
                                    {
                                        "sense_id": "a6dcd4fb-97ab-36d7-a101-ab10711531aa",
                                        "entry_id": "27d23b55-2361-3304-aacd-dbded6976cd3",
                                        "glosses": [
                                            "Offiziersdienstgrad über dem Oberleutnant"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1ee52ba-19c7-481f-a3c4-5ef7fa9e8f6e",
                                                "sense_id": "a6dcd4fb-97ab-36d7-a101-ab10711531aa",
                                                "text": "Er wurde zum Hauptmann ernannt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "735dad80-e58d-3afc-b7bb-3e21546529b3",
                                        "entry_id": "27d23b55-2361-3304-aacd-dbded6976cd3",
                                        "glosses": [
                                            "Offiziersdienstgrad über dem Oberleutnant",
                                            "unter dem Stabshauptmann"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "e3023d1c-1203-39e8-9d4b-9decf611976e",
                                        "entry_id": "27d23b55-2361-3304-aacd-dbded6976cd3",
                                        "glosses": [
                                            "Offiziersdienstgrad über dem Oberleutnant",
                                            "unter dem Major"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "a6b9e339-f7a2-3497-ae68-bca5bdc02376",
                                        "entry_id": "27d23b55-2361-3304-aacd-dbded6976cd3",
                                        "glosses": [
                                            "Offiziersdienstgrad über dem Oberleutnant",
                                            "Übersetzung für Dienstgrade fremdländischer Streitkräfte wie z.B. captain"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74bdd53b-d3f4-492d-a805-ba4080840f23",
                                                "sense_id": "a6b9e339-f7a2-3497-ae68-bca5bdc02376",
                                                "text": "„Es kam ihm vor, als ginge der amerikanische Hauptmann hastig über diesen Hinweis hinweg.“"
                                            },
                                            {
                                                "example_id": "c0d1e503-78d2-4966-8624-4c7ca053de25",
                                                "sense_id": "a6b9e339-f7a2-3497-ae68-bca5bdc02376",
                                                "text": "„Ein Onkel von ihm war Hauptmann der Artillerie und damals auf Governors Island stationiert, und bei ihm suchten wir Rat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1c\""
                                    },
                                    {
                                        "sense_id": "a59c5367-d7ef-30b8-8f40-a1b37c2d2fa2",
                                        "entry_id": "27d23b55-2361-3304-aacd-dbded6976cd3",
                                        "glosses": [
                                            "Offizier im Range eines Hauptmanns, im weiteren Sinne auch der Stabshauptmann als Teil der Laufbahngruppe der Hauptleute"
                                        ],
                                        "tags": [
                                            "Heer",
                                            "Luftwaffe"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42270de8-4252-474a-8e40-397a07f1a9d3",
                                                "sense_id": "a59c5367-d7ef-30b8-8f40-a1b37c2d2fa2",
                                                "text": "„Der Hauptmann beklagte sich, daß er die Nacht auf Stroh schlafen mußte.“"
                                            },
                                            {
                                                "example_id": "610b9e2c-4b99-40ce-998d-58739def8502",
                                                "sense_id": "a59c5367-d7ef-30b8-8f40-a1b37c2d2fa2",
                                                "text": "„Ein Major und zwei Hauptleute kamen an ihnen vorbei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b73ec3f0-c2f7-3dbd-a4c4-6a2eaad13830",
                                        "entry_id": "27d23b55-2361-3304-aacd-dbded6976cd3",
                                        "glosses": [
                                            "Anführer einer Truppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2843b770-0d43-4586-83da-d943d2bcf5e9",
                                                "sense_id": "b73ec3f0-c2f7-3dbd-a4c4-6a2eaad13830",
                                                "text": "Der Hauptmann befahl, ein Lager zu errichten."
                                            },
                                            {
                                                "example_id": "323f3b2c-6e08-4668-bc3e-f72cb99e1aa6",
                                                "sense_id": "b73ec3f0-c2f7-3dbd-a4c4-6a2eaad13830",
                                                "text": "„Weitere Instanzen auf Fähnleinebene sind der Hauptmann und sein Leutinger (Stellvertreter), der Feldweibel und das Spiel, bestehend aus einem Trommler und einem Pfeifer.“"
                                            },
                                            {
                                                "example_id": "853d11b6-816d-4595-907e-682e24288912",
                                                "sense_id": "b73ec3f0-c2f7-3dbd-a4c4-6a2eaad13830",
                                                "text": "„Des Morgens gab es großes Gedränge am Postschalter, und die Vorsteherin wäre nicht zu Rande gekommen ohne den Hauptmann, der ihr zuweilen half.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "31cf7c41-2a87-33ce-809c-3463d978feed",
                                        "entry_id": "27d23b55-2361-3304-aacd-dbded6976cd3",
                                        "glosses": [
                                            "Oberster einer Vereinigung"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "473f431d-a053-47d0-a811-d0f960ae9f4b",
                        "source_entry_id": "5ff21966-a136-3b66-aa95-adbc9ee433be",
