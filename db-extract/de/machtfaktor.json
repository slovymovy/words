                                "example_id": "b72346b5-dd1a-4b1a-9e48-eca272139e91",
                                "sense_id": "42bbd287-fe38-39d2-8684-c68029bef6b3",
                                "text": "„Das maronitische Netzwerk der CIA bildete einen Machtfaktor im Libanon.“"
                            },
                            {
                                "example_id": "19139531-9a41-4aa7-8069-248d820b559a",
                                "sense_id": "42bbd287-fe38-39d2-8684-c68029bef6b3",
                                "text": "„Groener seinerseits würde alles tun, um von der alten Armee zu retten, was zu retten war, und Zeit zu gewinnen, damit sie sich in der deutschen Nachkriegsgesellschaft als Machtfaktor etablieren konnte.“"
                            }
