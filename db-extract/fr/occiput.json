                    {
                        "translation_id": "13ed5094-d607-4a71-972d-53543239fe18",
                        "source_entry_id": "7c2ec7fc-4d8f-318a-bc39-6352f5ebac03",
                        "target_lang_word": "затылок",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "затылок",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d535ecee-d569-330d-a6c4-072d886066f6",
                                        "entry_id": "e6c189db-90c3-3425-a44e-8696a86fbfa2",
                                        "glosses": [
                                            "задняя, выдавшаяся назад часть головы у человека и у животных, над самой шеей или загривком, под теменем"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1d395ff-36cc-4fd3-a93c-a110bfc5366d",
                                                "sense_id": "d535ecee-d569-330d-a6c4-072d886066f6",
                                                "text": "Волосы у него на затылке были с проседью."
                                            },
                                            {
                                                "example_id": "f42bb756-2781-491c-aecf-cf4747d0ab1b",
                                                "sense_id": "d535ecee-d569-330d-a6c4-072d886066f6",
                                                "text": "— Где тебе ездить на моём коне? На первых трёх шагах он тебя сбросит, и ты разобьёшь себе затылок об камни."
                                            },
                                            {
                                                "example_id": "bc2e6642-aca7-483a-ad95-85785cd0f5a5",
                                                "sense_id": "d535ecee-d569-330d-a6c4-072d886066f6",
                                                "text": "Мохнатая баранья шапка съехала ему на затылок."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "затылок",
                                "target_lang_code": "ru",
