                "senses": [
                    {
                        "sense_id": "52582e5e-e938-35af-8d27-cd2accd519c7",
                        "entry_id": "ec49f62f-6a46-37b4-b0f1-cd24255d361c",
                        "glosses": [
                            "Gift, das über die Haut aufgenommen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eac96192-29c4-4b80-bc02-19de5545a6d4",
                                "sense_id": "52582e5e-e938-35af-8d27-cd2accd519c7",
                                "text": "„Er nahm unbedacht Blumen und Briefe entgegen, machte sich um Bomben und Kontaktgifte keine Gedanken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "38573915-3c4e-30a3-b893-c2cece4ba72e",
                        "entry_id": "ec49f62f-6a46-37b4-b0f1-cd24255d361c",
                        "glosses": [
                            "Stoff, der die Wirkweise eines Katalysators behindert oder aufhebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f03899e-ad78-4b70-bfe6-fd90e5e2ed01",
                                "sense_id": "38573915-3c4e-30a3-b893-c2cece4ba72e",
                                "text": "„Man muß sich die Ursache der Vergiftung bei der heterogenen Katalyse so erklären, daß entweder das Kontaktgift mit dem Katalysator eine katalytisch unwirksame chemische Verbindung eingeht oder daß der Giftstoff vom Kontakt bevorzugt adsorbiert wird und somit dessen aktive Zentren blockiert sind.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
