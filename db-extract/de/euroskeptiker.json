                        "glosses": [
                            "Person, die der europäischen Integration gegenüber skeptisch eingestellt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f49c8f4f-fb5f-4c23-a1c2-1c712871ce3d",
                                "sense_id": "f06bda0c-b750-3119-b5ba-04d7cc5207b0",
                                "text": "Die Eurokrise ist Wasser auf die Mühlen der Euroskeptiker."
                            },
                            {
                                "example_id": "b460eb79-a7bd-45ae-a811-8fad2fd74000",
                                "sense_id": "f06bda0c-b750-3119-b5ba-04d7cc5207b0",
                                "text": "„Der Politologe Simon Hix stellt fest, dass die Euroskeptiker ihre Strategie verändern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
