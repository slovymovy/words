                    "sense_id": "9c6a1fdc-760a-3cf9-91e1-46ab94204812",
                    "sense_definition": "A severe mental disorder characterized by a loss of contact with reality and a distorted personality.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mental_health",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient suffered from a severe <w>psychosis</w> that made it difficult to distinguish between dreams and reality.",
                            "target_lang_translations": {
                                "zh": "这位病人患有严重的<w>精神病</w>，导致他难以区分梦境与现实。"
                            }
                        },
                        {
                            "text": "Long-term substance abuse can sometimes trigger a <w>psychosis</w> in vulnerable individuals.",
                            "target_lang_translations": {
                                "zh": "长期滥用药物有时会在易感人群中诱发<w>精神错乱</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "madness",
                        "insanity"
                    ],
                    "common_phrases": [
                        "acute psychosis",
                        "drug-induced psychosis"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种严重的精神障碍，其特征是与现实脱节以及人格扭曲。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "精神病",
                                "target_lang_sense_clarification": "指严重的精神失常，导致患者无法区分现实与幻觉。"
                            },
                            {
                                "target_lang_word": "精神错乱",
                                "target_lang_sense_clarification": "指思维、情感或行为出现严重混乱的状态。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
