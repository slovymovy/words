                        ],
                        "examples": [
                            {
                                "example_id": "7e71658a-4cc5-4bc0-ae17-a7221339ecfd",
                                "sense_id": "5cc314fb-b802-369a-b8a4-8958e7804417",
                                "text": "Une personne nous a dit que si nous ne mettions pas d'isolant au sol il fallait mettre un polyane sur toute la surface du garage pour que l'humidité ne passe pas et pour éviter que les carrelages ne se décollent plus tard."
                            }
