                "senses": [
                    {
                        "sense_id": "39ac7ec2-61f5-38bc-a9cd-e9ea3f6661e6",
                        "entry_id": "2148b47c-c150-30e9-a3f4-a7cec11e1508",
                        "glosses": [
                            "jemand, der Opfer einer Vergewaltigung wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99274e53-9030-47d6-9199-039deac4fb50",
                                "sense_id": "39ac7ec2-61f5-38bc-a9cd-e9ea3f6661e6",
                                "text": "Die Polizei versuchte die Identität des Vergewaltigungsopfers festzustellen."
                            },
                            {
                                "example_id": "cd218f47-6525-49a8-bbe8-cdd51265b0dd",
                                "sense_id": "39ac7ec2-61f5-38bc-a9cd-e9ea3f6661e6",
                                "text": "„Historiker gehen heute von insgesamt zwei Millionen deutschen Vergewaltigungsopfern aus.“"
                            },
                            {
                                "example_id": "3aa59ce0-b17f-4feb-816a-0388944726be",
                                "sense_id": "39ac7ec2-61f5-38bc-a9cd-e9ea3f6661e6",
                                "text": "„Sie hatte einen bösen Traum und sah sich als Vergewaltigungsopfer verletzt in unserem Berliner Garten liegen.“"
                            },
                            {
                                "example_id": "97e623a7-0b48-45b6-be43-bfa06fb1f1ff",
                                "sense_id": "39ac7ec2-61f5-38bc-a9cd-e9ea3f6661e6",
                                "text": "„Nicht jedes Revier besitzt eine Notfallausrüstung für Vergewaltigungsopfer, aber ich weiß, dass solche Ausrüstungen existieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
