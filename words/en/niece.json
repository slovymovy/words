{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7758974e-d23d-333d-8c59-f101c248ccc8",
                    "sense_definition": "A daughter of one's sibling, brother-in-law, or sister-in-law.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "family_relations",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My <w>niece</w> just celebrated her fifteenth birthday with a big family party.",
                            "target_lang_translations": {
                                "ru": "Моя <w>племянница</w> только что отпраздновала свое пятнадцатилетие на большом семейном празднике.",
                                "zh": "我的<w>侄女</w>刚刚举办了一场盛大的家庭派对来庆祝她的十五岁生日。"
                            }
                        },
                        {
                            "text": "She bought a beautiful gift for her newborn <w>niece</w>.",
                            "target_lang_translations": {
                                "ru": "Она купила красивый подарок для своей новорожденной <w>племянницы</w>.",
                                "zh": "她为刚出生的<w>外甥女</w>买了一份精美的礼物。"
                            }
                        }
                    ],
                    "antonyms": [
                        "nephew"
                    ],
                    "common_phrases": [
                        "my niece",
                        "newborn niece"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дочь брата или сестры (а также брата или сестры супруга/супруги).",
                        "zh": "兄弟姐妹的女儿，或配偶的兄弟姐妹的女儿。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "племянница",
                                "target_lang_sense_clarification": "дочь брата или сестры"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "侄女",
                                "target_lang_sense_clarification": "兄弟的女儿"
                            },
                            {
                                "target_lang_word": "外甥女",
                                "target_lang_sense_clarification": "姐妹的女儿"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b91ad07a-15d2-3bd9-bc84-d4ce784994fe",
                    "sense_definition": "A daughter of one's cousin or cousin-in-law.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "family_relations",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In some cultures, the daughter of your cousin is also referred to as your <w>niece</w>.",
                            "target_lang_translations": {
                                "ru": "В некоторых культурах дочь двоюродного брата или сестры также называют <w>племянницей</w>.",
                                "zh": "在某些文化中，堂表兄弟姐妹的女儿也被称为<w>表侄女</w>。"
                            }
                        },
                        {
                            "text": "He invited his cousin's daughter, whom he considers his <w>niece</w>, to the wedding.",
                            "target_lang_translations": {
                                "ru": "Он пригласил на свадьбу дочь своего двоюродного брата, которую считает своей <w>племянницей</w>.",
                                "zh": "他邀请了堂姐的女儿参加婚礼，他一直把她当作自己的<w>侄女</w>看待。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дочь двоюродного брата или двоюродной сестры (двоюродная племянница).",
                        "zh": "堂表兄弟姐妹的女儿。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "двоюродная племянница",
                                "target_lang_sense_clarification": "дочь кузена или кузины"
                            },
                            {
                                "target_lang_word": "племянница",
                                "target_lang_sense_clarification": "в разговорной речи или широком смысле"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "堂侄女",
                                "target_lang_sense_clarification": "堂兄弟的女儿"
                            },
                            {
                                "target_lang_word": "表侄女",
                                "target_lang_sense_clarification": "表兄弟姐妹的女儿"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "ead7a13f-501d-3c5f-a988-266ca8b2ac94",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local directory lists a family named <w>Niece</w> living on the main street.",
                            "target_lang_translations": {
                                "ru": "В местном справочнике указана семья по фамилии <w>Нис</w>, живущая на главной улице.",
                                "zh": "当地名录显示有一户姓<w>尼斯</w>的人家住在主街上。"
                            }
                        },
                        {
                            "text": "We met a historian named Professor <w>Niece</w> during our trip to the archives.",
                            "target_lang_translations": {
                                "ru": "Во время нашей поездки в архивы мы встретили историка по фамилии профессор <w>Нис</w>.",
                                "zh": "在去档案馆的途中，我们遇到了一位名叫<w>尼斯</w>教授的历史学家。"
                            }
                        }
                    ],
                    "traits": [
                        {
