                                        "entry_id": "6e37fc32-340a-32f8-b3b6-8253f3b171ad",
                                        "glosses": [
                                            "A fur or sometimes wool hat traditionally worn by men throughout the Caucasus and Central Asia; its shape varies from hemispherical to cylindrical, which may be slightly tapered in either direction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf6ff0a7-3b91-41b3-b058-2124970194a9",
                                                "sense_id": "6c83859f-2093-354e-bb91-b12c244d0b00",
                                                "text": "Outside Russia, the Cossacks tend to be viewed as cartoonish anachronisms, with their whips, papakha fur hats and horses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
