                ],
                "senses": [
                    {
                        "sense_id": "5174ab20-c3a4-31e8-b49d-b4454edd8fd4",
                        "entry_id": "872c3bcd-7819-316b-8fba-c241a68a18d4",
                        "glosses": [
                            "sehr dünnes Rohr, das an einem Ende oft sehr spitz ist und mit dem man Flüssigkeiten unter die Haut, in ein Blutgefäß oder ein Gewebe einbringen und daraus entfernen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27c47699-280e-4d51-ba99-a864c7a3d500",
                                "sense_id": "5174ab20-c3a4-31e8-b49d-b4454edd8fd4",
                                "text": "„Eine weitere Möglichkeit der Behandlung [eines Ganglions] ist die Punktion. Dabei wird mit einer Hohlnadel die Gelenkflüssigkeit abgesaugt.“"
                            },
                            {
                                "example_id": "cad33e49-f821-46fe-b3a5-9012268a210a",
                                "sense_id": "5174ab20-c3a4-31e8-b49d-b4454edd8fd4",
                                "text": "„Bei der Untersuchung wird mit einer Hohlnadel eine Probe Fruchtwasser aus der Fruchtblase der Frau entnommen.“"
                            },
                            {
                                "example_id": "f79c7333-234e-4e53-8981-4df22122d74e",
                                "sense_id": "5174ab20-c3a4-31e8-b49d-b4454edd8fd4",
                                "text": "„Mit Hilfe von Hohlnadeln wird das auffällige Gewebe entnommen und anschließend vom Pathologen untersucht.“"
                            },
                            {
                                "example_id": "efd7dc71-05bd-4beb-a228-2bb5c7d2deb8",
                                "sense_id": "5174ab20-c3a4-31e8-b49d-b4454edd8fd4",
                                "text": "„Bei der Brachytherapie handelt es sich um einen minimalinvasiven Eingriff zur Behandlung von Prostatakrebs im Frühstadium. Bei dieser Methode werden zahlreiche reiskorngrosse, radioaktive Strahler (Seeds) über Hohlnadeln durch den Damm in der Prostata eingepflanzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
