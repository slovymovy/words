                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Warm air blew gently from the floor <w>register</w> near the window.",
                            "target_lang_translations": {
                                "ru": "Теплый воздух мягко дул из напольной <w>вентиляционной решетки</w> у окна.",
                                "zh": "暖风从窗户附近的地面<w>通风口</w>轻轻吹出。"
                            }
