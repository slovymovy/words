                    "semantic_group_id": "dlugosc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Autor przygotował <w>sążnisty</w> artykuł, który zajął niemal połowę całego wydania gazety.",
                            "target_lang_translations": {
                                "ru": "Автор подготовил <w>пространную</w> статью, которая заняла почти половину всего газетного выпуска."
                            }
                        },
                        {
                            "text": "Polityk wygłosił <w>sążnistą</w> mowę, chociaż większość słuchaczy wolałaby usłyszeć zwięzłe podsumowanie faktów.",
                            "target_lang_translations": {
                                "ru": "Политик произнёс <w>многословную</w> речь, хотя большинство слушателей предпочли бы услышать краткое изложение фактов."
