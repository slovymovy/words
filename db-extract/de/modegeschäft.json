                "senses": [
                    {
                        "sense_id": "913b8546-fef9-3b00-a07c-1788e2aa6c9c",
                        "entry_id": "b1b5b40d-4189-3f5a-9ee6-65a240aa721d",
                        "glosses": [
                            "Laden, in dem Kleidung verkauft wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e966cac-e010-4716-a3ec-d4f86d49201f",
                                "sense_id": "913b8546-fef9-3b00-a07c-1788e2aa6c9c",
                                "text": "„Der Priester drückt sich gegenüber in den Eingang eines Modegeschäfts, lässt die Walkingstöcke dort liegen und schleicht zurück.“"
                            },
                            {
                                "example_id": "bece4055-9947-4f69-9bf9-5cbc7929346c",
                                "sense_id": "913b8546-fef9-3b00-a07c-1788e2aa6c9c",
                                "text": "„Ich hatte schon oft vor Modegeschäften gestanden und mir Röcke und Pullover, Schuhe und Taschen angesehen und mir vorgestellt, wie ihr das alles stehen würde, aber ihr Vater hatte so strikte Vorstellungen von Geld, daß ich nie gewagt hätte, ihr etwas mitzubringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
