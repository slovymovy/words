                        ],
                        "examples": [
                            {
                                "example_id": "00bbd967-c2f6-4b8c-97ec-2afe16f899b3",
                                "sense_id": "c4f6a50b-b8cf-34cd-b69a-87b5b2649f1a",
                                "text": "„Nun kehrt das Material zurück in die Stuben und lässt wieder dieses typische Knarzgeräusch hören, das Rattanmöbel von sich geben, sobald man seinen Hintern darauf setzt.“"
                            },
                            {
                                "example_id": "709178a7-b7bb-4129-9054-3197df40240c",
                                "sense_id": "c4f6a50b-b8cf-34cd-b69a-87b5b2649f1a",
                                "text": "„Viel lernten sie bei einem Aufenthalt im javanischen Cirebon, der heute darbenden, einstigen Hauptstadt der Rattanmöbel.“"
                            }
                        ],
