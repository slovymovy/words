                        "sense_id": "6f823dc1-de5d-3340-ad49-8899f2641162",
                        "entry_id": "a4518ab7-c31a-32db-be06-73bb7b690f67",
                        "glosses": [
                            "patroon van klanken en andere hoorbare trillingen, gemaakt om bij de luisteraar een bepaalde indruk op te roepen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21686017-8cf1-44b9-bbb1-a3264ba7bf68",
                                "sense_id": "6f823dc1-de5d-3340-ad49-8899f2641162",
                                "text": "Als voorbeeld noemt hij het gebruik van ‘reverb’, een kaatsend geluidseffect."
                            },
                            {
                                "example_id": "3b0572b5-1d27-44d4-92e1-fdc0629f9442",
                                "sense_id": "6f823dc1-de5d-3340-ad49-8899f2641162",
                                "text": "Apocalypse Now gebruikte geluid realistisch, hyperrealistisch en surrealistisch, Murch’ liet geluid het meest ruimtelijk klinken door eerst naar mono terug te schakelen. Evenzo blijft het beste geluidseffect stilte, stelt Costin. Zoals Ben Burtt een ‘auditief zwarte gat’ gebruikte: voor een seismische knal liet hij een seconde absolute stilte vallen, alsof de film de adem inhoudt."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba9e0601-bf6e-3bdc-943a-b5d7b4cd9cb1",
                        "entry_id": "a4518ab7-c31a-32db-be06-73bb7b690f67",
                        "glosses": [
                            "veroorzaakte inbreuk op rust en stilte"
                        ],
                        "tags": [],
