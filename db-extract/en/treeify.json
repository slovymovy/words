                        "examples": [
                            {
                                "example_id": "551d10e8-a1da-4e2e-944a-0f1eb549320d",
                                "sense_id": "738f704f-d2fe-3c63-b6a1-9e8d80d6d2ed",
                                "text": "Now, Daphne — before she was happily treeified —\nOver all blossoms the lily had deified,"
                            },
                            {
                                "example_id": "82b57ff2-2d74-4639-86ce-265e8cef5352",
                                "sense_id": "738f704f-d2fe-3c63-b6a1-9e8d80d6d2ed",
                                "text": "1985: Lope de Vega (Spanish); Alan S. Trueblood & Edwin Honig (tr.), La Dorotea\nPyramus is now no suicide,\nnor are all Daphnes treeified\n(Ya no se mata Píramo,\nNi son las Dafnes árboles)"
                            },
                            {
                                "example_id": "cf3a2911-1926-4b5b-a4a1-087d8b0ee0f5",
                                "sense_id": "738f704f-d2fe-3c63-b6a1-9e8d80d6d2ed",
                                "text": "For being able to show it in the figure, this acyclic graph has been \"treeified\"."
                            }
                        ]
