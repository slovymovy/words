                        "sense_id": "e9e36d50-4b99-3b6b-9c36-1fbdff929a3c",
                        "entry_id": "dc4a885c-efb7-365c-be25-f21edba03e73",
                        "glosses": [
                            "издавна, с незапамятных времён"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "863ccbff-d6d2-4530-8610-d2cd4242c301",
                                "sense_id": "e9e36d50-4b99-3b6b-9c36-1fbdff929a3c",
                                "text": "По нему отец мой, и отец отца, и их предки испокон веков жили, ― говорю с деланой хрипотцой."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
