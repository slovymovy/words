                "senses": [
                    {
                        "sense_id": "10dc51ab-8ad1-3674-8586-370f077f0362",
                        "entry_id": "2f326101-d0a9-346c-bd8c-914ef686137e",
                        "glosses": [
                            "Techniker, der auf dem Gebiet der Elektrotechnik arbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5897a056-646c-427f-915b-ab4f35b4dea5",
                                "sense_id": "10dc51ab-8ad1-3674-8586-370f077f0362",
                                "text": "Ich interessiere mich für eine Weiterbildung zum Elektrotechniker."
                            },
                            {
                                "example_id": "9b084f42-0609-47c5-81b1-5bfe4d7fdfb0",
                                "sense_id": "10dc51ab-8ad1-3674-8586-370f077f0362",
                                "text": "Der Elektrotechniker ist eine gut ausgebildete Fachkraft im Bereich der Elektrik und Elektronik."
                            },
                            {
                                "example_id": "cdf6aee9-91f7-494d-bf80-88c9e15ae041",
                                "sense_id": "10dc51ab-8ad1-3674-8586-370f077f0362",
                                "text": "Elektrotechniker wird man über eine Ausbildung in einem elektrotechnischen Beruf und einer anschließenden Weiterqualifizierung zum staatlich geprüften Techniker für Elektrotechnik."
                            }
                        ],
