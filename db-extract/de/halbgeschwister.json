                "senses": [
                    {
                        "sense_id": "859d9344-b9ed-3ccc-ba59-d74d7fc4e695",
                        "entry_id": "2f6a13b9-d962-3a14-a677-69a291041a57",
                        "glosses": [
                            "Geschwister mit nur einem gemeinsamen Elternteil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8d3072a-d835-4b28-b76a-6b5c8d82da9e",
                                "sense_id": "859d9344-b9ed-3ccc-ba59-d74d7fc4e695",
                                "text": "„Für Sibylle, deren Mutter kurz nach ihrer Geburt gestorben und die in kühler Distanz zur Stiefmutter und den sechs jüngeren Halbgeschwistern geblieben war, wurde der Vater zum inneren Fixstern.“"
                            },
                            {
                                "example_id": "a1bacdc4-513f-469d-8b09-f6772544131f",
                                "sense_id": "859d9344-b9ed-3ccc-ba59-d74d7fc4e695",
                                "text": "„Tatsächlich hat dort fast jedes vierte Kind mindestens ein Halbgeschwister.“"
                            },
                            {
                                "example_id": "d22be0cb-166f-4e4d-bd7b-e4f1bf4110ef",
                                "sense_id": "859d9344-b9ed-3ccc-ba59-d74d7fc4e695",
                                "text": "„Robert sollte seine Halbgeschwister erst viel später kennenlernen, als er sich als junger Mann von 19 Jahren auf die Suche nach seinem Vater machte, den er tatsächlich aufspürte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
