                "senses": [
                    {
                        "sense_id": "05c98568-95f1-377a-914b-9e6c36a5fc2c",
                        "entry_id": "6b81058b-fd90-3d07-9ccf-ba09fa299288",
                        "glosses": [
                            "gedachter Bogen, der die Schneidekanten und Höcker der oberen Zähne miteinander verbindet und ventral (vorne) den Caput mandibulae (Gelenkkopf des Unterkiefers) (Kondylus) tangiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf10d6eb-4e25-4dd7-a9d3-3e93a89f46d9",
                                "sense_id": "05c98568-95f1-377a-914b-9e6c36a5fc2c",
                                "text": "Das Prinzip der Spee-Kurve besteht darin, die Kauflächen der im Hauptkraftfeld der Kaumuskeln befindlichen Molaren in eine für die Funktion günstige Stellung zu bringen."
                            },
                            {
                                "example_id": "31dd3655-cbbe-434e-8c2a-e0f2ff6bcb87",
                                "sense_id": "05c98568-95f1-377a-914b-9e6c36a5fc2c",
                                "text": "Die Spee-Kurve und die Gelenkbahnneigung sollten für eine balancierte Okklusion aufeinander abgestimmt sein."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
