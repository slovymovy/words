                        "glosses": [
                            "Person, die Opfer einer Straftat wurde, ohne dass der Täter dies im Voraus geplant hatte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "086a751c-5cf2-4f4e-bc7a-6f6154d262d4",
                                "sense_id": "b07163ec-1ed5-33f5-9be2-8a0f52af39fe",
                                "text": "„Genau wie Sophier schien er ein Zufallsopfer zu sein. Zur absolut falschen Zeit am absolut falschen Ort.“"
                            },
                            {
                                "example_id": "8e7c1c34-3111-48f4-bf05-d4605cb663e8",
                                "sense_id": "b07163ec-1ed5-33f5-9be2-8a0f52af39fe",
                                "text": "„Da sie ein Kind war, hatte sie keinen Einfluss auf ihr Leben und ihre Umgebung, und meiner Einschätzung nach war sie ein Zufallsopfer.“"
                            }
                        ],
