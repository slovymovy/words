                "senses": [
                    {
                        "sense_id": "df388276-62ad-3dcb-9e05-badc3dd4f5e8",
                        "entry_id": "4f2052a5-f090-3726-8a79-cfad1d1d7f4a",
                        "glosses": [
                            "weibliche Person, die infolge eines Krieges bleibende körperliche Schäden erlitten hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "494bcee6-0463-4b08-a48a-bc9d2a05051e",
                                "sense_id": "df388276-62ad-3dcb-9e05-badc3dd4f5e8",
                                "text": "In Afghanistan verlor Frau Möbius einen Arm. Sie ist nun eine Kriegsversehrte."
                            },
                            {
                                "example_id": "797569a4-b0b2-4da8-9aec-b50d8c4eb21c",
                                "sense_id": "df388276-62ad-3dcb-9e05-badc3dd4f5e8",
                                "text": "Annabelle hält viele Vorträge, in denen sie über ihr Schicksal als Kriegsversehrte berichtet."
                            },
                            {
                                "example_id": "c0bd8a28-60f7-4440-becb-e64d1f13354a",
                                "sense_id": "df388276-62ad-3dcb-9e05-badc3dd4f5e8",
                                "text": "Dies ist eine Aufschlüsselung des erhöhten Pflegebedarfs der Kriegsversehrten Lynch."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
