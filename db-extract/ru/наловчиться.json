                    {
                        "translation_id": "4113dfc1-e477-4d6a-918e-31ef82889d61",
                        "source_entry_id": "201f4957-995c-3258-94a0-7af7690fe3f4",
                        "source_sense_id": "6827dc03-a72f-37cd-b3eb-2d0b52f48200",
                        "target_lang_word": "Fertigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fertigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db250f5d-07c2-3e33-8c9a-19f66a93f40b",
                                        "entry_id": "02ff3200-a87b-3e88-ba29-36fd866365de",
                                        "glosses": [
                                            "(erworbene) Fähigkeit, etwas Bestimmtes zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6232306-6646-4d88-8a89-9909bd0095bf",
                                                "sense_id": "db250f5d-07c2-3e33-8c9a-19f66a93f40b",
                                                "text": "Die Fertigkeit, Lehm zu formen, ermöglicht ihm, Trinkgefäße herzustellen."
                                            },
                                            {
                                                "example_id": "16abaaa8-7129-41d3-8e6f-7380f28b0d7e",
                                                "sense_id": "db250f5d-07c2-3e33-8c9a-19f66a93f40b",
                                                "text": "„Gerade hier, im Dschungel, waren die Indigenen und ihre Fertigkeiten hoch gefragt.“"
                                            },
                                            {
                                                "example_id": "902a49aa-c6b2-4348-96de-de015c1ced6e",
                                                "sense_id": "db250f5d-07c2-3e33-8c9a-19f66a93f40b",
                                                "text": "„Der Gleitschirmflieger spielt mit den technischen Möglichkeiten seines Fluggeräts und mit seinen Fertigkeiten: […] Er spielt mit den Leinen, den Bremsen, den Kräften des Windes in seinem Gleitschirm.“"
                                            },
                                            {
                                                "example_id": "8d84e8bc-173b-4dd0-b06d-ac345abfe76b",
                                                "sense_id": "db250f5d-07c2-3e33-8c9a-19f66a93f40b",
                                                "text": "„Das alles soll in diesem kurzen Strich stecken, auch der für seine Tüchtigkeit, seine Findigkeit und Fertigkeit gerühmte Fischer, dem vor keinem Wetter bange war, der zu viel trank, zugleich aber über einen unstillbaren Wissensdurst verfügte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3211d157-0b08-4a38-84b8-73a133345863",
                        "source_entry_id": "201f4957-995c-3258-94a0-7af7690fe3f4",
