                "senses": [
                    {
                        "sense_id": "8f2c9ae3-02b1-398b-be08-a65f52b6f473",
                        "entry_id": "19ed12e3-3935-338a-b1ea-7a1316855190",
                        "glosses": [
                            "Plante dont parle Homère et à laquelle il attribue des vertus merveilleuses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca737a4d-fa53-4603-b929-cd6ccec8baab",
                                "sense_id": "8f2c9ae3-02b1-398b-be08-a65f52b6f473",
                                "text": "J'aurais peut-être mieux fait de m'enivrer du nectar d'evanthée, de manger la fleur de la plante moly, de m'alanguir au pays des lotophages, de rester chez Circé."
                            }
                        ]
                    },
                    {
                        "sense_id": "eaef2fd0-a5fb-3c85-be0a-43588c8625f9",
                        "entry_id": "19ed12e3-3935-338a-b1ea-7a1316855190",
                        "glosses": [
                            "Espèce d’ail vulgairement appelée ail doré et de nom scientifique Allium moly."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9d11269-73dd-43e8-9718-de7c70f6b7bf",
                        "source_entry_id": "19ed12e3-3935-338a-b1ea-7a1316855190",
                        "target_lang_word": "moly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be1ef828-4d11-330d-8998-be8cc2e12fe3",
                                        "entry_id": "855c76c0-fef7-391a-846a-8c0463f70be0",
                                        "glosses": [
                                            "A magic herb or plant used by Odysseus to overcome Circe."
                                        ],
                                        "tags": [
                                            "Greek",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f69fb746-465b-468a-b568-91df38a8b050",
                                                "sense_id": "be1ef828-4d11-330d-8998-be8cc2e12fe3",
                                                "text": "It excels Homers moly, cures this, falling sickness, and almost all other infirmities."
                                            },
                                            {
                                                "example_id": "ff86ff5d-974b-41f2-923b-f12173b81447",
                                                "sense_id": "be1ef828-4d11-330d-8998-be8cc2e12fe3",
                                                "text": "Or, propt on beds of amaranth and moly, / How sweet (while warm airs lull us, blowing lowly,)"
                                            },
                                            {
                                                "example_id": "d500f2e7-8b89-4c3f-b90e-8528df37acd6",
                                                "sense_id": "be1ef828-4d11-330d-8998-be8cc2e12fe3",
                                                "text": "So spoke the Radiant One; then gave me the magic herb, pulling it from the ground and showing me in what form it grew; its root was black, its flower milk-white. Its name among the gods is moly."
                                            },
                                            {
                                                "example_id": "cd12e708-1671-48e4-a66d-b11f19a7468d",
                                                "sense_id": "be1ef828-4d11-330d-8998-be8cc2e12fe3",
                                                "text": "I would need all the secret herbs of Dicte […] . I would need as well the rest of my moly stores."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dac6a378-306c-3a8a-9d97-67724e4aaa83",
                                        "entry_id": "855c76c0-fef7-391a-846a-8c0463f70be0",
                                        "glosses": [
                                            "Any plant associated with the mythological moly, especially the European allium, Allium moly."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "moly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84cdc541-488c-3045-aa8c-4df683d7e9ae",
                                        "entry_id": "10fb8346-316b-356a-b689-0eb6aa06808b",
                                        "glosses": [
                                            "Molybdenum."
