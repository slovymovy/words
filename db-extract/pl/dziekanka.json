                        ],
                        "examples": [
                            {
                                "example_id": "698637cd-b497-4bda-b7ad-918d001fece2",
                                "sense_id": "b1d430aa-fcc8-3584-8eee-c7c841b5a592",
                                "text": "Przez długie lata zapomniany i praktycznie niedostępny dla mieszkańców Gniezna, park przy szpitalu „Dziekanka” zmieni swoje oblicze"
                            },
                            {
                                "example_id": "85932d84-517d-43ce-9611-616d21935abf",
                                "sense_id": "b1d430aa-fcc8-3584-8eee-c7c841b5a592",
                                "text": "Z końcem lipca tego roku w „Dziekance” pozostanie tylko 1 specjalista zatrudniony na część etatu, który nie jest w stanie zabezpieczyć potrzeb wszystkich pacjentów"
                            },
                            {
                                "example_id": "ea42ff8a-804e-45a0-926b-7d88dac7a09f",
                                "sense_id": "b1d430aa-fcc8-3584-8eee-c7c841b5a592",
                                "text": "Pacjentka gnieźnieńskiej „Dziekanki” odebrała sobie życie w trakcie leczenia szpitalnego"
                            }
                        ],
