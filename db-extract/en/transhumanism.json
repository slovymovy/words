{
    "word": "transhumanism",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "122bb182-74e0-3eea-9b07-3eb3cdff811b",
                "word": "transhumanism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "1d193ba3-5d2b-4e36-ba5a-166ceec07c2e",
                        "entry_id": "122bb182-74e0-3eea-9b07-3eb3cdff811b",
                        "tags": [
                            "plural"
                        ],
                        "form": "transhumanisms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a5e14914-8ec9-36d1-9389-02fb087524b5",
                        "entry_id": "122bb182-74e0-3eea-9b07-3eb3cdff811b",
                        "glosses": [
                            "A philosophy favouring the use of science and technology, especially neurotechnology, biotechnology, and nanotechnology, to overcome human limitations and improve the human condition."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "422187d8-2408-40da-b622-6caea62b8132",
                                "sense_id": "a5e14914-8ec9-36d1-9389-02fb087524b5",
                                "text": "Those who favor transhumanism speak the language of individual choice and freedom from institutional authoritarianism; those who challenge it speak the language of human dignity and human nature as embodied in the individual."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "972ebe86-0cc0-4b3a-a74a-045c528d900b",
                        "source_entry_id": "122bb182-74e0-3eea-9b07-3eb3cdff811b",
                        "source_sense_id": "a5e14914-8ec9-36d1-9389-02fb087524b5",
                        "source_sense_description": "philosophy favoring the use of science and technology",
                        "target_lang_word": "transhumanisme",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transhumanisme",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "75ec1377-9b84-3f55-988a-8b8d76ae1e75",
                                        "entry_id": "311569e8-1553-3d78-92a0-d56ebf5755c4",
                                        "glosses": [
                                            "streven om het menselijk lichaam door het toepassen van nieuwe technologie ingrijpend te verbeteren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "593a699c-c051-4f38-960c-d588a67cf77e",
                                                "sense_id": "75ec1377-9b84-3f55-988a-8b8d76ae1e75",
                                                "text": "Het transhumanisme staat er niet al te best op de laatste tijd. De beweging die propageert dat de mensheid aan zichzelf moet sleutelen met hulp van futuristische technieken zoals genetische modificatie en brein-computer-koppelingen, kreeg afgelopen jaar een aantal tegenslagen te verduren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b16f610a-f7cd-4a0e-8cd2-39b7a0623002",
                        "source_entry_id": "122bb182-74e0-3eea-9b07-3eb3cdff811b",
                        "source_sense_id": "a5e14914-8ec9-36d1-9389-02fb087524b5",
                        "source_sense_description": "philosophy favoring the use of science and technology",
                        "target_lang_word": "transhumanisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transhumanisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f726ca62-5092-385e-9255-d0feeca24df4",
                                        "entry_id": "f6a18ae9-b586-38fc-9c85-3257d4f1a13a",
                                        "glosses": [
                                            "Mouvement culturel et intellectuel international prônant l’usage des sciences et des techniques afin d’améliorer les caractéristiques physiques et mentales des êtres humains."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17019111-5f8e-4d9b-94cb-b98e6a8d1e96",
                                                "sense_id": "f726ca62-5092-385e-9255-d0feeca24df4",
                                                "text": "Au début des années 1980, l’Université de Californie, à Los Angeles, est devenue le foyer de ce que l’on peut appeler une nouvelle conception philosophique du monde et de l’homme, doctrine que l’on a désignée par la suite sous le nom de transhumanisme."
                                            },
                                            {
                                                "example_id": "b04016a9-a707-40e2-b342-ac5d81a811f0",
                                                "sense_id": "f726ca62-5092-385e-9255-d0feeca24df4",
                                                "text": "La question du transhumanisme est extrêmement difficile. Notamment parce que la puissance des techniques biomédicales augmente très vite et qu'il est donc hasardeux d'évaluer aujourd'hui ce que l'homme sera en mesure de réaliser demain"
                                            },
                                            {
                                                "example_id": "6f5a490b-92cc-4ca9-bbfa-c09e8ab51d0f",
                                                "sense_id": "f726ca62-5092-385e-9255-d0feeca24df4",
                                                "text": "Le drapeau du transhumanisme est alors brandi par l’armée des entreprises mondiales occidentales affirmant leur volonté de supprimer les limites biologiques des êtres humains grâce aux techniques dites NBIC (nano, bio, informatique et survie cognitive) aux objectifs séduisants : mort de la mort, augmentation des capacités de chaque être humain, création d’un monde de l’intelligence artificielle, création de la vie sur commande en laboratoire et colonisation du cosmos."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f886b47a-6086-4697-9491-fd4de375c3b0",
                        "source_entry_id": "122bb182-74e0-3eea-9b07-3eb3cdff811b",
                        "source_sense_id": "a5e14914-8ec9-36d1-9389-02fb087524b5",
                        "source_sense_description": "philosophy favoring the use of science and technology",
                        "target_lang_word": "Transhumanismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Transhumanismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f540f0c8-1bf6-3bc4-afae-1e6884cbc1dc",
                                        "entry_id": "5239b04d-9f14-33f8-b49b-94051108afbb",
                                        "glosses": [
                                            "Denkrichtung der Philosophie, die darauf abzielt, die natürlichen Grenzen des Menschen durch den Einsatz neuer Technologien zu überwinden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd24f3b6-2a62-4e21-8f13-e8466f6b53ae",
                                                "sense_id": "f540f0c8-1bf6-3bc4-afae-1e6884cbc1dc",
                                                "text": "„Das verhandelte Thema ist der Transhumanismus, jene technospirituelle Bewegung, die den menschlichen Körper als ein Problem ansieht, das darauf wartet, gelöst zu werden.“"
                                            },
                                            {
                                                "example_id": "5792d58b-377e-40d4-aed1-4f3fd8bde6f6",
                                                "sense_id": "f540f0c8-1bf6-3bc4-afae-1e6884cbc1dc",
                                                "text": "„Der Transhumanismus bleibt letztlich anthropozentrisch, da nicht ein Ablösung des Menschen durch künstliche Lebensformen angestrebt wird, sondern eine Verschmelzung mit der Technik […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
