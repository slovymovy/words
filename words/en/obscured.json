{
    "word_family": [
        "obscure",
        "obscurity",
        "obscuration",
        "obscurely"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "83bcbfb0-060d-3c1e-a280-95e02fb8ac6a",
                    "sense_definition": "Hidden from view or made difficult to see, often by being covered or darkened.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "visibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mountain peak remained <w>obscured</w> by thick clouds throughout the entire morning.",
                            "target_lang_translations": {
                                "ru": "Горная вершина оставалась <w>скрытой</w> густыми облаками на протяжении всего утра."
                            }
                        },
                        {
                            "text": "The driver could not see the road clearly because his vision was partially <w>obscured</w> by the heavy rain.",
                            "target_lang_translations": {
                                "ru": "Водитель не мог четко видеть дорогу, так как обзор был частично <w>закрыт</w> сильным дождем."
                            }
                        }
                    ],
                    "synonyms": [
                        "hidden",
                        "concealed",
                        "blocked",
                        "shrouded"
                    ],
                    "antonyms": [
                        "clear",
                        "visible",
                        "exposed",
                        "uncovered"
                    ],
                    "common_phrases": [
                        "partially obscured",
                        "obscured by clouds",
                        "obscured from view"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скрытый от глаз или трудноразличимый, часто из-за того, что он чем-то закрыт или затемнен."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скрытый",
                                "target_lang_sense_clarification": "находящийся вне поля зрения"
                            },
                            {
                                "target_lang_word": "заслоненный",
                                "target_lang_sense_clarification": "закрытый чем-то другим"
                            },
                            {
                                "target_lang_word": "затуманенный",
                                "target_lang_sense_clarification": "плохо видимый из-за тумана или облаков"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b2e89949-756f-3f2d-99c5-45093da9c2b1",
                    "sense_definition": "The simple past and past participle of <w>obscure</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tall new building <w>obscured</w> our view of the sunset every evening.",
                            "target_lang_translations": {
                                "ru": "Новое высокое здание каждый вечер <w>загораживало</w> нам вид на закат."
                            }
                        },
                        {
                            "text": "He <w>obscured</w> the truth by providing the investigators with misleading information.",
                            "target_lang_translations": {
                                "ru": "Он <w>скрыл</w> правду, предоставив следователям ложную информацию."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма прошедшего времени и причастие прошедшего времени глагола «obscure» (загораживать, скрывать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "загородил",
                                "target_lang_sense_clarification": "о физическом препятствии для обзора"
                            },
                            {
                                "target_lang_word": "скрыл",
                                "target_lang_sense_clarification": "сделал невидимым или непонятным"
                            },
                            {
                                "target_lang_word": "затуманил",
                                "target_lang_sense_clarification": "сделал неясным"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}