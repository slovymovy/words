                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98049f3c-bbe2-425d-b682-c747074dde9b",
                                "sense_id": "7ecddb73-88b4-37bb-9a24-87eef3328d05",
                                "text": "La veste en jean est un basique de la garderobe masculine, un indémodable."
                            },
                            {
                                "example_id": "4b712308-cc12-496b-9c0e-350667769070",
                                "sense_id": "7ecddb73-88b4-37bb-9a24-87eef3328d05",
                                "text": "Qu’il s’agisse des indémodables comme le polo Lacoste, du boom des voitures néo-rétro ou encore de la machine à faire de l’eau gazeuse fun… tous ces objets sont tendances ! Des classiques aux produits les plus innovants"
                            }
                        ]
