                    {
                        "translation_id": "5a93a0ce-bd54-4d0e-98bb-a72b78510699",
                        "source_entry_id": "d1183ce4-45d7-3d2a-bf6b-8a62b40b4499",
                        "source_sense_description": "Not capable of being discerned",
                        "target_lang_word": "indiscernable",
