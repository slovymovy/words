                                                "example_id": "c0e0d7cf-d766-435d-8f2a-09f4a8a6f73b",
                                                "sense_id": "5b44a2ad-bfb8-3ff0-9af2-9892f7d352c6",
                                                "text": "Waldemar wyrósł na przystojnego kawalera."
                                            },
                                            {
                                                "example_id": "e068e707-fc11-4ef1-bc57-5185e56b9373",
                                                "sense_id": "5b44a2ad-bfb8-3ff0-9af2-9892f7d352c6",
                                                "text": "Teraz jego detektywi wysłali do CBŚ i Prokuratury Apelacyjnej w Poznaniu dokumenty, które według detektywa Waldemara Czerwińskiego dowodzą, że Jurkiewicz został zamordowany na zlecenie."
                                            },
                                            {
                                                "example_id": "6722626b-2134-49fb-a696-cee4fe19ecd2",
                                                "sense_id": "5b44a2ad-bfb8-3ff0-9af2-9892f7d352c6",
                                                "text": "Rozwój osady zaczął się 100 lat później, kiedy to król duński Waldemar I podarował ją biskupowi Absalonowi."
                                            },
                                            {
                                                "example_id": "4ca16a62-923f-4dcd-9fac-006734139540",
                                                "sense_id": "5b44a2ad-bfb8-3ff0-9af2-9892f7d352c6",
                                                "text": "Nadinsp. Michał Ledzion, dotychczasowy komendant wojewódzki, przekazał garnizon swojemu następcy, insp. Waldemarowi Wołowcowi."
                                            }
