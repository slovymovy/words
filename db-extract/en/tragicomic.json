                        "glosses": [
                            "Of, pertaining to, or resembling tragicomedy; having both tragic and comic aspects."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aaf149d1-2a5c-4512-9a15-af718f2d7f6c",
                                "sense_id": "1675903a-829b-33bf-bca0-d98359c62004",
                                "text": "The pirates threatened to kill Captain Phillips if attacked, and the result was tragicomic: the world’s most powerful navy vs. a lifeboat."
                            }
                        ]
                    }
                ],
