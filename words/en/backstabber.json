                            }
                        },
                        {
                            "text": "She was warned to avoid that office <w>backstabber</w> who constantly took credit for other people's work.",
                            "target_lang_translations": {
                                "ru": "Её предупреждали держаться подальше от того офисного <w>подлеца</w>, который постоянно присваивал себе чужие заслуги."
                            }
                        }
                    ],
                    "synonyms": [
