                "senses": [
                    {
                        "sense_id": "728f313e-22e4-3268-8c99-77039ff7d2d0",
                        "entry_id": "f26b4891-a863-3fd6-b568-f14aa5e16c0b",
                        "glosses": [
                            "een deel van een toneelstuk of film dat eenzelfde plaats, tijd en handeling voorstelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5860965f-32f5-4c6d-8ab1-9d61f8592e05",
                                "sense_id": "728f313e-22e4-3268-8c99-77039ff7d2d0",
                                "text": "Deze scène bestaat uit vijf shots en is het eerste deel van een sequens van zes scènes."
                            },
                            {
                                "example_id": "bf12c5b1-e0f3-4f8f-b6e0-5b1faff8743c",
                                "sense_id": "728f313e-22e4-3268-8c99-77039ff7d2d0",
                                "text": "Het was een soort lange scène uit een Woody Allen film waarin we alles en iedereen analyseerden en vervolgens fileerden."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c2c86b7-bbdc-3ef3-81d7-e9bfca6433b3",
                        "entry_id": "f26b4891-a863-3fd6-b568-f14aa5e16c0b",
                        "glosses": [
                            "een opschudding veroorzaakt doordat iemand opspeelt, ruzie maakt of iets dergelijks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c40a2a91-bd7f-4090-ac25-404ef7d802c6",
                                "sense_id": "5c2c86b7-bbdc-3ef3-81d7-e9bfca6433b3",
                                "text": "Ze maakte weer eens een vreselijke scène."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc22e7d5-f3ff-4255-9137-375d77a48184",
                        "source_entry_id": "f26b4891-a863-3fd6-b568-f14aa5e16c0b",
