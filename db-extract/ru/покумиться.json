                "senses": [
                    {
                        "sense_id": "ef13cde6-dd9c-38e9-bee2-28271475eae7",
                        "entry_id": "a4136b60-516d-321d-9dbd-711bcab7dc6e",
                        "glosses": [
                            "прост. стать кумовьями"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f083b48-a8b7-48ae-bcd4-ce77b4427b41",
                                "sense_id": "ef13cde6-dd9c-38e9-bee2-28271475eae7",
                                "text": "Я даже… хэ-хэ!.. думал позовете меня в крестные отцы… Честь мне окажете, покумитесь… Хэ-хэ-с!.."
                            }
                        ]
                    },
                    {
                        "sense_id": "9b540da8-d31c-3b9b-8c56-164773e9d15d",
                        "entry_id": "a4136b60-516d-321d-9dbd-711bcab7dc6e",
                        "glosses": [
                            "истор. обменяться крестами, называя друг друга кумами (по старинному обычаю молодых русских девушек и женщин)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "702a221d-a02c-486e-a625-b6d514c5e093",
                                "sense_id": "9b540da8-d31c-3b9b-8c56-164773e9d15d",
                                "text": "Покумимся, кума, покумимся, // Мы семицкою березкой покумимся. // Ой Дид Ладо! Честному Семику. // Березке моей, // Еще кумушке да голубушке! // Покумимся, Покумимся, // Не сваряса, не браняса! // Ой Дид Ладо! Березка моя!"
                            }
                        ]
                    }
