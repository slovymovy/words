                ],
                "senses": [
                    {
                        "sense_id": "e751c828-b259-3f6c-9b9d-62789ff2cd81",
                        "entry_id": "38839ef5-6f43-3fea-a0b1-3901e2c8afdd",
                        "glosses": [
                            "Verbindung von Orten mit einem Schienenweg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50e2e580-0af9-48eb-9261-a61926862d18",
                                "sense_id": "e751c828-b259-3f6c-9b9d-62789ff2cd81",
                                "text": "„Im Deutschen Bund wurden zwischen 1835 und 1870 knapp 25000 km Eisenbahnstrecke gebaut.“"
                            },
                            {
                                "example_id": "39b33cf7-0d10-4823-ae30-374bd9bdfb14",
                                "sense_id": "e751c828-b259-3f6c-9b9d-62789ff2cd81",
                                "text": "„Der Neubau von Eisenbahnstrecken des Fernverkehrs findet überwiegend im Bereich des Schnell- (< 250 km/h) und Hochgeschwindigkeitsverkehrs (HGV, ≥ 250 km/h) statt.“"
                            },
                            {
                                "example_id": "858913af-85c9-4a05-a441-4b35ea6a2628",
                                "sense_id": "e751c828-b259-3f6c-9b9d-62789ff2cd81",
                                "text": "„In Leipzig half er tatkräftig mit, die erste deutsche Ferneisenbahnstrecke nach Dresden Wirklichkeit werden zu lassen, und die darauf folgenden Eisenbahnstrecken und -gesellschaften sind von ihm beeinflusst.“"
                            },
                            {
                                "example_id": "342ef477-1f62-4d52-aede-5b8725fd0428",
                                "sense_id": "e751c828-b259-3f6c-9b9d-62789ff2cd81",
                                "text": "„Während unserer Wanderung sind wir direkt an der Mosel entlang gewandert, auch die Eisenbahnstrecke verlief direkt entlang der Mosel, so dass die Züge manchmal ganz nahe an uns vorbei fuhren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
