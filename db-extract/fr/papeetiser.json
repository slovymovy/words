                "senses": [
                    {
                        "sense_id": "1cf749c6-24d0-3630-b082-8b44fb004a64",
                        "entry_id": "d75d4b6b-a14f-39eb-90d3-10c595416c20",
                        "glosses": [
                            "Homologuer (un bateau) pour l’importer en Polynésie française, moyennant une taxe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8f0d78d-2acd-46c3-9c0a-062e539d638f",
                                "sense_id": "1cf749c6-24d0-3630-b082-8b44fb004a64",
                                "text": "S'ils restent plus longtemps ils devront papeetiser le bateau, c-a-d payer environ 30% de la valeur vénale du navire à la date d’entrée sur le territoire, et telle qu’évaluée par les douaniers."
                            },
                            {
                                "example_id": "fd894aeb-6313-4281-a054-8504d9716e93",
                                "sense_id": "1cf749c6-24d0-3630-b082-8b44fb004a64",
                                "text": "Au delà de ce délai, il faut \"papeetiser\" le bateau c'est à dire le faire expertiser, l'importer via un transitaire et payer les taxes d'importation (total des frais environ 20% de la valeur du bateau)."
                            },
                            {
                                "example_id": "2b1709bf-49d4-4ba7-b6ed-016bbc668a39",
                                "sense_id": "1cf749c6-24d0-3630-b082-8b44fb004a64",
                                "text": "Il me donne la combine pour papeetiser. Il faut s’adresser à un expert corrompu, le payer en liquide et lui demander de sous-évaluer le bateau."
                            }
                        ]
                    }
                ],
