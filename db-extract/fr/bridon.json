                                        "glosses": [
                                            "Gebissstück mit Ringen an jeder Seite zum Einschnallen von Pferdezügeln (das leichte Zaumzeug)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ff190cb-fefc-4fa6-a0b2-9e5e28540ccc",
                                                "sense_id": "13c7471e-a0bc-3667-8cb4-9a388721dba0",
                                                "text": "Eine Trense ist Bestandteil des Zaumzeugs für Pferde"
                                            }
