                                        "glosses": [
                                            "ve dvou případech"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "728edc21-acd2-4e05-bd6b-e8eae7e03b0b",
                                                "sense_id": "5dd49e59-45d6-39f0-bf59-51cc9158fbd1",
                                                "text": "Kdybyste jim řekli, že dvakrát dvě jsou čtyři, odpovědí vám na to pohotově a s jakousi převahou: „Ano, ale dvakrát tři, pane, je šest.“ Načež od vás odejdou s uspokojením, že se nedali a že to vaše tvrzení uvedli, jak se říká, na správnou míru."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dvakrát",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "7e54fddc-b353-3c60-9ecf-aa3c80641ac7",
                                        "entry_id": "a4299d53-5152-3a9c-8fe3-a527b59d66ed",
                                        "glosses": [
                                            "velmi, mnoho"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89c61704-b341-4133-84b1-11202cffc3d5",
                                                "sense_id": "7e54fddc-b353-3c60-9ecf-aa3c80641ac7",
                                                "text": "Po pravdě řečeno jsem však ze svého přidělení k hraničářskému pluku 18 nebyl dvakrát nadšený."
                                            },
                                            {
                                                "example_id": "cd0132a1-7c52-4497-8216-b6dc944392d8",
                                                "sense_id": "7e54fddc-b353-3c60-9ecf-aa3c80641ac7",
                                                "text": "(…) duch nesvornosti mezi ně se vloudil / a dvakrát moudrý Brahmin takto soudil: / »Jest rodné matce syn nad život dražší / a věrný přítel, kde je k nalezení? / jej ztrativ, na vždy ztratíš, — však tím snazší, / kde větší láska, — jest i odpuštění.«"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9365b88-d75f-4dee-a90d-099ea1322fe9",
                        "source_entry_id": "0351de50-2487-34ac-94bd-f9a666be2960",
                        "source_sense_id": "4dfea5a6-79aa-34bd-b940-8a7944d3f15d",
