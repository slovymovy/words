{
    "word_family": [
        "hope",
        "hopeful",
        "hopefully",
        "hopelessness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "25d64132-22ae-3531-9129-1127a7886c2f",
                    "sense_definition": "Without hope; despairing; not expecting anything positive.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The refugees felt <w>hopeless</w> after walking for days without food.",
                            "target_lang_translations": {
                                "ru": "Беженцы были <w>в отчаянии</w> после нескольких дней пути без еды.",
                                "zh": "难民们在几天没吃东西徒步跋涉后感到<w>绝望</w>。"
                            }
                        },
                        {
                            "text": "She gave a <w>hopeless</w> sigh when she saw the pile of work.",
                            "target_lang_translations": {
                                "ru": "Она издала <w>безнадёжный</w> вздох, увидев кучу работы.",
                                "zh": "看到那堆工作时，她发出一声<w>绝望</w>的叹息。"
                            }
                        }
                    ],
                    "synonyms": [
                        "forlorn",
                        "desperate",
                        "despairing"
                    ],
                    "antonyms": [
                        "hopeful"
                    ],
                    "common_phrases": [
                        "feel hopeless",
                        "hopeless look"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывающий отчаяние; не ожидающий ничего хорошего.",
                        "zh": "感到绝望；不抱任何希望。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безнадёжный",
                                "target_lang_sense_clarification": "выражающий отчаяние или уныние"
                            },
                            {
                                "target_lang_word": "отчаявшийся",
                                "target_lang_sense_clarification": "потерявший надежду"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "绝望的",
                                "target_lang_sense_clarification": "形容人失去希望的状态"
                            },
                            {
                                "target_lang_word": "灰心的",
                                "target_lang_sense_clarification": "形容人因挫折而失去信心"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "703c5eed-589e-31d0-a382-ecfb6305592d",
                    "sense_definition": "Giving no ground of hope; promising nothing desirable.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Trying to fix the old car was a <w>hopeless</w> task.",
                            "target_lang_translations": {
                                "ru": "Попытка починить старую машину была <w>безнадёжной</w> задачей.",
                                "zh": "试图修理那辆旧车是一项<w>无望</w>的任务。"
                            }
                        },
                        {
                            "text": "They found themselves in a <w>hopeless</w> situation with no way out.",
                            "target_lang_translations": {
                                "ru": "Они оказались в <w>безнадёжной</w> ситуации, из которой не было выхода.",
                                "zh": "他们发现自己陷入了走投无路的<w>绝望</w>境地。"
                            }
                        }
                    ],
                    "synonyms": [
                        "desperate"
                    ],
                    "antonyms": [
                        "hopeful"
                    ],
                    "common_phrases": [
                        "hopeless situation",
                        "hopeless cause",
                        "hopeless case"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не дающий оснований для надежды; обречённый на неудачу.",
                        "zh": "没有希望的；注定失败的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безнадёжный",
                                "target_lang_sense_clarification": "не предвещающий успеха"
                            },
                            {
                                "target_lang_word": "безысходный",
                                "target_lang_sense_clarification": "не имеющий выхода или решения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无望的",
                                "target_lang_sense_clarification": "指事情没有成功的可能"
                            },
                            {
                                "target_lang_word": "绝望的",
                                "target_lang_sense_clarification": "指处境没有转机"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "434fc87c-39cf-3d28-85ed-6bd7811fe27f",
                    "sense_definition": "Without talent or skill in a particular area.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am absolutely <w>hopeless</w> at remembering people's names.",
                            "target_lang_translations": {
                                "ru": "Я абсолютно <w>безнадёжен</w> в запоминании имён людей.",
                                "zh": "我记人名简直<w>一窍不通</w>。"
                            }
                        },
                        {
                            "text": "He is a <w>hopeless</w> cook, so we usually order dinner.",
                            "target_lang_translations": {
                                "ru": "Он <w>никудышный</w> повар, поэтому мы обычно заказываем ужин.",
                                "zh": "他是个<w>笨拙</w>的厨师，所以我们通常点外卖。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hopeless at"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used to describe lack of skill"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Не имеющий таланта или навыков в определённой области.",
                        "zh": "在某方面毫无天赋或技能的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безнадёжный",
                                "target_lang_sense_clarification": "неспособный к чему-либо"
                            },
                            {
                                "target_lang_word": "никудышный",
                                "target_lang_sense_clarification": "разг. неумелый, плохой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "笨拙的",
                                "target_lang_sense_clarification": "指在某事上非常不擅长"
                            },
                            {
                                "target_lang_word": "一窍不通的",
                                "target_lang_sense_clarification": "指对某事完全没有能力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6858fd74-4599-398b-9671-9d18fe5e348b",
                    "sense_definition": "Incurable or impossible to change.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She admits that she is a <w>hopeless</w> romantic who loves love stories.",
                            "target_lang_translations": {
                                "ru": "Она признаёт, что она <w>неисправимый</w> романтик, который обожает любовные истории.",
                                "zh": "她承认自己是个<w>无可救药</w>的浪漫主义者，非常喜欢爱情故事。"
                            }
                        },
                        {
                            "text": "The teacher thought the boy was a <w>hopeless</w> idler.",
                            "target_lang_translations": {
                                "ru": "Учитель считал мальчика <w>безнадёжным</w> лодырем.",
                                "zh": "老师认为那个男孩是个<w>不可救药</w>的懒汉。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hopeless romantic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неисправимый или невозможный для изменения.",
                        "zh": "无法改变或无法治愈的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неисправимый",
                                "target_lang_sense_clarification": "о характере или привычках"
                            },
                            {
                                "target_lang_word": "безнадёжный",
                                "target_lang_sense_clarification": "закоренелый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不可救药的",
                                "target_lang_sense_clarification": "指习惯或性格无法改变"
                            },
                            {
                                "target_lang_word": "无可救药的",
                                "target_lang_sense_clarification": "指程度深到无法挽回"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}