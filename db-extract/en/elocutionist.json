                            "plural"
                        ],
                        "form": "elocutionists"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9ba2923d-9e89-349a-abb3-03b8ed509136",
                        "entry_id": "19ecc477-8c44-34b8-90d6-68153f9331a7",
                        "glosses": [
                            "Someone who practices or teaches elocution."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7046413-9a45-45e1-aaab-72680f13e213",
                                "sense_id": "9ba2923d-9e89-349a-abb3-03b8ed509136",
                                "text": "Melville Bell's father, Alexander Bell, had been a famous elocutionist and stage reciter."
                            },
                            {
                                "example_id": "6a7a35b6-222d-4795-9619-8c983d11d8f1",
                                "sense_id": "9ba2923d-9e89-349a-abb3-03b8ed509136",
                                "text": "Her ability as a recitalist or elocutionist, as she was sometimes called, indicated a possible career on the stage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb10c119-1777-401d-b261-771fd93e6bf1",
                        "source_entry_id": "19ecc477-8c44-34b8-90d6-68153f9331a7",
                        "source_sense_id": "9ba2923d-9e89-349a-abb3-03b8ed509136",
                        "source_sense_description": "someone who practices or teaches elocution",
                        "target_lang_word": "чтец",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "чтец",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "47c4b92b-fef8-3897-83e0-85d7763404c6",
                                        "entry_id": "52db3170-dc24-3a82-8c84-e9b2507afc75",
                                        "glosses": [
                                            "устар., часто шутл., ирон. тот, кто читает письменные тексты"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68520de9-8de8-4e98-a6f9-7fc1df72c0e9",
                                                "sense_id": "47c4b92b-fef8-3897-83e0-85d7763404c6",
                                                "text": "Молчалин: Слог его здесь ставят в образец! Читали вы? // Чацкий: Я глупостей не чтец, // А пуще образцовых."
                                            },
                                            {
                                                "example_id": "ce1e0739-a9c0-4e1c-919f-bb1076dbfb0f",
                                                "sense_id": "47c4b92b-fef8-3897-83e0-85d7763404c6",
                                                "text": "Годам к четырем я был уже чтец заправский, и вскоре стал поглощать книжку за книжкой."
                                            },
                                            {
                                                "example_id": "8af224ea-cbd8-4948-8689-fe8c3b0f1f3e",
                                                "sense_id": "47c4b92b-fef8-3897-83e0-85d7763404c6",
                                                "text": "Лимузин сворачивал в конце переулка. Пожилой водитель «Волги», чтец газеты «Спорт» и флегматик, умчался за ним, увозя Лидин плащ…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40cfe1d7-8ca3-3e78-8126-37e767b6d8ad",
                                        "entry_id": "52db3170-dc24-3a82-8c84-e9b2507afc75",
                                        "glosses": [
                                            "иногда ирон. тот, кто читает какой-либо текст вслух, для слушателей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f288d0d6-4fdd-4981-b1aa-f31b82fa17f9",
                                                "sense_id": "40cfe1d7-8ca3-3e78-8126-37e767b6d8ad",
                                                "text": "Потом встал секретарь и начал читать обвинительный акт. … Маслова то сидела неподвижно, слушая чтеца и смотря на него, то вздрагивала и как бы хотела возражать, краснела и потом тяжело вздыхала, переменяла положение рук, оглядывалась и опять уставлялась на чтеца."
                                            },
                                            {
                                                "example_id": "47324137-2f33-46cd-971f-200dfad89695",
                                                "sense_id": "40cfe1d7-8ca3-3e78-8126-37e767b6d8ad",
                                                "text": "Дамы всячески подчеркивали, что дедушка ― глава семьи; дом замирал, когда он ложился отдохнуть; по вечерам, затаив дыханье, слушали, как дедушка читает вслух старинные романы, ― он числился замечательным чтецом."
                                            },
                                            {
                                                "example_id": "55948acf-3a3e-43cd-b057-1d9bf7895fb6",
                                                "sense_id": "40cfe1d7-8ca3-3e78-8126-37e767b6d8ad",
                                                "text": "Милая девушка не подозревала, что по незнанию ввязалась в такую же статью, по которой мается в неволе индивидуальный предприниматель, чтец лекций Михаил Ходорковский."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fd8bb12-7513-350c-9331-b86da1b70710",
                                        "entry_id": "52db3170-dc24-3a82-8c84-e9b2507afc75",
                                        "glosses": [
                                            "человек, в обязанности которого входит чтение вслух для кого-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ed5de22-c65e-45ac-bb55-3458ee721006",
                                                "sense_id": "1fd8bb12-7513-350c-9331-b86da1b70710",
                                                "text": "Ему посчастливилось; за высокую цену в знатных домах находился он то домашним секретарем, то чтецом, то библиотекарем, а более всего собеседником."
                                            },
                                            {
                                                "example_id": "e4afaa02-36e0-4588-a9c7-ebb6719430d1",
                                                "sense_id": "1fd8bb12-7513-350c-9331-b86da1b70710",
                                                "text": "М. Н. Алексеев"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "162706cf-1985-3e9f-a661-0bfef8c68d98",
                                        "entry_id": "52db3170-dc24-3a82-8c84-e9b2507afc75",
                                        "glosses": [
                                            "артист, профессионально занимающийся художественным чтением вслух"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0281581-4847-4d2f-a25f-319b9f2541c4",
                                                "sense_id": "162706cf-1985-3e9f-a661-0bfef8c68d98",
                                                "text": "Саша Медведев, чтец филармонического отдела, декламировал с эстрады Пушкина и Маяковского, а в узком кругу ― Ахматову, Пастернака и Мандельштама."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcc89e21-ed16-38ac-95f1-0ceae2b1c34d",
                                        "entry_id": "52db3170-dc24-3a82-8c84-e9b2507afc75",
                                        "glosses": [
                                            "церк. низший церковнослужитель, не возведённый в степень священства, читающий во время богослужения тексты Священного писания и молитвы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e32155c8-d04d-4710-aa91-95c0b2bc6148",
                                                "sense_id": "bcc89e21-ed16-38ac-95f1-0ceae2b1c34d",
                                                "text": "По окончании псалма царские врата отверзаются; чтец, все диаконы и старший священник кланяются архиерею, а протодиакон начинает великую ектению."
                                            },
                                            {
                                                "example_id": "2079fcc2-3a0e-40e3-8314-abd98e86ed9c",
                                                "sense_id": "bcc89e21-ed16-38ac-95f1-0ceae2b1c34d",
                                                "text": "…Николай Никифорович, работая токарем на заводе «Красный богатырь», был чтецом храма Спаса Преображения в Богородском."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
