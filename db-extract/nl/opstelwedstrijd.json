                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b158707-4984-474c-b74e-1d1f4b13bbe1",
                                "sense_id": "9051cb46-866e-3a3b-a85b-211090dc643d",
                                "text": "Ondanks deze hoopvolle tekens noemt Irina Sjtsjerbakova, die namens Memorial de opstelwedstrijd heeft georganiseerd, die bewustwording een druppel waarheid in een oceaan van leugens."
                            },
                            {
                                "example_id": "febcc5d6-b629-4d19-abbb-1c7919b014f5",
                                "sense_id": "9051cb46-866e-3a3b-a85b-211090dc643d",
                                "text": "Memorial dreigt te worden gesloten. Volgens Petrov werd een door Memorial georganiseerde opstelwedstrijd op aangeven van het ministerie van Onderwijs geboycot. Volgens Petrov wil het ministerie niet dat er een andere versie van de geschiedenis gepropagandeerd wordt."
                            }
