                                "target_senses": [
                                    {
                                        "sense_id": "5aa5a5de-f63d-35ab-9d6e-05cc80dab7e1",
                                        "entry_id": "7bf4047c-1b94-3c11-8978-d8e27653b414",
                                        "glosses": [
