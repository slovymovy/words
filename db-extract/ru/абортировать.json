                                                "text": "Paul wurde durch den Sturm vollkommen vom Kurs abgetrieben."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "c9a34df6-f941-3abd-b677-a284f00b3a68",
                                        "entry_id": "fae5878d-cf04-3146-ba4d-84ae15fc5e6e",
                                        "glosses": [
                                            "eine flüssige, schaumige Speise schlagen, rühren, quirlen"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "South German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "756196e7-c965-4fa6-953f-4b2733b497f3",
                                                "sense_id": "c9a34df6-f941-3abd-b677-a284f00b3a68",
                                                "text": "Abtreiben bedeutet, Butter oder Eier und Zucker (ohne Hitze) so lange mit einem Rührlöffel in einem Geschirr rühren, bis die Masse dick wird und Blasen wirft."
                                            },
                                            {
                                                "example_id": "0c416c89-9b63-4f30-8d1e-96cc7756e9ba",
                                                "sense_id": "c9a34df6-f941-3abd-b677-a284f00b3a68",
                                                "text": "Butter, Zucker und Eier abtreiben und dann die anderen Zutaten beifügen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "fa27d933-5b20-3215-868e-3536860fed35",
                                        "entry_id": "fae5878d-cf04-3146-ba4d-84ae15fc5e6e",
                                        "glosses": [
                                            "das Eintreiben von Holzbohlen in schräger Richtung von innen nach außen in das Gestein, um das übrige Gestein abzuschließen"
                                        ],
                                        "tags": [
                                            "Bergbau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4bb9c6f-fe36-4655-a495-f587f9fedea9",
                                                "sense_id": "fa27d933-5b20-3215-868e-3536860fed35",
                                                "text": "Gänge in einer Mine heißen Gallerien und ihr Bau geschieht durch das ›Abtreiben der Gänge‹."
