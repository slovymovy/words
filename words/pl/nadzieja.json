                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "Hope",
                                "target_lang_sense_clarification": "a female given name"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88fab57d-f54f-3446-8292-0aa75dcf4c0a",
                    "sense_definition": "Nazwisko używane w Polsce.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "surname_entity",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pan <w>Nadzieja</w> pracuje w urzędzie miasta od wielu lat.",
                            "target_lang_translations": {
                                "ru": "Господин <w>Надзея</w> работает в городской администрации уже много лет.",
                                "en": "Mr. <w>Nadzieja</w> has been working at the city hall for many years."
                            }
                        },
                        {
                            "text": "Listonosz przyniósł ważną przesyłkę dla państwa <w>Nadziejów</w>.",
                            "target_lang_translations": {
                                "ru": "Почтальон принес важную посылку для супругов <w>Надзея</w>.",
                                "en": "The postman brought an important package for the <w>Nadzieja</w> family."
                            }
                        }
                    ],
                    "traits": [
                        {
