                        "source_entry_id": "d8e642ac-2237-305c-8c33-5e2b44809f90",
                        "source_sense_id": "7158170c-11bc-3837-91e9-d8bf2aed23fd",
                        "source_sense_description": "Zoologie, Entomologie: ein Insekt aus der Familie der Zweiflügler",
                        "target_lang_word": "Bremse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bremse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b9a90473-3846-3f38-969f-ee70a4ccc6a1",
                                        "entry_id": "efde9b29-ea6d-3ec6-8318-7928c1b0f24f",
                                        "glosses": [
                                            "Vorrichtung, die dazu dient, eine Bewegung zu verlangsamen oder anzuhalten"
                                        ],
                                        "tags": [
                                            "Mechanik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a334f53e-d4be-4c37-9c6c-2788ccf027cd",
                                                "sense_id": "b9a90473-3846-3f38-969f-ee70a4ccc6a1",
                                                "text": "„Dabei war die Fahrtschnelligkeit natürlich nicht immer die gleiche. Wenn auf einzelnen Plätzen infolge allzu großen Andrangs von den Seiten große Umstellungen vorgenommen werden mußten, stockten die ganzen Reihen und fuhren nur Schritt für Schritt, dann aber kam es auch wieder vor, daß für ein Weilchen alles blitzschnell vorbeijagte, bis es, wie von einer einzigen Bremse regiert, sich wieder besänftigte.“"
                                            },
                                            {
                                                "example_id": "545ea9bc-21d0-4004-bd46-67a74c1f7ed2",
                                                "sense_id": "b9a90473-3846-3f38-969f-ee70a4ccc6a1",
                                                "text": "„Weil der Rest der Welt im Namen der Bremse unterwegs ist, blüht in Deutschland der Autobahn-Tourismus.“"
                                            },
                                            {
                                                "example_id": "42963f00-729a-4b0a-babe-2dd8eb3a8747",
                                                "sense_id": "b9a90473-3846-3f38-969f-ee70a4ccc6a1",
                                                "text": "„Man hörte quietschende Bremsen, dann ein lautes dumpfes Geräusch wie beim Zusammenprall von Metall und Fleisch.“"
                                            },
                                            {
                                                "example_id": "a3c09984-67b1-4cb5-94db-415d96325611",
                                                "sense_id": "b9a90473-3846-3f38-969f-ee70a4ccc6a1",
                                                "text": "„Der Zug wurde langsamer, die Bremsen quietschten, und mit einem fürchterlichen Ruck, der mich fast umwarf, blieb er stehen.“"
                                            },
                                            {
                                                "example_id": "9526bddb-02a8-4596-964d-2b74bc34ba2a",
                                                "sense_id": "b9a90473-3846-3f38-969f-ee70a4ccc6a1",
                                                "text": "„Der Gleitschirmflieger spielt mit den technischen Möglichkeiten seines Fluggeräts und mit seinen Fertigkeiten: […] Er spielt mit den Leinen, den Bremsen, den Kräften des Windes in seinem Gleitschirm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "44f188ca-3e50-3841-aff4-4517ae719aba",
                                        "entry_id": "efde9b29-ea6d-3ec6-8318-7928c1b0f24f",
