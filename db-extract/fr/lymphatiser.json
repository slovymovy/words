                "senses": [
                    {
                        "sense_id": "e447a316-1705-34e8-a282-0257667d94ee",
                        "entry_id": "22c1d868-ba66-3e33-8dd5-9e2726542e18",
                        "glosses": [
                            "Donner un caractère lymphatique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a966044c-758f-4b51-850b-3d206605073a",
                                "sense_id": "e447a316-1705-34e8-a282-0257667d94ee",
                                "text": "En voyant les masses se lymphatiser, qui oserait dire qu'il n y a pas là manque de régime?"
                            },
                            {
                                "example_id": "d64eaa8f-5bee-47b9-afeb-876001b75dc4",
                                "sense_id": "e447a316-1705-34e8-a282-0257667d94ee",
                                "text": "Il chagrine. Il lymphatise. Il neurasthénise. Il léthargise."
                            },
                            {
                                "example_id": "69bd4f2c-fd46-4b5c-ac31-e4032da4646b",
                                "sense_id": "e447a316-1705-34e8-a282-0257667d94ee",
                                "text": "Alors, on prend son temps, on se cale un fesse comme il faut, on n'oublie pas de se servir un grand verre de plasma lymphatisé et c'est parti !"
                            }
                        ]
                    }
