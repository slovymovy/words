                    {
                        "translation_id": "05bd6ded-2435-4c3d-b5a9-322e321062d4",
                        "source_entry_id": "c60a6d88-262c-3358-b9de-8b0ef1036ffd",
                        "source_sense_id": "393134c7-c37c-3efc-8022-7c856e39ea56",
                        "target_lang_word": "défloration",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "défloration",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d61c2fc5-e558-3b72-9bd0-9fd7b422ac9d",
                                        "entry_id": "d2162c42-ec27-3ed0-afc6-96ef9955baa5",
                                        "glosses": [
                                            "Action de déflorer une jeune fille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da3622c0-5102-4fe5-93bb-be0b413a893e",
                                                "sense_id": "d61c2fc5-e558-3b72-9bd0-9fd7b422ac9d",
                                                "text": "Or Belle de Candeur était vierge, et au moment de la défloration, elle ne manqua pas de ressentir une douleur passablement désagréable."
                                            },
                                            {
                                                "example_id": "411cf3c6-2f06-43ab-b8e7-8500638d1eea",
                                                "sense_id": "d61c2fc5-e558-3b72-9bd0-9fd7b422ac9d",
                                                "text": "Le lit si bien bordé a connu le sang des déflorations et des accouchements et la sueur des agonies, la mode des voyages de noces étant de date récente et celle d’aller naître et mourir à l’hôpital ou à la clinique encore à venir."
                                            },
                                            {
                                                "example_id": "734e2a69-584e-4ba2-b86d-e62f996dba83",
                                                "sense_id": "d61c2fc5-e558-3b72-9bd0-9fd7b422ac9d",
                                                "text": "J’ai cessé d’être vierge à l’âge de dix-huit ans – ce qui n’est pas spécialement tôt – mais j’ai partouzé pour la première fois dans les semaines qui ont suivi ma défloration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea27d08f-6b36-3a03-a0af-693f251b17c6",
                                        "entry_id": "d2162c42-ec27-3ed0-afc6-96ef9955baa5",
                                        "glosses": [
                                            "Fait de passer en premier dans un endroit vierge."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0170f033-80b8-4ae5-87f0-788008b8c419",
                                                "sense_id": "ea27d08f-6b36-3a03-a0af-693f251b17c6",
                                                "text": "Il existe au ski une préséance de la trace, un plaisir de passer le premier. C’est une défloration de l’éphémère, vice inoffensif."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5111955-aad1-4223-9c7a-65a1a7df8169",
                        "source_entry_id": "c60a6d88-262c-3358-b9de-8b0ef1036ffd",
                        "source_sense_id": "393134c7-c37c-3efc-8022-7c856e39ea56",
