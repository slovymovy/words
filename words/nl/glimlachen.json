            "senses": [
                {
                    "sense_id": "060e6207-f523-3dab-9c95-52a7c7b9cb88",
                    "sense_definition": "een vriendelijke of geamuseerde gezichtsuitdrukking maken zonder geluid te maken",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "lachen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>glimlachte</w> vriendelijk naar de buurman toen ze hem in de tuin zag.",
                            "target_lang_translations": {
                                "en": "She <w>smiled</w> kindly at the neighbor when she saw him in the garden."
                            }
                        },
                        {
                            "text": "De baby begon te <w>glimlachen</w> toen hij zijn moeder zag.",
                            "target_lang_translations": {
                                "en": "The baby started to <w>smile</w> when he saw his mother."
                            }
                        }
                    ],
                    "synonyms": [
                        "smuilen"
                    ],
                    "common_phrases": [
                        "vriendelijk glimlachen",
                        "breed glimlachen",
                        "even glimlachen"
                    ],
                    "target_lang_definitions": {
                        "en": "to make a friendly or amused facial expression without making a sound"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "smile",
                                "target_lang_sense_clarification": "to have a smile on one's face"
                            },
                            {
                                "target_lang_word": "to smile",
                                "target_lang_sense_clarification": "to express amusement or kindness"
                            }
                        ]
                    }
                }
            ]
        },
