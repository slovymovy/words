    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "eaccff75-7166-328a-b5f3-b01cc9bf4934",
                "word": "Dalit",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3a32007a-210f-43e0-b58d-b404f8dc9c6d",
                        "entry_id": "eaccff75-7166-328a-b5f3-b01cc9bf4934",
                        "tags": [
                            "plural"
                        ],
                        "form": "Dalits"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4e5accdb-879c-3053-9fee-477ae47689d9",
                        "entry_id": "eaccff75-7166-328a-b5f3-b01cc9bf4934",
                        "glosses": [
                            "A member of a South Asian group of people traditionally regarded as untouchables or outcastes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e0b8603-218b-4c76-83dd-ef952fb4f87a",
                                "sense_id": "4e5accdb-879c-3053-9fee-477ae47689d9",
                                "text": "Jogendra Nath Mandal was the first leader to fight for a further identity of the Dalits, holding that they were neither Hindus nor Muslims."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3404a6dd-6d11-4448-b16a-86ca184bdac2",
                        "source_entry_id": "eaccff75-7166-328a-b5f3-b01cc9bf4934",
                        "source_sense_id": "4e5accdb-879c-3053-9fee-477ae47689d9",
                        "source_sense_description": "person regarded as outcaste",
                        "target_lang_word": "intouchable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intouchable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ca6d92f7-46c5-3087-a3e7-c7872ad9c5d4",
                                        "entry_id": "c4369f30-cd19-3fde-aa3c-6079433b214c",
                                        "glosses": [
                                            "Qui ne peut être touché, inaccessible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c489cbd-8626-48e1-be08-2196e545546b",
                                                "sense_id": "ca6d92f7-46c5-3087-a3e7-c7872ad9c5d4",
                                                "text": "L’image vague d’un univers intouchable et silencieux."
                                            },
                                            {
                                                "example_id": "ae43ca38-b6fa-40c2-8418-a4568e30bd5b",
                                                "sense_id": "ca6d92f7-46c5-3087-a3e7-c7872ad9c5d4",
                                                "text": "Une jeune fille secrète invisible, intouchable, soigneusement gardée pour vous ? Elle est là. Elle vous attendait."
                                            },
                                            {
                                                "example_id": "16d5e657-54ac-4594-99fa-855a1416911e",
                                                "sense_id": "ca6d92f7-46c5-3087-a3e7-c7872ad9c5d4",
                                                "text": "L'on n'insistera pas trop sur l'identité du « poignardeur » en chef de cette fine équipe, intouchable judiciairement et dont la réputation en matière de lancer du couteau dans le dos des autres n'est plus à faire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd7aef54-ace7-38f7-aedd-f7b18ccced9c",
                                        "entry_id": "c4369f30-cd19-3fde-aa3c-6079433b214c",
                                        "glosses": [
                                            "Qu’on ne doit pas toucher, inviolable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f24872e-fce8-4829-be43-78826d21e90c",
                                                "sense_id": "cd7aef54-ace7-38f7-aedd-f7b18ccced9c",
                                                "text": "Quant à mon père, je le voyais peu. Il partait chaque matin pour « le Palais », portant sous son bras une serviette pleine de choses intouchables qu’on appelait des dossiers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e35d6f9-6bb0-3e44-a51f-84fa4cc802f8",
                                        "entry_id": "c4369f30-cd19-3fde-aa3c-6079433b214c",
                                        "glosses": [
                                            "Hors d’atteinte, impénétrable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8c6ac0e-b084-478c-9cf6-cd6c6371b2a7",
                                                "sense_id": "6e35d6f9-6bb0-3e44-a51f-84fa4cc802f8",
                                                "text": "Des effets de jonction ont été de la sorte obtenus dans tous les développements historiques. Zones de développement, axes de développement, nœuds de trafics sont conquis peu à peu sur les « données » naguère intouchables du théoricien qui, fermant les yeux sur la réalité, s’occupait surtout de la croissance du marché plus que de celle de l’économie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "intouchable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "197dfd16-61e5-3c27-93c7-1fd1949c2604",
                                        "entry_id": "05f7e782-b656-3577-a755-3f092d258335",
                                        "glosses": [
                                            "En Inde, paria, membre d’une caste inférieure, au plus bas de la hiérarchie sociale, dont l’hindouisme interdit aux castes supérieures tout contact."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "648b531a-eeea-4775-89f1-a21a39f3fcd6",
                                                "sense_id": "197dfd16-61e5-3c27-93c7-1fd1949c2604",
                                                "text": "Dans la cacophonie orientale […] des pestiférés, des coolies, des intouchables dont j’ai partagé la vie aux coins des rues grouillantes."
                                            },
                                            {
                                                "example_id": "2720cdf5-3121-4492-95a3-575c07f9d035",
                                                "sense_id": "197dfd16-61e5-3c27-93c7-1fd1949c2604",
                                                "text": "Je suis doublement intouchable, d’abord comme né hors de la péninsule, ensuite comme écrivain, artisan assimilable à un plombier, un menuisier ou un barbier. Si je touche un brahmane, il ne dira rien, mais cela lui coûtera huit jours de purifications et de macérations. Si j’entre dans sa cuisine, tous les aliments s’y trouvant devront être jetés. Si je respire ses fleurs, il devra les couper et les jeter."
                                            },
                                            {
                                                "example_id": "ba9a136c-95a0-4d78-aaa6-799dce6a1e0f",
                                                "sense_id": "197dfd16-61e5-3c27-93c7-1fd1949c2604",
                                                "text": "Nous n’avons aucune preuve scientifique qu’Eve ait été tentée par le Serpent, que les âmes des infidèles brûlent en enfer après la mort ou qu’il déplaise au Créateur qu’un brahmane épouse une intouchable: des millénaires durant, des milliards de gens ont pourtant cru à ces histoires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62c6f843-9fc2-3c12-a283-19a3c82c2024",
                                        "entry_id": "05f7e782-b656-3577-a755-3f092d258335",
                                        "glosses": [
                                            "Toute personne mise au ban de la société."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5eacf8f1-7a09-4336-823d-25040ec1eac4",
                                                "sense_id": "62c6f843-9fc2-3c12-a283-19a3c82c2024",
                                                "text": "… les petites gens… ils avaient dû faire des sottises, sans s’en rendre compte, bien sûr, mais tout de même ils étaient coupables et c’était déjà bien gentil qu’on leur donne ainsi en souffrant l’occasion d’expier leurs indignités… C’était une « intouchable » ma mère. Cet optimisme résigné et tragique lui servait de foi et formait le fond de sa nature."
                                            },
                                            {
                                                "example_id": "a126a0ac-bc85-4835-8b86-8fa1ecc0797d",
                                                "sense_id": "62c6f843-9fc2-3c12-a283-19a3c82c2024",
                                                "text": "Je suis un déclassé qui, pour ces Brahmes que sont les grands bourgeois, a préféré les Intouchables ; mais ceux-ci, qui appellent de leurs vœux une société sans classe, me lorgnent comme un transfuge incapable de se laver du péché originel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6aaefde-52ee-4492-a6ff-175374c7cc35",
                        "source_entry_id": "eaccff75-7166-328a-b5f3-b01cc9bf4934",
                        "source_sense_id": "4e5accdb-879c-3053-9fee-477ae47689d9",
                        "source_sense_description": "person regarded as outcaste",
                        "target_lang_word": "paria",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paria",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9365fb95-2fad-3c1f-b1d4-135d764d1378",
                                        "entry_id": "4800a1ac-ca60-300f-b642-f121f9e0c814",
                                        "glosses": [
                                            "Personne de la dernière caste en Inde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccac53fb-6df6-4cdc-8b14-a0c6f96e5dd6",
                                                "sense_id": "9365fb95-2fad-3c1f-b1d4-135d764d1378",
                                                "text": "La caste des parias est réputée infâme par toutes les autres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a275a124-4483-3619-bc8c-de9bea553b55",
                                        "entry_id": "4800a1ac-ca60-300f-b642-f121f9e0c814",
                                        "glosses": [
                                            "Individu exclu d’un groupe social ou humain."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d3a22ba-660a-4911-9e7b-e7ef56adf2d9",
                                                "sense_id": "a275a124-4483-3619-bc8c-de9bea553b55",
                                                "text": "Il est sur ce rivage une race flétrie,[…]\nLes parias ; le jour à regret les éclaire,\nLa terre sur son sein les porte avec colère."
                                            },
                                            {
                                                "example_id": "d104f66e-7efe-4930-acb7-02ed8761d63e",
                                                "sense_id": "a275a124-4483-3619-bc8c-de9bea553b55",
                                                "text": "Après avoir, sous plusieurs formes, expliqué la nature et plaint la condition du Poète dans notre société, j’ai voulu montrer ici celle du Soldat, autre Paria moderne."
                                            },
                                            {
                                                "example_id": "fbf5a0cc-2c0a-4b97-8e76-542e39ea2e19",
                                                "sense_id": "a275a124-4483-3619-bc8c-de9bea553b55",
                                                "text": "Pérégrinations d’une paria (1833-1834)"
                                            },
                                            {
                                                "example_id": "96f98abe-a555-4846-8234-77969da17dec",
                                                "sense_id": "a275a124-4483-3619-bc8c-de9bea553b55",
                                                "text": "Et, sans que Silvère eût besoin de les interroger, ses camarades lui racontèrent l’histoire du braconnier Chantegreil et de sa fille Miette, avec cette haine aveugle des foules contre les parias."
                                            },
                                            {
                                                "example_id": "84796d4c-90dc-472f-9ee2-9c5d45d8739b",
                                                "sense_id": "a275a124-4483-3619-bc8c-de9bea553b55",
                                                "text": "En France, les grands patrons qui ne sont pas issus de la noblesse d’État sont des parias du monde des affaires."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "paria",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a61f5282-1d0c-36c4-a236-12779e67510c",
                                        "entry_id": "da142806-c9de-3970-bda7-a65539bb3d79",
                                        "glosses": [
                                            "Type de confiture de la Bresse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "paria",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "60d3d5f7-2ebd-3da9-847b-60605a06f270",
                                        "entry_id": "170f65c2-92f0-34c9-b38f-056c8f1e1e85",
                                        "glosses": [
                                            "Troisième personne du singulier du passé simple de parier."
                                        ],
