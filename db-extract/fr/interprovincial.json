                        "examples": [
                            {
                                "example_id": "c4f3b6ad-19e5-4c48-bffc-75acd0db66f1",
                                "sense_id": "fa90cff1-b28d-3ef0-93ae-1b4679aec76f",
                                "text": "Car les citoyens d'Ottawa-Gatineau ont peut-être l'impression d'habiter une seule et même ville, mais le fait de se retrouver à cheval sur une frontière interprovinciale, en même temps que sous l'autorité fédérale de la CCN, crée bien des tracasseries."
                            }
