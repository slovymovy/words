                "senses": [
                    {
                        "sense_id": "e5b93445-86ba-3e42-a7af-ea63a8315e60",
                        "entry_id": "fae7b03f-5e43-39dd-a069-b930786346d3",
                        "glosses": [
                            "door ziekte of heftige gevoelens met glimmende ogen kijken of met glazen blik verwilderd staren"
                        ],
                        "tags": [
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "01443c11-7af9-48c4-be63-805f0e221fa1",
                                "sense_id": "e5b93445-86ba-3e42-a7af-ea63a8315e60",
                                "text": "Hij wroetelde rond op de knieën, bleef op zijn handen geleund zitten glariën uit zijn hok en nu ontwaarde hij zijn wijf onder de stoof."
                            },
                            {
                                "example_id": "a3416e41-be87-447b-b692-f05498139a7f",
                                "sense_id": "e5b93445-86ba-3e42-a7af-ea63a8315e60",
                                "text": "Bruintje stond daar met zijn fluwelen paardeogen te glariën."
                            }
                        ]
                    },
                    {
                        "sense_id": "cfa54a3a-e561-3171-844f-f4db817cb675",
                        "entry_id": "fae7b03f-5e43-39dd-a069-b930786346d3",
                        "glosses": [
                            "licht weerspiegelen of uitstralen met wisselende sterkte"
                        ],
                        "tags": [
                            "van dingen"
                        ],
                        "examples": [
                            {
                                "example_id": "abcb2ae0-44f1-4a4b-af0d-1d17a4359a5b",
                                "sense_id": "cfa54a3a-e561-3171-844f-f4db817cb675",
                                "text": "De wind zit oost, de lucht is glashelder en 's avonds glariën de sterren."
                            }
                        ]
                    }
