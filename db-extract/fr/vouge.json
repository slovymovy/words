                    },
                    {
                        "sense_id": "fc6dba43-a67d-39b3-8d6d-fc36f297114a",
                        "entry_id": "2dfe3b05-2967-35d0-870f-586073c8eda7",
                        "glosses": [
                            "Serpe à long manche."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "6ce5e248-1f5c-439c-bc89-1b480c83c500",
                                "sense_id": "fc6dba43-a67d-39b3-8d6d-fc36f297114a",
                                "text": "Jehannot Regnaudin, deux cognées, une vouge, une hache et une hache à main."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac4fee0a-69e7-30a7-a0c2-d9e178ae42c9",
                        "entry_id": "2dfe3b05-2967-35d0-870f-586073c8eda7",
                        "glosses": [
                            "Arme d’hast médiévale apparue en Allemagne et en Suisse à la fin du xiiiᵉ siècle, constituée d’une serpe montée sur une hampe d’environ 2 mètres, issue de l’outil agricole du même nom."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e37afed1-8f2b-4a30-b828-5d772fa0225b",
                                "sense_id": "ac4fee0a-69e7-30a7-a0c2-d9e178ae42c9",
                                "text": "Tous portaient sur l’épaule le vouge et à la ceinture des haches de charpentier."
                            },
                            {
                                "example_id": "675e3731-2a60-4c3d-8d55-55793aabfc8e",
                                "sense_id": "ac4fee0a-69e7-30a7-a0c2-d9e178ae42c9",
                                "text": "Le couteau de brèche était de même aussi une vouge ou une guisarme, c'est-à-dire une lame au bout d'un manche en bois."
                            }
                        ]
                    }
                ],
