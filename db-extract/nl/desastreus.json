                        "examples": [
                            {
                                "example_id": "680b608d-5b0c-4645-a22a-3dcd4089da59",
                                "sense_id": "a4598ce1-6529-3c75-9332-ff63b7e82a45",
                                "text": "Het referendum in Nederland over het associatieverdrag met Oekraïne heeft een „desastreus resultaat” opgeleverd. Dat heeft premier Rutte maandag gezegd bij een bijeenkomst met parlementariërs uit EU-landen in de Ridderzaal. De premier zei verder dat het nog altijd mogelijk is dat Nederland het akkoord met Oekraïne als enige EU-lidstaat niet tekent."
                            }
                        ]
                    }
