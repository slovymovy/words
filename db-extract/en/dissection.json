                    {
                        "translation_id": "0fccd8f7-6f51-4ad7-944e-070c7764c428",
                        "source_entry_id": "704dde75-60eb-341e-b8f9-92b3c1425d05",
                        "source_sense_description": "the act of dissecting, of cutting a dead body apart",
                        "target_lang_word": "disección",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disección",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "a49d024d-e8d5-3d69-b9cf-99bd218a4836",
                                        "entry_id": "4e2df1f3-65f2-370d-9df7-cf01b9360c23",
                                        "glosses": [
                                            "Acción y efecto de disecar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fe703ad-c41e-4ac8-8977-96f3b176a850",
                                                "sense_id": "a49d024d-e8d5-3d69-b9cf-99bd218a4836",
                                                "text": "«—Nosotros, en nuestra isla, estábamos cansados de hacer disecciones en los cadáveres, cuando en Europa todavía no se atrevían a ello»."
                                            },
                                            {
                                                "example_id": "0ae64ba0-0f30-4614-bde1-6dad4141e107",
                                                "sense_id": "a49d024d-e8d5-3d69-b9cf-99bd218a4836",
                                                "text": "«Los facultativos de este establecimiento benéfico certificaron la muerte del cantante, y el cadáver fue depositado sobre la plancha de la mesa de disección, con el fin de hacerle la autopsia»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "02ace81c-1988-3221-96ff-0c4b76ea94b8",
                                        "entry_id": "4e2df1f3-65f2-370d-9df7-cf01b9360c23",
                                        "glosses": [
                                            "Análisis o estudio que se lleva a cabo minuciosamente para el conocimiento a profundidad de algo."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f09d99e-8ec7-4170-9a6f-e4d7cb224e35",
                        "source_entry_id": "704dde75-60eb-341e-b8f9-92b3c1425d05",
                        "source_sense_description": "examination",
                        "target_lang_word": "ана́лиз",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ана́лиз",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b7403fc9-4e5c-31fd-81c2-2218075c9106",
                                        "entry_id": "3e41e722-9831-319c-b099-4e4c35d97af9",
                                        "glosses": [
                                            "метод исследования объектов путём выделения и рассмотрения их отдельных частей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fbbcd53-d839-47db-ae35-eddb24d0165a",
                                                "sense_id": "b7403fc9-4e5c-31fd-81c2-2218075c9106",
                                                "text": "Для анализа и синтеза таких сложных систем возможно использование нового направления развития систем искусственного интеллекта ― синергетического искусственного интеллекта."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1a156c4-3350-3450-9f7d-ee5b72803028",
                                        "entry_id": "3e41e722-9831-319c-b099-4e4c35d97af9",
                                        "glosses": [
                                            "разг. рассмотрение, изучение, исследование"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61f8d6fc-488b-417b-b381-75f191cc4e8d",
                                                "sense_id": "b1a156c4-3350-3450-9f7d-ee5b72803028",
                                                "text": "Анализ документов проводится на основе определённых критериев отбора."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2133f43-5308-3629-a64a-b1f720563c4c",
                                        "entry_id": "3e41e722-9831-319c-b099-4e4c35d97af9",
                                        "glosses": [
                                            "мед., разг., мн. ч. пробы продуктов жизнедеятельности, физиологических жидкостей или тканей, предназначенные для исследования"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28dba567-be24-49e9-9103-1f8d6d96d44f",
                                                "sense_id": "c2133f43-5308-3629-a64a-b1f720563c4c",
                                                "text": "Завтра разбуди меня пораньше — надо зайти в поликлинику сдать анализы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a621bf7-758c-36ae-b9a2-85d8693c89b8",
                                        "entry_id": "3e41e722-9831-319c-b099-4e4c35d97af9",
                                        "glosses": [
                                            "мед., разг., мн. ч. результаты такого исследования в письменной форме"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff3c710a-41c3-4ce3-bb69-15224adecb78",
                                                "sense_id": "2a621bf7-758c-36ae-b9a2-85d8693c89b8",
                                                "text": "Не забудьте сегодня вечером забрать свои анализы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
