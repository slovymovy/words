                "senses": [
                    {
                        "sense_id": "f36d024e-fb9d-3491-8663-1a4c35e46559",
                        "entry_id": "d9b29cd5-4b18-30c0-a7ea-681fadcb2a37",
                        "glosses": [
                            "Absonderung rot gefärbten Schweißes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b60779d9-8460-4e43-b0d5-260c41e4a442",
                                "sense_id": "f36d024e-fb9d-3491-8663-1a4c35e46559",
                                "text": "„Die somatischen Reaktionen, die Resch auflistet, gleichen denen von Besessenen wie Stigmatisation, Levitation, Blutschwitzen, krampfartigen Kontraktionen der Extremitäten, Verzücken, Schmerzempfinden.“"
                            },
                            {
                                "example_id": "9d818118-014d-4dfc-a3b1-9d3063d3527b",
                                "sense_id": "f36d024e-fb9d-3491-8663-1a4c35e46559",
                                "text": "„Wahres Blutschwitzen, bei welchem Blutkörperchen durch die Drüsenmündungen austreten, ist angeblich auch beobachtet worden.“"
                            },
                            {
                                "example_id": "b8abe365-e52c-4a74-8a74-2b9ecdf7a6ab",
                                "sense_id": "f36d024e-fb9d-3491-8663-1a4c35e46559",
                                "text": "„Ähnlich wie Therese Neumann von Konnersreuth erlebte sie in der Folgezeit an Freitagen die Passion, und es bildete sich in der Nachkriegszeit bei ihr eine Art Blutschwitzen aus.“"
                            },
                            {
                                "example_id": "4c1084de-d211-4e86-ad7d-2f3abf847fc3",
                                "sense_id": "f36d024e-fb9d-3491-8663-1a4c35e46559",
                                "text": "„Eine der Schwestern vom Steinerberg, Theresia Städele, wurde 1849 wegen Simulierens von Blutschwitzen als Betrügerin zu einer Gefängnisstrafe verurteilt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
