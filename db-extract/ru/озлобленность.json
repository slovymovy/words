                    },
                    {
                        "translation_id": "689e267d-b706-493b-bfbb-3bcafd333798",
                        "source_entry_id": "5c17d072-58fe-3665-9885-6f1546cdacdc",
                        "source_sense_id": "f942cb45-e1c4-3c5f-891e-79244fa8daf5",
                        "target_lang_word": "aigreur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aigreur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4743961a-6081-3b68-b1dc-c7db8e471f80",
                                        "entry_id": "e04bd3cf-cf9a-3435-a4ae-364b54cfa0d0",
                                        "glosses": [
                                            "Qualité de ce qui est aigre, acide, notamment pour un aliment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e42a07f-4095-47dc-9898-12094e93fa63",
                                                "sense_id": "4743961a-6081-3b68-b1dc-c7db8e471f80",
                                                "text": "Des fruits qui ont de l’aigreur, qui ont une petite aigreur."
                                            },
                                            {
                                                "example_id": "7a19e6c1-1e3b-40d3-a027-12b36dbd2551",
                                                "sense_id": "4743961a-6081-3b68-b1dc-c7db8e471f80",
                                                "text": "Ce vin a de l’aigreur."
                                            },
                                            {
                                                "example_id": "94b534ec-e3f8-44e3-9ee3-ed43fc4c6242",
                                                "sense_id": "4743961a-6081-3b68-b1dc-c7db8e471f80",
                                                "text": "Son but est d'éliminer les substances chimiques responsables de l'aigreur et de l'acidité qui caractérisent la saveur et l'odeur de la graine brute."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "669d7c30-c1e5-3a6b-bb75-ba5bb1606e82",
                                        "entry_id": "e04bd3cf-cf9a-3435-a4ae-364b54cfa0d0",
                                        "glosses": [
                                            "Renvois que causent quelquefois les aliments mal digérés, et, dans ce sens, on l’emploie plus ordinairement au pluriel qu’au singulier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51cdb564-6ad2-4ef1-9479-b3381c4d0db0",
                                                "sense_id": "669d7c30-c1e5-3a6b-bb75-ba5bb1606e82",
                                                "text": "Cela donne des aigreurs, cause des aigreurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bb0a1a9-4098-3647-af63-a3f0f7051eea",
                                        "entry_id": "e04bd3cf-cf9a-3435-a4ae-364b54cfa0d0",
                                        "glosses": [
                                            "État d’esprit qui pervertit l’humeur (qui la ronge comme un acide) ; et qui lorsqu’elle s'exprime mène à proférer des paroles méchantes."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfd582e9-9354-4d77-be5a-b6a50018edb5",
                                                "sense_id": "7bb0a1a9-4098-3647-af63-a3f0f7051eea",
                                                "text": "C’est un homme qui a beaucoup d’aigreur dans l’esprit, dans l’humeur."
                                            },
                                            {
                                                "example_id": "79078c75-104f-43c8-8486-18bd0934fa78",
                                                "sense_id": "7bb0a1a9-4098-3647-af63-a3f0f7051eea",
                                                "text": "Répondre avec aigreur."
                                            },
                                            {
                                                "example_id": "222d1fbc-3735-409f-af51-48540ef377d6",
                                                "sense_id": "7bb0a1a9-4098-3647-af63-a3f0f7051eea",
                                                "text": "… comment se débarrasser d’un intellectuel comme Roberto Salviano ? Le désigner à la vindicte populiste, à l’aigreur collective."
                                            },
                                            {
                                                "example_id": "21467784-6c9d-4384-a37d-e2ffbfee5d18",
                                                "sense_id": "7bb0a1a9-4098-3647-af63-a3f0f7051eea",
                                                "text": "Il y a de l’aigreur, quelque aigreur, un peu d’aigreur entre ces deux personnes, Il y a entre elles un commencement de brouille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0efea220-a4c1-3c7b-ab33-2e6389aaf28e",
                                        "entry_id": "e04bd3cf-cf9a-3435-a4ae-364b54cfa0d0",
                                        "glosses": [
                                            "Tailles où l’eau-forte a trop mordu."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "353bf1e8-de62-4819-97fc-18395e0cb661",
                        "source_entry_id": "5c17d072-58fe-3665-9885-6f1546cdacdc",
                        "source_sense_id": "f942cb45-e1c4-3c5f-891e-79244fa8daf5",
                        "target_lang_word": "amertume",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amertume",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0112bacf-a8f3-3442-82e4-6b8bec61ee90",
                                        "entry_id": "c56806ff-67fa-3856-a5b2-6bab816fe983",
                                        "glosses": [
                                            "Saveur de ce qui est amer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90aa2c6b-5dcc-465b-8303-1354cb3dc4a2",
                                                "sense_id": "0112bacf-a8f3-3442-82e4-6b8bec61ee90",
                                                "text": "Ce fruit n’est confit qu'après un long séjour dans l'eau fraîche, destiné à lui ôter son amertume."
                                            },
                                            {
                                                "example_id": "5d1eb682-ceef-40de-89a4-c8f3808d92c3",
                                                "sense_id": "0112bacf-a8f3-3442-82e4-6b8bec61ee90",
                                                "text": "Derrière l’amertume de ses renvois d'estomac, il ressentait comme un sentiment diffus de corruption."
                                            },
                                            {
                                                "example_id": "1f92bddc-0b89-4179-95b3-435ffc0274c8",
                                                "sense_id": "0112bacf-a8f3-3442-82e4-6b8bec61ee90",
                                                "text": "Car si les bactéries peuvent s’avérer de mortelles ennemies, elles sont aussi vertueuses pour la gastronomie. On leur doit tout autant la couleur de notre saucisson, le moelleux d’un pain de campagne ou l’amertume d’une bière d’abbaye."
                                            },
                                            {
                                                "example_id": "7be4ade3-ced0-42b0-9ac1-8160cc967038",
                                                "sense_id": "0112bacf-a8f3-3442-82e4-6b8bec61ee90",
                                                "text": "L’amertume, qui expliquerait pourquoi les enfants et certains adultes renâclent à manger des légumes, correspond à une saveur, mais on la confond parfois avec l’astringence qui, elle, correspond à une sensation d’assèchement de la bouche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78fa3002-bd60-3c34-bf0c-6bd1af9b1316",
                                        "entry_id": "c56806ff-67fa-3856-a5b2-6bab816fe983",
                                        "glosses": [
                                            "Ce qu’il y a de mordant, d’offensant dans des écrits ou des discours."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "921db095-285d-4a79-bfc3-72f9a457b76c",
                                                "sense_id": "78fa3002-bd60-3c34-bf0c-6bd1af9b1316",
                                                "text": "Il y a bien de l’amertume dans cette critique, dans cette défense. Ses propos sont pleins d’amertume. Il m’a parlé de lui avec amertume."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "378b51a7-ee9b-3067-a91f-7f2308558ebe",
                                        "entry_id": "c56806ff-67fa-3856-a5b2-6bab816fe983",
                                        "glosses": [
                                            "Âpre tristesse ; douleur ; humiliation ; nostalgie ; regret ou ressentiment suite à une désillusion."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "366cbdf9-c58b-44d1-a175-60be71634369",
                                                "sense_id": "378b51a7-ee9b-3067-a91f-7f2308558ebe",
                                                "text": "Enfin, le cœur débordant d'amertume, Jacques pleura, la tête abandonnée sur les genoux de Yasmina."
                                            },
                                            {
                                                "example_id": "a3cc1784-15f1-4a0a-b524-081c06c61679",
                                                "sense_id": "378b51a7-ee9b-3067-a91f-7f2308558ebe",
                                                "text": "Il en ruminera des projets et des amertumes pendant cent ans encore."
                                            },
                                            {
                                                "example_id": "13497ecf-4bff-4867-9aee-91fce00dcf7b",
                                                "sense_id": "378b51a7-ee9b-3067-a91f-7f2308558ebe",
                                                "text": "Pour Pavlov le chemin de la vie fut jonché d'épines, plein d’amertume, de déceptions et de luttes acharnées…"
                                            },
                                            {
                                                "example_id": "e930e79c-bced-4504-9330-0e528d73dcf1",
                                                "sense_id": "378b51a7-ee9b-3067-a91f-7f2308558ebe",
                                                "text": "Tout a commencé en 2014 quand Sylvain Girodon a voulu cacher un trou dans le trottoir situé juste devant chez lui. « J’avais moi-même planté une rose trémière sur mon trottoir pour cacher la misère. Mais elle n’a pas tenu longtemps, elle a été rapidement rasée par les débroussailleurs de la Ville », se rappelle-t-il avec amertume."
                                            },
                                            {
                                                "example_id": "26f1ee1a-a4ef-4309-8a08-e7a49fc2cc84",
                                                "sense_id": "378b51a7-ee9b-3067-a91f-7f2308558ebe",
                                                "text": "Voilà le genre d’occasion qui n'était pas donné à tout le monde et il s'en fallut d’un rien qu’ivre d’amertume je m’offusquasse de n’y trouver nul profit."
                                            }
                                        ]
                                    }
                                ]
                            },
