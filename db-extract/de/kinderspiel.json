                    }
                ],
                "senses": [
                    {
                        "sense_id": "a2d872c5-aaa7-3307-81fe-85fb69074baf",
                        "entry_id": "a59ecf3e-db4f-3dc2-9971-25efcf857d66",
                        "glosses": [
                            "Spiel für Kinder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2876f76d-67c4-45e8-bb8f-2807b8f200e1",
                                "sense_id": "a2d872c5-aaa7-3307-81fe-85fb69074baf",
                                "text": "Als Grundschullehrerin sollte man verschiedene Kinderspiele kennen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "147719a9-64af-349d-886d-fb8366e2669e",
                        "entry_id": "a59ecf3e-db4f-3dc2-9971-25efcf857d66",
                        "glosses": [
                            "Aufgabe, die spielend leicht zu lösen oder zu meistern ist"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "9000ac04-1dc4-4b28-9598-c1b091d8df3b",
                                "sense_id": "147719a9-64af-349d-886d-fb8366e2669e",
                                "text": "Diese Mathematikaufgabe ist doch ein Kinderspiel."
                            },
                            {
                                "example_id": "304b644a-8555-4416-aa5e-2812782de1ec",
                                "sense_id": "147719a9-64af-349d-886d-fb8366e2669e",
                                "text": "\"Wer es so macht [Doping in sehr wirksamer Mikrodosierung], kann positive Tests umgehen - ein Kinderspiel. Das sage ich seit Jahren\", sagte [der Heidelberger Dopingexperten Werner] Franke."
                            },
                            {
                                "example_id": "19c7dafc-5d01-4264-bf8f-47b678c157d1",
                                "sense_id": "147719a9-64af-349d-886d-fb8366e2669e",
                                "text": "Die Kinderlähmung könnte längst so gut wie ausgerottet sein. Doch in Nigeria, Afghanistan und Pakistan grassiert das Virus wie eh und je. Dabei wäre ein sicherer Schutz vor der Krankheit ein Kinderspiel [, nämlich durch eine einfache Schluckimpfung]."
                            },
                            {
                                "example_id": "62254b29-1527-44be-8345-1846173b4e37",
                                "sense_id": "147719a9-64af-349d-886d-fb8366e2669e",
                                "text": "„Die Tür der beiden war ein Kinderspiel. Ich kriegte sie mit meiner Visa-Karte auf.“"
                            },
                            {
                                "example_id": "98b8539a-1bd2-4322-b513-16b0941c5470",
                                "sense_id": "147719a9-64af-349d-886d-fb8366e2669e",
                                "text": "„Für verwegene Kerle, die gut bezahlt wurden, ein Kinderspiel, ihn und die ganzen lästigen Aufsichtsbeamten hier irgendwo an der Küste verschwinden zu lassen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
