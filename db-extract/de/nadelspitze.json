                                "sense_id": "1aa4a45f-df99-32fa-9cda-c5f6daafcdaa",
                                "text": "„Er bewegte den Arm ein bißchen, als er spürte, wie die Nadelspitze sich in die Vene seines rechten Arms grub.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9393dce7-b7f6-331b-89cd-bd79a94a3179",
