                "senses": [
                    {
                        "sense_id": "39112281-ea50-38f0-8c26-a5914ec58cc3",
                        "entry_id": "9cce00e4-a42f-3fa2-ae1d-fc1050f918ec",
                        "glosses": [
                            "rodzaj mogiły w kształcie kopca"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "670c87c9-ce13-4646-8247-95d968bfaa24",
                                "sense_id": "39112281-ea50-38f0-8c26-a5914ec58cc3",
                                "text": "Archeolodzy zamierzają zbadać pobliski kurhan."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "1145363d-69af-359f-8098-59f3a6a31824",
                        "entry_id": "9cce00e4-a42f-3fa2-ae1d-fc1050f918ec",
                        "glosses": [
                            "kopiec usypany na cześć kogoś lub na pamiątkę czegoś"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "efdc7012-48a5-4bbe-8cef-cd795d1a1eea",
                        "source_entry_id": "9cce00e4-a42f-3fa2-ae1d-fc1050f918ec",
                        "source_sense_id": "39112281-ea50-38f0-8c26-a5914ec58cc3",
                        "target_lang_word": "kurgan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kurgan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec39c385-c4eb-3a1a-b86b-6e733a52c10e",
                                        "entry_id": "ebd9370f-7503-363b-9b9f-95dd1ad42635",
                                        "glosses": [
                                            "A prehistoric burial mound once used by peoples in Siberia and Central Asia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16fe6cc2-ef23-4fa1-8976-1e1776f47452",
                                                "sense_id": "ec39c385-c4eb-3a1a-b86b-6e733a52c10e",
                                                "text": "The kurgans and the burials they contain are consistent with the early IE burial practices outlined above, and the late Lithuanian archaeologist Marija Gimbutas proposed that the kurgan peoples were in fact early Indo-Europeans."
                                            },
                                            {
                                                "example_id": "034257b1-a981-4350-a2c6-a01fb076395c",
                                                "sense_id": "ec39c385-c4eb-3a1a-b86b-6e733a52c10e",
                                                "text": "A broad scatter of kurgan graves in the steppes contained imported Tripolye C2 pots (among other imported pot types) and a few, like Serezlievka, also contained Tripolye-like schematic rod-headed figurines."
                                            },
                                            {
                                                "example_id": "21661af2-6d66-4f49-8a85-551d4caf36ed",
                                                "sense_id": "ec39c385-c4eb-3a1a-b86b-6e733a52c10e",
                                                "text": "In 1897 N. I. Veselovskii excavated the very large, nearly 11 meter high Oshad kurgan or barrow in the town of Maikop in the Kuban region near the foothills of the northwestern Caucasus (the present-day capital of the Adygei Republic).[…]This discovery stimulated the excavation of other large kurgans located in the same general region, some of which seemed royal-like in their dimensions and, when not robbed in antiquity, in their materials."
                                            },
                                            {
                                                "example_id": "852c2f8e-2e08-4cfa-8a1a-a7e856e9262e",
                                                "sense_id": "ec39c385-c4eb-3a1a-b86b-6e733a52c10e",
                                                "text": "Even in the middle Volga region some kurgans have central graves containing adult females, as at Krasnosamarskoe IV.[…]The appearance of adult females in one out of five kurgan graves, including central graves, suggests that gender was not the only factor that determined who was buried under a kurgan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23d6a535-46c1-4db7-bdbc-febaf9201d3d",
                        "source_entry_id": "9cce00e4-a42f-3fa2-ae1d-fc1050f918ec",
                        "source_sense_id": "39112281-ea50-38f0-8c26-a5914ec58cc3",
                        "target_lang_word": "kurhan",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7fcc8e97-57b3-416b-9d5b-504b59dbb4f7",
                        "source_entry_id": "9cce00e4-a42f-3fa2-ae1d-fc1050f918ec",
                        "source_sense_id": "39112281-ea50-38f0-8c26-a5914ec58cc3",
                        "target_lang_word": "kourgane",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kourgane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "375570a0-3ace-34c0-b483-c3bb6a090723",
                                        "entry_id": "d276c120-962b-383b-b6d7-49e7e01d7338",
                                        "glosses": [
                                            "En Russie, sépulture préhistorique recouverte dʼun tumulus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26aa7be3-29c3-438c-b768-19c37598f471",
                                                "sense_id": "375570a0-3ace-34c0-b483-c3bb6a090723",
                                                "text": "Il s'agissait de visiter un kapas (c'est ainsi que les Lithuaniens appellent les tumulus auxquels les Russes donnent le nom de kourgâne) très célèbre dans le pays, parce qu'autrefois les poètes et les sorciers, c'était tout un, s'y réunissaient en certaines occasions solennelles."
                                            },
                                            {
                                                "example_id": "2bb883a4-8463-434c-b749-a2ea916522be",
                                                "sense_id": "375570a0-3ace-34c0-b483-c3bb6a090723",
                                                "text": "Le kourgane de base comprend la sépulture qui contient une grande quantité de mobilier varié, si elle nʼa pas été pillée."
                                            },
                                            {
                                                "example_id": "708d3300-bdd5-421a-969e-166d71a81fa0",
                                                "sense_id": "375570a0-3ace-34c0-b483-c3bb6a090723",
                                                "text": "Sur les rayonnages traînent une bible en langue afrikaner et un bocal de terre ramassée au kourgane Mamaïev."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "12692103-7be7-4ac5-8a87-275b265225ec",
                        "source_entry_id": "9cce00e4-a42f-3fa2-ae1d-fc1050f918ec",
                        "source_sense_id": "39112281-ea50-38f0-8c26-a5914ec58cc3",
                        "target_lang_word": "kourgan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kourgan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bb0556ac-ccba-3cfe-bb54-c5dc1ac2b53f",
                                        "entry_id": "02dfcbdf-d2bb-38c8-b84e-81628029cd47",
                                        "glosses": [
                                            "Nom d’antiques éminences tumulaires qu’on trouve dans certaines parties de la Russie orientale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed1490d9-4d49-4827-aa8b-2d9e9b535ff4",
                                                "sense_id": "bb0556ac-ccba-3cfe-bb54-c5dc1ac2b53f",
                                                "text": "Seul le sol du kourgan resta noir : pas la plus petite herbe n’en sortit."
                                            },
                                            {
                                                "example_id": "0d486f84-5921-4d3f-8c57-8c660e3ec6d3",
                                                "sense_id": "bb0556ac-ccba-3cfe-bb54-c5dc1ac2b53f",
                                                "text": "Kiptchak, dont on parle depuis si longtemps, s’annonce par un volcan crénelé, immense kourgan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
