                        "glosses": [
                            "Pantalon long porté par les Perses."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "ad7237ca-0927-4ea6-a133-6962f81c6b17",
                                "sense_id": "4ecb7e14-b772-39d6-96d4-f4ae18a51add",
                                "text": "On peut attribuer aux Perses la diffusion du vêtement long ou caftan, appelé candys, souvent porté manches pendantes, qui serait l'évolution du grand châle sumérien; c'est avec davantage de certitude qu'on doit leur accorder l'introduction en Asie antérieure du pantalon long, appelé par d'aucuns anaxyride, tel qu'il figure sur les frises d'Apadena, à Persépolis (- 400 à - 360 environ) et dont l'origine doit être recherchée chez les nomades des steppes."
                            }
                        ]
                    }
