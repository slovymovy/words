                "senses": [
                    {
                        "sense_id": "335f9972-dc9d-3fc0-9d5a-4f1260db1deb",
                        "entry_id": "e1375a50-950e-3d4a-8313-bc8f79a66315",
                        "glosses": [
                            "Person, die im Müll nach Verwertbarem sucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "552be82e-40c5-47d0-8a56-6b48bd499c13",
                                "sense_id": "335f9972-dc9d-3fc0-9d5a-4f1260db1deb",
                                "text": "„Von den letzten Strottern wurde in den 1950er Jahren berichtet.“"
                            },
                            {
                                "example_id": "b1f616f2-607a-4eb2-b51f-28145875c4e9",
                                "sense_id": "335f9972-dc9d-3fc0-9d5a-4f1260db1deb",
                                "text": "„»Außerdem laufen wir zu dieser Stunde keinen Kanalarbeitern über den Weg, höchstens vielleicht einem Strotter«, sagte Byron und holte die Karte hervor, die er angefertigt hatte.“"
                            },
                            {
                                "example_id": "23c7cdc8-8e46-4fcf-b24b-105677028f93",
                                "sense_id": "335f9972-dc9d-3fc0-9d5a-4f1260db1deb",
                                "text": "„Ein Mann mit weißem Haar und einem Gesicht, das eher einem Edelmann zu gehören schien als einem Strotter.“"
                            },
                            {
                                "example_id": "055f4887-8bec-418a-b824-f1d64a28afb2",
                                "sense_id": "335f9972-dc9d-3fc0-9d5a-4f1260db1deb",
                                "text": "„Der Mann war ein Strotter vom Scheitel bis zur durchgewetzten Sohle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
