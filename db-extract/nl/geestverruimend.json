                "senses": [
                    {
                        "sense_id": "3afc047c-ab4e-357f-a7d2-25b287825c09",
                        "entry_id": "793090f3-e943-377d-827a-1c944d8f3d19",
                        "glosses": [
                            "van drugs: dat ze een hallucinerende werking hebben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9ef9e0f-369d-41c7-b4ac-2879a0dd699f",
                                "sense_id": "3afc047c-ab4e-357f-a7d2-25b287825c09",
                                "text": "Voor een nieuwe generatie toeschouwers, die onbekend is met de wereld rondom de roman, zal On the Road vooral gaan over twee vrienden die een tijdperk van vrijheid, roes, seks en geestverruimende stuff ontdekken. Ze worden aangejaagd door Deans levensmotto: altijd bewegen."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e80e73f-8cc7-378a-ade3-b0c20d3822e4",
                        "entry_id": "793090f3-e943-377d-827a-1c944d8f3d19",
                        "glosses": [
                            "iets wat helemaal buiten het normale is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a402b29-a7df-4330-b88d-8aa15bbee42a",
                                "sense_id": "7e80e73f-8cc7-378a-ade3-b0c20d3822e4",
                                "text": "Voor sommige dingen bestaan geen metaforen. Soms is iets gewoon zo ontzettend iets dat je het niet goed kan illustreren met iets anders. En als je dat toch zou proberen, dan zou je dat oorspronkelijke iets waarvan je wil zeggen hoe bijzonder, groot, prachtig of geestverruimend absurd het is, eigenlijk alleen maar tekort doen."
                            }
                        ]
                    }
                ],
                "translations": [
