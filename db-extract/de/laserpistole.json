                    {
                        "sense_id": "1da8bc3e-4fca-3bd1-a835-1675c7dab863",
                        "entry_id": "076f2e24-cc25-31d2-8642-b31e2ade2184",
                        "glosses": [
                            "mit einer Hand haltbares, zur Geschwindigkeitsmessung von Fahrzeugen eingesetztes Lasergerät"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8227053e-1c5e-4843-91e2-4388fd726a54",
                                "sense_id": "1da8bc3e-4fca-3bd1-a835-1675c7dab863",
                                "text": "„Und kontrolliert bzw. gestraft würden auch Radfahrer – auf der Mariahilfer Straße werde ihre Geschwindigkeit mit der Laserpistole gemessen.“"
                            },
                            {
                                "example_id": "50e5c236-ba7f-46e8-a88c-2172777a8ddc",
                                "sense_id": "1da8bc3e-4fca-3bd1-a835-1675c7dab863",
                                "text": "„Bei der Laserpistole (Preis: circa 20.000 Euro) muss ein speziell geschulter Polizeibeamter das Fahrzeug mit dem Laserstrahl verfolgen.“"
                            },
                            {
                                "example_id": "3919e086-378a-41ce-8cd4-65944849180d",
                                "sense_id": "1da8bc3e-4fca-3bd1-a835-1675c7dab863",
                                "text": "„In der Laserpistole befindet sich eine kleine rote Laserdiode, die einen Lichtblitz von einer Sekunde in das Fleisch schießt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
