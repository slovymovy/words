                                        "sense_id": "7578cf47-afb1-3fdf-b906-e0253532dd0b",
                                        "entry_id": "95b5c4da-5361-3258-888d-10983be0d154",
                                        "glosses": [
                                            "Any sound or information intended to give notice of approaching danger; a warning sound to arouse attention; a warning of danger."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04428f27-f074-47e3-9522-afb4466d7f4a",
                                                "sense_id": "7578cf47-afb1-3fdf-b906-e0253532dd0b",
                                                "text": "Sound an alarm in my holy mountain."
                                            },
                                            {
                                                "example_id": "fc94c9af-bac5-473d-bf79-0442a03ace9e",
                                                "sense_id": "7578cf47-afb1-3fdf-b906-e0253532dd0b",
                                                "text": "She went about the house in a state of real terror, and yet lied monstrously and wilfully, and invented many of the alarms she spread, and made many of the sounds we heard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ac4ff9a-d798-3640-8379-0562071aedc7",
                                        "entry_id": "95b5c4da-5361-3258-888d-10983be0d154",
                                        "glosses": [
                                            "A device intended to warn or give notice of approaching danger."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06654063-bb51-49e8-b0a3-46286a96717f",
                                                "sense_id": "7ac4ff9a-d798-3640-8379-0562071aedc7",
                                                "text": "The fire alarm is located high on the wall to prevent tampering."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cef98ec-8b20-38d8-b6c6-bce3d0caeb03",
                                        "entry_id": "95b5c4da-5361-3258-888d-10983be0d154",
                                        "glosses": [
                                            "A sudden attack; a disturbance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80760a59-868b-470d-97cc-0f0984be830d",
                                                "sense_id": "3cef98ec-8b20-38d8-b6c6-bce3d0caeb03",
                                                "text": "Lord Marshal, command our officers-at-arms\nBe ready to direct these home alarms."
                                            },
                                            {
                                                "example_id": "1960fd3a-5d6f-4a98-aa25-fff2ddbef952",
                                                "sense_id": "3cef98ec-8b20-38d8-b6c6-bce3d0caeb03",
                                                "text": "Is it then true, as distant rumours run,\nthat crowds of rivals for thy mother's charms\nthy Palace fill with insults and alarms?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05114ed1-88f4-3f40-84d0-076984521c44",
                                        "entry_id": "95b5c4da-5361-3258-888d-10983be0d154",
                                        "glosses": [
                                            "Sudden surprise with fear or terror excited by apprehension of danger; in the military use, commonly, sudden apprehension of being attacked by surprise."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "732ebf47-3a2f-4d8d-b2c5-0997c3436172",
                                                "sense_id": "05114ed1-88f4-3f40-84d0-076984521c44",
                                                "text": "Alarm and resentment spread through the camp."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e217a6b-c772-31cd-9438-87d45459098d",
                                        "entry_id": "95b5c4da-5361-3258-888d-10983be0d154",
                                        "glosses": [
                                            "A mechanical device for awaking people, or rousing their attention."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59a6086a-7bc7-4ec3-a136-00c780601ba1",
                                                "sense_id": "7e217a6b-c772-31cd-9438-87d45459098d",
                                                "text": "The clock radio is a friendlier version of the cold alarm by the bedside."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3b0cc26-9422-3165-b1b3-715b9e9e98c0",
                                        "entry_id": "95b5c4da-5361-3258-888d-10983be0d154",
                                        "glosses": [
                                            "An instance of an alarm ringing, beeping or clanging, to give a noise signal at a certain time."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77c401eb-9567-4859-9ff9-23e1299eeda7",
                                                "sense_id": "d3b0cc26-9422-3165-b1b3-715b9e9e98c0",
                                                "text": "You should set the alarm on your watch to go off at seven o'clock."
                                            }
                                        ]
                                    }
                                ]
                            },
