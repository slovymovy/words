                ],
                "senses": [
                    {
                        "sense_id": "c24b3dc1-3f35-3546-b5dd-8ad6be7a3dd0",
                        "entry_id": "7f506ece-faf7-31e1-a4e5-74d4640ec039",
                        "glosses": [
                            "Qui a une valeur d'indice ou de référence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40217b65-1b35-493d-a667-42300539ca17",
                                "sense_id": "c24b3dc1-3f35-3546-b5dd-8ad6be7a3dd0",
                                "text": "Nous nous référons toujours à ces écrits indiciels, c'est la base."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f06b995-f713-3f0c-9982-14043ac89c31",
                        "entry_id": "7f506ece-faf7-31e1-a4e5-74d4640ec039",
                        "glosses": [
                            "Qui utilise des indices."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b3b9768-6918-450e-9fce-da08badcb879",
                                "sense_id": "5f06b995-f713-3f0c-9982-14043ac89c31",
                                "text": "Cette notation indicielle est particulièrement incompréhensible."
                            }
                        ]
                    },
                    {
                        "sense_id": "a8ec7a83-16c4-34fd-9c0d-7125ddf5434d",
                        "entry_id": "7f506ece-faf7-31e1-a4e5-74d4640ec039",
                        "glosses": [
                            "Qui concerne une caractéristique donnée par l'énonciation elle-même."
                        ],
                        "tags": [],
                        "note": "\"Je\" est dit par celui qui est \"Je\", \"Ici\" est dit par celui qui se trouve \"Ici\"",
                        "examples": [
                            {
                                "example_id": "81a04746-5885-43b5-9637-41d0eb383abe",
                                "sense_id": "a8ec7a83-16c4-34fd-9c0d-7125ddf5434d",
                                "text": "Les aspect indiciels de \"je\", \"ici\" et \"maintenant\" sont indubitables."
                            }
                        ]
                    },
                    {
                        "sense_id": "e98ecdda-2ff1-34ce-9ca0-7b719c6ebdeb",
                        "entry_id": "7f506ece-faf7-31e1-a4e5-74d4640ec039",
                        "glosses": [
                            "Qui est un Indicateur, un symptôme d'une maladie."
                        ],
                        "tags": [
                            "Sémiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "dc38a06c-4882-400f-85ca-832d92581ce4",
                                "sense_id": "e98ecdda-2ff1-34ce-9ca0-7b719c6ebdeb",
                                "text": "Son front rouge et bleu et ses yeux tournant sans arrêt sont des signes indiciels d'une maladie encore inconnue dans nos contrées."
                            }
                        ]
                    },
                    {
                        "sense_id": "cc9796c8-e139-3c4f-ac30-3ff12de6e1df",
                        "entry_id": "7f506ece-faf7-31e1-a4e5-74d4640ec039",
                        "glosses": [
                            "Qui est relatif à un indice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5a88602-cc4a-4668-9337-538fb2829dbd",
                                "sense_id": "cc9796c8-e139-3c4f-ac30-3ff12de6e1df",
                                "text": "Ce fond indiciel est établi sur l'euro, ce n'est pas le moment d'y toucher."
                            }
                        ]
                    },
                    {
                        "sense_id": "54696ce0-6780-324f-bf37-644ab1246416",
                        "entry_id": "7f506ece-faf7-31e1-a4e5-74d4640ec039",
                        "glosses": [
                            "Qui est relatif à l'indice d'écoute ou de visionnage."
                        ],
                        "tags": [
                            "Audiovisuel"
                        ],
                        "examples": [
                            {
                                "example_id": "be9eddcc-3783-4c93-bf81-5447d4233016",
                                "sense_id": "54696ce0-6780-324f-bf37-644ab1246416",
                                "text": "Nous avions toujours dit que mettre des petits chatons au JT était une tentative douteuse pour remonter la rentabilité indicielle de l'émission."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
