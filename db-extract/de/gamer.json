                    {
                        "translation_id": "8b3d1e0c-30a3-4e31-9ca9-c20207ea4488",
                        "source_entry_id": "f4756b47-b1f3-335b-81ef-a1b5a04aa77a",
                        "source_sense_id": "8f31f06b-63da-3d06-a4fc-2683de0e157b",
                        "source_sense_description": "(männliche) Person, die gerne oder regelmäßig Computerspiele spielt",
                        "target_lang_word": "gamer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gamer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f122a062-f1c3-3fe0-9619-e4d6bdd25d27",
                                        "entry_id": "4824bd14-e5c2-3dfe-befe-82cc56b2eece",
                                        "glosses": [
                                            "Joueur assidu ou fan de jeux vidéo."
                                        ],
                                        "tags": [
                                            "Jeux vidéo"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86f3abe9-196c-42d3-bcd3-ebd8e7db938b",
                                                "sense_id": "f122a062-f1c3-3fe0-9619-e4d6bdd25d27",
                                                "text": "L'avenir, c'est confier la sécurité routière à des gamers."
                                            },
                                            {
                                                "example_id": "bc44b0af-8b61-4719-a49b-ffbdd2a15423",
                                                "sense_id": "f122a062-f1c3-3fe0-9619-e4d6bdd25d27",
                                                "text": "Ce n’est que trois ans plus tard que leurs destins se croisent quand Riot Games, éditeur du jeu, demande à Fortiche de réaliser des présentations de leurs personnages phares. Le succès est tel que l’envie de voir plus grand « spawn », comme disent les gamers, dans l’esprit des deux sociétés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18e0a115-b465-301b-8939-ba4472192aca",
                                        "entry_id": "4824bd14-e5c2-3dfe-befe-82cc56b2eece",
                                        "glosses": [
                                            "Ordinateur portable dont les performances et la carte graphique sont particulièrement adaptées aux jeux vidéo."
                                        ],
                                        "tags": [
                                            "Jeux vidéo"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gamer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "214dcc73-384d-3807-af17-0386c01da306",
                                        "entry_id": "5a8f108d-0df0-3af6-8131-b3f356a0782f",
                                        "glosses": [
                                            "Maladie occasionnée par la grande douve du foie des ovins."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d2ffba1-7901-4fce-bffa-e8237e240e87",
                                                "sense_id": "214dcc73-384d-3807-af17-0386c01da306",
                                                "text": "Cette humidité, lorsqu'elle est froide comme celle des rosées, peut causer la maladie appellée la pourriture , le foie pourri, la maladie du foie, le gamer ou gamige ([…]). L’humidité cause aussi aux moutons des coliques très-dangereuses; […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gamer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "834f4ab9-56a4-3e80-9e5e-f023bc2c293a",
                                        "entry_id": "e084ad25-d745-37ce-97b2-e532dfaf507b",
                                        "glosses": [
                                            "Jouer de manière assidue aux jeux vidéo."
                                        ],
                                        "tags": [
                                            "Jeux vidéo"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee8e9fbe-c936-4e7e-bf2a-ed01c0cc0ea4",
                                                "sense_id": "834f4ab9-56a4-3e80-9e5e-f023bc2c293a",
                                                "text": "Minimum requis pour commencez à jouer le restant reprendra le jour de la sortie je pense...mais vous pourrez commencer à gamer dès la première heure de la sortie officielle."
                                            },
                                            {
                                                "example_id": "0f811385-91e9-4e81-ab37-3e02552444aa",
                                                "sense_id": "834f4ab9-56a4-3e80-9e5e-f023bc2c293a",
                                                "text": "Je passe pas mal de temps à gamer sur Battlefield ps4 et je viens d apprendre que la réactivitée^([sic]) de la tv est importante."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
