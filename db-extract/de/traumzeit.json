                "senses": [
                    {
                        "sense_id": "9b775077-12a9-31a2-86eb-e89cbd050a46",
                        "entry_id": "67f13342-64c3-307c-8bea-cb4059e80cfd",
                        "glosses": [
                            "zentraler Begriff/Konzept in der Mythologie der australischen Aborigines"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f38d516e-5257-45f0-97d6-502737574534",
                                "sense_id": "9b775077-12a9-31a2-86eb-e89cbd050a46",
                                "text": "„Es existiert sogar ein Hinweis in dem Manuskript, der eine Analogie zwischen Netherscurial und jenem wunderbaren Mythos der australischen Aborigines andeutet, der als Alchera (Traumzeit) bekannt ist - eine Überwirklichkeit, welche die Quelle all dessen ist, was wir in der Welt um uns herum sehen.“"
                            },
                            {
                                "example_id": "3d7bbd51-eb83-4e05-b8fe-d4e0433562bd",
                                "sense_id": "9b775077-12a9-31a2-86eb-e89cbd050a46",
                                "text": "„Unsere Überlieferungen waren voll von Geistern und Halluzinationen, Mythen und Aberglauben. Die ›Traumzeit‹ hatten die Aborigines es genannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b1509fd1-c93b-4091-8ef0-774d12139219",
