                                    },
                                    {
                                        "sense_id": "93e6f9f9-a16d-3eef-92b6-c56bce253c78",
                                        "entry_id": "0bea05bb-2efb-3b2e-bd7b-9f442ad7c70b",
                                        "glosses": [
                                            "A lawyer who represents defendants, especially a public defender; a defense attorney (US) or defence counsel (UK)."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec8fcd35-ab55-4f58-8cd7-181c8bae709e",
                                                "sense_id": "93e6f9f9-a16d-3eef-92b6-c56bce253c78",
                                                "text": "There was another protection to which she was intitled by that law, namely, a defender; but she had none."
                                            },
                                            {
                                                "example_id": "03175c1d-1658-4d83-aea5-bd98ec62489e",
                                                "sense_id": "93e6f9f9-a16d-3eef-92b6-c56bce253c78",
                                                "text": "So, what is contemplated under this model is that the defender would work with civil legal services lawyers to address the clients' needs."
                                            },
                                            {
                                                "example_id": "1ec8a745-c79a-40ae-97c0-3e55530a0cd5",
                                                "sense_id": "93e6f9f9-a16d-3eef-92b6-c56bce253c78",
                                                "text": "It puts you at the head of the table, at a right angle to the witness; the court reporter sits to your right, and the defender sits on the witness's far side."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f29f76e7-b369-3e3d-be77-eb210aad8dc8",
                                        "entry_id": "0bea05bb-2efb-3b2e-bd7b-9f442ad7c70b",
                                        "glosses": [
                                            "A defendant in a civil action."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
