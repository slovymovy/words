                "senses": [
                    {
                        "sense_id": "580f16ae-f82c-3060-9d7c-446586675d56",
                        "entry_id": "d46d7364-444c-35a0-8867-ca9a2152ba47",
                        "glosses": [
                            "Person, die mit Katzen besonders gut auskommt; die Katzen sehr mag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d18348c3-8f0e-4e51-89f1-a8a76c5224db",
                                "sense_id": "580f16ae-f82c-3060-9d7c-446586675d56",
                                "text": "„Martin H., dem 80-jährigen Katzenliebhaber, haben seine Lieblingstiere auf andere Weise geholfen.“"
                            },
                            {
                                "example_id": "05176d57-d1b1-4a22-a4d2-76b43e178833",
                                "sense_id": "580f16ae-f82c-3060-9d7c-446586675d56",
                                "text": "„Gottfried John, ein Katzenliebhaber und beschwörend eindringlicher Rezitator von Rilke-Gedichten, kann das fragile Ego eines Ehemanns in der Midlife-Crisis (in Doris Dörries \"Bin ich schön\") ebenso präzis verkörpern wie einen comichaften, mit goldenem Lorbeer bekränzten Caesar in \"Asterix und Obelix gegen Caesar\".“"
                            },
                            {
                                "example_id": "4f95f9d0-888b-43d0-8b68-0278cc8147ca",
                                "sense_id": "580f16ae-f82c-3060-9d7c-446586675d56",
                                "text": "„Katzenliebhaber werden es nicht gerne hören, aber zu den bedeutendsten Gefahren für den Vogelbestand zählen heute Hauskatzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
