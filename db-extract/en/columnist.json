                "senses": [
                    {
                        "sense_id": "fde4e47b-a7f7-3884-9c4a-5bafc0e11cc9",
                        "entry_id": "91da554b-12cb-3cb4-8dfb-3548a167a708",
                        "glosses": [
                            "A regular writer of a column, such as in a magazine or newspaper."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cd08776-e5f4-41e5-b306-bff48f3e0127",
                                "sense_id": "fde4e47b-a7f7-3884-9c4a-5bafc0e11cc9",
                                "text": "a sports columnist"
                            },
                            {
                                "example_id": "675968fb-937b-4d0d-a9ef-b01aa348f82d",
                                "sense_id": "fde4e47b-a7f7-3884-9c4a-5bafc0e11cc9",
                                "text": "a news columnist"
                            },
                            {
                                "example_id": "484fe5d7-07d3-4400-8f7c-5abe9610757d",
                                "sense_id": "fde4e47b-a7f7-3884-9c4a-5bafc0e11cc9",
                                "text": "a sporadic columnist"
                            },
                            {
                                "example_id": "a60260b5-e449-43ee-a306-3d0169131d1a",
                                "sense_id": "fde4e47b-a7f7-3884-9c4a-5bafc0e11cc9",
                                "text": "Ann Landers, who sometimes wrote her columns from her bathtub, called herself “the general manager of the world,” which pretty much describes the types of questions an advice columnist might be called upon to answer."
                            },
                            {
                                "example_id": "4350188b-ab4d-4138-a15a-ea9a90863407",
                                "sense_id": "fde4e47b-a7f7-3884-9c4a-5bafc0e11cc9",
                                "text": "As soon as it was suggested that it was considering the Swedish model – in which men are criminalised for buying sex, but the women working in prostitution are decriminalised – a slew of prominent male columnists started arguing against this infringement on a man's right to purchase a woman's body."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "846fec5d-8426-4fb6-9227-a3b26eaf1123",
                        "source_entry_id": "91da554b-12cb-3cb4-8dfb-3548a167a708",
                        "source_sense_id": "fde4e47b-a7f7-3884-9c4a-5bafc0e11cc9",
                        "source_sense_description": "regular writer of a column",
                        "target_lang_word": "sloupkař",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "19c4c94a-c1a1-4d46-81a5-11ef438f28ca",
                        "source_entry_id": "91da554b-12cb-3cb4-8dfb-3548a167a708",
                        "source_sense_id": "fde4e47b-a7f7-3884-9c4a-5bafc0e11cc9",
                        "source_sense_description": "regular writer of a column",
                        "target_lang_word": "columnist",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "columnist",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c04dc7b9-5120-3fb2-8ad2-9fc6e65bbccb",
                                        "entry_id": "cd4af2d3-f780-3109-bd22-c0f263f4b679",
                                        "glosses": [
                                            "iemand die een column schrijft"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e5e7509-b874-4b9e-aadf-d5a9b705dfd8",
                                                "sense_id": "c04dc7b9-5120-3fb2-8ad2-9fc6e65bbccb",
                                                "text": "Vooral in de media werd Buikhuisen verguisd, onder meer door columnist Piet Grijs (een pseudoniem van Hugo Brandt Corstius). Die noemde hem een \"kale, impotente carrièrewetenschapper\" en vergeleek hem met de toenmalige leider van de nationaalsocialistische Nederlandse Volks-Unie (NVU)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f0ce7db-b8c9-4354-8624-940f7b5f5a8d",
                        "source_entry_id": "91da554b-12cb-3cb4-8dfb-3548a167a708",
                        "source_sense_id": "fde4e47b-a7f7-3884-9c4a-5bafc0e11cc9",
                        "source_sense_description": "regular writer of a column",
                        "target_lang_word": "columniste",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "columniste",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f1b8c5ba-0732-3427-a146-b5c896f7cbda",
                                        "entry_id": "2ae7c3c0-cf59-38c5-8099-5059147807bb",
                                        "glosses": [
                                            "vrouwelijke stukjes schrijver die een vaste plaats in een krant of tijdschrift heeft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bbec88e-12d0-4fca-a929-5d2a76d5b7cc",
                                                "sense_id": "f1b8c5ba-0732-3427-a146-b5c896f7cbda",
                                                "text": "De aanklachten tegen de miljardair dateren van begin jaren 80 tot en met 2016, schrijft The Business Insider die een overzicht van alle aantijgingen tegen de twee mannen heeft gepubliceerd. Twee vrouwen hebben Trump beschuldigd van verkrachting. Een van hen is zijn ex-vrouw Ivana Trump, al zei ze later dat ze het niet 'letterlijk' had bedoeld. De ander is columniste E. Jean Carroll. De president ontkent alle aanklachten."
                                            },
                                            {
                                                "example_id": "1014f775-4d6d-4ab5-b31c-3354153dab19",
                                                "sense_id": "f1b8c5ba-0732-3427-a146-b5c896f7cbda",
                                                "text": "Schrijfster en columniste Carl Friedman is overleden. Ze stierf vrijdag op 67-jarige leeftijd in haar woonplaats Amsterdam na een ziekbed, meldt uitgeverij Van Oorschot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "545d3d2d-3fb6-4dac-b10a-f82d461eb183",
                        "source_entry_id": "91da554b-12cb-3cb4-8dfb-3548a167a708",
                        "source_sense_id": "fde4e47b-a7f7-3884-9c4a-5bafc0e11cc9",
                        "source_sense_description": "regular writer of a column",
                        "target_lang_word": "chroniqueur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chroniqueur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5a598577-a949-3f01-a0e2-b57cdb041681",
                                        "entry_id": "d61fd9ef-19ee-3d0c-b72e-2f0927d2d70b",
                                        "glosses": [
                                            "Auteur de chroniques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7af2d305-f72d-4bdc-92a3-fa9b47d33962",
                                                "sense_id": "5a598577-a949-3f01-a0e2-b57cdb041681",
                                                "text": "Longpont nous force d’ajouter foi aux paroles de Guillaume de Nangis et à celles de tous les chroniqueurs qui ont parlé de l’incendie de 1131."
                                            },
                                            {
                                                "example_id": "75235764-dcda-4e14-be3e-071a08c29366",
                                                "sense_id": "5a598577-a949-3f01-a0e2-b57cdb041681",
                                                "text": "L’historien n’a pas à délivrer des prix de vertu, […] ; les questions qui intéressent les chroniqueurs et passionnent les romanciers sont celles qu’il laisse le plus volontiers de côté."
                                            },
                                            {
                                                "example_id": "a4903b5d-c874-458a-bd36-417d5fb2fc51",
                                                "sense_id": "5a598577-a949-3f01-a0e2-b57cdb041681",
                                                "text": "Certains chroniqueurs prétendent même qu’il aurait étendu cette mesure à tous les juifs de son royaume, à l’instigation de l’empereur d’Orient, Héraclius, qui lui aurait fait savoir qu’aux dires de ses astrologues l’empire chrétien était menacé par un peuple circoncis."
                                            },
                                            {
                                                "example_id": "ab47a2f9-0206-4e29-994a-21f9b54a088f",
                                                "sense_id": "5a598577-a949-3f01-a0e2-b57cdb041681",
                                                "text": "C’est aussi en tant que « roi de France » que Louis IX (saint Louis) est mentionné par divers chroniqueurs arabes de la fin du xiiiᵉ ou du xiiiᵉ siècle, qui le désignent comme “Sanlûwis ibn Lûwis” et “rîdâfrans”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a6fae54-cd1a-3f0e-b2a9-f51a4dc6b4b2",
                                        "entry_id": "d61fd9ef-19ee-3d0c-b72e-2f0927d2d70b",
                                        "glosses": [
                                            "Rédacteur dans un journal, dans une émission de radio ou de télévision, spécialement chargé de la chronique."
                                        ],
                                        "tags": [
                                            "Audiovisuel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2abb70e-e881-49d6-ad3f-ebe89143559e",
                                                "sense_id": "5a6fae54-cd1a-3f0e-b2a9-f51a4dc6b4b2",
                                                "text": "Pourquoi ne pas avoir aussi mentionné que le préfacier de l’édition française de Human Nature, Alexandre Dorozynski, est un chroniqueur scientifique formé en Russie soviétique et spécialiste de Lénine ?"
                                            },
                                            {
                                                "example_id": "fd4aaee6-d005-4883-9649-3e234d077cf9",
                                                "sense_id": "5a6fae54-cd1a-3f0e-b2a9-f51a4dc6b4b2",
                                                "text": "Les chroniqueurs rapportent que Nicolas Sarkozy, pour expliquer qu’il se sentait bien dans sa peau de Président, aurait dit qu’il avait la banane."
                                            },
                                            {
                                                "example_id": "e8766d1c-dce8-4925-9ab6-a4cc4057ec9f",
                                                "sense_id": "5a6fae54-cd1a-3f0e-b2a9-f51a4dc6b4b2",
                                                "text": "Chaque jour, Harold Hyman, chroniqueur à BFMTV, explique les nœuds de la géopolitique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b2051b0-f7ee-46e7-a129-19bc9aa349cb",
                        "source_entry_id": "91da554b-12cb-3cb4-8dfb-3548a167a708",
                        "source_sense_id": "fde4e47b-a7f7-3884-9c4a-5bafc0e11cc9",
