                        "sense_id": "c9d414bb-377e-3516-8feb-513ddc217ce8",
                        "entry_id": "e2c22d78-071a-39b0-b949-8be00e1fea2f",
                        "glosses": [
                            "door mensen georganiseerd gevecht tussen kamphanen waarbij de toeschouwers kunnen wedden op de uitkomst van het gevecht"
                        ],
                        "tags": [
                            "illegaal"
                        ],
                        "examples": [
                            {
                                "example_id": "8a6f4712-a0fb-4744-a1f4-ae81df36d72c",
                                "sense_id": "c9d414bb-377e-3516-8feb-513ddc217ce8",
                                "text": "Uit hun ongearticuleerde kreten, hun gesis, viel niets over de ruzie op te maken. Uit zijn werkcel kwam slaperig de toneelschrijver te voorschijn. `Hanengevecht, Dip?'`Aardige vondst, Albert. Maar het beeld klopt niet."
                            },
                            {
                                "example_id": "30917f27-8777-445a-8ca4-c76993df2a66",
                                "sense_id": "c9d414bb-377e-3516-8feb-513ddc217ce8",
                                "text": "Een voormalige prinses van Roemenië is in de Amerikaanse staat Oregon verdachte in een zaak die alles behalve prinsessen-achtig is. De 60-jarige Irina Walker wordt verdacht van het organiseren van illegale hanengevechten."
                            }
                        ]
                    }
