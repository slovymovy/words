                "senses": [
                    {
                        "sense_id": "4d6968f0-7769-312d-9d7f-2c537511666f",
                        "entry_id": "5be9e23e-4d6a-303f-86bf-869abe570ed9",
                        "glosses": [
                            "Chocolat noir à forte teneur en cacao et au goût légèrement amer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51e043c6-da7a-4acd-b164-6c59ad30b53f",
                                "sense_id": "4d6968f0-7769-312d-9d7f-2c537511666f",
                                "text": "Vollmilchschokolade ist mir zu süß, lieber esse ich Zartbitterschokolade.",
                                "translation": "Le chocolat au lait est trop sucré pour moi, je préfère le chocolat noir."
                            },
                            {
                                "example_id": "bdeb850c-660a-4287-a7fb-ec7869e6bc0c",
                                "sense_id": "4d6968f0-7769-312d-9d7f-2c537511666f",
                                "text": "Für dieses Rezept müssen Sie die Zartbitterschokolade grob raspeln.",
                                "translation": "Pour cette recette il faut râper grossièrement le chocolat noir."
                            }
                        ]
                    }
                ],
