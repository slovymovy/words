                                                "example_id": "5ce9f4ba-9228-4928-a5da-4e2395b8b097",
                                                "sense_id": "a24ffdf2-0a58-3c2d-a2ac-e25c063e5d59",
                                                "text": "„Sex ist das, was unser normalerweise geordnetes Leben in Unordnung bringt.“"
                                            },
