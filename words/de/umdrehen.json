                        "wenden"
                    ],
                    "antonyms": [
                        "beibehalten"
                    ],
                    "common_phrases": [
                        "den Spieß umdrehen",
                        "das Spiel umdrehen"
                    ]
                },
                {
                    "sense_id": "2b0ae738-42a3-3640-bbce-baece730b454",
                    "sense_definition": "Ein Kleidungsstück so wenden, dass die Innenseite nach außen gekehrt wird.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "wenden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vor dem Waschen sollte man den Pullover <w>umdrehen</w>, um den Druck zu schonen."
                        },
                        {
                            "text": "Sie bemerkte erst im Büro, dass sie ihr Oberteil versehentlich <w>umgedreht</w> hatte."
