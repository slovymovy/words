                ],
                "senses": [
                    {
                        "sense_id": "8c3a258b-c294-3d20-8179-1f8a4b719030",
                        "entry_id": "e56f48bb-2fbb-33dd-bca9-2aef17c92d18",
                        "glosses": [
                            "Personne qui urine dans son lit ou dans ses vêtements."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "da608a4f-9cad-4ce6-945e-98886f82344b",
                                "sense_id": "8c3a258b-c294-3d20-8179-1f8a4b719030",
                                "text": "C'était pareil pour les pisseux. Tous les matins, Henri qui surveillait notre dortoir inspectait les lits. Nous étions une soixantaine dans chaque dortoir. « Toi là-bas, ton lit est mouillé, tu as encore pissé au lit, toujours les mêmes..."
                            }
                        ]
                    },
                    {
                        "sense_id": "26c29d2b-77c0-3db5-8982-4f1d0577953a",
                        "entry_id": "e56f48bb-2fbb-33dd-bca9-2aef17c92d18",
                        "glosses": [
                            "Personne très peureuse."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "d7acce75-6ef4-43db-8d8b-7720987609df",
                                "sense_id": "26c29d2b-77c0-3db5-8982-4f1d0577953a",
                                "text": "Il parle fort, mais en réalité, c’est un pisseux."
                            }
                        ]
                    }
                ],
