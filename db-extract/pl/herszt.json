                "senses": [
                    {
                        "sense_id": "2496c149-2ab8-3668-ad94-fcdfb084e99d",
                        "entry_id": "5ec45b1a-1c4a-36b5-b66a-ae6f357c9250",
                        "glosses": [
                            "przywódca bandy, szajki złoczyńców"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6786fba-97e6-45a3-9b5a-d36ecac86f37",
                        "source_entry_id": "5ec45b1a-1c4a-36b5-b66a-ae6f357c9250",
                        "source_sense_id": "2496c149-2ab8-3668-ad94-fcdfb084e99d",
                        "target_lang_word": "chieftain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chieftain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a59e013c-67bc-3d02-bfaf-1f07a3789cc2",
                                        "entry_id": "a16d0343-aa8b-30bf-977f-74b514249eac",
                                        "glosses": [
                                            "A leader of a clan or tribe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e397467-a7cf-4f9d-bd88-041c88f686bf",
                                                "sense_id": "a59e013c-67bc-3d02-bfaf-1f07a3789cc2",
                                                "text": "VI. THE PUYUMA GROUP.\nThe tribes belonging to this group occupy the plains in Hinan and that neighbourhood, and call themselves \"Puyumas,\" but the Chinese call them the \"Hinan Savages\". The Puyumas formed a very powerful State some 300 years ago, and united under one single rule as many as seventy isolated tribes scattered over the land, stretching from Hakusekikwaku and Seikoko to Harogwai in the southern part of the island, and were at one time so powerful that the chieftain was called by foreigners \"The King of Hinan\"."
                                            },
                                            {
                                                "example_id": "2bf9bd5e-7c68-4afd-909d-6ee8eb1c8299",
                                                "sense_id": "a59e013c-67bc-3d02-bfaf-1f07a3789cc2",
                                                "text": "They were probably the work of individual craftsmen working to meet the chieftains' needs. Their place in the chronology of the big cemeteries is indicated by the less richly-decorated double-springed bronze brooches which are found here."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "615f59c7-1c78-38bb-b563-23579839f6d2",
                                        "entry_id": "a16d0343-aa8b-30bf-977f-74b514249eac",
                                        "glosses": [
                                            "A leader of a group."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d44f10db-1e12-41a3-8f74-1c590a05e65e",
                                                "sense_id": "615f59c7-1c78-38bb-b563-23579839f6d2",
                                                "text": "The robber chieftain divided up the spoils."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55b3eda3-ea1e-4b5a-a114-94b3d9b32073",
                        "source_entry_id": "5ec45b1a-1c4a-36b5-b66a-ae6f357c9250",
                        "source_sense_id": "2496c149-2ab8-3668-ad94-fcdfb084e99d",
                        "target_lang_word": "ringleader",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ringleader",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6680d0c4-baad-3950-9e62-2b17261b51f5",
                                        "entry_id": "02ce0160-2e84-3124-b4a8-dcaa2ab34de2",
                                        "glosses": [
                                            "A leader of a group of people, especially an unofficial group."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "289c40d9-8175-43e4-9705-6a40eef0ecf8",
                                                "sense_id": "6680d0c4-baad-3950-9e62-2b17261b51f5",
                                                "text": "Once, on a confident whim, I approached the group of popular girls in an attempt to broaden my circle. Their ringleader took one glance at my new Aeropostale T-shirt and whispered to her clones, “Yeah, Aero's definitely out now.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40ef2d83-8a5c-356a-8efb-5011f2e194f2",
                                        "entry_id": "02ce0160-2e84-3124-b4a8-dcaa2ab34de2",
                                        "glosses": [
                                            "A person who starts and leads a disturbance (such as a riot), a conspiracy, or a criminal gang."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b701614d-2f66-4ac1-bf6b-6827f82a6d1f",
                                                "sense_id": "40ef2d83-8a5c-356a-8efb-5011f2e194f2",
                                                "text": "The police arrested the ringleaders of the smuggling operation."
                                            },
                                            {
                                                "example_id": "2d00bc88-b6b4-4944-9862-c483cad45045",
                                                "sense_id": "40ef2d83-8a5c-356a-8efb-5011f2e194f2",
                                                "text": "A sort of naughty persons, lewdly bent, / Under the countenance and confederacy / Of Lady Eleanor, the protector's wife, / The ringleader and head of all this rout, / Have practis'd dangerously against your state..."
                                            },
                                            {
                                                "example_id": "2fce41d5-0d13-4abf-8a2a-f44a069588c7",
                                                "sense_id": "40ef2d83-8a5c-356a-8efb-5011f2e194f2",
                                                "text": "The ringleaders of the gang were eventually hanged at Tyburn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3831c504-1877-4b84-988d-ae203c82bcad",
                        "source_entry_id": "5ec45b1a-1c4a-36b5-b66a-ae6f357c9250",
                        "source_sense_id": "2496c149-2ab8-3668-ad94-fcdfb084e99d",
                        "target_lang_word": "warlord",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "warlord",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ff8b9e0-be9d-3037-bc84-b11c7276cbbf",
                                        "entry_id": "d94f7de0-fd7e-33a9-90d6-72b34a09e956",
                                        "glosses": [
                                            "A military commander or bandit leader wielding civilian power in an area where the government is weak."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1399c902-6716-43f6-aed8-d9bb01b93a6b",
                                                "sense_id": "8ff8b9e0-be9d-3037-bc84-b11c7276cbbf",
                                                "text": "Afghanistan's first major battle of the post-Taliban era ended tonight when the soldiers of the warlord besieging this strategic city south of Kabul ran out of ammunition and fled the battlefront in clouds of dust, cursing the warlord to his face for his callousness in committing them to a fight they were doomed to lose."
                                            },
                                            {
                                                "example_id": "f69d5650-c5dd-4b4b-b87d-9602e665c393",
                                                "sense_id": "8ff8b9e0-be9d-3037-bc84-b11c7276cbbf",
                                                "text": "“I’m not a warlord … I’m a liberator of the people,” he said. That’s the problem: So are they all. More than four million people have died in Congo’s wars since 1998, making it the most lethal conflict since World War II."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
