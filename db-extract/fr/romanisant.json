                    },
                    {
                        "form_id": "907024f8-ae89-4fc1-9cc9-7c74497f8d9a",
                        "entry_id": "45e136ea-8277-3d48-860b-f208eba096a6",
                        "tags": [
                            "feminine"
                        ],
                        "form": "romanisante"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7cd63db6-cbbc-32da-bee6-f0b26187dde3",
                        "entry_id": "45e136ea-8277-3d48-860b-f208eba096a6",
                        "glosses": [
                            "Savant qui étudie Rome."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed2619d1-a639-4e08-8a13-76df5e73e22e",
                                "sense_id": "7cd63db6-cbbc-32da-bee6-f0b26187dde3",
                                "text": "Tout homme à esprit cultivé qui découvrira une villa romaine enfouie dans son domaine deviendra, je le crois, un romanisant, si je puis me servir de ce mot, et un amateur des débris du passé."
                            },
                            {
                                "example_id": "0c003542-3833-400c-b590-fd49dd85b9fb",
                                "sense_id": "7cd63db6-cbbc-32da-bee6-f0b26187dde3",
                                "text": "C’est plus qu’un patoisant ; mais ce n’est pas un romanisant ni par l’inspiration, ni par la forme."
                            }
                        ]
                    },
                    {
                        "sense_id": "49c958cd-9be8-3fc7-aac3-5d62f22c25b4",
                        "entry_id": "45e136ea-8277-3d48-860b-f208eba096a6",
                        "glosses": [
                            "Celui qui étudie les langues romanes."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
