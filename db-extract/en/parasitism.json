                "senses": [
                    {
                        "sense_id": "7d3399f7-f4e5-3a1e-8f9c-e01e342b37a8",
                        "entry_id": "c66933b9-950f-333d-b988-bd3d123182e2",
                        "glosses": [
                            "Interaction between two organisms, in which one organism (the parasite) benefits and the other (the host) is harmed."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "28cecb6b-62db-3b88-b61e-976d7a194f8d",
                        "entry_id": "c66933b9-950f-333d-b988-bd3d123182e2",
                        "glosses": [
                            "A similar interaction between people or things."
                        ],
                        "tags": [
                            "figuratively",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "814a3fcf-8266-4d32-bf8c-138002111241",
                                "sense_id": "28cecb6b-62db-3b88-b61e-976d7a194f8d",
                                "text": "We accused her of parasitism in taking his hard-earned money for new dresses."
                            },
                            {
                                "example_id": "ad1d6cb8-9d5b-422d-9ce0-9a9abfb85c2d",
                                "sense_id": "28cecb6b-62db-3b88-b61e-976d7a194f8d",
                                "text": "These devices' energy consumption is parasitism upon the electrical grid."
                            },
                            {
                                "example_id": "fb682773-8c43-4e56-b481-d305c6b63a44",
                                "sense_id": "28cecb6b-62db-3b88-b61e-976d7a194f8d",
                                "text": "Either theſe men imagine themſelves to be marvelouſly high ſet and exalted in the chair of Belfaſt, to vouchſafe the parliament of England no better ſtile than Servants, or elſe their high notion, which we rather believe, falls as low as court paraſitiſm ; ſuppoſing all men to be ſervants, but the king."
                            }
                        ]
                    }
