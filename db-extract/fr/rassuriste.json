                        "glosses": [
                            "Qui se plaît à rassurer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "123d7296-62c5-4598-b7b2-b04f95a90220",
                                "sense_id": "83366162-9587-3662-8e12-5066893b674f",
                                "text": "Sur les plateaux télé et de radio, les tenants du discours « rassuriste » abattent leurs cartes. À raison ?"
                            },
                            {
                                "example_id": "21a3e6bb-ef2c-4bea-abde-5c9359ec26b5",
                                "sense_id": "83366162-9587-3662-8e12-5066893b674f",
                                "text": "Pour y parvenir, puisque les analyses rassuristes sont fausses, puisque les contestations idéologiques sont vaines et dangereuses, il faut tenter de desserrer l’étau que crée le respect des dogmes …."
                            }
                        ]
                    }
                ],
