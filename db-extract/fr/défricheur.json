                        ],
                        "examples": [
                            {
                                "example_id": "5d8c7e5d-6d97-4b0e-86b9-7fbf14fa8dd4",
                                "sense_id": "2615a532-4cd2-3491-9b79-4c980bcee035",
                                "text": "On retrouve encore aujourd'hui […] les vestiges de monastères-forteresses, élevés jadis, dit-on par les moines défricheurs ; […]."
