        "nl-extract.jsonl": [
            {
                "entry_id": "fc924658-95f6-3097-8b83-724a2bd445dc",
                "word": "frunniken",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0cc6e996-8cc5-3e01-b4fd-799c472d0c4c",
                        "entry_id": "fc924658-95f6-3097-8b83-724a2bd445dc",
                        "glosses": [
                            "iets prettigs doen met kleine niet al te planmatige bewegingen van de vingers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e5e629a-466c-4c34-bc23-199168fae7bd",
                                "sense_id": "0cc6e996-8cc5-3e01-b4fd-799c472d0c4c",
                                "text": "- Je vindt het vaak moeilijk om in de spiegel te kijken. Dikke brillenglazen, een glanzend en hoog voorhoofd en dik ‘onhandelbaar’ haar. Maar weet dat over een jaar of vijf de modellen Iman en Tyra dat hoge voorhoofd populair maken. En over tien jaar zul je dol zijn op je locks. Al zal het wel een hele kunst zijn om de gretige vingers van anderen - die er graag in frunniken - elegant te ontwijken. Succes daarmee."
                            },
                            {
                                "example_id": "03477838-952f-48c5-88c9-f03c031d1341",
                                "sense_id": "0cc6e996-8cc5-3e01-b4fd-799c472d0c4c",
                                "text": "- Naast de rode loper staat Rick Delput, 17 jaar oud, in een fijn blauw jasje. Een plechtig moment. Wat is mooier dan jongens in hun eerste pak? Dat frunniken aan knopen, het stille aaien van een das, met voorzichtige vingers, als op de huid van een meisje. Dan even een verend loopje proberen, de handen achteloos in broekzakken. Straks begint het dansen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "291d38d2-0326-46e0-b1c5-28b442697895",
                        "source_entry_id": "fc924658-95f6-3097-8b83-724a2bd445dc",
                        "source_sense_id": "0cc6e996-8cc5-3e01-b4fd-799c472d0c4c",
                        "target_lang_word": "fiddle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fiddle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "60cda017-54a1-3d73-abff-f6768c24cf9e",
                                        "entry_id": "42ae2694-f2d1-3ab2-8039-92dc817a12fb",
                                        "glosses": [
                                            "A violin, a small unfretted stringed instrument with four strings tuned (lowest to highest) G-D-A-E, usually held against the chin, shoulder, chest or on the upper thigh and played with a bow (see also usage notes below)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dcd5d38-7abb-485d-b478-511ede469d90",
                                                "sense_id": "60cda017-54a1-3d73-abff-f6768c24cf9e",
                                                "text": "...Of harpe & of salteriun. of fiðele & of coriun..."
                                            },
                                            {
                                                "example_id": "a41e9372-b4d5-48e5-918a-671804959d94",
                                                "sense_id": "60cda017-54a1-3d73-abff-f6768c24cf9e",
                                                "text": "Johnny, rosin up your bow and play your fiddle hard\n'Cause Hell's broke loose in Georgia an' the Devil deals the cards..."
                                            },
                                            {
                                                "example_id": "8d90e32f-f52a-4ad5-bdf5-21e659666412",
                                                "sense_id": "60cda017-54a1-3d73-abff-f6768c24cf9e",
                                                "text": "When I play it like this, it's a fiddle; when I play it like that, it's a violin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e39cea6d-5a5f-348b-a660-7991a308b505",
                                        "entry_id": "42ae2694-f2d1-3ab2-8039-92dc817a12fb",
                                        "glosses": [
                                            "Any of various other bowed stringed instruments, particularly those of the violin family when played non-classically."
                                        ],
                                        "tags": [
                                            "proscribed",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45852325-55aa-4e5c-94f8-ca8ab2724c46",
                                                "sense_id": "e39cea6d-5a5f-348b-a660-7991a308b505",
                                                "text": "The fiddle of these early times, however, was the viol and not our modern violin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b7fc61b-7604-3eaa-bec1-564b6db7965b",
                                        "entry_id": "42ae2694-f2d1-3ab2-8039-92dc817a12fb",
                                        "glosses": [
                                            "A violinist, or fiddler, in a band."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6b1bab1-a880-41ec-9462-ecb20ce6e36a",
                                                "sense_id": "7b7fc61b-7604-3eaa-bec1-564b6db7965b",
                                                "text": "He is first fiddle in the band."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6136147-2907-30db-baa5-53c0f9598fe8",
                                        "entry_id": "42ae2694-f2d1-3ab2-8039-92dc817a12fb",
                                        "glosses": [
                                            "Something resembling a violin, or fiddle, in shape",
                                            "A dock (Rumex pulcher) with leaves supposed to resemble the musical instrument."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f0e18dbd-002d-340c-91a0-6bd3a2291af0",
                                        "entry_id": "42ae2694-f2d1-3ab2-8039-92dc817a12fb",
                                        "glosses": [
                                            "Something resembling a violin, or fiddle, in shape",
                                            "A long pole pulled by a draft animal to drag loose straw, hay, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1da910e2-890e-3efc-9895-ccc787e58b52",
                                        "entry_id": "42ae2694-f2d1-3ab2-8039-92dc817a12fb",
                                        "glosses": [
                                            "Something resembling a violin, or fiddle, in shape",
                                            "A rack for drying pottery after glazing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4f724519-e722-3f38-ba98-f2f10cfa85ae",
                                        "entry_id": "42ae2694-f2d1-3ab2-8039-92dc817a12fb",
                                        "glosses": [
                                            "A clown; an unserious person entertaining a group."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "772999f6-3e71-4a2b-b2a6-992bd48e1585",
                                                "sense_id": "4f724519-e722-3f38-ba98-f2f10cfa85ae",
                                                "text": "You would not have your Son the Fiddle to every jovial Company."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9bfabcb-36e6-3c5b-936c-601a70669fe6",
                                        "entry_id": "42ae2694-f2d1-3ab2-8039-92dc817a12fb",
                                        "glosses": [
                                            "Unskillful or unartful behavior, particularly when showy and superficially pleasing.",
                                            "A scam; a fraud or swindle."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aceef966-2af7-498b-aa3e-e7e68885164a",
                                                "sense_id": "f9bfabcb-36e6-3c5b-936c-601a70669fe6",
                                                "text": "There was some kind of fiddle going on at that company, and several of the directors were arrested."
                                            },
                                            {
                                                "example_id": "7f33ac55-69d0-4dfe-bf6a-72578a0d9cb8",
                                                "sense_id": "f9bfabcb-36e6-3c5b-936c-601a70669fe6",
                                                "text": "Says Bevin: 'I want peace... and we shan't get it unless we deal with one another as friends. I will be a party to no fiddles.'"
                                            },
                                            {
                                                "example_id": "6a67ce17-cbb4-465e-bbf9-01c8d64cb7ac",
                                                "sense_id": "f9bfabcb-36e6-3c5b-936c-601a70669fe6",
                                                "text": "I know you'll think this is one of my fiddles. At my last parish we raffled a horse and trap,... a clothes horse and a mousetrap."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "889da1ef-43ce-376a-a852-abd708249b5b",
                                        "entry_id": "42ae2694-f2d1-3ab2-8039-92dc817a12fb",
                                        "glosses": [
                                            "Unskillful or unartful behavior, particularly when showy and superficially pleasing.",
                                            "A workaround; a quick and less than perfect solution for some flaw or problem."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14d4c8ea-31aa-4ba0-b8e9-487e96be7079",
                                                "sense_id": "889da1ef-43ce-376a-a852-abd708249b5b",
                                                "text": "That parameter setting is just a fiddle to make the lighting look right."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58789104-994b-309f-ad91-e6f260fb101d",
                                        "entry_id": "42ae2694-f2d1-3ab2-8039-92dc817a12fb",
                                        "glosses": [
                                            "Unskillful or unartful behavior, particularly when showy and superficially pleasing.",
                                            "An act of tinkering, playing around, or fidgeting with something."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd006a6a-28a3-4442-8903-3b83230335e8",
                                                "sense_id": "58789104-994b-309f-ad91-e6f260fb101d",
                                                "text": "Most people are quite careful about buying appliances. When looking at TVs for instance you might look for a particular brand, peruse the definition and colors on the screen, and maybe even have a fiddle with the remote."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6f901e8-c23f-3b43-8a6c-6266da10aea0",
                                        "entry_id": "42ae2694-f2d1-3ab2-8039-92dc817a12fb",
                                        "glosses": [
                                            "Any rail or device that prevents items from sliding off a table, stove, etc. in rough water."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0372762f-2e10-43df-b690-338a8a6b7c7f",
                                                "sense_id": "d6f901e8-c23f-3b43-8a6c-6266da10aea0",
                                                "text": "The meal is served on special trays which slot into the arms of airline-type seats of the passenger coaches. The trays have fiddles for each of the plates, cups and glasses, and the crockery is so well-designed that it is seldom any of the contents get spilled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99f6251a-8ce3-399a-a7cb-5bf3815cb37d",
                                        "entry_id": "42ae2694-f2d1-3ab2-8039-92dc817a12fb",
                                        "glosses": [
                                            "An arrest warrant."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "411fd9d2-91bf-3264-acfe-1d97e53755a0",
                                        "entry_id": "42ae2694-f2d1-3ab2-8039-92dc817a12fb",
                                        "glosses": [
                                            "A watchman's rattle."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0d795590-6fa9-306f-95f6-e673d3ecd738",
                                        "entry_id": "42ae2694-f2d1-3ab2-8039-92dc817a12fb",
                                        "glosses": [
                                            "A trifling amount."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a552073b-a063-4b86-bc90-c5d1f1730c30",
                                                "sense_id": "0d795590-6fa9-306f-95f6-e673d3ecd738",
                                                "text": "Done at a fiddle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fiddle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "359f4fbd-f2d9-393d-89e5-da27f71469c2",
                                        "entry_id": "9e264986-2541-35c6-921b-7bf66c7e8a3f",
                                        "glosses": [
                                            "To play the fiddle or violin, particularly in a folk or country style."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6333290-9df9-4ddd-afe7-04782d610b1b",
                                                "sense_id": "359f4fbd-f2d9-393d-89e5-da27f71469c2",
                                                "text": "to fiddle while Rome burns"
                                            },
                                            {
                                                "example_id": "4e6e5225-c5f1-48bc-8c4e-2a5dd3f55f64",
                                                "sense_id": "359f4fbd-f2d9-393d-89e5-da27f71469c2",
                                                "text": "Themistocles […] said he could not fiddle, but yet he could make a small town a great city."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5f946fa-2a54-32f1-accd-78cf74a9bb72",
                                        "entry_id": "9e264986-2541-35c6-921b-7bf66c7e8a3f",
                                        "glosses": [
                                            "To fraudulently manipulate (records, accounts, etc.) in order to cheat or swindle."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c7d2851-8186-4618-8baf-5b9c87cf1559",
                                                "sense_id": "b5f946fa-2a54-32f1-accd-78cf74a9bb72",
                                                "text": "Fred was sacked when the auditors caught him fiddling the books."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb9078ee-658d-3f53-96fb-0f4d2c62c57c",
                                        "entry_id": "9e264986-2541-35c6-921b-7bf66c7e8a3f",
                                        "glosses": [
                                            "To fidget or play; to fuss; to idly amuse oneself, to act aimlessly, idly, or frivolously, particularly out of nervousness or restlessness; see also fiddle with."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8ea9518-f834-481a-a329-d44a8372833e",
                                                "sense_id": "fb9078ee-658d-3f53-96fb-0f4d2c62c57c",
                                                "text": "Sit up straight and stop fiddling!"
                                            },
                                            {
                                                "example_id": "efdbc27f-70bf-4140-bafc-48fda44e30e4",
                                                "sense_id": "fb9078ee-658d-3f53-96fb-0f4d2c62c57c",
                                                "text": "Loke you fydell nat with your handes whan your maister speketh to you."
                                            },
                                            {
                                                "example_id": "8e002c9c-41b7-4093-8f67-49dd636e644c",
                                                "sense_id": "fb9078ee-658d-3f53-96fb-0f4d2c62c57c",
                                                "text": "[…] talking, and fiddling with their hats and feathers […]"
                                            },
                                            {
                                                "example_id": "01e66124-76fe-47fd-a84f-3ba08b8f0e79",
                                                "sense_id": "fb9078ee-658d-3f53-96fb-0f4d2c62c57c",
                                                "text": "Yossarian went along in Milo Minderbinder's speeding M & M staff car to police headquarters to meet a swarthy, untidy police commissioner with a narrow black mustache and unbuttoned tunic who was fiddling with a stout woman with warts and two chins when they entered his office and who greeted Milo with warm surprise and bowed and scraped in obscene servility as though Milo were some elegant marquis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0de788f6-2061-3940-8e13-5653279582cc",
                                        "entry_id": "9e264986-2541-35c6-921b-7bf66c7e8a3f",
                                        "glosses": [
                                            "Synonym of tinker (“to make small adjustments or improvements”); see also fiddle with."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f357a74d-bd1b-421f-b495-8a7f19120dfb",
                                                "sense_id": "0de788f6-2061-3940-8e13-5653279582cc",
                                                "text": "I don't exactly know how to fix this lawnmower; I'm really just fiddling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d4fb252-23a8-3690-ab92-8278f089ee38",
                                        "entry_id": "9e264986-2541-35c6-921b-7bf66c7e8a3f",
                                        "glosses": [
                                            "To do odd jobs for money."
                                        ],
                                        "tags": [
                                            "UK",
                                            "intransitive",
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90687893-fb67-488b-9201-d74a3742a20d",
                                                "sense_id": "6d4fb252-23a8-3690-ab92-8278f089ee38",
                                                "text": "A cake-seller told me that a little while before I saw him a lad of twelve or so had consumed a shilling’s worth of cakes and pastry, as he had got a shilling by “fiddling;” not, be it understood, by the exercise of any musical skill, for “fiddling,” among the initiated, means the holding of horses, or the performing of any odd jobs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fiddle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4e7297d-194e-3af2-b154-44d8d965788f",
                                        "entry_id": "8319d1ec-4638-32d3-b7a7-386c43a24ad8",
                                        "glosses": [
                                            "Synonym of fiddlesticks or euphemism for fuck."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d786c38-4ee4-441f-847d-47532d8a87f4",
                                                "sense_id": "b4e7297d-194e-3af2-b154-44d8d965788f",
                                                "text": "Oh, fiddle. I left my whip in the stable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
