                        "entry_id": "7470c7ea-58b0-3dbe-ac2e-73b6bd90be8d",
                        "glosses": [
                            "square (someone subscribing complacently to materialistic middle-class ideals)"
                        ],
                        "tags": [
                            "Switzerland",
