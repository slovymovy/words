                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fecb66f-2984-4b46-adb1-143fe81c53b1",
                                                "sense_id": "1902fe36-0c2a-36c5-9a48-baa649a07dd0",
                                                "text": "Mariner 10 poskytl snímky 45 % povrchu planety s rozlišením 1 km/pixel, objevil magnetické pole planety, zjistil přítomnost vodíku a hélia v tenké atmosféře (složení atomsféry bylo posléze na základě pozemních pozorování zpřesněno, v exosféře planety byla potvrzena přítomnost iontů sodíku, draslíku a vápníku)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
