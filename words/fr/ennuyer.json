    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9da3d3f4-3f59-31d1-89b0-772240ef1b32",
                    "sense_definition": "Éprouver de l'ennui, manquer d'intérêt pour ce que l'on fait ou ne pas savoir comment s'occuper.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "etat_ennui",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant les vacances d'hiver, les enfants s'<w>ennuient</w> souvent à la maison."
                        },
                        {
                            "text": "Je m'<w>ennuie</w> tellement que j'ai décidé de lire un livre en entier."
                        }
                    ],
                    "common_phrases": [
                        "s'ennuyer à mourir"
                    ]
                },
                {
                    "sense_id": "18f53c58-c87b-389c-b4d6-2dc122dba780",
                    "sense_definition": "Causer de l'ennui à quelqu'un par manque d'intérêt, monotonie ou excès de longueur.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "causer_ennui",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce long discours monotone risque d'<w>ennuyer</w> les auditeurs de la conférence."
                        },
                        {
                            "text": "Le conférencier <w>ennuie</w> tout le monde avec ses anecdotes interminables."
                        }
                    ],
                    "synonyms": [
                        "lasser"
                    ],
                    "antonyms": [
                        "intéresser"
                    ]
                },
                {
                    "sense_id": "ae3bf4f5-4685-3ed4-9e36-05574f591ae0",
                    "sense_definition": "Contrarier, déranger ou causer du désagrément à quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "contrariete",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cela m'<w>ennuie</w> de devoir annuler notre rendez-vous au dernier moment."
                        },
                        {
                            "text": "Le bruit constant des travaux <w>ennuie</w> tous les voisins de l'immeuble."
                        }
                    ],
                    "common_phrases": [
                        "ennuyer le monde"
                    ]
                },
                {
                    "sense_id": "1fa74cb2-42a7-34a9-8514-97f6221fc03a",
                    "sense_definition": "Ressentir de la tristesse ou de la mélancolie en raison de l'absence de quelqu'un ou de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nostalgie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis son départ à l'étranger, elle s'<w>ennuie</w> de ses amis d'enfance."
                        },
                        {
                            "text": "Tu es parti depuis une semaine et je m'<w>ennuie</w> déjà beaucoup de toi."
                        }
                    ],
                    "common_phrases": [
                        "s'ennuyer de sa famille",
                        "s'ennuyer de son pays"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Courant au Québec ou dans un style littéraire"
                        }
                    ]
                }
            ]
        }
    ]
