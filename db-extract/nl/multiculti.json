                                "sense_id": "e3fde2ed-a837-379f-8187-faf171b4e701",
                                "text": "2012, Jan Kuitenbrouwer, De woorden van Wilders en hoe ze werken, De Bezige Bij, quoting Geert Wilders.\n'Het is weer zo'n afschuwelijk multiculti-plan vol met softe maatregelen, zoals we van PvdA-ministers gewend zijn.'",
                                "translation": "(please add an English translation of this quotation)",
                                "english": "(please add an English translation of this quotation)"
                            },
                            {
                                "example_id": "da41256f-960e-428d-8fcd-8b850319e14f",
                                "sense_id": "e3fde2ed-a837-379f-8187-faf171b4e701",
                                "text": "Van cultuurrelativisme tot multiculti. Zeg maar culturele zelfverminking.",
                                "translation": "From cultural relativism to multiculti. Let's say cultural self-mutilation.",
                                "english": "From cultural relativism to multiculti. Let's say cultural self-mutilation."
                            },
                            {
                                "example_id": "eebe8230-0d52-49cd-abb8-82aff0ab60a6",
                                "sense_id": "e3fde2ed-a837-379f-8187-faf171b4e701",
                                "text": "De multiculti-elite staat ook hier steeds meer alleen.",
                                "translation": "Here too the multiculti elite is increasingly isolated.",
                                "english": "Here too the multiculti elite is increasingly isolated."
                            },
                            {
                                "example_id": "78ead84e-d2c9-4082-91c8-bf564cf75089",
                                "sense_id": "e3fde2ed-a837-379f-8187-faf171b4e701",
                                "text": "Het leven is goed én goedkoop in multiculti, levendig Kreuzberg.",
                                "translation": "Life is good and affordable in multiculti, vibrant Kreuzberg.",
                                "english": "Life is good and affordable in multiculti, vibrant Kreuzberg."
                            }
                        ]
                    }
