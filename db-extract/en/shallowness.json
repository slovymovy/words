                        "entry_id": "51214613-3f98-36b4-bc17-d7af59408e7f",
                        "glosses": [
                            "The property of being shallow; having little depth."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "9d9e011b-c946-4060-9c56-efc27df32079",
                                "sense_id": "1df2f2c0-d2e2-3492-bab0-a2c6f1f07f90",
                                "text": "The dimensions of the ships used on this service have always been restricted by the shallowness of the Lymington River, although the Lymington was somewhat larger than her predecessors, and was the first steel vessel built for this service."
                            }
                        ]
                    }
                ],
