                        "glosses": [
                            "wedstrijd die gaat om de 3de en 4de plaats van een toernooi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ddca944-7844-4d89-bb10-007d597f51a1",
                                "sense_id": "d8158038-c1f8-318d-9d0b-ad69154941c1",
                                "text": "Interessant wordt wat de UEFA gaat doen met het finaletoernooi van de Nations League. De halve finales zijn op 2 en 3 juni, de finale en de troostfinale worden op 6 juni gespeeld, vijf dagen voor het begin van het EK."
                            },
                            {
                                "example_id": "33b58c50-6116-4b93-a174-97b9e62416b2",
                                "sense_id": "d8158038-c1f8-318d-9d0b-ad69154941c1",
                                "text": "Laurine van Riessen schopte het op de keirin tot de halve finales, maar werd daarin veroordeeld tot de troostfinale. Voor Shanne Braspennincx, winnares van WK-zilver in 2015, zat het toernooi er in de kwartfinales al op."
                            }
                        ]
                    }
