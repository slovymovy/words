                                        "examples": [
                                            {
                                                "example_id": "700047ef-6a0c-4d3d-86cd-618e0b7575e4",
                                                "sense_id": "618b2c54-e337-3294-81b4-7dcc609d171f",
                                                "text": "Après quatre années d’enquête, l’exécutif européen a rendu son verdict : la loi de 1929 qui régente les holdings luxembourgeois est aussi illégale qu’anticoncurrentielle. (L’Écho Républicain, nᵒ 19.336, 20 juillet 2006)"
                                            },
                                            {
                                                "example_id": "e9b7226f-21d3-4548-8aba-f18c2e2336f3",
                                                "sense_id": "618b2c54-e337-3294-81b4-7dcc609d171f",
                                                "text": "Les vedettes des pratiques anticoncurrentielles en 2016-1027 ? Des mannequins, des fabricants de boules de pétanque, de tire-bouchons ou des rois du forfait… téléphonique."
                                            },
                                            {
                                                "example_id": "430e1cc4-b73d-4d4e-afb8-6abb449e9551",
                                                "sense_id": "618b2c54-e337-3294-81b4-7dcc609d171f",
                                                "text": "Les ententes anticoncurrentielles se forment à tous les échelons territoriaux (communaux, départementaux, régionaux, nationaux et européens) selon l’enjeu économique du contrat."
                                            },
                                            {
                                                "example_id": "6f69efb2-1d07-495a-87fb-47f75a848b79",
                                                "sense_id": "618b2c54-e337-3294-81b4-7dcc609d171f",
                                                "text": "Selon Reuters, le régulateur antitrust français, à savoir l'Autorité de la concurrence, pourrait poursuivre la firme américaine en justice pour des pratiques anticoncurrentielles présumées."
                                            }
                                        ]
