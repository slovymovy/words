                    "frequency": "VeryLow",
                    "semantic_group_id": "small",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>pinpoint</w> pricked her finger.",
                            "target_lang_translations": {
                                "pl": "<w>Czubek szpilki</w> ukłuł ją w palec."
                            }
                        },
                        {
                            "text": "He felt the sharp <w>pinpoint</w> against his skin.",
                            "target_lang_translations": {
