{
    "word_family": [
        "soft",
        "soften",
        "softness",
        "softener"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "e1c62db8-34ed-3a11-aee0-ff19395ac13d",
                    "sense_definition": "In a quiet way; with a low volume.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please speak <w>softly</w> while we are in the library.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, говорите <w>тихо</w>, пока мы в библиотеке.",
                                "zh": "在图书馆里请<w>低声</w>说话。",
                                "es": "Por favor, hable <w>suavemente</w> mientras estemos en la biblioteca."
                            }
                        },
                        {
                            "text": "The music played <w>softly</w> in the background during dinner.",
                            "target_lang_translations": {
                                "ru": "Во время ужина на заднем плане <w>тихо</w> играла музыка.",
                                "zh": "晚餐时，背景音乐<w>轻轻地</w>响着。",
                                "es": "La música sonaba <w>suavemente</w> de fondo durante la cena."
                            }
                        }
                    ],
                    "synonyms": [
                        "quietly",
                        "faintly"
                    ],
                    "antonyms": [
                        "loudly",
                        "noisily"
                    ],
                    "common_phrases": [
                        "speak softly",
                        "whisper softly",
                        "play softly",
                        "sing softly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тихо; с низкой громкостью.",
                        "zh": "以安静的方式；音量低。",
                        "es": "De manera silenciosa; con poco volumen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тихо",
                                "target_lang_sense_clarification": "не издавая громких звуков"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轻轻地",
                                "target_lang_sense_clarification": "形容声音小，不吵闹"
                            },
                            {
                                "target_lang_word": "低声地",
                                "target_lang_sense_clarification": "指说话声音小"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "silenciosamente",
                                "target_lang_sense_clarification": "sin hacer ruido o con muy poco volumen"
                            },
                            {
                                "target_lang_word": "en voz baja",
                                "target_lang_sense_clarification": "hablando con un volumen reducido"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4551f94e-68f1-3d23-ae50-d674eb05c9c6",
                    "sense_definition": "In a gentle or delicate way; without force or roughness.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He closed the door <w>softly</w> so he would not disturb anyone.",
                            "target_lang_translations": {
                                "ru": "Он <w>мягко</w> закрыл дверь, чтобы никого не побеспокоить.",
                                "zh": "他<w>轻轻地</w>关上门，以免打扰到别人。",
                                "es": "Cerró la puerta <w>suavemente</w> para no molestar a nadie."
                            }
                        },
                        {
                            "text": "The snow fell <w>softly</w> on the frozen ground.",
                            "target_lang_translations": {
                                "ru": "Снег <w>мягко</w> падал на мерзлую землю.",
                                "zh": "雪<w>轻柔地</w>落在冰冻的地面上。",
                                "es": "La nieve caía <w>suavemente</w> sobre el suelo helado."
                            }
                        }
                    ],
                    "synonyms": [
                        "gently",
                        "delicately",
                        "tenderly",
                        "quietly",
                        "lightly"
                    ],
                    "antonyms": [
                        "roughly",
                        "harshly",
                        "hard"
                    ],
                    "common_phrases": [
                        "tread softly",
                        "touch softly",
                        "land softly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягко или нежно; без применения силы или грубости.",
                        "zh": "以温柔或细腻的方式；不粗鲁或用力。",
                        "es": "De manera delicada o gentil; sin fuerza ni brusquedad."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мягко",
                                "target_lang_sense_clarification": "аккуратно, плавно; без толчков"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "温柔地",
                                "target_lang_sense_clarification": "形容动作轻柔，带有感情"
                            },
                            {
                                "target_lang_word": "轻柔地",
                                "target_lang_sense_clarification": "形容动作轻缓，不生硬"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "suavemente",
                                "target_lang_sense_clarification": "con delicadeza, sin brusquedad"
                            },
                            {
                                "target_lang_word": "delicadamente",
                                "target_lang_sense_clarification": "con cuidado y suavidad"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "542c7fdf-2b24-3255-ab69-d5f75b7a5870",
                    "sense_definition": "With a gentle appearance, especially regarding light or color; not brightly or harshly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The room was <w>softly</w> lit by a few candles on the table.",
                            "target_lang_translations": {
                                "ru": "Комната была <w>мягко</w> освещена несколькими свечами на столе.",
                                "zh": "桌上的几支蜡烛将房间照得十分<w>柔和</w>。",
                                "es": "La habitación estaba <w>suavemente</w> iluminada por unas pocas velas sobre la mesa."
                            }
                        },
                        {
                            "text": "We could see the mountains glowing <w>softly</w> in the distance.",
                            "target_lang_translations": {
                                "ru": "Мы видели горы, <w>мягко</w> светящиеся вдалеке.",
                                "zh": "我们可以看到远处的山峦在<w>柔和地</w>发着光。",
                                "es": "Podíamos ver las montañas brillando <w>suavemente</w> en la distancia."
                            }
                        }
                    ],
                    "synonyms": [
                        "dimly"
                    ],
                    "antonyms": [
                        "brightly"
                    ],
                    "common_phrases": [
                        "softly lit",
                        "softly colored",
                        "softly glowing"
                    ],
                    "target_lang_definitions": {
                        "ru": "С мягким оттенком (о свете или цвете); не ярко и не резко.",
                        "zh": "指光线或色彩柔和，不刺眼或不强烈。",
                        "es": "Con una apariencia suave, especialmente en relación con la luz o el color; no brillante ni intenso."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мягко",
                                "target_lang_sense_clarification": "приятно для глаз, не резко"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "柔和地",
                                "target_lang_sense_clarification": "形容光线或色彩不刺眼"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "suavemente",
                                "target_lang_sense_clarification": "de forma tenue, agradable a la vista"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}