                        "entry_id": "1191ef12-58ca-3824-8e90-f0fcbee4bb39",
                        "glosses": [
                            "Qualité de ce qui est mince."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36234927-849a-4e6a-b45c-ab9a367d8305",
                                "sense_id": "2b98feb1-6fbd-3258-8789-8f59d77b512f",
                                "text": "La minceur de la taille."
                            },
                            {
                                "example_id": "5b3ba0d0-7e22-4af3-a944-0ca0543b7445",
                                "sense_id": "2b98feb1-6fbd-3258-8789-8f59d77b512f",
                                "text": "La minceur d’une étoffe."
                            },
                            {
                                "example_id": "24b57808-649b-4442-b241-5092f02c2865",
                                "sense_id": "2b98feb1-6fbd-3258-8789-8f59d77b512f",
                                "text": "Un jour, je demande à Yuko le secret de sa minceur."
                            },
                            {
                                "example_id": "599f51e9-ce44-4439-ae9e-7be8b73a7fcb",
                                "sense_id": "2b98feb1-6fbd-3258-8789-8f59d77b512f",
                                "text": "Au contraire, c'est par la minceur désormais que les classes supérieures vont vouloir se démarquer du corps gras devenu « vulgaire », celui de l'ouvrier, du corps productif « bien nourri »."
                            }
                        ]
                    }
