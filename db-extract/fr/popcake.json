                                    {
                                        "sense_id": "b31e1734-ab82-30d6-9ffc-0da5d5da57fb",
                                        "entry_id": "7c890637-039f-341d-b3fa-69ee73c4cea2",
                                        "glosses": [
                                            "A confection consisting of a round piece of cake coated in icing or chocolate and stuck on a stick in the manner of a lollipop."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0628122-5ec5-4e42-8f39-dc64fbd751d7",
                                                "sense_id": "b31e1734-ab82-30d6-9ffc-0da5d5da57fb",
                                                "text": "The holidays are one of my favorite times of the year to make cake pops."
                                            },
                                            {
                                                "example_id": "6cb18d42-067a-4171-952a-ceed3341b9ba",
                                                "sense_id": "b31e1734-ab82-30d6-9ffc-0da5d5da57fb",
                                                "text": "Before you start it's best to pierce the holes into the polystyrene block that will hold the cake pops."
                                            },
                                            {
                                                "example_id": "0e199a21-dc12-4053-9017-a6e90df0e7f9",
                                                "sense_id": "b31e1734-ab82-30d6-9ffc-0da5d5da57fb",
                                                "text": "“Maybe this will cheer you up.” Paige whipped the cutest cellophane-wrapped cake pop out of her tote, decorated like a mini pumpkin all the way down to the stem."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
