                                "target_senses": [
                                    {
                                        "sense_id": "b4515362-f5cb-3b8a-bc9f-c98234ed2bc1",
                                        "entry_id": "fb510699-f4d2-3406-994f-976735f55673",
                                        "glosses": [
                                            "An assistant rector or vicar."
                                        ],
                                        "tags": [],
