                        "examples": [
                            {
                                "example_id": "53bc0529-9c00-41de-9894-e7ef8eb77638",
                                "sense_id": "4d5909ed-67f3-3570-a82b-5498d3f18f5e",
                                "text": "' `Het gaat over de rechtzetting van een bericht dat de eer van een lid van mijn familie aantast."
                            },
                            {
                                "example_id": "c2e1eccc-f50b-40bb-b72f-650aa29126eb",
                                "sense_id": "4d5909ed-67f3-3570-a82b-5498d3f18f5e",
                                "text": "' In hoofdstuk 21 is Dumas overigens zijn eigen rechtzetting vergeten, want daar heet het dat Dantès door de smokkelaars uit zee wordt opgevist op 28 februari 1829, 'op de dag' veertien jaar na zijn arrestatie."
                            },
                            {
                                "example_id": "ba3318a9-266e-417b-86e2-cdb94ac83ce9",
                                "sense_id": "4d5909ed-67f3-3570-a82b-5498d3f18f5e",
                                "text": "Wel schrijft hij dat het huwelijk met Mathilde heeft geleid tot vier kinderen, die met liefde worden omringd. \"Het is in alle sereniteit dat ik deze rechtzetting aanbreng\", schrijft de prins."
                            }
                        ]
                    }
