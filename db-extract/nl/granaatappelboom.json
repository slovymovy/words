                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85a2e41d-71f6-47d8-88aa-bb9ae104f4be",
                        "source_entry_id": "94cc1e0b-3af7-3448-a159-5d421a7f322c",
                        "source_sense_id": "78679a5c-220a-312f-9786-cecefcbfb9c1",
