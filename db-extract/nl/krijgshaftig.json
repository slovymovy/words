                "senses": [
                    {
                        "sense_id": "1134f07f-e463-3434-a66d-da967abb8794",
                        "entry_id": "37be66cc-47f7-3b09-9e57-7eca21fad9ef",
                        "glosses": [
                            "geschikt en geneigd om oorlog te voeren"
                        ],
                        "tags": [],
