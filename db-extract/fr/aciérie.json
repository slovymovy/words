                    {
                        "sense_id": "9830dd56-b7c9-33f7-81c6-97d6847d2319",
                        "entry_id": "e4334547-c651-3e5a-b51e-bc5aba7ddd7c",
                        "glosses": [
                            "Usine où l’on fabrique l’acier."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "d167e21f-37a7-4cfa-b115-ca79663869c1",
                                "sense_id": "9830dd56-b7c9-33f7-81c6-97d6847d2319",
                                "text": "Les travaux ont été conduits rapidement et la nouvelle aciérie à l'oxygène fut mise en service le 25 septembre 1967."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f4e7194f-47f6-42af-9006-c81ceba51ea1",
                        "source_entry_id": "e4334547-c651-3e5a-b51e-bc5aba7ddd7c",
                        "source_sense_id": "9830dd56-b7c9-33f7-81c6-97d6847d2319",
                        "target_lang_word": "Stahlfabrik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stahlfabrik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05ca6c29-777c-31b9-80fb-d4e6fbbca064",
                                        "entry_id": "564decc6-7c6f-35bf-b0a2-bb0c35b2616f",
                                        "glosses": [
                                            "Fabrik für Stahl und seine Verarbeitung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6de35687-70c6-4dcf-b5b3-bc0525b23a25",
                                                "sense_id": "05ca6c29-777c-31b9-80fb-d4e6fbbca064",
                                                "text": "„Alte Fabriken, Panzer und andere Fahrzeuge wurden ausgeschlachtet, Strom- und Telefonmasten abgeschlagen, um an das Eisen zu kommen, das dann an Stahlfabriken in Lahore verkauft wurden.“"
                                            },
                                            {
                                                "example_id": "7e617913-3257-4136-ac1c-14b59e66f521",
                                                "sense_id": "05ca6c29-777c-31b9-80fb-d4e6fbbca064",
                                                "text": "„Das reichte, damit Doc wusste, dass er für ihn das Tor zur alten Stahlfabrik offen lassen sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d86a606d-7d2b-498c-96b4-4673e0033446",
                        "source_entry_id": "e4334547-c651-3e5a-b51e-bc5aba7ddd7c",
                        "source_sense_id": "9830dd56-b7c9-33f7-81c6-97d6847d2319",
                        "target_lang_word": "Stahlhütte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "be9d15ac-cf25-477a-927e-445c1ba60cf4",
                        "source_entry_id": "e4334547-c651-3e5a-b51e-bc5aba7ddd7c",
                        "source_sense_id": "9830dd56-b7c9-33f7-81c6-97d6847d2319",
                        "target_lang_word": "Stahlwerk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stahlwerk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e58875b4-d8b2-3034-acda-30620f4f1a57",
                                        "entry_id": "0e38579e-d0d3-3cd3-8746-38733d20fcc5",
                                        "glosses": [
                                            "ein Werk, das Stahl herstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "626ee860-42f8-4dd8-bccb-c4d5ffc4dc69",
                                                "sense_id": "e58875b4-d8b2-3034-acda-30620f4f1a57",
                                                "text": "Das ehemalige Stahlwerk ist heute eine Ruine."
                                            },
                                            {
                                                "example_id": "f1572485-455c-42b2-bc11-7b51bbbc9a77",
                                                "sense_id": "e58875b4-d8b2-3034-acda-30620f4f1a57",
                                                "text": "„Denn ein sehr großer Teil der CO₂-Einsparung in Rohrdorf geht schon jetzt auf eine geänderte Rezeptur mit einen höheren Anteil etwa von Hochofenschlacke aus Stahlwerken zurück.“"
                                            },
                                            {
                                                "example_id": "df92f94e-3fa6-4e79-9ca5-ce2a5d299795",
                                                "sense_id": "e58875b4-d8b2-3034-acda-30620f4f1a57",
                                                "text": "„Puyi fühlte sich in seiner Rolle nicht ganz wohl, denn er hatte kaum anderes zu tun, als japanische Verordnungen zu unterzeichnen und Stahlwerke, Straßenbrücken und Eisenbahnlinien zu eröffnen.“"
                                            },
                                            {
                                                "example_id": "90ca6ff9-07a0-445d-aed3-fb8e78086c13",
                                                "sense_id": "e58875b4-d8b2-3034-acda-30620f4f1a57",
                                                "text": "„Großes Gewicht maßen die Sowjets Stahlwerken, der Sperrholzindustrie und Hydrieranlagen bei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
