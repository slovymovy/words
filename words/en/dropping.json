        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fb740f0d-254d-311f-a350-2d243a985713",
                    "sense_definition": "Solid waste passed from the body of an animal or bird.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We identified the animal by the <w>droppings</w> it left on the trail.",
                            "target_lang_translations": {
                                "ru": "Мы определили животное по <w>помёту</w>, который оно оставило на тропе.",
                                "pl": "Zidentyfikowaliśmy zwierzę po <w>odchodach</w>, które zostawiło na szlaku."
                            }
                        },
                        {
                            "text": "The park bench was covered in bird <w>droppings</w>.",
                            "target_lang_translations": {
                                "ru": "Скамейка в парке была покрыта птичьим <w>помётом</w>.",
                                "pl": "Ławka w parku była pokryta ptasimi <w>odchodami</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "dung",
                        "excrement",
                        "feces",
                        "scat"
                    ],
                    "common_phrases": [
                        "bird droppings",
                        "mouse droppings",
                        "animal droppings"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердые отходы жизнедеятельности животного или птицы.",
                        "pl": "Stałe odchody wydalane przez organizm zwierzęcia lub ptaka."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "помёт",
                                "target_lang_sense_clarification": "экскременты птиц и зверей"
                            },
                            {
                                "target_lang_word": "навоз",
                                "target_lang_sense_clarification": "удобрение, экскременты скота"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "odchody",
                                "target_lang_sense_clarification": "ogólne określenie wydalin zwierzęcych"
                            },
                            {
                                "target_lang_word": "kał",
                                "target_lang_sense_clarification": "termin biologiczny"
                            },
                            {
                                "target_lang_word": "pomiot",
                                "target_lang_sense_clarification": "odchody ptasie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ad76d4e-ce53-326a-8af7-c50c6b72a0d6",
                    "sense_definition": "The act of falling or causing something to fall.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>dropping</w> of the heavy curtain signaled the end of the play.",
                            "target_lang_translations": {
                                "ru": "Внезапное <w>опускание</w> тяжелого занавеса возвестило об окончании пьесы.",
                                "pl": "Nagłe <w>opuszczenie</w> ciężkiej kurtyny zasygnalizowało koniec sztuki."
                            }
                        },
                        {
                            "text": "Constant <w>dropping</w> of water will eventually wear away the stone.",
                            "target_lang_translations": {
                                "ru": "Постоянное <w>капание</w> воды в конечном итоге сточит камень.",
                                "pl": "Ciągłe <w>kapanie</w> wody w końcu wydrąży kamień."
                            }
                        }
                    ],
                    "synonyms": [
                        "fall",
                        "descent",
                        "plunge"
                    ],
                    "antonyms": [
                        "rising",
                        "lifting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт падения или приведения чего-либо в падение.",
                        "pl": "Akt spadania lub powodowania, że coś spada."
                    },
