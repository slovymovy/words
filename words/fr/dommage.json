                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce vieux récit, le garde champêtre surveillait quiconque était en <w>dommage</w>."
                        },
                        {
                            "text": "Ce jeune garçon indiscipliné passait ses journées à être en <w>dommage</w> dans les champs voisins."
                        }
                    ],
