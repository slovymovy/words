                                    {
                                        "sense_id": "4b816b44-dc5f-3031-9179-b03252792635",
                                        "entry_id": "9fa2a95c-5112-37a6-b9b1-1ca070efb076",
                                        "glosses": [
                                            "A powerful synthetic hallucinogen."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45c9af77-8374-4161-9197-e8545d5ff0a3",
                                                "sense_id": "4b816b44-dc5f-3031-9179-b03252792635",
                                                "text": "As surely as that winter of 1970 turned to spring, lysergic acid deithylamide made its grand entrance into my life."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24513540-5c59-4c68-9316-7643f0372b61",
                        "source_entry_id": "05fe439f-f302-38cc-8c83-8045223c6d92",
                        "source_sense_id": "77b6cd16-888b-3e53-8814-caf16cf76ea2",
                        "source_sense_description": "Chemie: halluzinogene Droge (Alkaloid aus dem Mutterkorn, heute synthetisch hergestellt)",
                        "target_lang_word": "diéthylamide d’acide lysergique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "382f13aa-5e8d-4cef-9fbd-f4e96296cf65",
                        "source_entry_id": "05fe439f-f302-38cc-8c83-8045223c6d92",
                        "source_sense_id": "77b6cd16-888b-3e53-8814-caf16cf76ea2",
                        "source_sense_description": "Chemie: halluzinogene Droge (Alkaloid aus dem Mutterkorn, heute synthetisch hergestellt)",
                        "target_lang_word": "LSD",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "LSD",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "13e23059-16e0-3070-97c3-984e2ab1ce22",
                                        "entry_id": "8ef77bc5-466f-3571-a493-62649cdc8ea7",
                                        "glosses": [
                                            "Composé organique de la famille des ergolines, le diéthylamide de l’acide lysergique, dérivé de l’acide lysergique présent dans l’ergot de seigle, connu comme un hallucinogène très puissant actif à de très faibles doses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1aab6d0-9217-4230-93ed-3451a1c0cdb7",
                                                "sense_id": "13e23059-16e0-3070-97c3-984e2ab1ce22",
                                                "text": "Tout ici, tout ce qui se mange et qui se boit, est drogué : il y a 35,000 microgrammes de LSD dans les bonbonnes de cidre, de la mescaline dans la salade de carotte, du peyote dans le poulet, du LSD encore dans le pain."
                                            },
                                            {
                                                "example_id": "726ac6f0-cb49-44a9-8a07-c4ce1edab3ed",
                                                "sense_id": "13e23059-16e0-3070-97c3-984e2ab1ce22",
                                                "text": "Le LSD est un puissant hallucinogène qui modifie intensément les sensations et les perceptions."
                                            },
                                            {
                                                "example_id": "6d9266fc-a782-4e6d-8765-9b391725f3b4",
                                                "sense_id": "13e23059-16e0-3070-97c3-984e2ab1ce22",
                                                "text": "Pour moi, le LSD est un voyage au plus profond de soi, qui permet parfois de mieux se découvrir ou tout simplement de tripper et de passer un bon moment. Sauf que j’ai l’impression que ce bad m’a fait prendre conscience de mon inconscient, et j’peux vous dire que dans mon inconscient, c’est le gros bordel."
                                            },
                                            {
                                                "example_id": "841222b0-f142-4437-9d6e-1e6e437d98ba",
                                                "sense_id": "13e23059-16e0-3070-97c3-984e2ab1ce22",
                                                "text": "Malgré sa réputation sulfureuse et ses effets secondaires très dangereux, le LSD a été l’objet de plusieurs études mettant en avant ses vertus médicales, notamment pour booster l’énergie et réduire l’alcoolisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
