                    {
                        "translation_id": "cc3398eb-5622-400f-bcd7-d6e9460f34e0",
                        "source_entry_id": "5a0ad147-d04a-319b-9069-8ae5b1fcd52a",
                        "source_sense_id": "70ba07b0-2d45-3b51-a058-3c9873ed95b4",
                        "source_sense_description": "estimate based on insufficient or unreliable data",
                        "target_lang_word": "à vue de nez",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à vue de nez",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "baa5d9fe-ef79-3c33-a965-91661efadf76",
                                        "entry_id": "b3098b6c-3fb7-3503-98f8-6e1f9aabc2be",
                                        "glosses": [
                                            "Intuitivement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34530c23-5df6-4a6b-a91a-c45d78eaab3c",
                                                "sense_id": "baa5d9fe-ef79-3c33-a965-91661efadf76",
                                                "text": "J’y suis allé à vue de nez."
                                            },
                                            {
                                                "example_id": "74631b8a-f630-4bb3-9f44-612c2b378583",
                                                "sense_id": "baa5d9fe-ef79-3c33-a965-91661efadf76",
                                                "text": "Je dirais à vue de nez que ce n’est pas la raison de son départ."
                                            },
                                            {
                                                "example_id": "f686421c-8772-4ef8-bd8a-6cc67b9db254",
                                                "sense_id": "baa5d9fe-ef79-3c33-a965-91661efadf76",
                                                "text": "Elle mesurait un bon mètre soixante-huit et pesait à vue de nez cinquante-huit kilos avec un tour de poitrine de 78 C et les doigts de pieds en éventail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1753a96-acea-3956-a8ac-9e943c8948f5",
                                        "entry_id": "b3098b6c-3fb7-3503-98f8-6e1f9aabc2be",
                                        "glosses": [
                                            "Approximativement, sans mesure précise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1e53112-6350-449f-bcc0-c4ea32ba4aa2",
                                                "sense_id": "c1753a96-acea-3956-a8ac-9e943c8948f5",
                                                "text": "J’ai dosé les ingrédients de cette recette à vue de nez."
                                            },
                                            {
                                                "example_id": "7a723ec2-2fb4-4611-bc55-942fc01d02f1",
                                                "sense_id": "c1753a96-acea-3956-a8ac-9e943c8948f5",
                                                "text": "Les trois rangées mises bout à bout auraient fait 120 pieds de longueur , & n'auraient du contenir que 240 plantes ; mais les distances que je ne réglais qu’ à vue de nez, n’étant pas exactement de six pouces, on sema 96 bouquets par rangée, ce qui en donna 16 de plus ; ainsi plusieurs de ces bouquets se font trouvés un peu plus près que six pouces les uns des autres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebd68af3-b8d3-3cec-93d9-f7eff00169bf",
                                        "entry_id": "b3098b6c-3fb7-3503-98f8-6e1f9aabc2be",
                                        "glosses": [
                                            "En première approximation, en se fiant à son expérience et ses connaissances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4769bac8-ab40-42a2-b6f0-9b6b56f522c9",
                                                "sense_id": "ebd68af3-b8d3-3cec-93d9-f7eff00169bf",
                                                "text": "À vue de nez, cette table ne vaut guère plus de vingt euros."
                                            },
                                            {
                                                "example_id": "3f04be99-49aa-4c5b-bdea-944c0fdf7a7a",
                                                "sense_id": "ebd68af3-b8d3-3cec-93d9-f7eff00169bf",
                                                "text": "Il m’a du reste semblé à vue de nez avoir partie liée avec votre père."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
