                                    {
                                        "sense_id": "fa56b384-6a78-30c8-b62e-fd26162a1a0b",
                                        "entry_id": "d1c77025-d53f-3757-a4a5-8f1d78153698",
                                        "glosses": [
                                            "действие по значению гл. ликовать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1e07dd5-95a8-4f4e-b425-447e419fd808",
                                                "sense_id": "fa56b384-6a78-30c8-b62e-fd26162a1a0b",
                                                "text": "Старший же сын его был на поле; и, возвращаясь, когда приблизился к дому, услышал пение и ликование …"
                                            }
                                        ]
                                    },
