                "senses": [
                    {
                        "sense_id": "185169fe-9f59-3b1c-b1d9-6efc4851d81d",
                        "entry_id": "aaeec478-b93b-37db-83c4-ba6bea8e1119",
                        "glosses": [
                            "Träger eines der zahlreichen höheren zivilen und militärischen Ämter"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "f126aa89-33ae-4be1-878c-08dd6b1cc07b",
                                "sense_id": "185169fe-9f59-3b1c-b1d9-6efc4851d81d",
                                "text": "„Kaum war der Anker ausgeworfen, als er [der Bailo] seine Flagge als Generalkapitän der Seestreitkräfte der Republik hissen und der Provveditore die seine streichen ließ.“"
                            },
                            {
                                "example_id": "6c91d6db-7f69-45fe-917a-291f64c884e8",
                                "sense_id": "185169fe-9f59-3b1c-b1d9-6efc4851d81d",
                                "text": "„Über das Meer wacht ihnen ein Provveditore, den sie mit sechs Galeeren nach Korfu, der Mitte ihrer Besitzungen, senden. “"
                            },
                            {
                                "example_id": "4c064383-f30f-4a55-92b4-2d1c88e44ee2",
                                "sense_id": "185169fe-9f59-3b1c-b1d9-6efc4851d81d",
                                "text": "„Denn auf dem Rückzuge mußte das Heer sich noch einmal zum Kampfe stellen und verlor etwa die Hälfte seiner Leute, so daß der eine Provveditore sich rettete und mit über 25 000 Mann zu Fuß und zu Pferde nach Verona kam. “"
                            },
                            {
                                "example_id": "3c318c49-108c-4cb4-ac82-80460ad079d3",
                                "sense_id": "185169fe-9f59-3b1c-b1d9-6efc4851d81d",
                                "text": "„»Voran, Herr Waser! Ihr seid mein verehrter Gast«, sagte der Schlanke, den jetzt Jenatsch und Wertmüller als den Provveditore der Republik mit höchster Ehrerbietung begrüßten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
