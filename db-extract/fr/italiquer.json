                "senses": [
                    {
                        "sense_id": "a48982cb-cee0-3f48-9b6a-7bf15c4e27bb",
                        "entry_id": "42816e03-64ee-3e7e-8545-0a9697780d58",
                        "glosses": [
                            "Écrire en italique."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "f002867f-d63b-4173-8a60-93b04c295c9f",
                                "sense_id": "a48982cb-cee0-3f48-9b6a-7bf15c4e27bb",
                                "text": "C’est pour ça que j’y suis et que j’y reste, bien à l’ombre, sirotant un thé glacé, parcourant vos courriels en somnolant, visionnant vos photos en bâillant, vous répondant en italiquant…"
                            },
                            {
                                "example_id": "8ca234f4-1529-4828-af35-365434448871",
                                "sense_id": "a48982cb-cee0-3f48-9b6a-7bf15c4e27bb",
                                "text": "Voilà pourquoi les auteures du Français au bureau recommandent d’italiquer les abréviations cf. (confer « reportez-vous à »), ibid. (ibidem « au même endroit »), id. (idem « le même »), i. e. (id est « c’est-à-dire » — forme à préférer), inf. (infra « ci-dessous »), loc. cit. (loco citato « à l’endroit cité »), op. cit. (opere citato « dans l’ouvrage cité »), sq. (sequiturque « et suivant »), sqq. (sequunturque « et suivants ») et v. g. (verbi gratia « exemple »)."
                            }
                        ]
                    }
