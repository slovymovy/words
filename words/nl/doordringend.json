            "senses": [
                {
                    "sense_id": "e1203602-dc14-3a2c-9d98-68efa04a97ab",
                    "sense_definition": "met een sterk vermogen om ergens doorheen te gaan, vaak met betrekking tot geluid, geur of een blik",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "waarneming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vrouw heeft een harde <w>doordringende</w> stem die boven de muziek uitkomt.",
                            "target_lang_translations": {
                                "en": "The woman has a loud <w>piercing</w> voice that rises above the music."
                            }
                        },
                        {
                            "text": "Uit de keuken kwam een <w>doordringende</w> geur van vers gebakken brood.",
                            "target_lang_translations": {
                                "en": "A <w>pervasive</w> smell of freshly baked bread came from the kitchen."
                            }
                        }
                    ],
                    "synonyms": [
                        "penetrant",
                        "schel",
                        "snijdend",
                        "scherp"
                    ],
                    "antonyms": [
                        "zacht",
                        "oppervlakkig"
                    ],
                    "common_phrases": [
                        "doordringende stem",
                        "doordringende geur",
                        "doordringende blik"
                    ],
                    "target_lang_definitions": {
                        "en": "having a strong ability to pass through something, often referring to sound, smell, or a look"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "piercing",
                                "target_lang_sense_clarification": "used for sounds and looks"
                            },
                            {
                                "target_lang_word": "penetrating",
                                "target_lang_sense_clarification": "used for looks, smells, and sounds"
                            },
                            {
                                "target_lang_word": "shrill",
                                "target_lang_sense_clarification": "specifically for high-pitched sounds"
                            },
                            {
                                "target_lang_word": "pungent",
                                "target_lang_sense_clarification": "specifically for strong smells"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ac1c67b0-dc72-3535-bde1-305fbcd15828",
                    "sense_definition": "onvoltooid deelwoord van <w>doordringen</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grammaticale vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Langzaam <w>doordringend</w> tot de kern van het probleem, vond hij eindelijk een oplossing.",
                            "target_lang_translations": {
                                "en": "Slowly <w>penetrating</w> to the core of the problem, he finally found a solution."
                            }
                        },
                        {
                            "text": "Het water is diep in de grond <w>doordringend</w> na de zware regenval.",
                            "target_lang_translations": {
                                "en": "The water is <w>soaking</w> deep into the ground after the heavy rainfall."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "onvoltooid deelwoord"
                        }
                    ],
                    "target_lang_definitions": {
