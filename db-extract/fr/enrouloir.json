                        "entry_id": "ca940860-8f00-345c-81c5-36a66f245501",
                        "glosses": [
                            "Cylindre sur lequel on enroule une pièce de tissu, un store, une voile etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c0f4986-be42-4da3-96bd-cee4012ebf1c",
                                "sense_id": "20301524-2fda-3f1a-adc3-ee08a47a9700",
                                "text": "Le tissu vient s’enrouler sur l’axe de l’enrouloir à mouvement continu, au fur et à mesure de la formation, sans choc ni interruption."
                            },
                            {
                                "example_id": "6b4640ad-fe6a-47bc-a067-da4d1a8d4d69",
                                "sense_id": "20301524-2fda-3f1a-adc3-ee08a47a9700",
                                "text": "Je développe la grosse sangle que je viens de prélever sur l’enrouloir du volet pliant."
                            },
                            {
                                "example_id": "9f4c53e7-c879-4cd0-b870-e807f270322a",
                                "sense_id": "20301524-2fda-3f1a-adc3-ee08a47a9700",
                                "text": "Et pourtant, chaque mois, il accroche la toile d’écran au mur, la déroule et garde dans sa main l’enrouloir dont il se sert pour taper sur la tête de ceux qui ne suivent pas."
                            }
                        ]
                    }
