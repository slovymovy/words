                "senses": [
                    {
                        "sense_id": "fecd962e-a029-3107-ae7c-3d6d0b3e9713",
                        "entry_id": "14e989bb-78ba-3a9f-bcdf-8873eb78c5b0",
                        "glosses": [
                            "Action d’élinguer, de lever une charge avec des élingues."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bb0b2b6-3ad7-4ff4-87c2-b593f4ab0132",
                                "sense_id": "fecd962e-a029-3107-ae7c-3d6d0b3e9713",
                                "text": "La capacité maximale d’utilisation d’une élingue multibrins est déterminée en tenant compte de la charge maximale d’utilisation du brin le plus faible, du nombre de brins et d’un facteur minorant qui dépend du mode d’élingage prévu."
                            },
                            {
                                "example_id": "cfd9db2d-bc8a-40c5-8d4d-0a41f2cc0fa0",
                                "sense_id": "fecd962e-a029-3107-ae7c-3d6d0b3e9713",
                                "text": "Dans la mesure où la plupart des éléments de décoration, d’éclairage et de sonorisation sont suspendus, il serait également utile que les salariés travaillant sur le plateau soient formés aux techniques de l’élingage, du levage ou à la manipulation des cintres."
                            },
                            {
                                "example_id": "66273b9f-f135-40b6-919b-04b694dedbe9",
                                "sense_id": "fecd962e-a029-3107-ae7c-3d6d0b3e9713",
                                "text": "Quelques minutes avant, il avait lui-même attaché la charge en faisant un élingage « en double panier »."
                            }
                        ]
                    }
                ],
