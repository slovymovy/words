                {
                    "sense_id": "1e7a031d-bf98-3120-8f70-788ce72117e4",
                    "sense_definition": "gemakkelijk te vouwen of in plooien te leggen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit dunne materiaal is heel <w>plooibaar</w> en past makkelijk in een tas.",
                            "target_lang_translations": {
                                "de": "Dieses dünne Material ist sehr <w>faltbar</w> und passt problemlos in eine Tasche."
                            }
                        },
                        {
                            "text": "Voor deze verpakking hebben we een stevig maar <w>plooibaar</w> karton nodig.",
                            "target_lang_translations": {
                                "de": "Für diese Verpackung benötigen wir einen stabilen, aber <w>biegsamen</w> Karton."
                            }
                        }
                    ],
                    "common_phrases": [
                        "plooibaar materiaal"
                    ],
                    "target_lang_definitions": {
                        "de": "leicht zu falten oder zusammenzulegen"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "faltbar",
                                "target_lang_sense_clarification": "zum Falten geeignet"
                            },
                            {
                                "target_lang_word": "knickbar",
                                "target_lang_sense_clarification": "lässt sich biegen oder falten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7b5135e-6b24-3c62-89b4-1d659afd9d22",
                    "sense_definition": "gemakkelijk te buigen zonder te breken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De takken van de jonge boom zijn nog erg <w>plooibaar</w>.",
                            "target_lang_translations": {
                                "de": "Die Äste des jungen Baumes sind noch sehr <w>biegsam</w>."
                            }
                        },
                        {
                            "text": "Koper is een zacht en <w>plooibaar</w> metaal dat gemakkelijk te bewerken is.",
                            "target_lang_translations": {
                                "de": "Kupfer ist ein weiches und <w>biegsames</w> Metall, das leicht zu bearbeiten ist."
                            }
                        }
                    ],
                    "synonyms": [
                        "soepel"
                    ],
                    "common_phrases": [
                        "plooibaar metaal"
                    ],
                    "target_lang_definitions": {
                        "de": "leicht zu biegen, ohne zu brechen"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "biegsam",
                                "target_lang_sense_clarification": "elastisch, flexibel biegend"
                            },
                            {
                                "target_lang_word": "geschmeidig",
                                "target_lang_sense_clarification": "gut formbar, elastisch"
                            },
                            {
                                "target_lang_word": "verformbar",
                                "target_lang_sense_clarification": "besonders bei Metallen oder Materialien"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e2528e0-6b39-3f6a-beec-4caa314edeb7",
                    "sense_definition": "bereid om zich aan te passen aan anderen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nieuwe directeur toont zich een <w>plooibaar</w> persoon tijdens moeilijke onderhandelingen.",
                            "target_lang_translations": {
                                "de": "Der neue Direktor erweist sich bei schwierigen Verhandlungen als <w>nachgiebige</w> Person."
                            }
                        },
                        {
                            "text": "Zijn karakter is niet erg <w>plooibaar</w>, waardoor conflicten snel escaleren.",
                            "target_lang_translations": {
                                "de": "Sein Charakter ist nicht sehr <w>anpassungsfähig</w>, weshalb Konflikte schnell eskalieren."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een plooibaar karakter"
                    ],
                    "target_lang_definitions": {
                        "de": "bereit, sich anderen anzupassen oder nachzugeben"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "nachgiebig",
                                "target_lang_sense_clarification": "bereit zu Kompromissen"
                            },
                            {
                                "target_lang_word": "fügsam",
                                "target_lang_sense_clarification": "sich leicht anpassend oder unterordnend"
                            },
                            {
                                "target_lang_word": "anpassungsfähig",
                                "target_lang_sense_clarification": "flexibel im Verhalten"
                            }
                        ]
                    }
                }
            ]
        }
    ]
