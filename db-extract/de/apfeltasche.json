                "senses": [
                    {
                        "sense_id": "70f61be6-0da3-38d1-b387-77f8d081761f",
                        "entry_id": "0f1cabc4-a516-30a2-9b89-385ad130fb14",
                        "glosses": [
                            "Gebäck in Form einer Tasche, das mit Äpfeln gefüllt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d7bc51f-17b1-4648-bd04-427fea2939b7",
                                "sense_id": "70f61be6-0da3-38d1-b387-77f8d081761f",
                                "text": "„Zum Programm der Kurverwaltung gehören Apfeltaschen backen mit Quark-Öl-Vollkornteig, Häkelketten mit Glasperlen, ganzheitliche Körperschulung, sanftes Nordic Walking, Ausdrucksmalerei und Hormon-Yoga.“"
                            },
                            {
                                "example_id": "fef0359b-7f7c-45d3-98f1-a67b8bcb1313",
                                "sense_id": "70f61be6-0da3-38d1-b387-77f8d081761f",
                                "text": "„Ein Reformationsbrötchen ist ein meist quadratisch aussehendes, süßes Gebäck, meist von der Größe einer Apfeltasche.“"
                            },
                            {
                                "example_id": "7ae1b061-31da-4bd4-b68a-9747066f15f3",
                                "sense_id": "70f61be6-0da3-38d1-b387-77f8d081761f",
                                "text": "„Dazu gehört das Anheizen des Gemeindebackhauses sowie die Verkostung der örtlichen Spezialitäten, der Panade, einer Art aus Brotteig gefertigten Apfeltasche und des hier angebauten Weines.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca33d24f-08a6-40aa-8195-799825631514",
                        "source_entry_id": "0f1cabc4-a516-30a2-9b89-385ad130fb14",
                        "source_sense_id": "70f61be6-0da3-38d1-b387-77f8d081761f",
                        "source_sense_description": "Gebäck in Form einer Tasche, das mit Äpfeln gefüllt ist",
                        "target_lang_word": "chausson aux pommes",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chausson aux pommes",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "837364fb-dd8f-37ae-a4bb-aca60b0b03c2",
                                        "entry_id": "cc773604-b644-34a7-ab0e-31c32e316d68",
                                        "glosses": [
                                            "Viennoiserie à base de pâte feuilletée de forme semi-circulaire ou triangulaire contenant le même type de garniture que dans la tarte aux pommes ; il se mange de préférence chaud."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bdf8214-102e-466d-b829-66b3864ce95e",
                                                "sense_id": "837364fb-dd8f-37ae-a4bb-aca60b0b03c2",
                                                "text": "— J’ai mangé des chaussons aux pommes, mais je n’ai jamais mangé des tartes à l’abricot, seulement j’en ai vu. Qu’est-ce que c’est que ces petites choses blanches qui sont collées sur la confiture jaune ?\n— Des amandes.\n— Oh !"
                                            },
                                            {
                                                "example_id": "9e426613-b01f-4c66-b9d7-d437b065b21e",
                                                "sense_id": "837364fb-dd8f-37ae-a4bb-aca60b0b03c2",
                                                "text": "Pour mes pauvres, je voudrais des chaussons aux pommes !"
                                            },
                                            {
                                                "example_id": "5cb982fa-8e37-4161-9f55-b8fd410e5e95",
                                                "sense_id": "837364fb-dd8f-37ae-a4bb-aca60b0b03c2",
                                                "text": "[…] ; les boulangers plaçaient les petits pains au chocolat et les chaussons aux pommes sous des présentoirs encadrés de laiton doré, comme des bijoux de joailliers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
