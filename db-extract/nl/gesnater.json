                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gaggling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5f3c8d0-46ab-375c-8a8d-6e3b1da477e1",
                                        "entry_id": "72824bd9-1885-3480-9762-54daee2a13cb",
                                        "glosses": [
                                            "The cackling sound of a goose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da50df49-6c61-4509-8ff3-f96773bf377c",
                                                "sense_id": "c5f3c8d0-46ab-375c-8a8d-6e3b1da477e1",
                                                "text": "[…] gold teeth, jewelry, and other belongings of the murdered were sorted out before dispatch to the Reich, and where several hundred geese not only provided meat for the SS-men, but with their gagglings also helped to drown the terrible cries […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4019d986-3cf6-4b37-bc51-9f1467ac2416",
                        "source_entry_id": "8485f137-4b1f-3ab9-9b1a-35765efc797f",
                        "source_sense_id": "af6a7982-e1a4-30fb-88ab-6388ac587002",
                        "source_sense_description": "geluid van ganzen en andere vogels",
                        "target_lang_word": "gaggle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gaggle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2979332e-cea1-3040-b4c0-7a3f629bfb87",
                                        "entry_id": "bdbd3bcb-7a8f-32e2-8422-413dfa1802b6",
                                        "glosses": [
                                            "A group of geese when they are on the ground or on the water."
                                        ],
                                        "tags": [
                                            "collective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d1092ab-d73d-42e2-8697-1835aee46145",
                                                "sense_id": "2979332e-cea1-3040-b4c0-7a3f629bfb87",
                                                "text": "The Canada geese always flew over the 80 acre lake; it was a landmark on their route and a stopping point for many a gaggle, where many hours were spent after feeding in the farmers' fields."
                                            },
                                            {
                                                "example_id": "4fcaf06e-2d81-4615-9136-8085ca8d1ac0",
                                                "sense_id": "2979332e-cea1-3040-b4c0-7a3f629bfb87",
                                                "text": "They're only referred to as a gaggle when they're on land. When they're flying in formation they can be referred to as a skein."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cf2b6fb-71e1-3c03-9adf-6b2b6f65537a",
                                        "entry_id": "bdbd3bcb-7a8f-32e2-8422-413dfa1802b6",
                                        "glosses": [
                                            "Any group or gathering of related things, particularly one perceived as noisy, boisterous or chaotic."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aac44553-0000-4170-a0d5-ef36d78366cd",
                                                "sense_id": "4cf2b6fb-71e1-3c03-9adf-6b2b6f65537a",
                                                "text": "There were no signs and no one quite knew how to navigate the museum, including, as it was Fleet Week, gaggles of boyish sailors all in their summer whites. It looked like a Frank Sinatra movie."
                                            },
                                            {
                                                "example_id": "56b6ee78-3b9d-4a4d-af04-bd9222055328",
                                                "sense_id": "4cf2b6fb-71e1-3c03-9adf-6b2b6f65537a",
                                                "text": "The crow’s name was Betty. And she was on her way to stardom. A gaggle of Oxford University scientists watched in wonder as she casually picked up a piece of wire in her cage and then used a nearby object to bend it at one end, transforming the wire into a hooked tool."
                                            },
                                            {
                                                "example_id": "69f439ad-64b3-4d19-a433-42c231eea81a",
                                                "sense_id": "4cf2b6fb-71e1-3c03-9adf-6b2b6f65537a",
                                                "text": "The party level ramps up at Thornaby, where a gaggle of women on a 50th birthday bash join us."
                                            },
                                            {
                                                "example_id": "b5c8e5a0-c1a9-422b-90e5-f161fde59b7e",
                                                "sense_id": "4cf2b6fb-71e1-3c03-9adf-6b2b6f65537a",
                                                "text": "Millwall were allocated 3,781 tickets for this six-mile trip down the south London train tracks. The away end was duly packed out and ringed, sternly, by a gaggle of widely jeered Metropolitan police."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff506868-3960-3b9c-96b3-792b1d374a39",
                                        "entry_id": "bdbd3bcb-7a8f-32e2-8422-413dfa1802b6",
                                        "glosses": [
                                            "Short for press gaggle: an informal briefing of journalists."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "088dc417-d9bf-49f5-8940-7666a41bbe63",
                                                "sense_id": "ff506868-3960-3b9c-96b3-792b1d374a39",
                                                "text": "Last week, Mr. Trump told the [Christian Science] Monitor during a gaggle with reporters that there were “about four” other states where Republicans should redraw the maps besides Texas."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gaggle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97d12302-b2a8-3f51-960d-c94b17d2a373",
                                        "entry_id": "37c1967c-5936-30f6-8fd1-44c6cfc99e2a",
                                        "glosses": [
                                            "To make a noise like a goose; to cackle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4f61dd6-3bcc-4cda-975b-be6b0a3ae211",
                                                "sense_id": "97d12302-b2a8-3f51-960d-c94b17d2a373",
                                                "text": "Geese do gaggle"
                                            },
                                            {
                                                "example_id": "2080bd73-8ae6-479a-8043-ca0efbaee51b",
                                                "sense_id": "97d12302-b2a8-3f51-960d-c94b17d2a373",
                                                "text": "When a friend asked Socrates, how he could bear the scolding of his wife Xantippe? he retorted, and asked him, how he could bear the gaggling of his geese?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1179807-d4d6-492e-ab3e-dd91d7febf9e",
                        "source_entry_id": "8485f137-4b1f-3ab9-9b1a-35765efc797f",
                        "source_sense_id": "af6a7982-e1a4-30fb-88ab-6388ac587002",
                        "source_sense_description": "geluid van ganzen en andere vogels",
                        "target_lang_word": "gabble",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gabble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c3cc94f-4cf6-3052-8019-a30ecc383653",
                                        "entry_id": "3c2b39d7-3714-36c2-915c-112099f36d9e",
                                        "glosses": [
                                            "To talk fast, idly, foolishly, or without meaning."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1896602d-64f2-4138-8bab-3bb214c579d2",
                                                "sense_id": "7c3cc94f-4cf6-3052-8019-a30ecc383653",
                                                "text": "Does she regard him simply as a workman come to do a job for her, someone whom she need never lay eyes on again; or is she gabbling to hide discomfiture?"
                                            },
                                            {
                                                "example_id": "426aaecd-94c1-4172-9be8-700d848e7b1c",
                                                "sense_id": "7c3cc94f-4cf6-3052-8019-a30ecc383653",
                                                "text": "I pitied thee, took pains to make thee speak, taught thee each hour one thing or other; when thou didst not, savage, know thine own meaning, but wouldst gabble like a thing most brutish"
                                            },
                                            {
                                                "example_id": "d8791a46-fc9d-4216-b01e-76e23ecbfdc9",
                                                "sense_id": "7c3cc94f-4cf6-3052-8019-a30ecc383653",
                                                "text": "Then he fell to gabbling strange and dreadful things which were not clearly understandable."
                                            },
                                            {
                                                "example_id": "d521c9b1-b1bb-4943-b33a-d398f37e1a57",
                                                "sense_id": "7c3cc94f-4cf6-3052-8019-a30ecc383653",
                                                "text": "Americans are always drinking in crossroads saloons on Sunday afternoon; they bring their kids; they gabble and brawl over brews; everything’s fine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f8a9cda-e496-319e-ab33-9182273418ce",
                                        "entry_id": "3c2b39d7-3714-36c2-915c-112099f36d9e",
                                        "glosses": [
                                            "To utter inarticulate sounds with rapidity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93d09dc3-e199-45cf-ac5b-bb6f3982985a",
                                                "sense_id": "9f8a9cda-e496-319e-ab33-9182273418ce",
                                                "text": "gabbling fowls"
                                            },
                                            {
                                                "example_id": "8f335da4-203a-4f54-b901-0a528c2d0f95",
                                                "sense_id": "9f8a9cda-e496-319e-ab33-9182273418ce",
                                                "text": "I not to Cinna’s Ears, nor Varus dare aſpire; / But gabble like a Gooſe; amidſt the Svvan-like Quire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gabble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "147245cc-db8c-3fc7-9dee-db250c841fba",
                                        "entry_id": "659780f4-ea63-371c-b488-453cc5b7e325",
                                        "glosses": [
                                            "Confused or unintelligible speech."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4181037-7871-4e15-aa5c-6822f1249e0b",
                                                "sense_id": "147245cc-db8c-3fc7-9dee-db250c841fba",
                                                "text": "a lot of gabble from witnesses"
                                            },
                                            {
                                                "example_id": "512c6c79-b33a-411f-b629-6ad242da0f58",
                                                "sense_id": "147245cc-db8c-3fc7-9dee-db250c841fba",
                                                "text": "[T]he driver was delayed there by a skimpy little woman with a thin piping voice practised in the art of defeating escape from it by a ceaseless stream of gabble."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
