                    },
                    {
                        "translation_id": "c4e9f826-079a-49a5-baf0-131453da6a02",
                        "source_entry_id": "ee9e1b38-f131-3591-a91e-b2f558e66366",
                        "source_sense_id": "df3ebcf2-70e9-3aca-b3c7-c2f0f5172f23",
                        "source_sense_description": "Botanik: Pflanze aus der Familie der Schmetterlingsblütler mit blauen Blütentrauben",
                        "target_lang_word": "глициния",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "глициния",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6af5ddf7-193e-3d44-9165-097424af11a2",
                                        "entry_id": "4090ee41-e9c3-3a4b-90d4-e9fb59045620",
                                        "glosses": [
                                            "ботан. субтропическое декоративное вьющееся растение семейства бобовых, крупная деревянистая листопадная лиана или кустарник с гроздьями душистых цветов (лат. Wisteria)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "788fe75a-7f4e-47ee-962c-90e4073267bf",
                                                "sense_id": "6af5ddf7-193e-3d44-9165-097424af11a2",
                                                "text": "Как на горах цветёт у него весной азалея и под осень одевается ярким пурпуром клён, летом же над верандой свешивает свои изящные нежно-фиолетовые кисти глициния."
                                            },
                                            {
                                                "example_id": "17dd9772-c3c9-4c7f-bd90-d6a45a192cd8",
                                                "sense_id": "6af5ddf7-193e-3d44-9165-097424af11a2",
                                                "text": "Он не видел ясного солнечного дня, не чувствовал нежной игры теней от листьев густых акаций, дубов и клёнов; глицинии на фасаде его дома, усеянные гроздьями лиловых цветов, его не радовали."
                                            },
                                            {
                                                "example_id": "65e27052-3a47-45fd-a312-4c18025f7335",
                                                "sense_id": "6af5ddf7-193e-3d44-9165-097424af11a2",
                                                "text": "Лиловые кисти глицинии, оплетавшей саклю, свисали в прорезях узких окон, наполняли двор дурманно-сладким запахом."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
