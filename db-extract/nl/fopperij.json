                    {
                        "translation_id": "791c680c-2fa6-438f-b1b3-963bba61eb1a",
                        "source_entry_id": "210114b1-a6f3-3ead-aad9-e5902a1c46c4",
                        "source_sense_id": "e1c722c7-5bbb-3226-bd18-0c54fa229243",
                        "target_lang_word": "deceit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deceit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e62ff7b8-8ba9-386b-b8ca-d3e269b0e008",
                                        "entry_id": "0e4cf68a-73a5-3fb2-819f-1450a7cb87b1",
                                        "glosses": [
                                            "An act or practice intended to deceive; a trick."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2790701d-0493-4467-acc2-b1e835c0d74b",
                                                "sense_id": "e62ff7b8-8ba9-386b-b8ca-d3e269b0e008",
                                                "text": "The whole conversation was merely a deceit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96931005-8db7-3a81-b766-d097550f1f56",
                                        "entry_id": "0e4cf68a-73a5-3fb2-819f-1450a7cb87b1",
                                        "glosses": [
                                            "An act of deceiving someone."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d6d0d6b-ae08-4327-8ef2-7c6768e7f223",
                                                "sense_id": "96931005-8db7-3a81-b766-d097550f1f56",
                                                "text": "Upon his return he killed Eriphyle for her vanity and deceit of him and his father."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "113fbae6-66ad-39c9-8353-931726517bf1",
                                        "entry_id": "0e4cf68a-73a5-3fb2-819f-1450a7cb87b1",
                                        "glosses": [
                                            "The state of being deceitful or deceptive."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e3a58f9-7f95-4a08-a826-abc70b30e07f",
                                                "sense_id": "113fbae6-66ad-39c9-8353-931726517bf1",
                                                "text": "[T]he tvvo commended rules by him [Aristotle] ſet down, vvhereby the axioms of Sciences are precepted to be made convertible, and vvhich the latter men have not vvithout elegancy ſurnamed; the one the rule of truth, becauſe it preventeth deceipt; the other the rule of prudence, becauſe it freeth election, are the ſame thing in ſpeculation and affirmation, vvhich vve novv obſerve."
                                            },
                                            {
                                                "example_id": "ea35b5ba-b222-4d49-8545-a5f85e99618e",
                                                "sense_id": "113fbae6-66ad-39c9-8353-931726517bf1",
                                                "text": "His mouth is full of curſing, and deceit, and fraud : vnder his tongue is miſchiefe and vanitie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6f0d8c4-8311-3986-ae3e-df267aef750b",
                                        "entry_id": "0e4cf68a-73a5-3fb2-819f-1450a7cb87b1",
                                        "glosses": [
                                            "The tort or fraudulent representation of a material fact made with knowledge of its falsity, or recklessly, or without reasonable grounds for believing its truth and with intent to induce reliance on it; the plaintiff justifiably relies on the deception, to his injury."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
