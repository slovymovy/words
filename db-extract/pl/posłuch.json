                                "target_senses": [
                                    {
                                        "sense_id": "2e93af1a-7679-3722-9e6d-c238e7bc26aa",
                                        "entry_id": "19fecf49-a1fc-3e9d-b8f4-f3bfcb6a6019",
                                        "glosses": [
                                            "The quality of being obedient."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "727f0952-1d54-4b18-947d-081ce648d8fd",
                                                "sense_id": "2e93af1a-7679-3722-9e6d-c238e7bc26aa",
                                                "text": "Obedience is essential in any army."
                                            },
                                            {
                                                "example_id": "3cad43cb-b88b-4fb6-a771-7522bc2ebc6f",
                                                "sense_id": "2e93af1a-7679-3722-9e6d-c238e7bc26aa",
                                                "text": "February 24, 1823, Thomas Jefferson, letter to Mr. Edward Everett\nResistance to tyrants is obedience to God."
                                            },
                                            {
                                                "example_id": "b0259a1d-2d9f-42f9-8d8b-44ad9a9af517",
                                                "sense_id": "2e93af1a-7679-3722-9e6d-c238e7bc26aa",
                                                "text": "Cautioning Nobs to silence, and he had learned many lessons in the value of obedience since we had entered Caspak, I slunk forward, taking advantage of whatever cover I could find..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b4dbd31-4791-3a2b-b95a-760743ee7f10",
                                        "entry_id": "19fecf49-a1fc-3e9d-b8f4-f3bfcb6a6019",
                                        "glosses": [
                                            "The collective body of persons subject to any particular authority."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "463370ec-7bf9-380d-95d8-aac6610b4779",
                                        "entry_id": "19fecf49-a1fc-3e9d-b8f4-f3bfcb6a6019",
                                        "glosses": [
                                            "A written instruction from the superior of an order to those under him."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "69efe59a-6537-3ee8-a404-6c8c41f3aa55",
                                        "entry_id": "19fecf49-a1fc-3e9d-b8f4-f3bfcb6a6019",
                                        "glosses": [
                                            "Any official position under an abbot's jurisdiction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd80050d-40f7-4c9e-be10-28e77ce89de7",
                        "source_entry_id": "cebad64e-315f-3a19-b249-d20d61f18872",
                        "source_sense_id": "cdedc0b4-1e3b-3f10-8e44-aa992b7655e0",
                        "target_lang_word": "obéissance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obéissance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2128b021-e5b1-3889-962b-1ebe4d04fd78",
                                        "entry_id": "04ad8ab5-5e7a-3922-a90e-fc484bdc7e4f",
                                        "glosses": [
                                            "Action d’obéir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd099945-0840-417f-bb2f-994e6cb0a922",
                                                "sense_id": "2128b021-e5b1-3889-962b-1ebe4d04fd78",
                                                "text": "Franz fit un signe de tête indiquant qu’il se rendait à l’invitation générale plutôt par obéissance pour les ordres de l’honorable société que dans l’espoir de réussir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9298a585-8dea-35b1-80d1-efa5478d0588",
                                        "entry_id": "04ad8ab5-5e7a-3922-a90e-fc484bdc7e4f",
                                        "glosses": [
                                            "Disposition à obéir, habitude d’obéir, soumission d’esprit aux ordres des supérieurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "495502be-ec0b-426b-b819-c3adb28163d9",
                                                "sense_id": "9298a585-8dea-35b1-80d1-efa5478d0588",
                                                "text": "Mais ne savais-je pas bien que les tyrans de tout genre allaient reprendre espoir dans ces jours de malheur où l’obéissance passive était restaurée ?"
                                            },
                                            {
                                                "example_id": "dad1c0b8-eef6-48fb-9e96-0a57e3e0ec6c",
                                                "sense_id": "9298a585-8dea-35b1-80d1-efa5478d0588",
                                                "text": "Peut-être parce que, depuis le XIᵉ siècle, la seule théorie politique de l'islam a été celle de l’obéissance passive à toute autorité de facto, le gouvernement par consentement reste un concept inconnu : l'autocratie a été la véritable et, pour l'essentiel, l'unique expérience."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ccc403b-1c60-3779-8456-674ffcd7ac83",
                                        "entry_id": "04ad8ab5-5e7a-3922-a90e-fc484bdc7e4f",
                                        "glosses": [
                                            "Domination, autorité."
                                        ],
                                        "tags": [
                                            "Parfois"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82898d67-d954-4a2b-b056-59d263a4b422",
                                                "sense_id": "5ccc403b-1c60-3779-8456-674ffcd7ac83",
                                                "text": "Il a réduit, il a rangé cette province sous son obéissance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b10f133a-d947-4726-a3df-287ef2a48f4f",
                        "source_entry_id": "cebad64e-315f-3a19-b249-d20d61f18872",
                        "source_sense_id": "cdedc0b4-1e3b-3f10-8e44-aa992b7655e0",
                        "target_lang_word": "Gehorsam",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gehorsam",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e78404b0-3659-32cd-88bc-ea7f6b82a8d9",
                                        "entry_id": "24d53677-79e2-3ce2-8e68-270653f178e8",
                                        "glosses": [
                                            "widerspruchsloses Befolgen von Aufforderungen gegenüber einer Autorität"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78ac840c-f036-4a61-af51-c500e029f723",
                                                "sense_id": "e78404b0-3659-32cd-88bc-ea7f6b82a8d9",
                                                "text": "Bei einem Polizeihund ist der Gehorsam eine positive Eigenschaft."
                                            },
                                            {
                                                "example_id": "624ac469-78d7-49c8-937c-0bec680601d1",
                                                "sense_id": "e78404b0-3659-32cd-88bc-ea7f6b82a8d9",
                                                "text": "Ein Leben in Armut, Keuschheit und Gehorsam. Ein Leben ohne Sex. Allein mit Gott. Unvorstellbar? Nicht für Tobias Schrörs. Er ist Dominikanermönch."
                                            },
                                            {
                                                "example_id": "c8ea6bd7-a5fb-44be-83aa-3068ad21c9c6",
                                                "sense_id": "e78404b0-3659-32cd-88bc-ea7f6b82a8d9",
                                                "text": "Befehl und Gehorsam sind das Prinzip jeder Armee. Nicht so bei der Bundeswehr im Kampf gegen Ebola. Hier wird man zum Einsatz gebeten."
                                            },
                                            {
                                                "example_id": "975df9a8-f25a-43f5-9eef-3817c7cc3d48",
                                                "sense_id": "e78404b0-3659-32cd-88bc-ea7f6b82a8d9",
                                                "text": "Denn wie durch den Ungehorsam des einen Menschen die Vielen zu Sündern geworden sind, so werden auch durch den Gehorsam des Einen die Vielen zu Gerechten."
                                            },
                                            {
                                                "example_id": "f73f2972-3d4c-418d-a0ba-f8e3d0469038",
                                                "sense_id": "e78404b0-3659-32cd-88bc-ea7f6b82a8d9",
                                                "text": "Gott fordert von Abraham den absoluten Gehorsam: Er soll seinen einzigen Sohn Isaak töten. Abrahams wichtigstes Ziel, ein Volk zu gründen, wäre damit passé. In letzter Sekunde verhindert Gott das Opfer."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b527192d-74c5-498d-8be6-52153b95655c",
                        "source_entry_id": "cebad64e-315f-3a19-b249-d20d61f18872",
                        "source_sense_id": "cdedc0b4-1e3b-3f10-8e44-aa992b7655e0",
