                        ],
                        "form": "уга́ром"
                    },
                    {
                        "form_id": "ab873a69-ddec-451f-a85b-504ca256aa93",
                        "entry_id": "100ec43f-ce64-3d06-a5ab-a1011ac76cde",
                        "tags": [
                            "plural",
