                                        "sense_id": "30ee7e79-bcc2-358a-8932-9973e6866a34",
                                        "entry_id": "55ee4304-44f9-34f9-baff-a1143b92aadd",
                                        "glosses": [
                                            "The initial agent that is the cause of all things."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3df48bae-a04b-317b-b43c-b2b16b1e5574",
                                        "entry_id": "55ee4304-44f9-34f9-baff-a1143b92aadd",
                                        "glosses": [
                                            "A machine, such as a water wheel or steam engine, that receives and modifies energy as supplied by some natural source or fuel and transforms it into mechanical work"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3e68619c-5fe3-33f4-b6a7-678d33f4f78d",
                                        "entry_id": "55ee4304-44f9-34f9-baff-a1143b92aadd",
                                        "glosses": [
                                            "The front part of a semi-trailer type truck, i.e., the tractor to which the trailer part attaches."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "212f3459-7661-30ff-9295-a4e9f83db4d2",
                                        "entry_id": "55ee4304-44f9-34f9-baff-a1143b92aadd",
                                        "glosses": [
                                            "A military or heavy construction vehicle."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "06a823de-1edd-3306-ad20-10f4606e6d1a",
                                        "entry_id": "55ee4304-44f9-34f9-baff-a1143b92aadd",
                                        "glosses": [
                                            "A person or thing that is seminal and influential."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d030f798-af47-4e22-bcdf-e620f6a939bf",
                                                "sense_id": "06a823de-1edd-3306-ad20-10f4606e6d1a",
                                                "text": "\"I need not remind this audience that, though Professor Summerlee, as the head of the Committee of Investigation, has been put up to speak to-night, still it is I who am the real prime mover in this business, and that it is mainly to me that any successful result must be ascribed.\""
                                            },
                                            {
                                                "example_id": "3be8e7e0-d46b-4449-99c8-d9e2006dffd5",
                                                "sense_id": "06a823de-1edd-3306-ad20-10f4606e6d1a",
                                                "text": "Seeger was a prime mover in the folk-music revival and was accepted by collegians and young people outside the South, regardless of his alleged Communist sympathies […]"
                                            },
                                            {
                                                "example_id": "32ad3466-a012-486f-9b7c-774f724ab4ce",
                                                "sense_id": "06a823de-1edd-3306-ad20-10f4606e6d1a",
                                                "text": "This first article looked at the present situation and asks if lessons can be learned from the past, when the railways were the prime mover in the development of tourism and leisure travel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
