                        "entry_id": "4a64ee0a-b062-3125-8541-af23f387ecb1",
                        "glosses": [
                            "Qui concerne l’agroforesterie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6302561e-032d-4013-9af8-da5167921ae8",
                                "sense_id": "a98dd35f-1b3c-30db-8943-06786b011d2c",
                                "text": "En bien des régions des tropiques, des systèmes agroforestiers, au moins à l’état d'ébauches, se sont développés spontanément."
                            },
                            {
                                "example_id": "1a9c0673-353f-4a2c-9e65-99dc38ff3cc0",
                                "sense_id": "a98dd35f-1b3c-30db-8943-06786b011d2c",
                                "text": "Lors d’une journée consacrée à l’agroforesterie, Stéphane Le Foll a souligné l’importance des systèmes agroforestiers pour faire évoluer l’agriculture."
                            }
                        ]
                    }
