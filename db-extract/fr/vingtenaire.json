                    {
                        "sense_id": "d77c737b-9ccc-33e7-a77f-002f64a83ea0",
                        "entry_id": "82da66cb-c326-3640-80f6-a4d309d26be1",
                        "glosses": [
                            "D’une durée de vingt ans."
                        ],
                        "tags": [
                            "Jurisprudence"
                        ],
                        "examples": [
                            {
                                "example_id": "8e0147ea-6998-42bc-8fa0-d06d80171c21",
                                "sense_id": "d77c737b-9ccc-33e7-a77f-002f64a83ea0",
                                "text": "La prescription vingtenaire permettait de devenir automatiquement propriétaire d’une terre après vingt ans d’exploitation continue de celle-ci."
