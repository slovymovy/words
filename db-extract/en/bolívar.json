                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9ad4ad0-d6bf-4801-a8e1-64e02a010eb7",
                                                "sense_id": "c13767cf-6065-3d05-bfb2-e30969ce99b9",
                                                "text": "De oorzaak zit 'm in de hyperinflatie. Het is zelfs zo erg dat de regering van de Venezolaanse president Nicolás Maduro besloten heeft simpelweg nullen te schrappen. Een busritje van 40.000 bolivar wordt nu gewoon opgeschreven als 0,4 bolivar. Nu alleen nog even die benzine hier zien te krijgen."
                                            }
                                        ]
                                    }
                                ]
                            }
