                                    {
                                        "sense_id": "ac60af8d-9180-3395-a635-ce992b8d9629",
                                        "entry_id": "5c13bf70-f938-3c69-8c02-c3df56e2e642",
                                        "glosses": [
                                            "Cellule basse et obscure."
                                        ],
                                        "tags": [
                                            "Prison"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9724aac9-6b7a-495d-bc8c-3c19e5c1df6d",
                                                "sense_id": "ac60af8d-9180-3395-a635-ce992b8d9629",
                                                "text": "Quand Napoléon III fut empoigné à Boulogne pour avoir donné une seconde représentation du débarquement à Cannes, on le jeta au cachot et on l’emmena à Paris sans lui donner le temps de changer de chemise."
                                            },
                                            {
                                                "example_id": "8935de7d-d05d-4717-91ac-cc0661f3143a",
                                                "sense_id": "ac60af8d-9180-3395-a635-ce992b8d9629",
                                                "text": "Le dix-septième jour de la seconde année de sa prévention, Jacques Errant fut extrait de son cachot et conduit entre deux gendarmes dans une grande salle où la lumière l'éblouit au point qu'il manqua défaillir."
                                            },
                                            {
                                                "example_id": "59776432-9220-4817-a736-70fab7727044",
                                                "sense_id": "ac60af8d-9180-3395-a635-ce992b8d9629",
                                                "text": "C'était un cachot, presque un placard, où la lumière du jour n'entrait jamais."
                                            },
                                            {
                                                "example_id": "6105c0f8-a1c8-44c2-a8dd-ea634764b315",
                                                "sense_id": "ac60af8d-9180-3395-a635-ce992b8d9629",
                                                "text": "La prochaine fois que tu parleras dans ton dialecte, ce sera le cachot!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
