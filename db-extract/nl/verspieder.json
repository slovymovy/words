        "nl-extract.jsonl": [
            {
                "entry_id": "25ba5f33-1c8f-34da-9334-d2b4f1c2bf6c",
                "word": "verspieder",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "f92254b2-286c-4269-bfcc-81814ecdab66",
                        "entry_id": "25ba5f33-1c8f-34da-9334-d2b4f1c2bf6c",
                        "tags": [
                            "plural"
                        ],
                        "form": "verspieders"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bd637f75-34a9-3e82-aaed-f731416ad309",
                        "entry_id": "25ba5f33-1c8f-34da-9334-d2b4f1c2bf6c",
                        "glosses": [
                            "iemand die op heimelijke en soms illegale wijze inlichtingen verzamelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be4e7061-0b2a-43fb-978f-9d7a1c849370",
                                "sense_id": "bd637f75-34a9-3e82-aaed-f731416ad309",
                                "text": "Ook wisten de verspieders een handleiding voor het maken van een bom, gevonden op een Al-Qaida-site, te veranderen in een recept voor een cupcake."
                            },
                            {
                                "example_id": "8f692c04-37a8-40f3-9bfc-b7a9781b71ee",
                                "sense_id": "bd637f75-34a9-3e82-aaed-f731416ad309",
                                "text": "En prompt schreef Schrijver een roman, Rachab.Rachab was de hoer van Jericho. Zij redde spionnen van het Israëlitische volk uit handen van de koning. Rachab verstopte de verspieders op het dak van haar huis, onder dikke bossen vlas, zo wil het bijbelverhaal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9f38d84-1929-4612-a7be-b63ad21540f8",
                        "source_entry_id": "25ba5f33-1c8f-34da-9334-d2b4f1c2bf6c",
                        "source_sense_id": "bd637f75-34a9-3e82-aaed-f731416ad309",
                        "target_lang_word": "spy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab6cc882-784c-368d-96d9-802b49b6f213",
                                        "entry_id": "022f9240-092a-3809-b829-3585dab714de",
                                        "glosses": [
                                            "A person who secretly watches and examines the actions of other individuals or organizations and gathers information on them (usually to gain an advantage)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c952354e-5c71-4768-8e82-06b484facae2",
                                                "sense_id": "ab6cc882-784c-368d-96d9-802b49b6f213",
                                                "text": "The dead leap at the throat, destroy\nThe meaning of the day; dark forms\nHave scaled your walls, and spies betray\nOld secrets to amorphous swarms."
                                            },
                                            {
                                                "example_id": "50358222-4df6-4a9b-a688-c9c34a7f602b",
                                                "sense_id": "ab6cc882-784c-368d-96d9-802b49b6f213",
                                                "text": "Even without hovering drones, a lurking assassin, a thumping score and a denouement, the real-life story of Edward Snowden, a rogue spy on the run, could be straight out of the cinema. But, as with Hollywood, the subplots and exotic locations may distract from the real message: America’s discomfort and its foes’ glee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42a19e36-58e0-3050-866b-e7e307c46e34",
                                        "entry_id": "022f9240-092a-3809-b829-3585dab714de",
                                        "glosses": [
                                            "A defensive player assigned to cover an offensive backfield player man-to-man when they are expected to engage in a running play, but the offensive player does not run with the ball immediately."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "spy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f1088949-73e6-3785-8ba0-a20665c1f39b",
                                        "entry_id": "d6c20005-28fd-3749-828d-653b1064bd0c",
                                        "glosses": [
                                            "To act as a spy."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5f520a8-ad37-4b61-8425-48b54ca5ce12",
                                                "sense_id": "f1088949-73e6-3785-8ba0-a20665c1f39b",
                                                "text": "During the Cold War, Russia and America would each spy on each other for recon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9e2a240-1c1b-3f91-a487-ad5efd1f62f6",
                                        "entry_id": "d6c20005-28fd-3749-828d-653b1064bd0c",
                                        "glosses": [
                                            "To spot; to catch sight of; to espy."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae2ae498-575f-4e55-a59f-0ea219417c27",
                                                "sense_id": "a9e2a240-1c1b-3f91-a487-ad5efd1f62f6",
                                                "text": "I think I can spy that hot guy coming over here."
                                            },
                                            {
                                                "example_id": "e52751f6-fd72-4779-af16-b1fc9e18adc9",
                                                "sense_id": "a9e2a240-1c1b-3f91-a487-ad5efd1f62f6",
                                                "text": "VVherefore lift up your heads, brethren, and look about vvith your eyes, ſpy vvhat things are to be reformed in the Church of England."
                                            },
                                            {
                                                "example_id": "1f830553-2e5f-4d98-b97a-b7136fdb51d2",
                                                "sense_id": "a9e2a240-1c1b-3f91-a487-ad5efd1f62f6",
                                                "text": "One in reading, skipped over all sentences where he spied a note of admiration."
                                            },
                                            {
                                                "example_id": "de63d104-f294-4727-a591-a33459de5afd",
                                                "sense_id": "a9e2a240-1c1b-3f91-a487-ad5efd1f62f6",
                                                "text": "Child, I see thee! Child, I spy thee!"
                                            },
                                            {
                                                "example_id": "b3dffa55-6bc7-4b4a-ae24-b50011f6bafd",
                                                "sense_id": "a9e2a240-1c1b-3f91-a487-ad5efd1f62f6",
                                                "text": "The next person they spied was a Bandicoot carrying a watermelon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "067108a1-801f-3926-be3a-91d7b9e68866",
                                        "entry_id": "d6c20005-28fd-3749-828d-653b1064bd0c",
                                        "glosses": [
                                            "To search narrowly; to scrutinize."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57284125-cdab-4027-b177-8cd486b40dde",
                                                "sense_id": "067108a1-801f-3926-be3a-91d7b9e68866",
                                                "text": "(As I confeſſe it is my Natures plague / To ſpy into Abuſes, and of my iealouſie / Shapes faults that are not)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c411a7ae-d0b2-3b1b-bf03-993de0c2cb0c",
                                        "entry_id": "d6c20005-28fd-3749-828d-653b1064bd0c",
                                        "glosses": [
                                            "To explore; to see; to view; inspect and examine secretly, as a country."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
