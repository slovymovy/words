                    }
                ],
                "senses": [
                    {
                        "sense_id": "b8f1c972-4e40-3b63-a25d-3141812dbb62",
                        "entry_id": "9099b9c3-9da0-3bd9-9718-a8ce2c3fe0e6",
                        "glosses": [
                            "Vésicule remplie de sérosités qui se forme sur la peau, dans certaines maladies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d51fded-38e4-45b4-a6cb-46180e7f4a4f",
                                "sense_id": "b8f1c972-4e40-3b63-a25d-3141812dbb62",
                                "text": "Une tuméfaction livide s’étendait sur la jambe, et avec des phlyctènes de place en place, par où suintait un liquide noir."
                            },
                            {
                                "example_id": "c1d172dd-a88d-4284-b8a8-ed10721249d3",
                                "sense_id": "b8f1c972-4e40-3b63-a25d-3141812dbb62",
                                "text": "La phlyctène séreuse est percée et vidée."
                            },
                            {
                                "example_id": "09d33397-7e91-4ad1-8226-54a2795e95f1",
                                "sense_id": "b8f1c972-4e40-3b63-a25d-3141812dbb62",
                                "text": "Lors de l’intoxication aiguë, la présentation classique initiale est la triade : céphalées, nausées, vomissements et sensations vertigineuses. Il peut exister également de façon inconstante : […];\n• des phlyctènes par compression, une coloration cochenille de la peau (le plus souvent une cyanose); […]."
                            }
                        ]
                    }
                ],
