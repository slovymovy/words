                ],
                "translations": [
                    {
                        "translation_id": "b92da135-2be9-47a6-b32f-a58ad611b45b",
                        "source_entry_id": "44fcf80f-799e-3f5a-9939-0a9f3da8b2fd",
                        "source_sense_id": "681bbc72-936c-38f5-831e-2c0d8daf3a3a",
                        "target_lang_word": "treble",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "treble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ebfd88ae-0877-3f26-9efc-0f50b8d5f2b0",
                                        "entry_id": "bfd8d1e7-0b41-3651-a274-8db1f82ba217",
                                        "glosses": [
                                            "High in pitch."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "686a4d32-40c3-4afc-b2fd-06a6499a89e3",
                                                "sense_id": "ebfd88ae-0877-3f26-9efc-0f50b8d5f2b0",
                                                "text": "He put his cigar in his mouth, and, with his right hand, up in the treble keys, he began to play, in octaves, the melody of a song called \"The Kinkajou,\" which, somewhat notably, had shifted into and ostensibly out of popularity before he was born."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf9a0d58-f6b5-3996-96f1-a329da1aa0bf",
                                        "entry_id": "bfd8d1e7-0b41-3651-a274-8db1f82ba217",
                                        "glosses": [
                                            "Pertaining to the highest singing voice or part in harmonized music; soprano."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "be7a68c9-2e91-3290-87be-9dbdebca3a73",
                                        "entry_id": "bfd8d1e7-0b41-3651-a274-8db1f82ba217",
                                        "glosses": [
                                            "Threefold, triple."
                                        ],
                                        "tags": [
                                            "dated",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72c58d18-6192-4563-b6b9-5da4e7b0d1e1",
                                                "sense_id": "be7a68c9-2e91-3290-87be-9dbdebca3a73",
                                                "text": "A lofty tower, and strong on every side / With treble walls."
                                            },
                                            {
                                                "example_id": "de241d56-4618-4ada-a631-2c9c852510d2",
                                                "sense_id": "be7a68c9-2e91-3290-87be-9dbdebca3a73",
                                                "text": "Every subscriber of one penny per week, who is sixty years of age, or upwards, and under four-score, to be entitled to receive treble his subscription at the end of the year; that is, his own subscription, and twice as much more."
                                            },
                                            {
                                                "example_id": "ad609947-1552-4428-993f-ecc8e9f7ebd6",
                                                "sense_id": "be7a68c9-2e91-3290-87be-9dbdebca3a73",
                                                "text": "The treble walls and ditches on the land side … diminish the extent of ground covered with houses."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "treble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad1da32f-50f2-374b-8a78-aa1037377850",
                                        "entry_id": "27b8d7d7-ab4f-32b2-a3a0-31c21b05fabc",
                                        "glosses": [
                                            "Trebly; triply."
                                        ],
                                        "tags": [
                                            "dated",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0283dfd-4190-4652-859c-afefe800c81a",
                                                "sense_id": "ad1da32f-50f2-374b-8a78-aa1037377850",
                                                "text": "Whose deserts might buy him treble"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "treble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "858eaa8f-a8e6-32b3-8f5d-90eb1c7c4164",
                                        "entry_id": "c6ab20dc-7bd2-32bb-980c-605c814b9df4",
                                        "glosses": [
                                            "The highest singing voice (especially as for a boy) or part in musical composition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea59172c-31a3-4b49-9d39-1cf9c0b2e1c8",
                                                "sense_id": "858eaa8f-a8e6-32b3-8f5d-90eb1c7c4164",
                                                "text": "He starts out by saying that there are three sights, the mene, treble, and quadreble, but actually he discusses only two, the treble and quadreble, both of which are read at the transposition of an octave."
                                            },
                                            {
                                                "example_id": "5e6beb49-15ea-41fe-bbe4-882da144ce18",
                                                "sense_id": "858eaa8f-a8e6-32b3-8f5d-90eb1c7c4164",
                                                "text": "The voices include a counter (always below the tenor), a countertenor (moving above and below the tenor), mene, treble, and quadreble."
                                            },
                                            {
                                                "example_id": "13ec0b4f-fe48-4657-a862-db230dc18338",
                                                "sense_id": "858eaa8f-a8e6-32b3-8f5d-90eb1c7c4164",
                                                "text": "The counter involves transposition of the sighted note to the fifth below (for extremely low notes a twelfth), the mene and countertenor do not transpose, the treble transposes to the octave above, and the quadreble to the twelfth above."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87ab0b9d-b6b4-3172-878a-39d30731d703",
                                        "entry_id": "c6ab20dc-7bd2-32bb-980c-605c814b9df4",
                                        "glosses": [
                                            "A person or instrument having a treble voice or pitch; a boy soprano."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cd2ab752-0d81-3f76-840c-0ceb33a5ef30",
                                        "entry_id": "c6ab20dc-7bd2-32bb-980c-605c814b9df4",
                                        "glosses": [
                                            "The highest tuned in a ring of bells."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79e67815-187e-3bb3-bd8a-80990a6cd523",
                                        "entry_id": "c6ab20dc-7bd2-32bb-980c-605c814b9df4",
                                        "glosses": [
                                            "Any high-pitched or shrill voice or sound."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "34f1570e-6356-34d7-a823-5b303adf1007",
                                        "entry_id": "c6ab20dc-7bd2-32bb-980c-605c814b9df4",
                                        "glosses": [
                                            "A threefold quantity or number; something having three parts or having been tripled."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd13c348-82ca-307f-8a4c-5bf97db279e6",
                                        "entry_id": "c6ab20dc-7bd2-32bb-980c-605c814b9df4",
                                        "glosses": [
                                            "A drink with three portions of alcohol; a triple"
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dd3554d7-281c-3414-be4d-7fa6e9035805",
                                        "entry_id": "c6ab20dc-7bd2-32bb-980c-605c814b9df4",
                                        "glosses": [
                                            "Any of the narrow areas enclosed by the two central circles on a dartboard, worth three times the usual value of the segment."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1cb7b0a5-aa9a-315b-9241-b6e819503cbb",
                                        "entry_id": "c6ab20dc-7bd2-32bb-980c-605c814b9df4",
                                        "glosses": [
                                            "Three goals, victories, awards etc. in a given match or season."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f6eefc7-2a3e-4570-84c1-98f724b8c3c6",
                                                "sense_id": "1cb7b0a5-aa9a-315b-9241-b6e819503cbb",
                                                "text": "As for City, a domestic treble is off the cards and they must haul themselves off the floor quickly with the second leg of their last-16 Champions League tie against Barcelona on Wednesday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d08d14f-c59b-3981-ade3-573519298680",
                                        "entry_id": "c6ab20dc-7bd2-32bb-980c-605c814b9df4",
                                        "glosses": [
                                            "Three goals, victories, awards etc. in a given match or season.",
                                            "A win in the top league, top national cup and top continental cup in the same season."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "treble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36bb04cd-f378-3ce0-aae0-ce5d2cc20ebf",
                                        "entry_id": "7037ea36-7d49-3869-a428-79f4892a4793",
                                        "glosses": [
                                            "To multiply by three; to make into three parts, layers, or thrice the amount."
                                        ],
                                        "tags": [
                                            "dated",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f14d588-f02b-46d2-8280-374c735495bc",
                                                "sense_id": "36bb04cd-f378-3ce0-aae0-ce5d2cc20ebf",
                                                "text": "There is increasing evidence that cannabis use can act as a risk factor for the development of bipolar as well as psychotic disorders. A recent systematic review by Gibbs and colleagues identified several studies supporting a link between cannabis use and subsequent relapse of manic symptoms. This review also included a meta-analysis of two large prospective cohort studies, which found that cannabis use almost trebled the risk of new-onset subthreshold manic symptoms after adjusting for potential confounding factors."
                                            },
                                            {
                                                "example_id": "0d929183-4087-4bb2-926d-4d417a9d8067",
