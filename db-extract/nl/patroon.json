                    {
                        "sense_id": "ab85d038-2554-311e-a019-9cf66a18a371",
                        "entry_id": "6ddda4f6-ccf0-3828-8b00-6332b2517100",
                        "glosses": [
                            "/: munitie voor een vuurwapen (cartouche, cartridge)"
                        ],
                        "tags": [
                            "feminine",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "e6b101a1-1426-4f34-994b-7881a4d957f9",
                                "sense_id": "ab85d038-2554-311e-a019-9cf66a18a371",
                                "text": "De patronen waren op, dus gaf de dief zich over."
                            }
                        ]
                    },
                    {
                        "sense_id": "6c98da7d-b891-356b-b9e3-ecd9c679ece3",
                        "entry_id": "6ddda4f6-ccf0-3828-8b00-6332b2517100",
                        "glosses": [
                            ": tekening die als basis dient om meerdere dezelfde eindproducten te maken, sjabloon, template"
                        ],
                        "tags": [
                            "neuter"
                        ],
                        "examples": [
                            {
                                "example_id": "9a8d5762-4872-4bdc-a5c5-af26b5881f5e",
                                "sense_id": "6c98da7d-b891-356b-b9e3-ecd9c679ece3",
                                "text": "Voordat je een jurk maakt, teken je meestal eerst het patroon."
                            }
                        ]
                    },
                    {
                        "sense_id": "03aa59bd-c734-3146-be05-4a3c3c4b22cd",
                        "entry_id": "6ddda4f6-ccf0-3828-8b00-6332b2517100",
                        "glosses": [
                            ": min of meer vaste terugkerende structuur, concreet dan wel abstract"
                        ],
                        "tags": [
                            "neuter"
                        ],
                        "examples": [
                            {
                                "example_id": "11149dc9-31d1-44bd-a628-a55e36c2f6a3",
                                "sense_id": "03aa59bd-c734-3146-be05-4a3c3c4b22cd",
                                "text": "In zijn handelingen is een zeker patroon te zien."
                            }
                        ]
                    },
                    {
                        "sense_id": "4f9593af-9980-3527-8437-54c3724bd58f",
                        "entry_id": "6ddda4f6-ccf0-3828-8b00-6332b2517100",
                        "glosses": [
                            ": baas, chef, overste"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "3018a7d7-b82d-438d-b210-8bc2f21c8f1d",
                                "sense_id": "4f9593af-9980-3527-8437-54c3724bd58f",
                                "text": "Daarvoor moet je bij mijn patroon zijn."
                            }
                        ]
                    },
                    {
                        "sense_id": "583629b1-86ac-323a-8ce2-d84081d86656",
                        "entry_id": "6ddda4f6-ccf0-3828-8b00-6332b2517100",
                        "glosses": [
                            ": , beschermheer, beschermheilige, schutspatroon"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "4b6db411-3429-4ed6-bb53-aefa3d209655",
                                "sense_id": "583629b1-86ac-323a-8ce2-d84081d86656",
                                "text": "Hij trad op als patroon van de klager."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c0445f5-d474-4b93-b599-d9873d9d1609",
                        "source_entry_id": "6ddda4f6-ccf0-3828-8b00-6332b2517100",
                        "source_sense_id": "ab85d038-2554-311e-a019-9cf66a18a371",
                        "source_sense_description": "munitie voor een vuurwapen",
                        "target_lang_word": "bala",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bala",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "23a110b7-467a-385d-ad2d-58e0bf5f885e",
                                        "entry_id": "beea6766-4725-3491-9835-abb896d95969",
                                        "glosses": [
                                            "Proyectil sólido, normalmente de metal o piedra, usado como munición."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03dff628-226f-4ea5-8033-7088bf263ee7",
                                                "sense_id": "23a110b7-467a-385d-ad2d-58e0bf5f885e",
                                                "text": "Los Voluntarios de Madrid por su parte, abrieron fuego por hileras, la pieza de artillería escupió algunas metrallas, las balas de fusil hicieron diversos claros en el centro; pero a un amago de carga a fondo de la hueste, agitáronse los guías y la tropa española emprendió en orden hacia la villa su retirada."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2a4588d4-5ad9-34c5-ac79-30a944b68066",
                                        "entry_id": "beea6766-4725-3491-9835-abb896d95969",
                                        "glosses": [
                                            "Mercancía unida y compactada para facilitar su transporte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65ffeca3-f7c5-41c7-a763-95d5f76424d8",
                                                "sense_id": "2a4588d4-5ad9-34c5-ac79-30a944b68066",
                                                "text": "En mi caso, uno de los muchos trabajos que realizaba consistía en colocar dentro del pajar las balas de paja que mis hermanos introducían por el único orificio que había entre las paredes de aquel viejo edificio."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "bala",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "0834f366-d16f-3e50-9eff-aeefe92e1a2d",
                                        "entry_id": "57865530-2ccf-3cee-aef8-82154bd3b351",
                                        "glosses": [
                                            "Hombre homosexual."
                                        ],
                                        "tags": [
                                            "Argentina",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "800def93-51d5-4044-92a6-1beca5ce20ba",
                                                "sense_id": "0834f366-d16f-3e50-9eff-aeefe92e1a2d",
                                                "text": "Hace dos meses, cuando el secretario de Transportes Ricardo Jaime anunció la construcción de un tren bala, el intendente de Córdoba Luis Juez ironizó: “¿Qué? ¿Va a hacer un vagón con pucheros? No podemos arreglar una zorrita y vamos a armar el tren bala”. Puchero y bala son dos palabras del slang cordobés para referirse a los homosexuales. El escándalo duró semanas y pasó a formar parte de la disputa electoral, en la que Jaime y su hermano Roberto jugaron un papel decisivo. Las principales organizaciones de Lesbianas, Gays, Travestis, Transgéneros y Bisexuales lo escracharon y le exigieron una retractación."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "bala",
                                "target_lang_code": "es",
                                "target_senses": [
