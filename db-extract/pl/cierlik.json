                "senses": [
                    {
                        "sense_id": "3337507c-dccc-386e-a0c1-32fa5540a1f4",
                        "entry_id": "b9bfe5f1-4b7e-3349-9cb2-e0d029700fd3",
                        "glosses": [
                            "Emberiza cirlus, ptak z rodziny trznadlowatych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a67ad311-1513-4bdb-a381-42acb785c0f1",
                                "sense_id": "3337507c-dccc-386e-a0c1-32fa5540a1f4",
                                "text": "U cierlików jaja wysiadywane są wyłącznie przez samicę."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3fb2c471-c3b6-4ba5-8e94-76ce9158823f",
                        "source_entry_id": "b9bfe5f1-4b7e-3349-9cb2-e0d029700fd3",
                        "source_sense_id": "3337507c-dccc-386e-a0c1-32fa5540a1f4",
                        "target_lang_word": "cirl bunting",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cirl bunting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b0082ee-bc41-3940-94a8-2b5ae43c075b",
                                        "entry_id": "311daf28-44fc-33ca-a864-7f1b87a44f21",
                                        "glosses": [
                                            "A small Old World passerine bird, Emberiza cirlus, of the bunting family (Emberizidae), very similar to the yellowhammer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1408dffb-e3a1-4011-914c-7d01ec0bc878",
                                                "sense_id": "6b0082ee-bc41-3940-94a8-2b5ae43c075b",
                                                "text": "A minute or two later, a female cirl bunting dropped down into the field in front of us, soon followed by a male."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e086031d-8983-4871-94e4-456ecaf3f103",
                        "source_entry_id": "b9bfe5f1-4b7e-3349-9cb2-e0d029700fd3",
                        "source_sense_id": "3337507c-dccc-386e-a0c1-32fa5540a1f4",
                        "target_lang_word": "Cirl Bunting",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a446bd58-9cac-40a5-b0a8-43497169b896",
                        "source_entry_id": "b9bfe5f1-4b7e-3349-9cb2-e0d029700fd3",
                        "source_sense_id": "3337507c-dccc-386e-a0c1-32fa5540a1f4",
                        "target_lang_word": "zizi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zizi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "27b6ff1f-4b1d-33eb-9fe7-3f0ecd1beafa",
                                        "entry_id": "d8a28139-3ef2-3bf8-b1f5-8abae376d19c",
                                        "glosses": [
                                            "Pénis."
                                        ],
                                        "tags": [
                                            "childish"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f6e89c9-c0cc-4598-b693-106540a6756f",
                                                "sense_id": "27b6ff1f-4b1d-33eb-9fe7-3f0ecd1beafa",
                                                "text": "Des zizis y’en a d’toutes les couleurs\nÔ gué, ô gué\nDes boulangers jusqu’aux ramoneurs\nÔ gué, ô gué\nJ’en ai vu des impulsifs\nQui grimpaient dans les calcifs\nJ’en ai vu de moins voraces\nTomber dans les godasses."
                                            },
                                            {
                                                "example_id": "f0defa69-1e8f-4532-9f2e-4a5d15507fad",
                                                "sense_id": "27b6ff1f-4b1d-33eb-9fe7-3f0ecd1beafa",
                                                "text": "Tu veux mon zizi ? oui oui oui oui\nJe vais te le donner, oui oui oui oui"
                                            },
                                            {
                                                "example_id": "22c43cb9-6661-47c6-9462-71cb28ba42c5",
                                                "sense_id": "27b6ff1f-4b1d-33eb-9fe7-3f0ecd1beafa",
                                                "text": "Elle proposa à Solange de la suivre, déroula une serviette de toilette sur le lit de ses parents, allongea Tom sur le linge. Elle nettoya ses fesses, le pli des cuisses, le zizi, puis les sécha avec application."
                                            },
                                            {
                                                "example_id": "068fcd11-bf35-4c24-b114-4803e17dd914",
                                                "sense_id": "27b6ff1f-4b1d-33eb-9fe7-3f0ecd1beafa",
                                                "text": "Le petit zizi fait donc partie intégrante de l’idéal esthétique de l’époque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a483d58-854c-3b60-ab44-d0659b7a893b",
                                        "entry_id": "d8a28139-3ef2-3bf8-b1f5-8abae376d19c",
                                        "glosses": [
                                            "Garçon falot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4e6876a-9f2b-4339-a84b-069e3b9fd9e5",
                                                "sense_id": "5a483d58-854c-3b60-ab44-d0659b7a893b",
                                                "text": "Que les hommes nous appellent nanas ou boudins, humiliant, mais je n’étais pas très nette du côté vocabulaire moi non plus, les garçons, je les divisais souvent en minus, zigotos et zizis, dont avec Hilda j’ignorais le sens obscène. Bien obligée d’avouer que le zizi était le pendant de boudin, un type falot, sans valeur flirtable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "zizi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a4410c58-947a-3437-aae4-78c96c3a13ae",
                                        "entry_id": "2d0f49ad-333f-3429-aabf-055af3f078ae",
                                        "glosses": [
                                            "Synonyme de bruant zizi (oiseau)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54a3580f-4254-41c6-807d-4621a8b840ed",
                                                "sense_id": "a4410c58-947a-3437-aae4-78c96c3a13ae",
                                                "text": "Buffon a écrit très sérieusement dans son Histoire naturelle : « Je donne à cet oiseau le nom de zizi d’après son cri ordinaire », sans se douter qu’aujourd’hui ce nom prêterait à sourire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d69bb6a-2609-408d-ba47-889db79311d0",
                        "source_entry_id": "b9bfe5f1-4b7e-3349-9cb2-e0d029700fd3",
                        "source_sense_id": "3337507c-dccc-386e-a0c1-32fa5540a1f4",
                        "target_lang_word": "bruant zizi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bruant zizi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "28b5a8a1-43ba-352e-9257-205e447780b1",
                                        "entry_id": "02914696-4980-33f4-8c67-f708ca0b6e55",
                                        "glosses": [
                                            "Espèce de petit oiseau passereau d'Europe méridionale, bruant au plumage brun, noir et jaune et dont la tête du mâle, rayée de noir et de jaune, a une calotte brun olivâtre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f15a91af-94af-4b4e-b615-b5643d121594",
                                                "sense_id": "28b5a8a1-43ba-352e-9257-205e447780b1",
                                                "text": "Les randonneurs verront et entendront en cours de route le bruant zizi, le tarier pâtre, la linotte et le chardonneret."
                                            },
                                            {
                                                "example_id": "04e7b929-ddb1-462b-9923-64a7e08b3a0c",
                                                "sense_id": "28b5a8a1-43ba-352e-9257-205e447780b1",
                                                "text": "Je me rendis à Statte, en 1942 afin d’examiner les endroits choisis par les Bruants zizis pour établir leurs nids."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "042a0c00-2b8c-4e7c-9529-589592abb7a8",
                        "source_entry_id": "b9bfe5f1-4b7e-3349-9cb2-e0d029700fd3",
                        "source_sense_id": "3337507c-dccc-386e-a0c1-32fa5540a1f4",
                        "target_lang_word": "escribano soteño",
                        "target_lang_code": "es",
