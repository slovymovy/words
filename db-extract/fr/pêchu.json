                            {
                                "target_word": "mitreißend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "56225828-dbf5-3929-88a2-ad897db6b8e1",
                                        "entry_id": "56a55edc-6141-320c-a88b-89e318dc996f",
                                        "glosses": [
                                            "bei jemandem Begeisterung weckend, jemanden in Enthusiasmus versetzend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7e68ab1-e03d-4d1d-8259-5d6ed0b22816",
                                                "sense_id": "56225828-dbf5-3929-88a2-ad897db6b8e1",
                                                "text": "„Wir erleben heute ein mitreißendes Spiel der deutschen Fußballnationalmannschaft gegen Brasilien. Am Ende steht es 7:1.“"
                                            },
                                            {
                                                "example_id": "239be8b8-4284-4866-acbf-ecf8d0d0797b",
                                                "sense_id": "56225828-dbf5-3929-88a2-ad897db6b8e1",
                                                "text": "„Wir haben eine mitreißende Rede von Oskar Lafontaine auf dem SPD-Parteitag gehört.“"
                                            },
                                            {
                                                "example_id": "ce971705-4abc-4b85-8a72-708cb95b5e61",
                                                "sense_id": "56225828-dbf5-3929-88a2-ad897db6b8e1",
                                                "text": "Im Alltag ist Jessenig eine Frau […] mit mitreißender Energie und […]"
                                            },
                                            {
                                                "example_id": "e305d168-1110-441d-be4b-bd9c4759c244",
                                                "sense_id": "56225828-dbf5-3929-88a2-ad897db6b8e1",
                                                "text": "Zu den Höhepunkten des Konzerts gehörte eine Folge moderner Stücke des Kirchmusikers, Komponisten und Arrangeurs Michael Schütz, die der Posaunenchor einstudiert hatte. Darunter eine Jazz-Interpretation von \"Erd und Himmel sollen singen\", mitreißende Klezmermusik unter dem Titel \"Come along\" und die Pop-Ballade \"Glory Song\"."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "mitreißend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bdfad635-8de9-34e5-9c29-4a3021bfd57b",
                                        "entry_id": "c8f03661-31f3-3bdd-a188-6fb097cd0f1a",
