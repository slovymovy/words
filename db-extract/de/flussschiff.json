                "senses": [
                    {
                        "sense_id": "987ceaf5-ffaa-3657-a9d7-36dc02fc0fa8",
                        "entry_id": "fa566eb9-0550-3f62-848f-0e709d9aec2c",
                        "glosses": [
                            "ein für den Verkehr auf Binnengewässern gebautes Schiff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "295dad2b-8ebb-4825-9677-8eeae852c8ba",
                                "sense_id": "987ceaf5-ffaa-3657-a9d7-36dc02fc0fa8",
                                "text": "Flussschiffe sind aufgrund ihrer Bauweise nicht geeignet, um auf See zu verkehren."
                            },
                            {
                                "example_id": "aaedcfd4-2dee-45eb-a4c7-8d9677fa12b3",
                                "sense_id": "987ceaf5-ffaa-3657-a9d7-36dc02fc0fa8",
                                "text": "„Solange der Niger genügend Wasser führte – bis Mitte November –, legten hier die großen Flussschiffe an, die stromabwärts über Mopti und Timbuktu bis nach Gao fuhren.“"
                            }
                        ],
