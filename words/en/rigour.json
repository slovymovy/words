{
    "word_family": [
        "rigorous",
        "rigorously"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "14075c63-1931-3abe-bfad-c8668b7025ff",
                    "sense_definition": "The quality of being extremely strict or severe.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "strictness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>rigour</w> of the new school rules surprised many students.",
                            "target_lang_translations": {
                                "nl": "De <w>strengheid</w> van de nieuwe schoolregels verraste veel leerlingen."
                            }
                        },
                        {
                            "text": "He applied the law with great <w>rigour</w> to ensure fairness.",
                            "target_lang_translations": {
                                "nl": "Hij paste de wet met grote <w>gestrengheid</w> toe om eerlijkheid te waarborgen."
                            }
                        }
                    ],
                    "synonyms": [
                        "strictness",
                        "severity",
                        "harshness"
                    ],
                    "antonyms": [
                        "leniency"
                    ],
                    "target_lang_definitions": {
                        "nl": "De eigenschap van uiterst streng of rigoureus zijn."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "strengheid",
                                "target_lang_sense_clarification": "algemene term voor striktheid of gestrengheid"
                            },
                            {
                                "target_lang_word": "gestrengheid",
                                "target_lang_sense_clarification": "nadruk op een formele of autoritaire houding"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c918789-a473-3096-b674-d32fa2ab3d70",
                    "sense_definition": "The state of being thorough, accurate, and careful.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "strictness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientific research requires a high level of <w>rigour</w> to be credible.",
                            "target_lang_translations": {
                                "nl": "Wetenschappelijk onderzoek vereist een hoge mate van <w>nauwkeurigheid</w> om geloofwaardig te zijn."
                            }
                        },
                        {
                            "text": "The academic <w>rigour</w> of this university program is well known.",
                            "target_lang_translations": {
                                "nl": "De academische <w>grondigheid</w> van dit universitaire programma is welbekend."
                            }
                        }
                    ],
                    "synonyms": [
                        "thoroughness",
                        "precision",
                        "accuracy"
                    ],
                    "common_phrases": [
                        "academic rigour",
                        "scientific rigour"
                    ],
                    "target_lang_definitions": {
                        "nl": "De staat van grondigheid, nauwkeurigheid en zorgvuldigheid."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "nauwkeurigheid",
                                "target_lang_sense_clarification": "focus op precisie en correctheid"
                            },
                            {
                                "target_lang_word": "grondigheid",
                                "target_lang_sense_clarification": "focus op volledigheid en diepgang"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b86bea15-0b6a-3de1-ae52-0e0f3a81ec65",
                    "sense_definition": "The harsh or difficult conditions of a climate or environment.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "harshness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The explorers were unprepared for the <w>rigour</w> of the arctic winter.",
                            "target_lang_translations": {
                                "nl": "De ontdekkingsreizigers waren niet voorbereid op de <w>barheid</w> van de arctische winter."
                            }
                        },
                        {
                            "text": "Few plants can survive the <w>rigour</w> of such a dry climate.",
                            "target_lang_translations": {
                                "nl": "Weinig planten kunnen de <w>strengheid</w> van zo'n droog klimaat overleven."
                            }
                        }
                    ],
                    "synonyms": [
                        "harshness",
                        "severity"
                    ],
                    "common_phrases": [
                        "rigour of winter"
                    ],
                    "target_lang_definitions": {
                        "nl": "De barre of moeilijke omstandigheden van een klimaat of omgeving."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "barheid",
                                "target_lang_sense_clarification": "verwijzend naar onherbergzame omstandigheden"
                            },
                            {
                                "target_lang_word": "strengheid",
                                "target_lang_sense_clarification": "vaak gebruikt in de context van een streng klimaat of winter"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3cf8437-a686-31c8-890c-0734b540c182",
                    "sense_definition": "A physical trembling or shivering, often caused by cold or illness.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shivering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient experienced a sudden <w>rigour</w> as the fever began to rise.",
                            "target_lang_translations": {
                                "nl": "De patiënt kreeg een plotselinge <w>rilling</w> toen de koorts begon te stijgen."
                            }
                        },
                        {
                            "text": "A violent <w>rigour</w> shook his body after he fell into the icy water.",
                            "target_lang_translations": {
                                "nl": "Een hevige <w>beving</w> schudde zijn lichaam nadat hij in het ijzige water was gevallen."
                            }
                        }
                    ],
                    "synonyms": [
                        "shiver",
                        "tremor"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een fysieke beving of rilling, vaak veroorzaakt door kou of ziekte."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "rilling",
                                "target_lang_sense_clarification": "plotselinge fysieke reactie op kou of koorts"
                            },
                            {
                                "target_lang_word": "beving",
                                "target_lang_sense_clarification": "het schudden van het lichaam"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}