                "senses": [
                    {
                        "sense_id": "bd332d98-96be-35cb-9eb0-162a38896049",
                        "entry_id": "022e8498-1395-35d0-891b-a139abb43c4e",
                        "glosses": [
                            "älteste, bedeutendste Kirche eines Bezirks, einer Stadt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e900d29a-a054-4998-9571-d77521cd119a",
                                "sense_id": "bd332d98-96be-35cb-9eb0-162a38896049",
                                "text": "„Im mittelfränkischen Baiersdorf schlagen die Glocken der evangelischen Hauptkirche um mindestens 16,6 Dezibel zu laut.“"
                            },
                            {
                                "example_id": "913ca6a1-f1ec-42ff-8fd9-2ec486de4583",
                                "sense_id": "bd332d98-96be-35cb-9eb0-162a38896049",
                                "text": "„In der dortigen Hauptkirche entstand in den letzten Wochen ein Werk der beiden Künstler Marios Pergialis und Anthony di Paola, mit dem das Pestjahr 2020 vorläufig auf eine bündige, wenngleich niederschmetternde Bildformel gebracht wird.“"
                            },
                            {
                                "example_id": "9c2134b5-c731-44e2-809c-15b3a9e147cb",
                                "sense_id": "bd332d98-96be-35cb-9eb0-162a38896049",
                                "text": "„Am Montag, dem Jahrestag des deutschen Überfalls auf die Sowjetunion 1941, besuchte Putin die neue Hauptkirche der Streitkräfte im Militärfreizeitgelände ‚Park Patriot‘ nahe Moskau: Der tarnfarbene Großbau vereint Hammer-und-Sichel-Symbolik mit Heiligenbildern und Kreuzen, verzichtet aber auf ursprünglich geplante Putin- und Stalin-Mosaike.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
