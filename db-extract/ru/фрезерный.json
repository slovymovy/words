                        "form": "фре́зерны"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d16f50ab-a423-355c-b7f2-f3ea5563c271",
                        "entry_id": "d61d37c4-e733-36ae-b4f8-f3d4ce7f0929",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным фреза"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "775682c9-33e2-49a4-b869-d88db9a3b2a2",
                                "sense_id": "d16f50ab-a423-355c-b7f2-f3ea5563c271",
                                "text": "Советские инженеры создали и внедрили на многих предприятиях фрезерный способ добычи торфа."
                            },
                            {
                                "example_id": "e3a06d00-e3f3-4c01-b47f-6a4b2b161a64",
                                "sense_id": "d16f50ab-a423-355c-b7f2-f3ea5563c271",
                                "text": "Они познакомились давно, в научно-техническом секторе ВСНХ, куда Фома заезжал по вопросу об изысканиях фрезерной разработки торфа."
                            }
                        ]
                    },
                    {
                        "sense_id": "b005e88c-a90f-3c46-a988-ca5778c418ab",
                        "entry_id": "d61d37c4-e733-36ae-b4f8-f3d4ce7f0929",
                        "glosses": [
                            "связанный с механической обработкой металла, дерева и других материалов посредством фрезерования"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df111e4c-b1a5-4f2f-bd08-dfee44781a0b",
                                "sense_id": "b005e88c-a90f-3c46-a988-ca5778c418ab",
                                "text": "Ей нравилось токарное дело, нравилось и фрезерное; особенно прелестен был настольно-токарный станочек."
                            },
                            {
                                "example_id": "9a36168e-342a-40e5-ad2c-c77b0211da31",
                                "sense_id": "b005e88c-a90f-3c46-a988-ca5778c418ab",
                                "text": "В историческом городе Дмитрове построены механический завод, завод фрезерных станков и ряд других важных промышленных предприятий."
                            }
                        ]
                    },
                    {
                        "sense_id": "092b1309-fa40-336f-b21f-9fe74fe74dc8",
                        "entry_id": "d61d37c4-e733-36ae-b4f8-f3d4ce7f0929",
                        "glosses": [
                            "предназначенный для фрезеровщика"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5b95a91f-3504-34be-8a0d-e364455a096a",
                        "entry_id": "d61d37c4-e733-36ae-b4f8-f3d4ce7f0929",
                        "glosses": [
                            "состоящий из фрезеровщиков"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b25faa4-0f19-426f-bfa0-4c643b90e388",
                                "sense_id": "5b95a91f-3504-34be-8a0d-e364455a096a",
                                "text": "Ей трудно было понять, как он мог справляться со своими фрезерными, если на самом деле он так влюблен в книгу."
                            }
                        ]
                    }
                ],
