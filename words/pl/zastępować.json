                    "sense_definition": "pełnić czyjąś rolę lub wykonywać czyjeś zadania zamiast danej osoby",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "wymiana_ludzi",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W przyszłym tygodniu dyrektor jedzie na urlop i koleżanka <w>zastępuje</w> go w biurze.",
                            "target_lang_translations": {
                                "ru": "На следующей неделе директор уходит в отпуск, и коллега <w>замещает</w> его в офисе."
                            }
                        },
                        {
                            "text": "Kiedy nauczyciel choruje, inni pedagodzy chętnie go <w>zastępują</w> na lekcjach.",
                            "target_lang_translations": {
                                "ru": "Когда учитель болеет, другие педагоги охотно <w>заменяют</w> его на уроках."
                            }
                        }
                    ],
                    "synonyms": [
                        "wyręczać",
                        "pełnić obowiązki",
                        "pełnić funkcję w zastępstwie"
                    ],
