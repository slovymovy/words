                ],
                "senses": [
                    {
                        "sense_id": "afa5f44d-099d-3e43-a8fa-e275370bd87a",
                        "entry_id": "c7577af1-495f-31aa-b2cc-bf64ece24840",
                        "glosses": [
                            "dający życie; podtrzymujący istnienie"
