                        "glosses": [
                            "Relié à une famille dont les parents sont lesbiennes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6003fe55-5d4e-47ef-b084-3a68cbd0da83",
                                "sense_id": "1d4c16bb-6951-3ccf-b29e-887cdb74fd3a",
                                "text": "Ces enfants ont été élevés dans un contexte lesboparental."
                            },
                            {
                                "example_id": "23004c94-de37-4954-9bb4-311c1534de4f",
                                "sense_id": "1d4c16bb-6951-3ccf-b29e-887cdb74fd3a",
                                "text": "C’est aussi cette idée que les genres seraient complémentaires dans la parentalité qui est mise à mal par les résultats des décennies d’études empiriques sur les familles homoparentales ou lesboparentales."
                            },
                            {
                                "example_id": "cf3e9cdb-470b-45a8-ae18-10bd465e95fe",
                                "sense_id": "1d4c16bb-6951-3ccf-b29e-887cdb74fd3a",
                                "text": "Les familles lesboparentales sont réputées subversives en ce sens qu’elles contestent la représentation classique de la famille voulant qu’elle soit le fait d’un homme et d’une femme."
                            }
                        ]
                    }
