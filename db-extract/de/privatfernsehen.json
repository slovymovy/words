                "senses": [
                    {
                        "sense_id": "cbfdb932-1df0-3a55-b42a-556dc6400a12",
                        "entry_id": "572352c8-1e6e-359b-8a7b-e9f06f8c88fa",
                        "glosses": [
                            "Fernsehen, das in privater (statt in öffentlich-rechtlicher) Trägerschaft betrieben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b205dba-5334-41d9-be58-8c309e475708",
                                "sense_id": "cbfdb932-1df0-3a55-b42a-556dc6400a12",
                                "text": "„Nach Einführung des Privatfernsehens brachen die Zuschauerzahlen weiter ein.“"
                            },
                            {
                                "example_id": "d978cac8-3461-4696-afd6-267d6e975259",
                                "sense_id": "cbfdb932-1df0-3a55-b42a-556dc6400a12",
                                "text": "„Im deutschen Privatfernsehen gab es eine Sendung, die die Vermutung vieler besorgter Menschen thematisierte, die Welt würde womöglich von Außerirdischen attackiert.“"
                            },
                            {
                                "example_id": "962a3c86-bad0-4ee7-8dc8-c1856c26631f",
                                "sense_id": "cbfdb932-1df0-3a55-b42a-556dc6400a12",
                                "text": "„Als wir ab Ende der Achtzigerjahre Privatfernsehen empfingen, stachelte sie mich, wenn sie bei uns zu Besuch war, spätabends immer an, herumzuzappen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
