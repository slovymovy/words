                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5dd98b31-4d5e-4d6a-9ae0-df885f7242d1",
                                                "sense_id": "49c5e085-89d4-34fe-97f8-22b1122342ec",
                                                "text": "[…] & we went for a long walk & fatigued ourselves so that I, for one, took a caulk in the afternoon."
                                            }
