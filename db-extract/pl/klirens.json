                        "entry_id": "eddc86a4-cd69-3ab5-868b-93059253a5bc",
                        "glosses": [
                            "współczynnik określający objętość osocza, jakie w jednostce czasu zostanie oczyszczone z pewnej substancji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06398e48-5195-473f-b6c7-2117891c2321",
                                "sense_id": "2051ba2a-bbe4-32d9-bf5e-011e72c1d9fa",
                                "text": "Zmniejszenie klirensu metabolicznego analogu powoduje, że znajduje się on w większym stężeniu poza komórką i z tego powodu wywołuje silniejsze działanie regulacyjne."
                            }
