                ],
                "senses": [
                    {
                        "sense_id": "de23eace-2164-3733-b18d-66543c4a7eff",
                        "entry_id": "4d8fc458-3db8-35c7-8c64-b0e1284e2b0f",
                        "glosses": [
                            "Having four equal sides, the opposite sides parallel, and four right angles; square."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72f2fb64-8962-4a6b-a8eb-9f7f2a55f938",
                                "sense_id": "de23eace-2164-3733-b18d-66543c4a7eff",
                                "text": "Figures, some round, some triangle, some quadrate."
                            }
                        ]
                    },
                    {
                        "sense_id": "42812367-967c-38b7-af8d-4478ae9b461f",
                        "entry_id": "4d8fc458-3db8-35c7-8c64-b0e1284e2b0f",
                        "glosses": [
                            "Produced by multiplying a number by itself; square."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84d263da-12f5-480c-af61-116b52b7658b",
                                "sense_id": "42812367-967c-38b7-af8d-4478ae9b461f",
                                "text": "The number of Ten hath been as highly extolled, as containing even, odd, long, plain, quadrate and cubical numbers."
                            }
                        ]
                    },
                    {
                        "sense_id": "83b4bd52-e7ef-3173-a31a-af0f6682ac49",
                        "entry_id": "4d8fc458-3db8-35c7-8c64-b0e1284e2b0f",
                        "glosses": [
                            "Square; even; balanced; equal; exact."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "542159d1-0465-43dc-a289-ad952e788dbc",
                                "sense_id": "83b4bd52-e7ef-3173-a31a-af0f6682ac49",
                                "text": "a quadrat, solid, wise man"
                            }
                        ]
                    },
                    {
                        "sense_id": "189464ec-3d94-31b5-a1aa-046560050a5d",
                        "entry_id": "4d8fc458-3db8-35c7-8c64-b0e1284e2b0f",
                        "glosses": [
                            "Squared; suited; correspondent."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "99b0e28b-67b1-4106-8558-9d9e56dc9a5b",
                                "sense_id": "189464ec-3d94-31b5-a1aa-046560050a5d",
                                "text": "a generical description quadrate to both"
                            }
                        ]
                    }
                ],
