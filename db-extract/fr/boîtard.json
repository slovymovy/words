                        "glosses": [
                            "Boîte en fonte qui occupe le centre de la meule inférieure ou gisante."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "992caf2e-0aa9-4bc6-af27-fb96afe25f5b",
                                "sense_id": "f4a591a7-38dc-3c8b-b947-0addc158e0d6",
                                "text": "L'œillard est percé au centre d'une pièce de meulière très-dure, hexagone en général, qu'on appelle le boîtard. Pour la meule gisante ou dormante, le boîtard est en fonte, et le fer de meule le traverse sans laisser de jour."
                            }
                        ]
