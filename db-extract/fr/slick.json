                                                "example_id": "6355250c-d8d8-4935-bc40-b4dc05c85d16",
                                                "sense_id": "470b2de2-8b40-3e2f-ad55-28d1e79d04a4",
                                                "text": "The surface had been slicked."
                                            },
                                            {
                                                "example_id": "ff394ec0-d911-41b0-991b-c0d6b13371a5",
                                                "sense_id": "470b2de2-8b40-3e2f-ad55-28d1e79d04a4",
