{
    "word_family": [
        "supervision",
        "supervisor",
        "supervisory"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dcd2c773-4538-358d-a789-f1a7d0282033",
                    "sense_definition": "To oversee or direct a task, a project, or a group of people to ensure that everything is done correctly.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "management",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager will <w>supervise</w> the project to ensure that all deadlines are met on time.",
                            "target_lang_translations": {
                                "ru": "Менеджер будет <w>контролировать</w> проект, чтобы обеспечить соблюдение всех сроков."
                            }
                        },
                        {
                            "text": "It is difficult to <w>supervise</w> the work of a large team when you are working remotely.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>руководить</w> работой большой команды, когда вы работаете удаленно."
                            }
                        }
                    ],
                    "synonyms": [
                        "superintend"
                    ],
                    "common_phrases": [
                        "supervise the work",
                        "supervise the project",
                        "supervise the construction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наблюдать за выполнением задачи, проекта или работой группы людей, чтобы гарантировать правильность выполнения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "контролировать",
                                "target_lang_sense_clarification": "проверять ход выполнения"
                            },
                            {
                                "target_lang_word": "руководить",
                                "target_lang_sense_clarification": "управлять процессом или людьми"
                            },
                            {
                                "target_lang_word": "курировать",
                                "target_lang_sense_clarification": "осуществлять общее наблюдение за проектом"
                            },
                            {
                                "target_lang_word": "заведовать",
                                "target_lang_sense_clarification": "управлять отделом или направлением"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fefe2a39-d04f-36d6-9f95-c979618be227",
                    "sense_definition": "To look over or read something carefully; to peruse.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "reading",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scholar asked to <w>supervise</w> the ancient manuscript before it was returned to the vault.",
                            "target_lang_translations": {
                                "ru": "Ученый попросил <w>осмотреть</w> древнюю рукопись перед тем, как ее вернут в хранилище."
                            }
                        },
                        {
                            "text": "He took a moment to <w>supervise</w> the letter, checking for any hidden meanings in the text.",
                            "target_lang_translations": {
                                "ru": "Он выделил минутку, чтобы <w>изучить</w> письмо, проверяя, нет ли в тексте скрытых смыслов."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is no longer in common use."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внимательно просматривать или изучать что-либо; детально ознакомиться с текстом (устаревшее значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изучать",
                                "target_lang_sense_clarification": "внимательно рассматривать"
                            },
                            {
                                "target_lang_word": "осматривать",
                                "target_lang_sense_clarification": "тщательно проверять визуально"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}