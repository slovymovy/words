            "senses": [
                {
                    "sense_id": "9cf56b15-5b28-3bb7-9a2b-07be8af0258e",
                    "sense_definition": "Souhaits de bonheur, de santé ou de réussite que l'on formule pour autrui, en particulier lors du Nouvel An ou d'un événement festif.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "souhait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous vous envoyons nos meilleurs <w>vœux</w> de bonheur et de réussite pour la nouvelle année."
                        },
                        {
                            "text": "Pour leur mariage, nous avons adressé aux jeunes époux tous nos <w>vœux</w> de bonheur."
                        }
                    ],
                    "synonyms": [
                        "souhait"
                    ],
                    "common_phrases": [
                        "carte de vœux",
                        "meilleurs vœux"
                    ]
                },
                {
                    "sense_id": "65e7703b-1f4b-38ff-8d18-9dd77e893861",
                    "sense_definition": "Désir vif, souhait ardent ou aspiration de voir s'accomplir quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "souhait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le maire a formulé le <w>vœu</w> de voir ce projet de parc public aboutir rapidement."
                        },
                        {
                            "text": "Avant de souffler les bougies de son gâteau, l'enfant a fait un <w>vœu</w> en silence."
                        }
                    ],
                    "synonyms": [
                        "souhait"
                    ],
                    "common_phrases": [
                        "faire un vœu",
                        "émettre le vœu"
                    ]
                },
                {
                    "sense_id": "6c6eb997-1beb-394e-a0ff-6adae58e3f86",
                    "sense_definition": "Promesse solennelle et engagement formel, notamment pris envers Dieu ou au sein d'une communauté religieuse.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "promesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs années de noviciat, le moine a enfin prononcé ses <w>vœux</w> perpétuels."
                        },
                        {
                            "text": "La religieuse a toujours respecté strictement ses <w>vœux</w> de pauvreté et d'obéissance."
                        }
                    ],
                    "common_phrases": [
                        "prononcer ses vœux",
                        "vœu de silence",
                        "vœu de pauvreté"
                    ]
                },
                {
                    "sense_id": "5c8795b2-0e8f-30f7-943f-783db3ded727",
                    "sense_definition": "Demande ou choix d'affectation exprimé par un candidat dans une procédure d'orientation scolaire ou universitaire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "orientation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque lycéen doit confirmer l'ordre de ses <w>vœux</w> sur la plateforme d'admission avant la date limite."
                        },
                        {
                            "text": "Son premier <w>vœu</w> universitaire a été accepté dès l'ouverture des résultats."
                        }
                    ],
                    "common_phrases": [
                        "confirmer un vœu",
                        "liste de vœux"
                    ]
                }
            ]
        }
