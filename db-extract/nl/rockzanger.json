                        "examples": [
                            {
                                "example_id": "5e2fe614-dcff-4b84-9ac7-a128e85a5480",
                                "sense_id": "74314073-748c-3cde-a82c-81bd7192418d",
                                "text": "In de oude dorpswinkel van Sparrman die jaren geleden al op de fles ging, woont een oude rockzanger."
                            },
                            {
                                "example_id": "c06b7ef9-60dc-415f-af70-2d7f5e35d2a5",
                                "sense_id": "74314073-748c-3cde-a82c-81bd7192418d",
                                "text": "De beroemdste rockzanger van Oekraïne: Verslaggever Rudy Bouma is in de West-Oekraïense stad Lviv, die al dagen wordt overspoeld door Oekraïners op de vlucht. Hij gaat op pad met de bekende Oekraïense rockster en oud-parlementariër Svyatoslav Vakarchuk, die het land rondreist om militairen en vrijwilligers te steunen."
                            }
                        ]
