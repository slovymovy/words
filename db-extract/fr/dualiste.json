                                        "entry_id": "2850d5e0-6e77-30e5-808b-c7b3c7083779",
                                        "glosses": [
                                            "Of or supporting dualism."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ed8367f-be5b-4819-b906-450c4b63aed1",
                                                "sense_id": "8d6037a6-07de-3018-a3d4-0307c97601b0",
                                                "text": "She has a strictly dualist approach to morality."
                                            }
