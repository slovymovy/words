                "senses": [
                    {
                        "sense_id": "1ca88379-c356-3ead-a388-56fa33238eff",
                        "entry_id": "bde1978d-f86e-35bd-98d3-d9d9782f124d",
                        "glosses": [
                            "Prozess vom Reaktanten zum Produkt einer meist chemischen Reaktion, wobei Zwischenprodukte und Übergangszustände vollständig charakterisiert sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6f0f9f8-dee0-4551-bbbc-994e3ffd1367",
                                "sense_id": "1ca88379-c356-3ead-a388-56fa33238eff",
                                "text": "„Die Aufklärung eines Reaktionsmechanismus ist ein Inverses Problem, bei dem nicht nur Modellparameter zu bestimmen sind, sondern die Struktur des Modells zunächst unbekannt ist.“"
                            },
                            {
                                "example_id": "91d3e203-7f86-49a2-a962-10c7eda84ed6",
                                "sense_id": "1ca88379-c356-3ead-a388-56fa33238eff",
                                "text": "„Der Reaktionsmechanismus beschreibt den detaillierten Verlauf einer chemischen Reaktion in allen Teilschritten.“"
                            },
                            {
                                "example_id": "d35e6972-666b-41ee-ab45-f54e666f1357",
                                "sense_id": "1ca88379-c356-3ead-a388-56fa33238eff",
                                "text": "„Den Reaktionsmechanismus zu Beginn eines Sehvorgangs beschreibt ein Aufsatz in der neuesten Ausgabe der Zeitschrift ‚nature‘, an dem Dr. Oliver Weingart von der Universität Duisburg-Essen (UDE) mitgearbeitet hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
