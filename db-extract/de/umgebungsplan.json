                "senses": [
                    {
                        "sense_id": "34c80b76-caef-3d27-a490-5dbf59ae23dc",
                        "entry_id": "caa12e29-814f-3027-bc1a-01b3ff3134e0",
                        "glosses": [
                            "Plan, der die nähere Umgebung eines vorgegebenen Standortes zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "619463e3-1c9c-4db6-ac05-3b0b77e34e82",
                                "sense_id": "34c80b76-caef-3d27-a490-5dbf59ae23dc",
                                "text": "Der Umgebungsplan im Schaukasten ist nicht mehr aktuell."
                            },
                            {
                                "example_id": "ed561249-4ddd-46c7-87e1-b1a70829b1a1",
                                "sense_id": "34c80b76-caef-3d27-a490-5dbf59ae23dc",
                                "text": "„Die Straßenbahn- und Bushaltestellen in Wien bekommen ein neues Design. Fahr- und Umgebungspläne werden im A3-Format und damit doppelt so groß wie bisher zur Verfügung stehen.“"
                            },
                            {
                                "example_id": "aeefdf60-0ede-4626-9e36-1fb15044346f",
                                "sense_id": "34c80b76-caef-3d27-a490-5dbf59ae23dc",
                                "text": "„Für alles, was man sich an topographischem Wissensdurst sonst noch vorstellen kann, hält der \"Leipzig Atlas\" Labung parat - von der Wohnungsmarktentwicklung zur Sozialraumstruktur, vom Umgebungsplan des Jahres 1507 bis zur Wahlverteilung in den Stadtteilen bei den Kommunalwahlen 2004, von den Standorten des Musikgeschehens bis zum geologischen Schnitt durch den Nordsächsisch-Schwarzburger Grundgebirgssattel, auf dem das denkbar flache Leipzig ruht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
