                                                "sense_id": "d28e4f4d-a480-3fd3-b988-214966f28cdc",
                                                "text": "„Zum Trocknen von Gasen leitet man das Gas durch ein geeignetes Trockenmittel.“"
                                            },
                                            {
                                                "example_id": "9ec9f27b-f08c-4cf6-9448-5cc205986f50",
                                                "sense_id": "d28e4f4d-a480-3fd3-b988-214966f28cdc",
                                                "text": "Der Hauptvorteil des Trocknens liegt in der starken Verminderung des Raumbedarfes bei der Lagerung getrockneter Güter."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
