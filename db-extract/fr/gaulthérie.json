                        "entry_id": "c9ea2bf9-992e-35ee-b44c-ee3a25d786cb",
                        "glosses": [
                            "Petit arbuste forestier d’Amérique du Nord, de moins de quinze centimètres de hauteur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf7b5046-35d4-4dd4-9905-4f49bfbe2334",
                                "sense_id": "7af2c2ca-82cf-322b-a714-1b2665971100",
                                "text": "Elle respire l’odeur des baumes rangés sur l’étagère à côté de la table de massage. Des flacons contiennent des huiles, des chauffantes, des apaisantes, des anti-inflammatoires, des crèmes à la gaulthérie."
                            },
                            {
                                "example_id": "b595a159-e1b0-4319-830c-f9b27a3ac7a6",
                                "sense_id": "7af2c2ca-82cf-322b-a714-1b2665971100",
                                "text": "Les baies rouges de la gaulthérie résistent à l’hiver et contiennent une essence aromatique nommée « wintergreen »."
                            }
                        ]
                    }
