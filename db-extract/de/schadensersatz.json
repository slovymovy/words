                ],
                "senses": [
                    {
                        "sense_id": "3afd2b47-281c-3bd4-90bb-1c0310e9f018",
                        "entry_id": "e88c5e6b-d733-36dd-a8a2-f86c8e6412c7",
                        "glosses": [
                            "Ausgleich/Kompensation für einen entstandenen Schaden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c818effb-1897-42bc-a0e6-e0dafe26edc0",
                                "sense_id": "3afd2b47-281c-3bd4-90bb-1c0310e9f018",
                                "text": "„Vier Ex-Fahnder verlangen Schadensersatz, weil sie aufgrund unlauterer Gutachten zwangspensioniert wurden.“"
                            },
                            {
                                "example_id": "44183b8a-f0d4-4dd3-83b1-7b6906378a39",
                                "sense_id": "3afd2b47-281c-3bd4-90bb-1c0310e9f018",
                                "text": "„In dem Fall hatte die Klägerin Schadensersatz für Schmuck verlangt, der aus ihrem Reisegepäck verschwunden war.“"
                            },
                            {
                                "example_id": "1eeabdd8-0a45-4470-9cf7-5a936a35cd63",
                                "sense_id": "3afd2b47-281c-3bd4-90bb-1c0310e9f018",
                                "text": "„Erst am Donnerstag kündigte Stöckl an, erstmals eine Bank auf Schadensersatz zu klagen.“"
                            },
                            {
                                "example_id": "acdc904f-ce49-4911-b36f-75062b53dc62",
                                "sense_id": "3afd2b47-281c-3bd4-90bb-1c0310e9f018",
                                "text": "„Ein nach sonstigen Vorschriften begründeter Anspruch auf Schadensersatz bleibt unberührt.“"
                            },
                            {
                                "example_id": "df7c590d-38a8-49e4-abbb-f900a6843fbf",
                                "sense_id": "3afd2b47-281c-3bd4-90bb-1c0310e9f018",
                                "text": "„Wer schuldlos in einen Unfall verwickelt wird, hat in der Regel Anspruch auf Schadensersatz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
