                    {
                        "sense_id": "2a1ee155-d113-31b1-b232-1fb75aebdf9e",
                        "entry_id": "28fd22ee-8459-3fb1-9552-3a36f1c5aa99",
                        "glosses": [
                            "japanischer Heiztisch, für die kalte Jahreszeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72e6b1eb-5529-4642-814a-aacbd884d41c",
                                "sense_id": "2a1ee155-d113-31b1-b232-1fb75aebdf9e",
                                "text": "Verstohlen greift der Sohn unter dem Kotatsu nach der Hand des Nachbarmädchens, ergreift aber die der Mutter."
                            },
                            {
                                "example_id": "9129e092-aa66-4fd8-9846-6f6056e28a40",
                                "sense_id": "2a1ee155-d113-31b1-b232-1fb75aebdf9e",
                                "text": "Nur wenige japanische Wohnungen haben eine Heizung, wie Europäer sie kennen, hier hält man sich an einem Kotatsu warm. Die ganze Familie sammelt sich dort und hat die dicke Steppdecke auf den Knien liegen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
