                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nose",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wiped his <w>snitch</w> with a clean handkerchief.",
                            "target_lang_translations": {
                                "fr": "Il s'est essuyé le <w>pif</w> avec un mouchoir propre."
                            }
                        },
                        {
                            "text": "She looked down her <w>snitch</w> at the messy room.",
                            "target_lang_translations": {
                                "fr": "Elle a regardé la pièce en désordre en fronçant le <w>pif</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "schnozz",
                        "sneck"
