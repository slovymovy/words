                ],
                "senses": [
                    {
                        "sense_id": "7b8b6297-e33e-32a3-a2b1-b357c90e4176",
                        "entry_id": "ef42d4f0-d039-3719-bee6-a88dc1b79b9a",
                        "glosses": [
                            "temporäre Gefangennahme zur Verhinderung von und vor Begehung einer Ordnungswidrigkeit oder Straftat durch eine Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ad5af3e-997e-4b26-b6df-b04da9fca88d",
                                "sense_id": "7b8b6297-e33e-32a3-a2b1-b357c90e4176",
                                "text": "„Ohne Anklage in Präventivhaft festsitzen, Dauer ungewiss – was sich nach einem Zustand in einer hoffentlich weit entfernten Diktatur anhört, ist in Bayern seit gut einem Jahr möglich.“"
                            },
                            {
                                "example_id": "f0bc931b-bafd-4386-8bcd-d04abe2876cd",
                                "sense_id": "7b8b6297-e33e-32a3-a2b1-b357c90e4176",
                                "text": "[Das bayerische Polizeiaufgabengesetz] „sieht den Einsatz von elektronischen Fußfesseln, die Neuregelung von Aufenthaltsverboten- und Pflichten, die Überwachung der Kommunikation und eine verlängerte Präventivhaft von bis zu drei Monaten vor.“"
                            },
                            {
                                "example_id": "6f6a8e3c-aa3c-43d8-bb9e-eb06f49ec998",
                                "sense_id": "7b8b6297-e33e-32a3-a2b1-b357c90e4176",
                                "text": "„Laut PAG-Kommission wurde zwischen August 2017 und Juli 2018 in Bayern in insgesamt elf Fällen von Richtern eine Präventivhaft von mehr als zwei Wochen angeordnet.“"
                            },
                            {
                                "example_id": "70ace3d7-2587-4aee-9d6a-3e46bc1ab6f2",
                                "sense_id": "7b8b6297-e33e-32a3-a2b1-b357c90e4176",
                                "text": "„Präventivhaft für Klima-Aktivisten, wie die CSU sie fordert, findet Alexander Klar „albern“.“"
                            },
                            {
                                "example_id": "ac0c82b6-425f-467c-ba5c-7504343e924d",
                                "sense_id": "7b8b6297-e33e-32a3-a2b1-b357c90e4176",
                                "text": "„Präventivhaft für Stauverursacher ist der völlig falsche Weg,“ […]."
                            },
                            {
                                "example_id": "fe3f2a8b-d17d-4f99-9f1f-9147f96eb55a",
                                "sense_id": "7b8b6297-e33e-32a3-a2b1-b357c90e4176",
                                "text": "„Monatelange Präventivhaft ohne Prozess vergiftet nur das Klima – in jeder Hinsicht. Das kann niemand wollen.“"
                            },
                            {
                                "example_id": "94ef1587-245a-4a36-a293-56fa710aae1e",
                                "sense_id": "7b8b6297-e33e-32a3-a2b1-b357c90e4176",
                                "text": "[USA:] „Meiner Ansicht nach stellt die Tatsache, dass es keine Präventivhaft gibt, den größten denkbaren Schutz für die Bürgerrechte in den USA dar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
