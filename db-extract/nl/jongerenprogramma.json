                        "examples": [
                            {
                                "example_id": "06add542-7300-429c-86c3-e6627889b70e",
                                "sense_id": "74d08761-7124-37d0-88dc-49fbd7e614f9",
                                "text": "Nyck de Vries heeft voor het eerst een hoofdrace gewonnen in de Formule 2. De 23-jarige coureur liet op het circuit in Boedapest Lando Norris, zijn collega uit het jongerenprogramma van racestal McLaren, achter zich."
