                                        "examples": [
                                            {
                                                "example_id": "9abb3bd3-ffc4-4ff3-be52-e8e3f4907b02",
                                                "sense_id": "cb1338f6-e400-3047-83d7-e5d112764327",
                                                "text": "When girls appropriate a male-dominated form like HM, can they discard its sexist content without replacing it with something else?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7f7a63f-2e62-3a88-bed9-4c53064f6ff2",
                                        "entry_id": "37eae0bf-1cec-319d-8195-a195673a24e4",
                                        "glosses": [
                                            "Initialism of hidden machine"
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1083c9db-de2c-4b34-b6f1-37d8d9084070",
                                                "sense_id": "f7f7a63f-2e62-3a88-bed9-4c53064f6ff2",
                                                "text": "For any obstacle in the way, HMs such as Cut and Strength must be taught to one of the six Pokémon in the trainer's party. […] Relicanth is a relatively unsurprising inclusion. It fulfills the ideal requirements for an HM mule in that it can learn four HMs: Surf, Waterfall, Dive, and Rock Smash. That last one is what edges it out over other Water-types such as Luvdisc."
                                            }
                                        ]
                                    }
                                ]
                            },
