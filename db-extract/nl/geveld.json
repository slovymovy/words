                        "examples": [
                            {
                                "example_id": "4c9de5c3-620b-434a-9909-c555ac7b3c99",
                                "sense_id": "0f20b401-900e-30f5-ab95-8c4579bf07ad",
                                "text": "Door hartaanval gevelde regisseur Kevin Smith bedankt fans vanuit ziekenhuis"
                            },
                            {
                                "example_id": "f16ec35c-6455-4f0e-a786-285107faa299",
                                "sense_id": "0f20b401-900e-30f5-ab95-8c4579bf07ad",
                                "text": "Buren hoorden iemand wegrennen. Een overbuurman is naar buiten gestormd, maar zag noch het gevelde slachtoffer in het donkere gangpad noch de vluchtende dader. Sommige buurtbewoners maken zichzelf verwijten dat ze geen poolshoogte zijn gaan nemen, zodat het slachtoffer eerder zou zijn gevonden."
                            }
                        ]
                    },
