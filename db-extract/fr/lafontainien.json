                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e224e70-f625-4f82-89b6-462f36b7863f",
                                "sense_id": "d6600fd8-86ca-35d9-8443-51e15da495fe",
                                "text": "Il se trouve continuellement dans le conte des vers sur les principaux motifs lafontainiens, comme cet adieu de la femme de Joconde, le premier de ces adieux qui sont les points d'orgue de l'émotion de La Fontaine, toujours si vive dès qu'il s'agit d'absence."
                            },
                            {
