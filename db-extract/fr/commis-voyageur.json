                "senses": [
                    {
                        "sense_id": "6c084e43-d051-3fd1-a101-68e4e8db1aae",
                        "entry_id": "49e1bfb8-518f-3e92-908b-cab7d9e0c0d8",
                        "glosses": [
                            "Celui qui voyage pour vendre des produits. Équivalent du métier moderne d’un commercial ou d’un technico-commercial."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "97875127-28a2-48d6-bcde-787c03489299",
                                "sense_id": "6c084e43-d051-3fd1-a101-68e4e8db1aae",
                                "text": "Mais c’est meugnon tout plein, ça, minaudai-je, avec des grâces ridicules de commis-voyageur égrillard."
                            },
                            {
                                "example_id": "55fd6d66-f900-4050-83b2-73fa9c251405",
                                "sense_id": "6c084e43-d051-3fd1-a101-68e4e8db1aae",
                                "text": "Il avait plus appris dans une année (comme commis-voyageur pour le placement d’un article dont personne ne voulait entendre parler, et moins encore faire l’emplette ; c’était avant qu’il entrât dans la partie des vins) que pendant les six ans qu’il avait passés dans une institution dirigée par un bachelier d’Oxford…"
                            },
                            {
                                "example_id": "7adc99ef-4561-4279-9265-f765a49bc58e",
                                "sense_id": "6c084e43-d051-3fd1-a101-68e4e8db1aae",
                                "text": "Josépha, c’est de la gnognote ! cria l’ancien commis-voyageur."
                            }
                        ]
                    }
                ],
