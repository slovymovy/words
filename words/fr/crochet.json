    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4f1daec2-279f-30b0-9544-9c6c4725da2a",
                    "sense_definition": "Pièce rigide et recourbée servant à suspendre, attacher ou retenir quelque chose.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "outil_objet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu peux suspendre ton manteau au <w>crochet</w> fixé derrière la porte d'entrée."
                        },
                        {
                            "text": "Elle a fixé plusieurs <w>crochets</w> métalliques dans la cuisine pour ranger ses ustensiles."
                        }
                    ],
                    "synonyms": [
                        "croc",
                        "patère"
                    ],
                    "common_phrases": [
                        "crochet en fer",
                        "crochet de boucher"
                    ]
                },
                {
                    "sense_id": "6d1acb02-4532-3953-86f7-66a19171f8a4",
                    "sense_definition": "Aiguille munie d'une encoche à son extrémité pour confectionner des tissus de laine ou de coton, ou travail réalisé avec cet outil.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "outil_objet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ma grand-mère passe ses après-midi d'hiver à faire du <w>crochet</w> près de la cheminée."
                        },
                        {
                            "text": "Elle a acheté un nouveau <w>crochet</w> plus fin pour confectionner une nappe délicate."
                        }
                    ],
                    "common_phrases": [
                        "faire du crochet",
                        "point de crochet"
                    ]
                },
                {
                    "sense_id": "906efcda-5c77-3d54-8204-bd29fd94baae",
                    "sense_definition": "Signe de ponctuation formé de barres verticales à angles droits, utilisé pour encadrer des précisions ou des modifications dans un texte.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "typographie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'éditeur a inséré la correction du manuscrit entre deux <w>crochets</w>."
                        },
                        {
                            "text": "En typographie, on utilise un <w>crochet</w> ouvrant pour ajouter une note explicative."
                        }
                    ],
                    "common_phrases": [
                        "entre crochets"
                    ]
                },
                {
                    "sense_id": "04b493a0-efeb-3338-b04b-9241116babd6",
                    "sense_definition": "Changement brusque de direction pour contourner un obstacle ou s'écarter de la trajectoire directe.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons fait un petit <w>crochet</w> sur la route pour admirer le château médiéval."
                        },
                        {
                            "text": "L'attaquant a éliminé le défenseur d'un superbe <w>crochet</w> avant de tirer au but."
                        }
                    ],
                    "synonyms": [
                        "détour",
                        "feinte"
                    ],
                    "common_phrases": [
                        "faire un crochet"
                    ]
                },
                {
                    "sense_id": "d1436166-65a4-3d51-a6a5-efd6b75f8c84",
                    "sense_definition": "Coup de poing latéral porté avec le bras replié vers l'intérieur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "combat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le boxeur a surpris son adversaire avec un puissant <w>crochet</w> du droit au menton."
                        },
                        {
                            "text": "Il a esquivé l'attaque avant de répliquer par plusieurs <w>crochets</w> rapides au corps."
                        }
                    ],
                    "antonyms": [
                        "direct"
                    ],
                    "common_phrases": [
                        "crochet du gauche",
                        "crochet du droit"
                    ]
                },
                {
                    "sense_id": "fa81ccd7-30bd-328f-a353-846565e8348d",
                    "sense_definition": "Dent pointue et recourbée propre à certains animaux, en particulier celle servant à injecter le venin chez les serpents.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "anatomie_animale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette vipère injecte son venin mortel à travers deux redoutables <w>crochets</w>."
                        },
                        {
                            "text": "Le chercheur examine avec précaution chaque <w>crochet</w> du serpent venimeux."
                        }
                    ],
                    "synonyms": [
                        "croc"
                    ],
                    "common_phrases": [
                        "crochets venimeux"
                    ]
                }
            ]
        }
    ]
