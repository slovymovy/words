                        "sense_id": "df054cc7-2c02-35f0-8db9-c51b58351544",
                        "entry_id": "266d989f-4dcb-3131-bca8-3b59ee9224e3",
                        "glosses": [
                            "een statische afbeelding (\\\"foto\\\") van wat er op een bepaald moment zichtbaar is op (een deel van) een beeldscherm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "225e320a-2f3b-405d-be9f-7b272ea70a0d",
                                "sense_id": "df054cc7-2c02-35f0-8db9-c51b58351544",
                                "text": "Maar vooral haar voedsellijst en haar bevoorradingsplan waren erg handig. Op haar blog vond ik twee screenshots van haar voedsellijst die ik geheel heb overgetypt in Excel."
                            },
                            {
                                "example_id": "14d35ab1-9fd9-4f99-a9cd-b9aaa2047416",
                                "sense_id": "df054cc7-2c02-35f0-8db9-c51b58351544",
                                "text": "De scholen merken dat sociale media een groot deel van de problemen veroorzaken. Zo kunnen leerlingen hun schoolgenoten via Snapchat bedreigen. Die berichten poppen eventjes op in het beeldscherm en verdwijnen gelijk weer. ,,Als een leerling er een screenshot van maakt, ziet de bedreiger dat."
                            }
                        ]
                    }
