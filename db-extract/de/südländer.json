                ],
                "senses": [
                    {
                        "sense_id": "c8f564e0-ee75-3df9-b76d-f13143450b0a",
                        "entry_id": "b961e89e-7d43-3017-b8eb-45da6105d01e",
                        "glosses": [
                            "Bewohner eines im Süden gelegenen Landes, vor allem im Mittelmeerraum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53752416-5d7c-4679-b9f7-62049d3d350f",
                                "sense_id": "c8f564e0-ee75-3df9-b76d-f13143450b0a",
                                "text": "Die Existenz vieler Südländer ist vom Tourismus abhängig."
                            },
                            {
                                "example_id": "6783b907-93fa-4873-a8d4-c014a3e05e52",
                                "sense_id": "c8f564e0-ee75-3df9-b76d-f13143450b0a",
                                "text": "„Zuzutrauen wäre den feurigen Südländern ein solches Bubenstück schon.“"
                            },
                            {
                                "example_id": "bef49d3e-7c51-43cb-8fef-5efbc23d3478",
                                "sense_id": "c8f564e0-ee75-3df9-b76d-f13143450b0a",
                                "text": "„Luis wirkte an ihrer Seite als schöner Südländer, dunkel und markant, mit großen, schwarzen Augen, starkem Bartwuchs, das Haar ein wenig gelockt, ein wenig zerzaust.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
