                "senses": [
                    {
                        "sense_id": "cec98970-725a-3032-b570-a72510272191",
                        "entry_id": "fa156693-11ea-3ee4-aff8-1c48cd21dd73",
                        "glosses": [
                            "Erforschung der Bedingungen und Grundlagen für dauerhaften Frieden zwischen Staaten, Völkern und Menschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0230aed-fcf7-4a66-8c36-8d5a1606266b",
                                "sense_id": "cec98970-725a-3032-b570-a72510272191",
                                "text": "„Der Tendenz zur postmodernen Kriegführung könnte man mit den Erkenntnissen der liberalen Friedenstheorien begegnen.“"
                            },
                            {
                                "example_id": "bc49d872-4a14-4570-a8ca-a8cc2acb3b41",
                                "sense_id": "cec98970-725a-3032-b570-a72510272191",
                                "text": "„In Zusammenhang gebracht mit der Demokratischen Friedenstheorie, wird der Konflikt zwischen Indien und Pakistan von Muppidi (2001) näher analysiert.“"
                            },
                            {
                                "example_id": "99af080e-d513-4c03-8b5e-b95dfb73b2de",
                                "sense_id": "cec98970-725a-3032-b570-a72510272191",
                                "text": "„Die dominierende Denkschule auf diesem Gebiet ist das Konzept der liberalen Friedenskonsolidierung, das aus der demokratischen Friedenstheorie entstanden ist.“"
                            },
                            {
                                "example_id": "e56e2418-6484-4a5d-a086-85b10c217f07",
                                "sense_id": "cec98970-725a-3032-b570-a72510272191",
                                "text": "„Die demokratische Friedenstheorie funktioniert auch in den Kolonien nicht besonders gut.“"
                            },
                            {
                                "example_id": "4f5bab8d-63bc-4ecf-af80-a48fac4521d0",
                                "sense_id": "cec98970-725a-3032-b570-a72510272191",
                                "text": "„Seit dem Aufkommen der ersten Friedenstheorien hat sich eine Vielfalt an internationalen Institutionen im Bereich der institutionalisierten Sicherheits- und Friedenspolitik entwickelt.“"
                            },
                            {
                                "example_id": "ce327e1e-ec7e-4b02-a43d-33e60b60fc44",
                                "sense_id": "cec98970-725a-3032-b570-a72510272191",
                                "text": "„Der größte Teil der Ausführungen handelt von der Friedenstheorie angesichts der damals heiß geführten Diskussion um die menschliche Aggression.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
