                "senses": [
                    {
                        "sense_id": "6974b8fe-5246-3117-83c8-022264de7bc9",
                        "entry_id": "e386c0a2-bff5-3099-bf96-97ef116241ca",
                        "glosses": [
                            "Auseinandersetzung zwischen nah beieinander lebenden Parteien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74e702f6-a99c-4bac-a936-a6b67c8475a6",
                                "sense_id": "6974b8fe-5246-3117-83c8-022264de7bc9",
                                "text": "Ein Gericht musste den Nachbarschaftsstreit um einen Knallerbsenstrauch und einen Maschendrahtzaun beilegen."
                            },
                            {
                                "example_id": "9b458f30-5ff2-48a9-9ade-9a8a2d52cb0f",
                                "sense_id": "6974b8fe-5246-3117-83c8-022264de7bc9",
                                "text": "„Nachbarschaftsstreit eskaliert: Mann geht mit Besen auf Ehepaar los“"
                            },
                            {
                                "example_id": "3d738956-944b-495f-8eb1-44a1e32c944d",
                                "sense_id": "6974b8fe-5246-3117-83c8-022264de7bc9",
                                "text": "„Mit zwei Entscheidungen endete der zweite Prozesstag eines Nachbarschaftsstreites im Altkreis Ziegenhain.“"
                            },
                            {
                                "example_id": "64e679dc-64d7-482f-a6e2-9501b1d4f650",
                                "sense_id": "6974b8fe-5246-3117-83c8-022264de7bc9",
                                "text": "„Mit welchen Nachbarschaftsstreits sich Gerichte teilweise beschäftigen müssen, ist kurios: Zum Beispiel im Fall der Familie Koller. Sie wohnt seit einigen Jahren in Haiming im Landkreis Altötting direkt am Golfplatz. Eigentlich ein Traum.“"
                            },
                            {
                                "example_id": "812eafdf-dc7f-4c12-a6b8-a7af33699aad",
                                "sense_id": "6974b8fe-5246-3117-83c8-022264de7bc9",
                                "text": "„Ein lang andauernder Nachbarschaftsstreit in einem Nettersheimer Ortsteil wird zu Beginn des neuen Jahres ein juristisches Nachspiel haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
