                ],
                "senses": [
                    {
                        "sense_id": "3cb15ed8-6206-3d67-bd1d-572759955c8a",
                        "entry_id": "2383d9e3-9a00-3274-a150-daa669bbd594",
                        "glosses": [
                            "de kracht die zorgt voor de voortbeweging van een voertuig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e515e81e-497d-409f-9004-bd515adafc4c",
                                "sense_id": "3cb15ed8-6206-3d67-bd1d-572759955c8a",
                                "text": "Alle versies van de Stinger hebben een achttraps automaat, die de aandrijfkrachten aan de achterwielen of aan alle vier wielen doorgeeft."
                            },
                            {
                                "example_id": "503fb144-7c12-4e8f-be1b-99a44a4b44dd",
                                "sense_id": "3cb15ed8-6206-3d67-bd1d-572759955c8a",
                                "text": "De A6 rijdt ook nog eens erg comfortabel. Onderweg voel je wel dat de Audi een voorwielaandrijver is; de aandrijfkrachten zijn nadrukkelijk aanwezig in de verder wat doods aanvoelende besturing."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82daa71e-3546-4a7b-9d61-6159512a740d",
                        "source_entry_id": "2383d9e3-9a00-3274-a150-daa669bbd594",
                        "source_sense_id": "3cb15ed8-6206-3d67-bd1d-572759955c8a",
                        "target_lang_word": "propelling power",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c0887d28-45cb-46ec-8b6e-ed6cd6c52fc5",
                        "source_entry_id": "2383d9e3-9a00-3274-a150-daa669bbd594",
                        "source_sense_id": "3cb15ed8-6206-3d67-bd1d-572759955c8a",
                        "target_lang_word": "propulsion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "propulsion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8612a7e-3d9c-3fbe-b26e-6d1eaf935a80",
                                        "entry_id": "116d9ba7-ef7f-3e8b-b9ab-98f7818069a0",
                                        "glosses": [
                                            "The process of propelling, driving, or pushing, typically forward or onward; a propulsive force or impulse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3fbff729-4f30-3f8e-b37d-2b05d4244ba7",
                                        "entry_id": "116d9ba7-ef7f-3e8b-b9ab-98f7818069a0",
                                        "glosses": [
                                            "That which propels."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "511b89cd-f98e-4ff8-a517-97daff576ddb",
                                                "sense_id": "3fbff729-4f30-3f8e-b37d-2b05d4244ba7",
                                                "text": "However, nuclear propulsion provides a very high specific impulse and consistent, long duration energy source."
                                            },
                                            {
                                                "example_id": "bddd4b46-da35-4ff7-b7c6-af863f4c30af",
                                                "sense_id": "3fbff729-4f30-3f8e-b37d-2b05d4244ba7",
                                                "text": "This propulsion provides an initial velocity for the vehicle in a short time span."
                                            },
                                            {
                                                "example_id": "d4820fe3-c51a-4654-af9f-bee71402a757",
                                                "sense_id": "3fbff729-4f30-3f8e-b37d-2b05d4244ba7",
                                                "text": "Solar-electric propulsion accelerates a spacecraft by means of a low-thrust ion jet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e31b229a-7974-48a4-8438-056a08f1fd22",
                        "source_entry_id": "2383d9e3-9a00-3274-a150-daa669bbd594",
                        "source_sense_id": "3cb15ed8-6206-3d67-bd1d-572759955c8a",
                        "target_lang_word": "driving force",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "driving force",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16704764-1855-3fbe-a014-1ce873a85634",
                                        "entry_id": "7d4051f0-6e93-37e7-9113-63e95f801a37",
                                        "glosses": [
                                            "Impetus; a person or thing that causes, stimulates, or motivates something to happen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a94d087b-9d97-4346-9f28-ae09f2fab5ff",
                                                "sense_id": "16704764-1855-3fbe-a014-1ce873a85634",
                                                "text": "Many authors see a digital revolution taking place today and stress that this is a driving force behind many changes in companies."
                                            },
                                            {
                                                "example_id": "44b66134-fd4f-4855-94a1-b7a3c86785c0",
                                                "sense_id": "16704764-1855-3fbe-a014-1ce873a85634",
                                                "text": "Every living creature has a driving force that pushes him in the direction of certain goals."
                                            },
                                            {
                                                "example_id": "feae9972-e49d-403d-8933-5d1cf1cd4733",
                                                "sense_id": "16704764-1855-3fbe-a014-1ce873a85634",
                                                "text": "With the aim of moving toward our subsequent discussion of the driving forces behind mass indebtedness, however, we might take things a little further by condensing the original work's detailed breakdown into two very broad causes of individual indebtedness."
                                            },
                                            {
                                                "example_id": "8b197829-7cff-491a-a537-a8333892f301",
                                                "sense_id": "16704764-1855-3fbe-a014-1ce873a85634",
                                                "text": "Sheikh Mohammed is the driving force behind the transformation of Dubai into one of the great cities of the modern world: a hub for business and tourism, and the world's gateway to the Middle East."
                                            },
                                            {
                                                "example_id": "21ecfcdd-7070-42d6-9983-5a2756c0c149",
                                                "sense_id": "16704764-1855-3fbe-a014-1ce873a85634",
                                                "text": "Marples, who later fled to Monaco to escape prosecution for fraud, was the driving force behind The Reshaping of British Railways report published on March 27 1963. Dr Richard Beeching [who wrote the report] was just his fall guy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f0fad36-2daf-3334-9b5f-6332f316ab6d",
                                        "entry_id": "7d4051f0-6e93-37e7-9113-63e95f801a37",
                                        "glosses": [
                                            "The force that causes something to move or a physical process to occur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "093d1331-2063-448a-9f31-f12cdded7e85",
                                                "sense_id": "7f0fad36-2daf-3334-9b5f-6332f316ab6d",
                                                "text": "Diffusing particles experience a drift motion in addition to random diffusion, when an external driving force is applied."
                                            },
                                            {
                                                "example_id": "1a81dcf6-037f-4b4b-8751-2fefbd3e3ecf",
                                                "sense_id": "7f0fad36-2daf-3334-9b5f-6332f316ab6d",
                                                "text": "The total driving force is the sum of two forces: an electrical force (e.g. the negative potential in the cell tends to pull in positively charged ions) and a diffusion force (based on the concentration gradient) (fig. 3-5)."
                                            },
                                            {
                                                "example_id": "054e9504-5317-4368-ad4d-f9f7bd060d5a",
                                                "sense_id": "7f0fad36-2daf-3334-9b5f-6332f316ab6d",
                                                "text": "The ions transport through the fuel cell electrolytes under the influence of both electrical potential gradient and concentration gradient as the driving forces."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
