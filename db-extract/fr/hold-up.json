                    {
                        "sense_id": "f62b98df-a22b-37b2-ad57-604c967f4901",
                        "entry_id": "5f30fa23-64bc-353e-8b9a-a4fd749d583f",
                        "glosses": [
                            "Braquage, vol à main armée, attaque à main armée."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "f81f497d-b8bd-4d7d-85f0-0ec97081b4c1",
                                "sense_id": "f62b98df-a22b-37b2-ad57-604c967f4901",
                                "text": "Les hold-up lui faisaient peur."
                            }
                        ]
                    },
                    {
                        "sense_id": "31496443-fd1e-34a0-a722-a23a49a034ad",
                        "entry_id": "5f30fa23-64bc-353e-8b9a-a4fd749d583f",
                        "glosses": [
                            "Accaparement injuste de quelque chose."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "acbd58a1-3ea7-4ba3-a2ac-0271954bce9a",
                                "sense_id": "31496443-fd1e-34a0-a722-a23a49a034ad",
                                "text": "Verisign fait un hold-up sur tous les noms de domaines qui n’existent pas…encore."
                            },
                            {
                                "example_id": "dbf9e73f-3b1e-4e00-888d-a036df5dfa3a",
                                "sense_id": "31496443-fd1e-34a0-a722-a23a49a034ad",
                                "text": "\"C'est la première fois que François Fillon utilise comme vocabulaire politique les mots de sexisme, de misogynie et ce n'est pas crédible\". \"C'est un petit hold-up sur le féminisme\", a-t-elle expliqué.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "19b87730-c72b-339f-8eb8-2c433c9bb0bd",
                        "entry_id": "5f30fa23-64bc-353e-8b9a-a4fd749d583f",
                        "glosses": [
                            "Accaparement au dernier moment de quelque chose, en particulier de la médaille d’or dans le sport."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4b6df108-d74e-4592-8cf3-a9618e545435",
                                "sense_id": "19b87730-c72b-339f-8eb8-2c433c9bb0bd",
                                "text": "TOP 14 : le talentueux hold-up du Stade Toulousain !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "022857af-da37-4f89-972a-6e647711c23b",
                        "source_entry_id": "5f30fa23-64bc-353e-8b9a-a4fd749d583f",
                        "source_sense_id": "f62b98df-a22b-37b2-ad57-604c967f4901",
                        "source_sense_description": "(Anglicisme) (Droit) Braquage, vol à main armée, attaque à main armée.",
                        "target_lang_word": "hold-up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hold-up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa4f41fb-af9e-3b4e-bdfc-378a40d60e55",
                                        "entry_id": "e2f93dd0-3720-3510-90bc-0c8fc67aebf7",
                                        "glosses": [
                                            "A delay or wait."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef1d4956-0b1f-40a1-ae70-b9ed09497cea",
                                                "sense_id": "fa4f41fb-af9e-3b4e-bdfc-378a40d60e55",
                                                "text": "What is the hold-up?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54682815-3c7a-366a-98e7-476a393f464e",
                                        "entry_id": "e2f93dd0-3720-3510-90bc-0c8fc67aebf7",
                                        "glosses": [
                                            "A robbery at gunpoint."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbbcee43-1c46-4e00-93bc-733667d75496",
                                                "sense_id": "54682815-3c7a-366a-98e7-476a393f464e",
                                                "text": "This is a hold-up! Give us all your money."
                                            },
                                            {
                                                "example_id": "ffe152be-589a-44a9-bbde-fcc5aeb6120c",
                                                "sense_id": "54682815-3c7a-366a-98e7-476a393f464e",
                                                "text": "They didn't get shot to death in hold-ups, strangled to death in rapes, stabbed to death in saloons, bludgeoned to death with axes by parents or children or die summarily by some other act of God."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7112d621-b8c5-3767-bd99-56a687bd5719",
                                        "entry_id": "e2f93dd0-3720-3510-90bc-0c8fc67aebf7",
                                        "glosses": [
                                            "The holding back of a card that could win a trick in order to use it later."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5aed6fb4-9bbf-4cad-8eac-4b84ce55e891",
                                                "sense_id": "7112d621-b8c5-3767-bd99-56a687bd5719",
                                                "text": "This was another hand on which a holdup caused declarer to lose control and to go down in a sensational way: […]"
                                            },
                                            {
                                                "example_id": "d5fb2057-7d01-466c-ab3c-df29791389f3",
                                                "sense_id": "7112d621-b8c5-3767-bd99-56a687bd5719",
                                                "text": "In a holdup, a player delays taking a trick until opponents' entries are reduced."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a66a7d86-2cf2-355c-b66b-91799e6b899b",
                                        "entry_id": "e2f93dd0-3720-3510-90bc-0c8fc67aebf7",
                                        "glosses": [
                                            "Women's stockings designed to be worn without suspenders."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fdee408c-6cec-333e-8434-8d9eabebb634",
                                        "entry_id": "e2f93dd0-3720-3510-90bc-0c8fc67aebf7",
                                        "glosses": [
                                            "The inventory of nuclear material within a separation plant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee9b2537-fd4c-475a-b8b0-025ba155d66a",
                                                "sense_id": "fdee408c-6cec-333e-8434-8d9eabebb634",
                                                "text": "And to the left is a portable gamma counter that tells us the holdup of plutonium recovery facilities."
                                            },
                                            {
                                                "example_id": "94546b20-a3a2-4084-83a2-8dbd74661d79",
                                                "sense_id": "fdee408c-6cec-333e-8434-8d9eabebb634",
                                                "text": "During process operations and temporary shutdown, the holdup within the facility is also known as the in-process inventory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1efb7ae4-0163-3a45-910d-65b658f73ecf",
                                        "entry_id": "e2f93dd0-3720-3510-90bc-0c8fc67aebf7",
                                        "glosses": [
                                            "A traffic jam."
                                        ],
                                        "tags": [
                                            "Nigeria"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9589b18e-df5d-4346-9b85-f8780944cc9b",
                        "source_entry_id": "5f30fa23-64bc-353e-8b9a-a4fd749d583f",
