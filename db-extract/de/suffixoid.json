                ],
                "senses": [
                    {
                        "sense_id": "6715f7cb-6924-3666-8866-f7979ca295b6",
                        "entry_id": "933e0625-6c01-3f3a-bb27-b8587cd9171c",
                        "glosses": [
                            "grammatisches Morphem, das in seiner Form einem Lexem gleicht, aber nicht die Bedeutung dieses Lexems hat. Es wird wie ein Suffix für die Ableitung verwendet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7391c75c-f545-4a11-bf89-90a2f9a280fe",
                                "sense_id": "6715f7cb-6924-3666-8866-f7979ca295b6",
                                "text": "In dem Lexem \"Laubwerk\" ist \"-werk\" ein Suffixoid; es sieht aus wie das Substantiv \"Werk\" (Fabrik), hat aber nicht diese Bedeutung. Es bedeutet stattdessen hier \"Menge von (Laub)\"."
                            },
                            {
                                "example_id": "6ef3f8a7-7c5f-4845-9653-bec8e100e27a",
                                "sense_id": "6715f7cb-6924-3666-8866-f7979ca295b6",
                                "text": "„Der Oberbegriff von Suffixoid und Präfixoid ist Affixoid.“"
                            },
                            {
                                "example_id": "b3f5b22f-c005-4d01-9ec0-a398f31282cf",
                                "sense_id": "6715f7cb-6924-3666-8866-f7979ca295b6",
                                "text": "„Die adjektivische Wortbildung ist durch eine im Vergleich zum Substantiv noch stärker ausgeprägte Reihenbildung sowohl simplizischer als auch komplexer (derivierter) adjektivischer Zweitglieder gekennzeichnet, die teilweise als ‚suffixartige Funktionsträger‘ oder Suffixoide behandelt werden.“"
                            },
                            {
                                "example_id": "ef40f0c5-2860-4d17-9b58-551f5a2139c0",
                                "sense_id": "6715f7cb-6924-3666-8866-f7979ca295b6",
                                "text": "„Zur Bezeichnung von Übergangsstufen zwischen Kompositionsglied und Suffix benützt man in neuerer Zeit die Termini ‚Halbsuffix‘ oder Suffixoid (…)“"
                            },
                            {
                                "example_id": "b55f7b4b-31a4-49da-8a36-9d94cadaec2c",
                                "sense_id": "6715f7cb-6924-3666-8866-f7979ca295b6",
                                "text": "„Das komplementäre Zusammenwirken von Suffixen und Suffixoiden bei der Adjektivbildung läßt sich bei folgenden Funktionen besonders klar beobachten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
