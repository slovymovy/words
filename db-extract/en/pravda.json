                            },
                            {
                                "example_id": "c8f68ff7-561f-42da-8b7c-1845c2215312",
                                "sense_id": "a6192fd6-d0a1-36ee-9932-cc532142a4e5",
                                "text": "Eric Pickles, the new local government secretary, said he wanted to axe 'the weekly town hall Pravdas' to ensure that a healthy independent local press can scrutinise the work of councils."
                            },
                            {
                                "example_id": "8753f2b6-ab7e-413b-967a-3730edd165d6",
                                "sense_id": "a6192fd6-d0a1-36ee-9932-cc532142a4e5",
                                "text": "Clinton did not mention Cernovich, but she attacked Alex Jones, the paranoiac Texas radio host, and Breitbart.com, the Pravda of the alt-right."
                            },
                            {
                                "example_id": "0e2d24e4-7e03-4dd7-8438-4adfac70316f",
                                "sense_id": "a6192fd6-d0a1-36ee-9932-cc532142a4e5",
                                "text": "I'm sure Fox News would be more than happy to call itself the right wing network as soon as the big three give up the ghost and start calling themselves the Pravdas that they are."
                            },
                            {
                                "example_id": "ac619854-ab82-4e50-8cd7-a11d194bb96f",
                                "sense_id": "a6192fd6-d0a1-36ee-9932-cc532142a4e5",
                                "text": "But don’t expect to read that in the FT, Guardian, or Economist, the Pravdas and Izvestias of the Remainers."
                            }
                        ]
                    }
