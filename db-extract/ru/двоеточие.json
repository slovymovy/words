                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3ff8d95-3d10-4300-8879-20100e006bf2",
                                                "sense_id": "d0276d8c-ddb8-3295-9e85-8fef9d708edc",
                                                "text": "A colon tells the reader that what follows is closely related to the preceding clause."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85ad8c49-e490-379e-bdaa-f240c6fabfa7",
