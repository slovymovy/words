                "translations": [
                    {
                        "translation_id": "1e05dad1-1fb1-4df5-9fd2-0191d87c62fa",
                        "source_entry_id": "8a6c7f1f-8310-3730-b1e0-fdcc6876b186",
                        "source_sense_id": "b856ce78-77b1-3685-92da-97b7473c04b5",
                        "target_lang_word": "asylum seeker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "asylum seeker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e649427c-1f35-3c78-8ba0-e2410f7b202e",
                                        "entry_id": "c51220bb-dc53-3f98-a72e-1e933540d1d4",
                                        "glosses": [
                                            "A person who has applied for asylum in a foreign country but has not yet been granted refugee status by that country."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d503a8e4-2404-4e00-9ea8-b9730bd7ea0d",
                                                "sense_id": "e649427c-1f35-3c78-8ba0-e2410f7b202e",
                                                "text": "He stayed with friends and even spent a few nights in a hotel when had nowhere else to go. In September 2019, he moved into a flat with three other gay asylum seekers through Le Refuge, an organisation supporting isolated LGBTQI+ youth."
                                            },
                                            {
                                                "example_id": "57913538-0703-4206-99d3-ef1d92b0c31d",
                                                "sense_id": "e649427c-1f35-3c78-8ba0-e2410f7b202e",
                                                "text": "In Manchester and in Aldershot in Hampshire, asylum seeker accommodation was targeted by demonstrators carrying placards that read “deport them, don’t support them” and “no apartments for illegals”."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8be7c654-04e9-4039-b646-1e2182e5a04c",
                        "source_entry_id": "8a6c7f1f-8310-3730-b1e0-fdcc6876b186",
                        "source_sense_id": "b856ce78-77b1-3685-92da-97b7473c04b5",
                        "target_lang_word": "refugee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "refugee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b400a3bb-f706-35ec-9642-0b5123f74ca6",
                                        "entry_id": "c9b92b0c-f91e-39c9-9b5c-aafd9fe73d01",
                                        "glosses": [
                                            "A person seeking refuge (as for shelter or protection), especially in a foreign country, out of fear or prospect of political, religious persecution, war, natural disaster, etc."
                                        ],
                                        "tags": [
                                            "also",
                                            "attributive",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc7c14d8-a311-4607-b1d6-c91d0d12afe3",
                                                "sense_id": "b400a3bb-f706-35ec-9642-0b5123f74ca6",
                                                "text": "In 1962 a special law had to be passed to permit the immigration of several thousand Chinese refugees who had escaped from Communist China to Hong Kong."
                                            },
                                            {
                                                "example_id": "f8ed0251-87c6-46f8-b401-bfde485526ef",
                                                "sense_id": "b400a3bb-f706-35ec-9642-0b5123f74ca6",
                                                "text": "The eight military bases being used to house Afghan refugees have a total capacity of 50,000 to house evacuees. […] The nine refugee resettlement agencies who work in coordination with the federal government will ultimately determine where Afghans are relocated, based on whether they have US ties or where their local affiliates have capacity to take them in."
                                            },
                                            {
                                                "example_id": "1b36d134-2c2f-4ee4-9a9a-76bba6ab84e5",
                                                "sense_id": "b400a3bb-f706-35ec-9642-0b5123f74ca6",
                                                "text": "While thousands of refugees were evacuated from the New Orleans convention center, chaos continued at the airport, thousands were still trapped in homes and hotels, fires raged virtually unchecked in parts of the city, the power was out, and vast sections were still under water."
                                            },
                                            {
                                                "example_id": "85aa3499-bc7e-4bfc-b4e5-ef733132c710",
                                                "sense_id": "b400a3bb-f706-35ec-9642-0b5123f74ca6",
                                                "text": "Why did the SDP dream eventually fade? Partly because it succeeded far better inside parliament than out. It might attract some inner-city Catholic traditionalist Labour refugees from Labour's left, but many of those were already gentrifying."
                                            },
                                            {
                                                "example_id": "fd33a82c-1bd0-4a46-882d-6a49946d8183",
                                                "sense_id": "b400a3bb-f706-35ec-9642-0b5123f74ca6",
                                                "text": "Alluding to the regional consequences of a war in the Taiwan Strait, Zelensky pointed out that there could be millions of refugees, similar to the result of the Russian invasion of Ukraine."
                                            },
                                            {
                                                "example_id": "a407fd92-70da-489f-8ed9-57eb3789ff85",
                                                "sense_id": "b400a3bb-f706-35ec-9642-0b5123f74ca6",
                                                "text": "My son, a Canada-based IT professional who often travels to Ukraine, told me about the exhilarating atmosphere on those Ukraine-bound trains, bringing home hundreds of the unwilling refugees, mostly women and children (including the babies, born in exile on the way to meet their Ukrainian fighter fathers for the first time). The difference between Ukrainian refugees and other reluctant exiles is that Ukrainians are desperate to return."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "479988f3-0a6f-3eba-a89a-8ec023efc012",
                                        "entry_id": "c9b92b0c-f91e-39c9-9b5c-aafd9fe73d01",
                                        "glosses": [
                                            "A person who is fleeing from justice, punishment deemed righteous, etc.; a runaway, a fugitive."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "derogatory"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "refugee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a70a2da-0c49-3c96-a4a8-eaa284613fdd",
                                        "entry_id": "44d01bea-7261-329e-ab51-afe6edeb290c",
                                        "glosses": [
                                            "To convey (slaves) away from the advance of the federal forces."
                                        ],
                                        "tags": [
                                            "US",
                                            "historical",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "231d5aec-919e-4431-bf38-a4c065ea62e4",
                        "source_entry_id": "8a6c7f1f-8310-3730-b1e0-fdcc6876b186",
                        "source_sense_id": "b856ce78-77b1-3685-92da-97b7473c04b5",
                        "target_lang_word": "exile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad5f89cc-8992-3cc3-bf55-f84ab612501a",
                                        "entry_id": "760ef990-e560-3bd2-a4ca-734ccb26af4e",
                                        "glosses": [
                                            "The state of being banished from one's home or country."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bf95d16-de8e-4f3e-a7bd-003ca5fa4825",
                                                "sense_id": "ad5f89cc-8992-3cc3-bf55-f84ab612501a",
                                                "text": "He lived in exile."
                                            },
                                            {
                                                "example_id": "eb50e641-0cac-4b7d-80ac-a494020503c7",
                                                "sense_id": "ad5f89cc-8992-3cc3-bf55-f84ab612501a",
                                                "text": "They chose exile rather than assimilation."
                                            },
                                            {
                                                "example_id": "17cd259e-ddeb-4cb8-9022-ea5f3c2fe97c",
                                                "sense_id": "ad5f89cc-8992-3cc3-bf55-f84ab612501a",
                                                "text": "Let them be recalled from their exile."
                                            },
                                            {
                                                "example_id": "3dbce57f-9ea8-4caf-b4fe-da514d06f81b",
                                                "sense_id": "ad5f89cc-8992-3cc3-bf55-f84ab612501a",
                                                "text": "My son, a Canada-based IT professional who often travels to Ukraine, told me about the exhilarating atmosphere on those Ukraine-bound trains, bringing home hundreds of the unwilling refugees, mostly women and children (including the babies, born in exile on the way to meet their Ukrainian fighter fathers for the first time). The difference between Ukrainian refugees and other reluctant exiles is that Ukrainians are desperate to return."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8afd4a1-b0cd-3946-a7e5-53809830a285",
                                        "entry_id": "760ef990-e560-3bd2-a4ca-734ccb26af4e",
                                        "glosses": [
                                            "Someone who is banished from his home or country."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "114ace20-b0e7-47f3-bfdf-5ef2eb2283db",
                                                "sense_id": "c8afd4a1-b0cd-3946-a7e5-53809830a285",
                                                "text": "She lived as an exile, and did her best to make the most out of such life."
                                            },
                                            {
                                                "example_id": "d3ffce3f-a27d-437b-a365-4cbb94bf6a54",
                                                "sense_id": "c8afd4a1-b0cd-3946-a7e5-53809830a285",
                                                "text": "Thou art an exile, and thou must not stay."
                                            },
                                            {
                                                "example_id": "48e6b175-21bc-4ffd-b95e-7481a745b37f",
                                                "sense_id": "c8afd4a1-b0cd-3946-a7e5-53809830a285",
                                                "text": "My son, a Canada-based IT professional who often travels to Ukraine, told me about the exhilarating atmosphere on those Ukraine-bound trains, bringing home hundreds of the unwilling refugees, mostly women and children (including the babies, born in exile on the way to meet their Ukrainian fighter fathers for the first time). The difference between Ukrainian refugees and other reluctant exiles is that Ukrainians are desperate to return."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "exile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d8207ee-3383-3d46-b2db-83d4d676048e",
                                        "entry_id": "8b58734b-4757-3c88-96bc-30e33853883e",
                                        "glosses": [
                                            "To send (someone or something) into exile."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82cd5c73-0037-4b82-97a4-bd6c1a20c07e",
                                                "sense_id": "6d8207ee-3383-3d46-b2db-83d4d676048e",
                                                "text": "Calling home our exiled friends abroad."
                                            },
                                            {
                                                "example_id": "e906013b-93c6-4eaa-9b2d-b4260c1034e8",
                                                "sense_id": "6d8207ee-3383-3d46-b2db-83d4d676048e",
                                                "text": "She, mouldering with the dull earth's mouldering sod, / Inwrapt tenfold in slothful shame, / Lay there exiled from eternal God, / Lost to her place and name."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
