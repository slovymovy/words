                        "entry_id": "3b3b88be-ce74-3329-bb06-946a426aca62",
                        "glosses": [
                            "Action de couler."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "1d592bdd-f394-42b8-92d3-db904d9a65cb",
                                "sense_id": "b9f075b9-ddfc-344b-a032-fb8cad805d14",
                                "text": "Mais tout ainsi que l’onde à val des ruisseaux fuit\nLe pressant coulement de l’autre qui la suit,\nAinsi le temps se coule."
                            },
                            {
                                "example_id": "e7491480-20e4-4011-9578-70b97b9f676b",
                                "sense_id": "b9f075b9-ddfc-344b-a032-fb8cad805d14",
                                "text": "Pour la viser et peut-être pour se plaindre de tant d’échecs, le gouverneur commença d’une voix triste, comme malgré lui, une histoire qui le poussait plus qu’il ne l’inventait et dont le coulement « prenait », se solidifiait au sortir de sa bouche."
                            }
                        ]
                    }
