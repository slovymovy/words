                ],
                "senses": [
                    {
                        "sense_id": "e1237bd4-14b2-3d5c-b725-5da0b2d2a888",
                        "entry_id": "546cd4d5-a7f5-3c53-8611-097c4c2cfc23",
                        "glosses": [
                            "To light or kindle anew."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "93ea5d24-5a04-4c55-84f4-4b431f2f3886",
                                "sense_id": "e1237bd4-14b2-3d5c-b725-5da0b2d2a888",
                                "text": "This act of politeness having in some mysterious way set Mr Limpet's mind at rest, he produced an immense pipe, which he had apparently been smoking prior to the curate's entrance, and relit it, while the curate, seated gingerly on the edge of the rocking chair, surreptitiously inspected the room, which was so close to the roof as to make the December heat uncomfortably apparent."
                            },
                            {
                                "example_id": "3cb52f75-f9d8-4022-824f-9be997230f18",
                                "sense_id": "e1237bd4-14b2-3d5c-b725-5da0b2d2a888",
                                "text": "By Tuesday evening the track had been cleared to the three snowbound engines, and the following day, under their own steam, they were moved away; the business of relighting their fires and raising steam in such conditions is better imagined than described."
                            }
                        ]
                    },
                    {
                        "sense_id": "d3e7af76-18b3-3775-b72e-efa413f2c3bd",
                        "entry_id": "546cd4d5-a7f5-3c53-8611-097c4c2cfc23",
                        "glosses": [
                            "To light or illuminate anew."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35528dc9-6bf4-4a8f-874f-a97e1c13df34",
                                "sense_id": "d3e7af76-18b3-3775-b72e-efa413f2c3bd",
                                "text": "The lights went down on Gilbert ranting and raving about surviving nuclear war. The stage was relit and Holly sang her song, \"Family Promise,\" written to her baby nephew."
                            }
                        ]
                    },
                    {
                        "sense_id": "546eaff6-03a2-3be1-a006-840478415b29",
                        "entry_id": "546cd4d5-a7f5-3c53-8611-097c4c2cfc23",
                        "glosses": [
                            "To render again with different simulated lighting conditions."
                        ],
