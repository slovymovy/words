                        "examples": [
                            {
                                "example_id": "a916d335-faa2-4999-a939-6203b87b8287",
                                "sense_id": "fbd358dd-2384-3f7c-9b82-dca00eaba428",
                                "text": "Da Lehrer hot alle des Gedicht owasong lassn."
                            },
                            {
                                "example_id": "2f64fc69-b207-4cf3-b472-ee624c0d43bb",
                                "sense_id": "fbd358dd-2384-3f7c-9b82-dca00eaba428",
                                "text": "„In Emsee homs a Howossa ghobt, d'Fisch hom von de Bam owagsogt, fürchtet Euch nicht, oba fürchtet Euch nicht.“ (Bairischer Nonsensreim)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d75c81b6-6a47-400e-99fa-a3a0d183b26d",
                        "source_entry_id": "42e17193-1fe9-3ffd-a3d0-42aa72cd75cd",
                        "source_sense_id": "fbd358dd-2384-3f7c-9b82-dca00eaba428",
                        "source_sense_description": "bairisch: auswendig hersagen",
                        "target_lang_word": "hersagen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hersagen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "34909dd5-5bb7-3425-adf9-7523010c94dd",
                                        "entry_id": "bf544410-3ad7-3de6-a0e6-acb94541bb55",
                                        "glosses": [
                                            "einen Text auswendig vortragen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5367192-a910-46df-bf12-0aa68e6888d3",
                                                "sense_id": "34909dd5-5bb7-3425-adf9-7523010c94dd",
                                                "text": "Ein französischer Mönch hat gerüchteweise im 19. Jahrhundert die ganze Bibel auswendig hergesagt."
                                            },
                                            {
                                                "example_id": "a59562cf-e83c-4bc6-914b-3633e403c3bf",
                                                "sense_id": "34909dd5-5bb7-3425-adf9-7523010c94dd",
                                                "text": "„Mit siebzehn Jahren schrieb der französische Dichter dieses Meisterwerk, das in France mancher Schüler auswendig hersagen kann: Le Dormeur du Val (Der Schläfer im Tal).“"
                                            },
                                            {
                                                "example_id": "fa3fb6d4-e09d-4024-aec8-b1bc639ca944",
                                                "sense_id": "34909dd5-5bb7-3425-adf9-7523010c94dd",
                                                "text": "„Ich erinnere mich, daß ich schon im Kriege in Rußland oft mit jungen Menschen sprach, welche Gedichte von Goethe, Hölderlin, Eichendorff in untadeligem Deutsch auswendig hersagen konnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
