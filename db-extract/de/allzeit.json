        "de-extract.jsonl": [
            {
                "entry_id": "9f3dabc2-996d-301d-a40a-f10306ffd035",
                "word": "allzeit",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "14967829-5052-3b59-88bc-42b89fdef6e9",
                        "entry_id": "9f3dabc2-996d-301d-a40a-f10306ffd035",
                        "glosses": [
                            "zu jeder Zeit"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "cfdc7aff-893d-4595-aac2-2369d0693bcc",
                                "sense_id": "14967829-5052-3b59-88bc-42b89fdef6e9",
                                "text": "„Allzeit bereit“ (Pfadfindergruß)"
                            },
                            {
                                "example_id": "6a120d29-78b2-4741-918d-0065daed2dca",
                                "sense_id": "14967829-5052-3b59-88bc-42b89fdef6e9",
                                "text": "„Allzeit: wie kann dieses besser gemacht werden.“ (Georg Christoph Lichtenberg, Aphorismen)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "559a0edf-17bc-4052-afc2-a1e65dec818a",
                        "source_entry_id": "9f3dabc2-996d-301d-a40a-f10306ffd035",
                        "source_sense_id": "14967829-5052-3b59-88bc-42b89fdef6e9",
                        "source_sense_description": "veraltend: zu jeder Zeit",
                        "target_lang_word": "always",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "always",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f752e3a-821c-32af-a381-9f0273c18e2c",
                                        "entry_id": "66c4bd36-63f9-3380-9bc5-e7c0f83baf74",
                                        "glosses": [
                                            "At all times; throughout all time; since the beginning."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37b1048c-016a-4312-98cf-cef24fcb655e",
                                                "sense_id": "6f752e3a-821c-32af-a381-9f0273c18e2c",
                                                "text": "God is always the same."
                                            },
                                            {
                                                "example_id": "247dca47-5a2a-4392-a08a-d71d2058aae3",
                                                "sense_id": "6f752e3a-821c-32af-a381-9f0273c18e2c",
                                                "text": "Green has always been my favorite color. I’ve loved it for as long as I can remember."
                                            },
                                            {
                                                "example_id": "e604797a-8906-4603-81cd-d2c45f4e5fc0",
                                                "sense_id": "6f752e3a-821c-32af-a381-9f0273c18e2c",
                                                "text": "Airplanes did not always exist as a form of transportation."
                                            },
                                            {
                                                "example_id": "00e2fdfb-15a9-4f40-a240-a59b2f00ccb3",
                                                "sense_id": "6f752e3a-821c-32af-a381-9f0273c18e2c",
                                                "text": "Plant breeding is always a numbers game.[…]The wild species we use are rich in genetic variation, and individual plants are highly heterozygous and do not breed true. In addition, we are looking for rare alleles, so the more plants we try, the better."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2047b5c9-6a5d-3552-b2cc-0d2dde46997e",
                                        "entry_id": "66c4bd36-63f9-3380-9bc5-e7c0f83baf74",
                                        "glosses": [
                                            "Constantly during a certain period, or regularly at stated intervals (opposed to sometimes or occasionally)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ed5dc33-9b90-41fe-aa21-2b00eb8056d3",
                                                "sense_id": "2047b5c9-6a5d-3552-b2cc-0d2dde46997e",
                                                "text": "In this street, the shops always close during lunchtime."
                                            },
                                            {
                                                "example_id": "fd75fa21-b5bd-4837-a692-2954b04117df",
                                                "sense_id": "2047b5c9-6a5d-3552-b2cc-0d2dde46997e",
                                                "text": "His liveries are black,—his carriage is black,—he always rides a black galloway,—and, faith, if he ever marry again, I think he will show his respect to the sainted Maria by marrying a black woman."
                                            },
                                            {
                                                "example_id": "18121f5c-e758-4cd3-82e9-2f1ab0d5ef52",
                                                "sense_id": "2047b5c9-6a5d-3552-b2cc-0d2dde46997e",
                                                "text": "They burned the old gun that used to stand in the dark corner up in the garret, close to the stuffed fox that always grinned so fiercely. Perhaps the reason why he seemed in such a ghastly rage was that he did not come by his death fairly. And why else was he put away up there out of sight?—and so magnificent a brush as he had too."
                                            },
                                            {
                                                "example_id": "2550f152-88c4-4595-b96a-39b8d2b264f1",
                                                "sense_id": "2047b5c9-6a5d-3552-b2cc-0d2dde46997e",
                                                "text": "And so it had always pleased M. Stutz to expect great things from the dark young man whom he had first seen in his early twenties ; and his expectations has waxed rather than waned on hearing the faint bruit of the love of Ivor and Virginia—for Virginia, M. Stutz thought, would bring fineness to a point in a man like Ivor Marlay,[…]."
                                            },
                                            {
                                                "example_id": "d6715328-d62c-4a80-8b5e-f0e0f60260c0",
                                                "sense_id": "2047b5c9-6a5d-3552-b2cc-0d2dde46997e",
                                                "text": "The highway to the East Coast which ran through the borough of Ebbfield had always been a main road and even now, despite the vast garages, the pylons and the gaily painted factory glasshouses which had sprung up beside it, there still remained an occasional trace of past cultures."
                                            },
                                            {
                                                "example_id": "64f5eb36-5e62-40fd-a1c6-b960fe0db509",
                                                "sense_id": "2047b5c9-6a5d-3552-b2cc-0d2dde46997e",
                                                "text": "She used to always talk about how she wished she had time to write all day, but now she had the time, she never even went near the typewriter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2089baac-4590-30fe-a4da-368e0e94b16f",
                                        "entry_id": "66c4bd36-63f9-3380-9bc5-e7c0f83baf74",
                                        "glosses": [
                                            "if necessary, or if there is no better option; in any event."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c452717-8129-42ad-af27-1ddbb2bedff5",
                                                "sense_id": "2089baac-4590-30fe-a4da-368e0e94b16f",
                                                "text": "I thought I could always go back to work."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c390a55-ea29-43c4-a24b-4c158ef55264",
                        "source_entry_id": "9f3dabc2-996d-301d-a40a-f10306ffd035",
                        "source_sense_id": "14967829-5052-3b59-88bc-42b89fdef6e9",
                        "source_sense_description": "veraltend: zu jeder Zeit",
                        "target_lang_word": "altijd",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "altijd",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "759ac738-1392-3e9d-822d-5da9bd016bb1",
                                        "entry_id": "302236ec-9d89-3f05-87b7-1241142389d6",
                                        "glosses": [
                                            "op elk moment, blijvend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa2b0879-a314-40da-8957-99581b68e6c9",
                                                "sense_id": "759ac738-1392-3e9d-822d-5da9bd016bb1",
                                                "text": "Ik zal altijd van je houden zei de man tegen zijn vrouw."
                                            },
                                            {
                                                "example_id": "776312ae-1827-4432-9e24-727f2c65e7eb",
                                                "sense_id": "759ac738-1392-3e9d-822d-5da9bd016bb1",
                                                "text": "Dat kan altijd gebeuren."
                                            },
                                            {
                                                "example_id": "2cf38449-e9d0-48e2-aca0-d1e54c35323a",
                                                "sense_id": "759ac738-1392-3e9d-822d-5da9bd016bb1",
                                                "text": "In een interview in 2009 met Mare zei Buikhuisen dat hij nog altijd last had van de affaire. Hij zei nog elke keer te hopen op een verontschuldiging als hij post kreeg van de universiteit. \"Dat ze gewoon een beetje erkennen: we zijn toch wel tekortgeschoten. Ik zou daar heel blij mee zijn.\""
                                            },
                                            {
                                                "example_id": "60810752-ccd0-4203-8d5e-3596e43651a2",
                                                "sense_id": "759ac738-1392-3e9d-822d-5da9bd016bb1",
                                                "text": "'De Route Nationale 7 is nog altijd belangrijk voor ons, omdat ze veel toeristen aanvoert', zegt Sandro Belle (30), chef de cuisine van het Vineum in Tain l'Hermitage, een lunchrestaurant en wijnproeverij, twee jaar geleden geopend door de grote wijnproducent Paul Jaboulet Ainé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2650cb4-c409-31d8-a863-d8ad0a4d9300",
                                        "entry_id": "302236ec-9d89-3f05-87b7-1241142389d6",
                                        "glosses": [
                                            "telkens opnieuw"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aef7859-a2e9-4fca-b274-e9976d8ed8ef",
                                                "sense_id": "a2650cb4-c409-31d8-a863-d8ad0a4d9300",
                                                "text": "Hij komt altijd te laat."
                                            },
                                            {
                                                "example_id": "12002c7d-0ac9-472f-a64d-f6df2c47fdaa",
                                                "sense_id": "a2650cb4-c409-31d8-a863-d8ad0a4d9300",
                                                "text": "In het verleden was de Amerikaanse STAR-detector altijd sneller in het vinden van recordbrekende antimateriedeeltjes. ‘Elke keer als ze [het LHC-team] ergens naar op zoek gingen, waren de onderzoekers van STAR ze voor’, zegt natuurkundige Horst Stöcker van het Frankfurt Institute for Advanced Studies in Duitsland. ‘Dit is de eerste keer dat het STAR-team iets nog niet heeft gezien, maar LHC-onderzoekers wel.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad8234d3-6a63-3463-9350-eb6cd2969e94",
                                        "entry_id": "302236ec-9d89-3f05-87b7-1241142389d6",
                                        "glosses": [
                                            "in elk geval"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfff4c5b-b3b4-4bd2-a9b2-0e5e78d23be6",
                                                "sense_id": "ad8234d3-6a63-3463-9350-eb6cd2969e94",
                                                "text": "Dat gaat altijd fout."
                                            },
                                            {
                                                "example_id": "5ac15790-cc41-4b5e-8ead-e1bf6547635f",
                                                "sense_id": "ad8234d3-6a63-3463-9350-eb6cd2969e94",
                                                "text": "0, ja, hij kon goed klimmen, op de rotsen tenminste, hij was gewend aan de kou, want in de bergen was het 's nachts altijd koud."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7287863-c416-4e40-9622-6106a3d5647d",
                        "source_entry_id": "9f3dabc2-996d-301d-a40a-f10306ffd035",
                        "source_sense_id": "14967829-5052-3b59-88bc-42b89fdef6e9",
                        "source_sense_description": "veraltend: zu jeder Zeit",
                        "target_lang_word": "всегда",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "всегда",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e4a10d0c-3352-36ce-a528-db9df77db295",
                                        "entry_id": "31663cde-bb77-3d5c-a327-2dedc50bec1f",
                                        "glosses": [
                                            "в любой момент времени, во все времена"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f844d5c-562a-49b0-99c9-a5ab2ccdd81e",
                                                "sense_id": "e4a10d0c-3352-36ce-a528-db9df77db295",
                                                "text": "Я тебя любить готов, Только будь всегда простою, Будь обрызгана росою, Как сплетеньем жемчугов, Будь же, будь всегда простою"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
