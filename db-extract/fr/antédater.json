                "senses": [
                    {
                        "sense_id": "5dd4f4b4-6511-3992-9a2a-af2d3aba528d",
                        "entry_id": "b457acc7-c30b-36fa-a2c5-92cd800f953c",
                        "glosses": [
                            "Attribuer une date antérieure à celle qui était auparavant attribuée à (quelque chose)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b45010e-e68f-4900-87f7-b2a8a573c556",
                                "sense_id": "5dd4f4b4-6511-3992-9a2a-af2d3aba528d",
                                "text": "Les données onomastiques anciennes permettent d'antédater un certain nombre de lexèmes romans et l'analyse de mieux en établir les bases étymologiques."
                            },
                            {
                                "example_id": "f6e0bd56-414a-4763-8d79-e073a4e77bee",
                                "sense_id": "5dd4f4b4-6511-3992-9a2a-af2d3aba528d",
                                "text": "Le toit roman aura ainsi incité à antédater d'environ 260 ans en moyenne les cinq lexèmes francoprovençaux observés."
                            }
                        ]
                    }
                ],
