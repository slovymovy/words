{
    "word_family": [
        "сколько",
        "нисколько",
        "столько",
        "насколько",
        "поскольку"
    ],
    "entries": [
        {
            "pos": "numeral",
            "senses": [
                {
                    "sense_id": "ea71330b-401f-3bac-92eb-60dde3f2ac2d",
                    "sense_definition": "Небольшое, но неопределённое количество кого-либо или чего-либо.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На столе в большой вазе лежало <w>несколько</w> красных яблок.",
                            "target_lang_translations": {
                                "en": "There were <w>several</w> red apples lying in a large vase on the table.",
                                "cs": "Na stole ve velké váze leželo <w>několik</w> červených jablek.",
                                "zh": "桌上的大花瓶里放着<w>几个</w>红苹果。"
                            }
                        },
                        {
                            "text": "Я уже <w>несколько</w> раз звонил ему, но он не отвечает.",
                            "target_lang_translations": {
                                "en": "I have already called him <w>several</w> times, but he is not answering.",
                                "cs": "Už jsem mu <w>několikrát</w> volal, ale neodpovídá.",
                                "zh": "我已经给他打过<w>几</w>次电话了，但他没接。"
                            }
                        }
                    ],
                    "synonyms": [
                        "немного",
                        "сколько-то",
                        "пара"
                    ],
                    "antonyms": [
                        "нисколько"
                    ],
                    "common_phrases": [
                        "несколько раз",
                        "несколько дней",
                        "несколько человек",
                        "несколько лет",
                        "несколько минут"
                    ],
                    "target_lang_definitions": {
                        "en": "A small but indefinite number of people or things.",
                        "cs": "Malé, ale neurčité množství osob nebo věcí.",
                        "zh": "指数量不多但又不确定的若干人或物。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "several",
                                "target_lang_sense_clarification": "more than two but not many"
                            },
                            {
                                "target_lang_word": "a few",
                                "target_lang_sense_clarification": "a small number of"
                            },
                            {
                                "target_lang_word": "some",
                                "target_lang_sense_clarification": "an indefinite number"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "několik",
                                "target_lang_sense_clarification": "neurčité množství větší než dva"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "几个",
                                "target_lang_sense_clarification": "用于指代少量的人或物"
                            },
                            {
                                "target_lang_word": "一些",
                                "target_lang_sense_clarification": "表示不确定的数量"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "93d09875-295c-35c8-9b29-f8464abbbf05",
                    "sense_definition": "В некоторой степени, немного, слегка.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его голос звучал <w>несколько</w> странно и неуверенно.",
                            "target_lang_translations": {
                                "en": "His voice sounded <w>somewhat</w> strange and uncertain.",
                                "cs": "Jeho hlas zněl <w>poněkud</w> zvláštně a nejistě.",
                                "zh": "他的声音听起来<w>有点</w>奇怪且不自信。"
                            }
                        },
                        {
                            "text": "Эта задача оказалась <w>несколько</w> сложнее, чем мы предполагали вначале.",
                            "target_lang_translations": {
                                "en": "This task turned out to be <w>a little</w> more difficult than we initially assumed.",
                                "cs": "Tento úkol se ukázal být <w>poněkud</w> složitějším, než jsme zpočátku předpokládali.",
                                "zh": "这项任务比我们最初预想的要<w>稍微</w>复杂一些。"
                            }
                        }
                    ],
                    "synonyms": [
                        "немного",
                        "слегка"
                    ],
                    "common_phrases": [
                        "несколько иначе",
                        "несколько странный",
                        "несколько больше",
                        "несколько позже"
                    ],
                    "target_lang_definitions": {
                        "en": "To a certain extent or degree; slightly.",
                        "cs": "Do určité míry; poněkud, trochu.",
                        "zh": "在一定程度上；稍微。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "somewhat",
                                "target_lang_sense_clarification": "to a limited extent or degree"
                            },
                            {
                                "target_lang_word": "a little",
                                "target_lang_sense_clarification": "slightly; to a small degree"
                            },
                            {
                                "target_lang_word": "a bit",
                                "target_lang_sense_clarification": "informal; slightly"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "poněkud",
                                "target_lang_sense_clarification": "do určité míry, v určitém stupni"
                            },
                            {
                                "target_lang_word": "trochu",
                                "target_lang_sense_clarification": "v malé míře"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有点",
                                "target_lang_sense_clarification": "表示程度稍微"
                            },
                            {
                                "target_lang_word": "稍微",
                                "target_lang_sense_clarification": "表示程度轻微"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c97c2a9-9fcd-3fc6-a7a5-b609f759fdcb",
                    "sense_definition": "В течение некоторого, непродолжительного времени; недолго.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Путники отдохнули <w>несколько</w> у ручья и продолжили свой путь.",
                            "target_lang_translations": {
                                "en": "The travelers rested <w>a little</w> by the stream and continued their journey.",
                                "cs": "Poutníci si u potoka <w>chvíli</w> odpočinuli a pokračovali v cestě.",
                                "zh": "旅人在溪边休息了<w>片刻</w>，随后继续赶路。"
                            }
                        },
                        {
                            "text": "Он помолчал <w>несколько</w>, собираясь с мыслями перед ответом.",
                            "target_lang_translations": {
                                "en": "He remained silent <w>for a while</w>, gathering his thoughts before answering.",
                                "cs": "Před odpovědí <w>chvíli</w> mlčel a dával si myšlenky dohromady.",
                                "zh": "他在回答前沉默了<w>一会儿</w>，整理了一下思绪。"
                            }
                        }
                    ],
                    "synonyms": [
                        "недолго"
                    ],
                    "antonyms": [
                        "долго"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "For a short period of time; for a while.",
                        "cs": "Po krátkou dobu; chvíli.",
                        "zh": "在一段较短的时间内；一会儿。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "a little",
                                "target_lang_sense_clarification": "for a short time"
                            },
                            {
                                "target_lang_word": "a bit",
                                "target_lang_sense_clarification": "for a short time"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "chvíli",
                                "target_lang_sense_clarification": "po krátkou dobu"
                            },
                            {
                                "target_lang_word": "na chvíli",
                                "target_lang_sense_clarification": "na krátký časový úsek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一会儿",
                                "target_lang_sense_clarification": "指短暂的时间"
                            },
                            {
                                "target_lang_word": "片刻",
                                "target_lang_sense_clarification": "指极短的时间"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}