                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29be8d10-530a-4193-85b2-28f23d5eae5e",
                                                "sense_id": "c8871013-f1d1-33f8-a111-6898aefc5a83",
                                                "text": "Η γραμματέας μου είναι σκέτη καύλα, φοράει κάτι μίνι φούστες, έχει και μεγάλο στήθος."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a7ad70e-7d7e-3c0e-bb3c-51ae42d116b9",
                                        "entry_id": "1b35ab40-abcd-35c3-a76d-fff6599b08d3",
