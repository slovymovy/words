                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт преклонения колен в знак уважения или вежливости.",
                        "zh": "为表示尊敬或礼貌而下跪的动作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преклонение колена",
                                "target_lang_sense_clarification": "жест"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "屈膝礼",
                                "target_lang_sense_clarification": "表示尊敬或礼貌的下跪动作"
                            },
                            {
                                "target_lang_word": "跪礼",
                                "target_lang_sense_clarification": "较宽泛"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "56f9af64-a470-3130-b31d-997d128a1b39",
                    "sense_definition": "To hit or strike someone using the knee.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soccer player was penalized because he <w>kneed</w> the goalkeeper.",
                            "target_lang_translations": {
                                "ru": "Футболиста оштрафовали за то, что он <w>ударил коленом</w> вратаря.",
                                "zh": "那名足球运动员因用<w>膝盖撞</w>守门员而被判罚。"
                            }
                        },
                        {
                            "text": "He <w>kneed</w> the door open because his hands were full of groceries.",
                            "target_lang_translations": {
                                "ru": "Он <w>толкнул коленом</w> дверь, так как его руки были заняты продуктами.",
                                "zh": "他手里拎满了杂货，只好用<w>膝盖顶</w>开门。"
                            }
                        }
                    ],
                    "common_phrases": [
