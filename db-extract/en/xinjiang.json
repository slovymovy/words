                                        "glosses": [
                                            "een autonome regio in het noordwesten van China"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85c32311-e098-4727-991d-dc04d6d522bf",
                                                "sense_id": "9580b675-ec23-343d-9f53-463d1ab6a06d",
                                                "text": "De regio Xinjiang is erg mooi."
                                            }
