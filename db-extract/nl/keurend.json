                                        "glosses": [
                                            "The act by which something is reviewed, or thought about again; a mental review."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3695485a-c09c-4cd7-9a3b-1c49b8f5d33b",
                                                "sense_id": "8d23bce5-7857-3c2a-a132-bb9151efb5da",
                                                "text": "Sleep came for me eventually, after many more reviewings of the long, involved and fractious day, and many more attempts to stop thinking about all the mysteries surrounding me."
                                            }
                                        ]
