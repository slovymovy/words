                "senses": [
                    {
                        "sense_id": "10f8577a-a618-3619-95dd-ce6f2be59bff",
                        "entry_id": "6c60fddf-f4e0-389f-bd80-476948874b30",
                        "glosses": [
                            "Welle einer bestimmten Wellenlänge, die jedem Teilchen zugeordnet werden kann (Welle-Teilchen-Dualismus); dieser Wellencharakter tritt erst im atomaren Bereich in Erscheinung"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "d054f295-2bb2-4352-9389-88ef304ddff3",
                                "sense_id": "10f8577a-a618-3619-95dd-ce6f2be59bff",
                                "text": "„Im Jahr 1924 veröffentlichte Louis de Broglie seine Theorie der Materiewellen, wonach jegliche Materie einen Wellencharakter aufweisen kann und umgekehrt Wellen auch einen Teilchencharakter aufweisen können.“"
                            },
                            {
                                "example_id": "0cddd9a0-9c70-4bcc-a4f2-a24862aed0aa",
                                "sense_id": "10f8577a-a618-3619-95dd-ce6f2be59bff",
                                "text": "„Die dabei beobachteten Interferenzmuster zeigen, dass auch klassische Teilchen Welleneigenschaften haben – man spricht dann von Materiewellen und vom Welle-Teilchen-Dualismus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
