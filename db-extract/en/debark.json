                    }
                ],
                "translations": [
                    {
                        "translation_id": "217319b2-23cd-45d9-9571-d65e74de17c2",
                        "source_entry_id": "242ab00a-3fb2-38cf-962e-c998ec873bf9",
                        "source_sense_description": "to unload",
                        "target_lang_word": "débarquer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "débarquer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "398ece96-41c9-3ff5-99a6-d9a492676e9a",
                                        "entry_id": "7b5b6f2d-3d89-34dc-a40a-5231e74f6729",
                                        "glosses": [
                                            "Tirer, ou faire sortir d’un navire, d’un bateau, ce qu’il contient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ca3cceb-7991-45f1-87f7-78edfc3f458c",
                                                "sense_id": "398ece96-41c9-3ff5-99a6-d9a492676e9a",
                                                "text": "[…] mais le Bureau de Santé était implacable et livrait sans merci aux autorités administratives et judiciaires ceux qui débarquaient clandestinement, avec la complicité des terriens, des marchandises suspectes […]"
                                            },
                                            {
                                                "example_id": "de42ff97-8d3e-4965-bf8b-c7bbbba2418a",
                                                "sense_id": "398ece96-41c9-3ff5-99a6-d9a492676e9a",
                                                "text": "Chaque semaine, des paquebots arrivaient de New-York et débarquaient des touristes américains qui venaient se reposer de leurs affaires, à l’abri des lois de la prohibition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "907302b6-dc49-3100-8a97-38cf51393a07",
                                        "entry_id": "7b5b6f2d-3d89-34dc-a40a-5231e74f6729",
                                        "glosses": [
                                            "Quitter le navire, le bateau, et descendre à terre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d984f5e-b916-4dd9-9f30-2a747909d733",
                                                "sense_id": "907302b6-dc49-3100-8a97-38cf51393a07",
                                                "text": "Nous débarquâmes en tel endroit, à tel port."
                                            },
                                            {
                                                "example_id": "63d162d4-f58e-46c4-8b51-69ff8bf8a38a",
                                                "sense_id": "907302b6-dc49-3100-8a97-38cf51393a07",
                                                "text": "Le navire n’ayant pu mettre à la voile, nous fûmes obligés de débarquer."
                                            },
                                            {
                                                "example_id": "60d010fe-4bcb-4ae4-a265-25d74dcecd92",
                                                "sense_id": "907302b6-dc49-3100-8a97-38cf51393a07",
                                                "text": "19 septembre 42 – Quand on sait combien il est délicat d’aborder sur une jetée avec son petit canot, même sans que personne vous en empêche, on se demande comment pourraient débarquer des divisions blindées sur un côte entièrement minée et sous les bombes ennemies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b8f30ca-5c5b-32a4-8eee-a588288586cb",
                                        "entry_id": "7b5b6f2d-3d89-34dc-a40a-5231e74f6729",
                                        "glosses": [
                                            "Descendre ou faire descendre d’un véhicule."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8be5da1f-6975-4e7a-8b41-6e2de6f2bade",
                                                "sense_id": "8b8f30ca-5c5b-32a4-8eee-a588288586cb",
                                                "text": "C’était l’enfer quand je devais débarquer tout seul des frigos américains, et il y en avait beaucoup. Ils faisaient au moins dans les 40 kilos."
                                            },
                                            {
                                                "example_id": "f772702f-3573-4add-b1a3-fed6c6c30f0b",
                                                "sense_id": "8b8f30ca-5c5b-32a4-8eee-a588288586cb",
                                                "text": "Quand l’envie leur prend, ils enfourchent leur vélo-cargo, transportent leur sound system, et débarquent à l’improviste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d408ffcc-f1c6-3e37-b8f2-9ee19d4f39e6",
                                        "entry_id": "7b5b6f2d-3d89-34dc-a40a-5231e74f6729",
                                        "glosses": [
                                            "Écarter quelqu’un d’un poste dont on le juge indigne."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "032ffa11-e04d-42ed-a8aa-80e1f6011eb4",
                                                "sense_id": "d408ffcc-f1c6-3e37-b8f2-9ee19d4f39e6",
                                                "text": "Le rédacteur en chef de la prestigieuse revue Proceeding of the National Academy of Sciences (PNAS), Inder Verma, vient en effet d’être débarqué pour harcèlement sexuel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a499640-c154-30a3-9c8a-d0ea72e47252",
                                        "entry_id": "7b5b6f2d-3d89-34dc-a40a-5231e74f6729",
                                        "glosses": [
                                            "Arriver."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c044d1b-bf0a-4634-9946-3e2d053c429a",
                                                "sense_id": "9a499640-c154-30a3-9c8a-d0ea72e47252",
                                                "text": "En débarquant à Toulouse, je me trouvais devant la gare assez hésitant. Une canette au buffet et me voici quand même déambulant à travers les rues."
                                            },
                                            {
                                                "example_id": "1923239d-12a9-48ee-bd74-d49febeede17",
                                                "sense_id": "9a499640-c154-30a3-9c8a-d0ea72e47252",
                                                "text": "Tout en somnolant, en s’étirant, en maugréant, la nuit se passe et, à 6 heures ce matin du 20, nous débarquons à 500 m de Bussy-le-Repos où nous allons cantonner."
                                            },
                                            {
                                                "example_id": "8232d9f5-3731-4e8a-9bc3-ec5b230008da",
                                                "sense_id": "9a499640-c154-30a3-9c8a-d0ea72e47252",
                                                "text": "Nous débarquons chez lui sur le coup de six heures ; nous y déposons nos valises et les colichemardes ; nous donnons un coup d’œil à la cuisine, et puis en route pour la pleine eau. C’est le vrai moment de se baigner."
                                            },
                                            {
                                                "example_id": "f65ced7c-44ce-460e-8667-d003e1f3a9b7",
                                                "sense_id": "9a499640-c154-30a3-9c8a-d0ea72e47252",
                                                "text": "Puis débarquèrent les Tortues Ninja en de multiples exemplaires, ainsi que des poupées de toutes sortes et des peluches… des peluches à n’en plus finir, depuis le Snoopy miniature jusqu’au Roi Lion grand modèle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61911f4d-9a70-38b0-90c0-5b7a4a7da49b",
                                        "entry_id": "7b5b6f2d-3d89-34dc-a40a-5231e74f6729",
                                        "glosses": [
                                            "Faire arriver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "923ceb44-7f45-4326-be6a-107e70d212cf",
                                                "sense_id": "61911f4d-9a70-38b0-90c0-5b7a4a7da49b",
                                                "text": "Vers la fin du siècle dernier, le vélocifère, prédécesseur de la diligence et des messageries, débarquait à Paris un provençal, plein de verve et d’entrain, né dans la ville d’Aix, et bossu, comme Ésope, par devant et par derrière."
                                            },
                                            {
                                                "example_id": "a4b31efa-be49-4f13-8b60-cceecec18121",
                                                "sense_id": "61911f4d-9a70-38b0-90c0-5b7a4a7da49b",
                                                "text": "Denise était venue à pied de la gare Saint-Lazare, où un train de Cherbourg l’avait débarquée avec ses deux frères, après une nuit passée sur la dure banquette d’un wagon de troisième classe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4365e422-4edb-3669-89e9-ea4c10237815",
                                        "entry_id": "7b5b6f2d-3d89-34dc-a40a-5231e74f6729",
                                        "glosses": [
                                            "L’infinitif s’emploie comme nom et signifie débarquement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad7621c0-8666-4926-a44f-ee11c04b3130",
                                                "sense_id": "4365e422-4edb-3669-89e9-ea4c10237815",
                                                "text": "Au débarquer à Gallipoli, un choléra […] faillit m’emporter […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bc7880d-71ec-395e-8874-411e602660ef",
                                        "entry_id": "7b5b6f2d-3d89-34dc-a40a-5231e74f6729",
                                        "glosses": [
                                            "Se rendre compte, réaliser."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3c80010-970e-4f00-998b-de648b7187d0",
                                                "sense_id": "0bc7880d-71ec-395e-8874-411e602660ef",
                                                "text": "Ah, mais tu débarques toi !"
                                            },
                                            {
                                                "example_id": "16446355-8689-4b0a-8042-302a659e6ba6",
                                                "sense_id": "0bc7880d-71ec-395e-8874-411e602660ef",
                                                "text": "– Je ne savais pas !\n– C’est vrai : tu débarques."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "débarquer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "47d643b0-c283-352f-ae97-27d7fcbc2d9f",
                                        "entry_id": "c3d9b052-1768-35bb-9254-ac19a1ee51fe",
                                        "glosses": [
                                            "Moment où un navire arrive à son point de débarquement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e76b9746-9d5b-4539-83cc-5f29d4358550",
                                                "sense_id": "47d643b0-c283-352f-ae97-27d7fcbc2d9f",
                                                "text": "Nahalania, autre mère bienfaisante, implorée au départ et remerciée au débarquer dans les ports de Zélande, et qui a dû l'être aussi plus au sud des côtes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
