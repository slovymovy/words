                "senses": [
                    {
                        "sense_id": "db44dbbf-c1d7-3462-b3dd-7cf59f8a4386",
                        "entry_id": "9186f276-60ae-3ed3-a786-7c5dedc6429f",
                        "glosses": [
                            "Körperhaltung, bei der das Gewicht auf Händen und Knien ruht, wobei die Hände unter den Schultern und die Knie unter den Hüften positioniert sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afc0c976-4ea3-47ea-8023-c7c7318f7255",
                                "sense_id": "db44dbbf-c1d7-3462-b3dd-7cf59f8a4386",
                                "text": "„Der Vierfüßlerstand im Pilates ist eine wahrhaft unterschätzte Übungsposition.“"
                            },
                            {
                                "example_id": "ff6c482a-c74c-4823-9e97-e5486c98cf40",
                                "sense_id": "db44dbbf-c1d7-3462-b3dd-7cf59f8a4386",
                                "text": "„Übungen im Vierfüßlerstand sind so ziemlich in jeder Kursstunde dabei.“"
                            },
                            {
                                "example_id": "a4274be5-7d08-450f-a39a-458ab1c62169",
                                "sense_id": "db44dbbf-c1d7-3462-b3dd-7cf59f8a4386",
                                "text": "„Bringe dann Deine Hände unter die Schultern und drücke Dich hoch in den Vierfüßlerstand.“"
                            },
                            {
                                "example_id": "e712bf47-f327-44f7-b88a-d44ff7e9144b",
                                "sense_id": "db44dbbf-c1d7-3462-b3dd-7cf59f8a4386",
                                "text": "„Bei der sogenannten ‚Hündchenstellung‘ geht die Frau in den Vierfüßlerstand, während sich der Mann hinter ihr auf Knien positioniert.“"
                            },
                            {
                                "example_id": "42661eab-0cec-48f3-8ed8-d10fbde96e24",
                                "sense_id": "db44dbbf-c1d7-3462-b3dd-7cf59f8a4386",
                                "text": "„Sie brachte mir einen Pezziball, über den ich mich im Vierfüßlerstand beugen konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
