                "senses": [
                    {
                        "sense_id": "35dd1283-2c8e-3ec9-98cc-67dbfde675a5",
                        "entry_id": "a5b0b14c-809f-3f5f-a603-fe6d532ddd82",
                        "glosses": [
                            "nicht genau definierter südwestlicher Teil des Atlantischen Ozeans"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63094a53-6cd7-4ea3-a4a0-2227937fc3de",
                                "sense_id": "35dd1283-2c8e-3ec9-98cc-67dbfde675a5",
                                "text": "„Des Weiteren ist dieser Fisch aus dem Südwestatlantik bekannt von den südöstlichen Küsten Brasiliens, den Küsten Uruguays und Argentiniens.“"
                            },
                            {
                                "example_id": "ff6cf6e9-1204-4758-b118-baeaf652628f",
                                "sense_id": "35dd1283-2c8e-3ec9-98cc-67dbfde675a5",
                                "text": "„Vom benachbarten Kastilien aus verfolgten einige Personen aufmerksam, was die Portugiesen im Südwestatlantik trieben.“"
                            },
                            {
                                "example_id": "83efec1c-c946-4378-8f85-765eb0f85fec",
                                "sense_id": "35dd1283-2c8e-3ec9-98cc-67dbfde675a5",
                                "text": "„Für Seefisch gibt es definierte Fanggebiete wie Nordwestatlantik, Nordostatlantik, Ostsee und Südwestatlantik.“"
                            },
                            {
                                "example_id": "adf8e754-a5c0-406b-a2c9-54998eba765d",
                                "sense_id": "35dd1283-2c8e-3ec9-98cc-67dbfde675a5",
                                "text": "„Neue understmalig nachgewiesene Knorpelfische aus dem Archibenthal des Südwestatlantiks, einschliesslich einer Diskussion einiger Etmopterus-Arten Südlicher Meere.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
