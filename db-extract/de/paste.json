                                        "entry_id": "12437ab3-38b1-3ecc-9583-47f586227115",
                                        "glosses": [
                                            "A hard lead-containing glass, or an artificial gemstone made from this glass."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
