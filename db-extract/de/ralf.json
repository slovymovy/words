                "translations": [
                    {
                        "translation_id": "f4c24f81-bbf1-407c-96be-d5c1f5eef304",
                        "source_entry_id": "ed2dfacc-c4e0-30ee-8f1c-3a55cc4ade9e",
                        "source_sense_id": "20dbb8d7-e99a-3327-8aa8-f1575ab5c5fc",
                        "source_sense_description": "männlicher Vorname",
                        "target_lang_word": "Ralph",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ralph",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a07d1aa6-6d22-34ab-9d18-4e7b887d75b3",
                                        "entry_id": "d75c448a-ac56-31c5-88bc-c43012495960",
                                        "glosses": [
                                            "A male given name from the Germanic languages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "606371aa-0e3a-4311-b65b-c603b04519df",
                                                "sense_id": "a07d1aa6-6d22-34ab-9d18-4e7b887d75b3",
                                                "text": "There were none fine but Adam, Ralph, and Gregory: / The rest were ragged, old, and beggarly"
                                            },
                                            {
                                                "example_id": "3657cc4e-1be4-40d1-bc22-919fb471da31",
                                                "sense_id": "a07d1aa6-6d22-34ab-9d18-4e7b887d75b3",
                                                "text": "Regarding the correct pronunciation, especially of the name Ralph: according to a friend at the BBC, the possibilities of this name - either aristocratic 'Rafe' or vulgar, almost Australasian 'Ralff' - lie in its potential for wilful mispronunciation against type. I saw him cast confusion into an over-confident studio guest by introducing him as 'Sir Rafe Halpern'. This was nothing to the consternation, almost disintegration of the personality, of the artistic, aloof actor brought on as 'Rolf Fiennes' ('Fiennes', naturally, pronounced superbly)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f1b32e7-8104-3419-94da-7368f769cc2b",
                                        "entry_id": "d75c448a-ac56-31c5-88bc-c43012495960",
                                        "glosses": [
                                            "A surname originating as a patronymic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "77bc2a75-6a7d-3a11-b386-d767eea87362",
                                        "entry_id": "d75c448a-ac56-31c5-88bc-c43012495960",
                                        "glosses": [
                                            "Fictional person used in references to vomiting."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a978933-28b9-4543-bc41-980e63269c82",
                                                "sense_id": "77bc2a75-6a7d-3a11-b386-d767eea87362",
                                                "text": "He's outside calling Ralph [i.e. vomiting]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a93d94dc-7650-3b42-94cc-d6a61d3efb6e",
                                        "entry_id": "d75c448a-ac56-31c5-88bc-c43012495960",
                                        "glosses": [
                                            "An unincorporated community in Harding County, South Dakota, United States."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5ebce03e-ff46-352d-aca8-060bacf7d9b0",
                                        "entry_id": "d75c448a-ac56-31c5-88bc-c43012495960",
