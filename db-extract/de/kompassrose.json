                "senses": [
                    {
                        "sense_id": "0f91dbcf-6f42-3ce9-9b86-49bbce79811f",
                        "entry_id": "3b5d6606-9eeb-30c7-9d1e-68d9f6da56e0",
                        "glosses": [
                            "Gradeinteilung auf einem Kompass; zusätzlich gibt es meistens eine Unterteilung in 8, 16 oder 32 gleich große Winkel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16d65a76-1ad3-45a8-aca3-0383d3fa96dc",
                                "sense_id": "0f91dbcf-6f42-3ce9-9b86-49bbce79811f",
                                "text": "„Der nautische Strich hängt mit der früher üblichen Einteilung der Kompassrose zusammen und entspricht einem Viertel von 45°, dem Winkelunterschied der acht ‚Weltgegenden‘ der antiken Nautik.“"
                            },
                            {
                                "example_id": "bf23e2b0-e1b7-4208-9d8a-43dfb4cdb8c3",
                                "sense_id": "0f91dbcf-6f42-3ce9-9b86-49bbce79811f",
                                "text": "„Im Gegensatz dazu ist bei Kompassen, die an Land verwendet werden, die Kompassrose am Gehäuse angebracht, und nur die Kompassnadel dreht sich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
