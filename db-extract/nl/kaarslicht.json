                "senses": [
                    {
                        "sense_id": "4b54e8d7-de98-3d31-989f-12d856fcf566",
                        "entry_id": "0fb496cc-35a7-31a9-bc2c-b15cc224f3c9",
                        "glosses": [
                            "het schijnsel van een brandende kaars"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5243fde-4aa9-453a-8ef0-46dcf04159c1",
                                "sense_id": "4b54e8d7-de98-3d31-989f-12d856fcf566",
                                "text": "Het waren geen juwelen, het waren ogen die naar haar knipoogden in het kaarslicht en naar de meisjes keken die naar zichzelf keken."
                            },
                            {
                                "example_id": "f63605b1-f3b8-412f-8c99-b3fd8112dca5",
                                "sense_id": "4b54e8d7-de98-3d31-989f-12d856fcf566",
                                "text": "Emil liep in de ochtend van 5 augustus vanaf dit huisje naar Conques, waar hij 's middags een expositie bezocht en 's avonds in de kerk naar enkele jongeren luisterde die bij kaarslicht religieuze liederen zongen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff203aba-6fd9-4a61-b214-cea17d6bcf00",
                        "source_entry_id": "0fb496cc-35a7-31a9-bc2c-b15cc224f3c9",
                        "source_sense_id": "4b54e8d7-de98-3d31-989f-12d856fcf566",
                        "source_sense_description": "het schijnsel van een brandende kaars",
                        "target_lang_word": "Kerzenlicht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kerzenlicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1aee8f18-a3cb-32e2-afc4-633222156005",
                                        "entry_id": "a2a8dd93-b4b1-34c0-9a44-47e916d93189",
                                        "glosses": [
                                            "von einer Kerze emittiertes Licht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9426c697-2e37-43e3-a368-ba9905db288c",
                                                "sense_id": "1aee8f18-a3cb-32e2-afc4-633222156005",
                                                "text": "Ich biete Dir ein romantisches Abendessen im Kerzenlicht an."
                                            },
                                            {
                                                "example_id": "a0fb4a38-cdc2-4fcd-9dd2-e3bb6602f76e",
                                                "sense_id": "1aee8f18-a3cb-32e2-afc4-633222156005",
                                                "text": "„Als die Gäste kamen, erklärte Helena, sie würden einen ganz besonderen Abend bei Kerzenlicht verbringen, ohne warmes Essen, nur mit Süßigkeiten.“"
                                            },
                                            {
                                                "example_id": "0c203548-2e96-439f-8f37-3237e8b552f6",
                                                "sense_id": "1aee8f18-a3cb-32e2-afc4-633222156005",
                                                "text": "„Wir saßen nun in einem kleinen Kreis um ihn herum, Kerzenlicht machte uns alle gleich jung und schön.“"
                                            },
                                            {
                                                "example_id": "7b6dfc7a-d401-4800-9b84-3b84a33043ed",
                                                "sense_id": "1aee8f18-a3cb-32e2-afc4-633222156005",
                                                "text": "„Die Farbe der Wände mochte er nicht, deshalb hatte er beschlossen, daß sie bei Kerzenlicht aßen.“"
                                            },
                                            {
                                                "example_id": "ff50f5c1-7183-445d-92f2-e873f3adf0ae",
                                                "sense_id": "1aee8f18-a3cb-32e2-afc4-633222156005",
                                                "text": "„Er drückte ihr noch einmal die Hand und liess sie dann los, und nun kehrte Natascha an ihren Platz im Kerzenlicht zurück und nahm wieder die Haltung von vorhin ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b66a3ffe-ff1b-46a4-abaa-b066c77b1049",
                        "source_entry_id": "0fb496cc-35a7-31a9-bc2c-b15cc224f3c9",
