                                "target_senses": [
                                    {
                                        "sense_id": "12a68e53-76b6-3990-b972-a190142f4d69",
                                        "entry_id": "ba49d208-5ec0-3ab8-88f2-84a6804b57fa",
                                        "glosses": [
                                            "A student of, or expert in prehistory."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80565cc0-6173-4160-921e-0f4fcccbddbf",
                                                "sense_id": "12a68e53-76b6-3990-b972-a190142f4d69",
                                                "text": "The prehistorian Andre Leroi-Gourhan has identified it as \"a woman holding a bison horn.\""
                                            },
                                            {
                                                "example_id": "7d83c89e-ade7-4a6a-96af-86ec6f0588c1",
                                                "sense_id": "12a68e53-76b6-3990-b972-a190142f4d69",
                                                "text": "In the early 1930s, he fell under the spell of a wife-beating, alcoholic, Austrian occultist called Karl Maria Wiligut and a Dutch prehistorian called Herman Wirth, whose views further fed his fantastical illusions."
                                            }
                                        ]
                                    }
                                ]
                            }
