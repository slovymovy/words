                        "translation_id": "834247de-f3ed-4a07-a7c5-6b4688b12948",
                        "source_entry_id": "1cc29a94-530d-3f71-b6dc-498d0e6c9903",
                        "source_sense_id": "f76e83f8-302a-3d07-9080-5ce6a5ea44c8",
                        "source_sense_description": "sexuelle Präferenz gegenüber Statuen/Puppen etc.",
                        "target_lang_word": "agalmatophilia",
