    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0e775ade-0662-345d-8a2d-9151aba7e03d",
                    "sense_definition": "Sprawić, że ktoś przestaje spać i odzyskuje świadomość.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sleep_wake",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Proszę <obudzić> mnie jutro o siódmej rano.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <разбудите> меня завтра в семь утра.",
                                "en": "Please <wake> me up tomorrow at seven in the morning."
                            }
                        },
                        {
                            "text": "Głośny hałas na ulicy nagle <obudził> całą rodzinę.",
                            "target_lang_translations": {
                                "ru": "Громкий шум на улице внезапно <разбудил> всю семью.",
                                "en": "A loud noise in the street suddenly <w>woke</w> the whole family."
                            }
                        }
                    ],
                    "synonyms": [
                        "zbudzić"
                    ],
                    "antonyms": [
                        "uśpić"
                    ],
                    "common_phrases": [
                        "obudzić kogoś rano",
                        "obudzić ze snu",
                        "trudno kogoś obudzić"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставить кого-то проснуться, прервать чей-то сон.",
                        "en": "To cause someone to stop sleeping and regain consciousness."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разбудить",
                                "target_lang_sense_clarification": "прервать чей-то сон"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "wake up",
                                "target_lang_sense_clarification": "transitive; to cause someone to stop sleeping"
                            },
                            {
                                "target_lang_word": "awaken",
                                "target_lang_sense_clarification": "to cause someone to stop sleeping, often used in more formal contexts"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23245cb2-3d6a-3127-861f-37bb7ffe6544",
                    "sense_definition": "Zakończyć sen i zacząć czuwać (używane z zaimkiem zwrotnym „się”).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sleep_wake",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dziś <obudziłem> się bardzo wcześnie i byłem wypoczęty.",
                            "target_lang_translations": {
                                "ru": "Сегодня я <проснулся> очень рано и был отдохнувшим.",
                                "en": "Today I <w>woke</w> up very early and felt rested."
                            }
                        },
                        {
                            "text": "Czy możesz <obudzić> się bez nastawiania budzika?",
                            "target_lang_translations": {
                                "ru": "Ты можешь <проснуться> без будильника?",
                                "en": "Can you <w>wake</w> up without setting an alarm?"
                            }
                        }
                    ],
                    "synonyms": [
                        "ocknąć się"
                    ],
                    "antonyms": [
                        "zasnąć"
                    ],
                    "common_phrases": [
                        "obudzić się rano",
                        "obudzić się wcześnie",
                        "obudzić się z krzykiem"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перестать спать и начать бодрствовать (обычно с возвратной частицей).",
                        "en": "To stop sleeping and become conscious (used with a reflexive pronoun)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проснуться",
                                "target_lang_sense_clarification": "самому перестать спать"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "wake up",
                                "target_lang_sense_clarification": "intransitive; to stop sleeping"
                            },
                            {
                                "target_lang_word": "awake",
                                "target_lang_sense_clarification": "intransitive; to become conscious after sleeping"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21dcbced-8ab5-375d-8c14-e91eb330c8b1",
                    "sense_definition": "Wywołać u kogoś silne emocje, wspomnienia, zainteresowanie lub inne stany wewnętrzne.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotions_cause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ta niezwykła podróż <obudziła> w niej pasję do fotografii.",
                            "target_lang_translations": {
                                "ru": "Это необыкновенное путешествие <пробудило> в ней страсть к фотографии.",
                                "en": "This extraordinary journey <w>awakened</w> a passion for photography in her."
                            }
                        },
                        {
                            "text": "Widok starego domu <obudził> wspomnienia z czasów dzieciństwa.",
                            "target_lang_translations": {
                                "ru": "Вид старого дома <пробудил> воспоминания из детства.",
                                "en": "The sight of the old house <w>awakened</w> childhood memories."
                            }
                        }
                    ],
                    "synonyms": [
                        "zbudzić"
                    ],
                    "antonyms": [
                        "uśpić",
                        "stłumić"
                    ],
                    "common_phrases": [
                        "obudzić nadzieję",
                        "obudzić wspomnienia",
                        "obudzić ciekawość",
                        "obudzić zaufanie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызвать сильные эмоции, воспоминания или интерес.",
                        "en": "To stir up or evoke strong emotions, memories, interests, or internal states in someone."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пробудить",
                                "target_lang_sense_clarification": "вызвать чувства или воспоминания"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "awaken",
                                "target_lang_sense_clarification": "to stir up feelings or memories"
                            },
                            {
                                "target_lang_word": "rouse",
                                "target_lang_sense_clarification": "to stir someone from a state of inaction or to evoke strong feelings"
                            },
                            {
                                "target_lang_word": "stir up",
                                "target_lang_sense_clarification": "to cause emotions or memories to become active"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}