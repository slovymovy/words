        "fr-extract.jsonl": [
            {
                "entry_id": "0fe79e67-9575-37d8-a624-9db594a5423d",
                "word": "eh",
                "pos": "intj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e1166c4e-50de-3e83-b792-88a20f7c0e2a",
                        "entry_id": "0fe79e67-9575-37d8-a624-9db594a5423d",
                        "glosses": [
                            "D’admiration, de surprise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ef5982e-5716-430d-b450-956bd24a91d4",
                                "sense_id": "e1166c4e-50de-3e83-b792-88a20f7c0e2a",
                                "text": "Eh ! Qui aurait pu croire cela ?"
                            },
                            {
                                "example_id": "b24bd736-08de-4061-847d-b76280061650",
                                "sense_id": "e1166c4e-50de-3e83-b792-88a20f7c0e2a",
                                "text": "Eh ! Tu me fais mal !"
                            },
                            {
                                "example_id": "1be57935-a9af-445d-a90e-e9c4354643bb",
                                "sense_id": "e1166c4e-50de-3e83-b792-88a20f7c0e2a",
                                "text": "Eh ! Si cela se trouve, il avait déménagé chez elle, simplement !"
                            }
                        ]
                    },
                    {
                        "sense_id": "5c05dbe3-5079-32c7-b303-7df02b16dd33",
                        "entry_id": "0fe79e67-9575-37d8-a624-9db594a5423d",
                        "glosses": [
                            "Autre graphie pour « hé »."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cbf265d-2b95-40a9-adc6-dd55a86df17a",
                                "sense_id": "5c05dbe3-5079-32c7-b303-7df02b16dd33",
                                "text": "— Eh ! monsieur ! s’écria un garçon d’écurie courant après l’inconnu, eh ! monsieur ! voilà un papier qui s’est échappé de votre chapeau ! Eh ! monsieur ! eh ! eh !…"
                            },
                            {
                                "example_id": "57cd407f-23be-4c62-b2d7-de0b4aaedcc4",
                                "sense_id": "5c05dbe3-5079-32c7-b303-7df02b16dd33",
                                "text": "Chaque fois qu’on me jette le nom de mon père au visage, j’éprouve une brûlure par tout le corps. Quand je passe et que les gamins crient : Eh ! la Chantegreil ! Cela me met hors de moi ; je voudrais les tenir pour les battre."
                            },
                            {
                                "example_id": "c8020c8f-6db0-4a38-a9fb-8f1d75fb1b05",
                                "sense_id": "5c05dbe3-5079-32c7-b303-7df02b16dd33",
                                "text": "— Eh ! Fais un peu attention, c’est dangereux ici, je ne veux pas d’histoire avec ton paternel, moi ! maugréa Abraham en la rattrapant par le bras."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a45134c-7742-44f2-afc1-9db3e39ea065",
                        "source_entry_id": "0fe79e67-9575-37d8-a624-9db594a5423d",
                        "target_lang_word": "na",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "na",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "56df274b-a81f-363e-9493-3f139aba8105",
                                        "entry_id": "c0195c34-3846-3d78-af92-ce8b4c72683a",
                                        "glosses": [
                                            "ein sehr nuancierter, kontextabhängiger, floskelhafter Ausdruck der Zustimmung, der Überraschung, der Verwunderung, des Zweifels, der Skepsis, der Ablehnung, der Ungeduld, des Ärgers, der sanften Drohung, der Ermahnung, der Entrüstung, der Missbilligung; er dient weiterhin der Schaffung einer Denkpause oder Gesprächspause, um die Aufmerksamkeit, die Spannung zu erhöhen oder das Nachfolgende herauszustellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc7ea6b1-fc40-45e2-9306-6cc0ec06b6c7",
                                                "sense_id": "56df274b-a81f-363e-9493-3f139aba8105",
                                                "text": "Na, wenn das keinen Spaß macht, weiß ich auch nicht, was wir noch machen sollen."
                                            },
                                            {
                                                "example_id": "608b2599-bac4-42bb-be93-339ff12de795",
                                                "sense_id": "56df274b-a81f-363e-9493-3f139aba8105",
                                                "text": "Na, das ist aber eine Überraschung!"
                                            },
                                            {
                                                "example_id": "cc5d8a5b-b434-4cbe-b609-2e92ef00f876",
                                                "sense_id": "56df274b-a81f-363e-9493-3f139aba8105",
                                                "text": "Na, dass du überhaupt noch kommst, ist ein Wunder."
                                            },
                                            {
                                                "example_id": "0f3b8b2a-a73f-4c57-bccd-63fd507931eb",
                                                "sense_id": "56df274b-a81f-363e-9493-3f139aba8105",
                                                "text": "Na, wenn das mal gut geht."
                                            },
                                            {
                                                "example_id": "6c73aba9-0505-4919-8bb2-2564730ae56d",
                                                "sense_id": "56df274b-a81f-363e-9493-3f139aba8105",
                                                "text": "Na, ich bin da skeptisch."
                                            },
                                            {
                                                "example_id": "e9ec5a3b-2b9a-4556-9e15-fd9da5e6d6e6",
                                                "sense_id": "56df274b-a81f-363e-9493-3f139aba8105",
                                                "text": "Na, das kannst du aber vergessen."
                                            },
                                            {
                                                "example_id": "6089f806-b4ef-41ff-8876-a36c0fb0ffaf",
                                                "sense_id": "56df274b-a81f-363e-9493-3f139aba8105",
                                                "text": "Na, hoffentlich wirst du bald fertig."
                                            },
                                            {
                                                "example_id": "8b4734e3-d636-4c8e-917d-64d86940b19c",
                                                "sense_id": "56df274b-a81f-363e-9493-3f139aba8105",
                                                "text": "Na, das hätte ich dir gleich sagen können, dass das Punkte in Flensburg bringt."
                                            },
                                            {
                                                "example_id": "e8ce2863-ee88-4e6b-8e7b-07d62640160c",
                                                "sense_id": "56df274b-a81f-363e-9493-3f139aba8105",
                                                "text": "Na, wenn Sie hier nicht aufpassen, werden Sie es noch bereuen."
                                            },
                                            {
                                                "example_id": "3d8a5784-7d2a-4b6c-85f5-2d0b8b8b631d",
                                                "sense_id": "56df274b-a81f-363e-9493-3f139aba8105",
                                                "text": "Na, da bin ich aber gespannt, was noch passiert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6495a5f5-5fb9-350f-929b-8d122c4fcf0d",
