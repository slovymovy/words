                "senses": [
                    {
                        "sense_id": "3af1fb30-596b-3104-ae80-940dcb7faddd",
                        "entry_id": "8405326a-d9bd-310a-9517-f2a137bfcb15",
                        "glosses": [
                            "Frau, die vor oder in der Kirche Kerzen verkauft"
                        ],
                        "tags": [
                            "bairisch veraltet"
                        ],
                        "examples": [
                            {
                                "example_id": "e9476285-f435-4ab3-b47c-b2f5aff75971",
                                "sense_id": "3af1fb30-596b-3104-ae80-940dcb7faddd",
                                "text": "„Was nun das Handeln der Kerzlerinnen betrifft, so glaubt der Einsender dieses, daß es wohl des Beste seyn würde, diesen Handel in der Kirche mit Kerzeln ganz abzuschaffen, da man diese Kerzeln ja überall anders kaufen kann; […]“"
                            },
                            {
                                "example_id": "76ee0000-11ec-4682-94e6-9cb820ffb7d6",
                                "sense_id": "3af1fb30-596b-3104-ae80-940dcb7faddd",
                                "text": "„Man bittet, dasselbe bei der Kerzlerin in der St. Peters-Pfarr-Kirche abzugeben.“"
                            },
                            {
                                "example_id": "d5e79d96-52ae-4af4-9aad-f68e4d1c6ea0",
                                "sense_id": "3af1fb30-596b-3104-ae80-940dcb7faddd",
                                "text": "„Inzwischen waren sie dem bescheidenen Ständchen der betagten Kerzlerin näher gekommen, die der wohlbekannten Kundin freundlich entgegenlächelte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
