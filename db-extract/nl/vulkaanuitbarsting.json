                "senses": [
                    {
                        "sense_id": "fc6d4139-7306-3a4d-85d5-09251027c9bb",
                        "entry_id": "a77d67bc-5902-3ccc-8338-7a651fd1b253",
                        "glosses": [
                            "de vaak explosieve activiteit waarmee in een vulkaan opgebouwde spanningen zich ontladen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5a5a1da-5838-47a1-a793-7eb5ca5eaecd",
                                "sense_id": "fc6d4139-7306-3a4d-85d5-09251027c9bb",
                                "text": "Er is weer een vulkaanuitbarsting op IJsland."
                            },
                            {
                                "example_id": "65611f6c-aae8-47d7-9f6d-a4928b3cc86f",
                                "sense_id": "fc6d4139-7306-3a4d-85d5-09251027c9bb",
                                "text": "Platentektoniek: De belangrijkste oorzaak van de bevingen zijn verschuivingen van aardplaten. \"Het gebied rond Voerendaal ligt in de Roerdalslenk, die wordt begrensd door twee grote breuken waardoor de ondergrond onder druk staat\", zegt Evers tegen 1Limburg. \"De regio staat tektonisch onder spanning. Die is te herleiden naar het Middellandse Zeegebied, waar vaker aardbevingen en vulkaanuitbarstingen voorkomen.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc0546cb-4b77-441d-81ab-83890a50a262",
                        "source_entry_id": "a77d67bc-5902-3ccc-8338-7a651fd1b253",
                        "source_sense_id": "fc6d4139-7306-3a4d-85d5-09251027c9bb",
                        "source_sense_description": "de vaak explosieve activiteit waarmee in een vulkaan opgebouwde spanningen zich ontladen",
                        "target_lang_word": "Vulkanausbruch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vulkanausbruch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "59da9ad7-9ea9-3367-8a1a-f0f05e559ee7",
                                        "entry_id": "92af820e-73f0-39fd-a91d-db51732806cd",
                                        "glosses": [
                                            "vulkanischer Ausstoß von Lava, Gestein und Asche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f33681f0-8a10-438f-9006-aa8f6b614a60",
                                                "sense_id": "59da9ad7-9ea9-3367-8a1a-f0f05e559ee7",
                                                "text": "Bei dem Vulkanausbruch starben keine Menschen, weil sie rechtzeitig evakuiert wurden."
                                            },
                                            {
                                                "example_id": "a6be8807-880b-460e-a1d4-c3268acb0f13",
                                                "sense_id": "59da9ad7-9ea9-3367-8a1a-f0f05e559ee7",
                                                "text": "„Du bist ziemlich sicher, dass Roland alle Sagas gelesen hat und noch weiß, wann der Vulkanausbruch von Surtsey war.“"
                                            },
                                            {
                                                "example_id": "c7e1e53a-691f-416e-b332-5cf6278f71ec",
                                                "sense_id": "59da9ad7-9ea9-3367-8a1a-f0f05e559ee7",
                                                "text": "„Vor etwa 200.000 Jahren schufen die Vulkanausbrüche des Bellerbergs die Voraussetzungen für die spätere Basaltlavagewinnung und -verarbeitung in Mayen.“"
                                            },
                                            {
                                                "example_id": "26b484ef-5497-4b26-9d92-7328528dc69b",
                                                "sense_id": "59da9ad7-9ea9-3367-8a1a-f0f05e559ee7",
                                                "text": "„Die Vulkanausbrüche Islands haben auch ein Reiseziel erschaffen, das ich bis heute nicht erreichen konnte: 1963 ist vor der Südküste Islands eine neue Insel entstanden.“"
                                            },
                                            {
                                                "example_id": "66958477-7274-4b7c-a8d6-ecfd63353f55",
                                                "sense_id": "59da9ad7-9ea9-3367-8a1a-f0f05e559ee7",
                                                "text": "„In Millionen von Jahren haben ständige Vulkanausbrüche die Berge geformt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
