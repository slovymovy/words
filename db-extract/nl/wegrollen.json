                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f41dc5f-6db2-492b-870e-8546743810be",
                                                "sense_id": "af1681ef-877e-3fe1-8098-e5abd16a9e82",
                                                "text": "My pen rolled off the table."
                                            },
                                            {
                                                "example_id": "1b01856e-6451-4fd9-b2ec-40b612eae557",
                                                "sense_id": "af1681ef-877e-3fe1-8098-e5abd16a9e82",
                                                "text": "I can't believe that that skateboarder just rolled right off that ledge like the six-foot drop was nothing!"
