                                    {
                                        "sense_id": "b4387409-4314-33f0-9c5b-4c4c0b803181",
                                        "entry_id": "4c84a2e5-0574-3668-93cc-109ccc6c25d6",
                                        "glosses": [
                                            "Person, die (nahezu) genauso wie eine andere Person aussieht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bc4794b-4895-4ca5-bd63-a17a045a6d3d",
                                                "sense_id": "b4387409-4314-33f0-9c5b-4c4c0b803181",
                                                "text": "Ein eineiiger Zwilling hat sicher einen Doppelgänger."
                                            },
                                            {
                                                "example_id": "ef35e3b9-18d3-4bbc-8b8f-533662018815",
                                                "sense_id": "b4387409-4314-33f0-9c5b-4c4c0b803181",
                                                "text": "Manche Doppelgänger leben gefährlich, da sie ihr Original schützen müssen."
                                            },
                                            {
                                                "example_id": "0735ab30-9676-4d6e-8de4-80f8bc573c9c",
                                                "sense_id": "b4387409-4314-33f0-9c5b-4c4c0b803181",
                                                "text": "„Man könnte eine lange Liste von Doppelgängern aus dem Werk Hoffmanns aufstellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
