                "senses": [
                    {
                        "sense_id": "5161123c-7fd4-3a74-8c8c-82854d63fa65",
                        "entry_id": "954c2490-0dc0-37a3-9106-71eb1b7a1795",
                        "glosses": [
                            "Straßenbelag, bestehend aus 3 Schichten verdichtetem Schotter mit verschiedenen Korngrößen, heute meist mit Teer oder Bitumen gebunden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d60736d0-79c9-4c6f-8afc-61c1600b413f",
                                "sense_id": "5161123c-7fd4-3a74-8c8c-82854d63fa65",
                                "text": "Makadam war zwar eine arbeitsintensive, aber effektive Methode, die Straße zu befestigen."
                            },
                            {
                                "example_id": "26622d7c-e878-407a-b3ff-21c997120e99",
                                "sense_id": "5161123c-7fd4-3a74-8c8c-82854d63fa65",
                                "text": "Bei seinem Sturz ist er mit dem Gesicht direkt auf den Makadam geschlagen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e42ec14d-8ca1-4ca3-9d07-e90e173e8718",
                        "source_entry_id": "954c2490-0dc0-37a3-9106-71eb1b7a1795",
                        "source_sense_id": "5161123c-7fd4-3a74-8c8c-82854d63fa65",
                        "target_lang_word": "macadam",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "macadam",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed0f1e6d-d0b3-3987-97d6-fb2514f65928",
                                        "entry_id": "0cd8a5e5-0dda-369e-96de-94bb44c43d44",
                                        "glosses": [
                                            "The surface of a road consisting of layers of crushed stone (usually tar-coated for modern traffic)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8872404-21dc-46b4-ba60-ee47fd78efdf",
                                                "sense_id": "ed0f1e6d-d0b3-3987-97d6-fb2514f65928",
                                                "text": "This narrow-gauge line had suffered the same fate as that between Schull and Skibbereen, with the track taken up except where it runs through one of the town streets and is embedded in the macadam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dfa9c95-b00b-33fc-b01d-d18857f6dcb3",
                                        "entry_id": "0cd8a5e5-0dda-369e-96de-94bb44c43d44",
                                        "glosses": [
                                            "Any road or street."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "macadam",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dcc83e45-f0b4-3fec-8542-1a91fad8e184",
                                        "entry_id": "cf091530-882c-35c3-8ecf-182cf4fd2f86",
                                        "glosses": [
                                            "To cover or surface with macadam."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c4c6fe4-0739-42b2-8858-bb31ea4e1982",
                        "source_entry_id": "954c2490-0dc0-37a3-9106-71eb1b7a1795",
                        "source_sense_id": "5161123c-7fd4-3a74-8c8c-82854d63fa65",
                        "target_lang_word": "macadam",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "macadam",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fbd15399-04ac-38b0-9452-a41796bd287e",
                                        "entry_id": "5f7d7f5a-dbd5-3ee4-91e5-9f6b8734c849",
                                        "glosses": [
                                            "Empierrement de routes ou de pavage de rues qui se fait avec des cailloux ou du granit concassé, fortement comprimés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6a3efcf-b8cc-4cdd-a6bd-07398e1b25ed",
                                                "sense_id": "fbd15399-04ac-38b0-9452-a41796bd287e",
                                                "text": "Ce sont ces chemins qu'il s'agit de macadamiser; non pas au moyen de pierres jetées à tort et à travers, mais au moyen d'un macadam de 2m. 50 c. de large, avec fossés pour l'écoulement des eaux; un macadam bien fait, recouvert en matière dure, quoique tendre au fond."
                                            },
                                            {
                                                "example_id": "605ce9ce-1e60-40fe-9828-e4b3e4bf51b9",
                                                "sense_id": "fbd15399-04ac-38b0-9452-a41796bd287e",
                                                "text": "Il se présentait, à Paris, sous quatre formes différentes: D'abord, le pavé: […]. Ce revêtement en pierre ne présentait d'autre inconvénient que sa sonorité. Ensuite, on trouvait le macadam, mélange de pierre concassée et de sable, qui fit son apparition dans les années 1880: en 1887, 1.607.900 m2 de rues étaient macadamisées. Les chaussées à macadam, formées de porphyre, fatiguaient moins le pied des chevaux que le pavé et surtout étaient plus silencieuses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a79ebd2-d62c-3c8a-b5e0-f8f25fe2157c",
                                        "entry_id": "5f7d7f5a-dbd5-3ee4-91e5-9f6b8734c849",
                                        "glosses": [
                                            "Chaussée ou trottoir ainsi empierré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4cc5d97-456e-4fba-89db-a37dac37c94a",
                                                "sense_id": "7a79ebd2-d62c-3c8a-b5e0-f8f25fe2157c",
                                                "text": "À genoux sur le macadam, Taxis chercha l’endroit exact où il avait saisit l’épingle."
                                            },
                                            {
                                                "example_id": "821764b1-9120-45f0-94f6-f0a2d9d8c4f5",
                                                "sense_id": "7a79ebd2-d62c-3c8a-b5e0-f8f25fe2157c",
                                                "text": "La mode est dans l’air, c’est le vent qui l’apporte, on la pressent, on la respire, elle est au ciel et sur le macadam, elle tient aux idées, aux mœurs, aux évènements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e67c518a-39dc-377a-904a-68ff24fa6281",
                                        "entry_id": "5f7d7f5a-dbd5-3ee4-91e5-9f6b8734c849",
                                        "glosses": [
                                            "Couche d’asphalte ou d'enrobé bitumineux utilisé comme revêtement de la chaussée."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b49763e6-ac25-4e24-aa70-debd3ceb9ed4",
                                                "sense_id": "e67c518a-39dc-377a-904a-68ff24fa6281",
                                                "text": "La communauté urbaine d’Arras (CUA) réaménagera le trottoir actuel, avec du macadam, de l’arrêt de bus jusqu’au garage automobile du village."
                                            },
                                            {
                                                "example_id": "6571bfb7-db0c-44ea-bf19-aba197aadfd0",
                                                "sense_id": "e67c518a-39dc-377a-904a-68ff24fa6281",
                                                "text": "Depuis la situation a changé. Les pavés recouverts de macadam ou d’asphalte disparaissent si profondément que les contestataires ne peuvent les deviner et surtout les en extraire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c4eb705-fc8f-3427-a2ec-1175f53002a9",
                                        "entry_id": "5f7d7f5a-dbd5-3ee4-91e5-9f6b8734c849",
                                        "glosses": [
                                            "Toutes sortes de route, et en particulier les routes goudronnées."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f6ad017-0573-491c-b2ce-911935f0d42a",
                                                "sense_id": "2c4eb705-fc8f-3427-a2ec-1175f53002a9",
                                                "text": "La neige n’avait pas tenu sur le béton de Bobigny. Une boue crasseuse s’était étalée sur le macadam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98956598-cff8-33f4-adf8-8cb68e08c3bc",
                                        "entry_id": "5f7d7f5a-dbd5-3ee4-91e5-9f6b8734c849",
                                        "glosses": [
                                            "Escroquerie aux assurances maladies."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c64ea095-abd2-49d6-9ad9-edde70662527",
                                                "sense_id": "98956598-cff8-33f4-adf8-8cb68e08c3bc",
                                                "text": "Ce qui a tué ce genre d’escroquerie (macadam, officines médicales douteuses), ça a été l’assurance sociale en 1930."
                                            },
                                            {
                                                "example_id": "465976e4-da48-45e6-995e-7ba393508947",
                                                "sense_id": "98956598-cff8-33f4-adf8-8cb68e08c3bc",
                                                "text": "Il faut provoquer un macadam, une blessure volontaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
