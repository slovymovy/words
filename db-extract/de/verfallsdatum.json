                "senses": [
                    {
                        "sense_id": "aecf9ec2-1b28-3e3f-8fd7-9d4e1c4f00e5",
                        "entry_id": "ff35a254-9daa-3790-909b-5465e13d74c2",
                        "glosses": [
                            "Zeitpunkt, ab dem ein Lebensmittel, Arzneimittel oder Ähnliches nicht mehr verwendet werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d432d75-52f9-4ca3-bee3-613f0dc5d92e",
                                "sense_id": "aecf9ec2-1b28-3e3f-8fd7-9d4e1c4f00e5",
                                "text": "Im Kühlschrank fand sich ein Becher Joghurt mit abgelaufenem Verfallsdatum."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0622c169-42dd-360c-95b9-54063b1f04a8",
                        "entry_id": "ff35a254-9daa-3790-909b-5465e13d74c2",
                        "glosses": [
                            "Zeitpunkt, an dem etwas verfällt, an dem die Gültigkeits-, Lagerungs- oder Verwendungsfrist von etwas abläuft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "488e056a-b7ec-4e9c-8b27-cef386f155d2",
                                "sense_id": "0622c169-42dd-360c-95b9-54063b1f04a8",
                                "text": "„Datenschutz können wir nicht mehr dem Staat überlassen, sagt Harvard-Professor Mayer-Schönberger. Deshalb fordert er ein Verfallsdatum für gespeicherte Informationen.“"
                            },
                            {
                                "example_id": "a781212b-b038-46ea-95fb-06a7c2bd6572",
                                "sense_id": "0622c169-42dd-360c-95b9-54063b1f04a8",
                                "text": "„Dieser Kalauer zeigt, dass man an allen Witzen ihre Entstehungszeit ablesen kann, ja, dass Witze ein Zeitgradmesser für ihre Entstehungszeit und ihr Verfallsdatum sind.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "261b19cd-da69-3579-b0d3-d01a31b10226",
                        "entry_id": "ff35a254-9daa-3790-909b-5465e13d74c2",
                        "glosses": [
                            "Fälligkeitstermin eines Wechsels, Optionsscheins oder Ähnlichem"
                        ],
                        "tags": [
                            "Bankwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "be549f7d-edf7-41a3-a143-adc39abb833e",
                                "sense_id": "261b19cd-da69-3579-b0d3-d01a31b10226",
                                "text": "„In der Vergangenheit sind Besitzer von Optionsscheinen, die sich mit der komplizierten Materie nicht befaßt haben und auch von ihren Banken nicht rechtzeitig genug vorgewarnt wurden, den Verfallsdaten zum Opfer gefallen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4639af57-2f1d-4f36-9a56-fcb4b732316a",
                        "source_entry_id": "ff35a254-9daa-3790-909b-5465e13d74c2",
                        "source_sense_id": "aecf9ec2-1b28-3e3f-8fd7-9d4e1c4f00e5",
                        "source_sense_description": "Zeitpunkt, ab dem ein Lebensmittel, Arzneimittel oder Ähnliches nicht mehr verwendet werden soll",
                        "target_lang_word": "expiry date",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "expiry date",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10043405-d1a9-305b-8ecc-71ac8c7cc61f",
                                        "entry_id": "036fc773-9599-35ad-853b-86e54bf49584",
                                        "glosses": [
                                            "The date on which something runs out or expires and becomes out of date, in many cases requiring renewal."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "090ababd-5383-41fe-8c32-93eea868ee01",
                                                "sense_id": "10043405-d1a9-305b-8ecc-71ac8c7cc61f",
                                                "text": "The expiry date of my debit card is the 30th of April."
                                            },
                                            {
                                                "example_id": "5a17bd1d-0937-4975-a069-2bc630eaa5d4",
                                                "sense_id": "10043405-d1a9-305b-8ecc-71ac8c7cc61f",
                                                "text": "You'd better throw that milk out: it's passed the expiry date."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e51de71-16f4-4e21-81ac-7624b83a7691",
                        "source_entry_id": "ff35a254-9daa-3790-909b-5465e13d74c2",
                        "source_sense_id": "aecf9ec2-1b28-3e3f-8fd7-9d4e1c4f00e5",
                        "source_sense_description": "Zeitpunkt, ab dem ein Lebensmittel, Arzneimittel oder Ähnliches nicht mehr verwendet werden soll",
                        "target_lang_word": "expiration date",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "expiration date",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf53f7b2-ab37-37a9-a698-cd320906216f",
                                        "entry_id": "0f847cc1-e10f-3a21-850b-40ae1574df78",
                                        "glosses": [
                                            "A date by which an object either should not be used or loses its value, depending upon the item."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f860aef9-ae3a-4300-a8c1-00f9215583c2",
                                                "sense_id": "cf53f7b2-ab37-37a9-a698-cd320906216f",
                                                "text": "credit card expiration date"
                                            },
                                            {
                                                "example_id": "acc2c936-d854-4826-a336-9bab1a2ad2c4",
                                                "sense_id": "cf53f7b2-ab37-37a9-a698-cd320906216f",
                                                "text": "Well, in the mercy of God we are normally unaware of our personal expiration date."
                                            },
                                            {
                                                "example_id": "4f3a670a-1f70-4e5c-8267-2f8ca63aacf7",
                                                "sense_id": "cf53f7b2-ab37-37a9-a698-cd320906216f",
                                                "text": "You have an expiration date, and despite your wanting to claim control over life circumstances, you're not entitled to know when your expiration date will be."
                                            },
                                            {
                                                "example_id": "40b0b0d0-f554-4ce0-82f9-390a69c78665",
                                                "sense_id": "cf53f7b2-ab37-37a9-a698-cd320906216f",
                                                "text": "If my expiration date is set, then it doesn't matter if I smoke or eat a gallon of ice cream a day; however, the quality of my life between now and that point will be improved considerably by eating well and taking good care of myself."
                                            },
                                            {
                                                "example_id": "adc2c976-a3cd-41c4-b139-493e1a2afa21",
                                                "sense_id": "cf53f7b2-ab37-37a9-a698-cd320906216f",
                                                "text": "It is modern medicine's best guess, a 50/50 shot, a coin flip of a lifespan. I would not want to know my expiration date or median survival."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3bd3c68a-f572-4245-9cd8-c1e700c14c8d",
                        "source_entry_id": "ff35a254-9daa-3790-909b-5465e13d74c2",
                        "source_sense_id": "aecf9ec2-1b28-3e3f-8fd7-9d4e1c4f00e5",
