                            {
                                "example_id": "e1ee8fbc-20bd-478f-9f04-1eef3a803cdc",
                                "sense_id": "f99b6197-59ee-3b52-8b56-8cc7e3fdd7e2",
                                "text": "Mon père était, par nature, un « animal antipolitique » et même « apolitique » ainsi que disaient, au siècle dernier, les individualistes, précurseurs de Nietsche."
                            },
                            {
                                "example_id": "c0edb4fb-3fdf-4209-b256-8123183374f8",
                                "sense_id": "f99b6197-59ee-3b52-8b56-8cc7e3fdd7e2",
                                "text": "Le populisme n’est pas antipolitique, comme il est parfois stigmatisé, mais hyperpolitique, parce qu’il porte cet espoir que la politique change le monde."
                            }
                        ]
                    }
