                                                "sense_id": "13454ce0-276f-35cc-9d87-f02a5d888a9d",
                                                "text": "I heard an almighty crash and ran into the kitchen to see what had happened."
                                            },
                                            {
                                                "example_id": "da979008-7f9e-4819-97b4-23c761bf86eb",
                                                "sense_id": "13454ce0-276f-35cc-9d87-f02a5d888a9d",
                                                "text": "When Jonathan Trott and Kevin Pietersen both went cheaply inside the first hour on the fifth day, a further 134 were needed and there was a genuine sense that an almighty upset might just come off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eee0f81e-5243-37ab-a4fd-3ea8e26a3b9a",
                                        "entry_id": "f7ed0bf8-f5cf-3592-a5f4-c0814462667c",
                                        "glosses": [
                                            "Having very great power, influence, etc."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
