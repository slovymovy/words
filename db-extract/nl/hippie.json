                "senses": [
                    {
                        "sense_id": "d52ffa38-73ef-374f-b3c5-172f4cec3a77",
                        "entry_id": "604670dc-9126-3b09-9366-4462174d4430",
                        "glosses": [
                            "softe apolitieke persoon (oorspronkelijk uit de jaren zestig van de twintigste eeuw) die zich door zijn non-conformistische gedrag en vredelievende levenswijze afzette tegen toenmalige maatschappelijke opvattingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57dfebe6-5de8-49da-9f73-0d5597a3af18",
                                "sense_id": "d52ffa38-73ef-374f-b3c5-172f4cec3a77",
                                "text": "hippies hielden van lang haar, kralen en bloemen"
                            },
                            {
                                "example_id": "6d867009-528c-4354-bfcc-0d508172a39d",
                                "sense_id": "d52ffa38-73ef-374f-b3c5-172f4cec3a77",
                                "text": "De kinderen hadden meer dan genoeg aanspraak met alle hippies om zich heen en leken volop te genieten van het avontuur."
                            }
                        ]
                    }
                ],
                "translations": [
