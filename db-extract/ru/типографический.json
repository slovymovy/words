                "senses": [
                    {
                        "sense_id": "2c9d3c4f-c63d-3716-a7db-f3a82ed6ae60",
                        "entry_id": "f5e2ddcc-93a0-3527-9bfb-ef8be665c5dd",
                        "glosses": [
                            "устар. то же, что типографский"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "821d1fa7-8004-4d44-af20-1980c2337e2d",
                                "sense_id": "2c9d3c4f-c63d-3716-a7db-f3a82ed6ae60",
                                "text": "Благодарю и Одоевского за его типографические хлопоты."
                            },
                            {
                                "example_id": "fb8977c5-8ab7-4cf7-9795-f8267512bd30",
                                "sense_id": "2c9d3c4f-c63d-3716-a7db-f3a82ed6ae60",
                                "text": "Не могу понять, как есть на свете люди, которые могут писать письма летом с Рейна и прилежащих к нему государств. Это всё равно, что на балу думать о типографической ошибке, замеченной утром в статье, или беседовать с доктором о пользе и вреде ламповых и свечных испарений."
                            },
                            {
                                "example_id": "37d5dfd2-8098-4bbf-9d79-9c836cae6a46",
                                "sense_id": "2c9d3c4f-c63d-3716-a7db-f3a82ed6ae60",
                                "text": "Страница, исписанная тесным, мелким и неуверенным почерком Лермонтова, мгновенно меняется, когда рукопись превращается в строй типографических литер."
                            }
                        ]
                    }
                ],
