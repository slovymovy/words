                ],
                "senses": [
                    {
                        "sense_id": "a86047dd-511d-3b4b-b779-72211f66cd90",
                        "entry_id": "147131b3-e3a0-356f-800f-47c88aa539d8",
                        "glosses": [
                            "Saltimbanque qui attire les chalands au spectacle."
                        ],
                        "tags": [
                            "literally"
                        ],
                        "examples": [
                            {
                                "example_id": "792a450c-e701-4f46-a87e-92b1d4974159",
                                "sense_id": "a86047dd-511d-3b4b-b779-72211f66cd90",
                                "text": "« On la vend deux sous, paroles et musique ! » clamait la bonisseuse, tendant sa chanson à la ronde."
                            },
                            {
                                "example_id": "8e35a2fc-bbf5-4bcf-80ec-c2df194cc95c",
                                "sense_id": "a86047dd-511d-3b4b-b779-72211f66cd90",
                                "text": "S'il en est capable, le bonisseur fait encore un numéro à l'intérieur, pour corser le spectacle. Il lui faut en outre, bien souvent, participer au montage et au démontage, parfois manœuvrer lui-même l'appareil de projection, […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "959bdf67-10a2-3514-9e6c-cdf1a61ee6af",
                        "entry_id": "147131b3-e3a0-356f-800f-47c88aa539d8",
                        "glosses": [
                            "Personnage qui dit des boniments."
                        ],
                        "tags": [
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "4c39d6e7-8d7e-4aa1-87d3-3d0b82d958ec",
                                "sense_id": "959bdf67-10a2-3514-9e6c-cdf1a61ee6af",
                                "text": "[…] ; mais j'ai tout lieu de supposer que dans le brillant entourage de ce bonisseur, il n'y a personne ayant entendu parler du Mouvement socialiste."
                            },
                            {
                                "example_id": "24c7a8c8-f15b-499b-94ad-f51472fdae97",
                                "sense_id": "959bdf67-10a2-3514-9e6c-cdf1a61ee6af",
                                "text": "Robert Macaire, pitre magnifique, camelot effronté, prodigieux bonisseur, génial saltimbanque est la caricature la plus parfaite de ce temps que l'on identifie, à tort toutefois, avec lui. Il n'en est que la dérision."
                            }
                        ]
                    }
                ],
