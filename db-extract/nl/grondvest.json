                    {
                        "sense_id": "78e46107-5221-3fc0-8e9d-e767355256a6",
                        "entry_id": "8a8acc31-485f-3e76-b74d-1937517ff14a",
                        "glosses": [
                            "constructie in de grond die een stevige basis vormt om er een gebouw op te bouwen"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "8b7a50fb-f421-4043-ae27-c22c922805b7",
                                "sense_id": "78e46107-5221-3fc0-8e9d-e767355256a6",
                                "text": "⧖ Wy zynder eens geweest; met Iuda is 't gedaen,\nEn Sions grondvest grynst mismaeckt den Hemel aen:\nDes Heeren heylighdom ach! ach! 't gaetme aen de zinnen,\nTer hellen neergezackt is met zyn hooge tinnen."
                            }
                        ]
                    },
                    {
                        "sense_id": "c3d05ed7-f365-3b71-ac1c-464420d471e1",
                        "entry_id": "8a8acc31-485f-3e76-b74d-1937517ff14a",
                        "glosses": [
                            "onveranderlijk en onmisbaar uitgangspunt voor verdere activiteit, organisatie of redenering"
                        ],
                        "tags": [
                            "figuratively",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "735c3402-62ff-4feb-850a-360284a0f3d3",
                                "sense_id": "c3d05ed7-f365-3b71-ac1c-464420d471e1",
                                "text": "⧖ Een goede Opvoedinge der Kinderen, is de grondvest der Borgerye, en het wel-wesen van Landen en Staaten."
                            }
                        ]
                    }
