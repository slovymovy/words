                "senses": [
                    {
                        "sense_id": "67ffdbf2-9800-306d-b66e-ee891847c183",
                        "entry_id": "4a5682c9-63f3-3659-bc64-478ee0680082",
                        "glosses": [
                            "Therapie, die darauf abzielt, die Atmung der Patienten mit eingeschränkter Lungenfunktion zu verbessern, zu erleichtern oder zu stabilisieren, in dem sie verschiedene Techniken, wie das Training der Atemmuskulatur, Atemübungen zur Förderung der Atmungseffizienz, Inhalationstechniken zur Unterstützung der Atemwege und Maßnahmen zur Sekretentfernung umfasst"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "dcda568c-2147-3784-b5f3-5db35ab4b633",
                        "entry_id": "4a5682c9-63f3-3659-bc64-478ee0680082",
                        "glosses": [
                            "ganzheitliche Praxis, die verschiedene Techniken zur gezielten Beeinflussung der Atmung einsetzt, um die körperliche, geistige und emotionale Gesundheit zu fördern, Blockaden zu lösen und das allgemeine Wohlbefinden zu steigern"
                        ],
                        "tags": [
                            "Alternativmedizin"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
