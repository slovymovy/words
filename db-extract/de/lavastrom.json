                "senses": [
                    {
                        "sense_id": "18bd5557-0e06-302b-bca7-e587ed26847c",
                        "entry_id": "90a3148d-1c1a-3b6d-ba0e-2c60316e6807",
                        "glosses": [
                            "zähfließende Masse aus geschmolzenem Gestein (Lava)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7ea0783-05d3-4300-a040-0e2bace1d794",
                                "sense_id": "18bd5557-0e06-302b-bca7-e587ed26847c",
                                "text": "Lavaströme reißen alles auf ihrem Weg mit sich, wenn sie denn groß genug sind."
                            },
                            {
                                "example_id": "249c6ee2-9755-4313-866e-4af1f9abc8dd",
                                "sense_id": "18bd5557-0e06-302b-bca7-e587ed26847c",
                                "text": "„Der Lavastrom des Ätna ist am Mittwoch unmittelbar vor dem Touristenzentrum Rifugio Sapienza zum Stehen gekommen.“"
                            },
                            {
                                "example_id": "d659ffa0-d285-415f-b0ab-1c99d1872ebf",
                                "sense_id": "18bd5557-0e06-302b-bca7-e587ed26847c",
                                "text": "„Ungefähr 12 Meilen, bis zum Dorfe Nicolosi, steigt man allmählig durch reiche Weinberge und Maulbeerpflanzungen; aber auch diese sind von dem letzten Lavastrom durchbrochen und vielfach zerstört.“"
                            },
                            {
                                "example_id": "5fc98f88-8e0b-4f6f-a56b-0fc56d647bd7",
                                "sense_id": "18bd5557-0e06-302b-bca7-e587ed26847c",
                                "text": "„Nach dieser Seite hin mußte der Vulkan in prähistorischer Zeit auch ausgebrochen sein, die Spuren eines breiten Lavastroms reichten bis zum Haifischmaul im Nordosten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
