                "senses": [
                    {
                        "sense_id": "2d56c7ac-eb97-3490-8284-8319562cac8b",
                        "entry_id": "486a36b7-59a3-385f-a3c9-b9b95fe76433",
                        "glosses": [
                            "Phase, in der jemand oder eine Institution/Organisation auf dem Höhepunkt seiner/ihrer Möglichkeiten war"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81c9c8a9-bb18-48ba-9035-66c4463f7ddf",
                                "sense_id": "2d56c7ac-eb97-3490-8284-8319562cac8b",
                                "text": "„Ihre Glanzzeiten sind vorbei.“"
                            },
                            {
                                "example_id": "3f70c03c-ff9c-401c-9d0c-d02ef8a375b0",
                                "sense_id": "2d56c7ac-eb97-3490-8284-8319562cac8b",
                                "text": "„Zu seiner Glanzzeit 1884/85 zählte Obock rund 2000 Einwohner.“"
                            },
                            {
                                "example_id": "04361fa3-783b-407c-9aa9-2899fbcef123",
                                "sense_id": "2d56c7ac-eb97-3490-8284-8319562cac8b",
                                "text": "„Es war eine Glanzzeit des deutschen Geistes, von den Werken großer Philosophen, Künstler und Naturforscher bis hin zu Erfindungen wie das Auto, Aspirin und die Entdeckung der Röntgenstrahlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
