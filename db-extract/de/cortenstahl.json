                "senses": [
                    {
                        "sense_id": "7f381db8-906e-3258-b8f3-4b7382af02da",
                        "entry_id": "0e0a14cc-35c0-3b16-8a1c-dc6156b7b687",
                        "glosses": [
                            "Stahl, der eine witterungsbeständige Patina bildet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87a31737-a769-4f14-affc-aea844cfb243",
                                "sense_id": "7f381db8-906e-3258-b8f3-4b7382af02da",
                                "text": "„Ein Holzkreuz mit einzelnen Elementen aus Cortenstahl soll bald im neuen Olchinger Parkfriedhof aufgestellt werden.“"
                            },
                            {
                                "example_id": "2ce84f87-d583-4bbe-a2d6-b383b438019f",
                                "sense_id": "7f381db8-906e-3258-b8f3-4b7382af02da",
                                "text": "„Im Falle von Chillida gehört der Rost allerdings zum Material und entsprang einer bewussten Entscheidung des Künstlers. Cortenstahl ist nicht nur durch den Rostbelag sehr wetterfest sondern ein modernes Material, das in der Architektur gerne eingesetzt wird.“"
                            },
                            {
                                "example_id": "783af2d6-682a-4c06-bb6a-df779d56bf27",
                                "sense_id": "7f381db8-906e-3258-b8f3-4b7382af02da",
                                "text": "„Der Schattenriss des ‚Bullen von Tölz‘ aus 10 Millimeter dickem Cortenstahl wird mit einem Unterdruck-Heber aus der Platte gehoben, aus der ihn ein Laser geschnitten hatte.“"
                            },
                            {
                                "example_id": "1ee55250-8c72-4165-8657-629d9cdad1b8",
                                "sense_id": "7f381db8-906e-3258-b8f3-4b7382af02da",
                                "text": "„An der Ostseite des Münzgebäudes werden Außentreppe und Aussichtsplattform aus Cortenstahl angesetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
