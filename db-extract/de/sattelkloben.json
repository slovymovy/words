                "senses": [
                    {
                        "sense_id": "55ce8352-e687-36a2-8033-bfff9cb03e76",
                        "entry_id": "39c64d26-4b8b-3cf2-b7c0-4253a9a07286",
                        "glosses": [
                            "Klemmvorrichtung zur Befestigung des Sattels an der Sattelstütze eines Fahrrades"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "8214a6a6-807b-46fa-9f2f-e46d050f5caa",
                                "sense_id": "55ce8352-e687-36a2-8033-bfff9cb03e76",
                                "text": "Falls der Kloben auf der Sattelstütze verbleiben soll, Sattelschienen oder -drähte aus der Klemmung des Sattelklobens herausnehmen."
                            },
                            {
                                "example_id": "7178c6a5-d60a-4bda-beab-ac571fdee0c0",
                                "sense_id": "55ce8352-e687-36a2-8033-bfff9cb03e76",
                                "text": "Neigungswinkel und Horizontalposition des Sattels lassen sich am Sattelkloben einstellen."
                            },
                            {
                                "example_id": "505896e8-ed17-4bb8-b494-91dbd92e85f3",
                                "sense_id": "55ce8352-e687-36a2-8033-bfff9cb03e76",
                                "text": "Es gibt zwei Typen von Sattelstützen: rohrförmige Modelle mit separatem Sattelkloben und einstellbare Leichtmetallmodelle."
                            },
                            {
                                "example_id": "e1187b6b-a57b-4c98-9080-6b8430e6569e",
                                "sense_id": "55ce8352-e687-36a2-8033-bfff9cb03e76",
                                "text": "Um die Neigung des Sattels und den Abstand des Sattels zum Lenker variieren zu können, muß die Mutter des Sattelklobenbolzens … gelockert, nach der Einstellung dann wieder fest angezogen werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
