                ],
                "senses": [
                    {
                        "sense_id": "18f05462-293f-33cb-bdaa-15aee52b5eba",
                        "entry_id": "8b9e7fb8-2684-3738-81e7-ea95242e0889",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "084235ce-c3b2-405c-ad88-257b510373c8",
                                "sense_id": "18f05462-293f-33cb-bdaa-15aee52b5eba",
                                "text": "Frau Zeitz ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "1440dc63-2ea5-464f-8ab1-edd7b2b17de1",
                                "sense_id": "18f05462-293f-33cb-bdaa-15aee52b5eba",
                                "text": "Herr Zeitz wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ef53623d-108e-4ed8-857d-24db8b876534",
                                "sense_id": "18f05462-293f-33cb-bdaa-15aee52b5eba",
                                "text": "Die Zeitz' fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "31c56f1d-8377-4ae0-b577-09d1adfb4af9",
                                "sense_id": "18f05462-293f-33cb-bdaa-15aee52b5eba",
                                "text": "Der Zeitz trägt nie die Schals, die die Zeitz ihm strickt."
                            },
                            {
                                "example_id": "5f7304ab-aac3-42ee-815c-2602a842d8b8",
                                "sense_id": "18f05462-293f-33cb-bdaa-15aee52b5eba",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Zeitz kommt, geht der Herr Zeitz.“"
                            },
                            {
                                "example_id": "319f024d-3e1a-41ff-9f04-7e4f8348122e",
                                "sense_id": "18f05462-293f-33cb-bdaa-15aee52b5eba",
                                "text": "Zeitz kommt und geht."
                            },
                            {
                                "example_id": "0b0f1a09-4ba6-42bd-bed2-c8d96a8c1874",
                                "sense_id": "18f05462-293f-33cb-bdaa-15aee52b5eba",
                                "text": "Zeitzes kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
