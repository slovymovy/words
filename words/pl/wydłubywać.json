    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "05137451-db60-3c29-8eeb-32e24b4c4163",
                    "sense_definition": "wydobywać coś ze środka za pomocą dłubania, palców lub ostrego narzędzia",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wydobywanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dziecko z uwagą <w>wydłubywało</w> pestki z plasterka cytryny przed wrzuceniem go do herbaty.",
                            "target_lang_translations": {
                                "ru": "Ребёнок внимательно <w>выковыривал</w> косточки из ломтика лимона перед тем, как бросить его в чай."
                            }
                        },
                        {
                            "text": "Przez dłuższą chwilę <w>wydłubywał</w> drobne ziarenka maku spomiędzy zębów.",
                            "target_lang_translations": {
                                "ru": "Он довольно долго <w>выковыривал</w> мелкие маковые зёрнышки из зубов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wydłubywać pestki",
                        "wydłubywać resztki"
                    ],
                    "target_lang_definitions": {
                        "ru": "извлекать что-либо изнутри пальцами, ковырянием или острым предметом"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выковыривать",
                                "target_lang_sense_clarification": "извлекать ковыряя"
                            },
                            {
                                "target_lang_word": "выковыривать пальцем",
                                "target_lang_sense_clarification": "доставать пальцами или ногтями"
                            },
                            {
                                "target_lang_word": "выковыривать острым предметом",
                                "target_lang_sense_clarification": "доставать что-то застрявшее"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3682b1ea-a83b-37e1-9feb-ffb2d69808da",
                    "sense_definition": "usuwać lub uszkadzać coś ostrym narzędziem albo pazurami, zwłaszcza oczy; wyłużać, wykłuwać",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "niszczenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Agresywny ptak zaciekle atakował i niemal <w>wydłubywał</w> oczy swojej ofierze.",
                            "target_lang_translations": {
                                "ru": "Агрессивная птица яростно нападала и чуть ли не <w>выклёвывала</w> глаза своей жертве."
                            }
                        },
                        {
                            "text": "W starych legendach potwory często <w>wydłubywały</w> oczy uwięzionym ludziom.",
                            "target_lang_translations": {
                                "ru": "В старинных легендах чудовища часто <w>выкалывали</w> глаза пленённым людям."
                            }
                        }
                    ],
                    "synonyms": [
                        "wykłuwać",
                        "wyłupiać"
                    ],
                    "common_phrases": [
                        "wydłubywać oczy"
                    ],
                    "target_lang_definitions": {
                        "ru": "выкалывать, вырывать или повреждать острым предметом либо когтями (обычно о глазах)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выклёвывать",
                                "target_lang_sense_clarification": "о птицах, повреждать клювом"
                            },
                            {
                                "target_lang_word": "выкалывать",
                                "target_lang_sense_clarification": "о глазах, острым предметом"
                            },
                            {
                                "target_lang_word": "выцарапывать",
                                "target_lang_sense_clarification": "когтями или ногтями"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}