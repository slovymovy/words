                    {
                        "sense_id": "761d7000-1973-37a8-9b3f-947268cc2de1",
                        "entry_id": "b9036e21-01c8-3cf9-a391-efa0ecb65df1",
                        "glosses": [
                            "Strict adherence to the forms or principles of some church organization; sectarianism."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "bbda7d46-e68f-448b-b93e-12fff9e1904f",
                                "sense_id": "761d7000-1973-37a8-9b3f-947268cc2de1",
                                "text": "The appellant's idea of religion , essentially different from churchism ."
                            },
                            {
                                "example_id": "870038cc-d524-43a4-b46e-4c5cb9dd64b8",
                                "sense_id": "761d7000-1973-37a8-9b3f-947268cc2de1",
                                "text": "This identification of himself with his denomination is the acme of consecration, and this aborption of individual consciousness in the common and larger consciousness of the Church is a sign of efficient churchism, which, well regulated, may contribute to the enlargement of Christ's kingdom."
                            }
                        ]
                    },
                    {
                        "sense_id": "44d180f0-1267-3ddc-b2d5-d97ed9e279c1",
                        "entry_id": "b9036e21-01c8-3cf9-a391-efa0ecb65df1",
                        "glosses": [
                            "A cliché or overused saying uttered in church."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "00d90eb3-96b2-4477-8f6f-8ed5e2af9562",
                                "sense_id": "44d180f0-1267-3ddc-b2d5-d97ed9e279c1",
                                "text": "Christians resort to churchisms such as: “Let go and let God”; “Love the sinner, hate the sin”; “I have Jesus in my heart”; “God said it. I believe it. That settles it!\""
                            },
                            {
                                "example_id": "f7048b5d-c678-422a-b9ab-4fe60ea9f007",
                                "sense_id": "44d180f0-1267-3ddc-b2d5-d97ed9e279c1",
                                "text": "One churchism (a term or phrase that we use in church that has almost become a cliché) that is used when talking about prayer is the phrase \"touch and agree.\""
                            },
                            {
                                "example_id": "2b179bd9-abb3-479d-be16-9880c7ce698f",
                                "sense_id": "44d180f0-1267-3ddc-b2d5-d97ed9e279c1",
                                "text": "Kids kept yelling ingrained churchisms for us to debunk, a la MythBusters: \" God helps those who help themselves! \" \" Cleanliness is next to godliness! \" \"A gate in Jerusalem was named Eye of a Needle, so it's fine to be rich!\""
                            }
                        ]
                    }
