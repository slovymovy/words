                                "target_lang_word": "стучать",
                                "target_lang_sense_clarification": "издавать звук удара"
                            },
                            {
                                "target_lang_word": "ударить",
                                "target_lang_sense_clarification": "нанести удар"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "敲",
                                "target_lang_sense_clarification": "发出声音的动作"
                            },
                            {
                                "target_lang_word": "击打",
                                "target_lang_sense_clarification": "用力敲击"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77debbfb-7847-37e4-881c-49772bc38e48",
                    "sense_definition": "To talk freely and casually with someone.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "talk_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They stayed up all night just <w>rapping</w> about the future.",
                            "target_lang_translations": {
                                "ru": "Они не спали всю ночь, просто <w>болтая</w> о будущем.",
                                "zh": "他们彻夜未眠，只是在<w>闲聊</w>关于未来的事。"
                            }
                        },
                        {
                            "text": "I like to <w>rap</w> with my friends whenever we meet up.",
                            "target_lang_translations": {
                                "ru": "Мне нравится <w>болтать</w> с друзьями, когда мы встречаемся.",
                                "zh": "每次和朋友见面，我都喜欢和他们<w>侃大山</w>。"
                            }
                        }
