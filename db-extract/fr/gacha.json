                                    {
                                        "sense_id": "355641ed-e20c-385d-af5b-3ea1bf42049a",
                                        "entry_id": "43468932-18dd-3c19-9e01-12c4065b6484",
                                        "glosses": [
                                            "A small toy sold in a plastic capsule in a vending machine, especially toys sold in or associated with Japan."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d541351-479e-4b1e-b12c-22435ea4268b",
                                                "sense_id": "355641ed-e20c-385d-af5b-3ea1bf42049a",
                                                "text": "Gacha, from the Japanese word gachapon, refers to capsules sold in vending machines and containing random toys inside"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3162f48-235b-3cb1-a706-3eafd9071a9a",
                                        "entry_id": "43468932-18dd-3c19-9e01-12c4065b6484",
                                        "glosses": [
                                            "The vending machine that sells such toys."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75f0c391-5b76-4fcb-ab03-1d0c3c673b04",
                                                "sense_id": "c3162f48-235b-3cb1-a706-3eafd9071a9a",
                                                "text": "And if you’re looking for something that’s cute, compact, and affordable, you can’t go past the country’s gacha capsule toy vending machines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "608c5e4e-1069-3405-a3ee-96b7b66a7f87",
                                        "entry_id": "43468932-18dd-3c19-9e01-12c4065b6484",
                                        "glosses": [
                                            "A mechanism in certain video games, especially mobile games, whereby in-game items or characters are purchased randomly with real or in-game money."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa0beec8-ec71-41d4-8527-1f863d41ebb3",
                                                "sense_id": "608c5e4e-1069-3405-a3ee-96b7b66a7f87",
                                                "text": "Since a loot table with ten rewards won’t last for long, the very first step in gacha design is to ensure that you have enough content to make gacha a viable monetization strategy."
                                            },
                                            {
                                                "example_id": "3c689ac9-93c6-4c63-bdde-b66c05676c1f",
                                                "sense_id": "608c5e4e-1069-3405-a3ee-96b7b66a7f87",
                                                "text": "Gacha mechanics are a powerful advantage monetization strategy in free-to-play games that have also been integrated into many premium titles on mobile devices, PCs, and consoles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f05629e5-fbac-3d1c-8a4b-f0b921c1c1cc",
                                        "entry_id": "43468932-18dd-3c19-9e01-12c4065b6484",
                                        "glosses": [
                                            "A game which features this mechanic as its central feature."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
