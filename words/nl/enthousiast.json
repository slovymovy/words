        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "90a38b14-1bbe-38a3-a680-316c6da0343b",
                    "sense_definition": "Vol energie, plezier en interesse voor iets; met veel toewijding.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotion_positive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leerlingen waren erg <w>enthousiast</w> over het schoolreisje naar de dierentuin.",
                            "target_lang_translations": {
                                "en": "The students were very <w>enthusiastic</w> about the school trip to the zoo.",
                                "ru": "Ученики были в полном <w>восторге</w> от школьной поездки в зоопарк.",
                                "zh": "学生们对去动物园的学校旅行非常<w>兴奋</w>。"
                            }
                        },
                        {
                            "text": "Zij vertelde <w>enthousiast</w> over haar nieuwe baan in het ziekenhuis.",
                            "target_lang_translations": {
                                "en": "She spoke <w>enthusiastically</w> about her new job at the hospital.",
                                "ru": "Она <w>с энтузиазмом</w> рассказывала о своей новой работе в больнице.",
                                "zh": "她<w>热情</w>地谈起自己在医院的新工作。"
                            }
                        },
                        {
                            "text": "Het publiek reageerde <w>enthousiast</w> toen de band begon te spelen.",
                            "target_lang_translations": {
                                "en": "The audience reacted <w>enthusiastically</w> when the band started playing.",
                                "ru": "Публика отреагировала <w>восторженно</w>, когда группа начала играть.",
                                "zh": "当乐队开始演奏时，观众反应非常<w>热烈</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "geestdriftig",
                        "bevlogen",
                        "gepassioneerd"
                    ],
                    "common_phrases": [
                        "enthousiast zijn over",
                        "razend enthousiast",
                        "enthousiast onthaal",
                        "enthousiast maken"
                    ],
                    "target_lang_definitions": {
                        "en": "Full of energy, pleasure, and interest in something; with great dedication.",
                        "ru": "Полный энергии, радости и интереса к чему-либо; проявляющий большую самоотдачу.",
                        "zh": "对某事充满精力、乐趣和兴趣；充满热情和干劲的。"
                    },
                    "translations": {
