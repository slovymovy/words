                        ],
                        "form": "die Knautschzonen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "38eeb534-7e40-3d68-bcc5-2ec1d1dc1395",
                        "entry_id": "62559ba2-c701-3148-80c8-e61a33460ccc",
                        "glosses": [
                            "Bereich eines Fahrzeugs, der sich im Falle einer Kollision verformt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9437a971-69ac-4739-9ff0-02e8df4d814c",
                                "sense_id": "38eeb534-7e40-3d68-bcc5-2ec1d1dc1395",
                                "text": "Bei dem Autounfall hat sich die Knautschzone stark verformt, aber die Fahrgastzelle blieb intakt."
                            },
                            {
                                "example_id": "d747029f-42b3-4d86-94c6-8bc5c96e819a",
                                "sense_id": "38eeb534-7e40-3d68-bcc5-2ec1d1dc1395",
                                "text": "Bei Motor- und Fahrrädern gibt es keine Knautschzone, man sitzt bei einem Unfall total ungeschützt!"
                            },
                            {
                                "example_id": "1afbb6ac-3639-41ab-87e1-ad86a120fe49",
                                "sense_id": "38eeb534-7e40-3d68-bcc5-2ec1d1dc1395",
                                "text": "„[…] viele Autofahrer [halten] viel zu wenig Abstand bei Fahrrädern oder übersehen Radfahrer beim Abbiegen. Und dann kann es schnell richtig gefährlich werden, weil das Rad weder Airbag noch Knautschzone hat.“"
                            },
                            {
                                "example_id": "ba372135-df92-4f5e-b1c8-3efb3cfa587a",
                                "sense_id": "38eeb534-7e40-3d68-bcc5-2ec1d1dc1395",
                                "text": "„An Knautschzonen dachte [in den 1950ern bei Kabinenrollern von Heinkel, Fend oder der BMW-Isetta] noch niemand.“"
                            },
                            {
                                "example_id": "bc5cc84d-80c5-43b6-9aea-8506ad2c13e3",
                                "sense_id": "38eeb534-7e40-3d68-bcc5-2ec1d1dc1395",
                                "text": "„Das [gebrauchte] Auto ist somit nicht mehr strassentauglich, weil ein Teil der Knautschzone eingedrückt ist.“ [Anmerkung: 'strassentauglich' ist Schweizer Rechtschreibung]"
                            },
                            {
                                "example_id": "e2b0c6d3-7c2f-4c54-90dc-5c055de351c9",
                                "sense_id": "38eeb534-7e40-3d68-bcc5-2ec1d1dc1395",
                                "text": "„Die Knautschzonen großer Autos sollen so konstruiert sein, dass bei einem Unfall mit einem viel kleineren Fahrzeug auch dessen Fahrgastzelle weitgehend unverformt bleibt.“"
                            },
                            {
                                "example_id": "fbb8375d-d34c-4821-99e6-8090990683a1",
                                "sense_id": "38eeb534-7e40-3d68-bcc5-2ec1d1dc1395",
                                "text": "„„Unter einer aktiven Haube versteht man das Anheben der Motorhaube an Fahrzeugen, so dass eine Knautschzone für den Fußgänger geschaffen wird und der Aufprall somit weicher wird für den Fußgänger“, erklärt Bovenkerk.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
