                "senses": [
                    {
                        "sense_id": "b884982c-e65b-39e7-a876-aad3a3700a46",
                        "entry_id": "fa024faa-e4aa-388c-add2-e524fe360694",
                        "glosses": [
                            "Relatif, à la fois, à l'estomac et aux intestins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28ffe1e8-7873-4d71-8540-88f63b2dac9b",
                                "sense_id": "b884982c-e65b-39e7-a876-aad3a3700a46",
                                "text": "Les organes gastro-intestinaux préparent les matériaux de la nutrition et les font pénétrer dans le sang ; les reins en éliminent les parties excrémentitielles, c'est-à-dire les produits qui n'ont pu être assimilés."
                            },
                            {
                                "example_id": "0af23347-1cf9-4421-ac20-b6e2202b0ce1",
                                "sense_id": "b884982c-e65b-39e7-a876-aad3a3700a46",
                                "text": "La triple lauréate du Giro (2018, 2019 et 2022) avait été diminuée en début de semaine par un virus gastro-intestinal."
                            },
                            {
                                "example_id": "f33d14f5-53e2-4e2c-a530-fd4aaf436160",
                                "sense_id": "b884982c-e65b-39e7-a876-aad3a3700a46",
                                "text": "Un comprimé orodispersible se place sur la langue et le principe actif est absorbé au niveau de la muqueuse gastro-intestinale. Il se dissout dans la bouche."
                            }
                        ]
                    }
