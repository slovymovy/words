                "senses": [
                    {
                        "sense_id": "c42916ca-74f4-3298-92bc-914aeb4752dc",
                        "entry_id": "de4ce780-e6c0-3f65-a776-5a5575fe3bdb",
                        "glosses": [
                            "Gars ; mec ; type."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "e0c577db-185d-416c-9c6b-c5b34c759bb0",
                                "sense_id": "c42916ca-74f4-3298-92bc-914aeb4752dc",
                                "text": "Il n'avait pas dû être le seul à se lâcher sur le net. Il avait dû en avoir des bougs comme lui, énervés par le Député-Maire, à cracher leur fiel sur leur mur virtuel..."
                            },
                            {
                                "example_id": "5a2f9994-7ef7-404c-a4a6-8cd568de7516",
                                "sense_id": "c42916ca-74f4-3298-92bc-914aeb4752dc",
                                "text": "Je parle même pas des bougs camouflés en honnêtes travailleurs, et qui zieutent ceux qui ont de la maille en attendant le bon moment. C'est ça qui me vénèr le plus, gros."
                            },
                            {
                                "example_id": "0e71ed52-852f-4514-af2e-864633751ef9",
                                "sense_id": "c42916ca-74f4-3298-92bc-914aeb4752dc",
                                "text": "— Bah, vas-y alors ! En vrai, t'auras qu'à faire le canard et l'appeler Bébé. J'en vois des bougs dans le bus, ils font genre les bonhommes et sur leur iPhone c'est marqué « Bébé » avec l'émoji cœur, tu connais ?"
                            },
                            {
                                "example_id": "b281a125-e7fc-4fcb-8d20-329577640f35",
                                "sense_id": "c42916ca-74f4-3298-92bc-914aeb4752dc",
                                "text": "On compte sur lui hein, le boug a fait ses preuves, et on souhaite donc aux Spurs d’apprécier les Playoffs à la télé, Top 3 des phrases les plus inattendues de l’année."
                            }
                        ]
                    }
                ],
