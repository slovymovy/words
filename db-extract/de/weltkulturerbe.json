                    {
                        "form_id": "bc91cc5e-b574-4c59-9fba-933ec167e056",
                        "entry_id": "b55e38e2-8b84-321c-ab8e-d849cec427bb",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Weltkulturerbe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "81344dec-cb28-3164-979d-5c34658189b8",
                        "entry_id": "b55e38e2-8b84-321c-ab8e-d849cec427bb",
                        "glosses": [
                            "von der UNESCO als für die Menschheit besonders wertvolles und zu schützend eingestuftes Kulturgut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0ae73cd-a1a8-4f35-9d82-2ce5118a4f04",
                                "sense_id": "81344dec-cb28-3164-979d-5c34658189b8",
                                "text": "Wie in Wien sind auch in Köln Teile des Stadtzentrums als Weltkulturerbe deklariert."
                            },
                            {
                                "example_id": "c09f243c-b083-4699-9d0d-8fc3eaea499b",
                                "sense_id": "81344dec-cb28-3164-979d-5c34658189b8",
                                "text": "„Die Untersuchung zeigte aber auch, dass das von der Unesco als Weltkulturerbe geführte Bauwerk an vielen Stellen von Verfall und Zerstörung bedroht ist.“"
                            },
                            {
                                "example_id": "00866ef2-ef7b-403b-89cb-63b663dd242b",
                                "sense_id": "81344dec-cb28-3164-979d-5c34658189b8",
                                "text": "In Timbuktu in Mali haben Islamisten mit der Zerstörung der zum Weltkulturerbe gehörenden antiken Mausoleen begonnen."
                            },
                            {
                                "example_id": "7ee890b9-78a2-420a-a04a-06251832591b",
                                "sense_id": "81344dec-cb28-3164-979d-5c34658189b8",
                                "text": "„Zu Recht wurde diese kunstvoll vom Menschen gestaltete Landschaftseinheit zwischen Bingen und Koblenz von der UNESCO als Weltkulturerbe anerkannt.“"
                            },
                            {
                                "example_id": "4bedf28d-20e4-45c8-9f8e-b717eeb6ce0b",
                                "sense_id": "81344dec-cb28-3164-979d-5c34658189b8",
                                "text": "„Am 10. März 2001 zerstörten die Bilderstürmer der Taliban das Weltkulturerbe der Statuen von Bamyan.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
