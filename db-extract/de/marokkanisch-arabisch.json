                "senses": [
                    {
                        "sense_id": "76aaef20-e603-35da-ae06-889fedfc5b75",
                        "entry_id": "7ceb951d-d26d-3f09-befe-4c4a47cbea56",
                        "glosses": [
                            "die in Marokko gesprochene Form (teilweise als Dialekt bezeichnet) des Arabischen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef1799eb-d486-4b39-8880-5421d5c5e59d",
                                "sense_id": "76aaef20-e603-35da-ae06-889fedfc5b75",
                                "text": "„Wer schon Arabisch lesen kann: Das geschriebene Marokkanisch-Arabisch hat einen Zusatzbuchstaben, ›kaf‹ mit drei Punkten oben, das in der Transliteration als ‚g‘ auftaucht.“"
                            },
                            {
                                "example_id": "4e461b80-164e-44ff-8848-d61851abad26",
                                "sense_id": "76aaef20-e603-35da-ae06-889fedfc5b75",
                                "text": "„Das hängt wohl auch damit zusammen, daß der Übergang zwischen Ägyptisch-Arabisch und Hocharabisch fließender ist, als der zwischen Marokkanisch-Arabisch und Hocharabisch.“"
                            },
                            {
                                "example_id": "1083ef38-4c0d-40d1-80ad-cb183ff1ca99",
                                "sense_id": "76aaef20-e603-35da-ae06-889fedfc5b75",
                                "text": "„Umgangssprachen sind Marokkanisch-Arabisch (Darija) und Französisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
