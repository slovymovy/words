                    "frequency": "Middle",
                    "semantic_group_id": "oplossing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De regering had nog geen goed <w>antwoord</w> op dit complexe probleem kunnen vinden.",
                            "target_lang_translations": {
                                "en": "The government had not yet been able to find a good <w>answer</w> to this complex problem."
                            }
                        },
                        {
                            "text": "Dit nieuwe beleid is een <w>antwoord</w> op de groeiende ongelijkheid in de stad.",
                            "target_lang_translations": {
