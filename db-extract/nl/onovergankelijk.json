                "senses": [
                    {
                        "sense_id": "711784db-64f3-3f38-9d6d-4e34fdc6e6a8",
                        "entry_id": "de11a403-8eb0-371b-a896-38796860c78c",
                        "glosses": [
                            "zonder lijdend voorwerp waarop de werking van het werkwoord overgedragen wordt"
                        ],
                        "tags": [
                            "van een werkwoord"
                        ],
                        "examples": [
                            {
                                "example_id": "7fa784df-815a-4637-97a6-92f85645b9a5",
                                "sense_id": "711784db-64f3-3f38-9d6d-4e34fdc6e6a8",
                                "text": "Normaal gesproken neemt een onovergankelijk werkwoord een onderwerp, een overgankelijk werkwoord een onderwerp en een lijdend voorwerp, en er zijn ook werkwoorden zoals wachten die naast een onderwerp een voorzetselvoorwerp nemen."
                            }
                        ]
                    },
                    {
                        "sense_id": "e0dae94f-5dcb-302d-a264-7a4bccdd3f9e",
                        "entry_id": "de11a403-8eb0-371b-a896-38796860c78c",
                        "glosses": [
                            "niet voorbij gaand, niet te overschrijden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "215decda-a25f-48f6-b337-ee286ebec229",
                                "sense_id": "e0dae94f-5dcb-302d-a264-7a4bccdd3f9e",
                                "text": "Waarschijnlijk is de NPD naar haar uiterlijke verschijningsvorm een fascistische partij, dat wil zeggen een partij die in haar uitlatingen die elementen vertoont die tezamen „racisme\" betekenen: het leggen van een geëxalteerde nadruk op de staat en haar symbolen, op recht en orde die met alle macht moeten worden gehandhaafd, en op een grootvaderlijk verleden als onovergankelijk patroon voor de toekomst."
                            },
                            {
                                "example_id": "398c2c98-ebe6-431d-95ee-0bed23bdb850",
                                "sense_id": "e0dae94f-5dcb-302d-a264-7a4bccdd3f9e",
                                "text": "(…) zoohaast zij rond hare bevestigingen eenen kring durft teekenen, als onovergankelijke grens voor het vrij onderzoek, zij blijft te kort aan de eerste voorwaarde van alle ernstige kritiek..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "19e86976-4543-4b6e-945d-d6697a4b40d5",
                        "source_entry_id": "de11a403-8eb0-371b-a896-38796860c78c",
                        "source_sense_id": "711784db-64f3-3f38-9d6d-4e34fdc6e6a8",
                        "source_sense_description": "(van een werkwoord) zonder lijdend voorwerp waarop de werking van het werkwoord overgedragen wordt",
                        "target_lang_word": "intransitiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intransitiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81389146-d798-3359-88a5-47640b60396c",
                                        "entry_id": "e843c174-9be5-3ef1-b567-c53c0490540d",
                                        "glosses": [
                                            "als Verb kein Akkusativobjekt benötigend und unfähig zum persönlichen Passiv"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "331a8e9a-4b7b-46a1-9a30-888b64be44b7",
                                                "sense_id": "81389146-d798-3359-88a5-47640b60396c",
                                                "text": "Das Wort „beginnen“ kann kontextabhängig sowohl intransitiv als auch transitiv verwendet werden."
                                            },
                                            {
                                                "example_id": "adf25f3c-d1fb-4e08-a252-ccd182d7786d",
                                                "sense_id": "81389146-d798-3359-88a5-47640b60396c",
                                                "text": "Das Verb „rasen“ ist nur intransitiv, weil die Aussage „jemand oder etwas wurde gerast“ keine sinnvolle Passivbildung darstellt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6a010ce3-1405-341e-addc-8ecad1138fb1",
                                        "entry_id": "e843c174-9be5-3ef1-b567-c53c0490540d",
                                        "glosses": [
                                            "aus der Gültigkeit einer Relation zwischen zwei beliebigen Elementen a und b einer Menge und der Gültigkeit dieser Relation für das gleiche Element b und ein drittes Element c nicht unbedingt die Gültigkeit für a und c begründend"
                                        ],
                                        "tags": [
                                            "Mengenlehre"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fc9e4c5-7372-4516-af62-c8ab0bc5e507",
                                                "sense_id": "6a010ce3-1405-341e-addc-8ecad1138fb1",
                                                "text": "„In gerader Linie verwandt sein“ ist keine transitive, sondern eine intransitive Relation. Söhne sind mit ihrem Vater immer in gerader Linie verwandt, ebenso der Vater mit seinen Söhnen, aber die Söhne untereinander sind es nicht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5108ccdc-84ce-48ce-a2f1-cf0f29bf933c",
                        "source_entry_id": "de11a403-8eb0-371b-a896-38796860c78c",
                        "source_sense_id": "711784db-64f3-3f38-9d6d-4e34fdc6e6a8",
                        "source_sense_description": "(van een werkwoord) zonder lijdend voorwerp waarop de werking van het werkwoord overgedragen wordt",
                        "target_lang_word": "intransitive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intransitive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "18516d14-8f02-37c7-8636-639b356149ba",
                                        "entry_id": "316ae0c5-ad29-3253-994a-6abcae4ef74e",
                                        "glosses": [
                                            "An intransitive verb."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8af78d2e-dcf1-4142-95bc-c7ef62d4da79",
                                                "sense_id": "18516d14-8f02-37c7-8636-639b356149ba",
                                                "text": "This means that subcategorization properties do not allow us to distinguish between transitives and intransitives (both types of verbs are allowed, but not obliged, to take a direct object)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "intransitive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b957d122-d540-3d03-9c14-04a49ec237c9",
                                        "entry_id": "833b2721-7093-309a-b6a5-0c11f01a9bb0",
                                        "glosses": [
                                            "Not transitive: not having, or not taking, a direct object."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91f9fee4-c8a1-4916-9643-1aebb433f49e",
                                                "sense_id": "b957d122-d540-3d03-9c14-04a49ec237c9",
                                                "text": "The word \"drink\" is a transitive verb in \"they drink wine\", but an intransitive one in \"they drink often.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20d0db14-516f-373f-aece-02810c6f9971",
                                        "entry_id": "833b2721-7093-309a-b6a5-0c11f01a9bb0",
                                        "glosses": [
                                            "Not transitive or passing further; kept; detained."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d60aed16-c268-4879-8fd8-ee3e702a8777",
                                                "sense_id": "20d0db14-516f-373f-aece-02810c6f9971",
                                                "text": "1664-1667, Jeremy Taylor, Dissuasive from Popery\nAnd then it is for the image's sake and so far is intransitive; but whatever is paid more to the image is transitive and passes further."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "885177b5-f292-305e-ac04-bc167557b3ba",
                                        "entry_id": "833b2721-7093-309a-b6a5-0c11f01a9bb0",
                                        "glosses": [
                                            "Of a set of dice: containing three dice A, B, and C, with the property that A rolls higher than B more than half the time, and B rolls higher than C more than half the time, but lacking the property that A rolls higher than C more than half the time. See intransitive dice and intransitive game."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "776e807d-d62f-4b61-ae6f-d18ef6b247cd",
                        "source_entry_id": "de11a403-8eb0-371b-a896-38796860c78c",
                        "source_sense_id": "711784db-64f3-3f38-9d6d-4e34fdc6e6a8",
                        "source_sense_description": "(van een werkwoord) zonder lijdend voorwerp waarop de werking van het werkwoord overgedragen wordt",
                        "target_lang_word": "intransitif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intransitif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ba6ad586-8f63-3ff7-bb66-c17bc62ff6ba",
                                        "entry_id": "9ed791b9-f511-3dad-bf81-d835cab78e71",
                                        "glosses": [
                                            "(sens grammatical discuté) Qualifie un verbe, ou l’emploi d’un verbe, qui n’accepte pas de complément d’objet direct."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a0b0d83-ea77-4d50-80ef-071c5c90fc19",
                                                "sense_id": "ba6ad586-8f63-3ff7-bb66-c17bc62ff6ba",
                                                "text": "Le verbe rester est intransitif."
                                            },
                                            {
                                                "example_id": "ff18f96e-761a-49af-9d9e-b1e794d963bb",
                                                "sense_id": "ba6ad586-8f63-3ff7-bb66-c17bc62ff6ba",
                                                "text": "Verbe non susceptible de recevoir un régime direct, et dont on peut dire qu'il ne comporte pas le passage immédiat de l'énoncé de l'action à celui de l'objet : par rapport à dire, transitif dans : dire quelque chose, parler est intransitif dans : parler de quelque chose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f44263e6-f220-3d7c-a91d-5cacf058066b",
                                        "entry_id": "9ed791b9-f511-3dad-bf81-d835cab78e71",
                                        "glosses": [
                                            "Qualifie un verbe qui ne régit aucun complément, dont la valence n'implique que le sujet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8efe9e06-d7fc-4df4-8f60-9ee433619c34",
                                                "sense_id": "f44263e6-f220-3d7c-a91d-5cacf058066b",
                                                "text": "Les verbes intransitifs sont ceux qui s'emploient tout seuls, sans aucun complément sélectionné par le verbe et normalement attendu."
                                            },
                                            {
                                                "example_id": "772ae9a4-b174-4050-ba54-5b771557b0ab",
                                                "sense_id": "f44263e6-f220-3d7c-a91d-5cacf058066b",
                                                "text": "La prédication peut être soit intransitive (Marie chante), soit transitive (Paul abat un arbre)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ab6628b-e743-3265-94ca-44333129acb6",
                                        "entry_id": "9ed791b9-f511-3dad-bf81-d835cab78e71",
                                        "glosses": [
                                            "Dans les langues inuites et yupikes, se dit d’un verbe dont la conjugaison utilise des désinences n’impliquant que le sujet (uniactancielles), le verbe en question pouvant très bien accepter un complément d’objet direct."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8ee77fb1-c8da-311e-928f-f9ff8faffc4a",
                                        "entry_id": "9ed791b9-f511-3dad-bf81-d835cab78e71",
                                        "glosses": [
                                            "Se dit d’une relation R telle que : si (x R y) et si (y R z), alors (x R z) est obligatoirement faux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "220fc983-25bf-48df-bb5b-472d8e552fee",
                                                "sense_id": "8ee77fb1-c8da-311e-928f-f9ff8faffc4a",
                                                "text": "La relation \"est le père de\" est intransitive : si x \"est le père de\" y, et que y \"est le père de\" z, et que x \"est différent de\" y, alors x N’\"est PAS le père de\" z."
                                            },
                                            {
                                                "example_id": "0d955f07-2080-44dd-91cb-67c9d74091dd",
                                                "sense_id": "8ee77fb1-c8da-311e-928f-f9ff8faffc4a",
                                                "text": "Une relation intransitive est forcément irréflexive."
                                            },
                                            {
                                                "example_id": "f1102354-0a30-4b83-a4d2-6ef4b8d627e3",
                                                "sense_id": "8ee77fb1-c8da-311e-928f-f9ff8faffc4a",
                                                "text": "Ne pas confondre intransitif et non-transitif."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
