                                        "sense_id": "5da28e01-cf58-34e1-b5fe-6031a5f00563",
                                        "entry_id": "02a87e9c-e8be-3db3-b3e3-6509704943d5",
                                        "glosses": [
                                            "Designating, or situated in, the liturgical east."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c5cb28b-cc57-4988-8a83-501c6ca22714",
                                                "sense_id": "5da28e01-cf58-34e1-b5fe-6031a5f00563",
                                                "text": "the east front of a cathedral"
                                            },
                                            {
                                                "example_id": "7fc75909-8af2-4c0e-b2d4-1287edf0f77b",
                                                "sense_id": "5da28e01-cf58-34e1-b5fe-6031a5f00563",
                                                "text": "Throughout the book I refer directionally to the altar and chancel of St. Andrew's as situated at ecclesiastical east (to avoid overcomplicating matters), not geographical or magnetic southeast. Thus, the altar is located at the east end of the church, and the gallery, at the west."
                                            },
                                            {
                                                "example_id": "0f0cbe82-102f-4c7b-be07-2b9a1b5fe107",
                                                "sense_id": "5da28e01-cf58-34e1-b5fe-6031a5f00563",
                                                "text": "The tapestry by Graham Sutherland that occupies the whole wall of the liturgical east and geographic north of the cathedral is recognisable […] a huge image of Christ on the [liturgical] east end, filling the entire wall and to be visible through the [liturgical] West Window (Fig. 24.2)."
                                            }
                                        ]
                                    }
