                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nail",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cartwright <w>clouted</w> the wagon wheel axle before the long journey.",
                            "target_lang_translations": {
                                "zh": "在踏上长途旅程之前，造车匠给货车的轮轴<w>包铁皮</w>以作保护。"
                            }
