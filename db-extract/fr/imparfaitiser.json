                "senses": [
                    {
                        "sense_id": "8fa9c41d-3406-3535-bb13-b714cdaa81d3",
                        "entry_id": "d6fa30ad-7556-31b9-a11f-ed1e79a5e9fb",
                        "glosses": [
                            "Donner un caractère imparfait à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c79a87eb-602f-4159-a813-02d8f42db731",
                                "sense_id": "8fa9c41d-3406-3535-bb13-b714cdaa81d3",
                                "text": "Tout le travail est donc de parfaire l'imparfait, de parfaire le parfait qui n'est pas aussi parfait qu'on le prétend, et ce, bien entendu, sans imparfaitiser le parfait ou rendre perfectible ce qui ne peut l’être ou qui l’est déjà, sans l’etre autrement plus !"
                            },
                            {
                                "example_id": "4aca1c5c-67f9-4655-bd49-d237220c9286",
                                "sense_id": "8fa9c41d-3406-3535-bb13-b714cdaa81d3",
                                "text": "bah comme je ne peux plus regarder depuis un bout de temps je ne sais pas s'ils se sont imparfaitisés"
                            }
                        ]
                    },
                    {
                        "sense_id": "096d3ff1-1cf4-3f9e-b6ef-15bc9fee9d71",
                        "entry_id": "d6fa30ad-7556-31b9-a11f-ed1e79a5e9fb",
                        "glosses": [
                            "Mettre au temps de l’imparfait."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ae68c29-3c25-4dc5-9577-4dd7541e25cd",
                                "sense_id": "096d3ff1-1cf4-3f9e-b6ef-15bc9fee9d71",
                                "text": "L’exercice 6 évalue une technique (celle qui consiste à « imparfaitiser » les verbes à l’indicatif et à transformer quelques pronoms personnels) totalement indépendante du degré de compréhension du contexte et du sens des phrases ainsi transformées."
                            }
                        ]
