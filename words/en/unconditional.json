    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d604e967-f2f3-38bf-a611-bde263a24c17",
                    "sense_definition": "Absolute; without conditions, limitations, reservations or qualifications.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "absolute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The army demanded the <w>unconditional</w> surrender of the enemy forces.",
                            "target_lang_translations": {
                                "ru": "Армия потребовала <w>безоговорочной</w> капитуляции вражеских сил."
                            }
                        },
                        {
                            "text": "She offered her <w>unconditional</w> support to her friend during the difficult time.",
                            "target_lang_translations": {
                                "ru": "Она предложила свою <w>безусловную</w> поддержку подруге в трудное время."
                            }
                        }
                    ],
                    "synonyms": [
                        "absolute",
                        "categorical"
                    ],
                    "antonyms": [
                        "conditional"
                    ],
                    "common_phrases": [
                        "unconditional surrender",
                        "unconditional support",
                        "unconditional love"
                    ],
                    "target_lang_definitions": {
                        "ru": "Абсолютный; не имеющий условий, ограничений, оговорок или квалификаций."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безусловный",
                                "target_lang_sense_clarification": "не требующий условий, абсолютный"
                            },
                            {
                                "target_lang_word": "безоговорочный",
                                "target_lang_sense_clarification": "не допускающий возражений или условий"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2e46a7b7-6a95-356e-9489-670c6c70b856",
                    "sense_definition": "That which is not conditional.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "absolute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Philosophers often debate the nature of <w>unconditionals</w> in metaphysical systems.",
                            "target_lang_translations": {
                                "ru": "Философы часто спорят о природе <w>безусловного</w> в метафизических системах."
                            }
                        },
                        {
                            "text": "The concept of <w>unconditionals</w> implies a truth that exists independently of any context.",
                            "target_lang_translations": {
                                "ru": "Концепция <w>безусловного</w> подразумевает истину, существующую независимо от любого контекста."
                            }
                        }
                    ],
                    "synonyms": [
                        "absolute"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что не является условным; нечто абсолютное."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безусловное",
                                "target_lang_sense_clarification": "философское понятие абсолюта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26e230ba-5e13-3e5b-9f29-e0e748919573",
                    "sense_definition": "A linguistic structure expressing that a result holds true regardless of the antecedent.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In linguistics, <w>unconditionals</w> are often analyzed for their unique logical properties.",
                            "target_lang_translations": {
                                "ru": "В лингвистике <w>безусловные предложения</w> часто анализируются на предмет их уникальных логических свойств."
                            }
                        },
                        {
                            "text": "The sentence structure used here is a classic example of <w>unconditionals</w> in English grammar.",
                            "target_lang_translations": {
                                "ru": "Использованная здесь структура предложения — классический пример <w>безусловного предложения</w> в английской грамматике."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лингвистическая структура, выражающая истинность результата независимо от условия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безусловное предложение",
                                "target_lang_sense_clarification": "лингвистический термин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}