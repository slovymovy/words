                        "target_lang_word": "terres agricoles",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d6ac9f6f-e9ab-4bfd-806e-6d28b7f78895",
                        "source_entry_id": "eaec8312-d9eb-30f2-b308-3b4529a3d2e1",
                        "source_sense_id": "cbac4606-77fa-306c-9106-2872f7057a37",
                        "source_sense_description": "land which is suitable for farming and agricultural production",
                        "target_lang_word": "Ackerland",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ackerland",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bab3373d-d815-3ade-a2f9-ded03a297699",
                                        "entry_id": "cf63c0a6-11d9-3e16-9d1a-53342ac6b09f",
                                        "glosses": [
                                            "landwirtschaftlich nutzbarer Boden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adbcbacf-e509-4931-8c87-0c169cd29077",
                                                "sense_id": "bab3373d-d815-3ade-a2f9-ded03a297699",
                                                "text": "Um die Dörfer herum ist viel Ackerland."
                                            },
                                            {
                                                "example_id": "d1e081f0-0b6c-48e5-84b8-8c6d29da7db8",
                                                "sense_id": "bab3373d-d815-3ade-a2f9-ded03a297699",
                                                "text": "„Die Kulturlandschaft ist eindeutig vom Ackerland dominiert und unterscheidet sich damit deutlich von den stark bewaldeten Mittelgebirgsregionen.“"
                                            },
                                            {
                                                "example_id": "490ce03d-3a91-4669-8607-df2f85c8c3ba",
                                                "sense_id": "bab3373d-d815-3ade-a2f9-ded03a297699",
                                                "text": "„Die Kelten siedelten dort, wo es fruchtbares Ackerland gab.“"
                                            },
                                            {
                                                "example_id": "c0a360b7-ce98-4247-99ef-4e793126e584",
                                                "sense_id": "bab3373d-d815-3ade-a2f9-ded03a297699",
                                                "text": "„Er besprühe das Ackerland mit krebserregenden Pflanzenschutzmitteln, imprägniere die Saat bereits vorab mit Insektengift, und was dann noch an Bestäubern überlebe, werde von ihm mit Giften vollends niedergemacht.“"
                                            },
                                            {
                                                "example_id": "11845c94-fbdf-443f-8518-9804966d68ba",
                                                "sense_id": "bab3373d-d815-3ade-a2f9-ded03a297699",
                                                "text": "„Immer mehr zusätzliches Ackerland wird für den Anbau von Tierfutter für die wachsende Fleischproduktion gebraucht. Humusreiche Feuchtgebiete und Moore werden dafür trockengelegt, Grünland in Ackerland umgewandelt und immer mehr Wälder durch Brandrodung urbar gemacht.“"
                                            },
                                            {
                                                "example_id": "8b3ebf0b-8c43-43f2-b8e3-a4a0f75aa5c8",
                                                "sense_id": "bab3373d-d815-3ade-a2f9-ded03a297699",
                                                "text": "„Der Sonderbericht des Weltklimarats (IPCC) zur Landnutzung und Ernährungssicherheit empfiehlt, Weideflächen und Ackerland weltweit zu reduzieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
