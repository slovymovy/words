                "senses": [
                    {
                        "sense_id": "93684bba-9528-3e0c-8ba1-727bf5a0d8be",
                        "entry_id": "763a4417-62f0-3b86-a740-14d2feb718c3",
                        "glosses": [
                            "jenes Teilgebiet der Archäologie, das sich mit der Bergung und Auswertung menschlicher Kulturgegenstände beschäftigt, die sich aktuell unter Wasser (meist unter der Meeresoberfläche) befinden"
                        ],
                        "tags": [
                            "Archäologie"
                        ],
                        "examples": [
                            {
                                "example_id": "2fc92317-ec83-420a-b8d8-9166cb338cef",
                                "sense_id": "93684bba-9528-3e0c-8ba1-727bf5a0d8be",
                                "text": "„Unterwasserarchäologie erfordert den Einsatz modernster Computertechnik.“"
                            },
                            {
                                "example_id": "37d73f48-6de2-4c9e-830d-1ac8cc04744c",
                                "sense_id": "93684bba-9528-3e0c-8ba1-727bf5a0d8be",
                                "text": "„Vor der Wiedervereinigung gab es kaum Untersuchungen hier, weil Taucher als potenzielle Republikflüchtlinge galten. Nun ist Eile geboten, denn fast zur selben Zeit, in der die Unterwasserarchäologie in der ehemaligen DDR in Schwung kam, begann sich der Schiffsbohrwurm in der Ostsee auszubreiten. Das zu den Muscheln zählende Tier bohrt sich ins Holz und zersetzt es.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
