                "senses": [
                    {
                        "sense_id": "c38b2077-6452-3a4b-8bdc-ae290bdb1e98",
                        "entry_id": "f0f39fb1-f63f-32db-9f7c-5d157ed92a8b",
                        "glosses": [
                            "高加索山脈，東歐的山脈，位於黑海與裏海之間，橫跨俄羅斯、格鲁吉亚（喬治亞）、亞美尼亞和阿塞拜疆（亞塞拜然）的領土，包括大高加索山脈和小高加索山脈。"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "500d915b-9b1f-4028-9047-c2181e5159bf",
                                "sense_id": "c38b2077-6452-3a4b-8bdc-ae290bdb1e98",
                                "text": "[…] from the long and rugged ravines of the Caucasus, […]",
                                "translation": "[…] 来自高加索山漫长而崎岖的峡谷， […]"
                            },
                            {
                                "example_id": "c19ce76a-0e83-4696-8d73-b2686996c814",
                                "sense_id": "c38b2077-6452-3a4b-8bdc-ae290bdb1e98",
                                "text": "Driven with that weak blast which Winter leaves, / Closing his palace gates on Caucasus, / […]",
                                "translation": "冬天留下的微弱寒风吹拂着，/关闭了高加索山宫殿的大门， […]"
                            },
                            {
                                "example_id": "ff18d951-00ce-474a-a623-785a79b93174",
                                "sense_id": "c38b2077-6452-3a4b-8bdc-ae290bdb1e98",
                                "text": "Germany, Italy, Spain and Belgium writhed in the throes of Anarchy, while Russia, watching from the Caucasus, stooped and bound them one by one.",
                                "translation": "德国、意大利、西班牙和比利时在无政府状态中痛苦挣扎，而远在高加索山注视着的俄罗斯则俯下身来，将他们一个个束缚住。"
                            }
                        ]
                    },
