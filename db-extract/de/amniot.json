                "translations": [
                    {
                        "translation_id": "e87b0452-5fe0-495f-a1ff-cbf7cce8ada2",
                        "source_entry_id": "bd069622-de52-3eb7-876f-f136c15c12c2",
                        "source_sense_id": "0a226049-3014-307f-9e51-2600fefc4e22",
                        "source_sense_description": "höheres Wirbeltier, das in seiner Embryonalphase ein Amnion ausbildet",
                        "target_lang_word": "amniote",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amniote",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30315cd1-a587-381b-a518-d596afbec069",
                                        "entry_id": "0daeebc1-8a74-35fa-9c27-4cddf3c428dd",
                                        "glosses": [
                                            "Any of the Amniota group of vertebrates having an amnion during the development of the embryo; mammals, birds and reptiles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "361d7ccf-58e9-47ed-b46d-3c5c185668e5",
                                                "sense_id": "30315cd1-a587-381b-a518-d596afbec069",
                                                "text": "Natural selection responded accordingly and the ultimate result was not just the evolution of more amphibians but ultimately of creatures no longer dependent on an aquatic habitat for reproduction, the so-called amniotes – the animals we know today as reptiles, birds and mammals."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "504b1b08-bc75-4070-9af6-30dcda44685d",
                        "source_entry_id": "bd069622-de52-3eb7-876f-f136c15c12c2",
                        "source_sense_id": "0a226049-3014-307f-9e51-2600fefc4e22",
                        "source_sense_description": "höheres Wirbeltier, das in seiner Embryonalphase ein Amnion ausbildet",
                        "target_lang_word": "amniote",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amniote",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d2671ebd-fb61-367a-b34c-56a858a03116",
                                        "entry_id": "22aebddf-68df-37e9-9eaf-521e4cc18f07",
                                        "glosses": [
                                            "Se dit d’un animal (vertébré tétrapode) dont l’embryon et le fœtus sont protégés par un amnios et une allantoïde."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6245d664-140c-47b3-91d5-c247af557193",
                                                "sense_id": "d2671ebd-fb61-367a-b34c-56a858a03116",
                                                "text": "Les reptiles, les oiseaux et les mammifères sont des vertébrés amniotes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "amniote",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "07851539-d7ce-3cb0-889e-117b34195a1a",
                                        "entry_id": "542e4cb6-e5d4-3471-8884-28a4dd2936ca",
                                        "glosses": [
                                            "Animal (vertébré tétrapode) dont l’embryon et le fœtus sont protégés par un amnios et une allantoïde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ad55267-ea78-47b1-ae37-c3d0f4a5db77",
                                                "sense_id": "07851539-d7ce-3cb0-889e-117b34195a1a",
                                                "text": "Ainsi, chez les amniotes, la colonne vertébrale est une structure osseuse clairement segmentée, et les gènes Hox jouent un rôle essentiel dans le contrôle génétique de l’identité des vertèbres, cervicales, thoraciques, lombaires ou sacrées, qui la composent."
                                            }
                                        ]
                                    }
                                ]
                            }
