                        "glosses": [
                            "Ferrailler à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d86952d-2e3f-4f53-8dba-101b701dcd3b",
                                "sense_id": "1219135a-ed47-3a37-aa66-b94d835c9811",
                                "text": "L’opération consiste à dégager le béton tout autour des torons en créant une ouverture sur l’épaisseur de la dalle et sur une certaine longueur suivant le tracé des torons, à raccorder les torons à l’aide de coupleurs et d’ancrages intermédiaires, à retendre les torons à partir des ancrages intermédiaires, à referrailler l’ouverture en scellant dans le béton de nouvelles armatures passives et à fermer l’ouverture à l’aide d’un mortier haute résistance à retrait compensé."
                            }
                        ]
                    }
