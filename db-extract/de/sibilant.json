                                "target_senses": [
                                    {
                                        "sense_id": "d80d569f-c51b-3eee-b925-fd62c5d8f94a",
                                        "entry_id": "191db0cb-47d5-3e3d-a223-b42469ed7b9f",
                                        "glosses": [
                                            "Characterized by a hissing or hushing sound such as the s or sh in sack or shack."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38bacdb6-4259-4f6f-a0ad-459f5099cb49",
                                                "sense_id": "d80d569f-c51b-3eee-b925-fd62c5d8f94a",
                                                "text": "She had a curious habit of prefacing everything she said with a soft sibilant sound.\n\"S-s-s Grace,\" she said, \"it's just like I was telling Brother Hutson the other day. 'S-s-s Brother Hutson,' I said, 'looks like we're fighting a losing battle, a losing battle.' I said.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sibilant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91844d74-2da2-3467-acef-0f8d02523169",
                                        "entry_id": "c59ad7ef-84e4-3f94-b58d-51ee29498419",
                                        "glosses": [
                                            "A consonant having a hissing or hushing sound such as the s or sh in sack or shack."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16a66720-bc23-4877-86f6-452f5048f3d9",
                                                "sense_id": "91844d74-2da2-3467-acef-0f8d02523169",
                                                "text": "Groove fricatives all have more or less of an [s]-like quality, and are for this reason sometimes called sibilants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
