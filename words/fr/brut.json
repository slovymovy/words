            "senses": [
                {
                    "sense_id": "c276adfb-f8c8-360b-8c55-75fc6d7f243b",
                    "sense_definition": "Qui n'a subi aucune déduction de cotisations, de charges ou d'impôts.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son salaire <w>brut</w> est attractif, mais les cotisations sociales diminuent nettement le montant net."
                        },
                        {
                            "text": "L'employeur lui a proposé un revenu annuel <w>brut</w> supérieur à ses attentes."
