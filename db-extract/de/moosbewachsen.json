                ],
                "senses": [
                    {
                        "sense_id": "3d3e63bf-d375-3f46-a029-5aec6ee51d64",
                        "entry_id": "d50ddcc9-9f46-3420-abbb-7dc8fa7b2582",
                        "glosses": [
                            "Moos als Bewuchs aufweisend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddf38070-3276-4644-8246-4b825c707f7b",
                                "sense_id": "3d3e63bf-d375-3f46-a029-5aec6ee51d64",
                                "text": "„Der moosbewachsene Triumphbogen [Gateway of India] der Engländer ist das Wahrzeichen Mumbais und steht wie ein vergessenes Filmrequisit im Monsunregen.“"
                            },
                            {
                                "example_id": "30f186c4-10ae-431a-b626-96e01e89c564",
                                "sense_id": "3d3e63bf-d375-3f46-a029-5aec6ee51d64",
                                "text": "„Die Zerstörung der moosbewachsenen Moorlandschaften wird […] kaum zur Kenntnis genommen.“"
                            },
                            {
                                "example_id": "8d685a3d-61ef-42cb-adeb-781def38a1e1",
                                "sense_id": "3d3e63bf-d375-3f46-a029-5aec6ee51d64",
                                "text": "„Nach Ardham ging es über eine steinerne, moosbewachsene Brücke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": [
