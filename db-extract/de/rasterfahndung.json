                "senses": [
                    {
                        "sense_id": "cd549b6c-d9ca-306c-9a49-58dd345b52d9",
                        "entry_id": "8dd93957-70e6-366c-8708-de0433b98ac6",
                        "glosses": [
                            "die Fahndung nach verdächtigen Personen anhand von bestimmten Merkmalen in einem größeren Personenkreis mit Hilfe von Computern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cf4b958-173a-4ade-9d65-93049e2da7d5",
                                "sense_id": "cd549b6c-d9ca-306c-9a49-58dd345b52d9",
                                "text": "Die Rasterfahndung zum Beispiel ist ein Instrument, das gegen die neue terroristische Bedrohung nicht helfen wird."
                            },
                            {
                                "example_id": "a7ed67cf-d017-40ae-9dc7-0ff576371d9c",
                                "sense_id": "cd549b6c-d9ca-306c-9a49-58dd345b52d9",
                                "text": "Dem Bundeskriminalamt soll es zukünftig erlaubt sein, präventive Rasterfahndungen auf Bundesebene anzuordnen und durchzuführen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d2ab4e1-e825-4a02-a4d7-5a9307aff7c5",
