                "senses": [
                    {
                        "sense_id": "9ca8f887-80b5-3105-9b7e-9e12afb4f919",
                        "entry_id": "e0fb1f22-f4f3-37f7-b082-6772c4eeb5e6",
                        "glosses": [
                            "цвета огня, красного пламени"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a89a17be-d993-4a1c-93fa-253f379a3d55",
                                "sense_id": "9ca8f887-80b5-3105-9b7e-9e12afb4f919",
                                "text": "В щелочах [куркумин] растворяется с красно-бурым цветом; в спиртовом его растворе уксуснокислый свинец образует огненно-красный осадок."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3bd5391-274a-430d-baef-dfab9cba4407",
                        "source_entry_id": "e0fb1f22-f4f3-37f7-b082-6772c4eeb5e6",
                        "source_sense_id": "9ca8f887-80b5-3105-9b7e-9e12afb4f919",
                        "target_lang_word": "flame-red",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ca97d96e-8993-4e9b-b495-8e2852366f03",
                        "source_entry_id": "e0fb1f22-f4f3-37f7-b082-6772c4eeb5e6",
                        "source_sense_id": "9ca8f887-80b5-3105-9b7e-9e12afb4f919",
                        "target_lang_word": "feuerrot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feuerrot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "949cc619-d517-3b36-b74c-8ba4ed7c4c1c",
                                        "entry_id": "341b00e9-88a3-349f-8b9c-3de84ac69bac",
                                        "glosses": [
                                            "in, von einem grellen, intensiven Rot (wie dem des Feuers)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "112ea0cf-22c7-46b1-ba54-1534fdc2bcbc",
                                                "sense_id": "949cc619-d517-3b36-b74c-8ba4ed7c4c1c",
                                                "text": "Sie trug einen feuerroten Pullover."
                                            },
                                            {
                                                "example_id": "cf12e788-ac1d-4b95-b808-665d964e9f68",
                                                "sense_id": "949cc619-d517-3b36-b74c-8ba4ed7c4c1c",
                                                "text": "Seine Wangen wurden feuerrot."
                                            },
                                            {
                                                "example_id": "f91fe131-18af-42ce-8588-7b549505d79a",
                                                "sense_id": "949cc619-d517-3b36-b74c-8ba4ed7c4c1c",
                                                "text": "„Im Garten spielten die fremden Kinder, tütenblau, dottergelb, feuerrot, angezogen wie Clowns, […].“"
                                            },
                                            {
                                                "example_id": "9f9ed758-bfa1-4290-bc8b-4a0f190316b2",
                                                "sense_id": "949cc619-d517-3b36-b74c-8ba4ed7c4c1c",
                                                "text": "„Undine mit dem langen, roten Haar, in einem noch feuerroteren Kleid, ging mit halb geschlossenen Augen und gesenktem Blick, Fuß vor Fuß.“"
                                            },
                                            {
                                                "example_id": "33f0c505-f657-40e1-86bc-62ac3cc59835",
                                                "sense_id": "949cc619-d517-3b36-b74c-8ba4ed7c4c1c",
                                                "text": "„Der arme Tubaspieler hat bereits ein feuerrotes Gesicht.“"
                                            },
                                            {
                                                "example_id": "e556acd3-1483-4465-96bc-fad70ca2c61e",
                                                "sense_id": "949cc619-d517-3b36-b74c-8ba4ed7c4c1c",
                                                "text": "„Mitten auf der Straße schnaubte wütend ein nagelneues, feuerrotes Auto, dessen Windschutzscheibe durch einen Ziegel zersplittert war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
