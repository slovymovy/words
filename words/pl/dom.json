                {
                    "sense_id": "b95c3676-26fa-3847-ab98-47dc47605ca3",
                    "sense_definition": "Miejsce stałego zamieszkania, do którego się wraca i z którym jest się emocjonalnie związanym.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "home_place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jestem bardzo zmęczony i chcę już wrócić do <w>domu</w>.",
                            "target_lang_translations": {
                                "ru": "Я очень устал и хочу уже вернуться <w>домой</w>.",
                                "en": "I am very tired and I want to go <w>home</w> now."
                            }
                        },
                        {
                            "text": "Wszędzie dobrze, ale w <w>domu</w> najlepiej.",
                            "target_lang_translations": {
                                "ru": "В гостях хорошо, а <w>дома</w> лучше.",
                                "en": "There is no place like <w>home</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "mieszkanie",
                        "dach nad głową",
                        "własny kąt",
                        "ognisko domowe",
                        "gniazdo rodzinne"
                    ],
                    "common_phrases": [
                        "wracać do domu",
                        "czuć się jak w domu",
                        "nie ma to jak w domu",
                        "praca w domu"
                    ],
                    "target_lang_definitions": {
                        "ru": "Место постоянного проживания, куда человек возвращается и с которым эмоционально связан.",
                        "en": "A place of permanent residence to which one returns and with which one is emotionally connected."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дом",
                                "target_lang_sense_clarification": "жилище, домашний очаг"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "home",
                                "target_lang_sense_clarification": "emotional place of residence"
                            },
                            {
                                "target_lang_word": "household",
                                "target_lang_sense_clarification": "the people living together"
                            }
                        ]
                    }
                },
                {
