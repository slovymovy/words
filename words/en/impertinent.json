{
    "word_family": [
        "pertinence",
        "pertinent",
        "impertinence"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a98f8357-3075-347c-b34f-26a6596477e0",
                    "sense_definition": "Showing a lack of respect or being rude and ill-mannered.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "rude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was <w>impertinent</w> of the student to interrupt the professor during the lecture.",
                            "target_lang_translations": {
                                "zh": "那名学生在讲课时打断教授，真是太<w>无礼</w>了。"
                            }
                        },
                        {
                            "text": "The child gave an <w>impertinent</w> answer when asked to clean his room.",
                            "target_lang_translations": {
                                "zh": "当被要求打扫房间时，那个孩子给出了一个<w>放肆的</w>回答。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "impertinent remark",
                        "impertinent question"
                    ],
                    "target_lang_definitions": {
                        "zh": "不礼貌的、无礼的，尤指对长辈或上级不够尊重的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "无礼的",
                                "target_lang_sense_clarification": "缺乏礼貌、冒犯人的"
                            },
                            {
                                "target_lang_word": "放肆的",
                                "target_lang_sense_clarification": "言行不受规矩约束、轻率任性的"
                            },
                            {
                                "target_lang_word": "粗鲁的",
                                "target_lang_sense_clarification": "举止不文雅、不客气的"
                            },
                            {
                                "target_lang_word": "冒失的",
                                "target_lang_sense_clarification": "鲁莽轻率、失礼的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60284a01-1bd8-316b-9345-9386d32546c4",
                    "sense_definition": "Not relevant or not connected to the matter at hand.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "irrelevant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer argued that the witness's testimony was <w>impertinent</w> to the case.",
                            "target_lang_translations": {
                                "zh": "律师辩称证人的证词与本案<w>不相干</w>。"
                            }
                        },
                        {
                            "text": "He spent hours discussing <w>impertinent</w> details that did not help solve the problem.",
                            "target_lang_translations": {
                                "zh": "他花了几个小时讨论那些对解决问题毫无帮助的<w>无关</w>细节。"
                            }
                        }
                    ],
                    "synonyms": [
                        "nonpertinent"
                    ],
                    "antonyms": [
                        "pertinent",
                        "relevant"
                    ],
                    "target_lang_definitions": {
                        "zh": "不相干的，与当前议题无关的（多用于正式或法律语境）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "不相干的",
                                "target_lang_sense_clarification": "与当前话题没有关联的"
                            },
                            {
                                "target_lang_word": "无关的",
                                "target_lang_sense_clarification": "没有关系的、题外的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5a329a5c-bf67-3862-b9f2-832fe0d2bb93",
                    "sense_definition": "A person who behaves in a rude or disrespectful manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The host asked the <w>impertinents</w> to leave the party immediately.",
                            "target_lang_translations": {
                                "zh": "主人要求那些<w>无礼之徒</w>立即离开聚会。"
                            }
                        },
                        {
                            "text": "She found it difficult to deal with such <w>impertinents</w> in a professional setting.",
                            "target_lang_translations": {
                                "zh": "她发现在职场环境中很难应付这样<w>放肆的人</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "举止粗鲁、傲慢无礼的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "无礼之徒",
                                "target_lang_sense_clarification": "行为举止缺乏教养、不礼貌的人"
                            },
                            {
                                "target_lang_word": "放肆的人",
                                "target_lang_sense_clarification": "言行轻浮、不知分寸的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}