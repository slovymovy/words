                                "example_id": "3bc91a0a-3176-42be-b012-919187c40cdb",
                                "sense_id": "238d2b28-6952-30fc-bf2d-42c1252fa45a",
                                "text": "With hemophobia, symptoms may be triggered by seeing blood in real life or on television."
                            },
                            {
                                "example_id": "bb8f1c3a-ecf1-4048-adea-3ec5163af172",
                                "sense_id": "238d2b28-6952-30fc-bf2d-42c1252fa45a",
                                "text": "However, hemophobia causes much more than discomfort, and someone with this condition will experience highly distressing and disruptive symptoms at the sight of blood."
                            }
                        ]
                    }
