                        "target_lang_word": "пу́тать",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пу́тать",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c8719263-80bc-348c-9a9b-47079c354efa",
                                        "entry_id": "711ed395-d4e5-351a-83ea-d6fb9153b927",
                                        "glosses": [
                                            "сматывать, закручивать беспорядочно (веревки, нитки), образуя сложные сплетения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99bbd1d6-d054-4396-a400-4c2a2e3a4678",
                                                "sense_id": "c8719263-80bc-348c-9a9b-47079c354efa",
                                                "text": "Путать нитки."
                                            },
                                            {
                                                "example_id": "23bec3e7-f7f8-49ab-899b-a0ed65f00b92",
                                                "sense_id": "c8719263-80bc-348c-9a9b-47079c354efa",
                                                "text": "Путать веревки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f449403-b26c-3837-a63e-e2ec3d197638",
                                        "entry_id": "711ed395-d4e5-351a-83ea-d6fb9153b927",
                                        "glosses": [
                                            "разг. расстраивать порядок, в к-ром расположены вещи, перекладывая с места на место, вносить беспорядок в какое-н. дело"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ae22e48-99c5-4fa0-953a-cdb0e14a12ad",
                                                "sense_id": "8f449403-b26c-3837-a63e-e2ec3d197638",
                                                "text": "Путать бумаги на столе."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be190696-a747-3474-8c9a-568e0ce751e1",
                                        "entry_id": "711ed395-d4e5-351a-83ea-d6fb9153b927",
                                        "glosses": [
                                            "разг. кого-что с кем-чем принимать одного (одно) за другого (другое), ошибочно отождествлять, не различать какие-либо объекты"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1000e23d-da9c-446a-ab73-04fa2dadcabf",
                                                "sense_id": "be190696-a747-3474-8c9a-568e0ce751e1",
                                                "text": "Я всегда их путаю — они так похожи друг на друга."
                                            },
                                            {
                                                "example_id": "4ecbfbd3-61e2-4f13-b925-8200a2e806ed",
                                                "sense_id": "be190696-a747-3474-8c9a-568e0ce751e1",
                                                "text": "Постарайтесь не путать возвратный залог со страдательным."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4bc39e2-dc34-312e-a4ee-946d18defb77",
                                        "entry_id": "711ed395-d4e5-351a-83ea-d6fb9153b927",
                                        "glosses": [
                                            "разг. что и без доп. сбивчиво излагать, говорить, терять логическую связь, принимая одни факты за другие"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "783b5097-41f8-490d-ac66-693ebc0eaa47",
                                                "sense_id": "c4bc39e2-dc34-312e-a4ee-946d18defb77",
                                                "text": "Не торопитесь, не путайте, отвечайте яснее."
                                            },
                                            {
                                                "example_id": "2aa5aacf-d567-45cd-9f53-78f9f9ed8d13",
                                                "sense_id": "c4bc39e2-dc34-312e-a4ee-946d18defb77",
                                                "text": "Пока был умный жрец, кумир не путал врак."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e74ae475-6f4c-31ff-bdc9-33f916cb06b0",
                                        "entry_id": "711ed395-d4e5-351a-83ea-d6fb9153b927",
                                        "glosses": [
                                            "разг. кого-что сбивать с толку, расстраивать ход мыслей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e820a41-72e4-430d-828b-c744def9f090",
                                                "sense_id": "e74ae475-6f4c-31ff-bdc9-33f916cb06b0",
                                                "text": "Хватит меня путать, вы мне доступно объясните, есть ли смысл приходить в пятницу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b94d1277-194b-3d72-b672-5d9e9faf53b2",
                                        "entry_id": "711ed395-d4e5-351a-83ea-d6fb9153b927",
                                        "glosses": [
                                            "разг. вмешивать, вовлекать соучастником чего-н."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5465ada7-4141-4b6d-b7c4-7e9a0dd3a347",
                                                "sense_id": "b94d1277-194b-3d72-b672-5d9e9faf53b2",
                                                "text": "Не путайте меня в это грязное дело."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17580872-4b2a-3219-a238-47d4d8bf8b76",
                                        "entry_id": "711ed395-d4e5-351a-83ea-d6fb9153b927",
                                        "glosses": [
                                            "рег. (ru) надевать путы на кого-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4a9bd47-e726-422a-86be-c8ac6e249b7c",
                                                "sense_id": "17580872-4b2a-3219-a238-47d4d8bf8b76",
                                                "text": "Путали лошадей веревками, а когда ее не хватало - скрученными травяными жгутами."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2dd6cc3b-4b2d-3e92-a92c-c9f81d87d9f3",
                                        "entry_id": "711ed395-d4e5-351a-83ea-d6fb9153b927",
                                        "glosses": [
                                            "устар., рег. (ru) без доп. ходить, плутая, сбиваясь в пути, быть путану"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5541203d-4fb4-443a-8f4e-6bc90618fb20",
                                                "sense_id": "2dd6cc3b-4b2d-3e92-a92c-c9f81d87d9f3",
                                                "text": "Путать на пути."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
