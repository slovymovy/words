                "senses": [
                    {
                        "sense_id": "0d589638-868a-3257-881e-7b0b610bf00e",
                        "entry_id": "ea333904-a04f-392f-83fb-f58485864eff",
                        "glosses": [
                            "Titel von Personen, die die militärische Befehlsgewalt über ein Gebiet oder einen Militärverband haben"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "ba5f5c44-ae68-43d4-9376-d5c97e7086d4",
                                "sense_id": "0d589638-868a-3257-881e-7b0b610bf00e",
                                "text": "„Solche Überlegungen veranlassten im Jahr 286 den Flottenkommandanten Carausius, sich in Britannien zum Imperator ausrufen zu lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d85e84cc-116d-3d01-aab8-f684c8a02f39",
                        "entry_id": "ea333904-a04f-392f-83fb-f58485864eff",
                        "glosses": [
                            "Person, die die militärische Befehlsgewalt über ein Gebiet oder einen Militärverband hat"
                        ],
                        "tags": [
                            "historisch, Römisches Reich",
                            "ursprünglich"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "1fd10e82-3aba-365e-8f0e-f687a7de1304",
                        "entry_id": "ea333904-a04f-392f-83fb-f58485864eff",
                        "glosses": [
                            "Ehrentitel des Kaisers seit Augustus"
                        ],
                        "tags": [
                            "historisch, Römisches Reich"
                        ],
                        "examples": [],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "daab3f81-af2f-3dd3-8c64-537a7e9f1c75",
                        "entry_id": "ea333904-a04f-392f-83fb-f58485864eff",
                        "glosses": [
                            "Titel, den Kaiser zur Hervorhebung ihrer Würde trugen"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "ac2dc218-54de-4c10-98e3-0a3ca9abd07f",
                                "sense_id": "daab3f81-af2f-3dd3-8c64-537a7e9f1c75",
                                "text": "„Nicht, dass die Bürger den mächtigen Imperator sehen wollen, nein, vor den Toren der Stadt sollte es eine Schlacht geben, die Schlacht aller Schlachten.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
