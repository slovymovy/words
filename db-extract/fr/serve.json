                        "entry_id": "db271aa6-8f6a-35ef-b7c3-7d1f557b8c4a",
                        "glosses": [
                            "Femme attachée au domaine qu’elle cultive moyennant redevance au seigneur qui en est le propriétaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3173159-e453-49af-bd05-6389ffcefbfe",
                                "sense_id": "c794ddcd-64a6-3510-a47d-729dc55e7aa7",
                                "text": "Elle se trouvait à la cuisine, près du feu, vêtue comme une serve."
                            },
                            {
                                "example_id": "5899975d-adc9-4652-a404-00f61c361ca9",
                                "sense_id": "c794ddcd-64a6-3510-a47d-729dc55e7aa7",
                                "text": "Il fréquentait des femmes en noir, vivant seules dans les hameaux de la montagne, des esclaves, des serves ne parlant que le patois."
                            }
                        ]
                    }
                ],
