                "senses": [
                    {
                        "sense_id": "aee16dd1-7bad-3901-bd17-1345572a134f",
                        "entry_id": "cdf03245-f9d7-3f2d-91ed-36e79ac15f7b",
                        "glosses": [
                            "een slag op de schouder die men krijgt als men tot ridder wordt geslagen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0621ecbc-ae9a-48fc-b4da-b76ddcd69b20",
                                "sense_id": "aee16dd1-7bad-3901-bd17-1345572a134f",
                                "text": "De ridderslag kwam 53 jaar nadat de vier Beatles de onderscheiding Member of the British Empire ontvingen. Volgens Starr miste hij dit keer het gezelschap van de bandleden. ,,Ik was een beetje bibberig in mijn eentje\", zei hij tegen de BBC. Starr, die eigenlijk Richard Starkey heet, weet nog niet of hij als Sir Ringo door het leven wil gaan. Zanger Paul McCartney werd 21 jaar geleden al geridderd."
                            },
                            {
                                "example_id": "f5e0818d-6216-4034-9339-4d5ed5f1db2e",
                                "sense_id": "aee16dd1-7bad-3901-bd17-1345572a134f",
                                "text": "Tuinman ontving met de ridderslag, een klap van de koning op zijn schouder, de hoogste dapperheidsonderscheiding wegens zijn meervoudig ploegoptreden voor Taskforce 55 in 2009 voor zijn getoonde leiderschap in Afghanistan."
                            },
                            {
                                "example_id": "04c2eb23-bc76-4eb5-8f26-305b0f3e3887",
                                "sense_id": "aee16dd1-7bad-3901-bd17-1345572a134f",
                                "text": "Kroon staat bij Defensie bekend als kundig infanterist. Hij krijgt de onderscheiding voor meerdere acties. Waarvoor precies, hoort hij op 29 mei, als hij van koningin Beatrix de ridderslag ontvangt."
                            }
                        ]
                    }
