                ],
                "senses": [
                    {
                        "sense_id": "1ce768bf-992e-394f-aede-877a3e3c312f",
                        "entry_id": "f5512292-6338-3927-9720-e8ca6b470c1b",
                        "glosses": [
                            "een oorlog waarin beide partijen zich tegenover elkaar ingegraven hebben in loopgraven en andere versterkte posities, met als doel de opmars van de vijand te stuiten, die uitgemond is in een patstelling waarbij geen van beide partijen erin slaagt door de vijandelijke linies te breken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bee3b84-e51f-49ad-8b63-6d3015764bae",
                                "sense_id": "1ce768bf-992e-394f-aede-877a3e3c312f",
                                "text": "Tijdens de Tweede Wereldoorlog sloot Montyn zich aan bij de Kriegsmarine, waar hij een schipbreuk meemaakte die hij ternauwernood overleefde. Vervolgens werd hij naar het Oostfront gestuurd om te dienen in de loopgravenoorlog in Koerland."
                            }
                        ]
                    },
                    {
                        "sense_id": "c6dc1a84-63c2-3a28-b94f-8c1e97241143",
                        "entry_id": "f5512292-6338-3927-9720-e8ca6b470c1b",
                        "glosses": [
                            "een strijd waarbij de partijen niet of nauwelijks van positie veranderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64427264-aa64-4301-8fae-b473534f93d4",
                                "sense_id": "c6dc1a84-63c2-3a28-b94f-8c1e97241143",
                                "text": "Dudal betreurt het wel dat zijn Franstalige collega's van CSC en CGSP het protocol hebben verworpen. 'Ik voel me er niet goed bij. Maar de Nederlandstalige bonden hebben onderhandeld, de Franstaligen hebben een loopgravenoorlog gevoerd. Ik hoop dat de breuk kan gelijmd worden', besluit Dudal."
                            }
                        ]
                    }
                ],
