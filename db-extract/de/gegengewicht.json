                ],
                "senses": [
                    {
                        "sense_id": "99923402-8e17-3513-bb3b-60a4c7fc262e",
                        "entry_id": "8b4ad7d5-7302-3fca-84f3-f797f6f0a9c5",
                        "glosses": [
                            "das, was auf einer Waagschale auf der anderen Seite zum Gewicht liegt; das, was ausgleicht oder aufhebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "094eb734-4a1e-4efd-befd-313d40ef21c0",
                                "sense_id": "99923402-8e17-3513-bb3b-60a4c7fc262e",
                                "text": "Wir hatten so eine alte Waage, links konnte man in eine Schale das Wägegut legen und rechts auf einen Halter das Gegengewicht."
                            },
                            {
                                "example_id": "134904c0-6107-44b1-a8be-0bff7b7b04e5",
                                "sense_id": "99923402-8e17-3513-bb3b-60a4c7fc262e",
                                "text": "„Unter Gegengewicht ist hier nicht das beargwöhnte Gleichgewicht zwischen Rivalen gemeint, das mehr als einmal in Krieg geendet hat, sondern vielmehr ein Aushandeln von Interessen unter Nichtrivalen, das Extremismus verhindert.“"
                            },
                            {
                                "example_id": "61ffce94-0263-463a-a047-b574907e9c27",
                                "sense_id": "99923402-8e17-3513-bb3b-60a4c7fc262e",
                                "text": "Ihre Äußerungen stellen immer ein erfrischendes Gegengewicht zu all den festgefahrenen Ansichten dar."
                            },
                            {
                                "example_id": "d32c4402-45a2-417f-a399-2e268d231d31",
                                "sense_id": "99923402-8e17-3513-bb3b-60a4c7fc262e",
                                "text": "„Äußerer Flitter ist ein ausgezeichnetes Gegengewicht gegen ein so schlechtes Geschenk der Natur.“"
                            },
                            {
                                "example_id": "1ae35b35-4b8f-494f-97ea-fcd3ce46eff4",
                                "sense_id": "99923402-8e17-3513-bb3b-60a4c7fc262e",
                                "text": "„Kameradschaft ist das erträumte Gegengewicht im Leben eines Einzelgängers.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "772615ad-7334-44bf-96f2-a14abed56377",
                        "source_entry_id": "8b4ad7d5-7302-3fca-84f3-f797f6f0a9c5",
                        "source_sense_id": "99923402-8e17-3513-bb3b-60a4c7fc262e",
                        "source_sense_description": "das, was auf einer Waagschale auf der anderen Seite zum Gewicht liegt; das, was ausgleicht oder aufhebt",
                        "target_lang_word": "counterweight",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "counterweight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12a8ae98-5d0b-36a7-a585-eb47b3460c27",
                                        "entry_id": "c436a1bf-3ef1-354e-bd5b-15d196aad1d4",
                                        "glosses": [
                                            "A heavy mass of often iron or concrete, mechanically linked in opposition to a load which is to be raised and lowered, with the intent of reducing the amount of work which must be done to effect the raising and lowering. Counterweights are used, for example, in cable-hauled elevators and some kinds of movable bridges (e.g. a bascule bridge)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba00f575-4d85-4d91-a7b9-cd9ac5f559b1",
                                                "sense_id": "12a8ae98-5d0b-36a7-a585-eb47b3460c27",
                                                "text": "Four 110-ton counterweights, one in each tower, make this feat possible by reducing the effective weight to be lifted to some 25 tons; but an additional 20 tons (a very heavy snow load) can be lifted if necessary."
                                            },
                                            {
                                                "example_id": "3abbd9c8-2824-4d0e-a75c-ae4204d7b87f",
                                                "sense_id": "12a8ae98-5d0b-36a7-a585-eb47b3460c27",
                                                "text": "Like other supertall towers, 432 Park relies on the counterweight system to address the forces of wind and reduce the feeling of swaying for residents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e1b704a-49ab-3b37-bcb7-13aa935ac915",
                                        "entry_id": "c436a1bf-3ef1-354e-bd5b-15d196aad1d4",
                                        "glosses": [
                                            "A counterbalance."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0ee6c11-56e8-4ef9-bae6-f4d98ffbf6ed",
                                                "sense_id": "9e1b704a-49ab-3b37-bcb7-13aa935ac915",
                                                "text": "A counterweight to the anti-immigrant fear mongering of the former leader of the right-wing U.K. Independence Party, Nigel Farage, Lexiteers^([sic]) argued a left-wing, democratic and internationalist case for Brexit."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "counterweight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8088abb1-9382-3d79-8d3b-d1ebb4558449",
                                        "entry_id": "535e9056-26e6-3472-9f83-1bf108221bd5",
                                        "glosses": [
                                            "To fit with a counterweight."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64f41241-0f7e-4ee0-9059-11c48e419d78",
                                                "sense_id": "8088abb1-9382-3d79-8d3b-d1ebb4558449",
                                                "text": "Everything on the grid – all the backdrops and curtains, anything that has to move up and down from the fly-tower – has to be counterweighted."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88222ea1-2794-4700-a2ce-be02efaed278",
                        "source_entry_id": "8b4ad7d5-7302-3fca-84f3-f797f6f0a9c5",
                        "source_sense_id": "99923402-8e17-3513-bb3b-60a4c7fc262e",
                        "source_sense_description": "das, was auf einer Waagschale auf der anderen Seite zum Gewicht liegt; das, was ausgleicht oder aufhebt",
                        "target_lang_word": "contrepoids",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contrepoids",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a91150df-c13d-3819-89f0-76803867df52",
                                        "entry_id": "6728cc90-0fcf-3231-aa2e-2acb9632e245",
                                        "glosses": [
                                            "Poids servant à contrebalancer une force opposée ou à en modérer l’action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "977d2ea0-b461-40ab-8c70-3bd9d7ec540b",
                                                "sense_id": "a91150df-c13d-3819-89f0-76803867df52",
                                                "text": "Armé de sa hache, il assaillit la poterne à coups redoublés, protégé en partie contre les traits et les pierres lancés des remparts par les décombres du premier pont-levis, que le templier avait démoli en abandonnant la barbacane, laissant le contrepoids encore fixé à la partie supérieure de l’entrée."
                                            },
                                            {
                                                "example_id": "ad8f4688-0d90-4ca0-897c-7f911ecee51f",
                                                "sense_id": "a91150df-c13d-3819-89f0-76803867df52",
                                                "text": "On ne saura jamais ce qu’on peut faire avec un contrepoids ! Un enfant peut, de son petit doigt, faire tourner une maison… quand un pan de mur, si lourd soit-il, est amené par le contrepoids sur son pivot, bien en équilibre, il ne pèse pas plus qu’une toupie sur sa pointe."
                                            },
                                            {
                                                "example_id": "b0f76fe1-2f05-4b43-905d-e266a892a740",
                                                "sense_id": "a91150df-c13d-3819-89f0-76803867df52",
                                                "text": "Ces mouvements sont assurés par un excentrique, sur la circonférence duquel court un galet qui est relié à une chaîne attachée au chariot avec un contrepoids."
                                            },
                                            {
                                                "example_id": "f403b5bf-28f0-468e-9de9-58e1d9a25f5e",
                                                "sense_id": "a91150df-c13d-3819-89f0-76803867df52",
                                                "text": "Ils marchaient lentement, s’arrêtaient sur un point plus vif de discussion, puis repartaient : frêle silhouette du petit moine dans sa rude robe caramel, grand-père à peine plus grand, le corps penché en avant, les mains en contrepoids croisées derrière le dos."
                                            },
                                            {
                                                "example_id": "081d1da8-75cd-484a-b6de-17672f0a06e1",
                                                "sense_id": "a91150df-c13d-3819-89f0-76803867df52",
                                                "text": "Il paraît que la nouvelle génération de hors-bord, appelés « cigarettes », a un moteur trop puissant pour la coque du bateau. Celui-ci, ballotté par la houle, risque à chaque instant de se renverser en raison de sa trop grande vitesse et de son équilibre instable. L’utilisation d’un contrepoids mobile, se déplaçant d’avant en arrière sur le bateau, permet ainsi d’en contrôler l’aplomb"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef750bde-fff0-360c-a691-f427c13dbb6f",
                                        "entry_id": "6728cc90-0fcf-3231-aa2e-2acb9632e245",
                                        "glosses": [
                                            "Ce qui sert à contrebalancer des affections, des qualités bonnes ou mauvaises, et en général de toutes les choses morales, politiques, etc., qui servent à en contrebalancer d’autres."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34dbed72-b989-4782-9dfd-4740f5388d98",
                                                "sense_id": "ef750bde-fff0-360c-a691-f427c13dbb6f",
                                                "text": "[…] ; c’est à vous seule que je m’adresse ; et qu’y a-t-il qui puisse servir de contrepoids à votre décision ?"
                                            },
                                            {
                                                "example_id": "0c0844de-2300-47d5-a340-10271da6cb7e",
                                                "sense_id": "ef750bde-fff0-360c-a691-f427c13dbb6f",
                                                "text": "Il arriverait, si nous savions mieux analyser nos amours, de voir que souvent les femmes ne nous plaisent qu’à cause du contrepoids d’hommes à qui nous avons à les disputer, bien que nous souffrions jusqu’à mourir d’avoir à les leur disputer ; le contrepoids supprimé, le charme de la femme tombe."
                                            },
                                            {
                                                "example_id": "5b077713-8af5-4342-a34b-4d585b650022",
                                                "sense_id": "ef750bde-fff0-360c-a691-f427c13dbb6f",
                                                "text": "Mais le maître chanteur a son utilité sociale. Sans lui, la crapule aurait trop beau jeu. Le maître chanteur, c'est le contrepoids absolument nécessaire, le châtiment, la menace du châtiment qui plane."
                                            },
                                            {
                                                "example_id": "752bacd0-c01f-48dc-a2c9-9cb79def98d3",
                                                "sense_id": "ef750bde-fff0-360c-a691-f427c13dbb6f",
                                                "text": "Situer en face de l'Allemagne et de l'Autriche coalisés un groupement de nations qui pût faire hardiment contrepoids et puis attendre l'arme au pied, bloc contre bloc, la guerre qu'il jugeait inévitable, telle était sa politique."
                                            },
                                            {
                                                "example_id": "f25e99a1-e332-4c11-b933-446d8921f3e2",
                                                "sense_id": "ef750bde-fff0-360c-a691-f427c13dbb6f",
                                                "text": "Un papyrologue est de ce rythme-là. Pouvant passer des années à déchiffrer un papyrus, accumulant patiemment le savoir comme on collecte la rosée dans le désert, il est le contrepoids indispensable à notre société productiviste dopée à l’Internet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
