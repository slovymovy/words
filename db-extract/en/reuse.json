                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceba39be-b489-4e82-bd80-60de1d4cce3d",
                                                "sense_id": "72d1e7d4-934c-3231-aeb4-4a2081db43c8",
                                                "text": "La réutilisation des eaux pluviales."
                                            },
                                            {
                                                "example_id": "c1496f08-0a41-4c3f-b263-96b1cdc9811f",
                                                "sense_id": "72d1e7d4-934c-3231-aeb4-4a2081db43c8",
                                                "text": "La réutilisation des épisodes de conception afin de faciliter la tâche du concepteur est le sujet principal de ce chapitre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
