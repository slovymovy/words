                                        "glosses": [
                                            "Vin produit dans l’île de Madère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e64c99ef-b3d8-436f-a3cf-5a6b221dcf84",
                                                "sense_id": "e26426f2-90f1-3350-8999-585fbb0cfeff",
                                                "text": "Il y avait là une vingtaine de solliciteuses, attendant leur tour, trempant des biscuits dans des verres de madère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5a8d2cc-0925-3c8a-b674-b4d773058a04",
                                        "entry_id": "5fdd8bfc-2efe-328f-b553-513841941f7c",
