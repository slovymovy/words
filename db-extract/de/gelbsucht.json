                "senses": [
                    {
                        "sense_id": "8b716287-4a05-3129-b9f5-76c6918355f8",
                        "entry_id": "9f9abe52-8951-3e97-bc08-1df58dcb1b3d",
                        "glosses": [
                            "Gelbfärbung von Haut, Schleim- und Bindehaut infolge Erkrankung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34e5e910-42e5-4be0-9608-33ec9370e012",
                                "sense_id": "8b716287-4a05-3129-b9f5-76c6918355f8",
                                "text": "„Gelbsucht und Typhus sind aus der Mode gekommen.“"
                            },
                            {
                                "example_id": "d008d1aa-7bc8-4b7e-86e7-8a379b68a19e",
                                "sense_id": "8b716287-4a05-3129-b9f5-76c6918355f8",
                                "text": "„Sie hat Gelbsucht gehabt, sie hat vier Monate im Bett gelegen.“"
                            },
                            {
                                "example_id": "7938e407-11a0-4125-842b-9aeb4198aabe",
                                "sense_id": "8b716287-4a05-3129-b9f5-76c6918355f8",
                                "text": "„Am Leben war ich, auch wenn ich infolge von Hunger und Gram Gelbsucht bekam.“"
                            },
                            {
                                "example_id": "89572cf2-5d29-4326-8610-98ca081f7efc",
                                "sense_id": "8b716287-4a05-3129-b9f5-76c6918355f8",
                                "text": "„Man könnte an Gelbsucht denken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
