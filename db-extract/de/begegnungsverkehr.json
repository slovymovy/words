                    {
                        "sense_id": "056edc7f-5674-304f-9b19-b09c985fba28",
                        "entry_id": "99fa5029-7233-3d72-a6de-785c6f095583",
                        "glosses": [
                            "Bewegung von Verkehrsteilnehmern in unterschiedlichen (meist entgegengesetzten) Richtungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1983e55e-a4fb-4b8a-ae0b-0f8d6b4201db",
                                "sense_id": "056edc7f-5674-304f-9b19-b09c985fba28",
                                "text": "„Auf Verkehrswegen im Tagbau sind Ausweichen für Begegnungsverkehr, Reversier- und Umkehrplätze in ausreichender Anzahl und Breite vorzusehen.“"
                            },
                            {
                                "example_id": "e3ed562f-7478-4320-97bb-b02dc3d250a2",
                                "sense_id": "056edc7f-5674-304f-9b19-b09c985fba28",
                                "text": "„Prüfung weiterer Querungshilfen für den geplanten neuen Busbahnsteig, um damit potentielle Gefahren durch Begegnungsverkehre zwischen Fußgängern und Bussen zu vermeiden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
