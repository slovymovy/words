                        "translation_id": "07ce0126-a97c-4f6d-9093-d397fc5ca11e",
                        "source_entry_id": "fb787ce9-f283-3033-802c-195c0f543e72",
                        "source_sense_description": "frame or rack",
                        "target_lang_word": "égouttoir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "égouttoir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c924c577-b3bc-3f84-b27b-7fc869a44c7e",
                                        "entry_id": "19f36992-f65f-3200-b3ba-e1e168bf265c",
                                        "glosses": [
                                            "Planche, treillis, éclisse sur laquelle on met égoutter quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d4448dd-2b9c-4229-bd1c-05af8fd7040e",
                                                "sense_id": "c924c577-b3bc-3f84-b27b-7fc869a44c7e",
                                                "text": "Tu vois cet égouttoir? C’est comme ça que je t’arrangerai si je te retrouve ici demain!"
                                            },
                                            {
                                                "example_id": "f1094e96-6dc2-4291-bcdf-16fd53360565",
                                                "sense_id": "c924c577-b3bc-3f84-b27b-7fc869a44c7e",
                                                "text": "Le mari, d’âge moyen, a la passion de la photographie. Ses journées se passent dans sa chambre noire au milieu des cuvettes et des égouttoirs."
                                            },
                                            {
                                                "example_id": "89f2f3ec-9d2c-4db1-9a15-50dcef2c98cc",
                                                "sense_id": "c924c577-b3bc-3f84-b27b-7fc869a44c7e",
                                                "text": "L’égouttoir à fromage se trouve sous 4 formes majeures : - un plateau en bois, - un meuble en bois composé de 2 plateaux superposés, - un plat très creux en céramique ou en bois, muni d’un champignon central, - un récipient dont le fond est garni de trous et que l’on appelle couramment « faisselle »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
