                                "target_senses": [
                                    {
                                        "sense_id": "ddca3042-e64a-3b1e-8d0f-80376b9f5289",
                                        "entry_id": "48a026d9-1dfb-335a-a08d-8ee507f93379",
                                        "glosses": [
                                            "Aéronef."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "735ee481-3b00-48da-9fcb-ea4eedf5846d",
                                                "sense_id": "ddca3042-e64a-3b1e-8d0f-80376b9f5289",
                                                "text": "Signaler la présence des aérodromes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17e52906-9ef9-3d57-a5f3-5546cdf083aa",
                                        "entry_id": "48a026d9-1dfb-335a-a08d-8ee507f93379",
                                        "glosses": [
                                            "Terrain aménagé pour l’atterrissage, le stationnement, l'entretien et le décollage habituels des aéronefs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d29ba297-d8b7-45ab-b63f-e295c4dcf281",
                                                "sense_id": "17e52906-9ef9-3d57-a5f3-5546cdf083aa",
                                                "text": "La plupart des personnes venues assister à notre décollage étaient encore sur l’aérodrome à 10 heures et demie."
                                            },
                                            {
                                                "example_id": "61d05b56-f33d-4a1d-aea3-1b48b3ecf2ab",
                                                "sense_id": "17e52906-9ef9-3d57-a5f3-5546cdf083aa",
                                                "text": "La 8ᵉ force aérienne avait d'abord calculé qu'il lui faudrait achever 61 aérodromes avant la fin 1943 ; mais elle finit par en construire 120, mobilisant un million de mois-hommes de travail, et couvrant 42 millions de mètres carrés de béton."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f13dc9d0-bfdb-49cb-a774-c452588b7c81",
                        "source_entry_id": "a58092fc-52c3-3e40-9d69-004720ed6bf7",
                        "source_sense_id": "59c5377a-63ec-3027-86ab-b8175137d350",
                        "source_sense_description": "Luftfahrt: Start- und Landeplatz für Flugzeuge",
                        "target_lang_word": "luchthaven",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "luchthaven",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "bcde6a03-ba69-3fdf-8125-eed97b418bea",
                                        "entry_id": "b1bbc3b1-94d3-309f-bfcc-3ec0cb6bea09",
                                        "glosses": [
                                            "een vliegveld voor verkeersvliegtuigen met accommodatie voor ontvangst en vertrek van passagiers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50186ed0-41ea-41a4-ab8a-968452ea541e",
                                                "sense_id": "bcde6a03-ba69-3fdf-8125-eed97b418bea",
                                                "text": "Luchtvaartmaatschappijen gaan de schade op Schiphol verhalen van annuleringen die ze op verzoek van de luchthaven deden."
                                            },
                                            {
                                                "example_id": "60b445c6-5a4e-4028-8954-c8ab73d93cd7",
                                                "sense_id": "bcde6a03-ba69-3fdf-8125-eed97b418bea",
                                                "text": "Schiphol heeft een hub-and-spoke-systeem (naaf-met-spaken) als businessmodel. In de luchtvaart is een hub een centrale luchthaven waar reizigers naar toe worden vervoerd om over te stappen op andere vluchten, zo mogelijk van dezelfde maatschappij."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
