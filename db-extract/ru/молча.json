        "ru-extract.jsonl": [
            {
                "entry_id": "23a48606-626b-3277-8279-fa92364d2ece",
                "word": "молча",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [
                    {
                        "form_id": "3b85a8d3-4a6f-415f-a86b-dacb0dd85c01",
                        "entry_id": "23a48606-626b-3277-8279-fa92364d2ece",
                        "tags": [
                            "stressed"
                        ],
                        "form": "мо́лча"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f4513920-7e12-3a9f-beae-8a79cc8b7a23",
                        "entry_id": "23a48606-626b-3277-8279-fa92364d2ece",
                        "glosses": [
                            "сохраняя молчание, ничего не говоря"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1b9d6aa-4190-43a4-b5c4-db358c7463e2",
                                "sense_id": "f4513920-7e12-3a9f-beae-8a79cc8b7a23",
                                "text": "Он встал и молча вышел."
                            },
                            {
                                "example_id": "bbfa1724-ec45-47a5-902f-60d7c74c6bff",
                                "sense_id": "f4513920-7e12-3a9f-beae-8a79cc8b7a23",
                                "text": "Двигались молча, без разговоров."
                            }
                        ]
                    },
                    {
                        "sense_id": "451fd701-8976-33a2-8772-42e7c6dbc160",
                        "entry_id": "23a48606-626b-3277-8279-fa92364d2ece",
                        "glosses": [
                            "перен. не протестуя, безропотно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c3342f6-c8bd-423b-83e3-7021b4567eac",
                                "sense_id": "451fd701-8976-33a2-8772-42e7c6dbc160",
                                "text": "Вообрази: я здесь одна, Никто меня не понимает, Рассудок мой изнемогает, И молча гибнуть я должна."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "037bb049-b350-4fef-a46e-a106aa4c2da5",
                        "source_entry_id": "23a48606-626b-3277-8279-fa92364d2ece",
                        "target_lang_word": "silently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "silently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "73db7210-4dfc-33b7-9d1d-a3d4c6c99ec3",
                                        "entry_id": "d3aaf0d9-85cb-3950-96cc-2596731d1cf1",
                                        "glosses": [
                                            "In a silent manner; making no noise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dd1de5e-2418-443b-bc85-8832823a89fa",
                                                "sense_id": "73db7210-4dfc-33b7-9d1d-a3d4c6c99ec3",
                                                "text": "It often happens that the most important results in the natural world are brought about by causes which operate silently, if not imperceptibly."
                                            },
                                            {
                                                "example_id": "db4e2e38-6298-4fab-afb0-ee64d924855e",
                                                "sense_id": "73db7210-4dfc-33b7-9d1d-a3d4c6c99ec3",
                                                "text": "Frederick, I presume, at this late hour of four, may be snatching a morsel of dinner; his orderlies are silently speeding, plans taken, orders given: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0c4f1bd-e3dd-3db0-ac81-e039fd2f4797",
                                        "entry_id": "d3aaf0d9-85cb-3950-96cc-2596731d1cf1",
                                        "glosses": [
                                            "Of an edit or change to a text, without explicit acknowledgment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f21bbce9-e5e9-401a-9362-d9bccc78bf57",
                                                "sense_id": "c0c4f1bd-e3dd-3db0-ac81-e039fd2f4797",
                                                "text": "There never was an English-language text, either in 1561 or 1859. Yule and Burnell have silently provided a translation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84c3d79d-8fc3-4478-9fc9-767f3d075cb7",
                        "source_entry_id": "23a48606-626b-3277-8279-fa92364d2ece",
                        "target_lang_word": "speechlessly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "speechlessly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb6e30f4-c09a-3b84-8fd9-5041f61e3b57",
                                        "entry_id": "bc7e7745-2bc3-386d-946d-ce37a11a8351",
                                        "glosses": [
                                            "In a speechless manner; without speaking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f67bc465-f0ad-4059-b113-c8b3fb21567c",
                                                "sense_id": "bb6e30f4-c09a-3b84-8fd9-5041f61e3b57",
                                                "text": "He stood there speechlessly. The surprise had rendered him unable to make an intelligible reply."
                                            },
                                            {
                                                "example_id": "4864f0b8-6b2a-420f-87b6-de39cc15b2ec",
                                                "sense_id": "bb6e30f4-c09a-3b84-8fd9-5041f61e3b57",
                                                "text": "That afternoon they stood at the foot of Mrs. Civil's bed. She was propped up by pillows, and through the little window looking westward the afternoon sun blazed unsparingly on the discoloured face of the sick woman, speechlessly rigid."
                                            },
                                            {
                                                "example_id": "a6b0edbc-51e2-4c31-a565-31160b88b3b5",
                                                "sense_id": "bb6e30f4-c09a-3b84-8fd9-5041f61e3b57",
                                                "text": "His eyes grew round and he pointed speechlessly into space."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb7fc5d9-b17d-4d1d-9655-c1d5ef84ff3d",
                        "source_entry_id": "23a48606-626b-3277-8279-fa92364d2ece",
                        "target_lang_word": "en silence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en silence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "535bcfa9-e316-39b0-9744-087469654b82",
                                        "entry_id": "ab1320ab-26c6-37f4-b882-98f548cb973f",
                                        "glosses": [
                                            "Sans faire de bruit ; silencieusement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cafdde1-4f14-47a8-8a9b-ca7ee6e11753",
                                                "sense_id": "535bcfa9-e316-39b0-9744-087469654b82",
                                                "text": "Ils cheminaient donc en silence et ils allaient traverser la chaussée pour remonter le côté gauche du boulevard Malesherbes, lorsque le financier s'arrêta."
                                            },
                                            {
                                                "example_id": "fd7bf09a-1201-411b-893b-eb2593204309",
                                                "sense_id": "535bcfa9-e316-39b0-9744-087469654b82",
                                                "text": "Pendant de longues heures nous marchons en silence, ne regardant ni à droite ni à gauche, la tête baissée sous nos capuchons pour nous garantir de l’ondée cinglante."
                                            },
                                            {
                                                "example_id": "73f39fe4-10d1-46de-8cbf-20490c629df0",
                                                "sense_id": "535bcfa9-e316-39b0-9744-087469654b82",
                                                "text": "Le repas était, comme toujours en Polynésie, une affaire très sérieuse et tout le monde mangeait en silence."
                                            },
                                            {
                                                "example_id": "fdcdb57b-413e-4421-b240-825cb04bdabf",
                                                "sense_id": "535bcfa9-e316-39b0-9744-087469654b82",
                                                "text": "François s’exécuta, puis, d'un coup de pouce, il enflamma son briquet d’amadou et le tendit, en silence, à la fille."
                                            },
                                            {
                                                "example_id": "44708851-23dd-4447-84b7-adf9ab4c6902",
                                                "sense_id": "535bcfa9-e316-39b0-9744-087469654b82",
                                                "text": "Nous écoutâmes un morceau en silence."
                                            },
                                            {
                                                "example_id": "2c36c133-cb9d-4448-ba58-df40129a0e33",
                                                "sense_id": "535bcfa9-e316-39b0-9744-087469654b82",
                                                "text": "Un soir, t’en souvient-il ? nous voguions en silence ;\nOn n’entendait au loin, sur l’onde et sous les cieux,\nQue le bruit des rameurs qui frappaient en cadence\nTes flots harmonieux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b98a2b1a-bdbb-4dd3-bd87-b4c9976afb54",
                        "source_entry_id": "23a48606-626b-3277-8279-fa92364d2ece",
                        "target_lang_word": "sans rien dire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2272c71c-d73d-4e82-8a1c-dcafb0dba68b",
                        "source_entry_id": "23a48606-626b-3277-8279-fa92364d2ece",
                        "target_lang_word": "sans un mot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sans un mot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8b8abbc0-029d-346a-a0b7-8c6f420bdc28",
                                        "entry_id": "5cdf7785-ea26-37d3-b2d5-a2ffbb51c48c",
                                        "glosses": [
                                            "Sans rien dire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c44ef1bb-0da0-47d5-9061-70aadae011aa",
                                                "sense_id": "8b8abbc0-029d-346a-a0b7-8c6f420bdc28",
                                                "text": "Je passe près d’elle sans un mot. Elle me voit, me sourit et replonge dans son travail."
                                            },
                                            {
                                                "example_id": "8de57845-91bc-401e-b237-0b48de8b1b6b",
                                                "sense_id": "8b8abbc0-029d-346a-a0b7-8c6f420bdc28",
                                                "text": "Sans un mot, Abraham fit un pas vers son aîné. Paul leva son pistolet. Son bras tremblait comme les pattes d’un chiot qui vient de naître."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
