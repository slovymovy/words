{
    "word_family": [
        "transform",
        "transformation",
        "transformer",
        "transformational"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "752bac8c-895e-3e4e-a87a-da13e9a601c3",
                    "sense_definition": "That causes a transformation; producing a marked and lasting change.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new law had a <w>transformative</w> effect on the country's economy.",
                            "target_lang_translations": {
                                "zh": "这项新法律对国家经济产生了<w>变革性</w>的影响。"
                            }
                        },
                        {
                            "text": "Education is a <w>transformative</w> experience that changes students' lives.",
                            "target_lang_translations": {
                                "zh": "教育是一种能够改变学生人生的<w>变革性</w>经历。"
                            }
                        }
                    ],
                    "synonyms": [
                        "transformatory",
                        "transmutative"
                    ],
                    "antonyms": [
                        "nontransformative"
                    ],
                    "common_phrases": [
                        "transformative effect",
                        "transformative project"
                    ],
                    "target_lang_definitions": {
                        "zh": "引起重大且持久改变的；具有变革性的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "变革性的",
                                "target_lang_sense_clarification": "指能够带来根本性、深远改变的。"
                            },
                            {
                                "target_lang_word": "有重大影响的",
                                "target_lang_sense_clarification": "强调改变的程度和重要性。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ce587bb-f3ec-374d-b478-4bf46c4482c2",
                    "sense_definition": "Relating to generative grammar, in which operations called transformations produce new sentences from existing ones.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The study examines the <w>transformative</w> model within modern linguistics.",
                            "target_lang_translations": {
                                "zh": "这项研究探讨了现代语言学中的<w>转换</w>模型。"
                            }
                        },
                        {
                            "text": "The rules of the <w>transformative</w> system explain how complex sentences are generated.",
                            "target_lang_translations": {
                                "zh": "<w>转换</w>系统的规则解释了复杂句子是如何生成的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "transformative-generative grammar"
                    ],
                    "target_lang_definitions": {
                        "zh": "与生成语法相关，指通过转换规则从基础句生成新句子的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "转换的",
                                "target_lang_sense_clarification": "语言学中指代转换生成语法中的转换操作。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}