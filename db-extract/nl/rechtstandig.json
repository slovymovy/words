                                    },
                                    {
                                        "sense_id": "024a52fc-f207-37ac-a510-3eb0171361d2",
                                        "entry_id": "170a53bd-aec4-3037-8ef7-d4c1c1af1f70",
                                        "glosses": [
                                            "Short for upright piano"
                                        ],
                                        "tags": [
