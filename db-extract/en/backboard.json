                    {
                        "sense_id": "ad87e33f-16aa-3251-b2be-065f9ccdb756",
                        "entry_id": "f059c67e-93f7-39a4-b471-b1a207d027aa",
                        "glosses": [
                            "The flat vertical surface to which the basket is attached."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ca99025a-d7c8-398f-bba9-2ed6e89f09c1",
                        "entry_id": "f059c67e-93f7-39a4-b471-b1a207d027aa",
                        "glosses": [
                            "A flat vertical wall with the image of a tennis net drawn or painted on it, designed to practice hitting against such that the ball rebounds."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b1166519-3afe-3580-8a81-c76fb9e4a294",
                        "entry_id": "f059c67e-93f7-39a4-b471-b1a207d027aa",
                        "glosses": [
                            "A spine board."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5554c6af-f80a-34e3-874d-9a5d5d7a2823",
                        "entry_id": "f059c67e-93f7-39a4-b471-b1a207d027aa",
                        "glosses": [
                            "A board placed at the back of a cart, boat, behind a signal, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "394f5c7d-62ef-4e06-9e72-7a28541dc25e",
                                "sense_id": "5554c6af-f80a-34e3-874d-9a5d5d7a2823",
                                "text": "The L.B.S.C.R. favoured backboards for signals wherever these helped visibility. The Great Eastern also made extensive use of backboards."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2716f020-615c-4833-a2e6-d279eaf7d3a9",
