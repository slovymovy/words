                        "glosses": [
                            "The vowels, sequence of vowels, or the quality peculiar to the vowels of a given word or group of words."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fb26762-abb7-4e55-83e2-2ec0750bfc9e",
                                "sense_id": "636ccc07-0e6b-36f0-90f7-c7e5ef9c8a2b",
                                "text": "All forms contain a base *θirr- or *θurr-. Types 1 and 2 [which contain *θirr] may have been influenced by θirri̯are 'to screech', suggesting that the forms with *θurr- preserve the original vocalism."
                            }
                        ]
