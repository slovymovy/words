                    {
                        "sense_id": "e15b8ba8-66ac-3620-91c4-38f72e984f01",
                        "entry_id": "ff882efb-2934-3be7-b63d-e92c44f116bb",
                        "glosses": [
                            "stevig touw of draad dat men gebruikt om iets vast te maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "587e4c1d-521e-4ca9-b79f-2644e0e9e8e9",
                                "sense_id": "e15b8ba8-66ac-3620-91c4-38f72e984f01",
                                "text": "JSB produceert speciale staaldraden, voornamelijk met nylon bedekt, die gebruikt worden als spiraal binddraad en voor talrijke toepassingen in de kledingindustrie zoals voor haken en ogen en beugels voor bustehouders."
                            },
                            {
                                "example_id": "2c215611-0887-44a4-9dcf-c488c2bab9cb",
                                "sense_id": "e15b8ba8-66ac-3620-91c4-38f72e984f01",
                                "text": "Gijsen en Molenberghs beraamden samen een plan om de grootmoeder van Gijsen in haar woning in Eisden-Tuinwijk (Maasmechelen) van haar geld te beroven. Er was vooraf afgesproken dat er geweld gebruikt ging worden, want het koppel was binddraad en tape gaan kopen."
                            }
                        ]
                    }
