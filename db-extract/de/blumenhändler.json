                    {
                        "sense_id": "dcfa6000-1add-3395-b0d2-1728f3250460",
                        "entry_id": "9e70c1a6-49a2-351d-b4fc-e50544e25f85",
                        "glosses": [
                            "jemand, der professionell Blumen kauft und verkauft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84d9d49a-ca2a-4a68-9c61-b67a38b3a1f2",
                                "sense_id": "dcfa6000-1add-3395-b0d2-1728f3250460",
                                "text": "Blumenhändler müssen sehr auf die Frische ihrer Waren achten."
                            },
                            {
                                "example_id": "c89fb181-ea6f-4c09-a634-96ea1526cb53",
                                "sense_id": "dcfa6000-1add-3395-b0d2-1728f3250460",
                                "text": "„Sie erzählte mir von einem Blumenhändler.“"
                            },
                            {
                                "example_id": "e7ae9061-2cab-4ef6-9d43-58ee8a12f8da",
                                "sense_id": "dcfa6000-1add-3395-b0d2-1728f3250460",
                                "text": "„Der Blumenhändler, drei Häuser weiter, kennt sie ebenfalls.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
