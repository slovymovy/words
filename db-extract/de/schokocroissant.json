                                        "entry_id": "5a6bae22-0b99-3a56-a651-7c87e83335f4",
                                        "glosses": [
                                            "Viennoiserie à base de pâte feuilletée contenant une ou plusieurs barres de chocolat."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "Nord du Nouveau-Brunswick",
