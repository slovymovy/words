                        "glosses": [
                            "A small gable, or gable-shaped canopy, formed over a tabernacle, niche, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74432673-e66a-4e61-979d-1b8125c7765e",
                                "sense_id": "d59a8963-b1ad-3f60-884f-f86251e72636",
                                "text": "The Pinnacles are numerous, and very fine. They are in general square, and not on diagonally; the sides are frequently panelled, and terminate in crocketed canopies, or gablets, from which rises the spire, which is also crocketed at the angles, and terminates in a finial."
                            },
                            {
                                "example_id": "77e95b25-a363-4c9e-bda0-de488a0e35fe",
                                "sense_id": "d59a8963-b1ad-3f60-884f-f86251e72636",
                                "text": "Almost opposite Clarence House, and immediately adjoining the Swan Hotel, is a lofty and somewhat narrow structure of four storeys, whose twin gablets overhang and overbend the street in quite a serious manner."
                            }
                        ]
