                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36ed140e-b3e4-4f43-807c-e657d0f62b93",
                                "sense_id": "d566955c-eb43-349c-a9ba-a1b0ac53a391",
                                "text": "To parody the inquisitorial rhetoric of another age, I am not now, nor have I ever been, a boy-lover."
                            }
                        ]
                    },
                    {
                        "sense_id": "25dfe4cf-a4b9-3615-8cec-2a8dcfedd720",
                        "entry_id": "060b0afd-7302-3c18-9bec-f7cf551e3593",
                        "glosses": [
                            "In a manner of inquisition or inquisitors."
                        ],
                        "tags": [],
                        "examples": [
                            {
