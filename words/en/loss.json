{
    "word_family": [
        "lose",
        "loser",
        "lost"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "16d32694-da07-327e-97f9-f98cc24b06d1",
                    "sense_definition": "The fact or process of no longer having something or having less of it.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "deprivation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>loss</w> of his job caused significant financial stress.",
                            "target_lang_translations": {
                                "ru": "<w>Потеря</w> работы вызвала у него значительный финансовый стресс.",
                                "zh": "他<w>失去</w>工作导致了巨大的经济压力。"
                            }
                        },
                        {
                            "text": "She is worried about the sudden <w>loss</w> of her hearing.",
                            "target_lang_translations": {
                                "ru": "Она обеспокоена внезапной <w>потерей</w> слуха.",
                                "zh": "她很担心自己听力的突然<w>丧失</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "gain",
                        "acquisition"
                    ],
                    "common_phrases": [
                        "weight loss",
                        "memory loss",
                        "hair loss",
                        "loss of appetite"
                    ],
                    "target_lang_definitions": {
                        "ru": "Факт или процесс лишения чего-либо или обладания меньшим количеством чего-либо.",
                        "zh": "指不再拥有某物或某物数量减少的事实或过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поте́ря",
                                "target_lang_sense_clarification": "общая"
                            },
                            {
                                "target_lang_word": "утра́та",
                                "target_lang_sense_clarification": "способностей или качеств"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "失去",
                                "target_lang_sense_clarification": "指状态或能力的丧失"
                            },
                            {
                                "target_lang_word": "损失",
                                "target_lang_sense_clarification": "指具体事物或数量的减少"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2ea8635-72e8-328e-a096-d891e3992054",
                    "sense_definition": "A failure to win a game, competition, or contest.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "defeat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team suffered a painful <w>loss</w> in the final match.",
                            "target_lang_translations": {
                                "ru": "Команда потерпела болезненное <w>поражение</w> в финальном матче.",
                                "zh": "该队在决赛中遭遇了一场痛苦的<w>失败</w>。"
                            }
                        },
                        {
                            "text": "It was their first <w>loss</w> of the season.",
                            "target_lang_translations": {
                                "ru": "Это был их первый <w>проигрыш</w> в сезоне.",
                                "zh": "这是他们本赛季的第一次<w>输</w>球。"
                            }
                        }
                    ],
                    "antonyms": [
                        "win",
                        "victory"
                    ],
                    "common_phrases": [
                        "big loss",
                        "accept a loss"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неудача в игре, соревновании или состязании.",
                        "zh": "在游戏、比赛或竞争中未能获胜。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пораже́ние",
                                "target_lang_sense_clarification": "в соревновании или битве"
                            },
                            {
                                "target_lang_word": "про́игрыш",
                                "target_lang_sense_clarification": "в игре"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "失败",
                                "target_lang_sense_clarification": "指比赛或竞争的结果"
                            },
                            {
                                "target_lang_word": "输",
                                "target_lang_sense_clarification": "指比赛中的失利"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1dedf55-63f9-305f-ad4b-41f036c9b7ff",
                    "sense_definition": "An amount of money lost by a business or organization.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "financial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company reported a huge <w>loss</w> for the third quarter.",
                            "target_lang_translations": {
                                "ru": "Компания сообщила об огромном <w>убытке</w> за третий квартал.",
                                "zh": "该公司报告第三季度出现了巨额<w>亏损</w>。"
                            }
                        },
                        {
                            "text": "They had to sell the house at a <w>loss</w>.",
                            "target_lang_translations": {
                                "ru": "Им пришлось продать дом в <w>убыток</w>.",
                                "zh": "他们不得不<w>亏本</w>卖掉了房子。"
                            }
                        }
                    ],
                    "antonyms": [
                        "profit",
                        "gain"
                    ],
                    "common_phrases": [
                        "financial loss",
                        "net loss",
                        "operate at a loss"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сумма денег, потерянная бизнесом или организацией.",
                        "zh": "企业或组织亏损的金额。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убы́ток",
                                "target_lang_sense_clarification": "финансовый"
                            },
                            {
                                "target_lang_word": "поте́ря",
                                "target_lang_sense_clarification": "денежная"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "亏损",
                                "target_lang_sense_clarification": "财务上的负收益"
                            },
                            {
                                "target_lang_word": "损失",
                                "target_lang_sense_clarification": "金钱上的减少"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "076f70a8-b0e5-3b5f-9ad6-2561d3b426ce",
                    "sense_definition": "The death of a person or the suffering caused by losing someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "death",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We were deeply saddened to hear of your <w>loss</w>.",
                            "target_lang_translations": {
                                "ru": "Мы были глубоко опечалены известием о вашей <w>утрате</w>.",
                                "zh": "得知您的<w>丧失</w>之痛，我们深感悲痛。"
                            }
                        },
                        {
                            "text": "The army suffered heavy <w>losses</w> during the battle.",
                            "target_lang_translations": {
                                "ru": "Армия понесла тяжелые <w>потери</w> во время битвы.",
                                "zh": "军队在战斗中遭受了惨重的<w>伤亡</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tragic loss",
                        "mourn a loss",
                        "great loss"
                    ],
                    "target_lang_definitions": {
                        "ru": "Смерть человека или страдания, вызванные потерей кого-либо.",
                        "zh": "指人的死亡或因失去某人而遭受的痛苦。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утра́та",
                                "target_lang_sense_clarification": "смерть близкого"
                            },
                            {
                                "target_lang_word": "поте́ря",
                                "target_lang_sense_clarification": "горе или жертвы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "丧失",
                                "target_lang_sense_clarification": "指亲人的离世"
                            },
                            {
                                "target_lang_word": "伤亡",
                                "target_lang_sense_clarification": "指战争或事故中的人员损失"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "091f1b63-ae98-304e-a994-043eb144d399",
                    "sense_definition": "Something that has been completely destroyed or ruined, often used in insurance contexts.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ruin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car was declared a total <w>loss</w> after the accident.",
                            "target_lang_translations": {
                                "ru": "После аварии автомобиль был признан полной <w>утратой</w>.",
                                "zh": "事故发生后，这辆车被认定为<w>全损</w>。"
                            }
                        },
                        {
                            "text": "The fire resulted in the total <w>loss</w> of the building.",
                            "target_lang_translations": {
                                "ru": "Пожар привел к полной <w>утрате</w> здания.",
                                "zh": "火灾导致该建筑彻底<w>报废</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "total loss"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, что было полностью разрушено или уничтожено; часто используется в страховании.",
                        "zh": "指完全被毁坏或报废的事物，常用于保险领域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утра́та",
                                "target_lang_sense_clarification": "имущества"
                            },
                            {
                                "target_lang_word": "уще́рб",
                                "target_lang_sense_clarification": "урон"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "全损",
                                "target_lang_sense_clarification": "保险术语，指完全毁坏"
                            },
                            {
                                "target_lang_word": "报废",
                                "target_lang_sense_clarification": "指物品彻底损坏无法使用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1697cb35-f52f-3bab-952b-f2a347e30584",
                    "sense_definition": "Energy or power that is wasted or escapes during a process.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Good insulation helps prevent heat <w>loss</w> in the winter.",
                            "target_lang_translations": {
                                "ru": "Хорошая изоляция помогает предотвратить <w>потерю</w> тепла зимой.",
                                "zh": "良好的隔热层有助于防止冬季的热量<w>损耗</w>。"
                            }
                        },
                        {
                            "text": "The system is designed to minimize power <w>loss</w> during transmission.",
                            "target_lang_translations": {
                                "ru": "Система разработана для минимизации <w>потерь</w> мощности при передаче.",
                                "zh": "该系统旨在最大限度地减少传输过程中的功率<w>损耗</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "heat loss",
                        "energy loss",
                        "power loss"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Энергия или мощность, которая тратится впустую или уходит во время процесса.",
                        "zh": "在过程中浪费或散失的能量或功率。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поте́ря",
                                "target_lang_sense_clarification": "энергии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "损耗",
                                "target_lang_sense_clarification": "技术上指能量或功率的流失"
                            },
                            {
                                "target_lang_word": "流失",
                                "target_lang_sense_clarification": "指能量的散失"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}