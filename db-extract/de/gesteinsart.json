                "senses": [
                    {
                        "sense_id": "6b1499c7-3d6d-38cc-83ab-96ddf02ad53d",
                        "entry_id": "4cf576fd-0c2d-3ea3-9b2e-d939e321dd95",
                        "glosses": [
                            "von anderen Gesteinen nach bestimmten Merkmalen abgegrenzte Gruppe von Gesteinen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6eaf4417-b225-4f2f-b397-80a2cf2d0922",
                                "sense_id": "6b1499c7-3d6d-38cc-83ab-96ddf02ad53d",
                                "text": "„Typisch für die meist aus Feuerstein und anderen feinkörnigen Gesteinsarten hergestellten Faustkeile ist die durch beiderseitige Abschläge hergestellte dreieckige bis birnenförmige Form.“"
                            },
                            {
                                "example_id": "a420f721-61b3-4c3b-9591-3acf64ba57ff",
                                "sense_id": "6b1499c7-3d6d-38cc-83ab-96ddf02ad53d",
                                "text": "„Hinter dem Eingang lagen schmale Säle mit Schaukästen aus Eichenholz voller Steine und Mineralien, ich schlenderte umher und sah sie mir an, Gesteinsarten aus aller Welt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
