                        "glosses": [
                            "iets wat men gebruikt om anderen ergens toe te dwingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "becc258d-072f-4d4c-af07-13b4be72991b",
                                "sense_id": "4a43151e-9fb7-3d7c-9b07-8b34daf9fccb",
                                "text": "Ik meende er iets van te begrijpen: nu ze zich onverwacht zo had laten gaan, wilde ze tenminste Tonio als pressiemiddel achter de hand houden."
                            },
                            {
                                "example_id": "2fa70577-2067-44e9-b933-bbbb8b9fcfb4",
                                "sense_id": "4a43151e-9fb7-3d7c-9b07-8b34daf9fccb",
                                "text": "Jansen loopt al decennia rond in de mondiale voetbalwereld. Hij verwacht dat de aangekondigde Super League vooral een pressiemiddel is om de overkoepelende instanties zo ver te krijgen dat er veel meer geld naar de Europese topclubs gaat. \"Het is een oud verhaal, dat niet gaat gebeuren. En spelers schorsen kan ook niet.\""
                            }
                        ]
                    }
