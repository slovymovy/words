                        "glosses": [
                            "produkt spożywczy, tłuszcz jadalny podobny do masła, wytwarzany z olejów roślinnych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08176249-c2a4-4644-98d2-30ab995e8fcf",
