{
    "word_family": [
        "opbaren",
        "geboorte",
        "baarlijk"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c8ff16d0-08ae-373e-9a3c-39426c1735fc",
                    "sense_definition": "Onderstel of draagtoestel waarop een overledene of een doodskist wordt opgebaard of vervoerd.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "doodskistdrager",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dragers tilden de zware houten kist voorzichtig van de <w>baar</w>.",
                            "target_lang_translations": {
                                "ru": "Носильщики осторожно сняли тяжелый деревянный гроб с <w>катафалка</w>."
                            }
                        },
                        {
                            "text": "Tijdens de uitvaartdienst stond de kist op een met bloemen versierde <w>baar</w>.",
                            "target_lang_translations": {
                                "ru": "Во время заупокойной службы гроб стоял на украшенном цветами <w>катафалке</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "katafalk",
                        "draagbaar",
                        "lijkbaar",
                        "lijkbed"
                    ],
                    "common_phrases": [
                        "op de baar"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подставка или носилки, на которых устанавливают или переносят гроб с умершим."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "катафалк",
                                "target_lang_sense_clarification": "постамент или подставка для гроба"
                            },
                            {
                                "target_lang_word": "дроги",
                                "target_lang_sense_clarification": "погребальные носилки или подставка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf1c0d30-8df6-33e7-8770-f65269656d92",
                    "sense_definition": "Gegoten blok of staaf van een kostbaar metaal, zoals goud of zilver.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "metaalstaaf",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de zwaarbeveiligde kluis lag een massieve <w>baar</w> goud te glanzen.",
                            "target_lang_translations": {
                                "ru": "В особо охраняемом сейфе поблескивал массивный <w>слиток</w> золота."
                            }
                        },
                        {
                            "text": "De centrale bank bewaart vele tonnen edelmetaal in de vorm van zilveren en gouden <w>baren</w>.",
                            "target_lang_translations": {
                                "ru": "Центральный банк хранит многие тонны драгоценных металлов в виде серебряных и золотых <w>слитков</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "staaf"
                    ],
                    "common_phrases": [
                        "baar goud",
                        "baar zilver"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отлитый брусок из драгоценного металла, такого как золото или серебро."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слиток",
                                "target_lang_sense_clarification": "брусок драгоценного металла"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20f31f6a-a363-3073-8d15-8e44bbb79ac9",
                    "sense_definition": "Hoge golf op zee of ander open water.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "watergolf",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het schip vocht urenlang tegen de woeste <w>baren</w> van de noordelijke oceaan.",
                            "target_lang_translations": {
                                "ru": "Корабль часами боролся с буйными <w>валами</w> северного океана."
                            }
                        },
                        {
                            "text": "Vele zeelui vonden vroeger hun graf in de onstuimige <w>baren</w>.",
                            "target_lang_translations": {
                                "ru": "Многие моряки в былые времена нашли свою могилу в бурных <w>волнах</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "golf"
                    ],
                    "common_phrases": [
                        "de woeste baren"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Vaak in literair of poëtisch taalgebruik, meestal in het meervoud."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Высокая волна в море или другом водоеме (преимущественно поэтическое или устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вал",
                                "target_lang_sense_clarification": "высокая морская волна"
                            },
                            {
                                "target_lang_word": "волна",
                                "target_lang_sense_clarification": "морская волна"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "422dd021-f266-3425-a0f2-f236c7bfcc48",
                    "sense_definition": "Onervaren persoon of nieuwkomer, oorspronkelijk gezegd van een Europeaan die pas in Nederlands-Indië was aangekomen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nieuwkomer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen hij pas van boord stapte, werd hij door de ervaren kolonisten direct als een <w>baar</w> behandeld.",
                            "target_lang_translations": {
                                "ru": "Как только он сошел на берег, опытные колонисты сразу стали относиться к нему как к <w>новичку</w>."
                            }
                        },
                        {
                            "text": "De bemanning maakte grapjes over de jonge <w>baar</w> die nog alles moest leren over de tropen.",
                            "target_lang_translations": {
                                "ru": "Экипаж подшучивал над молодым <w>зеленым новичком</w>, которому еще только предстояло узнать все о тропиках."
                            }
                        }
                    ],
                    "synonyms": [
                        "groentje",
                        "nieuweling"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historische koloniale term."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неопытный человек, новичок (исторически — европеец, только прибывший в Голландскую Ост-Индию)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "новичок",
                                "target_lang_sense_clarification": "неопытный человек"
                            },
                            {
                                "target_lang_word": "салага",
                                "target_lang_sense_clarification": "разговорное о неопытном новоприбывшем"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "86451dea-9aa2-3a61-88df-32ced276ef99",
                    "sense_definition": "Uitsluitend gezegd van geld: contant, in tastbare munten of biljetten aanwezig.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "contant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij deze transactie eiste de verkoper de betaling in <w>baar</w> geld te ontvangen.",
                            "target_lang_translations": {
                                "ru": "При этой сделке продавец потребовал оплату <w>наличными</w> деньгами."
                            }
                        },
                        {
                            "text": "Helaas had de reiziger geen <w>baar</w> geld bij zich om de taxichauffeur te betalen.",
                            "target_lang_translations": {
                                "ru": "К сожалению, у путешественника не было с собой <w>наличных</w> денег, чтобы заплатить таксисту."
                            }
                        }
                    ],
                    "synonyms": [
                        "cash",
                        "contant"
                    ],
                    "common_phrases": [
                        "baar geld"
                    ],
                    "target_lang_definitions": {
                        "ru": "О деньгах: наличный, в виде монет или банкнот."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наличный",
                                "target_lang_sense_clarification": "о деньгах"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e9fd9a62-03f4-3d24-9e96-ce0ba6cf0f46",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van het werkwoord <w>baren</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als arts <w>baar</w> ik zelf geen kinderen op deze afdeling, maar begeleid ik patiënten.",
                            "target_lang_translations": {
                                "ru": "Как врач я сама не <w>рожаю</w> детей в этом отделении, а веду пациентов."
                            }
                        },
                        {
                            "text": "Ik <w>baar</w> mijn kind het liefst in een rustige en vertrouwde thuisomgeving.",
                            "target_lang_translations": {
                                "ru": "Я предпочитаю <w>рожать</w> своего ребенка в спокойной и привычной домашней обстановке."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Vorm van baren."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма первого лица единственного числа настоящего времени от глагола baren (рожать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рожаю",
                                "target_lang_sense_clarification": "1-е л. ед. ч. наст. вр."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}