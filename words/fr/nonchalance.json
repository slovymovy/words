{
    "word_family": [
        "nonchalant",
        "nonchaloir"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "44642f90-9e93-304f-b746-15a5032e63ee",
                    "sense_definition": "Manque d'ardeur, d'empressement ou d'application ; négligence et apathie dans les actions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nonchalance_attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'acquitte de son travail avec une telle <w>nonchalance</w> qu'il commet sans cesse de graves erreurs."
                        },
                        {
                            "text": "Son responsable ne supporte plus sa <w>nonchalance</w> quotidienne et son manque d'implication dans l'équipe."
                        }
                    ],
                    "synonyms": [
                        "indolence",
                        "négligence",
                        "apathie"
                    ],
                    "antonyms": [
                        "empressement",
                        "zèle",
                        "ardeur"
                    ],
                    "common_phrases": [
                        "avec nonchalance",
                        "faire preuve de nonchalance"
                    ]
                },
                {
                    "sense_id": "49e30d0b-23c3-3544-b91e-647e9caa222c",
                    "sense_definition": "Attitude ou allure empreinte d'une mollesse paisible ou d'une langueur souvent gracieuse.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nonchalance_attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chat s'étirait sur le tapis avec une <w>nonchalance</w> tout à fait gracieuse."
                        },
                        {
                            "text": "Il marchait les mains dans les poches, affichant une <w>nonchalance</w> feinte pour dissimuler son angoisse."
                        }
                    ],
                    "synonyms": [
                        "langueur",
                        "désinvolture",
                        "mollesse"
                    ],
                    "antonyms": [
                        "vivacité",
                        "énergie"
                    ],
                    "common_phrases": [
                        "nonchalance naturelle",
                        "nonchalance feinte"
                    ]
                },
                {
                    "sense_id": "4102aca5-643e-313a-89bb-bb0f1348a3ce",
                    "sense_definition": "État de doux relâchement ou d'insouciance tranquille où l'on se complaît volontiers.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nonchalance_attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Durant les vacances d'été, nous nous laissions bercer par une douce <w>nonchalance</w> au bord de la mer."
                        },
                        {
                            "text": "Après des mois de labeur épuisant, cette délicieuse <w>nonchalance</w> lui apportait enfin la paix d'esprit."
                        }
                    ],
                    "synonyms": [
                        "insouciance",
                        "oisiveté"
                    ],
                    "antonyms": [
                        "rigueur"
                    ],
                    "common_phrases": [
                        "douce nonchalance"
                    ]
                }
            ]
        }
    ]
}