                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2768fe86-3669-48f7-83d4-d9c2d7461667",
                                "sense_id": "1b9ba003-5857-36b0-9199-028ad3744eba",
                                "text": "Ce fut la fin des messes & du caté pré-scolaires de ce lève-tôt de Fennèque ; avec ça l’abbé nouveau faisait aussi faire du théâtre aux enfants & aux jeunes."
                            }
                        ]
                    }
                ],
