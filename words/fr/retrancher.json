{
    "word_family": [
        "retranchement",
        "tranchant",
        "tranche",
        "tranchée",
        "trancher"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3fbc6cb9-11a3-37f4-9307-32bc7b86fc11",
                    "sense_definition": "Séparer ou enlever une partie d'un tout ; supprimer un passage ou un élément inutile.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "suppression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'auteur a décidé de <w>retrancher</w> quelques paragraphes trop longs pour alléger le texte."
                        },
                        {
                            "text": "Ce manuscrit est si bien équilibré qu'il n'y a absolument rien à <w>retrancher</w>."
                        }
                    ],
                    "synonyms": [
                        "ôter"
                    ],
                    "common_phrases": [
                        "rien à retrancher",
                        "retrancher une partie"
                    ]
                },
                {
                    "sense_id": "afbae23f-8a4d-39fb-b12f-89b9c37211f3",
                    "sense_definition": "Déduire une quantité ou une somme d'une autre ; soustraire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "soustraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il convient de <w>retrancher</w> les taxes du montant global pour calculer le prix hors taxe."
                        },
                        {
                            "text": "Le comptable <w>retranche</w> les dépenses imprévues avant de présenter le bilan final."
                        }
                    ],
                    "synonyms": [
                        "soustraire"
                    ],
                    "common_phrases": [
                        "retrancher une somme"
                    ]
                },
                {
                    "sense_id": "3666db59-b24c-3fee-9f4d-74720c9b7327",
                    "sense_definition": "Se mettre à l'abri d'un danger ou s'enfermer dans une attitude défensive en invoquant un prétexte.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "defense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'accusé a choisi de se <w>retrancher</w> dans un silence obstiné durant tout le procès."
                        },
                        {
                            "text": "Face aux critiques des journalistes, le ministre a préféré se <w>retrancher</w> derrière la loi."
                        }
                    ],
                    "common_phrases": [
                        "se retrancher dans le silence",
                        "se retrancher derrière"
                    ]
                },
                {
                    "sense_id": "061d22a3-9c54-34b0-9a63-13bac9a834da",
                    "sense_definition": "Munir un camp ou une position de fossés et d'ouvrages défensifs pour résister à l'ennemi.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le général donna l'ordre de <w>retrancher</w> la colline afin de bloquer l'avancée adverse."
                        },
                        {
                            "text": "Les soldats ont passé la nuit à <w>retrancher</w> leur camp contre les attaques nocturnes."
                        }
                    ],
                    "synonyms": [
                        "fortifier"
                    ],
                    "common_phrases": [
                        "retrancher un camp"
                    ]
                }
            ]
        }
    ]
}