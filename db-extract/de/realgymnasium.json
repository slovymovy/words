                "senses": [
                    {
                        "sense_id": "dc4ef463-ac2a-38eb-9c1c-32a4b2721c7b",
                        "entry_id": "cae98ae6-1e1e-3777-b08f-d23024ecd56f",
                        "glosses": [
                            "in Deutschland veraltete Bezeichnung, in Österreich und der Schweiz noch gebräuchlich: Gymnasium mit einem Schwerpunkt in naturwissenschaftlichen Fächern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb8cd80c-18a1-4d37-8fe6-921ca3709082",
                                "sense_id": "dc4ef463-ac2a-38eb-9c1c-32a4b2721c7b",
                                "text": "„Nur noch Ludwig, der Quintaner, besuchte die Höhere Schule - unverdrossen, jeden Morgen von Lea mit einem frischen Hemd versehen, fuhr er mit dem Rad zum Realgymnasium Averhoffstraße auf der Uhlenhorst.“"
                            },
                            {
                                "example_id": "51d8ac2c-2e75-4c03-80e5-eee7845810bb",
                                "sense_id": "dc4ef463-ac2a-38eb-9c1c-32a4b2721c7b",
                                "text": "„Das Gymnasium für Berufstätige, das Realgymnasium für Berufstätige und das Wirtschaftskundliche Realgymnasium für Berufstätige umfassen acht Semester.“"
                            },
                            {
                                "example_id": "a9e49630-1dfd-4ef1-b0fa-08b4325a9165",
                                "sense_id": "dc4ef463-ac2a-38eb-9c1c-32a4b2721c7b",
                                "text": "„Hungermann, als Deutschlehrer am Realgymnasium, hat Arthur erpreßt, da er sonst einen andern Buchhändler an seiner Schule empfehlen würde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
