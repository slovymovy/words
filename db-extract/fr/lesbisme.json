                        "sense_id": "70c67656-fcb9-3e1c-b47e-0effc9cfc886",
                        "entry_id": "69dca2b2-791e-3c12-93ff-a746be270ec8",
                        "glosses": [
                            "Synonyme de lesbianisme."
