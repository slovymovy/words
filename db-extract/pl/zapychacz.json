                ],
                "senses": [
                    {
                        "sense_id": "1919bab7-4f2c-374a-87c5-4e09facba83e",
                        "entry_id": "ff49cdfb-88aa-386c-b493-29b13a495aa6",
                        "glosses": [
                            "pokarm jedzony dla zabicia głodu, dający uczucia sytości na dłużej, często, choć nie zawsze, o niskiej wartości odżywczej"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "b2d7c3e7-0b31-4452-868a-4fcb3c38a275",
                                "sense_id": "1919bab7-4f2c-374a-87c5-4e09facba83e",
                                "text": "Owsianka to zdrowy zapychacz: jedząc ją, można dłużej wytrzymać do kolejnego posiłku."
                            },
                            {
                                "example_id": "86e9c9b9-3540-4050-86ce-90e5bab414f8",
                                "sense_id": "1919bab7-4f2c-374a-87c5-4e09facba83e",
                                "text": "(…) nawet chleb pszenny (który zwykle się podaje w przedszkolach) może bardziej zaszkodzić niż pomóc, bo działa jako zwykły zapychacz – ani tam witamin, ani błonnika ani nic poza węglowodanami."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "6a269039-81c5-3f1a-8b25-f26994afcb7e",
                        "entry_id": "ff49cdfb-88aa-386c-b493-29b13a495aa6",
                        "glosses": [
                            "składnik kosmetyku o właściwościach zatykających, zapychających pory skóry"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "0d130fd9-85e1-4929-b4b0-71e582dff948",
                                "sense_id": "6a269039-81c5-3f1a-8b25-f26994afcb7e",
                                "text": "Przy zakupie kremu kieruję się jego składem – unikam tych produktów, które zawierają potencjalne zapychacze."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "64f002f0-5149-3465-ab4f-e8a0b4e3a9ef",
                        "entry_id": "ff49cdfb-88aa-386c-b493-29b13a495aa6",
                        "glosses": [
                            "kosmetyk zatykający pory skóry"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "f12057e2-ef3a-4380-93c6-d7c1ec2e1aa2",
                                "sense_id": "64f002f0-5149-3465-ab4f-e8a0b4e3a9ef",
                                "text": "Jeśli już padliśmy ofiarą zapychacza, możemy sięgnąć po maseczkę z aspiryny."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
