                ],
                "senses": [
                    {
                        "sense_id": "8b79f5cf-9779-3687-bdc8-748957684c1d",
                        "entry_id": "8eb13108-0791-3d72-ad6d-9c5eb37b0cde",
                        "glosses": [
                            "tamelijk klein door de mens aangelegd water"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd0e3a5f-872d-473b-9161-296396f651bc",
                                "sense_id": "8b79f5cf-9779-3687-bdc8-748957684c1d",
                                "text": "Terwijl ik goedkeurend met mijn vinger langs de vergulde lambrisering streek, de dikte voelde van de stof van de zware, oker overgordijnen en de stoel wegschoof om de openslaande deuren te openen naar het terras, dat uitzicht bood op de rozentuin, of wat daarvan over was, en de vijver met de defecte fontein, bedacht ik dat ik nog tijd genoeg zou hebben om deze kamer en detail te beschrijven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0fd691e-6502-4cc0-9087-6c215007783e",
                        "source_entry_id": "8eb13108-0791-3d72-ad6d-9c5eb37b0cde",
                        "source_sense_id": "8b79f5cf-9779-3687-bdc8-748957684c1d",
                        "source_sense_description": "tamelijk klein door de mens aangelegd water",
                        "target_lang_word": "Teich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Teich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ae45b68-de21-37a4-9c07-2d9cd831a798",
                                        "entry_id": "f4a2924e-5eec-3562-bc48-fd54ea1a4432",
                                        "glosses": [
                                            "kleiner See; kleines stehendes Gewässer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "516a231b-79e0-4ad7-ae69-9674207d87d7",
                                                "sense_id": "5ae45b68-de21-37a4-9c07-2d9cd831a798",
                                                "text": "Wir haben in unserem Teich dieses Jahr wieder zwei Frösche."
                                            },
                                            {
                                                "example_id": "83ec470c-7c82-4bbe-ad19-a0331f9a947d",
                                                "sense_id": "5ae45b68-de21-37a4-9c07-2d9cd831a798",
                                                "text": "„Die Chauffeure fuhren die schweren, olivgrünen Wagen um den Teich herum und parkten sie ausgerichtet nebeneinander.“"
                                            },
                                            {
                                                "example_id": "0476a6dc-c1ec-42b1-94c5-ba8a3762facb",
                                                "sense_id": "5ae45b68-de21-37a4-9c07-2d9cd831a798",
                                                "text": "„Wir gingen zum Teich, ohne ein Wort zu reden.“"
                                            },
                                            {
                                                "example_id": "7d8bd8a2-3b13-4259-a789-b38c0eb684b8",
                                                "sense_id": "5ae45b68-de21-37a4-9c07-2d9cd831a798",
                                                "text": "„Es war nicht so leicht herauszubekommen, wem der Teich gehörte und wem die Enten, die im Teich schwammen.“"
                                            },
                                            {
                                                "example_id": "c801db88-19e0-4120-a780-c4ca5274cad5",
                                                "sense_id": "5ae45b68-de21-37a4-9c07-2d9cd831a798",
                                                "text": "„Der goldrote Himmel spiegelte sich in der Oberfläche des Teichs, und die schwarzen Stämme der Zypressen schnitten durch das Goldrot.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53052f8d-8e8a-460b-8c1a-04e71adb4558",
                        "source_entry_id": "8eb13108-0791-3d72-ad6d-9c5eb37b0cde",
                        "source_sense_id": "8b79f5cf-9779-3687-bdc8-748957684c1d",
                        "source_sense_description": "tamelijk klein door de mens aangelegd water",
                        "target_lang_word": "Weiher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weiher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7807217a-dbb6-30ae-8f04-8b8392b3f1ce",
                                        "entry_id": "809efce1-0200-389e-ba73-2bd11857e567",
                                        "glosses": [
                                            "kleiner, flacher See, stehendes Gewässer, Teich, Fischgewässer"
                                        ],
                                        "tags": [
                                            "geography",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89da8cb5-3186-47f2-86c0-9c3baa6661de",
                                                "sense_id": "7807217a-dbb6-30ae-8f04-8b8392b3f1ce",
                                                "text": "Am nördlichen Ortsausgang befinden sich einige Weiher, in denen heute Fische gezüchtet werden."
                                            },
                                            {
                                                "example_id": "1481cc09-079c-4a27-8ee4-5016b910937d",
                                                "sense_id": "7807217a-dbb6-30ae-8f04-8b8392b3f1ce",
                                                "text": "„Der Weiher lag ziemlich genau in der Mitte zwischen den Häusern unserer Eltern.“"
                                            },
                                            {
                                                "example_id": "f74edc44-4f47-404a-ba43-df27cc0225d9",
                                                "sense_id": "7807217a-dbb6-30ae-8f04-8b8392b3f1ce",
                                                "text": "„Auf der Lichtung mit dem kleinen Weiher betraten sie die hölzerne Brücke, die den schmalen Auslauf des Teiches überspannte.“"
                                            },
                                            {
                                                "example_id": "17fefb6c-7f40-4443-8202-e745ecc877e9",
                                                "sense_id": "7807217a-dbb6-30ae-8f04-8b8392b3f1ce",
                                                "text": "„Das hintere Tor stieß an einen Weiher.“"
                                            },
                                            {
                                                "example_id": "aa569b63-297c-4f0d-8b27-ccca785daab9",
                                                "sense_id": "7807217a-dbb6-30ae-8f04-8b8392b3f1ce",
                                                "text": "„Inmitten des Weihers hatte man eine Klippe gebaut, aus der vier Wasserstrahlen in halber Speerhöhe emporsprühten, um im Absturz wieder in den Weiher zu fallen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0ba246a8-b158-3233-8334-f563e6d7d904",
                                        "entry_id": "809efce1-0200-389e-ba73-2bd11857e567",
                                        "glosses": [
                                            "natürliches, langlebiges Gewässer ohne Tiefenschicht"
                                        ],
                                        "tags": [
                                            "Limnologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e54fcd3-1d75-4b01-80cf-02b2d2ac467d",
                                                "sense_id": "0ba246a8-b158-3233-8334-f563e6d7d904",
                                                "text": "Ein Weiher hat keine lichtarmen Tiefenzonen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22f4b335-aac0-491a-a12a-a5e8dd3ce882",
                        "source_entry_id": "8eb13108-0791-3d72-ad6d-9c5eb37b0cde",
                        "source_sense_id": "8b79f5cf-9779-3687-bdc8-748957684c1d",
                        "source_sense_description": "tamelijk klein door de mens aangelegd water",
                        "target_lang_word": "pond",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pond",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07a67ede-768f-3454-86a3-61bbe49ae875",
                                        "entry_id": "d7dcade3-0067-3b9a-9cbb-3f9b2322f42e",
                                        "glosses": [
                                            "An inland body of standing water, either natural or man-made, that is smaller than a lake."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9b760bd-a0c1-4cc1-8253-74a1ba49e2bd",
                                                "sense_id": "07a67ede-768f-3454-86a3-61bbe49ae875",
                                                "text": "But when the moon rose and the breeze awakened, and the sedges stirred, and the cat's-paws raced across the moonlit ponds, and the far surf off Wonder Head intoned the hymn of the four winds, the trinity, earth and sky and water, became one thunderous symphony—a harmony of sound and colour silvered to a monochrome by the moon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fd35895-d490-33e1-9fbe-c0484a728d6e",
                                        "entry_id": "d7dcade3-0067-3b9a-9cbb-3f9b2322f42e",
                                        "glosses": [
                                            "An inland body of standing water of any size that is fed by springs rather than by a river."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "276e3879-76d2-33e2-a1e6-a97fb038cf32",
                                        "entry_id": "d7dcade3-0067-3b9a-9cbb-3f9b2322f42e",
                                        "glosses": [
                                            "Chiefly in across the pond: the Atlantic Ocean."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2e4fb2e-c81e-4eae-8e01-1b9ce5995de4",
                                                "sense_id": "276e3879-76d2-33e2-a1e6-a97fb038cf32",
                                                "text": "I wonder how they do this on the other side of the pond."
                                            },
                                            {
                                                "example_id": "6bb252db-8073-48fe-b277-0ac3386d4d6f",
                                                "sense_id": "276e3879-76d2-33e2-a1e6-a97fb038cf32",
                                                "text": "I haven’t been back home across the pond in twenty years."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pond",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d11b581b-8701-3239-bebb-b72034fd99d8",
                                        "entry_id": "d2977391-09c0-3a9f-bec5-6d83b5feae1d",
                                        "glosses": [
                                            "To block the flow of water so that it can escape only through evaporation or seepage; to dam."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cc7bd77-fbe0-4163-943c-51756921f463",
                                                "sense_id": "d11b581b-8701-3239-bebb-b72034fd99d8",
                                                "text": "The rate of fall of the surface of water ponded over the soil within the ring gives a measure of the infiltration rate for the particular enclosed area."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "906b1fa7-010f-3d79-9c81-413eb6ce5e44",
                                        "entry_id": "d2977391-09c0-3a9f-bec5-6d83b5feae1d",
                                        "glosses": [
                                            "To make into a pond; to collect, as water, in a pond by damming."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8ce81ec8-1dd4-3701-933d-8fb89bda6fb3",
                                        "entry_id": "d2977391-09c0-3a9f-bec5-6d83b5feae1d",
                                        "glosses": [
                                            "To form a pond; to pool."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "pond",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b26128f4-c620-3177-a291-cc78d0b32398",
                                        "entry_id": "aad2507f-4d0c-3cf7-ad51-069ccd5e251e",
                                        "glosses": [
                                            "To ponder."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4abb405-6073-4b5e-9c23-3b70df3d4f1c",
                                                "sense_id": "b26128f4-c620-3177-a291-cc78d0b32398",
                                                "text": "Pleaseth you, pond your suppliant's plaint."
                                            }
