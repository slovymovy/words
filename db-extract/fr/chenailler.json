                    }
                ],
                "senses": [
                    {
                        "sense_id": "143d9f98-4274-3dc8-abce-16de771bbf8a",
                        "entry_id": "542cd04c-5429-3cc8-8b6a-55ee70985187",
                        "glosses": [
                            "Sorte d'appareil qui était utilisé pour évaporer l'eau de solutions ou de jus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b77b9c24-b7fc-4066-b996-2be350fe1710",
                                "sense_id": "143d9f98-4274-3dc8-abce-16de771bbf8a",
                                "text": "[…] saturation avec de la chaux et du carbonate de chaux ; décantation et concentration de la liqueur neutre dans un appareil Chenailler, où se précipite le chlorure de sodium ; nouvelle concentration dans un second chenailler."
                            },
                            {
                                "example_id": "6c5feec6-5d6b-412b-8a3c-dd6c2edab8b3",
                                "sense_id": "143d9f98-4274-3dc8-abce-16de771bbf8a",
                                "text": "Tout le monde reconnaissait, d’autre part, que le chenailler servait à provoquer l’évaporation de l’eau : or, d’où vient l’évaporation, si ce n’est de la chaleur ; le chenailler sert donc bien à chauffer l’eau ; c’est une chaudière."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
