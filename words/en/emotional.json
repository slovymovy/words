{
    "word_family": [
        "emotion",
        "emotionally",
        "emotionless",
        "emotive"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e33b01c1-e135-3ab6-896b-908771457aef",
                    "sense_definition": "Having strong feelings and showing them easily; sensitive or temperamental.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is an <w>emotional</w> person who cries at every sad movie.",
                            "target_lang_translations": {
                                "ru": "Она <w>эмоциональный</w> человек, который плачет над каждым грустным фильмом.",
                                "zh": "她是一个很<w>感性</w>的人，看每部悲伤的电影都会哭。"
                            }
                        },
                        {
                            "text": "He gets very <w>emotional</w> whenever he talks about his childhood.",
                            "target_lang_translations": {
                                "ru": "Он становится очень <w>эмоциональным</w>, когда говорит о своём детстве.",
                                "zh": "每当谈起童年，他都会变得非常<w>激动</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "temperamental",
                        "demonstrative",
                        "passionate",
                        "sentimental",
                        "effusive",
                        "sensitive"
                    ],
                    "common_phrases": [
                        "emotional person",
                        "highly emotional",
                        "get emotional"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий сильными чувствами и легко их проявляющий; чувствительный или темпераментный.",
                        "zh": "指人容易产生强烈情感并表现出来；敏感或情绪化。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эмоциональный",
                                "target_lang_sense_clarification": "легко выражающий чувства"
                            },
                            {
                                "target_lang_word": "чувствительный",
                                "target_lang_sense_clarification": "легко поддающийся эмоциям"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "情绪化",
                                "target_lang_sense_clarification": "指人容易受情绪影响"
                            },
                            {
                                "target_lang_word": "感性",
                                "target_lang_sense_clarification": "指人容易流露情感"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09f25ac4-3d65-38d6-8cd7-41f5317aa9aa",
                    "sense_definition": "Feeling a strong urge to cry because of happiness, sadness, or gratitude.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I became quite <w>emotional</w> when I saw my old friends again.",
                            "target_lang_translations": {
                                "ru": "Я был очень <w>растроган</w>, когда снова увидел своих старых друзей.",
                                "zh": "再次见到老朋友时，我感到非常<w>激动</w>。"
                            }
                        },
                        {
                            "text": "The winner felt <w>emotional</w> as she accepted the award on stage.",
                            "target_lang_translations": {
                                "ru": "Победительница была <w>растрогана</w>, принимая награду на сцене.",
                                "zh": "获奖者在台上领奖时感到十分<w>激动</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "moved",
                        "overwhelmed",
                        "overcome",
                        "touched"
                    ],
                    "common_phrases": [
                        "become emotional",
                        "feel emotional",
                        "get emotional"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывающий сильное желание заплакать от счастья, грусти или благодарности.",
                        "zh": "因快乐、悲伤或感激而产生强烈的想哭的冲动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "растроганный",
                                "target_lang_sense_clarification": "охваченный чувствами"
                            },
                            {
                                "target_lang_word": "взволнованный",
                                "target_lang_sense_clarification": "находящийся в состоянии волнения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "激动",
                                "target_lang_sense_clarification": "指情绪因受刺激而变得强烈"
                            },
                            {
                                "target_lang_word": "感伤",
                                "target_lang_sense_clarification": "指因触动心事而产生悲伤或怀旧的情绪"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da38d6f7-5123-3d4e-8e63-46d2bda1966f",
                    "sense_definition": "Relating to feelings and the way people react to things.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "relational",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Children need physical care and <w>emotional</w> support to grow up healthy.",
                            "target_lang_translations": {
                                "ru": "Детям нужна физическая забота и <w>эмоциональная</w> поддержка, чтобы расти здоровыми.",
                                "zh": "孩子们需要身体上的照顾和<w>情感</w>支持才能健康成长。"
                            }
                        },
                        {
                            "text": "The job requires a high level of <w>emotional</w> intelligence.",
                            "target_lang_translations": {
                                "ru": "Эта работа требует высокого уровня <w>эмоционального</w> интеллекта.",
                                "zh": "这份工作需要高水平的<w>情感</w>智力。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "emotional support",
                        "emotional intelligence",
                        "emotional health",
                        "emotional abuse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к чувствам и тому, как люди реагируют на происходящее.",
                        "zh": "与情感及人们对事物的反应方式有关。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эмоциональный",
                                "target_lang_sense_clarification": "связанный с эмоциями"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "情感",
                                "target_lang_sense_clarification": "指与心理感受相关的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3dc7630-fc5e-350a-954b-046ec83f5200",
                    "sense_definition": "Causing strong feelings; making people feel sad, sympathetic, or touched.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "causative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was an <w>emotional</w> reunion for the family after ten years apart.",
                            "target_lang_translations": {
                                "ru": "Это было <w>трогательное</w> воссоединение семьи после десяти лет разлуки.",
                                "zh": "对于这个分离十年的家庭来说，这是一次<w>感人</w>的重逢。"
                            }
                        },
                        {
                            "text": "The director gave an <w>emotional</w> speech thanking the cast and crew.",
                            "target_lang_translations": {
                                "ru": "Режиссёр произнёс <w>эмоциональную</w> речь, поблагодарив актёров и съёмочную группу.",
                                "zh": "导演发表了一番<w>动人</w>的演讲，感谢了演职人员。"
                            }
                        }
                    ],
                    "synonyms": [
                        "touching",
                        "poignant",
                        "affecting",
                        "heartrending",
                        "emotive",
                        "gripping",
                        "dramatic",
                        "soul stirring",
                        "heartbreaking"
                    ],
                    "common_phrases": [
                        "emotional speech",
                        "emotional moment",
                        "emotional scene"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий сильные чувства; заставляющий людей грустить, сочувствовать или умиляться.",
                        "zh": "引起强烈情感的；使人感到悲伤、同情或感动的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трогательный",
                                "target_lang_sense_clarification": "вызывающий умиление или грусть"
                            },
                            {
                                "target_lang_word": "волнующий",
                                "target_lang_sense_clarification": "заставляющий переживать"
                            },
                            {
                                "target_lang_word": "эмоциональный",
                                "target_lang_sense_clarification": "наполненный эмоциями"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "感人",
                                "target_lang_sense_clarification": "指使人感动"
                            },
                            {
                                "target_lang_word": "动人",
                                "target_lang_sense_clarification": "指触动人心"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb9a3d74-cd46-36fd-86f9-f3692a4add42",
                    "sense_definition": "Based on feelings rather than facts or reason.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "logic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Buying a house is often an <w>emotional</w> decision rather than a financial one.",
                            "target_lang_translations": {
                                "ru": "Покупка дома — это часто <w>эмоциональное</w> решение, а не финансовое.",
                                "zh": "买房往往是一个<w>感情用事</w>的决定，而非财务上的考量。"
                            }
                        },
                        {
                            "text": "He made an <w>emotional</w> response instead of thinking about the consequences.",
                            "target_lang_translations": {
                                "ru": "Он дал <w>эмоциональный</w> ответ вместо того, чтобы подумать о последствиях.",
                                "zh": "他做出了<w>情绪化</w>的反应，而没有考虑后果。"
                            }
                        }
                    ],
                    "synonyms": [
                        "passionate"
                    ],
                    "common_phrases": [
                        "emotional decision",
                        "emotional response",
                        "emotional appeal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Основанный на чувствах, а не на фактах или разуме.",
                        "zh": "基于情感而非事实或理性的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эмоциональный",
                                "target_lang_sense_clarification": "продиктованный чувствами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "感情用事",
                                "target_lang_sense_clarification": "指凭个人感情处理事情"
                            },
                            {
                                "target_lang_word": "情绪化",
                                "target_lang_sense_clarification": "指受情绪支配而非理性"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "01b673b4-82ad-3971-a7f8-bb6d9fe75628",
                    "sense_definition": "A person who is easily affected by emotion.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is such an <w>emotional</w> that he weeps at the slightest provocation.",
                            "target_lang_translations": {
                                "ru": "Он такой <w>эмоциональный человек</w>, что плачет по малейшему поводу.",
                                "zh": "他是个非常<w>感性的人</w>，稍微受点刺激就会流泪。"
                            }
                        },
                        {
                            "text": "The group therapy session was full of <w>emotionals</w> sharing their feelings.",
                            "target_lang_translations": {
                                "ru": "Сеанс групповой терапии был полон <w>эмоциональных людей</w>, делящихся своими чувствами.",
                                "zh": "团体治疗课上坐满了分享自己感受的<w>感性的人</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "rarely used as a noun in standard English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, на которого легко влияют эмоции.",
                        "zh": "容易受情绪影响的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эмоциональный человек",
                                "target_lang_sense_clarification": "личность, подверженная эмоциям"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "感性的人",
                                "target_lang_sense_clarification": "指容易受情绪影响的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}