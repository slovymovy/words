                "senses": [
                    {
                        "sense_id": "1e5c030d-cf1b-3df7-91dc-321fd431112b",
                        "entry_id": "2a86b46c-f303-3450-81d3-4ecca0aea3b1",
                        "glosses": [
                            "„Winkel, unter dem ein Strahl in ein Medium eintritt“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2941de97-05fc-4b59-9c9a-09bff0dfe7b6",
                                "sense_id": "1e5c030d-cf1b-3df7-91dc-321fd431112b",
                                "text": "„Die Kugelgestalt der Erde hat unterschiedliche Einfallswinkel der Sonnenstrahlung und damit eine ungleiche Verteilung der zugeführten Energie zur Folge.“"
                            },
                            {
                                "example_id": "5fb9af10-87b6-4b08-bbe1-871ba0d007f7",
                                "sense_id": "1e5c030d-cf1b-3df7-91dc-321fd431112b",
                                "text": "„So wie die Temperaturen vom Äquator zu den Polen durch den abnehmenden Einfallswinkel der Sonnenstrahlen immer weiter abfallen, sinken die Celsiusgrade im Gebirge mit zunehmender Höhe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
