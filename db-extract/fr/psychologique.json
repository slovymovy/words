                                                "sense_id": "cb5c45e4-11de-3580-99d4-e4e71d59444a",
                                                "text": "I'm concerned about their psychological well-being."
                                            },
                                            {
                                                "example_id": "1d48ade0-bb11-4620-9355-a77635a4dd71",
                                                "sense_id": "cb5c45e4-11de-3580-99d4-e4e71d59444a",
                                                "text": "The film was a dark psychological thriller."
                                            },
                                            {
                                                "example_id": "35de4f32-1858-46b7-b82e-26c08f276ffe",
                                                "sense_id": "cb5c45e4-11de-3580-99d4-e4e71d59444a",
                                                "text": "In mild cases of hypergonadism prior to puberty, the onset of physical and mood changes may not be abnormally early or significant enough to cause any psychological or long-term physical complications."
