                    {
                        "sense_id": "75b2a4be-c6da-38e4-aa68-8617bdac5be6",
                        "entry_id": "bbf3501d-dae7-3056-8d9e-38146cf07b56",
                        "glosses": [
                            "Hoofdstad van de autonome regio Sicilië"
