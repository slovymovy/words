                    },
                    {
                        "form_id": "f858f44e-11aa-4bc2-86b5-24e4ac3b5eb7",
                        "entry_id": "ae056ec3-02da-3893-b2d7-4183279d7a70",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind unzurechenbar"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e427793d-5a43-3fee-a712-a6e7a115cbae",
                        "entry_id": "ae056ec3-02da-3893-b2d7-4183279d7a70",
                        "glosses": [
                            "so, dass es nicht zugerechnet werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "729f77d2-29bc-4744-8e9f-9f6b1bbb06bc",
                                "sense_id": "e427793d-5a43-3fee-a712-a6e7a115cbae",
                                "text": "„Alles, was der Täter als direkte oder indirekte Folge seiner äußeren oder inneren Handlung voraussehen mußte, ist zurechenbar, was er nicht voraussehen konnte, ist unzurechenbar; was er voraussehen konnte und nicht vorausgesehen hat, wird strafbar, wenn er es hätte voraussehen sollen.“"
                            },
                            {
                                "example_id": "e85da1de-4701-4fc4-aba5-a1ff880184dd",
                                "sense_id": "e427793d-5a43-3fee-a712-a6e7a115cbae",
                                "text": "„Fehlt es an diesem Kriterium, handelt der Suizident also etwa unzurechenbar aus der Situation einer akuten Psychose oder schwerwiegenden Depression heraus, so ist der Unterstützende … nach allgemeiner Ansicht wegen eines Totschlags (§ 212 StGB) oder gegebenenfalls wegen Mordes (§ 211 StGB) strafbar.“"
                            },
                            {
                                "example_id": "82b357f4-dcb5-4e2d-97b9-2910ca07bb40",
                                "sense_id": "e427793d-5a43-3fee-a712-a6e7a115cbae",
                                "text": "„… so muss derjenige, welcher eine solche That begangen hat, wahnsinnig und daher unzurechenbar sein …“"
                            },
                            {
                                "example_id": "ec55d072-8b73-4de0-a925-c54eb8d020d6",
                                "sense_id": "e427793d-5a43-3fee-a712-a6e7a115cbae",
                                "text": "„Allerdings können während ihrer Ausführung unzurechenbare Handlungen zurechenbar werden, wenn die handelnden Personen sich durch früheres zurechenbares Handeln selbst in den Zustand gebracht haben.“"
                            },
                            {
                                "example_id": "0bd5307c-2981-400e-ac47-6f32e043f0c5",
                                "sense_id": "e427793d-5a43-3fee-a712-a6e7a115cbae",
                                "text": "„Geht es aber um Auslandstaten oder um Delikte, die in örtlicher Hinsicht letztlich wirklich unkonkretisier- und unzurechenbar bleiben, kommt in solchen Fällen … die nach Art und Gegenstand ähnlichste Regelung des VStG zur Anwendung …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
