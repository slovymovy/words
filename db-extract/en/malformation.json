                                                "sense_id": "58e17b07-5009-3c07-827c-7b15490ea23f",
                                                "text": "Les loupes, la bosse sont des difformités."
                                            },
                                            {
                                                "example_id": "9b1a32b7-0891-44bd-827b-0861b9728c56",
                                                "sense_id": "58e17b07-5009-3c07-827c-7b15490ea23f",
                                                "text": "Les difformités de la taille."
                                            },
