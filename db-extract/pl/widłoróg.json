                "senses": [
                    {
                        "sense_id": "ed4a6c5e-898e-327d-88d3-d5efe2c625cf",
                        "entry_id": "5c911ef0-9cfb-32f0-92f0-e1466623695e",
                        "glosses": [
                            "Antilocapra, rodzaj ssaków kopytnych z rodziny widłorogowatych, których rogi mają rozwidlenia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69ea06a9-57b3-45b2-b357-41a79bbfa49a",
                                "sense_id": "ed4a6c5e-898e-327d-88d3-d5efe2c625cf",
                                "text": "Choć widłoróg wygląda jak antylopa, to najbliżej spokrewniony jest z żyrafami."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c963ae6c-83f5-4c2e-86fe-ecd4ae026230",
                        "source_entry_id": "5c911ef0-9cfb-32f0-92f0-e1466623695e",
                        "source_sense_id": "ed4a6c5e-898e-327d-88d3-d5efe2c625cf",
                        "target_lang_word": "pronghorn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pronghorn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "37f4804a-3929-31ac-9bce-afe3fbe96ac9",
                                        "entry_id": "7dc80a97-313f-333e-afdc-6dddf2ed0ed7",
                                        "glosses": [
                                            "A North American mammal, Antilocapra americana, that resembles an antelope."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fbfd1da-9c74-4805-8664-6246efa28630",
                                                "sense_id": "37f4804a-3929-31ac-9bce-afe3fbe96ac9",
                                                "text": "If historical records are accurate, the current population of about 250 pronghorn in the northern range is less than 15% of that in the early 1900s (YNP 1997) (Figure 4–7)."
                                            },
                                            {
                                                "example_id": "cef7d303-08ea-4124-8ff3-2282fff9c6b5",
                                                "sense_id": "37f4804a-3929-31ac-9bce-afe3fbe96ac9",
                                                "text": "When a pronghorn breaks into an easy, rocking canter (a 30 miles per hour pace that it can keep up indefinitely), the humerus swings back and forth over just a few inches with each stride. Only when a pronghorn stretches into a gallop does the humerus appear to be swinging freely, and then the hoof travels several yards with each stride."
                                            },
                                            {
                                                "example_id": "271001a8-fe76-4d7f-865b-fcd2f73e748c",
                                                "sense_id": "37f4804a-3929-31ac-9bce-afe3fbe96ac9",
                                                "text": "For the 10-year period 1981-90 an additional 736 pronghorns were transplanted within the state.\nDuring 1980-90, pronghorn occupied about 13.5 million acres in the Trans-Pecos, High Plains, Rolling Plains, and Edwards Plateau ecological regions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
