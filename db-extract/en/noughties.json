                                        "glosses": [
                                            "die Jahre 00 bis 09 des gegenwärtigen oder besagten Jahrhunderts"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc1d7e0e-f23a-4bea-b1ff-0638ffe794d8",
                                                "sense_id": "32438e85-0af9-3a92-8a43-3435373e06db",
                                                "text": "Die Nullerjahre des 20. Jahrhunderts brachten die Relativitätstheorie von Einstein."
                                            },
                                            {
                                                "example_id": "64a4f1c9-2ccd-47a3-b779-bb608945fc43",
                                                "sense_id": "32438e85-0af9-3a92-8a43-3435373e06db",
                                                "text": "„Mitte der Nullerjahre, als Palmer Luckey ein Teenager war, glaubte kaum jemand an ein Comeback der Computerbrillen.“"
                                            },
                                            {
                                                "example_id": "e9553ae4-1700-4c4f-855b-fdb50edd45bb",
                                                "sense_id": "32438e85-0af9-3a92-8a43-3435373e06db",
                                                "text": "„Als wir das erste Mal nach Köln kamen, am Anfang der Nullerjahre, liebten wir die Stadt sofort, ihre lebhafte und launische Seite.“"
                                            }
                                        ],
