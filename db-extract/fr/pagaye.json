                ],
                "senses": [
                    {
                        "sense_id": "4b96b730-0a5f-3caa-8d81-67e1c124dee3",
                        "entry_id": "5613dc24-2720-3836-a2df-882fc58ff687",
                        "glosses": [
                            "Variante de pagaille."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "c39b0f1f-d6e5-4ccd-bc77-4eb205e4b99c",
                                "sense_id": "4b96b730-0a5f-3caa-8d81-67e1c124dee3",
                                "text": "Tout se tassera après les premiers kilomètres; à présent, la pagaye est intense. Il y a des chameaux à la traîne qui se refusent à avancer, d'autres dont les colis mal équilibrés tombent à terre."
                            },
                            {
                                "example_id": "90bec345-206e-4e78-8ac8-c91821ff1ea6",
                                "sense_id": "4b96b730-0a5f-3caa-8d81-67e1c124dee3",
                                "text": "Des justifications, je sens que j’en ai en pagaye et des tas de gens très bien en trouveront pour moi, mais il n’y a que les honteux pour se justifier et le fait demeure accompli."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "78fa556e-db86-3033-a17b-220b77030fde",
                "word": "pagaye",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "87ef83fa-e290-4b9e-ba80-7c4650e90b4c",
                        "entry_id": "78fa556e-db86-3033-a17b-220b77030fde",
                        "tags": [
                            "plural"
                        ],
