                "translations": [
                    {
                        "translation_id": "b0675831-0e04-4aeb-88b8-779131a66c6c",
                        "source_entry_id": "d63fa4b5-8a76-3150-ab52-5ca982707885",
                        "source_sense_id": "1ccdc775-9ebb-3ea9-b343-534e242bcda7",
                        "target_lang_word": "inept",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inept",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b990390-1268-3615-ac4c-24e8e6bc5cef",
                                        "entry_id": "7c632cb2-538b-38c2-a226-b3a45e59f22b",
                                        "glosses": [
                                            "Not able to do something; not proficient; displaying incompetence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f46d2d5b-aaf6-4a18-9eb0-6dbfcc37b71f",
                                                "sense_id": "1b990390-1268-3615-ac4c-24e8e6bc5cef",
                                                "text": "As a waiter, he was inept, so they put him in the kitchen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54579766-f3b1-3c91-829c-0faf5b33929e",
                                        "entry_id": "7c632cb2-538b-38c2-a226-b3a45e59f22b",
                                        "glosses": [
                                            "Unfit; unsuitable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63513195-67cd-4c88-ad23-621a42857eda",
                                                "sense_id": "54579766-f3b1-3c91-829c-0faf5b33929e",
                                                "text": "The bungled phrase, the slipshod paragraph, the inept metaphor, the irrelevant excursion, the disproportionate development, the feeble conclusion, are indeed all failures of meaning, and the more poetically ambitious the verbal structure in which they occur, the deeper and more substantive the failure may be."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a564747-e0e1-4b56-bb93-7eccded48302",
                        "source_entry_id": "d63fa4b5-8a76-3150-ab52-5ca982707885",
                        "source_sense_id": "1ccdc775-9ebb-3ea9-b343-534e242bcda7",
                        "target_lang_word": "feckless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feckless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1240d493-0f26-38d0-9377-cad8fafd96a1",
                                        "entry_id": "8465b703-83ea-3e43-85a5-d5b8d9cf6e38",
                                        "glosses": [
                                            "Lacking purpose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21b165c1-5517-40eb-9f18-457da316a9c6",
                                                "sense_id": "1240d493-0f26-38d0-9377-cad8fafd96a1",
                                                "text": "It is the beauty of great games when they are played at their highest level and the extraordinary thing now is that we do not have to trawl back through all the years of your inexorable progress from feckless beach boy to master sportsman."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efb69100-6968-34f8-bcec-1b5562be4471",
                                        "entry_id": "8465b703-83ea-3e43-85a5-d5b8d9cf6e38",
                                        "glosses": [
                                            "Without skill, ineffective, incompetent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9bfb094-750b-4e32-b9c4-18d6b294cdbf",
                                                "sense_id": "efb69100-6968-34f8-bcec-1b5562be4471",
                                                "text": "“Lana, when I want you to talk, I will tell you. And until then, zip it.” “Wha-- what did I do?” “Nothing.” “Yeah, Lana.” “Which is why these feckless idiots lost 200 kilos of cocaine.” “Yeah, Lan-- oh. OK. Technically. But then we stole a plane loaded with, like, twice as much cocaine.” “Is this the part where you tell me to look under my seat?”"
                                            },
                                            {
                                                "example_id": "a2231f72-b5b8-4e9d-8ab3-d99a0a5b730a",
                                                "sense_id": "efb69100-6968-34f8-bcec-1b5562be4471",
                                                "text": "Across the country, Democratic voters who have been reeling from Mr. Trump’s sweeping and possibly illegal cuts to government, his head-spinning policy moves, and his politicization of federal law enforcement are growing more and more incensed at their own party’s seemingly feckless response."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab8ccb96-f9a0-3dc6-aff9-5d1cfb1fee33",
                                        "entry_id": "8465b703-83ea-3e43-85a5-d5b8d9cf6e38",
                                        "glosses": [
                                            "Lacking the courage to act in any meaningful way."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a742f23d-dc1d-3179-9a34-21b358076625",
                                        "entry_id": "8465b703-83ea-3e43-85a5-d5b8d9cf6e38",
                                        "glosses": [
                                            "Lacking vitality."
                                        ],
                                        "tags": [
                                            "British",
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1dfca34b-94c0-4539-a2f7-47178e8caf85",
                        "source_entry_id": "d63fa4b5-8a76-3150-ab52-5ca982707885",
                        "source_sense_id": "1ccdc775-9ebb-3ea9-b343-534e242bcda7",
                        "target_lang_word": "shiftless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shiftless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d768061-7401-306c-8bef-902ece6bf16f",
                                        "entry_id": "c5dbdff2-b684-364b-8791-b4068dc8e516",
                                        "glosses": [
                                            "Lazy, unmotivated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dce6a05-a611-476a-948c-a5555a011554",
                                                "sense_id": "3d768061-7401-306c-8bef-902ece6bf16f",
                                                "text": "To expand, without bothering about it—without shiftless timidity on one side, or loquacious eagerness on the other—to the full compass of what he would have called a \"pleasant\" experience, was Newman's most definite programme of life."
                                            },
                                            {
                                                "example_id": "9a211cd7-c81b-49cc-916c-9b41b37574c5",
                                                "sense_id": "3d768061-7401-306c-8bef-902ece6bf16f",
                                                "text": "Decades ago, before credit scores, loan officers could make decisions almost whimsically and your fate could hinge on whether you reminded them of someone, or they had slept poorly the night before, or they harbored stereotypes of \"shiftless blacks\" and \"flighty women.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "993577a9-ff9a-3ce0-abc5-5d55ea661b5c",
                                        "entry_id": "c5dbdff2-b684-364b-8791-b4068dc8e516",
                                        "glosses": [
                                            "Untrustworthy as a result of being incompetent at the job."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5fc20ca6-bb40-3344-8f84-0543542a1deb",
                                        "entry_id": "c5dbdff2-b684-364b-8791-b4068dc8e516",
                                        "glosses": [
                                            "Destitute of shifts or expedients; lacking proper means."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb7c8966-3d7b-44ad-b4ae-0bf2a762e012",
                        "source_entry_id": "d63fa4b5-8a76-3150-ab52-5ca982707885",
