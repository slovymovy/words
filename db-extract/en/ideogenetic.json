                        "glosses": [
                            "Originating ideas or images."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "a3d34b7d-5264-41fc-8339-f7e58aaa7bcf",
                                "sense_id": "82bd6c18-5761-3bba-b41b-8b5141408e07",
                                "text": "In such an ideogenetic theory, the mind does not form the species, as Matthew claims, but sensation begins with a reception."
                            },
                            {
                                "example_id": "4e6aa27b-8ac5-4316-a7d3-7e8721b9d86c",
                                "sense_id": "82bd6c18-5761-3bba-b41b-8b5141408e07",
                                "text": "This extreme ideogenetic view would make the function of divine illumination that of a kind of separate active intellect: in fact, God would Himself be an ontologically separate active intellect which infuses ideas into the human mind […]"
                            },
                            {
                                "example_id": "9f89e180-79bf-4dd5-aed6-2c9bfd136029",
                                "sense_id": "82bd6c18-5761-3bba-b41b-8b5141408e07",
                                "text": "In his ideogenetic view, these fixed ideas constitute the very heart of the symptoms of the disorder. A patient with traumatic hysteria with a paralyzed leg would thus have developed the fixed idea that his leg had become paralyzed […]"
                            }
                        ]
                    }
