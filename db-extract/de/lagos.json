                                        "sense_id": "27103958-85df-38e1-bc8c-40e9f169b76a",
                                        "entry_id": "3c64ec56-b346-354d-9025-3572ad5f5a0e",
                                        "glosses": [
                                            "The largest city and former capital of Nigeria, in Lagos State."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a86a5cc-bbde-4298-ad82-54c3306b1309",
                                                "sense_id": "27103958-85df-38e1-bc8c-40e9f169b76a",
                                                "text": "‘Lagos is just a noise-making place with too much light and glass.’"
                                            },
                                            {
                                                "example_id": "99f25a51-2964-499d-9930-9266a6d14e28",
                                                "sense_id": "27103958-85df-38e1-bc8c-40e9f169b76a",
                                                "text": "“Covid has ramped up the level of work we do because hospitals are too busy,” he told CNN over the phone from his home in Lagos, Nigeria’s biggest city."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "299a26e9-c2c7-3276-a759-061ee5c7f660",
                                        "entry_id": "3c64ec56-b346-354d-9025-3572ad5f5a0e",
                                        "glosses": [
                                            "A state of Nigeria in the South West geopolitical zone. Capital: Ikeja. Largest city: Lagos City."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d4df924f-6bd0-3c57-b162-7109e53c3c2c",
                                        "entry_id": "3c64ec56-b346-354d-9025-3572ad5f5a0e",
