                        "entry_id": "80dd421a-2192-368c-914f-e40761649cce",
                        "glosses": [
                            "een bericht met bijzonder nieuws dat aan de verzamelde troepen wordt voorgelezene dag moet uitvoeren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac459865-87fb-416d-9682-ea4b0b8c50f3",
                                "sense_id": "f57ccb0f-0b1c-37fe-a48b-5cf4e55373c6",
                                "text": "De volgende dag werd er in de dagorder niets over gezegd; als je je kop er maar bij houdt"
                            },
                            {
                                "example_id": "3d161c26-e8d1-421d-ae9d-fd377ff47048",
                                "sense_id": "f57ccb0f-0b1c-37fe-a48b-5cf4e55373c6",
                                "text": "Willem-Alexanders moeder Beatrix stuurde Defensie vanochtend ook al een Dagorder. Zij bedankte de militairen en burgermedewerkers van Defensie voor hun inzet. Ze zei erop te vertrouwen dat Defensie ook onder Willem-Alexander opkomt voor vrede en recht. Een Dagorder is een bericht met bijzonder nieuws dat aan de verzamelde troepen wordt voorgelezen."
                            }
                        ]
                    },
