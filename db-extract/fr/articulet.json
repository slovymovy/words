                                "target_senses": [
                                    {
                                        "sense_id": "7ee19047-e330-35fb-b067-bb7d11deacc1",
                                        "entry_id": "64f4c766-d3cc-3746-9893-e05ffe14e295",
                                        "glosses": [
                                            "A piece of nonfiction writing such as a story, report, opinion piece, or entry in a newspaper, magazine, journal, encyclopedia, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85dbb3cf-39dc-464d-9542-b3c8506316d6",
                                                "sense_id": "7ee19047-e330-35fb-b067-bb7d11deacc1",
                                                "text": "Although there are dozens of different types of gems, among the best known and most important are […]. (Common gem materials not addressed in this article include amber, amethyst, chalcedony, garnet, lazurite, malachite, opals, peridot, rhodonite, spinel, tourmaline, turquoise and zircon.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e81407eb-8dba-3820-9a87-99006020e35b",
                                        "entry_id": "64f4c766-d3cc-3746-9893-e05ffe14e295",
                                        "glosses": [
                                            "An object, a member of a group or class."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03ee4b0f-eacd-40c5-a45c-e9701d588c9c",
                                                "sense_id": "e81407eb-8dba-3820-9a87-99006020e35b",
                                                "text": "an article of clothing"
                                            },
                                            {
                                                "example_id": "7c90b3be-1113-4ecf-bfd4-4f9e4f756007",
                                                "sense_id": "e81407eb-8dba-3820-9a87-99006020e35b",
                                                "text": "There were many wooden chairs for the bulk of his visitors, and two wicker armchairs with red cloth cushions for superior people. From the packing-cases had emerged some Indian clubs,[…], and all these articles[…] made a scattered and untidy decoration that Mrs. Clough assiduously dusted and greatly cherished."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2eec16d9-0372-3238-89f5-b95d8219c44f",
                                        "entry_id": "64f4c766-d3cc-3746-9893-e05ffe14e295",
                                        "glosses": [
                                            "A part of speech that indicates, specifies and limits a noun (a, an, or the in English). In some languages the article may appear as an ending (e.g. definite article in Swedish) or there may be none (e.g. Russian, Pashto)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00782349-55b4-4edd-8f85-11e8e895cbf8",
                                                "sense_id": "2eec16d9-0372-3238-89f5-b95d8219c44f",
                                                "text": "‘A song called “Freak Like Me” by the Sugababes,’ said Jesse.\n‘Just Sugababes, no article,’ the man said, enjoying the stunned reaction on Jesse’s face."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfe56f00-86a9-38d0-9dd5-a944faa3622e",
                                        "entry_id": "64f4c766-d3cc-3746-9893-e05ffe14e295",
                                        "glosses": [
                                            "A section of a legal document, bylaws, etc. or, in the plural, the entire document seen as a collection of these."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea64e7b3-c3bc-4c05-b54f-ea823814edf7",
                                                "sense_id": "dfe56f00-86a9-38d0-9dd5-a944faa3622e",
                                                "text": "The Articles of War are a set of regulations[…]to govern the conduct of[…]military[…]forces"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f059ced-5876-3804-b72c-071b2e3f636d",
                                        "entry_id": "64f4c766-d3cc-3746-9893-e05ffe14e295",
                                        "glosses": [
                                            "Ellipsis of genuine article."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dc7bc87b-dd7b-39e7-8944-52f3a2f6df1e",
                                        "entry_id": "64f4c766-d3cc-3746-9893-e05ffe14e295",
                                        "glosses": [
                                            "A part or segment of something joined to other parts, or, in combination, forming a structured set."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c307152-efb7-4ecf-a54b-bff6e54e67f0",
                                                "sense_id": "dc7bc87b-dd7b-39e7-8944-52f3a2f6df1e",
                                                "text": "Each of the chelicerae is composed of two articles, forming a powerful pincer."
                                            },
                                            {
                                                "example_id": "d908d524-23df-4551-9210-83adb266bd19",
                                                "sense_id": "dc7bc87b-dd7b-39e7-8944-52f3a2f6df1e",
                                                "text": "upon each article of human duty"
                                            },
                                            {
                                                "example_id": "da01ca9d-019b-4978-820b-22704aeac957",
                                                "sense_id": "dc7bc87b-dd7b-39e7-8944-52f3a2f6df1e",
                                                "text": "the different articles which compose the blood"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f970d8c8-9ae1-3096-a5a3-d7be76363911",
                                        "entry_id": "64f4c766-d3cc-3746-9893-e05ffe14e295",
                                        "glosses": [
                                            "A person; an individual."
                                        ],
                                        "tags": [
                                            "dated",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fce8b191-2b7d-4465-8d59-d9604de370e8",
                                                "sense_id": "f970d8c8-9ae1-3096-a5a3-d7be76363911",
                                                "text": "a shrewd article"
                                            },
                                            {
                                                "example_id": "532e3935-fb02-4428-b373-cfa08fa21ed1",
                                                "sense_id": "f970d8c8-9ae1-3096-a5a3-d7be76363911",
                                                "text": "\"You dateless article,\" stormed his father, leaving Bennett to realise in his laconic way that he was, and probably always would be, a disappointment to Dad."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50a409ce-59e3-3cf1-b50b-5bb80d51d7d5",
                                        "entry_id": "64f4c766-d3cc-3746-9893-e05ffe14e295",
                                        "glosses": [
                                            "A wench."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb1f4564-b9af-45fd-8fb6-25570d01a70e",
                                                "sense_id": "50a409ce-59e3-3cf1-b50b-5bb80d51d7d5",
                                                "text": "She's a prime article, a devilish good piece, a hell of a goer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9c64a7f-ecbf-3956-a5bf-0a77c9731cd3",
                                        "entry_id": "64f4c766-d3cc-3746-9893-e05ffe14e295",
                                        "glosses": [
                                            "Subject matter; concern."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9063cea-99d7-4cb2-b662-50b487369000",
                                                "sense_id": "f9c64a7f-ecbf-3956-a5bf-0a77c9731cd3",
                                                "text": "a very great revolution that happened in this article of good breeding"
                                            },
                                            {
                                                "example_id": "0b65f96b-77bc-4239-b90d-40df7bce8591",
                                                "sense_id": "f9c64a7f-ecbf-3956-a5bf-0a77c9731cd3",
                                                "text": "This last article perhaps will hardly be believed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60adbbf3-685a-3815-8bbd-dbbb90c32613",
                                        "entry_id": "64f4c766-d3cc-3746-9893-e05ffe14e295",
                                        "glosses": [
                                            "A distinct part."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "164b419a-2561-3dcc-a608-49388d348254",
                                        "entry_id": "64f4c766-d3cc-3746-9893-e05ffe14e295",
                                        "glosses": [
                                            "A precise point in time; a moment."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87dd6d2a-e410-414e-96e9-19e83198bc39",
                                                "sense_id": "164b419a-2561-3dcc-a608-49388d348254",
                                                "text": "This fatal news coming to Hick's Hall upon the article of my Lord Russell's trial, was said to have had no little influence on the jury and all the bench to his prejudice."
                                            },
                                            {
                                                "example_id": "2ca08f82-dbea-40fa-8ea7-acc767f00f02",
                                                "sense_id": "164b419a-2561-3dcc-a608-49388d348254",
                                                "text": "[…] who has more opportunities of acquiring the knowledge, than a physician? He is admitted into the dwellings of all ranks of people, and into the innermost parts of them; he sees them by their fireside, at their tables, and in their beds; he sees them at work, and at their recreations; he sees them in health, in sickness, and in the article of death; […]"
                                            },
                                            {
                                                "example_id": "b016ac87-f45f-4303-b688-e83dee6b0b51",
                                                "sense_id": "164b419a-2561-3dcc-a608-49388d348254",
                                                "text": "each article of time"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "article",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "903014bc-64ea-3177-96ed-838abf478f82",
                                        "entry_id": "6ff994e5-0c87-371c-94af-ad15748a54a1",
                                        "glosses": [
                                            "To bind by articles of apprenticeship."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "158cdfe4-cb43-4007-85f7-10986b9d5ef8",
                                                "sense_id": "903014bc-64ea-3177-96ed-838abf478f82",
                                                "text": "to article an apprentice to a mechanic"
                                            },
                                            {
                                                "example_id": "68e29400-a542-41f3-9830-b02411d91703",
                                                "sense_id": "903014bc-64ea-3177-96ed-838abf478f82",
                                                "text": "When the boy left school at Liskeard, he was articled to a lawyer, Mr. Jacobson, at Plymouth, a wealthy man in good practice, first cousin to his mother; but this sort of profession did not at all approve itself to Robert's taste, and he only remained with Mr. Jacobson a few months."
                                            },
                                            {
                                                "example_id": "8010c7f1-4780-4aab-a76e-d3d6ef176e08",
                                                "sense_id": "903014bc-64ea-3177-96ed-838abf478f82",
                                                "text": "After educational training at Hayes Grammar School and Hayes College, Mr. Nokes was articled to a Surveyor and Land Agent in 1885, and, at the expiration of his articles, became a partner in the firm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33d54f70-5593-39fb-8cd2-456f38fe9aa3",
                                        "entry_id": "6ff994e5-0c87-371c-94af-ad15748a54a1",
                                        "glosses": [
                                            "To accuse or charge by an exhibition of articles or accusations."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "666ea163-bd9c-4a2e-945e-f063cc10c5be",
                                                "sense_id": "33d54f70-5593-39fb-8cd2-456f38fe9aa3",
                                                "text": "At noon dined alone with Sir W. Batten, where great discourse of Sir W. Pen, Sir W. Batten being, I perceive, quite out of love with him, thinking him too great and too high, and began to talk that the world do question his courage, upon which I told him plainly I have been told that he was articled against for it, and that Sir H. Vane was his great friend therein."
                                            },
                                            {
                                                "example_id": "e576f1be-757a-4b76-9988-37dd7ad4dc82",
                                                "sense_id": "33d54f70-5593-39fb-8cd2-456f38fe9aa3",
                                                "text": "[…] if the Captain of any Merchant ship under convoy shall wilfully disobey Signals […] he shall be liable to be articled against in the High Court of Admiralty […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "390523a0-2bda-3986-ba1c-4e9e4391921f",
                                        "entry_id": "6ff994e5-0c87-371c-94af-ad15748a54a1",
                                        "glosses": [
                                            "To formulate in articles; to set forth in distinct particulars."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78d24f12-eb55-41e5-9c6f-0426f95669f2",
                                                "sense_id": "390523a0-2bda-3986-ba1c-4e9e4391921f",
                                                "text": "If […]all his errors and follies were articled against him, the man would seem vicious and miserable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
