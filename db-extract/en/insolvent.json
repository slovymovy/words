                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01a69dc4-3331-3a1f-85d6-94fa9b247d80",
                                        "entry_id": "0b044a2f-f068-3777-bd50-a33568dad135",
                                        "glosses": [
                                            "unfähig sein, wegen fehlender Liquidität (=Geldmangel) oder Überschuldung seinen laufenden Zahlungsverpflichtungen (=Verbindlichkeiten, Schulden) gegenüber den Gläubigern nachkommen zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d4aeecf-54a7-485e-bc2b-e6bbd0494756",
                                                "sense_id": "01a69dc4-3331-3a1f-85d6-94fa9b247d80",
                                                "text": "Insolvent sein zieht in Deutschland oft ein gerichtliches Vergleichs- oder Konkursverfahren nach sich, die dann entweder in einen Vergleich, eine Sanierung oder einen Konkurs münden."
                                            },
                                            {
                                                "example_id": "6fcfdf9d-88a6-4583-ad88-422394183e73",
                                                "sense_id": "01a69dc4-3331-3a1f-85d6-94fa9b247d80",
                                                "text": "Wenn wir so weitermachen in dieser Firma, sind wir bald insolvent."
                                            },
                                            {
                                                "example_id": "0bd51f4e-5070-4f65-93b7-9647dbc33de5",
                                                "sense_id": "01a69dc4-3331-3a1f-85d6-94fa9b247d80",
                                                "text": "Der Betreiber des berühmten Hotelkasinos Caesars Palace in Las Vegas hat sich für insolvent erklärt."
                                            },
                                            {
                                                "example_id": "60d0d24f-b4b9-46df-a41d-47f34a1f6949",
                                                "sense_id": "01a69dc4-3331-3a1f-85d6-94fa9b247d80",
                                                "text": "Der Industriestandort [Detroit] im Staat Michigan darf nun seine rund 18 Milliarden Dollar (13,25 Milliarden Euro) Schulden in einer geregelten Insolvenz abbauen. \"Das Gericht meint, dass Detroit insolvent war und ist\", sagte Richter Steven Rhodes. Die Stadt könne nun neu starten."
                                            },
                                            {
                                                "example_id": "51f5bef6-47f7-4ec4-94c1-f6e95aa00a90",
                                                "sense_id": "01a69dc4-3331-3a1f-85d6-94fa9b247d80",
                                                "text": "Für die insolvente Tageszeitung Frankfurter Rundschau (FR) gibt es erste Kaufinteressenten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
