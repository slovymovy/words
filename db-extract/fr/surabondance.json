                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overvloed",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "265cba31-f777-3528-90d9-889246853c42",
                                        "entry_id": "91de9a6e-6fda-3449-a7c0-d17d16bc6758",
                                        "glosses": [
                                            "het voorhanden zijn van meer dan voldoende van iets"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7136de4-062d-42e1-99be-94b85c3246e0",
                                                "sense_id": "265cba31-f777-3528-90d9-889246853c42",
                                                "text": "Dat had de bodem gelegd voor de welstand, om niet te zeggen overvloed, van de voltallige familie voor de nabije toekomst."
                                            },
                                            {
                                                "example_id": "d876f1c7-8c33-4ead-867f-b69e0d307e44",
                                                "sense_id": "265cba31-f777-3528-90d9-889246853c42",
                                                "text": "Er was een overvloed van aardbeien dat jaar."
                                            },
                                            {
                                                "example_id": "e4d7f0e0-375a-4480-bebf-e6866abf8120",
                                                "sense_id": "265cba31-f777-3528-90d9-889246853c42",
                                                "text": "Menselijke aangelegenheden waren al net zo onveranderlijk als de seizoenen. Keizerrijken bloeiden op en raakten in verval. Perioden van overvloed werden afgewisseld met hongersnoden, maar in essentie bleef alles bij het oude."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f92867e5-2b70-46e6-bc1f-921648c80f62",
                        "source_entry_id": "4fe4b74d-323c-3deb-bc2a-7b4a152584ee",
                        "source_sense_id": "9384d9ef-9023-3528-8194-993aaacef714",
                        "target_lang_word": "weelderigheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "weelderigheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "69343ebe-8204-3e5c-acb5-63839eaab302",
                                        "entry_id": "85dd01a0-8e1b-390a-a97f-4278629e4304",
                                        "glosses": [
                                            "overdadige weelde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b28baee-8050-4078-a374-2aa338228ba1",
                                                "sense_id": "69343ebe-8204-3e5c-acb5-63839eaab302",
                                                "text": "Nog een testje. Geef een heteroman drie foto’s van vrouwen en vraag hem te kiezen welke hij het meest aantrekkelijk vindt. Eén van het ‘oh oh Cherso type’, een benig catwalkmodel en een gemiddelde vrouw met rondingen. Laat ook maar zitten, want we weten de uitslag allang. Hij kiest de vrouw met de rondingen. Uiteraard, er is immers niets aantrekkelijker dan een vrouw die als een trotse koningin haar weelderigheid draagt."
                                            },
                                            {
                                                "example_id": "41e13e92-eba6-4f32-91dd-d6af1326803d",
                                                "sense_id": "69343ebe-8204-3e5c-acb5-63839eaab302",
                                                "text": "We hoeven in ieder geval niet meer te tobben met een maatje meer. Dus kom op lady’s, wurm jezelf in een strak kleedje en laat het zien, al die zalige weelderigheid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
