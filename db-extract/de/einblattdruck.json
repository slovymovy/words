                "senses": [
                    {
                        "sense_id": "c2c412fb-4f76-38eb-9415-aff3c3980c66",
                        "entry_id": "d34dcfc5-3e82-385b-9e7b-c19f153b28e3",
                        "glosses": [
                            "Druck aus der Frühzeit des Buchdrucks, bestehend aus nur einem bedruckten Blatt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c85c265-337d-4235-b8d9-2a342ae4006d",
                                "sense_id": "c2c412fb-4f76-38eb-9415-aff3c3980c66",
                                "text": "„Doch nicht nur wegen der beiden Einblattdrucke ist der Band buchgeschichtlich bemerkenswert.“"
                            },
                            {
                                "example_id": "8db82347-c5f0-49ea-847f-14d624fa29b4",
                                "sense_id": "c2c412fb-4f76-38eb-9415-aff3c3980c66",
                                "text": "„Bei den meisten handelte es sich um kleine Broschüren oder Einblattdrucke zu Unterhaltung und Zeitvertreib.“"
                            },
                            {
                                "example_id": "d084b798-6627-48ae-85b8-d78ef4aed36a",
                                "sense_id": "c2c412fb-4f76-38eb-9415-aff3c3980c66",
                                "text": "„Das lag nicht allein an Büchern und Bibeln, sondern vor allem an den Flugschriften, häufig Einblattdrucke mit einer Illustration.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
