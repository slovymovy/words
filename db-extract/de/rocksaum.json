                                "sense_id": "78b4cc62-1427-3865-8933-1eeb726c0fea",
                                "text": "„Heute Morgen entnahm ich der Tagespresse eine Meldung, wonach der Rocksaum sich präzise eine Männerhand breit unter dem Knie der Dame zu befinden habe.“"
                            },
                            {
                                "example_id": "7959ea0a-868f-4822-9de6-0d10b712ad3d",
                                "sense_id": "78b4cc62-1427-3865-8933-1eeb726c0fea",
                                "text": "„Am Rocksaume klingelten Edelsteingehänge.“"
                            }
                        ],
