                "translations": [
                    {
                        "translation_id": "04de652d-87c2-464b-81fc-103e41fd0e1b",
                        "source_entry_id": "6ce88422-7d22-3bde-9f6e-43096272dac1",
                        "source_sense_id": "003045b8-73de-39c4-b944-9f38c9ec1c1a",
                        "target_lang_word": "boulonnais",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boulonnais",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c03674ad-7eed-3a2d-b515-bdbf689b8f8b",
                                        "entry_id": "3b5dcf43-ea36-32c7-9174-f8ed7e999842",
                                        "glosses": [
                                            "Originaire du Boulonnais."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19da94d6-e88f-46af-94fc-41d01dacef6b",
                                                "sense_id": "c03674ad-7eed-3a2d-b515-bdbf689b8f8b",
                                                "text": "Faites venir des chevaux boulonnais dans le Midi de la France ou en Espagne à la seconde génération vous ne les reconnaîtrez plus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6500536-0e7a-3795-b761-b31158cb71d7",
                                        "entry_id": "3b5dcf43-ea36-32c7-9174-f8ed7e999842",
                                        "glosses": [
                                            "Relatif à Boulogne, commune de la Vendée, en France."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f2fdfafb-1839-385f-87d3-d649098f0a72",
                                        "entry_id": "3b5dcf43-ea36-32c7-9174-f8ed7e999842",
                                        "glosses": [
                                            "Relatif à Boulogne-Billancourt, commune des Hauts-de-Seine, en France."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c388bd5-27cc-404a-8491-9d359f00fe8a",
                                                "sense_id": "f2fdfafb-1839-385f-87d3-d649098f0a72",
                                                "text": "La fin de vie n’est pas simplement une vie qui s’achève, c’est le parachèvement d’une vie, disait le philosophe boulonnais Damien Le Gay."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "759981e0-d148-3488-bd10-9d48f1107ae2",
                                        "entry_id": "3b5dcf43-ea36-32c7-9174-f8ed7e999842",
                                        "glosses": [
                                            "Relatif à Boulogne-sur-Gesse, commune de la Haute-Garonne, en France."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cbc721d7-6616-3622-a0ea-7224a512aa2b",
                                        "entry_id": "3b5dcf43-ea36-32c7-9174-f8ed7e999842",
                                        "glosses": [
                                            "Relatif à Boulogne-sur-Helpe, commune du Nord, en France."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e4da281-89c1-3ec7-8c01-702128c1fde0",
                                        "entry_id": "3b5dcf43-ea36-32c7-9174-f8ed7e999842",
                                        "glosses": [
                                            "Relatif à Boulogne-sur-Mer, commune du Pas-de-Calais, en France."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b85d43b9-532e-3a66-b549-198530a25376",
                                        "entry_id": "3b5dcf43-ea36-32c7-9174-f8ed7e999842",
                                        "glosses": [
                                            "Relatif à Boulon, commune du Calvados, en France."
                                        ],
                                        "tags": [],
