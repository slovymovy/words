                "senses": [
                    {
                        "sense_id": "7769cf41-e07d-3736-bfb9-89dfd58f6592",
                        "entry_id": "52c017b1-d799-38d1-bbb8-7b3425c968dc",
                        "glosses": [
                            "den zweiten Rang bezüglich der geringen Größe einnehmend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5cfb4fd-bcdc-4684-80d2-cfa70835cb82",
                                "sense_id": "7769cf41-e07d-3736-bfb9-89dfd58f6592",
                                "text": "„Europa ist mit rund 10 Mio. km2 zwar der zweitkleinste Erdteil, war jedoch jahrhundertelang der wirtschaftliche und kulturelle Mittelpunkt der Welt.“"
                            },
                            {
                                "example_id": "6ce3bf3c-ccb5-4e37-88bb-65823c91701f",
                                "sense_id": "7769cf41-e07d-3736-bfb9-89dfd58f6592",
                                "text": "„Zweitkleinster Staat nach dem Vatikan ist das Fürstentum Monaco mit einer Fläche von 1,95 Quadratkilometern.“"
                            }
