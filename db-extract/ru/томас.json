                                    },
                                    {
                                        "sense_id": "f559570f-8a4d-3fec-ac81-da0833bcdb45",
                                        "entry_id": "b751654c-144c-3e0f-90ed-055288d08f87",
                                        "glosses": [
                                            "A number of places in the United States:",
                                            "A city in Custer County, Oklahoma."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fed7399-74f6-4f8d-83fe-c3c660cc7175",
                                                "sense_id": "f559570f-8a4d-3fec-ac81-da0833bcdb45",
                                                "text": "Located in northeastern Custer County, Thomas is situated at the intersection of State Highways 33 and 47. Originally, Thomas was a trading point where William Thomas had a general store and served as the first postmaster of a post office designated on February 12, 1894."
                                            }
                                        ]
