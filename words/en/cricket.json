{
    "word_family": [
        "cricketer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dde4d9ee-0ff8-3709-aa8a-f6629040b64b",
                    "sense_definition": "A game played outdoors with bats and a ball between two teams of eleven, popular in England and many Commonwealth countries.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "group_game",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We are going to watch a <w>cricket</w> match at the stadium this weekend.",
                            "target_lang_translations": {
                                "ru": "В эти выходные мы собираемся посмотреть матч по <w>крикету</w> на стадионе.",
                                "zh": "这个周末我们要去体育场看一场<w>板球</w>比赛。"
                            }
                        },
                        {
                            "text": "He has been the captain of the school <w>cricket</w> team for two years.",
                            "target_lang_translations": {
                                "ru": "Он был капитаном школьной команды по <w>крикету</w> в течение двух лет.",
                                "zh": "他担任学校<w>板球</w>队队长已经两年了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "play cricket",
                        "cricket match",
                        "cricket team",
                        "test cricket",
                        "cricket ball"
                    ],
                    "target_lang_definitions": {
                        "ru": "Командная игра на открытом воздухе с использованием бит и мяча, популярная в Англии и многих странах Содружества.",
                        "zh": "一种在户外进行的球类运动，由两支各十一人的队伍使用球棒和球进行比赛，在英国及许多英联邦国家很受欢迎。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крикет",
                                "target_lang_sense_clarification": "спортивная игра"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "板球",
                                "target_lang_sense_clarification": "体育运动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f03fbc6-76d9-3495-adb9-41985cd3ebec",
                    "sense_definition": "An insect in the order Orthoptera that makes a chirping sound by rubbing its wing casings against combs on its hind legs.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_insect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The loud noise of a <w>cricket</w> kept me awake all night.",
                            "target_lang_translations": {
                                "ru": "Громкий стрекот <w>сверчка</w> не давал мне спать всю ночь.",
                                "zh": "<w>蟋蟀</w>的鸣叫声很大，吵得我整晚没睡着。"
                            }
                        },
                        {
                            "text": "She found a small black <w>cricket</w> hiding in the tall grass.",
                            "target_lang_translations": {
                                "ru": "Она нашла маленького черного <w>сверчка</w>, прячущегося в высокой траве.",
                                "zh": "她在高草丛中发现了一只躲藏的小黑<w>蟋蟀</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "chirping cricket"
                    ],
                    "target_lang_definitions": {
                        "ru": "Насекомое отряда прямокрылых, издающее стрекочущие звуки трением надкрылий.",
                        "zh": "直翅目昆虫，通过摩擦后腿上的梳状结构与翅膀发出鸣叫声。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сверчок",
                                "target_lang_sense_clarification": "насекомое"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "蟋蟀",
                                "target_lang_sense_clarification": "昆虫"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2e36739-5685-3ef4-a90f-03d230fee2fb",
                    "sense_definition": "Absolute silence or a lack of communication, often implying awkwardness or no response.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_silence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I told a joke to the audience, but there were only <w>crickets</w>.",
                            "target_lang_translations": {
                                "ru": "Я рассказал аудитории шутку, но в ответ была лишь <w>тишина</w>.",
                                "zh": "我给观众讲了个笑话，结果台下一片<w>沉默</w>。"
                            }
                        },
                        {
                            "text": "I sent an email to the support team last week, but so far it has been <w>crickets</w>.",
                            "target_lang_translations": {
                                "ru": "Я отправил письмо в службу поддержки на прошлой неделе, но пока <w>молчание</w>.",
                                "zh": "我上周给支持团队发了邮件，但至今仍<w>无人回应</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hear crickets"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used metaphorically to describe silence"
                        },
                        {
                            "trait_type": "form",
                            "comment": "usually plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полная тишина или отсутствие реакции, часто подразумевающее неловкость.",
                        "zh": "绝对的寂静或缺乏沟通，通常暗示尴尬或无人回应。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тишина",
                                "target_lang_sense_clarification": "отсутствие звуков или ответа"
                            },
                            {
                                "target_lang_word": "молчание",
                                "target_lang_sense_clarification": "отсутствие коммуникации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "沉默",
                                "target_lang_sense_clarification": "缺乏回应"
                            },
                            {
                                "target_lang_word": "鸦雀无声",
                                "target_lang_sense_clarification": "形容非常安静"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "933580da-e88a-3e4d-a80f-8a843b6fc8a1",
                    "sense_definition": "An act that is fair, honorable, and sportsmanlike.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "group_fairness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cheating on the final exam is simply not <w>cricket</w>.",
                            "target_lang_translations": {
                                "ru": "Списывать на выпускном экзамене — это просто не <w>честно</w>.",
                                "zh": "期末考试作弊简直太不<w>正派</w>了。"
                            }
                        },
                        {
                            "text": "It is not <w>cricket</w> to leave your team without warning just before the finals.",
                            "target_lang_translations": {
                                "ru": "Это не <w>по-товарищески</w> бросать свою команду без предупреждения прямо перед финалом.",
                                "zh": "在决赛前毫无预兆地离开团队，这不符合<w>公平竞争</w>的精神。"
                            }
                        }
                    ],
                    "antonyms": [
                        "not cricket"
                    ],
                    "common_phrases": [
                        "not cricket"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often used in the negative phrase 'not cricket'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поступок, являющийся честным, благородным и соответствующим духу спортивного соперничества.",
                        "zh": "一种公平、光荣且符合体育精神的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "честная игра",
                                "target_lang_sense_clarification": "порядочное поведение"
                            },
                            {
                                "target_lang_word": "порядочность",
                                "target_lang_sense_clarification": "соблюдение правил приличия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "公平竞争",
                                "target_lang_sense_clarification": "正当行为"
                            },
                            {
                                "target_lang_word": "正派",
                                "target_lang_sense_clarification": "符合道德规范"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56de52e1-97a2-32f7-8dcc-ab06e27c81d1",
                    "sense_definition": "A relatively small area of a roof constructed to divert water from a horizontal intersection of the roof with a chimney or wall.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "group_architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The builder installed a <w>cricket</w> behind the chimney to prevent leaks.",
                            "target_lang_translations": {
                                "ru": "Строитель установил <w>разуклонку</w> за дымоходом, чтобы предотвратить протечки.",
                                "zh": "建筑工人在烟囱后面安装了一个<w>导水板</w>以防止漏水。"
                            }
                        },
                        {
                            "text": "Water was pooling on the roof because the <w>cricket</w> was not built correctly.",
                            "target_lang_translations": {
                                "ru": "Вода скапливалась на крыше, потому что <w>разуклонка</w> была построена неправильно.",
                                "zh": "由于<w>导水板</w>建造不当，屋顶上积了水。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой элемент кровли, предназначенный для отвода воды от места примыкания крыши к дымоходу или стене.",
                        "zh": "屋顶上的一小块区域，用于将水从屋顶与烟囱或墙壁的水平交汇处引开。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разуклонка",
                                "target_lang_sense_clarification": "элемент кровли"
                            },
                            {
                                "target_lang_word": "седло",
                                "target_lang_sense_clarification": "архитектурный элемент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "导水板",
                                "target_lang_sense_clarification": "建筑构件"
                            },
                            {
                                "target_lang_word": "分水脊",
                                "target_lang_sense_clarification": "屋顶排水结构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66d5679a-d97d-3d6f-860c-a6560eaf212b",
                    "sense_definition": "A wooden footstool.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "group_furniture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She sat on the small <w>cricket</w> by the fire to warm her hands.",
                            "target_lang_translations": {
                                "ru": "Она села на маленькую <w>скамеечку</w> у огня, чтобы согреть руки.",
                                "zh": "她坐在火炉旁的<w>小矮凳</w>上暖手。"
                            }
                        },
                        {
                            "text": "The old wooden <w>cricket</w> in the corner has been in the family for generations.",
                            "target_lang_translations": {
                                "ru": "Старая деревянная <w>скамеечка</w> в углу принадлежит семье уже несколько поколений.",
                                "zh": "角落里那把旧木制<w>脚凳</w>在家里传了好几代了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "regional usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деревянная скамеечка для ног.",
                        "zh": "一种木制的脚凳。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скамеечка для ног",
                                "target_lang_sense_clarification": "мебель"
                            },
                            {
                                "target_lang_word": "низкая табуретка",
                                "target_lang_sense_clarification": "мебель"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "脚凳",
                                "target_lang_sense_clarification": "家具"
                            },
                            {
                                "target_lang_word": "小矮凳",
                                "target_lang_sense_clarification": "家具"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e257dcec-2489-3dd7-80b7-d044c73c91f6",
                    "sense_definition": "To play the game of cricket.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_game",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They spent the whole summer <w>cricketing</w> around the country.",
                            "target_lang_translations": {
                                "ru": "Они провели все лето, разъезжая по стране и <w>играя в крикет</w>.",
                                "zh": "他们整个夏天都在全国各地<w>打板球</w>。"
                            }
                        },
                        {
                            "text": "He has <w>cricketed</w> for this local club since he was a young boy.",
                            "target_lang_translations": {
                                "ru": "Он <w>играл в крикет</w> за этот местный клуб с самого детства.",
                                "zh": "他从小就在这家当地俱乐部<w>打板球</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Играть в игру крикет.",
                        "zh": "进行板球运动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "играть в крикет",
                                "target_lang_sense_clarification": "заниматься спортом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打板球",
                                "target_lang_sense_clarification": "体育活动"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}