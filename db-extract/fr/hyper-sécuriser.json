                                "example_id": "327b825e-e4e3-491d-91e3-e6e68a2f2b4a",
                                "sense_id": "3fde6c0b-92e2-3bd7-94eb-363f385a8b8f",
                                "text": "SecuTABLET, tablette hyper-sécurisée."
                            }
                        ]
