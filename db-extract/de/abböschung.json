                    {
                        "sense_id": "ff5e84cb-b624-3d58-a1ec-d7bc4697ad04",
                        "entry_id": "dcf2ed56-2b37-3e5e-acb1-c776b3d8a635",
                        "glosses": [
                            "schräge Fläche oder Neigung an einem Hang oder einer Seitenwand, die in der Regel für Stabilität, Schutz oder konstruktive Zwecke geschaffen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9de2bbc9-0820-466b-ae01-f0743d9dcc42",
                                "sense_id": "ff5e84cb-b624-3d58-a1ec-d7bc4697ad04",
                                "text": "„Im Norden bot eine acht Meter lange künstliche Abböschung mit einer vorgelagerten Terrasse Schutz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8598f137-68a7-3899-9feb-8e426cb6f86b",
                        "entry_id": "dcf2ed56-2b37-3e5e-acb1-c776b3d8a635",
                        "glosses": [
                            "Vorgang, bei dem etwas eine Böschung hinzugefügt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b4cb470-b7cf-42c2-bd6c-b1f795d2af98",
                                "sense_id": "8598f137-68a7-3899-9feb-8e426cb6f86b",
                                "text": "„Bei nicht standsicherem Boden oder der Überschreitung der Tiefe wird ein Verbau und/oder eine Abböschung der Seitenwände notwendig.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
