                                    {
                                        "sense_id": "d5e50f2b-638c-3a2e-bf52-90fdbc12fc12",
                                        "entry_id": "b7db1741-c735-3d57-ae17-4bb5d71060cc",
                                        "glosses": [
                                            "Qui a la même forme ; qui est semblable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "000da24a-26c0-4103-9186-4e4d991d4646",
                                                "sense_id": "d5e50f2b-638c-3a2e-bf52-90fdbc12fc12",
                                                "text": "Les théoriciens de la version alternative […] échafaudent des hypothèses conformes à leurs convictions sans apporter de preuves indiscutables."
                                            },
                                            {
                                                "example_id": "7433d2ec-12c5-4238-9019-f44a895286d0",
                                                "sense_id": "d5e50f2b-638c-3a2e-bf52-90fdbc12fc12",
                                                "text": "La copie est conforme à l’original."
                                            },
                                            {
                                                "example_id": "5ea9a414-3d13-44c5-b4b1-bdeeea6a153a",
                                                "sense_id": "d5e50f2b-638c-3a2e-bf52-90fdbc12fc12",
                                                "text": "Ces écritures sont conformes."
                                            },
                                            {
                                                "example_id": "b7705fb7-a503-4043-bab4-4bbf5032ffd8",
                                                "sense_id": "d5e50f2b-638c-3a2e-bf52-90fdbc12fc12",
                                                "text": "Son humeur est conforme à la vôtre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fb1ba0f-34ab-32e5-9292-0b08b716befa",
                                        "entry_id": "b7db1741-c735-3d57-ae17-4bb5d71060cc",
                                        "glosses": [
                                            "Convenable, qui s’accorde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6fe7f23-e353-41a9-a03b-37dec43fb2c4",
                                                "sense_id": "9fb1ba0f-34ab-32e5-9292-0b08b716befa",
                                                "text": "Mener une vie conforme à sa profession."
                                            },
                                            {
                                                "example_id": "78c54556-54db-47dd-a457-af4b23da3c7a",
                                                "sense_id": "9fb1ba0f-34ab-32e5-9292-0b08b716befa",
                                                "text": "Avoir des sentiments conformes à sa naissance."
                                            },
                                            {
                                                "example_id": "57386f30-9398-4365-a86c-9f618e5b383d",
                                                "sense_id": "9fb1ba0f-34ab-32e5-9292-0b08b716befa",
                                                "text": "Cela est parfaitement conforme à ses vues."
                                            },
                                            {
                                                "example_id": "8552951c-efea-4a0e-8558-5b5b5fb207a1",
                                                "sense_id": "9fb1ba0f-34ab-32e5-9292-0b08b716befa",
                                                "text": "Ses mœurs ne sont pas conformes à sa doctrine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71e09b68-3d0b-3a11-b002-8d694d2221e2",
                                        "entry_id": "b7db1741-c735-3d57-ae17-4bb5d71060cc",
                                        "glosses": [
                                            "Qui correspond à un standard, à une norme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adc5b3d5-0526-4d95-8557-134d69f437c9",
                                                "sense_id": "71e09b68-3d0b-3a11-b002-8d694d2221e2",
                                                "text": "Chargée d’une mission inédite, la CIIVISE a adopté une organisation conforme aux standards institutionnels du genre avec des ajustements résultant du caractère inédit de sa mission."
                                            },
                                            {
                                                "example_id": "996aab51-d266-42bd-afbb-c54ab7db3b0d",
                                                "sense_id": "71e09b68-3d0b-3a11-b002-8d694d2221e2",
                                                "text": "Un bouton d’arrêt d’urgence conforme aux standards de sécurité."
                                            }
                                        ]
                                    }
                                ]
