                    "frequency": "High",
                    "semantic_group_id": "mouvement_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut <w>tirer</w> la porte pour l'ouvrir car elle ne se pousse pas."
                        },
                        {
                            "text": "L'enfant <w>tire</w> son petit chariot rouge dans toute la maison."
                        }
