                ],
                "senses": [
                    {
                        "sense_id": "843f8c55-ea7e-3606-b5ea-63b606ab0c09",
                        "entry_id": "16fae643-f979-3aa6-b485-8d6bcefe0590",
                        "glosses": [
                            "durch ein Ereignis oder einen Umstand verursachte Beeinträchtigung einer Maschine, eines Motors; Beschädigung oder Defekt einer Maschine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1a04d13-0e02-430a-b034-c5a27671bd31",
                                "sense_id": "843f8c55-ea7e-3606-b5ea-63b606ab0c09",
                                "text": "„Einer davon ist, dass der Zug derzeit mit einem Maschinenschaden in Paris steht.“"
                            },
                            {
                                "example_id": "323467c4-e88d-4362-892d-08320fb7b084",
                                "sense_id": "843f8c55-ea7e-3606-b5ea-63b606ab0c09",
                                "text": "„Als Betriebsunterbrechung gilt die völlige oder teilweise Unterbrechung der Betriebsfertigkeit (Betriebsbereitschaft) der versicherten Sachen durch einen Maschinenschaden.“"
                            },
                            {
                                "example_id": "d71f8888-9189-4062-8898-d75ffdb0cd59",
                                "sense_id": "843f8c55-ea7e-3606-b5ea-63b606ab0c09",
                                "text": "„Nur ein bisschen Glück und gutes Wetter und keinen weiteren Maschinenschaden, keinen Streik und keine Unruhen und keinen Krieg, dann hat das Schiff Geld verdient.“"
                            },
                            {
                                "example_id": "5dc9d8ed-abb0-464a-a92c-d731cf9241f6",
                                "sense_id": "843f8c55-ea7e-3606-b5ea-63b606ab0c09",
                                "text": "„Kapitän Schröder versuchte, der Küstenwache mitzuteilen, dass es sich um einen Maschinenschaden handelt.“"
                            },
                            {
                                "example_id": "be0b98aa-04a0-44fc-886b-9f3d17f65f59",
                                "sense_id": "843f8c55-ea7e-3606-b5ea-63b606ab0c09",
                                "text": "„Hat jetzt ein Schiff Maschinenschaden, kommt es auf einer Untiefe fest oder seine Ladung ins Rutschen, dann beginnt der »Tanz« der Bergungsschlepper.“"
                            },
                            {
                                "example_id": "a645818a-d0b8-4b68-a85f-6f9c45a68d45",
                                "sense_id": "843f8c55-ea7e-3606-b5ea-63b606ab0c09",
                                "text": "„Die Termini, das Schiff mit dem Maschinenschaden, lag für drei Wochen fest, während die Gallia das einzige Schiff bei Capri war und dort die Jump-Point-Überwachung durchführte und deshalb nicht abgezogen werden konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
