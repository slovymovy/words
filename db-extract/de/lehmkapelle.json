                "senses": [
                    {
                        "sense_id": "66bd8e7e-a73c-3066-9a84-99e8b9371214",
                        "entry_id": "86581e10-a022-3dc8-8bc4-4185d7cd3ed3",
                        "glosses": [
                            "einfach gestaltetes Andachtsgebäude, kleines Gotteshaus in Lehmbauweise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a55bf37c-155a-41fd-bb91-68685eb11b4e",
                                "sense_id": "66bd8e7e-a73c-3066-9a84-99e8b9371214",
                                "text": "„Vor der strohbedeckten Lehmkapelle warten 30 kleine Kinder.“"
                            },
                            {
                                "example_id": "2daacfce-f799-4e4c-8f1b-a47b5d7ce619",
                                "sense_id": "66bd8e7e-a73c-3066-9a84-99e8b9371214",
                                "text": "„Superintendent Martin Kirchner, der Sohn des damaligen Oberkonsistorialrats, war gekommen, um Fischer in der voll besetzten Lehmkapelle feierlich zu „entpflichten“ und in den Ruhestand zu verabschieden.“"
                            },
                            {
                                "example_id": "9c082a56-f2a0-4877-aaa7-83dec3d6d036",
                                "sense_id": "66bd8e7e-a73c-3066-9a84-99e8b9371214",
                                "text": "„Heute lädt an der Bernauer Straße eine moderne Lehmkapelle zur zeitgeschichtlichen Spurensuche ein.“"
                            },
                            {
                                "example_id": "cbd6172e-35d3-4e36-b9c3-0379188a3d8a",
                                "sense_id": "66bd8e7e-a73c-3066-9a84-99e8b9371214",
                                "text": "„Tief beeindruckt haben ihn die lebendigen Gottesdienste, die zumeist in schlichten grasgedeckten Lehmkapellen der Siedlungen gefeiert wurden und die immer in tiefer Feierlichkeit endeten.“"
                            },
                            {
                                "example_id": "64c43ee7-bbe3-4f87-be5d-a461f00ddc2d",
                                "sense_id": "66bd8e7e-a73c-3066-9a84-99e8b9371214",
                                "text": "„Bescheidene Lehmkapellen in den neu gegründeten Gemeinden werden immer weiter ausgebaut und beherbergen heute die Gottesdienste und kostenlosen Kindergärten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
