                "senses": [
                    {
                        "sense_id": "f7955ec6-b08e-3226-a044-50429ab8426a",
                        "entry_id": "7511c8a7-da52-3c7d-bb37-b14f67d4686a",
                        "glosses": [
                            "Reproduire par phototypie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c9a6e62-318a-4e04-9e88-be7cdc60ba94",
                                "sense_id": "f7955ec6-b08e-3226-a044-50429ab8426a",
                                "text": "En 1913, Henri DE LA VILLE DE MIRMONT, professeur à la Faculté des Lettres de l'Université de Bordeaux, a fait photographier et phototyper ce manuscrit."
                            },
                            {
                                "example_id": "2b915ab0-6bf7-4b3f-9c4b-d764925e74e4",
                                "sense_id": "f7955ec6-b08e-3226-a044-50429ab8426a",
                                "text": "Ce sera le noyau d’une collection de vues de ces villages avant leur écrasement, vues des plus rares aujourd'hui, les éditeurs ruraux faisant surtout phototyper à Lille, Roubaix ou Nancy."
                            }
                        ]
                    }
