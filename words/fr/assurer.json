            "senses": [
                {
                    "sense_id": "7cc7b59e-e7ef-3c0a-a3b6-f424df926a6e",
                    "sense_definition": "Affirmer formellement une chose à quelqu'un en lui donnant la certitude qu'elle est vraie.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "declaration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le témoin <w>assure</w> qu'il a vu l'accident de ses propres yeux."
                        },
                        {
                            "text": "Je peux vous <w>assurer</w> que ce dossier sera traité rapidement."
                        }
                    ],
                    "synonyms": [
                        "affirmer",
                        "certifier",
                        "garantir"
                    ],
                    "antonyms": [
                        "contester",
                        "douter",
                        "nier"
                    ],
                    "common_phrases": [
