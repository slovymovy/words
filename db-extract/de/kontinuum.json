                                                "sense_id": "4369f5e4-5f6d-3b7e-a83b-30ab53495d3e",
                                                "text": "Les parties du continu."
                                            },
                                            {
                                                "example_id": "a27bd5a9-2ed3-41b2-9372-f675c3a497a6",
                                                "sense_id": "4369f5e4-5f6d-3b7e-a83b-30ab53495d3e",
