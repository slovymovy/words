                    "sense_id": "9e284bfe-c26d-393c-a3c6-86e905f0755f",
                    "sense_definition": "Used to express annoyance or disappointment.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Oh <w>bum</w>, I forgot to bring my wallet!",
                            "target_lang_translations": {
                                "ru": "О <w>чёрт</w>, я забыл взять кошелек!",
                                "zh": "<w>糟糕</w>，我忘了带钱包了！"
                            }
                        },
                        {
                            "text": "<w>Bum</w>! We missed the last bus home.",
                            "target_lang_translations": {
                                "ru": "<w>Блин</w>! Мы опоздали на последний автобус домой.",
