                                    {
                                        "sense_id": "d2c6356b-5bb3-35d7-ae24-1d000374f33e",
                                        "entry_id": "0cd22111-9493-3298-bd7b-3ca25e53bb11",
                                        "glosses": [
                                            "Spécialiste de Byzance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "095d328d-98d6-4e84-a5cd-73ffafc5f78d",
                                                "sense_id": "d2c6356b-5bb3-35d7-ae24-1d000374f33e",
                                                "text": "Longtemps les byzantinistes n’ont pas jugé intéressant d’étudier le sort des femmes dans l’Empire."
                                            },
                                            {
                                                "example_id": "bae3db1e-e401-4fbb-9838-6804a2e1f858",
                                                "sense_id": "d2c6356b-5bb3-35d7-ae24-1d000374f33e",
                                                "text": "Alors tout le monde allait savoir que le grand byzantiniste n’avait jamais existé, et que celle qui pensait et écrivait à sa place, c’était sa femme."
                                            },
                                            {
                                                "example_id": "d9ed8b03-fbff-4635-a320-9c444d9bf73c",
                                                "sense_id": "d2c6356b-5bb3-35d7-ae24-1d000374f33e",
                                                "text": "L’évêque Porphire est un célèbre byzantiniste et orientaliste russe. Il est le fondateur de la Mission orthodoxe russe de Jérusalem."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
