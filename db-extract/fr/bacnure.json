                        ],
                        "examples": [
                            {
                                "example_id": "2ddcdd04-77a9-4041-af3f-dadcd4e65b67",
                                "sense_id": "00c56a0d-88cb-3142-9d49-3801e2a8aa93",
                                "text": "Les galeries percées de manière à rencontrer successivement les diverses couches de roches ou de charbon dont se compose le terrain, sont dit galeries à travers-banc, et s'appellent bacnures dans le pays de Liége, et beuveaux dans le Hainaut."
                            },
                            {
                                "example_id": "06f22c66-e2d3-471a-8d8e-d6ad25029c56",
                                "sense_id": "00c56a0d-88cb-3142-9d49-3801e2a8aa93",
                                "text": "Bacnure ou tranche : galerie partant du puits et creusée à travers les stampes pour recouper les couches de houille de la concession."
                            }
                        ]
                    }
