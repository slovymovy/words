                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "9ea792e5-c023-3126-970f-43bab3dea60a",
                        "entry_id": "cda36911-b709-3102-944e-14a2b527b214",
                        "glosses": [
                            "administracyjny okręg kościelny pod jurysdykcją biskupa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5eec256f-32da-4243-b36a-069b141fa9ab",
                                "sense_id": "9ea792e5-c023-3126-970f-43bab3dea60a",
                                "text": "To biskupstwo ustanowił Ojciec Święty Jan Paweł II."
                            },
                            {
                                "example_id": "e8681fd3-3f1a-48d8-a34e-c6f4ce35e1f9",
                                "sense_id": "9ea792e5-c023-3126-970f-43bab3dea60a",
                                "text": "Biskupstwo pomezańskie jest diecezją tytularną bp. Adama Wodarczyka."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
