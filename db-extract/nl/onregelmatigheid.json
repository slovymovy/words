                "entry_id": "77b3635b-8a94-3cba-a75b-7d2750d25077",
                "word": "onregelmatigheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "c3ecd837-f583-477b-bcd7-04e82afd86e6",
                        "entry_id": "77b3635b-8a94-3cba-a75b-7d2750d25077",
                        "tags": [
                            "plural"
                        ],
                        "form": "onregelmatigheden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7a680455-7bf9-3021-9fdd-352a201c919b",
                        "entry_id": "77b3635b-8a94-3cba-a75b-7d2750d25077",
                        "glosses": [
                            "iets wat niet volgens de regels is gegaan (er zijn frauduleuze handelingen verricht)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71e9e31f-9ca4-4ea1-bf30-251191c5bdf5",
                                "sense_id": "7a680455-7bf9-3021-9fdd-352a201c919b",
                                "text": "Er waren enkele onregelmatigheden gevonden in de aanbestedingsprocedure o.a. had de voorzitter van de commissie steekpenningen aangenomen."
                            }
                        ]
                    },
                    {
                        "sense_id": "33f08447-38bb-3f92-b454-40871b941c57",
                        "entry_id": "77b3635b-8a94-3cba-a75b-7d2750d25077",
                        "glosses": [
                            "niet gelijkmatig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa4d6bec-41f1-4bf0-8f32-2ce91b75b2cc",
                                "sense_id": "33f08447-38bb-3f92-b454-40871b941c57",
                                "text": "Door een onregelmatigheid in de draaisnelheid van de platenspeler was de kwaliteit van de muziek niet zo goed."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef42959a-3178-48ae-ab36-18594d8cd729",
                        "source_entry_id": "77b3635b-8a94-3cba-a75b-7d2750d25077",
                        "target_lang_word": "abnormality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abnormality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aa83e66e-b633-369b-953b-28b56fd3ba04",
                                        "entry_id": "dd8cb471-944d-3d40-8259-e3f163eb8c4f",
                                        "glosses": [
                                            "The state or quality of being abnormal; variation; irregularity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c8c773d-1a68-45cd-b85e-6fcb1f2336de",
                                                "sense_id": "aa83e66e-b633-369b-953b-28b56fd3ba04",
                                                "text": "Taylor said that her fame makes her \"sometimes\" miss the normality of being able to hang out with friends but that she's had to get used to \"the abnormality of my life\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f55ce250-88f6-3085-a629-daca7cd3bd8c",
                                        "entry_id": "dd8cb471-944d-3d40-8259-e3f163eb8c4f",
                                        "glosses": [
                                            "Something abnormal; an aberration; an abnormal occurrence or feature."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1105f1de-6ba5-46b3-a72a-ad1184d2815a",
                                                "sense_id": "f55ce250-88f6-3085-a629-daca7cd3bd8c",
                                                "text": "I want a full genetic analysis. We're going to examine any abnormality we find no matter how insignificant it seems."
                                            },
                                            {
                                                "example_id": "7284ac2f-3efa-4a79-bc17-2dbf7c46a283",
                                                "sense_id": "f55ce250-88f6-3085-a629-daca7cd3bd8c",
                                                "text": "The factors that filter out who “gets through” from conception to birth include chromosomal or genetic abnormalities of the fetus or the mother’s stress response to changes in her environment, Catalano said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df615b95-0c7c-4758-bb8c-8a2df1affe54",
                        "source_entry_id": "77b3635b-8a94-3cba-a75b-7d2750d25077",
                        "target_lang_word": "abnormity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abnormity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bbdceed3-ce3a-3aff-b6b1-8ff7104d6b50",
                                        "entry_id": "e7b9581a-66bd-3d1e-98a2-0ba71ee4607c",
                                        "glosses": [
                                            "Alternative form of abnormality"
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4721babf-70db-481e-84a4-0ff09db19361",
                                                "sense_id": "bbdceed3-ce3a-3aff-b6b1-8ff7104d6b50",
                                                "text": "Why do critics—some of them—make such short, smart work,—such cheerful, confident despatch, nowadays, of a story with religion in it, as if it were an abnormity,—a thing with sentence of death in itself, like a calf born with two heads,—that needs not their trouble, save to name it as it is?"
                                            },
                                            {
                                                "example_id": "8ef2f0d8-2575-4f60-8b0d-f7f0cc36a252",
                                                "sense_id": "bbdceed3-ce3a-3aff-b6b1-8ff7104d6b50",
                                                "text": "Abnormity was detected during the flight of the rocket, which blasted off at 7:23 p.m. Sunday from Wenchang Space Launch Center in southern province of Hainan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7889c8cc-616b-3b06-99b3-c7b26fe5d78a",
                                        "entry_id": "e7b9581a-66bd-3d1e-98a2-0ba71ee4607c",
                                        "glosses": [
                                            "A monstrosity"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a8f39fc-f81d-4ae8-8d17-9ed203922579",
                        "source_entry_id": "77b3635b-8a94-3cba-a75b-7d2750d25077",
                        "target_lang_word": "anomaly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anomaly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4564c0a-afe0-3581-a699-5ddaa14f8bbd",
                                        "entry_id": "4e4524bb-efba-3d74-91b3-cf5c5085259a",
                                        "glosses": [
                                            "A deviation from a rule or from what is regarded as normal; an outlier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "254a5a76-482c-4d25-9fc2-2d04237d6980",
                                                "sense_id": "c4564c0a-afe0-3581-a699-5ddaa14f8bbd",
                                                "text": "This ardent exploration, absorbing all his energy and interest, made him forget for the moment the mystery of his heritage and the anomaly that cut him off from all his fellows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec3d3cc6-4803-3c95-85a0-41e3d4ba9319",
                                        "entry_id": "4e4524bb-efba-3d74-91b3-cf5c5085259a",
                                        "glosses": [
                                            "Something or someone that is strange or unusual."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38663990-7354-457a-928b-140cc5607e51",
                                                "sense_id": "ec3d3cc6-4803-3c95-85a0-41e3d4ba9319",
                                                "text": "He is an anomaly among his friends in that he's the only one who's unmarried."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f8925d2-289b-3df9-9e97-b90fcc09959c",
                                        "entry_id": "4e4524bb-efba-3d74-91b3-cf5c5085259a",
                                        "glosses": [
                                            "Any event or measurement that is out of the ordinary regardless of whether it is exceptional or not."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abaa15b5-cfa5-4054-90b7-cb84db2f1fcc",
                                                "sense_id": "8f8925d2-289b-3df9-9e97-b90fcc09959c",
                                                "text": "She disregarded some of the anomalies in the experiment, putting them down to miscalculation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ed8484c-2c09-36d2-954c-ae2ffa4624a1",
                                        "entry_id": "4e4524bb-efba-3d74-91b3-cf5c5085259a",
