                "senses": [
                    {
                        "sense_id": "0135d450-5bba-36b0-bad3-f8f35c87c4e3",
                        "entry_id": "0011b5c6-dce7-3202-a1e6-16df361d14a6",
                        "glosses": [
                            "Änderung eines Schienenweges, auf dem sich ein Schienenfahrzeug fortbewegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e2a8838-64ad-42cb-8794-8e8f9e578302",
                                "sense_id": "0135d450-5bba-36b0-bad3-f8f35c87c4e3",
                                "text": "Heute gibt es eine Gleisänderung: der Zug fährt auf Gleis 7 statt auf Gleis 8."
                            },
                            {
                                "example_id": "b03ecc91-5d20-4c8e-b583-b32d9ec9da24",
                                "sense_id": "0135d450-5bba-36b0-bad3-f8f35c87c4e3",
                                "text": "„Neben Gleisänderungen und Verspätungen erregten besonders ungültig gewordene Reservierungen den Unmut der Fahrgäste.“"
                            },
                            {
                                "example_id": "7d03495d-ee63-4c9f-9982-12f0c5cc53a0",
                                "sense_id": "0135d450-5bba-36b0-bad3-f8f35c87c4e3",
                                "text": "„Und die Nationalspieler lernten gleich mal den Bahn-Alltag kennen: Gleisänderung, erst mit 11 Minuten Verspätung ging es los, der Zug dazu proppevoll.“"
                            },
                            {
                                "example_id": "0a936912-febd-420a-9ce7-a69a2a846557",
                                "sense_id": "0135d450-5bba-36b0-bad3-f8f35c87c4e3",
                                "text": "„Dauerdurchsagen zu Störungen, Verspätungen, Zugsausfällen und plötzlichen Gleisänderungen sind zur Begleitmusik fast jeder Reise geworden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
