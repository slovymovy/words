                                "target_senses": [
                                    {
                                        "sense_id": "6de016c7-b3cc-3244-b34a-112730d9cb1d",
                                        "entry_id": "84602efb-3051-3cb3-9c4e-63e6bee16ab0",
                                        "glosses": [
                                            "volgens de opvattingen van Plato"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47f69ad2-e4ee-486e-b074-cf3488fc9aba",
                                                "sense_id": "6de016c7-b3cc-3244-b34a-112730d9cb1d",
                                                "text": "Boven het oppervlak van de aarde valt er helemaal níéts te beleven. Dat is Wittgenstein. Tégen de platonische neiging om te zoeken naar de essentie, naar wat nou echt het goede is, of het huwelijk, of de dood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a3110f0-b3a5-3c27-9f73-47bce479838f",
                                        "entry_id": "84602efb-3051-3cb3-9c4e-63e6bee16ab0",
                                        "glosses": [
                                            "zonder seks"
                                        ],
                                        "tags": [
                                            "van liefde"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c17d900-53aa-4b3f-a6d8-fc684f3f148b",
                                                "sense_id": "4a3110f0-b3a5-3c27-9f73-47bce479838f",
                                                "text": "Hij had met zijn vrouw een platonische relatie."
                                            },
                                            {
                                                "example_id": "eddecde4-b9e6-49f5-885c-f7597b7597e2",
                                                "sense_id": "4a3110f0-b3a5-3c27-9f73-47bce479838f",
                                                "text": "Poëzie schrijven en wekenlang chatten zonder vooruitzicht op een echte ontmoeting. Misschien bloeit de platonische liefde wel op."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
