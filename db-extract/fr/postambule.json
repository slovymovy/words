                "word": "postambule",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ba103ec0-d948-44af-94fc-1c03abdf3aa0",
                        "entry_id": "a56c95d1-f743-3e1b-bfe9-57a906a1a64e",
                        "tags": [
