                ],
                "senses": [
                    {
                        "sense_id": "4b198ff1-cfe0-32ea-b07a-986c7fee4c7c",
                        "entry_id": "6f83bc82-dc34-32cd-a7d8-1dc0b1725151",
                        "glosses": [
                            "внеплановый отдых, предоставляемый работнику как компенсация за переработку"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7bec151-d4a4-42f1-8d2c-fe5e0b75b29c",
                                "sense_id": "4b198ff1-cfe0-32ea-b07a-986c7fee4c7c",
                                "text": "Я нажал было кнопку звонка, но тут же вспомнил, что секретарша взяла отгул."
                            },
                            {
                                "example_id": "94a8cdc2-da42-4b90-8b3e-781394943cde",
                                "sense_id": "4b198ff1-cfe0-32ea-b07a-986c7fee4c7c",
                                "text": "В следующий понедельник у меня отгул, и я тебя отсюда заберу…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65b04e21-df63-4ed3-ba62-d66090cd5b9f",
                        "source_entry_id": "6f83bc82-dc34-32cd-a7d8-1dc0b1725151",
                        "source_sense_id": "4b198ff1-cfe0-32ea-b07a-986c7fee4c7c",
                        "target_lang_word": "congé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "congé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "681ce199-dc67-3ec1-8e7a-40c39eebb49c",
                                        "entry_id": "d829b6e8-2564-36a4-b9c4-5e589249736e",
                                        "glosses": [
                                            "Permission d’aller, de venir, de s’absenter, de se retirer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1902bf12-161d-4b90-909c-c5b8897a967f",
                                                "sense_id": "681ce199-dc67-3ec1-8e7a-40c39eebb49c",
                                                "text": "Cet employé a obtenu un congé de huit jours."
                                            },
                                            {
                                                "example_id": "f4554727-6834-4a1f-80fe-5ef89304f8ec",
                                                "sense_id": "681ce199-dc67-3ec1-8e7a-40c39eebb49c",
                                                "text": "Lui-même, à son dernier congé, en plaisantait devant moi, d'être un gradé de la marine qui, comme le petit navire de la chanson, n'avait ja-ja-jamais navigué."
                                            },
                                            {
                                                "example_id": "3f37c9dc-cabc-40b6-931f-0a6d871cebaf",
                                                "sense_id": "681ce199-dc67-3ec1-8e7a-40c39eebb49c",
                                                "text": "Alors maman, qui, en toutes circonstances, savait ce qui se fait et ce qui ne se fait pas, se leva et nous obligea tous à nous lever, sauf Mme Duport qui dut sentir le congé que lui signifiait maman, adouci d’une formule de gratitude pour les renseignements qu’elle nous avait donnés."
                                            },
                                            {
                                                "example_id": "354ed9e5-e587-4232-a9b5-11cc4ec180e6",
                                                "sense_id": "681ce199-dc67-3ec1-8e7a-40c39eebb49c",
                                                "text": "Congé de convalescence. Être en congé."
                                            },
                                            {
                                                "example_id": "cfbb8304-5457-46d2-80d2-47b797ccdb7a",
                                                "sense_id": "681ce199-dc67-3ec1-8e7a-40c39eebb49c",
                                                "text": "Accorder un congé de huit jours."
                                            },
                                            {
                                                "example_id": "496148d3-ae59-4a93-b58b-b27f1a4d3f61",
                                                "sense_id": "681ce199-dc67-3ec1-8e7a-40c39eebb49c",
                                                "text": "Ce député a demandé un congé à la Chambre, pour cause de maladie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "639c24da-475a-388f-b73a-22f4768497e7",
                                        "entry_id": "d829b6e8-2564-36a4-b9c4-5e589249736e",
                                        "glosses": [
                                            "En parlant d’un domestique, action de se retirer tout à fait ou fait d'être renvoyé par son maître."
                                        ],
                                        "tags": [
                                            "dated",
                                            "especially"
                                        ],
                                        "note": "Dans ce sens, s'emploie généralement avec l'adjectif possessif",
                                        "examples": [
                                            {
                                                "example_id": "4141e1f2-623d-49bd-9508-91205783168b",
                                                "sense_id": "639c24da-475a-388f-b73a-22f4768497e7",
                                                "text": "Un domestique qui demande son congé."
                                            },
                                            {
                                                "example_id": "864a25c0-029c-4ec2-80f8-9f8ff6673b55",
                                                "sense_id": "639c24da-475a-388f-b73a-22f4768497e7",
                                                "text": "Son maître lui a donné congé, son congé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "689790fc-2160-39bd-8849-5d4d1558da83",
                                        "entry_id": "d829b6e8-2564-36a4-b9c4-5e589249736e",
                                        "glosses": [
                                            "Vacances scolaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ae2493c-9135-4f43-9539-9285393674a5",
                                                "sense_id": "689790fc-2160-39bd-8849-5d4d1558da83",
                                                "text": "Jours de congé."
                                            },
                                            {
                                                "example_id": "b888742a-381f-4900-abe5-834e5d315c01",
                                                "sense_id": "689790fc-2160-39bd-8849-5d4d1558da83",
                                                "text": "Les élèves ont eu congé."
                                            },
                                            {
                                                "example_id": "5b514715-4b10-488c-b7a4-e91ce6b2cb2d",
                                                "sense_id": "689790fc-2160-39bd-8849-5d4d1558da83",
                                                "text": "C’est demain congé."
                                            },
                                            {
                                                "example_id": "226c64bb-6cda-4ce9-99f1-eb932330cf0a",
                                                "sense_id": "689790fc-2160-39bd-8849-5d4d1558da83",
                                                "text": "Les congés de Noël, de Pâques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e68ab2d-f959-3aa5-94e5-85653193fc47",
                                        "entry_id": "d829b6e8-2564-36a4-b9c4-5e589249736e",
                                        "glosses": [
                                            "Permission, autorisation."
                                        ],
                                        "tags": [
                                            "Simplement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebea0542-a274-458f-b3b1-b006cf3483ce",
                                                "sense_id": "1e68ab2d-f959-3aa5-94e5-85653193fc47",
                                                "text": "Se marier sans le congé de ses parents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23479163-15c1-3ce7-8cc2-7181f28fac0e",
                                        "entry_id": "d829b6e8-2564-36a4-b9c4-5e589249736e",
                                        "glosses": [
                                            "Permission de transporter la marchandise dont les droits ont été acquittés."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3c7e80a-8546-4f19-98b8-0225289bddb5",
                                                "sense_id": "23479163-15c1-3ce7-8cc2-7181f28fac0e",
                                                "text": "On peut expédier ce vin, voici le congé."
                                            },
                                            {
                                                "example_id": "f62a1b95-7e47-4113-a258-dcdb3a2a3b05",
                                                "sense_id": "23479163-15c1-3ce7-8cc2-7181f28fac0e",
                                                "text": "Le 29 janvier 1686, il stipule que tout canot chargé de marchandises et ne possédant pas de congé dûment signé sera confisqué."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47c9706f-7ad7-348a-85b8-f3cedf69d27d",
                                        "entry_id": "d829b6e8-2564-36a4-b9c4-5e589249736e",
                                        "glosses": [
                                            "Arrondi rentrant créant un raccordement progressif entre deux surfaces."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "467153ce-b9ed-37b8-826f-b58df00f0607",
                                        "entry_id": "d829b6e8-2564-36a4-b9c4-5e589249736e",
                                        "glosses": [
                                            "Raccordement d'une moulure et d'un parement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2ba373e0-6f76-35f5-a882-37e57753b213",
                                        "entry_id": "d829b6e8-2564-36a4-b9c4-5e589249736e",
                                        "glosses": [
                                            "Outil de sculpteur pour faire un congé."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8664de88-57bf-3814-b762-e3ccc98419de",
                                        "entry_id": "d829b6e8-2564-36a4-b9c4-5e589249736e",
                                        "glosses": [
                                            "Laissez-passer que le capitaine d'un navire doit avoir quand il quitte le port pour prendre la mer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d03d5410-9472-3655-a6c9-9c267e7b72e6",
                                        "entry_id": "d829b6e8-2564-36a4-b9c4-5e589249736e",
                                        "glosses": [
                                            "Acte, écrit ou verbal, par lequel le propriétaire ou le principal locataire d’une maison, d’une ferme, etc., signifie à un locataire ou fermier qu’il ait à vider les lieux dans un certain temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1499255f-2385-4706-84f7-6f5fccf36bae",
                                                "sense_id": "d03d5410-9472-3655-a6c9-9c267e7b72e6",
                                                "text": "Ce propriétaire a donné congé à son fermier, à son locataire."
                                            },
                                            {
                                                "example_id": "730a77c4-483a-45ca-9b16-413922ef2b95",
                                                "sense_id": "d03d5410-9472-3655-a6c9-9c267e7b72e6",
                                                "text": "Recevoir congé."
                                            },
                                            {
                                                "example_id": "63380107-4f17-4712-9a11-c6c4aab57759",
                                                "sense_id": "d03d5410-9472-3655-a6c9-9c267e7b72e6",
                                                "text": "À sa sortie de l’hôpital, elle réintégra son petit appartement de la rue des Entrepreneurs (Justine avait réussi à convaincre sa propriétaire de ne pas tenir compte du congé que celle-ci lui avait adressé)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b922c1c6-7f49-327a-a04f-a738681965f3",
                                        "entry_id": "d829b6e8-2564-36a4-b9c4-5e589249736e",
                                        "glosses": [
                                            "Acte, écrit ou verbal, par lequel le propriétaire ou le principal locataire d’une maison, d’une ferme, etc., signifie à un locataire ou fermier qu’il ait à vider les lieux dans un certain temps.",
                                            "On le dit également d’un locataire à l’égard du propriétaire ou du principal locataire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5c8df8a-6e32-4fc2-a9ac-f808cbc6db4f",
                                                "sense_id": "b922c1c6-7f49-327a-a04f-a738681965f3",
                                                "text": "Lorsque le locataire se marie en cours de bail, le conjoint qui n'a pas signé le contrat peut quand même se prévaloir du bail. Il faudra donc que le renon donné par les locataires soit signé par les deux époux et si l'un ne le fait pas, le bailleur pourra considérer que le congé est nul."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
