                                "target_senses": [
                                    {
                                        "sense_id": "7827d5e6-f56e-368f-9e38-1bdefee8f165",
                                        "entry_id": "bac499c0-7861-32e4-9012-e50091e0aa38",
                                        "glosses": [
                                            "A collection of papers collated and archived together."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e88706b7-b8e7-46b5-8a6d-0aa2c7e7e59d",
                                                "sense_id": "7827d5e6-f56e-368f-9e38-1bdefee8f165",
                                                "text": "It is upon a file with the duke's other letters."
                                            },
                                            {
                                                "example_id": "3720cb28-b230-4e2b-b3ad-04b493d96389",
                                                "sense_id": "7827d5e6-f56e-368f-9e38-1bdefee8f165",
                                                "text": "We'd like to know a little bit about you for our files\nWe'd like to help you learn to help yourself"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9689650-6ffa-3b37-ad64-770235cdac41",
                                        "entry_id": "bac499c0-7861-32e4-9012-e50091e0aa38",
                                        "glosses": [
                                            "A roll or list."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d58fbb1-b741-4c6d-836c-1ef687bdded2",
                                                "sense_id": "f9689650-6ffa-3b37-ad64-770235cdac41",
                                                "text": "a file of all the gentry"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27529d0a-4c08-3d5c-845f-e22b45da438b",
                                        "entry_id": "bac499c0-7861-32e4-9012-e50091e0aa38",
                                        "glosses": [
                                            "A course of thought; a thread of narration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6105f7e4-c3ee-4179-ae45-6bd3791d650f",
                                                "sense_id": "27529d0a-4c08-3d5c-845f-e22b45da438b",
                                                "text": "Let me resume the file of my narration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6126aa68-d7ea-3678-ae3a-9a88933b3d4f",
                                        "entry_id": "bac499c0-7861-32e4-9012-e50091e0aa38",
                                        "glosses": [
                                            "An aggregation of data on a storage device, identified by a name."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b981b059-7fae-47b0-9c06-e432c9b9eec9",
                                                "sense_id": "6126aa68-d7ea-3678-ae3a-9a88933b3d4f",
                                                "text": "He had created a file for coding to design a new product."
                                            },
                                            {
                                                "example_id": "440f340c-7e1a-4d19-82f9-b8493faba6d6",
                                                "sense_id": "6126aa68-d7ea-3678-ae3a-9a88933b3d4f",
                                                "text": "I'm going to delete these unwanted files to free up some disk space."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a106655d-53d8-33d8-95dc-53c47adf91df",
                                        "entry_id": "bac499c0-7861-32e4-9012-e50091e0aa38",
                                        "glosses": [
                                            "A row of modular kitchen units and a countertop, consisting of cabinets and appliances below (dishwasher) and next to (stove/cooker) a countertop."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d945c1b-9714-4780-89fe-1bdb7e620f65",
                                                "sense_id": "a106655d-53d8-33d8-95dc-53c47adf91df",
                                                "text": "Many homes now have double-file kitchens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a29ae6d-c616-3450-94ae-719609b4bf19",
                                        "entry_id": "bac499c0-7861-32e4-9012-e50091e0aa38",
                                        "glosses": [
                                            "Clipping of file cabinet."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "abbreviation",
                                            "alt-of",
                                            "clipping"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72f3eb4d-e2a0-49f8-9365-b570ce96364c",
                                                "sense_id": "2a29ae6d-c616-3450-94ae-719609b4bf19",
                                                "text": "The Nonfiction Vertical File: […]I spent my university years working in the library at the Maritime School of Social Work. One of my responsibilities was to keep the library's vertical file up to date. The vertical file was a cabinet full of current newspaper and magazine clippings on topics of interest to the students and faculty of the school."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "file",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25c3446f-01b5-32e5-93e8-7cab8605e9c3",
                                        "entry_id": "cffc0cb9-3aa7-3195-8572-a090eb8dd9ff",
                                        "glosses": [
                                            "To commit (official papers) to some office."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "650e6b82-ebc8-4af2-b02d-54feaf70e3cb",
                                                "sense_id": "25c3446f-01b5-32e5-93e8-7cab8605e9c3",
                                                "text": "She filed their accounts yesterday."
                                            },
                                            {
                                                "example_id": "e21221e1-47d7-4b0c-b4cc-58881d0a387c",
                                                "sense_id": "25c3446f-01b5-32e5-93e8-7cab8605e9c3",
                                                "text": "The episode’s unwillingness to fully commit to the pathos of the Bart-and-Laura subplot is all the more frustrating considering its laugh quota is more than filled by a rollicking B-story that finds Homer, he of the iron stomach and insatiable appetite, filing a lawsuit against The Frying Dutchman when he’s hauled out of the eatery against his will after consuming all of the restaurant’s shrimp (plus two plastic lobsters)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf57db80-9244-395a-b65f-e1407f97cdba",
                                        "entry_id": "cffc0cb9-3aa7-3195-8572-a090eb8dd9ff",
                                        "glosses": [
                                            "(of a journalist) To submit (an article) to a newspaper or similar publication."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfb68033-6228-4077-b5ce-4bfd87671a1e",
                                                "sense_id": "cf57db80-9244-395a-b65f-e1407f97cdba",
                                                "text": "I filed my copy soon after the interview."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e43b9ea7-f6c8-39e8-9f4f-499e21d06af3",
                                        "entry_id": "cffc0cb9-3aa7-3195-8572-a090eb8dd9ff",
                                        "glosses": [
                                            "To place in an archive in a logical place and order."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "551a9e2c-a6d1-4fb3-9f54-c6e9d349c5f1",
                                                "sense_id": "e43b9ea7-f6c8-39e8-9f4f-499e21d06af3",
                                                "text": "Troves of documents filed away in the depository."
                                            }
                                        ]
                                    },
                                    {
