    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e86bc837-bf6c-37cf-a9f6-1577ccba663b",
                    "sense_definition": "Een bedrijf dat goederen in grote hoeveelheden inkoopt bij fabrikanten en deze doorverkoopt aan winkeliers of andere zakelijke klanten.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zakelijke handel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De eigenaar van de supermarkt koopt zijn voorraad wekelijks in bij een lokale <w>groothandel</w>.",
                            "target_lang_translations": {
                                "en": "The supermarket owner buys his stock weekly from a local <w>wholesaler</w>."
                            }
                        },
                        {
                            "text": "Deze <w>groothandel</w> in bouwmaterialen levert uitsluitend aan geregistreerde aannemers en bedrijven.",
                            "target_lang_translations": {
                                "en": "This <w>wholesale company</w> in building materials supplies exclusively to registered contractors and businesses."
                            }
                        }
                    ],
                    "synonyms": [
                        "grossierderij",
                        "grossier"
                    ],
                    "antonyms": [
                        "detailhandel",
                        "kleinhandel"
                    ],
                    "common_phrases": [
                        "lokale groothandel",
                        "groothandel in bouwmaterialen"
                    ],
                    "target_lang_definitions": {
                        "en": "A company that purchases goods in large quantities from manufacturers and resells them to retailers or other business customers."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wholesaler",
                                "target_lang_sense_clarification": "a business entity"
                            },
                            {
                                "target_lang_word": "wholesale company",
                                "target_lang_sense_clarification": "a business entity"
                            },
                            {
                                "target_lang_word": "wholesale business",
                                "target_lang_sense_clarification": "a business entity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff3225b6-b155-3bc0-b0f4-322a35d6d2d0",
                    "sense_definition": "De economische sector of activiteit van het verhandelen van goederen op grote schaal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zakelijke handel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De marges in de <w>groothandel</w> zijn vaak kleiner dan die in de detailhandel.",
                            "target_lang_translations": {
                                "en": "Margins in <w>wholesale</w> are often smaller than those in retail."
                            }
                        },
                        {
                            "text": "Hij werkt al jaren in de <w>groothandel</w> en kent de markt voor elektronica door en door.",
                            "target_lang_translations": {
                                "en": "He has been working in <w>wholesale</w> for years and knows the electronics market inside out."
                            }
                        }
                    ],
                    "antonyms": [
                        "kleinhandel",
                        "detailhandel"
                    ],
                    "common_phrases": [
                        "werken in de groothandel"
                    ],
                    "target_lang_definitions": {
                        "en": "The economic sector or activity of trading goods on a large scale."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wholesale",
                                "target_lang_sense_clarification": "the sector or activity"
                            },
                            {
                                "target_lang_word": "wholesale trade",
                                "target_lang_sense_clarification": "the economic sector"
                            }
                        ]
                    }
                }
            ]
        }
    ]
