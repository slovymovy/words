                "senses": [
                    {
                        "sense_id": "de085fbd-1d38-346b-82a9-27afd9f7d66f",
                        "entry_id": "0166465d-a374-38a6-a9d2-aebf62a24ec5",
                        "glosses": [
                            "Personne qui travaille en dehors du lieu habituellement dédié dans l’entreprise, grâce aux appareils mobiles connectés à l’internet."
                        ],
                        "tags": [
                            "Anglicism",
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "f4e77cd8-0f9e-435a-a76a-ef103c9a8272",
                                "sense_id": "de085fbd-1d38-346b-82a9-27afd9f7d66f",
                                "text": "Un moofer, c’est un travailleur « mobile », qui fait son job hors de son bureau, à partir de chez lui, ou depuis n’importe quel endroit, grâce aux nouvelles technologies et, donc, à Internet."
                            },
                            {
                                "example_id": "59f8f229-d6ff-4f5d-bfe5-4a252707f0e6",
                                "sense_id": "de085fbd-1d38-346b-82a9-27afd9f7d66f",
                                "text": "Là où le philosophe se nourrissait de l’ambiance du lieu pour épaissir l’argumentaire de L’Être et le Néant, le moofer a au contraire tendance à s’en abstraire par la magie ubiquitaire de la connexion Internet."
                            },
                            {
                                "example_id": "3da03a0a-06fd-4bca-afe4-b032bd24f479",
                                "sense_id": "de085fbd-1d38-346b-82a9-27afd9f7d66f",
                                "text": "Il n’est pas rare de voir un moofer savourer un café au lait au café tout en utilisant un ordinateur portable pour lire des e-mails et travailler sur divers documents."
                            }
                        ]
                    }
                ],
