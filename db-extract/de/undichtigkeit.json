                ],
                "senses": [
                    {
                        "sense_id": "806c8fc1-f1b8-384c-8ec9-a697a994145b",
                        "entry_id": "a87c9e75-96ed-34bd-83f6-ed408293766c",
                        "glosses": [
                            "undichte Stelle; abgrenzende Fläche, die für eine Substanz durchlässig, permeabel ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b442658b-77c1-4053-9b10-28e181d492bd",
                                "sense_id": "806c8fc1-f1b8-384c-8ec9-a697a994145b",
                                "text": "„Der Geschäftsführer der Wiener Gasnetze, Gerhard Fida, schloss eine Undichtigkeit in der Hausleitung aus.“"
                            },
                            {
                                "example_id": "4fa75996-7664-4d3e-9b09-e52f7ef99c54",
                                "sense_id": "806c8fc1-f1b8-384c-8ec9-a697a994145b",
                                "text": "„Das Löschmittel wird mit Kohlendioxid oder Stickstoff aus dem Gerät getrieben; mit der Zeit kann durch kleinste Undichtigkeiten Treibgas entweichen, der Feuerlöscher erfüllt dann seinen Zweck nicht mehr.“"
                            },
                            {
                                "example_id": "2886e00d-b856-46a9-8cda-55d49c23b22a",
                                "sense_id": "806c8fc1-f1b8-384c-8ec9-a697a994145b",
                                "text": "„Sollten sich als Ursachen des Ölaustritts schadhafte Bohrloch-Verrohrungen oder Undichtigkeiten der Kaverne selbst herausstellen, müssten alle unterirdischen Speicher für Öl und Gas überprüft werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
