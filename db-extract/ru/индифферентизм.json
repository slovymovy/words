                "senses": [
                    {
                        "sense_id": "a6ec3c41-58ab-3661-8294-1d901fd8c340",
                        "entry_id": "2298a3e7-2a07-335b-8bd6-0163c7bd117a",
                        "glosses": [
                            "книжн. индифферентное, безучастное, безразличное отношение к кому-л., чему-л.; равнодушие"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eadb388c-12af-4ad8-b246-0f377c0de073",
                                "sense_id": "a6ec3c41-58ab-3661-8294-1d901fd8c340",
                                "text": "Общественное мнение отличалось странным индифференти́змом к общим вопросам; как тут было не измельчать литературе?"
                            },
                            {
                                "example_id": "51db85db-e757-45b4-b661-939ff599f56f",
                                "sense_id": "a6ec3c41-58ab-3661-8294-1d901fd8c340",
                                "text": "[Медведенко:] Я люблю вас — и встречаю один лишь индифференти́зм с вашей стороны."
                            }
                        ]
                    }
                ],
