                ],
                "senses": [
                    {
                        "sense_id": "d8b1c302-4130-3f76-a908-7b41bce34508",
                        "entry_id": "909cafa0-0c15-3b80-b1f6-935c727f6c01",
                        "glosses": [
                            "Qui a le caractère d’un délit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ebbf587-87b3-4124-aefd-77844eb455d9",
                                "sense_id": "d8b1c302-4130-3f76-a908-7b41bce34508",
                                "text": "Une opération rassemblant 450 policiers a visé, mardi, le square de Forceval, près de la porte de la Villette (19ᵉ), pour contrôler ce « site de consommation de crack à ciel ouvert », où ont lieu « trafics » et « actes délictueux », selon les mots du nouveau préfet de police Laurent Nuñez."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "125af008-c876-4991-9343-1c6563060f37",
                        "source_entry_id": "909cafa0-0c15-3b80-b1f6-935c727f6c01",
                        "source_sense_id": "d8b1c302-4130-3f76-a908-7b41bce34508",
                        "target_lang_word": "strafbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "strafbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aefbb1fd-ad4b-3680-8d02-51bf3b0b741c",
                                        "entry_id": "18bf31eb-646b-346a-8e9b-64570214f60a",
                                        "glosses": [
                                            "vom Gesetz unter Strafe gestellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24741a2f-137d-4bc4-a3a6-6586a6c2fa4e",
                                                "sense_id": "aefbb1fd-ad4b-3680-8d02-51bf3b0b741c",
                                                "text": "„Zeugen oder Sachverständige, die vor Gericht falsch aussagen, machen sich strafbar nach § 153 StGB. – In Österreich strafbar nach §§ 288, 289 StGB, in der Schweiz nach Art. 306 Abs. 1 (Parteien eines Zivilprozesses) und Art. 307 Abs. 1 (Zeugen, Sachverständige und Übersetzer vor Gericht) StGB.“"
                                            },
                                            {
                                                "example_id": "65f08943-6605-4923-abdd-f1919e4b9566",
                                                "sense_id": "aefbb1fd-ad4b-3680-8d02-51bf3b0b741c",
                                                "text": "Eine Ärztin wurde vom Amtsgericht Gießen zu einer Geldstrafe verurteilt, weil sie auf ihrer Webseite Schwangerschaftsabbrüche anbietet - laut Paragraf 219a hat sie sich damit strafbar gemacht."
                                            },
                                            {
                                                "example_id": "5f09a10e-bf07-4972-b505-3a801233b050",
                                                "sense_id": "aefbb1fd-ad4b-3680-8d02-51bf3b0b741c",
                                                "text": "„Die Korruptionsjäger haben umfangreich geprüft, ob Straches öffentlich einsehbare Aussagen auf Ibiza strafbar waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a667aded-eca5-4790-92f8-488675dd4e34",
                        "source_entry_id": "909cafa0-0c15-3b80-b1f6-935c727f6c01",
                        "source_sense_id": "d8b1c302-4130-3f76-a908-7b41bce34508",
                        "target_lang_word": "criminal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "criminal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55b6cd5a-e2d8-312f-afae-dfe9b0969c8c",
                                        "entry_id": "ddc6f5d0-7173-3382-af3f-b7ba678931cd",
                                        "glosses": [
                                            "Against the law; forbidden by law."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70f7d501-5a7f-43a1-9886-32954ba41e3a",
                                                "sense_id": "55b6cd5a-e2d8-312f-afae-dfe9b0969c8c",
                                                "text": "Foppish and fantastic ornaments are only indications of vice, not criminal in themselves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa93c8a7-f2ca-3a4b-bd5d-3de22a58d445",
                                        "entry_id": "ddc6f5d0-7173-3382-af3f-b7ba678931cd",
                                        "glosses": [
                                            "Guilty of breaking the law."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aed011c3-7ef0-41d1-8e54-a456f52a665e",
                                                "sense_id": "aa93c8a7-f2ca-3a4b-bd5d-3de22a58d445",
                                                "text": "The neglect of any of the relative duties renders us criminal in the sight of God."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c40ba212-245f-30a8-85d7-01d38c09cc12",
                                        "entry_id": "ddc6f5d0-7173-3382-af3f-b7ba678931cd",
                                        "glosses": [
                                            "Of or relating to crime or penal law."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80a41cd0-17e0-4b42-a100-93ba91cf7d56",
                                                "sense_id": "c40ba212-245f-30a8-85d7-01d38c09cc12",
                                                "text": "His long criminal record suggests that he is a dangerous man."
                                            },
                                            {
                                                "example_id": "9f9a7a7e-0711-4584-9ccf-30b0848b410a",
                                                "sense_id": "c40ba212-245f-30a8-85d7-01d38c09cc12",
                                                "text": "The officers and servants of the crown, violating the personal liberty, or other right of the subject […] in some cases, were liable to criminal process."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fbee928-c0c1-3e1c-80ee-3f7d179d178e",
                                        "entry_id": "ddc6f5d0-7173-3382-af3f-b7ba678931cd",
                                        "glosses": [
                                            "Abhorrent or very undesirable."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fae899eb-eafa-49ee-8cc3-93e4f1efa7b5",
                                                "sense_id": "0fbee928-c0c1-3e1c-80ee-3f7d179d178e",
                                                "text": "Printing such asinine opinions is criminal!"
                                            },
                                            {
                                                "example_id": "10389080-f78b-44ee-b222-6f23db83449c",
                                                "sense_id": "0fbee928-c0c1-3e1c-80ee-3f7d179d178e",
                                                "text": "[...] I think it represents exceptional value for money and I think it would be criminal not to go ahead and build it.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "criminal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "baf43a50-e9c6-345d-9f2d-955a6704586f",
                                        "entry_id": "b1231746-5138-34b3-93e1-19bbb808e638",
                                        "glosses": [
                                            "A person who is guilty of a crime, notably breaking the law."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36460d70-34bf-47f2-b5c0-011db40d8924",
                                                "sense_id": "baf43a50-e9c6-345d-9f2d-955a6704586f",
                                                "text": "‘[…] There's every Staffordshire crime-piece ever made in this cabinet, and that's unique. The Van Hoyer Museum in New York hasn't that very rare second version of Maria Marten's Red Barn over there, nor the little Frederick George Manning—he was the criminal Dickens saw hanged on the roof of the gaol in Horsemonger Lane, by the way—’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
