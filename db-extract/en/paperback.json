                    {
                        "translation_id": "46e73124-6f96-4b09-97ba-542b98c0ffd1",
                        "source_entry_id": "08daf41e-5a99-35ac-b4a6-8e27e123fa7f",
                        "source_sense_id": "734ecf92-f5b0-3925-80a1-64cd233f86ce",
