                ],
                "senses": [
                    {
                        "sense_id": "e0f89818-3957-33b9-b269-6ab9d79ce339",
                        "entry_id": "b7bf1f91-26f6-3d65-bc19-8f331aa1ecc6",
                        "glosses": [
                            "Forme de nationalisme dans lequel la nation et la nationalité sont définies en termes d’ethnicité, en mettant l’accent sur une approche ethnocentrique (et dans certains cas ethnocratique)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e06421e-5cb5-4d87-a8a3-3ba50e6801a0",
                                "sense_id": "e0f89818-3957-33b9-b269-6ab9d79ce339",
                                "text": "Du Brésil à la France, des États-Unis à l’Allemagne, les hérauts d’un ethnonationalisme désinhibé mettent en scène une paranoïa civilisationnelle."
                            },
                            {
                                "example_id": "b30fe800-852a-41e7-99a6-0d24df4de486",
                                "sense_id": "e0f89818-3957-33b9-b269-6ab9d79ce339",
                                "text": "Dans son discours de Rome, Marion Maréchal donne un aperçu de ce qui constitue l’ethnonationalisme aujourd’hui : une pensée contre-minoritaire qui dénonce, sous la même bannière, féminisme critique, élitisme, construction européenne, postcolonialisme et islamisme :…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "598c2c17-7615-49e4-a05d-76007345fcd1",
                        "source_entry_id": "b7bf1f91-26f6-3d65-bc19-8f331aa1ecc6",
                        "source_sense_id": "e0f89818-3957-33b9-b269-6ab9d79ce339",
