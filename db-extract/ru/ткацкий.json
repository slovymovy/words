                "senses": [
                    {
                        "sense_id": "7fbb1b91-6d4b-3dc1-8a85-257b762e7e67",
                        "entry_id": "30ce4e8a-026f-3062-adf6-928f2e731a52",
                        "glosses": [
                            "относящийся к ткачеству, тканью, служащий для тканья"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e204e5f-ecd2-4176-ab1c-02fb89e30736",
                                "sense_id": "7fbb1b91-6d4b-3dc1-8a85-257b762e7e67",
                                "text": "Он бережно заворачивает книгу в край кожаного фартука и несёт на окраину, в длинное полутёмное здание ткацкой мастерской."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83e96e53-59ff-4092-8114-c6d55b4ed8f4",
                        "source_entry_id": "30ce4e8a-026f-3062-adf6-928f2e731a52",
                        "source_sense_id": "7fbb1b91-6d4b-3dc1-8a85-257b762e7e67",
                        "target_lang_word": "weaving",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "weaving",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53430f47-5d8b-3411-81cc-cfccc1707509",
                                        "entry_id": "908df2d1-fb04-37a5-9b84-c1d6a635e1bc",
                                        "glosses": [
                                            "The process of making woven material on a loom."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a07c9033-e7da-384d-898d-98d012ac5e6d",
                                        "entry_id": "908df2d1-fb04-37a5-9b84-c1d6a635e1bc",
                                        "glosses": [
                                            "A piece of such material."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0a094f8-5e07-4883-af27-3a5a3d6b571e",
                                                "sense_id": "a07c9033-e7da-384d-898d-98d012ac5e6d",
                                                "text": "In the 1960s, in addition to small-scale weavings influenced by American Indian, Peruvian and African art, she began producing enigmatic assemblage boxes and collages, including postcard collages, which she sent to friends."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fd1baf8-7097-3282-9907-d3c07ec20cca",
                                        "entry_id": "908df2d1-fb04-37a5-9b84-c1d6a635e1bc",
                                        "glosses": [
                                            "An unsteady back and forth motion."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e759569-e3ae-466d-ba8c-b7c4af7c6e99",
                                                "sense_id": "8fd1baf8-7097-3282-9907-d3c07ec20cca",
                                                "text": "Through some ill-understood quirk of balance, his drunken weavings did nothing to upset the tray — it seemed to remain calmly horizontal."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "weaving",
