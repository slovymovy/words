            "senses": [
                {
                    "sense_id": "3da4e9ef-d1d0-3ec6-8b10-b620b5b13c26",
                    "sense_definition": "Partie postérieure du cou, située entre la tête et le haut du dos.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après une longue journée de travail devant l'écran, il ressentait une vive tension à la <w>nuque</w>."
                        },
                        {
                            "text": "Elle a noué ses cheveux pour laisser l'air frais de la brise rafraîchir sa <w>nuque</w>."
                        }
                    ],
                    "antonyms": [
                        "gorge"
                    ],
                    "common_phrases": [
                        "douleur à la nuque",
                        "raideur de la nuque"
                    ]
                },
                {
                    "sense_id": "7563033c-9672-363a-ba84-6a50b039383f",
                    "sense_definition": "Partie inférieure de la chevelure qui couvre ou borde l'arrière du cou.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "coiffure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le coiffeur a soigneusement tondu la <w>nuque</w> pour terminer cette coupe très courte."
                        },
                        {
                            "text": "Ses petites mèches rebelles dépassaient toujours et descendaient en désordre sur sa <w>nuque</w>."
                        }
                    ],
                    "common_phrases": [
                        "dégager la nuque",
                        "raser la nuque"
                    ]
                },
                {
                    "sense_id": "2e1826a7-88b8-338e-b5b5-2085e6aa5c9b",
                    "sense_definition": "Partie arrière de la tourelle d'un char ou d'un véhicule blindé.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les obus sont généralement stockés dans la <w>nuque</w> de la tourelle derrière une porte blindée."
                        },
                        {
                            "text": "L'impact a endommagé la <w>nuque</w> du char sans atteindre le poste de tir principal."
                        }
                    ]
                }
            ]
        }
    ]
