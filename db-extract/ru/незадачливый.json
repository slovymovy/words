                                "target_senses": [
                                    {
                                        "sense_id": "bb2b6de9-5ce2-30ae-97da-a9b0354c7ec0",
                                        "entry_id": "3dd6fad7-8530-3c2f-b932-18d200f077ec",
                                        "glosses": [
                                            "Unsuccessful, in a failing manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9def952b-34e9-497a-9ec2-bcdae9643127",
                                                "sense_id": "bb2b6de9-5ce2-30ae-97da-a9b0354c7ec0",
                                                "text": "The search party returned dejected from the luckless search."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01510846-ac30-3676-8b31-b55b255ef056",
                                        "entry_id": "3dd6fad7-8530-3c2f-b932-18d200f077ec",
                                        "glosses": [
                                            "Without luck, unfortunate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ea31274-220b-4e37-8a4c-6930b70a13b8",
                                                "sense_id": "01510846-ac30-3676-8b31-b55b255ef056",
                                                "text": "The luckless third-class passengers were required to stand in open wagons (or \"Stanhopes\"), which were of the same length and width as the carriages, and divided into four compartments by two bars running diagonally across the vehicle and crossing in the middle."
                                            },
                                            {
                                                "example_id": "323ede27-3416-453c-9498-7be272f1e154",
                                                "sense_id": "01510846-ac30-3676-8b31-b55b255ef056",
                                                "text": "Agents of the law, luckless pedestrian"
                                            },
                                            {
                                                "example_id": "79a6b160-aa53-44c2-9ed8-0a6f98bf673a",
                                                "sense_id": "01510846-ac30-3676-8b31-b55b255ef056",
                                                "text": "That Wolves reached half-time on level terms had much to do with the ultimately luckless Hennessey, who was in action in the opening minute to tip away Samir Nasri's shot following a City corner."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f308eaa3-13d9-4113-bc7b-47d24531c05a",
                        "source_entry_id": "19856b74-35b5-3ef6-819b-cd1d50e6cbf1",
                        "source_sense_description": "такой, которому ничто не удаётся, которого преследуют неудачи; неудачливый",
                        "target_lang_word": "unlucky",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unlucky",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "889117a4-8513-30c5-89cf-9ca74810d57e",
                                        "entry_id": "016a4b37-cc05-3d35-9288-e9eb04408e98",
                                        "glosses": [
                                            "Unfortunate, marked by misfortune."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "173444ba-57ef-4c68-97bd-1a40f5227b62",
                                                "sense_id": "889117a4-8513-30c5-89cf-9ca74810d57e",
                                                "text": "I pray you in your Letters, / When you ſhall theſe vnluckie deeds relate, / Speake of me, as I am. […] / Of one, whoſe ſubdu'd Eyes, / Albeit un-vsed to the melting moode, / Drops teares as faſt as the Arabian Trees / Their Medicinable gumme."
                                            },
                                            {
                                                "example_id": "3b98fa04-9084-4374-838a-55255ec19dad",
                                                "sense_id": "889117a4-8513-30c5-89cf-9ca74810d57e",
                                                "text": "\"So he has a chance,\" said Connie. \"Buckley's chance, the way his luck is. Fell out with his girl he did, and lost his job, and now 'e's goin' to lose 'is life. The unluckiest man that ever lived.\""
                                            },
                                            {
                                                "example_id": "478c9171-1576-4b6e-a1a6-5c155f3930f0",
                                                "sense_id": "889117a4-8513-30c5-89cf-9ca74810d57e",
                                                "text": "Her unluckier daughter and great-granddaughter have been tarred by amour's sloppy brush; but Mrs. Keppel, as her biographer Diana Souhami has written, \"turned adultery into an art.\""
                                            },
                                            {
                                                "example_id": "625da714-4012-45e8-b84d-6bb270169149",
                                                "sense_id": "889117a4-8513-30c5-89cf-9ca74810d57e",
                                                "text": "For those unlucky enough to be on a service without lavatory provision, we can only speculate as to how passengers improvised if caught short. For men, it might be possible to urinate, albeit at the risk of offending fellow passengers - there were reports of passengers being hauled up before the courts for 'micturition' in coaches during the 19th century."
                                            },
                                            {
                                                "example_id": "b70de512-f854-4d88-a4ff-51b8a9bc2017",
                                                "sense_id": "889117a4-8513-30c5-89cf-9ca74810d57e",
                                                "text": "By random chance alone, 99 times out of 100, the Lions should have won an NFL or NFC championship. Worse for arguably the league’s unluckiest fan base, the Lions haven’t really been competitive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75a4be86-ca9e-360e-b6fb-5906f2ceec53",
                                        "entry_id": "016a4b37-cc05-3d35-9288-e9eb04408e98",
                                        "glosses": [
                                            "Inauspicious."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7433d029-db54-3476-8647-74708a698745",
                                        "entry_id": "016a4b37-cc05-3d35-9288-e9eb04408e98",
                                        "glosses": [
                                            "Having ill luck."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92d17b64-0b79-3b9b-b186-9ce3985b2873",
                                        "entry_id": "016a4b37-cc05-3d35-9288-e9eb04408e98",
                                        "glosses": [
                                            "Bringing ill luck."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d580afbc-2141-4b1f-858e-39ae505bca5b",
                                                "sense_id": "92d17b64-0b79-3b9b-b186-9ce3985b2873",
                                                "text": "Country like Nepal, India, Bhutan and Myanmar, people who follows Hindu religion, they consider the numbers 0, 1, 8, 10, 12, 19 and 28 as unlucky numbers, bad luck or evil spirits etc. These numbers are called oudenophobia, henophobia, octophobia, decaphobia, dodecaphobia, enneadecaphobia and eikosioctophobia respectively."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7cd4a2fd-4d49-48b5-a108-feaa615ad626",
                        "source_entry_id": "19856b74-35b5-3ef6-819b-cd1d50e6cbf1",
