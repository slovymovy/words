                        "glosses": [
                            "Kurzform für Zeichentricktechnik, die u.a. bei der Herstellung von Zeichentrickfilmen zur Anwendung kommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6f92900-c454-4e38-9ae5-c0874525e99a",
                                "sense_id": "01ebdc6e-a5c9-3392-81c9-f1bb49d7751c",
                                "text": "Per Zeichentrick tauchten gezeichnete Figuren schon früh in Realfilmen auf."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "91e342b6-ceca-3f8c-b813-9a0c6be2eb4b",
                        "entry_id": "9d492a41-35a5-3380-ae49-1127f50ecb7f",
                        "glosses": [
                            "Kurzform für Zeichentrickfilm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e18e60ee-48dd-4c47-8b17-6a1a2c28cf63",
                                "sense_id": "91e342b6-ceca-3f8c-b813-9a0c6be2eb4b",
                                "text": "Im Zeichentrick können die Figuren Ambosse, Vorschlaghämmer oder Flammenwerfer einfach aus der Hosentasche zaubern."
                            }
                        ],
                        "sense_index_json": "\"2\""
