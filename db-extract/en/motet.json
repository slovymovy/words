                    {
                        "translation_id": "67d82574-340f-46ef-8b4c-71867a7749fc",
                        "source_entry_id": "4e519bc2-a44f-36a2-b1e7-d1e0fc13bb95",
                        "source_sense_id": "9cd66b3e-d8e5-36ea-8278-2fc0e6b4c710",
                        "source_sense_description": "a composition adapted to sacred words in the elaborate polyphonic church style",
                        "target_lang_word": "motet",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "motet",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "77116d53-0e6e-3994-85d3-5290eaa28815",
                                        "entry_id": "38b44f60-3a59-33ce-9961-f019fd821129",
                                        "glosses": [
                                            "meerstemmig, religieus lied"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3cb15ac-a2de-4998-bf0e-61ff4e7df621",
                                                "sense_id": "77116d53-0e6e-3994-85d3-5290eaa28815",
                                                "text": "Heel stijlvol was er voor gekozen om een groep mannen, als een soort schola cantorum (een jongenskoor dat de godsdienstoefeningen in de rooms-katholieke Kerk begeleidde, red.), de Gregoriaanse melodie te laten zingen, ter inleiding op het desbetreffende meerstemmige motet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5905e4b8-b8b8-30c8-aa12-42647e18cb02",
                                        "entry_id": "38b44f60-3a59-33ce-9961-f019fd821129",
                                        "glosses": [
                                            "benaming die in de westerse muziek wordt gebruikt voor bepaalde composities die in het algemeen door zangers worden uitgevoerd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1706d3ef-c021-46d6-bff1-8d38ddd0c643",
                                                "sense_id": "5905e4b8-b8b8-30c8-aa12-42647e18cb02",
                                                "text": "Onder leiding van dirigent Giulio Prandi brachten de Italianen van Ghislieri Choir Consort totale saaiheid en totale schoonheid. In die volgorde. Sowieso heeft de rode zaal van de Singel voor dit soort muziek de animo van koude kleren op een herfstochtend: je moet de warmte zelf bij elkaar trappelen. Dat die gloed er uiteindelijk toch kwam, kan je alleen maar wonderbaarlijk noemen. Aan het mottettone - Napolitaanse grootspraak voor ‘lang motet’ - waarmee de concertavond opende, lag het in elk geval niet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3072c624-4e01-4c2f-bfff-ce2a801c95c0",
                        "source_entry_id": "4e519bc2-a44f-36a2-b1e7-d1e0fc13bb95",
                        "source_sense_id": "9cd66b3e-d8e5-36ea-8278-2fc0e6b4c710",
                        "source_sense_description": "a composition adapted to sacred words in the elaborate polyphonic church style",
                        "target_lang_word": "motet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "motet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "39de25dc-25f4-3d32-b2f8-63b9bad15d75",
                                        "entry_id": "75bd150d-f7b9-3cbb-8efa-51a777f615a7",
                                        "glosses": [
                                            "Psaume ou autres paroles latines mises en musique pour être chantées à l’église et qui ne font pas partie de l’office divin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d5298e6-f6ba-4e1d-a2f3-e832493e206e",
                                                "sense_id": "39de25dc-25f4-3d32-b2f8-63b9bad15d75",
                                                "text": "Il était passionné de musique; on conserve de lui des chansons émues et mélodieuses, des motets bien construits."
                                            },
                                            {
                                                "example_id": "8a616234-b07e-4c4d-b038-b3064229a46e",
                                                "sense_id": "39de25dc-25f4-3d32-b2f8-63b9bad15d75",
                                                "text": "Toute la nuit, couché une dernière fois sur son lit dans sa cellule de Saint-Cosme, Zénon se joua et se rejoua un certain motet de Roland de Lassus, mêlé à ses projets d'avenir."
                                            },
                                            {
                                                "example_id": "113ee8c8-3c32-4a2b-9417-1fa227abe057",
                                                "sense_id": "39de25dc-25f4-3d32-b2f8-63b9bad15d75",
                                                "text": "Faire, composer, chanter, exécuter un motet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99d18b0f-274c-4145-9c96-15a9dc4202d7",
                        "source_entry_id": "4e519bc2-a44f-36a2-b1e7-d1e0fc13bb95",
                        "source_sense_id": "9cd66b3e-d8e5-36ea-8278-2fc0e6b4c710",
                        "source_sense_description": "a composition adapted to sacred words in the elaborate polyphonic church style",
                        "target_lang_word": "Motette",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Motette",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "88ab63a9-cec4-3059-98bd-5ac74db6dce6",
                                        "entry_id": "0ede24ff-9895-3d08-a381-c0d7beb9ec5b",
                                        "glosses": [
                                            "mehrstimmiger geistlicher oder weltlicher Chorgesang mit mehreren Abschnitten, zumeist ohne Instrumentalbegleitung"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bff5397-9af2-40a2-a0fd-f8c9c830f6c1",
                                                "sense_id": "88ab63a9-cec4-3059-98bd-5ac74db6dce6",
                                                "text": "Die Messen und Motetten des um 1500 unweit von Lille geborenen Nicolas Gombert gehören zum Schönsten, was die franko-flämische Polyfonie des 15. und 16. Jahrhunderts hinterlassen hat."
                                            },
                                            {
                                                "example_id": "981f79f8-ce9a-4848-ae29-a48fb090c29b",
                                                "sense_id": "88ab63a9-cec4-3059-98bd-5ac74db6dce6",
                                                "text": "Bachs unvergleichliches Verdienst bei der Renovierung des Prinzips Motette lag in der Verbindung von kontrapunktischer Feinarbeit und doppelchörigem Bauplan, von triebhaft-horizontalem Fugenwerk und federnd gelagerter Gruppenstruktur."
                                            },
                                            {
                                                "example_id": "19c6e673-74e8-42a0-a2d5-38cba7e54527",
                                                "sense_id": "88ab63a9-cec4-3059-98bd-5ac74db6dce6",
                                                "text": "Es war nicht irgendein Gelegenheitswerk, sondern die Motette Exsultate, jubilate KV 165, ein typisch italienisches, opernhaftes Bravourstück mit furiosen Ecksätzen, einem Rezitativ und einer ausdrucksvollen Andante-Arie."
                                            },
                                            {
                                                "example_id": "4798675b-3e9f-4264-a643-651c8e07b8a9",
                                                "sense_id": "88ab63a9-cec4-3059-98bd-5ac74db6dce6",
                                                "text": "Was sich nicht zuletzt in dessen madrigalesken Chorwerken aus den 30er-Jahren niederschlägt, die der NDR Chor unter Philipp Ahmann zum Doppelportrait ebenso sinnfesselnd beisteuerte wie Messiaens liturgische Motette \"O sacrum convivium\" (O heiliges Mahl)."
                                            },
                                            {
                                                "example_id": "8a340c03-43a7-45c1-acf6-8663dfa02bdd",
                                                "sense_id": "88ab63a9-cec4-3059-98bd-5ac74db6dce6",
                                                "text": "Gewiss singt er mit ihnen auch mal ein Schlagerlied, \"die trällern das dann im Bus bei unseren Konzertreisen vergnügt vor sich hin\", um gleich wieder ohne Murren zu einer Motette von Heinrich Schütz, einem Chorsatz von Mendelssohn zurückzukehren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
