                "translations": [
                    {
                        "translation_id": "9e363982-3577-470f-a111-ce06ff5f5558",
                        "source_entry_id": "4a3d0a82-8a2c-3caf-993b-d68c521752d3",
                        "source_sense_id": "4105ad7f-651a-3743-a2d1-e116d4431664",
                        "source_sense_description": "Botanik: Sonderform der Nussfrucht, bei der Samenschale und Fruchtwand miteinander verwachsen sind",
                        "target_lang_word": "caryopsis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caryopsis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "537ea23a-5d8f-341f-9634-bb58fcb47b21",
                                        "entry_id": "efc3fcc4-bde6-33a2-8da6-97dc89056a9d",
                                        "glosses": [
                                            "A type of fruit in which the fruit skin is stuck to the seed coat; especially the grain of a cereal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a945f3b2-6b5f-4156-a5de-17b88375f5e5",
                                                "sense_id": "537ea23a-5d8f-341f-9634-bb58fcb47b21",
                                                "text": "The variation of caryopsis characters in species of Aegilops and wheat diploids is similar to that of wheat tetraploids ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54ed232a-5702-4a76-bc84-98eaf6e63a8b",
                        "source_entry_id": "4a3d0a82-8a2c-3caf-993b-d68c521752d3",
                        "source_sense_id": "4105ad7f-651a-3743-a2d1-e116d4431664",
                        "source_sense_description": "Botanik: Sonderform der Nussfrucht, bei der Samenschale und Fruchtwand miteinander verwachsen sind",
                        "target_lang_word": "caryopse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caryopse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ab9e16a6-21a2-38e1-8567-3392be18923f",
                                        "entry_id": "7c6e83f5-fb9d-3813-8737-41c03fe6112b",
                                        "glosses": [
                                            "Fruit sec typique des graminées, indéhiscent, dans lequel le péricarpe est soudé à l'unique graine qu'il contient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0d5d593-dcaf-467b-b32b-2d4146e9a667",
                                                "sense_id": "ab9e16a6-21a2-38e1-8567-3392be18923f",
                                                "text": "Les caryopses de blé et de maïs sont généralement appellés grains."
                                            },
                                            {
                                                "example_id": "ee35d047-717b-4ca8-84f7-2a77f9d7153b",
                                                "sense_id": "ab9e16a6-21a2-38e1-8567-3392be18923f",
                                                "text": "Tel est le cas de l’akène qui est un péricarpe non soudé aux téguments de la graine, et du caryopse qui est un péricarpe soudé aux téguments de la graine."
                                            },
                                            {
                                                "example_id": "f49a82e7-c931-4522-a90c-b797e166c14d",
                                                "sense_id": "ab9e16a6-21a2-38e1-8567-3392be18923f",
                                                "text": "Le grain des céréales est un caryopse nu ou vêtu de ses glumelles. Le blé, le maïs, le sorgho, le seigle et le triticale appartiennent au premier groupe; l’orge et l’avoine font partie du second."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
