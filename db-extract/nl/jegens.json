                "senses": [
                    {
                        "sense_id": "48c0a1b5-21a5-3723-849e-41802b94451c",
                        "entry_id": "354c01e9-f567-35dd-88f8-55f7123d8e65",
                        "glosses": [
                            "ten aanzien van, tegenover, naar ... toe (figuurlijk, niet in de betekenis \\\"door een ruimte\\\"); vooral gebruikt bij personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cdde58d-a086-4b4f-b9a6-ee155dd6bfb7",
                                "sense_id": "48c0a1b5-21a5-3723-849e-41802b94451c",
                                "text": "Wrok jegens iemand koesteren."
                            },
                            {
                                "example_id": "8b690b7e-ea9e-43fb-9a3d-6a20206d14c5",
                                "sense_id": "48c0a1b5-21a5-3723-849e-41802b94451c",
                                "text": "Volgens de Twentse pastoor onderscheidt de christelijke gemeenschap op Sri Lanka zich door hun sterk verzoenende houding jegens andere religies. „Ze vormen slechts een kleine minderheid, - zo’n zeven procent van de bevolking- maar zijn zeer verdraagzaam. Zo heb ik het meegemaakt dat tijdens een misviering de buren van het boeddhistische gebedshuis opzettelijk lawaai begonnen te maken om het geluid van biddende christenen te overstemmen. Ik heb bewondering voor hun lankmoedigheid.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13e890c2-d51c-49e9-9443-d1ee065224a4",
                        "source_entry_id": "354c01e9-f567-35dd-88f8-55f7123d8e65",
                        "source_sense_id": "48c0a1b5-21a5-3723-849e-41802b94451c",
                        "source_sense_description": "tegenover",
                        "target_lang_word": "towards",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "towards",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "18f3fa77-e157-31ed-b462-7113de0e816a",
                                        "entry_id": "8a4c0faf-ed16-3590-ac44-e2704bc10410",
                                        "glosses": [
                                            "Alternative form of toward."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ffeb26f-21d3-45e6-b6a0-6d4840ec82cc",
                                                "sense_id": "18f3fa77-e157-31ed-b462-7113de0e816a",
                                                "text": "Towards the following morning, the thermometer fell to 5°; and at daylight, there was not an atom of water to be seen in any direction."
                                            },
                                            {
                                                "example_id": "0839a1c2-0bf0-462f-ac5d-33280dd50849",
                                                "sense_id": "18f3fa77-e157-31ed-b462-7113de0e816a",
                                                "text": "To the left towers the Jungfrau, with the train heading directly towards it."
                                            },
                                            {
                                                "example_id": "1b0b46c2-3e39-474f-bddc-1cc0eacfa479",
                                                "sense_id": "18f3fa77-e157-31ed-b462-7113de0e816a",
                                                "text": "But with Goodison Park openly directing its full hostility towards Atkinson, Liverpool went ahead when Carroll turned in his first Premier League goal of the season after 70 minutes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "towards",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aed4a7a9-0810-3f34-a755-7d776f16a235",
                                        "entry_id": "c610cdc9-8105-3a13-b18f-b89fc4bb222d",
                                        "glosses": [
                                            "In the direction of something (indicated by context)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9ff1e62-ab91-4666-af85-bc9b60d1540c",
                                                "sense_id": "aed4a7a9-0810-3f34-a755-7d776f16a235",
                                                "text": "Thus as he spake, lo far away they spyde / A varlet running towards hastily […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "towards",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4e05287-198b-3514-8c6e-028b5e8bd0b1",
                                        "entry_id": "3a7dab1e-e7c8-3285-93f9-e59f7fc96092",
                                        "glosses": [
                                            "Near; at hand; in state of preparation; toward."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af6c693b-eae9-46b4-8d64-7c0e4757654d",
                                                "sense_id": "d4e05287-198b-3514-8c6e-028b5e8bd0b1",
                                                "text": "We have a trifling foolish banquet towards."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a7836ae-9242-49f8-bd06-9e4ab57fd633",
                        "source_entry_id": "354c01e9-f567-35dd-88f8-55f7123d8e65",
                        "source_sense_id": "48c0a1b5-21a5-3723-849e-41802b94451c",
                        "source_sense_description": "tegenover",
                        "target_lang_word": "envers",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "envers",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a0656dd3-9a02-34c3-8972-9baeecb7f481",
                                        "entry_id": "430075a0-6dd3-3358-a65d-99c5127fe87c",
                                        "glosses": [
                                            "À l’égard de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2895756f-359e-4e54-aa5d-f48d90d0a058",
                                                "sense_id": "a0656dd3-9a02-34c3-8972-9baeecb7f481",
                                                "text": "Le nommé Lechat, ouvrier à Bolmont, commune de Remilly, a été arrêté ces jours derniers pour avoir proféré, dans un cabaret à Sormonne, des propos offensants envers le Président de la République."
                                            },
                                            {
                                                "example_id": "be6ddca8-7422-49ba-b02e-c00e24d4db7a",
                                                "sense_id": "a0656dd3-9a02-34c3-8972-9baeecb7f481",
                                                "text": "C’était un chaud lapin, disait-on au village, où il passait pour user envers les femmes d’arguments irrésistibles."
                                            },
                                            {
                                                "example_id": "47631797-b375-4c01-97c4-3444da54d9f7",
                                                "sense_id": "a0656dd3-9a02-34c3-8972-9baeecb7f481",
                                                "text": "Dans ses discours, il défendit avec force cette thèse que la stricte observance des lois religieuses doit s'accompagner, pour devenir méritoire, de la pratique de la justice et de l'amour du prochain, envers les juifs comme envers les non-juifs."
                                            },
                                            {
                                                "example_id": "cc3f8ddf-2b92-4cd6-ac24-3716be5f6ecc",
                                                "sense_id": "a0656dd3-9a02-34c3-8972-9baeecb7f481",
                                                "text": "Le sang de Samuel se mit à bouillir et il se jeta sur son frère. L’assemblée fut prise de court, trop occupée à ranimer Pierre Esterhuizen. Les Hugo s’empoignèrent sans ménagement, avec la férocité dont seuls deux frères étaient capables l’un envers l’autre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e2f2b7c-6bd6-33c8-b96e-2fb0a41ec2a2",
                                        "entry_id": "430075a0-6dd3-3358-a65d-99c5127fe87c",
                                        "glosses": [
                                            "En face de."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "envers",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d0181103-eecd-398a-a6e6-a15359949fad",
                                        "entry_id": "b0d6c8c5-9798-3f4d-b9e7-fa03cb0da02f",
                                        "glosses": [
                                            "Le côté qui, dans un objet à deux faces, n’est pas destiné à être vu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "113f8178-47be-4b9f-b102-e0ba5fe71a0c",
                                                "sense_id": "d0181103-eecd-398a-a6e6-a15359949fad",
                                                "text": "Voici l’endroit de cette étoffe, voilà l’envers. L’envers d’un tableau. L’envers d’un décor."
                                            },
                                            {
                                                "example_id": "c1822ce6-c1f8-4c51-b5d2-458a6eccaa01",
                                                "sense_id": "d0181103-eecd-398a-a6e6-a15359949fad",
                                                "text": "Cette étoffe n’a ni endroit ni envers."
                                            },
                                            {
                                                "example_id": "cb751d4b-72ac-42de-933d-88c159beac42",
                                                "sense_id": "d0181103-eecd-398a-a6e6-a15359949fad",
                                                "text": "Étoffe sans envers, celle dont les deux côtés sont semblables."
                                            },
                                            {
                                                "example_id": "90496bd4-bd95-49cb-a9b2-b53b377513d1",
                                                "sense_id": "d0181103-eecd-398a-a6e6-a15359949fad",
                                                "text": "Pas exactement un feu de joie, mais les gars ont mis une sorte de frénésie rageuse à dépouiller les envers de casques et à jeter dans le brasier les tuyaux de masques à gaz."
                                            },
                                            {
                                                "example_id": "0c132f26-1d5b-4457-adec-8c3a27e3df33",
                                                "sense_id": "d0181103-eecd-398a-a6e6-a15359949fad",
                                                "text": "Tout le monde sait que les Fougères n’ont pas de fleurs ; ce sont pour cette raison des cryptogames. Cependant on les sème, comme les autres végétaux, mais non pas au moyen de graines. Elles forment ordinairement à l’envers de leurs feuilles des corpuscules extrêmement ténu et qu’on appelle en botanique des spores."
                                            },
                                            {
                                                "example_id": "eb07c5a0-7d9c-4489-a17f-0936533eaaa8",
                                                "sense_id": "d0181103-eecd-398a-a6e6-a15359949fad",
                                                "text": "L’envers d’une qualité. L’envers d’une situation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "550b5bf7-4946-30f9-bbe0-18084467b498",
                                        "entry_id": "b0d6c8c5-9798-3f4d-b9e7-fa03cb0da02f",
                                        "glosses": [
                                            "Ubac."
                                        ],
                                        "tags": [
                                            "Toponymie",
                                            "Vosges",
                                            "Savoie",
                                            "Vallée d’Aoste"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba577e26-68c4-43bf-9bf0-094a1103fbf7",
                                                "sense_id": "550b5bf7-4946-30f9-bbe0-18084467b498",
                                                "text": "« L'adroite du lac » désigne simplement l'adret du lac, l'endroit (exposé) au soleil. « Ramberchamp » désigne un campus ou « espace ouvert et suffisamment plane » à l'envers, soit sur le rivage de l'ombre ou de l'ubac."
                                            },
                                            {
                                                "example_id": "b86b716e-cee1-48e7-a021-b3a39e051cf3",
                                                "sense_id": "550b5bf7-4946-30f9-bbe0-18084467b498",
                                                "text": "L’envers du Rupt de Bâmont. L’envers de la Poirie. L’envers des Graviers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
