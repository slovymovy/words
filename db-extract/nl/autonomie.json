                        "form": "autonomietje"
                    },
                    {
                        "form_id": "75a4fefd-6c1c-4bf5-94e0-91976684c06d",
                        "entry_id": "c05c7c89-bb01-3ac2-acad-e01fa1506402",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "autonomietjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6dcf15df-ea2a-3264-9ad0-b67230b4523c",
                        "entry_id": "c05c7c89-bb01-3ac2-acad-e01fa1506402",
                        "glosses": [
                            "gedeeltelijk zelfbestuur (met de mogelijkheid om zelf wetgeving te maken)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "776f5307-ffb2-480c-9b99-ae9b9eb67d45",
                                "sense_id": "6dcf15df-ea2a-3264-9ad0-b67230b4523c",
                                "text": "Vlaanderen wil steeds meer autonomie."
                            },
                            {
                                "example_id": "90dc1644-d96b-4976-b306-6f0ab6e92706",
                                "sense_id": "6dcf15df-ea2a-3264-9ad0-b67230b4523c",
                                "text": "Spanje en Marokko stonden een jaar lang lijnrecht tegenover elkaar. De crisis begon toen Spanje een prominent lid van de onafhankelijkheidsbeweging Polisario in een Spaans ziekenhuis had opgenomen. Polisario strijdt voor de autonomie van de Westelijke Sahara en wordt door Marokko als terroristisch gezien. Spanje had Marokko niet ingelicht over de opname en dat viel verkeerd in Rabat. Marokko besloot zelfs de grenscontroles te staken."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f5222f4-c16a-35de-91d0-ceffde52317d",
                        "entry_id": "c05c7c89-bb01-3ac2-acad-e01fa1506402",
                        "glosses": [
                            "onafhankelijkheid (van de menselijke geest)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59b08082-2947-4d28-89f2-f92b5c5f0716",
                                "sense_id": "5f5222f4-c16a-35de-91d0-ceffde52317d",
                                "text": "Patiënten eisen steeds meer autonomie op, met name t.a.v. het eigen levenseinde, maar dat komt soms in conflict met de autonomie van hulpverleners."
                            }
                        ]
                    },
                    {
                        "sense_id": "f0527266-cde0-3b46-914b-0fd035fad7fe",
                        "entry_id": "c05c7c89-bb01-3ac2-acad-e01fa1506402",
                        "glosses": [
                            "zelfvoorzienendheid (onafhankelijk van externe 'input' en/of energie)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73f68234-2aba-4f70-95b0-a033deb0b773",
                                "sense_id": "f0527266-cde0-3b46-914b-0fd035fad7fe",
                                "text": "De autonomie van dit bedrijf ging zover dat ze niet meer waren aangesloten op het stroomnet."
                            },
                            {
                                "example_id": "6a0173a9-c690-4e89-8402-a11b60208c62",
                                "sense_id": "f0527266-cde0-3b46-914b-0fd035fad7fe",
                                "text": "\"VU, hef niet je aardwetenschappen-afdeling op!\", schrijft hoofdgeoloog van de Geologische Dienst Nederland, Michiel van der Meulen van TNO, in een oproep op LinkedIn. \"Als ze dit besluit doorzetten, keren ze hun rug naar de samenleving en de toekomst\", gaat hij verder. \"Of het nou voor een beter milieu is, meer welvaart of grotere autonomie - voor Nederland, Europa of de wereld: aardwetenschappers leveren een essentiële bijdrage.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "158845d2-8b84-4da0-bff5-270916b9b4b7",
                        "source_entry_id": "c05c7c89-bb01-3ac2-acad-e01fa1506402",
                        "target_lang_word": "Autonomie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Autonomie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "866f22b0-6a6e-3529-bd7c-64557a666765",
                                        "entry_id": "35a67ae1-07d5-377f-a7f1-c0bb7ba280e0",
                                        "glosses": [
                                            "Recht, sich selbst Gesetze zu geben und/oder nach eigenen Gesetzen zu leben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbb09aa7-e99d-4891-8812-35efc3bed667",
                                                "sense_id": "866f22b0-6a6e-3529-bd7c-64557a666765",
                                                "text": "Mit ihrer Erklärung fordern sie ihre Autonomie."
                                            },
                                            {
                                                "example_id": "4023569d-bde3-4fa3-88bb-daa870627460",
                                                "sense_id": "866f22b0-6a6e-3529-bd7c-64557a666765",
                                                "text": "„Erst am Ende der zweiten Zigarette entschloß ich mich zu lachen und über die bevorstehende Autonomie Jerichos zu freuen.“"
                                            },
                                            {
                                                "example_id": "7135a676-9f26-4a34-bfa5-b553faee7984",
                                                "sense_id": "866f22b0-6a6e-3529-bd7c-64557a666765",
                                                "text": "„Erst 1905 wurde die Forderung nach einer nationalen und kulturellen Autonomie in aller Form in das Parteiprogramm aufgenommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "07d0500d-edc4-39db-a333-815a21b6a74b",
                                        "entry_id": "35a67ae1-07d5-377f-a7f1-c0bb7ba280e0",
                                        "glosses": [
                                            "Möglichkeit, sich ohne ungewollten Einfluss von außen selbst organisieren zu können"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4caf2e89-112e-426f-a74b-05fb18e39b3f",
                                                "sense_id": "07d0500d-edc4-39db-a333-815a21b6a74b",
                                                "text": "Ihre erlangte Autonomie stellt sie vor neue Probleme."
                                            },
                                            {
                                                "example_id": "8b82ae69-ed2a-464c-9806-c01bd519b34e",
                                                "sense_id": "07d0500d-edc4-39db-a333-815a21b6a74b",
                                                "text": "„Für jemanden wie mich, der sich seit Jahrzehnten um nichts so sehr bemüht hatte wie um Autonomie, war das ein durchaus bahnbrechendes Ereignis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "686c9550-2b08-30e8-be06-e5a8219e53f8",
                                        "entry_id": "35a67ae1-07d5-377f-a7f1-c0bb7ba280e0",
                                        "glosses": [
                                            "Zustand eines Menschen, sich nur von seinem Gewissen die Gesetze seines Verhaltens und Handelns vorschreiben zu lassen"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3eef692a-4044-4764-998b-a15543ec85f3",
                        "source_entry_id": "c05c7c89-bb01-3ac2-acad-e01fa1506402",
                        "target_lang_word": "autonomy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autonomy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "897ca9bd-bdb3-38ce-beb0-cc8f0039a725",
                                        "entry_id": "ac33ee09-2d41-38e1-b3a9-6abaaede8f81",
                                        "glosses": [
                                            "The right or condition of self-government; freedom to act or function independently."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e79223e-afa2-4a53-837b-bfe9a49bb370",
                                                "sense_id": "897ca9bd-bdb3-38ce-beb0-cc8f0039a725",
                                                "text": "But while assiduously dismissing any though of its own autonomy and proclaiming its victims its judges, it outdoes, in its veiled autocracy, all the excesses of autonomous art."
                                            },
                                            {
                                                "example_id": "2a27ace9-1582-425f-ab2d-e545b60af3b8",
                                                "sense_id": "897ca9bd-bdb3-38ce-beb0-cc8f0039a725",
                                                "text": "Financial independence and micro retirement have come to represent the autonomy I've created for myself, which is a powerful feeling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1149812-e3fd-3280-af5f-3ebb7fe9cd08",
                                        "entry_id": "ac33ee09-2d41-38e1-b3a9-6abaaede8f81",
                                        "glosses": [
                                            "A self-governing country or region."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0fd1efb4-91f6-3d2c-abef-ddb7f01d0918",
                                        "entry_id": "ac33ee09-2d41-38e1-b3a9-6abaaede8f81",
                                        "glosses": [
                                            "The capacity to make an informed, uncoerced decision."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea9025f6-5e6b-3d4e-b252-9657c783a3b8",
                                        "entry_id": "ac33ee09-2d41-38e1-b3a9-6abaaede8f81",
                                        "glosses": [
                                            "The capacity of a system to make a decision about its actions without the involvement of another system or operator."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1297d06f-2913-4daa-a4bc-6e0a9d7ddbcd",
                                                "sense_id": "ea9025f6-5e6b-3d4e-b252-9657c783a3b8",
                                                "text": "...[T]he fact that a scientific theory finds applications to a wide variety of different phenomena does not imply anything about the autonomy of this theory from deeper physical laws."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "460ff611-d063-3089-96be-84658ccd8046",
                                        "entry_id": "ac33ee09-2d41-38e1-b3a9-6abaaede8f81",
                                        "glosses": [
                                            "The status of a church whose highest-ranking bishop is appointed by the patriarch of the mother church, but which is self-governing in all other respects. Compare autocephaly."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6308aa26-1bfa-4f7e-a838-219714257d8c",
                        "source_entry_id": "c05c7c89-bb01-3ac2-acad-e01fa1506402",
                        "target_lang_word": "autonomie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autonomie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "873ca9ca-bed7-3c83-b021-d702966921e0",
                                        "entry_id": "32fc635f-b9d4-39e1-8e34-b8f4318c34c6",
                                        "glosses": [
                                            "État de ce qui est autonome, qui n’obéit pas à la loi ou à la règle d’autrui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1ba4b1b-ee1f-4833-aa67-a12eb89eb027",
                                                "sense_id": "873ca9ca-bed7-3c83-b021-d702966921e0",
                                                "text": "C’est à ces sentiments nettement latins et fédéralistes tout ensemble de l’École de Marseille qu’il faut rattacher la manifestation à laquelle se livrèrent quelques Félibres, qui, par une déclaration solennelle, publiée le 22 février 1892, se déclaraient partisans de l’autonomie et de la fédération des provinces françaises."
                                            },
                                            {
                                                "example_id": "cfa8c7c3-9675-4b2f-9915-e2f0c45cea9b",
                                                "sense_id": "873ca9ca-bed7-3c83-b021-d702966921e0",
                                                "text": "Aujourd’hui, on fait grief à la France de ne pas concéder à l’Alsace cette même autonomie que l’Allemagne avait accordée au Reichsland. Mais quelle était donc cette autonomie ? […] Somme toute, l’Alsace n’exerçait son autonomie que pour des dispositions ménagères."
                                            },
                                            {
                                                "example_id": "b6456ee0-f2c3-4b75-8c97-63465898ea21",
                                                "sense_id": "873ca9ca-bed7-3c83-b021-d702966921e0",
                                                "text": "Il faut un contexte social et politique tout à fait particulier pour que ces mêmes pouvoirs initient des réformes importantes, comme le fit Atatürk dans la Turquie des années 1920 ou, dans les années 1990, les pays turcophones ayant recouvré leur autonomie après la chute de l’URSS."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12125494-6a8b-39a8-876d-6f59f8583428",
                                        "entry_id": "32fc635f-b9d4-39e1-8e34-b8f4318c34c6",
                                        "glosses": [
                                            "Capacité à gérer seule sa vie quotidienne en parlant d’une personne."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62e57a8c-7cda-4888-9dad-49ccac1419ae",
                                                "sense_id": "12125494-6a8b-39a8-876d-6f59f8583428",
                                                "text": "Les années quatre-vingt ont consacré l’enfant-roi mais aussi travaillé en profondeur les mentalités vers toujours plus d’individualisme, cet état ambivalent de l’autonomie et de l’hypersolitude."
                                            },
                                            {
                                                "example_id": "2cc38844-ac95-4920-bfdf-a715721e7088",
                                                "sense_id": "12125494-6a8b-39a8-876d-6f59f8583428",
                                                "text": "Un enfant est dit mineur par la loi : son jeune âge fait présumer que l’autonomie n’est pas acquise, qu’il doit donc être protégé et que le statut juridique de l’incapacité est une protection."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "352c5082-9a21-33aa-b4ae-51dbeb0d4b65",
                                        "entry_id": "32fc635f-b9d4-39e1-8e34-b8f4318c34c6",
                                        "glosses": [
                                            "Temps de fonctionnement d'une machine, en particulier Distance que peut parcourir un véhicule, avec le plein en énergie ou en produit indispensable au fonctionnement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c718e0f1-0252-40bd-8119-a05a7a8bcc44",
                                                "sense_id": "352c5082-9a21-33aa-b4ae-51dbeb0d4b65",
                                                "text": "Ces écouteurs résistent à la poussière et à l’eau, peuvent se connecter à un smartphone et à un ordinateur sans avoir à les repairer et revendiquent aussi jusqu’à 36 heures d’autonomie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab30ab8d-2049-3e2c-84ae-ee4749e7a496",
                                        "entry_id": "32fc635f-b9d4-39e1-8e34-b8f4318c34c6",
                                        "glosses": [
                                            "Statut politique spécial avec délégation accrue de pouvoirs, plus grande que dans un fédéralisme symétrique, mais sans obtenir la souveraineté (indépendance juridique)."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b1526a3-e174-4b1e-82f7-e83f493c9d27",
                                                "sense_id": "ab30ab8d-2049-3e2c-84ae-ee4749e7a496",
                                                "text": "[L’indépendance] est le contraire politique de l’autonomie, même si, sur un plan historique, on peut la considérer comme son prolongement. Il n’y a rien de commun entre un séparatiste et un autonomiste : l’un veut la sécession du Québec, l’autre veut sa participation, plus ou moins intégrée, à la Confédération."
                                            },
                                            {
                                                "example_id": "ed2d8882-f152-4471-9b2d-0f422f92f752",
                                                "sense_id": "ab30ab8d-2049-3e2c-84ae-ee4749e7a496",
                                                "text": "« En plaçant le principe de l’autonomie au cœur de son projet politique, la CAQ s’inscrit dans une lignée qui, au cours de l’histoire, a fait de la défense des intérêts vitaux du Québec une priorité absolue. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be8c1db2-d575-48aa-bcd7-8f4f788efede",
