                                "sense_id": "795b8f40-a48e-3436-a690-d8ec9a444a5c",
                                "text": "Zo ontstond er een tweestrijd tussen de aanhangers van de Vrije Fransen en het Vichy-regime."
                            }
                        ]
                    },
                    {
                        "sense_id": "956a4424-b56e-38d7-b4ec-d191f603bbfd",
                        "entry_id": "e6543fa6-f3e2-37ec-945e-d705f9077877",
