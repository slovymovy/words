{
    "word_family": [],
    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "9d8e893d-74d7-3194-9e54-856ec97ec801",
                    "sense_definition": "Indique le lieu de destination vers lequel on se dirige.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous partons en vacances <w>à</w> Paris la semaine prochaine."
                        },
                        {
                            "text": "Elle va tous les matins <w>à</w> la gare en vélo."
                        }
                    ],
                    "common_phrases": [
                        "aller à Paris",
                        "arriver à destination"
                    ]
                },
                {
                    "sense_id": "16216b08-ab6a-38f5-a20e-f6cadf5707bc",
                    "sense_definition": "Indique le lieu où se trouve une personne ou un objet.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toute la famille reste <w>à</w> la maison ce dimanche."
                        },
                        {
                            "text": "Mon frère aîné habite <w>à</w> Lyon depuis deux ans."
                        }
                    ],
                    "common_phrases": [
                        "rester à la maison",
                        "habiter à Lyon"
                    ]
                },
                {
                    "sense_id": "1a382500-afe4-38c0-b301-a3aed633ffa8",
                    "sense_definition": "Indique un moment précis ou une heure déterminée.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cours de français commence toujours <w>à</w> huit heures."
                        },
                        {
                            "text": "Nous avons rendez-vous <w>à</w> midi devant le musée."
                        }
                    ],
                    "common_phrases": [
                        "à huit heures",
                        "à midi"
                    ]
                },
                {
                    "sense_id": "3b5b8ddd-c558-331a-b2a5-4054dfaffd02",
                    "sense_definition": "S'emploie dans les formules de salutation pour désigner le moment d'une prochaine rencontre.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je dois partir maintenant, je vous dis <w>à</w> bientôt !"
                        },
                        {
                            "text": "Bonne soirée et <w>à</w> demain matin pour la réunion."
                        }
                    ],
                    "common_phrases": [
                        "à bientôt",
                        "à demain",
                        "à plus tard"
                    ]
                },
                {
                    "sense_id": "e43a2f85-3350-3b10-9872-c4c5a9fcf5ce",
                    "sense_definition": "Indique une direction, une orientation ou une position spatiale relative.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour aller à la poste, tournez <w>à</w> gauche après le feu."
                        },
                        {
                            "text": "La boulangerie se trouve juste <w>à</w> droite de la mairie."
                        }
                    ],
                    "common_phrases": [
                        "tourner à gauche",
                        "à droite"
                    ]
                },
                {
                    "sense_id": "95018fc8-6995-3104-acc1-fe680edfb721",
                    "sense_definition": "Indique la limite temporelle finale, souvent en corrélation avec de.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le bureau reste ouvert du lundi <w>à</w> vendredi toute la journée."
                        },
                        {
                            "text": "La conférence aura lieu de quatorze heures <w>à</w> dix-sept heures."
                        }
                    ],
                    "common_phrases": [
                        "de lundi à vendredi"
                    ]
                },
                {
                    "sense_id": "9692e5c4-46a9-3567-981c-e4c1bd931ae1",
                    "sense_definition": "Indique l'appartenance ou la possession, notamment après le verbe être.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce manteau rouge posé sur la chaise est <w>à</w> Sophie."
                        },
                        {
                            "text": "Ces clés de voiture sont <w>à</w> moi, merci de me les rendre."
                        }
                    ],
                    "common_phrases": [
