                },
                {
                    "sense_id": "29f8e2d2-08a5-3310-a161-ef559ab5f9cd",
                    "sense_definition": "Scarce; not close, crowded, or numerous; not filling the space.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "density",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd began to get <w>thin</w> as the concert came to an end.",
                            "target_lang_translations": {
                                "ru": "Толпа начала <w>редеть</w>, когда концерт подошел к концу.",
                                "nl": "De menigte begon <w>uit te dunnen</w> toen het concert ten einde liep."
                            }
                        },
                        {
                            "text": "The air is very <w>thin</w> at the top of the mountain making it hard to breathe.",
                            "target_lang_translations": {
                                "ru": "На вершине горы воздух очень <w>разрежённый</w>, из-за чего трудно дышать.",
                                "nl": "De lucht is erg <w>ijjl</w> op de top van de berg, waardoor het moeilijk ademen is."
                            }
