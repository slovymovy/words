                "senses": [
                    {
                        "sense_id": "a1f0636e-e6da-3a76-85bf-aa8b7c28801b",
                        "entry_id": "cf92714d-0447-30d6-88cd-a524644d3004",
                        "glosses": [
                            "männliche Gans"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab6b4d43-b6cf-49bb-a332-740d45354c44",
                                "sense_id": "a1f0636e-e6da-3a76-85bf-aa8b7c28801b",
                                "text": "„Bleibend, Geschlechter und Geschlechter überdauernd, war nur Attila, der Zuchtganter, ein schwerer Gänserich von einundzwanzig Pfund.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e9a807b-a137-4c9d-b45d-6f23504b4d91",
                        "source_entry_id": "cf92714d-0447-30d6-88cd-a524644d3004",
                        "source_sense_id": "a1f0636e-e6da-3a76-85bf-aa8b7c28801b",
                        "source_sense_description": "männliche Gans",
                        "target_lang_word": "gander",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gander",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07f147cc-5e7f-3d9c-9d07-004bdb8c389b",
                                        "entry_id": "058b2146-8213-3f81-9997-e95cea4b6aae",
                                        "glosses": [
                                            "A male goose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6387c073-142d-471b-a218-3ed690567c1a",
                                                "sense_id": "07f147cc-5e7f-3d9c-9d07-004bdb8c389b",
                                                "text": "Ganders and geese are at their best for stock from two to ten years old. They live to a great age—it is stated to thirty or more years—but after ten years they cannot be reckoned upon as reliable assets on a farm. Two years old is the best age to mate them, making up pens of a gander and two or three geese at the New Year. It is difficult sometimes to distinguish ganders from geese. A practical man is, however, rarely mistaken."
                                            },
                                            {
                                                "example_id": "54a3be7f-3380-4432-8899-15cff97c24e3",
                                                "sense_id": "07f147cc-5e7f-3d9c-9d07-004bdb8c389b",
                                                "text": "Old Mother Goose / When she wanted to wander / Would ride through the air / On a very fine gander."
                                            },
                                            {
                                                "example_id": "44f8af48-c507-4b69-be23-41e6525b003f",
                                                "sense_id": "07f147cc-5e7f-3d9c-9d07-004bdb8c389b",
                                                "text": "Marta's gander was a magnificent snow-white bird: the object of terror to foxes, children and dogs. She had reared him as a gosling; and whenever he approached, he would let fly a low contented burble and sidle his neck around her thighs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a24d0c4d-857a-3e79-aefc-dc6450bab6ca",
                                        "entry_id": "058b2146-8213-3f81-9997-e95cea4b6aae",
                                        "glosses": [
                                            "A fool, simpleton."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "38440484-4c09-34fc-aae9-cdd895242fe6",
                                        "entry_id": "058b2146-8213-3f81-9997-e95cea4b6aae",
                                        "glosses": [
                                            "A glance, look."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ed566da-52a5-4037-afe7-43404ee819cc",
                                                "sense_id": "38440484-4c09-34fc-aae9-cdd895242fe6",
                                                "text": "Have a gander at what he’s written."
                                            },
                                            {
                                                "example_id": "c58f883c-0e62-41e9-970d-6f7ef76de9bd",
                                                "sense_id": "38440484-4c09-34fc-aae9-cdd895242fe6",
                                                "text": "I took a gander and she seemed so familiar."
                                            },
                                            {
                                                "example_id": "e1df8337-e227-4851-a232-f72f69e45dce",
                                                "sense_id": "38440484-4c09-34fc-aae9-cdd895242fe6",
                                                "text": "As well as the church and its sexton, the market house is worth a gander, while the hop fields and orchards are \"reminding one of Kent\", for we are in another \"Garden of England\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dc4ed37-c3a2-375e-b01d-1cacf561e7b9",
                                        "entry_id": "058b2146-8213-3f81-9997-e95cea4b6aae",
                                        "glosses": [
                                            "A man living apart from his wife."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gander",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95a84ad1-b01d-3406-a851-dfe623bd400f",
                                        "entry_id": "a841ec30-ebd4-3668-90b3-211e9909285f",
                                        "glosses": [
                                            "to ramble, wander"
                                        ],
                                        "tags": [
                                            "dialectal",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a23345bb-06ab-4e0e-be24-b7b2c6a4fc37",
                        "source_entry_id": "cf92714d-0447-30d6-88cd-a524644d3004",
                        "source_sense_id": "a1f0636e-e6da-3a76-85bf-aa8b7c28801b",
                        "source_sense_description": "männliche Gans",
                        "target_lang_word": "jars",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jars",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2283f8bc-de93-3db6-a208-869af45f6742",
                                        "entry_id": "bb512302-c80d-3ab2-8d16-2de44e4ae6e7",
                                        "glosses": [
                                            "Mâle de l’oie domestique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "320efcba-2528-432a-90d0-dc98afc8480a",
                                                "sense_id": "2283f8bc-de93-3db6-a208-869af45f6742",
                                                "text": "Scapin fit signe de la main aux comédiens de rester immobiles, et bientôt du fourré déboucha un magnifique jars, le col tendu, la tête haute, et se dandinant avec une stupidité majestueuse sur ses larges pattes palmées. Deux oies, ses épouses, le suivaient confiantes et naïves."
                                            },
                                            {
                                                "example_id": "e167b030-8897-4403-b4ed-8d1add67c0ec",
                                                "sense_id": "2283f8bc-de93-3db6-a208-869af45f6742",
                                                "text": "Les deux jars, en tête, s’arrêtèrent brusquement, hanchant sur une patte, leurs grands becs jaunes tournés l’un vers l’autre ; et les becs de chaque bande, tous à la fois, suivirent le bec de leur chef, tandis que les corps hanchaient du même côté."
                                            },
                                            {
                                                "example_id": "77aad15d-9517-41fb-881a-d5bdae227c96",
                                                "sense_id": "2283f8bc-de93-3db6-a208-869af45f6742",
                                                "text": "Au même instant, des dizaines d’oies sauvages, prévenues du danger se ruèrent vers le ciel, comme aspirées par un tourbillon ascensionnel. […] À la pointe de la flèche, Tadeuz crut reconnaître le jars qu’il avait laissé fuir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "605eb9e8-d27c-3086-88e3-4a7ccd6779e4",
                                        "entry_id": "bb512302-c80d-3ab2-8d16-2de44e4ae6e7",
                                        "glosses": [
                                            "Meuble représentant l’animal du même nom dans les armoiries. Il est généralement représenté de passant. À rapprocher de canard, cane, canette, cygne et oie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae0e4c94-d16f-4de8-b65c-9ce4fdb04bb5",
                                                "sense_id": "605eb9e8-d27c-3086-88e3-4a7ccd6779e4",
                                                "text": "De sinople au jars d’argent, becqué et membré d’or, au chef cousu de gueules chargé d’une croix aussi d’argent, qui est de Fronton → voir illustration « armoiries avec un jars »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jars",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "28d82c61-1315-35d4-a121-73b13c10a81a",
                                        "entry_id": "8f67c0fd-299d-322b-8061-12f8cf5d682e",
                                        "glosses": [
                                            "Variante de jarre, le poil."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "56aafd27-d537-363b-856d-e4a02da2f7a5",
                                        "entry_id": "8f67c0fd-299d-322b-8061-12f8cf5d682e",
                                        "glosses": [
                                            "Jargon, argot."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "605e4235-1844-49ce-95fc-8a1624be76ef",
                                                "sense_id": "56aafd27-d537-363b-856d-e4a02da2f7a5",
                                                "text": "Elle entravait peut-être lap à mon jars. Tant pis, je n’allais pas traduire."
                                            },
                                            {
                                                "example_id": "a1e0ebe9-3d01-4133-ba7e-48240a8cf2ae",
                                                "sense_id": "56aafd27-d537-363b-856d-e4a02da2f7a5",
                                                "text": "L’un et l’autre connaissaient à fond le slang, qui est le « jars » londonien, et l’« entravaient » avec une égale facilité."
                                            },
                                            {
                                                "example_id": "d68e6557-1328-45f7-8903-a78cc0f549b0",
                                                "sense_id": "56aafd27-d537-363b-856d-e4a02da2f7a5",
                                                "text": "— Merci, qu’est-ce que c’est que ce pissat de mulet ?Il paraît que vous ne dévidez pas le jars ? — (Eugène Sue, Les Mystères de Paris, Quarto Gallimard,p. 79)/>— C’est du cognac.\n— Du visqui, il me faudrait. Je veux du visqui. Et où est l’autre enfant de maquereau, Alexandre ?\n— Il s’est trissé, madame.\n— Il s’est trissé, madame. Dis donc, t’en es encore au jars des Pieds-Nickelés, toi, l’enfant de chœur ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
