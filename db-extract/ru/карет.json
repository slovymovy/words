                                    },
                                    {
                                        "sense_id": "d7666267-4d46-3815-b4ab-a3b27ee21053",
                                        "entry_id": "1a86666a-244d-3512-a393-054d041f10c6",
                                        "glosses": [
                                            "Nom vernaculaire de deux espèces de tortues marines dont on travaillait l’écaille.",
                                            "La caouanne (Caretta caretta)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28fa700d-1335-4ac7-a56e-1706479ef9e8",
                                                "sense_id": "d7666267-4d46-3815-b4ab-a3b27ee21053",
                                                "text": "Le Caret ou Caouanne ( Caretta caretta ), la Tortue imbriquée ( Eretmochelys imbricata) et la Tortue franche (Chelonia mydas) sont tous trois entièrement marins et, conformément à ce mode de vie, leurs pattes ont acquis la forme de nageoires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd64a13e-5b3b-312d-90f0-8f02aecac2cf",
                                        "entry_id": "1a86666a-244d-3512-a393-054d041f10c6",
                                        "glosses": [
                                            "Nom vernaculaire de deux espèces de tortues marines dont on travaillait l’écaille.",
                                            "La tortue imbriquée (Eretmochelys imbricata)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0ad7e3b-143a-4545-a4a5-5cc0d1ca3845",
                                                "sense_id": "bd64a13e-5b3b-312d-90f0-8f02aecac2cf",
                                                "text": "Il n’y a que trois espèces de tortues dont l’écaille ait les qualités convenables pour les arts ; elles sont connues sous les noms de caret ou tortue imbriquée, de tortue franche, de caouanne : elles sont marines toutes les trois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67a31290-0b1f-349f-84c5-e377a5ed8589",
                                        "entry_id": "1a86666a-244d-3512-a393-054d041f10c6",
                                        "glosses": [
                                            "Écaille de la tortue du même nom."
                                        ],
                                        "tags": [],
