                    {
                        "translation_id": "12f39cc5-2d5e-4142-b1a3-bef57e4e29f1",
                        "source_entry_id": "359a13ca-d9d4-399c-9e99-8010a5673ef7",
                        "source_sense_description": "an agent sent on a mission to represent the interests of someone else",
                        "target_lang_word": "émissaire",
                        "target_lang_code": "fr",
