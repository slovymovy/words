                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An algebraic structure consisting of a set of elements and an operation on them.",
                        "zh": "由一组元素及其运算组成的代数结构。"
