                "senses": [
                    {
                        "sense_id": "a8d3f1e7-5f69-3f4a-a1fe-5ed9296450c5",
                        "entry_id": "5d5a4210-3a75-3011-b509-4dc4550fa72b",
                        "glosses": [
                            "de verhouding tussen landen, met name die tussen grootmachten en zwakkere (buur)landen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7a49f22-0e24-4650-8bc0-2917a213cb7e",
                                "sense_id": "a8d3f1e7-5f69-3f4a-a1fe-5ed9296450c5",
                                "text": "Wij dwepen niet met Pruisen of het Pruisische Regeeringstelsel, maar het bloedige drama van '66 heeft toch dit voor, dat de machtsverhouding in Europa eene andere is geworden en zich in plaats van de traditioneele vrees voor Frankrijk, een geheel andere gezichteinder heeft gevormd;"
                            }
                        ]
                    },
                    {
                        "sense_id": "ee9ef3c4-23cd-3b5c-8814-6de495d2e643",
                        "entry_id": "5d5a4210-3a75-3011-b509-4dc4550fa72b",
                        "glosses": [
                            "de verhouding tussen politieke partijen, met name die tussen de grotere en kleinere"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c688327-ae8a-4e71-9334-0b32f0a4d202",
                                "sense_id": "ee9ef3c4-23cd-3b5c-8814-6de495d2e643",
                                "text": "wat zij zegt weet ieder, althans mij is in den laatsten tijd geen beschouwing omtrent de machtsverhouding in de Tweede Kamer onder de oogen gekomen, welke in hoofdzaak van het bovenstaande afwijkt."
                            }
                        ]
                    },
                    {
                        "sense_id": "2e779472-42dd-3c77-bbeb-4edea8cecc46",
                        "entry_id": "5d5a4210-3a75-3011-b509-4dc4550fa72b",
                        "glosses": [
                            "een verhouding tussen twee partijen waarbij macht of machtsmisbruik een rol speelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05f3b4e7-5ae2-4ff5-994c-59691c3adc83",
                                "sense_id": "2e779472-42dd-3c77-bbeb-4edea8cecc46",
                                "text": "De Reclassering deed onderzoek naar de man en ontdekte weinig bijzonderheden bij hem. Al snapte hij aanvankelijk niet zo goed dat het slachtoffer te jong was en dat er een machtsverhouding tussen hem en het meisje bestond. ,,Nu snap ik dat wel”, zei W. tegen de rechter."
                            },
                            {
                                "example_id": "1e000e0a-4469-41a0-9309-c4f73198dfde",
                                "sense_id": "2e779472-42dd-3c77-bbeb-4edea8cecc46",
                                "text": "Evers schrijft meerdere keren slachtoffer te zijn geweest van expliciete seksuele intimidatie vanuit een scheve machtsverhouding of impliciete intimidatie vanwege ‘gebrek aan sociale vaardigheden’."
                            },
                            {
                                "example_id": "b7d75ad6-b9e7-4de1-b073-eb56f6550c62",
                                "sense_id": "2e779472-42dd-3c77-bbeb-4edea8cecc46",
                                "text": "Volgens KHN is de machtsverhouding uit balans. Ze willen die 'normaler maken'. Inmiddels zijn er ruim 1.900 restaurants aangesloten bij BookDinners, de verwachting is dat gasten in juli 2018 bij 3.000 aangesloten restaurants een tafeltje kunnen reserveren. De KNH wil met het platform restaurants weer zelf de regie geven over hun reserveringen."
                            }
                        ]
                    }
                ],
