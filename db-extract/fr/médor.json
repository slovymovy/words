                        "examples": [
                            {
                                "example_id": "e595df62-551f-4053-a252-8b722b6b06df",
                                "sense_id": "47ae7336-ed45-3e4e-9f09-f45fbf0df335",
                                "text": "On peut remonter de l'individu au genre suprême, ou descendre du genre suprême à l'individu, en passant par tous les dégrés différenciels intermédiaires : Médor, chien, animal, substance, être, voilà la gradation ascendante ;"
                            },
                            {
                                "example_id": "b0ac3e1b-e241-440d-9894-8371766d6df7",
                                "sense_id": "47ae7336-ed45-3e4e-9f09-f45fbf0df335",
                                "text": "Aimable chien, fidèle et bon Médor, Tu restes seul à ta jeune maîtresse ! On m’abandonne… et toi, tu veux encor Me consoler par ta tendresse."
                            }
                        ]
                    },
                    {
                        "sense_id": "ad6c493a-f329-3e48-b6a1-510fcc1f8956",
                        "entry_id": "a870440a-d633-3a3c-9292-79a84197dba3",
                        "glosses": [
                            "Chat spécial."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d0e2454-bcf6-4b99-8c2d-4eb71c10eebe",
                                "sense_id": "ad6c493a-f329-3e48-b6a1-510fcc1f8956",
                                "text": "Soyez donc chat pour qu'on vous appelle Médor !"
                            }
                        ]
                    }
