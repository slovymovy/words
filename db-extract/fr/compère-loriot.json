                            {
                                "example_id": "d360d1ce-78b6-4c33-8d50-01bcae0a62fe",
                                "sense_id": "1c40d517-1399-3c93-9962-98d392a82f83",
                                "text": "Bonne chasse, brave Bâti ! rapportez-nous quelque oiseau, un gros geai bleu à moustaches, un beau compère-loriot noir et jaune, ou un de ces méchants piverts qui font des trous dans nos arbres."
                            },
                            {
                                "example_id": "291c9ad7-150d-48c5-832b-b4b3f5666629",
                                "sense_id": "1c40d517-1399-3c93-9962-98d392a82f83",
                                "text": "Loriot jaune. Loriot d'Europe."
                            }
                        ]
                    },
                    {
                        "sense_id": "eda760b5-0c57-3c3a-bd44-73f729fee24b",
                        "entry_id": "c89bcd00-fa69-3aca-affd-fc4a81b8985b",
                        "glosses": [
                            "Affection des paupières dite orgelet."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "61ee6e85-3f3a-4852-a8c9-ce5d2ab753d2",
                                "sense_id": "eda760b5-0c57-3c3a-bd44-73f729fee24b",
                                "text": "Des égueulés offraient des cure-dents et des cure-oreilles, et un affreux voyou dont les yeux se fleurissaient de compères-loriots hurlait : l’anneau brisé, la sûreté des clefs, dix centimes, deux sous !"
                            }
                        ]
