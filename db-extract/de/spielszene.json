                "senses": [
                    {
                        "sense_id": "b4e29366-6627-3db0-898e-8f4cc93473af",
                        "entry_id": "1bfaf309-ec2e-343c-8971-8f060583de1b",
                        "glosses": [
                            "Episode eines Spiels, auch in bildlicher Darstellung oder als Teil eines Schauspiels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cac6c3f-aeed-40ad-8a97-efc1335ab494",
                                "sense_id": "b4e29366-6627-3db0-898e-8f4cc93473af",
                                "text": "„Wenn von hier aus zu kleinen Scharaden, dramatischem Spiel oder gar einstudierten Spielszenen weitergegangen wird, so liegt das nicht unmittelbar auf der Linie dieses freien, geselligen Spielens mit der ganzen Schulklasse.“"
                            },
                            {
                                "example_id": "4df41325-3ea3-4860-92ac-d9657cb104d8",
                                "sense_id": "b4e29366-6627-3db0-898e-8f4cc93473af",
                                "text": "„Er verlegte die Spielszenen in die Straßen am Rande einer größeren Stadt und überließ dabei den über 250 spielenden Kindern den gesamten Lebensraum: […].“"
                            },
                            {
                                "example_id": "5465767b-0bad-4c62-a36c-78bb05d0e752",
                                "sense_id": "b4e29366-6627-3db0-898e-8f4cc93473af",
                                "text": "„Konkurrent Doppelpass, oft eine Aneinanderreihung vor- und zurückgespulter Spielszenen, die den Gästen zur Beurteilung vorgelegt werden, ist nämlich im Laufe der Jahre zu einer Lehrsendung für Schiedsrichter geschrumpft.“"
                            },
                            {
                                "example_id": "206b6008-c922-4763-9765-a595fefeaecb",
                                "sense_id": "b4e29366-6627-3db0-898e-8f4cc93473af",
                                "text": "„Kritiker halten ihnen vor, Spielszenen isoliert zu betrachten.“"
                            },
                            {
                                "example_id": "5531b291-4a82-4146-a94d-c73e7b9d6dde",
                                "sense_id": "b4e29366-6627-3db0-898e-8f4cc93473af",
                                "text": "„Dazu sitzt der Videoassistent neben zwei Operatoren eines Softwareanbieters, die ihm auf Wunsch jede Spielszene aus bis zu 21 Kameraperspektiven auf den Bildschirm werfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
