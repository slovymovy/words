                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "canneler",
                                "target_lang_sense_clarification": "créer des stries ou des rainures"
                            },
                            {
                                "target_lang_word": "strier",
                                "target_lang_sense_clarification": "marquer de lignes en relief"
                            }
                        ]
                    }
                }
            ]
        }
    ]
