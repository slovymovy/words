                        "glosses": [
                            "rym niedokładny, polegający tylko na współbrzmieniu spółgłosek po ostatniej akcentowanej samogłosce (np. grabarz — grabież, pacierz — chociaż)"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "5558e19c-3ac6-3b1a-b24c-2e408a9cb0fb",
                        "entry_id": "b369a306-671c-3ca4-a735-9ca9abcbd4b3",
                        "glosses": [
                            "harmonijne współbrzmienie dźwięków różnej wysokości"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddc730e2-797f-494b-8734-287c53a4f825",
                                "sense_id": "5558e19c-3ac6-3b1a-b24c-2e408a9cb0fb",
                                "text": "W obrębie jednej oktawy pryma, kwarta, kwinta i oktawa są konsonansami doskonałymi, zaś tercja i seksta nazywane są konsonansami niedoskonałymi."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
