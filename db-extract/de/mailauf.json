                "senses": [
                    {
                        "sense_id": "30e06cde-e043-32ba-9e93-b7982d637627",
                        "entry_id": "db060b69-683a-3ff5-a3da-f1b2e1434fd5",
                        "glosses": [
                            "Laufen/Joggen oder Laufveranstaltung im Monat Mai"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "aa4598ce-5148-4a70-a689-ee21efda43f5",
                                "sense_id": "30e06cde-e043-32ba-9e93-b7982d637627",
                                "text": "„Beim 31. Gristeder Mailauf erreichte Marco Julian Schäfer beim Walking über die Strecke von 7,5 km in der Altersklasse Senioren M 30 in der Zeit von 1:03:00 den ersten Rang.“"
                            },
                            {
                                "example_id": "622cc4a0-d2fe-4e3d-a785-c3457533f14b",
                                "sense_id": "30e06cde-e043-32ba-9e93-b7982d637627",
                                "text": "„Mit insgesamt 25 Starter der Laufgruppe, darunter 24 Lauffreunde, starteten wir traditionell beim Sebamed Mailauf in Boppard.“"
                            },
                            {
                                "example_id": "79a02b09-562b-4336-be41-7291fd22e0e9",
                                "sense_id": "30e06cde-e043-32ba-9e93-b7982d637627",
                                "text": "„Mit starken sportlichen Leistungen triumphierte die Hansa Simmerath beim 16. Mailauf.“"
                            },
                            {
                                "example_id": "080b5415-d6d1-4ef6-acab-b3349826747d",
                                "sense_id": "30e06cde-e043-32ba-9e93-b7982d637627",
                                "text": "„Am 09. Mai 2018 fand bei herrlichstem Wetter unser Mailauf statt.“"
                            },
                            {
                                "example_id": "3d9e786f-95c0-4508-937a-706a1252cddb",
                                "sense_id": "30e06cde-e043-32ba-9e93-b7982d637627",
                                "text": "„Oft verbringen wir diesen Tag noch immer in ihr, der Gärtnergatte beim Mailauf und ich in ihren ergrünenden Parkanlagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
