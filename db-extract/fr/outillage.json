                                "target_senses": [
                                    {
                                        "sense_id": "c39ceed5-62e2-3dff-bc72-521fdc985b73",
                                        "entry_id": "72c5a11c-c696-3cf5-bb49-32bbf462b924",
                                        "glosses": [
                                            "Kenntnisse oder Fertigkeiten, die man für eine Arbeit braucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b172a6fc-2104-438c-85fe-fd656b241e5a",
                                                "sense_id": "c39ceed5-62e2-3dff-bc72-521fdc985b73",
                                                "text": "Das Rüstzeug für ein erfolgreiches Studium erlangen."
                                            },
                                            {
                                                "example_id": "fd1f96d0-d53b-48a2-b567-eeabb47bed3c",
                                                "sense_id": "c39ceed5-62e2-3dff-bc72-521fdc985b73",
                                                "text": "„Das Rüstzeug für seine verfassungsrechtlichen Konzepte holte er sich beim Jurastudium in Wien.“"
                                            },
                                            {
                                                "example_id": "d4088359-89b1-4dc8-8cc0-91a47e8b1a1d",
                                                "sense_id": "c39ceed5-62e2-3dff-bc72-521fdc985b73",
                                                "text": "„Die ernüchtende Besichtigung des Fundaments der Wissenschaft kommt erst, wenn wir das notwendige Rüstzeug und den erforderlichen Mut beisammen haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fd5744a0-7e27-3175-ac64-be61062da31d",
                                        "entry_id": "72c5a11c-c696-3cf5-bb49-32bbf462b924",
                                        "glosses": [
                                            "Werkzeuge, die man für eine Arbeit braucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7dcd05d-394f-4500-9fc3-ad4f38b8c50a",
                                                "sense_id": "fd5744a0-7e27-3175-ac64-be61062da31d",
                                                "text": "Er hat nicht das richtige Rüstzeug für die auszuführenden Arbeiten dabei."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eac97e27-e589-43b4-b878-dd45c2eefd24",
