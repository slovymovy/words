                "senses": [
                    {
                        "sense_id": "28263483-b03c-3336-b7a8-eaff3ca42b08",
                        "entry_id": "2f98208b-9335-3ce4-bbe4-37d59d69461f",
                        "glosses": [
                            "matchmaking"
                        ],
                        "tags": [
                            "derogatory",
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "eab2ce0a-0670-417e-ab66-1579ae6b410c",
                                "sense_id": "28263483-b03c-3336-b7a8-eaff3ca42b08",
                                "text": "Das einzige, was mich an meiner besten Freundin nervt, sind ihre ewigen Kuppeleien.",
                                "translation": "The only thing that annoys me about my best friend is her constant matchmaking schemes.",
                                "english": "The only thing that annoys me about my best friend is her constant matchmaking schemes."
                            }
                        ]
                    },
                    {
                        "sense_id": "9c3bd3aa-86bd-3145-bc90-d8a066fdeb80",
                        "entry_id": "2f98208b-9335-3ce4-bbe4-37d59d69461f",
                        "glosses": [
                            "the crime of enabling illicit sexual relations for financial gain, e.g. by letting hotel rooms to unmarried couples"
                        ],
                        "tags": [
                            "feminine",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "e925feb4-19fa-47f4-b0e6-c85daf455bbb",
                                "sense_id": "9c3bd3aa-86bd-3145-bc90-d8a066fdeb80",
                                "text": "In Deutschland war die Kuppelei bis 1973 strafbar, in manchen islamischen Ländern ist sie es auch heute noch.",
                                "translation": "Enabling illicit relations was punishable in Germany until 1973, in some Islamic countries it still is today.",
                                "english": "Enabling illicit relations was punishable in Germany until 1973, in some Islamic countries it still is today."
                            }
                        ]
                    }
