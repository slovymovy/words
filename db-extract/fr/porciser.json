                "senses": [
                    {
                        "sense_id": "3fcf6c43-7994-3179-8f54-e51d38ab8d91",
                        "entry_id": "b3a95434-fea4-3ba9-bbd4-092a6f13a228",
                        "glosses": [
                            "Donner un caractère porcin à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74873afc-0401-4a87-bcb8-cafe749b69c4",
                                "sense_id": "3fcf6c43-7994-3179-8f54-e51d38ab8d91",
                                "text": "Mon commentateur a évoqué les porcs et les bœufs. Ces derniers ont-ils pour habitude de “boviniser” ou de “porciser” les gens – projettent-ils sur nous des attentes et des reflets de leurs propres modèles de comportement et, si oui, de quoi avons-nous l’air à leurs yeux ?"
                            },
                            {
                                "example_id": "235295db-ba40-45d7-91a9-7dac8411c812",
                                "sense_id": "3fcf6c43-7994-3179-8f54-e51d38ab8d91",
                                "text": "fausse information, en fait le Flamand est plus porcisé que le Wallon..."
                            },
                            {
                                "example_id": "99f555b4-6779-4d9b-b245-ab682d2a9181",
                                "sense_id": "3fcf6c43-7994-3179-8f54-e51d38ab8d91",
                                "text": "En Allemagne dans les années 1980, le dessinateur Rainer Hachfeld a été condamné pour avoir porcisé un dirigeant régional."
                            }
                        ]
                    }
