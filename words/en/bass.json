    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f587e654-3989-380c-90e8-5650e8c3254d",
                    "sense_definition": "A musical instrument that plays low-pitched notes, such as a bass guitar or double bass.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "music_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He started learning to play the <w>bass</w> when he was in high school.",
                            "target_lang_translations": {
                                "ru": "Он начал учиться играть на <w>басу</w>, когда учился в старшей школе.",
                                "zh": "他高中时就开始学习弹<w>贝斯</w>了。"
                            }
                        },
                        {
                            "text": "The band is looking for a new musician who can play the <w>bass</w> well.",
                            "target_lang_translations": {
                                "ru": "Группа ищет нового музыканта, который хорошо играет на <w>басу</w>.",
                                "zh": "乐队正在寻找一位能弹好<w>贝斯</w>的新乐手。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "play the bass",
                        "double bass",
                        "electric bass",
                        "bass guitar"
                    ],
                    "target_lang_definitions": {
                        "ru": "Музыкальный инструмент, издающий низкие звуки, например, бас-гитара или контрабас.",
                        "zh": "一种发出低音的乐器，如低音吉他或低音提琴。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бас",
                                "target_lang_sense_clarification": "разговорное название бас-гитары или контрабаса"
                            },
                            {
                                "target_lang_word": "бас-гитара",
                                "target_lang_sense_clarification": "электрический инструмент"
                            },
                            {
                                "target_lang_word": "контрабас",
                                "target_lang_sense_clarification": "смычковый инструмент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "贝斯",
                                "target_lang_sense_clarification": "指低音吉他"
                            },
                            {
                                "target_lang_word": "低音提琴",
                                "target_lang_sense_clarification": "指弦乐器"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00e0d248-1c19-32b9-84f4-e22cefa75746",
                    "sense_definition": "An edible fish found in rivers or the sea, often caught for sport or food.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fish_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We went to the lake early in the morning to fish for <w>bass</w>.",
                            "target_lang_translations": {
                                "ru": "Мы поехали на озеро рано утром ловить <w>окуня</w>.",
                                "zh": "我们一大早就去湖边钓<w>鲈鱼</w>了。"
                            }
                        },
                        {
                            "text": "The restaurant serves grilled sea <w>bass</w> with a side of fresh vegetables.",
                            "target_lang_translations": {
                                "ru": "В ресторане подают жареного морского <w>окуня</w> с гарниром из свежих овощей.",
                                "zh": "这家餐厅供应烤<w>海鲈</w>，配菜是新鲜蔬菜。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sea bass",
                        "freshwater bass",
                        "striped bass",
                        "largemouth bass"
                    ],
                    "target_lang_definitions": {
                        "ru": "Съедобная рыба, обитающая в реках или морях, часто вылавливаемая ради спорта или еды.",
                        "zh": "一种生活在河流或海洋中的食用鱼，常用于垂钓或食用。"
                    },
                    "translations": {
                        "ru": [
