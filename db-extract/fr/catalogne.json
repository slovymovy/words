                ],
                "senses": [
                    {
                        "sense_id": "a3a52712-9a61-3bf5-8127-91962889093a",
                        "entry_id": "31631620-2544-3222-9661-7ff6bcdb309d",
                        "glosses": [
                            "(depuis au moins 1611) Sorte de couvre-lit."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "fd43c1af-9d50-339e-867a-f61049cc05e9",
                        "entry_id": "31631620-2544-3222-9661-7ff6bcdb309d",
                        "glosses": [
                            "(depuis le XIXᵉ ou fin XVIIIᵉ siècle) Couverture ou tapis fabriqué au métier à tisser à partir de tissus usagés préalablement découpés en lanières."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "6ab09b89-dad3-4aba-81b0-0d943e88458a",
                                "sense_id": "fd43c1af-9d50-339e-867a-f61049cc05e9",
                                "text": "Au matin Tit’Bé sautait à bas de son lit longtemps avant le jour pour aller voir si les gros morceaux de bouleau avaient rempli leur office et brûlé toute la nuit ; si par malheur le feu était amorti, il le rallumait aussitôt avec de l’écorce de bouleau et des branches de cyprès, entassait de grosses bûches sur la première flamme, et retournait en courant s’enfoncer sous les couvertures de laine brune et de catalogne pour attendre que la bonne chaleur eût de nouveau rempli la maison."
                            },
                            {
                                "example_id": "30a62c3f-f325-4390-a5c3-5524be73accf",
                                "sense_id": "fd43c1af-9d50-339e-867a-f61049cc05e9",
                                "text": "'Marie sortit, pieusement,avec des caresses, les couvertures grises aux larges bordures pourpres, puis les lourdes catalognes barrées où, par bandes, sa mère avait étalé la couleur des paysages et des saisons: du bleu de montagne, du jaune de blé mûr, et, entre deux, de larges quartiers tout blancs comme les champs de neige de son pays.'"
                            }
                        ]
                    }
