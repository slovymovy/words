                "senses": [
                    {
                        "sense_id": "3465a2ef-e1d2-33d2-88f7-111cf9dfcf4d",
                        "entry_id": "191426a5-9511-3e2e-84b1-a3cac295ff47",
                        "glosses": [
                            "Abbildung, die einen Staatsmann/Staatsfrau/Herrscher zeigt und keinen privaten Zwecken dient"
                        ],
                        "tags": [
                            "historical",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "6ec1ebf7-d0d1-411a-88a7-419708bc46c9",
                                "sense_id": "3465a2ef-e1d2-33d2-88f7-111cf9dfcf4d",
                                "text": "„Die Vergleiche der Porträts belegen, dass es sich bei dem Ludwigsburger Typus weniger um ein offizielles Staatsporträt handelte als vielmehr um ein privates Bildnis […].“"
                            },
                            {
                                "example_id": "8be4e1e1-49aa-4d1f-befc-6df7fc2d108e",
                                "sense_id": "3465a2ef-e1d2-33d2-88f7-111cf9dfcf4d",
                                "text": "„Insbesondere im Staatsporträt der Königin vereinigt Goya Stilelemente von Mengs und Velázquez zu einem neuen Stil, den er in seinen späteren Porträts symbiotisch zu seinem eigenen Duktus reifen lassen wird.“"
                            }
                        ],
