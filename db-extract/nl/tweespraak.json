                                    },
                                    {
                                        "sense_id": "11ce4d81-3785-33e5-8e51-2125f7a9e8a7",
                                        "entry_id": "2640d573-91e1-3bce-b88c-200d404b409b",
                                        "glosses": [
                                            "To take part in a dialogue; to dialogize."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6303d47-44b3-4332-bfb8-a5f64cf28c99",
                                                "sense_id": "11ce4d81-3785-33e5-8e51-2125f7a9e8a7",
                                                "text": "Dost [thou] dialogue with thy shadow?"
