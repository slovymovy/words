                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "51a70328-6c18-32c0-ba59-84cf2ed1ba95",
                                        "entry_id": "3e8ac3fd-ac6c-3286-9257-00e0a8b2b8c9",
                                        "glosses": [
                                            "Aerodino que, principalmente, se mantiene en vuelo en virtud de las reacciones que ejerce el aire sobre planos a los cuales se imparte un movimiento de batimiento similar al de las alas de las aves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39005dbb-7216-4cb6-8c8a-3ae124bbcd7b",
                                                "sense_id": "51a70328-6c18-32c0-ba59-84cf2ed1ba95",
                                                "text": "La observación del vuelo de las aves ha llevado a diversos pensadores y científicos a través de la historia a diseñar ornitópteros - máquinas basadas en este principio"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
