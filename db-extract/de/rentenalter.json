                ],
                "senses": [
                    {
                        "sense_id": "57c86aeb-0111-3212-a66d-671b7c3fd6e2",
                        "entry_id": "6488b2d3-c267-397b-90f5-9356943f625c",
                        "glosses": [
                            "Alter, ab dem jemand Rente beziehen, in den Ruhestand gehen und somit zum Rentner werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "393b6c3a-57c3-4b63-a9a0-f165bbe78f52",
                                "sense_id": "57c86aeb-0111-3212-a66d-671b7c3fd6e2",
                                "text": "Das Rentenalter ist heute um einiges höher als vor 100 Jahren."
                            },
                            {
                                "example_id": "d0930d6b-c694-4854-81a8-d92f37cbd9fa",
                                "sense_id": "57c86aeb-0111-3212-a66d-671b7c3fd6e2",
                                "text": "„Also forderten Hindenburg und Ludendorff eine Ausdehnung der Wehrpflicht auf alle Männer von 16 Jahren bis zum Rentenalter, sie sollten notfalls zwangsweise in der Rüstungsproduktion eingesetzt werden.“"
                            },
                            {
                                "example_id": "c3ce0487-26d9-4299-b791-3ee8a112a9b8",
                                "sense_id": "57c86aeb-0111-3212-a66d-671b7c3fd6e2",
                                "text": "„Ich war allein, schon deutlich im Rentenalter und fuhr durch kahle Hügel und Buschwerk nach Namibia.“"
                            },
                            {
                                "example_id": "a56eeb6c-d426-4200-b623-18dfd24b4635",
                                "sense_id": "57c86aeb-0111-3212-a66d-671b7c3fd6e2",
                                "text": "„In den Iran wäre ich womöglich noch einmal im Rentenalter gereist, ich hätte auf dem Bazar zu viel Geld für einen Seidenteppich ausgegeben und im Hotel über den amateurhaften Service geschimpft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
