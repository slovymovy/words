        "pl-extract.jsonl": [
            {
                "entry_id": "22a37bdf-69f1-374d-8cd6-d2e7f3074449",
                "word": "mikroorganizm",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b78d8354-8def-3424-84eb-3c653cc1fff3",
                        "entry_id": "22a37bdf-69f1-374d-8cd6-d2e7f3074449",
                        "glosses": [
                            "organizm żywy widoczny tylko pod mikroskopem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf324883-a03c-4830-b1be-9300deef9446",
                                "sense_id": "b78d8354-8def-3424-84eb-3c653cc1fff3",
                                "text": "W ludzkim organizmie występuje mnóstwo mikroorganizmów – niektóre mają działanie pozytywne, inne negatywne."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30cb0a86-3a1e-4119-840a-f51bcaad1f54",
                        "source_entry_id": "22a37bdf-69f1-374d-8cd6-d2e7f3074449",
                        "source_sense_id": "b78d8354-8def-3424-84eb-3c653cc1fff3",
                        "target_lang_word": "microorganism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "microorganism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4457767-2633-3e15-96b5-18055e757cb2",
                                        "entry_id": "a1bab713-18af-30f7-9a6f-e54f382cdfeb",
                                        "glosses": [
                                            "An organism that is too small to be seen by the unaided eye; especially, a single-celled organism, such as a bacterium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91d075b3-5b00-44ce-9f67-ec9300201499",
                                                "sense_id": "e4457767-2633-3e15-96b5-18055e757cb2",
                                                "text": "The cud is then reswallowed and further digested by specialized microorganisms that live in the rumen."
                                            },
                                            {
                                                "example_id": "8b9e8060-b94c-47cc-b626-a30e0aed0a76",
                                                "sense_id": "e4457767-2633-3e15-96b5-18055e757cb2",
                                                "text": "Bacillus anthracis: from the first up to the sixth day, this microorganism was isolatable, or in other words still alive."
                                            },
                                            {
                                                "example_id": "b363dd4d-0cef-436f-a699-902bff3e63b8",
                                                "sense_id": "e4457767-2633-3e15-96b5-18055e757cb2",
                                                "text": "The differences in biofilm penetration patterns of both tested photosensitisers and the light source could have played an important role for the survival of microorganisms after the application of aPDT. In a recent own study, we showed that the deepest layers of the oral biofilm were not affected by the aPDT [4 ]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d34aa83d-31c7-44ec-883f-ac1a7c214fe3",
                        "source_entry_id": "22a37bdf-69f1-374d-8cd6-d2e7f3074449",
                        "source_sense_id": "b78d8354-8def-3424-84eb-3c653cc1fff3",
                        "target_lang_word": "micro-organisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "micro-organisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c8fe8fea-a164-3d95-9c2c-9cd6e8bd5dfe",
                                        "entry_id": "b36e96f3-3f1d-3bbc-b814-504e9c844810",
                                        "glosses": [
                                            "Tout organisme vivant qui ne peut être vu qu’au travers d’un microscope optique ou électronique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c17e7a26-9655-4266-8d78-86884dd4680b",
                                                "sense_id": "c8fe8fea-a164-3d95-9c2c-9cd6e8bd5dfe",
                                                "text": "En matière de maladies infectieuses, si les bactériologistes ont découvert de nombreux micro-organismes responsables de maladies, leurs connaissances n’ont pas encore engendré de moyens de traitement efficaces."
                                            },
                                            {
                                                "example_id": "4e49772a-5c7a-43c1-b293-78a257911151",
                                                "sense_id": "c8fe8fea-a164-3d95-9c2c-9cd6e8bd5dfe",
                                                "text": "Le terme n’est employé que depuis une quinzaine d’années, mais il sert à désigner quelque chose que nous connaissons depuis très longtemps : la flore microbienne, mais aussi des champignons et autres micro-organismes que notre estomac contient en grand nombre, dévoile le docteur Maxime Pichon, microbiologiste au sein du CHU de Poitiers et spécialiste du microbiote."
                                            },
                                            {
                                                "example_id": "1b70c4dd-51bd-48b9-8a53-4341cf55e22b",
                                                "sense_id": "c8fe8fea-a164-3d95-9c2c-9cd6e8bd5dfe",
                                                "text": "Il y avait une sorte d’agrément entre les structures et la pourriture noble qui les rongeait. Les bois et les micro-organismes qui les dévastent vivent toujours en bonne intelligence pourvu que cela soit à l’écart des hommes."
                                            },
                                            {
                                                "example_id": "a2de78e2-7c81-4016-a28c-d63ea699724b",
                                                "sense_id": "c8fe8fea-a164-3d95-9c2c-9cd6e8bd5dfe",
                                                "text": "En 2017, au Salon de l’agriculture, l’institut avait installé sur son stand un microscope pour observer les micro-organismes contenus dans un yaourt – environ dix milliards par pot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1022af8-e21a-427c-beeb-b807fcb01e98",
                        "source_entry_id": "22a37bdf-69f1-374d-8cd6-d2e7f3074449",
                        "source_sense_id": "b78d8354-8def-3424-84eb-3c653cc1fff3",
                        "target_lang_word": "microorganisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "microorganisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7875db48-0c1a-32aa-a900-3a1325fb096c",
                                        "entry_id": "568fedff-ff2c-37d7-b7e2-887fc2d09c1f",
                                        "glosses": [
                                            "Variante orthographique de micro-organisme."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d586b6b-6d81-494b-916f-3ee5bb00e97a",
                                                "sense_id": "7875db48-0c1a-32aa-a900-3a1325fb096c",
                                                "text": "Les virus et les bactéries sont des microorganismes."
                                            },
                                            {
                                                "example_id": "1c200f80-f8f7-4521-9d6d-c6e4d8306835",
                                                "sense_id": "7875db48-0c1a-32aa-a900-3a1325fb096c",
                                                "text": "À l’intérieur du phagocyte, le microorganisme est digéré par les enzymes de la cellule immunitaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
