                ],
                "senses": [
                    {
                        "sense_id": "41d987ec-7033-3a72-8a4a-8ad5ed655e36",
                        "entry_id": "950cb9be-c92d-3ab5-9fc7-0559df2e04df",
                        "glosses": [
                            "Fumer le cigare."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "11c3e9c5-c01e-4722-b965-635a00e545d8",
                                "sense_id": "41d987ec-7033-3a72-8a4a-8ad5ed655e36",
                                "text": "Il se lève en cigarant à toute vapeur."
                            },
                            {
                                "example_id": "7dd32a36-215c-4e74-8b34-a9d85662c565",
                                "sense_id": "41d987ec-7033-3a72-8a4a-8ad5ed655e36",
                                "text": "La grande verrière du hall de la gare enfume les voyageurs. Les trains à quai cigarent en attendant le prochain voyage."
                            },
                            {
                                "example_id": "b68ccb11-de09-48ec-b9a7-b10c79d539ba",
                                "sense_id": "41d987ec-7033-3a72-8a4a-8ad5ed655e36",
                                "text": "D'ailleurs personne ne cigarait, ne cigarillait, ne cigarettait."
                            },
                            {
                                "example_id": "af4ca825-4a15-45eb-a8ea-7f4c1488b5d1",
                                "sense_id": "41d987ec-7033-3a72-8a4a-8ad5ed655e36",
                                "text": "Les gens aisés \"cigaraient\" et les autres, dont mon père, se les roulaient et le dimanche adoraient la cigarette faite."
                            }
                        ]
                    }
                ],
