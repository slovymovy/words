                                "target_senses": [
                                    {
                                        "sense_id": "e69f5ea1-9563-3156-aad0-b31ef71f1d4a",
                                        "entry_id": "d94395a3-1708-30fe-91cd-191efa4932b0",
                                        "glosses": [
                                            "die Lagerung, das Abstellen von Gegenständen und Material, die Unterbringung von Gegenständen und Material"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d74292b8-b896-4947-945d-4f09fd727bf2",
                                                "sense_id": "e69f5ea1-9563-3156-aad0-b31ef71f1d4a",
                                                "text": "Die Ablagerung des Diebesgutes fand im Wesentlichen auf fremden Grundstücken statt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0c4a8863-3999-3ce4-a350-c08a95e51fd8",
                                        "entry_id": "d94395a3-1708-30fe-91cd-191efa4932b0",
                                        "glosses": [
                                            "das Absetzen, Niedersinken von losem Material auf einem Untergrund"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cabd8a16-cff3-4bb4-8c3b-ce9c4562f9d7",
                                                "sense_id": "0c4a8863-3999-3ce4-a350-c08a95e51fd8",
                                                "text": "Die Ablagerungen des Sandes findet man erst am Unterlauf des Flusses."
                                            },
                                            {
                                                "example_id": "7e56f09f-186a-4a2e-97c6-c14294e4f3a4",
                                                "sense_id": "0c4a8863-3999-3ce4-a350-c08a95e51fd8",
                                                "text": "„Die hierbei entstandenen Ablagerungen setzen sich an einigen Stellen des Alpenrandes aus groben. stark verkitteten Konglomeraten, der Nagelfluh, an andren aus Sandsteinen und Mergeln zusammen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "976cb955-5105-38d2-a9a3-a429b9494a62",
                                        "entry_id": "d94395a3-1708-30fe-91cd-191efa4932b0",
                                        "glosses": [
                                            "das Verweilen von Gegenständen, Material, Lebensmitteln, Genussmitteln, Zwischenprodukten meist an einem dafür vorgesehenen Platz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43cf987b-5dca-4e8d-88fa-24e8c9c3ecb3",
                                                "sense_id": "976cb955-5105-38d2-a9a3-a429b9494a62",
                                                "text": "Der Käse ist erst nach der Ablagerung genießbar."
                                            },
                                            {
                                                "example_id": "cf3663da-15c4-4805-b54d-63bf888c2642",
                                                "sense_id": "976cb955-5105-38d2-a9a3-a429b9494a62",
                                                "text": "Die feuchten Rohlinge müssen in der Ablagerung trocknen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
