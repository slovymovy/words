                "senses": [
                    {
                        "sense_id": "e9ac496f-37a2-3edf-9949-a790b27037b6",
                        "entry_id": "c604a524-84cc-37b3-aeb0-86ac0c503d99",
                        "glosses": [
                            "Burgundy wine."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5622ee1b-4621-492f-80ce-5f89816a63e5",
                                "sense_id": "e9ac496f-37a2-3edf-9949-a790b27037b6",
                                "text": "Many 2006 Burgundy reds are drinking well now, the better 2007s, especially Chambolles, have been beautiful for a while, and the 2008s could be left alone for a year or so to resolve their tannins. I find many 2011 and 2012 Burgs seductive, and irresistible, just bursting with fruit."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "147595f5-e74e-35d3-86ff-09c62287a463",
                "word": "burg",
