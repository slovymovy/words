                        "target_lang_word": "écorce",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "écorce",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "67c63b46-27be-3acc-aa57-8c993e397f4f",
                                        "entry_id": "8285c794-9a7c-300c-b2a6-7cf1c647756b",
                                        "glosses": [
                                            "Partie superficielle et protectrice des arbres et plus généralement des plantes ligneuses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71b554cf-41b6-4fe6-9060-a4249842fe0d",
                                                "sense_id": "67c63b46-27be-3acc-aa57-8c993e397f4f",
                                                "text": "L’écorce de chêne, employée pour le tannage des cuirs, est un élément important de la richesse forestière du département."
                                            },
                                            {
                                                "example_id": "ce13abab-0b5a-4404-82c9-a24db2ca3462",
                                                "sense_id": "67c63b46-27be-3acc-aa57-8c993e397f4f",
                                                "text": "L’eau frangeait les ramures, alourdissait les fils d’araignée, imbibait les écorces gluantes, et des feuilles tombaient, çà et là, en tournant, dans le tranquille égouttement, dans le grand calme profond."
                                            },
                                            {
                                                "example_id": "03c13a15-4a1f-4bc6-9093-6bf53d672105",
                                                "sense_id": "67c63b46-27be-3acc-aa57-8c993e397f4f",
                                                "text": "Les filaos géants, à l’écorce rugueuse et noire, étaient très nombreux et s'élevaient vers la voûte de feuillage comme des piliers de cathédrale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9925825c-ac3d-3002-9821-10e7d2b6c853",
                                        "entry_id": "8285c794-9a7c-300c-b2a6-7cf1c647756b",
                                        "glosses": [
                                            "Enveloppe de certains fruits, quand elle est épaisse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aed242f5-c0bb-4d1f-b73c-0cb0f3d3726c",
                                                "sense_id": "9925825c-ac3d-3002-9821-10e7d2b6c853",
                                                "text": "La portion aromatique de l’écorce est la plus extérieure, celle qui contient les glandes à huile essentielle."
                                            },
                                            {
                                                "example_id": "de40e739-de6d-4b1e-a511-ea00ad48d023",
                                                "sense_id": "9925825c-ac3d-3002-9821-10e7d2b6c853",
                                                "text": "Décoiffant, le tiramisu de Pierre Hermé, aux écorces de pamplemousse rose, jus de citron, wasabi frais râpé, poivre de Sarawak et thé vert !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f10e5d02-65c8-3def-a039-6469a71b42bd",
                                        "entry_id": "8285c794-9a7c-300c-b2a6-7cf1c647756b",
                                        "glosses": [
                                            "Croûte externe d'une planète."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4f91990-2e09-4f2b-a998-f11dd9e3d49f",
                                                "sense_id": "f10e5d02-65c8-3def-a039-6469a71b42bd",
                                                "text": "Vous venez de voir qu’il y a environ quatre milliards d’années, la Terre, alors jeune planète solitaire, a été percutée par une autre planète, de la taille de Mars, qui arracha un gigantesque morceau de son écorce pour l’éjecter dans l’espace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b157232-8324-3868-8859-315eea4305fe",
                                        "entry_id": "8285c794-9a7c-300c-b2a6-7cf1c647756b",
                                        "glosses": [
                                            "Superficie, apparence."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a22618e3-e8f0-4116-9204-f253dba32ec3",
                                                "sense_id": "2b157232-8324-3868-8859-315eea4305fe",
                                                "text": "Vous vous arrêtez à l’écorce, il faut pénétrer plus avant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dffa24b5-fe2e-3844-a85f-4748252898f5",
                                        "entry_id": "8285c794-9a7c-300c-b2a6-7cf1c647756b",
