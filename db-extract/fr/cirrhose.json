        "fr-extract.jsonl": [
            {
                "entry_id": "d55c8fff-7c59-3283-83bb-71d0dc2c6621",
                "word": "cirrhose",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6e860202-132b-41a6-9b4c-f737feb2c897",
                        "entry_id": "d55c8fff-7c59-3283-83bb-71d0dc2c6621",
                        "tags": [
                            "plural"
                        ],
                        "form": "cirrhoses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ef334c44-382b-32a8-9249-8208f490a908",
                        "entry_id": "d55c8fff-7c59-3283-83bb-71d0dc2c6621",
                        "glosses": [
                            "Affection du foie caractérisée par des granulations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "183d7859-604a-4a5f-a7fb-3aefce1cbb7b",
                                "sense_id": "ef334c44-382b-32a8-9249-8208f490a908",
                                "text": "Il aurait pu mourir d’une cirrhose du foie, à force."
                            },
                            {
                                "example_id": "df7c1d9a-5961-4fd0-866a-9be1e2b26b99",
                                "sense_id": "ef334c44-382b-32a8-9249-8208f490a908",
                                "text": "Pourtant, il passe le plus gros de son temps à leur remplir la panse de vinasse pas chère, à ces pochtrons, et à entretenir leur cirrhose contre de jolis euros brillants."
                            },
                            {
                                "example_id": "3516b746-ae67-4fd4-9fff-fa62ae15c0c7",
                                "sense_id": "ef334c44-382b-32a8-9249-8208f490a908",
                                "text": "L’aflatoxine est suspectée de favoriser les lésions hépatiques, qui peuvent évoluer en cirrhose puis dégénérer en tumeurs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6a5b29a-3ace-4770-a4e9-befa1d6fe734",
                        "source_entry_id": "d55c8fff-7c59-3283-83bb-71d0dc2c6621",
                        "source_sense_id": "ef334c44-382b-32a8-9249-8208f490a908",
                        "target_lang_word": "Zirrhose",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zirrhose",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e528a603-9bc0-3a31-9827-22cc625b8a39",
                                        "entry_id": "f6159544-6225-34f8-a495-2d35764df1e4",
                                        "glosses": [
                                            "chronische Wucherung von Bindegewebe in einem Körperorgan, die zur Verhärtung und Schrumpfung des Organs führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2631b172-5fec-4b52-a8ec-48bbfc79db8e",
                                                "sense_id": "e528a603-9bc0-3a31-9827-22cc625b8a39",
                                                "text": "Nach ihren Angaben ist der Inhaftierte, der an einer Zirrhose leidet, nach wie vor geschwächt."
                                            },
                                            {
                                                "example_id": "27838fa3-7c94-4729-9f19-82038b59cf31",
                                                "sense_id": "e528a603-9bc0-3a31-9827-22cc625b8a39",
                                                "text": "Penner: \"Handelt es sich um eine unkomplizierte Zirrhose, kann man sie mit Medikamenten ganz gut in den Griff bekommen, ansonsten ist eine Lebertransplantation nicht zu umgehen.\""
                                            },
                                            {
                                                "example_id": "ae3da4f8-cc51-4ed0-919c-4032bc296116",
                                                "sense_id": "e528a603-9bc0-3a31-9827-22cc625b8a39",
                                                "text": "Durch vier bis acht Wochen absolute Abstinenz kann sich die Fettleber wieder zurückbilden. Ansonsten kommt irgendwann eine Entzündung hinzu, bis schließlich nach ein paar Jahren eine Zirrhose die Leber funktionsunfähig macht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c403e41d-37ac-4d79-a93f-4ced90ac3aba",
                        "source_entry_id": "d55c8fff-7c59-3283-83bb-71d0dc2c6621",
                        "source_sense_id": "ef334c44-382b-32a8-9249-8208f490a908",
