            "senses": [
                {
                    "sense_id": "1a39f03a-fe6c-30b9-95fd-28599138e32d",
                    "sense_definition": "Танцевальный вечер для молодёжи с воспроизведением популярной танцевальной музыки, а также место или клуб, где он проводится",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "dance_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "По вечерам в нашем молодёжном клубе проходит шумная танцевальная <w>дискотека</w>.",
                            "target_lang_translations": {
                                "en": "In the evenings, a lively dance <w>disco</w> is held in our youth club."
                            }
                        },
                        {
                            "text": "Мои друзья каждые выходные с радостью собираются пойти на <w>дискотеку</w>.",
                            "target_lang_translations": {
                                "en": "Every weekend, my friends happily get together to go to the <w>disco</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "танцы"
                    ],
                    "common_phrases": [
                        "пойти на дискотеку",
                        "школьная дискотека",
                        "клубная дискотека"
                    ],
                    "target_lang_definitions": {
                        "en": "A dance party for young people playing popular dance music, as well as the venue or club where it is held"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "disco",
                                "target_lang_sense_clarification": "dance party or club"
                            },
                            {
                                "target_lang_word": "discotheque",
                                "target_lang_sense_clarification": "nightclub for dancing, dated"
                            },
                            {
                                "target_lang_word": "dance club",
                                "target_lang_sense_clarification": "venue for dancing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "614a83ef-1a07-3611-9857-b71583a65b76",
                    "sense_definition": "Собрание, систематизированная коллекция звукозаписей на грампластинках или компакт-дисках, а также хранилище для них",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этой библиотеке хранится богатая <w>дискотека</w> классической музыки прошлого века.",
                            "target_lang_translations": {
                                "en": "This library houses a rich <w>record library</w> of classical music from the past century."
                            }
                        },
                        {
                            "text": "Коллекционер с гордостью показал нам свою редкую домашнюю <w>дискотеку</w> виниловых пластинок.",
                            "target_lang_translations": {
                                "en": "The collector proudly showed us his rare home <w>collection</w> of vinyl records."
                            }
                        }
                    ],
                    "synonyms": [
                        "фонотека"
                    ],
                    "common_phrases": [
                        "богатая дискотека",
                        "домашняя дискотека"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "В значении фонотеки или собрания пластинок употребляется редко"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A systematic collection or archive of sound recordings on vinyl records or CDs, or a storage facility for them"
                    },
