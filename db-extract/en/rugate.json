                        "examples": [
                            {
                                "example_id": "98bd1e85-3331-4e2c-bd9e-575c53aafa21",
                                "sense_id": "03b2e6b6-fd4b-3061-b459-2644c7da9159",
                                "text": "Unifacial, superior surface transversely rugate, with minute oririmes at the bottom of the furrows"
                            }
