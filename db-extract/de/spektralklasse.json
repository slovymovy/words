                                        "glosses": [
                                            "A classification of stars depending on their spectra and luminosity; usually one of O, B, A, F, G, K, M."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6af9472f-051e-4f34-adcb-1f84703eeea6",
                                                "sense_id": "6aa03199-ff5a-3b39-a43e-6861eb86565a",
                                                "text": "Maji orbits the Vamshi binary giant stars. Vamshi-A is a blue star of spectral class A4III which burns at half again the temperature of Sol. Vamshi-B is an aging red giant of class M5III, over 220 times the size of Sol."
                                            }
                                        ]
