                ],
                "senses": [
                    {
                        "sense_id": "02a7e07c-0821-3d06-9171-d049d7e65eb9",
                        "entry_id": "f1a4be55-d31e-3459-a40c-c718a4936fd5",
                        "glosses": [
                            "Étriper."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "003f6a20-eb7d-4884-a047-26b329758385",
                                "sense_id": "02a7e07c-0821-3d06-9171-d049d7e65eb9",
                                "text": "Où est-il que je le désentripaille et vous le serve bouilli, en salamis, en chair à pâté, comme vous le voudrez ?"
                            },
                            {
                                "example_id": "fa294642-188b-4124-b5f2-6a7d206cc6a5",
                                "sense_id": "02a7e07c-0821-3d06-9171-d049d7e65eb9",
                                "text": "La chose était à ce point orchestrée que, la nuit où les deux tribus ont failli se désentripailler, un blanc organisait la marche des Laris sur Poto-Poto, et un autre celle des M’Bochis sur Bakongo."
                            },
                            {
                                "example_id": "33423597-0dac-4274-a08e-a29c19fd896a",
                                "sense_id": "02a7e07c-0821-3d06-9171-d049d7e65eb9",
                                "text": "Que Montfleury s’en aille,\nOu bien je l’essorille et le désentripaille !"
                            }
                        ]
                    },
                    {
                        "sense_id": "900783c1-cbb5-33fa-9c4b-0f6385ebeb26",
                        "entry_id": "f1a4be55-d31e-3459-a40c-c718a4936fd5",
                        "glosses": [
                            "Se désorganiser, se disloquer, perdre sa substance, comme un corps qui perd ses viscères."
                        ],
                        "tags": [
                            "figuratively",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "f316a6aa-4d7f-4fbe-a7f0-b1d8920fb06a",
                                "sense_id": "900783c1-cbb5-33fa-9c4b-0f6385ebeb26",
                                "text": "J'ai la vision soudaine, aiguë, d'une France qui perd ses entrailles. … Quel bruit un gouvernant peut-il recevoir de ce pays qui se désentripaille?"
                            }
                        ]
                    }
                ],
