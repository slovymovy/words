                                    {
                                        "sense_id": "a361c3cc-b064-335a-b430-ad3a5a382e88",
                                        "entry_id": "6272d5ad-e8ea-3dbb-8e17-da99afdf83fe",
                                        "glosses": [
                                            "Landschaft in Nordalgerien, in der die Kabylen die Bevölkerungsmehrheit bilden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a458980c-c77f-46a9-b609-fd297a427fba",
                                                "sense_id": "a361c3cc-b064-335a-b430-ad3a5a382e88",
                                                "text": "„Allein nach dem Mokrani-Aufstand in der Kabylei 1872 musste die Bevölkerung 36 Mio. Goldfranken bezahlen, eine halbe Million Hektar Land wurde beschlagnahmt. Hunderte Aufständische wurden hingerichtet, tausende inhaftiert …“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed61d9f6-645a-487e-8809-4017e3440d2b",
                        "source_entry_id": "1b83fcc7-61f6-31aa-9bc5-bea8fa793a08",
                        "source_sense_id": "cd725dff-9975-361e-805d-b68854b67019",
