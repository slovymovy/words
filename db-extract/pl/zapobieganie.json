                    },
                    {
                        "translation_id": "28c5960a-b914-4622-924a-f8b6df0548bb",
                        "source_entry_id": "68776921-a1ed-3f3c-bd14-c6aed44a9c9f",
                        "source_sense_id": "dbfbacd6-f314-3942-b059-648e0442ad12",
                        "target_lang_word": "Vorbeugung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorbeugung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d232e368-f205-32ed-87e7-cfc40b0a58d8",
                                        "entry_id": "04defa83-b667-3e15-8209-317118550f9f",
                                        "glosses": [
                                            "ein vorausschauendes Entgegenwirken, eine rechtzeitige Maßnahme zur Verhinderung von etwas, insbesondere von Krankheiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07a465b2-e38e-495b-9b7f-288615b93e22",
                                                "sense_id": "d232e368-f205-32ed-87e7-cfc40b0a58d8",
                                                "text": "Als Vorbeugung [gegen die Krankheit Beriberi] wird eine abwechslungsreiche Ernährung mit thiaminhaltigen Nahrungsmitteln, wie Hefe, Getreidekeimen, Ei und Leber empfohlen."
                                            },
                                            {
                                                "example_id": "8f8e8a42-e2c3-4a4a-8354-76646d5cab6d",
                                                "sense_id": "d232e368-f205-32ed-87e7-cfc40b0a58d8",
                                                "text": "Bereits vor einigen Jahren haben Forscher getestet, ob AIDS-Medikamente gesunden Menschen zur Vorbeugung einer HIV-Infektion gegeben werden können. Die Wahl fiel damals auf Truvada."
                                            },
                                            {
                                                "example_id": "c3f43a8d-0949-4b47-896e-18d7aad769ff",
