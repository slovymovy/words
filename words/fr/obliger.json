                    ]
                },
                {
                    "sense_id": "47cea19e-cde9-3f12-a288-293e310c5826",
                    "sense_definition": "Rendre service à quelqu'un ou lui faire plaisir par bienveillance et courtoisie.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin accepta d'<w>obliger</w> un ami en se déplaçant tard le soir."
                        },
                        {
