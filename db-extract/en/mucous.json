                                        "sense_id": "1cdf27df-7a82-3d5e-814c-e15a2fbac03f",
                                        "entry_id": "ca740b4e-c6dc-30c4-9e26-c0556cf43f2b",
                                        "glosses": [
                                            "in der Schleimhaut, schleimig, schleimbildend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be1abc0c-467e-4c4b-9cc7-4ed5ad78a278",
                                                "sense_id": "1cdf27df-7a82-3d5e-814c-e15a2fbac03f",
                                                "text": "Hierbei sollte darauf geachtet werden, ob der Schleim nur mukös oder durch einen Infekt stark purulent ist."
                                            },
                                            {
                                                "example_id": "41823b8a-5ffd-4980-bb2c-c129b7edf1be",
                                                "sense_id": "1cdf27df-7a82-3d5e-814c-e15a2fbac03f",
                                                "text": "Je nach sezernierender Drüse ist der dort gebildete Speichel eher serös (wässrig) oder eher mukös (schleimig)."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d6b2b7c-a3cc-4468-bfd1-b2c09f15051c",
                        "source_entry_id": "db9f5ab9-6515-37f9-85b4-408fdf032b59",
                        "source_sense_id": "3f9f4770-4997-3ec4-bea1-29d5b3f61868",
