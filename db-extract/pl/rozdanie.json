                ],
                "senses": [
                    {
                        "sense_id": "9a54d6d0-f94d-33f0-9eb2-a068300bdc7e",
                        "entry_id": "94c27377-fdbe-3b2d-a68b-b1aaecffdb3e",
                        "glosses": [
                            "rzecz. odczas. od rozdać"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04541029-cb2a-4d08-b5c8-912d83c0926c",
                                "sense_id": "9a54d6d0-f94d-33f0-9eb2-a068300bdc7e",
                                "text": "Rozdanie słodyczy przed obiadem było błędem, bo dzieci nie chciały jeść zupy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "ca6e2ae3-9f89-3244-b629-a1aa64c9c4ae",
                        "entry_id": "94c27377-fdbe-3b2d-a68b-b1aaecffdb3e",
                        "glosses": [
                            "uroczystość wręczania nagród konkursowych lub dyplomów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bc2dc98-9620-461b-a4fb-58747b93a00b",
                                "sense_id": "ca6e2ae3-9f89-3244-b629-a1aa64c9c4ae",
                                "text": "Na tegorocznym rozdaniu Oscarów uhonorowano jednego Polaka."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "f5f3f860-5c5b-31d8-9724-c82afc64c45f",
                        "entry_id": "94c27377-fdbe-3b2d-a68b-b1aaecffdb3e",
                        "glosses": [
                            "rozdzielenie stanowisk lub funkcji, zwykle według pewnego klucza"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff78e58a-146b-4005-9b58-183ff38810c1",
                                "sense_id": "f5f3f860-5c5b-31d8-9724-c82afc64c45f",
                                "text": "Po zwycięskich wyborach zawsze przychodzi rozdanie posad między swoich."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "f4f7b6a1-5fc9-3512-9120-56847f3f634a",
                        "entry_id": "94c27377-fdbe-3b2d-a68b-b1aaecffdb3e",
                        "glosses": [
                            "rozdzielenie kart między graczy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "906c970e-d860-42b5-83cb-98c7fb09d9c9",
                                "sense_id": "f4f7b6a1-5fc9-3512-9120-56847f3f634a",
                                "text": "W brydżu, po rozdaniu kart następuje licytacja."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    },
                    {
                        "sense_id": "d33ddcce-50ad-36d8-89c8-bb83cfa9eee1",
                        "entry_id": "94c27377-fdbe-3b2d-a68b-b1aaecffdb3e",
                        "glosses": [
                            "runda gry w karty"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbfdd079-391f-49e3-a04d-ac00d35b4605",
                                "sense_id": "d33ddcce-50ad-36d8-89c8-bb83cfa9eee1",
                                "text": "W tym rozdaniu atu są piki."
                            }
                        ],
                        "sense_index_json": "\"1.5\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e17edd81-4cb6-40e7-87fe-7431e73bad5b",
                        "source_entry_id": "94c27377-fdbe-3b2d-a68b-b1aaecffdb3e",
                        "source_sense_id": "f4f7b6a1-5fc9-3512-9120-56847f3f634a",
                        "target_lang_word": "donne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "donne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a1876ca3-a6d2-3fd7-b10e-6cdc69abb94a",
                                        "entry_id": "0088018d-fe05-3193-8b97-01262c18604f",
                                        "glosses": [
                                            "Action de donner, de distribuer les cartes, dans un jeu de cartes."
                                        ],
                                        "tags": [
                                            "Cartes à jouer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36843452-9a02-41d9-9b5d-b319b3ab7716",
                                                "sense_id": "a1876ca3-a6d2-3fd7-b10e-6cdc69abb94a",
                                                "text": "Lorsque, pendant la donne, il s’établissait de ces nauséabondes dissertations, le chevalier tirait sa tabatière par un geste digne de Molé, regardait la princesse Goritza, levait dignement le couvercle, massait sa prise, la vannait, la lévigeait, la façonnait en talus ; puis, quand les cartes étaient données, il avait garni les antres de son nez et replacé la princesse dans son gilet, toujours à gauche !"
                                            },
                                            {
                                                "example_id": "d4793ec8-7655-4588-9591-dde65c5362f5",
                                                "sense_id": "a1876ca3-a6d2-3fd7-b10e-6cdc69abb94a",
                                                "text": "Bien sûr, la difficulté réside dans le fait que ces signes s'échangent juste après la donne, à un moment où tous les joueurs s’épient, chacun cherchant tout aussi bien à surprendre les signes de ses adversaires qu’à communiquer avec son partenaire sans être vu de ceux-là."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d45dae99-35fe-3d12-a2f1-79fa557dfa06",
                                        "entry_id": "0088018d-fe05-3193-8b97-01262c18604f",
                                        "glosses": [
                                            "Résultat de cette action, cartes dont dispose un joueur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cf3ec64-df27-4929-ab86-847b0bd38c71",
                                                "sense_id": "d45dae99-35fe-3d12-a2f1-79fa557dfa06",
                                                "text": "Le vainqueur est le joueur ayant, à l’issue de sept donnes, le score total le plus élevé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6a60e35-9cd1-3334-84aa-27b57c384874",
                                        "entry_id": "0088018d-fe05-3193-8b97-01262c18604f",
                                        "glosses": [
                                            "Ce dont dispose un individu dans une relation sociale."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3484b7b8-505d-4ec6-9ddf-598701232823",
                                                "sense_id": "b6a60e35-9cd1-3334-84aa-27b57c384874",
                                                "text": "Ah oui, et puis, Biden a récolté sept millions de votes de plus que Trump : ça aussi, ça change la donne."
                                            },
                                            {
                                                "example_id": "503d60ea-6357-4d3d-a5c6-33150814bae5",
                                                "sense_id": "b6a60e35-9cd1-3334-84aa-27b57c384874",
                                                "text": "De fait, avec l'hypothèse d'un virus dormant chez certains survivants, la donne change en matière de santé publique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "donne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a72c4ac-b7a3-3433-a372-6c21c2a1ab1f",
                                        "entry_id": "eb36e74c-a9a2-3fbc-a2da-d7f612005ddb",
                                        "glosses": [
                                            "Première personne du singulier du présent de l’indicatif de donner."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed614517-5b08-4899-ad5c-6474a2eb01b1",
                                                "sense_id": "7a72c4ac-b7a3-3433-a372-6c21c2a1ab1f",
                                                "text": "« Je vous donne l’ordre de boucler ce porte-poisse », a-t-il dit."
                                            },
                                            {
                                                "example_id": "4933f47f-b4a7-41d0-9240-862733f88091",
                                                "sense_id": "7a72c4ac-b7a3-3433-a372-6c21c2a1ab1f",
                                                "text": "Malgré les dettes payées, malgré la différence d’âge, malgré la poésie, après neuf mois d’une noble défense et sans lui avoir permis de baiser ma main, après les plus chastes et les plus délicieuses amours, dans quelques jours, je ne me livre pas, comme il y a huit ans, inexpériente, ignorante et curieuse ; je me donne, et je suis attendue avec une si grande soumission, que je pourrais ajourner mon mariage à un an ; mais il n’y a pas la moindre servilité dans ceci : il y a servage et non soumission."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30491be8-1132-3143-beef-b67365c76fa8",
                                        "entry_id": "eb36e74c-a9a2-3fbc-a2da-d7f612005ddb",
                                        "glosses": [
                                            "Troisième personne du singulier du présent de l’indicatif de donner."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da9102f7-5e55-4c72-90ec-abaeaa6538b5",
                                                "sense_id": "30491be8-1132-3143-beef-b67365c76fa8",
                                                "text": "Son séjour se termina à Beauté-sur-Marne ; Charles IV en fut si enchanté qu’il s’y déclara guéri de sa goutte ; on y fit de somptueux échanges de cadeaux : coupes d’or garnies de pierreries et d’émaux champlevés, flacons, aiguières, hanaps d’or et gobelets ; jusqu’au moment où, à la veille de se faire leurs adieux, l’empereur donne au roi un rubis et un diamant tandis que le roi lui-même lui offre un diamant qu’il portait « et devant tous s’entraccolèrent et baisèrent à grands remerciements »."
                                            },
                                            {
                                                "example_id": "00b552a7-b489-4f2c-8e0c-7a9a29a90490",
                                                "sense_id": "30491be8-1132-3143-beef-b67365c76fa8",
                                                "text": "Autonomie et automatisme, autonomie mais automatisme de cette table de bois qui se donne spontanément son mouvement, certes, et semble ainsi s'animer, s’animaliser, se spiritualiser, se spiritiser, mais tout en restant un corps artefactuel, une sorte d’automate, une figurante, une poupée mécanique et raide dont la danse obéit à la rigidité technique d’un programme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cc11c7d-649a-3de6-b56c-838c2d857690",
                                        "entry_id": "eb36e74c-a9a2-3fbc-a2da-d7f612005ddb",
                                        "glosses": [
                                            "Première personne du singulier du présent du subjonctif de donner."
                                        ],
                                        "tags": [
