                    {
                        "sense_id": "36d0ba9a-a585-3173-b273-61f6844bd22f",
                        "entry_id": "1bac4a17-9a51-3704-895b-18a8210c42b3",
                        "glosses": [
                            "Bevölkerungsgruppe von hochgradig diverser kultureller und ethnischer Zusammensetzung im südlichen Afrika"
                        ],
                        "tags": [
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "dbd6445a-f6d8-4be9-bc6e-eea1103110e9",
                                "sense_id": "36d0ba9a-a585-3173-b273-61f6844bd22f",
                                "text": "„Bereits in seinen Jugendjahren hatte er tiefen Abscheu vor Rassenvermischung und Zusammenwohnen von Weißen und Coloureds im selben Stadtviertel zu erkennen gegeben.“"
                            },
                            {
                                "example_id": "4be16721-6a6a-44f4-894e-c39a06dac0eb",
                                "sense_id": "36d0ba9a-a585-3173-b273-61f6844bd22f",
                                "text": "„›Ich werd verrückt... Aldri? Was ist das denn für ein Name, Aldri? Weißt du, wir Coloureds sprechen vielleicht kein Hochafrikaans, aber ihr Weißen kommt vielleicht auf affige Namen! Wie sollen wir denn bei den Anwälten vorgehen?‹“"
                            }
                        ],
