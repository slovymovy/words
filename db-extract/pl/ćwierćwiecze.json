                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "cec6ffc3-f825-4a52-bb3e-f7f0e98391f2",
                                "sense_id": "6f3f8236-caf6-3f03-b2ba-e129089c42c1",
                                "text": "Najstarsza szkoła tańca we Włocławku i jedna z pierwszych w regionie obchodzi w tym roku ćwierćwiecze istnienia."
                            }
