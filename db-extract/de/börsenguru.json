                "senses": [
                    {
                        "sense_id": "6f56e6e8-55f4-3283-b075-4fb1ddef99f2",
                        "entry_id": "0843ee48-b3cd-3a7c-bab3-2975e3aa67a1",
                        "glosses": [
                            "Person, die als Experte im Börsenwesen anerkannt wird"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "451cd9b0-6cfa-4ed0-8ad0-f03ec635f576",
                                "sense_id": "6f56e6e8-55f4-3283-b075-4fb1ddef99f2",
                                "text": "„Warum Jean-Claude Trichet viel Positives hinterlässt und was der neue EZB-Chef zu bewerkstelligen hat, erklärt Börsenguru Heiko Thieme.“"
                            },
                            {
                                "example_id": "93430d44-471d-40a6-abae-ee913cd4e0e0",
                                "sense_id": "6f56e6e8-55f4-3283-b075-4fb1ddef99f2",
                                "text": "„Nun hat das Landgericht Frankfurt den ehemaligen Börsenguru des Senders N24 wegen der Manipulation von Aktienkursen zu zwei Jahren und sieben Monaten Haft verurteilt worden.“"
                            },
                            {
                                "example_id": "b0c61210-7b81-4444-8a5a-7cedd4d8b22c",
                                "sense_id": "6f56e6e8-55f4-3283-b075-4fb1ddef99f2",
                                "text": "„Sein Glatzkopf ist ein Markenzeichen: Mark Mobius (81) ist Börsenguru, Pionier der Investments in Schwellenländern und ehemaliger Executive Chairman der Fondsgesellschaft Franklin Templeton.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
