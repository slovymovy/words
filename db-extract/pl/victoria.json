                                    },
                                    {
                                        "sense_id": "c9d09392-2107-3568-95d6-9f1cc94e70c9",
                                        "entry_id": "455a84eb-114a-3fd2-8d16-ecd794692622",
                                        "glosses": [
                                            "A female given name from Latin."
                                        ],
                                        "tags": [
