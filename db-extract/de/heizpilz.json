                ],
                "senses": [
                    {
                        "sense_id": "31ad4124-b610-3972-b1f4-295b2b1a254c",
                        "entry_id": "d57a1d36-3a2e-3848-b2f7-30a5476d041f",
                        "glosses": [
                            "elektrische Heizvorrichtung, die vom Prinzip her wie eine Herdplatte arbeitet und die für Rundkolben eine passende Mulde hat, die den Kolben unten (an der zu beheizenden Stelle) umfasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65a41e25-afb8-485d-bbcc-94a4d25291fb",
                                "sense_id": "31ad4124-b610-3972-b1f4-295b2b1a254c",
                                "text": "Im Heizpilz langsam auf 40 °C erhitzen"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5841efd5-647b-3b85-be77-0ed9cafee909",
                        "entry_id": "d57a1d36-3a2e-3848-b2f7-30a5476d041f",
                        "glosses": [
                            "pilzförmiger, gasbetriebener Heizstrahler zur Verwendung im Freien"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "8b2b21a0-ffa6-47e8-a7d1-5f7f3e3e82f6",
                                "sense_id": "5841efd5-647b-3b85-be77-0ed9cafee909",
                                "text": "„Heizpilze blasen große Mengen Kohlendioxid in die Atmosphäre.“"
                            },
                            {
                                "example_id": "c3c2e12e-b12c-43b1-9bfe-f4b34e3f44de",
                                "sense_id": "5841efd5-647b-3b85-be77-0ed9cafee909",
                                "text": "„Es ist die Zeit im Jahr, da die Heizpilze den Sommer verlängern.“"
                            },
                            {
                                "example_id": "258db2c6-a7e4-4698-a352-23aeffbd6e4e",
                                "sense_id": "5841efd5-647b-3b85-be77-0ed9cafee909",
                                "text": "„Drei Frauen mit Weihnachtsmannmützen auf dem Kopf und Sektgläsern in der Hand, die schwatzend vor einer Boutique um einen Heizpilz herumstanden, verstummten, als wir an ihnen vorbeigingen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
