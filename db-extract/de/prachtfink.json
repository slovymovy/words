                        "examples": [
                            {
                                "example_id": "75987312-1e5b-481b-84bf-73423922116c",
                                "sense_id": "797f6050-01fc-350d-96ef-04f8daab7287",
                                "text": "Prachtfinken sind erstaunlich farbenprächtig und hoch sozial."
                            },
                            {
                                "example_id": "fa0a7222-58e5-419e-860d-90f319dc0454",
                                "sense_id": "797f6050-01fc-350d-96ef-04f8daab7287",
                                "text": "Prachtfinken zählen zu den beliebtesten Ziervögeln."
                            },
                            {
                                "example_id": "784ce1b8-5c7d-41fe-8f71-8a1ed1ba6c8e",
                                "sense_id": "797f6050-01fc-350d-96ef-04f8daab7287",
                                "text": "„Und tatsächlich, wie an den vergangenen beiden Tagen näherte sich der Prachtfink mit den langsamen, für die Spezies charakteristischen schleifenden Beinbewegungen seinem bevorzugten Platz.“"
                            }
                        ],
