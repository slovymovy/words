                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scheme",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00551144-438b-30b2-aa0d-b9ffcaecb262",
                                        "entry_id": "e8833800-26f7-35ba-9218-757ded76e7c9",
                                        "glosses": [
                                            "An artful deviation from the ordinary arrangement of words."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rhetoric"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "88955ba4-ecb7-3b1e-8d07-22c3ea9f63c5",
                                        "entry_id": "e8833800-26f7-35ba-9218-757ded76e7c9",
                                        "glosses": [
                                            "A representation of the aspects of the celestial bodies for any moment or at a given event."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f393761f-5a59-4d11-8fdf-5b232acafe7c",
                                                "sense_id": "88955ba4-ecb7-3b1e-8d07-22c3ea9f63c5",
                                                "text": "a blue case, from which was drawn a scheme of nativity"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0607760-a43f-3f3e-82d3-d28d46e42fe3",
                                        "entry_id": "e8833800-26f7-35ba-9218-757ded76e7c9",
                                        "glosses": [
                                            "A systematic plan of future action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf692add-4ace-49a6-86a3-c0bc18862576",
                                                "sense_id": "e0607760-a43f-3f3e-82d3-d28d46e42fe3",
                                                "text": "The stoical scheme of supplying our wants by lopping off our desires, is like cutting off our feet when we want shoes."
                                            },
                                            {
                                                "example_id": "484de677-7c92-4a43-b9b6-c1f637ce5679",
                                                "sense_id": "e0607760-a43f-3f3e-82d3-d28d46e42fe3",
                                                "text": "A “moving platform” scheme[…]is more technologically ambitious than maglev trains even though it relies on conventional rails. Local trains would use side-by-side rails to roll alongside intercity trains and allow passengers to switch trains by stepping through docking bays. This set-up solves several problems […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "818414d0-3810-3da5-b645-10d73c2357ed",
                                        "entry_id": "e8833800-26f7-35ba-9218-757ded76e7c9",
                                        "glosses": [
                                            "A plot or secret, devious plan."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "797bd4c3-9d4d-357c-9dee-28b12393570d",
                                        "entry_id": "e8833800-26f7-35ba-9218-757ded76e7c9",
                                        "glosses": [
                                            "An orderly combination of related parts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9934317c-de86-4bb4-a9ab-05fd0a6457ca",
                                                "sense_id": "797bd4c3-9d4d-357c-9dee-28b12393570d",
                                                "text": "the appearance and outward scheme of things"
                                            },
                                            {
                                                "example_id": "6f2a93e1-8c67-4ff2-94d2-42133ebb1ad9",
                                                "sense_id": "797bd4c3-9d4d-357c-9dee-28b12393570d",
                                                "text": "such a scheme of things as shall at once take in time and eternity"
                                            },
                                            {
                                                "example_id": "4d3790ea-fcc2-4006-aef3-eed64c45ea00",
                                                "sense_id": "797bd4c3-9d4d-357c-9dee-28b12393570d",
                                                "text": "arguments […] sufficient to support and demonstrate a whole scheme of moral philosophy"
                                            },
                                            {
                                                "example_id": "7f1ece89-0642-48a9-ada8-7ed90d6a80ef",
                                                "sense_id": "797bd4c3-9d4d-357c-9dee-28b12393570d",
                                                "text": "The Revolution came and changed his whole scheme of life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43a2762f-f82b-34e4-b1d9-759dacb18d99",
                                        "entry_id": "e8833800-26f7-35ba-9218-757ded76e7c9",
                                        "glosses": [
                                            "A chart or diagram of a system or object."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95bd6f60-513c-45c8-9b9d-a1cb00584047",
                                                "sense_id": "43a2762f-f82b-34e4-b1d9-759dacb18d99",
                                                "text": "April 29, 1694, Robert South, A Sermon Preached at Westminster Abbey\nto draw an exact scheme of Constantinople, or a map of France"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bbf9b84-d7ea-3814-88fb-eb2f1e4a2a38",
                                        "entry_id": "e8833800-26f7-35ba-9218-757ded76e7c9",
                                        "glosses": [
                                            "A mathematical structure that generalizes the notion of an algebraic variety in several ways, such as taking account of multiplicities and allowing \\\"varieties\\\" defined over any commutative ring. Formally, a locally ringed space that admits a covering by open sets, each of which is isomorphic to an affine scheme (i.e. the spectrum of some commutative ring)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92d149a1-c657-3d7d-8637-fea64b1ecdfc",
                                        "entry_id": "e8833800-26f7-35ba-9218-757ded76e7c9",
                                        "glosses": [
                                            "A council housing estate."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "UK",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73d092ec-07d8-40d3-849d-f2586f269857",
                                                "sense_id": "92d149a1-c657-3d7d-8637-fea64b1ecdfc",
                                                "text": "It was all too dear. They all just put their prices up because it was out in the scheme."
                                            },
                                            {
                                                "example_id": "bed1de94-0695-4d21-bc7c-3186495a561b",
                                                "sense_id": "92d149a1-c657-3d7d-8637-fea64b1ecdfc",
                                                "text": "“You can’t really say to the kids in the schemes [Scottish council estates]^([sic]): don’t do drugs, they’ll wreck your life, you’ll never get a job or a house or buy nice things.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bad2469-1adb-3c04-af1b-dd702f557fab",
                                        "entry_id": "e8833800-26f7-35ba-9218-757ded76e7c9",
