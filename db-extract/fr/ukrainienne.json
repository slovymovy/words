                "senses": [
                    {
                        "sense_id": "4aeda65a-b80d-3d42-8fda-5f460cf8055f",
                        "entry_id": "2daf930d-82f8-3138-8074-e00f4e000069",
                        "glosses": [
                            "Femme habitant en Ukraine ou qui en est originaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb8fb895-ee25-4d09-9d2c-aa6fa8bbeffa",
                                "sense_id": "4aeda65a-b80d-3d42-8fda-5f460cf8055f",
                                "text": "Bol (22 ans), médaillée de bronze olympique du 400 m haies l’été dernier et récente vice-championne du monde de la spécialité, s’est imposée en 52 sec 67 dans sa course de prédilection, largement devant deux Ukrainiennes Viktoriya Tkachuk (54.30) et Anna Ryzhykova (54.86)."
                            },
                            {
                                "example_id": "ed8c7937-21a2-4ebd-aabe-69372db21408",
                                "sense_id": "4aeda65a-b80d-3d42-8fda-5f460cf8055f",
                                "text": "Elle rêve de remporter son huitième titre en simple face à la 108ᵉ joueuse mondiale, tombeuse de l’Ukrainienne Kateryna Baindl (7-5, 7-5), samedi, sur la terre battue japonaise."
                            },
                            {
                                "example_id": "987650c7-e194-4512-8043-50716312d927",
                                "sense_id": "4aeda65a-b80d-3d42-8fda-5f460cf8055f",
                                "text": "Les sentiments sont mitigés, glisse Anna Ekvist, une Ukrainienne engagée dans le centre communautaire."
                            }
                        ]
                    }
                ],
