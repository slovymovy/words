                        "examples": [
                            {
                                "example_id": "dd25f523-c0ea-490e-8760-2dd0b40b1f80",
                                "sense_id": "c2669c11-8b94-305c-b3e2-e834c11929b3",
                                "text": "But notwithstanding he has fore-answered from the nature of things all that he can say about different interpretations, yet he proceeds in twenty tedious pages to enumerate those differences, which lie ranges under twelve heads; [...]"
                            },
                            {
                                "example_id": "49dc7a86-4612-4660-b11e-fff222621ebc",
                                "sense_id": "c2669c11-8b94-305c-b3e2-e834c11929b3",
                                "text": "It seemed a little severe to be shut away from her now but Mrs. Fuller's manner had fore-answered any appeal and I held my peace."
                            },
                            {
                                "example_id": "54727a14-8eae-446a-ac36-e5960d175758",
                                "sense_id": "c2669c11-8b94-305c-b3e2-e834c11929b3",
                                "text": "[...] and whether that buying public can really be increased to the extent hoped for by the dollar-book publishers is a question that cannot easily be foreanswered."
                            },
                            {
                                "example_id": "dec58964-fc7f-4b49-a04a-d275672a04ec",
                                "sense_id": "c2669c11-8b94-305c-b3e2-e834c11929b3",
                                "text": "\"Moby Dick\" was in the press as news of the Ann Alexander's disaster travelled round the world, providing testimony well calculated to conspire with the publishers of that now famous book, and to foreanswer and confound the author's critics of whom there were not a few."
                            }
