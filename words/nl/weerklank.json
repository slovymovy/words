{
    "word_family": [
        "weerkaatsen",
        "klank",
        "klinken"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "60d5831f-82b1-3ad0-b58b-51306451ecfb",
                    "sense_definition": "Een instemmende of positieve reactie op een voorstel, idee of mening.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijke_weerklank",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn innovatieve voorstel vond veel <w>weerklank</w> binnen de directie van het bedrijf.",
                            "target_lang_translations": {
                                "en": "His innovative proposal found a lot of <w>resonance</w> within the company's board of directors."
                            }
                        },
                        {
                            "text": "De nieuwe milieumaatregelen vonden weinig <w>weerklank</w> bij de lokale bevolking.",
                            "target_lang_translations": {
                                "en": "The new environmental measures found little <w>response</w> among the local population."
                            }
                        }
                    ],
                    "common_phrases": [
                        "weerklank vinden"
                    ],
                    "target_lang_definitions": {
                        "en": "An approving or positive response to a proposal, idea, or opinion."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "resonance",
                                "target_lang_sense_clarification": "figurative, finding agreement or sympathy"
                            },
                            {
                                "target_lang_word": "response",
                                "target_lang_sense_clarification": "reaction to an idea or proposal"
                            },
                            {
                                "target_lang_word": "echo",
                                "target_lang_sense_clarification": "figurative, positive reception or agreement"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b94ce806-ddcf-3304-a476-a814c64b921b",
                    "sense_definition": "Het teruggekaatste geluid dat men hoort nadat het oorspronkelijke geluid is gestopt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "letterlijke_weerklank",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de lege kathedraal hoorden we de <w>weerklank</w> van onze eigen voetstappen.",
                            "target_lang_translations": {
                                "en": "In the empty cathedral, we heard the <w>echo</w> of our own footsteps."
                            }
                        },
                        {
                            "text": "De luide <w>weerklank</w> van de donderslag rolde door het diepe dal.",
                            "target_lang_translations": {
                                "en": "The loud <w>reverberation</w> of the thunderclap rolled through the deep valley."
                            }
                        }
                    ],
                    "synonyms": [
                        "echo",
                        "nagalm"
                    ],
                    "common_phrases": [
                        "luide weerklank"
                    ],
                    "target_lang_definitions": {
                        "en": "The reflected sound heard after the original sound has stopped."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "echo",
                                "target_lang_sense_clarification": "reflected sound"
                            },
                            {
                                "target_lang_word": "reverberation",
                                "target_lang_sense_clarification": "prolongation of a sound, resonance"
                            },
                            {
                                "target_lang_word": "resonance",
                                "target_lang_sense_clarification": "literal, acoustic quality of echoing"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}