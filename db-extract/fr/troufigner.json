                "senses": [
                    {
                        "sense_id": "3c503928-f24f-3ff3-9f0d-c09d7291ca1f",
                        "entry_id": "3430f422-83c0-3f7b-a8c5-20d2f3e21b7d",
                        "glosses": [
                            "Enculer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a5064a5-49d1-4ca7-877c-42ab02b5d1a0",
                                "sense_id": "3c503928-f24f-3ff3-9f0d-c09d7291ca1f",
                                "text": "Ah! j'en prenais pour mon grade! où que j'avais été troufigner?"
                            },
                            {
                                "example_id": "ec712745-da73-466d-9f7c-d2290990858d",
                                "sense_id": "3c503928-f24f-3ff3-9f0d-c09d7291ca1f",
                                "text": "Un conseil, fais comme moi : va troufigner les merlus au Pérou !"
                            },
                            {
                                "example_id": "658ee490-b9cf-4d00-a5fc-3cca317d68cc",
                                "sense_id": "3c503928-f24f-3ff3-9f0d-c09d7291ca1f",
                                "text": "En plus utiliser TOR à tor ^([sic : tort]) et à travers, ça peut conduire à se faire troufigner la tronche"
                            },
                            {
                                "example_id": "02a46619-4a0c-4061-b7b9-d22f159eb3f2",
                                "sense_id": "3c503928-f24f-3ff3-9f0d-c09d7291ca1f",
                                "text": "Retrouver un job pour enfin ne pas me faire troufigner la rondelle, et si tel est le cas, emmerder le gars au maximum."
                            }
                        ]
                    }
