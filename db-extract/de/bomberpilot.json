                "senses": [
                    {
                        "sense_id": "379294e0-5257-35ef-8249-b94be8845eda",
                        "entry_id": "7b12a6a9-5292-3163-a976-b9a0f1411e24",
                        "glosses": [
                            "Person, die einen Bomber steuert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a5c8b80-a672-4f25-8541-8abb03231903",
                                "sense_id": "379294e0-5257-35ef-8249-b94be8845eda",
                                "text": "Wegen der Schlechtwetterfront verfehlte der Bomberpilot das Zielgebiet."
                            },
                            {
                                "example_id": "f098d8e5-de01-4d7c-a4a6-173b5ab0e79e",
                                "sense_id": "379294e0-5257-35ef-8249-b94be8845eda",
                                "text": "„Der ehemalige Bomberpilot de Winne hatte auf dem elftägigen Flug zur ISS vor allem als Computerspezialist Eindruck gemacht.“"
                            },
                            {
                                "example_id": "0e35434e-a8f4-457a-b869-652d953845ba",
                                "sense_id": "379294e0-5257-35ef-8249-b94be8845eda",
                                "text": "„Der dreißigjährige Oberst Paul W. Tibbets, Sohn eines Süßwaren-Großhändlers aus Florida, galt als bester Bomberpilot der Air Force.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
