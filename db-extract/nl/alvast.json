                                            {
                                                "example_id": "1350a619-02d2-46a0-98ca-bfca4d8be38e",
                                                "sense_id": "9b4db66e-d50f-316f-88e3-802bfaea91c3",
                                                "text": "Hast du das Geld gestohlen? — Schon."
                                            },
                                            {
                                                "example_id": "1ff78ef8-116a-44d3-833f-c1b05fdbae3e",
                                                "sense_id": "9b4db66e-d50f-316f-88e3-802bfaea91c3",
                                                "text": "Bist du zufrieden mit dem neuen Rad? — Schon, nur mit der Bremse komme ich nicht zurecht."
