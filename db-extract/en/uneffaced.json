                                "example_id": "525f3d64-a625-4316-9cb5-51f721c61f9b",
                                "sense_id": "8dbb1156-784f-399f-9bc3-929a5f54becd",
                                "text": "If there is any truth in the old adage that a burnt child dreads the fire, I ought to be very loath to touch a sermon, while the memory of what befell me on a recent occasion, possibly not yet forgotten by the readers of the Nineteenth Century, is uneffaced."
                            }
