        "fr-extract.jsonl": [
            {
                "entry_id": "d917ce79-2102-370f-a185-b8db7652032a",
                "word": "spontanéité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d23eb897-5716-40a1-b5a8-8e01b8bd85b4",
                        "entry_id": "d917ce79-2102-370f-a185-b8db7652032a",
                        "tags": [
                            "plural"
                        ],
                        "form": "spontanéités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ede0e5ab-7953-3770-add9-c8d766bf7794",
                        "entry_id": "d917ce79-2102-370f-a185-b8db7652032a",
                        "glosses": [
                            "Caractère de ce qui est spontané."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1af2ce4f-234a-49ae-94d5-6a12e0aeee6d",
                                "sense_id": "ede0e5ab-7953-3770-add9-c8d766bf7794",
                                "text": "Zaheira, à la dérobée, la regardait. Elle la trouvait belle et savante dans sa toilette et ses gestes calculés dans leur spontanéité même."
                            },
                            {
                                "example_id": "60469c97-0782-4bce-97e0-6ad4e82e56e2",
                                "sense_id": "ede0e5ab-7953-3770-add9-c8d766bf7794",
                                "text": "Le Sapin (Abies pectinata) se rencontre aussi en Normandie ; sa spontanéité paraît certaine."
                            },
                            {
                                "example_id": "55c70003-370e-477e-958c-74435c8e8208",
                                "sense_id": "ede0e5ab-7953-3770-add9-c8d766bf7794",
                                "text": "Dans le passage de l’oral à l’écrit, la spécificité du messager s'efface derrière celle du message. Peut-être y perd-on en spontanéité, mais on y gagne en cohérence, celle précisément d'une forme littéraire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1bbf01ea-76ad-46d5-98e4-52a126fb4f50",
                        "source_entry_id": "d917ce79-2102-370f-a185-b8db7652032a",
                        "source_sense_id": "ede0e5ab-7953-3770-add9-c8d766bf7794",
                        "target_lang_word": "Spontanität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spontanität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ab15538-3494-3eb5-a164-6f9c9ff7df3b",
                                        "entry_id": "b72f422f-9196-32a8-bc1c-818cf3dac1dc",
                                        "glosses": [
                                            "positive Unkompliziertheit, Agieren ohne präzise Planung, emotionales Handeln, aber eventuell auch Unzuverlässigkeit, Unvorhersehbarkeit"
                                        ],
                                        "tags": [
                                            "Charaktereigenschaft",
                                            "selten im Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "699c8a2f-c233-4a13-ae38-7643d5d8bbf3",
                                                "sense_id": "5ab15538-3494-3eb5-a164-6f9c9ff7df3b",
                                                "text": "„Doch war die Begeisterung nur ein Abklatsch des Vorjahres, die Spontanität fehlte, alles erschien zu gut organisiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b9f30eb-a79f-4589-9bb1-cd58bd42dea3",
                        "source_entry_id": "d917ce79-2102-370f-a185-b8db7652032a",
                        "source_sense_id": "ede0e5ab-7953-3770-add9-c8d766bf7794",
                        "target_lang_word": "spontaneity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spontaneity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eecb637a-7e4e-33fd-a8a3-c45b93880ca6",
                                        "entry_id": "6ff4b442-6bab-3184-9658-0fdb08bb7472",
                                        "glosses": [
                                            "The quality of being spontaneous."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19ec6393-f170-430a-b1d2-b45bf394cf26",
                                                "sense_id": "eecb637a-7e4e-33fd-a8a3-c45b93880ca6",
                                                "text": "In any case, they are not very big on spontaneity. They sit on him for a few minutes before they decide what to do next."
                                            },
                                            {
                                                "example_id": "dd30dfa0-48c0-4db6-b05a-0367a230e738",
                                                "sense_id": "eecb637a-7e4e-33fd-a8a3-c45b93880ca6",
                                                "text": "The unpredictability of Gemini was then contrasted with examples of human spontaneity, like the splatter technique of Jackson Pollock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d151cfe6-1ef2-33c5-a01d-dfb0cbec8e8a",
                                        "entry_id": "6ff4b442-6bab-3184-9658-0fdb08bb7472",
                                        "glosses": [
                                            "Spontaneous behaviour."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3391fea5-9144-477f-a1d6-6f2745c6ef47",
                                                "sense_id": "d151cfe6-1ef2-33c5-a01d-dfb0cbec8e8a",
                                                "text": "Romney Leigh, who lives by diagrams, / And crosses out the spontaneities / Of all his individual, personal life / With formal universals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9015aa2c-f923-3218-92e5-26bec780b9c9",
                                        "entry_id": "6ff4b442-6bab-3184-9658-0fdb08bb7472",
                                        "glosses": [
                                            "The tendency to undergo change, characteristic of both animal and vegetable organisms, and not restrained or checked by the environment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4bb8df04-927a-34ab-8eee-73a09bd33852",
                                        "entry_id": "6ff4b442-6bab-3184-9658-0fdb08bb7472",
                                        "glosses": [
                                            "The tendency to activity of muscular tissue, including the voluntary muscles, when in a state of healthful vigour and refreshment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
