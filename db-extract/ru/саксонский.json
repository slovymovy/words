                "translations": [
                    {
                        "translation_id": "c0938668-7671-47cc-9ab1-7f27942e8ad2",
                        "source_entry_id": "ec0856a6-6a69-33fc-b394-5120556fcee9",
                        "target_lang_word": "sächsisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sächsisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3454ec50-d069-3e30-9f32-d55c23e1ae99",
                                        "entry_id": "c3c17da0-3297-34d7-a973-fd57ca1ad439",
                                        "glosses": [
                                            "auf das Bundesland, den Freistaat Sachsen bezogen, zu diesem Bundesland gehörig, dieses Bundesland betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba3e7119-f9a8-47dd-bd19-268c36f763af",
                                                "sense_id": "3454ec50-d069-3e30-9f32-d55c23e1ae99",
                                                "text": "Zu den bekannten sächsischen Landschaften gehört die Sächsische Schweiz."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "45eb891e-19ea-3d59-b0e9-4f8293a703f6",
                                        "entry_id": "c3c17da0-3297-34d7-a973-fd57ca1ad439",
                                        "glosses": [
                                            "auf die Bewohner des Bundeslandes, des Freistaates Sachsen bezogen, diese Bewohner betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f9d8ed9-fdaa-4aaf-9d4a-4db58d94c664",
                                                "sense_id": "45eb891e-19ea-3d59-b0e9-4f8293a703f6",
                                                "text": "Einige sächsische Abgeordnete gehören zur Volksgruppe der Sorben."
                                            },
                                            {
                                                "example_id": "ca65aeba-c6ce-4fb1-a878-a812d1df0aaa",
                                                "sense_id": "45eb891e-19ea-3d59-b0e9-4f8293a703f6",
                                                "text": "„Daß Mensch und Natur sehr wohl miteinander auskommen können, haben die sächsischen Freikletterer seit über 130 Jahren bewiesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "046fd2bd-c146-3e87-b257-dfb308ffc763",
                                        "entry_id": "c3c17da0-3297-34d7-a973-fd57ca1ad439",
                                        "glosses": [
                                            "auf die historischen Territorien, die die Bezeichnung Sachsen als Teil ihres Eigennamens trugen, bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35f7a895-8344-4d10-b7c8-b678f6d00f2d",
                                                "sense_id": "046fd2bd-c146-3e87-b257-dfb308ffc763",
                                                "text": "Die sächsische Architektur umfasst mehrere Jahrhunderte Kulturgeschichte."
                                            },
                                            {
                                                "example_id": "8370faff-0b28-42e8-8775-6a3f9c3b3397",
                                                "sense_id": "046fd2bd-c146-3e87-b257-dfb308ffc763",
                                                "text": "„Im sächsischen Staat gab es von 1678 bis 1816 zwei Oberpostämter, eines in Leipzig und eines in Bautzen (Budissin).“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "010c0794-9e39-3d93-995c-35f32e8ee4e9",
                                        "entry_id": "c3c17da0-3297-34d7-a973-fd57ca1ad439",
                                        "glosses": [
                                            "auf die Bewohner von ^([3]) bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3266d4b3-3405-4844-b1f8-af9aa90c366a",
                                                "sense_id": "010c0794-9e39-3d93-995c-35f32e8ee4e9",
                                                "text": "Die sächsischen Gestade beginnen bei Cuxhaven und enden bei Coburg und Zittau."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "6cb6df22-ad62-3675-8afc-330810c4ef03",
                                        "entry_id": "c3c17da0-3297-34d7-a973-fd57ca1ad439",
                                        "glosses": [
                                            "auf den germanischen Stamm der Sachsen bezogen, zu diesem gehörig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4617e2c-5782-41fb-b6bb-62d1163849a2",
                                                "sense_id": "6cb6df22-ad62-3675-8afc-330810c4ef03",
                                                "text": "„Immer wieder waren fränkische Heere über die Jahre hinweg nach Sachsen eingedrungen, hatten das Land verheert, die Heiligtümer zerstört, die sächsischen Burgen gebrochen und Zwingburgen an ihre Stelle gesetzt.“"
                                            },
                                            {
                                                "example_id": "66125198-3645-420b-8b88-ce5188179beb",
                                                "sense_id": "6cb6df22-ad62-3675-8afc-330810c4ef03",
                                                "text": "„Die Insellage verschonte die Bewohner Britanniens von Einfällen von außen, obwohl es bereits in dieser Zeit vereinzelte Angriffe fränkischer und sächsischer Verbände gab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "c946fb47-91f6-36a5-96a1-d11e25049c4d",
                                        "entry_id": "c3c17da0-3297-34d7-a973-fd57ca1ad439",
                                        "glosses": [
                                            "Sächsisch die thüringisch-obersächsische Umgangssprache, den thüringisch-obersächsischen Dialekt betreffend, zu diesem gehörig, in der Art und Weise dieser Umgangssprache und dieses Dialektes"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "157fa0eb-3826-48a2-bd89-e488a55362ad",
                                                "sense_id": "c946fb47-91f6-36a5-96a1-d11e25049c4d",
                                                "text": "„Trommel-Meier und Knecht Stolten traten näher und grinsten Kurt Marenke an, der ostpreußisch, berlinerisch, sächsisch und thüringisch durcheinandersprach, wie es die Zeiten so mit sich gebracht hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
