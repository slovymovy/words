                "senses": [
                    {
                        "sense_id": "02e69f34-2f7e-3217-a06b-c7f37ab77409",
                        "entry_id": "8d0586b3-2901-30cc-a49f-83ff6dc64f2f",
                        "glosses": [
                            "gw. (Poznań) człowiek z marginesu, menel, lump, żul, kloszard"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe9adba8-ee08-4c93-89b8-55894c36ca42",
                                "sense_id": "02e69f34-2f7e-3217-a06b-c7f37ab77409",
                                "text": "Nachlany jakiś pener tam się został leżeć, czy jak?"
                            },
                            {
                                "example_id": "fc53f514-e14d-450d-b509-4df9c14763df",
                                "sense_id": "02e69f34-2f7e-3217-a06b-c7f37ab77409",
                                "text": "Znalazł tam na Ratajach, na tym osiedlu po drugiej stronie Warty (…) jakiegoś penera. Takiego gościa, co to łazi po osiedlu, zbiera flaszki i makulaturę po śmietnikach i śpi gdzie popadnie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
