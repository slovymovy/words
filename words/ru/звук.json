    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "547f8fbc-3b12-3322-811a-5c7a6bf2481d",
                    "sense_definition": "Физическое явление, воспринимаемое слухом.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "физическое_явление",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Громкий <w>звук</w> разбудил ребёнка.",
                            "target_lang_translations": {
                                "en": "A loud <w>sound</w> woke the child."
                            }
                        },
                        {
                            "text": "Я услышал странный <w>звук</w> за дверью своей квартиры.",
                            "target_lang_translations": {
                                "en": "I heard a strange <w>sound</w> behind the door of my apartment."
                            }
                        }
                    ],
                    "antonyms": [
                        "тишина"
                    ],
                    "common_phrases": [
                        "громкий звук",
                        "резкий звук"
                    ],
                    "target_lang_definitions": {
                        "en": "A physical sensation or noise perceived through hearing."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sound",
                                "target_lang_sense_clarification": "auditory sensation"
                            },
                            {
                                "target_lang_word": "noise",
                                "target_lang_sense_clarification": "unspecified or unwanted auditory sound"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9eb819b-7300-3f84-945f-a1ae5fc0c785",
                    "sense_definition": "Колебания среды, воспринимаемые органами слуха.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "физическое_явление",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Скорость <w>звука</w> в воздухе значительно ниже скорости света.",
                            "target_lang_translations": {
                                "en": "The speed of <w>sound</w> in air is significantly lower than the speed of light."
                            }
                        },
                        {
                            "text": "Мы слышим самые разные <w>звуки</w> в лесу по утрам.",
                            "target_lang_translations": {
                                "en": "We hear all kinds of <w>sounds</w> in the forest in the morning."
                            }
                        }
                    ],
                    "antonyms": [
                        "тишина"
                    ],
                    "common_phrases": [
                        "скорость звука"
                    ],
                    "target_lang_definitions": {
                        "en": "Vibrations in a medium capable of being heard by the ears."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sound",
                                "target_lang_sense_clarification": "acoustic phenomenon perceived by hearing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95badb2d-0aa7-3b2f-9197-8329811c2c2d",
                    "sense_definition": "Характер или качество воспроизведения музыки или голоса.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "качество_воспроизведения",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот новый инструмент имеет очень глубокий <w>звук</w>.",
                            "target_lang_translations": {
                                "en": "This new instrument has a very deep <w>sound</w>."
                            }
                        },
                        {
                            "text": "Нам очень нравится <w>звук</w> этой старой гитары.",
                            "target_lang_translations": {
                                "en": "We really like the <w>sound</w> of this old guitar."
                            }
                        }
                    ],
                    "synonyms": [
                        "звучание"
                    ],
                    "common_phrases": [
                        "качество звука"
                    ],
                    "target_lang_definitions": {
                        "en": "The character, tone, or quality of music or voice reproduction."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sound",
                                "target_lang_sense_clarification": "distinctive quality or tone of music/voice"
                            },
                            {
                                "target_lang_word": "tone",
                                "target_lang_sense_clarification": "acoustic quality or timbre of an instrument"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "375fbef0-593c-3d30-bad7-ae7901d85842",
                    "sense_definition": "Минимальная единица человеческой речи.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "лингвистика",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этом слове каждый <w>звук</w> произносится очень чётко.",
                            "target_lang_translations": {
                                "en": "In this word, each <w>sound</w> is pronounced very clearly."
                            }
                        },
                        {
                            "text": "Ученики учатся правильно произносить каждый <w>звук</w> иностранного языка.",
                            "target_lang_translations": {
                                "en": "Students learn to pronounce every <w>sound</w> of a foreign language correctly."
                            }
                        }
                    ],
                    "antonyms": [
                        "буква"
                    ],
                    "common_phrases": [
                        "гласный звук",
                        "согласный звук"
                    ],
                    "target_lang_definitions": {
                        "en": "The minimal acoustic unit of spoken language."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sound",
                                "target_lang_sense_clarification": "speech sound"
                            },
                            {
                                "target_lang_word": "phone",
                                "target_lang_sense_clarification": "linguistic speech unit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65c9d8da-21a3-362e-9e61-900a5a7012d9",
                    "sense_definition": "Колебательное движение частиц среды, распространяющееся в виде волн.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "физическое_явление",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Физики изучают, как <w>звук</w> распространяется в различных твёрдых телах.",
                            "target_lang_translations": {
                                "en": "Physicists study how <w>sound</w> travels through various solids."
                            }
                        },
                        {
                            "text": "Отражение <w>звука</w> от стен создаёт эффект эха в пустом зале.",
                            "target_lang_translations": {
                                "en": "The reflection of <w>sound</w> from the walls creates an echo effect in an empty hall."
                            }
                        }
                    ],
                    "common_phrases": [
                        "скорость звука"
                    ],
                    "target_lang_definitions": {
                        "en": "Oscillatory motion of particles in a medium propagating as waves."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sound",
                                "target_lang_sense_clarification": "acoustic wave in physics"
                            },
                            {
                                "target_lang_word": "acoustic wave",
                                "target_lang_sense_clarification": "wave of acoustic energy"
                            }
                        ]
                    }
                }
            ]
        }
