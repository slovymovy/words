                        "entry_id": "fbe6d8e7-f75e-3135-9c92-fd34202e33a8",
                        "glosses": [
                            "rozwlekłe mówienie o nieważnych rzeczach, często bez wewnętrznego ładu, często bez związku z reakcją otoczenia"
                        ],
