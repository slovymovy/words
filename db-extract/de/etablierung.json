                    {
                        "form_id": "c7a50dc4-30b7-4337-b555-1075ded3dc34",
                        "entry_id": "4d18c2e7-7303-3ddf-a2ff-63c9f0b64086",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Etablierungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c78fc1d7-f79a-3b18-88d1-19e704be4d32",
                        "entry_id": "4d18c2e7-7303-3ddf-a2ff-63c9f0b64086",
                        "glosses": [
                            "Entstehung, Einrichtung von etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db999aa8-224f-4611-9688-4329aa0724ba",
                                "sense_id": "c78fc1d7-f79a-3b18-88d1-19e704be4d32",
                                "text": "„Sie hat als Ministerpräsidentin im Saarland die Etablierung des LSU-Landesverbands aktiv unterstützt und den Vorsitzenden direkt in den Landesvorstand kooptiert.“"
                            },
                            {
                                "example_id": "b4932b0c-63af-42ee-83d2-de4fae256c32",
                                "sense_id": "c78fc1d7-f79a-3b18-88d1-19e704be4d32",
                                "text": "„So kümmert er sich als Stadtrat beispielsweise um die Verbesserung der Trinkwasserversorgung und sorgte für die Etablierung eines Gesundheitsamts in Marburg.“"
                            },
                            {
                                "example_id": "816f2acf-9703-4de7-b6f0-8b4c91bc4ca3",
                                "sense_id": "c78fc1d7-f79a-3b18-88d1-19e704be4d32",
                                "text": "„Es war das erste Mal seit Etablierung einer öffentlichen Stromversorgung im Jahr 1892, dass Britannien ohne Kohleverstromung auskommt.“"
                            },
                            {
                                "example_id": "09103180-4d93-4702-8d1f-a69534c19925",
                                "sense_id": "c78fc1d7-f79a-3b18-88d1-19e704be4d32",
                                "text": "„In Schweden hat dieser Mangel an akademischen Lehrern zur Etablierung eines neuartigen Professorats an den Hochschulen geführt.“"
                            },
                            {
                                "example_id": "bd44bedc-de61-4afe-b919-4b2887a1f8b9",
                                "sense_id": "c78fc1d7-f79a-3b18-88d1-19e704be4d32",
                                "text": "„Im Neuen Testament sind Botschaft und Weltbild zu unterscheiden. Die Botschaft steht für sich selbst; sie hat nicht die Etablierung eines bestimmten Weltbilds zum Ziel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "88e22563-02cd-309d-8293-5bca61d85e3d",
                        "entry_id": "4d18c2e7-7303-3ddf-a2ff-63c9f0b64086",
                        "glosses": [
                            "Ausbreitung von etwas (einer Sache, Methode, Meinung), sodass es mit der Zeit an Akzeptanz, Gültigkeit erlangt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce987521-8c20-49a9-a871-fd46baf38706",
                                "sense_id": "88e22563-02cd-309d-8293-5bca61d85e3d",
                                "text": "„Im Neuen Testament sind Botschaft und Weltbild zu unterscheiden. Die Botschaft steht für sich selbst; sie hat nicht die Etablierung eines bestimmten Weltbilds zum Ziel.“"
                            },
                            {
                                "example_id": "e7506dc3-8956-4a29-8a42-1226abc1f069",
                                "sense_id": "88e22563-02cd-309d-8293-5bca61d85e3d",
                                "text": "„Die kollektive Verarbeitung der Erfahrungen der Besatzungszeit prägte die nationale Identität der (Nord)Koreaner nachhaltig und belebte den Patriotismus. Durch ein auf diese Weise gestärktes Nationalgefühl konnte in der DVRK später die stark nationalistische Chuch'e-Philosophie problemloser als Staatsideologie etabliert werden. Die Etablierung dieser Ideologie [Chuch'e Philosophie] spielte bei der Entwicklung des politischen Systems eine besondere Rolle. Sie gilt heute als eine wichtige Stütze der Stabilität des gesamten Systems.“"
                            },
                            {
                                "example_id": "732892f9-bcc1-4a88-948a-ac8239950939",
                                "sense_id": "88e22563-02cd-309d-8293-5bca61d85e3d",
                                "text": "„Nach klinischer Etablierung der Methode ist eine ambulante Behandlung in Lokalanaesthesie denkbar.“"
                            },
                            {
                                "example_id": "f1b8a847-577f-4e05-a0e4-3d4f9bc1beaf",
                                "sense_id": "88e22563-02cd-309d-8293-5bca61d85e3d",
                                "text": "„Die Etablierung dieser neuen Interaktions- und Partizipationsformen gehen allerdings auch mit einer Relativierung des Monopols bürgerlicher Intelligenz einher.“"
                            },
                            {
                                "example_id": "eb5840de-6714-45ef-8586-41b61b482cbd",
                                "sense_id": "88e22563-02cd-309d-8293-5bca61d85e3d",
                                "text": "„In den analytischen Fokus gerieten die Etablierungen neuer Herrschaftsformen, die sich auf Privatleben und Psyche der Subjekte in den kapitalistischen Klassengesellschaften ausdehnten […].“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
