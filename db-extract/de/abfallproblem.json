                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8152541e-8e33-4317-b06d-26a22a726483",
                                "sense_id": "08eb12f9-956e-3ee3-9b56-d5f620bc2f38",
                                "text": "„Mit dem Vordringen der Elektronik in Haushalte und Unternehmen stellt sich ein Abfallproblem neuer Art: Immer mehr Systeme werden für immer kürzere Zeit eingesetzt und immer weitere entwickelt; demgemäß wächst die Menge ausgemusterter Geräte.“"
                            },
                            {
                                "example_id": "9739e280-f4c1-404d-a05e-770a491228f8",
                                "sense_id": "08eb12f9-956e-3ee3-9b56-d5f620bc2f38",
                                "text": "„Henderson Island im Südpazifik gilt als unberührtes Tropenidyll. Doch selbst die entlegene Insel hat ein gewaltiges Abfallproblem am Strand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
