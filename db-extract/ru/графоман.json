                            }
                        ]
                    },
                    {
                        "translation_id": "90301653-46c0-4fc9-ac12-b6989184d482",
                        "source_entry_id": "deb7f995-e0f5-38de-b55c-8799ea37d7b9",
                        "source_sense_id": "c34da7ba-3716-37bf-87d4-ca56a9a3b8fe",
                        "target_lang_word": "veelschrijver",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "veelschrijver",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "856964cf-41c2-3d44-a8c0-0f6a52f0c6ef",
                                        "entry_id": "a5709487-b575-371e-ad0c-337d7c51aff6",
                                        "glosses": [
                                            "iemand die heel veel teksten maakt, soms gebruikt als minachtende benaming voor een auteur die meer kwantiteit dan kwaliteit produceert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88cede2a-5e39-448b-82d1-13633a130aef",
                                                "sense_id": "856964cf-41c2-3d44-a8c0-0f6a52f0c6ef",
                                                "text": "De Dordtse huisjesmelker en veelschrijver Mustafa Karasahin maakt misbruik van zijn recht door de gemeente Dordrecht honderden brieven per jaar te schrijven. Dat kostte de gemeente al enkele tonnen aan het afhandelen van de brieven."
                                            },
                                            {
                                                "example_id": "cd48d9a8-bfcd-41d3-9144-4e7cb4ce05ec",
                                                "sense_id": "856964cf-41c2-3d44-a8c0-0f6a52f0c6ef",
                                                "text": "Hij was een veelschrijver. Tot zijn bekendste werken behoort de roman Gateway uit 1977, het verhaal van een ruimtestation dat verborgen is in een asteroïde. Het boek heeft later een computerspel geïnspireerd."
                                            },
                                            {
                                                "example_id": "d70cb4b1-c820-40c3-ab9c-0aa93ff64519",
                                                "sense_id": "856964cf-41c2-3d44-a8c0-0f6a52f0c6ef",
                                                "text": "Sir Pratchett was een veelschrijver. Toen hij in 2015 op 66-jarige leeftijd overleed aan de gevolgen van de ziekte van Alzheimer, had hij zeventig boeken geschreven waarvan een slordige zeventig miljoen exemplaren waren verkocht. Vooral zijn licht humoristische fantasy over de Schijfwereld (Discworld) sloegen wereldwijd aan: zijn boeken zijn tot nog toe in 37 talen verschenen. Volgens curator Richard Henry wilde de auteur niet dat na zijn dood iemand anders zijn werk zou afmaken."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70a5fe63-f24c-3e52-886b-01125aa6481a",
                                        "entry_id": "a5709487-b575-371e-ad0c-337d7c51aff6",
                                        "glosses": [
                                            "instrument waarmee meerdere fysiologische reacties tegelijkertijd kunnen worden geregistreerd"
                                        ],
